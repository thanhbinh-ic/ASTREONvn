transform -1 delayed_blink(delay, cycle):
    alpha .5

    pause delay

    block:
        linear .2 alpha 1.0
        pause .2
        linear .2 alpha 0.5
        pause (cycle - .4)
        repeat

transform -1 test_anim_not:
    on show:
        alpha 0
        ease 1 alpha 1.0
    on hide:
        ease 1 alpha 0

transform -1 button_pref:
    on idle:
        ease 0.5 alpha 1.0
    on hover:
        ease 0.5 alpha 0.7

transform -1 back:
    subpixel True
    xalign 0.15 yalign 0.0 zoom 1.01
    block:
        ease 9.0 xalign 0.85 yalign 0.6 zoom 1.05
        ease 9.0 xalign 0.15 yalign 0.0 zoom 1.01
        repeat

transform -1 logo_button:
    subpixel True
    on idle:
        xanchor 0.5
        yanchor 0.5
        ease 0.5 xysize (202, 109)
    on hover:
        xanchor 0.5
        yanchor 0.5
        ease 0.5 xysize (141, 76)

transform -1 notify_appear:
    on show:
        alpha 0
        linear .25 alpha 1.0
    on hide:
        linear .5 alpha 0.0

