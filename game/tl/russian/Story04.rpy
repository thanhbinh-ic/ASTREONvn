# game/Story04.rpy:6944
translate russian story05_5_3_4883f48e:

    # mc "You sure leaving her alone is a good idea?"
    mc "Ты уверен, что оставлять её одну - хорошая идея?"

# game/Story04.rpy:6945
translate russian story05_5_3_688ef7eb:

    # a "Her survival contradicts my logic entirely."
    a "Её выживание полностью противоречит моей логике."

# game/Story04.rpy:6946
translate russian story05_5_3_4c7df73f:

    # a "You’ll have to decide that one yourself."
    a "Это тебе придётся решить самому."

# game/Story04.rpy:6949
translate russian story05_5_3_2061d0e2:

    # mc "Figures."
    mc "Ну конечно."

# game/Story04.rpy:6951
translate russian story05_5_3_31a3ef4d:

    # mc "(Then let’s move.)"
    mc "(Тогда идём.)"

# game/Story04.rpy:6963
translate russian story05_5_3_a571b8c4:

    # mc "Beautiful…"
    mc "Красиво..."

# game/Story04.rpy:6964
translate russian story05_5_3_716fe1a3:

    # a "Ruins and overgrowth."
    a "Руины и заросли."

# game/Story04.rpy:6965
translate russian story05_5_3_9dedfefc:

    # a "There’s nothing beautiful about decay."
    a "В упадке нет ничего красивого."

