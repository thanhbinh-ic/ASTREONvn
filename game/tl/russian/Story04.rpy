translate russian story05_5_3_e69592fa:

    # keep3 "Third."
    keep3 "Третий."

# game/Story04.rpy:6993
translate russian story05_5_3_beda4223:

    # keep3 "Names mean nothing to us."
    keep3 "Имена для нас ничего не значат."

# game/Story04.rpy:6995
translate russian story05_5_3_50193a3e:

    # mc "Strange customs."
    mc "Странные обычаи."

