    mc "Почти смешно."

# game/Story04.rpy:6903
translate russian story05_5_3_71d7552f:

    # mc "So without the chip… the implants are useless?"
    mc "Значит, без чипа... импланты бесполезны?"

# game/Story04.rpy:6905
translate russian story05_5_3_0085e033_1:

    # keep3 "..."
    keep3 "..."

