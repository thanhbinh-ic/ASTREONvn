translate russian story05_5_3_2f61aa8f:

    # mc "Yeah. Why?"
    mc "Да. Почему?"

# game/Story04.rpy:6975
translate russian story05_5_3_d3c6023d:

    # a "Don’t use it. Elves don’t tolerate implants."
    a "Не используй его. Эльфы не терпят импланты."

# game/Story04.rpy:6976
translate russian story05_5_3_56c3991c:

    # mc "Why not?"
    mc "Почему?"

# game/Story04.rpy:6978
translate russian story05_5_3_e7cbf4b2:

    # a "Just advice."
    a "Просто совет."

# game/Story04.rpy:6979
translate russian story05_5_3_37c49932:

    # mc "(What changed him? He’s… unusually talkative.)"
    mc "(Что с ним изменилось? Он... непривычно разговорчив.)"

# game/Story04.rpy:6981
translate russian story05_5_3_6fb1465c:

    # mc "Noted."
    mc "Учту."

# game/Story04.rpy:6988
translate russian story05_5_3_c07e88d7:

    # mc "(An elven colony… so not Earth.)"
    mc "(Эльфийская колония... значит, не Земля.)"

# game/Story04.rpy:6989
translate russian story05_5_3_6080a8a9:

    # mc "(Which means the Gate experiment failed?)"
    mc "(Значит, эксперимент с Вратами провалился?)"

# game/Story04.rpy:6991
translate russian story05_5_3_c5975c38:

    # mc "White mask... No. What should I call you?"
    mc "Белая маска... Нет. Как мне тебя называть?"

