# game/Story04.rpy:10109
translate russian story05_5_6_58debe57:

    # Mi "Will you dance with me?"
    Mi "Потанцуешь со мной?"

# game/Story04.rpy:10111
translate russian story05_5_6_3c13ec82:

    # mc "(And the rest…)"
    mc "(А остальное…)"

# game/Story04.rpy:10113
translate russian story05_5_6_145cfa53:

    # mc "I don’t know if—"
    mc "Я не знаю, стоит ли—"

# game/Story04.rpy:10114
translate russian story05_5_6_fff99a50:

    # Mi "Just trust me."
    Mi "Просто доверься мне."

# game/Story04.rpy:10124
translate russian story05_5_6_de529672:

    # mc "(Let it be what it will.)"
    mc "(Будь что будет.)"

# game/Story04.rpy:10129
translate russian story05_5_6_5164590e:

    # mc "Why me?"
    mc "Почему я?"

# game/Story04.rpy:10133
translate russian story05_5_6_e137763f:

    # Mi "(whispering) You looked… too sad."
    Mi "(шёпотом) Ты выглядел… слишком грустным."

# game/Story04.rpy:10135
translate russian story05_5_6_5ce435eb:

    # Mi "(whispering) And… I wanted to cheer you up."
    Mi "(шёпотом) И… мне захотелось тебя подбодрить."

# game/Story04.rpy:10138
translate russian story05_5_6_29379b3f:

    # mc "(whispering) Others are staring at us. Are you sure this won’t cause trouble?"
    mc "(шёпотом) Остальные на нас смотрят. Уверена, что это не вызовет проблем?"

# game/Story04.rpy:10141
translate russian story05_5_6_90d49676:

    # Mi "(whispering) For us, dance is more than celebration. It’s a symbol."
    Mi "(шёпотом) Для нас танец — больше, чем празднование. Это символ."

# game/Story04.rpy:10144
translate russian story05_5_6_67cc638a:

    # Mi "(whispering) The elves trust me. And this is how I show that I trust you."
    Mi "(шёпотом) Эльфы доверяют мне. И так я показываю, что доверяю тебе."

# game/Story04.rpy:10148
translate russian story05_5_6_d655cd88:

    # Mi "(whispering) It’s my way of protecting you."
    Mi "(шёпотом) Это мой способ защитить тебя."

# game/Story04.rpy:10150
translate russian story05_5_6_e5fc4392:

    # mc "That’s too much honor for someone like me."
    mc "Это слишком большая честь для кого-то вроде меня."

# game/Story04.rpy:10154
translate russian story05_5_6_460a0666:

    # Mi "(whispering) I don’t even know why myself."
    Mi "(шёпотом) Я и сама не знаю почему."

# game/Story04.rpy:10156
translate russian story05_5_6_0eafce44:

    # Mi "(whispering) Maybe it’s the memories… or perhaps the promise."
    Mi "(шёпотом) Может, дело в воспоминаниях… или в обещании."

# game/Story04.rpy:10158
translate russian story05_5_6_e0844d3a:

    # Mi "(whispering) Funny, isn’t it?"
    Mi "(шёпотом) Забавно, правда?"

# game/Story04.rpy:10159
translate russian story05_5_6_b61d5c07:

    # Mi "(whispering) Others follow me… and yet I’m the one believing in something so foolish."
    Mi "(шёпотом) Другие идут за мной… и всё же именно я верю во что-то настолько глупое."

# game/Story04.rpy:10163
translate russian story05_5_6_188ebe34:

    # Mi "(whispering) Tell me… {w}what will I become in the future?"
    Mi "(шёпотом) Скажи мне… {w}кем я стану в будущем?"

# game/Story04.rpy:10165
translate russian story05_5_6_5da4b9f3:

    # mc "Why ask that now?"
    mc "Почему ты спрашиваешь об этом именно сейчас?"

# game/Story04.rpy:10167
translate russian story05_5_6_be9397cf:

    # Mi "(whispering) In those memories… I saw things I shouldn’t have."
    Mi "(шёпотом) В тех воспоминаниях… я видела то, чего не должна была видеть."

# game/Story04.rpy:10169
translate russian story05_5_6_b4ba8c8d:

    # Mi "(whispering) My future."
    Mi "(шёпотом) Моё будущее."

# game/Story04.rpy:10172
translate russian story05_5_6_cb6619d2:

    # Mi "(whispering) I’m afraid…"
    Mi "(шёпотом) Мне страшно…"

# game/Story04.rpy:10177
translate russian story05_5_6_90d84405:

    # n "Yo!"
    n "Йоу!"

# game/Story04.rpy:10178
translate russian story05_5_6_61741549:

    # n "Thats all for now."
    n "На этом пока всё."

translate russian strings:

    # game/Story04.rpy:1740
    old "(So that’s your answer?)"
    new "(Таков твой ответ?)"

    # game/Story04.rpy:1747
    old "Do nothing."
    new "Ничего не делать."

