translate russian story05_5_3_87d30154:

    # mc "But how do I get there?"
    mc "Но как мне туда добраться?"

# game/Story04.rpy:7081
translate russian story05_5_3_e9643e9d:

    # mc "No, wrong question."
    mc "Нет, не тот вопрос."

# game/Story04.rpy:7082
translate russian story05_5_3_512d0881:

    # mc "How do I get there {b}with Kalestra…{/b}"
    mc "Как мне попасть туда {b}вместе с Калестрой...{/b}"

# game/Story04.rpy:7084
translate russian story05_5_3_d22d3f4a:

    # keep3 "Still haven’t changed your mind?"
    keep3 "Всё ещё не передумал?"

