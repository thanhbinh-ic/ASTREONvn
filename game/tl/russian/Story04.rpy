translate russian story05_5_4_36ec17e3:

    # mc "Easy…"
    mc "Тише…"

# game/Story04.rpy:7815
translate russian story05_5_4_7def8fed:

    # mc "They’re not your enemy—"
    mc "Они тебе не враги—"

# game/Story04.rpy:7828
translate russian story05_5_4_ff444b16:

    # mc "Good-"
    mc "Хоро-"

# game/Story04.rpy:7831
translate russian story05_5_4_9fe59d85:

    # k "You’re… alive."
    k "Ты… жив."

# game/Story04.rpy:7834
translate russian story05_5_4_cf1adef2:

    # mc "Yeah."
    mc "Да."

# game/Story04.rpy:7835
translate russian story05_5_4_21d60d8b:

    # mc "I am."
    mc "Жив."

# game/Story04.rpy:7838
translate russian story05_5_4_8883f279:

    # Go "Drego. \n(Leave us.)"
    Go "Drego. \n(Оставьте нас.)"

# game/Story04.rpy:7839
translate russian story05_5_4_187294d2:

    # Go "A tiro na Ketrin. \n(And see to Ketrin.)"
    Go "A tiro na Ketrin. \n(И позаботьтесь о Кетрин.)"

# game/Story04.rpy:7840
translate russian story05_5_4_8a5d8422:

    # elf "Nae, Aran nín. \n(Yes, Your Highness.)"
    elf "Nae, Aran nín. \n(Да, Ваше Высочество.)"

# game/Story04.rpy:7846
translate russian story05_5_4_308776f5:

    # elf "(whispering) Losto. Ce danna maer. \n(It’ll pass. You did well. You held steady.)"
    elf "(шёпотом) Losto. Ce danna maer. \n(Всё пройдёт. Ты хорошо справилась. Ты выдержала.)"

# game/Story04.rpy:7848
translate russian story05_5_4_2fa8f909:

    # Go "Maer gwaith. \n(Good work.)"
    Go "Maer gwaith. \n(Хорошая работа.)"

# game/Story04.rpy:7849
translate russian story05_5_4_15f8a1d5:

    # ketr "Mm…"
    ketr "Мм…"

# game/Story04.rpy:7851
translate russian story05_5_4_5e72245c:

    # elf "Tol. \n(Come.)"
    elf "Tol. \n(Идём.)"

