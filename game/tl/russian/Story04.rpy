translate russian story05_5_3_0085e033_4:

    # keep3 "..."
    keep3 "..."

# game/Story04.rpy:7357
translate russian story05_5_3_1614dd6c:

    # keep3 "His sector wasn’t under my jurisdiction."
    keep3 "Его сектор был вне моей юрисдикции."

# game/Story04.rpy:7360
translate russian story05_5_3_8298bb5c:

    # Go "Please. This way."
    Go "Прошу. Сюда."

# game/Story04.rpy:7362
translate russian story05_5_3_87590ff9:

    # "Elven Village."
    "Эльфийская деревня."

# game/Story04.rpy:7365
translate russian story05_5_3_8d308d85:

    # mc "(Empty. Too empty.)"
    mc "(Пусто. Слишком пусто.)"

# game/Story04.rpy:7366
translate russian story05_5_3_7a6ee951:

    # mc "(And the smoke… thick. Bitter. Hard to breathe.)"
    mc "(И дым... густой. Горький. Трудно дышать.)"

# game/Story04.rpy:7367
translate russian story05_5_3_58f9b8f6:

    # mc "Forgive me. I can’t go any farther."
    mc "Прости. Я не могу идти дальше."

# game/Story04.rpy:7369
translate russian story05_5_3_9c5476d4:

    # Go "Is something… displeasing you?"
    Go "Что-то... тебя беспокоит?"

# game/Story04.rpy:7370
translate russian story05_5_3_6c664337:

    # mc "(I’ve gone too far from Kalestra. And if—)"
    mc "(Я ушёл слишком далеко от Калестры. И если-)"

# game/Story04.rpy:7372
translate russian story05_5_3_52f997eb:

    # mc "I need to return."
    mc "Мне нужно вернуться."

# game/Story04.rpy:7373
translate russian story05_5_3_fb57693e:

    # mc "I have to make sure she’s alright."
    mc "Я должен убедиться, что с ней всё в порядке."

# game/Story04.rpy:7374
translate russian story05_5_3_f7a03355:

    # Go "Ah. Your companion."
    Go "Ах. Твоя спутница."

# game/Story04.rpy:7378
translate russian story05_5_3_8ff7c669:

    # Go "My guards have already seen to her."
    Go "Мои стражи уже позаботились о ней."

# game/Story04.rpy:7379
translate russian story05_5_3_95573fa3:

    # mc "What—"
    mc "Что-"

# game/Story04.rpy:7382
translate russian story05_5_3_4d45f5f4:

    # Go "Do not concern yourself."
    Go "Не беспокойся."

# game/Story04.rpy:7383
translate russian story05_5_3_48ff54a5:

    # Go "She is in relative safety."
    Go "Она в относительной безопасности."

# game/Story04.rpy:7384
translate russian story05_5_3_55fcc115:

    # mc "I didn’t ask you to do that."
    mc "Я не просил тебя это делать."

# game/Story04.rpy:7386
translate russian story05_5_3_23ac7b1d_4:

    # Go "..."
    Go "..."

# game/Story04.rpy:7389
translate russian story05_5_3_7d3f9c6e:

    # Go "Please, do not misunderstand me."
    Go "Пожалуйста, не пойми меня неправильно."

# game/Story04.rpy:7390
translate russian story05_5_3_37c588c2:

    # Go "A human child with a hole in her chest… filled with miasma."
    Go "Человеческий ребёнок с дырой в груди... наполненной миазмой."

# game/Story04.rpy:7392
translate russian story05_5_3_3571d02a:

    # Go "At best, that is poor etiquette."
    Go "В лучшем случае это дурной тон."

# game/Story04.rpy:7393
translate russian story05_5_3_35412319:

    # Go "At worst… a declaration of war."
    Go "В худшем... объявление войны."

# game/Story04.rpy:7394
translate russian story05_5_3_b9b6052e:

    # Go "Anyone else in my position would have eliminated you on the spot."
    Go "Любой другой на моём месте устранил бы тебя на месте."

# game/Story04.rpy:7395
translate russian story05_5_3_1aaa839d:

    # mc "(Third. Credibility?)"
    mc "(Третий. Достоверность?)"

# game/Story04.rpy:7396
translate russian story05_5_3_24a9560f:

    # keep3 "(whispering) You saw what happened to the Federation."
    keep3 "(шёпотом) Ты видел, что стало с Федерацией."

# game/Story04.rpy:7397
translate russian story05_5_3_c0794855:

    # keep3 "He’s not lying."
    keep3 "Он не лжёт."

# game/Story04.rpy:7400
translate russian story05_5_3_641a2afc:

    # mc "(So what is this, then?)"
    mc "(Тогда что это?)"

# game/Story04.rpy:7401
translate russian story05_5_3_cd969157:

    # mc "(We’re hostages?)"
    mc "(Мы заложники?)"

# game/Story04.rpy:7402
translate russian story05_5_3_b20618a2:

    # keep3 "(whispering) No. You’re a curiosity."
    keep3 "(шёпотом) Нет. Ты - любопытная редкость."

# game/Story04.rpy:7403
translate russian story05_5_3_7f11f745:

    # keep3 "His new toy."
    keep3 "Его новая игрушка."

# game/Story04.rpy:7405
translate russian story05_5_3_bea370c4:

    # mc "(Curiosity…?)"
    mc "(Любопытная редкость...?)"

# game/Story04.rpy:7406
translate russian story05_5_3_9767e7a1:

    # keep3 "(whispering) Yes. Don’t give him everything."
    keep3 "(шёпотом) Да. Не раскрывай ему всё."

# game/Story04.rpy:7407
translate russian story05_5_3_f88b49b7:

    # keep3 "Mystery is leverage. It’s how we stay alive."
    keep3 "Тайна - это рычаг. Так мы останемся живы."

# game/Story04.rpy:7409
translate russian story05_5_3_bc548899:

    # mc "So you’re saying… she’s safe?"
    mc "То есть ты говоришь... она в безопасности?"

# game/Story04.rpy:7410
translate russian story05_5_3_8e359492:

    # mc "Fine."
    mc "Ладно."

# game/Story04.rpy:7413
translate russian story05_5_3_1493af16:

    # Go "Thank you for your understanding."
    Go "Спасибо за понимание."

# game/Story04.rpy:7415
translate russian story05_5_3_a6f34928:

    # mc "(I folded too quickly.)"
    mc "(Я сдался слишком быстро.)"

# game/Story04.rpy:7416
translate russian story05_5_3_48b759a6:

    # mc "(Hooked on his civility like an amateur.)"
    mc "(Клюнул на его вежливость, как любитель.)"

# game/Story04.rpy:7417
translate russian story05_5_3_30b7e44b:

    # keep3 "(whispering) Let that be your lesson."
    keep3 "(шёпотом) Пусть это станет тебе уроком."

# game/Story04.rpy:7435
translate russian story05_5_4_08b8db12:

    # mc "(That feeling again.)"
    mc "(Снова это чувство.)"

# game/Story04.rpy:7436
translate russian story05_5_4_21511ef2:

    # mc "(Tight chest. Measured air.)"
    mc "(Стеснение в груди. Отмеренный воздух.)"

# game/Story04.rpy:7437
translate russian story05_5_4_0448a427:

    # mc "(Like I’m back in Astoria’s office, being dissected without a blade.)"
    mc "(Словно я снова в кабинете Астории, и меня препарируют без лезвия.)"

# game/Story04.rpy:7440
translate russian story05_5_4_d5ed36e7:

    # Go "So."
    Go "Итак."

# game/Story04.rpy:7441
translate russian story05_5_4_b4188e6b:

    # Go "Why did Astoria send her hounds to me?"
    Go "Почему Астория отправила ко мне своих гончих?"

# game/Story04.rpy:7443
translate russian story05_5_4_8756dfa3:

    # mc "How long have you known?"
    mc "Как давно ты знаешь?"

# game/Story04.rpy:7449
translate russian story05_5_4_71c6da09:

    # Go "Allow me to introduce myself properly."
    Go "Позволь мне представиться должным образом."

# game/Story04.rpy:7450
translate russian story05_5_4_5b4d5097:

    # Go "Goremilion Aeliren Taer-Sylv."
    Go "Горемилион Аэлирен Таэр-Сильв."

# game/Story04.rpy:7456
translate russian story05_5_4_b1008d83:

    # mc "The Elven Emperor himself. I assume."
    mc "Сам эльфийский император, полагаю."

# game/Story04.rpy:7460
translate russian story05_5_4_23ac7b1d:

    # Go "..."
    Go "..."

# game/Story04.rpy:7462
translate russian story05_5_4_8ec059f7:

    # Go "Emperor…"
    Go "Император..."

# game/Story04.rpy:7463
translate russian story05_5_4_cad9d0a9:

    # Go "Interesting choice of words."
    Go "Любопытный выбор слов."

# game/Story04.rpy:7464
translate russian story05_5_4_c75c2efd:

    # Go "You are the first to call me that."
    Go "Ты первый, кто назвал меня так."

# game/Story04.rpy:7466
translate russian story05_5_4_5ddaab18:

    # mc "(What?)"
    mc "(Что?)"

# game/Story04.rpy:7467
translate russian story05_5_4_48fa5e63:

    # mc "(But Selvaria was called Empress. So either—)"
    mc "(Но Сельварию называли императрицей. Значит, либо-)"

# game/Story04.rpy:7470
translate russian story05_5_4_64ab9065:

    # keep3 "(whispering) Bad news."
    keep3 "(шёпотом) Плохие новости."

# game/Story04.rpy:7471
translate russian story05_5_4_485e169d:

    # keep3 "(whispering) We’ve been thrown back 97 years."
    keep3 "(шёпотом) Нас отбросило на 97 лет назад."

# game/Story04.rpy:7472
translate russian story05_5_4_2b35b6fe:

    # mc "..."
    mc "..."

# game/Story04.rpy:7474
translate russian story05_5_4_8df9b125:

    # Go "You are no ordinary young man."
    Go "Ты не обычный молодой человек."

# game/Story04.rpy:7480
translate russian story05_5_4_a9e3f1f8:

    # Go "Especially your companion."
    Go "Особенно твой спутник."

# game/Story04.rpy:7481
translate russian story05_5_4_29e4fb56:

    # Go "The Third Keeper. Am I correct?"
    Go "Третий Хранитель. Я прав?"

# game/Story04.rpy:7483
translate russian story05_5_4_61abcb5d:

    # keep3 "I underestimated him."
    keep3 "Я его недооценил."

# game/Story04.rpy:7487
translate russian story05_5_4_c163fab1:

    # mc "What exactly do you know about us?"
    mc "Что именно ты о нас знаешь?"

# game/Story04.rpy:7489
translate russian story05_5_4_2673f802:

    # Go "Enough to let you live."
    Go "Достаточно, чтобы оставить тебя в живых."

# game/Story04.rpy:7495
translate russian story05_5_4_e4147bf7:

    # Go "In trying to save this girl… you attempted to go to the gate"
    Go "Пытаясь спасти эту девушку... ты попытался добраться до Врат"

# game/Story04.rpy:7497
translate russian story05_5_4_c2650d06:

    # Go "And failed."
    Go "И не смогла."

# game/Story04.rpy:7498
translate russian story05_5_4_d2cb3ce4:

    # Go "Why?"
    Go "Почему?"

# game/Story04.rpy:7502
translate russian story05_5_4_421d6327:

    # Go "Did something interfere."
    Go "Что-то вмешалось."

# game/Story04.rpy:7504
translate russian story05_5_4_1d65c210:

    # Go "Or perhaps...someone."
    Go "Или, возможно... кто-то."

# game/Story04.rpy:7510
translate russian story05_5_4_f390ac3d:

    # mc "Astoria asked us to meet you."
    mc "Астория попросила нас встретиться с тобой."

# game/Story04.rpy:7511
translate russian story05_5_4_9b7059bb:

    # mc "She said you could help."
    mc "Она сказала, что ты можешь помочь."

# game/Story04.rpy:7517
translate russian story05_5_4_7178350e:

    # Go "I’m pleased we understand one another."
    Go "Рад, что мы понимаем друг друга."

# game/Story04.rpy:7519
translate russian story05_5_4_0932bce3:

    # mc "Tell me."
    mc "Скажи мне."

# game/Story04.rpy:7520
translate russian story05_5_4_5c7d12e0:

    # mc "Have you ever closed an activated Gate?"
    mc "Ты когда-нибудь закрывал активированные Врата?"

# game/Story04.rpy:7522
translate russian story05_5_4_e3ab25b2:

    # Go "What’s the catch?"
    Go "В чём подвох?"

# game/Story04.rpy:7524
translate russian story05_5_4_5fee6da8:

    # mc "Hypothetical."
    mc "Гипотетически."

# game/Story04.rpy:7529
translate russian story05_5_4_447e1a11:

    # Go "Yes."
    Go "Да."

# game/Story04.rpy:7534
translate russian story05_5_4_21924f07:

    # Go "I will ensure she survives."
    Go "Я обеспечу её выживание."

# game/Story04.rpy:7535
translate russian story05_5_4_c559ab05:

    # Go "Nothing more."
    Go "Не более."

# game/Story04.rpy:7536
translate russian story05_5_4_42374e0e:

    # Go "Whether she remains the same hum—"
    Go "Останется ли она тем же чел-"

# game/Story04.rpy:7538
translate russian story05_5_4_2ee86563:

    # mc "That’s enough."
    mc "Достаточно."

# game/Story04.rpy:7542
translate russian story05_5_4_59ccbc6b:

    # Go "Would you care for a walk?"
    Go "Не желаешь прогуляться?"

# game/Story04.rpy:7554
translate russian story05_5_4_a706495c:

    # Go "By nature, we elves are… inquisitive."
    Go "По своей природе мы, эльфы... любознательны."

# game/Story04.rpy:7555
translate russian story05_5_4_f27a259a:

    # Go "We have always sought to understand how this world is constructed."
    Go "Мы всегда стремились понять, как устроен этот мир."

# game/Story04.rpy:7557
translate russian story05_5_4_4840e6c1:

    # Go "And at times… that curiosity strayed beyond what was permitted."
    Go "И порой... это любопытство выходило за пределы дозволенного."

# game/Story04.rpy:7561
translate russian story05_5_4_36928135:

    # Mi "Proof that lines were crossed, mistakes made, and debts paid. Paid in blood."
    Mi "Доказательство того, что границы были пересечены, ошибки совершены, а долги оплачены. Оплачены кровью."

# game/Story04.rpy:7565
translate russian story05_5_4_5c062fba:

    # Mi "The former leader of our faction, who..."
    Mi "Бывший лидер нашей фракции, который..."

# game/Story04.rpy:7569
translate russian story05_5_4_cef1b352:

    # mc "That scientist."
    mc "Тот учёный."

# game/Story04.rpy:7570
translate russian story05_5_4_ac2acad2:

    # Go "Yes, my grandfather."
    Go "Да, мой дед."

# game/Story04.rpy:7573
translate russian story05_5_4_6e50502e:

    # mc "What did he do… exactly?"
    mc "Что именно он сделал?"

# game/Story04.rpy:7578
translate russian story05_5_4_7c8b819d:

    # Go "He attempted to access the Astreon System."
    Go "Он попытался получить доступ к системе Астреон."

# game/Story04.rpy:7581
translate russian story05_5_4_59885c7a:

    # mc "(whispering) And… what is that?"
    mc "(шёпотом) И... что это?"

# game/Story04.rpy:7585
translate russian story05_5_4_a05fa700:

    # Go "A tragedy."
    Go "Трагедия."

# game/Story04.rpy:7588
translate russian story05_5_4_530faaff:

    # Go "For our entire people."
    Go "Для всего нашего народа."

# game/Story04.rpy:7589
translate russian story05_5_4_853d9845:

    # Go "From that moment on… we became enemies of the galaxy."
    Go "С того момента... мы стали врагами галактики."

# game/Story04.rpy:7595
translate russian story05_5_4_2876efd9:

    # mc "Why?"
    mc "Почему?"

# game/Story04.rpy:7599
translate russian story05_5_4_b6441a88:

    # keep3 "There are rules in this galaxy."
    keep3 "В этой галактике есть правила."

# game/Story04.rpy:7600
translate russian story05_5_4_d64a83a5:

    # keep3 "Lines that are not to be crossed"
    keep3 "Границы, которые нельзя пересекать."

# game/Story04.rpy:7602
translate russian story05_5_4_fd929e92:

    # keep3 "One of them states: What has happened… must be paid for."
    keep3 "Одно из них гласит: за случившееся... нужно заплатить."

# game/Story04.rpy:7604
translate russian story05_5_4_0c8674d6:

    # keep3 "They broke that rule."
    keep3 "Они нарушили это правило."

# game/Story04.rpy:7606
translate russian story05_5_4_78d9297f:

    # keep3 "They went against time itself."
    keep3 "Они пошли против самого времени."

# game/Story04.rpy:7607
translate russian story05_5_4_5470cd4a:

    # keep3 "And in return… all of us paid for their mistake."
    keep3 "И в ответ... мы все заплатили за их ошибку."

# game/Story04.rpy:7611
translate russian story05_5_4_15b3e468:

    # mc "None of us are without sin."
    mc "Никто из нас не без греха."

# game/Story04.rpy:7612
translate russian story05_5_4_0085e033:

    # keep3 "..."
    keep3 "..."

# game/Story04.rpy:7618
translate russian story05_5_4_474762be:

    # Go "What do you see?"
    Go "Что ты видишь?"

# game/Story04.rpy:7621
translate russian story05_5_4_9d61da8a:

    # mc "A Gate."
    mc "Врата."

# game/Story04.rpy:7622
translate russian story05_5_4_0ed99863:

    # Go "Days. Weeks. Years. Decades… Time kept moving."
    Go "Дни. Недели. Годы. Десятилетия... Время продолжало идти."

# game/Story04.rpy:7624
translate russian story05_5_4_4d3c49ef:

    # Go "And with it… our curiosity grew."
    Go "И вместе с ним... росло наше любопытство."

# game/Story04.rpy:7631
translate russian story05_5_4_479720ab:

    # Go "Long lives are a blessing. {w=0.7}And a curse."
    Go "Долгие жизни - благословение. {w=0.7}И проклятие."

# game/Story04.rpy:7632
translate russian story05_5_4_671fb598:

    # Go "When you live long enough… meaning begins to rot."
    Go "Когда живёшь достаточно долго... смысл начинает гнить."

# game/Story04.rpy:7638
translate russian story05_5_4_63f9db68:

    # Go "So many of us cling to research."
    Go "Поэтому многие из нас цепляются за исследования."

# game/Story04.rpy:7639
translate russian story05_5_4_51968a67:

    # Go "To discovery."
    Go "За открытия."

# game/Story04.rpy:7640
translate russian story05_5_4_bb25eb4a:

    # Go "To prying open doors that should remain closed."
    Go "За вскрытие дверей, которые должны оставаться закрытыми."

# game/Story04.rpy:7642
translate russian story05_5_4_d56306e3:

    # Go "My grandfather was no exception."
    Go "Мой дед не был исключением."

# game/Story04.rpy:7643
translate russian story05_5_4_7993dfb4:

    # Go "He believed that uncovering the truth of the Gates would let us step beyond the limits of the possible."
    Go "Он верил, что истина о Вратах позволит нам выйти за пределы возможного."

# game/Story04.rpy:7645
translate russian story05_5_4_23ac7b1d_1:

    # Go "..."
    Go "..."

# game/Story04.rpy:7647
translate russian story05_5_4_0903fc81:

    # Go "What he didn’t know…"
    Go "Чего он не знал..."

# game/Story04.rpy:7648
translate russian story05_5_4_c96eee8a:

    # Go "Was about the price."
    Go "Так это цены."

# game/Story04.rpy:7650
translate russian story05_5_4_c21e0a9c:

    # Go "None of us did."
    Go "Никто из нас не знал."

# game/Story04.rpy:7651
translate russian story05_5_4_a4fc24fd:

    # Go "So he activated the Gate."
    Go "Поэтому он активировал Врата."

# game/Story04.rpy:7654
translate russian story05_5_4_2ef8f991:

    # Go "And time stopped."
    Go "И время остановилось."

# game/Story04.rpy:7658
translate russian story05_5_4_e81e8b98:

    # Go "Not metaphorically."
    Go "Не метафорически."

# game/Story04.rpy:7659
translate russian story05_5_4_104aa39f:

    # Go "Literally."
    Go "Буквально."

# game/Story04.rpy:7661
translate russian story05_5_4_cd2dd2fb:

    # Go "The world… froze."
    Go "Мир... замер."

