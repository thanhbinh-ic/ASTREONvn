    # mc "You think?"
    mc "Да ну?"

# game/Story04.rpy:6875
translate russian story05_5_3_f0495824:

    # keep3 "Ripping it out of your head wasn’t rational."
    keep3 "Вырывать его из своей головы было нерационально."

# game/Story04.rpy:6877
translate russian story05_5_3_28d51d64:

    # mc "Her life was on the line."
    mc "На кону была её жизнь."

# game/Story04.rpy:6879
translate russian story05_5_3_0085e033:

    # keep3 "..."
    keep3 "..."

