    Fl "Отправьте их на поддержку девятой. Им нужно перегруппироваться."

# game/Story04.rpy:3576
translate russian story05_5_dbaed599:

    # o "Flora?"
    o "Флора?"

# game/Story04.rpy:3577
translate russian story05_5_46f87ab9:

    # Fl "Yes?"
    Fl "Да?"

# game/Story04.rpy:3578
translate russian story05_5_c5a6cf55:

    # o "You’re doing well. Really well."
    o "Ты хорошо справляешься. Очень хорошо."

# game/Story04.rpy:3581
translate russian story05_5_41da62cb_1:

    # Fl "..."
    Fl "..."

# game/Story04.rpy:3583
translate russian story05_5_b0705bee:

    # Fl "Yeah…"
    Fl "Да..."

