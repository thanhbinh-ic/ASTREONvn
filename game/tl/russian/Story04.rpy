translate russian story05_5_3_a92fcbc5:

    # mc "What’s the difference? You always sounded all-knowing to me."
    mc "В чём разница? Ты всегда звучал как всезнайка."

# game/Story04.rpy:7014
translate russian story05_5_3_0085e033_2:

    # keep3 "..."
    keep3 "..."

# game/Story04.rpy:7015
translate russian story05_5_3_55ea5652:

    # keep3 "Going to war, would you take a sword, or a book?"
    keep3 "Идя на войну, ты взял бы меч или книгу?"

