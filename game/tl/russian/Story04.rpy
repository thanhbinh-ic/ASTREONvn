    # Go "In the next second…"
    Go "В следующую секунду..."

# game/Story04.rpy:7675
translate russian story05_5_4_4a6b467f:

    # Go "My father. My mother. My friends."
    Go "Мой отец. Моя мать. Мои друзья."

