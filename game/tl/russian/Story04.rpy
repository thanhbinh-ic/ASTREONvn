    # keep3 "A fair point."
    keep3 "Справедливо."

# game/Story04.rpy:7020
translate russian story05_5_3_b511b068:

    # keep3 "And your answer, no."
    keep3 "И ответ на твой вопрос - нет."

# game/Story04.rpy:7021
translate russian story05_5_3_37eaa0c9:

    # keep3 "I’m not all-knowing. I’m a weapon."
    keep3 "Я не всеведущий. Я оружие."

# game/Story04.rpy:7023
translate russian story05_5_3_38e357eb:

    # mc "(A statue of a girl. Strange ruins.)"
    mc "(Статуя девушки. Странные руины.)"

# game/Story04.rpy:7024
translate russian story05_5_3_0898dd82:

    # mc "(Nothing useful.)"
    mc "(Ничего полезного.)"

# game/Story04.rpy:7029
translate russian story05_5_3_06f9b724:

    # mc "(If there’s nothing here, I should go higher.)"
    mc "(Если здесь ничего нет, надо подняться выше.)"

# game/Story04.rpy:7030
translate russian story05_5_3_27f3f3ee:

    # mc "(Wait. Dead end?)"
    mc "(Постой. Тупик?)"

# game/Story04.rpy:7032
translate russian story05_5_3_0ca17839:

    # mc "(And here too.)"
    mc "(И здесь тоже.)"

# game/Story04.rpy:7034
translate russian story05_5_3_2b35b6fe_1:

    # mc "..."
    mc "..."

# game/Story04.rpy:7036
translate russian story05_5_3_060c6da2:

    # mc "Purely theoretical, what are the odds there’s no way out?"
    mc "Чисто теоретически, каковы шансы, что выхода нет?"

# game/Story04.rpy:7037
translate russian story05_5_3_0085e033_3:

    # keep3 "..."
    keep3 "..."

# game/Story04.rpy:7039
translate russian story05_5_3_e72e3021:

    # keep3 "The fact we survived unstable gates at all was already a miracle."
    keep3 "То, что мы вообще пережили нестабильные Врата, уже было чудом."

# game/Story04.rpy:7042
translate russian story05_5_3_39975497:

    # mc "(Time to check something.)"
    mc "(Пора кое-что проверить.)"

# game/Story04.rpy:7047
translate russian story05_5_3_5d72f225:

    # "Analysis complete. Optimal route constructed."
    "Анализ завершён. Оптимальный маршрут построен."

# game/Story04.rpy:7049
translate russian story05_5_3_f4d8e7da:

    # keep3 "Implants."
    keep3 "Импланты."

# game/Story04.rpy:7050
translate russian story05_5_3_fa8e14bf:

    # mc "I know. Still."
    mc "Я знаю. И всё же."

# game/Story04.rpy:7065
translate russian story05_5_3_a027e187:

    # mc "Let’s—"
    mc "Давай-"

# game/Story04.rpy:7069
translate russian story05_5_3_ea6e2dab:

    # mc "(Got it.)"
    mc "(Понял.)"

# game/Story04.rpy:7077
translate russian story05_5_3_aedf8e8b:

    # mc "(So maybe it’s not completely hopeless.)"
    mc "(Значит, может, всё не совсем безнадёжно.)"

# game/Story04.rpy:7078
translate russian story05_5_3_60c1564b:

    # mc "I see a passage beyond the rocks."
    mc "Я вижу проход за камнями."

