translate russian story05_5_3_1534a11a:

    # mc "Sounds like you’re hoping I will. Personal dislike?"
    mc "Звучит так, будто ты надеешься, что передумаю. Личная неприязнь?"

# game/Story04.rpy:7086
translate russian story05_5_3_61fe52cc:

    # keep3 "No comment."
    keep3 "Без комментариев."

# game/Story04.rpy:7090
translate russian story05_5_3_24314cb9:

    # "Threat detected. Enemy at seven o’clock."
    "Обнаружена угроза. Враг на семь часов."

# game/Story04.rpy:7093
translate russian story05_5_3_86583c85:

    # mc "(Just what I needed.)"
    mc "(Именно этого мне не хватало.)"

# game/Story04.rpy:7099
translate russian story05_5_3_0ee54723:

    # mc "(Alone. With flowers? …What the hell is this?)"
    mc "(Один. С цветами? ...Что, чёрт возьми, происходит?)"

# game/Story04.rpy:7102
translate russian story05_5_3_23ac7b1d:

    # Go "..."
    Go "..."

# game/Story04.rpy:7104
translate russian story05_5_3_f1c9a6b3:

    # Go "{font=Cybertron.otf}You are as radiant as you were the day we parted, Viola.{/font} \n(You are as radiant as you were the day we parted, Viola.)"
    Go "{font=Cybertron.otf}Ты сияешь так же, как в день нашей разлуки, Виола.{/font} \n(Ты сияешь так же, как в день нашей разлуки, Виола.)"

# game/Story04.rpy:7106
translate russian story05_5_3_a2fedbd5:

    # mc "(What language is that? Third, I need you.)"
    mc "(Что это за язык? Третий, ты мне нужен.)"

# game/Story04.rpy:7108
translate russian story05_5_3_36508db0:

    # keep3 "Ancient Elvish. I’ve never heard it spoken aloud before."
    keep3 "Древнеэльфийский. Я никогда раньше не слышал его вслух."

# game/Story04.rpy:7109
translate russian story05_5_3_88498c70:

    # mc "Do you understand him?"
    mc "Ты его понимаешь?"

# game/Story04.rpy:7110
