translate russian story05_355c6886:

    # mc "Charging straight through, not thinking about consequences… not thinking about the people close to me."
    mc "Мчусь вперёд, не думая о последствиях... не думая о близких мне людях."

# game/Story04.rpy:258
translate russian story05_2fded262:

    # h "..."
    h "..."

# game/Story04.rpy:259
translate russian story05_cfff3b47:

    # mc "And the funniest part? From the very beginning…"
    mc "А самое смешное? С самого начала..."

