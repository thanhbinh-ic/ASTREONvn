translate russian story05_5_4_cbdf1bb6:

    # Go "(whispering) Half of our race."
    Go "(шёпотом) Половина нашей расы."

# game/Story04.rpy:7681
translate russian story05_5_4_822d419a:

    # Go "(whispering) Half of galaxy."
    Go "(шёпотом) Половина галактики."

# game/Story04.rpy:7682
translate russian story05_5_4_cb7eb722:

    # Go "(whispering) In a single heartbeat."
    Go "(шёпотом) За один удар сердца."

# game/Story04.rpy:7684
translate russian story05_5_4_1890a173:

    # mc "How…?"
    mc "Как...?"

# game/Story04.rpy:7685
translate russian story05_5_4_756bb34d:

    # keep3 "Payment."
    keep3 "Плата."

# game/Story04.rpy:7686
translate russian story05_5_4_42b74561:

    # keep3 "For power."
    keep3 "За силу."

# game/Story04.rpy:7690
translate russian story05_5_4_b57a10de:

    # keep3 "We didn’t realize…"
    keep3 "Мы не понимали..."

# game/Story04.rpy:7695
translate russian story05_5_4_9eac7e46:

    # keep3 "The Gates were still tethered to the System."
    keep3 "Врата всё ещё были привязаны к Системе."

# game/Story04.rpy:7696
translate russian story05_5_4_76588c2f:

    # keep3 "(That was our mistake.)"
    keep3 "(Это была наша ошибка.)"

# game/Story04.rpy:7701
translate russian story05_5_4_0094ddb6:

    # Go "Answer me this."
    Go "Ответь мне вот на что."

# game/Story04.rpy:7702
translate russian story05_5_4_87042096:

    # Go "Why is the blood of the Ancients required to activate a Gate?"
    Go "Почему для активации Врат нужна кровь Древних?"

# game/Story04.rpy:7704
translate russian story05_5_4_81297b39:

    # mc "It’s the only viable energy source."
    mc "Это единственный жизнеспособный источник энергии."

# game/Story04.rpy:7707
translate russian story05_5_4_4388f0b9:

    # Go "Correct."
    Go "Верно."

# game/Story04.rpy:7708
translate russian story05_5_4_0fdd036f:

    # Go "But why?"
    Go "Но почему?"

# game/Story04.rpy:7710
translate russian story05_5_4_d94b413c:

    # Go "Because it consumes life."
    Go "Потому что он поглощает жизнь."

# game/Story04.rpy:7711
translate russian story05_5_4_5bebf0d5:

    # Go "To spare your own."
    Go "Чтобы сохранить свою."

# game/Story04.rpy:7713
translate russian story05_5_4_2b35b6fe_1:

    # mc "..."
    mc "..."

# game/Story04.rpy:7715
translate russian story05_5_4_d8ed302e:

    # mc "Then answer me something."
    mc "Тогда ответь мне кое на что."

# game/Story04.rpy:7716
translate russian story05_5_4_38d7f3b3:

    # mc "If you had stood in his place…"
    mc "Если бы ты оказался на его месте..."

# game/Story04.rpy:7717
translate russian story05_5_4_a2b68c64:

    # mc "Would you have chosen differently?"
    mc "Ты бы выбрал иначе?"

# game/Story04.rpy:7719
translate russian story05_5_4_059e31ef:

    # Go "Knowing the whole truth?"
    Go "Зная всю правду?"

# game/Story04.rpy:7722
translate russian story05_5_4_447e1a11_1:

    # Go "Yes."
    Go "Да."

# game/Story04.rpy:7723
translate russian story05_5_4_e789ac9c:

    # Go "…Or at least, I would like to believe so."
    Go "...Или, по крайней мере, мне хотелось бы в это верить."

# game/Story04.rpy:7725
translate russian story05_5_4_2b35b6fe_2:

    # mc "..."
    mc "..."

# game/Story04.rpy:7726
translate russian story05_5_4_295112db:

    # mc "Even if the lives of those you love depended on it?"
    mc "Даже если бы от этого зависели жизни тех, кого ты любишь?"

# game/Story04.rpy:7727
translate russian story05_5_4_95e5a45b:

    # Go "There are rules."
    Go "Есть правила."

# game/Story04.rpy:7731
translate russian story05_5_4_07b93860:

    # mc "Rules are easy when you’re not the one losing someone."
    mc "Правила просты, когда теряешь не ты."

# game/Story04.rpy:7739
translate russian story05_5_4_c80a81cf:

    # Go "So that is what this is about…"
    Go "Так вот в чём дело…"

# game/Story04.rpy:7741
translate russian story05_5_4_c2930ae5:

    # mc "She wants her sister back."
    mc "Она хочет вернуть свою сестру."

# game/Story04.rpy:7743
translate russian story05_5_4_479f068d:

    # Go "She knows the risks."
    Go "Она знает о рисках."

# game/Story04.rpy:7747
translate russian story05_5_4_0c89a7cd:

    # am "Go. Find Gorem."
    am "Иди. Найди Горема."

# game/Story04.rpy:7748
translate russian story05_5_4_fe5b2af0:

    # am "I’ll handle the rest."
    am "С остальным я разберусь."

# game/Story04.rpy:7752
translate russian story05_5_4_3b753126:

    # mc "I don’t think she understands them."
    mc "Не думаю, что она их понимает."

# game/Story04.rpy:7753
translate russian story05_5_4_7f08e5f1:

    # mc "Not really."
    mc "Не по-настоящему."

# game/Story04.rpy:7755
translate russian story05_5_4_971fd8c0:

    # Go "Did she grow afraid of her own choices?"
    Go "Она испугалась собственного выбора?"

# game/Story04.rpy:7757
translate russian story05_5_4_2034c056:

    # mc "Maybe."
    mc "Возможно."

# game/Story04.rpy:7758
translate russian story05_5_4_086f7e4e:

    # mc "Or maybe…"
    mc "А может…"

# game/Story04.rpy:7763
translate russian story05_5_4_99d399b1:

    # L "Astoria and I are trying to choose the one..."
    L "Мы с Асторией пытаемся выбрать тот..."

# game/Story04.rpy:7764
translate russian story05_5_4_221faad5:

    # L "Where everyone keeps what matters to them."
    L "Где каждый сохранит то, что ему дорого."

# game/Story04.rpy:7768
translate russian story05_5_4_8114117d:

    # mc "There’s still something human left in her."
    mc "В ней всё ещё осталось что-то человеческое."

# game/Story04.rpy:7769
translate russian story05_5_4_b887b7f4:

    # mc "(whispering) I hope so."
    mc "(шёпотом) Надеюсь."

# game/Story04.rpy:7775
translate russian story05_5_4_491f58a8:

    # elf "Aran nín, thang veleg dâf! \n(Your Highness, we have a problem!)"
    elf "Aran nín, thang veleg dâf! \n(Ваше Высочество, у нас проблема!)"

# game/Story04.rpy:7776
translate russian story05_5_4_7fe3f58c:

    # Go "Man danna? \n(What happened?)"
    Go "Man danna? \n(Что случилось?)"

# game/Story04.rpy:7777
translate russian story05_5_4_22d705df:

    # elf "I sell, hi— \n(The girl, she—)"
    elf "I sell, hi— \n(Девушка, она—)"

# game/Story04.rpy:7795
translate russian story05_5_4_efb9a313:

    # ketr "Ánin… ú-aníron baded… \n(Please… I don’t want to die…)"
    ketr "Ánin… ú-aníron baded… \n(Пожалуйста… я не хочу умирать…)"

# game/Story04.rpy:7796
translate russian story05_5_4_82091822:

    # k "..."
    k "..."

# game/Story04.rpy:7803
translate russian story05_5_4_baf2b1b9:

    # elf "An i lû i echant... \n(When she woke up...)"
    elf "An i lû i echant... \n(Когда она очнулась...)"

# game/Story04.rpy:7804
translate russian story05_5_4_1a0f3305:

    # elf "Hîr i naur glam a dantha Ketrin na gîl. \n(She grabbed a shard of glass and immediately took Ketrin hostage.)"
    elf "Hîr i naur glam a dantha Ketrin na gîl. \n(Она схватила осколок стекла и сразу взяла Кетрин в заложницы.)"

# game/Story04.rpy:7809
translate russian story05_5_4_2316d835:

    # Go "Drego i peng. \n(Lower your weapons.)"
    Go "Drego i peng. \n(Опустите оружие.)"

