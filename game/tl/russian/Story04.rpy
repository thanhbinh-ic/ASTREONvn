translate russian story05_5_3_826b5892:

    # mc "Meaning?"
    mc "В смысле?"

# game/Story04.rpy:6928
translate russian story05_5_3_0c5752be:

    # keep3 "Two factors."
    keep3 "Два фактора."

# game/Story04.rpy:6929
translate russian story05_5_3_2268eb81:

    # keep3 "Not financially viable."
    keep3 "Финансово нецелесообразны."

# game/Story04.rpy:6930
translate russian story05_5_3_152a1d37:

    # keep3 "And…"
    keep3 "И..."

# game/Story04.rpy:6932
translate russian story05_5_3_b0566b1a:

    # keep3 "The elves are the only ones capable of reinstalling implants."
    keep3 "Только эльфы способны переустанавливать импланты."

# game/Story04.rpy:6933
translate russian story05_5_3_7c548846:

    # keep3 "And relations with them… are strained."
    keep3 "А отношения с ними... напряжённые."

# game/Story04.rpy:6935
translate russian story05_5_3_8e84bfe9:

    # mc "I figured."
    mc "Я так и думал."

# game/Story04.rpy:6940
translate russian story05_5_3_c8ac0829:

    # mc "(Ammo’s intact. Count…)"
    mc "(Боезапас цел. Количество...)"

