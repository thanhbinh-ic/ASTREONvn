translate russian story05_5_4_1984ad90:

    # Go "We’ll continue later."
    Go "Мы продолжим позже."

# game/Story04.rpy:7863
translate russian story05_5_4_099869e7:

    # "Few minutes later."
    "Несколько минут спустя."

# game/Story04.rpy:7868
translate russian story05_5_4_b97d5541:

    # mc "How do you feel?"
    mc "Как ты себя чувствуешь?"

# game/Story04.rpy:7870
translate russian story05_5_4_d5dcf025:

    # k "Well, I can joke."
    k "Ну, шутить я могу."

# game/Story04.rpy:7871
translate russian story05_5_4_46db7444:

    # k "Brain’s a little scrambled though."
    k "Хотя мозги немного перемешались."

# game/Story04.rpy:7872
translate russian story05_5_4_96007ccf:

    # k "If it wasn’t for the hole in my chest, I’d say I’m fantastic."
    k "Если бы не дыра в груди, сказала бы, что я в полном порядке."

# game/Story04.rpy:7877
translate russian story05_5_4_148ed410:

    # k "On the bright side…"
    k "Зато есть и хорошая сторона…"

# game/Story04.rpy:7878
translate russian story05_5_4_49b2ab41:

    # k "I’ve got one extra hole now."
    k "Теперь у меня на одну дырку больше."

# game/Story04.rpy:7880
translate russian story05_5_4_0054e596:

    # mc "You’re serious?"
    mc "Ты серьёзно?"

# game/Story04.rpy:7886
translate russian story05_5_4_701f9418:

    # k "Knew you’d love that one."
    k "Знала, что тебе понравится."

# game/Story04.rpy:7890
translate russian story05_5_4_c28b4c97:

    # mc "(whispering) You never change…"
    mc "(шёпотом) Ты никогда не меняешься…"

# game/Story04.rpy:7892
translate russian story05_5_4_e6f4db0e:

    # k "Oh, look at that face."
    k "Ох, только посмотри на это лицо."

# game/Story04.rpy:7893
translate russian story05_5_4_65856b10:

    # k "All broody and tragic."
    k "Такое мрачное и трагичное."

# game/Story04.rpy:7894
translate russian story05_5_4_079ff3b5:

    # k "Is that supposed to be charming?"
    k "Это должно быть очаровательно?"

# game/Story04.rpy:7896
translate russian story05_5_4_3fae39b4:

    # mc "I didn’t say that."
    mc "Я этого не говорил."

# game/Story04.rpy:7899
translate russian story05_5_4_ee2f0821:

    # k "(mocking his voice) Don’t die. I won’t let you die."
    k "(передразнивая его голос) Не умирай. Я не позволю тебе умереть."

# game/Story04.rpy:7900
translate russian story05_5_4_77d8f3e9:

    # k "God, you should’ve seen your face."
    k "Боже, видел бы ты своё лицо."

# game/Story04.rpy:7903
translate russian story05_5_4_2a3ae760:

    # k "What was that expression?"
    k "Что это вообще было за выражение?"

# game/Story04.rpy:7904
translate russian story05_5_4_f2bcf34e:

    # k "You looked like the world was ending."
    k "Ты выглядел так, будто миру конец."

# game/Story04.rpy:7908
translate russian story05_5_4_fbf854f4:

    # mc "Time was measured in seconds."
    mc "Время шло на секунды."

# game/Story04.rpy:7910
translate russian story05_5_4_d3412f0b:

    # mc "Managing my emotions on top of that…"
    mc "А ещё держать эмоции под контролем…"

# game/Story04.rpy:7911
translate russian story05_5_4_4a4a9b87:

    # mc "Wasn’t exactly feasible."
    mc "Было не особо реально."

# game/Story04.rpy:7913
translate russian story05_5_4_2b35b6fe_3:

    # mc "..."
    mc "..."

# game/Story04.rpy:7923
translate russian story05_5_4_bbfa73d3:

    # k "Hey… [mc]?"
    k "Эй… [mc]?"

# game/Story04.rpy:7925
translate russian story05_5_4_582359ea:

    # mc "Hm?"
    mc "Хм?"

# game/Story04.rpy:7927
translate russian story05_5_4_2b922a7d:

    # k "Thanks."
    k "Спасибо."

# game/Story04.rpy:7933
translate russian story05_5_4_ccc941be:

    # mc "You’re welcome."
    mc "Пожалуйста."

# game/Story04.rpy:7936
translate russian story05_5_4_4458056b:

    # k "Congratulations."
    k "Поздравляю."

# game/Story04.rpy:7937
translate russian story05_5_4_ae2a9e36:

    # k "You’ve secured third place."
    k "Ты закрепил за собой третье место."

# game/Story04.rpy:7938
translate russian story05_5_4_7f67156e:

    # k "In the ranking of the most important people in my life."
    k "В рейтинге самых важных людей в моей жизни."

# game/Story04.rpy:7940
translate russian story05_5_4_5161cd10:

    # mc "I’m honored."
    mc "Для меня это честь."

# game/Story04.rpy:7941
translate russian story05_5_4_efb5bf40:

    # mc "What’s the prize?"
    mc "А какой приз?"

# game/Story04.rpy:7948
translate russian story05_5_4_406ca583:

    # k "Haven’t decided yet."
    k "Ещё не решила."

# game/Story04.rpy:7952
translate russian story05_5_4_c64803ba:

    # mc "Sorry I…"
    mc "Прости, что я…"

# game/Story04.rpy:7953
translate russian story05_5_4_ed70c4c2:

    # mc "Disfigured you—"
    mc "Изуродовал тебя—"

# game/Story04.rpy:7955
translate russian story05_5_4_78df62db:

    # k "I like it."
    k "Мне нравится."

# game/Story04.rpy:7956
translate russian story05_5_4_280915bd:

    # k "Makes me feel like I matter to someone."
    k "Так я чувствую, что для кого-то что-то значу."

# game/Story04.rpy:7957
translate russian story05_5_4_43c1f242:

    # k "Like someone was actually afraid to lose me."
    k "Будто кто-то правда боялся меня потерять."

# game/Story04.rpy:7962
translate russian story05_5_4_278af78f:

    # k "(whispering) Where are we?"
    k "(шёпотом) Где мы?"

# game/Story04.rpy:7964
translate russian story05_5_4_0ffe9dab:

    # mc "Still working on that."
    mc "Я ещё пытаюсь понять."

# game/Story04.rpy:7965
translate russian story05_5_4_d645cf27:

    # mc "There’s a strong chance we were thrown backward."
    mc "Есть большая вероятность, что нас отбросило назад."

# game/Story04.rpy:7966
translate russian story05_5_4_1fecf7ef:

    # mc "In time."
    mc "Во времени."

# game/Story04.rpy:7968
translate russian story05_5_4_26ee2b70:

    # k "(whispering) Wasn’t it a little early to trust them?"
    k "(шёпотом) Не рановато было им доверять?"

# game/Story04.rpy:7970
translate russian story05_5_4_08b08bf4:

    # mc "I wasn’t given much of a choice."
    mc "У меня не было особого выбора."

# game/Story04.rpy:7971
translate russian story05_5_4_7477892d:

    # mc "But they haven’t shown aggression."
    mc "Но они не проявляли агрессии."

# game/Story04.rpy:7973
translate russian story05_5_4_61651870:

    # k "Which somehow makes it worse."
    k "И от этого почему-то только хуже."

# game/Story04.rpy:7975
translate russian story05_5_4_caf9ce28:

    # mc "They saved you."
    mc "Они спасли тебя."

# game/Story04.rpy:7976
translate russian story05_5_4_4ad6cc31:

    # mc "That earns them… a fraction of trust."
    mc "Это даёт им… крупицу доверия."

# game/Story04.rpy:7980
translate russian story05_5_4_f8ba76d7:

    # k "Alright. If you say so."
    k "Ладно. Как скажешь."

# game/Story04.rpy:7981
translate russian story05_5_4_66658c40:

    # k "Just… don’t lose your head over them."
    k "Только… не теряй из-за них голову."

# game/Story04.rpy:7987
translate russian story05_5_4_8e6cd7ac:

    # mc "Want to look around?"
    mc "Хочешь осмотреться?"

# game/Story04.rpy:7989
translate russian story05_5_4_b621322b:

    # k "Sure."
    k "Конечно."

# game/Story04.rpy:7990
translate russian story05_5_4_1d6691e5:

    # k "But first, I need new clothes."
    k "Но сначала мне нужна новая одежда."

# game/Story04.rpy:7992
translate russian story05_5_4_2f85716f:

    # k "And a bath."
    k "И ванна."

# game/Story04.rpy:7994
translate russian story05_5_4_4484b017:

    # k "Want to check if I smell?"
    k "Хочешь проверить, пахнет ли от меня?"

# game/Story04.rpy:7996
translate russian story05_5_4_4f22aa68:

    # mc "I’ll pass."
    mc "Пожалуй, откажусь."

