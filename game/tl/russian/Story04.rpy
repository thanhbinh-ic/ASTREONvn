translate russian story05_2aa723f4:

    # mc "(The feelings I had back then… those memories…)"
    mc "(Чувства, которые я тогда испытывал... Эти воспоминания...)"

# game/Story04.rpy:339
translate russian story05_f9f9f109:

    # mc "(Memories?)"
    mc "(Воспоминания?)"

# game/Story04.rpy:340
translate russian story05_757a8ac4:

    # mc "(Wait… Could it be… the implants are back to normal?)"
    mc "(Подожди... Может... импланты снова в норме?)"

