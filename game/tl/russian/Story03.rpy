translate russian akt3chapter2_2_02cfa38c:

    # a "We are weapons. Forged sisters clash, sparks are expected."
    a "Мы оружие. Когда выкованные сестры сталкиваются, искры неизбежны."

# game/Story03.rpy:2856
translate russian akt3chapter2_2_53c38082:

    # k "But when the time comes, we’ll fall together. No doubts. Right?"
    k "Но когда придет час, мы падем вместе. Без сомнений. Верно?"

# game/Story03.rpy:2867
translate russian akt3chapter2_2_103699df:

    # gg "They took our people, let them pay in full."
    gg "Они забрали наших людей. Пусть заплатят сполна."

# game/Story03.rpy:2910
translate russian akt3chapter2_2_1c59acdd:

    # mc "Let them come."
    mc "Пусть приходят."

# game/Story03.rpy:2919
translate russian akt3chapter2_2_5af9b061:

    # mc "I’m ready."
    mc "Я готов."

# game/Story03.rpy:2921
translate russian akt3chapter2_2_740b22b2:

    # mc "(You’ve already lost your son… and you’re not losing anyone else.)"
    mc "(Ты уже потерял сына... и больше никого не потеряешь.)"

# game/Story03.rpy:2931
translate russian akt3chapter2_2_d8ad6ad0:

    # k "Stick close, hero. Die later, I hate being bored."
    k "Держись рядом, герой. Умрешь позже - я не люблю скучать."

# game/Story03.rpy:2946
translate russian akt3chapter2_2_9649516a:

    # k "Wasn’t planning to. But if you need it that badly, you looked almost worthy. Briefly."
    k "И не собиралась. Но если тебе это так нужно, ты почти выглядел достойно. На миг."

# game/Story03.rpy:2951
translate russian akt3chapter2_2_522a3d44:

    # mc "Last one."
    mc "Последний."

# game/Story03.rpy:2961
translate russian akt3chapter2_2_5bcfe907:

    # gg "Move! Like we trained, no wasted steps!"
    gg "Двигайтесь! Как на тренировках, без лишних шагов!"

# game/Story03.rpy:2974
translate russian akt3chapter2_2_f2c813e3:

    # gg "The rest, toward the corridor. Hustle, or I’ll finish you off myself!"
    gg "Остальные - к коридору. Шевелитесь, или я прикончу вас лично!"

# game/Story03.rpy:2988
translate russian akt3chapter3_debcd0a0:

    # "Sector 4. A ventilation shaft."
    "Сектор 4. Вентиляционная шахта."

# game/Story03.rpy:2989
translate russian akt3chapter3_8213ea34:

    # mc "I won’t pretend this is okay."
    mc "Я не стану делать вид, что все в порядке."

# game/Story03.rpy:3016
translate russian akt3chapter3_af24c268:

    # mc "(Yeah, and I’ll be your human shield again, when you run out of ammo.)"
    mc "(Ага, а когда у тебя кончатся патроны, я снова стану твоим живым щитом.)"

# game/Story03.rpy:3027
translate russian akt3chapter3_caffef16:

    # k "Keep your head up."
    k "Голову выше."

# game/Story03.rpy:3035
translate russian akt3chapter3_dc0e3738:

    # k "Always a pleasure."
    k "Всегда к вашим услугам."

# game/Story03.rpy:3042
translate russian akt3chapter3_8c9c7f34:

    # mc "You know something."
    mc "Ты что-то знаешь."

# game/Story03.rpy:3046
translate russian akt3chapter3_86782263:

    # mc "About them."
    mc "О них."

# game/Story03.rpy:3048
translate russian akt3chapter3_9a838154:

    # R "They think we’re behind this?"
    R "Они думают, что это мы устроили?"

# game/Story03.rpy:3101
translate russian akt3chapter3_f413af47:

    # mc "(He’s nervous… and it’s not the Inquisition.)"
    mc "(Он нервничает... и не из-за Инквизиции.)"

# game/Story03.rpy:3104
translate russian akt3chapter3_77448e7a:

    # mc "He found something, didn’t he?"
    mc "Он что-то нашел, да?"

# game/Story03.rpy:3106
translate russian akt3chapter3_d45b13c5:

    # mc "So you’re telling me, you know where they came from?"
    mc "То есть ты хочешь сказать, что знаешь, откуда они взялись?"

# game/Story03.rpy:3113
translate russian akt3chapter3_a6a65767:

    # a "Soulless... because there was a soul. Before the gate took it."
    a "Бездушные... потому что душа у них была. До того, как Врата ее забрали."

# game/Story03.rpy:3120
translate russian akt3chapter3_24a5a506:

    # mc "(All this time...)"
    mc "(Все это время...)"

# game/Story03.rpy:3158
translate russian akt3chapter3_6b642644:

    # mc "(They weren’t monsters.)"
    mc "(Они не были чудовищами.)"

# game/Story03.rpy:3162
translate russian akt3chapter3_2b15474b:

    # mc "...You knew."
    mc "...Ты знала."

# game/Story03.rpy:3164
translate russian akt3chapter3_b15d94ce:

    # mc "All of you."
    mc "Все вы."

# game/Story03.rpy:3165
translate russian akt3chapter3_e176a807:

    # a "People die over less."
    a "Люди умирают и за меньшее."

# game/Story03.rpy:3173
translate russian akt3chapter3_fd0357d3:

    # mc "(So that’s it.)"
    mc "(Вот оно что.)"

# game/Story03.rpy:3175
translate russian akt3chapter3_cba3f744:

    # mc "(Say the truth, and you disappear.)"
    mc "(Скажешь правду - исчезнешь.)"

# game/Story03.rpy:3181
translate russian akt3chapter3_62356372:

    # mc "Now I get it."
    mc "Теперь я понял."

# game/Story03.rpy:3184
translate russian akt3chapter3_5307f7d0:

    # mc "Lora wasn’t broken."
    mc "Лора не сама сломалась."

# game/Story03.rpy:3186
translate russian akt3chapter3_3a9fe4df:

    # mc "You did that to her."
    mc "Это вы с ней сделали."

# game/Story03.rpy:3188
translate russian akt3chapter3_c98ab144:

    # mc "...Not happening to me."
    mc "...Со мной этого не будет."

# game/Story03.rpy:3191
translate russian akt3chapter3_e9ad328d:

    # k "(And I don’t like people breaking my toys without warning.)"
    k "(И я не люблю, когда мои игрушки ломают без предупреждения.)"

# game/Story03.rpy:3208
translate russian akt3chapter3_a97711f4:

    # k "(Pain without rhythm is just noise.)"
    k "(Боль без ритма - всего лишь шум.)"

# game/Story03.rpy:3221
translate russian akt3chapter3_bbf7cf59:

    # k "So? Boiling yet?"
    k "Ну что? Уже закипаешь?"

# game/Story03.rpy:3228
translate russian akt3chapter3_f8a33d04:

    # k "(Angry? Good. I can feel it from here.)"
    k "(Злишься? Хорошо. Я отсюда чувствую.)"

# game/Story03.rpy:3231
translate russian akt3chapter3_5ea271a9:

    # mc "(I thought I finally found someone I could trust.)"
    mc "(Я думал, что наконец нашел того, кому могу доверять.)"

# game/Story03.rpy:3233
translate russian akt3chapter3_78b62800:

    # mc "(...Wrong.)"
    mc "(...Ошибся.)"

# game/Story03.rpy:3235
translate russian akt3chapter3_2b15474b_1:

    # mc "...You knew."
    mc "...Ты знала."

# game/Story03.rpy:3237
translate russian akt3chapter3_57c62461:

    # mc "And you said nothing."
    mc "И ничего не сказала."

# game/Story03.rpy:3240
translate russian akt3chapter3_0634651e:

    # k "Oh? Curtain’s up already? Spare me the tragedy."
    k "О? Занавес уже поднят? Избавь меня от трагедии."

# game/Story03.rpy:3243
translate russian akt3chapter3_3085095d:

    # mc "So that’s it."
    mc "Значит, вот как."

# game/Story03.rpy:3244
translate russian akt3chapter3_48f75eee:

    # mc "Everyone knew."
    mc "Все знали."

# game/Story03.rpy:3246
translate russian akt3chapter3_8a4f514c:

    # mc "...Except me."
    mc "...Кроме меня."

# game/Story03.rpy:3252
translate russian akt3chapter3_1e1b51c3:

    # k "(Try saying it once, 'I failed.')"
    k "(Попробуй хоть раз сказать: \"Я провалилась.\")"

# game/Story03.rpy:3263
translate russian akt3chapter3_55cfb131:

    # k "(No? Of course not. You always did overact.)"
    k "(Нет? Конечно нет. Ты всегда переигрывала.)"

# game/Story03.rpy:3266
translate russian akt3chapter3_33dd240d:

    # k "(Here we go again, dancing around conscience.)"
    k "(Вот опять - танцы вокруг совести.)"

# game/Story03.rpy:3269
translate russian akt3chapter3_fb9245ea:

    # k "Please. Kill me already."
    k "Прошу. Убей меня уже."

# game/Story03.rpy:3273
translate russian akt3chapter3_048b5630:

    # k "As adorable as this panic attack is, who’s flying this winged coffin?"
    k "Как бы ни была мила эта паническая атака, кто ведет этот крылатый гроб?"

# game/Story03.rpy:3283
translate russian akt3chapter3_c919e9fa:

    # mc "Wait, don’t tell me... no one’s flying this thing?"
    mc "Стой, только не говори мне... никто не умеет пилотировать эту штуку?"

# game/Story03.rpy:3286
translate russian akt3chapter3_bcb93426:

    # mc "...Never done this."
    mc "...Никогда этим не занимался."

# game/Story03.rpy:3308
translate russian akt3chapter3_480890f2:

    # mc "I’ll manage."
    mc "Справлюсь."

# game/Story03.rpy:3322
translate russian akt3chapter3_c8a894ae:

    # mc "(Then why lie to me?)"
    mc "(Тогда зачем было мне лгать?)"

# game/Story03.rpy:3424
translate russian akt3chapter3_36041560:

    # k "(I couldn’t, okay? If you’d found out then, it would’ve torn you apart.)"
    k "(Я не могла, ясно? Узнай ты тогда - тебя бы разорвало на части.)"

# game/Story03.rpy:3426
translate russian akt3chapter3_79d64210:

    # k "We’re not machines."
    k "Мы не машины."

# game/Story03.rpy:3437
translate russian akt3chapter3_826e6b17:

    # k "We breathe, we feel… and we break."
    k "Мы дышим, чувствуем... и ломаемся."

# game/Story03.rpy:3445
translate russian akt3chapter3_816a1c65:

    # k "So yeah, sorry I lied."
    k "Так что да. Прости, что солгала."

# game/Story03.rpy:3451
translate russian akt3chapter3_0b17be9e:

    # mc "...I get it."
    mc "...Я понимаю."

# game/Story03.rpy:3453
translate russian akt3chapter3_b4e4f80b:

    # mc "Doesn’t make it easier."
    mc "Но легче от этого не становится."

# game/Story03.rpy:3458
translate russian akt3chapter3_404a266a:

    # k "Move before I regret explaining myself."
    k "Идем, пока я не пожалела, что вообще объяснялась."

# game/Story03.rpy:3466
translate russian akt3chapter3_1_8f65b5a8:

    # "Sector 4-S. Warehouse area."
    "Сектор 4-S. Складская зона."

# game/Story03.rpy:3469
translate russian akt3chapter3_1_c060c641:

    # mc "(Wouldn’t be surprised if the corpses are still here.)"
    mc "(Не удивлюсь, если трупы все еще здесь.)"

# game/Story03.rpy:3472
translate russian akt3chapter3_1_4eb225e8:

    # mc "(Just… better hidden.)"
    mc "(Просто... лучше спрятаны.)"

# game/Story03.rpy:3475
translate russian akt3chapter3_1_f149133f:

    # mc "Why me. Specifically?"
    mc "Почему именно я?"

# game/Story03.rpy:3488
translate russian akt3chapter3_1_2bd5e0d8:

    # mc "You don’t look like you need help."
    mc "Ты не похож на того, кому нужна помощь."

# game/Story03.rpy:3492
translate russian akt3chapter3_1_db25554c:

    # g "Can. But with you, it’s faster."
    g "Могу. Но с тобой быстрее."

# game/Story03.rpy:3495
translate russian akt3chapter3_1_83fd040a:

    # k "(Going with him? Brave.)"
    k "(Идешь с ним? Смело.)"

# game/Story03.rpy:3499
translate russian akt3chapter3_1_6abb0a67:

    # k "(Or just stupid.)"
    k "(Или просто глупо.)"

# game/Story03.rpy:3504
translate russian akt3chapter3_1_9b9c96f0:

    # mc "(Do I even have a choice?)"
    mc "(У меня вообще есть выбор?)"

# game/Story03.rpy:3507
translate russian akt3chapter3_1_77f1e2ff:

    # mc "He reminds me of you."
    mc "Он напоминает мне тебя."

# game/Story03.rpy:3511
translate russian akt3chapter3_1_36338f19:

    # mc "When you stop pretending."
    mc "Когда ты перестаешь притворяться."

# game/Story03.rpy:3514
translate russian akt3chapter3_1_de2b2888:

    # k "Difference is, I don’t lie about my intentions."
    k "Разница в том, что я свои намерения не скрываю."

# game/Story03.rpy:3516
translate russian akt3chapter3_1_4ceeb90e:

    # gg "Catch. You hear even one step behind you, use it."
    gg "Лови. Услышишь за спиной хоть один шаг - используй."

# game/Story03.rpy:3529
translate russian akt3chapter3_1_3432103f:

    # g "First sign, we run."
    g "Первый же признак - бежим."

# game/Story03.rpy:3537
translate russian akt3chapter3_1_6ada3060:

    # mc "So."
    mc "Итак."

# game/Story03.rpy:3551
translate russian akt3chapter3_1_5164590e:

    # mc "Why me?"
    mc "Почему я?"

# game/Story03.rpy:3553
translate russian akt3chapter3_1_27bb7259:

    # mc "Say it."
    mc "Скажи."

# game/Story03.rpy:3592
translate russian akt3chapter3_1_db1d03c7:

    # mc "(One life… or everyone else.)"
    mc "(Одна жизнь... или все остальные.)"

# game/Story03.rpy:3610
translate russian akt3chapter3_1_16411555:

    # mc "(No.)"
    mc "(Нет.)"

# game/Story03.rpy:3612
translate russian akt3chapter3_1_28dcbde3:

    # mc "I had a son."
    mc "У меня был сын."

# game/Story03.rpy:3639
translate russian akt3chapter3_1_a2273163:

    # mc "...Same story."
    mc "...Та же история."

# game/Story03.rpy:3641
translate russian akt3chapter3_1_c5febbf9:

    # mc "...What did you do?"
    mc "...Что ты сделал?"

# game/Story03.rpy:3670
translate russian akt3chapter3_1_d007d27d:

    # mc "He was our pilot."
    mc "Он был нашим пилотом."

# game/Story03.rpy:3673
translate russian akt3chapter3_1_5c30b45c:

    # mc "(Control.)"
    mc "(Контроль.)"

# game/Story03.rpy:3676
translate russian akt3chapter3_1_9baa6b07:

    # mc "He was the only one who could fly this."
    mc "Он был единственным, кто мог управлять этой штукой."

# game/Story03.rpy:3680
translate russian akt3chapter3_1_275722e5:

    # mc "...You’re serious."
    mc "...Ты серьезно."

# game/Story03.rpy:3688
translate russian akt3chapter3_1_d209f981:

    # mc "I’ve never done this."
    mc "Я никогда этого не делал."

# game/Story03.rpy:3690
translate russian akt3chapter3_1_c50e415b:

    # mc "And him?"
    mc "А он?"

# game/Story03.rpy:3695
translate russian akt3chapter3_1_1a8e1d62:

    # mc "What do we tell them?"
    mc "Что мы им скажем?"

# game/Story03.rpy:3698
translate russian akt3chapter3_1_50ee686b:

    # k "(Well, well. Look who's back with news. Only one of them, ain’t a hero anymore.)"
    k "(Ну надо же. Смотрите, кто вернулся с новостями. Один вернулся - уже не герой.)"

# game/Story03.rpy:3718
translate russian akt3chapter3_1_1f0bd129:

    # mc "...You’re serious?"
    mc "...Ты серьезно?"

# game/Story03.rpy:3719
translate russian akt3chapter3_1_97534b87:

    # mc "I’ve never flown anything."
    mc "Я никогда ничем не управлял в воздухе."

# game/Story03.rpy:3720
translate russian akt3chapter3_1_46a250e6:

    # mc "Tried a simulator once as a kid… didn’t make it halfway."
    mc "В детстве один раз пробовал симулятор... даже до середины не дошел."

# game/Story03.rpy:3723
translate russian akt3chapter3_1_8ceca8bf:

    # mc "You killed our way out."
    mc "Ты убил наш выход отсюда."

# game/Story03.rpy:3731
translate russian akt3chapter3_1_c588f656:

    # mc "(...Just like that.)"
    mc "(...Вот так просто.)"

# game/Story03.rpy:3754
translate russian akt3chapter3_1_9e6f11df:

    # mc "Me?"
    mc "Я?"

# game/Story03.rpy:3766
translate russian akt3chapter3_1_31aeaa32:

    # mc "I drove trucks. Not this."
    mc "Я водил грузовики. Не вот это."

# game/Story03.rpy:3770
translate russian akt3chapter3_1_7cac32ac:

    # mc "(...There she is.)"
    mc "(...Вот она.)"

# game/Story03.rpy:3784
translate russian akt3chapter3_1_16a0fdf0:

    # gg "He was a friend. Yeah, impulsive, but he didn’t deserve a bullet in the back."
    gg "Он был другом. Да, вспыльчивым, но пули в спину он не заслужил."

# game/Story03.rpy:3786
translate russian akt3chapter3_1_97438224:

    # a "If needed, both."
    a "Если потребуется - и то, и другое."

# game/Story03.rpy:3791
translate russian akt3chapter3_1_fd22e77e:

    # mc "...No."
    mc "...Нет."

# game/Story03.rpy:3792
translate russian akt3chapter3_1_71904949:

    # mc "I’m not doing it."
    mc "Я не буду."

# game/Story03.rpy:3795
translate russian akt3chapter3_1_ee01286a:

    # mc "If I fly, someone lives."
    mc "Если я взлечу, кто-то выживет."

# game/Story03.rpy:3803
translate russian akt3chapter3_1_6a8b7c10:

    # mc "If I walk away, we’re all dead."
    mc "Если я уйду, мы все умрем."

# game/Story03.rpy:3805
translate russian akt3chapter3_1_8ac00661:

    # mc "...I’ll do it."
    mc "...Я сделаю это."

# game/Story03.rpy:3809
translate russian akt3chapter3_1_4610aef8:

    # mc "And that blood better not be wasted."
    mc "И пусть эта кровь не будет пролита зря."

# game/Story03.rpy:3823
translate russian akt3chapter3_1_605a7f54:

    # mc "(Don’t screw this up...)"
    mc "(Не облажайся...)"

# game/Story03.rpy:3834
translate russian akt3chapter3_1_bf4958b8:

    # mc "(Where’s the panel...?)"
    mc "(Где панель...?)"

# game/Story03.rpy:3837
translate russian akt3chapter3_1_5585f944:

    # mc "(Too many switches...)"
    mc "(Слишком много переключателей...)"

# game/Story03.rpy:3838
translate russian akt3chapter3_1_097158fe:

    # mc "(Start?.. Looks like it.)"
    mc "(Запуск?.. Похоже на то.)"

# game/Story03.rpy:3843
translate russian akt3chapter3_1_813c7211:

    # mc "(Got it. Turbines...)"
    mc "(Есть. Турбины...)"

# game/Story03.rpy:3844
translate russian akt3chapter3_1_ab629576:

    # mc "(Come on...)"
    mc "(Давай...)"

# game/Story03.rpy:3847
translate russian akt3chapter3_1_280e5c12:

    # mc "(...No.)"
    mc "(...Нет.)"

# game/Story03.rpy:3848
translate russian akt3chapter3_1_2af83fc1:

    # mc "(Not now.)"
    mc "(Только не сейчас.)"

# game/Story03.rpy:3851
translate russian akt3chapter3_1_12d7d528:

    # mc "Pull it."
    mc "Тяни."

# game/Story03.rpy:3897
translate russian akt3chapter3_1_32691724:

    # mc "If we wait, we’re dead anyway."
    mc "Если будем ждать, все равно умрем."

# game/Story03.rpy:3900
translate russian akt3chapter3_1_46cdda5b:

    # mc "(Too many lives on this...)"
    mc "(Слишком много жизней на кону...)"

# game/Story03.rpy:3910
translate russian akt3chapter3_1_0814eb95:

    # mc "(Focus.)"
    mc "(Сосредоточься.)"

# game/Story03.rpy:3913
translate russian akt3chapter3_1_e8991f85:

    # mc "(There you are...)"
    mc "(Вот ты где...)"

# game/Story03.rpy:3914
translate russian akt3chapter3_1_ab629576_1:

    # mc "(Come on...)"
    mc "(Давай...)"

# game/Story03.rpy:3918
translate russian akt3chapter3_2_180af67f:

    # mc "Miriel—"
    mc "Мириэль-"

# game/Story03.rpy:4112
translate russian akt3chapter3_3_2226b703:

    # "Sector 3-S."
    "Сектор 3-S."

# game/Story03.rpy:4135
translate russian akt3chapter3_3_673f5ea4:

    # Fl "If you’re not some Empire-flash, get lost."
    Fl "Если это не срочное сообщение Империи, проваливай."

# game/Story03.rpy:4140
translate russian akt3chapter3_3_08fc1af8:

    # Fl "No."
    Fl "Нет."

# game/Story03.rpy:4148
translate russian akt3chapter3_3_a76dc049:

    # Fl "Let my whole damn bloodline burn, but I’m finishing this!"
    Fl "Да пусть весь мой проклятый род сгорит, но я это закончу!"

# game/Story03.rpy:4162
translate russian akt3chapter3_3_c9a87a94:

    # em "Came to check the genius hasn’t burned herself out in her own chains."
    em "Пришла проверить, не сгорела ли гениальная девочка в собственных цепях."

# game/Story03.rpy:4166
translate russian akt3chapter3_3_00a0b108:

    # Fl "To them, I’m just the girl who signed the death warrant for hundreds, oh, sorry, thousands. Classic, right?"
    Fl "Для них я просто девчонка, подписавшая смертный приговор сотням... ой, прости, тысячам. Классика, да?"

# game/Story03.rpy:4175
translate russian akt3chapter3_3_f2bb268e:

    # em "In exchange for hundred thousand mutants."
    em "В обмен на сто тысяч мутантов."

# game/Story03.rpy:4178
translate russian akt3chapter3_3_8d3f7461:

    # Fl "At the cost of almost everyone who still believed in my father."
    Fl "Ценой почти всех, кто еще верил в моего отца."

# game/Story03.rpy:4180
translate russian akt3chapter3_3_85559fbf:

    # em "We’re all going to die, Flora."
    em "Мы все умрем, Флора."

# game/Story03.rpy:4181
translate russian akt3chapter3_3_bd83b348:

    # em "The question is how we lived."
    em "Вопрос в том, как мы жили."

# game/Story03.rpy:4185
translate russian akt3chapter3_3_2a362a0c:

    # em "...They died as heroes."
    em "...Они умерли героями."

# game/Story03.rpy:4189
translate russian akt3chapter3_3_d49eeb22:

    # Fl "To watch it all spiral into the gate."
    Fl "Чтобы смотреть, как все это затягивает во Врата."

# game/Story03.rpy:4192
translate russian akt3chapter3_3_32747935:

    # Fl "To watch everything they fought for get erased."
    Fl "Смотреть, как стирают все, за что они сражались."

# game/Story03.rpy:4193
translate russian akt3chapter3_3_83da2052:

    # Fl "To watch no one be held accountable."
    Fl "Смотреть, как никто за это не отвечает."

# game/Story03.rpy:4195
translate russian akt3chapter3_3_3699bab2:

    # em "To them, you’re just a number. Your people, numbers. The dead, statistics."
    em "Для них ты просто число. Твои люди - числа. Мертвые - статистика."

# game/Story03.rpy:4200
translate russian akt3chapter3_3_e1f58152:

    # Fl "What the hell is she doing there?!"
    Fl "Что она, черт возьми, там делает?!"

# game/Story03.rpy:4249
translate russian akt3chapter3_3_f6b94157:

    # em "Ask her yourself."
    em "Спроси ее сама."

# game/Story03.rpy:4251
translate russian akt3chapter3_3_c674bc1b:

    # scar "(Hmm… Security system, 2 out of 10.)"
    scar "(Хм... Система безопасности: 2 из 10.)"

# game/Story03.rpy:4253
translate russian akt3chapter3_4_304ed637:

    # "Sector 3-S. Lower City."
    "Сектор 3-S. Нижний город."

# game/Story03.rpy:4287
