    # mc "...Lower city."
    mc "...Нижний город."

# game/Story03.rpy:4288
translate russian akt3chapter3_4_ad09b856:

    # mc "Shit."
    mc "Черт."

# game/Story03.rpy:4290
translate russian akt3chapter3_4_10bdd5c8:

    # mc "(If it’s this bad below...)"
    mc "(Если внизу все настолько плохо...)"

# game/Story03.rpy:4292
translate russian akt3chapter3_4_0871a804:

    # mc "(What’s happening up top?)"
    mc "(Что тогда творится наверху?)"

# game/Story03.rpy:4296
translate russian akt3chapter3_4_d6dcbb26:

    # mc "Someone’s tearing the place apart."
    mc "Кто-то разносит это место в клочья."

# game/Story03.rpy:4310
translate russian akt3chapter3_4_2dec1211:

    # mc "And they’re doing it fast."
    mc "И делают это быстро."

# game/Story03.rpy:4312
translate russian akt3chapter3_4_90e317fe:

    # mc "(No idea how this works...)"
    mc "(Понятия не имею, как это работает...)"

# game/Story03.rpy:4338
translate russian akt3chapter3_4_b7efd87f:

    # mc "(Figure it out or die.)"
    mc "(Разберись или умри.)"

# game/Story03.rpy:4342
translate russian akt3chapter3_4_25f78c35:

    # mc "This won’t be smooth."
    mc "Плавно не будет."

# game/Story03.rpy:4345
translate russian akt3chapter3_4_558bd34b:

    # mc "Kalestra?! Get back inside!"
    mc "Калестра?! Вернись внутрь!"

# game/Story03.rpy:4355
translate russian akt3chapter3_4_eca204e8:

    # mc "(She... cut a missile?)"
    mc "(Она... разрезала ракету?)"

# game/Story03.rpy:4366
translate russian akt3chapter3_4_d48afd49:

    # mc "(...Noted.)"
    mc "(...Учту.)"

# game/Story03.rpy:4368
translate russian akt3chapter3_4_4901b32d:

    # mc "No control. We’re falling!"
    mc "Управления нет. Мы падаем!"

# game/Story03.rpy:4394
translate russian akt3chapter3_4_456e8c9f:

    # Mi "(That’s... a portal to the Abyss?!)"
    Mi "(Это... Врата в Бездну?!)"

# game/Story03.rpy:4415
translate russian akt3chapter3_4_955584b2:

    # mc "(What... is that?)"
    mc "(Что... это такое?)"

# game/Story03.rpy:4431
translate russian akt3chapter3_4_3b65910f:

    # g "Deploy Assault Group Three."
    g "Развернуть третью штурмовую группу."

# game/Story03.rpy:4438
translate russian akt3chapter3_4_270f37cc:

    # g "We need to be ready for anything."
    g "Мы должны быть готовы ко всему."

# game/Story03.rpy:4444
translate russian akt3chapter3_4_2d284bd8:

    # k "(whispering) Sure."
    k "(шепотом) Конечно."

# game/Story03.rpy:4459
translate russian akt3chapter3_4_e638115f:

    # k "(whispering) Just don’t say I didn’t cue my line on time."
    k "(шепотом) Только не говори потом, что я не вовремя подала реплику."

# game/Story03.rpy:4461
translate russian akt3chapter3_4_acb1e295:

    # ry "Tell me I didn’t just see what I think I saw..."
    ry "Скажи, что я только что не видел то, что думаю..."

# game/Story03.rpy:4463
translate russian akt3chapter3_4_e496a7e0:

    # ry "I’m not sure what’s more shocking, seeing it, or surviving it?"
    ry "Я даже не знаю, что шокирует больше: увидеть это или пережить?"

# game/Story03.rpy:4467
translate russian akt3chapter3_4_05cec37b:

    # el "And there’s the—"
    el "А вот и-"

# game/Story03.rpy:4470
translate russian akt3chapter3_4_7cc42076:

    # el "Oh no. That’s bad. Very bad."
    el "О нет. Это плохо. Очень плохо."

# game/Story03.rpy:4475
translate russian akt3chapter3_4_2c3d5b05:

    # Mi "ou almost killed us all!"
    Mi "Ты чуть всех нас не убил!"

# game/Story03.rpy:4489
translate russian akt3chapter3_4_97df86f1:

    # Mi "Or did you forget?!"
    Mi "Или ты забыл?!"

# game/Story03.rpy:4492
translate russian akt3chapter3_4_e0e8a5e8:

    # Mi "Millions died because of this!"
    Mi "Из-за этого погибли миллионы!"

# game/Story03.rpy:4497
translate russian akt3chapter3_4_32a55576:

    # el "Mir, this isn’t the time."
    el "Мир, сейчас не время."

# game/Story03.rpy:4508
translate russian akt3chapter3_4_dbd8eee1:

    # mc "What... was that?"
    mc "Что... это было?"

# game/Story03.rpy:4528
translate russian akt3chapter3_4_15cc83fd:

    # a "Portal."
    a "Врата."

# game/Story03.rpy:4532
translate russian akt3chapter3_4_8f430e01:

    # mc "(Portal? What kind of...)"
    mc "(Врата? Что за...)"

# game/Story03.rpy:4535
translate russian akt3chapter3_4_82091822_1:

    # k "..."
    k "..."

# game/Story03.rpy:4548
translate russian akt3chapter3_4_66306037:

    # k "Hm… Attention, reverence, drawn pistols, how sweet."
    k "Хм... внимание, благоговение, пистолеты наготове... как мило."

# game/Story03.rpy:4554
translate russian akt3chapter3_4_073a5943:

    # k "Boring..."
    k "Скучно..."

# game/Story03.rpy:4559
translate russian akt3chapter3_4_ab3e781a:

    # Fl "You’re late."
    Fl "Вы опоздали."

# game/Story03.rpy:4563
translate russian akt3chapter3_4_8f3e7169:

    # Fl "And judging by that entrance, still not thinking ahead."
    Fl "И судя по этому появлению, думать наперед вы все еще не умеете."

# game/Story03.rpy:4564
translate russian akt3chapter3_4_e1e21c13:

    # Fl "Maybe next time you’ll show up before half my people are dead."
    Fl "Может, в следующий раз появитесь до того, как половина моих людей умрет."

# game/Story03.rpy:4566
translate russian akt3chapter3_4_34ece62e:

    # Fl "Yes."
    Fl "Да."

# game/Story03.rpy:4576
translate russian akt3chapter3_4_b4254f11:

    # Fl "And I’m glad you’re here."
    Fl "И я рада, что вы здесь."

# game/Story03.rpy:4577
translate russian akt3chapter3_4_76d12d5a:

    # Fl "Because I’m short on people."
    Fl "Потому что у меня не хватает людей."

# game/Story03.rpy:4579
translate russian akt3chapter3_4_10153469:

    # a "They let children command armies now."
    a "Теперь у нас дети командуют армиями."

# game/Story03.rpy:4585
translate russian akt3chapter3_4_5704fc94:

    # Fl "You’ve got a problem with that?"
    Fl "Есть проблемы?"

# game/Story03.rpy:4586
translate russian akt3chapter3_4_2bad3711:

    # Fl "Good."
    Fl "Отлично."

# game/Story03.rpy:4588
translate russian akt3chapter3_4_68e2272e:

    # Fl "Then shut up and listen."
    Fl "Тогда заткнись и слушай."

# game/Story03.rpy:4590
translate russian akt3chapter3_4_9196b310:

    # Fl "My rules. Accept it or stay mad, quietly."
    Fl "Мои правила. Принимай или злись молча."

# game/Story03.rpy:4597
translate russian akt3chapter3_4_54d13c01:

    # a "You're loud."
    a "Ты громкая."

# game/Story03.rpy:4599
translate russian akt3chapter3_4_3d067ff8:

    # Fl "Ok."
    Fl "Окей."

# game/Story03.rpy:4600
translate russian akt3chapter3_4_80b97f3c:

    # k "You wouldn't last against Ember anyway."
    k "Против Эмбер ты бы все равно не продержалась."

# game/Story03.rpy:4606
translate russian akt3chapter3_4_fccd60ee:

    # k "You need rest. Urgently."
    k "Тебе нужен отдых. Срочно."

# game/Story03.rpy:4608
translate russian akt3chapter3_4_bb82788b:

    # Fl "Every conversation with you is a headache."
    Fl "От каждого разговора с тобой у меня болит голова."

# game/Story03.rpy:4618
translate russian akt3chapter3_4_338ad1c4:

    # Fl "All wounded to the medbay. Everyone else, to your rooms."
    Fl "Всех раненых - в медблок. Остальным - по комнатам."

# game/Story03.rpy:4619
translate russian akt3chapter3_4_3d97c635:

    # k "Yeah, yeah."
    k "Да-да."

# game/Story03.rpy:4638
translate russian akt3chapter3_4_3cb631cd:

    # Fl "You, with me. Now."
    Fl "Ты. Со мной. Сейчас."

# game/Story03.rpy:4644
translate russian akt3chapter4_9fdc8fdf:

    # Fl "So tell me—"
    Fl "Так скажи мне-"

# game/Story03.rpy:4688
translate russian akt3chapter4_9c8849ac:

    # Fl "how did you end up stuck at the outpost…"
    Fl "как ты умудрился застрять на аванпосте..."

# game/Story03.rpy:4689
translate russian akt3chapter4_0ba4d44f:

    # Fl "while your darling wife and Olivia made it here?"
    Fl "пока твоя дорогая жена и Оливия добрались сюда?"

# game/Story03.rpy:4692
translate russian akt3chapter4_73edf2b9:

    # mc "You always go for the things people try hardest not to remember."
    mc "Ты всегда бьешь туда, что люди сильнее всего пытаются не вспоминать."

# game/Story03.rpy:4693
translate russian akt3chapter4_d74c0807:

    # mc "Ever thought about changing that?"
    mc "Не думала это изменить?"

# game/Story03.rpy:4696
translate russian akt3chapter4_08fc1af8:

    # Fl "No."
    Fl "Нет."

# game/Story03.rpy:4697
translate russian akt3chapter4_d27a60f0:

    # Fl "Not my style."
    Fl "Не мой стиль."

# game/Story03.rpy:4700
translate russian akt3chapter4_444b7c1e:

    # Fl "I’m after something else."
    Fl "Мне нужно другое."

# game/Story03.rpy:4704
translate russian akt3chapter4_2034c056:

    # mc "Maybe."
    mc "Может быть."

# game/Story03.rpy:4708
translate russian akt3chapter4_effb41f4:

    # mc "Maybe not."
    mc "А может, и нет."

# game/Story03.rpy:4709
translate russian akt3chapter4_a1715063:

    # mc "It’s complicated."
    mc "Все сложно."

# game/Story03.rpy:4713
translate russian akt3chapter4_d5f9bf75:

    # Fl "(quietly) Of course."
    Fl "(тихо) Конечно."

# game/Story03.rpy:4714
translate russian akt3chapter4_161c2e55:

    # Fl "It’s never that simple…"
    Fl "Никогда не бывает так просто..."

# game/Story03.rpy:4715
translate russian akt3chapter4_89a8d5d5:

    # Fl "Be honest."
    Fl "Скажи честно."

# game/Story03.rpy:4716
translate russian akt3chapter4_3456e9a9:

    # Fl "Did you drop everything for her?"
    Fl "Ты правда бросил все ради нее?"

# game/Story03.rpy:4718
translate russian akt3chapter4_cb9704d6:

    # mc "Some things are harder to explain than you think."
    mc "Некоторые вещи объяснить сложнее, чем ты думаешь."

# game/Story03.rpy:4720
translate russian akt3chapter4_40a99654:

    # Fl "Have you always been like this—"
    Fl "Ты всегда был таким-"

# game/Story03.rpy:4721
translate russian akt3chapter4_324c16ec:

    # Fl "or is this new?"
    Fl "или это недавно началось?"

# game/Story03.rpy:4724
translate russian akt3chapter4_a488ac32:

    # mc "You’re pushing too hard."
    mc "Ты перегибаешь."

# game/Story03.rpy:4726
translate russian akt3chapter4_8a84f750:

    # Fl "So?"
    Fl "И?"

# game/Story03.rpy:4731
translate russian akt3chapter4_a48150a5:

    # Fl "What did you find?"
    Fl "Что ты нашел?"

# game/Story03.rpy:4735
translate russian akt3chapter4_f21b3964:

    # mc "You could’ve just asked me directly."
    mc "Ты могла просто спросить прямо."

# game/Story03.rpy:4737
translate russian akt3chapter4_c5cd3d15:

    # Fl "If you’d prefer—"
    Fl "Если тебе так удобнее-"

# game/Story03.rpy:4738
translate russian akt3chapter4_b6bc6642:

    # Fl "I can make it an order."
    Fl "я могу оформить это как приказ."

# game/Story03.rpy:4740
translate russian akt3chapter4_12b38da7:

    # Fl "Won’t change the outcome."
    Fl "Результат не изменится."

# game/Story03.rpy:4742
translate russian akt3chapter4_9ccc63d0:

    # mc "Quit playing games."
    mc "Хватит этих игр."

# game/Story03.rpy:4744
translate russian akt3chapter4_381e664a:

    # Fl "And she might be the only thing we have left."
    Fl "А она может быть единственным, что у нас осталось."

# game/Story03.rpy:4752
translate russian akt3chapter4_949ca777:

    # mc "You really don't know how to ask, do you?"
    mc "Ты правда не умеешь просить по-человечески, да?"

# game/Story03.rpy:4757
translate russian akt3chapter4_be67b6d3:

    # Fl "Right now— MILLIONS of lives depend on my decisions!"
    Fl "Сейчас - МИЛЛИОНЫ жизней зависят от моих решений!"

# game/Story03.rpy:4759
translate russian akt3chapter4_2f4db67a:

    # Fl "And whatever it takes—"
    Fl "И чего бы это ни стоило-"

# game/Story03.rpy:4760
translate russian akt3chapter4_4fddcea5:

    # Fl "you’re going to tell me everything!"
    Fl "ты расскажешь мне все!"

# game/Story03.rpy:4761
translate russian akt3chapter4_af076d1e:

    # Fl "Do you understand me?!"
    Fl "Ты меня понял?!"

# game/Story03.rpy:4763
translate russian akt3chapter4_c3cd955e:

    # mc "And your best idea was jumping me the second I walked in?"
    mc "И лучшая идея, до которой ты додумалась, - наброситься на меня, как только я вошел?"

# game/Story03.rpy:4765
translate russian akt3chapter4_493ac62e:

    # Fl "What else was I supposed to do?!"
    Fl "А что мне еще оставалось?!"

# game/Story03.rpy:4766
translate russian akt3chapter4_7786dd07:

    # Fl "You were supposed to help me!"
    Fl "Ты должен был мне помочь!"

# game/Story03.rpy:4768
translate russian akt3chapter4_4300402f:

    # mc "So this was your plan?"
    mc "И это был твой план?"

# game/Story03.rpy:4774
translate russian akt3chapter4_95d13048:

    # Fl "…You don’t get it."
    Fl "...Ты не понимаешь."

# game/Story03.rpy:4778
translate russian akt3chapter4_e4ab53e2:

    # Fl "You REFUSE to get it!"
    Fl "Ты НЕ ХОЧЕШЬ понимать!"

# game/Story03.rpy:4783
translate russian akt3chapter4_8339ec02:

    # mc "I risked my life."
    mc "Я рисковал жизнью."

# game/Story03.rpy:4784
translate russian akt3chapter4_80380bee:

    # mc "Almost died more than once."
    mc "И не раз почти умер."

# game/Story03.rpy:4785
translate russian akt3chapter4_0068191e:

    # mc "And this is what I get when I finally make it here?"
    mc "И вот что я получаю, когда наконец добираюсь сюда?"

# game/Story03.rpy:4786
translate russian akt3chapter4_1db1fa88:

    # mc "A breakdown?"
    mc "Истерику?"

# game/Story03.rpy:4787
translate russian akt3chapter4_0754010a:

    # mc "Threats?"
    mc "Угрозы?"

# game/Story03.rpy:4791
translate russian akt3chapter4_3a8251e0:

    # Fl "—I KNOW, alright?!"
    Fl "-Я ЗНАЮ, ясно?!"

# game/Story03.rpy:4792
translate russian akt3chapter4_0c4eb731:

    # Fl "Nothing is going according to plan!"
    Fl "Ничего не идет по плану!"

# game/Story03.rpy:4795
translate russian akt3chapter4_160a6f8b:

    # Fl "Everything I built—"
    Fl "Все, что я строила-"

# game/Story03.rpy:4796
translate russian akt3chapter4_fef54098:

    # Fl "Everything I calculated—"
    Fl "все, что я рассчитывала-"

# game/Story03.rpy:4797
translate russian akt3chapter4_9a46f5ad:

    # Fl "It’s all collapsing!"
    Fl "все рушится!"

# game/Story03.rpy:4798
translate russian akt3chapter4_0a002e6d:

    # Fl "All of it!"
    Fl "Абсолютно все!"

# game/Story03.rpy:4800
translate russian akt3chapter4_64b58791:

    # mc "Don’t pin this shit on me."
    mc "Не сваливай это дерьмо на меня."

# game/Story03.rpy:4803
translate russian akt3chapter4_ac79912b:

    # Fl "...I’m not—"
    Fl "...Я не-"

# game/Story03.rpy:4806
translate russian akt3chapter4_cf1adef2:

    # mc "Yeah."
    mc "Еще как."

# game/Story03.rpy:4807
translate russian akt3chapter4_d459d718:

    # mc "That’s exactly what you’re doing."
    mc "Именно это ты сейчас и делаешь."

# game/Story03.rpy:4810
translate russian akt3chapter4_a2104853:

    # Fl "Because..."
    Fl "Потому что..."

# game/Story03.rpy:4821
translate russian akt3chapter4_acc1c356:

    # Fl "You always needed things spelled out emotionally."
    Fl "Тебе всегда нужно было, чтобы эмоции раскладывали по полочкам."

# game/Story03.rpy:4823
translate russian akt3chapter4_656551f8:

    # Fl "So I push."
    Fl "Вот я и давлю."

# game/Story03.rpy:4824
translate russian akt3chapter4_84094cc4:

    # Fl "Because it works."
    Fl "Потому что это работает."

# game/Story03.rpy:4826
translate russian akt3chapter4_9e19a94a:

    # Fl "Usually."
    Fl "Обычно."

# game/Story03.rpy:4828
translate russian akt3chapter4_716931f4:

    # Fl "If you want to laugh, go ahead."
    Fl "Хочешь смеяться - смейся."

# game/Story03.rpy:4832
translate russian akt3chapter4_108da70c:

    # Fl "Smart enough to build systems."
    Fl "Ума хватает строить системы."

# game/Story03.rpy:4833
translate russian akt3chapter4_c24f223c:

    # Fl "Too stupid to talk to people."
    Fl "А поговорить с людьми - уже нет."

# game/Story03.rpy:4839
translate russian akt3chapter4_e0fc7c5b:

    # mc "You’re spoiled."
    mc "Ты избалована."

# game/Story03.rpy:4844
translate russian akt3chapter4_49f43cae:

    # Fl "I am NOT spoiled!"
    Fl "Я НЕ избалована!"

# game/Story03.rpy:4852
translate russian akt3chapter4_99b98ad8:

    # mc "Then prove me wrong."
    mc "Тогда докажи, что я ошибаюсь."

# game/Story03.rpy:4861
translate russian akt3chapter4_f07ba957:

    # Fl "I—"
    Fl "Я-"

# game/Story03.rpy:4865
translate russian akt3chapter4_7e0d3f9f:

    # mc "What’s your answer?"
    mc "Что ответишь?"

# game/Story03.rpy:4868
translate russian akt3chapter4_e495dd2c:

    # Fl "You really are an asshole."
    Fl "Ты правда мудак."

# game/Story03.rpy:4871
translate russian akt3chapter4_e186c9b3:

    # mc "Yeah. Probably."
    mc "Да. Наверное."

# game/Story03.rpy:4877
translate russian akt3chapter4_9452bee5:

    # L "I—"
    L "Я-"

# game/Story03.rpy:4878
translate russian akt3chapter4_11b9660c:

    # L "...What are you two doing?"
    L "...Что вы двое делаете?"

# game/Story03.rpy:4881
translate russian akt3chapter4_4851f5a4:

    # Fl "Talking."
    Fl "Разговариваем."

# game/Story03.rpy:4883
translate russian akt3chapter4_76d8f649:

    # mc "(Of all possible moments... she had to walk in now.)"
    mc "(Из всех возможных моментов... она вошла именно сейчас.)"

# game/Story03.rpy:4891
translate russian akt3chapter4_d5fd2eaf:

    # L "...What are you doing?"
    L "...Что ты делаешь?"

# game/Story03.rpy:4895
translate russian akt3chapter4_a398643d:

    # mc "Muscle memory."
    mc "Мышечная память."

# game/Story03.rpy:4897
translate russian akt3chapter4_49ec1ce5:

    # L "...Let go."
    L "...Отпусти."

# game/Story03.rpy:4899
translate russian akt3chapter4_5e2cb588:

    # mc "(Normally she'd already be furious.)"
    mc "(Обычно она бы уже разозлилась.)"

# game/Story03.rpy:4903
translate russian akt3chapter4_a22e8f5a:

    # mc "(But now...)"
    mc "(Но сейчас...)"

# game/Story03.rpy:4909
translate russian akt3chapter4_6651ab87:

    # mc "Alright."
    mc "Ладно."

# game/Story03.rpy:4910
translate russian akt3chapter4_542c2412:

    # mc "Someone want to explain what exactly is happening here?"
    mc "Кто-нибудь объяснит, что здесь вообще происходит?"

# game/Story03.rpy:4912
translate russian akt3chapter4_f190b946:

    # L "(whispers) I came to talk, but..."
    L "(шепотом) Я пришла поговорить, но..."

# game/Story03.rpy:4914
translate russian akt3chapter4_190ab1a1:

    # Fl "Nothing you need to worry about."
    Fl "Ничего, о чем тебе стоит переживать."

# game/Story03.rpy:4917
translate russian akt3chapter4_e3834ec7:

    # L "(whispers) I know."
    L "(шепотом) Я знаю."

# game/Story03.rpy:4920
translate russian akt3chapter4_4245de2c:

    # mc "So what the hell was that?"
    mc "Тогда что это, черт возьми, было?"

# game/Story03.rpy:4941
translate russian akt3chapter4_cea723ef:

    # mc "I asked a question."
    mc "Я задал вопрос."

# game/Story03.rpy:4943
translate russian akt3chapter4_e943d1ed:

    # L "I..."
    L "Я..."

# game/Story03.rpy:4945
translate russian akt3chapter4_ab473ab9:

    # Fl "Right."
    Fl "Ладно."

# game/Story03.rpy:4952
translate russian akt3chapter4_bfa9d6fa:

    # mc "I’m getting real tired of this shit."
    mc "Мне уже правда осточертело это дерьмо."

# game/Story03.rpy:4954
translate russian akt3chapter4_2713488d:

    # mc "This is getting old."
    mc "Это уже надоело."

# game/Story03.rpy:4956
translate russian akt3chapter4_3faf49fd:

    # mc "Either talk straight."
    mc "Либо говорите прямо."

# game/Story03.rpy:4957
translate russian akt3chapter4_45367d3f:

    # mc "Or start acting normal."
    mc "Либо начните вести себя нормально."

# game/Story03.rpy:4960
translate russian akt3chapter4_4d9ab87a:

    # Fl "Let’s just say..."
    Fl "Скажем так..."

# game/Story03.rpy:4965
translate russian akt3chapter4_e1823a68:

    # Fl "we had a disagreement."
    Fl "у нас возникли разногласия."

# game/Story03.rpy:4967
translate russian akt3chapter4_c42b05ac:

    # mc "And?"
    mc "И?"

# game/Story03.rpy:4970
translate russian akt3chapter4_49e7621f:

    # L "I said..."
    L "Я сказала..."

# game/Story03.rpy:4971
translate russian akt3chapter4_f0a1fab4:

    # L "We need to leave this planet."
    L "Нам нужно покинуть эту планету."

# game/Story03.rpy:4973
translate russian akt3chapter4_9a5056f5:

    # Fl "And she refused to explain why."
    Fl "И она отказалась объяснить почему."

# game/Story03.rpy:4975
translate russian akt3chapter4_a8aa0765:

    # L "And I’m not explaining why."
    L "И я не стану объяснять почему."

# game/Story03.rpy:4980
translate russian akt3chapter4_1c7d22c2:

    # mc "Problem with the plan?"
    mc "Проблема с планом?"

# game/Story03.rpy:4982
translate russian akt3chapter4_8320dad3:

    # Fl "She keeps shooting it down."
    Fl "Она его постоянно рубит."

# game/Story03.rpy:4983
translate russian akt3chapter4_7efe5a63:

    # Fl "Hard."
    Fl "На корню."

# game/Story03.rpy:4984
translate russian akt3chapter4_3fbb6973:

    # Fl "...and yeah."
    Fl "...и да."

# game/Story03.rpy:4985
translate russian akt3chapter4_c0299f55:

    # Fl "I might’ve said a few things."
    Fl "Я могла сказать пару лишних вещей."

# game/Story03.rpy:4987
translate russian akt3chapter4_be250528:

    # mc "One question."
    mc "Один вопрос."

# game/Story03.rpy:4990
translate russian akt3chapter4_e943d1ed_1:

    # L "I..."
    L "Я..."

# game/Story03.rpy:4994
translate russian akt3chapter4_28c618d2:

    # L "We won’t make it."
    L "Мы не доберемся."

# game/Story03.rpy:4995
translate russian akt3chapter4_c9ec8556:

    # L "You all die."
    L "Вы все умрете."

# game/Story03.rpy:4997
translate russian akt3chapter4_368910a2:

    # Fl "Oh, so now you're a prophet?"
    Fl "О, так ты теперь пророчица?"

# game/Story03.rpy:4998
translate russian akt3chapter4_2ab1ebac:

    # Fl "That’s cute."
    Fl "Как мило."

# game/Story03.rpy:5000
translate russian akt3chapter4_442776c8:

    # Fl "See, [mc]? She’s not even trying to—"
    Fl "Видишь, [mc]? Она даже не пытается-"

# game/Story03.rpy:5001
translate russian akt3chapter4_b268db7b:

    # Fl "[mc]?"
    Fl "[mc]?"

# game/Story03.rpy:5003
translate russian akt3chapter4_fbc7d4cb:

    # mc "You’re desperate."
    mc "Ты в отчаянии."

# game/Story03.rpy:5005
translate russian akt3chapter4_ddcd6a1f:

    # L "...Yes."
    L "...Да."

# game/Story03.rpy:5007
translate russian akt3chapter4_77970c33:

    # Fl "What are you talk-"
    Fl "О чем ты-"

# game/Story03.rpy:5009
translate russian akt3chapter4_fb7ac99a:

    # mc "She knows what’s coming."
    mc "Она знает, что будет дальше."

# game/Story03.rpy:5011
translate russian akt3chapter4_64754ce1:

    # L "I don’t see the path."
    L "Я не вижу путь."

# game/Story03.rpy:5014
translate russian akt3chapter4_b9686f2b:

    # L "Only the outcome."
    L "Только исход."

# game/Story03.rpy:5016
translate russian akt3chapter4_cfff6d08:

    # L "There’s a story."
    L "Есть одна история."

# game/Story03.rpy:5029
translate russian akt3chapter4_c8655f59:

    # L "About immortality."
    L "О бессмертии."

# game/Story03.rpy:5030
translate russian akt3chapter4_ec04ce5f:

    # L "They say… whoever passes through the gate, comes back."
    L "Говорят... кто проходит через Врата, возвращается."

# game/Story03.rpy:5032
translate russian akt3chapter4_7ec6c53b:

    # Fl "Immortality?"
    Fl "Бессмертие?"

# game/Story03.rpy:5033
translate russian akt3chapter4_613c3cb2:

    # Fl "...and you actually believe that?"
    Fl "...и ты правда в это веришь?"

# game/Story03.rpy:5038
translate russian akt3chapter4_fca52711:

    # mc "No."
    mc "Нет."

# game/Story03.rpy:5043
translate russian akt3chapter4_87c06655:

    # mc "That doesn’t sound like you."
    mc "Это на тебя не похоже."

# game/Story03.rpy:5044
translate russian akt3chapter4_fcde0016:

    # mc "Not without proof."
    mc "Точно не без доказательств."

# game/Story03.rpy:5046
translate russian akt3chapter4_4d425600:

    # Fl "That’s insane—"
    Fl "Это безумие-"

# game/Story03.rpy:5050
translate russian akt3chapter4_49274452:

    # Fl "No, that’s not how this works."
    Fl "Нет, так это не работает."

# game/Story03.rpy:5053
translate russian akt3chapter4_d4a2608b:

    # Fl "...Don’t look at me like that."
    Fl "...Не смотри на меня так."

# game/Story03.rpy:5054
translate russian akt3chapter4_aefe54cf:

    # Fl "Like I’m supposed to have an answer."
    Fl "Будто у меня обязан быть ответ."

# game/Story03.rpy:5055
translate russian akt3chapter4_0d059c5a:

    # mc "And you did nothing?"
    mc "И ты ничего не сделала?"

# game/Story03.rpy:5059
translate russian akt3chapter4_e4a25fd7:

    # L "I tried."
    L "Я пыталась."

# game/Story03.rpy:5062
translate russian akt3chapter4_285bb8d1:

    # Fl "...Wait."
    Fl "...Погоди."

# game/Story03.rpy:5063
translate russian akt3chapter4_85f28ade:

    # Fl "What about Astoria?"
    Fl "А Астория?"

# game/Story03.rpy:5065
translate russian akt3chapter4_d7a46d19:

    # L "She tried too."
    L "Она тоже пыталась."

# game/Story03.rpy:5066
translate russian akt3chapter4_7408d90e:

    # L "Same result."
    L "Итог тот же."

# game/Story03.rpy:5068
translate russian akt3chapter4_10a4cb79:

    # Fl "...how?!"
    Fl "...как?!"

# game/Story03.rpy:5071
translate russian akt3chapter4_ef0288f9:

    # mc "So there’s no way out?"
    mc "Значит, выхода нет?"

# game/Story03.rpy:5073
translate russian akt3chapter4_75b42395:

    # L "If I could change it…"
    L "Если бы я могла это изменить..."

# game/Story03.rpy:5074
translate russian akt3chapter4_56a04b19:

    # L "...don’t you think I already would have?"
    L "...думаешь, я бы уже не сделала это?"

# game/Story03.rpy:5076
translate russian akt3chapter4_a7146250:

    # mc "That changes nothing."
    mc "Это ничего не меняет."

# game/Story03.rpy:5082
translate russian akt3chapter4_aa9557d9:

    # Fl "No..."
    Fl "Нет..."

# game/Story03.rpy:5083
translate russian akt3chapter4_d83ed31e:

    # Fl "The tower—"
    Fl "Башня-"

# game/Story03.rpy:5086
translate russian akt3chapter4_9dc4fd2b:

    # mc "We don’t have another option."
    mc "Другого варианта у нас нет."

# game/Story03.rpy:5096
translate russian akt3chapter4_73005691:

    # mc "Flora."
    mc "Флора."

# game/Story03.rpy:5097
translate russian akt3chapter4_b629f374:

    # mc "Get the commanders together."
    mc "Собери командиров."

# game/Story03.rpy:5098
translate russian akt3chapter4_1b073a14:

    # Fl "I..."
    Fl "Я..."

# game/Story03.rpy:5099
translate russian akt3chapter4_bc4e820a:

    # Fl "...got it."
    Fl "...поняла."

# game/Story03.rpy:5101
translate russian akt3chapter4_9f25e89d:

    # mc "Lora, write everything down."
    mc "Лора, запиши все."

# game/Story03.rpy:5102
translate russian akt3chapter4_8479533f:

    # mc "Even the parts that sound insane."
    mc "Даже то, что звучит безумно."

# game/Story03.rpy:5104
translate russian akt3chapter4_2c5dd124:

    # L "And you?"
    L "А ты?"

# game/Story03.rpy:5106
translate russian akt3chapter4_b5ac1cd2:

    # mc "I’m gonna find us a way out."
    mc "Я найду нам выход."

# game/Story03.rpy:5127
translate russian akt3chapter5_fa928b9b:

    # L "Please..."
    L "Пожалуйста..."

# game/Story03.rpy:5134
translate russian akt3chapter5_9a2bb62f:

    # L "(Again…)"
    L "(Снова...)"

# game/Story03.rpy:5140
translate russian akt3chapter5_628d6346:

    # L "(Watching it happen…)"
    L "(Смотреть, как это происходит...)"

# game/Story03.rpy:5145
translate russian akt3chapter5_9cbdb9ab:

    # L "(He survives.)"
    L "(Он выживает.)"

# game/Story03.rpy:5154
translate russian akt3chapter5_24bd9d9b:

    # L "(This time… he...)"
    L "(В этот раз... он...)"

# game/Story03.rpy:5165
translate russian akt3chapter5_52597078:

    # mc "You holding up?"
    mc "Держишься?"

# game/Story03.rpy:5167
translate russian akt3chapter5_1b073a14:

    # Fl "I..."
    Fl "Я..."

# game/Story03.rpy:5170
translate russian akt3chapter5_8ed0c1b0:

    # mc "Scared?"
    mc "Страшно?"

# game/Story03.rpy:5173
translate russian akt3chapter5_b84af5bf:

    # Fl "What do you think?"
    Fl "А ты как думаешь?"

# game/Story03.rpy:5174
translate russian akt3chapter5_7ac7ed60:

    # Fl "She just told us we’re going to die!"
    Fl "Она только что сказала, что мы все умрем!"

# game/Story03.rpy:5175
translate russian akt3chapter5_1b073a14_1:

    # Fl "I..."
    Fl "Я..."

# game/Story03.rpy:5176
translate russian akt3chapter5_b24defdf:

    # Fl "(whispering) I don’t want to die."
    Fl "(шепотом) Я не хочу умирать."

# game/Story03.rpy:5179
translate russian akt3chapter5_cf1adef2:

    # mc "Yeah."
    mc "Да."

# game/Story03.rpy:5180
translate russian akt3chapter5_98d19c29:

    # mc "Me neither."
    mc "Я тоже."

# game/Story03.rpy:5190
translate russian akt3chapter5_2d82a0eb:

    # Fl "You don’t get it..."
    Fl "Ты не понимаешь..."

# game/Story03.rpy:5191
translate russian akt3chapter5_fbfb49e5:

    # Fl "Everyone sees me as some naive, spoiled little pet."
    Fl "Все смотрят на меня как на наивную, избалованную маленькую зверушку."

# game/Story03.rpy:5192
translate russian akt3chapter5_eeebf6fe:

    # Fl "No one takes me seriously."
    Fl "Меня никто не воспринимает всерьез."

# game/Story03.rpy:5193
translate russian akt3chapter5_67ec577e:

    # Fl "...not even you."
    Fl "...даже ты."

# game/Story03.rpy:5195
translate russian akt3chapter5_31eff69d:

    # mc "I—"
    mc "Я-"

# game/Story03.rpy:5201
translate russian akt3chapter5_d03c74b7:

    # Fl "Exactly."
    Fl "Вот именно."

# game/Story03.rpy:5203
translate russian akt3chapter5_9763be76:

    # mc "What about Ember?"
    mc "А Эмбер?"

# game/Story03.rpy:5208
translate russian akt3chapter5_3ef5cb5e:

    # Fl "She..."
    Fl "Она..."

# game/Story03.rpy:5211
translate russian akt3chapter5_dc16ebcd:

    # mc "Got it."
    mc "Понял."

# game/Story03.rpy:5212
translate russian akt3chapter5_eab0b344:

    # mc "Even now, she wanted something in return."
    mc "Даже сейчас ей нужно было что-то взамен."

# game/Story03.rpy:5214
translate russian akt3chapter5_d1674048:

    # Fl "Power isn’t about friendship."
    Fl "Власть не держится на дружбе."

# game/Story03.rpy:5226
translate russian akt3chapter5_04e4b842:

    # mc "(whispering) ...Strength."
    mc "(шепотом) ...Сила."

# game/Story03.rpy:5230
translate russian akt3chapter5_7e02afc0:

    # mc "Go to Lora."
    mc "Иди к Лоре."

# game/Story03.rpy:5231
translate russian akt3chapter5_823e29cb:

    # mc "Get the plan ready."
    mc "Подготовь план."

# game/Story03.rpy:5234
translate russian akt3chapter5_00e6018e:

    # Fl "But-"
    Fl "Но-"

# game/Story03.rpy:5241
translate russian akt3chapter5_688a3fb0:

    # mc "Go."
    mc "Иди."

# game/Story03.rpy:5243
translate russian akt3chapter5_f1403c76:

    # Fl "...No one will listened."
    Fl "...Никто не станет слушать."

# game/Story03.rpy:5247
translate russian akt3chapter5_b31dd769:

    # mc "I’ll handle the rest."
    mc "Остальное я беру на себя."

# game/Story03.rpy:5256
translate russian akt3chapter5_5e44a000:

    # mc "Right..."
    mc "Ладно..."

# game/Story03.rpy:5258
translate russian akt3chapter5_ea0294a0:

    # mc "(Pull yourself together.)"
    mc "(Соберись.)"

# game/Story03.rpy:5259
translate russian akt3chapter5_93cfe2d7:

    # mc "(And stop shaking.)"
    mc "(И перестань дрожать.)"

# game/Story03.rpy:5279
translate russian akt3chapter5_1_2e8b37ee:

    # k "And what little scheme have you cooked up this time?"
    k "И какую маленькую интригу ты состряпал на этот раз?"

# game/Story03.rpy:5296
translate russian akt3chapter5_1_c30a63ea:

    # k "Thanks, sister."
    k "Спасибо, сестра."

# game/Story03.rpy:5301
translate russian akt3chapter5_1_0a9d723c:

    # k "Ohoho! Delightful."
    k "О-хо-хо! Прелесть."

# game/Story03.rpy:5310
translate russian akt3chapter5_1_6d548c5d:

    # mc "You’d rather die?"
    mc "Вы правда предпочитаете умереть?"

# game/Story03.rpy:5328
translate russian akt3chapter5_1_ea147d35:

    # mc "I’m trying to keep us alive."
    mc "Я пытаюсь сохранить нам жизнь."

# game/Story03.rpy:5333
translate russian akt3chapter5_1_b4838f5b:

    # mc "You can decide what to do with me later."
    mc "Потом решите, что со мной делать."

# game/Story03.rpy:5334
translate russian akt3chapter5_1_b18e4b33:

    # mc "But now, I need you."
    mc "Но сейчас вы мне нужны."

# game/Story03.rpy:5336
translate russian akt3chapter5_1_6d460376:

    # mc "Your answer?"
    mc "Ваш ответ?"

# game/Story03.rpy:5343
translate russian akt3chapter5_1_b22f8d16:

    # mc "Surviving."
    mc "Выжить."

# game/Story03.rpy:5382
translate russian akt3chapter5_1_88ad5c5e:

    # mc "Don’t make this harder than it needs to be."
    mc "Не усложняйте больше, чем нужно."

# game/Story03.rpy:5385
translate russian akt3chapter5_1_efadbefc:

    # g "Drop weapon! Now!"
    g "Бросить оружие! Быстро!"

# game/Story03.rpy:5387
translate russian akt3chapter5_1_572473be:

    # mc "We’re past diplomacy."
    mc "Дипломатия закончилась."

# game/Story03.rpy:5390
translate russian akt3chapter5_1_ceb61bca:

    # k "What would you do without me?"
    k "Что бы ты без меня делал?"

# game/Story03.rpy:5391
translate russian akt3chapter5_1_7296948a:

    # k "Die, probably."
    k "Умер бы, наверное."

# game/Story03.rpy:5393
translate russian akt3chapter5_1_6f274295:

    # mc "Kalestra. Your turn."
    mc "Калестра. Твой выход."

# game/Story03.rpy:5395
translate russian akt3chapter5_1_a78edaca:

    # mc "Survival rarely looks clean."
    mc "Выживание редко выглядит чистым."

# game/Story03.rpy:5401
translate russian akt3chapter5_1_6f59d2aa:

    # k "Out of the way."
    k "С дороги."

# game/Story03.rpy:5407
translate russian akt3chapter5_1_b9597520:

    # k "Authority just arrived."
    k "Настоящая власть прибыла."

# game/Story03.rpy:5410
translate russian akt3chapter5_1_897e78ac:

    # k "Turn on the PA."
    k "Включи громкую связь."

# game/Story03.rpy:5413
translate russian akt3chapter5_1_16153dc4:

    # k "Wonderful."
    k "Чудесно."

# game/Story03.rpy:5416
translate russian akt3chapter5_1_42f0cb23:

    # k "Can everyone hear me now?"
    k "Теперь меня все слышат?"

# game/Story03.rpy:5418
translate russian akt3chapter5_1_db053b07:

    # k "Anyone still sleeping gets dragged out by the throat."
    k "Кого еще застанут спящим, вытащат за горло."

# game/Story03.rpy:5420
translate russian akt3chapter5_1_7c1faae7:

    # em "Nothing."
    em "Ничего."

# game/Story03.rpy:5450
translate russian akt3chapter5_1_028d94c1:

    # k "This isn’t improvisation. It’s protocol. All dissenters, sentenced to death. On the spot."
    k "Это не импровизация. Это протокол. Все несогласные приговариваются к смерти. На месте."

# game/Story03.rpy:5452
translate russian akt3chapter5_1_4ca66fb4:

    # k "That’s all! Now, to the hangar. Chop-chop. We’ve got murders to plan and not enough time."
    k "На этом все! Теперь в ангар. Живо-живо. Нам еще убийства планировать, а времени мало."

# game/Story03.rpy:5471
translate russian akt3chapter5_1_692ec8f7:

    # k "No. You’re just cowards hiding behind procedure."
    k "Нет. Вы просто трусы, прячущиеся за процедурой."

# game/Story03.rpy:5477
translate russian akt3chapter5_1_134fc383:

    # k "Sis, remind me, what’s the punishment for mouthing off to an Inquisitor?"
    k "Сестра, напомни, какое наказание за дерзость в адрес инквизитора?"

# game/Story03.rpy:5479
translate russian akt3chapter5_1_33c873ff:

    # a "Tribunal. In wartime, execution."
    a "Трибунал. В военное время - казнь."

# game/Story03.rpy:5481
translate russian akt3chapter5_1_b310aa38:

    # k "Execution?"
    k "Казнь?"

# game/Story03.rpy:5482
translate russian akt3chapter5_1_fe8fb784:

    # k "Mm. Efficient."
    k "Мм. Эффективно."

# game/Story03.rpy:5484
translate russian akt3chapter5_1_01cbc88e:

    # k "People call it madness whenever someone stops asking permission."
    k "Люди называют это безумием всякий раз, когда кто-то перестает спрашивать разрешения."

# game/Story03.rpy:5493
translate russian akt3chapter5_1_5449345d:

    # mc "(And that’s exactly why people fear you.)"
    mc "(Именно поэтому люди тебя и боятся.)"

# game/Story03.rpy:5496
translate russian akt3chapter5_1_cfcc8fd5:

    # mc "Enough spectacle."
    mc "Хватит спектакля."

# game/Story03.rpy:5499
translate russian akt3chapter5_1_2562ad6f:

    # mc "Move."
    mc "Двигаемся."

# game/Story03.rpy:5513
translate russian akt3chapter5_1_7faf5913:

    # Fl "What if... they won’t agree? Then it’s all over!"
    Fl "А если... они не согласятся? Тогда все кончено!"

# game/Story03.rpy:5521
translate russian akt3chapter5_1_ef3e37a6:

    # gggg "Exactly! We’ll back you, no matter what it costs!"
    gggg "Именно! Мы поддержим тебя, чего бы это ни стоило!"

# game/Story03.rpy:5524
translate russian akt3chapter5_1_1c347c1d:

    # Fl "Yeah, you’re... right."
    Fl "Да, вы... правы."

# game/Story03.rpy:5525
translate russian akt3chapter5_1_a250644c:

    # Fl "I need to pull myself together."
    Fl "Мне нужно взять себя в руки."

# game/Story03.rpy:5527
translate russian akt3chapter5_1_e4423a79:

    # mc "Outcome?"
    mc "Исход?"

# game/Story03.rpy:5534
translate russian akt3chapter5_1_22d0ef64:

    # L "I... don't know."
    L "Я... не знаю."

# game/Story03.rpy:5535
translate russian akt3chapter5_1_712df1b0:

    # mc "No point backing out now."
    mc "Отступать сейчас нет смысла."

# game/Story03.rpy:5544
translate russian akt3chapter5_1_d0e40f57:

    # mc "SURVIVE!"
    mc "ВЫЖИТЬ!"

# game/Story03.rpy:5580
translate russian akt3chapter5_1_86a2a077:

    # gg "HOW?!"
    gg "КАК?!"

# game/Story03.rpy:5582
translate russian akt3chapter5_1_a6c2c66e:

    # g "WE'VE ALREADY LOST!"
    g "МЫ УЖЕ ПРОИГРАЛИ!"

# game/Story03.rpy:5585
translate russian akt3chapter5_1_6235d204:

    # mc "(They think I’m insane.)"
    mc "(Они думают, что я спятил.)"

# game/Story03.rpy:5586
translate russian akt3chapter5_1_3517da4b:

    # mc "(Maybe they’re right.)"
    mc "(Может, они правы.)"

# game/Story03.rpy:5587
translate russian akt3chapter5_1_51dcac5a:

    # mc "Listen."
    mc "Слушайте."

# game/Story03.rpy:5589
translate russian akt3chapter5_1_36581657:

    # mc "I’m not going to stand here and promise survival."
    mc "Я не собираюсь стоять здесь и обещать, что все выживут."

# game/Story03.rpy:5590
translate russian akt3chapter5_1_639617cb:

    # mc "Some of us probably won’t make it."
    mc "Кто-то из нас, возможно, не выживет."

# game/Story03.rpy:5592
translate russian akt3chapter5_1_fa6ce8c2:

    # g "Then why are you even here?!"
    g "Тогда зачем ты вообще здесь?!"

# game/Story03.rpy:5594
translate russian akt3chapter5_1_b15f30bd:

    # mc "Waiting to die isn’t a strategy."
    mc "Ждать смерти - не стратегия."

# game/Story03.rpy:5598
translate russian akt3chapter5_1_0f47fc0d:

    # mc "Maybe Flora’s wrong."
    mc "Может, Флора ошибается."

# game/Story03.rpy:5599
translate russian akt3chapter5_1_28737f53:

    # mc "Maybe I’m wrong."
    mc "Может, я ошибаюсь."

# game/Story03.rpy:5601
translate russian akt3chapter5_1_f0396b93:

    # mc "Doing nothing guarantees the outcome."
    mc "Если ничего не делать, исход гарантирован."

# game/Story03.rpy:5607
translate russian akt3chapter5_1_d3c8de34:

    # mc "Right now that’s all we have left."
    mc "Сейчас это все, что у нас осталось."

# game/Story03.rpy:5618
translate russian akt3chapter5_1_dc676b5b:

    # mc "Right now, all we have is a direction."
    mc "Сейчас у нас есть только направление."

# game/Story03.rpy:5620
translate russian akt3chapter5_1_24c78e8b:

    # mc "And each other."
    mc "И друг друга."

# game/Story03.rpy:5621
translate russian akt3chapter5_1_b5fd579d:

    # mc "And people willing to stand beside you."
    mc "И люди, готовые стоять рядом с вами."

# game/Story03.rpy:5624
translate russian akt3chapter5_1_05592b27:

    # mc "If you can still stand — stand."
    mc "Если еще можешь стоять - стой."

# game/Story03.rpy:5631
translate russian akt3chapter5_1_fbaa6d26:

    # mc "And if you’re afraid..."
    mc "А если тебе страшно..."

# game/Story03.rpy:5632
translate russian akt3chapter5_1_ac313663:

    # mc "So am I."
    mc "Мне тоже."

# game/Story03.rpy:5633
translate russian akt3chapter5_1_29610376:

    # mc "Move anyway."
    mc "Все равно двигайся."

# game/Story03.rpy:5636
translate russian akt3chapter5_1_7cf243cc:

    # gg "...This is madness. And this is your plan?"
    gg "...Это безумие. И это твой план?"

# game/Story03.rpy:5638
translate russian akt3chapter5_1_94374d89:

    # g "I'd rather run than... this."
    g "Я лучше сбегу, чем... вот это."

# game/Story03.rpy:5641
translate russian akt3chapter5_1_9939c474:

    # L "Don’t worry, girl."
    L "Не бойся, девочка."

# game/Story03.rpy:5643
translate russian akt3chapter5_1_7ad4516a:

    # Fl "(They... believe in me.)"
    Fl "(Они... верят в меня.)"

# game/Story03.rpy:5645
translate russian akt3chapter5_1_2c77e49d:

    # Fl "(I don’t get to fall apart now.)"
    Fl "(Я не имею права развалиться сейчас.)"

# game/Story03.rpy:5647
translate russian akt3chapter5_1_c665a285:

    # Fl "I... I’ll do my best."
    Fl "Я... я сделаю все, что смогу."

# game/Story03.rpy:5656
translate russian akt3chapter5_1_d29a4c68:

    # Fl "Then we have the same expectations."
    Fl "Значит, наши ожидания совпадают."

# game/Story03.rpy:5664
translate russian akt3chapter5_1_fd3be89e:

    # Fl "(Breathe... Just breathe.)"
    Fl "(Дыши... Просто дыши.)"

# game/Story03.rpy:5674
translate russian akt3chapter5_1_ecc543cf:

    # Fl "(You prepared for this.)"
    Fl "(Ты готовилась к этому.)"

# game/Story03.rpy:5684
translate russian akt3chapter5_1_48b7d7cc:

    # Fl "(Stop shaking.)"
    Fl "(Перестань дрожать.)"

# game/Story03.rpy:5687
translate russian akt3chapter5_1_85465385:

    # Fl "If you want to survive, listen!"
    Fl "Если хотите выжить, слушайте!"

# game/Story03.rpy:5689
translate russian akt3chapter5_1_baeabc28:

    # Fl "Our entire lower city is fitted with an air processing system."
    Fl "Весь нижний город оснащен системой обработки воздуха."

# game/Story03.rpy:5703
translate russian akt3chapter5_1_260d2ad7:

    # Fl "The first team will head to the pumping station to load the cryog-"
    Fl "Первая группа отправится к насосной станции, чтобы загрузить криог-"

# game/Story03.rpy:5706
translate russian akt3chapter5_1_4c384397:

    # g "And if the plan fails?"
    g "А если план провалится?"

# game/Story03.rpy:5708
translate russian akt3chapter5_1_a76d5095:

    # em "We’ll evacua—"
    em "Мы эвакуи-"

# game/Story03.rpy:5712
translate russian akt3chapter5_1_fb3b0572:

    # gg "Where ar-"
    gg "Куда-"

# game/Story03.rpy:5713
translate russian akt3chapter5_1_cda8c2f5:

    # em "Cut me off again, and you die."
    em "Еще раз перебьешь - умрешь."

# game/Story03.rpy:5715
translate russian akt3chapter5_1_57d31baa:

    # em "I’ll get my people out."
    em "Своих людей я выведу."

# game/Story03.rpy:5716
translate russian akt3chapter5_1_c69329cb:

    # em "That’s the last time."
    em "Это было последнее предупреждение."

# game/Story03.rpy:5718
translate russian akt3chapter5_1_d81137e0:

    # g "Why don’t we just run?!"
    g "Почему нам просто не бежать?!"

# game/Story03.rpy:5724
translate russian akt3chapter5_1_920f8a6d:

    # L "It’s already too late."
    L "Уже слишком поздно."

# game/Story03.rpy:5726
translate russian akt3chapter5_1_325dc429:

    # L "The gat— Tower is about to activate."
    L "Вра- Башня вот-вот активируется."

# game/Story03.rpy:5730
translate russian akt3chapter5_1_4a45358c:

    # L "It’s over. Not just the city, the whole planet."
    L "Все закончится. Не только город, вся планета."

# game/Story03.rpy:5733
translate russian akt3chapter5_1_38132948:

    # ggg "WHAT?! What are you even saying?"
    ggg "ЧТО?! Что ты вообще такое говоришь?"

# game/Story03.rpy:5734
translate russian akt3chapter5_1_86529014:

    # gggg "That can't be..."
    gggg "Не может быть..."

# game/Story03.rpy:5735
translate russian akt3chapter5_1_45c37613:

    # k "Sis... What do we do?"
    k "Сестра... что нам делать?"

# game/Story03.rpy:5739
translate russian akt3chapter5_1_bcc1523c:

    # a "It's true."
    a "Это правда."

# game/Story03.rpy:5759
translate russian akt3chapter5_1_82091822_1:

    # k "..."
    k "..."

# game/Story03.rpy:5762
translate russian akt3chapter5_1_0529ebd9:

    # ggg "But we don’t have the manpower to take it..."
    ggg "Но у нас не хватит людей, чтобы взять ее..."

# game/Story03.rpy:5766
translate russian akt3chapter5_1_2c242fe3:

    # Fl "The team, led by [mc] will head straight to the tower's core."
    Fl "Группа под командованием [mc] отправится прямо к ядру башни."

# game/Story03.rpy:5773
translate russian akt3chapter5_1_b0787021:

    # mc "You have one choice: stay here… or fight."
    mc "Выбор один: остаться здесь... или сражаться."

# game/Story03.rpy:5783
translate russian akt3chapter5_1_ec129253:

    # mc "I’m not going to sit around."
    mc "Я не собираюсь сидеть и ждать."

# game/Story03.rpy:5784
translate russian akt3chapter5_1_a600edea:

    # mc "I’m going."
    mc "Я иду."

# game/Story03.rpy:5786
translate russian akt3chapter5_1_7d1f3def:

    # mc "Alone, if I have to."
    mc "Один, если придется."

# game/Story03.rpy:5788
translate russian akt3chapter5_1_0061b368_4:

    # ggg "..."
    ggg "..."

# game/Story03.rpy:5790
translate russian akt3chapter5_1_0061b368_5:

    # ggg "..."
    ggg "..."

# game/Story03.rpy:5794
translate russian akt3chapter5_1_2c1640cb:

    # mc "(Whispering) No choice..."
    mc "(шепотом) Выбора нет..."

# game/Story03.rpy:5801
translate russian akt3chapter5_1_060ab042:

    # ggg "Fuck it. Better than waiting."
    ggg "Да пошло оно. Лучше, чем ждать."

# game/Story03.rpy:5833
translate russian akt3chapter5_1_66158ff4:

    # g "I’d rather die with a gun, than under their boots in some filthy hole."
    g "Я лучше умру с оружием в руках, чем под их сапогами в какой-нибудь грязной дыре."

# game/Story03.rpy:5843
translate russian akt3chapter5_2_2625fddd:

    # aa "Almost imperial, grand, with just a hint of mass grave."
    aa "Почти имперски. Величественно. С легким привкусом братской могилы."

# game/Story03.rpy:5874
translate russian akt3chapter5_2_35dffb23:

    # sel "Leave her."
    sel "Оставь ее."

# game/Story03.rpy:5879
translate russian akt3chapter5_2_7a92fef3:

    # sel "Don’t worry. This will end soon enough."
    sel "Не волнуйся. Скоро все закончится."

# game/Story03.rpy:5889
translate russian akt3chapter5_2_8ebdca62:

    # sel "Though abandoning your own people…"
    sel "Хотя бросить собственный народ..."

# game/Story03.rpy:5891
translate russian akt3chapter5_2_86694098:

    # am "Not betrayal."
    am "Это не предательство."

# game/Story03.rpy:5893
translate russian akt3chapter5_2_666ff92b:

    # sel "Is that what you call it?"
    sel "Так ты это называешь?"

# game/Story03.rpy:5895
translate russian akt3chapter5_2_18b55e4f:

    # am "Mercy."
    am "Милосердие."

# game/Story03.rpy:5900
translate russian akt3chapter5_2_5935d0ed:

    # sel "If that comforts you… keep it."
    sel "Если тебе от этого легче... держись за это."

# game/Story03.rpy:5901
translate russian akt3chapter5_2_a67525ab:

    # sel "Judgment was never my role."
    sel "Судить никогда не было моей ролью."

# game/Story03.rpy:5903
translate russian akt3chapter5_2_1a5bc27a:

    # am "Emotion is weakness."
    am "Эмоции - слабость."

# game/Story03.rpy:5904
translate russian akt3chapter5_2_4ef316d7:

    # am "And you’ve surrendered to it."
    am "А ты им сдалась."

# game/Story03.rpy:5906
translate russian akt3chapter5_2_1afa2acd:

    # sel "Then why do you still want her back?"
    sel "Тогда почему ты все еще хочешь вернуть ее?"

# game/Story03.rpy:5910
translate russian akt3chapter5_2_624c47f0:

    # am "So I can finally be done with this."
    am "Чтобы наконец покончить с этим."

# game/Story03.rpy:5912
translate russian akt3chapter5_2_095d5754:

    # sel "We’re not as different as you pretend."
    sel "Мы не так уж различаемся, как ты изображаешь."

# game/Story03.rpy:5918
translate russian akt3chapter5_2_b1f87fea:

    # am "You still confuse desire with purpose."
    am "Ты все еще путаешь желание с предназначением."

# game/Story03.rpy:5920
translate russian akt3chapter5_2_41973757:

    # sel "Perhaps."
    sel "Возможно."

# game/Story03.rpy:5923
translate russian akt3chapter5_2_54593eb7:

    # sel "Destroying my head was, at the very least, discourteous."
    sel "Уничтожить мою голову было, по меньшей мере, невежливо."

# game/Story03.rpy:5939
translate russian akt3chapter5_2_3400050f:

    # sel "You knew. And still..."
    sel "Ты знала. И все равно..."

# game/Story03.rpy:5951
translate russian akt3chapter5_2_0e159cb4:

    # sel "That’s not like you, Astoria..."
    sel "Это на тебя не похоже, Астория..."

# game/Story03.rpy:5953
translate russian akt3chapter5_2_19e922b3:

    # Fl "Then again..."
    Fl "Хотя..."

# game/Story03.rpy:6019
translate russian akt3chapter5_2_746f342b:

    # Fl "Boop..."
    Fl "Тык..."

# game/Story03.rpy:6035
translate russian akt3chapter5_2_90dbf691:

    # Fl "...Now’s not the time."
    Fl "...Сейчас не время."

# game/Story03.rpy:6041
translate russian akt3chapter5_2_bac26605:

    # mc "(Time to go. I owe a visit..."
    mc "(Пора идти. Я задолжал один визит..."

# game/Story03.rpy:6059
translate russian akt3chapter5_2_d4e58502:

    # h "That’s not fair! We agreed, no implants, no cheap tricks!"
    h "Так нечестно! Мы договорились: без имплантов и дешевых трюков!"

# game/Story03.rpy:6112
translate russian akt3chapter5_2_c37e4714:

    # h "Let me guess, Lora’s handwork?"
    h "Дай угадаю, дело рук Лоры?"

# game/Story03.rpy:6127
translate russian akt3chapter5_2_bb48386b:

    # h "You’ve been awfully popular lately."
    h "Ты в последнее время подозрительно популярен."

# game/Story03.rpy:6160
translate russian akt3chapter5_2_350e2379:

    # h "Don’t give me that look."
    h "Не смотри на меня так."

# game/Story03.rpy:6161
translate russian akt3chapter5_2_a77a6f27:

    # h "Every time I turn around, there’s another girl hanging off you."
    h "Стоит отвернуться - на тебе уже виснет очередная девчонка."

# game/Story03.rpy:6162
translate russian akt3chapter5_2_2ace915a:

    # h "Just don’t lie to me."
    h "Только не ври мне."

# game/Story03.rpy:6166
translate russian akt3chapter5_2_58a2d515:

    # h "And don’t make me feel replaceable."
    h "И не заставляй меня чувствовать, что меня можно заменить."

# game/Story03.rpy:6168
translate russian akt3chapter5_2_fbba889c:

    # h "Honestly?"
    h "Честно?"

# game/Story03.rpy:6204
translate russian akt3chapter5_2_c255441b:

    # h "I’m not even sure who scares me more."
    h "Я уже не уверена, кто пугает меня сильнее."

# game/Story03.rpy:6205
translate russian akt3chapter5_2_4ca4391a:

    # h "You... or Lora."
    h "Ты... или Лора."

# game/Story03.rpy:6207
translate russian akt3chapter5_2_d080bc42:

    # h "I keep telling myself this is a bad idea."
    h "Я все твержу себе, что это плохая идея."

# game/Story03.rpy:6213
translate russian akt3chapter5_2_f9ce9344:

    # h "But every time I try to back away..."
    h "Но каждый раз, когда пытаюсь отступить..."

# game/Story03.rpy:6218
translate russian akt3chapter5_2_fa0c3cd5:

    # h "I just want you more."
    h "мне только сильнее хочется тебя."

# game/Story03.rpy:6219
translate russian akt3chapter5_2_adbfa2cd:

    # mc "I don’t really care."
    mc "Мне, честно, все равно."

# game/Story03.rpy:6229
translate russian akt3chapter5_2_201b6c08:

    # h "You’ve got terrible timing."
    h "Ты ужасно выбираешь момент."

# game/Story03.rpy:6230
translate russian akt3chapter5_2_51b52653:

    # h "...You’re impossible."
    h "...С тобой невозможно."

# game/Story03.rpy:6232
translate russian akt3chapter5_2_c6f01622:

    # h "What the hell got into you today?"
    h "Что на тебя сегодня нашло?"

# game/Story03.rpy:6234
translate russian akt3chapter5_2_64d5bba1:

    # h "...Cocky asshole."
    h "...Самоуверенный мудак."

# game/Story03.rpy:6237
translate russian akt3chapter5_2_faf95fd1:

    # mc "You don’t have to act tough with me."
    mc "Со мной не нужно строить из себя железную."

# game/Story03.rpy:6238
translate russian akt3chapter5_2_a82676f1:

    # h "...Says who?"
    h "...Это кто сказал?"

# game/Story03.rpy:6239
translate russian akt3chapter5_2_8ee75081_1:

    # mc "You’re shaking."
    mc "Ты дрожишь."

# game/Story03.rpy:6241
translate russian akt3chapter5_2_cd543497:

    # h "...You fight dirty."
    h "...Ты играешь грязно."

# game/Story03.rpy:6242
translate russian akt3chapter5_2_e7240eb2:

    # mc "You started this."
    mc "Ты сама начала."

# game/Story03.rpy:6244
translate russian akt3chapter5_2_a89bccd2:

    # h "You talk too damn much."
    h "Ты слишком много болтаешь."

# game/Story03.rpy:6245
translate russian akt3chapter5_2_69b064b1:

    # h "...And stop looking at me like that."
    h "...И перестань так на меня смотреть."

# game/Story03.rpy:6247
translate russian akt3chapter5_2_b2aba0e3:

    # mc "Like what?"
    mc "Как?"

# game/Story03.rpy:6249
translate russian akt3chapter5_2_900f9f9b:

    # h "...awkward."
    h "...неловко."

# game/Story03.rpy:6251
translate russian akt3chapter5_2_ff55d33c:

    # mc "You keep testing people."
    mc "Ты все время проверяешь людей."

# game/Story03.rpy:6252
translate russian akt3chapter5_2_aa946c3b:

    # mc "I’m just not backing away."
    mc "Я просто не отступаю."

# game/Story03.rpy:6254
translate russian akt3chapter5_2_e94e6658:

    # h "...That’s the problem."
    h "...В этом и проблема."

# game/Story03.rpy:6256
translate russian akt3chapter5_2_1b665527:

    # h "...So what now?"
    h "...И что теперь?"

# game/Story03.rpy:6258
translate russian akt3chapter5_2_793b2a87:

    # h "You gonna keep talking..."
    h "Так и будешь болтать..."

# game/Story03.rpy:6259
translate russian akt3chapter5_2_ede40bb0:

    # h "Or finally do something?"
    h "или наконец что-нибудь сделаешь?"

# game/Story03.rpy:6264
translate russian akt3chapter5_2_216fe352:

    # mc "You’re already shaking."
    mc "Ты уже дрожишь."

# game/Story03.rpy:6266
translate russian akt3chapter5_2_f2718d2c:

    # h "...And whose fault is that?"
    h "...И чья это вина?"

# game/Story03.rpy:6267
translate russian akt3chapter5_2_eae9fce4:

    # mc "You keep acting like you’ve still got your guard up."
    mc "Ты все еще делаешь вид, будто держишь оборону."

# game/Story03.rpy:6268
translate russian akt3chapter5_2_513c1325:

    # h "Maybe I do."
    h "Может, и держу."

# game/Story03.rpy:6269
translate russian akt3chapter5_2_fc4fd4bd:

    # mc "Not with me."
    mc "Не со мной."

# game/Story03.rpy:6270
translate russian akt3chapter5_2_a9e5ea3b:

    # h "...Shut up."
    h "...Заткнись."

# game/Story03.rpy:6271
translate russian akt3chapter5_2_0bf12d49:

    # mc "(Those trembling fingers... that uneven breathing...)"
    mc "(Эти дрожащие пальцы... это сбившееся дыхание...)"

# game/Story03.rpy:6272
translate russian akt3chapter5_2_fa1b5189:

    # mc "(She’s trying so hard not to break first.)"
    mc "(Она изо всех сил старается не сломаться первой.)"

# game/Story03.rpy:6281
translate russian akt3chapter5_2_8d2ab91d:

    # h "...You really don’t back off, do you?"
    h "...Ты правда не отступаешь, да?"

# game/Story03.rpy:6282
translate russian akt3chapter5_2_5e01d4cd:

    # mc "Should I?"
    mc "А должен?"

# game/Story03.rpy:6283
translate russian akt3chapter5_2_adec3928:

    # h "...No."
    h "...Нет."

# game/Story03.rpy:6284
translate russian akt3chapter5_2_cca62a2c:

    # h "That’s what makes this so damn unfair."
    h "Вот поэтому все так чертовски нечестно."

# game/Story03.rpy:6285
translate russian akt3chapter5_2_46398104:

    # mc "You could still stop me."
    mc "Ты все еще можешь меня остановить."

# game/Story03.rpy:6286
translate russian akt3chapter5_2_e417c014:

    # h "...I know."
    h "...Я знаю."

# game/Story03.rpy:6287
translate russian akt3chapter5_2_63cbbd81:

    # mc "(All that attitude, all that fire...)"
    mc "(Все эти колкости, весь этот огонь...)"

# game/Story03.rpy:6288
translate russian akt3chapter5_2_c5b48b29:

    # mc "(And underneath it... she just wants someone who stays.)"
    mc "(А под ними... она просто хочет того, кто останется.)"

# game/Story03.rpy:6289
translate russian akt3chapter5_2_3d37c993:

    # h "(I hate this...)"
    h "(Ненавижу это...)"

# game/Story03.rpy:6290
translate russian akt3chapter5_2_718ac1c4:

    # h "(...How easy it is to lose myself around him.)"
    h "(...Как легко я рядом с ним теряю себя.)"

# game/Story03.rpy:6291
translate russian akt3chapter5_2_8fd50577:

    # mc "You don’t always have to fight me."
    mc "Тебе не обязательно все время со мной бороться."

# game/Story03.rpy:6292
translate russian akt3chapter5_2_34d45548:

    # h "...Maybe."
    h "...Может быть."

# game/Story03.rpy:6293
translate russian akt3chapter5_2_898df622:

    # h "But I don’t know how not to."
    h "Но я не знаю, как иначе."

# game/Story03.rpy:6294
translate russian akt3chapter5_2_6f887114:

    # mc "Then stop thinking."
    mc "Тогда перестань думать."

# game/Story03.rpy:6295
translate russian akt3chapter5_2_2e0b71c8:

    # h "...That’s a terrible idea."
    h "...Это ужасная идея."

# game/Story03.rpy:6296
translate russian akt3chapter5_2_ad254bb7:

    # mc "You still haven’t moved away."
    mc "Но ты все еще не отстранилась."

# game/Story03.rpy:6297
translate russian akt3chapter5_2_daedd3b9:

    # h "...Yeah."
    h "...Да."

# game/Story03.rpy:6298
translate russian akt3chapter5_2_ddcf3c8f:

    # h "...Guess I haven’t."
    h "...Похоже, нет."

# game/Story03.rpy:6304
translate russian akt3chapter6_99155a02:

    # "Sector 3."
    "Сектор 3."

