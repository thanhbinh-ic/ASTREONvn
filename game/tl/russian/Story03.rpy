translate russian act3_5chapter1_cbdba510:

    # k "I said: I’m bored! {w=1.0}Say something already — entertain me."
    k "Я сказала: мне скучно! {w=1.0}Скажи что-нибудь - развлеки меня."

# game/Story03.rpy:6851
translate russian act3_5chapter1_2b35b6fe_5:

    # mc "..."
    mc "..."

# game/Story03.rpy:6855
translate russian act3_5chapter1_0d46d1f5:

    # mc "Alright then. You want words, I’ll keep them simple."
    mc "Ладно. Если тебе нужны слова, я буду говорить проще."

# game/Story03.rpy:6856
translate russian act3_5chapter1_68f7bd7a:

    # mc "So? What do you want to hear?"
    mc "Итак? Что ты хочешь услышать?"

