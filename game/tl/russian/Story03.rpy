    # a "I’ll handle part of it. The rest — is on you."
    a "Часть я беру на себя. Остальное — на тебе."

# game/Story03.rpy:2239
translate russian akt3chapter2_8b7318c3:

    # a "If you fail — they die."
    a "Если не справишься - они умрут."

