    # k "What matters is {b}how{/b} we pull it off!"
    k "Важно то, {b}как{/b} мы это делаем!"

# game/Story03.rpy:4500
translate russian akt3chapter3_a98f2e89:

    # em "With honors, that’s for sure."
    em "С честью, это уж точно."

# game/Story03.rpy:4503
translate russian akt3chapter3_7626e7b5:

    # a "You're in charge?"
    a "Ты здесь главная?"

# game/Story03.rpy:4506
translate russian akt3chapter3_0b229df3:

    # Fl "The Great Maiden lowers herself to speak to the underlings. Should I bow or just quietly take orders, Your Highness?"
    Fl "Великая Дева снизошла до разговора с мелкой сошкой. Мне поклониться или просто тихо выполнять приказы, ваше высочество?"

# game/Story03.rpy:4512
translate russian akt3chapter3_12c6f66d:

    # a "They let children command armies now. Color me unimpressed."
    a "Теперь они позволяют детям командовать армиями. Я не впечатлена."

# game/Story03.rpy:4514
translate russian akt3chapter3_d80ddf67:

    # Fl "My record of lives saved still outweighs your list of failures."
    Fl "Мой список спасённых жизней всё ещё превосходит твой список провалов."

# game/Story03.rpy:4515
translate russian akt3chapter3_aaa21477:

    # Fl "Babysitting a girl? Well, if her IQ barely matches room temperature, I get it — that’s a challenge for you."
    Fl "Присматривать за девушкой? Что ж, если её IQ едва достигает комнатной температуры, то я понимаю - для тебя это вызов."

# game/Story03.rpy:4519
translate russian akt3chapter3_6b0b9631:

    # a "Don’t test me."
    a "Не испытывай меня."

# game/Story03.rpy:4522
translate russian akt3chapter3_c555b102:

    # Fl "This isn’t your battlefield. My rules. Accept it or stay mad — quietly."
    Fl "Это не твоё поле боя. Здесь мои правила. Прими их или продолжай злиться - только тихонько."

# game/Story03.rpy:4524
translate russian akt3chapter3_a6e61a6a:

    # a "You're loud. That’s not the same as being dangerous."
    a "Ты громкая. Это не то же самое, что быть опасной."

# game/Story03.rpy:4526
translate russian akt3chapter3_3aa37f22:

    # Fl "You can rage all you want. The only thing you'll affect is the ambient temperature."
    Fl "Можешь злиться сколько хочешь. Единственное, на что это повлияет, - это температура окружающей среды."

# game/Story03.rpy:4532
translate russian akt3chapter3_2aa338e7:

    # k "Let it go. You wouldn't last against Ember anyway."
    k "Брось это. Ты всё равно не выстоишь против Эмбер."

# game/Story03.rpy:4533
translate russian akt3chapter3_0cfd9cd7:

    # k "And you need rest. Urgently. Before you decide to start a solo apocalypse."
    k "И тебе нужен отдых. Срочно. Пока ты не решила устроить сольный апокалипсис."

# game/Story03.rpy:4541
translate russian akt3chapter3_8ab2b4c1:

    # Fl "Every interaction with you is a damn migraine..."
    Fl "Каждое общение с вами - это чёртова мигрень..."

# game/Story03.rpy:4545
translate russian akt3chapter3_d40b423d:

    # Fl "All wounded to the medbay. Everyone else — to your rooms."
    Fl "Все раненые - в медблок. Все остальные - в свои комнаты."

# game/Story03.rpy:4546
translate russian akt3chapter3_4fe3728e:

    # Fl "And if I see anyone still here in ten minutes, go straight to the morgue."
    Fl "И если я увижу здесь кого-то через десять минут, отправляйтесь прямо в морг."

# game/Story03.rpy:4549
translate russian akt3chapter3_26530924:

    # Fl "Miriel, keep your people in line."
    Fl "Мириэль, присмотри за своими."

# game/Story03.rpy:4559
translate russian akt3chapter3_2cb042fd:

    # Fl "Kalestra, your sister’s your responsibility."
    Fl "Калестра, на тебе твоя сестра."

# game/Story03.rpy:4562
translate russian akt3chapter3_dd0ae64a:

    # k "Yeah, yeah. {w}Like a babysitter. With claws. And attitude."
    k "Да, да. {w}Как нянька. С когтями. И характером."

# game/Story03.rpy:4565
translate russian akt3chapter3_e15331ee:

    # k "Let’s just hope she doesn’t snap again."
    k "Будем надеяться, что она больше не сорвётся."

# game/Story03.rpy:4566
translate russian akt3chapter3_b1e4dd11:

    # k "Wouldn’t want the show getting too bloody even for my taste."
    k "Не хотелось бы, чтобы шоу стало слишком кровавым даже для моего вкуса."

# game/Story03.rpy:4568
translate russian akt3chapter3_053eee4d:

    # mc "(Snap again? Side effect from the activation?)"
    mc "(Не сорвётся? Побочный эффект от активации?)"

# game/Story03.rpy:4570
translate russian akt3chapter3_ba1a845a:

    # Fl "You — with me. Now."
    Fl "Ты — за мной. Сейчас же."

# game/Story03.rpy:4572
translate russian akt3chapter3_ad2ba4ed:

    # mc "I need to see Olivia and Lora."
    mc "Мне нужно увидеться с Оливией и Лорой."

# game/Story03.rpy:4574
translate russian akt3chapter3_e62dfc9d:

    # Fl "I don't think so."
    Fl "Я так не думаю."

# game/Story03.rpy:4577
translate russian akt3chapter3_a5341718:

    # Fl "Remember? You promised."
    Fl "Помнишь? Ты обещал."

# game/Story03.rpy:4578
translate russian akt3chapter3_8489819f:

    # Fl "And I don’t have time to wait. Got it?"
    Fl "И у меня нет времени ждать. Понял?"

# game/Story03.rpy:4583
translate russian akt3chapter3_5106d1fd:

    # mc "You’ve got something twisted, girl."
    mc "Ты что-то путаешь, девочка."

# game/Story03.rpy:4584
translate russian akt3chapter3_1b9b815a:

    # mc "I need to make sure they’re safe. And until I do..."
    mc "Мне нужно убедиться в их безопасности. И пока я это не сделаю..."

# game/Story03.rpy:4587
translate russian akt3chapter3_e352e2a2:

    # Fl "They’re fine. So let’s drop this."
    Fl "Они в порядке... Поэтому прекрати это."

# game/Story03.rpy:4589
translate russian akt3chapter3_4fcecb30:

    # mc "(What’s with her? She’s unusually docile... and afraid?)"
    mc "(Что с ней? Она на удивление покорна... и напугана?)"

# game/Story03.rpy:4591
translate russian akt3chapter3_e3c4889f:

    # mc "Did something happen?"
    mc "Что-то случилось?"

# game/Story03.rpy:4594
translate russian akt3chapter3_84dcb8a4:

    # Fl "It’s..."
    Fl "Это..."

# game/Story03.rpy:4595
translate russian akt3chapter3_6743d88a:

    # Fl "(Whispers) Over there. I’ll explain. Just... not here. Not now."
    Fl "{i}*шепчет*{/i} Туда. Я объясню. Только... не здесь. Не сейчас."

# game/Story03.rpy:4597
translate russian akt3chapter3_315d63ac:

    # mc "(Her voice… it’s shaking. This is the first time I’ve seen her like this.)"
    mc "(Её голос... он дрожит. Я впервые вижу её такой.)"

# game/Story03.rpy:4598
translate russian akt3chapter3_5be3d4df:

    # mc "Alright. Lead the way."
    mc "Ладно, веди."

# game/Story03.rpy:4600
translate russian akt3chapter3_4fc34a4d:

    # em "Get this ship in shape. We’ll need it again."
    em "Приведите этот корабль в порядок. Он нам ещё пригодится."

# game/Story03.rpy:4601
translate russian akt3chapter3_a7e0495a:

    # "Yes, ma’am."
    ggg "Есть."

# game/Story03.rpy:4613
translate russian akt3chapter3_112b64e7:

    # Fl "So tell me — how did you end up stuck at the outpost while your darling wife and Olivia landed here?"
    Fl "Итак, скажи мне - как ты оказался застрявшим на аванпосте, в то время как твоя любимая жена и Оливия приземлились здесь?"

# game/Story03.rpy:4616
translate russian akt3chapter3_64bbb18b:

    # mc "You’ve got a real gift for digging into old wounds, don’t you?"
    mc "У тебя настоящий талант копаться в старых ранах, не так ли?"

# game/Story03.rpy:4617
translate russian akt3chapter3_117eb6a4:

    # mc "What now? A moral lecture?"
    mc "Что теперь? Нравоучительная лекция?"

# game/Story03.rpy:4620
translate russian akt3chapter3_f628680d:

    # Fl "No. Not my style."
    Fl "Нет. Не в моём стиле."

# game/Story03.rpy:4623
translate russian akt3chapter3_33495cec:

    # Fl "I’m after something else..."
    Fl "Меня интересует кое-что другое..."

# game/Story03.rpy:4627
translate russian akt3chapter3_1ea74283:

    # Fl "Did you manage to bring Miriel under control?"
    Fl "Тебе удалось взять Мириэль под контроль?"

# game/Story03.rpy:4630
translate russian akt3chapter3_c1bd5175:

    # mc "Plans changed. It's not that simple."
    mc "Планы изменились. Это не так просто."

# game/Story03.rpy:4634
translate russian akt3chapter3_1528c240:

    # Fl "(Quietly) Of course. It never is..."
    Fl "{i}*шепчет*{/i} Конечно. Никогда не бывает просто..."

# game/Story03.rpy:4635
translate russian akt3chapter3_2316efdb:

    # Fl "Tell me honestly — did you drop everything because of her?"
    Fl "Скажи честно. Ты бросил всё из-за неё?"

# game/Story03.rpy:4637
translate russian akt3chapter3_4a4f5136:

    # mc "That’s none of your business."
    mc "Это не твоё дело."

# game/Story03.rpy:4639
translate russian akt3chapter3_994ce7c8:

    # Fl "Have you always been like this? Or is this something new?"
    Fl "Ты всегда был таким? Или это что-то новенькое?"

# game/Story03.rpy:4642
translate russian akt3chapter3_3d3037c5:

    # mc "You’re becoming unbearable."
    mc "Ты становишься невыносимой."

# game/Story03.rpy:4644
translate russian akt3chapter3_92447ec5:

    # Fl "That never used to stop you."
    Fl "Это никогда тебя не останавливало."

# game/Story03.rpy:4648
translate russian akt3chapter3_cc5cf145:

    # Fl "So? What did you find out?"
    Fl "Ну? Что ты выяснил?"

# game/Story03.rpy:4652
translate russian akt3chapter3_385f2ff3:

    # mc "And why exactly should I tell you anything?"
    mc "И с какой стати я должен тебе что-то рассказывать?"

# game/Story03.rpy:4654
translate russian akt3chapter3_ad580b80:

    # Fl "Because I’m asking. {w}If you’d rather — I’ll make it an order, but the outcome won’t change."
    Fl "Потому что я тебя прошу. {w}Если хочешь - я могу приказать, но результат от этого не изменится."

# game/Story03.rpy:4656
translate russian akt3chapter3_d7f2e3bd:

    # mc "Why her? Why now?"
    mc "Почему она? Почему сейчас?"

# game/Story03.rpy:4658
translate russian akt3chapter3_ce819397:

    # Fl "Because... everything’s falling apart."
    Fl "Потому что... всё трещит по швам."

# game/Story03.rpy:4662
translate russian akt3chapter3_b3471000:

    # Fl "And she might be the only hope left."
    Fl "И она, возможно, единственная оставшаяся надежда."

# game/Story03.rpy:4664
translate russian akt3chapter3_ae8604bd:

    # mc "(She raised her voice, but it’s not anger. It’s… panic?)"
    mc "(Она повысила голос, но это не злость. Это… паника?)"

# game/Story03.rpy:4666
translate russian akt3chapter3_bf5e593a:

    # mc "You're taking too much on yourself."
    mc "Ты берёшь на себя слишком много."

# game/Story03.rpy:4671
translate russian akt3chapter3_69558449:

    # Fl "Right now, millions of lives depend on my decisions!"
    Fl "Сейчас миллионы жизней зависят от моих решений!"

# game/Story03.rpy:4673
translate russian akt3chapter3_d74e485e:

    # Fl "And no matter what it takes — you will tell me everything!"
    Fl "И чего бы это ни стоило - ты расскажешь мне всё!"

# game/Story03.rpy:4674
translate russian akt3chapter3_26dc7cab:

    # Fl "Is that clear?!"
    Fl "Ясно?!"

# game/Story03.rpy:4678
translate russian akt3chapter3_462bfeb8:

    # mc "So your great idea was to push me, provoke me, and put on a show?"
    mc "Так твоя гениальная идея заключалась в том, чтобы подтолкнуть меня, спровоцировать и устроить шоу?"

# game/Story03.rpy:4679
translate russian akt3chapter3_a99ec2ca:

    # mc "...who are you even trying to be right now, Flora?"
    mc "...Кем ты вообще сейчас пытаешься быть, Флора?"

# game/Story03.rpy:4685
translate russian akt3chapter3_a550c833:

    # mc "Let me go."
    mc "Отпусти."

# game/Story03.rpy:4688
translate russian akt3chapter3_d2a9d41c:

    # Fl "...You don’t understand. You refuse to understand!"
    Fl "...Ты не понимаешь. Ты просто не хочешь понимать!"

# game/Story03.rpy:4693
translate russian akt3chapter3_74375137:

    # mc "This isn’t like the Flora I knew. What’s going on with you?"
    mc "Это не та Флора, которую я знал. Что с тобой происходит?"

# game/Story03.rpy:4696
translate russian akt3chapter3_8f12f96e:

    # Fl "Nothing’s going according to plan — absolutely nothing."
    Fl "Ничего не идёт по плану - абсолютно ничего."

# game/Story03.rpy:4699
translate russian akt3chapter3_68455c78:

    # Fl "Everything I built — crumbling. All my work, this entire damn system, my calculations — dust!"
    Fl "Всё, что я построила, рушится. Вся моя работа, вся эта чёртова система, мои расчёты - всё превратилось в пыль!"

# game/Story03.rpy:4700
translate russian akt3chapter3_bea9fa06:

    # mc "(She’s trembling, eyes darting. Her face... swollen from crying. This isn’t the Flora I remember.)"
    mc "(Она дрожит, её глаза бегают по сторонам. Её лицо... опухло от слёз. Это не та Флора, которую я помню.)"

# game/Story03.rpy:4702
translate russian akt3chapter3_5b002a71:

    # mc "You’re alone in this, aren’t you?"
    mc "Ты в этом одна, не так ли?"

# game/Story03.rpy:4705
translate russian akt3chapter3_824127f1:

    # Fl "...Yes."
    Fl "...Да."

# game/Story03.rpy:4708
translate russian akt3chapter3_feb9a2d0:

    # mc "You tried to bait me, manipulate, threaten…"
    mc "Ты пыталась меня спровоцировать, манипулировать, угрожать..."

# game/Story03.rpy:4709
translate russian akt3chapter3_2876efd9:

    # mc "Why?"
    mc "Зачем?"

# game/Story03.rpy:4712
translate russian akt3chapter3_16933c23:

    # Fl "Because it’s the only way I know how."
    Fl "Потому что это единственный способ, который я знаю."

# game/Story03.rpy:4714
translate russian akt3chapter3_9fbe019c:

    # mc "(God... Is it really that bad?)"
    mc "(Боже... Неужели всё так плохо?)"

# game/Story03.rpy:4723
translate russian akt3chapter3_038d4145:

    # Fl "My social skills are garbage — as you know."
    Fl "Мои навыки общения - полный отстой, как ты знаешь."

# game/Story03.rpy:4725
translate russian akt3chapter3_ab6bfb2b:

    # Fl "It was the only way I knew to get your attention."
    Fl "Это было единственное, что я могла использовать, чтобы привлечь твоё внимание."

# game/Story03.rpy:4728
translate russian akt3chapter3_5e3b205c:

    # mc "(Yeah. She’s brilliant. She’s ruthless. But beneath it all — just a shattered girl.)"
    mc "(Да. Она великолепна. Она безжалостна. Но под всем этим - просто разбитая девушка.)"

# game/Story03.rpy:4731
translate russian akt3chapter3_bed05a46:

    # Fl "If you want to laugh — go ahead."
    Fl "Если хочешь смеяться - вперёд."

# game/Story03.rpy:4732
translate russian akt3chapter3_102c29b9:

    # Fl "The genius scientist, razor-sharp mind, and a completely shitty personality."
    Fl "Гениальный учёный, острый ум и совершенно отвратительный характер."

# game/Story03.rpy:4733
translate russian akt3chapter3_62309409:

    # Fl "Who falls apart the second a real crisis hits."
    Fl "Которая разваливается в момент, когда наступает настоящий кризис."

# game/Story03.rpy:4742
translate russian akt3chapter3_a65456bc:

    # mc "I’ll help you."
    mc "Я помогу тебе."

# game/Story03.rpy:4746
translate russian akt3chapter3_3bb43600:

    # Fl "...What?"
    Fl "...Что?"

# game/Story03.rpy:4749
translate russian akt3chapter3_9525d822:

    # mc "But I’ve got one condition."
    mc "Только у меня одно условие."

# game/Story03.rpy:4757
translate russian akt3chapter3_5de5408f:

    # Fl "Name it."
    Fl "Какое?"

# game/Story03.rpy:4760
translate russian akt3chapter3_dc743ce7:

    # mc "No more pretending to be the heartless queen. Just be real — as much as you can."
    mc "Хватит притворяться бездушной королевой. Просто будь собой - насколько это возможно."

# game/Story03.rpy:4762
translate russian akt3chapter3_a8657bc4:

    # mc "Deal?"
    mc "Что скажешь?"

# game/Story03.rpy:4765
translate russian akt3chapter3_6d9b14fe:

    # Fl "I... can’t promise."
    Fl "Я... ничего не обещаю."

# game/Story03.rpy:4768
translate russian akt3chapter3_f44123e4:

    # Fl "But I’ll try."
    Fl "Но я постараюсь."

# game/Story03.rpy:4772
translate russian akt3chapter3_52ece02b:

    # L "WHAT THE HELL HAVE YOU DONE?!"
    L "КАКОГО ХРЕНА ТЫ ТУТ УСТРОИЛА?!"

# game/Story03.rpy:4776
translate russian akt3chapter3_65f15cf6:

    # Fl "And here comes the drama queen herself. Hello, darling."
    Fl "А вот и королева драмы. Привет, дорогая."

# game/Story03.rpy:4778
translate russian akt3chapter3_a19f4931:

    # mc "(Whispers) This is bad."
    mc "{i}*шепчет*{/i} Это плохо."

# game/Story03.rpy:4791
translate russian akt3chapter3_e32f9a1e:

    # L "What did you do with him?! Answer me!"
    L "Что ты с ним делала?! Отвечай!"

# game/Story03.rpy:4793
translate russian akt3chapter3_91ba8ed1:

    # Fl "Ouch..."
    Fl "Ауч...."

# game/Story03.rpy:4795
translate russian akt3chapter3_14a446e9:

    # Fl "Agg-ression. How very original."
    Fl "Агрессия. Как оригинально."

# game/Story03.rpy:4798
translate russian akt3chapter3_6680de12:

    # L "I’m talking to you!"
    L "Я с тобой разговариваю!"

# game/Story03.rpy:4800
translate russian akt3chapter3_e17d658f:

    # mc "Calm down. Nothing happened."
    mc "Успокойся. Ничего не было."

# game/Story03.rpy:4803
translate russian akt3chapter3_b280a2bd:

    # L "But she—"
    L "Но она-"

# game/Story03.rpy:4805
translate russian akt3chapter3_f07801a8:

    # mc "I said — that’s enough. Please."
    mc "Я сказал — достаточно. Пожалуйста."

# game/Story03.rpy:4811
translate russian akt3chapter3_c2306ebf:

    # mc "Better now?"
    mc "Лучше?"

# game/Story03.rpy:4821
translate russian akt3chapter3_cfb67220:

    # mc "(Jumping into a fight with no intel... That part of you hasn’t changed.)"
    mc "(Лезть в драку без какой либо информации... Это в тебе не изменилось.)"

# game/Story03.rpy:4825
translate russian akt3chapter3_757d549e:

    # mc "(But this is on me too. I should’ve stopped it earlier.)"
    mc "(Но в этом есть и моя вина. Мне стоило сразу остановить это.)"

# game/Story03.rpy:4828
translate russian akt3chapter3_859f55c3:

    # mc "I’m sorry. Are you okay?"
    mc "Прости. Ты в порядке?"

# game/Story03.rpy:4832
translate russian akt3chapter3_2524113b:

    # Fl "Yes. Thank you..."
    Fl "Да. Спасибо..."

# game/Story03.rpy:4833
translate russian akt3chapter3_a0c05229:

    # mc "I’m sorry. She can be... sharp. Too sharp."
    mc "Прости. Она бывает... резкой. Слишком резкой."

# game/Story03.rpy:4835
translate russian akt3chapter3_67ae2ecb:

    # Fl "I get it. We’re all on edge these days."
    Fl "Я понимаю. В последнее время мы все на нервах."

# game/Story03.rpy:4838
translate russian akt3chapter3_43ca7453:

    # mc "(And now what? They’ve gone quiet — but for how long will this fragile ceasefire last?)"
    mc "(И что теперь? Они притихли, но как долго продлится это хрупкое перемирие?)"

# game/Story03.rpy:4841
translate russian akt3chapter3_50fc55c6:

    # mc "Both of you — sit down. We don’t have the luxury of turning on each other."
    mc "Обе - сядьте. Мы не можем позволить себе враждовать друг с другом."

# game/Story03.rpy:4843
translate russian akt3chapter3_fb4d9702:

    # L "(whispers) I saw the way you clung to him. Think I’ll just pretend I didn’t?"
    L "{i}*шепчет*{/i} Я видела, как ты к нему липла. Думаешь, я просто сделаю вид, что ничего не заметила?"

# game/Story03.rpy:4845
translate russian akt3chapter3_3583bccd:

    # Fl "I did what had to be done. Someone needed to act."
    Fl "Я делала то, что считала нужным. Хоть кто-то должен действовать."

# game/Story03.rpy:4848
translate russian akt3chapter3_5a672918:

    # L "(whispers) You’re just toying with his feelings. Again."
    L "{i}*шепчет*{/i} Ты просто играешь на его чувствах. Опять."

# game/Story03.rpy:4850
translate russian akt3chapter3_848eacfd:

    # Fl "And you? You hid. Let everyone else clean up the mess. Planning to do that again, too?"
    Fl "А ты? Ты спряталась. Надеялась, что все остальные будут убирать за тобой. Планируешь сделать это снова?"

# game/Story03.rpy:4855
translate russian akt3chapter3_25236cdf:

    # Fl "You left him once. Want to finish the job?"
    Fl "Ты уже однажды его бросила. Хочешь довести дело до конца?"

# game/Story03.rpy:4857
translate russian akt3chapter3_54d0e568:

    # mc "(This is turning into a damn circus.)"
    mc "(Это превращается в чёртов цирк.)"

# game/Story03.rpy:4859
translate russian akt3chapter3_9c3859af:

    # mc "(If this keeps up, we won’t survive another night.)"
    mc "(Если они продолжат, нам не пережить следующей ночи.)"

# game/Story03.rpy:4866
translate russian akt3chapter3_8b9ee863:

    # mc "Enough."
    mc "Хватит."

# game/Story03.rpy:4871
translate russian akt3chapter3_74b7fd2e:

    # mc "(whispers) Why is it so impossible to get women to work together...?"
    mc "{i}*шепчет*{/i} Почему так сложно заставить женщин работать вместе...?"

# game/Story03.rpy:4873
translate russian akt3chapter3_62502621:

    # mc "You’re both smart. You know this infighting will get us all killed."
    mc "Вы обе умные. Вы знаете, что эти внутренние разборки приведут к нашей гибели."

# game/Story03.rpy:4874
translate russian akt3chapter3_cccc66b8:

    # b "Hmph..."
    "{color=#ff8899}Обе{/color}" "Хмпф..."

# game/Story03.rpy:4879
translate russian akt3chapter3_d5f4a898:

    # mc "Do you really want the Abyss to win — not because it’s stronger, but because we’re stubborn?"
    mc "Вы правда хотите, чтобы нас уничтожила не Бездна, а собственное упрямство?"

# game/Story03.rpy:4881
translate russian akt3chapter3_d9cec443:

    # L "I was just worried about you..."
    L "Я просто волновалась за тебя..."

# game/Story03.rpy:4883
translate russian akt3chapter3_66c42bf9:

    # Fl "And I was trying to secure support. My way."
    Fl "Я пыталась заручиться поддержкой. По-своему."

# game/Story03.rpy:4890
translate russian akt3chapter3_1c71c4fc:

    # mc "I’m not choosing between you. Not now. Not in this nightmare."
    mc "Я не хочу делать выбор между вами. Не сейчас. Не в этом кошмаре."

# game/Story03.rpy:4892
translate russian akt3chapter3_c4901386:

    # mc "Here’s the deal. I tell you everything I know — and you stop this feud."
    mc "Вот что я предлагаю. Я расскажу вам всё, что знаю, а вы прекратите эту вражду."

# game/Story03.rpy:4894
translate russian akt3chapter3_690bfed3:

    # mc "Work together. No more rival crap. Deal?"
    mc "Работайте вместе. Хватит соперничать. Договорились?"

# game/Story03.rpy:4896
translate russian akt3chapter3_f51f3210:

    # mc "I’m waiting."
    mc "Я жду."

# game/Story03.rpy:4902
translate russian akt3chapter3_58b2f2b2:

    # Fl "You’re seriously going to tell us everything?"
    Fl "Ты правда собираешься нам всё рассказать?"

# game/Story03.rpy:4904
translate russian akt3chapter3_b4ca1312:

    # mc "Only if you act like allies. Not enemies."
    mc "Только если вы будете вести себя как союзники, а не как враги."

# game/Story03.rpy:4907
translate russian akt3chapter3_afd342ab:

    # L "I’m not sure I can..."
    L "Я не уверена, что смогу..."

# game/Story03.rpy:4909
translate russian akt3chapter3_f8ff64a1:

    # Fl "I’ll try. If you do."
    Fl "Я попробую. Если ты тоже попробуешь."

# game/Story03.rpy:4911
translate russian akt3chapter3_6d4f651a:

    # L "Fine. For his sake."
    L "Хорошо. Ради него."

# game/Story03.rpy:4918
translate russian akt3chapter3_9d71812b:

    # mc "What do you know about the mutants?"
    mc "Что вам известно об этих мутантах?"

# game/Story03.rpy:4920
translate russian akt3chapter3_bdf7c589:

    # Fl "That they’re disgusting, deadly, and slightly smarter than the Security Council."
    Fl "Что они отвратительны, смертельно опасны и немного умнее Совета Безопасности."

# game/Story03.rpy:4924
translate russian akt3chapter3_199578df:

    # mc "You know more, don’t you?"
    mc "Ты знаешь больше, не так ли?"

# game/Story03.rpy:4926
translate russian akt3chapter3_14f37b77:

    # L "So... she told you after all."
    L "Значит... она всё-таки тебе рассказала."

# game/Story03.rpy:4932
translate russian akt3chapter3_9a5e9bc7:

    # Fl "Okay, what the hell are you two hiding?"
    Fl "Ладно, что, чёрт возьми, вы скрываете?"

# game/Story03.rpy:4934
translate russian akt3chapter3_cdb379a5:

    # L "All this time... we weren’t killing monsters. We were killing people."
    L "Всё это время... мы убивали не монстров. Мы убивали людей."

# game/Story03.rpy:4936
translate russian akt3chapter3_3bb43600_1:

    # Fl "...What?"
    Fl "...Что?"

# game/Story03.rpy:4938
translate russian akt3chapter3_bc1320b3:

    # L "Or what’s left of them."
    L "Или то, что от них осталось."

# game/Story03.rpy:4940
translate russian akt3chapter3_7ab45580:

    # Fl "You’ve got to be joking..."
    Fl "Ты шутишь..."

# game/Story03.rpy:4947
translate russian akt3chapter3_971d2cd2:

    # L "(whispers) I guess I don’t have a choice anymore..."
    L "{i}*шепчет*{/i} Похоже, у меня больше нет выбора..."

# game/Story03.rpy:4952
translate russian akt3chapter3_7da2eb6d:

    # L "The tower we’re heading to — it’s a junction. Part of a massive mechanism."
    L "Башня, к которой мы направляемся, - это узловая точка. Часть огромного механизма."

# game/Story03.rpy:4954
translate russian akt3chapter3_b8c01c89:

    # Fl "A mechanism? You mean the tomb?"
    Fl "Огромного механизма? Ты о гробнице?"

# game/Story03.rpy:4961
translate russian akt3chapter3_109280b3:

    # L "Yes."
    L "Да."

# game/Story03.rpy:4963
translate russian akt3chapter3_bf175132:

    # mc "And what’s the connection to the mutants?"
    mc "И как это связано с мутантами?"

# game/Story03.rpy:4965
translate russian akt3chapter3_03804d12:

    # L "To activate the mechanism... it needs the blood of the Ancients."
    L "Для активации механизма... нужна кровь Древних."

# game/Story03.rpy:4967
translate russian akt3chapter3_7949d67b:

    # Fl "...Excuse me?"
    Fl "...Прости?"

# game/Story03.rpy:4969
translate russian akt3chapter3_7fa00d82:

    # mc "The Ancients’ blood — that’s what you were dealing with, right?"
    mc "Кровь Древних — вот с чем ты имела дело, верно?"

# game/Story03.rpy:4976
translate russian akt3chapter3_3b2c01d7:

    # L "Energy."
    L "Энергия."

# game/Story03.rpy:4978
translate russian akt3chapter3_f35116b8:

    # Fl "...Don’t look at me like that. I know as much as you."
    Fl "…Не смотри на меня так. Я знаю не больше твоего."

# game/Story03.rpy:4981
translate russian akt3chapter3_43ba3dcf:

    # mc "So... where does this energy come from?"
    mc "Так... откуда берётся эта энергия?"

# game/Story03.rpy:4983
translate russian akt3chapter3_f35a172a:

    # L "From absorbing living organisms."
    L "Из поглощения живых организмов."

# game/Story03.rpy:4986
translate russian akt3chapter3_4478d7ce:

    # Fl "...Wait. So the mutants — they’re just a side effect?"
    Fl "…Погоди. Значит, те мутанты — это просто побочный продукт?"

# game/Story03.rpy:4987
translate russian akt3chapter3_bc922369:

    # Fl "And even if we kill them — the process still goes on?"
    Fl "И даже если мы их убиваем - процесс всё равно будет продолжаться?"

# game/Story03.rpy:4989
translate russian akt3chapter3_b42c9b91:

    # L "...Not in practice. But in theory? The Abyss can reuse the same organism. Even post-mortem."
    L "...На практике — нет. Но в теории? Бездна может повторно использовать тот же организм. Даже после смерти."

# game/Story03.rpy:4991
translate russian akt3chapter3_fee8dcd8:

    # Fl "...So even the dead are still useful to it. Fantastic."
    Fl "...То есть даже мёртвые всё ещё полезны. Фантастика."

# game/Story03.rpy:4993
translate russian akt3chapter3_62903e12:

    # L "As long as blood flows — they’re still vessels. Even corpses."
    L "Пока течёт кровь - они всё ещё являются сосудами. Даже трупы."

# game/Story03.rpy:4997
translate russian akt3chapter3_45110eda:

    # mc "(So every kill... just speeds up the activation?)"
    mc "(Значит, каждое убийство... только ускоряет активацию?)"

# game/Story03.rpy:4998
translate russian akt3chapter3_b58751b7:

    # mc "Great. Just... brilliant."
    mc "Отлично. Просто... замечательно."

# game/Story03.rpy:5000
translate russian akt3chapter3_c03bc906:

    # mc "What if we freeze them?"
    mc "Что если их заморозить?"

# game/Story03.rpy:5001
translate russian akt3chapter3_fb4a1719:

    # L "That... could work."
    L "Это... может сработать."

# game/Story03.rpy:5003
translate russian akt3chapter3_73b1b36d:

    # mc "You pulled it off once, didn’t you?"
    mc "Ты уже однажды это сделала, да?"

# game/Story03.rpy:5009
translate russian akt3chapter3_a7a5b260:

    # Fl "The mission failed. But we did manage to freeze a couple hundred thousand. Sloppy job, but better than nothing."
    Fl "Миссия провалилась. Но нам удалось заморозить пару сотен тысяч. Работа была неаккуратная, но лучше, чем ничего."

# game/Story03.rpy:5012
translate russian akt3chapter3_c6b41095:

    # mc "Still just a drop in the ocean..."
    mc "Всё равно это капля в море..."

# game/Story03.rpy:5019
translate russian akt3chapter3_1f634cf2:

    # mc "(So now what? The mutants matter — but the tower takes priority.)"
    mc "(И что теперь? Мутанты важны, но Башня в приоритете.)"

# game/Story03.rpy:5022
translate russian akt3chapter3_242e90b0:

    # mc "Flora, round up every commander you can find."
    mc "Флора, собери всех командиров, которых сможешь найти."

# game/Story03.rpy:5024
translate russian akt3chapter3_0cc3e927:

    # Fl "On it. But if anyone makes a move again — I won’t be so forgiving."
    Fl "Будет сделано. Но если кто-нибудь снова попытается что-то предпринять, я не буду так снисходительна."

# game/Story03.rpy:5026
translate russian akt3chapter3_dd92beda:

    # mc "Lora, write down everything you know. The Artifact, the attackers — everything. We need answers."
    mc "Лора, запиши всё, что знаешь. Артефакт, нападавшие - всё. Нам нужны ответы."

# game/Story03.rpy:5028
translate russian akt3chapter3_29d01ac0:

    # L "Yes, my love!"
    L "Хорошо, любимый!"

# game/Story03.rpy:5030
translate russian akt3chapter3_5779514a:

    # mc "And I’ll try to rally whatever support we’ve got left."
    mc "А я постараюсь собрать всю оставшуюся поддержку."


# game/Story03.rpy:5050
translate russian akt3chapter5_0df736ef:

    # L "(Was it really the right decision...)"
    L "(Действительно ли это было правильным решением...)"

# game/Story03.rpy:5053
translate russian akt3chapter5_37a46956:

    # Fl "And you? Hiding in a corner, hoping someone else would do the hard part for you?"
    Fl "А ты? Ты спряталась. Надеялась, что все остальные будут убирать за тобой."

# game/Story03.rpy:5058
translate russian akt3chapter5_f6131be1:

    # Fl "Walked away again, huh?"
    Fl "Ты уже однажды его бросила. Хочешь довести дело до конца?"

# game/Story03.rpy:5066
translate russian akt3chapter5_ee6422f9:

    # L "(She’s right... I left him... again.)"
    L "(Она права... Я снова его бросила.)"

# game/Story03.rpy:5069
translate russian akt3chapter5_38436deb:

    # L "(Why does it always have to be so complicated... why can’t we just go back?)"
    L "(Почему всё всегда должно быть так сложно... Почему мы не можем просто вернуться?)"

# game/Story03.rpy:5072
translate russian akt3chapter5_deda8956:

    # L "(Out of everyone... why did it have to be my husband?)"
    L "(Из всех людей... почему это должен был быть именно мой муж?)"

# game/Story03.rpy:5080
translate russian akt3chapter5_5412ab20:

    # L "(Focus, Lora. Now’s not the time. You need to act!)"
    L "(Сосредоточься, Лора. Сейчас не время. Ты должна действовать!)"

# game/Story03.rpy:5082
translate russian akt3chapter5_260b5d37:

    # L "(But... where to even start?)"
    L "(Но... с чего начать?)"

# game/Story03.rpy:5091
translate russian akt3chapter5_cb9145b4:

    # mc "So. What’s the situation?"
    mc "Итак. Как обстановка?"

# game/Story03.rpy:5093
translate russian akt3chapter5_f0348365:

    # Fl "Same as always — panic, idiocy, and ill-timed heroism."
    Fl "Та же, что и всегда - паника, идиотизм и несвоевременный героизм."

# game/Story03.rpy:5096
translate russian akt3chapter5_041785de:

    # mc "Care to elaborate?"
    mc "А подробнее?"

# game/Story03.rpy:5099
translate russian akt3chapter5_d2d1084d:

    # Fl "Commander’s gone. The rest are running around in circles and calling it 'coordination'."
    Fl "Командиры пропали. Остальные бегают по кругу и называют это \"координацией\"."

# game/Story03.rpy:5100
translate russian akt3chapter5_f977b11f:

    # Fl "Everyone’s doing whatever they please. Some are hiding. Some are playing general."
    Fl "Каждый делает, что хочет. Некоторые прячутся. Некоторые играют в генералов."

# game/Story03.rpy:5103
translate russian akt3chapter5_b631f7ce:

    # mc "But you’ve already managed to take some control, haven’t you?"
    mc "Но тебе ведь уже удалось взять командования в свои руки, верно?"

# game/Story03.rpy:5113
translate russian akt3chapter5_9255398a:

    # Fl "Only the ones who served my father — the ones who still remember how things used to be."
    Fl "Лишь тех, кто служил отцу... Тех, кто ещё помнит, как всё было раньше."

# game/Story03.rpy:5114
translate russian akt3chapter5_3a6b4acc:

    # Fl "The rest? They either ran... or act like I was never born."
    Fl "Остальные? Они либо сбежали... либо ведут себя так, как будто я никогда не рождалась."

# game/Story03.rpy:5116
translate russian akt3chapter5_f6738cc7:

    # mc "That’s why you went to the Lower City."
    mc "Вот почему ты отправилась в Нижний город."

# game/Story03.rpy:5122
translate russian akt3chapter5_0bef0afa:

    # Fl "Thought if I showed my face — someone might remember who I am. Or at least get scared."
    Fl "Я подумала, что если покажусь, кто-нибудь может вспомнить, кто я такая. Или, по крайней мере, испугается."

# game/Story03.rpy:5124
translate russian akt3chapter5_095ddf5e:

    # mc "And Ember?"
    mc "А Эмбер?"

# game/Story03.rpy:5129
translate russian akt3chapter5_b1cec4b8:

    # Fl "She made an offer. I had to refuse."
    Fl "Она сделала предложение. Я была вынуждена отказаться."

# game/Story03.rpy:5131
translate russian akt3chapter5_5b75a526:

    # mc "But... aren’t you two supposed to be friends?"
    mc "Но... разве вы двое не подруги?"

# game/Story03.rpy:5135
translate russian akt3chapter5_6bad95eb:

    # Fl "Power isn’t about friendship. When it’s about control — nothing else matters."
    Fl "Власть не имеет ничего общего с дружбой. Когда речь идёт о контроле, ничего больше не имеет значения."

# game/Story03.rpy:5136
translate russian akt3chapter5_9791edd9:

    # Fl "Only strength counts. And what it costs."
    Fl "Важна только сила. И то, чего она стоит."

# game/Story03.rpy:5138
translate russian akt3chapter5_30c9afb2:

    # mc "(Strength, of course. The eternal classic.)"
    mc "(Сила, ну конечно. Вечная классика.)"

# game/Story03.rpy:5144
translate russian akt3chapter5_d6d040f9:

    # mc "(The one currency that never devalues.)"
    mc "(Единственная валюта, что не обесценивается.)"

# game/Story03.rpy:5146
translate russian akt3chapter5_ecfd4e8d:

    # mc "So. Strength, is it?"
    mc "Значит, сила, да?"

# game/Story03.rpy:5150
translate russian akt3chapter5_e02b5376:

    # mc "Then here’s the deal. Draw up a plan."
    mc "Тогда вот что я предлагаю. Подготовь план."

# game/Story03.rpy:5153
translate russian akt3chapter5_8851e609:

    # Fl "What plan?"
    Fl "Какой план?"

# game/Story03.rpy:5155
translate russian akt3chapter5_05ea62a6:

    # mc "The freeze."
    mc "О заморозке."

# game/Story03.rpy:5157
translate russian akt3chapter5_492fda07:

    # Fl "But... it didn’t work. Already."
    Fl "Но... это же не сработало."

# game/Story03.rpy:5160
translate russian akt3chapter5_a652a4fc:

    # mc "Didn’t work because it was miscalculated?"
    mc "Не сработало, потому что было плохо просчитано?"

# game/Story03.rpy:5162
translate russian akt3chapter5_c9956029:

    # mc "Or because no one listened to you?"
    mc "Или потому, что тебя никто не слушал?"

# game/Story03.rpy:5165
translate russian akt3chapter5_e7080968:

    # Fl "...No one listened. Like I was air — invisible and irrelevant."
    Fl "...Никто не слушал. Как будто я была воздухом - невидимым и неважным."

# game/Story03.rpy:5167
translate russian akt3chapter5_b0cf92e7:

    # mc "Then focus on what you’re best at. I’ll handle the rest."
    mc "Тогда сосредоточься на том, что у тебя получается лучше всего. Я займусь остальным."

# game/Story03.rpy:5172
translate russian akt3chapter5_cd779858:

    # Fl "...Thanks. It’s been a long time since someone said that to me — and actually meant it."
    Fl "...Спасибо. Уже давно никто не говорил мне этого... искренне."

# game/Story03.rpy:5176
translate russian akt3chapter5_370ff582:

    # mc "Not doing this for thanks. Just... we both know how these 'elites' operate."
    mc "Я делаю это не ради благодарности. Просто... мы оба знаем, как действуют эти \"элиты\"."

# game/Story03.rpy:5178
translate russian akt3chapter5_716019b8:

    # mc "Right."
    Fl "Верно."

# game/Story03.rpy:5181
translate russian akt3chapter5_a6030d2d:

    # mc "(If reason falls on deaf ears... the crowd will make itself heard.)"
    mc "(Если разум не слышат... толпа заставит себя услышать.)"

# game/Story03.rpy:5198
translate russian akt3chapter5_37becf81:

    # mc "(Feels like the air down here forgot how to breathe...)"
    mc "(Такое чувство, что воздух здесь забыл, как дышать...)"

# game/Story03.rpy:5200
translate russian akt3chapter5_bb3fd65b:

    # mc "Come out. I know you’re here."
    mc "Выходи. Я знаю, что ты здесь."

# game/Story03.rpy:5205
translate russian akt3chapter5_88ebbfd6:

    # a "Speak."
    a "Говори."

# game/Story03.rpy:5207
translate russian akt3chapter5_566d630c:

    # mc "I need your help."
    mc "Мне нужна ваша помощь."

# game/Story03.rpy:5210
translate russian akt3chapter5_59643b2a:

    # k "And what little scheme have you cooked up this time? I’m all ears."
    k "И какую маленькую интрижку ты затеял на этот раз? Я вся во внимании."

# game/Story03.rpy:5213
translate russian akt3chapter5_3d10100f:

    # a "Left the water warm. In the bath."
    a "Нагрела воду. В ванне."

# game/Story03.rpy:5216
translate russian akt3chapter5_b8431d8b:

    # k "Thanks, sister dearest."
    k "Спасибо, дорогая сестрёнка."

# game/Story03.rpy:5218
translate russian akt3chapter5_7a179be7:

    # mc "I’m taking command of the army."
    mc "Я беру на себя командование армией."

# game/Story03.rpy:5223
translate russian akt3chapter5_374eea2b:

    # k "Ohoho, there it is — that familiar madness in your eyes! Delightful. Like coming home in a blaze."
    k "Охохо, вот оно - то знакомое безумие в твоих глазах! Восхитительно. Прямо как вернуться домой в огне."

# game/Story03.rpy:5229
translate russian akt3chapter5_a6cdd6be:

    # a "But?"
    a "Но?"

# game/Story03.rpy:5231
translate russian akt3chapter5_d71645f2:

    # mc "But I don’t have enough authority for anyone to follow me."
    mc "Но у меня нет достаточного авторитета, чтобы люди пошли за мной."

# game/Story03.rpy:5233
translate russian akt3chapter5_e21905b1:

    # a "And you thought we’d help you with that?"
    a "И ты решил, что мы тебе в этом поможем?"

# game/Story03.rpy:5239
translate russian akt3chapter5_a1f14f5a:

    # mc "You both know how this ends."
    mc "Вы обе знаете, чем это закончится."

# game/Story03.rpy:5240
translate russian akt3chapter5_4ef8007b:

    # mc "You don’t have a choice."
    mc "У вас нет выбора."

# game/Story03.rpy:5242
translate russian akt3chapter5_2df17c35:

    # k "So you’re the predator now? Intriguing... But don’t forget — even mice have teeth. Sometimes venomous."
    k "Так теперь ты хищник? Интригует... Но не забывай - даже у мышей есть зубы. Иногда ядовитые."

# game/Story03.rpy:5246
translate russian akt3chapter5_721d45ff:

    # a "That sounded like a threat."
    a "Это прозвучало как угроза."

# game/Story03.rpy:5249
translate russian akt3chapter5_2034c056:

    # mc "Maybe."
    mc "Возможно."

# game/Story03.rpy:5251
translate russian akt3chapter5_7281ea99:

    # mc "You can kill me later — if you think I deserve it. For now — I need you."
    mc "Можешь убить меня позже - если сочтёшь, что я этого заслуживаю. А пока - ты мне нужна."

# game/Story03.rpy:5254
translate russian akt3chapter5_5cbbd218:

    # mc "So? What’s your answer?"
    mc "Ну? Каков твой ответ?"

# game/Story03.rpy:5260
translate russian akt3chapter5_75507e23:

    # a "Unexpected. But accepted."
    a "Неожиданно. Но принято."

# game/Story03.rpy:5264
translate russian akt3chapter5_bb0eeaf4:

    # mc "Thank you."
    mc "Спасибо."

# game/Story03.rpy:5266
translate russian akt3chapter5_b016e587:

    # k "We can influence the small fry. But what about the big fish?"
    k "Мы сможем повлиять на мелких рыбёшек. Но как насчёт рыбы покрупнее?"

# game/Story03.rpy:5268
translate russian akt3chapter5_385d68a7:

    # k "Your approach won’t work on them."
    k "Твой подход на них не сработает."

# game/Story03.rpy:5270
translate russian akt3chapter5_5c7940de:

    # mc "Then I’ll find other levers to pull."
    mc "Тогда я найду другие рычаги давления."

# game/Story03.rpy:5276
translate russian akt3chapter5_9247b832:

    # k "How curious..."
    k "Как любопытно..."

# game/Story03.rpy:5279
translate russian akt3chapter5_6e3f8dd5:

    # k "Let’s hope you know what you’re doing."
    k "Надеюсь, ты знаешь, что делаешь."

# game/Story03.rpy:5282
translate russian akt3chapter5_aa3909c8:

    # mc "Better than anyone else."
    mc "Лучше, чем кто-либо ещё."

# game/Story03.rpy:5284
translate russian akt3chapter5_f848e410:

    # g "Who are you? This area is off li—"
    g "Кто вы такие? Эта зона закрыта для-"

# game/Story03.rpy:5291
translate russian akt3chapter5_8a8c2a58:

    # gg "And who the hell are you?"
    gg "Кто ты, чёрт возьми?"

# game/Story03.rpy:5294
translate russian akt3chapter5_d6f80076:

    # ggg "What are you doing?!"
    ggg "Что ты делаешь?!"

# game/Story03.rpy:5296
translate russian akt3chapter5_4bb2f63d:

    # mc "What none of you had the guts to."
    mc "То, на что ни у кого из вас не хватило смелости."

# game/Story03.rpy:5299
translate russian akt3chapter5_906c02d0:

    # mc "Resistance is out of fashion. Let’s go."
    mc "Сопротивление вышло из моды. Пошли."

# game/Story03.rpy:5302
translate russian akt3chapter5_6232376b:

    # g "Drop your weapon! I’m asking nicely!"
    g "Брось оружие! Я прошу тебя вежливо!"

# game/Story03.rpy:5304
translate russian akt3chapter5_d9b94ade:

    # mc "We don’t have time for 'nice'."
    mc "У нас нет на это времени."

# game/Story03.rpy:5307
translate russian akt3chapter5_314154c5:

    # k "What would you even do without me... Let me guess — die boringly?"
    k "Что бы ты без меня делал... Дай угадаю - скучно умирал?"

# game/Story03.rpy:5309
translate russian akt3chapter5_8f782852:

    # mc "Kalestra, gather everyone in the hangar. It’s open season."
    mc "Калестра, собери всех в ангаре. Мы открываем охоту."

# game/Story03.rpy:5311
translate russian akt3chapter5_def8f168:

    # a "They won’t like this."
    a "Им это не понравится."

# game/Story03.rpy:5313
translate russian akt3chapter5_fd595372:

    # mc "It’s the only way."
    mc "Это единственный выход."

# game/Story03.rpy:5317
translate russian akt3chapter5_83b21bf6:

    # k "Yes, yes, your excellency..."
    k "Да, да, ваше превосходительство..."

# game/Story03.rpy:5320
translate russian akt3chapter5_c01b0e08:

    # ggg "(Whispering) This is treason..."
    ggg "{i}*шепчет*{/i} Это измена..."

# game/Story03.rpy:5321
translate russian akt3chapter5_16452ef9:

    # ggg "(Whispering) Then you go tell her that to her face..."
    ggg "{i}*шепчет*{/i} Тогда иди и скажи ей это в лицо..."

# game/Story03.rpy:5322
translate russian akt3chapter5_65a8a3ca:

    # k "Out of the way, dolls. The lady’s ready for her entrance."
    k "Прочь с дороги, куклы. Леди готова к выходу."

# game/Story03.rpy:5325
translate russian akt3chapter5_d15a7eb3:

    # k "You — you’re in charge here, right? Turn on the PA for me."
    k "Ты... ты здесь главный, верно? Включи мне громкую связь."

# game/Story03.rpy:5328
translate russian akt3chapter5_42c7a354:

    # gg "Y-yes, ma’am, right away..."
    gg "Д-да, мэм, уже включаю..."

# game/Story03.rpy:5330
translate russian akt3chapter5_8285d225:

    # k "Thank you, darling. Good listener — means you’ll live a bit longer."
    k "Спасибо, дорогуша. Хороший слушатель - значит, ты проживёшь немного дольше."

# game/Story03.rpy:5331
translate russian akt3chapter5_0274ea6e:

    # k "Ahem... Can you hear me, my lovely ghosts of the revolution?"
    k "Ахем... Вы меня слышите, мои милые призраки революции?"

# game/Story03.rpy:5333
translate russian akt3chapter5_07a6ae99:

    # k "If anyone’s still asleep — don’t worry. I’ll claw the morning into you."
    k "Если кто-то ещё спит - не волнуйтесь. Я выцарапаю вам утро когтями."

# game/Story03.rpy:5335
translate russian akt3chapter5_40fb63b4:

    # h "What the...?"
    h "Что за...?"

# game/Story03.rpy:5337
translate russian akt3chapter5_9625f945:

    # Mi "I know that voice."
    Mi "Я узнаю этот голос."

# game/Story03.rpy:5340
translate russian akt3chapter5_d15bbb53:

    # k "You’d better."
    k "Лучше бы вам проснуться."

# game/Story03.rpy:5341
translate russian akt3chapter5_819ee949:

    # k "Now, what was I supposed to say... Ah, right."
    k "Так, что я хотела сказать... А, точно."

# game/Story03.rpy:5343
translate russian akt3chapter5_fb7d727a:

    # h "She’s just the same as ever."
    h "Она такая же, как всегда."

# game/Story03.rpy:5352
translate russian akt3chapter5_103becde:

    # k "This is Kalestra Elverin Ord’Laria speaking."
    k "Говорит Калестра Элверин Орд'Лария."

# game/Story03.rpy:5355
translate russian akt3chapter5_f2cd8f3e:

    # k "By order of the Inquisition, the current command is hereby relieved. Immediately."
    k "По приказу Инквизиции, нынешнее командование снимается с должности. Незамедлительно."

# game/Story03.rpy:5359
translate russian akt3chapter5_4c325193:

    # em "Now things are getting interesting."
    em "Теперь всё становится интереснее."

# game/Story03.rpy:5361
translate russian akt3chapter5_de055f8c:

    # gg "What do we do, Miss Ember?"
    gg "Что будем делать, госпожа Эмбер?"

# game/Story03.rpy:5363
translate russian akt3chapter5_47c95552:

    # em "The chessboard is shifting. Let’s see who falls first."
    em "Шахматная доска меняется. Посмотрим, кто упадёт первым."

# game/Story03.rpy:5365
translate russian akt3chapter5_6475a8a2:

    # k "This isn’t improvisation. It’s protocol. All dissenters — sentenced to death. On the spot."
    k "Это не импровизация. Это протокол. Все несогласные - приговорены к смерти. На месте."

# game/Story03.rpy:5367
translate russian akt3chapter5_ef232c34:

    # Fl "...They... actually handed me command?"
    Fl "...Они... действительно передали мне командование?"

# game/Story03.rpy:5369
translate russian akt3chapter5_1a82d3cc:

    # L "What are you doing, darling..."
    L "Что ты делаешь, дорогой..."

# game/Story03.rpy:5373
translate russian akt3chapter5_1b7687a1:

    # L "So... you’re officially a commander now?"
    L "Значит... теперь ты официально командир?"

# game/Story03.rpy:5383
translate russian akt3chapter5_0ab7764d:

    # k "That’s all! Now — to the hangar. Chop-chop. We’ve got murders to plan and not enough time."
    k "На этом всё! А теперь — в ангар. Чоп-чоп. Нам нужно спланировать убийства, а времени мало."

# game/Story03.rpy:5386
translate russian akt3chapter5_46165e04:

    # gg "You’re way out of line!"
    gg "Вы переходите границы дозволенного!"

# game/Story03.rpy:5387
translate russian akt3chapter5_c6f3f8db:

    # ggg "Have you all lost your minds?!"
    ggg "Вы все с ума сошли?!"

# game/Story03.rpy:5391
translate russian akt3chapter5_e2141b7c:

    # k "No, no — you are far too sane. Try madness, darling — it paints the world in honest colors."
    k "Нет, нет - вы слишком здравомыслящие. Попробуйте безумие, дорогие - оно окрашивает мир в честные цвета."

# game/Story03.rpy:5392
translate russian akt3chapter5_c34efa9d:

    # k "Sis, remind me — what’s the punishment for mouthing off to an Inquisitor?"
    k "Сестрёнка, напомни мне - какое наказание грозит за дерзость по отношению к Инквизитору?"

# game/Story03.rpy:5394
translate russian akt3chapter5_434e6ed7:

    # a "Tribunal. In wartime — execution."
    a "Трибунал. В военное время — казнь."

# game/Story03.rpy:5396
translate russian akt3chapter5_bf689b28:

    # k "Oh my, how harsh. I’m trembling... with pleasure."
    k "О боже, как жестоко. Я дрожу... от удовольствия."

# game/Story03.rpy:5398
translate russian akt3chapter5_5f760176:

    # k "So, what were you saying, boys? Couldn’t hear you over your teeth chattering."
    k "Итак, что вы говорили, мальчики? Не слышу вас из-за стука зубов."

# game/Story03.rpy:5400
translate russian akt3chapter5_0769102a:

    # k "Take them away. Gently. With nails."
    k "Уведите их. Нежно... но с гвоздями."

# game/Story03.rpy:5402
translate russian akt3chapter5_131f4000:

    # k "Justice prevails, as always!"
    k "Правосудие восторжествовало, как и всегда!"

# game/Story03.rpy:5404
translate russian akt3chapter5_632438b3:

    # a "You haven’t changed. Still mad."
    a "Ты не изменилась. Всё так же безумна."

# game/Story03.rpy:5406
translate russian akt3chapter5_87ad08db:

    # k "Madness is following protocol when the stage is on fire. I’m not mad... I’m just free."
    k "Безумие - это следование протоколу, когда сцена в огне. Я не безумна... Я просто свободна."

# game/Story03.rpy:5407
translate russian akt3chapter5_f47b3dd5:

    # k "And freedom, sister, smells like fire and steel."
    k "А свобода, сестра, пахнет огнём и сталью."

# game/Story03.rpy:5411
translate russian akt3chapter5_460c62ed:

    # mc "Let’s move. We don’t have time for pleasantries."
    mc "Пойдёмте. У нас нет времени на любезности."

# game/Story03.rpy:5425
translate russian akt3chapter5_d8df9d56:

    # mc "(Quite a crowd out there.)"
    mc "(Там довольно много народу.)"

# game/Story03.rpy:5427
translate russian akt3chapter5_7468f756:

    # L "Calm down, girl. We've been through this already."
    L "Успокойся, девочка. Мы уже это обсуждали."

# game/Story03.rpy:5429
translate russian akt3chapter5_c4f330ff:

    # Fl "I... I can't. There are too many people..."
    Fl "Я... Я не смогу. Там слишком много людей..."

# game/Story03.rpy:5430
translate russian akt3chapter5_a9e7acde:

    # Fl "What if... What if they won’t agree? Then it’s all over!"
    Fl "Что, если... Что, если они не согласятся? Тогда всё будет кончено!"

# game/Story03.rpy:5433
translate russian akt3chapter5_fa8bac44:

    # gg "Because of your plan, many of our comrades are still alive."
    gg "Благодаря вашему плану многие из наших товарищей остались живы."

# game/Story03.rpy:5434
translate russian akt3chapter5_2c2983cf:

    # gggg "Exactly! We’ll back you—no matter what it costs!"
    gggg "Именно! Мы поддержим вас, чего бы это не стоило!"

# game/Story03.rpy:5436
translate russian akt3chapter5_90e8d73c:

    # Fl "(That’s enough. Stop trembling.)"
    Fl "(Хватит. Перестань дрожать.)"

# game/Story03.rpy:5437
translate russian akt3chapter5_655fd017:

    # Fl "(They don’t need perfection — they need someone who tells them where to go.)"
    Fl "(Они не ищут идеального лидера. Им нужен кто-то, кто скажет, что делать.)"

# game/Story03.rpy:5438
translate russian akt3chapter5_9026bf15:

    # Fl "Yeah, you’re... right. I need to pull myself together."
    Fl "Да, вы... правы. Мне нужно взять себя в руки."

# game/Story03.rpy:5440
translate russian akt3chapter5_1f56feb7:

    # mc "Ready?"
    mc "Готовы?"

# game/Story03.rpy:5442
translate russian akt3chapter5_0a4b47c2:

    # Fl "No... But I’ll do everything I can."
    Fl "Нет... Но я сделаю всё, что в моих силах."

# game/Story03.rpy:5444
translate russian akt3chapter5_0297642d:

    # mc "Lora?"
    mc "Лора?"

# game/Story03.rpy:5446
translate russian akt3chapter5_467d1c75:

    # L "Of course, darling!"
    L "Конечно, дорогой!"

# game/Story03.rpy:5448
translate russian akt3chapter5_b330cab0:

    # mc "And remember — this is our only shot. No margin for error."
    mc "И помните - это наш единственный шанс. Нет права на ошибку."

# game/Story03.rpy:5452
translate russian akt3chapter5_abc5cc1f:

    # L "You don’t need to worry about that."
    L "Можешь не беспокоиться об этом."

# game/Story03.rpy:5455
translate russian akt3chapter5_77980029:

    # g "(Whispering) Is that her?"
    g "{i}*шепчет*{/i} Это она?"

# game/Story03.rpy:5456
translate russian akt3chapter5_d5751315:

    # gg "(Whispering) The one with the cat ears? Yeah, that’s her."
    gg "{i}*шепчет*{/i} Ты о той с кошачьими ушами? Да, это она."

# game/Story03.rpy:5458
translate russian akt3chapter5_43b86625:

    # g "(Whispering) What’s the Inquisition thinking, letting beasts command us..."
    g "{i}*шепчет*{/i} О чём думает Инквизиция, позволяя зверям командовать нами..."

# game/Story03.rpy:5463
translate russian akt3chapter5_93394a34:

    # k "You hear that? Gossiping about us. Wait 'til they find out the truth — what a joke."
    k "Слышишь? Это они о нас сплетничают. Вот будет умора, когда они узнают правду."

# game/Story03.rpy:5465
translate russian akt3chapter5_3bdfe8c7:

    # L "How are you holding up?"
    L "Как ты держишься?"

# game/Story03.rpy:5470
translate russian akt3chapter5_968789a3:

    # Fl "I-I think I’m okay... apart from the mild shaking."
    Fl "Д-думаю, я в порядке... если не считать лёгкой дрожи."

# game/Story03.rpy:5472
translate russian akt3chapter5_85ed116b:

    # Fl "Are you sure they’ll even listen to us?"
    Fl "Ты уверен, что они будут нас слушать?"

# game/Story03.rpy:5474
translate russian akt3chapter5_0cc4c70c:

    # mc "Not sure. But it’s worth trying."
    mc "Не уверен. Но попытаться стоит."

# game/Story03.rpy:5475
translate russian akt3chapter5_4b6a5fde:

    # mc "Besides..."
    mc "К тому же..."

# game/Story03.rpy:5478
translate russian akt3chapter5_f36519fa:

    # mc "(There won’t be a better moment than this.)"
    mc "(Лучшего момента не будет.)"

# game/Story03.rpy:5480
translate russian akt3chapter5_03116a06:

    # ggg "(Whispering) Who do they think they are, ordering us around?"
    ggg "{i}*шепчет*{/i} Кем они себя возомнили, чтобы нам приказывать?"

# game/Story03.rpy:5483
translate russian akt3chapter5_eacfde6f:

    # g "Who needs that mutt anyway?"
    g "Кому вообще нужна эта дворняга?"

# game/Story03.rpy:5484
translate russian akt3chapter5_f35d5059:

    # gg "Wasting our time... We’re doomed either way..."
    gg "Тратит наше время... Мы всё равно обречены..."

# game/Story03.rpy:5486
translate russian akt3chapter5_0a317cc2:

    # mc "(Tired. Angry. Starving for someone to lead them.)"
    mc "(Уставшие. Злые. Жаждущие, чтобы кто-нибудь их возглавил.)"

# game/Story03.rpy:5490
translate russian akt3chapter5_8f13d9d7:

    # mc "SILENCE!"
    mc "ТИШИНА!"

# game/Story03.rpy:5493
translate russian akt3chapter5_4e519e3e:

    # mc "I know. You're scared. Angry. Broken."
    mc "Я знаю. Вы напуганы. Разгневаны. Разбиты."

# game/Story03.rpy:5494
translate russian akt3chapter5_51112ac0:

    # mc "Some of you already buried hope. Some just wait to be next."
    mc "Некоторые уже похоронили надежду. Другие просто ждут своей очереди."

# game/Story03.rpy:5495
translate russian akt3chapter5_9e7b0ee4:

    # mc "You don’t owe me trust. And hell, you sure as hell didn’t lose your people for my sake."
    mc "Вы не обязаны мне верить. И, чёрт возьми, вы не ради меня теряли своих людей."

# game/Story03.rpy:5497
translate russian akt3chapter5_aadcbdd3:

    # g "(Whispering) He’s right..."
    g "{i}*шепчет*{/i} Он прав..."

# game/Story03.rpy:5498
translate russian akt3chapter5_d3578cc3:

    # mc "But if you’re looking for something—anything—to hold on to..."
    mc "Но если вы ищете что-то - что угодно - за что можно держаться..."

# game/Story03.rpy:5499
translate russian akt3chapter5_a569775e:

    # mc "...hold on to this: we’re still alive."
    mc "Держитесь за это: мы всё ещё живы."

# game/Story03.rpy:5501
translate russian akt3chapter5_3e058f65:

    # mc "Some of you left families behind."
    mc "Некоторые из вас оставили свои семьи."

# game/Story03.rpy:5503
translate russian akt3chapter5_325d0612:

    # mc "Some had brothers-in-arms."
    mc "Кто-то - братьев по оружию."

# game/Story03.rpy:5505
translate russian akt3chapter5_04e207fc:

    # mc "Some are still holding a photograph in their pocket."
    mc "Кто-то всё ещё носит фотографию в кармане."

# game/Story03.rpy:5507
translate russian akt3chapter5_f5bbbe5b:

    # mc "We fight for life. Not for ideas. Not flags. People."
    mc "Мы сражаемся за жизнь. Не за идеи. Не за флаги. За людей."

# game/Story03.rpy:5513
translate russian akt3chapter5_aa53f735:

    # mc "This is Flora Sevin."
    mc "Это Флора Севин."

# game/Story03.rpy:5514
translate russian akt3chapter5_141aa9dc:

    # mc "Not a hero. Not a savior. Just someone who showed up with a plan..."
    mc "Не герой. Не спаситель. Простой человек, который появился с планом..."

# game/Story03.rpy:5515
translate russian akt3chapter5_97389040:

    # mc "...while the rest stood around arguing and dying."
    mc "Пока остальные стояли в стороне, споря и умирая."

# game/Story03.rpy:5517
translate russian akt3chapter5_a0906736:

    # g "(Whispering) She’s a beast..."
    g "{i}*шепчет*{/i} Она зверь..."

# game/Story03.rpy:5518
translate russian akt3chapter5_4560c805:

    # gg "(Whispering) But she has a plan…?"
    gg "{i}*шепчет*{/i} Но у неё есть план…?"

# game/Story03.rpy:5520
translate russian akt3chapter5_3cc6188d:

    # mc "Yes, she’s not human."
    mc "Да, она не человек."

# game/Story03.rpy:5532
translate russian akt3chapter5_3a78d76b:

    # mc "But if you’re looking for someone to call your own — look to the ones who stood tall when everything burned. She stood."
    mc "Но если вы ищете кого-то, кого можно назвать своим, - посмотрите на тех, кто выстоял, когда всё сгорело. Она выстояла."

# game/Story03.rpy:5534
translate russian akt3chapter5_64df8345:

    # mc "(Voice is shaking... Hope they didn’t catch that.)"
    mc "(Голос дрожит… Надеюсь, они не заметили.)"

# game/Story03.rpy:5536
translate russian akt3chapter5_282f980e:

    # mc "(Every word feels like a rock in my throat.)"
    mc "(Каждое слово как камень в горле.)"

# game/Story03.rpy:5541
translate russian akt3chapter5_52c0f96b:

    # mc "(Screw it. Enough self-pity.)"
    mc "(К чёрту. Хватит себя жалеть.)"

# game/Story03.rpy:5543
translate russian akt3chapter5_f26055fa:

    # mc "I know some of you call us traitors."
    mc "Я знаю, что среди вас есть те, кто зовёт нас предателями."

# game/Story03.rpy:5545
translate russian akt3chapter5_75f652cc:

    # mc "So be it."
    mc "Пусть так."

# game/Story03.rpy:5547
translate russian akt3chapter5_c95094d0:

    # mc "But when that thing from beneath the earth comes to devour your home — we’ll be the first to stand."
    mc "Но когда те твари из-под земли придут, чтобы поглотить ваш дом, мы будем первыми, кто встанет на защиту."

# game/Story03.rpy:5548
translate russian akt3chapter5_af89540a:

    # mc "Not because you're right. But because there’s no one else left."
    mc "Не потому, что вы правы. А потому, что больше никого не осталось."

# game/Story03.rpy:5551
translate russian akt3chapter5_3d8f2fc3:

    # mc "(They look at me like I’ve lost my mind. Fine. As long as they listen.)"
    mc "(Они смотрят на меня так, будто я сошёл с ума. Пусть так. Лишь бы слушали.)"

# game/Story03.rpy:5552
translate russian akt3chapter5_c1415be6:

    # mc "We fight as long as we breathe. As long as we have purpose. As long as someone’s still standing."
    mc "Мы будем сражаться, пока дышим. Пока у нас есть цель. Пока кто-то ещё стоит на ногах."

# game/Story03.rpy:5559
translate russian akt3chapter5_9a370dbe:

    # mc "From now on — we’re one. No more 'them.' Only 'us.'"
    mc "С этого момента мы - одно целое. Больше нет \"их\". Есть только \"мы\"."

# game/Story03.rpy:5560
translate russian akt3chapter5_ab7f4757:

    # mc "Think you can do better? Be my guest. Prove it."
    mc "Думаете, сможете сделать лучше? Пожалуйста. Докажите это."

# game/Story03.rpy:5561
translate russian akt3chapter5_b1f1f547:

    # mc "If you stay — follow orders. There’s no room for mistakes anymore."
    mc "Если останетесь - выполняйте приказы. Больше нет места для ошибок."

# game/Story03.rpy:5563
translate russian akt3chapter5_13f09734:

    # mc "One chance. There won’t be another."
    mc "Один шанс. Другого не будет."

# game/Story03.rpy:5564
translate russian akt3chapter5_4f740eea:

    # mc "Together — we live."
    mc "Вместе — мы выживем."

# game/Story03.rpy:5565
translate russian akt3chapter5_9ef52384:

    # mc "Alone — we rot."
    mc "По отдельности - мы сгниём."

# game/Story03.rpy:5567
translate russian akt3chapter5_a56690f8:

    # L "Don’t worry, girl. If it all goes to hell — we’ll have your back."
    L "Не волнуйся, девочка. Если всё пойдёт наперекосяк — мы прикроем."

# game/Story03.rpy:5569
translate russian akt3chapter5_c01b0c7a:

    # Fl "(They... believe in me. I don’t get to fall apart now.)"
    Fl "(Они… верят в меня. Теперь я не могу сломаться.)"

# game/Story03.rpy:5571
translate russian akt3chapter5_7108fc77:

    # Fl "(No matter what it costs.)"
    Fl "(Независимо от того, чего это будет стоить.)"

# game/Story03.rpy:5573
translate russian akt3chapter5_ead321f2:

    # Fl "Thank you... I... I’ll do my best."
    Fl "Спасибо... Я... Я сделаю всё, что в моих силах."

# game/Story03.rpy:5582
translate russian akt3chapter5_226e69d0:

    # g "What’s your plan?"
    g "Какой у вас план?"

# game/Story03.rpy:5585
translate russian akt3chapter5_b359d44f:

    # Fl "To freeze the Soulless. With cryogen."
    Fl "Заморозить Бездушных. С помощью криогена."

# game/Story03.rpy:5587
translate russian akt3chapter5_30775db2:

    # gg "You think cryogen can stop the Soulless?"
    gg "Вы верите, что криоген остановит Бездушных?"

# game/Story03.rpy:5588
translate russian akt3chapter5_e2153c13:

    # Fl "I don’t believe. I know."
    Fl "Я не верю. Я знаю."

# game/Story03.rpy:5589
translate russian akt3chapter5_354baf61:

    # ggg "That’s suicide!"
    ggg "Это самоубийство!"

# game/Story03.rpy:5590
translate russian akt3chapter5_069a17cb:

    # Fl "Then we have the same expectations. The only question is — do you want to die for nothing, or for something that matters?"
    Fl "Тогда у нас одинаковые ожидания. Вопрос только в том - хотите ли вы умереть зря или за что-то важное?"

# game/Story03.rpy:5593
translate russian akt3chapter5_a46bb0f1:

    # Fl "Second phase is taking back the central tower."
    Fl "Вторая фаза - отбить центральную башню."

# game/Story03.rpy:5595
translate russian akt3chapter5_59ab45a3:

    # gg "And you think we’re strong enough for that?"
    gg "И вы думаете, что мы достаточно сильны для этого?"

# game/Story03.rpy:5599
translate russian akt3chapter5_3836ec07:

    # Fl "(Even now, they’re looking for an excuse to doubt. Habit. Fear.)"
    Fl "(Даже сейчас они ищут повод для сомнений. Привычка. Страх.)"

# game/Story03.rpy:5600
translate russian akt3chapter5_ae7ae1fb:

    # Fl "(Breathe... Just breathe. You prepared for this.)"
    Fl "(Дыши… Просто дыши. Ты готовилась к этому.)"

# game/Story03.rpy:5602
translate russian akt3chapter5_92f716a9:

    # Fl "(Don’t let them control the moment. Don’t let their faith in you fade.)"
    Fl "(Не дай им управлять тобой. Не дай вере других погаснуть.)"

# game/Story03.rpy:5607
translate russian akt3chapter5_0f459a39:

    # Fl "(Yes! I don’t want to hide anymore. Not now. Not in front of them.)"
    Fl "(Да! Я больше не хочу прятаться. Не сейчас. Не перед ними.)"

# game/Story03.rpy:5609
translate russian akt3chapter5_6dbfd782:

    # Fl "(If I don’t say this now — everything falls apart. I have to.)"
    Fl "(Если я не скажу это сейчас — всё развалится. Я должна.)"

# game/Story03.rpy:5612
translate russian akt3chapter5_72923443:

    # Fl "(whispering) Enough with the doubt. We don’t have time for fear. Only for action.)"
    Fl "{i}*шепчет*{/i} Хватит сомнений. У нас нет времени на страх. Только на действия."

# game/Story03.rpy:5615
translate russian akt3chapter5_137f0eef:

    # Fl "If you want to survive — shut up and listen!"
    Fl "Если вы хотите выжить — заткнитесь и слушайте!"

# game/Story03.rpy:5617
translate russian akt3chapter5_a6b1657b:

    # g "How are you going to pull that off?"
    g "Как вы собираетесь это сделать?"

# game/Story03.rpy:5630
translate russian akt3chapter5_b2cc0e49:

    # Fl "Our entire city is fitted with an air processing system."
    Fl "Весь наш город оснащён системой обработки воздуха."

# game/Story03.rpy:5631
translate russian akt3chapter5_8e7a647c:

    # Fl "The first team will head to the pumping station to load the cryogen."
    Fl "Первая группа направится к насосной станции, чтобы загрузить криоген."

# game/Story03.rpy:5632
translate russian akt3chapter5_26b2b992:

    # Fl "The second will provide cover."
    Fl "Вторая будет обеспечивать прикрытие."

# game/Story03.rpy:5635
translate russian akt3chapter5_d19cb6e3:

    # g "And if the plan fails? Who takes the fall?"
    g "А если план провалится? Кто за это ответит?"

# game/Story03.rpy:5637
translate russian akt3chapter5_a94bdc54:

    # gg "Why should we trust a beast none of us knew yesterday?"
    gg "Почему мы должны доверять зверю, о которой вчера никто из нас не знал?"

# game/Story03.rpy:5638
translate russian akt3chapter5_fd8609c8:

    # gg "And what about the civilians? Planning to leave them behind?"
    gg "И что насчёт жителей? Вы собрались их бросить?"

# game/Story03.rpy:5640
translate russian akt3chapter5_eb459e1e:

    # em "My people have taken care of that."
    em "Мои люди позаботились об этом."

# game/Story03.rpy:5642
translate russian akt3chapter5_c65bb771:

    # gg "Hmph... Then where are all these survivors you claim to have saved?"
    gg "Хмпф... Тогда где все эти выжившие, которых вы, как утверждаете, спасли?"

# game/Story03.rpy:5643
translate russian akt3chapter5_7e4ebe83:

    # em "In the Lower City."
    em "В Нижнем городе."

# game/Story03.rpy:5645
translate russian akt3chapter5_b779f06c:

    # em "We’re not the hypocrites you think we are."
    em "Мы не такие лицемеры, как вы думаете."

# game/Story03.rpy:5647
translate russian akt3chapter5_4536ecd3:

    # em "And we’re ready to fight for our people. Unlike you."
    em "И мы готовы сражаться за свой народ. В отличии от вас."

# game/Story03.rpy:5655
translate russian akt3chapter5_c13b11d4:

    # Fl "(Thank you.)"
    Fl "(Спасибо.)"

# game/Story03.rpy:5658
translate russian akt3chapter5_e0563b47:

    # g "But what about the Tower?"
    g "Но что насчёт Башни?"

# game/Story03.rpy:5659
translate russian akt3chapter5_42d6f64e:

    # g "We don’t have the strength to take it back from the enemy. And we don’t even know who’s attacking."
    g "У нас нет сил отбить её у врага. И мы даже не знаем, кто на нас нападает."

# game/Story03.rpy:5660
translate russian akt3chapter5_39e0faad:

    # g "So why fight for it?"
    g "Так зачем же за не сражаться?"

# game/Story03.rpy:5663
translate russian akt3chapter5_022d8a84:

    # L "Because if we don’t — everyone dies."
    L "Потому что, если мы этого не сделаем, погибнут все."

# game/Story03.rpy:5668
translate russian akt3chapter5_8ba599ae:

    # L "The Tower is a tomb."
    L "Башня - это гробница."

# game/Story03.rpy:5669
translate russian akt3chapter5_a0cb3f70:

    # L "If we let the enemy take it — they’ll activate the core. It’s over. Not just the city — the whole planet."
    L "Если оставить её врагу, они активируют ядро. И это будет конец. Не только для города - для всей планеты."

# game/Story03.rpy:5672
translate russian akt3chapter5_067e8185:

    # ggg "A tomb?! What are you even saying?"
    ggg "Гробница?! Что ты несёшь?"

# game/Story03.rpy:5673
translate russian akt3chapter5_7c61ce42:

    # gggg "That can’t be... that’s just some old legend!"
    gggg "Этого не может быть... Это всё старые легенды!"

# game/Story03.rpy:5674
translate russian akt3chapter5_c3bd15fc:

    # g "You’re insane! The Tower is the command center!"
    g "Вы спятили? Башня — это командный центр!"

# game/Story03.rpy:5676
translate russian akt3chapter5_bd314158:

    # k "Sis... What do we do? The crowd’s buzzing like a hornet’s nest. Show one crack — they’ll tear us apart."
    k "Сестрёнка... Что нам делать? Толпа гудит, как осиное гнездо. Покажи одну трещину - они разорвут нас на части."

# game/Story03.rpy:5688
translate russian akt3chapter5_63c9f7ff:

    # a "Silence!"
    a "Тишина!"

# game/Story03.rpy:5690
translate russian akt3chapter5_66cbdc61:

    # k "Gods... how does she do that every time..."
    k "Боже... Как ей это каждый раз удаётся..."

# game/Story03.rpy:5694
translate russian akt3chapter5_ffd98329:

    # a "What this girl says — is true."
    a "То, что говорит эта девушка, - правда."

# game/Story03.rpy:5695
translate russian akt3chapter5_60e660a2:

    # a "And if we don’t take it back — our entire Federation falls."
    a "И если мы не отобьём её, - вся наша Федерация рухнет."

# game/Story03.rpy:5699
translate russian akt3chapter5_f7c9fc1d:

    # k "Remind me, sis, what was that you said earlier about caring for the common folk?"
    k "Напомни, сестрёнка, что ты сказала ранее о заботе о простых людях?"

# game/Story03.rpy:5702
translate russian akt3chapter5_f36161d2:

    # a "Shut up."
    a "Заткнись."

# game/Story03.rpy:5707
translate russian akt3chapter5_d1ff28c0:

    # ggg "But we still don’t have the manpower to take it..."
    ggg "Но у нас всё ещё недостаточно сил, чтобы это сделать..."

# game/Story03.rpy:5708
translate russian akt3chapter5_64e7d7de:

    # g "Where... Where are you going to get people for this?"
    g "Где... Где вы найдёте людей для этого?"

# game/Story03.rpy:5710
translate russian akt3chapter5_520da0f1:

    # mc "We’ll send a small strike team."
    mc "Мы отправим небольшую ударную группу."

# game/Story03.rpy:5712
translate russian akt3chapter5_d864cc0a:

    # Fl "While the Syndicate and the Peacekeepers are focused on destroying the Soulless..."
    Fl "Пока Синдикат и Миротворцы сосредоточены на уничтожении Бездушных..."

# game/Story03.rpy:5713
translate russian akt3chapter5_3e22db4e:

    # Fl "The team — led by [mc] — will head straight to the tower's core."
    if mc == "Kael" or persistent.mc_name == "Kael":
        Fl "Группа под руководством Каэля направится прямо к ядру Башни."
    else:
        Fl "Группа под руководством [mc!t] направится прямо к ядру Башни."

# game/Story03.rpy:5715
translate russian akt3chapter5_8f8f1e13:

    # g "This whole plan is a death sentence!"
    g "Весь этот план - смертный приговор!"

# game/Story03.rpy:5716
translate russian akt3chapter5_2cff9a14:

    # gg "Who the hell would agree to join a suicide squad?"
    gg "Кто, чёрт возьми, согласится присоединиться к отряду самоубийц?"

# game/Story03.rpy:5722
translate russian akt3chapter5_20a26d58:

    # mc "You have one choice: stay here… or fight. For yourselves. For those who can’t anymore."
    mc "Выбор у вас один: остаться здесь... или сражаться. За себя. За тех, кто больше не может."

# game/Story03.rpy:5725
translate russian akt3chapter5_f89d0470:

    # mc "I’m not going to sit around and wait for them to come for me."
    mc "Я не собираюсь сидеть сложа руки и ждать, пока они придут за мной."

# game/Story03.rpy:5727
translate russian akt3chapter5_774a04e1:

    # mc "I’m going. Alone — if I have to."
    mc "Я пойду. В одиночку - если потребуется."

# game/Story03.rpy:5729
translate russian akt3chapter5_057b2d5b:

    # mc "(That’s it. It’s now or never.)"
    mc "(Вот и всё. Сейчас или никогда.)"

# game/Story03.rpy:5732
translate russian akt3chapter5_f98f0dcf:

    # mc "(So… No one?)"
    mc "(Значит... никто?)"

# game/Story03.rpy:5736
translate russian akt3chapter5_7246e336:

    # mc "(Whispering) Then I have no choice but to go alone."
    mc "{i}*шепчет*{/i} Тогда у меня нет выбора, кроме как пойти в одиночку."

# game/Story03.rpy:5743
translate russian akt3chapter5_c99e07f7:

    # L "Without me, you won’t stand a chance."
    L "Без меня у тебя нет шансов."

# game/Story03.rpy:5745
translate russian akt3chapter5_11cf044b:

    # mc "Time to make up for lost time, right?"
    mc "Пора наверстать упущенное, да?"

# game/Story03.rpy:5749
translate russian akt3chapter5_f613659c:

    # mc "Anyone else?"
    mc "Кто-то ещё?"

# game/Story03.rpy:5752
translate russian akt3chapter5_1da63c9b:

    # Mi "I’m in."
    Mi "Я в деле."

# game/Story03.rpy:5755
translate russian akt3chapter5_556c194f:

    # el "What are you doing, you idiot?!"
    el "Что ты делаешь, дура?!"

# game/Story03.rpy:5760
translate russian akt3chapter5_9b5e828e:

    # h "Like I’d let you go alone."
    h "Как будто я позволю тебе пойти в одиночку."

# game/Story03.rpy:5763
translate russian akt3chapter5_3afe9822:

    # k "Let you two have all the fun? Not a chance."
    k "Оставить всё веселья вам? Ни за что."

# game/Story03.rpy:5772
translate russian akt3chapter5_d8638cbb:

    # ggg "We’re with you!"
    ggg "Мы с вами!"

# game/Story03.rpy:5776
translate russian akt3chapter5_b0ba6e55:

    # gg "What the hell are you doing?!"
    gg "Какого хрена ты делаешь?!"

# game/Story03.rpy:5778
translate russian akt3chapter5_0b7d5e38:

    # g "...Damn it. After a speech like that... I just can’t stay behind."
    g "...Чёрт. После такой речи… Я просто не могу остаться."

# game/Story03.rpy:5779
translate russian akt3chapter5_a2866d2b:

    # gg "But it’s suici—"
    gg "Но это же самоуби-"

# game/Story03.rpy:5780
translate russian akt3chapter5_2b247cce:

    # g "Maybe. But I’d rather die with a gun in my hands than under their boots in some filthy hole."
    g "Может быть. Но я лучше умру с оружием в руках, чем под их сапогами в какой-нибудь грязной дыре."

# game/Story03.rpy:5785
translate russian akt3chapter5_4f655c15:

    # gg "Yeah? Screw it then, I’m in too!"
    gg "Да? Тогда к чёрту, я тоже с вами!"

# game/Story03.rpy:5787
translate russian akt3chapter5_bc3915d8:

    # ggg "Same here!"
    ggg "Я тоже!"

# game/Story03.rpy:5788
translate russian akt3chapter5_a600ef17:

    # mc "That’s — enough."
    mc "Этого достаточно."

# game/Story03.rpy:5789
translate russian akt3chapter5_4366c8c6:

    # mc "Now — they’re with us."
    mc "Теперь они с нами."

# game/Story03.rpy:5791
translate russian akt3chapter5_e5df6447:

    # mc "Now we fight not just for ourselves — but so they get to see tomorrow."
    mc "Теперь мы сражаемся не только за себя, но и за то, чтобы они увидели завтрашний день."

# game/Story03.rpy:5793
translate russian akt3chapter5_1f60dd06:

    # em "This young man... never ceases to surprise me."
    em "Этот юноша... никогда не перестаёт меня удивлять."

# game/Story03.rpy:5795
translate russian akt3chapter5_0bd28ccb:

    # em "This was your plan all along, wasn’t it, Astoria?"
    em "Это был твой план с самого начала, не так ли, Астория?"

# game/Story03.rpy:5797
translate russian akt3chapter5_ead8f03c:

    # scar "Not bad."
    scar "Неплохо."

# game/Story03.rpy:5799
translate russian akt3chapter5_52007fd3:

    # scar "You’ve gained quite the ally, Flora."
    scar "Ты приобрела замечательного союзника, Флора."

# game/Story03.rpy:5816
translate russian akt3chapter5_397c4916:

    # aa "The view from up here suits you, lady Astoria."
    aa "Отсюда открывается прекрасный вид, госпожа Астория."

# game/Story03.rpy:5817
translate russian akt3chapter5_b89cf2d2:

    # aa "Almost imperial — grand, with just a hint of mass grave."
    aa "Почти по-императорски величественный, с лёгким намёком на братскую могилу."

# game/Story03.rpy:5820
translate russian akt3chapter5_03d73107:

    # aa "Still playing statue?"
    aa "Всё ещё играешь в статую?"

# game/Story03.rpy:5822
translate russian akt3chapter5_03b6b523:

    # sel "Leave her. One more word and you’ll find out what death in silk gloves looks like."
    sel "Оставь её. Ещё одно слово, и ты узнаешь, как выглядит смерть в шёлковых перчатках."

# game/Story03.rpy:5827
translate russian akt3chapter5_5cf519eb:

    # aa "Yes, my queen."
    aa "Да, владычица."

# game/Story03.rpy:5830
translate russian akt3chapter5_08384062:

    # am "How long do you plan to drag out this opera you call 'liberation'?"
    am "Как долго ты планируешь тянуть эту оперу, которую называешь \"освобождением\"?"

# game/Story03.rpy:5833
translate russian akt3chapter5_2681630e:

    # sel "We’re on the brink, Astoria. The blood of the Ancients — almost gathered."
    sel "Мы у самой черты, Астория. Кровь Древних — почти собрана."

# game/Story03.rpy:5834
translate russian akt3chapter5_1bc59a61:

    # sel "Only one last step remains."
    sel "Остался только последний шаг."

# game/Story03.rpy:5836
translate russian akt3chapter5_d7fa06d6:

    # am "Do you realize you’ve sparked an interspecies massacre for that 'blood'? Billions — for a drop?"
    am "Ты осознаёшь, что вызвала межвидовую резню ради этой \"крови\"? Миллиарды - за каплю?"

# game/Story03.rpy:5838
translate russian akt3chapter5_077d1c05:

    # sel "The blood is just a symbol. We’re fighting for the right to exist outside the shadows."
    sel "Кровь - это лишь символ. Мы боремся за право существовать вне тени."

# game/Story03.rpy:5839
translate russian akt3chapter5_5219d582:

    # sel "To restore the Elven order, where intellect isn’t a death sentence — but a claim to the throne."
    sel "За восстановление эльфийского порядка, где интеллект - не смертный приговор, а право на трон."

# game/Story03.rpy:5841
translate russian akt3chapter5_a3a3f4d8:

    # am "Motives don’t hide behind flags. You see them in burning cities and children’s bones beneath your fleets."
    am "Мотивы не скрываются за флагами. Ты видишь их в горящих городах и костях детей под вашими флотами."

# game/Story03.rpy:5846
translate russian akt3chapter5_41c06004:

    # sel "You wouldn’t understand. Even your blood is sterile."
    sel "Тебе не понять. Даже твоя кровь стерильна."

# game/Story03.rpy:5848
translate russian akt3chapter5_8849980a:

    # am "Emotion is a virus. And you — are infected."
    am "Эмоции - это вирус. И ты - заражена."

# game/Story03.rpy:5850
translate russian akt3chapter5_f74e3679:

    # sel "And now you’re the one giving diagnoses?"
    sel "Так ты теперь ставишь диагнозы?"

# game/Story03.rpy:5854
translate russian akt3chapter5_04aa628b:

    # am "You overthrew Gorem. Usurped his throne. He was at least a fanatic — you’re just a calculator wrapped in powdered ethics."
    am "Ты свергла Горэма. Узурпировала его трон. Он был хотя бы фанатиком - а ты всего лишь калькулятор, припудренный этикой."

# game/Story03.rpy:5856
translate russian akt3chapter5_7739891c:

    # sel "Following your example."
    sel "Следую твоему примеру."

# game/Story03.rpy:5862
translate russian akt3chapter5_cba6400d:

    # am "If I destroy you — will this circus of corpses and delusions end?"
    am "Если я уничтожу тебя, закончится ли этот цирк трупов и иллюзий?"

# game/Story03.rpy:5864
translate russian akt3chapter5_7c2b6696:

    # sel "Perhaps. Or maybe... you’ll just lose the one person who still understands what you’ve become."
    sel "Возможно. А может быть... ты просто потеряешь единственного человека, который ещё понимает, кем ты стала."

# game/Story03.rpy:5867
translate russian akt3chapter5_c22a4cd3:

    # am "I don’t tolerate uncertainty."
    am "Я не терплю неопределённости."

# game/Story03.rpy:5876
translate russian akt3chapter5_c28c00dd:

    # sel "That hurts..."
    sel "Это больно..."

# game/Story03.rpy:5878
translate russian akt3chapter5_93736dc6:

    # am "...Predictable."
    am "...Предсказуемо."

# game/Story03.rpy:5881
translate russian akt3chapter5_eed00208:

    # sel "You could’ve warned me. Blasting my head apart is, at the very least, bad manners."
    sel "Ты могла бы предупредить меня. Взрывать мне голову - это, как минимум, дурной тон."

# game/Story03.rpy:5883
translate russian akt3chapter5_72012397:

    # am "I didn’t lay a finger on you."
    am "Я тебя и пальцем не тронула."

# game/Story03.rpy:5885
translate russian akt3chapter5_ef0a63fd:

    # sel "You shattered my skull."
    sel "Ты разнесла мне череп."

# game/Story03.rpy:5889
translate russian akt3chapter5_58c1b8df:

    # am "Yours? Or that thing you call 'you'?"
    am "Тебе? Или тому, что ты называешь \"собой\"?"

# game/Story03.rpy:5894
translate russian akt3chapter5_3fa6487c:

    # sel "You knew. And still did it. That’s not like you, Astoria..."
    sel "Ты знала. И всё равно сделала это. Это на тебя не похоже, Астория..."

# game/Story03.rpy:5907
translate russian akt3chapter5_c1d02e44:

    # Fl "You know… I still can’t believe you didn’t run the moment you got the chance."
    Fl "Знаешь... Я до сих пор не могу поверить, что ты не сбежал, как только у тебя появилась возможность."

# game/Story03.rpy:5910
translate russian akt3chapter5_58006ad4:

    # mc "And you’re still shocked someone could actually stand your personality?"
    mc "И ты до сих пор удивляешься, что кто-то может терпеть твой характер?"

# game/Story03.rpy:5913
translate russian akt3chapter5_6c4609f2:

    # Fl "It’s not every day a genius growls at you."
    Fl "Не каждый день на тебя рычит гений."

# game/Story03.rpy:5914
translate russian akt3chapter5_6ad84013:

    # Fl "Though in my case, it’s more of a… venomous hiss."
    Fl "Хотя в моём случае это скорее... ядовитое шипение."

# game/Story03.rpy:5917
translate russian akt3chapter5_21398537:

    # mc "You didn’t just hiss. You were a goddamn drill bit — screwing straight into my cortex."
    mc "Ты не просто шипела. Ты была чёртовым сверлом, вкручивающимся прямо в мой мозг."

# game/Story03.rpy:5918
translate russian akt3chapter5_5ada6331:

    # mc "But you dragged us through three layers of hell. For that — thanks."
    mc "Но ты протащила нас через три круга ада. За это - спасибо."

# game/Story03.rpy:5922
translate russian akt3chapter5_ca5efc42:

    # Fl "...Thanks."
    Fl "...Спасибо."

# game/Story03.rpy:5925
translate russian akt3chapter5_32206aac:

    # Fl "For believing in me. Even when I didn’t."
    Fl "За то, что верил в меня. Даже когда я сомневалась."

# game/Story03.rpy:5927
translate russian akt3chapter5_62727855:

    # mc "You? Doubting?"
    mc "Ты? Сомневалась?"

# game/Story03.rpy:5928
translate russian akt3chapter5_0b8442e8:

    # mc "Who are you and what did you do with Flora?"
    mc "Кто ты и что ты сделала с Флорой?"

# game/Story03.rpy:5931
translate russian akt3chapter5_4d484526:

    # Fl "I buried her. Deep. Somewhere even I can’t dig her out."
    Fl "Я похоронила её. Глубоко. Там, где даже я не смогу её выкопать."

# game/Story03.rpy:5933
translate russian akt3chapter5_1fb84e72:

    # mc "What now?"
    mc "Что теперь?"

# game/Story03.rpy:5935
translate russian akt3chapter5_75c6246b:

    # Fl "Comm link. I’ll try to reach my father."
    Fl "Канал связи. Попытаюсь добраться до отца."

# game/Story03.rpy:5937
translate russian akt3chapter5_1eda0920:

    # Fl "If he’s... still alive."
    Fl "Если он... Если он ещё жив."

# game/Story03.rpy:5939
translate russian akt3chapter5_8af492ff:

    # mc "(Sure. Not worried at all. You're practically vibrating.)"
    mc "(Конечно. Совсем не волнуешься. Ты практически дрожишь.)"

# game/Story03.rpy:5940
translate russian akt3chapter5_ba5215ec:

    # Fl "R-right, Flora! Of course he's okay, he’s—"
    Fl "Д-да, Флора! С ним точно всё в порядке, это же он..."

# game/Story03.rpy:5941
translate russian akt3chapter5_0191c37b:

    # mc "(She’s spiraling. {w}Maybe I should—)"
    mc "(Она в панике. {w}Может, мне стоит...)"

# game/Story03.rpy:5942
translate russian akt3chapter5_9a18e138:

    # Fl "You’re just overthinki—"
    Fl "Ты просто накру-"

# game/Story03.rpy:5946
translate russian akt3chapter5_8ee75081:

    # mc "You’re shaking."
    mc "Ты дрожишь."

# game/Story03.rpy:5948
translate russian akt3chapter5_d46b71a3:

    # mc "He’ll be fine. Even barely knowing him... I can feel that."
    mc "С ним всё будет хорошо. Даже почти не зная его... я чувствую это."

# game/Story03.rpy:5949
translate russian akt3chapter5_ff1af37e:

    # mc "He raised you — so that alone makes him some kind of legend."
    mc "Он воспитал тебя - и уже одно это делает его легендой."

# game/Story03.rpy:5951
translate russian akt3chapter5_19f528c1:

    # mc "But right now, you need to take care of yourself first. {w}Alright?"
    mc "Но сейчас тебе нужно в первую очередь позаботиться о себе. {w}Хорошо?"

# game/Story03.rpy:5953
translate russian akt3chapter5_522c95f4:

    # mc "(Great pep talk, [mc]. Motivational genius. Who’s saving who here again?)"
    mc "(Отличная речь, [mc!t]. Гений мотивации. Кто здесь кого спасает?)"

# game/Story03.rpy:5954
translate russian akt3chapter5_3783bba9:

    # Fl "You and him... hopeless optimists."
    Fl "Ты и он... безнадёжные оптимисты."

# game/Story03.rpy:5958
translate russian akt3chapter5_14330d71:

    # Fl "You know, for someone clinging so close, you’re awfully moral."
    Fl "Знаешь, для человека, который так привязан к нему, ты ужасно нравственный."

# game/Story03.rpy:5961
translate russian akt3chapter5_15371585:

    # Fl "In the other side..."
    Fl "С другой стороны..."

# game/Story03.rpy:5964
translate russian akt3chapter5_c86ee6ae:

    # Fl "I don’t mind."
    Fl "Я не против."

# game/Story03.rpy:5966
translate russian akt3chapter5_37bf6e39:

    # Fl "I wouldn’t mind picking up where we left off..."
    Fl "И я не против продолжить с того места, на котором мы остановились..."

# game/Story03.rpy:5969
translate russian akt3chapter5_70ce71e1:

    # mc "Not now."
    mc "Не сейчас."

# game/Story03.rpy:5970
translate russian akt3chapter5_b2dbb847:

    # Fl "No...? You sure?"
    Fl "Нет...? Уверен?"

# game/Story03.rpy:5979
translate russian akt3chapter5_be85719e:

    # Fl "Boop... Believe me, I’d love to feel you again — every inch of you—"
    Fl "Буп... Поверь, я бы с удовольствием снова почувствовала тебя... Каждый твой сантиметр..."

# game/Story03.rpy:5983
translate russian akt3chapter5_182989fd:

    # Fl "...but you’re right. Now’s not the time."
    Fl "Но ты прав. Сейчас не время."

# game/Story03.rpy:5989
translate russian akt3chapter5_5e11b74b:

    # Fl "So... gonna let me go?"
    Fl "Так... ты отпустишь меня?"

# game/Story03.rpy:5990
translate russian akt3chapter5_28b8c7f3:

    # mc "I’m not holding you. It’s you who won’t let go."
    mc "Я тебя не держу. Это ты не отпускаешь."

# game/Story03.rpy:5994
translate russian akt3chapter5_58942413:

    # Fl "Tell the short one I said hi."
    Fl "Передай привет коротышке."

# game/Story03.rpy:5996
translate russian akt3chapter5_8a68d655:

    # mc "Take care of yourself."
    mc "Береги себя."

# game/Story03.rpy:5998
translate russian akt3chapter5_96b6b8af:

    # mc "(Time to go. I owe a visit... to one wicked little girl.)"
    mc "(Пора идти. Я должен навестить... одну злую девочку.)"

# game/Story03.rpy:6005
translate russian akt3chapter5_d879c7ef:

    # Mi "Don't fall behind, Olivia."
    Mi "Не отставай, Оливия."

# game/Story03.rpy:6007
translate russian akt3chapter5_cf5ef594:

    # h "Me? Fall behind? Keep dreaming, elf-girl. I’m about to wipe the floor with you."
    h "Я? Отставать? Мечтай, эльфийка. Я собираюсь вытереть тобой пол."

# game/Story03.rpy:6029
translate russian akt3chapter5_be88d995:

    # Mi "Color me impressed. You’d usually be wheezing on the floor by now."
    Mi "Я впечатлена. Обычно ты бы уже хрипела на полу."

# game/Story03.rpy:6034
translate russian akt3chapter5_420adc9f:

    # h "Gotcha!"
    h "Попалась!"

# game/Story03.rpy:6037
translate russian akt3chapter5_19d73308:

    # h "Time for a little payback!"
    h "Пора вернуть должок!"

# game/Story03.rpy:6049
translate russian akt3chapter5_fd061f03:

    # Mi "One–zero, Olivia. Want me to keep going?"
    Mi "Один-ноль, Оливия. Хочешь, чтобы я продолжила?"

# game/Story03.rpy:6052
translate russian akt3chapter5_1b85c54f:

    # h "That’s not fair! We agreed — no implants, no cheap tricks!"
    h "Это нечестно! Мы договорились - никаких имплантов, никаких дешёвых трюков!"

# game/Story03.rpy:6058
translate russian akt3chapter5_8c1ca3c6:

    # Mi "(I’m in the air…)"
    Mi "(Я в воздухе…)"

# game/Story03.rpy:6061
translate russian akt3chapter5_6e7ff19b:

    # mc "Having fun, are we?"
    mc "Веселитесь, да?"

# game/Story03.rpy:6063
translate russian akt3chapter5_f804cb0d:

    # Mi "Put me down…"
    Mi "Поставь меня на место..."

# game/Story03.rpy:6065
translate russian akt3chapter5_47a7d7c6:

    # mc "Looks like the training’s paying off."
    mc "Похоже, тренировки приносят свои плоды."

# game/Story03.rpy:6067
translate russian akt3chapter5_1fe071d1:

    # h "Oh, look who finally remembered I exist."
    h "О, посмотрите-ка, кто наконец-то вспомнил о моём существовании."

# game/Story03.rpy:6068
translate russian akt3chapter5_be27a66a:

    # mc "Saving the best for last."
    mc "Приберёг лучшее напоследок."

# game/Story03.rpy:6070
translate russian akt3chapter5_f28b979b:

    # h "You’re looking way better than a few days ago."
    h "Ты выглядишь куда лучше, чем пару дней назад."

# game/Story03.rpy:6071
translate russian akt3chapter5_e087a34e:

    # mc "I’ll take that… I think?"
    mc "Спасибо... Наверное?"

# game/Story03.rpy:6072
translate russian akt3chapter5_d10cde38:

    # h "Let me guess — Lora’s handiwork?"
    h "Дай угадаю - это дело рук Лоры?"

# game/Story03.rpy:6074
translate russian akt3chapter5_deb9a320:

    # mc "No idea."
    mc "Без понятия."

# game/Story03.rpy:6078
translate russian akt3chapter5_1bef6b5d:

    # mc "Not gonna say anything?"
    mc "Ничего не скажешь?"

# game/Story03.rpy:6082
translate russian akt3chapter5_eedcf11b:

    # Mi "I think I’ll head out."
    Mi "Думаю, я пойду."

# game/Story03.rpy:6091
translate russian akt3chapter5_590aa206:

    # h "You two are acting weird. Like, seriously weird."
    h "Вы двое ведёте себя странно. Типа, очень странно."

# game/Story03.rpy:6093
translate russian akt3chapter5_d38c2456:

    # h "What did you do this time?"
    h "И что ты натворил на этот раз?"

# game/Story03.rpy:6095
translate russian akt3chapter5_6e0cbc41:

    # mc "Nothing?"
    mc "Ничего?"

# game/Story03.rpy:6097
translate russian akt3chapter5_12f1676c:

    # h "Uh-huh. You sure about that?"
    h "Угу. Ты в этом уверен?"

# game/Story03.rpy:6099
translate russian akt3chapter5_f58649e6:

    # mc "(What does she want me to say?)"
    mc "(Что она хочет, чтобы я сказал?)"

# game/Story03.rpy:6105
translate russian akt3chapter5_dcd0017e:

    # h "How’s Lora, by the way? Not losing her mind over your little harem?"
    h "Кстати, как там Лора? Не сошла с ума из-за твоего маленького гарема?"

# game/Story03.rpy:6106
translate russian akt3chapter5_eccc7153:

    # mc "Harem?"
    mc "Гарема?"

# game/Story03.rpy:6108
translate russian akt3chapter5_550610f9:

    # h "Oh, come on. Don’t play innocent. You’ve got girls circling you like you're the last man on Earth."
    h "Ой, да ладно. Не прикидывайся невинным. Девушки кружат вокруг тебя, как будто ты последний мужчина на Земле."

# game/Story03.rpy:6110
translate russian akt3chapter5_3ad41076:

    # mc "And you? What do you think about that?"
    mc "А ты? Что ты об этом думаешь?"

# game/Story03.rpy:6112
translate russian akt3chapter5_f71f86ad:

    # h "Your ‘harem’? Hah."
    h "О твоём \"гареме\"? Хах."

# game/Story03.rpy:6113
translate russian akt3chapter5_b7050ab2:

    # h "As long as you don’t lie to me — and you don’t forget I’m still here — the rest isn’t my problem."
    h "Пока ты не врёшь мне и не забываешь, что я всё ещё здесь, остальное меня не волнует."

# game/Story03.rpy:6114
translate russian akt3chapter5_a39a1d50:

    # mc "You're serious?"
    mc "Ты серьёзно?"

# game/Story03.rpy:6117
translate russian akt3chapter5_21e48207:

    # h "Do I look like I’ve got a choice?"
    h "Разве у меня есть выбор?"

# game/Story03.rpy:36
translate russian story04_9693ff4f:

    # mc "I buried you, Lora. A hundred times. Inside myself, every single day."
    mc "Я хоронил тебя, Лора. Сотни раз. Внутри себя, каждый день."

# game/Story03.rpy:66
translate russian story04_d7c60a8b:

    # Lor "Too much time passed. You should’ve forgotten me. And if you didn’t, it means you didn’t even try."
    Lor "Прошло слишком много времени. Ты должен был забыть меня. А если не забыл, значит, даже не пытался."

# game/Story03.rpy:94
translate russian story04_8466c3b9:

    # mc "No! I tried to keep him alive."
    mc "Нет! Я пытался сохранить ему жизнь."

# game/Story03.rpy:95
translate russian story04_58dbe82c:

    # mc "I warned him. Told him it wasn’t safe."
    mc "Я предупреждал его. Сказал, что там небезопасно."

# game/Story03.rpy:97
translate russian story04_18bcbb23:

    # mc "He didn’t listen."
    mc "Он не послушал."

# game/Story03.rpy:107
translate russian story04_450985e2:

    # mc "…It should’ve been me."
    mc "...Это должен был быть я."

# game/Story03.rpy:115
translate russian story04_55c64335:

    # mc "(…Is it really…?)"
    mc "(...Неужели это правда...?)"

# game/Story03.rpy:123
translate russian story04_b74da216:

    # mc "…I don’t even know what to say."
    mc "...Я даже не знаю, что сказать."

# game/Story03.rpy:129
translate russian story04_96759569:

    # mc "Every second. Without you, they were all the same."
    mc "Каждую секунду. Без тебя они все были одинаковыми."

# game/Story03.rpy:132
translate russian story04_24e53ddb:

    # L "I shouldn't have come back. Not like this."
    L "Мне не стоило возвращаться. Не так."

# game/Story03.rpy:134
translate russian story04_7fc6a47c:

    # mc "But you did."
    mc "Но ты вернулась."

# game/Story03.rpy:144
translate russian story04_8ff4a7cf:

    # mc "Lora… what is it?"
    mc "Лора... что такое?"

# game/Story03.rpy:153
translate russian story04_8aa651f2:

    # mc "(A scar?.. No. More like... miasma.)"
    mc "(Шрам?.. Нет. Скорее... миазмы.)"

# game/Story03.rpy:154
translate russian story04_26be1618:

    # mc "…Hey."
    mc "...Эй."

# game/Story03.rpy:158
translate russian story04_099892fb:

    # mc "Who did this?"
    mc "Кто это сделал?"

# game/Story03.rpy:163
translate russian story04_a09b8be3:

    # L "And now... I don’t even know what hurts more, that I left..."
    L "И теперь... я даже не знаю, что больнее: то, что я ушла..."

# game/Story03.rpy:167
translate russian story04_a9d41133:

    # L "Or that you were still waiting."
    L "или то, что ты все еще ждал."

# game/Story03.rpy:169
translate russian story04_69210536:

    # mc "What are you talking about?.."
    mc "О чем ты говоришь?.."

# game/Story03.rpy:173
translate russian story04_76f31adf:

    # mc "(That look… you’re hiding something.)"
    mc "(Этот взгляд... ты что-то скрываешь.)"

# game/Story03.rpy:176
translate russian story04_7f1d93fd:

    # L "I missed you. Your voice. Just... an ordinary day with you."
    L "Я скучала по тебе. По твоему голосу. Просто... по обычному дню рядом с тобой."

# game/Story03.rpy:177
translate russian story04_fe6fb19d:

    # L "All those years, I was alive. Physically."
    L "Все эти годы я была жива. Физически."

# game/Story03.rpy:178
translate russian story04_16904d01:

    # L "But every day, it was like an equation with no variable."
    L "Но каждый день был как уравнение без переменной."

# game/Story03.rpy:192
translate russian story04_c09b6015_2:

    # mc "What happened to you?"
    mc "Что с тобой случилось?"

# game/Story03.rpy:195
translate russian story04_61ec747c:

    # mc "I’ll find out."
    mc "Я выясню."

# game/Story03.rpy:196
translate russian story04_7147ceab:

    # mc "Today or tomorrow, doesn’t matter."
    mc "Сегодня или завтра, неважно."

# game/Story03.rpy:198
translate russian story04_b85195f7:

    # mc "But I’m not pretending this is okay."
    mc "Но я не буду делать вид, что все в порядке."

# game/Story03.rpy:202
translate russian story04_a3fc761c:

    # mc "Then tell me."
    mc "Тогда скажи мне."

# game/Story03.rpy:203
translate russian story04_622524e1:

    # L "(Whispering) They followed us."
    L "(шепотом) Они пошли за нами."

# game/Story03.rpy:208
translate russian story04_cfcc2293:

    # mc "I know."
    mc "Я знаю."

# game/Story03.rpy:209
translate russian story04_e4c77888:

    # L "You..."
    L "Ты..."

# game/Story03.rpy:213
translate russian story04_2ba0bdc4:

    # L "...How?"
    L "...Как?"

# game/Story03.rpy:221
translate russian story04_745afed5:

    # L "Of course..."
    L "Конечно..."

# game/Story03.rpy:240
translate russian story04_052cb094:

    # h "Lora... if you can’t tell him, then show him. Let him feel it. That bastard’s not going anywhere. You know him."
    h "Лора... если не можешь сказать, покажи ему. Дай ему это почувствовать. Этот упрямый ублюдок никуда не уйдет. Ты его знаешь."

# game/Story03.rpy:245
translate russian story04_d9e5f7d7:

    # h "And you, stop burning holes in her with that stare. You’re not her executioner."
    h "А ты перестань прожигать ее взглядом. Ты не ее палач."

# game/Story03.rpy:246
translate russian story04_2c9a0519:

    # mc "…Yeah."
    mc "...Да."

# game/Story03.rpy:247
translate russian story04_f3c5e835:

    # mc "Guess I don’t have much to add."
    mc "Пожалуй, мне особо нечего добавить."

# game/Story03.rpy:248
translate russian story04_d26074a8:

    # mc "Well… maybe one thing."
    mc "Хотя... может, кое-что."

# game/Story03.rpy:249
translate russian story04_38b71016:

    # mc "That time you blew up half the house with that rose experiment."
    mc "Помнишь, как ты своим экспериментом с розой взорвала полдома?"

# game/Story03.rpy:250
translate russian story04_59708e36:

    # mc "Took me forever to fix it."
    mc "Я потом вечность это чинил."

# game/Story03.rpy:252
translate russian story04_3c7e26c7:

    # mc "…Still worth it."
    mc "...И все равно оно того стоило."

# game/Story03.rpy:256
translate russian story04_606cf633:

    # L "But we both know, chaos was always your element, not mine."
    L "Но мы оба знаем: хаос всегда был твоей стихией, не моей."

# game/Story03.rpy:258
translate russian story04_6947410e:

    # mc "(That’s not like her.)"
    mc "(Это на нее не похоже.)"

# game/Story03.rpy:260
translate russian story04_ab72f821:

    # mc "(Too calm.)"
    mc "(Слишком спокойна.)"

# game/Story03.rpy:261
translate russian story04_ae37c2cf:

    # mc "You remember that trip we planned?"
    mc "Помнишь ту поездку, которую мы планировали?"

# game/Story03.rpy:263
translate russian story04_087b569c:

    # mc "To take Olivia and Anya on-"
    mc "Куда хотели взять Оливию и Аню..."

# game/Story03.rpy:270
translate russian story04_7974f397:

    # mc "Lora… you okay?"
    mc "Лора... ты в порядке?"

# game/Story03.rpy:282
translate russian story04_2369dd01:

    # L "(whispering) I'm scared..."
    L "(шепотом) Мне страшно..."

# game/Story03.rpy:284
translate russian story04_b633dac2:

    # L "(whispering) ...to losing you again..."
    L "(шепотом) ...снова потерять тебя..."

# game/Story03.rpy:286
translate russian story04_174d390f:

    # h "Take the step, even if it scares you. He’ll be there to catch you."
    h "Сделай шаг, даже если страшно. Он поймает тебя."

# game/Story03.rpy:293
translate russian story04_9861b9aa:

    # mc "Why."
    mc "Почему."

# game/Story03.rpy:300
translate russian story04_085fe47d:

    # mc "No secrets."
    mc "Без секретов."

# game/Story03.rpy:302
translate russian story04_1c4b4b57:

    # L "...I saw."
    L "...Я видела."

# game/Story03.rpy:303
translate russian story04_b7437275:

    # L "...Your death."
    L "...Твою смерть."

# game/Story03.rpy:310
translate russian story04_160d35e0:

    # L "A lot... of time."
    L "Много... раз."

# game/Story03.rpy:312
translate russian story04_2fd078aa:

    # L "Again. And again."
    L "Снова. И снова."

# game/Story03.rpy:314
translate russian story04_39bb903f:

    # mc "My… death?"
    mc "Мою... смерть?"

# game/Story03.rpy:316
translate russian story04_79f5f4d6:

    # L "Sometimes knowing ruins more than not knowing ever could."
    L "Иногда знание разрушает сильнее, чем незнание вообще могло бы."

# game/Story03.rpy:323
translate russian story04_79c3a04e:

    # mc "(That tone… she’s holding something back.)"
    mc "(Этот тон... она что-то недоговаривает.)"

# game/Story03.rpy:332
translate russian story04_d5cf79d5:

    # mc "…Why would you ask that?"
    mc "...Почему ты спрашиваешь?"

# game/Story03.rpy:337
translate russian story04_0fe7e331:

    # mc "Of course we-"
    mc "Конечно, мы..."

# game/Story03.rpy:339
translate russian story04_b8989d76:

    # mc "(Inquisition?)"
    mc "(Инквизиция?)"

# game/Story03.rpy:342
translate russian story04_41f19d44:

    # mc "(First Kalestra, now this one...)"
    mc "(Сначала Калестра, теперь еще она...)"

# game/Story03.rpy:361
translate russian story04_14c49c9b:

    # L "But... I need this."
    L "Но... мне это нужно."

# game/Story03.rpy:368
translate russian story04_1fa854c9:

    # a "Make it quick."
    a "Быстрее."

# game/Story03.rpy:376
translate russian story04_8eb62a7b:

    # mc "…And?"
    mc "...И?"

# game/Story03.rpy:382
translate russian story04_845c4c57:

    # mc "What was that?"
    mc "Что это сейчас было?"

# game/Story03.rpy:399
translate russian story04_384f897d:

    # L "I sleep, she files a report. I stay silent, they monitor my breathing. I think about you, they..."
    L "Я сплю - она пишет отчет. Я молчу - они следят за моим дыханием. Я думаю о тебе - они..."

# game/Story03.rpy:403
translate russian story04_99572bcd:

    # mc "…Right."
    mc "...Понятно."

# game/Story03.rpy:406
translate russian story04_57364719:

    # mc "Doesn’t sound like freedom."
    mc "На свободу не похоже."

# game/Story03.rpy:416
translate russian story04_394b8b2e:

    # h "Although, if you want the latter, we do have some ideas."
    h "Хотя, если тебе хочется последнего, у нас есть пара идей."

# game/Story03.rpy:422
translate russian story04_6a7adb0c:

    # mc "I’ll bring something next time."
    mc "В следующий раз что-нибудь принесу."

# game/Story03.rpy:424
translate russian story04_39dec636:

    # mc "We’ll figure something out."
    mc "Мы что-нибудь придумаем."

# game/Story03.rpy:433
translate russian story04_a34fa0dd:

    # L "But seriously, how did you get here?"
    L "А если серьезно, как вы сюда попали?"

# game/Story03.rpy:438
translate russian story04_17171e8e:

    # h "One moment you’re staring at some rift, next thing, boom. Different galaxy."
    h "Сначала смотришь на какой-то разлом, а через секунду - бац. Другая галактика."

# game/Story03.rpy:441
translate russian story04_ff853847:

    # mc "Everything else?"
    mc "Все остальное?"

# game/Story03.rpy:450
translate russian story04_6410bc11:

    # mc "Complicated."
    mc "Сложно."

# game/Story03.rpy:455
translate russian story04_ab5bdcd7:

    # mc "You seem better now."
    mc "Сейчас тебе будто лучше."

# game/Story03.rpy:457
translate russian story04_4a4f1156:

    # mc "Was it because of her?"
    mc "Из-за нее?"

# game/Story03.rpy:458
translate russian story04_c53091ff:

    # L "Partially. But not really."
    L "Отчасти. Но не совсем."

# game/Story03.rpy:464
translate russian story04_9055231a:

    # L "I want to. Just..."
    L "Я хочу. Просто..."

# game/Story03.rpy:466
translate russian story04_5d7b4cfa:

    # L "I’ve lost too much already to ruin this moment too."
    L "Я уже потеряла слишком много, чтобы испортить еще и этот миг."

# game/Story03.rpy:467
translate russian story04_94ce1bed:

    # mc "(…Why?)"
    mc "(...Почему?)"

# game/Story03.rpy:468
translate russian story04_b4154502:

    # mc "(We’re not strangers.)"
    mc "(Мы не чужие.)"

# game/Story03.rpy:469
translate russian story04_280e93cc:

    # mc "(So what’s stopping you?)"
    mc "(Тогда что тебя останавливает?)"

# game/Story03.rpy:474
translate russian story04_0b348ba0:

    # mc "…Alright."
    mc "...Ладно."

# game/Story03.rpy:484
translate russian story04_b6cdb87f:

    # mc "You know you’re a grandmother now?"
    mc "Ты знаешь, что теперь ты бабушка?"

# game/Story03.rpy:492
translate russian story04_035af7ae:

    # mc "…You still remember."
    mc "...Ты все еще помнишь."

# game/Story03.rpy:501
translate russian story04_7c895712:

    # mc "She’s doing alright."
    mc "У нее все неплохо."

# game/Story03.rpy:504
translate russian story04_a3fe42da:

    # mc "Anya?"
    mc "Аня?"

# game/Story03.rpy:506
translate russian story04_a7955f60:

    # mc "Still the same."
    mc "Все такая же."

# game/Story03.rpy:528
translate russian story04_0ac3693b:

    # h "Too late, Lora. He’s mine now, willingly and begrudgingly."
    h "Поздно, Лора. Теперь он мой - добровольно и скрепя сердце."

# game/Story03.rpy:532
translate russian story04_7ecdcdb3:

    # mc "You never add sugar."
    mc "Ты никогда не добавляешь сахар."

# game/Story03.rpy:536
translate russian story04_78bfc019:

    # mc "Should’ve stayed in the coma…"
    mc "Надо было оставаться в коме..."

# game/Story03.rpy:545
translate russian story04_c6a1f96b:

    # mc "(Seeing them smile…)"
    mc "(Видеть их улыбки...)"

# game/Story03.rpy:549
translate russian story04_83344d3d:

    # mc "(…That’s enough.)"
    mc "(...Этого достаточно.)"

# game/Story03.rpy:574
translate russian story04_7fa181fb:

    # mc "…Don’t make me wait too long."
    mc "...Не заставляй меня ждать слишком долго."

# game/Story03.rpy:585
translate russian akt3chapter1_2_f5f79f61:

    # "Sector 6. Blue Moon."
    "Сектор 6. Голубая луна."

# game/Story03.rpy:587
translate russian akt3chapter1_2_37bc3011:

    # mc "(…Tension’s thick.)"
    mc "(...Напряжение хоть ножом режь.)"

# game/Story03.rpy:591
translate russian akt3chapter1_2_64a9699a:

    # mc "(Give it time, something’s gonna snap.)"
    mc "(Дай ему время, и что-нибудь обязательно лопнет.)"

# game/Story03.rpy:598
translate russian akt3chapter1_2_0f527b40:

    # h "No clue."
    h "Без понятия."

# game/Story03.rpy:603
translate russian akt3chapter1_2_ae38f0ee:

    # h "You’ll get more words out of a brick wall than out of Miss Silent here."
    h "У кирпичной стены ты вытянешь больше слов, чем у нашей мисс Молчание."

# game/Story03.rpy:614
translate russian akt3chapter1_2_81c849f9:

    # h "Don't know."
    h "Не знаю."

# game/Story03.rpy:615
translate russian akt3chapter1_2_b0ee278f:

    # h "The cat said they’re short on people, literally."
    h "Кошка сказала, что у них не хватает людей. В буквальном смысле."

# game/Story03.rpy:619
translate russian akt3chapter1_2_a73f5623:

    # h "She needs Ember's answer."
    h "Ей нужен ответ Эмбер."

# game/Story03.rpy:624
translate russian akt3chapter1_2_1334db12:

    # L "Sorry… couldn’t help overhearing."
    L "Прости... я невольно услышала."

# game/Story03.rpy:628
translate russian akt3chapter1_2_df212ef4:

    # L "Flora?.."
    L "Флора?.."

# game/Story03.rpy:632
translate russian akt3chapter1_2_6bcb0b13:

    # L "...That figures."
    L "...Тогда понятно."

# game/Story03.rpy:634
translate russian akt3chapter1_2_bb19f620:

    # h "Whoa. That reaction, don’t tell me you know her?"
    h "Ого. Судя по реакции, ты ее знаешь?"

# game/Story03.rpy:638
translate russian akt3chapter1_2_09975d21:

    # mc "Any problem?"
    mc "Проблемы?"

# game/Story03.rpy:641
translate russian akt3chapter1_2_94fc0bf9:

    # L "Her mother was my mentor."
    L "Ее мать была моей наставницей."

# game/Story03.rpy:642
translate russian akt3chapter1_2_ce662af1:

    # L "I owe her more than I can explain."
    L "Я обязана ей больше, чем могу объяснить."

# game/Story03.rpy:644
translate russian akt3chapter1_2_d0263dc2:

    # L "I wouldn’t be standing here without her."
    L "Без нее меня бы здесь не было."

# game/Story03.rpy:655
translate russian akt3chapter1_2_1975860a:

    # L "...So that’s how it is."
    L "...Вот как."

# game/Story03.rpy:657
translate russian akt3chapter1_2_a1b44c2e:

    # mc "(whispering) Something wrong with Flora?"
    mc "(шепотом) С Флорой что-то не так?"

# game/Story03.rpy:658
translate russian akt3chapter1_2_256a6538:

    # L "(whispers) Flora’s not the problem."
    L "(шепотом) Проблема не во Флоре."

# game/Story03.rpy:662
translate russian akt3chapter1_2_1c57a87f:

    # L "(whispers) Her mother… that’s where things get complicated."
    L "(шепотом) Ее мать... вот где все становится сложнее."

# game/Story03.rpy:663
translate russian akt3chapter1_2_66aa968d:

    # L "(whispers) The Inquisition has a history with them."
    L "(шепотом) У Инквизиции с ними давняя история."

# game/Story03.rpy:665
translate russian akt3chapter1_2_35842eae:

    # L "(whispers) And it’s not a friendly one."
    L "(шепотом) И дружеской ее не назовешь."

# game/Story03.rpy:669
translate russian akt3chapter1_2_f61a286d:

    # mc "(What did you get yourself into…?)"
    mc "(Во что же ты ввязалась...?)"

# game/Story03.rpy:673
translate russian akt3chapter1_2_279af9ea:

    # h "Okay, can we finally talk about what we’re doing next?"
    h "Ладно, мы наконец можем обсудить, что делаем дальше?"

# game/Story03.rpy:685
translate russian akt3chapter1_2_aea6cb36:

    # mc "That the official line?"
    mc "Это официальная версия?"

# game/Story03.rpy:690
translate russian akt3chapter1_2_815bd241:

    # L "(whispers) We’re already too late."
    L "(шепотом) Мы уже опоздали."

# game/Story03.rpy:702
translate russian akt3chapter1_2_a484b3ad:

    # mc "(…What the hell does that mean?)"
    mc "(...Что это, черт возьми, значит?)"

# game/Story03.rpy:706
translate russian akt3chapter1_2_93fdd356:

    # mc "What do we call you?"
    mc "Как нам тебя называть?"

# game/Story03.rpy:714
translate russian akt3chapter1_2_75f652cc:

    # mc "So be it."
    mc "Пусть так."

# game/Story03.rpy:715
translate russian akt3chapter1_2_976ee3f5:

    # mc "You and Kalestra."
    mc "Ты и Калестра."

# game/Story03.rpy:717
translate russian akt3chapter1_2_9db04097:

    # mc "Same kind?"
    mc "Один вид?"

# game/Story03.rpy:737
translate russian akt3chapter1_2_dc6c0d6a:

    # mc "Then why bring us here?"
    mc "Тогда зачем привела нас сюда?"

# game/Story03.rpy:741
translate russian akt3chapter1_2_603fd34e:

    # mc "You don’t show up without Astoria’s say-so."
    mc "Ты не появляешься без разрешения Астории."

# game/Story03.rpy:744
translate russian akt3chapter1_2_6240ec20:

    # mc "So stop wasting time."
    mc "Так что перестань тратить время."

# game/Story03.rpy:748
translate russian akt3chapter1_2_91c3ef79:

    # mc "(…Right. Talking to a wall.)"
    mc "(...Точно. Разговор со стеной.)"

# game/Story03.rpy:749
translate russian akt3chapter1_2_36eadfd7:

    # mc "Then answer this."
    mc "Тогда ответь на это."

# game/Story03.rpy:751
translate russian akt3chapter1_2_9d83a8e2:

    # mc "What are you doing here?"
    mc "Что ты здесь делаешь?"

# game/Story03.rpy:754
translate russian akt3chapter1_2_76980de4:

    # mc "And us?"
    mc "А мы?"

# game/Story03.rpy:756
translate russian akt3chapter1_2_efc6895f:

    # mc "Where do we fit?"
    mc "Мы здесь при чем?"

# game/Story03.rpy:760
translate russian akt3chapter1_2_abc4a408:

    # a "Chaplain order."
    a "Приказ капеллана."

# game/Story03.rpy:765
translate russian akt3chapter1_2_a7a878c6:

    # mc "We’re heading for the tower."
    mc "Мы идем к Башне."

# game/Story03.rpy:771
translate russian akt3chapter1_2_97149d21:

    # mc "To shut the gate down."
    mc "Чтобы отключить Врата."

# game/Story03.rpy:792
translate russian akt3chapter1_2_3eb73908:

    # mc "We don’t have time for that."
    mc "У нас нет на это времени."

# game/Story03.rpy:793
translate russian akt3chapter1_2_59616d71:

    # k "Sprint blindfolded into the meat grinder and pray louder than the enemy shoots?"
    k "Рвануть с завязанными глазами в мясорубку и молиться громче, чем стреляет враг?"

# game/Story03.rpy:794
translate russian akt3chapter1_2_5e71a4bb:

    # k "Funny."
    k "Забавно."

# game/Story03.rpy:795
translate russian akt3chapter1_2_1e03d37d:

    # k "Weren’t you whining about that cat-man using the exact same method?"
    k "Ты ведь только что ныл, что тот кот пользуется ровно тем же методом?"

# game/Story03.rpy:796
translate russian akt3chapter1_2_326786cd:

    # k "Besides... I already dragged your corpses out once."
    k "К тому же... я уже один раз вытащила ваши трупы."

# game/Story03.rpy:800
translate russian akt3chapter1_2_78e2650b:

    # k "Don’t grow entitled."
    k "Не привыкайте."

# game/Story03.rpy:806
translate russian akt3chapter1_2_e517651c:

    # k "More like the dragon."
    k "Скорее дракон."

# game/Story03.rpy:808
translate russian akt3chapter1_2_31b8146c:

    # k "Speaking of, where is pointy-ears?"
    k "Кстати, где остроухая?"

# game/Story03.rpy:831
translate russian akt3chapter1_2_dc11c0fc:

    # k "As always. And as always, tight-lipped."
    k "Как всегда. И, как всегда, рот на замке."

# game/Story03.rpy:834
translate russian akt3chapter1_2_e2a95985:

    # k "You guys hang here. I need a word with miss broody over here."
    k "Вы пока побудьте здесь. Мне нужно перекинуться парой слов с мисс Мрачность."

# game/Story03.rpy:919
translate russian akt3chapter1_3_f68fb0b2:

    # L "Well?"
    L "Ну?"

# game/Story03.rpy:926
translate russian akt3chapter1_3_0c85d999:

    # L "…Good to know."
    L "...Хорошо это знать."

# game/Story03.rpy:928
translate russian akt3chapter1_3_47faff2b:

    # L "And I’m glad we’re together again."
    L "И я рада, что мы снова вместе."

# game/Story03.rpy:929
translate russian akt3chapter1_3_c3aaca30:

    # L "It’s bigger than I expected."
    L "Здесь больше, чем я ожидала."

# game/Story03.rpy:931
translate russian akt3chapter1_3_c8e88140:

    # L "Strangely cozy, too."
    L "И, как ни странно, довольно уютно."

# game/Story03.rpy:934
translate russian akt3chapter1_3_dcee8c8b:

    # mc "(You’re dodging it...)"
    mc "(Ты уходишь от ответа...)"

# game/Story03.rpy:935
translate russian akt3chapter1_3_f2a9d106:

    # mc "The cozy part, that’s you. The room’s just an empty box."
    mc "Уют здесь - это ты. Комната просто пустая коробка."

# game/Story03.rpy:950
translate russian akt3chapter1_3_891b02c1:

    # L "Oh come on, you’re exaggerating, those were good memories."
    L "Да брось, ты преувеличиваешь. Это были хорошие воспоминания."

# game/Story03.rpy:958
translate russian akt3chapter1_3_26de8d45:

    # mc "Tell me, do they always mess up names like that around here?"
    mc "Скажи, они здесь всегда так странно называют вещи?"

# game/Story03.rpy:965
translate russian akt3chapter1_3_87914250:

    # L "I’d pass."
    L "Я бы отказалась."

# game/Story03.rpy:966
translate russian akt3chapter1_3_6e8fc0c7:

    # L "And I wouldn’t recommend it to you either."
    L "И тебе тоже не советую."

# game/Story03.rpy:969
translate russian akt3chapter1_3_8fc7a981:

    # L "That’s what everyone says…"
    L "Так все говорят..."

# game/Story03.rpy:971
translate russian akt3chapter1_3_fd73adf7:

    # L "Right before it starts eating through them."
    L "пока оно не начинает разъедать их изнутри."

# game/Story03.rpy:974
translate russian akt3chapter1_3_4f8b99c1:

    # L "Relax. I’m joking."
    L "Расслабься. Я шучу."

# game/Story03.rpy:976
translate russian akt3chapter1_3_f2a62bfb:

    # L "...Mostly."
    L "...В основном."

# game/Story03.rpy:1002
translate russian akt3chapter1_3_df9bdc07:

    # L "There are things I can’t tell you."
    L "Есть вещи, о которых я не могу тебе рассказать."

# game/Story03.rpy:1004
translate russian akt3chapter1_3_c14b089b:

    # L "...Even if I wanted to."
    L "...Даже если хочу."

# game/Story03.rpy:1014
translate russian akt3chapter1_3_7e1e7e51:

    # L "I was already there."
    L "Я уже была там."

# game/Story03.rpy:1015
translate russian akt3chapter1_3_75e085dd:

    # L "On Earth."
    L "На Земле."

# game/Story03.rpy:1019
translate russian akt3chapter1_3_ca07f7dc:

    # L "After the incident."
    L "После инцидента."

# game/Story03.rpy:1037
translate russian akt3chapter1_3_a899b983:

    # mc "While I sat every night staring at an empty comm, praying for a sound, a word, a breath?!"
    mc "Пока я каждую ночь сидел и смотрел в пустой коммуникатор, молясь услышать хоть звук, хоть слово, хоть дыхание?!"

# game/Story03.rpy:1040
translate russian akt3chapter1_3_0002cea4:

    # L "You think I was ignoring you?"
    L "Ты думаешь, я тебя игнорировала?"

# game/Story03.rpy:1041
translate russian akt3chapter1_3_bbb15591:

    # L "You think I had the luxury of waiting for your voice?"
    L "Думаешь, у меня была роскошь ждать твоего голоса?"

# game/Story03.rpy:1042
translate russian akt3chapter1_3_0f633cb2:

    # L "I didn’t hear silence, [mc]."
    L "Я слышала не тишину, [mc]."

# game/Story03.rpy:1043
translate russian akt3chapter1_3_48960cab:

    # L "I heard them."
    L "Я слышала их."

# game/Story03.rpy:1044
translate russian akt3chapter1_3_e78b3a91:

    # L "Again."
    L "Снова."

# game/Story03.rpy:1045
translate russian akt3chapter1_3_396c7eee:

    # L "And again."
    L "И снова."

# game/Story03.rpy:1053
translate russian akt3chapter1_3_396c7eee_1:

    # L "And again."
    L "И снова."

# game/Story03.rpy:1063
translate russian akt3chapter1_3_3416c153:

    # L "Family…?"
    L "Семья...?"

# game/Story03.rpy:1064
translate russian akt3chapter1_3_e29ce428:

    # L "…Family?"
    L "...Семья?"

# game/Story03.rpy:1065
translate russian akt3chapter1_3_2e0fd158:

    # L "Ahahah—"
    L "Ахаха..."

# game/Story03.rpy:1067
translate russian akt3chapter1_3_d08554ea:

    # L "You still believe in that?"
    L "Ты все еще в это веришь?"

# game/Story03.rpy:1072
translate russian akt3chapter1_3_615a2be0:

    # L "I wanted to die there…"
    L "Я хотела умереть там..."

# game/Story03.rpy:1073
translate russian akt3chapter1_3_f76ebaa6:

    # L "I tried to die there."
    L "Я пыталась умереть там."

# game/Story03.rpy:1076
translate russian akt3chapter1_3_46fe9950:

    # L "...More than once."
    L "...И не один раз."

# game/Story03.rpy:1084
translate russian akt3chapter1_3_322e4d52:

    # L "Because I’m no longer someone you can come to."
    L "Потому что я больше не та, к кому ты можешь прийти."

# game/Story03.rpy:1086
translate russian akt3chapter1_3_0e0d8e7f:

    # L "I’m what’s left."
    L "Я то, что осталось."

# game/Story03.rpy:1087
translate russian akt3chapter1_3_0ed7883a:

    # mc "I cursed your name."
    mc "Я проклинал твое имя."

# game/Story03.rpy:1089
translate russian akt3chapter1_3_c9808cc0:

    # mc "And still... I waited."
    mc "И все равно... ждал."

# game/Story03.rpy:1100
translate russian akt3chapter1_3_849a4f45:

    # L "You think I didn’t try?"
    L "Думаешь, я не пыталась?"

# game/Story03.rpy:1102
translate russian akt3chapter1_3_7fbb8c05:

    # L "I did."
    L "Пыталась."

# game/Story03.rpy:1104
translate russian akt3chapter1_3_95325b70:

    # L "Over… and over."
    L "Снова... и снова."

# game/Story03.rpy:1106
translate russian akt3chapter1_3_0dc0703f:

    # L "Same ending."
    L "Один и тот же конец."

# game/Story03.rpy:1115
translate russian akt3chapter1_3_3bd181ae:

    # L "I’ve watched them die."
    L "Я смотрела, как они умирают."

# game/Story03.rpy:1116
translate russian akt3chapter1_3_cc2e8ab6:

    # L "I've watched you die..."
    L "Я смотрела, как умираешь ты..."

# game/Story03.rpy:1118
translate russian akt3chapter1_3_e78b3a91_1:

    # L "Again."
    L "Снова."

# game/Story03.rpy:1120
translate russian akt3chapter1_3_396c7eee_2:

    # L "And again."
    L "И снова."

# game/Story03.rpy:1122
translate russian akt3chapter1_3_396c7eee_3:

    # L "And again."
    L "И снова."

# game/Story03.rpy:1125
translate russian akt3chapter1_3_3d3eddb4:

    # L "I’m not asking for forgiveness."
    L "Я не прошу прощения."

# game/Story03.rpy:1127
translate russian akt3chapter1_3_3d1b3b64:

    # L "I don’t think it’s even possible."
    L "Я даже не думаю, что это возможно."

# game/Story03.rpy:1131
translate russian akt3chapter1_3_df375fcf:

    # L "So you know. So that if you hate me, it’s for the truth. Not for what you imagined."
    L "Я хочу, чтобы ты знал. Чтобы, если возненавидишь меня, то за правду. А не за то, что сам вообразил."

# game/Story03.rpy:1133
translate russian akt3chapter1_3_24d075b5:

    # mc "...You want me to hate you?"
    mc "...Ты хочешь, чтобы я тебя ненавидел?"

# game/Story03.rpy:1135
translate russian akt3chapter1_3_bf82e1a1:

    # L "You want the truth? I ran. And then I disappeared."
    L "Хочешь правду? Я сбежала. А потом исчезла."

# game/Story03.rpy:1138
translate russian akt3chapter1_3_2876efd9:

    # mc "Why?"
    mc "Почему?"

# game/Story03.rpy:1139
translate russian akt3chapter1_3_09437d02:

    # L "Afraid."
    L "Испугалась."

# game/Story03.rpy:1141
translate russian akt3chapter1_3_38f018d5:

    # L "If I came back and saw in your eyes..."
    L "Если бы я вернулась и увидела в твоих глазах..."

# game/Story03.rpy:1143
translate russian akt3chapter1_3_6ea51cde:

    # L "I couldn't."
    L "Я не смогла."

# game/Story03.rpy:1147
translate russian akt3chapter1_3_6ca481f0:

    # mc "You were everything I had. Everything."
    mc "Ты была всем, что у меня было. Всем."

# game/Story03.rpy:1156
translate russian akt3chapter1_3_a92b5d1e:

    # L "Hate me!"
    L "Ненавидь меня!"

# game/Story03.rpy:1158
translate russian akt3chapter1_3_fa928b9b:

    # L "Please..."
    L "Пожалуйста..."

# game/Story03.rpy:1173
translate russian akt3chapter1_3_f1febc7b:

    # L "You were the worst kind of choice, the one I couldn't unmake..."
    L "Ты был самым страшным выбором - тем, который я уже не могла отменить..."

# game/Story03.rpy:1174
translate russian akt3chapter1_3_1a8b5ef1:

    # mc "You’ve been through hell, Lora."
    mc "Ты прошла через ад, Лора."

# game/Story03.rpy:1176
translate russian akt3chapter1_3_b5b4172e:

    # mc "I’m just glad you let it spill."
    mc "Я просто рад, что ты наконец выпустила это наружу."

# game/Story03.rpy:1209
translate russian akt3chapter1_3_5f25b44e:

    # mc "So... how does your sudden appearance tie into my... {b}almost{/b} death?"
    mc "Так... как твое внезапное появление связано с моей... {b}почти{/b} смертью?"

# game/Story03.rpy:1279
translate russian akt3chapter1_3_a187cd75:

    # mc "Now that sounds suspicious."
    mc "А вот это уже звучит подозрительно."

# game/Story03.rpy:1281
translate russian akt3chapter1_3_f2ad8f6c:

    # mc "Makes me nervous."
    mc "Меня это напрягает."

# game/Story03.rpy:1282
translate russian akt3chapter1_3_29ec66b4:

    # L "Nothing complicated."
    L "Ничего сложного."

# game/Story03.rpy:1286
translate russian akt3chapter1_3_726a753f:

    # L "Just stay with me tonight."
    L "Просто останься со мной сегодня ночью."

# game/Story03.rpy:1292
translate russian akt3chapter1_3_03171757:

    # L "So..."
    L "Итак..."

# game/Story03.rpy:1294
translate russian akt3chapter1_3_9a9a8b6c:

    # L "How do we even begin after all this time?"
    L "С чего нам вообще начать после стольких лет?"

# game/Story03.rpy:1295
translate russian akt3chapter1_3_5c13ec43:

    # L "Careful."
    L "Осторожнее."

# game/Story03.rpy:1297
translate russian akt3chapter1_3_9a41363d:

    # L "I missed you enough already."
    L "Я и так слишком по тебе скучала."

# game/Story03.rpy:1299
translate russian akt3chapter1_3_0ac14cc8:

    # mc "Wouldn’t be the first time."
    mc "Не впервой."

# game/Story03.rpy:1302
translate russian akt3chapter1_3_fca52711:

    # mc "No."
    mc "Нет."

# game/Story03.rpy:1304
translate russian akt3chapter1_3_88f754ea:

    # mc "I just know you."
    mc "Я просто тебя знаю."

# game/Story03.rpy:1311
translate russian akt3chapter1_3_5ec9adcd:

    # L "(Those eyes...)"
    L "(Эти глаза...)"

# game/Story03.rpy:1313
translate russian akt3chapter1_3_22bb8e2b:

    # L "(I thought I’d never see them look at me like that again.)"
    L "(Я думала, они уже никогда не посмотрят на меня так.)"

# game/Story03.rpy:1324
translate russian akt3chapter1_3_707911a9:

    # L "You don’t know how many nights I wished for this..."
    L "Ты не знаешь, сколько ночей я мечтала об этом..."

# game/Story03.rpy:1325
translate russian akt3chapter1_3_d70953bf:

    # mc "This?"
    mc "Об этом?"

# game/Story03.rpy:1326
translate russian akt3chapter1_3_43a77fd3:

    # L "Still teasing me?"
    L "Все еще дразнишь?"

# game/Story03.rpy:1327
translate russian akt3chapter1_3_70358391:

    # L "(Good...)"
    L "(Хорошо...)"

# game/Story03.rpy:1329
translate russian akt3chapter1_3_268918ae:

    # L "(He still sounds like himself.)"
    L "(Он все еще звучит как он.)"

# game/Story03.rpy:1331
translate russian akt3chapter1_3_850d4f1e:

    # mc "Thought this conversation would go differently."
    mc "Думал, этот разговор пойдет иначе."

# game/Story03.rpy:1334
translate russian akt3chapter1_3_80f03c5a:

    # mc "Still couldn’t help myself."
    mc "Но все равно не удержался."

# game/Story03.rpy:1342
translate russian akt3chapter1_3_5c13ec43_1:

    # L "Careful."
    L "Осторожнее."

# game/Story03.rpy:1344
translate russian akt3chapter1_3_305bfffe:

    # L "(Don’t disappear again...)"
    L "(Не исчезай снова...)"

# game/Story03.rpy:1345
translate russian akt3chapter1_3_b00f9937:

    # L "You keep talking like that..."
    L "Если продолжишь так говорить..."

# game/Story03.rpy:1346
translate russian akt3chapter1_3_d94cefc3:

    # L "...and I might start believing you."
    L "...я ведь могу начать тебе верить."

# game/Story03.rpy:1347
translate russian akt3chapter1_3_73d05893:

    # mc "...You okay?"
    mc "...Ты в порядке?"

# game/Story03.rpy:1354
translate russian akt3chapter1_3_7f077ce1:

    # mc "Feels different?"
    mc "Ощущается иначе?"

# game/Story03.rpy:1355
translate russian akt3chapter1_3_76155097:

    # L "(Warm...)"
    L "(Тепло...)"

# game/Story03.rpy:1356
translate russian akt3chapter1_3_eea349f7:

    # L "(I almost forgot what this felt like.)"
    L "(Я почти забыла, каково это.)"

# game/Story03.rpy:1357
translate russian akt3chapter1_3_343ac107:

    # L "(If this is a dream… don’t wake me.)"
    L "(Если это сон... не будите меня.)"

# game/Story03.rpy:1358
translate russian akt3chapter1_3_c47e6076:

    # mc "(…She’s still here.)"
    mc "(...Она все еще здесь.)"

# game/Story03.rpy:1360
translate russian akt3chapter1_3_64114a64:

    # mc "(Not gone. Not yet.)"
    mc "(Не исчезла. Пока нет.)"

# game/Story03.rpy:1362
translate russian akt3chapter1_3_76c99569:

    # mc "…Don’t disappear again."
    mc "...Не исчезай снова."

# game/Story03.rpy:1365
translate russian akt3chapter1_3_59812da5:

    # L "(I’ll try…)"
    L "(Я постараюсь...)"

# game/Story03.rpy:1385
translate russian akt3chapter1_3_12b46ce9:

    # L "(Just a little longer…)"
    L "(Еще совсем немного...)"

# game/Story03.rpy:1387
translate russian akt3chapter1_3_7dcc798e_1:

    # L "Take off the uniform. I’ll find you something dry."
    L "Сними форму. Я найду тебе что-нибудь сухое."

# game/Story03.rpy:1389
translate russian akt3chapter1_3_095a783f:

    # mc "I think I’ll take a shower."
    mc "Думаю, я сначала приму душ."

# game/Story03.rpy:1401
translate russian akt3chapter1_3_5c413788:

    # L "...sure."
    L "...конечно."

# game/Story03.rpy:1405
translate russian akt3chapter1_3_f03fe041:

    # L "There it is again, that look. Stop it, [mc]."
    L "Вот опять этот взгляд. Не надо, [mc]."

# game/Story03.rpy:1406
translate russian akt3chapter1_3_b5e51c97:

    # L "For once, just let go."
    L "Хоть раз просто отпусти."

# game/Story03.rpy:1408
translate russian akt3chapter1_3_73158ab7:

    # L "Even for a moment."
    L "Хотя бы на мгновение."

# game/Story03.rpy:1409
translate russian akt3chapter1_3_351b7eaf:

    # mc "I can’t... It’s too much."
    mc "Не могу... Слишком много всего."

# game/Story03.rpy:1410
translate russian akt3chapter1_3_1e27fb48:

    # mc "Too complicated."
    mc "Слишком сложно."

# game/Story03.rpy:1416
translate russian akt3chapter1_3_7f0caa32:

    # mc "So... what happened to you?"
    mc "Так... что с тобой случилось?"

# game/Story03.rpy:1418
translate russian akt3chapter1_3_fff7e047:

    # L "In short? I know things I shouldn’t."
    L "Если коротко? Я знаю то, чего знать не должна."

# game/Story03.rpy:1420
translate russian akt3chapter1_3_3f9df27f_1:

    # mc "...What?"
    mc "...Что?"

# game/Story03.rpy:1421
translate russian akt3chapter1_3_f67cb3fb:

    # L "The truth."
    L "Правду."

# game/Story03.rpy:1423
translate russian akt3chapter1_3_ec1c09e7:

    # L "Or… part of it."
    L "Или... ее часть."

# game/Story03.rpy:1424
translate russian akt3chapter1_3_c4b75d84:

    # mc "And I’m supposed to just live with that?"
    mc "И я должен просто жить с этим?"

# game/Story03.rpy:1425
translate russian akt3chapter1_3_b7d8e078:

    # L "...Sorry."
    L "...Прости."

# game/Story03.rpy:1426
translate russian akt3chapter1_3_c5d62c3a:

    # L "I can’t explain it properly yet."
    L "Я пока не могу объяснить как следует."

# game/Story03.rpy:1428
translate russian akt3chapter1_3_c9bf13af:

    # mc "The gate. This is about the gate, isn’t it?"
    mc "Врата. Это связано с Вратами, да?"

# game/Story03.rpy:1431
translate russian akt3chapter1_3_d4e6c18c:

    # L "...Yeah."
    L "...Да."

# game/Story03.rpy:1432
translate russian akt3chapter1_3_ffe42956:

    # mc "What I heard before..."
    mc "То, что я слышал раньше..."

# game/Story03.rpy:1433
translate russian akt3chapter1_3_b8cc4033:

    # mc "You saw me die, didn’t you?"
    mc "Ты видела, как я умираю, да?"

# game/Story03.rpy:1437
translate russian akt3chapter1_3_9bb690ed:

    # L "Let’s just..."
    L "Давай просто..."

# game/Story03.rpy:1439
translate russian akt3chapter1_3_170cfc61:

    # L "Enjoy this moment a little longer."
    L "побудем в этом мгновении еще немного."

# game/Story03.rpy:1443
translate russian akt3chapter1_3_5552bbc4:

    # mc "Avoiding it again?"
    mc "Опять уходишь от ответа?"

# game/Story03.rpy:1447
translate russian akt3chapter1_3_09406ff7:

    # L "Please."
    L "Пожалуйста."

# game/Story03.rpy:1448
translate russian akt3chapter1_3_86d75e27:

    # L "I’ll explain... Just not now."
    L "Я объясню... Просто не сейчас."

# game/Story03.rpy:1451
translate russian akt3chapter1_3_46543b5c:

    # L "Okay?"
    L "Хорошо?"

# game/Story03.rpy:1458
translate russian akt3chapter1_3_f201598b:

    # L "Come here."
    L "Иди сюда."

# game/Story03.rpy:1460
translate russian akt3chapter1_3_0eb1bd99:

    # L "Let me forget about all of this for a while."
    L "Позволь мне ненадолго обо всем забыть."

# game/Story03.rpy:1470
translate russian akt3chapter1_3_d7bee0bd:

    # L "God... I missed you."
    L "Боже... я так скучала."

# game/Story03.rpy:1471
translate russian akt3chapter1_3_d12ded33:

    # mc "You’re different tonight..."
    mc "Сегодня ты другая..."

# game/Story03.rpy:1473
translate russian akt3chapter1_3_742c0d49:

    # L "I’m trying not to think."
    L "Я стараюсь не думать."

# game/Story03.rpy:1475
translate russian akt3chapter1_3_1b738645:

    # L "You still look at me like I’m me."
    L "Ты все еще смотришь на меня так, будто я - это я."

# game/Story03.rpy:1476
translate russian akt3chapter1_3_bf45bc7a:

    # L "Even now..."
    L "Даже сейчас..."

# game/Story03.rpy:1478
translate russian akt3chapter1_3_bc1b572a:

    # L "you still let your guard down around me."
    L "рядом со мной ты все еще опускаешь защиту."

# game/Story03.rpy:1480
translate russian akt3chapter1_3_a40c1e32:

    # L "Even now... you still trust me."
    L "Даже сейчас... ты все еще мне доверяешь."

# game/Story03.rpy:1482
translate russian akt3chapter1_3_70b11ee7:

    # mc "I’m trying to."
    mc "Я пытаюсь."

# game/Story03.rpy:1491
translate russian akt3chapter1_3_65e77a79:

    # mc "You always knew exactly what to do."
    mc "Ты всегда точно знала, что делать."

# game/Story03.rpy:1492
translate russian akt3chapter1_3_55aeb35c:

    # L "...No."
    L "...Нет."

# game/Story03.rpy:1494
translate russian akt3chapter1_3_935b2046:

    # L "I was terrified of losing it."
    L "Я просто до ужаса боялась все это потерять."

# game/Story03.rpy:1495
translate russian akt3chapter1_3_6f887114:

    # mc "Then stop thinking."
    mc "Тогда перестань думать."

# game/Story03.rpy:1497
translate russian akt3chapter1_3_d0ee8d4c:

    # mc "Just be here with me."
    mc "Просто будь здесь. Со мной."

# game/Story03.rpy:1498
translate russian akt3chapter1_3_6411bb44:

    # L "Careful..."
    L "Осторожнее..."

# game/Story03.rpy:1499
translate russian akt3chapter1_3_e55e5833:

    # L "I still know all your weak spots."
    L "Я все еще помню все твои слабые места."

# game/Story03.rpy:1507
translate russian akt3chapter1_3_83f2c02c:

    # mc "You already do."
    mc "Ты и так их знаешь."

# game/Story03.rpy:1509
translate russian akt3chapter1_3_bf3d67aa:

    # mc "Still resisting?"
    mc "Все еще сопротивляешься?"

# game/Story03.rpy:1512
translate russian akt3chapter1_3_49816fbb:

    # mc "You can stop anytime."
    mc "Можешь остановиться в любой момент."

# game/Story03.rpy:1513
translate russian akt3chapter1_3_2653b46c:

    # L "No."
    L "Нет."

# game/Story03.rpy:1514
translate russian akt3chapter1_3_eb60968a:

    # L "Not yet."
    L "Еще нет."

# game/Story03.rpy:1528
translate russian akt3chapter1_3_234a62b4:

    # L "…I missed this version of us."
    L "...Я скучала по таким нам."

# game/Story03.rpy:1530
translate russian akt3chapter1_3_74fc6761:

    # mc "Me too."
    mc "Я тоже."

# game/Story03.rpy:1540
translate russian akt3chapter1_3_c2f2ade4:

    # mc "Good night, Lora."
    mc "Спокойной ночи, Лора."

# game/Story03.rpy:1612
translate russian akt3chapter1_4_be8f1a89:

    # L "I'm sorry..."
    L "Прости..."

# game/Story03.rpy:1614
translate russian akt3chapter1_4_65c425c5:

    # L "I pushed too far. It’s just... all of it’s been piling up."
    L "Я зашла слишком далеко. Просто... все это слишком долго копилось."

# game/Story03.rpy:1618
translate russian akt3chapter1_4_e5544801:

    # mc "I get it."
    mc "Я понимаю."

# game/Story03.rpy:1619
translate russian akt3chapter1_4_c877e2a7:

    # mc "Still... when you said you could’ve died in agony..."
    mc "Но... когда ты сказала, что могла умереть в мучениях..."

# game/Story03.rpy:1620
translate russian akt3chapter1_4_deddb069:

    # mc "What did you mean?"
    mc "Что ты имела в виду?"

# game/Story03.rpy:1628
translate russian akt3chapter1_4_7e046f79:

    # L "I’m being... hunted."
    L "На меня... охотятся."

# game/Story03.rpy:1630
translate russian akt3chapter1_4_4cad93bd:

    # mc "By who?"
    mc "Кто?"

# game/Story03.rpy:1632
translate russian akt3chapter1_4_7654d757:

    # L "Everyone. In small pieces. Humans, elves, dragons... even insects."
    L "Все. По частям. Люди, эльфы, драконы... даже насекомые."

# game/Story03.rpy:1633
translate russian akt3chapter1_4_8c39d73f:

    # L "Surprised?"
    L "Удивлен?"

# game/Story03.rpy:1635
translate russian akt3chapter1_4_fb3be0f3:

    # mc "Sounds insane. But somehow, I believe you."
    mc "Звучит безумно. Но почему-то я тебе верю."

# game/Story03.rpy:1637
translate russian akt3chapter1_4_d7fc8fe8:

    # L "As you should. The reason is simple..."
    L "И правильно. Причина простая..."

# game/Story03.rpy:1638
translate russian akt3chapter1_4_771c08dc:

    # L "I know what’s hidden in the Abyss."
    L "Я знаю, что скрыто в Бездне."

# game/Story03.rpy:1640
translate russian akt3chapter1_4_9556576d:

    # mc "That’s not enough to make people want you dead."
    mc "Этого мало, чтобы все желали тебе смерти."

# game/Story03.rpy:1642
translate russian akt3chapter1_4_c46b1f38:

    # L "I’m one of the few who can enter it."
    L "Я одна из немногих, кто может туда войти."

# game/Story03.rpy:1644
translate russian akt3chapter1_4_af38c14f:

    # mc "Now that is a different story."
    mc "А вот это уже другое дело."

# game/Story03.rpy:1646
translate russian akt3chapter1_4_fd100e5b:

    # L "And you still don’t understand..."
    L "А ты все еще не понимаешь..."

# game/Story03.rpy:1648
translate russian akt3chapter1_4_b1098a20:

    # mc "I know. But I still don’t understand."
    mc "Знаю. Но я действительно все еще не понимаю."

# game/Story03.rpy:1650
translate russian akt3chapter1_4_19e706b6:

    # L "Let me put it simply. The Abyss isn’t just another dimension. It’s... layers of broken, entangled realities."
    L "Проще говоря, Бездна - это не просто еще одно измерение. Это... слои сломанных, переплетенных реальностей."

# game/Story03.rpy:1652
translate russian akt3chapter1_4_10fc187f:

    # L "There are artifacts connected to it. They allow access."
    L "С ней связаны артефакты. Они открывают доступ."

# game/Story03.rpy:1654
translate russian akt3chapter1_4_c236f5b0:

    # L "Still following?"
    L "Пока следишь за мыслью?"

# game/Story03.rpy:1656
translate russian akt3chapter1_4_f800bed0:

    # mc "Yes."
    mc "Да."

# game/Story03.rpy:1658
translate russian akt3chapter1_4_82d9987e:

    # L "Good."
    L "Хорошо."

# game/Story03.rpy:1660
translate russian akt3chapter1_4_2872e70d:

    # L "Now the obvious question — why does everyone want in?"
    L "Теперь очевидный вопрос: почему все хотят попасть внутрь?"

# game/Story03.rpy:1661
translate russian akt3chapter1_4_78f1808f:

    # L "The answer’s simple. Immortality."
    L "Ответ простой. Бессмертие."

# game/Story03.rpy:1663
translate russian akt3chapter1_4_2b35b6fe:

    # mc "..."
    mc "..."

# game/Story03.rpy:1664
translate russian akt3chapter1_4_dce1b6b1:

    # mc "(The Abyss... Immortality... She says it like it’s just part of her daily life...)"
    mc "(Бездна... Бессмертие... Она говорит об этом так, будто это часть повседневной жизни...)"

# game/Story03.rpy:1668
translate russian akt3chapter1_4_2b35b6fe_1:

    # mc "..."
    mc "..."

# game/Story03.rpy:1669
translate russian akt3chapter1_4_c76a8629:

    # mc "I need time to process all of this."
    mc "Мне нужно время, чтобы все это переварить."

# game/Story03.rpy:1671
translate russian akt3chapter1_4_7983de73:

    # L "I understand."
    L "Я понимаю."

# game/Story03.rpy:1672
translate russian akt3chapter1_4_b62c378a:

    # L "I have to go. Take care of yourself."
    L "Мне нужно идти. Береги себя."

# game/Story03.rpy:1674
translate russian akt3chapter1_4_d21d697a:

    # mc "You too..."
    mc "Ты тоже..."

# game/Story03.rpy:1693
translate russian akt3chapter2_3a25f878:

    # mc "You some kind of guardian? If not, what’s the point?"
    mc "Ты что, какой-то страж? Если нет, тогда какой в этом смысл?"

# game/Story03.rpy:1726
translate russian akt3chapter2_5a8da413:

    # aa "You're the only one I can make a deal with."
    aa "Ты единственный, с кем я могу заключить сделку."

# game/Story03.rpy:1732
translate russian akt3chapter2_93fc239d:

    # aa "To escape this nightmare."
    aa "Чтобы выбраться из этого кошмара."

# game/Story03.rpy:1737
translate russian akt3chapter2_2f568ae9:

    # mc "Riddles again..."
    mc "Опять загадки..."

# game/Story03.rpy:1738
translate russian akt3chapter2_dce44c47:

    # mc "How about something simple, for once?"
    mc "Может, хоть раз скажешь что-нибудь нормально?"

# game/Story03.rpy:1740
translate russian akt3chapter2_5168ef46:

    # aa "You already know. You're just afraid to admit it."
    aa "Ты уже знаешь. Просто боишься признать это."

# game/Story03.rpy:1743
translate russian akt3chapter2_0040bc2e:

    # aa "Don't let them summon her."
    aa "Не дай им призвать ее."

# game/Story03.rpy:1745
translate russian akt3chapter2_aef4a0de:

    # mc "Astoria...?"
    mc "Астория...?"

# game/Story03.rpy:1748
translate russian akt3chapter2_be8c22a7:

    # aa "No."
    aa "Нет."

# game/Story03.rpy:1750
translate russian akt3chapter2_055a43e9:

    # aa "The one she loves."
    aa "Ту, кого она любит."

# game/Story03.rpy:1751
translate russian akt3chapter2_abd8dbaa:

    # mc "The gates... she's connected to them?"
    mc "Врата... она с ними связана?"

# game/Story03.rpy:1755
translate russian akt3chapter2_2cac97b3:

    # aa "You're running out of time."
    aa "У тебя заканчивается время."

# game/Story03.rpy:1762
translate russian akt3chapter2_bf81904a:

    # aa "It’s..."
    aa "Оно..."

# game/Story03.rpy:1763
translate russian akt3chapter2_fc6f8c48:

    # aa "...too fast."
    aa "...слишком быстрое."

# game/Story03.rpy:1764
translate russian akt3chapter2_2d2d002e:

    # "Sector 0: Tower."
    "Сектор 0: Башня."

# game/Story03.rpy:1773
translate russian akt3chapter2_c7d15ea4:

    # aa "And warn the elves there, tell them to run."
    aa "И предупреди эльфов там. Скажи им бежать."

# game/Story03.rpy:1800
translate russian akt3chapter2_f5f79f61:

    # "Sector 6. Blue Moon."
    "Сектор 6. Голубая луна."

# game/Story03.rpy:1819
translate russian akt3chapter2_5ac44e1f:

    # mc "My head’s splitting..."
    mc "Голова раскалывается..."

# game/Story03.rpy:1820
translate russian akt3chapter2_b7feb858:

    # mc "Did I black out?"
    mc "Я что, вырубился?"

# game/Story03.rpy:1821
translate russian akt3chapter2_29709543:

    # mc "First time in days..."
    mc "Впервые за несколько дней..."

# game/Story03.rpy:1823
translate russian akt3chapter2_60735426:

    # mc "(And for what?)"
    mc "(И ради чего?)"

# game/Story03.rpy:1824
translate russian akt3chapter2_a857f184:

    # mc "(Feel like I got run over.)"
    mc "(Такое чувство, будто меня переехали.)"

# game/Story03.rpy:1826
translate russian akt3chapter2_81362217:

    # mc "(These dreams...)"
    mc "(Эти сны...)"

# game/Story03.rpy:1828
translate russian akt3chapter2_8b9ee863:

    # mc "Enough."
    mc "Хватит."

# game/Story03.rpy:1829
translate russian akt3chapter2_2562ad6f:

    # mc "Move."
    mc "Двигайся."

# game/Story03.rpy:1831
translate russian akt3chapter2_03367861:

    # mc "(Need to find the others.)"
    mc "(Нужно найти остальных.)"

# game/Story03.rpy:1832
translate russian akt3chapter2_494c55b7:

    # mc "(Before they kill each other.)"
    mc "(Пока они не перебили друг друга.)"

# game/Story03.rpy:1834
translate russian akt3chapter2_adfb2742:

    # mc "(Especially Olivia... Kalestra... Lora.)"
    mc "(Особенно Оливию... Калестру... Лору.)"

# game/Story03.rpy:1836
translate russian akt3chapter2_ef13739c:

    # mc "Left. Right."
    mc "Налево. Направо."

# game/Story03.rpy:1841
translate russian akt3chapter2_4078dcd2:

    # mc "Doesn’t matter."
    mc "Без разницы."

# game/Story03.rpy:1847
translate russian akt3chapter2_b8e13fb0:

    # mc "(Bare metal.)"
    mc "(Голый металл.)"

# game/Story03.rpy:1848
translate russian akt3chapter2_7d39ec26:

    # mc "(No people. Nothing.)"
    mc "(Ни людей. Ничего.)"

# game/Story03.rpy:1851
translate russian akt3chapter2_9914f789:

    # mc "(Every step echoes.)"
    mc "(Каждый шаг отдается эхом.)"

# game/Story03.rpy:1852
translate russian akt3chapter2_7c3920c7:

    # mc "(If someone’s here, they already heard me.)"
    mc "(Если здесь кто-то есть, меня уже услышали.)"

# game/Story03.rpy:1855
translate russian akt3chapter2_3ad15b1a:

    # mc "(Good.)"
    mc "(Хорошо.)"

# game/Story03.rpy:1856
translate russian akt3chapter2_36dd2701:

    # mc "(Silence is worse.)"
    mc "(Тишина хуже.)"

# game/Story03.rpy:1858
translate russian akt3chapter2_5eec69e5:

    # mc "Endless damn corridors..."
    mc "Бесконечные чертовы коридоры..."

# game/Story03.rpy:1860
translate russian akt3chapter2_f711ae47:

    # mc "(Should I call out...?)"
    mc "(Позвать кого-нибудь...?)"

# game/Story03.rpy:1862
translate russian akt3chapter2_78f33f44:

    # mc "(Quiet as a graveyard.)"
    mc "(Тихо, как на кладбище.)"

# game/Story03.rpy:1865
translate russian akt3chapter2_8a6b32bf:

    # mc "Might as well sing."
    mc "С тем же успехом можно запеть."

# game/Story03.rpy:1870
translate russian akt3chapter2_a55ee5f5:

    # mc "(Too much happened too fast.)"
    mc "(Слишком многое случилось слишком быстро.)"

# game/Story03.rpy:1877
translate russian akt3chapter2_a43d473c:

    # mc "(…Wait.)"
    mc "(...Погоди.)"

# game/Story03.rpy:1882
translate russian akt3chapter2_b9b63a11:

    # mc "(Not one person...)"
    mc "(Ни одного человека...)"

# game/Story03.rpy:1890
translate russian akt3chapter2_0b2f90a6:

    # mc "(A dream?)"
    mc "(Сон?)"

# game/Story03.rpy:1898
translate russian akt3chapter2_699878f6:

    # mc "Hey!"
    mc "Эй!"

# game/Story03.rpy:1899
translate russian akt3chapter2_0cb0755e:

    # mc "Anyone here?!"
    mc "Здесь есть кто-нибудь?!"

# game/Story03.rpy:1900
translate russian akt3chapter2_fdaa1d8c:

    # mc "Lora?! Olivia?!"
    mc "Лора?! Оливия?!"

# game/Story03.rpy:1901
translate russian akt3chapter2_7f7cc56b:

    # mc "Answer me!"
    mc "Ответьте мне!"

# game/Story03.rpy:1908
translate russian akt3chapter2_8a3197bb:

    # mc "(whispering) What the hell happened here?"
    mc "(шепотом) Что здесь, черт возьми, произошло?"

# game/Story03.rpy:1917
translate russian akt3chapter2_b4dff877:

    # mc "(whispering) Who found out?"
    mc "(шепотом) Кто узнал?"

# game/Story03.rpy:1923
translate russian akt3chapter2_b699af18:

    # mc "Where is everyone?"
    mc "Где все?"

# game/Story03.rpy:1932
translate russian akt3chapter2_b83a40f9:

    # mc "(Good enough.)"
    mc "(Сойдет.)"

# game/Story03.rpy:1947
translate russian akt3chapter2_fb364877:

    # mc "Lead."
    mc "Веди."

# game/Story03.rpy:1951
