translate russian akt3chapter5_2_d561ad9d:

    # mc "You already have. You’re just too proud to say it."
    mc "Ты уже сдалась. Просто ты слишком гордая, чтобы признать это."

# game/Story03.rpy:6267
translate russian akt3chapter5_2_51fb6e7a:

    # h "Tch... You arrogant...!"
    h "Тц... Ты высокомерный...!"

# game/Story03.rpy:6268
translate russian akt3chapter5_2_b94dd734:

    # h "Fine. Then stop talking—"
    h "Ладно. Тогда перестань говорить..."

# game/Story03.rpy:6269
translate russian akt3chapter5_2_610d06f4:

    # h "And *show* me."
    h "И {b}покажи{/b} мне."

# game/Story03.rpy:6270
translate russian akt3chapter5_2_a505cedb:

    # mc "Heh. Don’t say I didn’t warn you."
    mc "Хех. Не говори, что я тебя не предупреждал."

# game/Story03.rpy:6271
translate russian akt3chapter5_2_0d712ebc:

    # h "Bring it on."
    h "Продолжай."

# game/Story03.rpy:6272
translate russian akt3chapter5_2_1fa32e70:

    # mc "(She’s fire and thorns... but even fire can melt.)"
    mc "(Она как пламя и шипы... но даже пламя можно растопить.)"

# game/Story03.rpy:6273
translate russian akt3chapter5_2_1f664adf:

    # h "(I hate how much I want this... How much I want *him.*)"
    h "(Я ненавижу, как сильно я этого хочу... Как сильно я хочу {b}его{/b}.)"

# game/Story03.rpy:6274
translate russian akt3chapter5_2_18a36f72:

    # mc "Still think you’re in charge?"
    mc "Всё ещё думаешь, что ты главная?"

# game/Story03.rpy:6275
translate russian akt3chapter5_2_ce6ef817:

    # h "No. But I know how to take it back."
    h "Нет. Но я знаю, как вернуть контроль."

