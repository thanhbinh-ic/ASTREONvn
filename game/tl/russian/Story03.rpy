    mc "Давай, осталось немного."

# game/Story03.rpy:2288
translate russian akt3chapter2_682e89fa:

    # mc "Next!"
    mc "Следующий!"

# game/Story03.rpy:2290
translate russian akt3chapter2_07688819:

