translate russian act3_5chapter1_1648d5a4:

    # mc "(Crazy. Definitely.)"
    mc "(Сумасшедшая. Определённо.)"

# game/Story03.rpy:6832
translate russian act3_5chapter1_8ca36d9e:

    # k "Don't call me crazy right away. Just… different."
    k "Не называй меня сразу сумасшедшей. Просто... другой."

# game/Story03.rpy:6834
translate russian act3_5chapter1_6d26a197:

    # mc "Fine. Different. Be that way."
    mc "Ладно. Другая. Будь такой."

# game/Story03.rpy:6839
translate russian act3_5chapter1_82091822_4:

    # k "..."
    k "..."

