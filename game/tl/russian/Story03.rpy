    # L "..."
    L "..."

# game/Story03.rpy:1367
translate russian akt3chapter1_3_a53903be:

    # L "Don’t overload yourself. I’ll explain... Just not now, okay?"
    L "Не перегружай себя. Я всё расскажу... Но не сейчас, ладно?"

# game/Story03.rpy:1368
translate russian akt3chapter1_3_e98bda8e:

    # L "Better tell me this instead..."
    L "Лучше скажи мне..."

# game/Story03.rpy:1369
translate russian akt3chapter1_3_99ac0c90:

    # L "Ready for round two?"
    L "Готов ко второму раунду?"

# game/Story03.rpy:1372
translate russian akt3chapter1_3_e2651856:

    # mc "You’re insatiable..."
    mc "Ты ненасытная..."

# game/Story03.rpy:1376
translate russian akt3chapter1_3_9ca62a69:

    # mc "Please, be gentler with me."
    mc "Прошу, будь со мной нежнее."

# game/Story03.rpy:1378
translate russian akt3chapter1_3_db5cb18a:

    # L "Time to wash her filth off you."
    L "Пора бы смыть с тебя её грязь."

# game/Story03.rpy:1380
translate russian akt3chapter1_3_2b35b6fe_23:

    # mc "..."
    mc "..."

# game/Story03.rpy:1381
translate russian akt3chapter1_3_55951dd8:

    # mc "Oh... What are you—"
    mc "Оу... О чём ты-"

# game/Story03.rpy:1383
translate russian akt3chapter1_3_26b99e20:

    # L "Just thinking out loud."
    L "Просто мысли вслух."

# game/Story03.rpy:1387
translate russian akt3chapter1_3_f88cce26:

    # L "This feels so good..."
    L "Как же хорошо..."

# game/Story03.rpy:1390
translate russian akt3chapter1_3_20fd7990:

    # mc "You're... like a beast, Lora."
    mc "Ты... словно зверь, Лора."

# game/Story03.rpy:1391
translate russian akt3chapter1_3_6dc18362:

    # L "Didn’t you know? I’ve always been a predator."
    L "Разве ты не знал? Я всегда была хищницей."

# game/Story03.rpy:1392
translate russian akt3chapter1_3_08b7d9e3:

    # mc "Then why don’t I feel afraid?"
    mc "Тогда почему я не чувствую страха?"

# game/Story03.rpy:1393
translate russian akt3chapter1_3_49376366:

    # L "Because you’re mine."
    L "Потому что ты мой."

# game/Story03.rpy:1394
translate russian akt3chapter1_3_22c294ca:

    # L "You can fight. You can try to take control..."
    L "Ты можешь бороться. Можешь пытаться доминировать..."

# game/Story03.rpy:1395
translate russian akt3chapter1_3_c63bcd1a:

    # L "But in the end, you’ll still end up beneath me."
    L "Но в конце концов, ты всё равно окажешься подо мной."

# game/Story03.rpy:1396
translate russian akt3chapter1_3_cca9e975:

    # mc "I doubt that part."
    mc "В последнем я сомневаюсь."

# game/Story03.rpy:1397
translate russian akt3chapter1_3_096e26d8:

    # L "What?"
    L "Что?"

# game/Story03.rpy:1404
translate russian akt3chapter1_3_2455437c:

    # mc "You thought you’d always have control over me, didn’t you?"
    mc "Ты думала, что всегда будешь контролировать меня, да?"

# game/Story03.rpy:1405
translate russian akt3chapter1_3_b82d93cf:

    # L "Was I wrong?"
    L "Я ошибалась?"

# game/Story03.rpy:1406
translate russian akt3chapter1_3_a36766c6:

    # mc "Not today. It’s time I showed you what bliss feels like."
    mc "Не сегодня. Пришло время показать тебе, что такое блаженство."

# game/Story03.rpy:1407
translate russian akt3chapter1_3_d5e8c7c9:

    # mc "All I need from you — is consent."
    mc "Всё, что мне от тебя нужно, - это согласие."

# game/Story03.rpy:1408
translate russian akt3chapter1_3_e5542914:

    # L "And if I don’t want to give in?"
    L "А если я не хочу сдаваться?"

# game/Story03.rpy:1409
translate russian akt3chapter1_3_658cd16a:

    # mc "Then I’ll make you want to."
    mc "Тогда я заставлю тебя захотеть."

# game/Story03.rpy:1410
translate russian akt3chapter1_3_be13bc8f:

    # L "Is that all you’ve got?"
    L "Это всё, на что ты способен?"

# game/Story03.rpy:1418
translate russian akt3chapter1_3_583c9f0d:

    # L "UGHH♥"
    L "УГХХ{font=tl/russian/fonts/Symbola.ttf}♥{/font}"

# game/Story03.rpy:1419
translate russian akt3chapter1_3_ea1c6be7:

    # mc "So? Changed your mind yet?"
    mc "Ну что? Передумала?"

# game/Story03.rpy:1420
translate russian akt3chapter1_3_1d7016ef:

    # L "UGHHHHH♥"
    L "УГХХХХХ{font=tl/russian/fonts/Symbola.ttf}♥{/font}"

# game/Story03.rpy:1421
translate russian akt3chapter1_3_78741f58:

    # L "I... I can still resist..."
    L "Я... Я всё ещё могу сопротивляться..."

# game/Story03.rpy:1422
translate russian akt3chapter1_3_a32db2f7:

    # mc "No, you can’t. Not anymore."
    mc "Нет, не можешь. Больше не можешь."

# game/Story03.rpy:1423
translate russian akt3chapter1_3_daa40ee2:

    # L "MHM♥♥...."
    L "МХМ{font=tl/russian/fonts/Symbola.ttf}♥{/font}{font=tl/russian/fonts/Symbola.ttf}♥{/font}"

# game/Story03.rpy:1436
translate russian akt3chapter1_3_86c49c13:

    # L "You know, you were almost unbearable tonight..."
    L "Знаешь, ты сегодня был почти невыносим..."

# game/Story03.rpy:1437
translate russian akt3chapter1_3_6a9d5b6e:

    # mc "Only tonight?"
    mc "Только сегодня?"

# game/Story03.rpy:1438
translate russian akt3chapter1_3_b55ad727:

    # L "Yeah, just tonight. Good night, darling."
    L "Ага, только сегодня. Спокойной ночи, дорогой."

# game/Story03.rpy:1439
translate russian akt3chapter1_3_00274b47:

    # mc "Yeah. Good night."
    mc "Да, спокойной ночи."

# game/Story03.rpy:1448
translate russian akt3chapter1_3_be8f1a89:

    # L "I'm sorry..."
    L "Прости..."

# game/Story03.rpy:1449
translate russian akt3chapter1_3_65c425c5:

    # L "I pushed too far. It’s just... all of it’s been piling up."
    L "Я немного перегнула. Просто... всё это накопилось."

# game/Story03.rpy:1453
translate russian akt3chapter1_3_e5544801:

    # mc "I get it."
    mc "Я понимаю."

# game/Story03.rpy:1454
translate russian akt3chapter1_3_c877e2a7:

    # mc "Still... when you said you could’ve died in agony..."
    mc "Но всё же... Когда ты сказала, что могла умереть в мучениях..."

# game/Story03.rpy:1455
translate russian akt3chapter1_3_deddb069:

    # mc "What did you mean?"
    mc "Что ты имела в виду?"

# game/Story03.rpy:1463
translate russian akt3chapter1_3_7e046f79:

    # L "I’m being... hunted."
    L "За мной... охотятся."

# game/Story03.rpy:1465
translate russian akt3chapter1_3_4cad93bd:

    # mc "By who?"
    mc "Кто?"

# game/Story03.rpy:1467
translate russian akt3chapter1_3_7654d757:

    # L "Everyone. In small pieces. Humans, elves, dragons... even insects."
    L "Все. По чуть-чуть. Люди, эльфы, драконы... даже насекомые."

# game/Story03.rpy:1468
translate russian akt3chapter1_3_8c39d73f:

    # L "Surprised?"
    L "Удивлён?"

# game/Story03.rpy:1470
translate russian akt3chapter1_3_fb3be0f3:

    # mc "Sounds insane. But somehow, I believe you."
    mc "Звучит безумно. Но почему-то я тебе верю."

# game/Story03.rpy:1472
translate russian akt3chapter1_3_d7fc8fe8:

    # L "As you should. The reason is simple..."
    L "И это правильно. Причина проста..."

# game/Story03.rpy:1473
translate russian akt3chapter1_3_771c08dc:

    # L "I know what’s hidden in the Abyss."
    L "Я знаю, что скрыто в Бездне."

# game/Story03.rpy:1475
translate russian akt3chapter1_3_9556576d:

    # mc "That’s not enough to make people want you dead."
    mc "Этого мало, чтобы желать тебе смерти."

# game/Story03.rpy:1477
translate russian akt3chapter1_3_c46b1f38_1:

    # L "I’m one of the few who can enter it."
    L "Я одна из немногих, кто может туда войти."

# game/Story03.rpy:1479
translate russian akt3chapter1_3_af38c14f:

    # mc "Now that is a different story."
    mc "Это уже другая история."

# game/Story03.rpy:1481
translate russian akt3chapter1_3_fd100e5b:

    # L "And you still don’t understand..."
    L "И ты всё ещё не понимаешь..."

# game/Story03.rpy:1483
translate russian akt3chapter1_3_b1098a20:

    # mc "I know. But I still don’t understand."
    mc "Знаю. Но всё ещё не понимаю."

# game/Story03.rpy:1485
translate russian akt3chapter1_3_19e706b6:

    # L "Let me put it simply. The Abyss isn’t just another dimension. It’s... layers of broken, entangled realities."
    L "Попробую объяснить просто. Бездна — это не просто другое измерение. Это... слои разбитых, переплетённых реальностей."

# game/Story03.rpy:1487
translate russian akt3chapter1_3_10fc187f:

    # L "There are artifacts connected to it. They allow access."
    L "С ней связаны артефакты. Они позволяют туда войти."

# game/Story03.rpy:1489
translate russian akt3chapter1_3_c236f5b0:

    # L "Still following?"
    L "Пока всё понятно?"

# game/Story03.rpy:1491
translate russian akt3chapter1_3_f800bed0_1:

    # mc "Yes."
    mc "Да."

# game/Story03.rpy:1493
translate russian akt3chapter1_3_82d9987e:

    # L "Good."
    L "Славненько."

# game/Story03.rpy:1495
translate russian akt3chapter1_3_2872e70d_1:

    # L "Now the obvious question — why does everyone want in?"
    L "Теперь очевидный вопрос - почему все хотят туда попасть?"

# game/Story03.rpy:1496
translate russian akt3chapter1_3_78f1808f:

    # L "The answer’s simple. Immortality."
    L "Ответ прост. Бессмертие."

# game/Story03.rpy:1498
translate russian akt3chapter1_3_2b35b6fe_24:

    # mc "..."
    mc "..."

# game/Story03.rpy:1499
translate russian akt3chapter1_3_dce1b6b1:

    # mc "(The Abyss... Immortality... She says it like it’s just part of her daily life...)"
    mc "(Бездна... Бессмертие... Она говорит об этом, как будто это часть её повседневной жизни...)"

# game/Story03.rpy:1503
translate russian akt3chapter1_3_2b35b6fe_25:

    # mc "..."
    mc "..."

# game/Story03.rpy:1504
translate russian akt3chapter1_3_c76a8629:

    # mc "I need time to process all of this."
    mc "Мне нужно время, чтобы всё это переварить."

# game/Story03.rpy:1506
translate russian akt3chapter1_3_7983de73:

    # L "I understand."
    L "Я понимаю."

# game/Story03.rpy:1507
translate russian akt3chapter1_3_b62c378a:

    # L "I have to go. Take care of yourself."
    L "Мне нужно идти. Береги себя."

# game/Story03.rpy:1509
translate russian akt3chapter1_3_d21d697a:

    # mc "You too..."
    mc "Ты тоже..."

# game/Story03.rpy:1514
translate russian akt3chapter1_3_b97e0f40:

    # mc "You knew... You knew what I’d have to go through, and you still left."
    mc "Ты знала... Знала, через что мне придётся пройти, и всё равно ушла."

# game/Story03.rpy:1516
translate russian akt3chapter1_3_cc95c78e:

    # mc "Why didn’t you come back?.. Why didn’t you just come back..."
    mc "Почему ты не вернулась? Почему ты просто не вернулась..."

# game/Story03.rpy:1518
translate russian akt3chapter1_3_4995dfdd:

    # L "If I had returned... it would’ve been over. {w}Not just for me — for you, for everyone."
    L "Если бы я вернулась... всё было бы кончено. {w}Не только для меня — для тебя, для остальных."

# game/Story03.rpy:1520
translate russian akt3chapter1_3_f7ebaa2a:

    # mc "You could’ve said something. Anything..."
    mc "Ты могла сказать. Хотя бы что-то..."

# game/Story03.rpy:1524
translate russian akt3chapter1_3_4d6b660e:

    # L "And what would you have done? Chased after me? Died?"
    L "И что бы ты сделал? Побежал бы за мной? Погиб?"

# game/Story03.rpy:1525
translate russian akt3chapter1_3_c1e4d97f:

    # L "I made a choice. {w}Not because I wanted to — because I had to."
    L "Я сделала выбор. {w}Не потому, что хотела, а потому, что была должна."

# game/Story03.rpy:1529
translate russian akt3chapter1_3_2b35b6fe_26:

    # mc "..."
    mc "..."

# game/Story03.rpy:1531
translate russian akt3chapter1_3_3ca835df:

    # mc "Sometimes... even a conscious choice feels like betrayal."
    mc "Иногда... даже осознанный выбор кажется предательством."

# game/Story03.rpy:1534
translate russian akt3chapter1_3_e932fe52:

    # L "...I know."
    L "...Я знаю."

# game/Story03.rpy:1536
translate russian akt3chapter1_3_8dac49a4:

    # mc "What hurts the most isn’t that you left. It’s that you didn’t give me a chance... not even a goodbye."
    mc "Больше всего ранит не то, что ты ушла. А то, что ты не дала мне шанса... даже попрощаться."

# game/Story03.rpy:1544
translate russian akt3chapter1_3_9413ff51:

    # L "I said goodbye in my mind every single night. {w}But that’s not enough, is it?"
    L "Я каждую ночь мысленно прощалась с тобой. {w}Но этого недостаточно, верно?"

# game/Story03.rpy:1546
translate russian akt3chapter1_3_fd22e77e:

    # mc "...No."
    mc "...Нет."

# game/Story03.rpy:1550
translate russian akt3chapter1_3_5b83c1c2:

    # mc "But maybe now — this is that chance."
    mc "Но, может, сейчас - это тот самый шанс."

# game/Story03.rpy:1554
translate russian akt3chapter1_3_1e5e9894:

    # L "You still see me as human?"
    L "Ты по-прежнему видишь во мне человека?"

# game/Story03.rpy:1556
translate russian akt3chapter1_3_ace0ebe5:

    # mc "I see you. With all your secrets, your fears, and yes — your choices."
    mc "Я вижу тебя. Со всеми твоими тайнами, страхами и, да, твоими выборами."

# game/Story03.rpy:1557
translate russian akt3chapter1_3_c752b179:

    # mc "That doesn’t make you less human. Just... more complex."
    mc "Это не делает тебя менее человечной. Просто... более сложной."

# game/Story03.rpy:1559
translate russian akt3chapter1_3_a6d516ca:

    # L "That’s enough."
    L "Этого достаточно."

# game/Story03.rpy:1562
translate russian akt3chapter1_3_62b2fe6e:

    # mc "Now tell me what really happened."
    mc "Теперь расскажи мне, что на самом деле произошло."

# game/Story03.rpy:1564
translate russian akt3chapter1_3_86d3e86c:

    # L "How to put this..."
    L "Как бы это сказать..."

# game/Story03.rpy:1565
translate russian akt3chapter1_3_6dd79c2a:

    # L "I’m a key."
    L "Я ключ."

# game/Story03.rpy:1567
translate russian akt3chapter1_3_daa752da:

    # mc "A key?"
    mc "Ключ?"

# game/Story03.rpy:1568
translate russian akt3chapter1_3_e5221b65:

    # mc "Wait... a key to what? Is that a metaphor or literal?"
    mc "Погоди... Ключ от чего? Это какая-то метафора или ты буквально?"

# game/Story03.rpy:1570
translate russian akt3chapter1_3_aad85c44:

    # L "Both..."
    L "И то, и другое..."

# game/Story03.rpy:1571
translate russian akt3chapter1_3_6f953e2d:

    # L "The portal I activated — it didn’t just happen. It responded to me."
    L "Врата, которые я активировала, открылись не просто так. Они откликнулись на меня."

# game/Story03.rpy:1573
translate russian akt3chapter1_3_2b35b6fe_27:

    # mc "..."
    mc "..."

# game/Story03.rpy:1575
translate russian akt3chapter1_3_dcdac633:

    # L "Wait, you do know about it, right?"
    L "Подожди, ты же знаешь об этом, верно?"

# game/Story03.rpy:1577
translate russian akt3chapter1_3_cf1adef2:

    # mc "Yeah."
    mc "Да."

# game/Story03.rpy:1579
translate russian akt3chapter1_3_e9af7391:

    # L "And you still don’t get it..."
    L "И ты всё ещё не понимаешь..."

# game/Story03.rpy:1581
translate russian akt3chapter1_3_0dadb7a5:

    # mc "Honestly? Not really."
    mc "Честно? Не совсем."

# game/Story03.rpy:1583
translate russian akt3chapter1_3_10449473:

    # L "There’s the Abyss — think of it like a cluster of parallel realities. A terrifying place."
    L "Есть Бездна. Представь её как совокупность параллельных реальностей. Ужасающее место."

# game/Story03.rpy:1585
translate russian akt3chapter1_3_1dcb9dce:

    # L "There are regular people. They can’t interact with the Abyss."
    L "Есть обычные люди. Они не могут взаимодействовать с Бездной."

# game/Story03.rpy:1587
translate russian akt3chapter1_3_c6391848_1:

    # L "Still with me?"
    L "Всё ещё со мной?"

# game/Story03.rpy:1589
translate russian akt3chapter1_3_be064e5e:

    # mc "What do you mean by {b}terrifying place?{/b}"
    mc "Что ты имеешь в виду под {b}\"ужасающим местом\"{/b}?"

# game/Story03.rpy:1591
translate russian akt3chapter1_3_db01309b:

    # L "The Abyss has no shape, but it breathes. There’s no time, no logic in it."
    L "Бездна не имеет формы, но она дышит. В ней нет времени, нет логики."

# game/Story03.rpy:1592
translate russian akt3chapter1_3_b2d85ea5:

    # L "Only... warped shadows of realities. If you stare too long, you forget who you are."
    L "Только... искажённые тени реальностей. Если смотреть на неё слишком долго, ты забываешь, кто ты есть."

# game/Story03.rpy:1594
translate russian akt3chapter1_3_2b35b6fe_28:

    # mc "..."
    mc "..."

# game/Story03.rpy:1595
translate russian akt3chapter1_3_9993b94e_9:

    # L "..."
    L "..."

# game/Story03.rpy:1596
translate russian akt3chapter1_3_110db918:

    # mc "In simpler terms?"
    mc "А простым языком?"

# game/Story03.rpy:1598
translate russian akt3chapter1_3_6e3e1de9:

    # L "That was the simple version. It’s hard to explain. You’ll have to take my word."
    L "Это и была простая версия. Трудно объяснить. Тебе придётся поверить мне на слово."

# game/Story03.rpy:1600
translate russian akt3chapter1_3_6651ab87:

    # mc "Alright."
    mc "Ладно."

# game/Story03.rpy:1602
translate russian akt3chapter1_3_f5e88c3f_1:

    # L "Good boy."
    L "Хороший мальчик."

# game/Story03.rpy:1604
translate russian akt3chapter1_3_5aaba813:

    # L "Now, there are people like me — we can interact with that world."
    L "Есть люди, такие как я - мы можем взаимодействовать с этим миром."

# game/Story03.rpy:1605
translate russian akt3chapter1_3_877dbbfe:

    # L "Common folk call us psykers."
    L "Обычные люди считают нас теми, кто меняет реальность."

# game/Story03.rpy:1607
translate russian akt3chapter1_3_2b35b6fe_29:

    # mc "..."
    mc "..."

# game/Story03.rpy:1608
translate russian akt3chapter1_3_5ddaab18_1:

