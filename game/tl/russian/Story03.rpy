translate russian akt3chapter5_2_005a7d08:

    # mc "Tch. You’re already on the edge, and I haven’t even tried yet."
    mc "Тц. Ты уже на грани, а я ещё даже не пытался."

# game/Story03.rpy:6253
translate russian akt3chapter5_2_1b7b59e9:

    # h "Tried? This... this isn't trying?"
    h "Не пытался? Это... это не попытка?"

