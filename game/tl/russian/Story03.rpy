translate russian act3_5chapter1_581e9bbe:

    # k "The whole world’s a stage, and we’re all actors. Deep thoughts in your head, aren't they?"
    k "Весь мир - театр, а мы все актёры. У тебя в голове глубокие мысли, да?"

# game/Story03.rpy:6861
translate russian act3_5chapter1_7ad5f242:

    # mc "First, stop crawling into my head. Second, that's just a quote."
    mc "Во-первых, перестань лезть мне в голову. Во-вторых, это просто цитата."

# game/Story03.rpy:6863
translate russian act3_5chapter1_748df167:

    # k "Is it? Then tell me — what do you think of actresses?"
    k "Правда? Тогда скажи мне - что ты думаешь об актрисах?"

# game/Story03.rpy:6865
translate russian act3_5chapter1_8608927f:

    # mc "You read mind yourself. Remember?"
    mc "Ты сама читаешь мысли. Помнишь?"

