# game/Story03.rpy:3851
translate russian akt3chapter3_31d1872b:

    # mc "(So many lives hanging on this... So many eyes—on me.)"
    mc "(Столько жизней зависит от этого... Столько глаз смотрят на меня.)"

# game/Story03.rpy:3852
translate russian akt3chapter3_ee1d092e:

    # mc "(Focus. Breathe. Think...)"
    mc "(Сосредоточься. Дыши. Думай...)"

# game/Story03.rpy:3855
translate russian akt3chapter3_b98d0cd4:

    # mc "(There you are, you bastard panel! COME ON!)"
    mc "(Вот ты где, чёртова панель! ДАВАЙ!)"

# game/Story03.rpy:3859
translate russian akt3chapter3_d8d2e292:

    # mc "(IT WORKED! HOLY SHIT, IT’S WORKING!)"
    mc "(РАБОТАЕТ! ЧЁРТ ВОЗЬМИ, ОНО РАБОТАЕТ!)"

# game/Story03.rpy:3861
translate russian akt3chapter3_100e2981:

    # Mi "...That’ll slow them down."
    Mi "...Это их задержит."

# game/Story03.rpy:3864
translate russian akt3chapter3_021cdd16:

    # mc "Miriel, get your ass out of there. We’re getting out."
    mc "Мириэль, уноси свою задницу оттуда. Мы сваливаем."

# game/Story03.rpy:3876
translate russian akt3chapter3_da6c1eb6:

    # mc "(Barely made it... thought it was over for a second...)"
    mc "(Еле успели... На секунду подумал, что всё кончено...)"

# game/Story03.rpy:3879
translate russian akt3chapter3_d345d2cd:

    # mc "How’s everyone else?"
    mc "Как там остальные?"

# game/Story03.rpy:3881
translate russian akt3chapter3_4b7353a4:

    # Mi "Mixed. Some are stitching themselves back together. Some are just lying still."
    Mi "По-разному. Некоторые зашивают раны. Некоторые просто неподвижно лежат."

# game/Story03.rpy:3883
translate russian akt3chapter3_095d8692:

    # mc "(Could use a bit of stitching myself, but…)"
    mc "(Мне бы тоже не помешало, но...)"

# game/Story03.rpy:3884
translate russian akt3chapter3_75cd710f:

    # mc "(As always, no time to think about myself.)"
    mc "(Как всегда, нет времени думать о себе.)"

# game/Story03.rpy:3885
translate russian akt3chapter3_5cf1faeb:

    # mc "And you?"
    mc "А ты?"

# game/Story03.rpy:3888
translate russian akt3chapter3_aefae15e:

    # Mi "Counting losses."
    Mi "Проверяю потери."

# game/Story03.rpy:3890
translate russian akt3chapter3_ea7f6c81:

    # mc "(She came here... just to see me?)"
    mc "(Она пришла сюда… просто чтобы увидеть меня?)"

# game/Story03.rpy:3892
translate russian akt3chapter3_94075107:

    # mc "Thanks, I guess."
    mc "Спасибо, наверное."

# game/Story03.rpy:3894
translate russian akt3chapter3_0a26bf77:

    # Mi "There’s an autopilot here."
    Mi "Здесь есть автопилот."

# game/Story03.rpy:3897
translate russian akt3chapter3_f4a6cf1c:

    # mc "Wait, really?!"
    mc "Погоди, правда?!"

# game/Story03.rpy:3906
translate russian akt3chapter3_27dd6e80:

    # mc "You’ve got to be kidding me..."
    mc "Да ты должно быть шутишь..."

# game/Story03.rpy:3908
translate russian akt3chapter3_3d18f680:

    # Mi "Joking isn’t in my nature."
    Mi "Шутить не в моём характере."

# game/Story03.rpy:3910
translate russian akt3chapter3_db427f4c:

    # Mi "Better save your strength now."
    Mi "Лучше побереги свои силы."

# game/Story03.rpy:3911
translate russian akt3chapter3_3acd2c07:

    # Mi "Where are the others?"
    Mi "Где остальные?"

# game/Story03.rpy:3913
translate russian akt3chapter3_ab0eb14b:

    # mc "Far as I know — Sector Three."
    mc "Насколько я знаю, в третьем секторе."

# game/Story03.rpy:3915
translate russian akt3chapter3_c72dd2ac:

    # Mi "Understood."
    Mi "Понятно."

# game/Story03.rpy:3921
translate russian akt3chapter3_a2b93d28:

    # mc "So… what about Winter? And the lower city?"
    mc "Так… А что с Винтером и Нижним городом?"

# game/Story03.rpy:3924
translate russian akt3chapter3_addbed3f:

    # Mi "He agreed."
    Mi "Он согласился."

# game/Story03.rpy:3927
translate russian akt3chapter3_b77ad661:

    # mc "Seriously?!"
    mc "Серьёзно?!"

# game/Story03.rpy:3930
translate russian akt3chapter3_42a9d288:

    # Mi "He didn’t have a choice."
    Mi "У него не было другого выхода."

# game/Story03.rpy:3934
translate russian akt3chapter3_52649b70:

    # mc "Honestly didn’t see that coming. He struck me as the kind of man who never backs down."
    mc "Честно говоря, я этого не ожидал. Он показался мне человеком, который никогда не сдаётся."

# game/Story03.rpy:3937
translate russian akt3chapter3_015dd9d8:

    # Mi "When it’s the ones you love on the line — pride means nothing."
    Mi "Когда на кону стоят те, кого ты любишь, гордость не имеет никакого значения."

# game/Story03.rpy:3939
translate russian akt3chapter3_698e7949:

    # mc "You’ve had to make that choice too, haven’t you?"
    mc "Тебе тоже пришлось сделать такой выбор, не так ли?"

# game/Story03.rpy:3941
translate russian akt3chapter3_7ffa6c43:

    # Mi "It’s not a ‘had to’. It’s just how things are."
    Mi "Это не \"пришлось\". Просто так устроены вещи."

# game/Story03.rpy:3947
translate russian akt3chapter3_da67fb92:

    # mc "No choice, huh..."
    mc "Не было выбора, да..."

# game/Story03.rpy:3949
translate russian akt3chapter3_4a4a0fcc:

    # mc "And the ones with you… all of them?"
    mc "А те, кто с тобой… Это все?"

# game/Story03.rpy:3950
translate russian akt3chapter3_d4bb0e92:

    # Mi "The ones I managed to pull out."
    Mi "Те, кого успела вытащить."

# game/Story03.rpy:3951
translate russian akt3chapter3_111fb31d:

    # mc "So… not all."
    mc "То есть... не все."

# game/Story03.rpy:3952
translate russian akt3chapter3_95ce11d4:

    # Mi "The rest were taken by Yong."
    Mi "Остальных забрал Йонг."

# game/Story03.rpy:3953
translate russian akt3chapter3_0614a5a9:

    # mc "But where are you headed now?"
    mc "Но куда ты теперь?"

# game/Story03.rpy:3954
translate russian akt3chapter3_7e4480d9:

    # Mi "Safe zone. After that — doesn’t matter."
    Mi "В безопасную зону. А что будет потом - неважно."

# game/Story03.rpy:3955
translate russian akt3chapter3_46fe282c:

    # mc "Got it..."
    mc "Понял..."

# game/Story03.rpy:3959
translate russian akt3chapter3_e26ea0f8:

    # mc "About what happened… I’m sorry I vanished like that."
    mc "Насчёт того, что произошло... Прости, что я так исчез."

# game/Story03.rpy:3965
translate russian akt3chapter3_ac5d8a1e:

    # Mi "They told me what happened."
    Mi "Мне рассказали, что произошло."

# game/Story03.rpy:3966
translate russian akt3chapter3_a5019b35:

    # Mi "I’d have done the same."
    Mi "Я поступила бы так же."

# game/Story03.rpy:3968
translate russian akt3chapter3_a7a5c89c:

    # mc "So you’re not mad?"
    mc "Значит, ты не злишься?"

# game/Story03.rpy:3976
translate russian akt3chapter3_1111532b:

    # Mi "We’re even."
    Mi "Мы в расчёте."

# game/Story03.rpy:3977
translate russian akt3chapter3_59169f25:

    # Mi "And… how is she?"
    Mi "И… как она?"

# game/Story03.rpy:3980
translate russian akt3chapter3_f835a620:

    # mc "Who do you mean?"
    mc "Ты о чём?"

# game/Story03.rpy:3982
translate russian akt3chapter3_b9a57403:

    # Mi "The one you’re here for."
    Mi "О той, ради которой ты здесь."

# game/Story03.rpy:3984
translate russian akt3chapter3_c5d19339:

    # mc "...You mean Lora? It’s complicated. She’s changed. Too much."
    mc "...Ты про Лору? Всё сложно. Она изменилась. Слишком сильно."

# game/Story03.rpy:3985
translate russian akt3chapter3_e6ea2897:

    # mc "I still recognize her... but deep down, something says — that’s not the same Lora."
    mc "Я всё ещё узнаю её... но в глубине души что-то подсказывает мне, что это уже не та Лора."

# game/Story03.rpy:3987
translate russian akt3chapter3_6757d0fc:

    # mc "I thought once we met again, everything would go back to how it was."
    mc "Я думал, что когда мы снова встретимся, всё станет как раньше."

# game/Story03.rpy:3988
translate russian akt3chapter3_8bf4c9d8:

    # mc "But I was wrong. We both changed. And…"
    mc "Но я ошибался. Мы оба изменились. И..."

# game/Story03.rpy:3990
translate russian akt3chapter3_65c577a3:

    # Mi "You carry too much on your shoulders."
    Mi "Ты несёшь слишком большую ношу на своих плечах."

# game/Story03.rpy:3992
translate russian akt3chapter3_a455fcb2:

    # mc "Maybe… But if not me, then who?"
    mc "Возможно… Но если не я, то кто?"

# game/Story03.rpy:3994
translate russian akt3chapter3_ce76d0ff:

    # mc "She’s been through so much. I have to try. Somehow."
    mc "Она пережила так много. Я должен попробовать. Хотя бы как-нибудь."

# game/Story03.rpy:3996
translate russian akt3chapter3_641dcf98:

    # mc "(That’s right, [mc], even if it means losing yourself…)"
    mc "(Правильно, [mc!t], даже если это означает потерять себя...)"

# game/Story03.rpy:4001
translate russian akt3chapter3_bde4ed72:

    # Mi "You once told me: asking for help isn’t weakness."
    Mi "Ты когда-то сказал мне: просить помощи — это не слабость."

# game/Story03.rpy:4003
translate russian akt3chapter3_abb4083f:

    # mc "Maybe you’re right, but…"
    mc "Возможно, ты права, но..."

# game/Story03.rpy:4014
translate russian akt3chapter3_3489aed8:

    # Mi "You’re doing it."
    Mi "Ты справляешься."

# game/Story03.rpy:4015
translate russian akt3chapter3_c648ff15:

    # Mi "Not everyone could."
    Mi "Не каждый смог бы."

# game/Story03.rpy:4017
translate russian akt3chapter3_d9956fbf:

    # mc "But this is different. Lives depend on me."
    mc "Но это другое. От меня зависят жизни людей."

# game/Story03.rpy:4019
translate russian akt3chapter3_f9991d93:

    # mc "If I break — it all collapses."
    mc "Если я сломаюсь — рухнет всё."

# game/Story03.rpy:4023
translate russian akt3chapter3_eb6c1032:

    # Mi "Enough."
    Mi "Хватит."

# game/Story03.rpy:4024
translate russian akt3chapter3_a2f3f1cd:

    # Mi "I don’t care what kind of nonsense you’ve built up in your head."
    Mi "Мне плевать, какие глупости ты себе надумал."

# game/Story03.rpy:4026
translate russian akt3chapter3_14767483:

    # Mi "You’re not alone. I’m with you. Whatever that means, whatever it takes. Got it?"
    Mi "Ты не один. Я с тобой. Что бы это ни значило, и чего бы ни стоило. Понял?"

# game/Story03.rpy:4029
translate russian akt3chapter3_bf930c05:

    # mc "(She’s so close… and her hand’s trembling…)"
    mc "(Она так близко… и её рука дрожит…)"

# game/Story03.rpy:4031
translate russian akt3chapter3_ab2d6bae:

    # mc "You’re shaking… Are you okay?"
    mc "Ты дрожишь… Всё в порядке?"

# game/Story03.rpy:4033
translate russian akt3chapter3_c8c91fa9:

    # Mi "I don’t know…"
    Mi "Не знаю..."

# game/Story03.rpy:4035
translate russian akt3chapter3_88342d7a:

    # mc "(Her eyes… so much pain… and hope?)"
    mc "(Её глаза… в них столько боли и… надежды?)"

# game/Story03.rpy:4045
translate russian akt3chapter3_c6ced3b3:

    # Mi "No…"
    Mi "Нет..."

# game/Story03.rpy:4046
translate russian akt3chapter3_7b150c53:

    # mc "Miriël—"
    mc "Мириэль—"

# game/Story03.rpy:4049
translate russian akt3chapter3_37c761dc:

    # Mi "I’m sorry. That was a mistake."
    Mi "Прости. Это была ошибка."

# game/Story03.rpy:4051
translate russian akt3chapter3_a0d8248b:

    # mc "(No… it wasn’t. Just… too sudden.)"
    mc "(Нет… не была. Просто… слишком неожиданно.)"

# game/Story03.rpy:4053
translate russian akt3chapter3_85d135e3:

    # mc "(I wonder… if things had gone differently… could I have held on to her?)"
    mc "(Интересно… если бы всё сложилось иначе… смог бы я удержать её?)"

# game/Story03.rpy:4070
translate russian akt3chapter3_eab69095:

    # Fl "Come on, dammit, don’t break on me now. Just a little more…"
    Fl "Давай, чёрт возьми, не обрывайся сейчас. Ещё чуть-чуть..."

# game/Story03.rpy:4073
translate russian akt3chapter3_66702ac3:

    # Fl "If you’re not some Empire-flash drive full of secrets — get lost."
    Fl "Если ты не какая-нибудь флешка Империи, полная секретов, - проваливай."

# game/Story03.rpy:4075
translate russian akt3chapter3_2f1695d8:

    # em "Still no luck?"
    em "Так и не удалось?"

# game/Story03.rpy:4078
translate russian akt3chapter3_0ace4b5a:

    # Fl "Ah, Ember. It’s you."
    Fl "А, это ты, Эмбер."

# game/Story03.rpy:4080
translate russian akt3chapter3_3f37f5e6:

    # Fl "No. The damn thing’s encrypted like the Emperor himself was scared it’d be read."
    Fl "Нет. Эта чёртова штука зашифрована так, как будто сам Император боялся, что её прочитают."

# game/Story03.rpy:4083
translate russian akt3chapter3_5495681b:

    # Fl "Dad risked his life for this."
    Fl "Отец рисковал жизнью ради этого."

# game/Story03.rpy:4088
translate russian akt3chapter3_1fba655c:

    # Fl "And me… I can’t even peek inside. Hilarious, huh?"
    Fl "А я... Я даже не могу заглянуть внутрь. Забавно, да?"

# game/Story03.rpy:4090
translate russian akt3chapter3_c0c4dd5e:

    # em "Giving up?"
    em "Сдаёшься?"

# game/Story03.rpy:4093
translate russian akt3chapter3_d8656051:

    # Fl "Give up?! Yeah, right. Let my whole damn bloodline burn, but I’m finishing this."
    Fl "Сдаюсь?! Ага, щас. Пусть весь мой чёртов род сгорит, но я доведу это до конца."

# game/Story03.rpy:4094
translate russian akt3chapter3_ee355051:

    # Fl "(whispering) I won’t give up. Ever."
    Fl "{i}*шепчет*{/i} Я не сдамся. Никогда."

# game/Story03.rpy:4097
translate russian akt3chapter3_8b482f5c:

    # Fl "So, what are you here for?"
    Fl "Так зачем ты здесь?"

# game/Story03.rpy:4099
translate russian akt3chapter3_383da142:

    # em "Wanted to make sure the genius hadn’t burned out in her own chains."
    em "Хотела убедиться, что гений ещё не сгорел в собственных цепях."

# game/Story03.rpy:4104
translate russian akt3chapter3_da1542f9:

    # Fl "You’d be surprised how fast this place turns a genius into a leper."
    Fl "Ты бы удивилась, как быстро это место превращает гения в прокажённого."

# game/Story03.rpy:4107
translate russian akt3chapter3_6152b93f:

    # Fl "To them, I’m just the girl who signed the death warrant for hundreds — oh, sorry — four thousand. Classic, right?"
    Fl "Для них я просто девчонка, которая подписала смертный приговор сотням... О, прости, четырём тысячам. Классика, да?"

# game/Story03.rpy:4110
translate russian akt3chapter3_914bd3c3:

    # em "In exchange for three hundred thousand mutants."
    em "В обмен на триста тысяч мутантов."

# game/Story03.rpy:4113
translate russian akt3chapter3_eae975ce:

    # Fl "At the cost of almost everyone who still believed in my father. At the cost of any hope for justice."
    Fl "Ценой почти всех, кто ещё верил в моего отца. Ценой любой надежды на справедливость."

# game/Story03.rpy:4115
translate russian akt3chapter3_dde49483:

    # em "We’re all going to die, Flora. That’s not the question. The question is how we lived. And for what."
    em "Все мы умрём, Флора. Вопрос не в этом. Вопрос в том, как мы жили. И ради чего."

# game/Story03.rpy:4121
translate russian akt3chapter3_5fcddb7f:

    # em "They went out as heroes."
    em "Они ушли как герои."

# game/Story03.rpy:4123
translate russian akt3chapter3_c536bb12:

    # Fl "And we stayed behind."
    Fl "А мы остались позади."

# game/Story03.rpy:4125
translate russian akt3chapter3_14363cb2:

    # Fl "To watch it all spiral into the abyss. To watch everything they fought for get erased. To watch no one be held accountable."
    Fl "Смотреть, как всё катится в бездну. Как всё, за что они боролись, стирается. Смотреть, как никто не несёт ответственности."

# game/Story03.rpy:4127
translate russian akt3chapter3_49d9212f:

    # em "Command’s a joke. Bureaucrats with implants where their souls should be."
    em "Командование — это шутка. Бюрократы с имплантами вместо душ."

# game/Story03.rpy:4130
translate russian akt3chapter3_45bc6053:

    # em "To them, you’re just a number. Your people — numbers. The dead — statistics."
    em "Для них ты просто номер. Твои люди - номера. Мёртвые - статистика."

# game/Story03.rpy:4132
translate russian akt3chapter3_5a009dc8:

    # em "People like them will rot on their thrones till they tear each other apart."
    em "Такие, как они, будут гнить на троне, пока не перегрызут друг друга."

# game/Story03.rpy:4136
translate russian akt3chapter3_633b408d:

    # Fl "That’s why I’m angry. We let the innocent die."
    Fl "Вот почему я злюсь. Мы позволяем гибнуть невинным."

# game/Story03.rpy:4138
translate russian akt3chapter3_78263d4d:

    # Fl "We keep making the same damn mistake."
    Fl "Мы снова и снова повторяем эту чёртову ошибку."

# game/Story03.rpy:4140
translate russian akt3chapter3_0c4df5ee:

    # em "You take after your mother…"
    em "Ты вся в мать..."

# game/Story03.rpy:4142
translate russian akt3chapter3_546e0809:

    # Fl "No. She was naive. Wanted to change the world — and it devoured her alive."
    Fl "Нет. Она была наивна. Хотела изменить мир — и он сожрал её заживо."

# game/Story03.rpy:4145
translate russian akt3chapter3_09013f97:

    # em "You’d know best."
    em "Тебе виднее."

# game/Story03.rpy:4147
translate russian akt3chapter3_f2b5c327:

    # em "If you ever need help — just say the word."
    em "Если понадобится помощь — просто скажи."

# game/Story03.rpy:4150
translate russian akt3chapter3_b45d1f37:

    # Fl "Thanks, but… I don’t know how to share the weight. I’m used to dragging it all myself."
    Fl "Спасибо, но... я не умею делить ношу. Я привыкла тянуть всё сама."

# game/Story03.rpy:4160
translate russian akt3chapter3_70a8ebbe:

    # em "And yet you’ll pull it off."
    em "И всё же у тебя получится."

# game/Story03.rpy:4162
translate russian akt3chapter3_b7abe60d:

    # Fl "I know. That’s the problem."
    Fl "Знаю. В этом и проблема."

# game/Story03.rpy:4170
translate russian akt3chapter3_e5cb2fab:

    # Fl "What?"
    Fl "Что?"

# game/Story03.rpy:4173
translate russian akt3chapter3_f4a0a42e:

    # em "Skarlea’s already here."
    em "Скарлея уже здесь."

# game/Story03.rpy:4177
translate russian akt3chapter3_22f4b2c7:

    # Fl "What?!"
    Fl "Что?!"

# game/Story03.rpy:4178
translate russian akt3chapter3_b758aba5:

    # Fl "What the hell is she doing in my sector?!"
    Fl "Что, чёрт возьми, она делает в моём секторе?!"

# game/Story03.rpy:4182
translate russian akt3chapter3_633f4323:

    # em "Ask her yourself. If you dare."
    em "Спроси её сама. Если осмелишься."

# game/Story03.rpy:4184
translate russian akt3chapter3_e5bb6c27:

    # scar "(Hmm… Security system — 2 out of 10.)"
