translate russian akt3chapter1_4_109280b3:

    # L "Yes."
    L "Да."

# game/Story03.rpy:1721
translate russian akt3chapter1_4_36e8449b:

    # L "Not because they want me dead."
    L "Не потому, что хотят моей смерти."

# game/Story03.rpy:1722
translate russian akt3chapter1_4_5bfded4b:

    # L "Because they want what I know."
    L "А потому, что хотят получить то, что я знаю."

# game/Story03.rpy:1815
translate russian akt3chapter2_577c5298:

    # aa "Not the gates."
    aa "Не Врата."

# game/Story03.rpy:1817
translate russian akt3chapter2_52f842db:

    # aa "What waits behind them."
    aa "Что ждёт за ними."

# game/Story03.rpy:1818
translate russian akt3chapter2_e8404196:

    # mc "...The Abyss?"
    mc "...Бездна?"

# game/Story03.rpy:1847
translate russian akt3chapter2_46f16f1d:

    # R "Not enough energy to open the gate."
    R "Не хватает энергии, чтобы открыть Врата."

# game/Story03.rpy:2466
translate russian akt3chapter2_1_6553e5d6:

    # mc "(Lora and Olivia are in Sector Three. Alive. For now.)"
    mc "(Лора и Оливия в Третьем секторе. Живы. Пока.)"

# game/Story03.rpy:2467
translate russian akt3chapter2_1_d0ea411e:

    # mc "(But if the Peacekeepers fall, no one holds the line around the Tower.)"
    mc "(Но если Миротворцы падут, линию вокруг Башни будет некому удерживать.)"

# game/Story03.rpy:2469
translate russian akt3chapter2_1_eb5d2e69:

    # mc "(Then Lower City, Sector Three, everyone... gone.)"
    mc "(Тогда Нижний город, Третий сектор, все... погибнут.)"

# game/Story03.rpy:2470
translate russian akt3chapter2_1_04e429bb:

    # mc "(So first, the Peacekeepers. Then I get back to them.)"
    mc "(Значит, сначала Миротворцы. Потом я вернусь к ним.)"

# game/Story03.rpy:3191
translate russian akt3chapter3_f4cc7e48:

    # a "You saw the gate open. But you never asked what they opened on."
    a "Ты видел, как открылись Врата. Но ты ни разу не спросил, что они открыли."

# game/Story03.rpy:4026
translate russian akt3chapter3_2_030d78f5:

    # Mi "But it only holds a route once someone sets it manually."
    Mi "Но он удерживает маршрут только после того, как кто-то задаст его вручную."

# game/Story03.rpy:4027
translate russian akt3chapter3_2_cce2f0e1:

    # Mi "It couldn't have launched us. Not from that bay. Not under fire."
    Mi "Он не мог отправить нас сам. Не из того отсека. Не под огнём."

# game/Story03.rpy:4480
translate russian akt3chapter3_4_9fc136e2:

    # Mi "(That’s... a gate to the Abyss?!)"
    Mi "(Это... Врата в Бездну?!)"

# game/Story03.rpy:4555
translate russian akt3chapter3_4_495a65f1:

    # Mi "You almost killed us all!"
    Mi "Ты чуть не убила нас всех!"

# game/Story03.rpy:4595
translate russian akt3chapter3_4_144ab5eb:

    # Mi "An unstable breach."
    Mi "Нестабильная брешь."

# game/Story03.rpy:4596
translate russian akt3chapter3_4_0c158b40:

    # Mi "One mistake, and half the bay gets scattered into the Abyss."
    Mi "Одна ошибка - и половину отсека разбросает по Бездне."

# game/Story03.rpy:4597
translate russian akt3chapter3_4_99c07510:

    # a "We survived because it was short."
    a "Мы выжили, потому что переход был коротким."

# game/Story03.rpy:4598
translate russian akt3chapter3_4_dd5e7a8a:

    # a "And because I was lucky."
    a "И потому что мне повезло."

# game/Story03.rpy:4604
translate russian akt3chapter3_4_d4aa063b:

    # mc "(Gate? What kind of...)"
    mc "(Врата? Что за...)"

# game/Story03.rpy:5041
translate russian akt3chapter4_64288e43:

    # L "We need to find a way out."
    L "Нам нужно найти выход."

# game/Story03.rpy:5730
translate russian akt3chapter5_1_59242a8a:

    # Fl "Freezing is the priority."
    Fl "Заморозка - приоритет."

# game/Story03.rpy:5731
translate russian akt3chapter5_1_044afcc9:

    # Fl "If they breach the line, shoot. But only then."
    Fl "Если они прорвут линию, стреляйте. Но только тогда."

# game/Story03.rpy:5732
translate russian akt3chapter5_1_76982a3a:

    # Fl "Every dead Soulless feeds the substance."
    Fl "Каждый мёртвый Бездушный питает субстанцию."

# game/Story03.rpy:5733
translate russian akt3chapter5_1_4eae6bae:

    # Fl "So we don't kill to win. We kill only to buy seconds."
    Fl "Так что мы не убиваем ради победы. Мы убиваем только чтобы выиграть секунды."

# game/Story03.rpy:5803
translate russian akt3chapter5_1_ef395dc6:

    # L "The Tower is about to activate."
    L "Башня вот-вот активируется."

# game/Story03.rpy:5844
translate russian akt3chapter5_1_2909dd39:

    # Fl "While the Syndicate and the Peacekeepers are focused on containing the Soulless..."
    Fl "Пока Синдикат и Миротворцы сосредоточены на сдерживании Бездушных..."

# game/Story03.rpy:5970
translate russian akt3chapter5_2_964f8ad9:

    # am "A smaller grave than the one she would make of the world."
    am "Меньшая могила, чем та, которую она сделала бы из всего мира."

# game/Story03.rpy:8137
translate russian choiceY_da387ff3:

    # mc "So — gates and breaches. Different things?"
    mc "Так Врата и бреши - это разные вещи?"

# game/Story03.rpy:8139
translate russian choiceY_bcd130de:

    # y "branch are one system. Their natural function is to link worlds."
    y "ветви - единая система. Их природная функция - соединять миры."

# game/Story03.rpy:8143
translate russian choiceY_83f9fc35:

    # y "Machines built to control them."
    y "Машины, созданные для управления ими."

# game/Story03.rpy:8145
translate russian choiceY_4bd39382:

    # mc "So, put simply? Breaches happen naturally. Gates force them open?"
    mc "То есть, проще говоря? Бреши возникают естественно. А Врата насильно открывают их?"

