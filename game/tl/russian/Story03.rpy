translate russian act3_5chapter1_1_91aa9ee6:

    # mc "Thanks. I’ll take that as a compliment — stupidity included."
    mc "Спасибо. Приму это как комплимент - включая глупость."

# game/Story03.rpy:6685
translate russian act3_5chapter1_1_504c96a0:

    # k "She’ll sulk for a while."
    k "Она будет дуться некоторое время."

# game/Story03.rpy:6688
translate russian act3_5chapter1_1_59912dee:

    # k "Then either forgive you or slit your throat. Fifty-fifty."
    k "Потом либо простит тебя, либо перережет тебе горло. Пятьдесят на пятьдесят."

# game/Story03.rpy:6690
translate russian act3_5chapter1_1_c959b280:

    # mc "Calculations... You know, I’m starting to understand why you are the way you are."
    mc "Расчёты... Знаешь, я начинаю понимать, почему ты такая, какая ты есть."

# game/Story03.rpy:6693
translate russian act3_5chapter1_1_0e5a681d:

    # k "Oh? Do enlighten me."
    k "О? Просвяти меня."

# game/Story03.rpy:6695
translate russian act3_5chapter1_1_737f097e:

    # mc "Cold. Like everything’s the mission. Like machines."
    mc "Холодная. Как будто всё - это миссия. Как машина."

# game/Story03.rpy:6698
translate russian act3_5chapter1_1_812b74ec:

    # k "Mmm. Sharp tongue. Half-right. But unlike machines, I enjoy the mess."
    k "Ммм. Острый язычок. Наполовину ты прав. Но в отличии от машин, я наслаждаюсь хаосом."

# game/Story03.rpy:6700
translate russian act3_5chapter1_1_debcc36a:

    # mc "Maybe, but don’t you think there’s something off about this place?"
    mc "Может быть, но тебе не кажется, что в этом месте что-то не так?"

