translate russian act3_5chapter1_1_b4f7ad31:

    # gg "Cut the panic, grab the data for research. That’ll be more useful."
    gg "Хватит паниковать, возьми данные для исследования. Это будет полезно."

# game/Story03.rpy:6746
translate russian act3_5chapter1_1_174ec2be:

    # a "They’ve started evolving."
    a "Они начали эволюционировать."

# game/Story03.rpy:6748
translate russian act3_5chapter1_1_9c4a7209:

    # k "If that’s true… then everything just turned deliciously worse."
    k "Если это правда... то только что всё стало восхитительно хуже."

# game/Story03.rpy:6756
translate russian act3_5chapter1_1_b6529b9b:

    # a "Leave. Now."
    a "Уходим. Сейчас же."

# game/Story03.rpy:6759
translate russian act3_5chapter1_1_850ef128:

    # b "..."
    b "..."

# game/Story03.rpy:6763
translate russian act3_5chapter1_1_0472cfef:

    # g "What the hell was that monster!?"
    g "Что это, чёрт возьми, был за монстр?!"

# game/Story03.rpy:6765
translate russian act3_5chapter1_1_789611ab:

    # gggg "How are we supposed to know."
    gggg "Откуда нам знать."

# game/Story03.rpy:6767
translate russian act3_5chapter1_1_4ce08dcd:

    # g "Why didn't the device work?! It identifies those things fast!"
    g "Почему устройство не сработало?! Оно быстро распознаёт такие вещи!"

# game/Story03.rpy:6770
translate russian act3_5chapter1_1_8f65ac9b:

    # gggg "I DON'T KNOW! HEAR ME, I DON'T KNOW!"
    gggg "Я НЕ ЗНАЮ! СЛЫШИШЬ, Я НЕ ЗНАЮ!"

# game/Story03.rpy:6772
translate russian act3_5chapter1_1_124a7f4e:

    # gg "Cut the panic, both of you."
    gg "Хватит паниковать, вы оба."

# game/Story03.rpy:6775
translate russian act3_5chapter1_1_c2bdcbca:

    # mc "(Something’s off here… doesn’t add up.)"
    mc "(Здесь что-то не так... Всё не сходится.)"

# game/Story03.rpy:6777
translate russian act3_5chapter1_1_6612100d:

    # mc "(Their reactions — they know. But why are they hiding it?)"
    mc "(Их реакция - они знают. Но почему они это скрывают?)"

# game/Story03.rpy:6780
translate russian act3_5chapter1_1_f5ff0417:

    # mc "You {b}do{/b} know what that was, don’t you?"
    mc "Вы {b}знаете{/b}, что это было, не так ли?"

# game/Story03.rpy:6782
translate russian act3_5chapter1_1_0484d506:

    # mc "(Aha. Wonderful. A wall of silence.)"
    mc "(Ага. Замечательно. Стена молчания.)"

# game/Story03.rpy:6784
translate russian act3_5chapter1_1_dd0860a7:

    # mc "Well, Kalestra? Always clever. Maybe for once, be useful?"
    mc "Ну, Калестра? Всегда умная. Может, хоть раз будешь полезной?"

# game/Story03.rpy:6785
translate russian act3_5chapter1_1_bf4d335d:

    # k "Not the slightest clue."
    k "Ни малейшего представления."

# game/Story03.rpy:6788
translate russian act3_5chapter1_1_cc6c9da1:

    # k "(But if you don’t stick to me, you’ll be nothing but stains on the floor.)"
    k "(Но если не будешь держаться рядом со мной, от тебя останутся лишь пятна на полу.)"

# game/Story03.rpy:6790
translate russian act3_5chapter1_1_9ad54191:

    # mc "Ah, your living shield? Great prospect."
    mc "А, твой живой щит? Отличная перспектива."

# game/Story03.rpy:6792
translate russian act3_5chapter1_1_3386e15d:

    # k "Better a shield than a corpse. Stay close, or start digging your grave."
    k "Лучше щит, чем труп. Держись поближе или начинай копать себе могилу."

# game/Story03.rpy:6793
translate russian act3_5chapter1_1_2b35b6fe_1:

    # mc "..."
    mc "..."

# game/Story03.rpy:6794
translate russian act3_5chapter1_1_b0068f89:

    # mc "(I’ve… never seen her like that.)"
    mc "(Я... никогда не видел её такой.)"

# game/Story03.rpy:6797
translate russian act3_5chapter1_1_0d345e03:

    # k "And you really shouldn’t have."
    k "И тебе действительно не следовало бы."

