translate russian act3_5chapter1_db0bfed6:

    # k "And you follow them anyway."
    k "А ты всё равно их выполняешь."

# game/Story03.rpy:6769
translate russian act3_5chapter1_56cefe88:

    # k "Follow me, unless you’re tired of breathing."
    k "Следуйте за мной, если не устали дышать."

# game/Story03.rpy:6772
translate russian act3_5chapter1_47442c15:

    # gggg "What?! She just did that?!"
    gggg "Что?! Она только что это сделала?!"

# game/Story03.rpy:6773
translate russian act3_5chapter1_a18ec3af:

    # gg "Yeah, after her! Stick to her!"
    gg "Да, за ней! Держитесь за ней!"

# game/Story03.rpy:6783
translate russian act3_5chapter1_9dcb3407:

    # gg "Come on, quick. Move in!"
    gg "Давайте, быстрее. Вперёд!"

# game/Story03.rpy:6789
translate russian act3_5chapter1_2b35b6fe_2:

    # mc "..."
    mc "..."

# game/Story03.rpy:6790
translate russian act3_5chapter1_f9b263fd:

    # mc "(Quiet. Just the hum of the generators. Strange… but right now it almost feels calming.)"
    mc "(Тишина. Только гул генераторов. Странно... но сейчас это почти успокаивает.)"

# game/Story03.rpy:6796
translate russian act3_5chapter1_3b69dd5f:

    # mc "(The road’s only starting, and they already look worn out. Like ghosts.)"
    mc "(Дорога только начинается, а они уже выглядят измученными. Как призраки.)"

# game/Story03.rpy:6798
translate russian act3_5chapter1_3f537c6a:

    # mc "(And me? Back in the mess again. Playing the hero. Figures.)"
    mc "(А я? Снова по уши в дерьме. Играю в героя. Типично.)"

# game/Story03.rpy:6806
translate russian act3_5chapter1_82091822_3:

    # k "..."
    k "..."

# game/Story03.rpy:6808
translate russian act3_5chapter1_2b35b6fe_3:

    # mc "..."
    mc "..."

# game/Story03.rpy:6810
translate russian act3_5chapter1_b60a13ec:

    # mc "You’re usually the loud one. What’s with the silence?"
    mc "Обычно ты громкая. Что это за тишина?"

# game/Story03.rpy:6813
translate russian act3_5chapter1_df11187d:

    # k "Bored. Put on a show for me."
    k "Скучно. Устрой для меня шоу."

# game/Story03.rpy:6815
translate russian act3_5chapter1_2b35b6fe_4:

    # mc "..."
    mc "..."

# game/Story03.rpy:6818
translate russian act3_5chapter1_b45dbbf4:

    # mc "Bored? After all that? We’re lucky we’re still breathing."
    mc "Скучно? После всего этого? Нам повезло, что мы ещё дышим."

