translate russian act3_5chapter1_1_08cdef3d:

    # k "Maybe we should keep him. He looks fake enough to be useful bait."
    k "Может, нам стоит его оставить. Он выглядит достаточно фальшиво, чтобы быть полезной приманкой."

# game/Story03.rpy:6727
translate russian act3_5chapter1_1_76f558a8:

    # mc "Kalestra?"
    mc "Калестра?"

# game/Story03.rpy:6729
translate russian act3_5chapter1_1_93334484:

    # k "What?"
    k "Что?"

# game/Story03.rpy:6731
translate russian act3_5chapter1_1_443cdf07:

    # mc "Since when can the Faceless affect the subconscious?"
    mc "С каких пор Безликие могут влиять на подсознание?"

# game/Story03.rpy:6733
translate russian act3_5chapter1_1_82091822:

    # k "..."
    k "..."

# game/Story03.rpy:6738
translate russian act3_5chapter1_1_e72b01c4:

    # gggg "Who... is that?"
    gggg "Кто... это?"

# game/Story03.rpy:6741
translate russian act3_5chapter1_1_64783cc9:

    # gg "Looks like a Faceless."
    gg "Похож на Безликого."

