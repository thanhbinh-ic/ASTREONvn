translate russian akt3chapter5_2_8d574d23:

    # mc "Then try. I dare you."
    mc "Тогда попробуй. Я бросаю тебе вызов."

# game/Story03.rpy:6277
translate russian akt3chapter5_2_93d014be:

    # h "You’ll regret asking for that."
    h "Ты пожалеешь, что попросил об этом."

# game/Story03.rpy:6278
translate russian akt3chapter5_2_a0ba430f:

    # mc "I doubt it. In fact—"
    mc "Сомневаюсь. На самом деле..."

# game/Story03.rpy:6279
translate russian akt3chapter5_2_01779fee:

    # mc "I’m counting on it."
    mc "Я на это рассчитываю."

# game/Story03.rpy:6285
translate russian akt3chapter5_2_6d89ff97:

    # k "Quite a show, don’t you think?"
    k "Неплохое представление, не правда ли?"

