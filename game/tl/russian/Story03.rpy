translate russian act3_5chapter1_1_3f21e5ce:

    # k "Too quiet. Too clean. Like a stage before the slaughter."
    k "Слишком тихо. Слишком чисто. Как сцена перед бойней."

# game/Story03.rpy:6705
translate russian act3_5chapter1_1_fc60f0c6:

    # mc "Yeah. Stay sharp."
    mc "Да. Будь начеку."

