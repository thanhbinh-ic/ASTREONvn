    # a "I’ll buy time."
    a "Я выиграю время."

# game/Story03.rpy:2246
translate russian akt3chapter2_4b9fcff1:

    # a "Count on yourself."
    a "Полагайся на себя."

# game/Story03.rpy:2248
translate russian akt3chapter2_ce96487d:

    # mc "(Quietly) Hang in there, guys…"
