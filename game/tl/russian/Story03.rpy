translate russian akt3chapter3_3_8b482f5c:

    # Fl "So, what are you here for?"
    Fl "Так зачем ты здесь?"

# game/Story03.rpy:4127
translate russian akt3chapter3_3_383da142:

    # em "Wanted to make sure the genius hadn’t burned out in her own chains."
    em "Хотела убедиться, что гений ещё не сгорел в собственных цепях."

# game/Story03.rpy:4129
