translate russian akt3chapter2_7ddf4f10:

    # gggggg "I’ll go last. I’m no good up there."
    gggggg "Я пойду последний. От меня там не будет толку."

# game/Story03.rpy:2298
translate russian akt3chapter2_1284d641:

    # gg "Hold out, we’ll come back for you."
    gg "Держись, мы за тобой вернёмся."

# game/Story03.rpy:2299
translate russian akt3chapter2_0bd5009d:

    # gggggg "Don’t worry. I won’t die that easy."
    gggggg "Не волнуйтесь. Я так просто здесь не сдохну."

# game/Story03.rpy:2301
translate russian akt3chapter2_419403d0:

    # gggggg "Come on, freaks — I’ve got enough fire for all of you."
    gggggg "Давайте, твари, огонька на всех вас хватит."

# game/Story03.rpy:2303
translate russian akt3chapter2_e66d489a:

    # mc "You're the last one! Go!"
    mc "Ты последний! Пошёл!"

# game/Story03.rpy:2308
translate russian akt3chapter2_1c24321d:

    # gg "VALENS!!"
    gg "ВАЛЕНС!!!"

# game/Story03.rpy:2309
translate russian akt3chapter2_7427dfcf:

    # mc "(That’s him... the Faceless. How did he get so close? I didn’t feel a thing.)"
    mc "(Это он... Безликий. Как он подобрался? Я ничего не почувствовал.)"

# game/Story03.rpy:2311
translate russian akt3chapter2_26e3edc3:

    # gg "How the hell..."
    gg "Какого чёрта..."

# game/Story03.rpy:2313
translate russian akt3chapter2_de7bb69d:

    # mc "Enough. We’re leaving. Or there’ll be more corpses."
    mc "Хватит. Мы уходим. Или трупов будет ещё больше."

# game/Story03.rpy:2317
translate russian akt3chapter2_992588e6:

    # gg "Move out, everyone!"
    gg "Уходим!"

# game/Story03.rpy:2320
translate russian akt3chapter2_c31e395e:

    # a "Took too long."
    a "Слишком долго."

# game/Story03.rpy:2322
translate russian akt3chapter2_a7932198:

    # mc "Complain later. Run now."
    mc "Пожалуешься позже. Сейчас беги."

