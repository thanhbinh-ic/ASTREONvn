translate russian act3_5chapter1_d6314bd9:

    # mc "Actresses? They play their part, crowd claps, curtain falls. That’s it."
    mc "Актрисы? Они играют свою роль, публика аплодирует, занавес опускается. Вот и всё."

# game/Story03.rpy:6874
translate russian act3_5chapter1_db6ccace:

    # mc "What else is there to understand?"
    mc "Что ещё нужно понимать?"

# game/Story03.rpy:6876
translate russian act3_5chapter1_82091822_6:

    # k "..."
    k "..."

# game/Story03.rpy:6878
translate russian act3_5chapter1_bee86476:

    # mc "But you asked for a reason. Why? What’s on your mind?"
    mc "Но ты спросила не просто так. Почему? Что у тебя на уме?"

# game/Story03.rpy:6879
translate russian act3_5chapter1_963ac8d7:

    # k "Not curious?"
    k "Не любопытно?"

