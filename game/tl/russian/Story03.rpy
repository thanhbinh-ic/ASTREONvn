translate russian act3_5chapter1_1_bf2aef3b:

    # mc "You give terrible directions..."
    mc "Ты даёшь ужасные указания..."

# game/Story03.rpy:6811
translate russian act3_5chapter1_1_db0bfed6:

    # k "And you follow them anyway."
    k "А ты всё равно их выполняешь."

# game/Story03.rpy:6813
translate russian act3_5chapter1_1_56cefe88:

    # k "Follow me, unless you’re tired of breathing."
    k "Следуйте за мной, если не устали дышать."

# game/Story03.rpy:6816
translate russian act3_5chapter1_1_47442c15:

    # gggg "What?! She just did that?!"
    gggg "Что?! Она только что это сделала?!"

# game/Story03.rpy:6817
translate russian act3_5chapter1_1_a18ec3af:

    # gg "Yeah, after her! Stick to her!"
    gg "Да, за ней! Держитесь за ней!"

# game/Story03.rpy:6830
translate russian act3_5chapter2_9dcb3407:

    # gg "Come on, quick. Move in!"
    gg "Давайте, быстрее. Вперёд!"

# game/Story03.rpy:6837
translate russian act3_5chapter2_f9b263fd:

    # mc "(Quiet. Just the hum of the generators. Strange… but right now it almost feels calming.)"
    mc "(Тишина. Только гул генераторов. Странно... но сейчас это почти успокаивает.)"

# game/Story03.rpy:6843
translate russian act3_5chapter2_3b69dd5f:

    # mc "(The road’s only starting, and they already look worn out. Like ghosts.)"
    mc "(Дорога только начинается, а они уже выглядят измученными. Как призраки.)"

# game/Story03.rpy:6845
translate russian act3_5chapter2_3f537c6a:

    # mc "(And me? Back in the mess again. Playing the hero. Figures.)"
    mc "(А я? Снова по уши в дерьме. Играю в героя. Типично.)"

# game/Story03.rpy:6853
translate russian act3_5chapter2_82091822:

    # k "..."
    k "..."

# game/Story03.rpy:6857
translate russian act3_5chapter2_b60a13ec:

    # mc "You’re usually the loud one. What’s with the silence?"
    mc "Обычно ты громкая. Что это за тишина?"

# game/Story03.rpy:6860
translate russian act3_5chapter2_df11187d:

    # k "Bored. Put on a show for me."
    k "Скучно. Устрой для меня шоу."

# game/Story03.rpy:6865
translate russian act3_5chapter2_b45dbbf4:

    # mc "Bored? After all that? We’re lucky we’re still breathing."
    mc "Скучно? После всего этого? Нам повезло, что мы ещё дышим."

# game/Story03.rpy:6875
translate russian act3_5chapter2_fce91983:

    # k "Fear and sacrifice are so predictable. No theatrics — no worth. This whole thing tastes like wet ash."
    k "Страх и самопожертвование так предсказуемы. Без театральности - нет ценности. Всё это на вкус, как мокрая зола."

# game/Story03.rpy:6877
translate russian act3_5chapter2_1648d5a4:

    # mc "(Crazy. Definitely.)"
    mc "(Сумасшедшая. Определённо.)"

# game/Story03.rpy:6879
translate russian act3_5chapter2_8ca36d9e:

    # k "Don't call me crazy right away. Just… different."
    k "Не называй меня сразу сумасшедшей. Просто... другой."

# game/Story03.rpy:6881
translate russian act3_5chapter2_6d26a197:

    # mc "Fine. Different. Be that way."
    mc "Ладно. Другая. Будь такой."

# game/Story03.rpy:6886
translate russian act3_5chapter2_82091822_1:

    # k "..."
    k "..."

# game/Story03.rpy:6888
translate russian act3_5chapter2_e3e600ac:

    # k "(whisper) Boredom is the last thing in me that still counts as human."
    k "{i}*шепчет*{/i} Скука - последнее, что во мне всё ещё можно назвать человеческим."

# game/Story03.rpy:6890
translate russian act3_5chapter2_0c328ca6:

    # mc "What? Did you say something?"
    mc "Что? Ты что-то сказала?"

# game/Story03.rpy:6892
translate russian act3_5chapter2_82091822_2:

    # k "..."
    k "..."

# game/Story03.rpy:6896
translate russian act3_5chapter2_cbdba510:

    # k "I said: I’m bored! {w=1.0}Say something already — entertain me."
    k "Я сказала: мне скучно! {w=1.0}Скажи что-нибудь - развлеки меня."

# game/Story03.rpy:6902
translate russian act3_5chapter2_0d46d1f5:

    # mc "Alright then. You want words, I’ll keep them simple."
    mc "Ладно. Если тебе нужны слова, я буду говорить проще."

# game/Story03.rpy:6903
translate russian act3_5chapter2_68f7bd7a:

    # mc "So? What do you want to hear?"
    mc "Итак? Что ты хочешь услышать?"

# game/Story03.rpy:6906
translate russian act3_5chapter2_581e9bbe:

    # k "The whole world’s a stage, and we’re all actors. Deep thoughts in your head, aren't they?"
    k "Весь мир - театр, а мы все актёры. У тебя в голове глубокие мысли, да?"

# game/Story03.rpy:6908
translate russian act3_5chapter2_7ad5f242:

    # mc "First, stop crawling into my head. Second, that's just a quote."
    mc "Во-первых, перестань лезть мне в голову. Во-вторых, это просто цитата."

# game/Story03.rpy:6910
translate russian act3_5chapter2_748df167:

    # k "Is it? Then tell me — what do you think of actresses?"
    k "Правда? Тогда скажи мне - что ты думаешь об актрисах?"

# game/Story03.rpy:6912
translate russian act3_5chapter2_8fcfabf2:

    # mc "You can read my mind can't you?"
    mc "Ты можешь читать мысли, помнишь?"

# game/Story03.rpy:6915
translate russian act3_5chapter2_6223efba:

    # k "I want to hear it, not steal it from your skull. A live voice is so much more fun."
    k "Я хочу услышать это, а не выкрасть из твоей головы. Живой голос гораздо интереснее."

# game/Story03.rpy:6919
translate russian act3_5chapter2_d6314bd9:

    # mc "Actresses? They play their part, crowd claps, curtain falls. That’s it."
    mc "Актрисы? Они играют свою роль, публика аплодирует, занавес опускается. Вот и всё."

# game/Story03.rpy:6921
translate russian act3_5chapter2_db6ccace:

    # mc "What else is there to understand?"
    mc "Что ещё нужно понимать?"

# game/Story03.rpy:6923
translate russian act3_5chapter2_82091822_3:

    # k "..."
    k "..."

# game/Story03.rpy:6925
translate russian act3_5chapter2_bee86476:

    # mc "But you asked for a reason. Why? What’s on your mind?"
    mc "Но ты спросила не просто так. Почему? Что у тебя на уме?"

# game/Story03.rpy:6926
translate russian act3_5chapter2_963ac8d7:

    # k "Not curious?"
    k "Не любопытно?"

# game/Story03.rpy:6929
translate russian act3_5chapter2_45bb1b77:

    # k "They’re true artists. Life’s the stage, and their paints are pain and suffering."
    k "Они настоящие художники. Жизнь - это сцена, а их краски - это боль и страдания."

# game/Story03.rpy:6933
translate russian act3_5chapter2_db037c4d:

    # k "Every stroke, every ounce of misery becomes… beautiful."
    k "Каждый мазок, каждая капля страдания становится... прекрасной."

# game/Story03.rpy:6937
translate russian act3_5chapter2_497ceee9:

    # mc "You see beauty where most don’t. Strange taste, but… fine. I’ll take your word for it."
    mc "Ты видишь красоту там, где большинство её не видит. Странный вкус, но... ладно. Я поверю тебе на слово."

# game/Story03.rpy:6939
translate russian act3_5chapter2_82091822_4:

    # k "..."
    k "..."

# game/Story03.rpy:6941
translate russian act3_5chapter2_92413685:

    # mc "How long are we stuck in this can?"
    mc "Долго нам ещё торчать в этой жестянке?"

# game/Story03.rpy:6943
translate russian act3_5chapter2_bd97dd6c:

    # gg "Another ten minutes."
    gg "Ещё десять минут."

# game/Story03.rpy:6950
translate russian act3_5chapter2_00ebe152:

    # mc "Ten minutes. Long enough to think too much. Any ideas, what was that?"
    mc "Десять минут. Достаточно долго, чтобы хорошенько подумать. Есть идеи, что это было?"

# game/Story03.rpy:6952
translate russian act3_5chapter2_a5a8d775:

    # gg "There are a couple of theories, but none really explain what's happening."
    gg "Есть несколько теорий, но ни одна из них не объясняет, что происходит."

# game/Story03.rpy:6954
translate russian act3_5chapter2_6b4e4f1d:

    # mc "Not much. I was hoping for at least a hint."
    mc "Маловато. Я надеялся хотя бы на намёк."

# game/Story03.rpy:6956
translate russian act3_5chapter2_15f75b71:

    # gg "By appearance — a Faceless, but with an abnormal ability. Either a mutation, or something new."
    gg "По внешнему виду - Безликий, но с аномальной способностью. Либо мутация, либо что-то новое."

# game/Story03.rpy:6959
translate russian act3_5chapter2_900695d0:

    # gggg "I've never had the honor of being a test rat before."
    gggg "Я никогда раньше не имел чести быть подопытной крысой."

# game/Story03.rpy:6961
translate russian act3_5chapter2_b6d3481c:

    # mc "(That thing came for us. Something doesn’t add up…)"
    mc "(Эта штука пришла за нами. Что-то не сходится...)"

# game/Story03.rpy:6963
translate russian act3_5chapter2_48fa1c88:

    # mc "What was the plan before all this fell apart?"
    mc "Какой был план до того, как всё пошло через жопу?"

# game/Story03.rpy:6965
translate russian act3_5chapter2_c13ba05b:

    # gg "Originally, we were evacuating your civilians. But later the order was revoked, and we were told to return."
    gg "Изначально мы эвакуировали ваших гражданских. Но позже приказ был отменён, и нам велели вернуться."

# game/Story03.rpy:6966
translate russian act3_5chapter2_fea73b5d:

    # gg "With no explanation."
    gg "Без объяснений."

# game/Story03.rpy:6969
translate russian act3_5chapter2_9d9d6f45:

    # g "You received that; The rest have different orders. They'll head to assist the peacekeepers"
    g "Вы получили этот приказ, остальные - другой. Отправиться на помощь миротворцам."

# game/Story03.rpy:6970
translate russian act3_5chapter2_26258c3b:

    # g "Back where you came from."
    g "Туда, откуда вы пришли."

# game/Story03.rpy:6972
translate russian act3_5chapter2_6bd24c89:

    # gggg "All of this looks like madness. As if command itself has no clue what's going on."
    gggg "Всё это похоже на безумие. Как будто само командование не имеет понятия, что происходит."

# game/Story03.rpy:6976
translate russian act3_5chapter2_2e81bcd4:

    # gg "For now, we need to come back alive. We'll deal with the rest later."
    gg "Пока что нам нужно вернуться живыми. Остальным займёмся позже."

# game/Story03.rpy:6978
translate russian act3_5chapter2_dc12a94c:

    # gggg "That's for sure, and with hope and faith it's easier to walk toward a goal. Right, commander?"
    gggg "Это точно. И с надеждой и верой легче идти к цели. Верно, командир?"

# game/Story03.rpy:6985
translate russian act3_5chapter2_c5af235e:

    # mc "(Summing up...)"
    mc "(Подводя итог...)"

# game/Story03.rpy:6986
translate russian act3_5chapter2_d0964bc0:

    # mc "(Maiden is silent, Kalestra... as always. Little is known about the mutant, the orders from above are strange.)"
    mc "(Дева молчит. Калестра... как всегда. О мутанте мало что известно. Приказы сверху странные.)"

# game/Story03.rpy:6987
translate russian act3_5chapter2_c3cb703f:

    # mc "(The situation is unstable. We need to stick together to survive.)"
    mc "(Ситуация нестабильна. Нам нужно держаться вместе, чтобы выжить.)"

# game/Story03.rpy:6988
translate russian act3_5chapter2_f9f4b5c6:

    # mc "(Indeed, we can't do without faith and hope.)"
    mc "(В самом деле, без веры и надежды не обойтись.)"

# game/Story03.rpy:6991
translate russian act3_5chapter2_93457446:

    # L "If you're reading — it means you're alive. Which means — hold on. Just survive. No heroics. Just… survive."
    L "Если ты читаешь это - значит, ты жив. А это значит: держись. Не геройствуй. Просто... выживи."

# game/Story03.rpy:6996
translate russian act3_5chapter2_00b5f77c:

    # mc "Right, for their sake."
    mc "Верно, ради них."

# game/Story03.rpy:6997
translate russian act3_5chapter2_fcfb7c20:

    # mc "I have to survive, whatever it costs."
    mc "Я должен выжить, чего бы это ни стоило."

# game/Story03.rpy:7004
translate russian act3_5chapter2_a68496df:

    # mc "Nothing to say?"
    mc "Нечего сказать?"

# game/Story03.rpy:7009
translate russian act3_5chapter2_a69f6d14:

    # mc "Understood. So be it."
    mc "Понятно. Да будет так."

# game/Story03.rpy:7012
translate russian act3_5chapter2_aaa27d53:

    # mc "Since we're supposed to work as a team — maybe introduce ourselves?"
    mc "Раз мы должны работать в команде, может, представимся?"

# game/Story03.rpy:7013
translate russian act3_5chapter2_a7b35a62:

    # mc "Your names."
    mc "Ваши имена."

# game/Story03.rpy:7016
translate russian act3_5chapter2_f9acd091:

    # gg "My name is Nyx."
    gg "Меня зовут Никс."

# game/Story03.rpy:7019
translate russian act3_5chapter2_b76bb8ca:

    # gg "This big guy is Echo."
    gg "Этот крупный парень - Эхо."

# game/Story03.rpy:7020
translate russian act3_5chapter2_d6dbc95f:

    # gggg "Ha-ha... It's odd to hear my name outside the kitchen. Nice to meet you."
    gggg "Ха-ха... Странно слышать свою имя за пределами кухни. Приятно познакомиться."

# game/Story03.rpy:7022
translate russian act3_5chapter2_a28e71ff:

    # gg "The one who was rude to you — Brain."
    gg "Тот, кто был с вами груб - Брайн."

# game/Story03.rpy:7023
translate russian act3_5chapter2_d053a68f:

    # g "Hmph. They don't need to know the delivery guy's name."
    g "Хмпх. Им не нужно знать имя доставщика."

# game/Story03.rpy:7026
translate russian act3_5chapter2_d286d82d:

    # gg "This is Leo, our tech specialist and pyro."
    gg "Это Лео, наш технических специалист и пиротехник."

# game/Story03.rpy:7027
translate russian act3_5chapter2_a3d5572e:

    # gggg "Need something fixed, stolen, or just implants checked? I'm at your service."
    gggg "Нужно что-то починить, украсть или просто проверить импланты? Я к вашим услугам."

# game/Story03.rpy:7029
translate russian act3_5chapter2_9a99737b:

    # gg "The others, right to left: Nemo, Hedy, Sike, and Ava."
    gg "Остальные, справа налево: Немо, Хеди, Сайк и Ава."

# game/Story03.rpy:7032
translate russian act3_5chapter2_0ae2de7b:

    # mc "My name is [mc]."
    mc "Меня зовут [mc!t]."

# game/Story03.rpy:7035
translate russian act3_5chapter2_f0d1c72b:

    # mc "And hers..."
    mc "А её..."

# game/Story03.rpy:7038
translate russian act3_5chapter2_7e1d8063:

    # k "Kalestra. One and only. I'm here only because of him… and with him — because of boredom."
    k "Калестра. Единственная и неповторимая. Я здесь только из-за него... а с ним - из-за скуки."

# game/Story03.rpy:7042
translate russian act3_5chapter2_4f5437dd:

    # mc "And the second..."
    mc "А вторая..."

# game/Story03.rpy:7046
translate russian act3_5chapter2_c469651c:

    # mc "Got it. Stubborn."
    mc "Ясно. Упрямая."

# game/Story03.rpy:7050
translate russian act3_5chapter2_82091822_5:

    # k "..."
    k "..."

# game/Story03.rpy:7052
translate russian act3_5chapter2_93334484:

    # k "What?"
    k "Что?"

# game/Story03.rpy:7054
translate russian act3_5chapter2_a0cae81e:

    # mc "(whisper) I wanted to ask about her, but you know... forget it."
    mc "{i}*шепчет*{/i} Я хотел спросить о ней, но, знаешь... забудь."

# game/Story03.rpy:7056
translate russian act3_5chapter2_f17be527:

    # k "(Don't look at me like that — I answer for myself, and no one else.)"
    k "(Не смотри на меня так. Я отвечаю за себя, и ни за кого больше.)"

# game/Story03.rpy:7058
translate russian act3_5chapter2_bb753343:

    # mc "From now on we'll call each other by name. No nicknames, no monikers. You don't mind?"
    mc "С этого момента мы будем называть друг друга по именам. Никаких прозвищ, никаких кличек. Вы не против?"

# game/Story03.rpy:7060
translate russian act3_5chapter2_8d049099:

    # gg "Fine."
    gg "Хорошо."

# game/Story03.rpy:7062
translate russian act3_5chapter2_f85ee3df:

    # mc "(For her... for everyone who still breathes. I have to survive. Even if I have to bite my way through.)"
    mc "(Ради неё... Ради всех, кто ещё дышит. Я должен выжить. Даже если для этого придётся прогрызать себе путь.)"

# game/Story03.rpy:7064
translate russian act3_5chapter2_0512330b:

    # mc "Now we know each other's names. So if we end up dying — we'll die as people. But better yet — let's die as the living."
    mc "Теперь мы знаем имена друг друга. Так что, если нам суждено встретить смерть, мы встретим её людьми. Но ещё лучше - давайте встретим её живыми."

# game/Story03.rpy:7065
translate russian act3_5chapter2_cc6b5234:

    # mc "Alright then, let's go."
    mc "Ладно, пойдёмте."

# game/Story03.rpy:7083
translate russian act3_5chapter2_5c558797:

    # a "Ah… history repeats itself. Predictable as ever."
    a "Ах... история повторяется. Как всегда предсказуемо."

# game/Story03.rpy:7084
translate russian act3_5chapter2_26694e5f:

    # y "You… you swore! The Lower City was off-limits!"
    y "Ты... ты клялась! Нижний город был запретной зоной!"

# game/Story03.rpy:7087
translate russian act3_5chapter2_1dae9a31:

    # a "And you believed that oath meant anything?"
    a "И ты верил, что эта клятва что-то значит?"

# game/Story03.rpy:7088
translate russian act3_5chapter2_87ba2748:

    # a "One task. Escort the boy to the tower. Simple. Elegant. And yet — he’s here."
    a "Одна задача. Сопроводить мальчишку к башне. Просто. Элегантно. И всё же - он здесь."

# game/Story03.rpy:7090
translate russian act3_5chapter2_b5852ef1:

    # a "Pathetic. Mortals always crumble when it matters most. So once again, I must correct your failure."
    a "Жалко. Смертные всегда ломаются, когда это важнее всего. Так что я снова должна исправлять твою ошибку."

# game/Story03.rpy:7113
translate russian act3_5chapter2_1_09b69430:

    # mc "(The smell of burning, scorched walls, mutant corpses. A sight not for the faint-hearted.)"
    mc "(Запах гари, обгоревшие стены, мутировавшие трупы. Зрелище не для слабонервных.)"

# game/Story03.rpy:7117
translate russian act3_5chapter2_1_ee87ded2:

    # k "Ah… the smell. Charred walls, rotting freaks. Feels almost cozy."
    k "Ах... этот запах. Обгоревшие стены, гниющие уроды. Почти уютно."

# game/Story03.rpy:7119
translate russian act3_5chapter2_1_2b35b6fe:

    # mc "..."
    mc "..."

# game/Story03.rpy:7125
translate russian act3_5chapter2_1_e35dbfbd:

    # mc "Whoever did this knew exactly what they were doing."
    mc "Кто бы это ни сделал, он точно знал, что делает."

# game/Story03.rpy:7127
translate russian act3_5chapter2_1_9621c198:

    # k "Or rather — whoever did this had style. A true artist at work."
    k "Или, скорее, кто бы это ни сделал, он имел стиль. Работа настоящего художника."

# game/Story03.rpy:7132
translate russian act3_5chapter2_1_61308746:

    # k "Almost makes me jealous."
    k "Почти заставляет меня завидовать."

# game/Story03.rpy:7135
translate russian act3_5chapter2_1_87762c12:

    # mc "I have no doubt about that."
    mc "Не сомневаюсь."

# game/Story03.rpy:7138
translate russian act3_5chapter2_1_bb8e4b4e:

    # a "..."
    a "..."

# game/Story03.rpy:7140
translate russian act3_5chapter2_1_5794f5b7:

    # mc "Well? Anything worth noting?"
    mc "Ну? Есть что-нибудь примечательное?"

# game/Story03.rpy:7148
translate russian act3_5chapter2_1_ba08faf1:

    # mc "(So you’re staying quiet till the end? Fine…)"
    mc "(Значит, будешь молчать до конца? Ладно...)"

# game/Story03.rpy:7150
translate russian act3_5chapter2_1_1ae5d572:

    # gg "[mc] over here! Might be useful."
    gg "[mc!t], сюда! Может пригодиться."

# game/Story03.rpy:7153
translate russian act3_5chapter2_1_13274333:

    # mc "Nyx? What’ve you got?"
    mc "Никс? Что у тебя?"

# game/Story03.rpy:7156
