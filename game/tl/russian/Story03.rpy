translate russian akt3chapter2_d24a9262:

    # mc "Those the ones?"
    mc "Это они?"

# game/Story03.rpy:2337
translate russian akt3chapter2_90088bd9:

    # a "Syndicate. Pitiful sight."
    a "Синдикатовцы. Жалкое зрелище."

# game/Story03.rpy:2338
translate russian akt3chapter2_7e55beb6:

    # a "So it’s rotting faster than I thought."
    a "Значит, всё гниёт быстрее, чем я думала."

# game/Story03.rpy:2340
translate russian akt3chapter2_1aaaba6c:

    # mc "Aren’t you supposed to be enemies?"
    mc "Разве вы не враги?"

# game/Story03.rpy:2343
translate russian akt3chapter2_e3a82344:

    # a "Kalestra talks too much."
    a "Калестра слишком много болтает."

# game/Story03.rpy:2350
translate russian akt3chapter2_fabef0c1:

    # a "Let’s go."
    a "Пойдём."

# game/Story03.rpy:2353
translate russian akt3chapter2_fd64c5d5:

    # mc "You seemed to be doing just fine."
    mc "Казалось, вы и без нас прекрасно справлялись."

# game/Story03.rpy:2355
translate russian akt3chapter2_446e37bc:

    # g "We were. Didn’t need your fancy gear or pity."
    g "Справлялись. Нам не нужны ваше модное снаряжение или жалость."

# game/Story03.rpy:2356
translate russian akt3chapter2_d7a4ec40:

    # mc "Sure. Screaming ‘help’ is just part of the strategy, huh?"
    mc "Ага, конечно. Кричать \"помогите\" - это просто часть стратегии, да?"

# game/Story03.rpy:2359
translate russian akt3chapter2_878374e7:

    # gg "Drop the pride, Brayne. They saved us. Show some gratitude."
    gg "Отбрось гордость, Брайн. Они нас спасли. Прояви немного благодарности."

# game/Story03.rpy:2362
translate russian akt3chapter2_6a7d98b3:

    # gg "Thanks for helping. And sorry for his manners."
    gg "Спасибо за помощь. И простите за его манеры."

# game/Story03.rpy:2364
translate russian akt3chapter2_c5c4ec8f:

    # a "Is that all?"
    a "Это все?"

# game/Story03.rpy:2367
translate russian akt3chapter2_133e958c:

    # gg "No. We split from the main squad."
    gg "Нет. Мы отделились от основного отряда."

# game/Story03.rpy:2369
translate russian akt3chapter2_765d6112:

    # mc "Main squad? Did you see a redhead — short — and a dark-haired woman with a scar?"
    mc "Основной отряд? Вы видели рыжеволосую невысокого роста и темноволосую женщину со шрамом?"

# game/Story03.rpy:2372
translate russian akt3chapter2_57ee6b52:

    # g "Hmph... Why would you care?"
    g "Хмпф... А тебе-то какое дело?"

# game/Story03.rpy:2374
translate russian akt3chapter2_0d04f1a6:

    # gg "Enough with the tantrums."
    gg "Хватит истерить."

# game/Story03.rpy:2381
translate russian akt3chapter2_3c125a1a:

    # g "Yeah, we saw them. Would’ve been dead without their help."
    g "Да, видели. Без их помощи мы бы погибли."

# game/Story03.rpy:2383
translate russian akt3chapter2_42ae0448:

    # a "Direction."
    a "Направление."

# game/Story03.rpy:2387
translate russian akt3chapter2_f5b027bc:

    # gg "To the fallback point."
    gg "К запасному пункту."

# game/Story03.rpy:2390
translate russian akt3chapter2_2da34572:

    # gg "Forces split. Some stayed to defend the lower city..."
    gg "Силы разделились. Некоторые остались защищать Нижний город..."

# game/Story03.rpy:2392
translate russian akt3chapter2_2845b514:

    # mc "...and the rest went to the peacekeepers."
    mc "...А остальные перешли к миротворцам."

# game/Story03.rpy:2393
translate russian akt3chapter2_55717329:

    # gg "Exactly."
    gg "Именно."

# game/Story03.rpy:2396
translate russian akt3chapter2_b0e97012:

    # mc "(If I go after Lora and Olivia — the lower city might fall. With it, Miriel and the others...)"
    mc "(Если я пойду за Лорой и Оливией, Нижний город может пасть. А вместе с ним и Мириэль с остальными...)"

# game/Story03.rpy:2398
translate russian akt3chapter2_9533a5fe:

    # mc "(If I go to the peacekeepers — I risk the entire planet...)"
    mc "(Если я пойду к миротворцам, я рискую всей планетой...)"

# game/Story03.rpy:2399
translate russian akt3chapter2_1e60223c:

    # mc "(That’s not a choice. That’s two death sentences.)"
    mc "(Это не выбор. Это два смертных приговора.)"

# game/Story03.rpy:2412
translate russian akt3chapter2_f29ede01:

    # n "And now, please forgive me. But this route will be available in the next hotfix. It’s just... too much content for now."
    n "А сейчас, пожалуйста, простите меня. Но этот путь будет доступен в следующем обновлении. Просто... сейчас слишком много контента."

# game/Story03.rpy:2416
translate russian akt3chapter2_241aba70:

    # mc "Alright. Then — let’s move."
    mc "Ладно. Тогда вперёд."

# game/Story03.rpy:2423
translate russian akt3chapter2_716986f4:

    # mc "Where did they go?"
    mc "Куда они ушли?"

# game/Story03.rpy:2425
translate russian akt3chapter2_bc30750b:

    # gg "I’ll guide you."
    gg "Я вас проведу."

# game/Story03.rpy:2427
translate russian akt3chapter2_cbc7efb6:

    # a "And the rest?"
    a "А они?"

# game/Story03.rpy:2429
translate russian akt3chapter2_ee3ec44a:

    # g "None of your da—"
    g "Не твоё де—"

# game/Story03.rpy:2431
translate russian akt3chapter2_50492e52:

    # gg "They’re going to defend the lower city."
    gg "Они идут на защиту Нижнего города."

