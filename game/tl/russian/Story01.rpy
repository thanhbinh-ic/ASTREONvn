    # mc "Maybe not. But I can try."
    mc "Возможно. Но я могу попробовать."

# game/Story01.rpy:3412
translate russian HelpArc_3ccbffda:

    # g "Sorry to interrupt. You’re free to go."
    g "Простите, что прерываю. Вы можете идти."

