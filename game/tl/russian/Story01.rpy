translate russian choice1_72382877:

    # mc "(That guy…)"
    mc "(Тот парень...)"

# game/Story01.rpy:4906
translate russian choice1_8d7c7e66:

    # mc "(Why him?)"
    mc "(Почему он?)"

# game/Story01.rpy:4911
translate russian choice1_f8f8bce7:

    # mc "(Lora’s from here… and he’s the one who dragged me back here too...)"
    mc "(Лора отсюда... и он тоже притащил меня обратно сюда...)"

# game/Story01.rpy:4914
translate russian choice1_a51792f5:

    # mc "(Dragged… hell, more like pulled me back from the dead.)"
    mc "(Притащил... черт, скорее вытащил с того света.)"

# game/Story01.rpy:4919
translate russian choice1_d66f7e90:

    # lad "Find a way out."
    lad "Найди выход."

# game/Story01.rpy:4924
translate russian choice1_1756ec14:

    # lad "Then we’ll talk."
    lad "Тогда поговорим."

# game/Story01.rpy:4929
translate russian choice1_530e56c0:

    # mc "(A way out… What did she mean by that?)"
    mc "(Выход... Что она имела в виду?)"

# game/Story01.rpy:4930
translate russian choice1_ea6f1ad4:

    # mc "(I don’t get it…)"
    mc "(Не понимаю...)"

# game/Story01.rpy:4943
translate russian choice1_4eb5f368:

    # mc "(This isn’t Earth. That much is clear.)"
    mc "(Это не Земля. Тут все ясно.)"

# game/Story01.rpy:4944
translate russian choice1_b24e20fc:

    # mc "(But life here… it’s a damn nightmare.)"
    mc "(Но жизнь здесь... настоящий кошмар.)"

# game/Story01.rpy:4952
translate russian choice1_729a8fd1:

    # Mi "Every day… millions die at the front."
    Mi "Каждый день... на фронте гибнут миллионы."

# game/Story01.rpy:4955
translate russian choice1_83b3b8e7:

    # Mi "Saving lives."
    Mi "Спасая жизни."

# game/Story01.rpy:4956
translate russian choice1_d5fd0dfb:

    # Mi "Killing monsters."
    Mi "Убивая чудовищ."

# game/Story01.rpy:4959
translate russian choice1_581cd62c:

    # mc "(A human life here is worth less than a box of ammo.)"
    mc "(Человеческая жизнь здесь стоит меньше ящика патронов.)"

# game/Story01.rpy:4967
translate russian choice1_8f7cc81f:

    # mc "(And yet…)"
    mc "(И все же...)"

# game/Story01.rpy:4970
translate russian choice1_8a496ad7:

    # mc "(This world… it’s something else.)"
    mc "(Этот мир... он совсем другой.)"

# game/Story01.rpy:4973
translate russian choice1_8d353693:

    # mc "(At least on the surface.)"
    mc "(По крайней мере на поверхности.)"

# game/Story01.rpy:4978
translate russian choice1_fb4b91bf:

    # mc "(But the deeper you go, the more you see how rotten it really is.)"
    mc "(Но чем глубже спускаешься, тем яснее видишь, насколько он гнилой.)"

# game/Story01.rpy:4981
translate russian choice1_c987e3c7:

    # gg "Were you that desperate to steal my food—"
    gg "Вам так приспичило украсть мою еду-"

# game/Story01.rpy:4984
translate russian choice1_cf3cf208:

    # g "Look at you… fussing over some elf girl..."
    g "Посмотри на себя... носишься с какой-то эльфийской девчонкой..."

# game/Story01.rpy:4987
translate russian choice1_5fd51c99:

    # Mi "…Not from people like you."
    Mi "...Только не от таких, как ты."

# game/Story01.rpy:4988
translate russian choice1_e12472f4:

    # Mi "…You’re human."
    Mi "...Ты человек."

# game/Story01.rpy:5005
translate russian choice1_3de4e259:

    # mc "(The Mistress… that’s what everyone calls her.)"
    mc "(Госпожа... так ее все называют.)"

# game/Story01.rpy:5006
translate russian choice1_19026d91:

    # mc "(Said Lora is alive. No proof. Just words.)"
    mc "(Сказала, что Лора жива. Ни доказательств. Просто слова.)"

# game/Story01.rpy:5011
translate russian choice1_84919b03:

    # mc "(But from what I’ve pieced together…)"
    mc "(Но если собрать то, что я знаю...)"

# game/Story01.rpy:5014
translate russian choice1_3fd19999:

    # Mi "…He’s like the other two scientists."
    Mi "...Он такой же, как те двое ученых."

# game/Story01.rpy:5017
translate russian choice1_d783c35b:

    # mc "What...Lora...doing..."
    mc "Что... Лора... делает..."

# game/Story01.rpy:5018
translate russian choice1_83b3b8e7_1:

    # Mi "Saving lives."
    Mi "Спасает жизни."

# game/Story01.rpy:5019
translate russian choice1_d5fd0dfb_1:

    # Mi "Killing monsters."
    Mi "Убивает чудовищ."

# game/Story01.rpy:5022
translate russian choice1_90c3cba1:

    # mc "Why take that kind of risk…"
    mc "Зачем идти на такой риск..."

# game/Story01.rpy:5023
translate russian choice1_b0edbc8f:

    # Mi "To survive."
    Mi "Чтобы выжить."

# game/Story01.rpy:5028
translate russian choice1_01476a1f:

    # L "I can feel it spreading…"
    L "Я чувствую, как оно расползается..."

# game/Story01.rpy:5035
translate russian choice1_28fd6919:

    # mc "Lora was under surveillance."
    mc "За Лорой следили."

# game/Story01.rpy:5036
translate russian choice1_1134ccca:

    # Mi "…She was being hunted."
    Mi "...На нее охотились."

# game/Story01.rpy:5038
translate russian choice1_77a7c007:

    # mc "(She keeps to the shadows.)"
    mc "(Она держится в тени.)"

# game/Story01.rpy:5061
translate russian choice1_833e1938:

    # o "You don’t want to cross her on a bad day."
    o "Ты не захочешь перейти ей дорогу в плохой день."

# game/Story01.rpy:5062
translate russian choice1_39a2114c:

    # o "The Lady."
    o "Госпоже."

# game/Story01.rpy:5064
translate russian choice1_684f5e27:

    # mc "(People talk about her like she’s a ghost.)"
    mc "(Люди говорят о ней так, будто она призрак.)"

# game/Story01.rpy:5065
translate russian choice1_c4ffc0bb:

    # mc "(Something that only exists when it chooses to.)"
    mc "(Нечто, что существует только тогда, когда само этого хочет.)"

# game/Story01.rpy:5071
translate russian choice1_beb69513:

    # mc "(And that scares me more than I’d like to admit.)"
    mc "(И это пугает меня сильнее, чем я готов признать.)"

# game/Story01.rpy:5073
translate russian choice1_b1d5cbad:

    # mc "(What does she want from me?)"
    mc "(Что ей от меня нужно?)"

# game/Story01.rpy:5074
translate russian choice1_d7c3b2d0:

    # mc "(Why am I worth the trouble?)"
    mc "(Почему я стою всех этих хлопот?)"

# game/Story01.rpy:5091
translate russian HelpArc_0c0f4a3f:

    # a "Please... no! Don’t!"
    a "Пожалуйста... нет! Не надо!"

# game/Story01.rpy:5102
