translate russian firstanswernext_9ad00e5c:

    # mc "Doors were sealed. Robots damaged. And the things inside — they shouldn’t have been moving."
    mc "Двери были запечатаны. Роботы повреждены. А то, что было внутри - не должно было двигаться."

# game/Story01.rpy:1703
