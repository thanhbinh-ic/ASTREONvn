translate russian olivia_fr_scene_87e9a4d4:

    # h "Almost forgot what it felt like to stretch around something this... intense."
    h "Почти забыла, каково это - растягиваться вокруг чего-то такого... интенсивного."

# game/Story01.rpy:7439
