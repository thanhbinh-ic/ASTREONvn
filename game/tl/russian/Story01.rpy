    # g "She’s—"
    g "Она-"

# game/Story01.rpy:3454
translate russian HelpArc_09ed15c9:

    # o "So her blood makes her less human? That what you believe?"
    o "Так кровь делает её менее человечной? Так ты считаешь?"

