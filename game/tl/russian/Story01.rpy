translate russian final2_ee318afa:

    # g "(Where the hell are they...)"
    g "(Где они, чёрт возьми...)"

# game/Story01.rpy:6886
translate russian final2_f6c09a38:

    # o "DETONATE IT! NOW!"
    o "ВЗРЫВАЙ! ЖИВО!"

