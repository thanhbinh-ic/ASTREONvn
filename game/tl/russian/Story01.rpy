    Fl "Я... прости. Сейчас от меня никакого толку."

# game/Story01.rpy:7544
translate russian cyberstreet1_bb15f912_2:

    # mc "Flora?"
    mc "Флора?"

# game/Story01.rpy:7545
translate russian cyberstreet1_8a784eb6:

