    # h "So let’s see if Lora exaggerated... or not."
    h "Посмотрим, преувеличивала Лора... или нет."

# game/Story01.rpy:7430
translate russian olivia_fr_scene_2fded262_4:

    # h "..."
    h "..."

# game/Story01.rpy:7432
translate russian olivia_fr_scene_2c77a334:

    # mc "Everything okay? You just went quiet."
    mc "Всё хорошо? Ты резко притихла."

