translate russian path_second_up_3_3_ad3cdafc:

    # mc "(…behind me. Too hot.)"
    mc "(...за мной. Слишком горячо.)"

# game/Story01.rpy:7658
translate russian path_second_up_3_3_183cce60:

    # mc "(…I know.)"
    mc "(...Я знаю.)"

# game/Story01.rpy:7666
translate russian path_second_up_3_3_ebb9da9d:

    # mc "(…die—)"
    mc "(...умру-)"

# game/Story01.rpy:7671
translate russian path_second_up_3_3_239493a4:

    # mc "(That wasn’t a soulless.)"
    mc "(Это был не Бездушный.)"

# game/Story01.rpy:7674
translate russian path_second_up_3_3_731c66f9:

    # mc "Flora, I need everything you’ve got on that thing."
    mc "Флора, мне нужно все, что у тебя есть по этой твари."

# game/Story01.rpy:7675
translate russian path_second_up_3_3_cd93bcc9:

    # Fl "Y-yeah! Give me a second— I’m checking."
    Fl "Д-да! Дай секунду, я проверяю."

