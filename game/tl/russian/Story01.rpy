translate russian path_second_up_3_3_19949fd0:

    # mc "“Hello to everyone I couldn’t see!”"
    mc "\"Всем, кого не вижу, привет!\""

# game/Story01.rpy:7768
translate russian path_second_up_3_3_41da62cb:

    # Fl "..."
    Fl "..."

# game/Story01.rpy:7769
translate russian path_second_up_3_3_109b2e6e:

    # Fl "*A faint, almost reluctant chuckle.*"
    Fl "*Тихий, почти неохотный смешок.*"

# game/Story01.rpy:7771
translate russian path_second_up_3_3_035be45d:

    # Fl "…Okay, yeah."
    Fl "...Ладно, да."

# game/Story01.rpy:7772
translate russian path_second_up_3_3_60399158:

    # Fl "That was stupid."
    Fl "Это было тупо."

# game/Story01.rpy:7773
translate russian path_second_up_3_3_1df7826f:

    # Fl "But I’ll give you that— it was funny."
    Fl "Но признаю - смешно."

# game/Story01.rpy:7775
translate russian path_second_up_3_3_4f1f813b:

    # Fl "…and..."
    Fl "...и..."

# game/Story01.rpy:7776
translate russian path_second_up_3_3_56de9b62:

    # Fl "...thanks."
    Fl "...спасибо."

# game/Story01.rpy:7779
translate russian path_second_up_3_3_8b9a44df:

    # mc "We don’t forget."
    mc "Мы не забываем."

# game/Story01.rpy:7785
translate russian path_second_up_3_3_ab473ab9:

    # Fl "Right."
    Fl "Верно."

# game/Story01.rpy:7787
translate russian path_second_up_3_3_2cd89ca2:

    # Fl "Focus."
    Fl "Сосредоточимся."

# game/Story01.rpy:7788
translate russian path_second_up_3_3_616a575e:

    # Fl "We’re here for information."
    Fl "Мы здесь за информацией."

# game/Story01.rpy:7791
translate russian path_second_up_3_3_643ddf19:

    # mc "I’ll handle it."
    mc "Я разберусь."

# game/Story01.rpy:7794
translate russian path_second_up_3_3_ea62f8dd:

    # g "What about the civilians? We can’t deploy Titans in here."
    g "А гражданские? Мы не можем развернуть здесь Титанов."

# game/Story01.rpy:7796
translate russian path_second_up_3_3_f5b68726:

    # gg "If we just sit on this, the city’s going down!"
    gg "Если будем сидеть сложа руки, город падет!"

# game/Story01.rpy:7798
translate russian path_second_up_3_3_231f5771:

    # ex "We clear the civilians. Fast."
    ex "Выводим гражданских. Быстро."

# game/Story01.rpy:7799
translate russian path_second_up_3_3_214cc10b:

    # ex "Then we burn this sector to the ground. No hesitation."
    ex "Потом выжигаем сектор дотла. Без колебаний."

# game/Story01.rpy:7801
translate russian path_second_up_3_3_52ed70c5:

    # g "That’s insanity!"
    g "Это безумие!"

# game/Story01.rpy:7802
translate russian path_second_up_3_3_d23dcf01:

    # ex "No. That’s containment."
    ex "Нет. Это локализация."

# game/Story01.rpy:7803
translate russian path_second_up_3_3_ff65d8f7:

    # ex "Sector 6 is still holding."
    ex "Сектор 6 еще держится."

# game/Story01.rpy:7804
translate russian path_second_up_3_3_c91c8793:

    # ex "When it breaks and it will— we’re next in line."
    ex "Когда он рухнет, а он рухнет, следующими будем мы."

# game/Story01.rpy:7807
translate russian path_second_up_3_3_a4285e2b:

    # ex "...You."
    ex "...Ты."

# game/Story01.rpy:7808
translate russian path_second_up_3_3_53e77041:

    # ex "...you’re that ear-girl’s friend, aren’t you?"
    ex "...ты друг той ушастой девчонки, да?"

# game/Story01.rpy:7809
translate russian path_second_up_3_3_d411768e:

    # ex "What’s an Inquisition lapdog doing in my warzone?"
    ex "Что цепной пес Инквизиции делает в моей зоне боевых действий?"

# game/Story01.rpy:7810
translate russian path_second_up_3_3_f8825e66:

    # mc "Lower your voice."
    mc "Говори тише."

# game/Story01.rpy:7811
