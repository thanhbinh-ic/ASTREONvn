translate russian path_second_up_3_3_ebfadef9:

    # Fl "Soulless."
    Fl "Бездушные."

# game/Story01.rpy:7567
translate russian path_second_up_3_3_0ff4c83a:

    # Fl "Mutants driven by hunger… and rage."
    Fl "Мутанты, которыми движут голод... и ярость."

# game/Story01.rpy:7568
translate russian path_second_up_3_3_3801e079:

    # mc "Weaknesses?"
    mc "Слабости?"

# game/Story01.rpy:7572
translate russian path_second_up_3_3_2fb56a12:

    # Fl "No idea…"
    Fl "Без понятия..."

# game/Story01.rpy:7573
translate russian path_second_up_3_3_689b7fbd:

    # Fl "But kill one, and two more show up in its place."
    Fl "Но убьешь одного - на его месте появятся еще двое."

# game/Story01.rpy:7575
translate russian path_second_up_3_3_c011e17b:

    # Fl "Not literally."
    Fl "Не буквально."

# game/Story01.rpy:7577
translate russian path_second_up_3_3_47aa2200:

    # Fl "They multiply insanely fast! Like a virus."
