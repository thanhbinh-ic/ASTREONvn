translate russian path_second_up_3_3_8ceb05f1:

    # mc "Sector 8. The comm tower. You know anything about it?"
    mc "Сектор 8. Башня связи. Что-нибудь о ней знаешь?"

# game/Story01.rpy:7706
translate russian path_second_up_3_3_161413b5:

    # g "Uh— yeah."
    g "Эм... да."

# game/Story01.rpy:7707
translate russian path_second_up_3_3_40deb052:

    # g "Come with us. We’ll take you to the commander."
    g "Идем с нами. Мы отведем тебя к командиру."

