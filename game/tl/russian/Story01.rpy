    # mc "(…No.)"
    mc "(...Нет.)"

# game/Story01.rpy:5111
translate russian HelpArc_5f995033:

    # mc "(Damn it.)"
    mc "(Черт.)"

# game/Story01.rpy:5112
translate russian HelpArc_b2db285f:

    # mc "(I can't just stand here.)"
    mc "(Я не могу просто стоять здесь.)"

# game/Story01.rpy:5124
translate russian HelpArc_f2eccfcc:

    # mc "(…Hands still shaking.)"
    mc "(...Руки все еще дрожат.)"

# game/Story01.rpy:5126
translate russian HelpArc_2e983966:

    # Fl "Oh, fantastic."
    Fl "О, великолепно."

# game/Story01.rpy:5140
