translate russian choice1_4276540e:

    # mc "(Should’ve died. Should’ve just stayed dead.)"
    mc "(Я должен был умереть. Должен был просто остаться мертвым.)"

# game/Story01.rpy:4897
translate russian choice1_322b8ded:

    # mc "(And if it weren’t for that guy… Olivia would’ve died too.)"
    mc "(И если бы не тот парень... Оливия тоже бы погибла.)"

