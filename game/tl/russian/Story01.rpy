translate russian firstanswernext_71a86863:

    # y "..."
    y "..."

# game/Story01.rpy:1841
translate russian firstanswernext_8246161d:

    # y "You saw it too, didn’t you?"
    y "Ты тоже это видела, да?"

# game/Story01.rpy:1843
translate russian firstanswernext_91fffc36:

    # a "Saw what?"
