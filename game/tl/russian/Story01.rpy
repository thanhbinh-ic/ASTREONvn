translate russian firstanswernext_5654a191:

    # am "Give it to me — and you’ll get your answers."
    am "Отдай его мне - и ты получишь ответы."

# game/Story01.rpy:1802
translate russian firstanswernext_c508b393:

    # mc "(She’s revealing more than before... maybe I can press her.)"
    mc "(Она раскрывает больше, чем раньше... Может, я смогу на неё надавить.)"

# game/Story01.rpy:1804
translate russian firstanswernext_06833c0a:

    # mc "This isn't enough. I’ve given you far more information than I’ve received in return."
    mc "Этого недостаточно. Я дал вам гораздо больше информации, чем получил в ответ."

# game/Story01.rpy:1808
translate russian firstanswernext_04aba6fb:

    # am "If I fed you the whole truth now, it would choke you."
    am "Если я расскажу тебе всю правду сейчас, ты задохнёшься."

# game/Story01.rpy:1810
translate russian firstanswernext_eb1e3b1a:

    # mc "...What about Norman? Please... don’t dance around this one."
    mc "...Что насчёт Нормана? Пожалуйста... не уклоняйтесь от ответа."

# game/Story01.rpy:1812
translate russian firstanswernext_584eed55:

    # am "He’s dead."
    am "Он мёртв."

# game/Story01.rpy:1814
translate russian firstanswernext_e0715dbc:

    # mc "But-"
    mc "Но-"

# game/Story01.rpy:1816
translate russian firstanswernext_c7f99072:

    # am "No. His time is over. We cannot resurrect him."
    am "Нет. Его время истекло. Мы не можем воскресить его."

# game/Story01.rpy:1820
translate russian firstanswernext_1e3db584:

    # am "No dramatics. {w}You asked. {w}I answered."
    am "Без драматизма. {w}Ты спросил. {w}Я ответила."

# game/Story01.rpy:1821
translate russian firstanswernext_9e3dd379:

    # am "Mourn later — if you survive."
    am "Скорби потом. Если выживешь."

# game/Story01.rpy:1825
translate russian firstanswernext_71a58748:

    # y "That was unusually... generous of you. You’ve always preferred silence to sympathy."
    y "Это было необычно... великодушно с вашей стороны. Вы всегда предпочитали молчание сочувствию."

# game/Story01.rpy:1827
translate russian firstanswernext_165557ba:

    # am "Even silence has a rhythm."
    am "Даже молчание имеет свой ритм."

# game/Story01.rpy:1828
translate russian firstanswernext_d1f5ef9e:

    # am "Sometimes, a single note must be played to break the pattern."
    am "Иногда чтобы нарушить привычный ритм, нужно сыграть всего лишь одну ноту."

# game/Story01.rpy:1831
