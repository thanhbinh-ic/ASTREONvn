translate russian path_second_up_3_3_e0a0dddf:

    # Fl "...You’re alive."
    Fl "...Ты жив."

# game/Story01.rpy:7678
translate russian path_second_up_3_3_d6f0fd31:

    # Fl "That’s what matters."
    Fl "Это главное."

