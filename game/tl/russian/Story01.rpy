translate russian final2_e040751b:

    # o "Don't play hero. We still need you alive!"
    o "Не играй в героя. Ты ещё нужен нам живым!"

# game/Story01.rpy:6870
translate russian final2_2b35b6fe_1:

    # mc "..."
    mc "..."

