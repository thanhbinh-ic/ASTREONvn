translate russian path_second_up_3_3_3413110f:

    # gg "First door, that’s the command post."
    gg "Первая дверь. Там командный пункт."

# game/Story01.rpy:7730
translate russian path_second_up_3_3_51bcca72:

    # gg "You’ll find the commander there."
    gg "Командир будет там."

