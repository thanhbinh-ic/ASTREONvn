translate russian path_second_up_3_3_a001a5a6:

    # Fl "Sadly, yeah."
    Fl "К сожалению, да."

# game/Story01.rpy:7745
translate russian path_second_up_3_3_333917d1:

    # Fl "Grew up around here."
    Fl "Выросла неподалеку."

