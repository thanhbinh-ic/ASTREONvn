    # mc "Just in time."
    mc "Как раз вовремя."

# game/Story01.rpy:7473
translate russian olivia_fr_scene_93323f38:

    # Mi "Good. We found a passage. Possibly leads to the signal jammer."
    Mi "Хорошо. Я нашла проход. Возможно, он ведёт к глушилке."

# game/Story01.rpy:7474
translate russian olivia_fr_scene_dc268b32:

    # Mi "We need to move."
    Mi "Нам нужно идти."

# game/Story01.rpy:7480
translate russian olivia_fr_scene_12a1a1d5_1:

    # Mi "I’ve got news for you two. I found a passage that might lead us to the signal jammer."
    Mi "У меня есть для вас новости. Я нашла проход, который может привести нас к глушилке."

# game/Story01.rpy:7482
translate russian olivia_fr_scene_f46a0f1a:

    # Mi "So wake Olivia up. We’re heading out."
    Mi "Так что разбуди Оливию. Мы уходим."
