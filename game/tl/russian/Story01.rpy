translate russian path_second_up_3_3_47e1e607:

    # Fl "Oh wow~ so I made a good first impression, then?"
    Fl "Ого~ значит, первое впечатление я произвела хорошее?"

# game/Story01.rpy:7751
translate russian path_second_up_3_3_67d2ecd9:

    # mc "Your father’s a big shot, isn’t he? So how’d that happen?"
    mc "Твой отец ведь важная шишка, разве нет? Как так вышло?"

# game/Story01.rpy:7753
translate russian path_second_up_3_3_22910cdb:

    # Fl "My dad..."
    Fl "Мой отец..."

# game/Story01.rpy:7754
translate russian path_second_up_3_3_1533fab0:

    # Fl "the old man always had his principles."
    Fl "у старика всегда были свои принципы."

# game/Story01.rpy:7755
translate russian path_second_up_3_3_860a1f8b:

    # Fl "Thought he could make this sector… a little safer."
    Fl "Думал, что сможет сделать этот сектор... хоть немного безопаснее."

# game/Story01.rpy:7758
translate russian path_second_up_3_3_9c9aedbb:

    # mc "So you know people from around here?"
    mc "Значит, ты знаешь местных?"

# game/Story01.rpy:7759
translate russian path_second_up_3_3_b974504b:

    # Fl "...Yeah."
    Fl "...Да."

# game/Story01.rpy:7760
translate russian path_second_up_3_3_61a4b84f:

    # Fl "Or what’s left of them."
    Fl "Точнее, тех, кто от них остался."

# game/Story01.rpy:7761
translate russian path_second_up_3_3_291135f7:

    # mc "Hey, Flor?"
    mc "Эй, Флор?"

# game/Story01.rpy:7765
translate russian path_second_up_3_3_42f1fa33:

    # mc "What did the blind man say when he walked into a bar?"
    mc "Что сказал слепой, когда вошел в бар?"

