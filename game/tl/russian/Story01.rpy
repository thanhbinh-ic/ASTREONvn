translate russian cyberstreet1_56de9b62:

    # Fl "...thanks."
    Fl "...спасибо."

# game/Story01.rpy:7565
translate russian path_second_up_3_3_162dbbf7:

    # mc "Alright… what are we dealing with?"
    mc "Ладно... с чем мы имеем дело?"

