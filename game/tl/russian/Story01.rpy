    # mc "Sorry, Olivia. I can’t. Not like this."
    mc "Прости, Оливия. Я не могу. Не так."

# game/Story01.rpy:7462
translate russian olivia_fr_scene_76493995:

    # Mi "I’ve got something."
    Mi "Я кое-что нашла."

# game/Story01.rpy:7467
