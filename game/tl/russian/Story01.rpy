    # o "Retreat! We'll cover you!"
    o "Отступайте! Мы прикроем вас!"

# game/Story01.rpy:6843
translate russian final2_c6141f63:

    # mc "Olivia, fall back quickly. I'll hold them off."
    mc "Оливия, быстрей отступай. Я задержу их."

# game/Story01.rpy:6845
translate russian final2_d20bec36:

    # h "Got it."
    h "Поняла."

