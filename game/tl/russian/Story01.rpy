    # y "Do you regret telling him?"
    y "Вы жалеете, что рассказали ему?"

# game/Story01.rpy:1833
translate russian firstanswernext_793e890f:

    # am "Regret is for those who had a choice."
    am "Сожаление для тех, у кого был выбор."

# game/Story01.rpy:1838
translate russian firstanswernext_dc05a17f:

    # am "(Now, let’s see where this story will take us next.)"
    am "(Теперь посмотрим, куда нас приведёт эта история.)"

