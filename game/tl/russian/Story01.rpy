    # i "And it's been such a long time since we've seen each other, hasn't it?"
    i "И мы очень давно не виделись, верно?"

# game/Story01.rpy:6698
translate russian final2_fa2405b7:

    # Fl "So that's who you are... Now I understand."
    Fl "Так вот ты кто... Теперь я понимаю."

