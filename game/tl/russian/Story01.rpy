translate russian path_second_up_3_3_4ac1fa7b:

    # Fl "Movement ahead, tight formation."
    Fl "Впереди движение, плотный строй."

# game/Story01.rpy:7581
translate russian path_second_up_3_3_84b33d76:

    # Fl "Stay sharp."
    Fl "Будь начеку."

# game/Story01.rpy:7584
translate russian path_second_up_3_3_0e3a66e0:

    # mc "Don’t worry."
    mc "Не переживай."

# game/Story01.rpy:7585
translate russian path_second_up_3_3_c210c74e:

    # Fl "Try not to die immediately."
    Fl "Постарайся не умереть сразу."

# game/Story01.rpy:7586
translate russian path_second_up_3_3_7fe1bb9c:

    # Fl "That’d be great."
    Fl "Было бы отлично."

# game/Story01.rpy:7589
translate russian path_second_up_3_3_a333c531:

    # mc "I’d promise… but we both know how I handle bad ideas."
    mc "Я бы пообещал... но мы оба знаем, как я обращаюсь с плохими идеями."

# game/Story01.rpy:7594
translate russian path_second_up_3_3_d8595d8d:

    # g "Shit! Reloading!"
    g "Черт! Перезаряжаюсь!"

# game/Story01.rpy:7613
translate russian path_second_up_3_3_e90d4bad:

    # gg "I’ve got you! Make it fast. I’m down to fumes myself!"
    gg "Прикрою! Только быстрее, у меня у самого почти пусто!"

# game/Story01.rpy:7617
translate russian path_second_up_3_3_c1b6dc27:

    # mc "(Hot…)"
    mc "(Горячо...)"

# game/Story01.rpy:7650
translate russian path_second_up_3_3_9062fd34:

    # mc "Soldier. Report."
    mc "Солдат. Докладывай."

# game/Story01.rpy:7651
translate russian path_second_up_3_3_9b2de961:

    # gg "Yes, sir."
    gg "Так точно, сэр."

