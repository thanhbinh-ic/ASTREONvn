    # am "Three days of silence. Not a whisper. Not a trace."
    am "Три дня тишины. Ни звука. Ни следа."

# game/Story01.rpy:1568
translate russian firstanswernext_09f63fa0:

    # a "Last ping — then nothing. Like they were swallowed."
