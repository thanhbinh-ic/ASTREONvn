    # Fl "It’s never that simple…"
    Fl "Nunca es tan simple..."

# game/Story03.rpy:4715

translate spanish akt3chapter4_89a8d5d5:

    # Fl "Be honest."
    Fl "Sé honesto."

# game/Story03.rpy:4716

translate spanish akt3chapter4_3456e9a9:

    # Fl "Did you drop everything for her?"
    Fl "¿Lo dejaste todo por ella?"

# game/Story03.rpy:4718

translate spanish akt3chapter4_cb9704d6:

    # mc "Some things are harder to explain than you think."
    mc "Algunas cosas son más difíciles de explicar de lo que piensas."

# game/Story03.rpy:4720

translate spanish akt3chapter4_40a99654:

    # Fl "Have you always been like this—"
    Fl "¿Siempre has sido así?"

# game/Story03.rpy:4721

translate spanish akt3chapter4_324c16ec:

    # Fl "or is this new?"
    Fl "¿O es nuevo?"

# game/Story03.rpy:4724

translate spanish akt3chapter4_a488ac32:

    # mc "You’re pushing too hard."
    mc "Estás presionando demasiado."

# game/Story03.rpy:4726

translate spanish akt3chapter4_8a84f750:

    # Fl "So?"
    Fl "¿Y?"

# game/Story03.rpy:4731

translate spanish akt3chapter4_a48150a5:

    # Fl "What did you find?"
    Fl "¿Qué encontraste?"

# game/Story03.rpy:4735

translate spanish akt3chapter4_f21b3964:

    # mc "You could’ve just asked me directly."
    mc "Podrías haberme preguntado directamente."

# game/Story03.rpy:4737

translate spanish akt3chapter4_c5cd3d15:

    # Fl "If you’d prefer—"
    Fl "Si prefieres..."

# game/Story03.rpy:4738

translate spanish akt3chapter4_b6bc6642:

    # Fl "I can make it an order."
    Fl "Puedo hacer una orden."

# game/Story03.rpy:4740

translate spanish akt3chapter4_12b38da7:

    # Fl "Won’t change the outcome."
    Fl "No cambiará el resultado."

# game/Story03.rpy:4742

translate spanish akt3chapter4_9ccc63d0:

    # mc "Quit playing games."
    mc "Deja de jugar."

# game/Story03.rpy:4744

translate spanish akt3chapter4_381e664a:

    # Fl "And she might be the only thing we have left."
    Fl "Y puede que sea lo único que nos queda."

# game/Story03.rpy:4752

translate spanish akt3chapter4_949ca777:

    # mc "You really don't know how to ask, do you?"
    mc "No puedes preguntar como un humano, ¿verdad?"

# game/Story03.rpy:4757

translate spanish akt3chapter4_be67b6d3:

    # Fl "Right now— MILLIONS of lives depend on my decisions!"
    Fl "Ahora mismo— ¡Milliones de vidas dependen de mis decisiones!"

# game/Story03.rpy:4759

translate spanish akt3chapter4_2f4db67a:

    # Fl "And whatever it takes—"
    Fl "Y lo que sea que sea necesario..."

# game/Story03.rpy:4760

translate spanish akt3chapter4_4fddcea5:

    # Fl "you’re going to tell me everything!"
    Fl "¡Vas a decirme todo!"

# game/Story03.rpy:4761

translate spanish akt3chapter4_af076d1e:

    # Fl "Do you understand me?!"
    Fl "¿Me entiendes?"

# game/Story03.rpy:4763

translate spanish akt3chapter4_c3cd955e:

    # mc "And your best idea was jumping me the second I walked in?"
    mc "¿Y tu mejor idea me estaba saltando en el segundo en el que me fui?"

# game/Story03.rpy:4765

translate spanish akt3chapter4_493ac62e:

    # Fl "What else was I supposed to do?!"
    Fl "¿Qué más se suponía que debía hacer?!"

