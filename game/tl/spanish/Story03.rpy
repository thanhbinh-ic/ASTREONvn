# game/Story03.rpy:1277
translate spanish akt3chapter1_3_261bec41:

    # mc "You know... after everything that's happened?"
    mc "Ya sabes... ¿después de todo lo que pasó?"

# game/Story03.rpy:1278
translate spanish akt3chapter1_3_a6859242:

    # mc "Feels like my head's about ready to split open."
    mc "Siento que la cabeza está a punto de partirse."

# game/Story03.rpy:1282
translate spanish akt3chapter1_3_4cecdc4e:

    # L "(If it weren’t for me... for my selfishness, we could’ve lived a happy life.)"
    L "(Si no fuera por mí... por mi egoísmo, podríamos haber vivido una vida feliz.)"

# game/Story03.rpy:1283
translate spanish akt3chapter1_3_1fcfdcbc:

    # L "(He never would’ve had to suffer so much...)"
    L "(Él nunca habría tenido que sufrir tanto...)"

# game/Story03.rpy:1284
