    # mc "Got a pile of missed calls."
    mc "Tengo un montón de llamadas perdidas."

# game/Story03.rpy:2535

translate spanish akt3chapter2_2_ae74282c:

    # mc "Didn’t even know I had that feature."
    mc "Ni siquiera sabía que tenía esa característica."

# game/Story03.rpy:2538

translate spanish akt3chapter2_2_b6aa6c43:

    # mc "Yeah. That sounds about right."
    mc "Sí, eso suena bien."

# game/Story03.rpy:2550

translate spanish akt3chapter2_2_fe7da75b:

    # mc "How do you handle this?"
    mc "¿Cómo manejas esto?"

# game/Story03.rpy:2551

translate spanish akt3chapter2_2_bcd9f4ee:

    # mc "And if I don’t have years to spare?"
    mc "¿Y si no tengo años para ahorrar?"

# game/Story03.rpy:2554

translate spanish akt3chapter2_2_f9b21562:

    # mc "(Breathe.)"
    mc "(Tranquilo.)"

# game/Story03.rpy:2557

translate spanish akt3chapter2_2_ab7d7e77:

    # mc "(Don’t panic.)"
    mc "(No te asustes.)"

# game/Story03.rpy:2558

translate spanish akt3chapter2_2_ec576201:

    # mc "(Stay alive.)"
    mc "(Manténganse vivos.)"

# game/Story03.rpy:2560

translate spanish akt3chapter2_2_444ee177:

    # mc "(Lora...)"
    mc "(Lora...)"

# game/Story03.rpy:2568

translate spanish akt3chapter2_2_a336f09a:

    # mc "(Still you.)"
    mc "(Hasta luego.)"

# game/Story03.rpy:2569

translate spanish akt3chapter2_2_3bd87198:

    # mc "(You’ll come back.)"
    mc "(Volverás.)"

# game/Story03.rpy:2591

translate spanish akt3chapter2_2_051f897d:

    # mc "(So I stay alive.)"
    mc "(Así que me quedo vivo.)"

# game/Story03.rpy:2594

translate spanish akt3chapter2_2_a9dfb011:

    # mc "(Alone again.)"
    mc "(Solo otra vez.)"

# game/Story03.rpy:2598

translate spanish akt3chapter2_2_47b6c65f:

    # mc "(Of course.)"
    mc "(Por supuesto.)"

# game/Story03.rpy:2601

translate spanish akt3chapter2_2_120e7a56:

    # mc "(They’re alive.)"
    mc "(Están vivos.)"

# game/Story03.rpy:2602

translate spanish akt3chapter2_2_01f229da:

    # mc "(That’s enough.)"
    mc "(Eso es suficiente.)"

# game/Story03.rpy:2603

translate spanish akt3chapter2_2_fb0674d9:

    # mc "(Move.)"
    mc "(Move.)"

# game/Story03.rpy:2604

translate spanish akt3chapter2_2_997e07de:

    # mc "Sector Three."
    mc "Sector Tres."

# game/Story03.rpy:2608

translate spanish akt3chapter2_2_dcac0483:

    # mc "They’re regrouping."
    mc "Están reagrupándose."

# game/Story03.rpy:2611

translate spanish akt3chapter2_2_68f72674:

    # mc "So we find a flyer."
    mc "Así que encontramos un folleto."

# game/Story03.rpy:2636

translate spanish akt3chapter2_2_ac6f8112:

    # mc "Underground."
    mc "Subterráneo."

# game/Story03.rpy:2637

translate spanish akt3chapter2_2_0edcb3f1_1:

    # mc "...Great."
    mc "...Genial."

# game/Story03.rpy:2638

translate spanish akt3chapter2_2_675c8f0c:

    # mc "Where?"
    mc "¿Dónde?"

# game/Story03.rpy:2640

translate spanish akt3chapter2_2_c1860ef0:

    # gg "There’s an old hangar not far from here. With luck, something’s still inside."
    gg "Hay un viejo hangar no muy lejos de aquí. Con suerte, algo todavía está dentro."

# game/Story03.rpy:2655

translate spanish akt3chapter2_2_fb364877:

    # mc "Lead."
    mc "Lider."

# game/Story03.rpy:2657

translate spanish akt3chapter2_2_5f20b38f:

    # k "Bullets. How touching. Haven’t seen that kind of 'affection' in ages."
    k "Balas, qué tacto, hace mucho tiempo que me han expresado este tipo de ternura."

# game/Story03.rpy:2686

translate spanish akt3chapter2_2_46700a2a:

    # k "Spare me. The names, the threats, the gasps, I’ve heard them all a hundred times. Be original for once."
    k "Esquíeme. Los nombres, las amenazas, los gases, los he oído todas cien veces. Sé original por una vez."

# game/Story03.rpy:2710

translate spanish akt3chapter2_2_363dd4c2:

    # k "You want to stay? Adorable. But yes, I’ll get you out. Though I won’t lie, leaving you here is… tempting."
    k "¿Quieres quedarte? Adorable. Pero sí, te sacaré. Aunque no mentiré, dejarte aquí es... tentador."

# game/Story03.rpy:2723

translate spanish akt3chapter2_2_8529ccd2:

    # k "Completely. But don’t flatter yourself, I just don’t leave things unfinished."
    k "Completamente. Pero no te aplanes, simplemente no dejo las cosas sin terminar."

# game/Story03.rpy:2729

translate spanish akt3chapter2_2_53f69968:

    # k "Just don’t stare at me like I’m a monster. Or go ahead, doesn’t matter to me."
    k "Simplemente no me mires como si fuera un monstruo. O adelante, no me importa."

# game/Story03.rpy:2733

translate spanish akt3chapter2_2_201288e6:

    # gg "I’m responsible for you. And if I have to walk with Astoria’s dogs to get you out, I will."
    gg "Soy responsable de ti. Y si tengo que caminar con los perros de Astoria para sacarte, lo haré."

# game/Story03.rpy:2770

translate spanish akt3chapter2_2_d2c70b58:

    # mc "(...Slaughter.)"
    mc "(... risas.)"

# game/Story03.rpy:2771

translate spanish akt3chapter2_2_6f5fd1a1:

    # mc "(Clean. Fast.)"
    mc "(Clean. ¡Rápido!)"

# game/Story03.rpy:2772

translate spanish akt3chapter2_2_6fe354fe:

    # mc "You did this?"
    mc "¿Hiciste esto?"

# game/Story03.rpy:2777

translate spanish akt3chapter2_2_347a4121:

    # mc "Enjoying it?"
    mc "¿Disfrutándolo?"

# game/Story03.rpy:2783

translate spanish akt3chapter2_2_0db91082:

    # k "No. Boredom. And only two cures for that, art or death."
    k "No, aburrimiento, y solo dos curas para eso, arte o muerte."

# game/Story03.rpy:2784

translate spanish akt3chapter2_2_196cd2ef:

    # k "Sometimes, the line blurs."
    k "A veces, la línea se desdibuja."

# game/Story03.rpy:2787

translate spanish akt3chapter2_2_679562b4:

    # k "Not always. Sometimes I slice fabric."
    k "A veces rebano tela."

# game/Story03.rpy:2790

translate spanish akt3chapter2_2_bce9b817:

    # k "Other times, throats. Depends on the mood."
    k "Otras veces, gargantas, depende del estado de ánimo."

# game/Story03.rpy:2792

translate spanish akt3chapter2_2_f6f22481:

    # a "(Whispering) Try silence more often."
    a "Prueba el silencio más a menudo."

# game/Story03.rpy:2835

translate spanish akt3chapter2_2_981502f3:

    # a "(Whispering) And next time, stay out of what isn’t yours."
    a "Y la próxima vez, no te metas en lo que no es tuyo."

# game/Story03.rpy:2837

translate spanish akt3chapter2_2_02cfa38c:

    # a "We are weapons. Forged sisters clash, sparks are expected."
    a "Somos armas, hermanas forjadas chocan, se espera chispas."

# game/Story03.rpy:2856

translate spanish akt3chapter2_2_53c38082:

    # k "But when the time comes, we’ll fall together. No doubts. Right?"
    k "Pero cuando llegue el momento, caeremos juntos. Sin duda. ¿Verdad?"

# game/Story03.rpy:2867

translate spanish akt3chapter2_2_103699df:

    # gg "They took our people, let them pay in full."
    gg "Se llevaron a nuestra gente, y les dejaron pagar por completo."

# game/Story03.rpy:2910

translate spanish akt3chapter2_2_1c59acdd:

    # mc "Let them come."
    mc "Déjenlos venir."

# game/Story03.rpy:2919

translate spanish akt3chapter2_2_5af9b061:

    # mc "I’m ready."
    mc "Estoy listo."

# game/Story03.rpy:2921

translate spanish akt3chapter2_2_740b22b2:

    # mc "(You’ve already lost your son… and you’re not losing anyone else.)"
    mc "(Ya has perdido a tu hijo... y no estás perdiendo a nadie más.)"

# game/Story03.rpy:2931

translate spanish akt3chapter2_2_d8ad6ad0:

    # k "Stick close, hero. Die later, I hate being bored."
    k "Muere más tarde, odio estar aburrido."

# game/Story03.rpy:2946

translate spanish akt3chapter2_2_9649516a:

    # k "Wasn’t planning to. But if you need it that badly, you looked almost worthy. Briefly."
    k "No estaba planeando hacerlo. Pero si lo necesitas tan mal, pareces casi digno. Brevemente."

# game/Story03.rpy:2951

translate spanish akt3chapter2_2_522a3d44:

    # mc "Last one."
    mc "El último."

# game/Story03.rpy:2961

translate spanish akt3chapter2_2_5bcfe907:

    # gg "Move! Like we trained, no wasted steps!"
    gg "¡Como entrenamos, sin desperdiciar pasos!"

# game/Story03.rpy:2974

translate spanish akt3chapter2_2_f2c813e3:

    # gg "The rest, toward the corridor. Hustle, or I’ll finish you off myself!"
    gg "El resto, hacia el pasillo. ¡Asúmbrate, o te terminaré de mí mismo!"

# game/Story03.rpy:2988

translate spanish akt3chapter3_debcd0a0:

    # "Sector 4. A ventilation shaft."
    "Sector 4. Un eje de ventilación."

# game/Story03.rpy:2989

translate spanish akt3chapter3_8213ea34:

    # mc "I won’t pretend this is okay."
    mc "No voy a fingir que esto está bien."

# game/Story03.rpy:3016

translate spanish akt3chapter3_af24c268:

    # mc "(Yeah, and I’ll be your human shield again, when you run out of ammo.)"
    mc "(Sí, y seré tu escudo humano de nuevo, cuando te quedes sin munición.)"

# game/Story03.rpy:3027

translate spanish akt3chapter3_caffef16:

    # k "Keep your head up."
    k "Mantenga la cabeza en pie."

# game/Story03.rpy:3035

translate spanish akt3chapter3_dc0e3738:

    # k "Always a pleasure."
    k "Siempre es un placer."

# game/Story03.rpy:3042

translate spanish akt3chapter3_8c9c7f34:

    # mc "You know something."
    mc "Sabes algo."

# game/Story03.rpy:3046

translate spanish akt3chapter3_86782263:

    # mc "About them."
    mc "Sobre ellos."

# game/Story03.rpy:3048

translate spanish akt3chapter3_9a838154:

    # R "They think we’re behind this?"
    R "¿Creen que estamos detrás de esto?"

# game/Story03.rpy:3101

translate spanish akt3chapter3_f413af47:

    # mc "(He’s nervous… and it’s not the Inquisition.)"
    mc "(Está nervioso... y no es la Inquisición.)"

# game/Story03.rpy:3104

translate spanish akt3chapter3_77448e7a:

    # mc "He found something, didn’t he?"
    mc "Encontró algo, ¿no?"

# game/Story03.rpy:3106

translate spanish akt3chapter3_d45b13c5:

    # mc "So you’re telling me, you know where they came from?"
    mc "Así que me estás diciendo, ¿sabes de dónde vienen?"

# game/Story03.rpy:3113

translate spanish akt3chapter3_a6a65767:

    # a "Soulless... because there was a soul. Before the gate took it."
    a "Insalubres... porque había un alma antes de que la puerta se la llevara."

# game/Story03.rpy:3120

translate spanish akt3chapter3_24a5a506:

    # mc "(All this time...)"
    mc "(Todo este tiempo...)"

# game/Story03.rpy:3158

translate spanish akt3chapter3_6b642644:

    # mc "(They weren’t monsters.)"
    mc "(No eran monstruos.)"

# game/Story03.rpy:3162

translate spanish akt3chapter3_2b15474b:

    # mc "...You knew."
    mc "...lo sabías."

# game/Story03.rpy:3164

translate spanish akt3chapter3_b15d94ce:

    # mc "All of you."
    mc "Todos ustedes."

# game/Story03.rpy:3165

translate spanish akt3chapter3_e176a807:

    # a "People die over less."
    a "La gente muere por menos."

# game/Story03.rpy:3173

translate spanish akt3chapter3_fd0357d3:

    # mc "(So that’s it.)"
    mc "(Así que eso es todo)."

# game/Story03.rpy:3175

translate spanish akt3chapter3_cba3f744:

    # mc "(Say the truth, and you disappear.)"
    mc "(Di la verdad, y desapareces.)"

# game/Story03.rpy:3181

translate spanish akt3chapter3_62356372:

    # mc "Now I get it."
    mc "Ahora lo entiendo."

# game/Story03.rpy:3184

translate spanish akt3chapter3_5307f7d0:

    # mc "Lora wasn’t broken."
    mc "Lora no estaba rota."

# game/Story03.rpy:3186

translate spanish akt3chapter3_3a9fe4df:

    # mc "You did that to her."
    mc "Le hiciste eso."

# game/Story03.rpy:3188

translate spanish akt3chapter3_c98ab144:

    # mc "...Not happening to me."
    mc "No me está pasando."

# game/Story03.rpy:3191

translate spanish akt3chapter3_e9ad328d:

    # k "(And I don’t like people breaking my toys without warning.)"
    k "(Y no me gusta que la gente rompa mis juguetes sin advertencia.)"

# game/Story03.rpy:3208

translate spanish akt3chapter3_a97711f4:

    # k "(Pain without rhythm is just noise.)"
    k "(El dolor sin ritmo es solo ruido.)"

# game/Story03.rpy:3221

translate spanish akt3chapter3_bbf7cf59:

    # k "So? Boiling yet?"
    k "¿Y qué?"

# game/Story03.rpy:3228

translate spanish akt3chapter3_f8a33d04:

    # k "(Angry? Good. I can feel it from here.)"
    k "Bien. Puedo sentirlo desde aquí."

# game/Story03.rpy:3231

translate spanish akt3chapter3_5ea271a9:

    # mc "(I thought I finally found someone I could trust.)"
    mc "(Pensé que finalmente encontré a alguien en quien podía confiar.)"

# game/Story03.rpy:3233

translate spanish akt3chapter3_78b62800:

    # mc "(...Wrong.)"
    mc "(...Wrong.)"

# game/Story03.rpy:3235

translate spanish akt3chapter3_2b15474b_1:

    # mc "...You knew."
    mc "...lo sabías."

# game/Story03.rpy:3237

translate spanish akt3chapter3_57c62461:

    # mc "And you said nothing."
    mc "Y no dijiste nada."

# game/Story03.rpy:3240

translate spanish akt3chapter3_0634651e:

    # k "Oh? Curtain’s up already? Spare me the tragedy."
    k "¿La cortina ya está levantada? Escupe la tragedia."

# game/Story03.rpy:3243

translate spanish akt3chapter3_3085095d:

    # mc "So that’s it."
    mc "Así que eso es todo."

# game/Story03.rpy:3244

translate spanish akt3chapter3_48f75eee:

    # mc "Everyone knew."
    mc "Todos lo sabían."

# game/Story03.rpy:3246

translate spanish akt3chapter3_8a4f514c:

    # mc "...Except me."
    mc "...Excepto."

# game/Story03.rpy:3252

translate spanish akt3chapter3_1e1b51c3:

    # k "(Try saying it once, 'I failed.')"
    k "(Intenta decir, \"He fallado\".)"

# game/Story03.rpy:3263

translate spanish akt3chapter3_55cfb131:

    # k "(No? Of course not. You always did overact.)"
    k "(No? Por supuesto que no. Siempre lo hiciste exagerar.)"

# game/Story03.rpy:3266

translate spanish akt3chapter3_33dd240d:

    # k "(Here we go again, dancing around conscience.)"
    k "(Aquí vamos otra vez, bailando alrededor de la conciencia.)"

# game/Story03.rpy:3269

translate spanish akt3chapter3_fb9245ea:

    # k "Please. Kill me already."
    k "Por favor, mátame ya."

# game/Story03.rpy:3273

translate spanish akt3chapter3_048b5630:

    # k "As adorable as this panic attack is, who’s flying this winged coffin?"
    k "Tan adorable como este ataque de pánico es, ¿quién está volando este ataúd alado?"

# game/Story03.rpy:3283

translate spanish akt3chapter3_c919e9fa:

    # mc "Wait, don’t tell me... no one’s flying this thing?"
    mc "Espera, no me digas... ¿Nadie está volando esta cosa?"

# game/Story03.rpy:3286

translate spanish akt3chapter3_bcb93426:

    # mc "...Never done this."
    mc "...nunca hice esto."

# game/Story03.rpy:3308

translate spanish akt3chapter3_480890f2:

    # mc "I’ll manage."
    mc "Yo me las arreglaré."

# game/Story03.rpy:3322

translate spanish akt3chapter3_c8a894ae:

    # mc "(Then why lie to me?)"
    mc "(Entonces, ¿por qué mentirme?)"

# game/Story03.rpy:3424

translate spanish akt3chapter3_36041560:

    # k "(I couldn’t, okay? If you’d found out then, it would’ve torn you apart.)"
    k "(No podría, ¿de acuerdo? Si lo hubieras descubierto entonces, te habría destrozado.)"

# game/Story03.rpy:3426

translate spanish akt3chapter3_79d64210:

    # k "We’re not machines."
    k "No somos máquinas."

# game/Story03.rpy:3437

translate spanish akt3chapter3_826e6b17:

    # k "We breathe, we feel… and we break."
    k "Respiramos, sentimos... y nos rompemos."

# game/Story03.rpy:3445

translate spanish akt3chapter3_816a1c65:

    # k "So yeah, sorry I lied."
    k "Así que sí, siento haber mentido."

# game/Story03.rpy:3451

translate spanish akt3chapter3_0b17be9e:

    # mc "...I get it."
    mc "... lo entiendo."

# game/Story03.rpy:3453

translate spanish akt3chapter3_b4e4f80b:

    # mc "Doesn’t make it easier."
    mc "No lo hace más fácil."

# game/Story03.rpy:3458

translate spanish akt3chapter3_404a266a:

    # k "Move before I regret explaining myself."
    k "Muévete antes de que me explique."

# game/Story03.rpy:3466

translate spanish akt3chapter3_1_8f65b5a8:

    # "Sector 4-S. Warehouse area."
    "Sector 4-S. Zona de almacén."

# game/Story03.rpy:3469

translate spanish akt3chapter3_1_c060c641:

    # mc "(Wouldn’t be surprised if the corpses are still here.)"
    mc "(No se sorprendería si los cadáveres aún están aquí)."

# game/Story03.rpy:3472

translate spanish akt3chapter3_1_4eb225e8:

    # mc "(Just… better hidden.)"
    mc "(Solo... mejor escondido.)"

# game/Story03.rpy:3475

translate spanish akt3chapter3_1_f149133f:

    # mc "Why me. Specifically?"
    mc "¿Por qué yo?"

# game/Story03.rpy:3488

translate spanish akt3chapter3_1_2bd5e0d8:

    # mc "You don’t look like you need help."
    mc "No parece que necesites ayuda."

# game/Story03.rpy:3492

translate spanish akt3chapter3_1_db25554c:

    # g "Can. But with you, it’s faster."
    g "Pero con usted, es más rápido."

# game/Story03.rpy:3495

translate spanish akt3chapter3_1_83fd040a:

    # k "(Going with him? Brave.)"
    k "¿Vas con él?"

# game/Story03.rpy:3499

translate spanish akt3chapter3_1_6abb0a67:

    # k "(Or just stupid.)"
    k "(O simplemente estúpido.)"

# game/Story03.rpy:3504

translate spanish akt3chapter3_1_9b9c96f0:

    # mc "(Do I even have a choice?)"
    mc "(¿Tengo alguna opción?)"

# game/Story03.rpy:3507

translate spanish akt3chapter3_1_77f1e2ff:

    # mc "He reminds me of you."
    mc "Me recuerda a ti."

# game/Story03.rpy:3511

translate spanish akt3chapter3_1_36338f19:

    # mc "When you stop pretending."
    mc "Cuando dejas de fingir."

# game/Story03.rpy:3514

translate spanish akt3chapter3_1_de2b2888:

    # k "Difference is, I don’t lie about my intentions."
    k "La diferencia es, no miente sobre mis intenciones."

# game/Story03.rpy:3516

translate spanish akt3chapter3_1_4ceeb90e:

    # gg "Catch. You hear even one step behind you, use it."
    gg "Oís un paso atrás, úsalo."

# game/Story03.rpy:3529

translate spanish akt3chapter3_1_3432103f:

    # g "First sign, we run."
    g "Primera señal, corremos."

# game/Story03.rpy:3537

translate spanish akt3chapter3_1_6ada3060:

    # mc "So."
    mc "Así que."

# game/Story03.rpy:3551

translate spanish akt3chapter3_1_5164590e:

    # mc "Why me?"
    mc "¿Por qué yo?"

# game/Story03.rpy:3553

translate spanish akt3chapter3_1_27bb7259:

    # mc "Say it."
    mc "Dilo."

# game/Story03.rpy:3592

translate spanish akt3chapter3_1_db1d03c7:

    # mc "(One life… or everyone else.)"
    mc "(Una vida... o todos los demás.)"

# game/Story03.rpy:3610

translate spanish akt3chapter3_1_16411555:

    # mc "(No.)"
    mc "(No.)"

# game/Story03.rpy:3612

translate spanish akt3chapter3_1_28dcbde3:

    # mc "I had a son."
    mc "Tenía un hijo."

# game/Story03.rpy:3639

translate spanish akt3chapter3_1_a2273163:

    # mc "...Same story."
    mc "...Esa misma historia."

# game/Story03.rpy:3641

translate spanish akt3chapter3_1_c5febbf9:

    # mc "...What did you do?"
    mc "¿Qué hiciste?"

# game/Story03.rpy:3670

translate spanish akt3chapter3_1_d007d27d:

    # mc "He was our pilot."
    mc "Era nuestro piloto."

# game/Story03.rpy:3673

translate spanish akt3chapter3_1_5c30b45c:

    # mc "(Control.)"
    mc "(Control.)"

# game/Story03.rpy:3676

translate spanish akt3chapter3_1_9baa6b07:

    # mc "He was the only one who could fly this."
    mc "Él era el único que podía volar esto."

# game/Story03.rpy:3680

translate spanish akt3chapter3_1_275722e5:

    # mc "...You’re serious."
    mc "...Hablas en serio."

# game/Story03.rpy:3688

translate spanish akt3chapter3_1_d209f981:

    # mc "I’ve never done this."
    mc "Nunca he hecho esto."

# game/Story03.rpy:3690

translate spanish akt3chapter3_1_c50e415b:

    # mc "And him?"
    mc "¿Y él?"

# game/Story03.rpy:3695

translate spanish akt3chapter3_1_1a8e1d62:

    # mc "What do we tell them?"
    mc "¿Qué les decimos?"

# game/Story03.rpy:3698

translate spanish akt3chapter3_1_50ee686b:

    # k "(Well, well. Look who's back with news. Only one of them, ain’t a hero anymore.)"
