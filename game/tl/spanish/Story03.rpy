translate spanish act3_5chapter1_a68496df:

    # mc "Nothing to say?"
    mc "¿Nada que decir?"

# game/Story03.rpy:6959

translate spanish act3_5chapter1_bb8e4b4e_5:

    # a "..."
    a "..."

