    # Fl "...Wait."
    Fl "...espera."

# game/Story03.rpy:5063

translate spanish akt3chapter4_85f28ade:

    # Fl "What about Astoria?"
    Fl "¿Qué hay de Astoria?"

# game/Story03.rpy:5065

translate spanish akt3chapter4_d7a46d19:

    # L "She tried too."
    L "Ella también lo intentó."

# game/Story03.rpy:5066

translate spanish akt3chapter4_7408d90e:

    # L "Same result."
    L "El mismo resultado."

# game/Story03.rpy:5068

translate spanish akt3chapter4_10a4cb79:

    # Fl "...how?!"
    Fl "...¿cómo?"

# game/Story03.rpy:5071

translate spanish akt3chapter4_ef0288f9:

    # mc "So there’s no way out?"
    mc "¿Así que no hay salida?"

# game/Story03.rpy:5073

