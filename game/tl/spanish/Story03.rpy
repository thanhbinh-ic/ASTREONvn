translate spanish akt3chapter4_7ec6c53b:

    # Fl "Immortality?"
    Fl "¿Inmortalidad?"

# game/Story03.rpy:5033

translate spanish akt3chapter4_613c3cb2:

    # Fl "...and you actually believe that?"
    Fl "...y realmente crees eso?"

# game/Story03.rpy:5038

translate spanish akt3chapter4_fca52711:

    # mc "No."
    mc "No."

# game/Story03.rpy:5043

translate spanish akt3chapter4_87c06655:

    # mc "That doesn’t sound like you."
    mc "Eso no suena como tú."

# game/Story03.rpy:5044

translate spanish akt3chapter4_fcde0016:

    # mc "Not without proof."
    mc "No sin pruebas."

# game/Story03.rpy:5046

