    am "Hijo, no lo intentes. Estás demasiado débil ahora mismo."

# game/Story03.rpy:7623

translate spanish act3_5chapter2_2_7c87e695:

    # y "He’s not like the other versions. He’s stronger."
    y "No es como las otras versiones. Es más fuerte."

# game/Story03.rpy:7625

translate spanish act3_5chapter2_2_e8fe0f14:

    # am "Who gave you the audacity to grant him that sight?"
    am "¿Quién te dio la audacia de concederle esa vista?"

# game/Story03.rpy:7627

translate spanish act3_5chapter2_2_71a86863_3:

    # y "..."
    y "..."

# game/Story03.rpy:7629

translate spanish act3_5chapter2_2_5d9f22ac:

    # mc "I…"
    mc "Yo..."

