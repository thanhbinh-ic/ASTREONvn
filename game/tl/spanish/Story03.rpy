# game/Story03.rpy:1285
translate spanish akt3chapter1_3_94f267b4:

    # mc "You're here. Alive."
    mc "Estás aquí. Viva."

# game/Story03.rpy:1286
translate spanish akt3chapter1_3_ae7fbce1:

    # mc "That's all that matters."
