    # k "And what little scheme have you cooked up this time?"
    k "¿Y qué pequeño plan has cocinado esta vez?"

# game/Story03.rpy:5296

translate spanish akt3chapter5_1_c30a63ea:

    # k "Thanks, sister."
    k "Gracias, hermana."

# game/Story03.rpy:5301

translate spanish akt3chapter5_1_0a9d723c:

    # k "Ohoho! Delightful."
    k "Encantador."

# game/Story03.rpy:5310

translate spanish akt3chapter5_1_6d548c5d:

    # mc "You’d rather die?"
    mc "¿Preferirías morir?"

# game/Story03.rpy:5328

translate spanish akt3chapter5_1_ea147d35:

    # mc "I’m trying to keep us alive."
    mc "Estoy tratando de mantenernos vivos."

# game/Story03.rpy:5333

translate spanish akt3chapter5_1_b4838f5b:

    # mc "You can decide what to do with me later."
    mc "Puedes decidir qué hacer conmigo más tarde."

# game/Story03.rpy:5334

translate spanish akt3chapter5_1_b18e4b33:

    # mc "But now, I need you."
    mc "Pero ahora, te necesito."

# game/Story03.rpy:5336

translate spanish akt3chapter5_1_6d460376:

    # mc "Your answer?"
    mc "¿Tu respuesta?"

# game/Story03.rpy:5343

translate spanish akt3chapter5_1_b22f8d16:

    # mc "Surviving."
    mc "Sobreviviendo."

# game/Story03.rpy:5382

translate spanish akt3chapter5_1_88ad5c5e:

    # mc "Don’t make this harder than it needs to be."
    mc "No hagas esto más difícil de lo que necesita ser."

# game/Story03.rpy:5385

translate spanish akt3chapter5_1_efadbefc:

    # g "Drop weapon! Now!"
    g "¡Tira el arma!"

# game/Story03.rpy:5387

translate spanish akt3chapter5_1_572473be:

    # mc "We’re past diplomacy."
    mc "Ya hemos pasado la diplomacia."

# game/Story03.rpy:5390

translate spanish akt3chapter5_1_ceb61bca:

    # k "What would you do without me?"
    k "¿Qué harías sin mí?"

# game/Story03.rpy:5391

translate spanish akt3chapter5_1_7296948a:

    # k "Die, probably."
    k "Morir, probablemente."

# game/Story03.rpy:5393

translate spanish akt3chapter5_1_6f274295:

    # mc "Kalestra. Your turn."
    mc "Kalestra, tu turno."

# game/Story03.rpy:5395

translate spanish akt3chapter5_1_a78edaca:

    # mc "Survival rarely looks clean."
    mc "La supervivencia rara vez parece limpia."

# game/Story03.rpy:5401

translate spanish akt3chapter5_1_6f59d2aa:

    # k "Out of the way."
    k "Fuera del camino."

# game/Story03.rpy:5407

translate spanish akt3chapter5_1_b9597520:

    # k "Authority just arrived."
    k "La autoridad acaba de llegar."

# game/Story03.rpy:5410

translate spanish akt3chapter5_1_897e78ac:

    # k "Turn on the PA."
    k "Enciende la PA."

# game/Story03.rpy:5413

translate spanish akt3chapter5_1_16153dc4:

    # k "Wonderful."
    k "Maravilloso."

# game/Story03.rpy:5416

translate spanish akt3chapter5_1_42f0cb23:

    # k "Can everyone hear me now?"
    k "¿Pueden oírme ahora?"

# game/Story03.rpy:5418

translate spanish akt3chapter5_1_db053b07:

    # k "Anyone still sleeping gets dragged out by the throat."
    k "Cualquiera que aún duerme se arrastra por la garganta."

# game/Story03.rpy:5420

translate spanish akt3chapter5_1_7c1faae7:

    # em "Nothing."
    em "Nada."

# game/Story03.rpy:5450

translate spanish akt3chapter5_1_028d94c1:

    # k "This isn’t improvisation. It’s protocol. All dissenters, sentenced to death. On the spot."
    k "Esto no es improvisación. Es protocolo. Todos los disidentes, condenados a muerte. En el lugar."

# game/Story03.rpy:5452

translate spanish akt3chapter5_1_4ca66fb4:

    # k "That’s all! Now, to the hangar. Chop-chop. We’ve got murders to plan and not enough time."
    k "¡Eso es todo! Ahora, al hangar. Chop-chop. Tenemos asesinatos para planear y no suficiente tiempo."

# game/Story03.rpy:5471

translate spanish akt3chapter5_1_692ec8f7:

    # k "No. You’re just cowards hiding behind procedure."
    k "No. Solo son cobardes escondidos detrás del procedimiento."

# game/Story03.rpy:5477

translate spanish akt3chapter5_1_134fc383:

    # k "Sis, remind me, what’s the punishment for mouthing off to an Inquisitor?"
    k "Sis, recuérdame, ¿cuál es el castigo por deshacerse de un Inquisitor?"

# game/Story03.rpy:5479

translate spanish akt3chapter5_1_33c873ff:

    # a "Tribunal. In wartime, execution."
    a "Tribunal, en tiempos de guerra, ejecución."

# game/Story03.rpy:5481

translate spanish akt3chapter5_1_b310aa38:

    # k "Execution?"
    k "¿Execución?"

# game/Story03.rpy:5482

translate spanish akt3chapter5_1_fe8fb784:

    # k "Mm. Efficient."
    k "Eficiente."

# game/Story03.rpy:5484

translate spanish akt3chapter5_1_01cbc88e:

    # k "People call it madness whenever someone stops asking permission."
    k "La gente lo llama locura cuando alguien deja de pedir permiso."

# game/Story03.rpy:5493

translate spanish akt3chapter5_1_5449345d:

    # mc "(And that’s exactly why people fear you.)"
    mc "(Y eso es exactamente por qué la gente te teme.)"

# game/Story03.rpy:5496

translate spanish akt3chapter5_1_cfcc8fd5:

    # mc "Enough spectacle."
    mc "Basta de espectáculo."

# game/Story03.rpy:5499

translate spanish akt3chapter5_1_2562ad6f:

    # mc "Move."
    mc "Muévete."

# game/Story03.rpy:5513

translate spanish akt3chapter5_1_7faf5913:

    # Fl "What if... they won’t agree? Then it’s all over!"
    Fl "¿Y si... no estarán de acuerdo? ¡Entonces todo terminó!"

# game/Story03.rpy:5521

translate spanish akt3chapter5_1_ef3e37a6:

    # gggg "Exactly! We’ll back you, no matter what it costs!"
    gggg "¡Exactamente! ¡Te apoyaremos, no importa lo que cueste!"

# game/Story03.rpy:5524

translate spanish akt3chapter5_1_1c347c1d:

    # Fl "Yeah, you’re... right."
    Fl "Sí, tienes... razón."

# game/Story03.rpy:5525

translate spanish akt3chapter5_1_a250644c:

    # Fl "I need to pull myself together."
    Fl "Necesito reunirme."

# game/Story03.rpy:5527

translate spanish akt3chapter5_1_e4423a79:

    # mc "Outcome?"
    mc "¿Resultado?"

# game/Story03.rpy:5534

translate spanish akt3chapter5_1_22d0ef64:

    # L "I... don't know."
    L "No lo sé."

# game/Story03.rpy:5535

translate spanish akt3chapter5_1_712df1b0:

    # mc "No point backing out now."
    mc "No hay razón para salir ahora."

# game/Story03.rpy:5544

translate spanish akt3chapter5_1_d0e40f57:

    # mc "SURVIVE!"
    mc "¡Survicios!"

# game/Story03.rpy:5580

translate spanish akt3chapter5_1_86a2a077:

    # gg "HOW?!"
    gg "¿Cómo?"

# game/Story03.rpy:5582

translate spanish akt3chapter5_1_a6c2c66e:

    # g "WE'VE ALREADY LOST!"
    g "¡Ya hemos perdido!"

# game/Story03.rpy:5585

translate spanish akt3chapter5_1_6235d204:

    # mc "(They think I’m insane.)"
    mc "(Creen que estoy loco.)"

# game/Story03.rpy:5586

translate spanish akt3chapter5_1_3517da4b:

    # mc "(Maybe they’re right.)"
    mc "(Quizá tengan razón.)"

# game/Story03.rpy:5587

translate spanish akt3chapter5_1_51dcac5a:

    # mc "Listen."
    mc "Escucha."

# game/Story03.rpy:5589

translate spanish akt3chapter5_1_36581657:

    # mc "I’m not going to stand here and promise survival."
    mc "No voy a quedarme aquí y prometer supervivencia."

# game/Story03.rpy:5590

translate spanish akt3chapter5_1_639617cb:

    # mc "Some of us probably won’t make it."
    mc "Algunos de nosotros probablemente no lo lograremos."

# game/Story03.rpy:5592

translate spanish akt3chapter5_1_fa6ce8c2:

    # g "Then why are you even here?!"
    g "¿Entonces por qué estás aquí?"

# game/Story03.rpy:5594

translate spanish akt3chapter5_1_b15f30bd:

    # mc "Waiting to die isn’t a strategy."
    mc "Esperar a morir no es una estrategia."

# game/Story03.rpy:5598

translate spanish akt3chapter5_1_0f47fc0d:

    # mc "Maybe Flora’s wrong."
    mc "Tal vez Flora está equivocada."

# game/Story03.rpy:5599

translate spanish akt3chapter5_1_28737f53:

    # mc "Maybe I’m wrong."
    mc "Tal vez me equivoco."

# game/Story03.rpy:5601

translate spanish akt3chapter5_1_f0396b93:

    # mc "Doing nothing guarantees the outcome."
    mc "No hacer nada garantiza el resultado."

# game/Story03.rpy:5607

translate spanish akt3chapter5_1_d3c8de34:

    # mc "Right now that’s all we have left."
    mc "Ahora mismo eso es todo lo que nos queda."

# game/Story03.rpy:5618

translate spanish akt3chapter5_1_dc676b5b:

    # mc "Right now, all we have is a direction."
    mc "Ahora mismo, todo lo que tenemos es una dirección."

# game/Story03.rpy:5620

translate spanish akt3chapter5_1_24c78e8b:

    # mc "And each other."
    mc "Y el uno al otro."

# game/Story03.rpy:5621

translate spanish akt3chapter5_1_b5fd579d:

    # mc "And people willing to stand beside you."
    mc "Y gente dispuesta a estar a tu lado."

# game/Story03.rpy:5624

translate spanish akt3chapter5_1_05592b27:

    # mc "If you can still stand — stand."
    mc "Si aún puedes pararte, para."

# game/Story03.rpy:5631

translate spanish akt3chapter5_1_fbaa6d26:

    # mc "And if you’re afraid..."
    mc "Y si tienes miedo..."

# game/Story03.rpy:5632

translate spanish akt3chapter5_1_ac313663:

    # mc "So am I."
    mc "Yo también."

# game/Story03.rpy:5633

translate spanish akt3chapter5_1_29610376:

    # mc "Move anyway."
    mc "Muévete de todos modos."

# game/Story03.rpy:5636

translate spanish akt3chapter5_1_7cf243cc:

    # gg "...This is madness. And this is your plan?"
    gg "...esto es una locura. ¿Y este es tu plan?"

# game/Story03.rpy:5638

translate spanish akt3chapter5_1_94374d89:

    # g "I'd rather run than... this."
    g "Prefiero huir de aquí."

# game/Story03.rpy:5641

translate spanish akt3chapter5_1_9939c474:

    # L "Don’t worry, girl."
    L "No te preocupes, chica."

# game/Story03.rpy:5643

translate spanish akt3chapter5_1_7ad4516a:

    # Fl "(They... believe in me.)"
    Fl "(Ellos... creen en mí.)"

# game/Story03.rpy:5645

translate spanish akt3chapter5_1_2c77e49d:

    # Fl "(I don’t get to fall apart now.)"
    Fl "(No me voy a desmoronar ahora.)"

# game/Story03.rpy:5647

translate spanish akt3chapter5_1_c665a285:

    # Fl "I... I’ll do my best."
    Fl "Yo... haré lo mejor que pueda."

# game/Story03.rpy:5656

translate spanish akt3chapter5_1_d29a4c68:

    # Fl "Then we have the same expectations."
    Fl "Entonces tenemos las mismas expectativas."

# game/Story03.rpy:5664

translate spanish akt3chapter5_1_fd3be89e:

    # Fl "(Breathe... Just breathe.)"
    Fl "(Trae... respira.)"

# game/Story03.rpy:5674

translate spanish akt3chapter5_1_ecc543cf:

    # Fl "(You prepared for this.)"
    Fl "(Preparado para esto.)"

# game/Story03.rpy:5684

translate spanish akt3chapter5_1_48b7d7cc:

    # Fl "(Stop shaking.)"
    Fl "(Deja de temblar.)"

# game/Story03.rpy:5687

translate spanish akt3chapter5_1_85465385:

    # Fl "If you want to survive, listen!"
    Fl "Si quieres sobrevivir, escucha."

# game/Story03.rpy:5689

translate spanish akt3chapter5_1_baeabc28:

    # Fl "Our entire lower city is fitted with an air processing system."
    Fl "Nuestra ciudad inferior entera está equipada con un sistema de procesamiento de aire."

# game/Story03.rpy:5703

translate spanish akt3chapter5_1_260d2ad7:

    # Fl "The first team will head to the pumping station to load the cryog-"
    Fl "El primer equipo irá a la estación de bombeo para cargar el cryog-"

# game/Story03.rpy:5706

translate spanish akt3chapter5_1_4c384397:

    # g "And if the plan fails?"
    g "¿Y si el plan falla?"

# game/Story03.rpy:5708

translate spanish akt3chapter5_1_a76d5095:

    # em "We’ll evacua—"
    em "Evacuaremos..."

# game/Story03.rpy:5712

translate spanish akt3chapter5_1_fb3b0572:

    # gg "Where ar-"
    gg "Donde ar-"

# game/Story03.rpy:5713

translate spanish akt3chapter5_1_cda8c2f5:

    # em "Cut me off again, and you die."
    em "Córtame otra vez, y mueres."

# game/Story03.rpy:5715

translate spanish akt3chapter5_1_57d31baa:

    # em "I’ll get my people out."
    em "Sacaré a mi gente."

# game/Story03.rpy:5716

translate spanish akt3chapter5_1_c69329cb:

    # em "That’s the last time."
    em "Es la última vez."

# game/Story03.rpy:5718

translate spanish akt3chapter5_1_d81137e0:

    # g "Why don’t we just run?!"
    g "¿Por qué no corremos?!"

# game/Story03.rpy:5724

translate spanish akt3chapter5_1_920f8a6d:

    # L "It’s already too late."
    L "Ya es demasiado tarde."

# game/Story03.rpy:5726

translate spanish akt3chapter5_1_325dc429:

    # L "The gat— Tower is about to activate."
    L "La gat- Torre está a punto de activar."

# game/Story03.rpy:5730

translate spanish akt3chapter5_1_4a45358c:

    # L "It’s over. Not just the city, the whole planet."
    L "No solo la ciudad, todo el planeta."

# game/Story03.rpy:5733

translate spanish akt3chapter5_1_38132948:

    # ggg "WHAT?! What are you even saying?"
    ggg "¿Qué estás diciendo?"

# game/Story03.rpy:5734

translate spanish akt3chapter5_1_86529014:

    # gggg "That can't be..."
    gggg "No puedo..."

# game/Story03.rpy:5735

translate spanish akt3chapter5_1_45c37613:

    # k "Sis... What do we do?"
    k "Sis... ¿Qué hacemos?"

# game/Story03.rpy:5739

translate spanish akt3chapter5_1_bcc1523c:

    # a "It's true."
    a "Es verdad."

# game/Story03.rpy:5759

translate spanish akt3chapter5_1_82091822_1:

    # k "..."
    k "..."

# game/Story03.rpy:5762

translate spanish akt3chapter5_1_0529ebd9:

    # ggg "But we don’t have the manpower to take it..."
    ggg "Pero no tenemos el poder de tomarlo..."

# game/Story03.rpy:5766

translate spanish akt3chapter5_1_2c242fe3:

    # Fl "The team, led by [mc] will head straight to the tower's core."
    Fl "Equipo bajo mando [mc] Irá directamente al núcleo de la torre."

# game/Story03.rpy:5773

translate spanish akt3chapter5_1_b0787021:

    # mc "You have one choice: stay here… or fight."
    mc "Tienes una opción: quédate aquí... o pelea."

# game/Story03.rpy:5783

translate spanish akt3chapter5_1_ec129253:

    # mc "I’m not going to sit around."
    mc "No me voy a sentar."

# game/Story03.rpy:5784

translate spanish akt3chapter5_1_a600edea:

    # mc "I’m going."
    mc "Me voy."

# game/Story03.rpy:5786

translate spanish akt3chapter5_1_7d1f3def:

    # mc "Alone, if I have to."
    mc "Solo, si tengo que hacerlo."

# game/Story03.rpy:5788

translate spanish akt3chapter5_1_0061b368_4:

    # ggg "..."
    ggg "..."

# game/Story03.rpy:5790

translate spanish akt3chapter5_1_0061b368_5:

    # ggg "..."
    ggg "..."

# game/Story03.rpy:5794

translate spanish akt3chapter5_1_2c1640cb:

    # mc "(Whispering) No choice..."
    mc "No hay elección..."

# game/Story03.rpy:5801

translate spanish akt3chapter5_1_060ab042:

    # ggg "Fuck it. Better than waiting."
    ggg "Mejor que esperar."

# game/Story03.rpy:5833

translate spanish akt3chapter5_1_66158ff4:

    # g "I’d rather die with a gun, than under their boots in some filthy hole."
    g "Prefiero morir con un arma, que bajo sus botas en un agujero sucio."

# game/Story03.rpy:5843

translate spanish akt3chapter5_2_2625fddd:

    # aa "Almost imperial, grand, with just a hint of mass grave."
    aa "Casi imperial, grande, con solo un toque de fosa de masa."

# game/Story03.rpy:5874

translate spanish akt3chapter5_2_35dffb23:

    # sel "Leave her."
    sel "Déjala."

# game/Story03.rpy:5879

translate spanish akt3chapter5_2_7a92fef3:

    # sel "Don’t worry. This will end soon enough."
    sel "No te preocupes. Esto terminará pronto."

# game/Story03.rpy:5889

translate spanish akt3chapter5_2_8ebdca62:

    # sel "Though abandoning your own people…"
    sel "Aunque abandone a su propia gente..."

# game/Story03.rpy:5891

translate spanish akt3chapter5_2_86694098:

    # am "Not betrayal."
    am "No traición."

# game/Story03.rpy:5893

translate spanish akt3chapter5_2_666ff92b:

    # sel "Is that what you call it?"
    sel "¿Así lo llamas?"

# game/Story03.rpy:5895

translate spanish akt3chapter5_2_18b55e4f:

    # am "Mercy."
    am "Mercy."

# game/Story03.rpy:5900

translate spanish akt3chapter5_2_5935d0ed:

    # sel "If that comforts you… keep it."
    sel "Si eso te consuela... manténgalo."

# game/Story03.rpy:5901

translate spanish akt3chapter5_2_a67525ab:

    # sel "Judgment was never my role."
    sel "El juicio nunca fue mi papel."

# game/Story03.rpy:5903

translate spanish akt3chapter5_2_1a5bc27a:

    # am "Emotion is weakness."
    am "La emoción es debilidad."

# game/Story03.rpy:5904

translate spanish akt3chapter5_2_4ef316d7:

    # am "And you’ve surrendered to it."
    am "Y te has rendido a ello."

# game/Story03.rpy:5906

translate spanish akt3chapter5_2_1afa2acd:

    # sel "Then why do you still want her back?"
    sel "¿Entonces por qué la quieres de vuelta?"

# game/Story03.rpy:5910

translate spanish akt3chapter5_2_624c47f0:

    # am "So I can finally be done with this."
    am "Así que finalmente puedo terminar con esto."

# game/Story03.rpy:5912

translate spanish akt3chapter5_2_095d5754:

    # sel "We’re not as different as you pretend."
    sel "No somos tan diferentes como tú finges."

# game/Story03.rpy:5918

translate spanish akt3chapter5_2_b1f87fea:

    # am "You still confuse desire with purpose."
    am "Todavía confundes el deseo con propósito."

# game/Story03.rpy:5920

translate spanish akt3chapter5_2_41973757:

    # sel "Perhaps."
    sel "Tal vez."

# game/Story03.rpy:5923

translate spanish akt3chapter5_2_54593eb7:

    # sel "Destroying my head was, at the very least, discourteous."
    sel "Destruir mi cabeza era, al menos, desalentadora."

# game/Story03.rpy:5939

translate spanish akt3chapter5_2_3400050f:

    # sel "You knew. And still..."
    sel "Lo sabías, y aún así..."

# game/Story03.rpy:5951

translate spanish akt3chapter5_2_0e159cb4:

    # sel "That’s not like you, Astoria..."
    sel "No es como tú, Astoria..."

# game/Story03.rpy:5953

translate spanish akt3chapter5_2_19e922b3:

    # Fl "Then again..."
    Fl "Entonces otra vez..."

# game/Story03.rpy:6019

translate spanish akt3chapter5_2_746f342b:

    # Fl "Boop..."
    Fl "Boop..."

# game/Story03.rpy:6035

translate spanish akt3chapter5_2_90dbf691:

    # Fl "...Now’s not the time."
    Fl "...Ahora no es el momento."

# game/Story03.rpy:6041

translate spanish akt3chapter5_2_bac26605:

    # mc "(Time to go. I owe a visit..."
    mc "Debo una visita..."

# game/Story03.rpy:6059

translate spanish akt3chapter5_2_d4e58502:

    # h "That’s not fair! We agreed, no implants, no cheap tricks!"
    h "¡No es justo! ¡Acordamos, no implantes, no trucos baratos!"

# game/Story03.rpy:6112

translate spanish akt3chapter5_2_c37e4714:

    # h "Let me guess, Lora’s handwork?"
    h "Déjame adivinar, ¿la tarea de Lora?"

# game/Story03.rpy:6127

translate spanish akt3chapter5_2_bb48386b:

    # h "You’ve been awfully popular lately."
    h "Has sido muy popular últimamente."

# game/Story03.rpy:6160

translate spanish akt3chapter5_2_350e2379:

    # h "Don’t give me that look."
    h "No me des esa mirada."

# game/Story03.rpy:6161

translate spanish akt3chapter5_2_a77a6f27:

    # h "Every time I turn around, there’s another girl hanging off you."
    h "Cada vez que me doy vuelta, hay otra chica colgando de ti."

# game/Story03.rpy:6162

translate spanish akt3chapter5_2_2ace915a:

    # h "Just don’t lie to me."
    h "No me mientas."

# game/Story03.rpy:6166

translate spanish akt3chapter5_2_58a2d515:

    # h "And don’t make me feel replaceable."
    h "Y no me hagas sentir reemplazable."

# game/Story03.rpy:6168

translate spanish akt3chapter5_2_fbba889c:

    # h "Honestly?"
    h "¿Honestamente?"

# game/Story03.rpy:6204

translate spanish akt3chapter5_2_c255441b:

    # h "I’m not even sure who scares me more."
    h "Ni siquiera estoy seguro de quién me asusta más."

# game/Story03.rpy:6205

translate spanish akt3chapter5_2_4ca4391a:

    # h "You... or Lora."
    h "Tú... o Lora."

# game/Story03.rpy:6207

translate spanish akt3chapter5_2_d080bc42:

    # h "I keep telling myself this is a bad idea."
    h "Sigo diciéndome que es una mala idea."

# game/Story03.rpy:6213

translate spanish akt3chapter5_2_f9ce9344:

    # h "But every time I try to back away..."
    h "Pero cada vez que intento alejarme..."

# game/Story03.rpy:6218

translate spanish akt3chapter5_2_fa0c3cd5:

    # h "I just want you more."
    h "Solo quiero más."

# game/Story03.rpy:6219

translate spanish akt3chapter5_2_adbfa2cd:

    # mc "I don’t really care."
    mc "No me importa."

# game/Story03.rpy:6229

translate spanish akt3chapter5_2_201b6c08:

    # h "You’ve got terrible timing."
    h "Tienes un momento terrible."

# game/Story03.rpy:6230

translate spanish akt3chapter5_2_51b52653:

    # h "...You’re impossible."
    h "...Eres imposible."

# game/Story03.rpy:6232

translate spanish akt3chapter5_2_c6f01622:

    # h "What the hell got into you today?"
    h "¿Qué demonios te ha metido hoy?"

# game/Story03.rpy:6234

translate spanish akt3chapter5_2_64d5bba1:

    # h "...Cocky asshole."
    h "... ¡Maldito imbécil!"

# game/Story03.rpy:6237

translate spanish akt3chapter5_2_faf95fd1:

    # mc "You don’t have to act tough with me."
    mc "No tienes que actuar duro conmigo."

# game/Story03.rpy:6238

translate spanish akt3chapter5_2_a82676f1:

    # h "...Says who?"
    h "¿Quién dice?"

# game/Story03.rpy:6239

translate spanish akt3chapter5_2_8ee75081_1:

    # mc "You’re shaking."
    mc "Te estás sacudiendo."

# game/Story03.rpy:6241

translate spanish akt3chapter5_2_cd543497:

    # h "...You fight dirty."
    h "... luchas sucio."

# game/Story03.rpy:6242

translate spanish akt3chapter5_2_e7240eb2:

    # mc "You started this."
    mc "Tú empezaste esto."

# game/Story03.rpy:6244

translate spanish akt3chapter5_2_a89bccd2:

    # h "You talk too damn much."
    h "Hablas demasiado."

# game/Story03.rpy:6245

translate spanish akt3chapter5_2_69b064b1:

    # h "...And stop looking at me like that."
    h "Y deja de mirarme así."

# game/Story03.rpy:6247

translate spanish akt3chapter5_2_b2aba0e3:

    # mc "Like what?"
    mc "¿Como qué?"

# game/Story03.rpy:6249

translate spanish akt3chapter5_2_900f9f9b:

    # h "...awkward."
    h "...increíble."

# game/Story03.rpy:6251

translate spanish akt3chapter5_2_ff55d33c:

    # mc "You keep testing people."
    mc "Sigues probando a la gente."

# game/Story03.rpy:6252

translate spanish akt3chapter5_2_aa946c3b:

    # mc "I’m just not backing away."
    mc "No estoy atrasada."

# game/Story03.rpy:6254

translate spanish akt3chapter5_2_e94e6658:

    # h "...That’s the problem."
    h "...Ese es el problema."

# game/Story03.rpy:6256

translate spanish akt3chapter5_2_1b665527:

    # h "...So what now?"
    h "¿Y ahora qué?"

# game/Story03.rpy:6258

translate spanish akt3chapter5_2_793b2a87:

    # h "You gonna keep talking..."
    h "Vas a seguir hablando..."

# game/Story03.rpy:6259

translate spanish akt3chapter5_2_ede40bb0:

    # h "Or finally do something?"
    h "¿O finalmente hacer algo?"

# game/Story03.rpy:6264

translate spanish akt3chapter5_2_216fe352:

    # mc "You’re already shaking."
    mc "Ya te estás sacudiendo."

# game/Story03.rpy:6266

translate spanish akt3chapter5_2_f2718d2c:

    # h "...And whose fault is that?"
    h "¿Y cuál es la culpa?"

# game/Story03.rpy:6267

translate spanish akt3chapter5_2_eae9fce4:

    # mc "You keep acting like you’ve still got your guard up."
    mc "Sigues actuando como si todavía hubieras levantado tu guardia."

# game/Story03.rpy:6268

translate spanish akt3chapter5_2_513c1325:

    # h "Maybe I do."
    h "Tal vez lo haga."

# game/Story03.rpy:6269

translate spanish akt3chapter5_2_fc4fd4bd:

    # mc "Not with me."
    mc "No conmigo."

# game/Story03.rpy:6270

translate spanish akt3chapter5_2_a9e5ea3b:

    # h "...Shut up."
    h "...Cállate."

# game/Story03.rpy:6271

translate spanish akt3chapter5_2_0bf12d49:

    # mc "(Those trembling fingers... that uneven breathing...)"
    mc "(Los dedos temblantes... que respiran desparramadamente...)"

# game/Story03.rpy:6272

translate spanish akt3chapter5_2_fa1b5189:

    # mc "(She’s trying so hard not to break first.)"
    mc "(Ella está tratando tan difícil de no romper primero.)"

# game/Story03.rpy:6281

translate spanish akt3chapter5_2_8d2ab91d:

    # h "...You really don’t back off, do you?"
    h "... realmente no te marchas, ¿verdad?"

# game/Story03.rpy:6282

translate spanish akt3chapter5_2_5e01d4cd:

    # mc "Should I?"
    mc "¿Debería?"

# game/Story03.rpy:6283

translate spanish akt3chapter5_2_adec3928:

    # h "...No."
    h "...no."

# game/Story03.rpy:6284

translate spanish akt3chapter5_2_cca62a2c:

    # h "That’s what makes this so damn unfair."
    h "Eso es lo que hace que esto sea tan injusto."

# game/Story03.rpy:6285

translate spanish akt3chapter5_2_46398104:

    # mc "You could still stop me."
    mc "Todavía puedes detenerme."

# game/Story03.rpy:6286

translate spanish akt3chapter5_2_e417c014:

    # h "...I know."
    h "...lo sé."

# game/Story03.rpy:6287

translate spanish akt3chapter5_2_63cbbd81:

    # mc "(All that attitude, all that fire...)"
    mc "(Toda esa actitud, todo ese fuego...)"

# game/Story03.rpy:6288

translate spanish akt3chapter5_2_c5b48b29:

    # mc "(And underneath it... she just wants someone who stays.)"
    mc "(Y debajo de ella... ella solo quiere a alguien que se queda.)"

# game/Story03.rpy:6289

translate spanish akt3chapter5_2_3d37c993:

    # h "(I hate this...)"
    h "(Odio esto...)"

# game/Story03.rpy:6290

translate spanish akt3chapter5_2_718ac1c4:

    # h "(...How easy it is to lose myself around him.)"
    h "(...qué fácil es perderme a su alrededor.)"

# game/Story03.rpy:6291

translate spanish akt3chapter5_2_8fd50577:

    # mc "You don’t always have to fight me."
    mc "No siempre tienes que luchar conmigo."

# game/Story03.rpy:6292

translate spanish akt3chapter5_2_34d45548:

    # h "...Maybe."
    h "...tal vez."

# game/Story03.rpy:6293

translate spanish akt3chapter5_2_898df622:

    # h "But I don’t know how not to."
    h "Pero no sé cómo no hacerlo."

# game/Story03.rpy:6294

translate spanish akt3chapter5_2_6f887114:

    # mc "Then stop thinking."
    mc "Entonces deja de pensar."

# game/Story03.rpy:6295

translate spanish akt3chapter5_2_2e0b71c8:

    # h "...That’s a terrible idea."
    h "...Es una idea terrible."

# game/Story03.rpy:6296

translate spanish akt3chapter5_2_ad254bb7:

    # mc "You still haven’t moved away."
    mc "Aún no te has mudado."

# game/Story03.rpy:6297

translate spanish akt3chapter5_2_daedd3b9:

    # h "...Yeah."
    h "...Sí."

# game/Story03.rpy:6298

translate spanish akt3chapter5_2_ddcf3c8f:

    # h "...Guess I haven’t."
    h "... la señora que no tengo."

# game/Story03.rpy:6304

translate spanish akt3chapter6_99155a02:

    # "Sector 3."
    "Sector 3."

