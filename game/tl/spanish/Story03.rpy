    mc "No me pongas esta mierda encima."

# game/Story03.rpy:4803

translate spanish akt3chapter4_ac79912b:

    # Fl "...I’m not—"
    Fl "...no lo soy..."

# game/Story03.rpy:4806

translate spanish akt3chapter4_cf1adef2:

    # mc "Yeah."
    mc "Sí."

# game/Story03.rpy:4807

translate spanish akt3chapter4_d459d718:

    # mc "That’s exactly what you’re doing."
    mc "Eso es exactamente lo que estás haciendo."

# game/Story03.rpy:4810

translate spanish akt3chapter4_a2104853:

    # Fl "Because..."
    Fl "Porque..."

# game/Story03.rpy:4821

translate spanish akt3chapter4_acc1c356:

    # Fl "You always needed things spelled out emotionally."
    Fl "Siempre necesitabas cosas que se deletreaban emocionalmente."

# game/Story03.rpy:4823

translate spanish akt3chapter4_656551f8:

    # Fl "So I push."
    Fl "Así que empujo."

# game/Story03.rpy:4824

translate spanish akt3chapter4_84094cc4:

    # Fl "Because it works."
    Fl "Porque funciona."

# game/Story03.rpy:4826

translate spanish akt3chapter4_9e19a94a:

    # Fl "Usually."
    Fl "Normalmente."

# game/Story03.rpy:4828

translate spanish akt3chapter4_716931f4:

    # Fl "If you want to laugh, go ahead."
    Fl "Si quieres reírte, adelante."

# game/Story03.rpy:4832

translate spanish akt3chapter4_108da70c:

    # Fl "Smart enough to build systems."
    Fl "Lo suficientemente inteligente para construir sistemas."

# game/Story03.rpy:4833

translate spanish akt3chapter4_c24f223c:

    # Fl "Too stupid to talk to people."
    Fl "Demasiado estúpido para hablar con la gente."

# game/Story03.rpy:4839

translate spanish akt3chapter4_e0fc7c5b:

    # mc "You’re spoiled."
    mc "Estás arruinado."

# game/Story03.rpy:4844

translate spanish akt3chapter4_49f43cae:

    # Fl "I am NOT spoiled!"
    Fl "¡No estoy malcriada!"

# game/Story03.rpy:4852

translate spanish akt3chapter4_99b98ad8:

    # mc "Then prove me wrong."
    mc "Entonces prueba que me equivoco."

# game/Story03.rpy:4861

translate spanish akt3chapter4_f07ba957:

    # Fl "I—"
    Fl "Yo..."

# game/Story03.rpy:4865

translate spanish akt3chapter4_7e0d3f9f:

    # mc "What’s your answer?"
    mc "¿Cuál es tu respuesta?"

# game/Story03.rpy:4868

translate spanish akt3chapter4_e495dd2c:

    # Fl "You really are an asshole."
    Fl "Eres un idiota."

# game/Story03.rpy:4871

translate spanish akt3chapter4_e186c9b3:

    # mc "Yeah. Probably."
    mc "Sí, probablemente."

# game/Story03.rpy:4877

translate spanish akt3chapter4_9452bee5:

    # L "I—"
    L "Yo..."

# game/Story03.rpy:4878

translate spanish akt3chapter4_11b9660c:

    # L "...What are you two doing?"
    L "¿Qué están haciendo?"

# game/Story03.rpy:4881

translate spanish akt3chapter4_4851f5a4:

    # Fl "Talking."
    Fl "Hablando."

# game/Story03.rpy:4883

