    # L "But I need this. Like a bullet to the head — painful, but clean."
    L "Pero necesito esto. Como una bala en la cabeza — dolorosa, pero limpia."

# game/Story03.rpy:362

translate spanish story04_674c1331:

    # a "Fine. But make it quick."
    a "Bien, pero hazlo rápido."

# game/Story03.rpy:364

translate spanish story04_5516dce5:

    # L "How generous of you. In your own way."
    L "Qué generoso eres, a tu manera."

# game/Story03.rpy:371

translate spanish story04_150cb91c:

    # mc "And? What was that all about?"
    mc "¿De qué se trataba todo eso?"

# game/Story03.rpy:377

translate spanish story04_d87cec31:

    # L "Permission. Or freedom. Depends on which word makes you feel safer."
    L "Permiso, o libertad, depende de qué palabra te hace sentir más seguro."

# game/Story03.rpy:380

translate spanish story04_f7ba51dd:

    # L "Astoria assigned her to me. Like chaining a guard dog to a specimen jar."
    L "Astoria me la asignó, como encadenar un perro guardián a un frasco de especímenes."

# game/Story03.rpy:389

translate spanish story04_8e38de83:

    # L "Said it was for safety. But really, I’m under surveillance."
    L "Dijo que era por seguridad, pero en realidad, estoy bajo vigilancia."

# game/Story03.rpy:391

translate spanish story04_def48c6b:

    # L "I sleep — she files a report. I stay silent — they monitor my breathing. I think about you - they..."
    L "Duermo — ella presenta un informe. Me quedo en silencio — ellos monitorean mi respiración. Pienso en ti - ellos..."

# game/Story03.rpy:395

translate spanish story04_b2e20135:

    # L "And now she’s gone. For a few minutes. I almost feel alive."
    L "Y ahora se ha ido. Por unos minutos. Casi me siento vivo."

# game/Story03.rpy:398

translate spanish story04_cdf17c90:

    # h "Heard you’re kind of a big deal around here... So why’s your cage all rust and no gold?"
    h "Oí que eres un gran problema por aquí... ¿Por qué tu jaula es toda oxidada y no hay oro?"

# game/Story03.rpy:401

translate spanish story04_e13941b9:

    # h "Where are the servants, the wine cellar, the friendly beast who doesn’t try to eat your face?"
    h "¿Dónde están los sirvientes, la bodega, la bestia amigable que no trata de comer tu cara?"

# game/Story03.rpy:402

translate spanish story04_41df73e1:

    # h "Although, if you want the latter — we do have some ideas."
    h "Aunque, si quieres a este último, tenemos algunas ideas."

# game/Story03.rpy:408

translate spanish story04_a4d4c4bb:

    # L "A broom closet for a home, a warden for a nanny, and creatures who think I’m dinner with a side of fear."
    L "Un armario de escoba para un hogar, un guardián para una niñera, y criaturas que piensan que estoy cenando con un lado del miedo."

# game/Story03.rpy:409

translate spanish story04_ab6ba2a5:

    # L "Yeah, I’ve really made it."
    L "Sí, realmente lo he conseguido."

# game/Story03.rpy:411

translate spanish story04_c38253f0:

    # h "Ironically? Yeah. You definitely win this round of misery bingo."
    h "Sí, definitivamente ganas esta ronda de bingo de la miseria."

# game/Story03.rpy:413

translate spanish story04_53108ba4:

    # mc "Fine. I’ll bring snacks next time — maybe we’ll strike a deal."
    mc "Bien. La próxima vez traeré aperitivos, tal vez podamos hacer un trato."

# game/Story03.rpy:415

translate spanish story04_ed4d1fb3:

    # h "Knew it. You’re not here by choice. Fairy tales always lie..."
    h "Lo sabías. No estás aquí por elección. Los cuentos de hadas siempre mienten..."

# game/Story03.rpy:416

translate spanish story04_a4bf996b:

    # L "Give me a heads up. I’ll pick out someone’s arm for a treat."
    L "Dame una cabeza. Voy a recoger el brazo de alguien para un regalo."

# game/Story03.rpy:423

translate spanish story04_9e0dc583:

    # L "But seriously — how did you get here?"
    L "Pero en serio, ¿cómo llegaste aquí?"

# game/Story03.rpy:424

translate spanish story04_bd645c39:

    # L "You both look... worn out. But just as stubborn as ever."
    L "Ambos se ven... desgastados, pero tan tercos como siempre."

# game/Story03.rpy:426

translate spanish story04_3858a940:

    # h "Great question... We’ve got no idea ourselves."
    h "Gran pregunta... No tenemos idea de nosotros mismos."

# game/Story03.rpy:427

translate spanish story04_056e943d:

    # h "One moment you’re staring at some rift, next thing — boom. Different galaxy."
    h "Un momento estás mirando un grifo, siguiente cosa: boom. Diferente galaxia."

# game/Story03.rpy:429

translate spanish story04_a5ef7147:

    # mc "Nothing to add, really."
    mc "Nada que añadir, en realidad."

# game/Story03.rpy:430

translate spanish story04_3b7e9d0d:

    # mc "We’re somewhere in the Ark Federation. Got pulled in through a portal."
    mc "Estamos en algún lugar de la Federación de Arcas."

# game/Story03.rpy:432

translate spanish story04_35cafdc5:

    # mc "Everything else? We’re kept in the dark — literally."
    mc "¿Todo lo demás? Estamos guardados en la oscuridad — literalmente."

# game/Story03.rpy:441

translate spanish story04_cbf53f8d:

    # L "Yeah, sounds like their style..."
    L "Sí, suena como su estilo..."

# game/Story03.rpy:445

translate spanish story04_a161270c:

    # mc "You seem better now. Was it because of her?"
    mc "Pareces mejor ahora. ¿Fue por ella?"

# game/Story03.rpy:447

translate spanish story04_34301b56:

    # L "Partially. But not really. The truth is — I’m just tired of pretending everything’s fine."
    L "En parte. Pero no realmente. La verdad es: estoy cansado de fingir que todo está bien."

# game/Story03.rpy:448

translate spanish story04_a3c688b1:

    # L "It’s still hard to meet your eyes. For what I did... or failed to do."
    L "Aún es difícil conocer tus ojos. Por lo que hice... o fallé en hacer."

# game/Story03.rpy:450

translate spanish story04_1fd2a000:

    # mc "No desire to talk about it?"
    mc "¿No hay deseo de hablar de ello?"

# game/Story03.rpy:452

translate spanish story04_714d9b7f:

    # L "I want to. Just... not yet. I’ve lost too much already to ruin this moment too."
    L "Quiero. Solo... aún no. He perdido demasiado ya para arruinar este momento también."

# game/Story03.rpy:454

translate spanish story04_304beb63:

    # mc "(Why? We’re not strangers. Then why won’t you tell me…?)"
    mc "¿Por qué? No somos extraños. Entonces, ¿por qué no me dices...?"

# game/Story03.rpy:457

translate spanish story04_e75ed200:

    # mc "If that’s how it is."
    mc "Si así es."

# game/Story03.rpy:460

translate spanish story04_c75a513b:

    # h "Seriously, [mc]? We crawled through a grinder to get here, and now you’re acting like some schoolboy too shy to confess a crush?"
    h "En serio, [mc]? Nos arrastramos por una molinillo para llegar aquí, y ahora estás actuando como un estudiante demasiado tímido para confesar un triturado?"

# game/Story03.rpy:461

translate spanish story04_601a66eb:

    # h "Where’s the fist on the table, the big words? All that dramatic crap you usually throw at us?"
    h "¿Dónde está el puño en la mesa, las grandes palabras? ¿Toda esa mierda dramática que nos tiras normalmente?"

# game/Story03.rpy:464

translate spanish story04_06763333:

    # h "Where’s the explosion? The storm of emotions? Where’s your damn passion!"
    h "¿Dónde está la explosión? ¡La tormenta de emociones? ¿Dónde está tu maldita pasión!"

# game/Story03.rpy:466

translate spanish story04_6cba907f:

    # mc "You know what, she’s got a point. We haven’t seen each other in so long..."
    mc "Sabes que, ella tiene un punto. No nos hemos visto en tanto tiempo..."

# game/Story03.rpy:467

translate spanish story04_c3828297:

    # mc "You even became a grandmother, did you know that?"
    mc "Te has convertido en abuela, ¿lo sabías?"

# game/Story03.rpy:470

translate spanish story04_4eefabd0:

    # L "WHAT?!"
    L "¿Qué?"

# game/Story03.rpy:473

translate spanish story04_25a271ee:

    # L "Wait. I already was, wasn’t I? You mean Mina?"
    L "Espera. ¿Ya lo estaba, no? ¿Te refieres a Mina?"

# game/Story03.rpy:476

translate spanish story04_3ba45830:

    # mc "You still remember her..."
    mc "Todavía la recuerdas..."

# game/Story03.rpy:478

translate spanish story04_c475d1b7:

    # L "Of course! How could I forget that darling. How’s she doing?"
    L "¡Por supuesto! ¿Cómo puedo olvidar a ese querido? ¿Cómo está?"

# game/Story03.rpy:480

translate spanish story04_3e6cb3d6:

    # mc "You wouldn’t recognize her now."
    mc "No la reconocerías ahora."

# game/Story03.rpy:482

translate spanish story04_d12a027a:

    # L "Ha, I don’t doubt it. It’s been so many years..."
    L "Ha, no lo dudo. Ha sido tantos años..."

# game/Story03.rpy:483

translate spanish story04_8f0b9724:

    # L "Mina was always the light of my life. Those big eyes... I hope she’s happy."
    L "Mina siempre era la luz de mi vida. Esos grandes ojos... espero que sea feliz."

# game/Story03.rpy:485

translate spanish story04_76394643:

    # mc "She is. Enough."
    mc "Ya está, ya basta."

# game/Story03.rpy:487

translate spanish story04_9843fbce:

    # L "And Anya?"
    L "¿Y Anya?"

# game/Story03.rpy:489

translate spanish story04_8735c1cf:

    # mc "Anya? Still the same. Still pestering her sister."
    mc "Todavía igual, sigue molestando a su hermana."

# game/Story03.rpy:491

translate spanish story04_3cf0cef0:

    # h "She’s a bit more tolerable now. Well... mostly."
    h "Es un poco más tolerable ahora. Bueno... sobre todo."

# game/Story03.rpy:492

translate spanish story04_7f1d2572:

    # h "Sometimes you can even forget she’s a walking disaster wrapped in a cute package."
    h "A veces incluso puedes olvidar que es un desastre andante envuelto en un paquete lindo."

# game/Story03.rpy:495

translate spanish story04_ffe217b7:

    # L "You still run that bar?"
    L "¿Aún manejas ese bar?"

# game/Story03.rpy:497

translate spanish story04_866b7c7a:

    # h "Of course. It’s my life! {w}Okay, third place. First is Anya."
    h "Por supuesto. ¡Es mi vida! {w}Bien, tercer lugar, primero Anya."

# game/Story03.rpy:499

translate spanish story04_7495d250:

    # mc "Third? Not second?"
    mc "¿Tercer?"

# game/Story03.rpy:502

translate spanish story04_8dde6d4c:

    # h "Nope. Second’s personal."
    h "No. El segundo es personal."

# game/Story03.rpy:504

translate spanish story04_6ef9730a:

    # h "And don’t go digging. Nothing pretty down there."
    h "Y no vayas a cavar. Nada bonito ahí abajo."

# game/Story03.rpy:508

translate spanish story04_0b1cb94a:

    # L "You two got close. Maybe too close."
    L "Ustedes dos se acercaron, quizá demasiado cerca."

# game/Story03.rpy:510

translate spanish story04_3eff1c52:

    # L "I’m beginning to suspect you’re poaching my husband."
    L "Estoy empezando a sospechar que estás cazando a mi marido."

# game/Story03.rpy:512

translate spanish story04_aaa38644:

    # h "Too late, Lora. He’s mine now — willingly and begrudgingly."
    h "Demasiado tarde, Lora. Ahora es mío, voluntariamente y con frisura."

# game/Story03.rpy:513

translate spanish story04_c3482f25:

    # h "Every Friday: coffee, complaining, and my genius plans. I think he’s even starting to enjoy it. Or he’s just given up."
    h "Cada viernes: café, quejarse y mis planes de genio. Creo que incluso está empezando a disfrutarlo. O acaba de renunciar."

# game/Story03.rpy:515

translate spanish story04_0b458dc6:

    # mc "Because you always forget to add sugar."
    mc "Porque siempre olvidas añadir azúcar."

# game/Story03.rpy:517

translate spanish story04_96aae327:

    # h "Lies and slander. He just doesn’t get real coffee without vanilla fancy foam."
    h "Mentiras y calumnias. Él no consigue café real sin espuma de vainilla de lujo."

# game/Story03.rpy:519

translate spanish story04_ccd8cef8:

    # mc "Should’ve stayed in the coma..."
    mc "Debería haber estado en coma..."

# game/Story03.rpy:521

translate spanish story04_9cf4b8ad:

    # h "You chose a coma without me?!"
    h "¿Elegiste un coma sin mí?"

# game/Story03.rpy:522

translate spanish story04_0abca9d1:

    # h "Wow, [mc]. Even betrayal sounds softer than that."
    h "Vaya, [mc]Incluso la traición suena más suave que eso."

# game/Story03.rpy:529

translate spanish story04_6c83929f:

    # mc "(Seeing them smile... Really, what more could I ask for?)"
    mc "(Verles sonreír... ¿En serio, qué más podría pedir?)"

# game/Story03.rpy:530

translate spanish story04_f1e25f6a:

    # mc "(Just let this moment last a little longer.)"
    mc "(Solo deja que este momento dure un poco más.)"

# game/Story03.rpy:537

translate spanish story04_bbd34ff3:

    # a "Time’s up."
    a "Se acabó el tiempo."

# game/Story03.rpy:542

translate spanish story04_c933f6af:

    # L "I will tell you everything. Just... let me hold onto this moment a bit longer."
    L "Te lo diré todo, solo... déjame aguantar este momento un poco más."

# game/Story03.rpy:547

translate spanish story04_8ab296cf:

    # mc "Please. Just don’t make me wait too long..."
    mc "Por favor. No me hagas esperar demasiado tiempo..."

# game/Story03.rpy:563

translate spanish story04_e30e32b1:

    # mc "(This suffocating tension between them...)"
    mc "(Esta tensión asfixiante entre ellos...)"

# game/Story03.rpy:565

translate spanish story04_43694cd5:

    # mc "(If this keeps up — something’s bound to snap.)"
    mc "(Si esto sigue así, algo está obligado a romper.)"

# game/Story03.rpy:569

translate spanish story04_d2c80bad:

    # mc "Where are we going?"
    mc "¿Adónde vamos?"

# game/Story03.rpy:572

translate spanish story04_1909d665:

    # h "No clue. You’ll get more words out of a brick wall than out of Miss Silent here."
    h "No hay pista. Tendrás más palabras de una pared de ladrillo que de la Srta. Silent aquí."

# game/Story03.rpy:576

translate spanish story04_a3f9ee41:

    # h "If I hadn’t overheard something about a forward base, I wouldn’t have stepped a foot in this mess."
    h "Si no hubiera escuchado algo sobre una base de avance, no habría pisado un pie en este desastre."

# game/Story03.rpy:581

translate spanish story04_bcb2f423:

    # mc "And the plan?"
    mc "¿Y el plan?"

# game/Story03.rpy:591

translate spanish story04_4141f2c1:

    # h "That’s the catch. The cat said they’re short on people—literally."
    h "Esa es la captura. El gato dijo que son cortos en la gente —literalmente."

# game/Story03.rpy:592

translate spanish story04_66b14353:

    # h "A couple of soldiers she knows, some beastkin... But it’s a drop in the ocean."
    h "Un par de soldados que conoce, una bestia... pero es una gota en el océano."

# game/Story03.rpy:596

translate spanish story04_0c94c54b:

    # L "Who are you talking about?"
    L "¿De quién estás hablando?"

# game/Story03.rpy:598

translate spanish story04_2c2f9e9c:

    # L "Sorry, overheard a bit. Got curious."
    L "Lo siento, oí un poco."

# game/Story03.rpy:601

translate spanish story04_1d38e810:

    # h "About the arrogant cat. Flora. Everyone here knows her."
    h "Todo el mundo aquí la conoce."

# game/Story03.rpy:602

translate spanish story04_2ea4fb50:

    # h "She’s basically the acting commander now."
    h "Ella es básicamente el comandante en funciones ahora."

# game/Story03.rpy:604

translate spanish story04_ed0ea76a:

    # L "Flora?.. You mean Ostorius Sevin’s daughter?"
    L "Flora... ¿Te refieres a la hija de Ostorius Sevin?"

# game/Story03.rpy:608

translate spanish story04_fea56c05:

    # h "Whoa. That reaction — don’t tell me you know her?"
    h "Esa reacción - no me digas que la conoces?"

# game/Story03.rpy:612

translate spanish story04_f810296e:

    # h "(whispers) Why’s she staring like that...?"
    h "¿Por qué está mirando así?"

# game/Story03.rpy:613

translate spanish story04_4701063a:

    # mc "(whispers) Looks like she knows her. And not in a good way.)"
    mc "Parece que la conoce, y no de una manera buena."

# game/Story03.rpy:616

translate spanish story04_da7b02ca:

    # L "Her mother... was my mentor."
    L "Su madre... era mi mentor."

# game/Story03.rpy:617

translate spanish story04_fac44a50:

    # L "If not for her — I wouldn’t be here."
    L "Si no fuera por ella, no estaría aquí."

# game/Story03.rpy:620

translate spanish story04_1bc822f4:

    # L "Did I say something wrong?"
    L "¿Dije algo malo?"

# game/Story03.rpy:626

translate spanish story04_862a3ba2:

    # mc "(Something’s off here...)"
    mc "(Algo está aquí...)"

# game/Story03.rpy:630

translate spanish story04_00b82b6d:

    # mc "(whispers) Is there something wrong with Flora?"
    mc "¿Hay algo malo con Flora?"

# game/Story03.rpy:632

translate spanish story04_89a38896:

    # L "(whispers) With her — no. But her mother... that’s another story."
    L "Con ella —no. Pero su madre... esa es otra historia."

# game/Story03.rpy:636

translate spanish story04_1979c3e4:

    # L "(whispers) To the Inquisition, both of them are a pain in the ass."
    L "A la Inquisición, ambos son un dolor en el culo."

# game/Story03.rpy:638

translate spanish story04_5b8f47bb:

    # mc "(Looks like Lora shares a deeper burden with someone...)"
    mc "(Parece que Lora comparte una carga más profunda con alguien...)"

# game/Story03.rpy:639

translate spanish story04_3ff13d56:

    # mc "(What have you gotten yourself into...)"
    mc "(En qué te has metido...)"

# game/Story03.rpy:643

translate spanish story04_7282a154:

    # h "Okay, can we finally talk about why we’re hauling ourselves to this so-called forward base?"
    h "Vale, ¿podemos hablar por fin de por qué nos estamos llevando a esta llamada base de futuro?"

# game/Story03.rpy:647

translate spanish story04_38bf86db:

    # L "We’re here to deliver intel to Central Command."
    L "Estamos aquí para entregar información al Comando Central."

# game/Story03.rpy:650

translate spanish story04_a81d7fbe:

    # h "Seriously? What kind of intel?"
    h "¿Qué clase de información?"

# game/Story03.rpy:652

translate spanish story04_f7b7d848:

    # a "No help is coming."
    a "No hay ayuda."

# game/Story03.rpy:653

translate spanish story04_aa9ddee0:

    # L "I... wasn’t expecting that."
    L "Yo... no esperaba eso."

# game/Story03.rpy:656

translate spanish story04_3f1bc204:

    # mc "Is that... the official response?"
    mc "¿Es... la respuesta oficial?"

# game/Story03.rpy:660

translate spanish story04_0d1f38b5:

    # a "It’s an order. From the Lady herself."
    a "Es una orden. De la propia Señora."

# game/Story03.rpy:663

translate spanish story04_b0133794:

    # mc "(What the hell is that supposed to mean?)"
    mc "(¿Qué diablos se supone que significa eso?)"

# game/Story03.rpy:675

translate spanish story04_c08608ec:

    # mc "Who even are you? How are we supposed to address you?"
    mc "¿Cómo se supone que nos dirigimos a ti?"

# game/Story03.rpy:679

translate spanish story04_8b346338:

    # a "I have no name."
    a "No tengo nombre."

# game/Story03.rpy:686

translate spanish story04_f769b642:

    # mc "You and Calestra — are you from the same twisted nest?"
    mc "Calestra y tú sois del mismo nido retorcido."

# game/Story03.rpy:687

translate spanish story04_857dee33:

    # h "(whispers) Ooof, you probably shouldn’t have said that..."
    h "(susurros) Ooof, probablemente no deberías haber dicho que..."

# game/Story03.rpy:688

translate spanish story04_a6839d6b:

    # mc "(whispers) What, it’s not like it can get worse."
    mc "(susurros) Qué, no es como si pudiera empeorar."

# game/Story03.rpy:693

translate spanish story04_f9cfefa3:

    # a "How do you know her?"
    a "¿Cómo la conoces?"

# game/Story03.rpy:695

translate spanish story04_2d425c4e:

    # h "She watches over us. And unlike you, she actually talks."
    h "Ella nos cuida y a diferencia de ti, ella habla."

# game/Story03.rpy:697

translate spanish story04_580df0b0:

    # a "I see."
    a "Ya veo."

# game/Story03.rpy:703

translate spanish story04_ec0aaab4:

    # h "(whispers) Who would’ve thought that gorilla would end up being the reasonable one."
    h "(susurros) ¿Quién hubiera pensado que el gorila terminaría siendo el razonable."

# game/Story03.rpy:706

translate spanish story04_7f1a39c5:

    # mc "Then why are you bringing us here?"
    mc "¿Entonces por qué nos traes aquí?"

# game/Story03.rpy:710

translate spanish story04_764d48ae:

    # a "Irrelevant to you."
    a "Irrelevant para ti."

# game/Story03.rpy:713

translate spanish story04_e4a5ea9a:

    # mc "I know you wouldn’t be here without Astoria’s direct order. You people don’t act out of kindness."
    mc "Sé que no estarías aquí sin el orden directo de Astoria. No actúes por bondad."

# game/Story03.rpy:714

translate spanish story04_e4e94008:

    # mc "So are you helping us or not?"
    mc "¿Nos estás ayudando o no?"

# game/Story03.rpy:717

translate spanish story04_15d1fe5b:

    # a "We came."
    a "Vinimos."

# game/Story03.rpy:718

translate spanish story04_c17dbcd9:

    # mc "(Might as well be talking to a rock.)"
    mc "(También hay que hablar con una roca.)"

# game/Story03.rpy:721

translate spanish story04_813e8e41:

    # mc "Fine. Then just tell me straight — what are you doing here?"
    mc "Bien. Entonces dime directamente: ¿Qué haces aquí?"

# game/Story03.rpy:723

translate spanish story04_78686255:

    # a "Protecting Doctor Lora’s life."
    a "Proteger la vida del Doctor Lora."

# game/Story03.rpy:725

translate spanish story04_f8090a4b:

    # mc "And what about us? What’s our role in all this?"
    mc "¿Y qué hay de nosotros? ¿Cuál es nuestro papel en todo esto?"

# game/Story03.rpy:726

translate spanish story04_d76cb383:

    # mc "This isn’t a forward base."
    mc "Esta no es una base de avance."

# game/Story03.rpy:728

translate spanish story04_da3e6aeb:

    # a "Because it’s not one."
    a "Porque no es uno."

# game/Story03.rpy:736

translate spanish story04_119c65a8:

    # mc "Our mission is to reach the tower and stop the collapse."
    mc "Nuestra misión es llegar a la torre y detener el colapso."

# game/Story03.rpy:737

translate spanish story04_131d7b5b:

    # mc "For that I need forces. People. Now."
    mc "Para eso necesito fuerzas."

# game/Story03.rpy:743

translate spanish story04_1648ab77:

    # k "And here I am. Just in time."
    k "Y aquí estoy, justo a tiempo."

# game/Story03.rpy:744

translate spanish story04_3677ebb9:

    # k "She just wants you to take a breather."
    k "Solo quiere que te respires."

# game/Story03.rpy:747

translate spanish story04_81342ccc:

    # k "Or stay out of the way. Depends how you look at it."
    k "O no te acerques, depende de cómo lo miras."

# game/Story03.rpy:749

translate spanish story04_5f4de4b0:

    # h "And saying that like a normal person was too hard?"
    h "¿Y decir que como una persona normal era demasiado duro?"

# game/Story03.rpy:762

translate spanish story04_0ad31457:

    # mc "We don’t have time to rest. Everything could fall apart any minute. This planet isn’t a joke."
    mc "No tenemos tiempo para descansar. Todo podría desmoronarse en cualquier momento. Este planeta no es una broma."

# game/Story03.rpy:765

translate spanish story04_f071f7e3:

    # k "And what do you suggest? Run headfirst into the grinder with no plan?"
    k "¿Y qué sugieres?"

# game/Story03.rpy:766

translate spanish story04_553b72a4:

    # k "I didn’t sign up to save your asses twice."
    k "No me inscribí para salvarte el culo dos veces."

# game/Story03.rpy:768

translate spanish story04_f96e40df:

    # mc "(That snark — it’s second nature to her. But she’s not wrong... alone, we won’t get far.)"
    mc "(Ese snark — es la segunda naturaleza para ella. Pero ella no está equivocada... solo, no llegaremos lejos.)"

# game/Story03.rpy:770

translate spanish story04_df4cd1e3:

    # k "Relax. The team’s not ready yet. The locals aren’t exactly eager to work with us."
    k "Relájate. El equipo aún no está listo. Los lugareños no están exactamente ansiosos de trabajar con nosotros."

# game/Story03.rpy:772

translate spanish story04_fa2145e6:

    # h "So once again, it all comes down to the cat?"
    h "¿Entonces una vez más, todo se reduce al gato?"

# game/Story03.rpy:775

translate spanish story04_dec7ea33:

    # k "More like the elf. Speaking of — where is she?"
    k "Más bien el elfo. Hablando de — ¿dónde está?"

# game/Story03.rpy:777

translate spanish story04_d549633d:

    # mc "Said she had to step out. Didn’t say where."
    mc "Dijo que tenía que salir. No dije dónde."

# game/Story03.rpy:780

translate spanish story04_148dcf87:

    # k "So you’re the reason he’s here?"
    k "¿Así que eres la razón por la que está aquí?"

# game/Story03.rpy:784

translate spanish story04_99d3b1da:

    # mc "Yeah, she is. Problem?"
    mc "Sí, lo es. ¿Problema?"

# game/Story03.rpy:786

translate spanish story04_9e5cb84a:

    # k "Nope... not yet."
    k "No... aún no."

# game/Story03.rpy:791

translate spanish story04_032195b7:

    # k "And you’re her babysitter? Wouldn’t have guessed."
    k "¿Y usted es su niñera? No habría adivinado."

# game/Story03.rpy:793

translate spanish story04_14b08739:

    # a "I had no choice."
    a "No tenía elección."

# game/Story03.rpy:799

translate spanish story04_58deefad:

    # k "As always. And as always — tight-lipped."
    k "Como siempre. Y como siempre, apretado."

# game/Story03.rpy:800

translate spanish story04_ce86509d:

    # k "Alright. You guys hang here. I need a word with miss broody over here."
    k "Bien, ustedes esperen aquí, necesito hablar con la señorita Broody aquí."

# game/Story03.rpy:803

translate spanish story04_f31a0753:

    # a "I’m under orders not to leave her side."
    a "Estoy bajo órdenes de no dejar su lado."

# game/Story03.rpy:805

translate spanish story04_1d000dc8:

    # k "And I’m under orders to take you to the chaplain. So let’s skip the dramatics."
    k "Y estoy bajo órdenes de llevarte al capellán. Así que saltemos los dramáticos."

# game/Story03.rpy:815

translate spanish story04_9bcf3854:

    # k "Still haven’t learned manners, huh? Though really, you—"
    k "Aún no has aprendido modales, ¿eh? Aunque realmente, tú..."

# game/Story03.rpy:820

translate spanish story04_aa911206:

    # k "Yeah, yeah, save your outrage for later."
    k "Sí, sí, salva tu indignación para más tarde."

# game/Story03.rpy:822

translate spanish story04_89876043:

    # k "You too."
    k "Tú también."

# game/Story03.rpy:827

translate spanish story04_94142a29:

    # h "Me? Why?"
    h "¿Por qué?"

# game/Story03.rpy:830

translate spanish story04_cc6dbfc3:

    # k "Business. And for company."
    k "Negocios, y para compañía."

# game/Story03.rpy:834

translate spanish story04_26265c18:

    # h "Huh?!"
    h "¿Eh?"

# game/Story03.rpy:837

translate spanish story04_13d3c304:

    # k "Let’s go. Let the lovebirds have their moment."
    k "Vamos. Deja que los pájaros de amor tengan su momento."

# game/Story03.rpy:842

translate spanish story04_3d8be1cd:

    # h "Alright, I’m off..."
    h "Bien, me voy..."

# game/Story03.rpy:843

translate spanish story04_408a7a4b:

    # h "Try not to break anything while we’re gone."
    h "Intenta no romper nada mientras nos hemos ido."

# game/Story03.rpy:846

translate spanish story04_b21541d8:

    # mc "No promises."
    mc "No hay promesas."

# game/Story03.rpy:847

translate spanish story04_dfd0e56e:

    # mc "Take care."
    mc "Cuídate."

# game/Story03.rpy:862

translate spanish story04_fbf793c0:

    # h "You two, don’t get too carried away."
    h "Ustedes dos, no se dejen llevar."

# game/Story03.rpy:868

translate spanish story04_862723df:

    # mc "Now that we’re alone... I think it’s time we talked."
    mc "Ahora que estamos solos... creo que es hora de hablar."

# game/Story03.rpy:870

translate spanish story04_d75cf13e:

    # L "Yeah..."
    L "Sí..."

# game/Story03.rpy:874

translate spanish story04_c54fda8b:

    # L "(whispers) I was afraid this conversation would happen after all."
    L "Tenía miedo de que esta conversación pasara después de todo."

# game/Story03.rpy:884

translate spanish story04_71b85ce8:

    # L "What do you think?"
    L "¿Qué opinas?"

# game/Story03.rpy:886

translate spanish story04_b57042c2:

    # mc "About the room? I’ve seen worse."
    mc "¿Sobre la habitación? He visto peor."

# game/Story03.rpy:887

translate spanish story04_8a539ab4:

    # mc "Everything else?.. Crap, honestly."
    mc "¿Todo lo demás?"

# game/Story03.rpy:888

translate spanish story04_c5b4e487:

    # mc "But you know... I'm glad you're here. Even like this."
    mc "Pero, sabes, me alegro de que estés aquí."

# game/Story03.rpy:890

translate spanish story04_0b11c906:

    # L "Got it... {w} And, I'm really glad we’re together again."
    L "Lo entiendo. {w} También estoy muy feliz de que estemos juntos de nuevo."

# game/Story03.rpy:892

translate spanish story04_87b4edd4:

    # L "By the way, it’s kinda spacious here. And at the same time, cozy."
    L "Por cierto, es un poco espacioso aquí. Y al mismo tiempo, acogedor."

# game/Story03.rpy:894

translate spanish story04_b1e15291:

    # mc "The cozy part — that’s you. The room’s just an empty box."
    mc "La parte acogedora — que eres tú. La habitación es solo una caja vacía."

# game/Story03.rpy:895

translate spanish story04_d34c2f32:

    # L "Oh, my silver-tongued poet… Just give it a little clean—"
    L "Oh, mi poeta plateado... solo dale un poco limpio..."

# game/Story03.rpy:896

translate spanish story04_7d57ef15:

    # L "You’ll see. It’ll come to life."
    L "Ya verás. Llegará a la vida."

# game/Story03.rpy:899

translate spanish story04_3c2f682a:

    # mc "Still the same… perfectionist."
    mc "Aún así... perfeccionista."

# game/Story03.rpy:903

translate spanish story04_8a144bba:

    # L "Darling, you say it like it’s a bad thing..."
    L "Cariño, dices que es algo malo..."

# game/Story03.rpy:906

translate spanish story04_ad1ed176:

    # mc "I remember the shows you'd put on just for a deep clean... Dust still refuses to set foot near us."
    mc "Recuerdo las actuaciones que diste por la limpieza... el polvo todavía tiene miedo de acercarse a nosotros."

# game/Story03.rpy:908

translate spanish story04_997c35d1:

    # L "Oh come on, you’re exaggerating — those were good memories."
    L "Oh, vamos, estás exagerando, esos eran buenos recuerdos."

# game/Story03.rpy:910

translate spanish story04_577835a1:

    # mc "...Yeah. That they were."
    mc "- Sí, eso eran."

# game/Story03.rpy:911

translate spanish story04_8ca4eb76:

    # mc "Not gonna argue."
    mc "No va a discutir."

# game/Story03.rpy:916

translate spanish story04_13616450:

    # mc "By the way... you've been here longer than I have."
    mc "Por cierto, no estás aquí por primera vez."

# game/Story03.rpy:917

translate spanish story04_7b2a922c:

    # mc "Tell me — do they always mess up names like that around here?"
    mc "Dime, ¿siempre se meten nombres como ese por aquí?"

# game/Story03.rpy:918

translate spanish story04_0ffd001e:

    # mc "‘Wild Non-Carbonated’? And it’s fizzy? What kind of twisted joke is that?"
    mc "¿\"No Carbonado Salvado\"? ¿Y es vergonzoso? ¿Qué clase de broma torcida es esa?"

# game/Story03.rpy:921

translate spanish story04_9d9188f7:

    # L "What’s wrong with it?"
    L "¿Qué tiene de malo?"

# game/Story03.rpy:923

translate spanish story04_1a09fae5:

    # mc "Just... ah, screw it. You want one?"
    mc "Solo... ah, a la mierda. ¿Quieres uno?"

# game/Story03.rpy:924

translate spanish story04_a9d8894a:

    # L "I’ll pass. And I wouldn’t recommend it to you either."
    L "Y yo tampoco te lo recomendaría."

# game/Story03.rpy:925

translate spanish story04_c4843cea:

    # mc "Don’t be dramatic. Looks decent enough."
    mc "No seas dramático. Parece bastante decente."

# game/Story03.rpy:927

translate spanish story04_00534e97:

    # L "That’s what everyone says — until it starts eating through your organs."
    L "Eso es lo que todos dicen, hasta que empieza a comer a través de tus órganos."

# game/Story03.rpy:931

translate spanish story04_55300f9b:

    # L "Didn’t dare, huh? I was joking..."
    L "No se atrevía, ¿eh? Estaba bromeando..."

# game/Story03.rpy:933

translate spanish story04_4d9d84b6:

    # mc "All these years, and your jokes still catch me off guard."
    mc "Todos estos años, y tus chistes todavía me atrapan de la guardia."

# game/Story03.rpy:935

translate spanish story04_d03d467c:

    # L "And I missed that little scowl you always gave me after."
    L "Y me perdí ese pequeño coco que siempre me diste después."

# game/Story03.rpy:936

translate spanish story04_25dcc43a:

    # L "Besides, they’re not that bad. {w}Well... mostly."
    L "Además, no son tan malos. {w}Bueno... sobre todo."

# game/Story03.rpy:938

translate spanish story04_f16c798b:

    # mc "If you say so."
    mc "Si tú lo dices."

# game/Story03.rpy:945

translate spanish story04_918e6f51:

    # mc "So, here we are. Just the two of us."
    mc "Aquí estamos, solo nosotros dos."

# game/Story03.rpy:947

translate spanish story04_d75cf13e_1:

    # L "Yeah..."
    L "Sí..."

# game/Story03.rpy:951

translate spanish story04_39e95b64:

    # mc "...So. What happened to you?"
    mc "¿Qué te pasó?"

# game/Story03.rpy:956

translate spanish story04_d6185d2a:

    # mc "You’ve got no reason to stay silent now."
    mc "No tienes razón para permanecer en silencio ahora."

# game/Story03.rpy:958

translate spanish story04_3a443a4c:

    # L "There are things I can’t tell you... no matter how much I might want to."
    L "Hay cosas que no puedo decirte... no importa lo mucho que quiera."

# game/Story03.rpy:960

translate spanish story04_3c1def74:

    # mc "And I’m someone whose patience isn’t infinite, you know."
    mc "Y soy alguien cuya paciencia no es infinita, sabes."

# game/Story03.rpy:967

translate spanish story04_6f8610c8:

    # mc "So what are those things—"
    mc "¿Qué son esas cosas?"

# game/Story03.rpy:969

translate spanish story04_8be535e0:

    # L "I was already on the earth. After the incident."
    L "Ya estaba en la tierra, después del incidente."

# game/Story03.rpy:977

translate spanish story04_3f9df27f:

    # mc "...What?"
    mc "¿Qué?"

# game/Story03.rpy:978

translate spanish story04_72639988:

    # mc "You were... {w=0.2}there? {w=0.2}On that fucking planet?!"
    mc "Estabas... {w=0.2}¿Ahí? {w=0.2}¿En ese maldito planeta?"

# game/Story03.rpy:981

translate spanish story04_ec14f117:

    # L "I knew you’d—"
    L "Sabía que lo harías..."

# game/Story03.rpy:983

translate spanish story04_11bcf877:

    # mc "You knew what?!"
    mc "¿Sabes qué?"

# game/Story03.rpy:984

translate spanish story04_071c8918:

    # mc "That I was dying slowly, not knowing if you were dead or just erased from my life?!"
    mc "Que yo estaba muriendo lentamente, sin saber si estabas muerto o simplemente borrado de mi vida!"

# game/Story03.rpy:986

translate spanish story04_9452bee5:

    # L "I—"
    L "Yo..."

# game/Story03.rpy:988

translate spanish story04_8deeb14d:

    # mc "You were on that fucking planet, Lora?!"
    mc "¿Estabas en ese maldito planeta, Lora?"

# game/Story03.rpy:990

translate spanish story04_adfba148:

    # mc "While I sat every night staring at an empty comm, praying for a sound — a word, a breath?!"
    mc "Mientras me sentaba todas las noches mirando un coma vacío, rezando por un sonido — ¡una palabra, un aliento!"

# game/Story03.rpy:991

translate spanish story04_a9796b3e:

    # mc "I tore through half the galaxy chasing your ghost!"
    mc "¡Derribaré la mitad de la galaxia persiguiendo a tu fantasma!"

# game/Story03.rpy:993

translate spanish story04_8598f2bd:

    # L "I didn’t hear voices, [mc] — I heard the people I loved dying!"
    L "No escuché voces, [mc] - ¡Escuché a la gente que amaba morir!"

# game/Story03.rpy:994

translate spanish story04_078cdd49:

    # L "I heard them cry for help as they were slaughtered like cattle!"
    L "¡Los oí llorar por ayuda mientras eran masacrados como ganado!"

# game/Story03.rpy:1007

translate spanish story04_c7dad306:

    # mc "And I was calling for you! You were my family. My goddamn family!"
    mc "¡Y te estaba llamando! ¡Tú eras mi familia!"

# game/Story03.rpy:1012

translate spanish story04_a737c2b2:

    # L "Family?! FAMILY?! Ahahahahah..."
    L "¿Familia?"

# game/Story03.rpy:1014

translate spanish story04_4f74d1a0:

    # mc "...Lora?"
    mc "¿Lora?"

# game/Story03.rpy:1018

translate spanish story04_f8b3bf1f:

    # L "You… you don’t get it… I wanted to die there, [mc]. I really did."
    L "Tú... no lo entiendes... quería morir allí, [mc]- De verdad."

# game/Story03.rpy:1021

translate spanish story04_87236cd8:

    # L "Just to make it stop. The screaming. The blood."
    L "Para que pare, el grito, la sangre."

# game/Story03.rpy:1023

translate spanish story04_37c6a8ca:

    # L "...But I survived. And it got even worse."
    L "Pero sobreviví y empeoró."

# game/Story03.rpy:1025

translate spanish story04_57a6ca19:

    # mc "...Why didn’t you come to me?"
    mc "...¿Por qué no viniste a mí?"

# game/Story03.rpy:1027

translate spanish story04_7cc63acc:

    # L "Because I’m no longer someone you can come to. I’m what’s left. What’s left of the person you knew."
    L "Porque ya no soy alguien a quien puedes venir. Soy lo que queda. Lo que queda de la persona que conocías."

# game/Story03.rpy:1029

translate spanish story04_35e8f94e:

    # mc "I cursed your name. And still I waited."
    mc "Maldije tu nombre, y aún así esperé."

# game/Story03.rpy:1037

translate spanish story04_7901a0e1:

    # L "(Whispering) And I waited for you to stop."
    L "Y esperé que pararas."

# game/Story03.rpy:1041

translate spanish story04_d18b4aee:

    # L "Every single day of those twelve years... I remembered what I did."
    L "Cada día de esos doce años recordé lo que hice."

# game/Story03.rpy:1042

translate spanish story04_81eb213d:

    # L "I never forgot it. Not once."
    L "Nunca lo olvidé, ni una vez."

# game/Story03.rpy:1052

translate spanish story04_573b9e39:

    # L "I’ve seen hundreds die... people I cared about."
    L "He visto morir a cientos de personas que me importaban."

# game/Story03.rpy:1053

translate spanish story04_5dfe3ca7:

    # L "But how would you know... what that feels like..."
    L "Pero ¿cómo sabes... cómo se siente eso?"

# game/Story03.rpy:1055

translate spanish story04_6b7f7a17:

    # mc "You talk like that excuses the silence."
    mc "Hablas así excusas el silencio."

# game/Story03.rpy:1058

translate spanish story04_52393f82:

    # L "No. I’m not asking for forgiveness. I don’t think it’s even possible."
    L "No. No estoy pidiendo perdón. No creo que sea posible."

# game/Story03.rpy:1060

translate spanish story04_dbc24939:

    # mc "Then why are you here?"
    mc "¿Entonces por qué estás aquí?"

# game/Story03.rpy:1062

translate spanish story04_5f40b595:

    # L "So you know. So that if you hate me — it’s for the truth. Not for what you imagined."
    L "Así que, si me odias, es por la verdad. No por lo que imaginabas."

# game/Story03.rpy:1064

translate spanish story04_c528b82f:

    # mc "Truth... It’s too late, Lora."
    mc "Verdad... Es demasiado tarde, Lora."

# game/Story03.rpy:1066

translate spanish story04_68d0c89d:

    # L "You want the truth? Fine. I lived. I ran. And then I disappeared."
    L "¿Quieres la verdad?"

# game/Story03.rpy:1070

translate spanish story04_ec177b12:

    # L "Because if I came back and saw in your eyes... that you feared me, or worse — pitied me... I couldn’t have survived that."
    L "Porque si volví y vi en tus ojos... que me temías, o peor... me compadecía... no podría haber sobrevivido a eso."

# game/Story03.rpy:1071

translate spanish story04_9450cc52:

    # L "Death would’ve been better than being a shadow beside you."
    L "La muerte habría sido mejor que ser una sombra a tu lado."

# game/Story03.rpy:1076

translate spanish story04_54376eec:

    # mc "You’re not a shadow, Lora. You were everything I had. Everything."
    mc "No eres una sombra, Lora. Tú eras todo lo que tenía."

# game/Story03.rpy:1077

translate spanish story04_5a5a6bee:

    # mc "I loved you. I... hell, I still—"
    mc "Te quería."

# game/Story03.rpy:1079

translate spanish story04_cbca050b:

    # L "Don’t say it."
    L "No lo digas."

# game/Story03.rpy:1080

translate spanish story04_625c1544:

    # L "I know about your relationships with the other girls."
    L "Sé lo de tus relaciones con las otras chicas."

# game/Story03.rpy:1083

translate spanish story04_8b93fada:

    # L "Don’t say it. I’m not the one you loved. And you know it."
    L "No lo digas. No soy el que amabas. Y lo sabes."

# game/Story03.rpy:1087

translate spanish story04_e222d005:

    # mc "Then who are you?"
    mc "¿Entonces quién eres?"

# game/Story03.rpy:1089

translate spanish story04_24c9d4d0:

    # L "I’m what’s left... of whoever I used to be to you."
    L "Soy lo que queda... de quien solía ser para ti."

# game/Story03.rpy:1093

translate spanish story04_bc561bd3:

    # mc "Maybe. Or maybe — the only person I still want to talk to."
    mc "Tal vez, o tal vez, la única persona con la que todavía quiero hablar."

# game/Story03.rpy:1095

translate spanish story04_5fd0057f:

    # L "...You’re insane."
    L "... Estás loco."

# game/Story03.rpy:1097

translate spanish story04_2ef4ca35:

    # mc "More like... tired of being alone."
    mc "Más bien... cansado de estar solo."

# game/Story03.rpy:1101

translate spanish story04_4cedc381:

    # L "You were the worst kind of choice — the one I couldn't unmake..."
    L "Fuiste la peor elección de la historia, la que no puede ser revocada."

# game/Story03.rpy:1106

translate spanish story04_da5fb858:

    # mc "You’ve been through hell, Lora. I’m just glad you let it spill."
    mc "Has pasado por el infierno, Lora. Me alegro de que lo dejes derramar."

# game/Story03.rpy:1111

translate spanish story04_4d950dd5:

    # L "You’re the worst… and still the only one I need."
    L "Eres el peor... y aún el único que necesito."

# game/Story03.rpy:1119

translate spanish story04_78ea04a4:

    # mc "Did that help... even a little?"
    mc "¿Eso ayudó... incluso un poco?"

# game/Story03.rpy:1121

translate spanish story04_a3fb8272:

    # L "I don’t know... maybe."
    L "No lo sé... tal vez."

# game/Story03.rpy:1125

translate spanish story04_53d9d6cd:

    # L "I said a lot of stupid th—"
    L "Dije mucho estúpido..."

# game/Story03.rpy:1127

translate spanish story04_8cfe3c60:

    # mc "Forget it. I know you didn’t mean harm."
    mc "Olvídalo. Sé que no significaste daño."

# game/Story03.rpy:1131

translate spanish story04_40c72754:

    # L "Even so... I should apologize. I said things I shouldn’t have. I’m sorry."
    L "Incluso así... debería disculparme. Dije cosas que no debería tener. Lo siento."

# game/Story03.rpy:1136

translate spanish story04_ad58d384:

    # L "Thank you."
    L "Gracias."

# game/Story03.rpy:1138

translate spanish story04_f340adec:

    # mc "Alright. So... how does your sudden appearance tie into my... {b}almost{/b} death?"
    mc "Bien, entonces... ¿cómo se mete tu repentina apariencia en mi... {b}casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi{/b} ¿Muerte?"

# game/Story03.rpy:1161

translate spanish story04_4aadcf6c:

    # L "So... what now?"
    L "Entonces... ¿y ahora qué?"

# game/Story03.rpy:1163

translate spanish story04_acf67336:

    # mc "...We could just sit here. Like this."
    mc "Podríamos sentarnos aquí, así."

# game/Story03.rpy:1165

translate spanish story04_11c64f67:

    # L "Or... I could find something to wipe you down with."
    L "O... podría encontrar algo con lo que acabar contigo."

# game/Story03.rpy:1169

translate spanish story04_5cf98603:

    # mc "(Maybe I should...)"
    mc "(Quizá debería...)"

# game/Story03.rpy:1173

translate spanish story04_7dcc798e:

    # L "Take off the uniform. I’ll find you something dry."
    L "Quítate el uniforme. Te encontraré algo seco."

# game/Story03.rpy:1175

translate spanish story04_fcfaf241:

    # mc "I think I’ll take a shower... Unless you’d rather I froze to death."
    mc "Creo que me ducharé... a menos que prefiera que me congelara hasta morir."

# game/Story03.rpy:1176

translate spanish story04_97ce32be:

    # mc "...Would you join me?"
    mc "¿Podrías acompañarme?"

# game/Story03.rpy:1180

translate spanish story04_630a0b8e:

    # L "Together?"
    L "¿Juntos?"

# game/Story03.rpy:1182

translate spanish story04_6e918cdc:

    # mc "You mind?"
    mc "¿Te importa?"

# game/Story03.rpy:1185

translate spanish story04_9d92ed64:

    # L "...I don’t want to be alone. {w=0.2}Not tonight."
    L "...No quiero estar solo. {w=0.2}Esta noche no."

# game/Story03.rpy:1194

translate spanish story04_a06b436c:

    # mc "(Was this really a good idea?)"
    mc "(¿Es una buena idea?)"

# game/Story03.rpy:1195

translate spanish story04_06b8d3bb:

    # mc "(Then again... no point overthinking it.)"
    mc "(Entonces otra vez... no tiene sentido pensarlo)."

# game/Story03.rpy:1198

translate spanish story04_8407af83:

    # L "May I... come in?"
    L "¿Puedo... pasar?"

# game/Story03.rpy:1199

translate spanish story04_f800bed0:

    # mc "Yes."
    mc "Sí."

# game/Story03.rpy:1203

translate spanish story04_dddec25f:

    # L "Mister, you look awfully grim tonight... Wouldn't you like a lovely lady to sit by your side?"
    L "Hoy eres un poco sombrío, ¿no quieres que una linda dama se siente a tu lado?"

# game/Story03.rpy:1206

translate spanish story04_c1295f87:

    # mc "I see that lovely lady, and I wonder... What does she want in return?"
    mc "Veo a esa encantadora dama, y me pregunto... ¿Qué quiere a cambio?"

# game/Story03.rpy:1208

translate spanish story04_1d84e710:

    # mc "Nothing ever comes for free."
    mc "Nada viene gratis."

# game/Story03.rpy:1210

translate spanish story04_f4bd8251:

    # L "Just one thing. You."
    L "Solo una cosa."

# game/Story03.rpy:1214

translate spanish story04_f569b019:

    # mc "That’s... mutual."
    mc "Eso es... mutuo."

# game/Story03.rpy:1219

translate spanish story04_6a3a2b10:

    # L "Well then... Where shall we begin?"
    L "Bueno entonces... ¿Dónde empezaremos?"

# game/Story03.rpy:1220

translate spanish story04_09e0e530:

    # L "Something light? Perhaps... dessert?"
    L "¿Algo ligero?"

# game/Story03.rpy:1222

translate spanish story04_ce28e28c:

    # L "Maybe a juicy slice of watermelon... or... something sweeter?"
    L "¿Quizás una jugosa rebanada de sandía... o algo más dulce?"

# game/Story03.rpy:1224

translate spanish story04_0a37ba29:

    # mc "I'll trust the hostess's taste."
    mc "Confío en la dama de la noche."

# game/Story03.rpy:1226

translate spanish story04_610f61df:

    # L "Brave."
    L "Valiente."

# game/Story03.rpy:1228

translate spanish story04_8439d6de:

    # mc "No. Just... known you long enough."
    mc "No, solo... te conozco lo suficiente."

# game/Story03.rpy:1230

translate spanish story04_8c04b4ef:

    # L "Is that so..."
    L "¿Es eso tan..."

# game/Story03.rpy:1232

translate spanish story04_7a1ab329:

    # L "Then I know what you'll like."
    L "Entonces sé que te gustará."

# game/Story03.rpy:1234

translate spanish story04_201524f2:

    # mc "(She's... become that Lora again. Or trying to be.)"
    mc "(Ella es... ella es la Laura otra vez, o ella está tratando de ser.)"

# game/Story03.rpy:1236

translate spanish story04_af6d114b:

    # L "(I missed those eyes. That warmth...)"
    L "(Me perdí esos ojos, esa calidez...)"

# game/Story03.rpy:1238

translate spanish story04_bd10dfa5:

    # L "We lost so much time, [mc]... Let’s take it back. Slowly. Together."
    L "Perdimos tanto tiempo, [mc]... Vamos a recuperarlo. Despacio. Juntos."

# game/Story03.rpy:1239

translate spanish story04_fb8b17ce:

    # mc "If you're by my side — I’m ready."
    mc "Si estás aquí, estoy listo."

# game/Story03.rpy:1248

translate spanish story04_6efd4c35:

    # L "You don’t know how many nights I wished for this — just like this."
    L "No sabes cuántas noches deseaba esto, como esta."

# game/Story03.rpy:1249

translate spanish story04_16b7e48e:

    # mc "This? I thought you came to see me for another reason."
    mc "Pensé que viniste a verme por otra razón."

# game/Story03.rpy:1250

translate spanish story04_4d262860:

    # L "Oh, stop... You know that’s not what I meant."
    L "Oh, para... sabes que eso no es lo que quise decir."

# game/Story03.rpy:1251

translate spanish story04_6eeb5878:

    # mc "I do. Still... couldn’t resist the chance."
    mc "Yo sí. Aún así... no podía resistir la oportunidad."

# game/Story03.rpy:1252

translate spanish story04_a4abbaa8:

    # L "Feeling cheeky?"
    L "¿Te sientes mal?"

# game/Story03.rpy:1253

translate spanish story04_2306f4f4:

    # mc "Takes one to know one."
    mc "Se necesita uno para conocer uno."

# game/Story03.rpy:1255

translate spanish story04_73749ece:

    # L "...You always felt things deeper than you let on."
    L "Siempre sentiste cosas más profundas de lo que dejaste."

# game/Story03.rpy:1256

translate spanish story04_0e5f8d0a:

    # mc "And you — always knew, but said nothing."
    mc "Y tú siempre lo sabías, pero no dijiste nada."

# game/Story03.rpy:1257

translate spanish story04_fcd06d28:

    # L "I didn’t stay silent... I was screaming inside. Just no one listened."
    L "No me quedé callado... estaba gritando dentro."

# game/Story03.rpy:1258

translate spanish story04_3c512297:

    # mc "...I would have listened."
    mc "...habría escuchado."

# game/Story03.rpy:1259

translate spanish story04_077bb65a:

    # L "My chatty hero — focus."
    L "Mi héroe de chatty —centrarse."

# game/Story03.rpy:1260

translate spanish story04_2ed291ff:

    # mc "Ready to keep going?"
    mc "¿Listo para seguir?"

# game/Story03.rpy:1261

translate spanish story04_18a6ae10:

    # L "Lead on."
    L "Sigue adelante."

# game/Story03.rpy:1266

translate spanish story04_581f5095:

    # L "You know... I almost forgot what this felt like over the years."
    L "Sabes... casi olvido lo que esto sentía a lo largo de los años."

# game/Story03.rpy:1267

translate spanish story04_9cff8108:

    # mc "And? How does it feel?"
    mc "¿Cómo se siente?"

# game/Story03.rpy:1268

translate spanish story04_a55d6ef6:

    # L "Like cloud nine."
    L "Como la nube nueve."

# game/Story03.rpy:1283

translate spanish story04_c391fc2c:

    # mc "(Okay, but... what now? The problems didn’t vanish.)"
    mc "(Vale, pero... ¿ahora qué? Los problemas no se desvanecieron.)"

# game/Story03.rpy:1285

translate spanish story04_9cb59fed:

    # L "There it is again — that look. Stop it, [mc]."
    L "Ahí está otra vez — esa mirada. [mc]."

# game/Story03.rpy:1287

translate spanish story04_e8a590af:

    # L "For once — just let go. Even for a moment."
    L "Por una vez, solo déjalo ir."

# game/Story03.rpy:1289

translate spanish story04_96f6d5a0:

    # mc "I can’t... It’s too much. Too complicated."
    mc "No puedo... es demasiado. Demasiado complicado."

# game/Story03.rpy:1290

translate spanish story04_0d6b481c:

    # L "Don’t bottle it up. Let me in."
    L "No lo embotellas. Déjame entrar."

# game/Story03.rpy:1292

translate spanish story04_8ffcc6a9:

    # L "What’s troubling you most?"
    L "¿Qué te preocupa más?"

# game/Story03.rpy:1295

translate spanish story04_8d1c7daa:

    # mc "You. What happened to you."
    mc "Tú, qué te pasó."

# game/Story03.rpy:1297

translate spanish story04_4d0853ca:

    # L "In short? I’m being hunted."
    L "¿En resumen? Estoy siendo cazado."

# game/Story03.rpy:1299

translate spanish story04_5aeeac7c:

    # mc "...By who?"
    mc "... ¿Por quién?"

# game/Story03.rpy:1301

translate spanish story04_76c9b9ec:

    # L "Everyone. In bits. Humans, elves, dragons... Even a shadow-creature that looks like an insect."
    L "Hombres, elfos, dragones... incluso una sombra que parece un insecto."

# game/Story03.rpy:1303

translate spanish story04_f78524d4:

    # mc "But why? I don’t see a reason."
    mc "¿Pero por qué? No veo una razón."

# game/Story03.rpy:1305

translate spanish story04_0c2713d3:

    # L "I know what lies in the Abyss."
    L "Sé lo que está en el Abismo."

# game/Story03.rpy:1307

translate spanish story04_e2398f84:

    # mc "That’s not enough to want you dead."
    mc "Eso no es suficiente para quererte muerto."

# game/Story03.rpy:1309

translate spanish story04_c46b1f38:

    # L "I’m one of the few who can enter it."
    L "Soy uno de los pocos que pueden entrar en él."

# game/Story03.rpy:1313

translate spanish story04_27e122ea:

    # mc "Now that’s another story."
    mc "Ahora esa es otra historia."

# game/Story03.rpy:1315

translate spanish story04_19d78fe3:

    # L "Wait, you do know why everyone’s after it, right?"
    L "Espera, sabes por qué todos lo buscan, ¿verdad?"

# game/Story03.rpy:1317

translate spanish story04_ee940614:

    # mc "No. Not the faintest idea."
    mc "No, no es la idea más débil."

# game/Story03.rpy:1319

translate spanish story04_68fbb2ec:

    # L "Yikes... And you never wondered?"
    L "¿Y nunca se preguntó?"

# game/Story03.rpy:1321

translate spanish story04_6fe2db85:

    # mc "Honestly? No. I had enough trouble on this side of reality."
    mc "No, tuve suficientes problemas en este lado de la realidad."

# game/Story03.rpy:1323

translate spanish story04_19d44639:

    # L "So like you..."
    L "Así que como tú..."

# game/Story03.rpy:1324

translate spanish story04_7b92d8c6:

    # L "Alright, explanation time!"
    L "¡Muy bien, tiempo de explicación!"

# game/Story03.rpy:1326

translate spanish story04_48baf8a1:

    # L "Look. The Abyss isn’t just another dimension. It’s... layers of broken, tangled realities."
    L "Mira. El Abismo no es solo otra dimensión. Es... capas de realidades rotas y enredadas."

# game/Story03.rpy:1328

translate spanish story04_65693ad3:

    # L "There are artifacts tied to it. They let you enter."
    L "Hay artefactos atados a ella, y te dejan entrar."

# game/Story03.rpy:1330

translate spanish story04_c6391848:

    # L "Still with me?"
    L "¿Sigues conmigo?"

# game/Story03.rpy:1334

translate spanish story04_4a046dbb:

    # mc "Yeah. So far."
    mc "Sí, hasta ahora."

# game/Story03.rpy:1336

translate spanish story04_f5e88c3f:

    # L "Good boy."
    L "Buen chico."

# game/Story03.rpy:1338

translate spanish story04_2872e70d:

    # L "Now the obvious question — why does everyone want in?"
    L "Ahora la pregunta obvia - ¿por qué todos quieren entrar?"

# game/Story03.rpy:1339

translate spanish story04_ab161a36:

    # L "The answer's simple. Immortality."
    L "La respuesta es simple."

# game/Story03.rpy:1342

translate spanish story04_5ddaab18:

    # mc "(What?)"
    mc "(¿Qué?)"

# game/Story03.rpy:1344

translate spanish story04_1726c4df:

    # mc "Hold on. Then how are you—"
    mc "Espera, entonces, ¿cómo estás...?"

# game/Story03.rpy:1349

translate spanish story04_a53903be:

    # L "Don’t overload yourself. I’ll explain... Just not now, okay?"
    L "No te sobrecargas. Te explicaré... No ahora, ¿de acuerdo?"

# game/Story03.rpy:1350

translate spanish story04_e98bda8e:

    # L "Better tell me this instead..."
    L "Mejor dime esto en su lugar..."

# game/Story03.rpy:1351

translate spanish story04_99ac0c90:

    # L "Ready for round two?"
    L "¿Listo para la segunda ronda?"

# game/Story03.rpy:1354

translate spanish story04_e2651856:

    # mc "You’re insatiable..."
    mc "Eres insaciable..."

# game/Story03.rpy:1358

translate spanish story04_9ca62a69:

    # mc "Please, be gentler with me."
    mc "Por favor, sé más amable conmigo."

# game/Story03.rpy:1360

translate spanish story04_db5cb18a:

    # L "Time to wash her filth off you."
    L "Es hora de lavarte su suciedad."

# game/Story03.rpy:1363

translate spanish story04_55951dd8:

    # mc "Oh... What are you—"
    mc "¿Qué estás...?"

# game/Story03.rpy:1365

translate spanish story04_26b99e20:

    # L "Just thinking out loud."
    L "Solo pensaba en voz alta."

# game/Story03.rpy:1369

translate spanish story04_f88cce26:

    # L "This feels so good..."
    L "Esto se siente tan bien..."

# game/Story03.rpy:1372

translate spanish story04_20fd7990:

    # mc "You're... like a beast, Lora."
    mc "Eres como una bestia, Laura."

# game/Story03.rpy:1373

translate spanish story04_6dc18362:

    # L "Didn’t you know? I’ve always been a predator."
    L "¿No lo sabías? Siempre he sido un depredador."

# game/Story03.rpy:1374

translate spanish story04_08b7d9e3:

    # mc "Then why don’t I feel afraid?"
    mc "Entonces, ¿por qué no me siento asustado?"

# game/Story03.rpy:1375

translate spanish story04_49376366:

    # L "Because you’re mine."
    L "Porque eres mía."

# game/Story03.rpy:1376

translate spanish story04_22c294ca:

    # L "You can fight. You can try to take control..."
    L "Puedes luchar, puedes intentar tomar el control..."

# game/Story03.rpy:1377

translate spanish story04_c63bcd1a:

    # L "But in the end, you’ll still end up beneath me."
    L "Pero al final, aún terminarás bajo mí."

# game/Story03.rpy:1378

translate spanish story04_cca9e975:

    # mc "I doubt that part."
    mc "Dudo de esa parte."

# game/Story03.rpy:1379

translate spanish story04_096e26d8:

    # L "What?"
    L "¿Qué?"

# game/Story03.rpy:1386

translate spanish story04_2455437c:

    # mc "You thought you’d always have control over me, didn’t you?"
    mc "Pensabas que siempre tendrías control sobre mí, ¿no?"

# game/Story03.rpy:1387

translate spanish story04_b82d93cf:

    # L "Was I wrong?"
    L "¿Me equivoqué?"

# game/Story03.rpy:1388

translate spanish story04_a36766c6:

    # mc "Not today. It’s time I showed you what bliss feels like."
    mc "No hoy. Es hora de que te enseñé cómo es la dicha."

# game/Story03.rpy:1389

translate spanish story04_d5e8c7c9:

    # mc "All I need from you — is consent."
    mc "Todo lo que necesito de ti es el consentimiento."

# game/Story03.rpy:1390

translate spanish story04_e5542914:

    # L "And if I don’t want to give in?"
    L "¿Y si no quiero rendirme?"

# game/Story03.rpy:1391

translate spanish story04_658cd16a:

    # mc "Then I’ll make you want to."
    mc "Entonces haré que quieras."

# game/Story03.rpy:1392

translate spanish story04_be13bc8f:

    # L "Is that all you’ve got?"
    L "¿Eso es todo lo que tienes?"

# game/Story03.rpy:1401

translate spanish story04_ea1c6be7:

    # mc "So? Changed your mind yet?"
    mc "¿Has cambiado de opinión?"

# game/Story03.rpy:1403

translate spanish story04_78741f58:

    # L "I... I can still resist..."
    L "Yo... todavía puedo resistir..."

# game/Story03.rpy:1404

translate spanish story04_a32db2f7:

    # mc "No, you can’t. Not anymore."
    mc "No, no puedes. Ya no."

# game/Story03.rpy:1418

translate spanish story04_86c49c13:

    # L "You know, you were almost unbearable tonight..."
    L "Sabes, eras casi insoportable esta noche..."

# game/Story03.rpy:1419

translate spanish story04_6a9d5b6e:

    # mc "Only tonight?"
    mc "¿Solo esta noche?"

# game/Story03.rpy:1420

translate spanish story04_b55ad727:

    # L "Yeah, just tonight. Good night, darling."
    L "Sí, esta noche, buenas noches, querida."

# game/Story03.rpy:1421

translate spanish story04_00274b47:

    # mc "Yeah. Good night."
    mc "Buenas noches."

# game/Story03.rpy:1430

translate spanish story04_be8f1a89:

    # L "I'm sorry..."
    L "Lo siento."

# game/Story03.rpy:1431

translate spanish story04_65c425c5:

    # L "I pushed too far. It’s just... all of it’s been piling up."
    L "Yo he empujado demasiado lejos. Es solo que... todo ha estado acechando."

# game/Story03.rpy:1435

translate spanish story04_e5544801:

    # mc "I get it."
    mc "Lo entiendo."

# game/Story03.rpy:1436

translate spanish story04_c877e2a7:

    # mc "Still... when you said you could’ve died in agony..."
    mc "Aún así... cuando dijiste que podrías haber muerto en agonía..."

# game/Story03.rpy:1437

translate spanish story04_deddb069:

    # mc "What did you mean?"
    mc "¿Qué querías decir?"

# game/Story03.rpy:1445

translate spanish story04_7e046f79:

    # L "I’m being... hunted."
    L "Estoy siendo... cazado."

# game/Story03.rpy:1447

translate spanish story04_4cad93bd:

    # mc "By who?"
    mc "¿Por quién?"

# game/Story03.rpy:1449

translate spanish story04_7654d757:

    # L "Everyone. In small pieces. Humans, elves, dragons... even insects."
    L "En pequeños pedazos, humanos, elfos, dragones... incluso insectos."

# game/Story03.rpy:1450

translate spanish story04_8c39d73f:

    # L "Surprised?"
    L "¿Sorprendido?"

# game/Story03.rpy:1452

translate spanish story04_fb3be0f3:

    # mc "Sounds insane. But somehow, I believe you."
    mc "Suena loco, pero de alguna manera, te creo."

# game/Story03.rpy:1454

translate spanish story04_d7fc8fe8:

    # L "As you should. The reason is simple..."
    L "Como deberías, la razón es simple..."

# game/Story03.rpy:1455

translate spanish story04_771c08dc:

    # L "I know what’s hidden in the Abyss."
    L "Sé lo que está escondido en el Abismo."

# game/Story03.rpy:1457

translate spanish story04_9556576d:

    # mc "That’s not enough to make people want you dead."
    mc "Eso no es suficiente para que la gente te quiera muerto."

# game/Story03.rpy:1459

translate spanish story04_c46b1f38_1:

    # L "I’m one of the few who can enter it."
    L "Soy uno de los pocos que pueden entrar en él."

# game/Story03.rpy:1461

translate spanish story04_af38c14f:

    # mc "Now that is a different story."
    mc "Ahora es una historia diferente."

# game/Story03.rpy:1463

translate spanish story04_fd100e5b:

    # L "And you still don’t understand..."
    L "Y aún no entiendes..."

# game/Story03.rpy:1465

translate spanish story04_b1098a20:

    # mc "I know. But I still don’t understand."
    mc "Lo sé, pero aún no entiendo."

# game/Story03.rpy:1467

translate spanish story04_19e706b6:

    # L "Let me put it simply. The Abyss isn’t just another dimension. It’s... layers of broken, entangled realities."
    L "Deja que lo ponga simplemente. El Abismo no es solo otra dimensión. Es... capas de realidades rotas y enredadas."

# game/Story03.rpy:1469

translate spanish story04_10fc187f:

    # L "There are artifacts connected to it. They allow access."
    L "Hay artefactos conectados a él. Permiten el acceso."

# game/Story03.rpy:1471

translate spanish story04_c236f5b0:

    # L "Still following?"
    L "¿Sigues?"

# game/Story03.rpy:1473

translate spanish story04_f800bed0_1:

    # mc "Yes."
    mc "Sí."

# game/Story03.rpy:1475

translate spanish story04_82d9987e:

    # L "Good."
    L "Bien."

# game/Story03.rpy:1477

translate spanish story04_2872e70d_1:

    # L "Now the obvious question — why does everyone want in?"
    L "Ahora la pregunta obvia - ¿por qué todos quieren entrar?"

# game/Story03.rpy:1478

translate spanish story04_78f1808f:

    # L "The answer’s simple. Immortality."
    L "La respuesta es simple. Inmortalidad."

# game/Story03.rpy:1481

translate spanish story04_dce1b6b1:

    # mc "(The Abyss... Immortality... She says it like it’s just part of her daily life...)"
    mc "(El Abismo... la inmortalidad... Ella dice que es solo parte de su vida diaria...)"

# game/Story03.rpy:1486

translate spanish story04_c76a8629:

    # mc "I need time to process all of this."
    mc "Necesito tiempo para procesar todo esto."

# game/Story03.rpy:1488

translate spanish story04_7983de73:

    # L "I understand."
    L "Entiendo."

# game/Story03.rpy:1489

translate spanish story04_b62c378a:

    # L "I have to go. Take care of yourself."
    L "Tengo que irme, cuídate."

# game/Story03.rpy:1491

translate spanish story04_d21d697a:

    # mc "You too..."
    mc "Tú también..."

# game/Story03.rpy:1496

translate spanish story04_b97e0f40:

    # mc "You knew... You knew what I’d have to go through, and you still left."
    mc "Sabías... sabías lo que tendría que pasar, y aún te fuiste."

# game/Story03.rpy:1498

translate spanish story04_cc95c78e:

    # mc "Why didn’t you come back?.. Why didn’t you just come back..."
    mc "¿Por qué no regresaste?. ¿Por qué no acabas de volver..."

# game/Story03.rpy:1500

translate spanish story04_4995dfdd:

    # L "If I had returned... it would’ve been over. {w}Not just for me — for you, for everyone."
    L "Si hubiera regresado... habría terminado. {w}No solo para mí, para ti, para todos."

# game/Story03.rpy:1502

translate spanish story04_f7ebaa2a:

    # mc "You could’ve said something. Anything..."
    mc "Podrías haber dicho algo."

# game/Story03.rpy:1506

translate spanish story04_4d6b660e:

    # L "And what would you have done? Chased after me? Died?"
    L "¿Y qué habrías hecho? ¿Acaparado por mí?"

# game/Story03.rpy:1507

translate spanish story04_c1e4d97f:

    # L "I made a choice. {w}Not because I wanted to — because I had to."
    L "Hice una elección. {w}No porque yo quisiera, porque tenía que hacerlo."

# game/Story03.rpy:1513

translate spanish story04_3ca835df:

    # mc "Sometimes... even a conscious choice feels like betrayal."
    mc "A veces... incluso una elección consciente se siente como traición."

# game/Story03.rpy:1516

translate spanish story04_e932fe52:

    # L "...I know."
    L "...lo sé."

# game/Story03.rpy:1518

translate spanish story04_8dac49a4:

    # mc "What hurts the most isn’t that you left. It’s that you didn’t give me a chance... not even a goodbye."
    mc "Lo que más duele no es que te fuiste. Es que no me diste una oportunidad... ni siquiera un adiós."

# game/Story03.rpy:1526

translate spanish story04_9413ff51:

    # L "I said goodbye in my mind every single night. {w}But that’s not enough, is it?"
    L "Me despidió en la mente cada noche. {w}Pero eso no es suficiente, ¿verdad?"

# game/Story03.rpy:1528

translate spanish story04_fd22e77e:

    # mc "...No."
    mc "...no."

# game/Story03.rpy:1532

translate spanish story04_5b83c1c2:

    # mc "But maybe now — this is that chance."
    mc "Pero tal vez ahora, esta es esa oportunidad."

# game/Story03.rpy:1536

translate spanish story04_1e5e9894:

    # L "You still see me as human?"
    L "¿Todavía me ves como humano?"

# game/Story03.rpy:1538

translate spanish story04_ace0ebe5:

    # mc "I see you. With all your secrets, your fears, and yes — your choices."
    mc "Te veo. Con todos tus secretos, tus miedos y sí tus opciones."

# game/Story03.rpy:1539

translate spanish story04_c752b179:

    # mc "That doesn’t make you less human. Just... more complex."
    mc "Eso no te hace menos humano. Solo... más complejo."

# game/Story03.rpy:1541

translate spanish story04_a6d516ca:

    # L "That’s enough."
    L "Es suficiente."

# game/Story03.rpy:1544

translate spanish story04_62b2fe6e:

    # mc "Now tell me what really happened."
    mc "Ahora dime qué pasó realmente."

# game/Story03.rpy:1546

translate spanish story04_86d3e86c:

    # L "How to put this..."
    L "¿Cómo poner esto..."

# game/Story03.rpy:1547

translate spanish story04_6dd79c2a:

    # L "I’m a key."
    L "Soy una llave."

# game/Story03.rpy:1549

translate spanish story04_daa752da:

    # mc "A key?"
    mc "¿Una llave?"

# game/Story03.rpy:1550

translate spanish story04_e5221b65:

    # mc "Wait... a key to what? Is that a metaphor or literal?"
    mc "Espera... ¿Es una clave para qué?"

# game/Story03.rpy:1552

translate spanish story04_aad85c44:

    # L "Both..."
    L "Ambos..."

# game/Story03.rpy:1553

translate spanish story04_6f953e2d:

    # L "The portal I activated — it didn’t just happen. It responded to me."
    L "El portal que activé — no solo sucedió. Me respondió."

# game/Story03.rpy:1557

translate spanish story04_dcdac633:

    # L "Wait, you do know about it, right?"
    L "Espera, sabes de ello, ¿verdad?"

# game/Story03.rpy:1559

translate spanish story04_cf1adef2:

    # mc "Yeah."
    mc "Sí."

# game/Story03.rpy:1561

translate spanish story04_e9af7391:

    # L "And you still don’t get it..."
    L "Y aún no lo entiendes..."

# game/Story03.rpy:1563

translate spanish story04_0dadb7a5:

    # mc "Honestly? Not really."
    mc "¿En serio?"

# game/Story03.rpy:1565

translate spanish story04_10449473:

    # L "There’s the Abyss — think of it like a cluster of parallel realities. A terrifying place."
    L "Hay el Abyss — piensa en ello como un grupo de realidades paralelas. Un lugar aterrador."

# game/Story03.rpy:1567

translate spanish story04_1dcb9dce:

    # L "There are regular people. They can’t interact with the Abyss."
    L "Hay gente regular. No pueden interactuar con el Abismo."

# game/Story03.rpy:1569

translate spanish story04_c6391848_1:

    # L "Still with me?"
    L "¿Sigues conmigo?"

# game/Story03.rpy:1571

translate spanish story04_be064e5e:

    # mc "What do you mean by {b}terrifying place?{/b}"
    mc "¿Qué quieres decir con {b}¿Un lugar aterrador?{/b}"

# game/Story03.rpy:1573

translate spanish story04_db01309b:

    # L "The Abyss has no shape, but it breathes. There’s no time, no logic in it."
    L "El Abismo no tiene forma, pero respira. No hay tiempo, no hay lógica en ella."

# game/Story03.rpy:1574

translate spanish story04_b2d85ea5:

    # L "Only... warped shadows of realities. If you stare too long, you forget who you are."
    L "Solo... sombras de realidades encubiertas... si miras demasiado tiempo, olvidas quién eres."

# game/Story03.rpy:1578

translate spanish story04_110db918:

    # mc "In simpler terms?"
    mc "¿En términos más simples?"

# game/Story03.rpy:1580

translate spanish story04_6e3e1de9:

    # L "That was the simple version. It’s hard to explain. You’ll have to take my word."
    L "Esa era la versión simple. Es difícil de explicar. Tendrás que tomar mi palabra."

# game/Story03.rpy:1582

translate spanish story04_6651ab87:

    # mc "Alright."
    mc "Muy bien."

# game/Story03.rpy:1584

translate spanish story04_f5e88c3f_1:

    # L "Good boy."
    L "Buen chico."

# game/Story03.rpy:1586

translate spanish story04_5aaba813:

    # L "Now, there are people like me — we can interact with that world."
    L "Ahora, hay gente como yo, podemos interactuar con ese mundo."

# game/Story03.rpy:1587

translate spanish story04_877dbbfe:

    # L "Common folk call us psykers."
    L "La gente común nos llama psiquiatras."

# game/Story03.rpy:1590

translate spanish story04_5ddaab18_1:

    # mc "(What?)"
    mc "(¿Qué?)"

# game/Story03.rpy:1597

translate spanish story04_d274e7e9:

    # mc "(The Abyss reacts to portals. And Lora can interact with the Abyss...)"
    mc "(El Abismo reacciona a los portales. Y Lora puede interactuar con el Abismo...)"

# game/Story03.rpy:1598

translate spanish story04_5546706c:

    # mc "(Of course everything lines up perfectly — lucky me.)"
    mc "(Por supuesto todo se alinea perfectamente — afortunado.)"

# game/Story03.rpy:1600

translate spanish story04_d289642f:

    # mc "Alright, I need to process all of this."
    mc "Bien, necesito procesar todo esto."

# game/Story03.rpy:1602

translate spanish story04_c7cecc6b:

    # mc "And you could use some sleep."
    mc "Y podrías dormir un poco."

# game/Story03.rpy:1604

translate spanish story04_37ddf8d3:

    # L "That would be lovely."
    L "Eso sería encantador."

# game/Story03.rpy:1609

translate spanish story04_dbf6f967:

    # mc "(Okay, but... what now? The problems still hang over our heads.)"
    mc "(Vale, pero... ¿ahora qué? Los problemas aún se ahorcan sobre nuestras cabezas.)"

# game/Story03.rpy:1611

translate spanish story04_9e2911ee:

    # L "There it is again — that little frown... Stop it."
    L "Ahí está otra vez, ese pequeño ceño... basta."

# game/Story03.rpy:1613

translate spanish story04_b6493171:

    # L "Let your brain relax for once."
    L "Deja que tu cerebro se relaje por una vez."

# game/Story03.rpy:1615

translate spanish story04_5be80e38:

    # mc "Can’t... It’s all too complicated."
    mc "No puedo... Es demasiado complicado."

# game/Story03.rpy:1616

translate spanish story04_4d4da92c:

    # L "Don’t overthink it."
    L "No lo pienses demasiado."

# game/Story03.rpy:1620

translate spanish story04_adc6295b:

    # L "You know, I’ve got a perfect plan!"
    L "¡Sabes, tengo un plan perfecto!"

# game/Story03.rpy:1623

translate spanish story04_a1d4bcb4:

    # mc "(A plan?)"
    mc "(¿Un plan?)"

# game/Story03.rpy:1625

translate spanish story04_e363030b:

    # mc "Wait, what kind of— Pla—"
    mc "Espera, ¿qué clase de..."

# game/Story03.rpy:1627

translate spanish story04_9993b94e_27:

    # L "..."
    L "..."

# game/Story03.rpy:1630

translate spanish story04_5f99675b:

    # L "Are you ready... to make up for lost time?"
    L "¿Estás listo para compensar el tiempo perdido?"

# game/Story03.rpy:1633

translate spanish story04_4b66c920:

    # mc "After all these years? Of course. Just..."
    mc "¿Después de todos estos años?"

# game/Story03.rpy:1637

translate spanish story04_88e2db20:

    # mc "Please, be gentle with me."
    mc "Por favor, sé amable conmigo."

# game/Story03.rpy:1639

translate spanish story04_db5cb18a_1:

    # L "Time to wash her filth off you."
    L "Es hora de lavarte su suciedad."

# game/Story03.rpy:1642

translate spanish story04_d94d702f:

    # mc "Oh... What do you mean?"
    mc "¿Qué quieres decir?"

# game/Story03.rpy:1644

translate spanish story04_26b99e20_1:

    # L "Just thinking out loud."
    L "Solo pensaba en voz alta."

# game/Story03.rpy:1648

translate spanish story04_3e8173a6:

    # L "God, this feels so good..."
    L "Dios, esto se siente tan bien..."

# game/Story03.rpy:1651

translate spanish story04_2040e08e:

    # mc "You're like an animal, Lora."
    mc "Eres como una bestia, Laura."

# game/Story03.rpy:1652

translate spanish story04_6dc18362_1:

    # L "Didn’t you know? I’ve always been a predator."
    L "¿No lo sabías? Siempre he sido un depredador."

# game/Story03.rpy:1653

translate spanish story04_4c562f7b:

    # mc "Then why don’t I feel fear?"
    mc "Entonces, ¿por qué no siento miedo?"

# game/Story03.rpy:1654

translate spanish story04_12720f09:

    # L "Because you — are mine."
    L "Porque tú eres mía."

# game/Story03.rpy:1655

translate spanish story04_e2e3dcd0:

    # L "You can fight. Try to take control..."
    L "Puedes luchar, intenta controlar..."

# game/Story03.rpy:1656

translate spanish story04_c63bcd1a_1:

    # L "But in the end, you’ll still end up beneath me."
    L "Pero al final, aún terminarás bajo mí."

# game/Story03.rpy:1657

translate spanish story04_8d649b82:

    # mc "I’m not so sure about that part."
    mc "No estoy tan seguro de esa parte."

# game/Story03.rpy:1658

translate spanish story04_096e26d8_1:

    # L "What?"
    L "¿Qué?"

# game/Story03.rpy:1665

translate spanish story04_2455437c_1:

    # mc "You thought you’d always have control over me, didn’t you?"
    mc "Pensabas que siempre tendrías control sobre mí, ¿no?"

# game/Story03.rpy:1666

translate spanish story04_cf4e715c:

    # L "Wasn’t I right?"
    L "¿No tenía razón?"

# game/Story03.rpy:1667

translate spanish story04_21b36a98:

    # mc "Not tonight. Tonight, you’re the one heading to bliss."
    mc "Esta noche no. Esta noche, eres el que se dirige a la dicha."

# game/Story03.rpy:1668

translate spanish story04_f6c3e5cf:

    # mc "All I need from you... is a yes."
    mc "Todo lo que necesito de ti... es un sí."

# game/Story03.rpy:1669

translate spanish story04_3cb513d2:

    # L "And what if I don’t want to give in?"
    L "¿Y si no quiero rendirme?"

# game/Story03.rpy:1670

translate spanish story04_658cd16a_1:

    # mc "Then I’ll make you want to."
    mc "Entonces haré que quieras."

# game/Story03.rpy:1671

translate spanish story04_d3ee2e15:

    # L "Is that the best you’ve got?"
    L "¿Es lo mejor que tienes?"

# game/Story03.rpy:1680

translate spanish story04_23d93394:

    # mc "Well? Changed your mind yet?"
    mc "¿Ya te has cambiado de opinión?"

# game/Story03.rpy:1682

translate spanish story04_8e4500ec:

    # L "I... I still can..."
    L "Yo... todavía puedo..."

# game/Story03.rpy:1683

translate spanish story04_48d7a357:

    # mc "No. You can’t."
    mc "No. No puedes."

# game/Story03.rpy:1697

translate spanish story04_86c49c13_1:

    # L "You know, you were almost unbearable tonight..."
    L "Sabes, eras casi insoportable esta noche..."

# game/Story03.rpy:1698

translate spanish story04_385d2325:

    # mc "Just tonight?"
    mc "¿Solo esta noche?"

# game/Story03.rpy:1699

translate spanish story04_84548121:

    # L "Mhm, just tonight. Good night, darling."
    L "Buenas noches, querida."

# game/Story03.rpy:1700

translate spanish story04_f56d3401:

    # mc "Yeah... Good night."
    mc "Sí... buenas noches."

# game/Story03.rpy:1718

translate spanish akt3chapter2_22912c56:

    # mc "(Where the hell did I end up this time?)"
    mc "¿Dónde diablos terminé esta vez?"

# game/Story03.rpy:1721

translate spanish akt3chapter2_d4ad830d:

    # mc "(Everything looks like it’s...)"
    mc "(Todo parece que es...)"

# game/Story03.rpy:1724

translate spanish akt3chapter2_6d976220:

    # aa "A dream?"
    aa "¿Un sueño?"

# game/Story03.rpy:1726

translate spanish akt3chapter2_58589dd6:

    # mc "(A dream... but far too real.)"
    mc "(Un sueño... pero demasiado real.)"

# game/Story03.rpy:1730

translate spanish akt3chapter2_f107dcaf:

    # mc "You… can hear me?"
    mc "¿Puedes oírme?"

# game/Story03.rpy:1733

translate spanish akt3chapter2_85e48934:

    # mc "(Why can I feel this cold crawling down my spine..?)"
    mc "(¿Por qué puedo sentir este frío arrastrando por mi columna?)"

# game/Story03.rpy:1735

translate spanish akt3chapter2_7c1680fc:

    # mc "(And that mask of his... carved from snow, no eyeholes.)"
    mc "(Y esa máscara de su... tallada de nieve, sin ojos)."

# game/Story03.rpy:1737

translate spanish akt3chapter2_f8a2d499:

    # mc "No words? Who are you? What do you want?"
    mc "¿Qué quieres?"

# game/Story03.rpy:1740

translate spanish akt3chapter2_b3aa3e75:

    # mc "Where even are we?"
    mc "¿Dónde estamos?"

# game/Story03.rpy:1744

translate spanish akt3chapter2_765a6a82:

    # aa "I’ve been watching you... watching your choices."
    aa "Te he estado observando tus opciones."

# game/Story03.rpy:1747

translate spanish akt3chapter2_e06bf3de:

    # mc "(Watching?)"
    mc "¿Esperando?"

# game/Story03.rpy:1748

translate spanish akt3chapter2_19775acb:

    # mc "You some kind of guardian? If not — what’s the point?"
    mc "¿Eres algún tipo de tutor? Si no – ¿Cuál es el punto?"

# game/Story03.rpy:1750

translate spanish akt3chapter2_53de29ee:

    # aa "I’m not your guardian. Never have been."
    aa "No soy tu guardián. Nunca lo he sido."

# game/Story03.rpy:1751

translate spanish akt3chapter2_d033f1f4:

    # aa "But..."
    aa "Pero..."

# game/Story03.rpy:1752

translate spanish akt3chapter2_be54f22f:

    # aa "The key sleeps within you. I can’t touch it — but you already carry it."
    aa "La llave duerme dentro de ti. No puedo tocarla, pero ya la llevas."

# game/Story03.rpy:1756

translate spanish akt3chapter2_7318ee42:

    # mc "(So I’m here for a reason, huh?)"
    mc "(Entonces estoy aquí por una razón, ¿eh?)"

# game/Story03.rpy:1757

translate spanish akt3chapter2_57a00897:

    # mc "(When did I become the world's savior, exactly?)"
    mc "(¿Cuándo me convertí en el salvador del mundo?)"

# game/Story03.rpy:1759

translate spanish akt3chapter2_518d3cde:

    # mc "Tell me what you want, White Mask."
    mc "Dime lo que quieras, White Mask."

# game/Story03.rpy:1760

translate spanish akt3chapter2_c1c87e65:

    # aa "She’s bound in the Abyss. But the cracks have already begun."
    aa "Está atada en el Abyss. Pero las grietas ya han comenzado."

# game/Story03.rpy:1762

translate spanish akt3chapter2_693938ab:

    # mc "Riddles again... How about something simple, for once?"
    mc "Riddles otra vez... ¿Qué tal algo simple, por una vez?"

# game/Story03.rpy:1764

translate spanish akt3chapter2_8e7403d8:

    # mc "You’re sitting in my head, and you know I’ve had it with this shit."
    mc "Estás sentado en mi cabeza, y sabes que lo he tenido con esta mierda."

# game/Story03.rpy:1767

translate spanish akt3chapter2_c6077828:

    # aa "You mustn’t let her awaken."
    aa "No debes dejarla despertar."

# game/Story03.rpy:1771

translate spanish akt3chapter2_800afb04:

    # mc "That’s... Astoria?"
    mc "Eso es... ¿Astoria?"

# game/Story03.rpy:1773

translate spanish akt3chapter2_d65e4a87:

    # aa "Her younger sister."
    aa "Su hermana menor."

# game/Story03.rpy:1775

translate spanish akt3chapter2_43a4068d:

    # mc "What are you talking about? You mean she’s part of that artifact?"
    mc "¿De qué estás hablando? ¿Quieres decir que es parte de ese artefacto?"

# game/Story03.rpy:1777

translate spanish akt3chapter2_480bd2f7:

    # aa "Astoria is flame. But her sister — she’s darkness that remembers how to burn."
    aa "Astoria es llama. Pero su hermana — es oscuridad que recuerda cómo quemar."

# game/Story03.rpy:1784

translate spanish akt3chapter2_0b2a3361:

    # aa "It’s... happening too fast."
    aa "Está... pasando demasiado rápido."

# game/Story03.rpy:1785

translate spanish akt3chapter2_008c63d5:

    # mc "(What the hell is going on?!)"
    mc "(¿Qué demonios está pasando?!)"

# game/Story03.rpy:1793

translate spanish akt3chapter2_eaa1a017:

    # aa "(Just a bit more... and nothing will stop us.)"
    aa "(Solo un poco más... y nada nos detendrá.)"

# game/Story03.rpy:1794

translate spanish akt3chapter2_312a533b:

    # gg "Ma’am, the gates are beginning to close."
    gg "Señora, las puertas están empezando a cerrar."

# game/Story03.rpy:1796

translate spanish akt3chapter2_0769a6d8:

    # aa "What’s happening?"
    aa "¿Qué está pasando?"

# game/Story03.rpy:1798

translate spanish akt3chapter2_51dc01cf:

    # R "Things went off-script."
    R "Las cosas se fueron de la escuela."

# game/Story03.rpy:1800

translate spanish akt3chapter2_f014ce6c:

    # aa "Details."
    aa "Detalles."

# game/Story03.rpy:1804

translate spanish akt3chapter2_bd810fd2:

    # R "Internal resistance. Something’s keeping us from entering."
    R "Resistencia interna. Algo nos impide entrar."

# game/Story03.rpy:1805

translate spanish akt3chapter2_95681472:

    # R "Not enough energy to open the portal."
    R "No suficiente energía para abrir el portal."

# game/Story03.rpy:1806

translate spanish akt3chapter2_0f94b4e6:

    # aa "We need more sacrifices?"
    aa "¿Necesitamos más sacrificios?"

# game/Story03.rpy:1808

translate spanish akt3chapter2_fe701b0c:

    # R "Yes. A lot more."
    R "Sí, mucho más."

# game/Story03.rpy:1810

translate spanish akt3chapter2_4acb9992:

    # aa "You."
    aa "Tú."

# game/Story03.rpy:1814

translate spanish akt3chapter2_70c8041e:

    # ggg "Yes, ma’am!"
    ggg "¡Sí, señora!"

# game/Story03.rpy:1816

translate spanish akt3chapter2_66eedf5a:

    # aa "Throw bait into the lower town."
    aa "Tirar cebo en la ciudad baja."

# game/Story03.rpy:1818

translate spanish akt3chapter2_11cb946b:

    # ggg "Right away."
    ggg "Enseguida."

# game/Story03.rpy:1820

translate spanish akt3chapter2_9f74a4ee:

    # aa "And warn the elves there — tell them to run."
    aa "Y advierte a los elfos allí, diles que corran."

# game/Story03.rpy:1822

translate spanish akt3chapter2_59a17453:

    # R "Now that’s a twist."
    R "Ahora eso es un giro."

# game/Story03.rpy:1839

translate spanish akt3chapter2_2567e431:

    # mc "My head is splitting... {w} Did I pass out? First time in a couple of days..."
    mc "Mi cabeza se está dividiendo... {w} ¿Me he pasado?"

# game/Story03.rpy:1841

translate spanish akt3chapter2_fde28825:

    # mc "(And for what? I just feel worse. Like I got flattened by a truck.)"
    mc "(Y por qué? Me siento peor. Como me halaga un camión.)"

# game/Story03.rpy:1843

translate spanish akt3chapter2_9321491e:

    # mc "(These dreams... they’re too vivid. And something about them is wrong. Deeply wrong.)"
    mc "(Estos sueños... son demasiado vívidos. Y algo sobre ellos está mal. Profundamente equivocado.)"

# game/Story03.rpy:1845

translate spanish akt3chapter2_a8fcc26b:

    # mc "Enough whining. Move your ass."
    mc "Basta de lloriqueo, muévete el culo."

# game/Story03.rpy:1847

translate spanish akt3chapter2_45fba807:

    # mc "(I need to find the others. Before they tear each other apart.)"
    mc "(Necesito encontrar a los otros. Antes de que se desgarren.)"

# game/Story03.rpy:1849

translate spanish akt3chapter2_197e0e88:

    # mc "(Especially Olivia, Kalestra... and Lora.)"
    mc "(Especialmente Olivia, Kalestra... y Lora.)"

# game/Story03.rpy:1851

translate spanish akt3chapter2_3c9f286c:

    # mc "Lora..."
    mc "Lora..."

# game/Story03.rpy:1855

translate spanish akt3chapter2_69196beb:

    # mc "Left? Right? Who cares. I’ll figure it out as I go."
    mc "¿Izquierda? ¿A quién le importa? Lo averiguaré mientras me voy."

# game/Story03.rpy:1856

translate spanish akt3chapter2_e95bf460:

    # mc "Knowing my luck? Straight into hell."
    mc "¿Saber mi suerte?"

# game/Story03.rpy:1862

translate spanish akt3chapter2_9aa472c6:

    # mc "(The corridor... bare metal. No people. Not even rats.)"
    mc "(El pasillo... metal desnudo, sin gente, ni ratas.)"

# game/Story03.rpy:1865

translate spanish akt3chapter2_2269e86c:

    # mc "(Each step’s a gunshot. Whoever’s out there — they already know.)"
    mc "(Cada paso es un disparo. Quien está ahí fuera — ya lo saben.)"

# game/Story03.rpy:1868

translate spanish akt3chapter2_533be7c3:

    # mc "(And you know what? Good. Silence is worse than the unknown.)"
    mc "El silencio es peor que lo desconocido."

# game/Story03.rpy:1870

translate spanish akt3chapter2_2acd009a:

    # mc "Corridors. Endless damn corridors."
    mc "Corredores, corredores sin fin."

# game/Story03.rpy:1872

translate spanish akt3chapter2_c0194040:

    # mc "(Maybe I should call out... try to find someone?)"
    mc "(Quizá debería llamar... ¿tratar a buscar a alguien?)"

# game/Story03.rpy:1874

translate spanish akt3chapter2_afe7c3d5:

    # mc "(Though who? It’s quieter than a morgue in here.)"
    mc "(¿A quién? Es más tranquilo que una morgue aquí.)"

# game/Story03.rpy:1877

translate spanish akt3chapter2_78baccc2:

    # mc "Well then... time for a song."
    mc "Bueno entonces... es hora de una canción."

# game/Story03.rpy:1882

translate spanish akt3chapter2_33e9a386:

    # mc "(So much has happened... It’s unreal.)"
    mc "(Ha pasado mucho... es irreal.)"

# game/Story03.rpy:1885

translate spanish akt3chapter2_12571677:

    # mc "(As if soulless monsters weren’t enough, now everyone’s chasing damn immortality.)"
    mc "(Como si los Desalmados no fueran suficiente, ahora todos persiguen la maldita inmortalidad.)"

# game/Story03.rpy:1886

translate spanish akt3chapter2_d7a88826:

    # mc "(Exhausting...)"
    mc "(Agotando...)"

# game/Story03.rpy:1890

translate spanish akt3chapter2_6c430e53:

    # mc "(Wait... hold on...)"
    mc "(Espera... espera...)"

# game/Story03.rpy:1893

translate spanish akt3chapter2_18cd513d:

    # mc "(Something’s off.)"
    mc "(Algo está apagado.)"

# game/Story03.rpy:1895

translate spanish akt3chapter2_a9392d5d:

    # mc "Quiet..."
    mc "Silencio..."

# game/Story03.rpy:1896

translate spanish akt3chapter2_742a7621:

    # mc "Too quiet."
    mc "Demasiado silencio."

# game/Story03.rpy:1898

translate spanish akt3chapter2_51cf3399:

    # mc "(All this time — not a single person.)"
    mc "(Todo este tiempo, no una sola persona.)"

# game/Story03.rpy:1901

translate spanish akt3chapter2_785b9566:

    # mc "(I don’t like this.)"
    mc "(No me gusta esto.)"

# game/Story03.rpy:1904

translate spanish akt3chapter2_a9862efa:

    # mc "(Empty...)"
    mc "(Vacía...)"

# game/Story03.rpy:1907

translate spanish akt3chapter2_8bd9693d:

    # mc "(Here too.)"
    mc "(Aquí también.)"

# game/Story03.rpy:1910

translate spanish akt3chapter2_5c3153a1:

    # mc "(A joke? No, this is... madness. A dream?)"
    mc "No, esto es... locura. ¿Un sueño?"

# game/Story03.rpy:1912

translate spanish akt3chapter2_71c7e6a7:

    # mc "Hey! Is anyone here?!"
    mc "¿Hay alguien aquí?"

# game/Story03.rpy:1913

translate spanish akt3chapter2_38da4e44:

    # mc "Lora! Olivia! Kalestra! Someone, say something!"
    mc "¡Olivia, Kalestra, di algo!"

# game/Story03.rpy:1920

translate spanish akt3chapter2_7cddc058:

    # a "Quiet."
    a "Silencio."

# game/Story03.rpy:1927

translate spanish akt3chapter2_465734bf:

    # mc "(whispers) What the hell is going on here?"
    mc "¿Qué demonios está pasando aquí?"

# game/Story03.rpy:1932

translate spanish akt3chapter2_ebb64590:

    # a "(whispers) They found out."
    a "Se enteraron."

# game/Story03.rpy:1934

translate spanish akt3chapter2_315cc1f6:

    # mc "(whispers) Who? Where is everyone else?"
    mc "¿Dónde están los demás?"

# game/Story03.rpy:1945

translate spanish akt3chapter2_ea4e48cd:

    # a "Move."
    a "Muévete."

# game/Story03.rpy:1950

translate spanish akt3chapter2_68919a8f:

    # a "You armed?"
    a "¿Estás armado?"

# game/Story03.rpy:1953

translate spanish akt3chapter2_fca52711:

    # mc "No."
    mc "No."

# game/Story03.rpy:1956

translate spanish akt3chapter2_68641a1b:

    # mc "(A pistol? Anything... Fine.)"
    mc "¿Algo... bien?"

# game/Story03.rpy:1958

translate spanish akt3chapter2_bfe5c751:

    # a "Cover me."
    a "Cubreme."

# game/Story03.rpy:1960

translate spanish akt3chapter2_462f9f6d:

    # mc "We’ll see who’s covering who."
    mc "Veremos quién cubre quién."

# game/Story03.rpy:1964

translate spanish akt3chapter2_ef85c08c:

    # a "Good."
    a "Bien."

# game/Story03.rpy:1978

translate spanish akt3chapter2_8e09ac59:

    # mc "You meant these ones? How the hell did they even get in here?"
    mc "¿Cómo diablos llegaron hasta aquí?"

# game/Story03.rpy:1980

translate spanish akt3chapter2_406a0704:

    # a "Doesn't matter."
    a "Lo que sea."

# game/Story03.rpy:1985

translate spanish akt3chapter2_db8f77f4:

    # mc "The others?"
    mc "¿Los otros?"

# game/Story03.rpy:1988

translate spanish akt3chapter2_c63e49c1:

    # mc "What about them?"
    mc "¿Qué hay de ellos?"

# game/Story03.rpy:1990

translate spanish akt3chapter2_7d430ec0:

    # a "Alive. I didn't come for them."
    a "No vine por ellos."

# game/Story03.rpy:1998

translate spanish akt3chapter2_6d3f3a4d:

    # mc "You never stop."
    mc "Nunca paras."

# game/Story03.rpy:2009

translate spanish akt3chapter2_08c09db2:

    # mc "(They used to be stronger. Or is it just me?)"
    mc "(Ellos solían ser más fuertes. ¿O es solo yo?)"

# game/Story03.rpy:2011

translate spanish akt3chapter2_7022e0d3:

    # a "Last one."
    a "El último."

# game/Story03.rpy:2014

translate spanish akt3chapter2_891ed671:

    # a "Clean job."
    a "Trabajo limpio."

# game/Story03.rpy:2015

translate spanish akt3chapter2_54fdbc26:

    # a "He’ll work."
    a "Trabajará."

# game/Story03.rpy:2017

translate spanish akt3chapter2_f3ce9207:

    # mc "Thanks...? I guess..."
    mc "Gracias, supongo..."

# game/Story03.rpy:2018

translate spanish akt3chapter2_8df27228:

    # mc "({b}He’ll work{/b}. Like she’s complimenting a hammer.)"
    mc "({b}Trabajará.{/b}. Como si estuviera alabando un martillo.)"

# game/Story03.rpy:2021

translate spanish akt3chapter2_e65d9463:

    # mc "Is that a... survivor?"
    mc "¿Es un... sobreviviente?"

# game/Story03.rpy:2023

translate spanish akt3chapter2_e6111f74:

    # g "Kh... More like what’s left of me..."
    g "Kh... más bien lo que queda de mí..."

# game/Story03.rpy:2026

translate spanish akt3chapter2_14961f49:

    # g "Don’t waste time... I’m done for."
    g "No pierdas el tiempo... Estoy acabado."

# game/Story03.rpy:2027

translate spanish akt3chapter2_76bfd1ac:

    # g "All I wanted was to go home..."
    g "Todo lo que quería era ir a casa..."

# game/Story03.rpy:2030

translate spanish akt3chapter2_d5d8435b:

    # a "Who attacked?"
    a "¿Quién atacó?"

# game/Story03.rpy:2032

translate spanish akt3chapter2_b51d8e2d:

    # g "The Soulless... Someone directed them. Straight to us."
    g "El Inmueble... alguien los dirigió, directo a nosotros."

# game/Story03.rpy:2033

translate spanish akt3chapter2_b3d71468:

    # g "We... didn’t even have time to react..."
    g "Nosotros... ni siquiera tuvimos tiempo de reaccionar..."

# game/Story03.rpy:2035

translate spanish akt3chapter2_4c7021e4:

    # mc "You’re here alone? Where are the others?"
    mc "¿Estás solo? ¿Dónde están los otros?"

# game/Story03.rpy:2038

translate spanish akt3chapter2_26bc6a20:

    # g "Over there... survivors. I tried to cover them, but..."
    g "Por ahí... sobrevivientes, intenté cubrirlos, pero..."

# game/Story03.rpy:2045

translate spanish akt3chapter2_19f5fb8b:

    # g "Now they’re in danger. The Faceless are here."
    g "Ahora están en peligro. Los sin rostro están aquí."

# game/Story03.rpy:2046

translate spanish akt3chapter2_2a61b2dc:

    # g "They won’t make it. Not against them."
    g "No lo lograrán. No contra ellos."

# game/Story03.rpy:2047

translate spanish akt3chapter2_211f0919:

    # mc "Faceless? You mean those invisible freaks?"
    mc "¿Te refieres a esos monstruos invisibles?"

# game/Story03.rpy:2049

translate spanish akt3chapter2_f651834f:

    # g "That’s the ones, sir..."
    g "Ése es el que, señor..."

# game/Story03.rpy:2050

translate spanish akt3chapter2_c7f957a5:

    # mc "(This is bad. If it weren’t for Flora, I’d be headless right now.)"
    mc "(Esto es malo. Si no fuera por Flora, estaría sin cabeza ahora mismo.)"

# game/Story03.rpy:2051

translate spanish akt3chapter2_2a14d9be:

    # g "You... you're one of them. The Maiden of War..."
    g "Eres uno de ellos."

# game/Story03.rpy:2052

translate spanish akt3chapter2_191f6dda:

    # g "I know I shouldn’t ask but…"
    g "Sé que no debería preguntar pero..."

# game/Story03.rpy:2054

translate spanish akt3chapter2_83f74e10:

    # g "End it..."
    g "Termínalo..."

# game/Story03.rpy:2056

translate spanish akt3chapter2_941dcd09:

    # mc "What are you ta—"
    mc "¿Qué estás haciendo?"

# game/Story03.rpy:2062

translate spanish akt3chapter2_e9ff3baf:

    # mc "Hey! He’s one of ours! What are you—"
    mc "¡Es uno de los nuestros!"

# game/Story03.rpy:2063

translate spanish akt3chapter2_d8cf9260:

    # g "I... just wanted to go home..."
    g "Yo... solo quería ir a casa..."

# game/Story03.rpy:2069

translate spanish akt3chapter2_b8c19548:

    # mc "HE WAS ONE OF US, DAMN IT!"
    mc "¡Era uno de nosotros, joder!"

# game/Story03.rpy:2074

translate spanish akt3chapter2_703ac693:

    # a "He was already dying."
    a "Ya estaba muriendo."

# game/Story03.rpy:2077

translate spanish akt3chapter2_4352e888:

    # mc "He was talking! He was asking! He was-"
    mc "Él estaba hablando, él estaba preguntando, él estaba..."

# game/Story03.rpy:2079

translate spanish akt3chapter2_2c7767f2:

    # a "You would’ve let him suffer?"
    a "¿Lo habrías dejado sufrir?"

# game/Story03.rpy:2080

translate spanish akt3chapter2_e80a5349:

    # a "Better a clean end than a slow death."
    a "Mejor un final limpio que una muerte lenta."

# game/Story03.rpy:2082

translate spanish akt3chapter2_27f72556:

    # a "That’s it. Let’s go."
    a "Eso es. Vamos."

# game/Story03.rpy:2083

translate spanish akt3chapter2_0ac20b9b:

    # mc "(Maybe she’s right... but to shoot one of our own without a flinch...)"
    mc "(Quizá tenga razón... pero disparar a uno de los nuestros sin un pinchazo...)"

# game/Story03.rpy:2086

translate spanish akt3chapter2_e9b6b6e7:

    # mc "(If it were me instead... would she have done the same?)"
    mc "(Si fuera yo, ¿habría hecho lo mismo?)"

# game/Story03.rpy:2089

translate spanish akt3chapter2_ea4e48cd_1:

    # a "Move."
    a "Muévete."

# game/Story03.rpy:2094

translate spanish akt3chapter2_71acc0ba:

    # mc "...Yeah. Coming."
    mc "- Sí, ya voy."

# game/Story03.rpy:2103

translate spanish akt3chapter2_244c6a9d:

    # mc "(If that was the only choice — then what the hell awaits me?)"
    mc "(Si esa fue la única opción - entonces ¿qué demonios me espera?)"

# game/Story03.rpy:2104

translate spanish akt3chapter2_e21f48be:

    # mc "(Damn it, I’m losing it. No more circles — just ask her.)"
    mc "(Damn it, I'm losing. No más círculos - solo preguntar a ella.)"

# game/Story03.rpy:2107

translate spanish akt3chapter2_4c1aa1f6:

    # mc "Be honest. If it were me instead of him — or anyone else — would you have done the same?"
    mc "Sé honesto. ¿Si fuera yo en lugar de él, o alguien más, habrías hecho lo mismo?"

# game/Story03.rpy:2110

translate spanish akt3chapter2_210c06eb:

    # a "Yes."
    a "Sí."

# game/Story03.rpy:2112

translate spanish akt3chapter2_11e8529e:

    # mc "(Didn’t even blink.)"
    mc "(Ni siquiera parpadeó.)"

# game/Story03.rpy:2113

translate spanish akt3chapter2_f536237b:

    # mc "(Fantastic. One misstep and I get a bullet too.)"
    mc "(Fantastico. Un error y yo también tengo una bala)."

# game/Story03.rpy:2114

translate spanish akt3chapter2_63039663:

    # mc "(I need to find Lora and Olivia — fast. Before it’s too late.)"
    mc "(Necesito encontrar a Lora y Olivia — rápido. Antes de que sea demasiado tarde.)"

# game/Story03.rpy:2116

translate spanish akt3chapter2_1ddae9b3:

    # mc "(Everything else can wait... First, I need information.)"
    mc "(Todo lo demás puede esperar... primero, necesito información.)"

# game/Story03.rpy:2118

translate spanish akt3chapter2_a636480f:

    # mc "Right. So we’re playing the guessing game now. Great."
    mc "Bien. Así que estamos jugando el juego de adivinanzas ahora."

# game/Story03.rpy:2119

translate spanish akt3chapter2_64bbc67c:

    # mc "Cut the silence — what’s really going on here?"
    mc "Corta el silencio — ¿qué está pasando realmente aquí?"

# game/Story03.rpy:2126

translate spanish akt3chapter2_76c27651:

    # mc "(Yeah. Golden silence. Just what I needed.)"
    mc "(Sí, silencio dorado. Justo lo que necesitaba.)"

# game/Story03.rpy:2129

translate spanish akt3chapter2_1e540330:

    # a "Someone’s controlling the Soulless."
    a "Alguien está controlando a los Desalmados."

# game/Story03.rpy:2131

translate spanish akt3chapter2_4bc25851:

    # mc "Like... a shepherd of the dead? Oh, this just keeps getting better..."
    mc "¿Como un pastor de muertos?"

# game/Story03.rpy:2132

translate spanish akt3chapter2_791d41fb:

    # mc "(She says it so calmly — like it’s nothing.)"
    mc "(Ella lo dice con tanta calma — como si no fuera nada.)"

# game/Story03.rpy:2134

translate spanish akt3chapter2_134cb603:

    # mc "So it was their doing?"
    mc "¿Así que fue su trabajo?"

# game/Story03.rpy:2137

translate spanish akt3chapter2_75117745:

    # a "Most likely."
    a "Lo más probable."

# game/Story03.rpy:2140

translate spanish akt3chapter2_d833dfee:

    # mc "Most likely? So even you don’t know much, do you?"
    mc "¿Lo más probable? Así que ni siquiera sabes mucho, ¿verdad?"

# game/Story03.rpy:2143

translate spanish akt3chapter2_ccce35ff:

    # a "Lots of gaps."
    a "Muchas lagunas."

# game/Story03.rpy:2144

translate spanish akt3chapter2_8f0778a3:

    # a "Few facts."
    a "Pocos hechos."

# game/Story03.rpy:2147

translate spanish akt3chapter2_f7feaf42:

    # mc "Then how’d they find this hideout?"
    mc "¿Entonces cómo encontraron este escondite?"

# game/Story03.rpy:2155

translate spanish akt3chapter2_1726d1d9:

    # mc "Ears?"
    mc "¿Oídos?"

# game/Story03.rpy:2158

translate spanish akt3chapter2_3898012d:

    # a "They’re very sensitive to sound."
    a "Son muy sensibles al sonido."

# game/Story03.rpy:2160

translate spanish akt3chapter2_31ad668a:

    # mc "So they followed the noise to us?"
    mc "¿Así que nos siguieron el ruido?"

# game/Story03.rpy:2161

translate spanish akt3chapter2_278bdd85:

    # mc "How does that even make sense..."
    mc "¿Cómo tiene sentido eso?"

# game/Story03.rpy:2163

translate spanish akt3chapter2_487a0cb1:

    # a "That’s not your priority right now."
    a "Esa no es tu prioridad ahora mismo."

# game/Story03.rpy:2165

translate spanish akt3chapter2_25730a42:

    # mc "That’s all? After putting a bullet in your own guy?"
    mc "¿Después de poner una bala en tu propio tipo?"

# game/Story03.rpy:2167

translate spanish akt3chapter2_60541220:

    # mc "(Silence. Again.)"
    mc "(Silencio. Otra vez.)"

# game/Story03.rpy:2169

translate spanish akt3chapter2_c67429e2:

    # mc "Figures. I’ll do it alone, then."
    mc "Figuras. Lo haré solo, entonces."

# game/Story03.rpy:2170

translate spanish akt3chapter2_f560e395:

    # mc "(If I don’t lose my mind on the way.)"
    mc "(Si no pierdo la cabeza en el camino.)"

# game/Story03.rpy:2181

translate spanish akt3chapter2_844ac3a2:

    # mc "Wait... Those are... gunshots?"
    mc "Espera... ¿Esos son... disparos de armas?"

# game/Story03.rpy:2184

translate spanish akt3chapter2_1c2947fa:

    # a "Hear that?"
    a "¿Oíste eso?"

# game/Story03.rpy:2186

translate spanish akt3chapter2_ca7809f9:

    # mc "It’s them. The second half of the group."
    mc "Son ellos. La segunda mitad del grupo."

# game/Story03.rpy:2187

translate spanish akt3chapter2_5ef6f305:

    # mc "If they’re alive — we can still change something... and if they’re not — we’ll at least learn what killed them."
    mc "Si están vivos —todavía podemos cambiar algo... y si no lo están— al menos aprenderemos lo que los mató."

# game/Story03.rpy:2193

translate spanish akt3chapter2_7a529063:

    # g "We’re not making it out alive! Commander?!"
    g "¡No lo estamos haciendo vivo!"

# game/Story03.rpy:2194

translate spanish akt3chapter2_40862426:

    # gg "Hold the line! Valens is on reload!"
    gg "¡Valens está en recarga!"

# game/Story03.rpy:2195

translate spanish akt3chapter2_ecf90cfb:

    # g "Then tell him to reload faster!"
    g "¡Entonces dile que vuelva a cargar más rápido!"

# game/Story03.rpy:2196

translate spanish akt3chapter2_bcffdde7:

    # g "(They’re coming from every side... A little more, and we’re finished!)"
    g "(Vienen de todos los lados... un poco más, y estamos acabados!)"

# game/Story03.rpy:2199

translate spanish akt3chapter2_6d49edca:

    # g "Not today, freaks!"
    g "¡Hoy no, monstruos!"

# game/Story03.rpy:2202

translate spanish akt3chapter2_1604ed76:

    # gg "Valens, cover the rear!"
    gg "¡Valens, cubre la parte trasera!"

# game/Story03.rpy:2204

translate spanish akt3chapter2_7d0e4caf:

    # gggggg "Time to serve up some crispy fried chicken."
    gggggg "Es hora de servir un pollo frito crujiente."

# game/Story03.rpy:2205

translate spanish akt3chapter2_8ff14c4b:

    # gggggg "Well? Who wants to get golden-browned first?"
    gggggg "¿Quién quiere ser dorado primero?"

# game/Story03.rpy:2208

translate spanish akt3chapter2_abc7f2be:

    # gggggg "Burn, all of you, burn!"
    gggggg "¡Quemen, todos ustedes, quemen!"

# game/Story03.rpy:2210

translate spanish akt3chapter2_435be28e:

    # mc "Looks like they’re having plenty of fun without us."
    mc "Parece que se están divirtiendo sin nosotros."

# game/Story03.rpy:2214

translate spanish akt3chapter2_704bef9b:

    # a "No mistaking it. Plenty of fire — not much thought."
    a "No lo tomes mal. Un montón de fuego — no mucho pensamiento."

# game/Story03.rpy:2216

translate spanish akt3chapter2_6f0c607c:

    # mc "(Mowing them down ten at a time works too... but not for long. We need to get them out. Fast.)"
    mc "(Llevarlos diez a la vez funciona también... pero no por mucho tiempo. Necesitamos sacarlos."

# game/Story03.rpy:2218

translate spanish akt3chapter2_51df0af5:

    # mc "(The alarm... That might just do it.)"
    mc "(La alarma... eso podría hacerlo.)"

# game/Story03.rpy:2220

translate spanish akt3chapter2_0cbd8072:

    # mc "They hear sound well, right?"
    mc "Oyen bien, ¿verdad?"

# game/Story03.rpy:2222

translate spanish akt3chapter2_98251579:

    # mc "So what if we drown it out with something... more annoying?"
    mc "¿Y si lo ahogamos con algo... más molesto?"

# game/Story03.rpy:2226

translate spanish akt3chapter2_3b912f5c:

    # a "(Theoretically possible. In practice — unlikely.)"
    a "(Teóricamente posible. En la práctica - poco probable.)"

# game/Story03.rpy:2228

translate spanish akt3chapter2_06086bf1:

    # a "Won’t deafen them. But it might distract."
    a "No los deafendirá, pero podría distraer."

# game/Story03.rpy:2230

translate spanish akt3chapter2_719bc557:

    # mc "Distract is good enough. We just need time."
    mc "El Distraer es suficiente, solo necesitamos tiempo."

# game/Story03.rpy:2238

translate spanish akt3chapter2_49ebff48:

    # a "I’ll handle part of it. The rest — is on you."
    a "Yo me encargaré de parte de ella. El resto - está en usted."

# game/Story03.rpy:2239

translate spanish akt3chapter2_8b7318c3:

    # a "If you fail — they die."
    a "Si fallas, mueren."

# game/Story03.rpy:2241

translate spanish akt3chapter2_98c82d65:

    # mc "Getting used to heavy thoughts."
    mc "Acostumbrándose a pensamientos pesados."

# game/Story03.rpy:2244

translate spanish akt3chapter2_cde97aab:

    # a "I’ll buy time."
    a "Compraré tiempo."

# game/Story03.rpy:2246

translate spanish akt3chapter2_4b9fcff1:

    # a "Count on yourself."
    a "Cuente contigo mismo."

# game/Story03.rpy:2248

translate spanish akt3chapter2_ce96487d:

    # mc "(Quietly) Hang in there, guys…"
    mc "Aguanta, chicos..."

# game/Story03.rpy:2255

translate spanish akt3chapter2_cd853805:

    # mc "It’s on. Bought us a little time."
    mc "Está encendida. Nos trajiste un poco de tiempo."

# game/Story03.rpy:2257

translate spanish akt3chapter2_3cda44d4:

    # gg "(Reinforcements...? Could it be?)"
    gg "¿Podría ser?"

# game/Story03.rpy:2259

translate spanish akt3chapter2_500416a6:

    # mc "Move! Or die like heroes — forgotten and in pieces."
    mc "¡Muévanse! O mueren como héroes — olvidados y en pedazos."

# game/Story03.rpy:2261

translate spanish akt3chapter2_b8708955:

    # mc "We’re getting you out. If we’re lucky."
    mc "Te vamos a sacar. Si tenemos suerte."

# game/Story03.rpy:2263

translate spanish akt3chapter2_bd396cdd:

    # gg "Brayne, you heard him? Move, move it!"
    gg "Brayne, ¿lo escuchaste?"

# game/Story03.rpy:2265

translate spanish akt3chapter2_e0550001:

    # ggggg "Move that fat ass, ammo’s not infinite!"
    ggggg "Mueva ese culo gordo, la munición no es infinita!"

# game/Story03.rpy:2266

translate spanish akt3chapter2_f6bfc065:

    # gggg "Shut your damn mouth and do something useful!"
    gggg "¡Cierra la maldita boca y haz algo útil!"

# game/Story03.rpy:2268

translate spanish akt3chapter2_d810d136:

    # gg "Cut the chatter, both of you!"
    gg "¡Corten la charla, los dos!"

# game/Story03.rpy:2272

translate spanish akt3chapter2_7e362e01:

    # gggg "I... I can’t do it. It’s too damn high!"
    gggg "Yo... no puedo hacerlo. ¡Es demasiado alto!"

# game/Story03.rpy:2274

translate spanish akt3chapter2_cddc4e2f:

    # gg "You’d rather be breakfast for those things?! Wipe your nose and move!"
    gg "¿Prefieres ser el desayuno para esas cosas?! ¡Apaga la nariz y muévete!"

# game/Story03.rpy:2276

translate spanish akt3chapter2_0288aebc:

    # mc "Trust me."
    mc "Confía en mí."

# game/Story03.rpy:2278

translate spanish akt3chapter2_daa04ce6:

    # gggg "(Screw it. Here goes nothing.)"
    gggg "(Cógelo. Aquí no va nada.)"

# game/Story03.rpy:2285

translate spanish akt3chapter2_b3324d5a:

    # mc "Got you!"
    mc "¡Te tengo!"

# game/Story03.rpy:2287

translate spanish akt3chapter2_f2358430:

    # mc "Come on, almost there."
    mc "Vamos, casi allí."

# game/Story03.rpy:2288

translate spanish akt3chapter2_682e89fa:

    # mc "Next!"
    mc "¡Siguiente!"

# game/Story03.rpy:2290

translate spanish akt3chapter2_07688819:

    # gg "Boyk, you're up. Cover us from above."
    gg "Boyke, vamos, encuéntrenos."

# game/Story03.rpy:2292

translate spanish akt3chapter2_d9dc0358:

    # ggggg "Yessir, commander."
    ggggg "Sí, señor, comandante."

# game/Story03.rpy:2295

translate spanish akt3chapter2_24f62c2d:

    # gg "Valens, you're next."
    gg "Valens, eres el siguiente."

# game/Story03.rpy:2296

translate spanish akt3chapter2_7ddf4f10:

    # gggggg "I’ll go last. I’m no good up there."
    gggggg "Voy a durar. No soy bueno allí arriba."

# game/Story03.rpy:2298

translate spanish akt3chapter2_1284d641:

    # gg "Hold out, we’ll come back for you."
    gg "Espera, volveremos por ti."

# game/Story03.rpy:2299

translate spanish akt3chapter2_0bd5009d:

    # gggggg "Don’t worry. I won’t die that easy."
    gggggg "No te preocupes. No voy a morir tan fácil."

# game/Story03.rpy:2301

translate spanish akt3chapter2_419403d0:

    # gggggg "Come on, freaks — I’ve got enough fire for all of you."
    gggggg "Vamos, monstruos, tengo suficiente fuego para todos ustedes."

# game/Story03.rpy:2303

translate spanish akt3chapter2_e66d489a:

    # mc "You're the last one! Go!"
    mc "¡Eres el último!"

# game/Story03.rpy:2308

translate spanish akt3chapter2_1c24321d:

    # gg "VALENS!!"
    gg "¡Ventas!"

# game/Story03.rpy:2309

translate spanish akt3chapter2_7427dfcf:

    # mc "(That’s him... the Faceless. How did he get so close? I didn’t feel a thing.)"
    mc "(Es él... el sin rostro. ¿Cómo se acercaba tanto? No sentí nada.)"

# game/Story03.rpy:2311

translate spanish akt3chapter2_26e3edc3:

    # gg "How the hell..."
    gg "¿Cómo diablos...?"

# game/Story03.rpy:2313

translate spanish akt3chapter2_de7bb69d:

    # mc "Enough. We’re leaving. Or there’ll be more corpses."
    mc "Ya basta. Nos vamos o habrá más cadáveres."

# game/Story03.rpy:2317

translate spanish akt3chapter2_992588e6:

    # gg "Move out, everyone!"
    gg "¡Muévanse, todos!"

# game/Story03.rpy:2320

translate spanish akt3chapter2_c31e395e:

    # a "Took too long."
    a "Tardó demasiado."

# game/Story03.rpy:2322

translate spanish akt3chapter2_a7932198:

    # mc "Complain later. Run now."
    mc "Queja más tarde, corre ahora."

# game/Story03.rpy:2336

translate spanish akt3chapter2_d24a9262:

    # mc "Those the ones?"
    mc "¿Esos son los que?"

# game/Story03.rpy:2337

translate spanish akt3chapter2_90088bd9:

    # a "Syndicate. Pitiful sight."
    a "Sindicato, vista piadosa."

# game/Story03.rpy:2338

translate spanish akt3chapter2_7e55beb6:

    # a "So it’s rotting faster than I thought."
    a "Así que es pudriéndose más rápido de lo que pensaba."

# game/Story03.rpy:2340

translate spanish akt3chapter2_1aaaba6c:

    # mc "Aren’t you supposed to be enemies?"
    mc "¿No se supone que eres enemigo?"

# game/Story03.rpy:2343

translate spanish akt3chapter2_e3a82344:

    # a "Kalestra talks too much."
    a "Kalestra habla demasiado."

# game/Story03.rpy:2350

translate spanish akt3chapter2_fabef0c1:

    # a "Let’s go."
    a "Vamos."

# game/Story03.rpy:2353

translate spanish akt3chapter2_fd64c5d5:

    # mc "You seemed to be doing just fine."
    mc "Parecías estar bien."

# game/Story03.rpy:2355

translate spanish akt3chapter2_446e37bc:

    # g "We were. Didn’t need your fancy gear or pity."
    g "No necesitamos tu equipo de fantasía o piedad."

# game/Story03.rpy:2356

translate spanish akt3chapter2_d7a4ec40:

    # mc "Sure. Screaming ‘help’ is just part of the strategy, huh?"
    mc "Claro. Crecer la ayuda es parte de la estrategia, ¿eh?"

# game/Story03.rpy:2359

translate spanish akt3chapter2_878374e7:

    # gg "Drop the pride, Brayne. They saved us. Show some gratitude."
    gg "Deja el orgullo, Brayne, nos salvaron, muestra gratitud."

# game/Story03.rpy:2362

translate spanish akt3chapter2_6a7d98b3:

    # gg "Thanks for helping. And sorry for his manners."
    gg "Gracias por ayudar y lamentar sus modales."

# game/Story03.rpy:2364

translate spanish akt3chapter2_c5c4ec8f:

    # a "Is that all?"
    a "¿Eso es todo?"

# game/Story03.rpy:2367

translate spanish akt3chapter2_133e958c:

    # gg "No. We split from the main squad."
    gg "Nos separamos del equipo principal."

# game/Story03.rpy:2369

translate spanish akt3chapter2_765d6112:

    # mc "Main squad? Did you see a redhead — short — and a dark-haired woman with a scar?"
    mc "¿Viste a una pelirroja —cortada— y a una mujer morena con una cicatriz?"

# game/Story03.rpy:2372

translate spanish akt3chapter2_57ee6b52:

    # g "Hmph... Why would you care?"
    g "Hmph... ¿Por qué te importaría?"

# game/Story03.rpy:2374

translate spanish akt3chapter2_0d04f1a6:

    # gg "Enough with the tantrums."
    gg "Basta con los tantrums."

# game/Story03.rpy:2381

translate spanish akt3chapter2_3c125a1a:

    # g "Yeah, we saw them. Would’ve been dead without their help."
    g "Sí, los vimos. Habría estado muerto sin su ayuda."

# game/Story03.rpy:2383

translate spanish akt3chapter2_42ae0448:

    # a "Direction."
    a "Dirección."

# game/Story03.rpy:2387

translate spanish akt3chapter2_f5b027bc:

    # gg "To the fallback point."
    gg "Al punto de retroceso."

# game/Story03.rpy:2390

translate spanish akt3chapter2_2da34572:

    # gg "Forces split. Some stayed to defend the lower city..."
    gg "Algunos se quedaron para defender la ciudad baja..."

# game/Story03.rpy:2392

translate spanish akt3chapter2_2845b514:

    # mc "...and the rest went to the peacekeepers."
    mc "...y el resto fue a los pacificadores."

# game/Story03.rpy:2393

translate spanish akt3chapter2_55717329:

    # gg "Exactly."
    gg "Exactamente."

# game/Story03.rpy:2396

translate spanish akt3chapter2_b0e97012:

    # mc "(If I go after Lora and Olivia — the lower city might fall. With it, Miriel and the others...)"
    mc "(Si voy tras Lora y Olivia, la ciudad baja podría caer. Con ella, Miriel y los otros...)"

# game/Story03.rpy:2398

translate spanish akt3chapter2_9533a5fe:

    # mc "(If I go to the peacekeepers — I risk the entire planet...)"
    mc "(Si voy a los pacificadores, arriesgo todo el planeta...)"

# game/Story03.rpy:2399

translate spanish akt3chapter2_1e60223c:

    # mc "(That’s not a choice. That’s two death sentences.)"
    mc "(Eso no es una opción. Eso es dos sentencias de muerte.)"

# game/Story03.rpy:2412

translate spanish akt3chapter2_f29ede01:

    # n "And now, please forgive me. But this route will be available in the next hotfix. It’s just... too much content for now."
    n "Y ahora, por favor perdóname. Pero esta ruta estará disponible en el próximo hotfix. Es solo... demasiado contenido por ahora."

# game/Story03.rpy:2416

translate spanish akt3chapter2_241aba70:

    # mc "Alright. Then — let’s move."
    mc "Muy bien. Entonces, vamos a movernos."

# game/Story03.rpy:2423

translate spanish akt3chapter2_716986f4:

    # mc "Where did they go?"
    mc "¿Adónde fueron?"

# game/Story03.rpy:2425

translate spanish akt3chapter2_bc30750b:

    # gg "I’ll guide you."
    gg "Te guiaré."

# game/Story03.rpy:2427

translate spanish akt3chapter2_cbc7efb6:

    # a "And the rest?"
    a "¿Y el resto?"

# game/Story03.rpy:2429

translate spanish akt3chapter2_ee3ec44a:

    # g "None of your da—"
    g "No es tu..."

# game/Story03.rpy:2431

translate spanish akt3chapter2_50492e52:

    # gg "They’re going to defend the lower city."
    gg "Van a defender la ciudad baja."

# game/Story03.rpy:2434

translate spanish akt3chapter2_9ed15506:

    # g "(Whispers) Are you insane?! We’re telling them everything!"
    g "¡Les estamos diciendo todo!"

# game/Story03.rpy:2436

translate spanish akt3chapter2_13877b46:

    # gg "(Whispers) And you?"
    gg "¿Y tú?"

# game/Story03.rpy:2439

translate spanish akt3chapter2_dd0b3d66:

    # gg "(Whispers) Forgot what happens when the Inquisition starts asking questions?"
    gg "¿Olvidó lo que pasa cuando la Inquisición empieza a hacer preguntas?"

# game/Story03.rpy:2442

translate spanish akt3chapter2_e2a5a513:

    # gg "(Whispers) You haven’t seen them work. Trust me — keep your damn mouth shut."
    gg "No los has visto trabajar. Confía en mí, mantén la maldita boca cerrada."

# game/Story03.rpy:2447

translate spanish akt3chapter2_87fa76de:

    # mc "(They hate them. Still fall in line. Fear — sharper than pride.)"
    mc "(Los odian. Todavía caen en la línea. El miedo — más fuerte que el orgullo.)"

# game/Story03.rpy:2451

translate spanish akt3chapter2_2c2995d0:

    # mc "(The old game. Threats in one hand — promises in the other.)"
    mc "(El viejo juego. Amenazas en una mano - promesas en la otra.)"

# game/Story03.rpy:2454

translate spanish akt3chapter2_419d5750:

    # a "What?"
    a "¿Qué?"

# game/Story03.rpy:2456

translate spanish akt3chapter2_647eae23:

    # mc "Didn’t think they’d agree. Last I checked, you were at each other’s throats."
    mc "No pensaba que estarían de acuerdo. Lo último que comprobé, estaban en la garganta del otro."

# game/Story03.rpy:2462

translate spanish akt3chapter2_882a948d:

    # a "Yesterday — yes. Today — they trail behind us."
    a "Ayer — sí. Hoy — siguen detrás de nosotros."

# game/Story03.rpy:2464

translate spanish akt3chapter2_65566871:

    # mc "Change of heart?"
    mc "¿Cambio de corazón?"

# game/Story03.rpy:2466

translate spanish akt3chapter2_586447b2:

    # a "No. Cold math."
    a "No, matemáticas frías."

# game/Story03.rpy:2475

translate spanish akt3chapter2_1a0f8fb7:

    # mc "(Whatever that means — doesn’t sound good.)"
    mc "(Lo que sea que signifique – no suena bien.)"

# game/Story03.rpy:2478

translate spanish akt3chapter2_64030585:

    # a "No time left."
    a "No queda tiempo."

# game/Story03.rpy:2480

translate spanish akt3chapter2_075a49aa:

    # gg "We’ll hold the line."
    gg "Mantendremos la línea."

# game/Story03.rpy:2482

translate spanish akt3chapter2_fdd4f775:

    # a "Until the first shot comes from your side."
    a "Hasta que el primer disparo venga de tu lado."

# game/Story03.rpy:2483

translate spanish akt3chapter2_fabef0c1_1:

    # a "Let’s go."
    a "Vamos."

# game/Story03.rpy:2485

translate spanish akt3chapter2_7a52a076:

    # gg "Yes, ma’am."
    gg "Sí, señora."

# game/Story03.rpy:2495

translate spanish akt3chapter2_d795864b:

    # gg "Stick together. Devices ready. If the Faceless shows up — shoot on sight."
    gg "Mantengase unidos. Dispositivos listos. Si el sin rostro aparece — dispara a la vista."

# game/Story03.rpy:2500

translate spanish akt3chapter2_45ee2071:

    # mc "(Head's splitting... Like a tank rolled right over it.)"
    mc "(La cabeza se divide como si un tanque hubiera pasado por encima de él.)"

# game/Story03.rpy:2501

translate spanish akt3chapter2_e687ec6a:

    # mc "(And silence. Total. No voices. No traces. No explanations. Just — nothing.)"
    mc "(Y silencio. Total. Sin voces. Sin rastros. Sin explicaciones. Solo — nada.)"

# game/Story03.rpy:2504

translate spanish akt3chapter2_1eb67712:

    # mc "(Like everything was just supposed to click into place on its own.)"
    mc "(Como todo se suponía que debía hacer clic en su propio lugar.)"

# game/Story03.rpy:2505

translate spanish akt3chapter2_c228f6c4:

    # mc "(And me? I was supposed to just get it. Of course. Naturally.)"
    mc "(Y yo? Se suponía que solo lo conseguiría. Por supuesto."

# game/Story03.rpy:2508

translate spanish akt3chapter2_84b7a515:

    # mc "No way..."
    mc "De ninguna manera..."

# game/Story03.rpy:2513

translate spanish akt3chapter2_19830262:

    # mc "Perfect. Just fucking perfect."
    mc "Perfecto, perfecto."

# game/Story03.rpy:2515

translate spanish akt3chapter2_0a04edb5:

    # a "Something happened?"
    a "¿Pasó algo?"

# game/Story03.rpy:2518

translate spanish akt3chapter2_1dc40720:

    # mc "Oh, something happened, all right. A whole parade of little miracles. Like — dozens of voicemails."
    mc "Algo pasó, de acuerdo, un desfile de pequeños milagros, como docenas de buzones."

# game/Story03.rpy:2519

translate spanish akt3chapter2_6aa07636:

    # mc "And the best part? I didn’t even know I had voicemail."
    mc "¿Y la mejor parte? Ni siquiera sabía que tenía un correo de voz."

# game/Story03.rpy:2521

translate spanish akt3chapter2_187d667a:

    # mc "You know when I signed up for that kind of fun?"
    mc "¿Sabes cuando me inscribí para ese tipo de diversión?"

# game/Story03.rpy:2524ё

translate spanish akt3chapter2_1f88073f:

    # gg "First time using implants?"
    gg "¿Primera vez usando implantes?"

# game/Story03.rpy:2526

translate spanish akt3chapter2_c7efe583:

    # mc "Yeah. Guess I’m radiating rookie vibes, huh?"
    mc "Supongo que estoy radiando vibraciones de novatos, ¿eh?"

# game/Story03.rpy:2528

translate spanish akt3chapter2_210c06eb_1:

    # a "Yes."
    a "Sí."

# game/Story03.rpy:2531

translate spanish akt3chapter2_fa47ef4c:

    # mc "Appreciate the honesty."
    mc "Aprecio la honestidad."

# game/Story03.rpy:2533

translate spanish akt3chapter2_76d0e924:

    # gg "You don’t see many first-timers with implants. Especially in your division."
    gg "No se ve muchos primeros impulsores con implantes. Especialmente en su división."

# game/Story03.rpy:2535

translate spanish akt3chapter2_05fd8ed9:

    # mc "Category: 'fell out of the sky and somehow still breathing'?"
    mc "Categoría: \"Falled from the sky and some still breathing\"?"

# game/Story03.rpy:2536

translate spanish akt3chapter2_fbd5ae70:

    # mc "Seriously. How do you deal with this?"
    mc "En serio. ¿Cómo se enfrenta a esto?"

# game/Story03.rpy:2537

translate spanish akt3chapter2_dd2888d3:

    # gg "Experience. Takes a couple years, usually."
    gg "Experiencia. Lleva un par de años, generalmente."

# game/Story03.rpy:2538

translate spanish akt3chapter2_619fe112:

    # mc "A couple of years, huh? Charming. And what if I don’t have years to spare?"
    mc "Un par de años, ¿eh? Encantador. ¿Y qué pasa si no tengo años para ahorrar?"

# game/Story03.rpy:2540

translate spanish akt3chapter2_098dd180:

    # gg "Implants are your best shot. Sure, they’re hell at first. But later... they become part of you. You won’t even notice."
    gg "Las implantes son tu mejor oportunidad. Claro, son el infierno al principio. Pero más tarde... se convierten en parte de ti. Ni siquiera te darás cuenta."

# game/Story03.rpy:2542

translate spanish akt3chapter2_ec345a2f:

    # mc "(Breathe, [mc]. Don’t bolt.)"
    mc "(Breathe, [mc]. No se atornilla.)"

# game/Story03.rpy:2543

translate spanish akt3chapter2_2be52401:

    # mc "(Step by step: first — figure out where you are. Then — who you are. Right now — stay alive.)"
    mc "(Paso a paso: primero — averiguar dónde estás. Entonces — quién eres. Ahora mismo— mantente vivo.)"

# game/Story03.rpy:2545

translate spanish akt3chapter2_96af3308:

    # "Notification from Lora."
    "Notificación de Lora."

# game/Story03.rpy:2547

translate spanish akt3chapter2_a3da06cd:

    # L "Thank you... for last night. I didn’t expect, after everything... for something inside to finally go quiet."
    L "Gracias... por anoche. No esperaba, después de todo... que algo dentro se callara."

# game/Story03.rpy:2549

translate spanish akt3chapter2_868ada83:

    # L "You became something like... a quiet place. Just for a few hours."
    L "Te convertiste en algo como... un lugar tranquilo."

# game/Story03.rpy:2550

translate spanish akt3chapter2_8da59526:

    # L "I saw you sleeping. Didn’t want to wake you. You earned it."
    L "Te vi durmiendo. No quería despertarte. Te lo ganaste."

# game/Story03.rpy:2552

translate spanish akt3chapter2_c0a29178:

    # mc "(Lora. There's still something left in you of the one I knew...)"
    mc "(Laura. Todavía tienes algo de lo que yo sabía.)"

# game/Story03.rpy:2553

translate spanish akt3chapter2_2959e860:

    # mc "(Warmth even in the ashes. Still caring, even after everything's been burned.)"
    mc "(Abraza incluso en las cenizas. Todavía te preocupas, incluso después de que todo se quema.)"

# game/Story03.rpy:2554

translate spanish akt3chapter2_6d6be2ca:

    # mc "(God, I missed that voice.)"
    mc "(Dios, me perdí esa voz.)"

# game/Story03.rpy:2555

translate spanish akt3chapter2_9fdcd41a:

    # L "I’m waiting at the command post. Left corridor, second door."
    L "Estoy esperando en el puesto de mando. Corredor izquierdo, segunda puerta."

# game/Story03.rpy:2559

translate spanish akt3chapter2_49064845:

    # "Notification from Lora, a few hours later."
    "Notificación de Lora, unas horas más tarde."

# game/Story03.rpy:2561

translate spanish akt3chapter2_ac95a26a:

    # L "[mc], someone sold us out. It all went to hell."
    L "[mc]Alguien nos vendió, todo fue al infierno."

# game/Story03.rpy:2562

translate spanish akt3chapter2_45814f48:

    # L "We tried to reach you. I swear. But we barely had anything left..."
    L "Intentamos contactarte, lo juro, pero apenas nos quedamos nada..."

# game/Story03.rpy:2564

translate spanish akt3chapter2_49064845_1:

    # "Notification from Lora, a few hours later."
    "Notificación de Lora, unas horas más tarde."

# game/Story03.rpy:2565

translate spanish akt3chapter2_897d24fe:

    # "5 missed calls."
    "5 llamadas perdidas."

# game/Story03.rpy:2567

translate spanish akt3chapter2_994078b8:

    # L "Pick up. Please. I can’t just sit here. Not knowing..."
    L "Recoge. Por favor. No puedo simplemente sentarme aquí. No saber..."

# game/Story03.rpy:2569

translate spanish akt3chapter2_8323d9c2:

    # "16 missed calls."
    "16 llamadas perdidas."

# game/Story03.rpy:2570

translate spanish akt3chapter2_4938d32b:

    # "Notification from Lora, a few minutes ago."
    "Notificación de Lora, hace unos minutos."

# game/Story03.rpy:2572

translate spanish akt3chapter2_5947287e:

    # L "They’re evacuating us to Sector Three. Me and Olivia."
    L "Nos están evacuando al Sector Tres. Yo y Olivia."

# game/Story03.rpy:2573

translate spanish akt3chapter2_d42872ab:

    # L "If you’re reading this — it means you’re alive. Which means: hold on. No heroics. Just... survive."
    L "Si estás leyendo esto, significa que estás vivo. Lo que significa: espera. No hay heroicos. Solo... sobreviva."

# game/Story03.rpy:2574

translate spanish akt3chapter2_40b466f2:

    # L "I’ll come back. I swear."
    L "Volveré. Lo juro."

# game/Story03.rpy:2576

translate spanish akt3chapter2_c671798f:

    # mc "(You’ll come back. You have to…)"
    mc "(Volverás. Tienes que...)"

# game/Story03.rpy:2577

translate spanish akt3chapter2_0ff01de9:

    # mc "(I just have to live long enough for that {b}have to{/b} to mean something.)"
    mc "(Solo tengo que vivir lo suficiente para eso {b}que debe tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que tener que{/b} para significar algo.)"

# game/Story03.rpy:2583

translate spanish akt3chapter2_d5251480:

    # mc "(Of course. Alone again. Almost tradition by now.)"
    mc "(Por supuesto. Solo de nuevo. Casi tradición para ahora.)"

# game/Story03.rpy:2584

translate spanish akt3chapter2_8bf24a25:

    # mc "(Might as well start a scrapbook—‘Abandoned During Crises: A Memoir’.)"
    mc "(También comienza un libro de recortes, ‘Abandonado durante las crisis: un recuerdo’)."

# game/Story03.rpy:2587

translate spanish akt3chapter2_19730d69:

    # mc "(But this isn’t the first time. [mc], pull it together. They’re alive. That’s what matters.)"
    mc "(Pero esta no es la primera vez. [mc], tirarlo juntos. Están vivos. Eso es lo que importa.)"

# game/Story03.rpy:2588

translate spanish akt3chapter2_c1727d53:

    # mc "(No time to fall apart. Time to move.)"
    mc "(No hay tiempo para desmoronarse."

# game/Story03.rpy:2592

translate spanish akt3chapter2_e05172b5:

    # mc "Lora and the others are headed to Sector Three. Looks like a regroup."
    mc "Lora y los otros se dirigen al sector tres."

# game/Story03.rpy:2595

translate spanish akt3chapter2_67eca88f:

    # gg "Sector Three?.. Are you sure?"
    gg "Sector Tres... ¿Estás seguro?"

# game/Story03.rpy:2597

translate spanish akt3chapter2_d07e9066:

    # mc "Not really in the mood for second guesses."
    mc "No está de humor para las segundas conjeturas."

# game/Story03.rpy:2598

translate spanish akt3chapter2_f40f67a5:

    # gg "You won’t make it there without air transport."
    gg "No llegarás sin transporte aéreo."

# game/Story03.rpy:2600

translate spanish akt3chapter2_416f7614:

    # mc "(Air... transport?)"
    mc "(Air... transporte?)"

# game/Story03.rpy:2610

translate spanish akt3chapter2_e37e8fa9:

    # mc "And that’s... the only way?"
    mc "¿Y esa es la única manera?"

# game/Story03.rpy:2612

translate spanish akt3chapter2_91a707ee:

    # gg "Not the only one. Just the fastest."
    gg "No es el único, el más rápido."

# game/Story03.rpy:2619

translate spanish akt3chapter2_860926de:

    # mc "So we’re hunting for a flying tin can with blades. {b}Underground{/b}. Sounds almost reasonable."
    mc "Así que estamos cazando para una lata voladora con cuchillas. {b}Subterráneo{/b}Suena casi razonable."

# game/Story03.rpy:2620

translate spanish akt3chapter2_14ba79d8:

    # mc "Any idea where they nest?"
    mc "¿Alguna idea de dónde anidan?"

# game/Story03.rpy:2624

translate spanish akt3chapter2_de11a1cb:

    # gg "There’s an old hangar not far from here. With luck — something’s still inside."
    gg "Hay un viejo hangar no muy lejos de aquí. Con suerte — algo todavía está dentro."

# game/Story03.rpy:2637

translate spanish akt3chapter2_75463d0e:

    # mc "Right. You know the way?"
    mc "Bien. ¿Sabes el camino?"

# game/Story03.rpy:2639

translate spanish akt3chapter2_d69da573:

    # gg "I do. But it won’t be easy."
    gg "Lo hago, pero no será fácil."

# game/Story03.rpy:2641

translate spanish akt3chapter2_6721b823:

    # gg "You’ll stay in the rear. We’ll take point."
    gg "Usted se quedará en la parte trasera. Tomaremos punto."

# game/Story03.rpy:2649

translate spanish akt3chapter2_4ba52ba6:

    # gg "Now, let’s mo—"
    gg "Ahora, vamos a..."

# game/Story03.rpy:2665

translate spanish akt3chapter2_6fb165f8:

    # k "Hmm..."
    k "Hmm..."

# game/Story03.rpy:2667

translate spanish akt3chapter2_61a92015:

    # k "Hmm... Bullets. How touching. Haven’t seen that kind of 'affection' in ages."
    k "Balas, qué tacto, no he visto una caricia como esta en años."

# game/Story03.rpy:2668

translate spanish akt3chapter2_f7aeb100:

    # k "Well? What’s the excuse this time, sister? Or is pulling the trigger still easier than using your voice?"
    k "¿Cuál es la excusa esta vez, hermana? ¿O está apretando el gatillo aún más fácil que usar su voz?"

# game/Story03.rpy:2670

translate spanish akt3chapter2_3ecdd609:

    # a "Tch."
    a "Tch."

# game/Story03.rpy:2672

translate spanish akt3chapter2_bff25426:

    # k "Still... familiar faces are always a treat. Even the crooked ones."
    k "Aún así... las caras familiares siempre son un regalo, incluso las torcidas."

# game/Story03.rpy:2674

translate spanish akt3chapter2_42ba5ce1:

    # mc "Of course. Trouble shows up, and there you are. With fanfare, obviously."
    mc "Por supuesto, el problema aparece, y ahí estás, con fanfarrón, obviamente."

# game/Story03.rpy:2676

translate spanish akt3chapter2_210c06eb_2:

    # a "Yes."
    a "Sí."

# game/Story03.rpy:2679

translate spanish akt3chapter2_8e987af1:

    # k "Keep talking like that, and I’ll start thinking you actually missed me."
    k "Sigue hablando así, y empezaré a pensar que me extrañaste."

# game/Story03.rpy:2680

translate spanish akt3chapter2_5ac82a9f:

    # k "Wipe that look off your face. I didn’t bleed through hell to be greeted with your theatrics."
    k "Anillo que mira fuera de tu cara. No sangré por el infierno para ser recibido con tu teatro."

# game/Story03.rpy:2682

translate spanish akt3chapter2_57f3fbab:

    # mc "You’re supposed to be with Lora and Olivia. What are you doing here?"
    mc "Se supone que estás con Lora y Olivia. ¿Qué haces aquí?"

# game/Story03.rpy:2685

translate spanish akt3chapter2_00b8258e:

    # k "Maybe you’ll finally learn to listen. Or is that still too much for you to handle?"
    k "Tal vez finalmente aprenderás a escuchar. ¿O es que todavía es demasiado para que te encargues?"

# game/Story03.rpy:2686

translate spanish akt3chapter2_f8144d16:

    # g "(Whispering) Is that... Her?"
    g "¿Es... ella?"

# game/Story03.rpy:2687

translate spanish akt3chapter2_3711cd40:

    # gg "You’re..."
    gg "Estás..."

# game/Story03.rpy:2690

translate spanish akt3chapter2_63df0046:

    # k "Spare me. The names, the threats, the gasps — I’ve heard them all a hundred times. Be original for once."
    k "Esquíeme. Los nombres, las amenazas, los gases — los he oído todas cien veces. Sé original por una vez."

# game/Story03.rpy:2692

translate spanish akt3chapter2_4f3fbff3:

    # mc "You still haven’t answered. Why are you here?"
    mc "Aún no has respondido. ¿Por qué estás aquí?"

# game/Story03.rpy:2695

translate spanish akt3chapter2_feb629ba:

    # k "You. The princess. And sweet little Lora. One loud, desperate cry for help."
    k "La princesa, y el dulce Lora, un grito de ayuda."

# game/Story03.rpy:2696

translate spanish akt3chapter2_d8291caa:

    # k "So I came. Did you miss me?"
    k "Así que vine. ¿Me extrañaste?"

# game/Story03.rpy:2700

translate spanish akt3chapter2_cc594085:

    # mc "I’m moved. Deeply."
    mc "Estoy emocionado."

# game/Story03.rpy:2701

translate spanish akt3chapter2_ed5d4173:

    # mc "Wait... You’re getting us out of here?"
    mc "Espera... ¿Nos estás sacando de aquí?"

# game/Story03.rpy:2703

translate spanish akt3chapter2_3d85dd7b:

    # k "You want to stay? Adorable. But yes — I’ll get you out. Though I won’t lie, leaving you here is… tempting."
    k "¿Quieres quedarte? Adorable. Pero sí — te sacaré. Aunque no mentiré, dejarte aquí es... tentador."

# game/Story03.rpy:2705

translate spanish akt3chapter2_0054e596:

    # mc "You’re serious?"
    mc "¿Hablas en serio?"

# game/Story03.rpy:2707

translate spanish akt3chapter2_1a30af6d:

    # k "Completely. But don’t flatter yourself — I just don’t leave things unfinished."
    k "Completamente. Pero no te aplanes — simplemente no dejo las cosas sin terminar."

# game/Story03.rpy:2713

translate spanish akt3chapter2_197caaf5:

    # k "Just don’t stare at me like I’m a monster. Or go ahead — doesn’t matter to me."
    k "Simplemente no me mires como si fuera un monstruo. O seguir adelante — no me importa."

# game/Story03.rpy:2717

translate spanish akt3chapter2_955fba72:

    # gg "Now’s not the time for old grudges."
    gg "Ahora no es el momento de los viejos rencores."

# game/Story03.rpy:2719

translate spanish akt3chapter2_95c7633a:

    # mc "Are you okay?"
    mc "¿Estás bien?"

# game/Story03.rpy:2721

translate spanish akt3chapter2_0fbef901:

    # k "I’m always fine. It’s when others forget that things start falling apart."
    k "Siempre estoy bien. Es cuando otros olvidan que las cosas comienzan a desmoronarse."

# game/Story03.rpy:2722

translate spanish akt3chapter2_9aa282ea:

    # k "Move. I’m not here for your soul-searching."
    k "Muévete. No estoy aquí para tu búsqueda de alma."

# game/Story03.rpy:2726

translate spanish akt3chapter2_56763e0f:

    # ggg "(whispering) You can’t be serious… She killed our people."
    ggg "No puedes ser serio... mató a nuestra gente."

# game/Story03.rpy:2727

translate spanish akt3chapter2_d7f1c947:

    # gg "(whispering) And you want to stay here? Die here?"
    gg "¿Y quieres quedarte aquí?"

# game/Story03.rpy:2728

translate spanish akt3chapter2_f2cd03b0:

    # gg "(whispering) We don’t choose allies. We choose survival."
    gg "(susurando) No elegimos aliados. Elegimos la supervivencia."

# game/Story03.rpy:2730

translate spanish akt3chapter2_b9978003:

    # gg "She’s not just an executioner. She’s the nightmare our nightmares fear."
    gg "No es solo una verdugo. Es la pesadilla que temen nuestras pesadillas."

# game/Story03.rpy:2732

translate spanish akt3chapter2_5e011817:

    # gg "I’m responsible for you. And if I have to walk with Astoria’s dogs to get you out — I will."
    gg "Soy responsable de ti. Y si tengo que caminar con los perros de Astoria para sacarte de aquí, lo haré."

# game/Story03.rpy:2752

translate spanish akt3chapter3_366faaab:

    # mc "(God... It’s like a hurricane tore through here. With swords. And guts.)"
    mc "(Dios... es como un huracán que se desgarró por aquí. Con espadas. Y agallas.)"

# game/Story03.rpy:2753

translate spanish akt3chapter3_f2be55a0:

    # k "(You noticed. I put my soul into it.)"
    k "(Lo notaste. Puse mi alma en ella.)"

# game/Story03.rpy:2755

translate spanish akt3chapter3_15918131:

    # mc "This nightmare... You did all this?"
    mc "Esta pesadilla... ¿Hiciste todo esto?"

# game/Story03.rpy:2758

translate spanish akt3chapter3_44640dd4:

    # k "They chose death. I just made sure it was... artfully done."
    k "Eligieron la muerte, me aseguré de que se hiciera... con arte."

# game/Story03.rpy:2761

translate spanish akt3chapter3_109cf605:

    # mc "Power trip, right?"
    mc "Viaje de energía, ¿verdad?"

# game/Story03.rpy:2764

translate spanish akt3chapter3_7bf35f3f:

    # k "No. Boredom. And only two cures for that—art or death. Sometimes, the line blurs."
    k "No. Boredom. Y solo dos curas para eso —arte o muerte. A veces, la línea se desdibuja."

# game/Story03.rpy:2767

translate spanish akt3chapter3_73f99694:

    # mc "Do you always cause this much carnage when you're bored?"
    mc "¿Siempre haces ese tipo de masacre cuando estás aburrido?"

# game/Story03.rpy:2769

translate spanish akt3chapter3_981c86f8:

    # k "Not always. Sometimes I slice fabric. Other times, throats. Depends on the mood."
    k "A veces rebano telas, otras veces gargantas, depende del estado de ánimo."

# game/Story03.rpy:2771

translate spanish akt3chapter3_c6d30ed0:

    # mc "Why didn’t you go with Lora and Olivia?"
    mc "¿Por qué no fuiste con Lora y Olivia?"

# game/Story03.rpy:2774

translate spanish akt3chapter3_caa476b6:

    # k "I wasn’t in the mood for whining. Even theirs."
    k "No estaba de humor para quejarme, ni siquiera la suya."

# game/Story03.rpy:2777

translate spanish akt3chapter3_36d1bfd9:

    # mc "Stop pretending."
    mc "Deja de fingir."

# game/Story03.rpy:2781

translate spanish akt3chapter3_0b014af2:

    # a "Perceptive."
    a "Perceptivo."

# game/Story03.rpy:2789

translate spanish akt3chapter3_0b556877:

    # k "...Fine. I was bored and wanted some fun."
    k "Estaba aburrido y quería divertirme."

# game/Story03.rpy:2791

translate spanish akt3chapter3_ebfb01ab:

    # k "And you looked... fragile enough."
    k "Y parecías... lo suficientemente frágil."

# game/Story03.rpy:2795

translate spanish akt3chapter3_b6af152b:

    # k "Perfect warm-up material."
    k "Material de calentamiento perfecto."

# game/Story03.rpy:2797

translate spanish akt3chapter3_09a5d2d9:

    # mc "(And again, everyone’s saving me... Am I really that helpless?!)"
    mc "(Y de nuevo, todos me están salvando... ¿Soy realmente tan indefenso?)"

# game/Story03.rpy:2798

translate spanish akt3chapter3_cf953a06:

    # mc "(Pull yourself together. When did you turn into this? Where’s your fire?)"
    mc "(Llévate. ¿Cuándo te convertiste en esto? ¿Dónde está tu fuego?)"

# game/Story03.rpy:2801

translate spanish akt3chapter3_954c13c3:

    # mc "(You’ve already lost your son. And if you keep sitting on your hands…)"
    mc "(Ya has perdido a tu hijo. Y si sigues sentado en tus manos...)"

# game/Story03.rpy:2802

translate spanish akt3chapter3_5dc95fe6:

    # mc "(You don’t get to stand by. Not again. Not after everything.)"
    mc "(No puedes estar de pie. No otra vez. No después de todo.)"

# game/Story03.rpy:2804

translate spanish akt3chapter3_98dc88c6:

    # k "(Oh, stop pitying yourself...)"
    k "(Oh, deja de compadecerte...)"

# game/Story03.rpy:2809

translate spanish akt3chapter3_9be052d1:

    # k "—Ouch!"
    k "- ¡Ay!"

# game/Story03.rpy:2811

translate spanish akt3chapter3_56483e15:

    # a "(Whispering) Try silence more often. You might actually see."
    a "Prueba el silencio más a menudo."

# game/Story03.rpy:2814

translate spanish akt3chapter3_64e83ecb:

    # a "(Whispering) And next time—stay out of what isn’t yours."
    a "(Susurrando) Y la próxima vez—sténganse fuera de lo que no es suyo."

# game/Story03.rpy:2816

translate spanish akt3chapter3_afeec0a4:

    # a "(Whispering) Last warning."
    a "Última advertencia."

# game/Story03.rpy:2818

translate spanish akt3chapter3_99b254fb:

    # k "Killjoy."
    k "Killjoy."

# game/Story03.rpy:2823

translate spanish akt3chapter3_e9dbe232:

    # mc "She’s acting like a child..."
    mc "Está actuando como una niña..."

# game/Story03.rpy:2828

translate spanish akt3chapter3_2a982dca:

    # a "Defense mechanism. Or habit."
    a "Mecanismo de defensa o hábito."

# game/Story03.rpy:2830

translate spanish akt3chapter3_a72e2fb8:

    # mc "I get the feeling you two are... pretty close."
    mc "Tengo la sensación de que ustedes dos están... bastante cerca."

# game/Story03.rpy:2833

translate spanish akt3chapter3_f9333cd5:

    # a "We are weapons. Forged sisters clash — sparks are expected."
    a "Somos armas. Las hermanas forjadas chocan, se espera chispas."

# game/Story03.rpy:2835

translate spanish akt3chapter3_1556dcfd:

    # k "You should see how she looks at me when I take the last coffee..."
    k "Deberías ver cómo me mira cuando tomo el último café..."

# game/Story03.rpy:2837

translate spanish akt3chapter3_63baaa49:

    # a "She does it on purpose."
    a "Lo hace a propósito."

# game/Story03.rpy:2839

translate spanish akt3chapter3_a1e094b0:

    # k "Of course. {w}Little wars make strong bonds."
    k "Por supuesto. {w}Las pequeñas guerras hacen fuertes lazos."

# game/Story03.rpy:2840

translate spanish akt3chapter3_c9f06c4c:

    # k "We’re like any sisters: we love, we fight, we drive each other insane..."
    k "Somos como cualquier hermana: amamos, luchamos, nos llevamos locos..."

# game/Story03.rpy:2841

translate spanish akt3chapter3_b7d16e40:

    # k "But when the time comes — we’ll fall together. No doubts. Right?"
    k "Pero cuando llegue el momento, caeremos juntos. Sin duda. ¿Verdad?"

# game/Story03.rpy:2848

translate spanish akt3chapter3_fba49164:

    # a "Without hesitation."
    a "Sin dudarlo."

# game/Story03.rpy:2849

translate spanish akt3chapter3_8ac5cee3:

    # a "Loyalty. And the will to die, if needed."
    a "La lealtad y la voluntad de morir, si es necesario."

# game/Story03.rpy:2851

translate spanish akt3chapter3_64c9ed20:

    # mc "(I thought th—)"
    mc "(Pensé que...)"

# game/Story03.rpy:2853

translate spanish akt3chapter3_e341ba96:

    # k "After our Lady’s orders, of course."
    k "Después de las órdenes de nuestra Señora, por supuesto."

# game/Story03.rpy:2857

translate spanish akt3chapter3_6896212c:

    # a "You made the right choice. It will be remembered."
    a "Tú tomaste la decisión correcta, será recordado."

# game/Story03.rpy:2860

translate spanish akt3chapter3_530bb51a:

    # mc "(What the hell was that?)"
    mc "¿Qué demonios fue eso?"

# game/Story03.rpy:2862

translate spanish akt3chapter3_1b6a4552:

    # k "(Whispering) That was her version of ‘thank you’. Adorable, right?"
    k "(Susurrando) Esa era su versión de \"gracias\". Adorable, ¿verdad?"

# game/Story03.rpy:2869

translate spanish akt3chapter3_ada47138:

    # mc "He was getting on my nerves."
    mc "Me estaba poniendo nervioso."

# game/Story03.rpy:2871

translate spanish akt3chapter3_dfba945c:

    # k "Thanks..."
    k "Gracias..."

# game/Story03.rpy:2875

translate spanish akt3chapter3_e4ad04c2:

    # k "(Pull it together. We have company...)"
    k "Tenemos compañía..."

# game/Story03.rpy:2881

translate spanish akt3chapter3_c99b5fce:

    # a "Cover the rear. We move ahead."
    a "Cubrimos la parte trasera."

# game/Story03.rpy:2883

translate spanish akt3chapter3_69bf3109:

    # gg "Understood."
    gg "Entendido."

# game/Story03.rpy:2886

translate spanish akt3chapter3_68a2e804:

    # gg "They took our people — let them pay in full."
    gg "Se llevaron a nuestra gente — que paguen por completo."

# game/Story03.rpy:2889

translate spanish akt3chapter3_ff2a0f71:

    # k "So, a little pain in the name of Astoria?"
    k "¿Entonces, un poco de dolor en el nombre de Astoria?"

# game/Story03.rpy:2897

translate spanish akt3chapter3_91484e5e:

    # mc "Let them come. I’ve got something for each of them."
    mc "Deja que vengan. Tengo algo para cada uno de ellos."

# game/Story03.rpy:2899

translate spanish akt3chapter3_c4cda81e:

    # mc "(You’ve already lost your son… and you’re not losing anyone else. You hear that, monsters?)"
    mc "(Ya has perdido a tu hijo... y no estás perdiendo a nadie más. ¿Escuchas eso, monstruos?)"

# game/Story03.rpy:2900

translate spanish akt3chapter3_b77c36be:

    # mc "(Yeah. Time to take control.)"
    mc "(Sí, es hora de tomar el control.)"

# game/Story03.rpy:2906

translate spanish akt3chapter3_589dd92b:

    # mc "More! I’ve got enough fury for every last one of you!"
    mc "¡Más! ¡Tengo suficiente furia por cada uno de ustedes!"

# game/Story03.rpy:2910

translate spanish akt3chapter3_4cd4a0e2:

    # k "Now that’s a voice. Finally, someone here who doesn’t flinch at the scent of blood."
    k "Ahora es una voz. Finalmente, alguien aquí que no se desploma en el olor de la sangre."

# game/Story03.rpy:2911

translate spanish akt3chapter3_ef62d9ec:

    # k "Stick close, hero. Die later — I hate being bored."
    k "Quédate cerca, héroe. Muere más tarde — Odio estar aburrido."

# game/Story03.rpy:2925

translate spanish akt3chapter3_1bad2bb5:

    # mc "Don’t bother thanking me."
    mc "No te molestes en darme las gracias."

# game/Story03.rpy:2927

translate spanish akt3chapter3_48973881:

    # k "Wasn’t planning to. But if you need it that badly — you looked almost worthy. Briefly."
    k "No estaba planeando hacerlo. Pero si lo necesitas tan mal — parecías casi digno. Brevemente."

# game/Story03.rpy:2930

translate spanish akt3chapter3_dddb1efb:

    # mc "That’s the last one. He’s down."
    mc "Ese es el último. Está abajo."

# game/Story03.rpy:2940

translate spanish akt3chapter3_28033310:

    # a "Enough. Move out."
    a "¡Basta!"

# game/Story03.rpy:2947

translate spanish akt3chapter3_7e10cdd5:

    # gg "Copy."
    gg "Copiado."

# game/Story03.rpy:2949

translate spanish akt3chapter3_2d1f62d3:

    # gg "Stick together!"
    gg "¡Manténganse juntos!"

# game/Story03.rpy:2952

translate spanish akt3chapter3_489ee94a:

    # gg "Move! Like we trained — no wasted steps!"
    gg "¡Muévanse! ¡Como entrenamos, sin desperdiciar pasos!"

# game/Story03.rpy:2953

translate spanish akt3chapter3_e62fc0b6:

    # gg "The rest — toward the corridor. Hustle, or I’ll finish you off myself!"
    gg "El resto — hacia el pasillo. ¡Asúmbrate, o te terminaré yo mismo!"

# game/Story03.rpy:2966

translate spanish akt3chapter3_c1670847:

    # mc "...Holy shit."
    mc "Mierda."

# game/Story03.rpy:2967

translate spanish akt3chapter3_b1a54921:

    # k "Just like my bedroom. Minus the shackles, and a bit cleaner."
    k "Como mi habitación, menos las grilletes y un poco más limpio."

# game/Story03.rpy:2968

translate spanish akt3chapter3_e61fba61:

    # a "Not cleaner."
    a "No más limpio."

# game/Story03.rpy:2969

translate spanish akt3chapter3_2b90d5d4:

    # a "Ventilation sector. Air from the surface used to flow through here."
    a "Sector de ventilación. Aire de la superficie que se utiliza para fluir por aquí."

# game/Story03.rpy:2972

translate spanish akt3chapter3_f4b677e0:

    # mc "You're saying... this whole thing is ventilation? Why so massive?"
    mc "¿Por qué es tan enorme?"

# game/Story03.rpy:2973

translate spanish akt3chapter3_6e9b66cc:

    # a "When they released the gas, the floors collapsed one after another."
    a "Cuando liberaron el gas, los pisos se derrumbieron uno tras otro."

# game/Story03.rpy:2974

translate spanish akt3chapter3_b6e6a2f9:

    # a "The city rotted from the bottom up."
    a "La ciudad se pudrió desde abajo."

# game/Story03.rpy:2977

translate spanish akt3chapter3_fc6a0035:

    # mc "Gas? That's what killed them?"
    mc "¿Los mató?"

# game/Story03.rpy:2978

translate spanish akt3chapter3_53e83df6:

    # mc "But the mutants... they’re not human."
    mc "Pero los mutantes... no son humanos."

# game/Story03.rpy:2981

translate spanish akt3chapter3_5948b769:

    # k "No wonder I felt like I was stepping on someone's ribs again."
    k "No me extraña que me haya sentido como si estuviera pisando las costillas de alguien de nuevo."

# game/Story03.rpy:2983

translate spanish akt3chapter3_be5cc369:

    # mc "(You could at least pretend this isn’t normal.)"
    mc "(Al menos podrías fingir que esto no es normal.)"

# game/Story03.rpy:2985

translate spanish akt3chapter3_00dec9b0:

    # k "(Sweetheart. We're on a station held together by duct tape, screaming, and someone’s bones.)"
    k "(Sweetie, estamos en una estación donde cada otra pared se sostiene por el moco, gritando y los huesos de alguien.)"

# game/Story03.rpy:2988

translate spanish akt3chapter3_e1d29dea:

    # k "(Nothing here is normal. I just adapted.)"
    k "(Nada aquí es normal. Acabo de adaptarme.)"

# game/Story03.rpy:2991

translate spanish akt3chapter3_93aa5d79:

    # mc "I'm not you."
    mc "No soy tú."

# game/Story03.rpy:2993

translate spanish akt3chapter3_259375b0:

    # mc "And I won’t pretend this is okay."
    mc "Y no voy a fingir que esto está bien."

# game/Story03.rpy:2996

translate spanish akt3chapter3_94930995:

    # k "Good. One lunatic per square meter is already too much."
    k "Un lunático por metro cuadrado ya es demasiado."

# game/Story03.rpy:2999

translate spanish akt3chapter3_3cb18e7c:

    # k "Just... don’t overthink it. Mutants aren’t people. Keeps it cleaner. For you."
    k "No lo pienses demasiado. Los mutantes no son personas. Mantiene la limpieza. Para ti."

# game/Story03.rpy:3001

translate spanish akt3chapter3_a913904e:

    # k "If the real nightmare ever breaks loose — get behind me."
    k "Si la verdadera pesadilla se desata, métete detrás de mí."

# game/Story03.rpy:3004

translate spanish akt3chapter3_7eafddce:

    # k "{b}It’s cozy there. It’s... nice."
    k "{b}Es acogedor allí. Es... agradable."

# game/Story03.rpy:3006

translate spanish akt3chapter3_e90b3c86:

    # mc "(Yeah, and I’ll be your human shield when you run out of ammo.)"
    mc "(Sí, y seré tu escudo humano cuando te quedes sin munición.)"

# game/Story03.rpy:3007

translate spanish akt3chapter3_9c9c7261:

    # k "(What? I like how that sounds...)"
    k "Me gusta cómo suena eso..."

# game/Story03.rpy:3009

translate spanish akt3chapter3_6118b17e:

    # mc "Figures. Let’s keep moving."
    mc "Figuras. Sigamos moviéndonos."

# game/Story03.rpy:3012

translate spanish akt3chapter3_beee153b:

    # k "There it is. A little crack in the mask. Now you’re starting to feel real."
    k "Ahí está. Un poco de crack en la máscara. Ahora estás empezando a sentirte real."

# game/Story03.rpy:3013

translate spanish akt3chapter3_1302a6e4:

    # k "Keep your head up. Down there? There’s only carrion... and regret."
    k "Mantenga la cabeza arriba. ¿Abajo? Solo hay carriona... y el arrepentimiento."

# game/Story03.rpy:3015

translate spanish akt3chapter3_5e44a000:

    # mc "Right..."
    mc "Bien..."

# game/Story03.rpy:3017

translate spanish akt3chapter3_b5b448e0:

    # mc "And thanks."
    mc "Y gracias."

# game/Story03.rpy:3020

translate spanish akt3chapter3_f40a37f8:

    # k "Always a pleasure. Especially when you growl at me after."
    k "Siempre es un placer, especialmente cuando me creces después."

# game/Story03.rpy:3023

translate spanish akt3chapter3_47887b0b:

    # mc "(Mutants, humans... What the hell’s really going on here?)"
    mc "(Mutantes, humanos... ¿Qué demonios está pasando aquí?)"

# game/Story03.rpy:3024

translate spanish akt3chapter3_119c346d:

    # mc "(Lora... Dr. Li... Were they part of this?)"
    mc "(Lora... Dr. Li... ¿Fueron parte de esto?)"

# game/Story03.rpy:3027

translate spanish akt3chapter3_8f0a423c:

    # mc "You know something. About them."
    mc "Ya sabes algo, sobre ellos."

# game/Story03.rpy:3034

translate spanish akt3chapter3_fdf4cc37:

    # mc "Talk."
    mc "Habla."

# game/Story03.rpy:3036

translate spanish akt3chapter3_763d88b4:

    # mc "Or at least tell me — does this tie back to Lora?"
    mc "O al menos dime: ¿ha vuelto esta corbata a Lora?"

# game/Story03.rpy:3038

translate spanish akt3chapter3_b5efc462:

    # a "You want the truth?"
    a "¿Quieres la verdad?"

# game/Story03.rpy:3041

translate spanish akt3chapter3_f800bed0:

    # mc "Yes."
    mc "Sí."

# game/Story03.rpy:3048

translate spanish akt3chapter3_61bf9ec8:

    # a "Lora and the man with the patch. They worked together."
    a "Lora y el hombre con el parche, trabajaron juntos."

# game/Story03.rpy:3050

translate spanish akt3chapter3_3c5a0c96:

    # a "Studying. Testing. Under the Lady’s orders."
    a "Estudiando. Testing. Bajo las órdenes de la Señora."

# game/Story03.rpy:3051

translate spanish akt3chapter3_2c0b1bfb:

    # a "Lora passed. He didn’t."
    a "Lora pasó."

# game/Story03.rpy:3053

translate spanish akt3chapter3_dc057b0f:

    # mc "Dr. Li?"
    mc "¿Dr. Li?"

# game/Story03.rpy:3060

translate spanish akt3chapter3_6e2d5d7b:

    # a "The Lady handed him over to Ostorius. As a trophy. As disposable."
    a "La Señora lo entregó a Ostorius como trofeo, como desechable."

# game/Story03.rpy:3061

translate spanish akt3chapter3_34ea003c:

    # a "He kept experimenting. Until the end."
    a "Seguía experimentando hasta el final."

# game/Story03.rpy:3063

translate spanish akt3chapter3_342c5ccf:

    # a "You knew him?"
    a "¿Lo conocías?"

# game/Story03.rpy:3065

translate spanish akt3chapter3_cf1adef2:

    # mc "Yeah."
    mc "Sí."

# game/Story03.rpy:3072

translate spanish akt3chapter3_04967ad2:

    # a "He never discovered the mutants’ origin."
    a "Nunca descubrió el origen de los mutantes."

# game/Story03.rpy:3075

translate spanish akt3chapter3_5d1729bf:

    # a "He had theories. But no proof."
    a "Tenía teorías, pero no pruebas."

# game/Story03.rpy:3079

translate spanish akt3chapter3_6fad8b99:

    # mc "(Wait. Something’s off…)"
    mc "(Espera. Algo está apagado...)"

# game/Story03.rpy:3082

translate spanish akt3chapter3_8266c76d:

    # mc "Li. He wrote reports. He found something, didn’t he?"
    mc "Li. Él escribió informes. Él encontró algo, ¿no?"

# game/Story03.rpy:3084

translate spanish akt3chapter3_e4476ff4:

    # a "It was in his report. But he didn’t believe himself."
    a "Estaba en su informe, pero no se creía."

# game/Story03.rpy:3086

translate spanish akt3chapter3_4e455574:

    # mc "So you’re telling me — you know where they came from?"
    mc "Así que me estás diciendo - ¿Sabes de dónde vienen?"

# game/Story03.rpy:3091

translate spanish akt3chapter3_c88aa9db:

    # a "Do you know why they’re called soulless?"
    a "¿Sabes por qué se llaman Desalmados?"

# game/Story03.rpy:3096

translate spanish akt3chapter3_a34f5214:

    # a "Soulless... because there was a soul. Before the Abyss took it."
    a "Insalubre... porque había un alma antes de que el Abismo lo tomara."

# game/Story03.rpy:3098

translate spanish akt3chapter3_3d8f9aab:

    # mc "You..."
    mc "Tú..."

# game/Story03.rpy:3101

translate spanish akt3chapter3_e08af8b7:

    # mc "No. I... I don’t understand."
    mc "No. Yo... no entiendo."

# game/Story03.rpy:3104

translate spanish akt3chapter3_a60d5916:

    # a "You saw the portals open. But you never asked what they opened on."
    a "Vio abrir los portales, pero nunca le preguntaste en qué se abrieron."

# game/Story03.rpy:3106

translate spanish akt3chapter3_7c1dcde0:

    # mc "Through energy. Through instability—"
    mc "A través de la energía."

# game/Story03.rpy:3112

translate spanish akt3chapter3_d81eba0b:

    # a "Where does the energy come from. And where do the bodies go."
    a "¿De dónde viene la energía y dónde van los cuerpos?"

# game/Story03.rpy:3114

translate spanish akt3chapter3_8e34c139:

    # mc "(They... were human?)"
    mc "(¿Ellos eran humanos?)"

# game/Story03.rpy:3125

translate spanish akt3chapter3_9a397c22:

    # k "Just... don’t think about it. Mutants aren’t people."
    k "No pienses en ello. Los mutantes no son personas."

# game/Story03.rpy:3127

translate spanish akt3chapter3_ca292e8b:

    # mc "(All this time... they screamed like monsters. But they were screaming like us.)"
    mc "(Todo este tiempo... gritaban como monstruos, pero gritaban como nosotros)."

# game/Story03.rpy:3131

translate spanish akt3chapter3_4590c5e6:

    # mc "You knew all this?"
    mc "¿Sabías todo esto?"

# game/Story03.rpy:3133

translate spanish akt3chapter3_b50e700b:

    # mc "You {b}all{/b} knew."
    mc "Tú {b}Todo el mundo{/b} Lo sabía."

# game/Story03.rpy:3134

translate spanish akt3chapter3_d4661ad2:

    # a "You suspect."
    a "Sospechoso."

# game/Story03.rpy:3135

translate spanish akt3chapter3_fd5865b3:

    # a "That’s why you’re angry."
    a "Por eso estás enfadado."

# game/Story03.rpy:3141

translate spanish akt3chapter3_668ef0ff:

    # a "(quietly) Clever. That’ll be your downfall."
    a "(quietly) Clever. Esa será tu caída."

# game/Story03.rpy:3142

translate spanish akt3chapter3_16a26557:

    # a "They can’t know. No one can."
    a "No pueden saberlo. Nadie puede."

# game/Story03.rpy:3143

translate spanish akt3chapter3_60a4c853:

    # mc "(So if I expose this... they’ll erase me? Or just shut me up...)"
    mc "(Si expongo esto... me borrarán? O simplemente me callan...)"

# game/Story03.rpy:3149

translate spanish akt3chapter3_7ca33b5b:

    # a "Arkgh!"
    a "¡Arkgh!"

# game/Story03.rpy:3151

translate spanish akt3chapter3_3d391460:

    # mc "So that’s how it works. Power and fear. Intimidate, corner, silence."
    mc "Así es como funciona. Poder y miedo. Intimidar, esquina, silencio."

# game/Story03.rpy:3153

translate spanish akt3chapter3_eb0092f1:

    # mc "No wonder Lora was so withdrawn around you. Empty."
    mc "No me extraña que Lora estuviera tan retraída alrededor tuyo."

# game/Story03.rpy:3154

translate spanish akt3chapter3_a4a126a2:

    # mc "You broke her. But you won't break me."
    mc "Lo rompiste, pero no puedes romperme."

# game/Story03.rpy:3161

translate spanish akt3chapter3_705eec7e:

    # a "(Whispering) Watch over him."
    a "Cuidado con él."

# game/Story03.rpy:3163

translate spanish akt3chapter3_2145c24a:

    # k "(You could’ve been gentler. But... who am I kidding.)"
    k "(Podrías haber sido más amable. Pero... ¿quién soy yo?)"

# game/Story03.rpy:3164

translate spanish akt3chapter3_a7fecff0:

    # k "(You just wanted to snap his wings. See how much it hurt when they cracked.)"
    k "(Solo querías romper sus alas. Ver cuánto duele cuando se rompieron.)"

# game/Story03.rpy:3167

translate spanish akt3chapter3_63056cb1:

    # a "(Whispering) You care about a simple man? {w}Since when?"
    a "¿Te importa un hombre simple? {w}¿Desde cuándo?"

# game/Story03.rpy:3169

translate spanish akt3chapter3_bfd87274:

    # k "(He’s not simple. He’s... amusing.)"
    k "(No es simple. Él es... divertido.)"

# game/Story03.rpy:3170

translate spanish akt3chapter3_64f1f69b:

    # k "(And I don’t like when someone breaks my toys without warning.)"
    k "(Y no me gusta cuando alguien rompe mis juguetes sin aviso.)"

# game/Story03.rpy:3174

translate spanish akt3chapter3_57cc1caa:

    # a "(Whispering) Stay focused. The Lady is our priority."
    a "(Susurrando) Mantente enfocado. La Señora es nuestra prioridad."

# game/Story03.rpy:3175

translate spanish akt3chapter3_a9f2e04c:

    # a "No emotions change that."
    a "No hay emociones que cambien eso."

# game/Story03.rpy:3177

translate spanish akt3chapter3_df8c2444:

    # a "Is that clear?"
    a "¿Está claro?"

# game/Story03.rpy:3184

translate spanish akt3chapter3_647e80cd:

    # k "(You’re not protecting him from breaking. You’re just setting the stage...)"
    k "(No lo estás protegiendo de romper. Solo estás poniendo el escenario...)"

# game/Story03.rpy:3185

translate spanish akt3chapter3_7c79fc16:

    # k "(The Lady taught us to savor control, sure. But you forgot — the audience needs balance.)"
    k "(La Señora nos enseñó a saborear el control, claro. Pero se olvidó — el público necesita equilibrio.)"

# game/Story03.rpy:3187

translate spanish akt3chapter3_5bbc432b:

    # k "Tch..."
    k "Tch..."

# game/Story03.rpy:3188

translate spanish akt3chapter3_124efc84:

    # k "(Whispering) You lit the fuse — don’t cry if it takes the curtain down with it."
    k "(Susurrando) Encendiste el fusible - no llores si se toma la cortina abajo con ella."

# game/Story03.rpy:3192

translate spanish akt3chapter3_839c3aec:

    # k "So how about you? Are you boiling yet?"
    k "¿Y tú qué tal si estás hirviendo?"

# game/Story03.rpy:3195

translate spanish akt3chapter3_a37454d8:

    # k "(Angry? Good. I can almost feel the heat.)"
    k "(¿Angry? Bien. Casi puedo sentir el calor.)"

# game/Story03.rpy:3198

translate spanish akt3chapter3_4be058af:

    # mc "(I wanted to believe I’d found someone in this world I could trust. {w}But I was wrong.)"
    mc "(Quería creer que había encontrado a alguien en este mundo en quien podía confiar. {w}Pero estaba equivocado.)"

# game/Story03.rpy:3200

translate spanish akt3chapter3_7cc790b8:

    # mc "Why didn’t you tell me?"
    mc "¿Por qué no me lo dijiste?"

# game/Story03.rpy:3203

translate spanish akt3chapter3_84f3a77c:

    # k "Oh, curtain up already? Spare me the tears. The world’s loud enough with all these breathing corpses."
    k "Oh, ¿ya te has levantado la cortina? Ahórrame las lágrimas. El mundo es lo suficientemente fuerte con todos estos cuerpos respiratorios."

# game/Story03.rpy:3206

translate spanish akt3chapter3_f30c76e8:

    # mc "Are you serious?"
    mc "¿Hablas en serio?"

# game/Story03.rpy:3207

translate spanish akt3chapter3_ed73c6cd:

    # mc "You kept this from me, and now you’re telling me not to react?"
    mc "¿Me has ocultado esto, y ahora me estás diciendo que no reaccione?"

# game/Story03.rpy:3208

translate spanish akt3chapter3_f9913b53:

    # mc "I trusted you. This isn’t just information. This is... everything I stand on."
    mc "Confié en ti. Esto no es solo información. Esto es... todo lo que estoy en pie."

# game/Story03.rpy:3214

translate spanish akt3chapter3_1bc15095:

    # k "(Yeah... He’s burning now. Feels good. Warm all over.)"
    k "(Sí... ahora está quemando. Se siente bien. Caliente por todos lados.)"

# game/Story03.rpy:3217

translate spanish akt3chapter3_4b227d9f:

    # k "(Whispering) It always gets messy when you don’t know how to lie. Gracefully. Or even... humanly."
    k "Siempre se pone desordenado cuando no sabes mentir. Con gratitud. O incluso... humanamente."

# game/Story03.rpy:3220

translate spanish akt3chapter3_9810fe39:

    # k "(Try this on your tongue — 'I failed.' Not so hard, is it?)"
    k "(Trata de decir, \"Metí la pata\". No es tan difícil, ¿verdad?)"

# game/Story03.rpy:3225

translate spanish akt3chapter3_9a92569c:

    # k "(No? Of course not... provincial theater actress that you are.)"
    k "Por supuesto que no... actriz de teatro provincial que eres.)"

# game/Story03.rpy:3228

translate spanish akt3chapter3_18c0dbe9:

    # k "(Here we go again — dancing around conscience.)"
    k "(Aquí vamos otra vez - bailando alrededor de la conciencia.)"

# game/Story03.rpy:3231

translate spanish akt3chapter3_47e60563:

    # k "Please. Just kill me. Better quick than bleeding out in this slow-motion drama."
    k "Por favor, mátame, mejor rápido que sangrar en este drama de cámara lenta."

# game/Story03.rpy:3235

translate spanish akt3chapter3_a5ec69d4:

    # k "(But not now. Don’t ruin the show in the first act.)"
    k "(Pero no ahora. No arruines el espectáculo en el primer acto.)"

# game/Story03.rpy:3237

translate spanish akt3chapter3_96289803:

    # k "Actually, wait..."
    k "En realidad, espera..."

# game/Story03.rpy:3241

translate spanish akt3chapter3_c26d0bfb:

    # k "As charming as this panic is — who the hell is flying this coffin with wings?"
    k "Tan encantador como este pánico es — ¿quién demonios está volando este ataúd con alas?"

# game/Story03.rpy:3245

translate spanish akt3chapter3_43e34f05:

    # mc "Wait — don’t tell me... no one’s flying this thing?"
    mc "Espera — no me digas... ¿Nadie está volando esta cosa?"

# game/Story03.rpy:3250

translate spanish akt3chapter3_4de01bd8:

    # gg "We... didn’t think that far ahead..."
    gg "Nosotros... no pensamos que mucho por delante..."

# game/Story03.rpy:3253

translate spanish akt3chapter3_8d68d766:

    # g "I can."
    g "Puedo."

# game/Story03.rpy:3255

translate spanish akt3chapter3_ef178b3a:

    # gg "Brain, what are you—"
    gg "Cerebro, ¿qué estás...?"

# game/Story03.rpy:3258

translate spanish akt3chapter3_b4a519d0:

    # g "Worked air delivery as a kid."
    g "Entrega de aire trabajado como niño."

# game/Story03.rpy:3260

translate spanish akt3chapter3_db007c6d:

    # g "Just need a second hand."
    g "Solo necesito una segunda mano."

# game/Story03.rpy:3265

translate spanish akt3chapter3_9e6f11df:

    # mc "Me?"
    mc "¿Yo?"

# game/Story03.rpy:3268

translate spanish akt3chapter3_08b60af4:

    # mc "But I’ve never..."
    mc "Pero nunca he..."

# game/Story03.rpy:3270

translate spanish akt3chapter3_e3fb8912:

    # g "You’ll just sit there and not touch anything. Think you can manage?"
    g "Usted se sentará allí y no tocar nada. ¿Crees que puedes manejar?"

# game/Story03.rpy:3277

translate spanish akt3chapter3_2199477d:

    # mc "...I think so."
    mc "...creo que sí."

# game/Story03.rpy:3284

translate spanish akt3chapter3_f702af86:

    # gg "One problem down, I guess."
    gg "Un problema, supongo."

# game/Story03.rpy:3286

translate spanish akt3chapter3_9769d7a5:

    # mc "How much further?"
    mc "¿Cuánto más?"

# game/Story03.rpy:3288

translate spanish akt3chapter3_966e75bc:

    # gg "We’re here. Just need to go in."
    gg "Estamos aquí. Solo tenemos que entrar."

# game/Story03.rpy:3293

translate spanish akt3chapter3_6cd20e48:

    # gg "How’s the door coming?"
    gg "¿Cómo va la puerta?"

# game/Story03.rpy:3296

translate spanish akt3chapter3_e7be1092:

    # ggggg "Locked. From the other side."
    ggggg "Cerrado, del otro lado."

# game/Story03.rpy:3298

translate spanish akt3chapter3_814b4855:

    # gg "No other way in?"
    gg "¿No hay otra manera de entrar?"

# game/Story03.rpy:3305

translate spanish akt3chapter3_4a0fd56d:

    # ggggg "Technically? Yeah. But you won’t like it."
    ggggg "Técnicamente? Sí. Pero no te gustará."

# game/Story03.rpy:3308

translate spanish akt3chapter3_b7f1c999:

    # gggggg "What do you mea—"
    gggggg "¿Qué meas...?"

# game/Story03.rpy:3313

translate spanish akt3chapter3_9c150573:

    # a "Step aside."
    a "Apártate."

# game/Story03.rpy:3314

translate spanish akt3chapter3_deadb412:

    # ggggg "You don’t give me orders."
    ggggg "No me das órdenes."

# game/Story03.rpy:3315

translate spanish akt3chapter3_9e257187:

    # a "I don’t negotiate commands."
    a "No negozco órdenes."

# game/Story03.rpy:3322

translate spanish akt3chapter3_bf9054ac:

    # gggggg "Do as she says."
    gggggg "Haz lo que ella diga."

# game/Story03.rpy:3331

translate spanish akt3chapter3_09425915:

    # g "(whispering) What’s she doing?"
    g "¿Qué está haciendo?"

# game/Story03.rpy:3332

translate spanish akt3chapter3_9cdab376:

    # ggggg "(whispering) Thinks she can move it one-handed. Lunatics..."
    ggggg "Piensa que puede moverlo de una mano."

# game/Story03.rpy:3335

translate spanish akt3chapter3_58415143:

    # gg "(whispering) Kids… You haven’t seen what they’re capable of."
    gg "Niños... No han visto de qué son capaces."

# game/Story03.rpy:3350

translate spanish akt3chapter3_4a349266:

    # gggggg "She… she moved the door. One hand. Is that even legal?"
    gggggg "Ella... ella movió la puerta. ¿Es legal?"

# game/Story03.rpy:3353

translate spanish akt3chapter3_fabef0c1:

    # a "Let’s go."
    a "Vamos."

# game/Story03.rpy:3355

translate spanish akt3chapter3_12f7b17d:

    # mc "(Do they all have a family kink for brute force?)"
    mc "(¿Todos tienen un kink familiar para la fuerza bruta?)"

# game/Story03.rpy:3359

translate spanish akt3chapter3_f57e5e89:

    # k "(Strength’s the only language that doesn’t lie.)"
    k "(La fuerza es el único lenguaje que no miente.)"

# game/Story03.rpy:3361

translate spanish akt3chapter3_86b0bfad:

    # mc "(You’re in my head again.)"
    mc "(Estás en mi cabeza otra vez.)"

# game/Story03.rpy:3364

translate spanish akt3chapter3_95b44fab:

    # k "(And you’re still pouting like a boy with a broken toy.)"
    k "(Y sigues apasionando como un niño con un juguete roto.)"

# game/Story03.rpy:3371

translate spanish akt3chapter3_52c4145b:

    # mc "(Then why didn’t you tell me?)"
    mc "(Entonces, ¿por qué no me lo dijiste?)"

# game/Story03.rpy:3374

translate spanish akt3chapter3_eb19bf4c:

    # k "(Again?! You’re relentless...)"
    k "(¿Otra vez?! Eres implacable...)"

# game/Story03.rpy:3376

translate spanish akt3chapter3_b8bb5a89:

    # mc "(I trusted you. And now I don’t know… if I still can.)"
    mc "(Confié en ti. Y ahora no sé... si todavía puedo.)"

# game/Story03.rpy:3379

translate spanish akt3chapter3_4c9bb4fd:

    # k "Argh… Principles, principles… You’ve got enough morality for a bad romance novel."
    k "Principios, principios... Tienes suficiente moralidad para una mala novela romántica."

# game/Story03.rpy:3386

translate spanish akt3chapter3_062235e2:

    # k "(I couldn’t, okay? If you’d found out then — it would’ve torn you apart.)"
    k "(No podría, ¿de acuerdo? Si lo hubieras descubierto entonces, te habría destrozado.)"

# game/Story03.rpy:3388

translate spanish akt3chapter3_b5ec5fc4:

    # k "(You would’ve fallen. And we don’t allow weak allies.)"
    k "(Usted se habría caído. Y no permitimos aliados débiles.)"

# game/Story03.rpy:3389

translate spanish akt3chapter3_43195097:

    # mc "(You think I couldn’t handle it?)"
    mc "(¿Crees que no podría manejarlo?)"

# game/Story03.rpy:3392

translate spanish akt3chapter3_7477bab9:

    # k "(You don’t get it. It’s not about being strong.)"
    k "(No lo entiendes. No se trata de ser fuerte.)"

# game/Story03.rpy:3394

translate spanish akt3chapter3_04cdc2f7:

    # k "(It’s about how death breaks you… when you still believe they were people.)"
    k "(Es sobre cómo la muerte te rompe... cuando aún crees que eran personas.)"

# game/Story03.rpy:3398

translate spanish akt3chapter3_afad5e3d:

    # k "We’re not machines. We breathe, we feel… and we break."
    k "No somos máquinas. Respiramos, sentimos... y nos rompemos."

# game/Story03.rpy:3406

translate spanish akt3chapter3_288945c1:

    # k "I’ve seen it."
    k "Lo he visto."

# game/Story03.rpy:3408

translate spanish akt3chapter3_a7cf177e:

    # k "Seen strong ones bend when the truth hit."
    k "Vi fuertes doblarse cuando la verdad golpeó."

# game/Story03.rpy:3410

translate spanish akt3chapter3_fadc3f51:

    # k "So yeah, sorry I lied. That was my gift — protecting you from yourself."
    k "Así que sí, lo siento, mentí, ese fue mi regalo, protegiéndote de ti mismo."

# game/Story03.rpy:3413

translate spanish akt3chapter3_e7643b5f:

    # mc "I… I get why you did it."
    mc "Entiendo por qué lo hiciste."

# game/Story03.rpy:3414

translate spanish akt3chapter3_34c21873:

    # mc "But… the pain’s still there."
    mc "Pero... el dolor sigue ahí."

# game/Story03.rpy:3418

translate spanish akt3chapter3_cebdc106:

    # k "Pain means you’re alive. That’s already a win."
    k "El dolor significa que estás vivo. Eso ya es una victoria."

# game/Story03.rpy:3419

translate spanish akt3chapter3_11305ff6:

    # k "Now come on. Without us, the show’s just dull."
    k "Ahora vamos. Sin nosotros, el espectáculo es aburrido."

# game/Story03.rpy:3429

translate spanish akt3chapter3_94829569:

    # k "Used to be bones, flies, and silence down here."
    k "Solía ser huesos, moscas y silencio aquí abajo."

# game/Story03.rpy:3430

translate spanish akt3chapter3_f89521da:

    # k "Now it’s pipes, lights, and the smell of old corpses. Progress… almost."
    k "Ahora son tuberías, luces y el olor de viejos cuerpos. Progreso... casi."

# game/Story03.rpy:3431

translate spanish akt3chapter3_20850c44:

    # mc "(Wouldn’t be surprised if the corpses are still here. Just buried deeper.)"
    mc "(No se sorprendería si los cadáveres aún están aquí. Simplemente enterrado más profundo.)"

# game/Story03.rpy:3434

translate spanish akt3chapter3_9b609ed8:

    # gg "Fan out. There’s got to be at least one transport left."
    gg "Hay que estar al menos un transporte a la izquierda."

# game/Story03.rpy:3437

translate spanish akt3chapter3_bd75da86:

    # gggg "This pit’s been abandoned, sir. Doubt anything’s functional."
    gggg "Este pozo ha sido abandonado, señor. Duda de que todo sea funcional."

# game/Story03.rpy:3438

translate spanish akt3chapter3_5d97d04e:

    # gg "Then we believe in miracles. Or go make one."
    gg "Entonces creemos en milagros, o vamos a hacer uno."

# game/Story03.rpy:3440

translate spanish akt3chapter3_639da679:

    # mc "(One wrong move — and it’s a one-way ticket.)"
    mc "(Un movimiento equivocado – y es un boleto de un solo sentido.)"

# game/Story03.rpy:3441

translate spanish akt3chapter3_b69f6829:

    # mc "Looks promising..."
    mc "Parece prometedor..."

# game/Story03.rpy:3444

translate spanish akt3chapter3_3710a0f9:

    # g "You. You’re coming with me."
    g "Tú. Tú vienes conmigo."

# game/Story03.rpy:3446

translate spanish akt3chapter3_889d77af:

    # mc "And what do you need me for?"
    mc "¿Y para qué me necesitas?"

# game/Story03.rpy:3448

translate spanish akt3chapter3_e6a7b655:

    # g "Need another pair of hands. To check the fuel."
    g "Necesito otro par de manos para comprobar el combustible."

# game/Story03.rpy:3450

translate spanish akt3chapter3_1ce3527f:

    # mc "You can’t do it alone?"
    mc "¿No puedes hacerlo solo?"

# game/Story03.rpy:3452

translate spanish akt3chapter3_ef6e8b3d:

    # g "Can. But with you — it’s faster."
    g "Puede. Pero con usted - es más rápido."

# game/Story03.rpy:3453

translate spanish akt3chapter3_35fff124:

    # mc "(Perfect... Just perfect.)"
    mc "(Perfecto... perfecto.)"

# game/Story03.rpy:3456

translate spanish akt3chapter3_42102a88:

    # g "You can stay behind, of course. But don’t blame anyone if we run out of time."
    g "Puedes quedarte atrás, por supuesto. Pero no culpes a nadie si nos quedamos sin tiempo."

# game/Story03.rpy:3458

translate spanish akt3chapter3_cd2bace7:

    # k "(You’re really going with him? Mmm… Bold. Stupid. But bold.)"
    k "(¿Realmente vas con él? Mmm... Bold. Estúpido. Pero audaz.)"

# game/Story03.rpy:3463

translate spanish akt3chapter3_87b975c5:

    # mc "(Do I have a choice?)"
    mc "(¿Tengo elección?)"

# game/Story03.rpy:3466

translate spanish akt3chapter3_a8eb1af5:

    # k "(You always have a choice. Sometimes it’s just between a {b}bullet to the chest{/b} and a {b}bullet to the back{/b}.)"
    k "(Siempre tienes una opción. A veces es solo entre un {b}bala en el pecho{/b} y a {b}bala a la espalda{/b}.)"

# game/Story03.rpy:3468

translate spanish akt3chapter3_5c6d3de5:

    # mc "He reminds me of you when you’re pissed."
    mc "Me recuerda a ti cuando estás enojado."

# game/Story03.rpy:3471

translate spanish akt3chapter3_d82c0243:

    # k "Difference is — I don’t lie about my intentions."
    k "La diferencia es — no miente acerca de mis intenciones."

# game/Story03.rpy:3475

translate spanish akt3chapter3_eee5ed20:

    # k "(Not gonna say anything, huh?)"
    k "(No va a decir nada, ¿eh?)"

# game/Story03.rpy:3477

translate spanish akt3chapter3_eaf08bf4:

    # g "We’re heading out. Going to check the fuel tanks."
    g "Vamos a comprobar los tanques de combustible."

# game/Story03.rpy:3480

translate spanish akt3chapter3_e7d4348e:

    # gg "Wait."
    gg "Espera."

# game/Story03.rpy:3483

translate spanish akt3chapter3_53e74ce3:

    # gg "Catch. You hear even one step behind you — use it."
    gg "Atrapate. Oigas incluso un paso atrás de ti — úsalo."

# game/Story03.rpy:3486

translate spanish akt3chapter3_33570131:

    # gg "These walls breathe. You never know what’ll crawl out of the dark. Remember what to do?"
    gg "Estas paredes respiran. Nunca sabes lo que se arrastrará de la oscuridad. ¿Recuerdas qué hacer?"

# game/Story03.rpy:3493

translate spanish akt3chapter3_4799d043:

    # g "First sign — we run."
    g "Primera señal: corremos."

# game/Story03.rpy:3494

translate spanish akt3chapter3_006f1365:

    # gg "Go."
    gg "Ve."

# game/Story03.rpy:3503

translate spanish akt3chapter3_b33c7452:

    # mc "(Something’s off. This place is screaming: “Run.”)"
    mc "(Algo está apagado. Este lugar está gritando: “Run.”)"

# game/Story03.rpy:3507

translate spanish akt3chapter3_521c53bb:

    # mc "So... Why do you really need me?"
    mc "Entonces... ¿por qué me necesitas?"

# game/Story03.rpy:3509

translate spanish akt3chapter3_6ac0bf72:

    # g "I noticed. You’re not like them."
    g "No me he dado cuenta. No eres como ellos."

# game/Story03.rpy:3512

translate spanish akt3chapter3_3d996037:

    # mc "What are you talking about?"
    mc "¿De qué estás hablando?"

# game/Story03.rpy:3515

translate spanish akt3chapter3_69bc08ec:

    # g "Don’t play dumb. We’re lower city folk. We read people like cracked glass."
    g "No juegues tonto. Somos gente de la ciudad baja. Leemos a la gente como vidrio crujido."

# game/Story03.rpy:3520

translate spanish akt3chapter3_153d0ce7:

    # g "It’s simple. You either fake it — or say it straight."
    g "Es simple. O lo finge — o lo dices directamente."

# game/Story03.rpy:3525

translate spanish akt3chapter3_0eb29620:

    # mc "Yeah. Fair."
    mc "Sí, justo."

# game/Story03.rpy:3528

translate spanish akt3chapter3_b7773ec2:

    # g "Ha. Didn’t think you’d actually say yes."
    g "Ha. No pensé que de hecho dirías que sí."

# game/Story03.rpy:3531

translate spanish akt3chapter3_20365eff:

    # g "Glad you didn’t bullshit me."
    g "Me alegra que no me hayas mentido."

# game/Story03.rpy:3534

translate spanish akt3chapter3_8c117f9a:

    # g "I need your help."
    g "Necesito tu ayuda."

# game/Story03.rpy:3536

translate spanish akt3chapter3_5514cbd1:

    # mc "(Here we go...)"
    mc "(Aquí vamos...)"

# game/Story03.rpy:3537

translate spanish akt3chapter3_c6b16b8c:

    # mc "(It’s either blackmail or a begging plea.)"
    mc "(Es chantaje o una petición de mendicidad.)"

# game/Story03.rpy:3546

translate spanish akt3chapter3_1c5c3816:

    # mc "Fine. Out with it. What do you want?"
    mc "Bien, fuera con eso. ¿Qué quieres?"

# game/Story03.rpy:3548

translate spanish akt3chapter3_871ff683:

    # g "Help me. My wife and daughter… They won’t survive this place."
    g "Ayúdame. Mi esposa e hija... No sobrevivirán a este lugar."

# game/Story03.rpy:3549

translate spanish akt3chapter3_6b53a4f7:

    # g "I’m not asking much. Just a ride. It’s close — I’ll handle everything else. Just..."
    g "No estoy pidiendo mucho. Solo un paseo. Está cerca — Yo me encargaré de todo lo demás. Solo..."

# game/Story03.rpy:3550

translate spanish akt3chapter3_8f588f24:

    # g "They’re waiting. They believe I’ll come back."
    g "Ellos están esperando. Creen que volveré."

# game/Story03.rpy:3552

translate spanish akt3chapter3_215fbb6a:

    # mc "(He’s like Norman… Doing it all for family. But this is our only shot.)"
    mc "(Es como Norman... Haciéndolo todo por familia. Pero esta es nuestra única oportunidad.)"

# game/Story03.rpy:3553

translate spanish akt3chapter3_fca52711:

    # mc "No."
    mc "No."

# game/Story03.rpy:3555

translate spanish akt3chapter3_892fd1ce:

    # g "Please..."
    g "Por favor..."

# game/Story03.rpy:3557

translate spanish akt3chapter3_bfa3ac19:

    # mc "(He’s our only pilot.)"
    mc "(Es nuestro único piloto.)"

# game/Story03.rpy:3559

translate spanish akt3chapter3_d62dcfc6:

    # mc "(If we help — he gets us out.)"
    mc "(Si ayudamos, nos saca de aquí.)"

# game/Story03.rpy:3562

translate spanish akt3chapter3_ebd80908:

    # mc "(But every extra minute puts us all at risk. And how do I face Lora then?...)"
    mc "(Pero cada minuto extra nos pone a todos en riesgo. ¿Y cómo me enfrenta a Lora entonces?...)"

# game/Story03.rpy:3564

translate spanish akt3chapter3_085c4fb1:

    # mc "(No. One life isn’t worth a hundred others.)"
    mc "(No. Una vida no vale cien más)."

# game/Story03.rpy:3566

translate spanish akt3chapter3_8b9dbe8c:

    # mc "I wish I could. But if I say yes — we all burn."
    mc "Ojalá pudiera, pero si digo que sí, todos ardemos."

# game/Story03.rpy:3572

translate spanish akt3chapter3_8a43d5eb:

    # g "I see."
    g "Ya veo."

# game/Story03.rpy:3578

translate spanish akt3chapter3_3c59f45c:

    # g "So what now?"
    g "¿Y ahora qué?"

# game/Story03.rpy:3580

translate spanish akt3chapter3_749b8edc:

    # mc "Wait. Don’t do anything stupid."
    mc "Espera. No hagas nada estúpido."

# game/Story03.rpy:3583

translate spanish akt3chapter3_a24b133e:

    # mc "I know this is hard, but we hav—"
    mc "Sé que esto es difícil, pero nosotros..."

# game/Story03.rpy:3585

translate spanish akt3chapter3_975ef168:

    # g "I’m not going without them! Either we go together, or not at all!"
    g "¡No voy a ir sin ellos! ¡O vamos juntos, o no!"

# game/Story03.rpy:3588

translate spanish akt3chapter3_c3bd0649:

    # mc "Alright, let’s calm down first."
    mc "Bien, vamos a calmarnos primero."

# game/Story03.rpy:3591

translate spanish akt3chapter3_cd640c3e:

    # mc "I had a son. Around your age. With a family."
    mc "Tenía un hijo, alrededor de tu edad, con una familia."

# game/Story03.rpy:3593

translate spanish akt3chapter3_88227939:

    # mc "So trust me, I get what you’re feeling—"
    mc "Así que créeme, entiendo lo que sientes..."

# game/Story03.rpy:3597

translate spanish akt3chapter3_39a84955:

    # g "DON’T COME ANY CLOSER! You think I don’t see what you’re trying to do?!"
    g "¡No vengas a ninguna CLOSER! ¿Crees que no veo lo que estás tratando de hacer?!"

# game/Story03.rpy:3598

translate spanish akt3chapter3_7c877ac9:

    # g "STAY BACK!"
    g "¡Atrás!"

# game/Story03.rpy:3600

translate spanish akt3chapter3_29b2d7ea:

    # mc "Okay, okay. We’ll talk from here. Just lower the gun, alright?"
    mc "Bien, bien, hablaremos desde aquí."

# game/Story03.rpy:3602

translate spanish akt3chapter3_ff97d55e:

    # g "IT’S NOT YOUR CALL!"
    g "¡No es tu llamada!"

# game/Story03.rpy:3604

translate spanish akt3chapter3_3386ff5a:

    # g "TELL ME NOW! Are you—"
    g "Dime ahora. ¿Estás...?"

# game/Story03.rpy:3617

translate spanish akt3chapter3_c8b06020:

    # a "That’s what happens when you trust vermin."
    a "Eso es lo que pasa cuando confías en el vermin."

# game/Story03.rpy:3620

translate spanish akt3chapter3_01ac36dc:

    # mc "ARE YOU OUT OF YOUR DAMN MIND?!"
    mc "¿Estás loco?"

# game/Story03.rpy:3621

translate spanish akt3chapter3_b938c928:

    # mc "He could’ve saved us! He was..."
    mc "¡Nos pudo haber salvado!"

# game/Story03.rpy:3624

translate spanish akt3chapter3_f868265c:

    # mc "(No, breathe. Stay calm.)"
    mc "(No, respira. Mantente calmado.)"

# game/Story03.rpy:3627

translate spanish akt3chapter3_bdb22018:

    # mc "He was our pilot..."
    mc "Era nuestro piloto..."

# game/Story03.rpy:3634

translate spanish akt3chapter3_9dfcb55b:

    # a "Now we have you."
    a "Ahora te tenemos."

# game/Story03.rpy:3637

translate spanish akt3chapter3_baebe7cb:

    # mc "What? Is this a joke? I’ve never flown anything like this!"
    mc "¿Qué? ¿Es una broma? Nunca he volado algo así!"

# game/Story03.rpy:3639

translate spanish akt3chapter3_efac164a:

    # a "You’ll learn."
    a "Aprenderás."

# game/Story03.rpy:3642

translate spanish akt3chapter3_acf63861:

    # mc "And what about him?! What do we tell the others?!"
    mc "¿Y qué hay de él? ¿Qué les decimos a los demás?"

# game/Story03.rpy:3645

translate spanish akt3chapter3_9e1351f8:

    # a "That’s my problem now."
    a "Ese es mi problema ahora."

# game/Story03.rpy:3648

translate spanish akt3chapter3_4d4ec6cd:

    # mc "(Now I get why Lora’s always at her throat — she’s livid.)"
    mc "(Ahora entiendo por qué Lora siempre está en su garganta — ella es livid.)"

# game/Story03.rpy:3656

translate spanish akt3chapter3_27be8719:

    # gg "Check the storage bays. Maybe someone left something behind."
    gg "Mira las bahías de almacenamiento, tal vez alguien dejó algo atrás."

# game/Story03.rpy:3657

translate spanish akt3chapter3_2c11d821:

    # ggg "On it."
    ggg "En ello."

# game/Story03.rpy:3658

translate spanish akt3chapter3_933e4d29:

    # k "(Bored...)"
    k "(Bored...)"

# game/Story03.rpy:3661

translate spanish akt3chapter3_8f594cc2:

    # gg "I'm heading to the turbines. Gonna check the tanks."
    gg "Voy a ir a las turbinas, voy a revisar los tanques."

# game/Story03.rpy:3662

translate spanish akt3chapter3_55137c09:

    # k "(Well, well. Look who's back with news. Only one of them — ain’t a hero anymore.)"
    k "(Miren quién ha vuelto con las noticias, solo uno de ellos ya no es un héroe.)"

# game/Story03.rpy:3665

translate spanish akt3chapter3_9c8c4e09:

    # mc "This a joke?.. You seriously think I'm flying that thing?"
    mc "¿De verdad crees que voy a volar esta cosa?"

# game/Story03.rpy:3666

translate spanish akt3chapter3_b598bb4d:

    # mc "I've never sat in a cockpit! Not once! Tried a simulator once as a kid — and bailed halfway through."
    mc "Nunca me he sentado en la cabina, nunca he intentado un simulador como niño y lo he dejado a mitad de camino."

# game/Story03.rpy:3669

translate spanish akt3chapter3_cd6aa4e7:

    # a "You'll have time to remember. In flight."
    a "Tendrás tiempo para recordar, en vuelo."

# game/Story03.rpy:3672

translate spanish akt3chapter3_bd558f76:

    # mc "This would be funny if it weren't... you know, fatal."
    mc "Sería gracioso si no fuera... bueno, ya sabes, mortal."

# game/Story03.rpy:3675

translate spanish akt3chapter3_9a8e9796:

    # mc "If you hadn’t killed him — maybe we'd still have a shot at seeing dawn."
    mc "Si no lo hubieras matado, podríamos tener la oportunidad de ver el amanecer."

# game/Story03.rpy:3677

translate spanish akt3chapter3_cdcff9ce:

    # gg "You're back?"
    gg "¿Has vuelto?"

# game/Story03.rpy:3683

translate spanish akt3chapter3_6f90a720:

    # gg "Where’s Bra—"
    gg "¿Dónde está Bra?"

# game/Story03.rpy:3686

translate spanish akt3chapter3_f51c71cc:

    # a "Dead."
    a "Muerto."

# game/Story03.rpy:3691

translate spanish akt3chapter3_b4e517f7:

    # gg "What?"
    gg "¿Qué?"

# game/Story03.rpy:3695

translate spanish akt3chapter3_5b5caad2:

    # a "I shot him."
    a "Le disparé."

# game/Story03.rpy:3697

translate spanish akt3chapter3_5352fa07:

    # mc "(No-no-no. Are you serious?! Just like that?!)"
    mc "¿Hablas en serio?"

# game/Story03.rpy:3700

translate spanish akt3chapter3_5baf2c93:

    # gg "Explain. Now."
    gg "Explíquelo."

# game/Story03.rpy:3702

translate spanish akt3chapter3_61fdf4bb:

    # a "He pointed a weapon at him. Made threats. Wanted to break out, save his family."
    a "Le señaló un arma, le hizo amenazas, quería salir, salvar a su familia."

# game/Story03.rpy:3703

translate spanish akt3chapter3_560b354a:

    # gg "So you... just decided?"
    gg "Así que... ¿solo has decidido?"

# game/Story03.rpy:3705

translate spanish akt3chapter3_b9a7c5f4:

    # a "I made a choice."
    a "Hice una elección."

# game/Story03.rpy:3707

translate spanish akt3chapter3_0b4a4ec5:

    # mc "You killed the only one who could get us out of here!"
    mc "¡Mataste al único que podía sacarnos de aquí!"

# game/Story03.rpy:3709

translate spanish akt3chapter3_739178da:

    # a "We still have him."
    a "Aún lo tenemos."

# game/Story03.rpy:3711

translate spanish akt3chapter3_e37ea051:

    # mc "Me?! I'm not a pilot! I drove a truck—not a combat shuttle! It's like jumping into a fire with a paper cup and hoping it doesn’t boil!"
    mc "¡No soy piloto! Manejé un coche, no un transbordador de combate. ¡Es como saltar en un fuego con una taza de papel y esperar que no hierva!"

# game/Story03.rpy:3715

translate spanish akt3chapter3_a7b24434:

    # ggg "You just erased our only shot! Damn it, you..."
    ggg "¡Acabas de borrar nuestro único disparo!"

# game/Story03.rpy:3718

translate spanish akt3chapter3_b59e3a77:

    # gg "Enough!"
    gg "¡Basta!"

# game/Story03.rpy:3720

translate spanish akt3chapter3_15c2302f:

    # k "(Ohhh, now it's heating up...)"
    k "(Oh, esto está recibiendo un poco más de tracción.)"

# game/Story03.rpy:3722

translate spanish akt3chapter3_c9d13edd:

    # gg "Did you have the right? Who gave you that damn right?"
    gg "¿Quién te dio ese maldito derecho?"

# game/Story03.rpy:3725

translate spanish akt3chapter3_9f9532eb:

    # a "No one. I took it."
    a "Nadie, yo lo tomé."

# game/Story03.rpy:3727

translate spanish akt3chapter3_cb771c4f:

    # mc "(There it is. Her real face. No mask.)"
    mc "(Ahí está. Su cara real. Sin máscara.)"

# game/Story03.rpy:3729

translate spanish akt3chapter3_5a208efd:

    # gg "He was a friend. Yeah, impulsive — but he didn’t deserve a bullet in the back."
    gg "Era un amigo. Sí, impulsivo, pero no merecía una bala en la espalda."

# game/Story03.rpy:3731

translate spanish akt3chapter3_0e0be1b2:

    # a "He would’ve gotten us killed. Everyone knows how that ends. A panicking man with a gun? Worse than the enemy."
    a "Él nos habría matado. Todo el mundo sabe cómo termina. Un hombre que se asusta con un arma? Peor que el enemigo."

# game/Story03.rpy:3733

translate spanish akt3chapter3_bcfc8a06:

    # ggg "And who are you now?! Judge? Executioner?!"
    ggg "¿Y quién es usted ahora?"

# game/Story03.rpy:3735

translate spanish akt3chapter3_bc6beb48:

    # a "If needed — both."
    a "Si es necesario, ambos."

# game/Story03.rpy:3736

translate spanish akt3chapter3_3cbddbbf:

    # mc "You know what? I'm done. Do whatever you want. I'm not flying."
    mc "He terminado, haz lo que quieras, no soy piloto."

# game/Story03.rpy:3739

translate spanish akt3chapter3_ff5c8c31:

    # k "So it's a {b}bullet in the back{/b}, after all?"
    k "Entonces, después de todo, {b}balan-en-la-back{/b}?"

# game/Story03.rpy:3745

translate spanish akt3chapter3_e51896df:

    # mc "...I had a son. He'd be Braien’s age now."
    mc "Tenía un hijo, ahora tendría la misma edad que Brian."

# game/Story03.rpy:3747

translate spanish akt3chapter3_ef07d6f8:

    # mc "But if I take the controls — someone might survive."
    mc "Pero si tomo los controles, alguien podría sobrevivir."

# game/Story03.rpy:3749

translate spanish akt3chapter3_cec5c568:

    # mc "If I walk away — we’re all dead. Every last one of us."
    mc "Si me voy, estamos todos muertos."

# game/Story03.rpy:3752

translate spanish akt3chapter3_c3e3e85b:

    # mc "So... to hell with it."
    mc "Así que... al diablo con eso."

# game/Story03.rpy:3753

translate spanish akt3chapter3_7183f58e:

    # mc "I’ll fly the damn wreck."
    mc "Voy a volar el maldito desastre."

# game/Story03.rpy:3755

translate spanish akt3chapter3_e2390ffe:

    # gg "He’s actually going."
    gg "En realidad va."

# game/Story03.rpy:3759

translate spanish akt3chapter3_82eb7296:

    # mc "And for the blood you've already poured into our tanks."
    mc "Y por la sangre que ya has derramado en nuestros tanques."

# game/Story03.rpy:3769

translate spanish akt3chapter3_451b5c6f:

    # gg "To the Transporter. Now!"
    gg "Al Transportador. ¡Ahora!"

# game/Story03.rpy:3778

translate spanish akt3chapter3_b1c22684:

    # mc "(Don’t screw this up... Of course. You’re the hero, right?)"
    mc "(No lo arruines... por supuesto. Eres el héroe, ¿verdad?)"

# game/Story03.rpy:3780

translate spanish akt3chapter3_8a7d5908:

    # mc "(Where the hell’s the front panel on this thing?!)"
    mc "(¿Dónde diablos está el panel delantero en esta cosa?!)"

# game/Story03.rpy:3783

translate spanish akt3chapter3_c4e6f911:

    # mc "(Thousands of switches, everything’s blinking... This one? Start? Looks like it...)"
    mc "(Miles de interruptores, todo está parpadeando... ¿Este? Comience? Parece que...)"

# game/Story03.rpy:3788

translate spanish akt3chapter3_859c9032:

    # mc "(Ha! There — turbines are humming! Come on, baby...)"
    mc "¡Ahí están las turbinas!"

# game/Story03.rpy:3791

translate spanish akt3chapter3_a4a6788b:

    # mc "(What?.. What the hell?! NO! NOT NOW! NOT NOW!)"
    mc "¿Qué demonios?"

# game/Story03.rpy:3794

translate spanish akt3chapter3_757be55a:

    # mc "(Fuel’s dropping. Red light. Pressure’s crashing.)"
    mc "(El combustible está cayendo. Luz roja. Presión se está bloqueando.)"

# game/Story03.rpy:3799

translate spanish akt3chapter3_1e74a45e:

    # mc "(Where’s the drain? Where’s the failsafe?! Where—)"
    mc "(¿Dónde está el drenaje? ¿Dónde está el seguro de falla?!"

# game/Story03.rpy:3802

translate spanish akt3chapter3_d6a7a0d4:

    # Mi "Your safety is the priority. The rest is mine to handle."
    Mi "Tu seguridad es la prioridad, el resto es mío."

# game/Story03.rpy:3803

translate spanish akt3chapter3_4da8e47d:

    # Mi "Move to the ship. Now."
    Mi "Muévete al barco."

# game/Story03.rpy:3806

translate spanish akt3chapter3_aa27878e:

    # el "Mir... Please be careful, alright?"
    el "Mir... por favor ten cuidado, ¿de acuerdo?"

# game/Story03.rpy:3809

translate spanish akt3chapter3_15d9ce2d:

    # el "Go! Anyone who can move — get to the bays! This is our shot!"
    el "¡A cualquiera que pueda moverse, a las bahías!"

# game/Story03.rpy:3811

translate spanish akt3chapter3_dae17119:

    # Mi "How many more are there..?"
    Mi "¿Cuántos más hay?"

# game/Story03.rpy:3813

translate spanish akt3chapter3_76a4db82:

    # H "Scan... 783 targets. Total elimination — impossible."
    H "Escáner... 783 objetivos. Eliminación total — imposible."

# game/Story03.rpy:3814

translate spanish akt3chapter3_565eee6f:

    # Mi "(Time till breach?..)"
    Mi "(¿Tiempo hasta la brecha?.)"

# game/Story03.rpy:3815

translate spanish akt3chapter3_eb4846ec:

    # H "Defense will collapse in 7 minutes."
    H "La defensa se derrumbará en 7 minutos."

# game/Story03.rpy:3816

translate spanish akt3chapter3_396d612f:

    # Mi "(Patch me to the pilot.)"
    Mi "(Pásame al piloto.)"

# game/Story03.rpy:3819

translate spanish akt3chapter3_fd5e8cfa:

    # Mi "Cold Reaper. Who's at the helm? I need full status."
    Mi "Cold Reaper, ¿quién está en el timón? Necesito información completa."

# game/Story03.rpy:3821

translate spanish akt3chapter3_69872871:

    # mc "Miriel?! That you?! What the hell are you doing here?!"
    mc "¿Qué diablos haces aquí?"

# game/Story03.rpy:3822

translate spanish akt3chapter3_7b014783:

    # Mi "[mc]? Patch me through to the lead pilot. Now."
    Mi "[mc]Pásame al piloto principal."

# game/Story03.rpy:3823

translate spanish akt3chapter3_a75b9746:

    # mc "I am the goddamn lead pilot!"
    mc "¡Soy el maldito piloto principal!"

# game/Story03.rpy:3825

translate spanish akt3chapter3_a134b853:

    # mc "And we’ve got a problem — fuel locks won’t seal. The whole thing’s held together with duct tape and prayers!"
    mc "Y tenemos un problema: las cerraduras de combustible no sella. Todo se mantiene junto con cinta de conducto y oraciones!"

# game/Story03.rpy:3831

translate spanish akt3chapter3_4297302a:

    # mc "Look outside. Fast!"
    mc "Mira afuera. ¡Rápido!"

# game/Story03.rpy:3833

translate spanish akt3chapter3_eaa1fd0b:

    # Mi "Bad. One's stuck. For good. If I pull it — we explode."
    Mi "Si me cago, explotamos."

# game/Story03.rpy:3835

translate spanish akt3chapter3_4bc14330:

    # mc "Wonderful. Just freaking great"
    mc "Maravilloso, solo que increíblemente"

# game/Story03.rpy:3836

translate spanish akt3chapter3_6a82a8c1:

    # mc "Tell me. Can you pull it out or not?!"
    mc "Dime. ¿Puedes sacarlo o no?"

# game/Story03.rpy:3838

translate spanish akt3chapter3_6619b253:

    # Mi "...Risk of blowing the whole bay. But yes. I can."
    Mi "...el ruido de volar toda la bahía, pero sí, puedo."

# game/Story03.rpy:3839

translate spanish akt3chapter3_34ff7d60:

    # mc "Then pull it. Better to blow now than wait till they tear us apart."
    mc "Entonces, mejor que volar ahora que esperar hasta que nos destrocen."

# game/Story03.rpy:3842

translate spanish akt3chapter3_7726fb4c:

    # Mi "(I can’t afford a mistake. Not for them. Not for all the elves inside.)"
    Mi "(No puedo permitirme un error. No para ellos. No para todos los elfos dentro.)"

# game/Story03.rpy:3843

translate spanish akt3chapter3_62bb6b73:

    # H "Reaper system activation. Initializing..."
    H "Activación del sistema de reaperación. Inicialización..."

# game/Story03.rpy:3848

translate spanish akt3chapter3_4a7b308c:

    # Mi "Beginning sweep."
    Mi "Comienzo de barrido."

# game/Story03.rpy:3851

translate spanish akt3chapter3_31d1872b:

    # mc "(So many lives hanging on this... So many eyes—on me.)"
    mc "(Muchas vidas colgando en esto... tantos ojos sobre mí.)"

# game/Story03.rpy:3852

translate spanish akt3chapter3_ee1d092e:

    # mc "(Focus. Breathe. Think...)"
    mc "(Focus. Respira. Piensa...)"

# game/Story03.rpy:3855

translate spanish akt3chapter3_b98d0cd4:

    # mc "(There you are, you bastard panel! COME ON!)"
    mc "¡Ahí estás, maldito panel!"

# game/Story03.rpy:3859

translate spanish akt3chapter3_d8d2e292:

    # mc "(IT WORKED! HOLY SHIT, IT’S WORKING!)"
    mc "¡Holy SHIT, está funcionando!"

# game/Story03.rpy:3861

translate spanish akt3chapter3_100e2981:

    # Mi "...That’ll slow them down."
    Mi "... Eso los reducirá."

# game/Story03.rpy:3864

translate spanish akt3chapter3_021cdd16:

    # mc "Miriel, get your ass out of there. We’re getting out."
    mc "Miriel, saca tu trasero de ahí."

# game/Story03.rpy:3876

translate spanish akt3chapter3_da6c1eb6:

    # mc "(Barely made it... thought it was over for a second...)"
    mc "(Lo hizo... pensó que había terminado por un segundo...)"

# game/Story03.rpy:3879

translate spanish akt3chapter3_d345d2cd:

    # mc "How’s everyone else?"
    mc "¿Cómo están todos los demás?"

# game/Story03.rpy:3881

translate spanish akt3chapter3_4b7353a4:

    # Mi "Mixed. Some are stitching themselves back together. Some are just lying still."
    Mi "Algunos se están cosiendo juntos, algunos están todavía acostados."

# game/Story03.rpy:3883

translate spanish akt3chapter3_095d8692:

    # mc "(Could use a bit of stitching myself, but…)"
    mc "(Podría usar un poco de coserme, pero...)"

# game/Story03.rpy:3884

translate spanish akt3chapter3_75cd710f:

    # mc "(As always, no time to think about myself.)"
    mc "(Como siempre, no hay tiempo para pensar en mí mismo.)"

# game/Story03.rpy:3885

translate spanish akt3chapter3_5cf1faeb:

    # mc "And you?"
    mc "¿Y tú?"

# game/Story03.rpy:3888

translate spanish akt3chapter3_aefae15e:

    # Mi "Counting losses."
    Mi "Contando pérdidas."

# game/Story03.rpy:3890

translate spanish akt3chapter3_ea7f6c81:

    # mc "(She came here... just to see me?)"
    mc "(Ella vino aquí... ¿para verme?)"

# game/Story03.rpy:3892

translate spanish akt3chapter3_94075107:

    # mc "Thanks, I guess."
    mc "Gracias, supongo."

# game/Story03.rpy:3894

translate spanish akt3chapter3_0a26bf77:

    # Mi "There’s an autopilot here."
    Mi "Hay un piloto automático aquí."

# game/Story03.rpy:3897

translate spanish akt3chapter3_f4a6cf1c:

    # mc "Wait, really?!"
    mc "¡Espera, en serio!"

# game/Story03.rpy:3906

translate spanish akt3chapter3_27dd6e80:

    # mc "You’ve got to be kidding me..."
    mc "Tienes que estar bromeando..."

# game/Story03.rpy:3908

translate spanish akt3chapter3_3d18f680:

    # Mi "Joking isn’t in my nature."
    Mi "El broma no está en mi naturaleza."

# game/Story03.rpy:3910

translate spanish akt3chapter3_db427f4c:

    # Mi "Better save your strength now."
    Mi "Mejor salve tu fuerza ahora."

# game/Story03.rpy:3911

translate spanish akt3chapter3_3acd2c07:

    # Mi "Where are the others?"
    Mi "¿Dónde están los otros?"

# game/Story03.rpy:3913

translate spanish akt3chapter3_ab0eb14b:

    # mc "Far as I know — Sector Three."
    mc "Por lo que sé, sector tres."

# game/Story03.rpy:3915

translate spanish akt3chapter3_c72dd2ac:

    # Mi "Understood."
    Mi "Entendido."

# game/Story03.rpy:3921

translate spanish akt3chapter3_a2b93d28:

    # mc "So… what about Winter? And the lower city?"
    mc "¿Y qué hay de Winter?"

# game/Story03.rpy:3924

translate spanish akt3chapter3_addbed3f:

    # Mi "He agreed."
    Mi "Él estuvo de acuerdo."

# game/Story03.rpy:3927

translate spanish akt3chapter3_b77ad661:

    # mc "Seriously?!"
    mc "¿En serio?"

# game/Story03.rpy:3930

translate spanish akt3chapter3_42a9d288:

    # Mi "He didn’t have a choice."
    Mi "No tenía elección."

# game/Story03.rpy:3934

translate spanish akt3chapter3_52649b70:

    # mc "Honestly didn’t see that coming. He struck me as the kind of man who never backs down."
    mc "Sinceramente no lo vio venir. Me golpeó como el tipo de hombre que nunca se apoya."

# game/Story03.rpy:3937

translate spanish akt3chapter3_015dd9d8:

    # Mi "When it’s the ones you love on the line — pride means nothing."
    Mi "Cuando son los que amas en la línea, el orgullo no significa nada."

# game/Story03.rpy:3939

translate spanish akt3chapter3_698e7949:

    # mc "You’ve had to make that choice too, haven’t you?"
    mc "También has tenido que elegir, ¿no?"

# game/Story03.rpy:3941

translate spanish akt3chapter3_7ffa6c43:

    # Mi "It’s not a ‘had to’. It’s just how things are."
    Mi "No es un ‘tenido’. Es solo cómo son las cosas."

# game/Story03.rpy:3947

translate spanish akt3chapter3_da67fb92:

    # mc "No choice, huh..."
    mc "No hay elección, eh..."

# game/Story03.rpy:3949

translate spanish akt3chapter3_4a4a0fcc:

    # mc "And the ones with you… all of them?"
    mc "Y los que están contigo... ¿todos?"

# game/Story03.rpy:3950

translate spanish akt3chapter3_d4bb0e92:

    # Mi "The ones I managed to pull out."
    Mi "Las que logré sacar."

# game/Story03.rpy:3951

translate spanish akt3chapter3_111fb31d:

    # mc "So… not all."
    mc "Así que... no todo."

# game/Story03.rpy:3952

translate spanish akt3chapter3_95ce11d4:

    # Mi "The rest were taken by Yong."
    Mi "El resto fue tomado por Yong."

# game/Story03.rpy:3953

translate spanish akt3chapter3_0614a5a9:

    # mc "But where are you headed now?"
    mc "¿Pero a dónde vas ahora?"

# game/Story03.rpy:3954

translate spanish akt3chapter3_7e4480d9:

    # Mi "Safe zone. After that — doesn’t matter."
    Mi "Zona segura. Después de eso — no importa."

# game/Story03.rpy:3955

translate spanish akt3chapter3_46fe282c:

    # mc "Got it..."
    mc "Lo tengo..."

# game/Story03.rpy:3959

translate spanish akt3chapter3_e26ea0f8:

    # mc "About what happened… I’m sorry I vanished like that."
    mc "Sobre lo que pasó... Siento haber desaparecido así."

# game/Story03.rpy:3965

translate spanish akt3chapter3_ac5d8a1e:

    # Mi "They told me what happened."
    Mi "Me dijeron lo que pasó."

# game/Story03.rpy:3966

translate spanish akt3chapter3_a5019b35:

    # Mi "I’d have done the same."
    Mi "Yo habría hecho lo mismo."

# game/Story03.rpy:3968

translate spanish akt3chapter3_a7a5c89c:

    # mc "So you’re not mad?"
    mc "¿Así que no estás enfadado?"

# game/Story03.rpy:3976

translate spanish akt3chapter3_1111532b:

    # Mi "We’re even."
    Mi "Estamos a mano."

# game/Story03.rpy:3977

translate spanish akt3chapter3_59169f25:

    # Mi "And… how is she?"
    Mi "Y... ¿cómo está?"

# game/Story03.rpy:3980

translate spanish akt3chapter3_f835a620:

    # mc "Who do you mean?"
    mc "¿A quién quieres decir?"

# game/Story03.rpy:3982

translate spanish akt3chapter3_b9a57403:

    # Mi "The one you’re here for."
    Mi "El que estás aquí para."

# game/Story03.rpy:3984

translate spanish akt3chapter3_c5d19339:

    # mc "...You mean Lora? It’s complicated. She’s changed. Too much."
    mc "...¿Quieres decir Lora? Es complicado. Ella ha cambiado. Demasiado."

# game/Story03.rpy:3985

translate spanish akt3chapter3_e6ea2897:

    # mc "I still recognize her... but deep down, something says — that’s not the same Lora."
    mc "Todavía la reconozco... pero en lo profundo, algo dice — eso no es lo mismo Lora."

# game/Story03.rpy:3987

translate spanish akt3chapter3_6757d0fc:

    # mc "I thought once we met again, everything would go back to how it was."
    mc "Pensé que una vez que nos conocimos, todo volvería a ser como era."

# game/Story03.rpy:3988

translate spanish akt3chapter3_8bf4c9d8:

    # mc "But I was wrong. We both changed. And…"
    mc "Pero estaba equivocado, ambos cambiamos y..."

# game/Story03.rpy:3990

translate spanish akt3chapter3_65c577a3:

    # Mi "You carry too much on your shoulders."
    Mi "Llevas demasiado sobre tus hombros."

# game/Story03.rpy:3992

translate spanish akt3chapter3_a455fcb2:

    # mc "Maybe… But if not me, then who?"
    mc "Tal vez... pero si no yo, ¿quién?"

# game/Story03.rpy:3994

translate spanish akt3chapter3_ce76d0ff:

    # mc "She’s been through so much. I have to try. Somehow."
    mc "Ha pasado por mucho. Tengo que intentarlo."

# game/Story03.rpy:3996

translate spanish akt3chapter3_641dcf98:

    # mc "(That’s right, [mc], even if it means losing yourself…)"
    mc "(Eso es correcto, [mc], incluso si significa perderse...)"

# game/Story03.rpy:4001

translate spanish akt3chapter3_bde4ed72:

    # Mi "You once told me: asking for help isn’t weakness."
    Mi "Una vez me dijiste: pedir ayuda no es debilidad."

# game/Story03.rpy:4003

translate spanish akt3chapter3_abb4083f:

    # mc "Maybe you’re right, but…"
    mc "Tal vez tengas razón, pero..."

# game/Story03.rpy:4014

translate spanish akt3chapter3_3489aed8:

    # Mi "You’re doing it."
    Mi "Lo estás haciendo."

# game/Story03.rpy:4015

translate spanish akt3chapter3_c648ff15:

    # Mi "Not everyone could."
    Mi "No todos podían."

# game/Story03.rpy:4017

translate spanish akt3chapter3_d9956fbf:

    # mc "But this is different. Lives depend on me."
    mc "Pero esto es diferente, las vidas dependen de mí."

# game/Story03.rpy:4019

translate spanish akt3chapter3_f9991d93:

    # mc "If I break — it all collapses."
    mc "Si me rompe, todo se derrumba."

# game/Story03.rpy:4023

translate spanish akt3chapter3_eb6c1032:

    # Mi "Enough."
    Mi "Suficiente."

# game/Story03.rpy:4024

translate spanish akt3chapter3_a2f3f1cd:

    # Mi "I don’t care what kind of nonsense you’ve built up in your head."
    Mi "No me importa qué clase de tonterías has acumulado en tu cabeza."

# game/Story03.rpy:4026

translate spanish akt3chapter3_14767483:

    # Mi "You’re not alone. I’m with you. Whatever that means, whatever it takes. Got it?"
    Mi "No estás solo. Estoy contigo. Lo que sea que sea necesario, lo que sea. ¿Lo entiendes?"

# game/Story03.rpy:4029

translate spanish akt3chapter3_bf930c05:

    # mc "(She’s so close… and her hand’s trembling…)"
    mc "(Está tan cerca... y su mano temblando...)"

# game/Story03.rpy:4031

translate spanish akt3chapter3_ab2d6bae:

    # mc "You’re shaking… Are you okay?"
    mc "Te estás agitando... ¿Estás bien?"

# game/Story03.rpy:4033

translate spanish akt3chapter3_c8c91fa9:

    # Mi "I don’t know…"
    Mi "No sé..."

# game/Story03.rpy:4035

translate spanish akt3chapter3_88342d7a:

    # mc "(Her eyes… so much pain… and hope?)"
    mc "(Sus ojos... tanto dolor... y esperanza?)"

# game/Story03.rpy:4045

translate spanish akt3chapter3_c6ced3b3:

    # Mi "No…"
    Mi "No..."

# game/Story03.rpy:4046

translate spanish akt3chapter3_7b150c53:

    # mc "Miriël—"
    mc "Miriël..."

# game/Story03.rpy:4049

translate spanish akt3chapter3_37c761dc:

    # Mi "I’m sorry. That was a mistake."
    Mi "Lo siento, fue un error."

# game/Story03.rpy:4051

translate spanish akt3chapter3_a0d8248b:

    # mc "(No… it wasn’t. Just… too sudden.)"
    mc "(No... no lo fue. Solo... demasiado repentino.)"

# game/Story03.rpy:4053

translate spanish akt3chapter3_85d135e3:

    # mc "(I wonder… if things had gone differently… could I have held on to her?)"
    mc "(Me pregunto... si las cosas habían ido de forma diferente... ¿podría haberle mantenido?)"

# game/Story03.rpy:4070

translate spanish akt3chapter3_eab69095:

    # Fl "Come on, dammit, don’t break on me now. Just a little more…"
    Fl "Vamos, maldición, no me rompas ahora."

# game/Story03.rpy:4073

translate spanish akt3chapter3_66702ac3:

    # Fl "If you’re not some Empire-flash drive full of secrets — get lost."
    Fl "Si no eres un viaje de Empire-flash lleno de secretos, pierdete."

# game/Story03.rpy:4075

translate spanish akt3chapter3_2f1695d8:

    # em "Still no luck?"
    em "¿Todavía no hay suerte?"

# game/Story03.rpy:4078

translate spanish akt3chapter3_0ace4b5a:

    # Fl "Ah, Ember. It’s you."
    Fl "Ah, Ember. Eres tú."

# game/Story03.rpy:4080

translate spanish akt3chapter3_3f37f5e6:

    # Fl "No. The damn thing’s encrypted like the Emperor himself was scared it’d be read."
    Fl "No. La maldita cosa está encriptada como el Emperador mismo tenía miedo de que se lea."

# game/Story03.rpy:4083

translate spanish akt3chapter3_5495681b:

    # Fl "Dad risked his life for this."
    Fl "Papá arriesgó su vida por esto."

# game/Story03.rpy:4088

translate spanish akt3chapter3_1fba655c:

    # Fl "And me… I can’t even peek inside. Hilarious, huh?"
    Fl "Y yo... ni siquiera puedo mirar dentro."

# game/Story03.rpy:4090

translate spanish akt3chapter3_c0c4dd5e:

    # em "Giving up?"
    em "¿Te vas?"

# game/Story03.rpy:4093

translate spanish akt3chapter3_d8656051:

    # Fl "Give up?! Yeah, right. Let my whole damn bloodline burn, but I’m finishing this."
    Fl "¿Desarrollar?! Sí, claro. Deja que mi maldito linaje queme, pero estoy terminando esto."

# game/Story03.rpy:4094

translate spanish akt3chapter3_ee355051:

    # Fl "(whispering) I won’t give up. Ever."
    Fl "No me rendiré."

# game/Story03.rpy:4097

translate spanish akt3chapter3_8b482f5c:

    # Fl "So, what are you here for?"
    Fl "¿Para qué estás aquí?"

# game/Story03.rpy:4099

translate spanish akt3chapter3_383da142:

    # em "Wanted to make sure the genius hadn’t burned out in her own chains."
    em "Quería asegurarse de que el genio no se había quemado en sus propias cadenas."

# game/Story03.rpy:4104

translate spanish akt3chapter3_da1542f9:

    # Fl "You’d be surprised how fast this place turns a genius into a leper."
    Fl "Te sorprendería lo rápido que este lugar convierte a un genio en un leproso."

# game/Story03.rpy:4107

translate spanish akt3chapter3_6152b93f:

    # Fl "To them, I’m just the girl who signed the death warrant for hundreds — oh, sorry — four thousand. Classic, right?"
    Fl "Para ellos, soy solo la chica que firmó la orden de muerte para cientos — oh, lo siento — cuatro mil. Clásico, ¿verdad?"

# game/Story03.rpy:4110

translate spanish akt3chapter3_914bd3c3:

    # em "In exchange for three hundred thousand mutants."
    em "A cambio de trescientos mil mutantes."

# game/Story03.rpy:4113

translate spanish akt3chapter3_eae975ce:

    # Fl "At the cost of almost everyone who still believed in my father. At the cost of any hope for justice."
    Fl "A costa de casi todos los que todavía creían en mi padre, a costa de cualquier esperanza de justicia."

# game/Story03.rpy:4115

translate spanish akt3chapter3_dde49483:

    # em "We’re all going to die, Flora. That’s not the question. The question is how we lived. And for what."
    em "Todos vamos a morir, Flora. Esa no es la pregunta. La pregunta es cómo vivimos. Y para qué."

# game/Story03.rpy:4121

translate spanish akt3chapter3_5fcddb7f:

    # em "They went out as heroes."
    em "Salieron como héroes."

# game/Story03.rpy:4123

translate spanish akt3chapter3_c536bb12:

    # Fl "And we stayed behind."
    Fl "Y nos quedamos atrás."

# game/Story03.rpy:4125

translate spanish akt3chapter3_14363cb2:

    # Fl "To watch it all spiral into the abyss. To watch everything they fought for get erased. To watch no one be held accountable."
    Fl "Para verlo todo en espiral en el abismo. Para ver todo lo que lucharon por ser borrados. Para ver a nadie ser considerado responsable."

# game/Story03.rpy:4127

translate spanish akt3chapter3_49d9212f:

    # em "Command’s a joke. Bureaucrats with implants where their souls should be."
    em "Comando es una broma. Burócratas con implantes donde sus almas deben estar."

# game/Story03.rpy:4130

translate spanish akt3chapter3_45bc6053:

    # em "To them, you’re just a number. Your people — numbers. The dead — statistics."
    em "Para ellos, usted es solo un número. Su gente — números. Los muertos— estadísticas."

# game/Story03.rpy:4132

translate spanish akt3chapter3_5a009dc8:

    # em "People like them will rot on their thrones till they tear each other apart."
    em "La gente como ellos se pudra en sus tronos hasta que se desgarren."

# game/Story03.rpy:4136

translate spanish akt3chapter3_633b408d:

    # Fl "That’s why I’m angry. We let the innocent die."
    Fl "Por eso estoy enojada. Dejamos morir a los inocentes."

# game/Story03.rpy:4138

translate spanish akt3chapter3_78263d4d:

    # Fl "We keep making the same damn mistake."
    Fl "Seguimos cometiendo el mismo error."

# game/Story03.rpy:4140

translate spanish akt3chapter3_0c4df5ee:

    # em "You take after your mother…"
    em "Tú llevas a tu madre..."

# game/Story03.rpy:4142

translate spanish akt3chapter3_546e0809:

    # Fl "No. She was naive. Wanted to change the world — and it devoured her alive."
    Fl "No. Ella era ingenua. Quería cambiar el mundo — y la devoró viva."

# game/Story03.rpy:4145

translate spanish akt3chapter3_09013f97:

    # em "You’d know best."
    em "Lo sabrías mejor."

# game/Story03.rpy:4147

translate spanish akt3chapter3_f2b5c327:

    # em "If you ever need help — just say the word."
    em "Si alguna vez necesitas ayuda, solo di la palabra."

# game/Story03.rpy:4150

translate spanish akt3chapter3_b45d1f37:

    # Fl "Thanks, but… I don’t know how to share the weight. I’m used to dragging it all myself."
    Fl "Gracias, pero... no sé compartir el peso. Estoy acostumbrado a arrastrarlo todo yo mismo."

# game/Story03.rpy:4160

translate spanish akt3chapter3_70a8ebbe:

    # em "And yet you’ll pull it off."
    em "Y sin embargo lo sacarás."

# game/Story03.rpy:4162

translate spanish akt3chapter3_b7abe60d:

    # Fl "I know. That’s the problem."
    Fl "Lo sé. Ese es el problema."

# game/Story03.rpy:4170

translate spanish akt3chapter3_e5cb2fab:

    # Fl "What?"
    Fl "¿Qué?"

# game/Story03.rpy:4173

translate spanish akt3chapter3_f4a0a42e:

    # em "Skarlea’s already here."
    em "Skarlea ya está aquí."

# game/Story03.rpy:4177

translate spanish akt3chapter3_22f4b2c7:

    # Fl "What?!"
    Fl "¿Qué?"

# game/Story03.rpy:4178

translate spanish akt3chapter3_b758aba5:

    # Fl "What the hell is she doing in my sector?!"
    Fl "¿Qué diablos está haciendo en mi sector?!"

# game/Story03.rpy:4182

translate spanish akt3chapter3_633f4323:

    # em "Ask her yourself. If you dare."
    em "Pregúntale tú mismo, si te atreves."

# game/Story03.rpy:4184

translate spanish akt3chapter3_e5bb6c27:

    # scar "(Hmm… Security system — 2 out of 10.)"
    scar "(Hmm... sistema de seguridad - 2 de 10.)"

# game/Story03.rpy:4186

translate spanish akt3chapter3_3337434e:

    # gg "Commander, multiple hostiles en route to the lower city."
    gg "Comandante, varios hostiles en camino a la ciudad baja."

# game/Story03.rpy:4187

translate spanish akt3chapter3_0411fed6:

    # gg "Looks like the second mutant wave."
    gg "Parece la segunda ola mutante."

# game/Story03.rpy:4189

translate spanish akt3chapter3_9c3dce77:

    # g "Syndicate territory? Do not engage."
    g "¿Territorio sindicado? No te involucres."

# game/Story03.rpy:4190

translate spanish akt3chapter3_e705ef17:

    # gg "Sir, but that’s not tactica—"
    gg "Señor, pero eso no es táctica..."

# game/Story03.rpy:4191

translate spanish akt3chapter3_f08b439a:

    # g "Stand down."
    g "¡Abajo!"

# game/Story03.rpy:4194

translate spanish akt3chapter3_0070e140:

    # gggg "Unidentified object heading straight for us."
    gggg "Objeto no identificado dirigiéndose directamente hacia nosotros."

# game/Story03.rpy:4195

translate spanish akt3chapter3_4c53a510:

    # gggg "From the cargo bays, possibly a transport."
    gggg "Desde las bahías de carga, posiblemente un transporte."

# game/Story03.rpy:4196

translate spanish akt3chapter3_5bb05914:

    # g "Any response from the pilot?"
    g "¿Alguna respuesta del piloto?"

# game/Story03.rpy:4198

translate spanish akt3chapter3_9c7cec87:

    # gg "No. No reply."
    gg "No, no hay respuesta."

# game/Story03.rpy:4199

translate spanish akt3chapter3_4da78630:

    # gg "Last known location — lower city."
    gg "Última ubicación conocida: ciudad baja."

# game/Story03.rpy:4201

translate spanish akt3chapter3_323dbd60:

    # g "Open fire."
    g "Abran fuego."

# game/Story03.rpy:4202

translate spanish akt3chapter3_b3a3fccb:

    # gg "But—"
    gg "Pero..."

# game/Story03.rpy:4203

translate spanish akt3chapter3_310d3096:

    # g "Do it."
    g "Hazlo."

# game/Story03.rpy:4218

translate spanish akt3chapter3_7972d9a9:

    # mc "Lower city?.. Oh, shit."
    mc "¿Ciudad baja?"

# game/Story03.rpy:4220

translate spanish akt3chapter3_f65a64fb:

    # mc "(If it’s that much of a slaughter down below…)"
    mc "(Si es que mucho de una masacre abajo...)"

# game/Story03.rpy:4222

translate spanish akt3chapter3_64e854d0:

    # mc "(What's going on up top?..)"
    mc "(¿Qué está pasando ahí arriba?)"

# game/Story03.rpy:4226

translate spanish akt3chapter3_0f69fa0f:

    # mc "(What the—)"
    mc "(Lo que el--)"

# game/Story03.rpy:4233

translate spanish akt3chapter3_f66dbfff:

    # mc "No. Not this."
    mc "No, esto no."

# game/Story03.rpy:4236

translate spanish akt3chapter3_806995fa:

    # a "Focus. Panic comes later."
    a "El pánico viene más tarde."

# game/Story03.rpy:4237

translate spanish akt3chapter3_c9ba6e42:

    # a "Status."
    a "Estado."

# game/Story03.rpy:4239

translate spanish akt3chapter3_a6ee4205:

    # mc "Someone’s out to make ends meet—"
    mc "Alguien está fuera para hacer finos encuentros..."

# game/Story03.rpy:4240

translate spanish akt3chapter3_bdeb668e:

    # mc "—and doing a damn good job at it."
    mc "-y haciendo un buen trabajo en ello."

# game/Story03.rpy:4242

translate spanish akt3chapter3_7be646ee:

    # a "Time to target?"
    a "¿Tiempo de blanco?"

# game/Story03.rpy:4244

translate spanish akt3chapter3_3cddec90:

    # mc "No clue. Everything’s gone sideways."
    mc "No hay pista. Todo se ha ido de la raya."

# game/Story03.rpy:4246

translate spanish akt3chapter3_22d327a1:

    # a "I’ll handle it. You just get us there faster."
    a "Yo me encargaré de ello. Solo tienes que llevarnos allí más rápido."

# game/Story03.rpy:4248

translate spanish akt3chapter3_456bef91:

    # mc "Copy that."
    mc "Entendido."

# game/Story03.rpy:4251

translate spanish akt3chapter3_b2a032e6:

    # a "(Time to test this beast.)"
    a "(Hora de probar esta bestia.)"

# game/Story03.rpy:4255

translate spanish akt3chapter3_0c9c8e31:

    # H "Auto-turret system: Switching to manual control."
    H "Sistema de arranque automático: conmutación a control manual."

# game/Story03.rpy:4257

translate spanish akt3chapter3_8046d5bb:

    # a "Manual mode. Target in sight."
    a "Modo manual."

# game/Story03.rpy:4267

translate spanish akt3chapter3_1f8c1651:

    # mc "(I'll do it, sure — but how?! I’ve no idea how this thing even works!)"
    mc "(Lo haré, por supuesto - pero ¿cómo?! Ni siquiera sé cómo funciona esta cosa!)"

# game/Story03.rpy:4268

translate spanish akt3chapter3_9c89bead:

    # mc "(Well, if I’m meant to die today… so be it.)"
    mc "(Bueno, si estoy destinado a morir hoy... así que sea.)"

# game/Story03.rpy:4272

translate spanish akt3chapter3_b1040de0:

    # mc "Brace yourselves! It’s gonna be a hell of a ride!"
    mc "¡Abranse! ¡Va a ser un viaje de un infierno!"

# game/Story03.rpy:4275

translate spanish akt3chapter3_595ef682:

    # gg "We’ll chew through it. {w=0.2}Missile, eight o’clock!"
    gg "Lo masticaremos. {w=0.2}¡Misile, a las ocho!"

# game/Story03.rpy:4277

translate spanish akt3chapter3_26c56264:

    # a "Neutralized."
    a "Neutralizada."

# game/Story03.rpy:4278

translate spanish akt3chapter3_78b18c5f:

    # gg "Another one! Four o’clock!"
    gg "¡Otra! ¡Cuatro en punto!"

# game/Story03.rpy:4280

translate spanish akt3chapter3_d213e880:

    # k "This baby’s mine."
    k "Este bebé es mío."

# game/Story03.rpy:4281

translate spanish akt3chapter3_b4a10064:

    # k "(whispering) Time to break the boredom..."
    k "Hora de romper el aburrimiento..."

# game/Story03.rpy:4283

translate spanish akt3chapter3_08d42f97:

    # mc "Kalestra?! What the hell are you doing?! Get back inside!"
    mc "Kalestra!!"

# game/Story03.rpy:4285

translate spanish akt3chapter3_b5409310:

    # k "Relax, I’ve got this. {w=0.2}Kinda."
    k "Relájate, tengo esto. {w=0.2}Algo así."

# game/Story03.rpy:4287

translate spanish akt3chapter3_5e9225ed:

    # k "Everything's..."
    k "Todo..."

# game/Story03.rpy:4292

translate spanish akt3chapter3_da6c618b:

    # k "…under control!"
    k "... bajo control!"

# game/Story03.rpy:4294

translate spanish akt3chapter3_0f332379:

    # mc "(She… she actually did it?!)"
    mc "(Ella... ella realmente lo hizo?!)"

# game/Story03.rpy:4295

translate spanish akt3chapter3_f2d44c20:

    # mc "(A missile... with a sword?!)"
    mc "(Un misil... con una espada?!)"

# game/Story03.rpy:4297

translate spanish akt3chapter3_9799ebb7:

    # mc "(How is that even possible?!)"
    mc "(¿Cómo es posible?!)"

# game/Story03.rpy:4298

translate spanish akt3chapter3_f4a93051:

    # mc "(Note to self: Do not piss her off. {w=0.4}Ever.)"
    mc "No te enojes. {w=0.4}Nunca.)"

# game/Story03.rpy:4300

translate spanish akt3chapter3_68f24920:

    # mc "(Okay, focus, [mc], we’re almost there.)"
    mc "(Ok, concéntrate, [mc], estamos casi allí.)"

# game/Story03.rpy:4303

translate spanish akt3chapter3_914c7109:

    # mc "(There’s the command post!)"
    mc "(¡Hay el puesto de comando!)"

# game/Story03.rpy:4305

translate spanish akt3chapter3_bda9abd0:

    # mc "We’re almost there — hold tight!"
    mc "Estamos casi allí - ¡Manténganse apretados!"

# game/Story03.rpy:4309

translate spanish akt3chapter3_6edadb59:

    # mc "(What the — fuel!)"
    mc "(¡Qué combustible!)"

# game/Story03.rpy:4310

translate spanish akt3chapter3_9b80b661:

    # mc "We’re out!"
    mc "¡Nos vamos!"

# game/Story03.rpy:4311

translate spanish akt3chapter3_73045ce4:

    # gg "What?! So we’re crashing?!"
    gg "¿Qué?! Entonces nos estamos estrellando?!"

# game/Story03.rpy:4314

translate spanish akt3chapter3_4824fdf1:

    # k "Perfect. We'll die the way we lived — beautifully and unpredictably."
    k "Moriremos de la forma en que vivimos, bella e impredecible."

# game/Story03.rpy:4317

translate spanish akt3chapter3_3ecba540:

    # a "Situation?"
    a "¿Situación?"

# game/Story03.rpy:4319

translate spanish akt3chapter3_6602183e:

    # mc "We’re flying straight to hell!"
    mc "¡Estamos volando directo al infierno!"

# game/Story03.rpy:4326

translate spanish akt3chapter3_12d7e588:

    # a "{font=Cybertron.otf}Something in a strange language."
    a "{font=Cybertron.otf}Algo en un lenguaje extraño."

# game/Story03.rpy:4339

translate spanish akt3chapter3_b7397781:

    # Mi "(Why did I run back then…? How can I face him now? I'm just... a coward.)"
    Mi "¿Cómo puedo verlo a los ojos ahora?"

# game/Story03.rpy:4341

translate spanish akt3chapter3_46e3aa9c:

    # Mi "(Maybe later...)"
    Mi "(Quizás más tarde...)"

# game/Story03.rpy:4345

translate spanish akt3chapter3_9dfe1752:

    # Mi "(That’s... {w=0.5}a portal to the Abyss?! {w=0.5}Impossible…)"
    Mi "(Eso es... {w=0.5}¿un portal al Abyss? {w=0.5}Imposible...)"

# game/Story03.rpy:4347

translate spanish akt3chapter3_38889da3:

    # mc "(What the fuck is that?!)"
    mc "(¿Qué mierda es eso?!)"

# game/Story03.rpy:4349

translate spanish akt3chapter3_a612d350:

    # mc "(No, no, no. I’m not dying here. And I won’t let the others either!)"
    mc "(No, no, no. No estoy muriendo aquí. Y tampoco voy a dejar a los otros!)"

# game/Story03.rpy:4351

translate spanish akt3chapter3_7fcf8609:

    # mc "(Please... don’t let this be the end...)"
    mc "(Por favor... no dejes que esto sea el final...)"

# game/Story03.rpy:4363

translate spanish akt3chapter3_0edcb57a:

    # gggg "We can't reach the crew, sir."
    gggg "No podemos contactar con la tripulación, señor."

# game/Story03.rpy:4364

translate spanish akt3chapter3_61d49a58:

    # gggg "Might be a system failure."
    gggg "Podría ser un fracaso del sistema."

# game/Story03.rpy:4365

translate spanish akt3chapter3_f6c2a4c8:

    # g "I don’t like this..."
    g "No me gusta esto..."

# game/Story03.rpy:4369

translate spanish akt3chapter3_2bdb71c8:

    # g "Deploy Assault Group Three. We need to be ready for anything."
    g "Despliegue el Grupo de asalto Tres."

# game/Story03.rpy:4370

translate spanish akt3chapter3_c231ac4f:

    # g "(quietly) Feels like… the calm before the storm. {w}Let’s just not end up in its eye."
    g "Se siente como... la calma antes de la tormenta. {w}No terminemos en su ojo."

# game/Story03.rpy:4376

translate spanish akt3chapter3_609dfaee:

    # gg "We’re alive…"
    gg "Estamos vivos..."

# game/Story03.rpy:4379

translate spanish akt3chapter3_534bf4b6:

    # ggg "YES!"
    ggg "¡Sí!"

# game/Story03.rpy:4383

translate spanish akt3chapter3_0a4ea72a:

    # k "(whispering) Not exactly a genius performance, sis."
    k "No es exactamente una actuación genial, hermana."

# game/Story03.rpy:4384

translate spanish akt3chapter3_711d7e7a:

    # k "(whispering) You look like a character on the edge of a breakdown."
    k "Pareces un personaje en el borde de una ruptura."

# game/Story03.rpy:4387

translate spanish akt3chapter3_e4ae307f:

    # a "That’s for me to decide."
    a "Eso es para mí decidir."

# game/Story03.rpy:4390

translate spanish akt3chapter3_ede1a015:

    # k "(whispering) Sure. Just don’t say I didn’t cue my line on time."
    k "(susurando) Claro. Simplemente no digas que no he dado mi línea a tiempo."

# game/Story03.rpy:4392

translate spanish akt3chapter3_6cdd9a83:

    # ry "Tell me I didn’t just see what I think I saw—"
    ry "Dime que no solo vi lo que creo que vi..."

# game/Story03.rpy:4394

translate spanish akt3chapter3_97742ae2:

    # el "The Abyss… That word alone terrifies entire nations."
    el "El Abismo... esa palabra solo aterroriza a naciones enteras."

# game/Story03.rpy:4395

translate spanish akt3chapter3_d9ae0a26:

    # el "To see it with our own eyes… We’re damn lucky."
    el "Para verlo con nuestros propios ojos... tenemos mucha suerte."

# game/Story03.rpy:4397

translate spanish akt3chapter3_968b082c:

    # ry "I’m not sure what’s more shocking — seeing it, or surviving it?"
    ry "No estoy seguro de qué es más impactante, verlo o sobrevivirlo?"

# game/Story03.rpy:4399

translate spanish akt3chapter3_e494d3a5:

    # el "One thing’s certain. The world will be furious."
    el "Una cosa es cierta. El mundo estará furioso."

# game/Story03.rpy:4401

translate spanish akt3chapter3_b14f21fa:

    # el "And there’s the— Oh no. That’s bad. Very bad."
    el "Y hay el-- Oh no. Eso es malo. Muy malo."

# game/Story03.rpy:4406

translate spanish akt3chapter3_2bdcde07:

    # el "Wait, Mir, don’t do anything stupid."
    el "Espera, Mir, no hagas nada estúpido."

# game/Story03.rpy:4409

translate spanish akt3chapter3_6b2041c5:

    # Mi "Not now, Eleyna."
    Mi "Ahora no, Eleyna."

# game/Story03.rpy:4413

translate spanish akt3chapter3_80fd3988:

    # Mi "What did you just do?!"
    Mi "¿Qué acabas de hacer?!"

# game/Story03.rpy:4417

translate spanish akt3chapter3_8aff3a4c:

    # a "Alive. That’s enough."
    a "Vivo. ¡Basta!"

# game/Story03.rpy:4419

translate spanish akt3chapter3_f3de89f7:

    # Mi "You think you saved us?! You almost killed us all!"
    Mi "¿Crees que nos salvaste? ¡Casi nos matas a todos!"

# game/Story03.rpy:4420

translate spanish akt3chapter3_91805d28:

    # Mi "Their use is forbidden! Or did you forget?!"
    Mi "¡Su uso está prohibido! ¿O lo olvidaste?"

# game/Story03.rpy:4423

translate spanish akt3chapter3_0d3c6ebc:

    # Mi "How it swallowed half a galaxy?!"
    Mi "¿Cómo se tragó la mitad de una galaxia?"

# game/Story03.rpy:4426

translate spanish akt3chapter3_02e3ac60:

    # k "(Well done. Another disaster for your trophy shelf, sis.)"
    k "Otro desastre para tu estante de trofeos, hermana."

# game/Story03.rpy:4428

translate spanish akt3chapter3_431107f3:

    # Mi "Answer me!"
    Mi "¡Contéstame!"

# game/Story03.rpy:4431

translate spanish akt3chapter3_ec6d64e4:

    # a "You were trembling. I acted."
    a "Estabas temblando, actué."

# game/Story03.rpy:4432

translate spanish akt3chapter3_84a84d51:

    # a "And I’ll do it again if I have to."
    a "Y lo haré de nuevo si tengo que hacerlo."

# game/Story03.rpy:4434

translate spanish akt3chapter3_f44abf61:

    # Mi "You arro—"
    Mi "Tú arro..."

# game/Story03.rpy:4437

translate spanish akt3chapter3_98b9c60f:

    # el "Mir, please… This isn’t the time."
    el "Mir, por favor... no es el momento."

# game/Story03.rpy:4442

translate spanish akt3chapter3_30dbbf74:

    # el "We need to take care of them."
    el "Tenemos que cuidarlos."

# game/Story03.rpy:4446

translate spanish akt3chapter3_d041895d:

    # Mi "Yeah… I lost it a little."
    Mi "Sí... lo perdí un poco."

# game/Story03.rpy:4449

translate spanish akt3chapter3_beec8655:

    # el "You keep surprising me more every damn time!"
    el "¡Me sigues sorprendiendo cada vez más!"

# game/Story03.rpy:4452

translate spanish akt3chapter3_1b3a695b:

    # mc "(That’s the angriest I’ve ever seen her…)"
    mc "(Esa es la más molesta que he visto...)"

# game/Story03.rpy:4454

translate spanish akt3chapter3_07b37587:

    # mc "(But why?)"
    mc "(Pero, ¿por qué?)"

# game/Story03.rpy:4457

translate spanish akt3chapter3_130d6f7b:

    # mc "That was… the Abyss, wasn’t it?"
    mc "Eso fue... el Abyss, ¿no?"

# game/Story03.rpy:4459

translate spanish akt3chapter3_cfd59a51:

    # a "One of its borders. I crossed it — for all of us."
    a "Una de sus fronteras. La cruzé —para todos nosotros."

# game/Story03.rpy:4461

translate spanish akt3chapter3_5abbee45:

    # mc "(Right. Only high elves can open it… Is she one of them?)"
    mc "(Verdad. Solo los elfos altos pueden abrirla... ¿Es ella una de ellas?)"

# game/Story03.rpy:4463

translate spanish akt3chapter3_054c5ee0:

    # mc "I see."
    mc "Ya veo."

# game/Story03.rpy:4465

translate spanish akt3chapter3_78939b24:

    # mc "(No, better not bring it up now.)"
    mc "(No, mejor no lo traigan ahora)."

# game/Story03.rpy:4466

translate spanish akt3chapter3_77ccc3ba:

    # mc "(They’re all too wound up.)"
    mc "(Están todos muy heridos.)"

# game/Story03.rpy:4469

translate spanish akt3chapter3_335c4834:

    # k "(Ah, nailed it.)"
    k "(Ah, la clavaron)."

# game/Story03.rpy:4470

translate spanish akt3chapter3_4e8bdf3d:

    # mc "By the way — this is the command center, right?"
    mc "Por cierto, este es el centro de mando, ¿verdad?"

# game/Story03.rpy:4471

translate spanish akt3chapter3_c7baea77:

    # mc "Then where is everyo—"
    mc "Entonces, ¿dónde está cada uno?"

# game/Story03.rpy:4476

translate spanish akt3chapter3_8ad8a4d9:

    # ggg "Nobody move—"
    ggg "Nadie se mueve..."

# game/Story03.rpy:4477

translate spanish akt3chapter3_fe13fe0b:

    # ggg "Inquisition?!"
    ggg "¿Inquisición?"

# game/Story03.rpy:4481

translate spanish akt3chapter3_d67f1ed2:

    # ggg "Our deepest apologies!"
    ggg "¡Nuestras disculpas más profundas!"

# game/Story03.rpy:4484

translate spanish akt3chapter3_4041d7f0:

    # k "Hm… Attention, reverence, drawn pistols — how sweet. {w}All for me?"
    k "Atención, reverencia, pistolas dibujadas — qué dulce. {w}¿Todo para mí?"

# game/Story03.rpy:4486

translate spanish akt3chapter3_2b785d99:

    # a "Don't start. They're scared of your presence."
    a "Te tienen miedo de estar aquí."

# game/Story03.rpy:4489

translate spanish akt3chapter3_5c1b6518:

    # k "Boring... {w}I was hoping for screams."
    k "Aburrido... {w}Esperaba gritos."

# game/Story03.rpy:4491

translate spanish akt3chapter3_e5620868:

    # a "Who's in command here?"
    a "¿Quién está a cargo aquí?"

# game/Story03.rpy:4494

translate spanish akt3chapter3_35c4dd6e:

    # Fl "Punctuality isn’t your strength — neither is strategic thinking."
    Fl "La puntualidad no es tu fuerza, ni tampoco es el pensamiento estratégico."

# game/Story03.rpy:4495

translate spanish akt3chapter3_f4803980:

    # Fl "One day, maybe you’ll arrive before half my people are dead."
    Fl "Un día, tal vez llegues antes de que la mitad de mi gente esté muerta."

# game/Story03.rpy:4497

translate spanish akt3chapter3_94671f37:

    # k "What matters is {b}how{/b} we pull it off!"
    k "Lo que importa es {b}¿Cómo cómo?{/b} ¡Lo sacamos!"

# game/Story03.rpy:4500

translate spanish akt3chapter3_a98f2e89:

    # em "With honors, that’s for sure."
    em "Con honores, eso es seguro."

# game/Story03.rpy:4503

translate spanish akt3chapter3_7626e7b5:

    # a "You're in charge?"
    a "¿Estás a cargo aquí?"

# game/Story03.rpy:4506

translate spanish akt3chapter3_0b229df3:

    # Fl "The Great Maiden lowers herself to speak to the underlings. Should I bow or just quietly take orders, Your Highness?"
    Fl "La Gran Maiden se baja para hablar con los subordinados. ¿Debería inclinarme o simplemente tomar órdenes silenciosamente, Su Alteza?"

# game/Story03.rpy:4512

translate spanish akt3chapter3_12c6f66d:

    # a "They let children command armies now. Color me unimpressed."
    a "Dejan que los niños ordenen ejércitos ahora."

# game/Story03.rpy:4514

translate spanish akt3chapter3_d80ddf67:

    # Fl "My record of lives saved still outweighs your list of failures."
    Fl "Mi historial de vidas salvadas aún supera tu lista de fracasos."

# game/Story03.rpy:4515

translate spanish akt3chapter3_aaa21477:

    # Fl "Babysitting a girl? Well, if her IQ barely matches room temperature, I get it — that’s a challenge for you."
    Fl "¿Bebésear a una chica? Bueno, si su coeficiente intelectual apenas coincide con la temperatura ambiente, lo entiendo — eso es un desafío para usted."

# game/Story03.rpy:4519

translate spanish akt3chapter3_6b0b9631:

    # a "Don’t test me."
    a "No me pruebes."

# game/Story03.rpy:4522

translate spanish akt3chapter3_c555b102:

    # Fl "This isn’t your battlefield. My rules. Accept it or stay mad — quietly."
    Fl "Este no es tu campo de batalla. Mis reglas. Acéptalo o manténte enojada — silenciosamente."

# game/Story03.rpy:4524

translate spanish akt3chapter3_a6e61a6a:

    # a "You're loud. That’s not the same as being dangerous."
    a "No es lo mismo que ser peligroso."

# game/Story03.rpy:4526

translate spanish akt3chapter3_3aa37f22:

    # Fl "You can rage all you want. The only thing you'll affect is the ambient temperature."
    Fl "Puedes estar tan enojada como quieras, lo único que va a afectar es la temperatura del medio ambiente."

# game/Story03.rpy:4532

translate spanish akt3chapter3_2aa338e7:

    # k "Let it go. You wouldn't last against Ember anyway."
    k "No puedes soportar a Amber de todos modos."

# game/Story03.rpy:4533

translate spanish akt3chapter3_0cfd9cd7:

    # k "And you need rest. Urgently. Before you decide to start a solo apocalypse."
    k "Y necesitas descansar urgentemente antes de decidir empezar un apocalipsis en solitario."

# game/Story03.rpy:4541

translate spanish akt3chapter3_8ab2b4c1:

    # Fl "Every interaction with you is a damn migraine..."
    Fl "Cada interacción contigo es una migraña..."

# game/Story03.rpy:4545

translate spanish akt3chapter3_d40b423d:

    # Fl "All wounded to the medbay. Everyone else — to your rooms."
    Fl "Todos heridos en el medbay."

# game/Story03.rpy:4546

translate spanish akt3chapter3_4fe3728e:

    # Fl "And if I see anyone still here in ten minutes, go straight to the morgue."
    Fl "Y si veo a alguien aquí en diez minutos, ve directo a la morgue."

# game/Story03.rpy:4549

translate spanish akt3chapter3_26530924:

    # Fl "Miriel, keep your people in line."
    Fl "Miriel, mantenga a su gente en la línea."

# game/Story03.rpy:4559

translate spanish akt3chapter3_2cb042fd:

    # Fl "Kalestra, your sister’s your responsibility."
    Fl "Kalestra, tu hermana es tu responsabilidad."

# game/Story03.rpy:4562

translate spanish akt3chapter3_dd0ae64a:

    # k "Yeah, yeah. {w}Like a babysitter. With claws. And attitude."
    k "Sí, sí. {w}Como una niñera, con garras y actitud."

# game/Story03.rpy:4565

translate spanish akt3chapter3_e15331ee:

    # k "Let’s just hope she doesn’t snap again."
    k "Esperemos que no vuelva a romper."

# game/Story03.rpy:4566

translate spanish akt3chapter3_b1e4dd11:

    # k "Wouldn’t want the show getting too bloody even for my taste."
    k "No querría que el programa se pusiera demasiado sangriento incluso para mi gusto."

# game/Story03.rpy:4568

translate spanish akt3chapter3_053eee4d:

    # mc "(Snap again? Side effect from the activation?)"
    mc "¿Efecto secundario de la activación?"

# game/Story03.rpy:4570

translate spanish akt3chapter3_ba1a845a:

    # Fl "You — with me. Now."
    Fl "Tú, conmigo."

# game/Story03.rpy:4572

translate spanish akt3chapter3_ad2ba4ed:

    # mc "I need to see Olivia and Lora."
    mc "Necesito ver a Olivia y Lora."

# game/Story03.rpy:4574

translate spanish akt3chapter3_e62dfc9d:

    # Fl "I don't think so."
    Fl "No lo creo."

# game/Story03.rpy:4577

translate spanish akt3chapter3_a5341718:

    # Fl "Remember? You promised."
    Fl "Lo prometiste."

# game/Story03.rpy:4578

translate spanish akt3chapter3_8489819f:

    # Fl "And I don’t have time to wait. Got it?"
    Fl "Y no tengo tiempo para esperar. ¿Entendido?"

# game/Story03.rpy:4583

translate spanish akt3chapter3_5106d1fd:

    # mc "You’ve got something twisted, girl."
    mc "Tienes algo torcido, chica."

# game/Story03.rpy:4584

translate spanish akt3chapter3_1b9b815a:

    # mc "I need to make sure they’re safe. And until I do..."
    mc "Necesito asegurarme de que estén a salvo."

# game/Story03.rpy:4587

translate spanish akt3chapter3_e352e2a2:

    # Fl "They’re fine. So let’s drop this."
    Fl "Están bien. Así que vamos a dejar esto."

# game/Story03.rpy:4589

translate spanish akt3chapter3_4fcecb30:

    # mc "(What’s with her? She’s unusually docile... and afraid?)"
    mc "(¿Qué hay con ella? Ella es inusualmente dócil... y temerosa?)"

# game/Story03.rpy:4591

translate spanish akt3chapter3_e3c4889f:

    # mc "Did something happen?"
    mc "¿Pasó algo?"

# game/Story03.rpy:4594

translate spanish akt3chapter3_84dcb8a4:

    # Fl "It’s..."
    Fl "Es..."

# game/Story03.rpy:4595

translate spanish akt3chapter3_6743d88a:

    # Fl "(Whispers) Over there. I’ll explain. Just... not here. Not now."
    Fl "Allí, te lo explicaré. Solo... no aquí."

# game/Story03.rpy:4597

translate spanish akt3chapter3_315d63ac:

    # mc "(Her voice… it’s shaking. This is the first time I’ve seen her like this.)"
    mc "(Su voz... está temblando. Esta es la primera vez que la he visto así.)"

# game/Story03.rpy:4598

translate spanish akt3chapter3_5be3d4df:

    # mc "Alright. Lead the way."
    mc "Bien, diríjase al camino."

# game/Story03.rpy:4600

translate spanish akt3chapter3_4fc34a4d:

    # em "Get this ship in shape. We’ll need it again."
    em "Consigue esta nave en forma. Lo necesitaremos de nuevo."

# game/Story03.rpy:4601

translate spanish akt3chapter3_a7e0495a:

    # "Yes, ma’am."
    ggg "Sí, señora."

# game/Story03.rpy:4613

translate spanish akt3chapter3_112b64e7:

    # Fl "So tell me — how did you end up stuck at the outpost while your darling wife and Olivia landed here?"
    Fl "Así que dime, ¿cómo acabaste atrapado en el puesto de avanzada mientras tu querida esposa y Olivia aterrizaron aquí?"

# game/Story03.rpy:4616

translate spanish akt3chapter3_64bbb18b:

    # mc "You’ve got a real gift for digging into old wounds, don’t you?"
    mc "Tienes un verdadero regalo para cavar en viejas heridas, ¿no?"

# game/Story03.rpy:4617

translate spanish akt3chapter3_117eb6a4:

    # mc "What now? A moral lecture?"
    mc "¿Una conferencia moral?"

# game/Story03.rpy:4620

translate spanish akt3chapter3_f628680d:

    # Fl "No. Not my style."
    Fl "No, no es mi estilo."

# game/Story03.rpy:4623

translate spanish akt3chapter3_33495cec:

    # Fl "I’m after something else..."
    Fl "Estoy buscando algo más..."

# game/Story03.rpy:4627

translate spanish akt3chapter3_1ea74283:

    # Fl "Did you manage to bring Miriel under control?"
    Fl "¿Has conseguido traer a Miriel bajo control?"

# game/Story03.rpy:4630

translate spanish akt3chapter3_c1bd5175:

    # mc "Plans changed. It's not that simple."
    mc "Cambio de planes, no es tan simple."

# game/Story03.rpy:4634

translate spanish akt3chapter3_1528c240:

    # Fl "(Quietly) Of course. It never is..."
    Fl "Por supuesto, nunca es..."

# game/Story03.rpy:4635

translate spanish akt3chapter3_2316efdb:

    # Fl "Tell me honestly — did you drop everything because of her?"
    Fl "Dime honestamente: ¿lo dejaste todo por ella?"

# game/Story03.rpy:4637

translate spanish akt3chapter3_4a4f5136:

    # mc "That’s none of your business."
    mc "Eso no es asunto tuyo."

# game/Story03.rpy:4639

translate spanish akt3chapter3_994ce7c8:

    # Fl "Have you always been like this? Or is this something new?"
    Fl "¿Siempre has sido así o es algo nuevo?"

# game/Story03.rpy:4642

translate spanish akt3chapter3_3d3037c5:

    # mc "You’re becoming unbearable."
    mc "Te estás volviendo insoportable."

# game/Story03.rpy:4644

translate spanish akt3chapter3_92447ec5:

    # Fl "That never used to stop you."
    Fl "Eso nunca te detuvo."

# game/Story03.rpy:4648

translate spanish akt3chapter3_cc5cf145:

    # Fl "So? What did you find out?"
    Fl "¿Qué averiguaste?"

# game/Story03.rpy:4652

translate spanish akt3chapter3_385f2ff3:

    # mc "And why exactly should I tell you anything?"
    mc "¿Y por qué debería decirte algo exactamente?"

# game/Story03.rpy:4654

translate spanish akt3chapter3_ad580b80:

    # Fl "Because I’m asking. {w}If you’d rather — I’ll make it an order, but the outcome won’t change."
    Fl "Porque te lo pido. {w}Si prefieres – lo haré un pedido, pero el resultado no cambiará."

# game/Story03.rpy:4656

translate spanish akt3chapter3_d7f2e3bd:

    # mc "Why her? Why now?"
    mc "¿Por qué ella?"

# game/Story03.rpy:4658

translate spanish akt3chapter3_ce819397:

    # Fl "Because... everything’s falling apart."
    Fl "Porque... todo se está desmoronando."

# game/Story03.rpy:4662

translate spanish akt3chapter3_b3471000:

    # Fl "And she might be the only hope left."
    Fl "Y puede que sea la única esperanza que queda."

# game/Story03.rpy:4664

translate spanish akt3chapter3_ae8604bd:

    # mc "(She raised her voice, but it’s not anger. It’s… panic?)"
    mc "(Ella levantó su voz, pero no es ira. Es... ¿ pánico?)"

# game/Story03.rpy:4666

translate spanish akt3chapter3_bf5e593a:

    # mc "You're taking too much on yourself."
    mc "Estás tomando demasiado."

# game/Story03.rpy:4671

translate spanish akt3chapter3_69558449:

    # Fl "Right now, millions of lives depend on my decisions!"
    Fl "¡Ahora mismo, millones de vidas dependen de mis decisiones!"

# game/Story03.rpy:4673

translate spanish akt3chapter3_d74e485e:

    # Fl "And no matter what it takes — you will tell me everything!"
    Fl "Y no importa lo que sea necesario, ¡me lo dirás todo!"

# game/Story03.rpy:4674

translate spanish akt3chapter3_26dc7cab:

    # Fl "Is that clear?!"
    Fl "¿Está claro?"

# game/Story03.rpy:4678

translate spanish akt3chapter3_462bfeb8:

    # mc "So your great idea was to push me, provoke me, and put on a show?"
    mc "¿Así que tu gran idea era empujarme, provocarme y ponerme en un espectáculo?"

# game/Story03.rpy:4679

translate spanish akt3chapter3_a99ec2ca:

    # mc "...who are you even trying to be right now, Flora?"
    mc "...¿quién estás tratando de ser ahora mismo, Flora?"

# game/Story03.rpy:4685

translate spanish akt3chapter3_a550c833:

    # mc "Let me go."
    mc "Déjame ir."

# game/Story03.rpy:4688

translate spanish akt3chapter3_d2a9d41c:

    # Fl "...You don’t understand. You refuse to understand!"
    Fl "...No lo entiendes. ¡Rehusas comprender!"

# game/Story03.rpy:4693

translate spanish akt3chapter3_74375137:

    # mc "This isn’t like the Flora I knew. What’s going on with you?"
    mc "Esto no es como la Flora que conocí. ¿Qué pasa contigo?"

# game/Story03.rpy:4696

translate spanish akt3chapter3_8f12f96e:

    # Fl "Nothing’s going according to plan — absolutely nothing."
    Fl "Nada va de acuerdo con el plan, absolutamente nada."

# game/Story03.rpy:4699

translate spanish akt3chapter3_68455c78:

    # Fl "Everything I built — crumbling. All my work, this entire damn system, my calculations — dust!"
    Fl "Todo lo que construí —desmoronamiento. Todo mi trabajo, todo este maldito sistema, mis cálculos— polvo!"

# game/Story03.rpy:4700

translate spanish akt3chapter3_bea9fa06:

    # mc "(She’s trembling, eyes darting. Her face... swollen from crying. This isn’t the Flora I remember.)"
    mc "(Ella está temblando, los ojos atrevidos. Su cara... se hincha de llorar. Esta no es la Flora que recuerdo.)"

# game/Story03.rpy:4702

translate spanish akt3chapter3_5b002a71:

    # mc "You’re alone in this, aren’t you?"
    mc "Estás solo en esto, ¿no?"

# game/Story03.rpy:4705

translate spanish akt3chapter3_824127f1:

    # Fl "...Yes."
    Fl "Sí."

# game/Story03.rpy:4708

translate spanish akt3chapter3_feb9a2d0:

    # mc "You tried to bait me, manipulate, threaten…"
    mc "Intentaste cegarme, manipular, amenazar..."

# game/Story03.rpy:4709

translate spanish akt3chapter3_2876efd9:

    # mc "Why?"
    mc "¿Por qué?"

# game/Story03.rpy:4712

translate spanish akt3chapter3_16933c23:

    # Fl "Because it’s the only way I know how."
    Fl "Porque es la única manera en que sé cómo."

# game/Story03.rpy:4714

translate spanish akt3chapter3_9fbe019c:

    # mc "(God... Is it really that bad?)"
    mc "(Dios... ¿Es realmente tan malo?)"

# game/Story03.rpy:4723

translate spanish akt3chapter3_038d4145:

    # Fl "My social skills are garbage — as you know."
    Fl "Mis habilidades sociales son basura, como sabes."

# game/Story03.rpy:4725

translate spanish akt3chapter3_ab6bfb2b:

    # Fl "It was the only way I knew to get your attention."
    Fl "Era la única manera en que sabía llamar tu atención."

# game/Story03.rpy:4728

translate spanish akt3chapter3_5e3b205c:

    # mc "(Yeah. She’s brilliant. She’s ruthless. But beneath it all — just a shattered girl.)"
    mc "(Sí. Ella es brillante. Ella es despiadado. Pero debajo de todo - solo una chica destrozada.)"

# game/Story03.rpy:4731

translate spanish akt3chapter3_bed05a46:

    # Fl "If you want to laugh — go ahead."
    Fl "Si quieres reírte, adelante."

# game/Story03.rpy:4732

translate spanish akt3chapter3_102c29b9:

    # Fl "The genius scientist, razor-sharp mind, and a completely shitty personality."
    Fl "El genio científico, la mente de afeitar y una personalidad completamente de mierda."

# game/Story03.rpy:4733

translate spanish akt3chapter3_62309409:

    # Fl "Who falls apart the second a real crisis hits."
    Fl "Que se desmorona la segunda crisis."

# game/Story03.rpy:4742

translate spanish akt3chapter3_a65456bc:

    # mc "I’ll help you."
    mc "Te ayudaré."

# game/Story03.rpy:4746

translate spanish akt3chapter3_3bb43600:

    # Fl "...What?"
    Fl "¿Qué?"

# game/Story03.rpy:4749

translate spanish akt3chapter3_9525d822:

    # mc "But I’ve got one condition."
    mc "Pero tengo una condición."

# game/Story03.rpy:4757

translate spanish akt3chapter3_5de5408f:

    # Fl "Name it."
    Fl "Dilo."

# game/Story03.rpy:4760

translate spanish akt3chapter3_dc743ce7:

    # mc "No more pretending to be the heartless queen. Just be real — as much as you can."
    mc "No más pretender ser la reina sin corazón. Solo sé real, tanto como puedas."

# game/Story03.rpy:4762

translate spanish akt3chapter3_a8657bc4:

    # mc "Deal?"
    mc "¿Trato?"

# game/Story03.rpy:4765

translate spanish akt3chapter3_6d9b14fe:

    # Fl "I... can’t promise."
    Fl "No puedo prometer."

# game/Story03.rpy:4768

translate spanish akt3chapter3_f44123e4:

    # Fl "But I’ll try."
    Fl "Pero lo intentaré."

# game/Story03.rpy:4772

translate spanish akt3chapter3_52ece02b:

    # L "WHAT THE HELL HAVE YOU DONE?!"
    L "¿Qué diablos has hecho?"

# game/Story03.rpy:4776

translate spanish akt3chapter3_65f15cf6:

    # Fl "And here comes the drama queen herself. Hello, darling."
    Fl "Y aquí viene la reina del drama."

# game/Story03.rpy:4778

translate spanish akt3chapter3_a19f4931:

    # mc "(Whispers) This is bad."
    mc "Esto es malo."

# game/Story03.rpy:4791

translate spanish akt3chapter3_e32f9a1e:

    # L "What did you do with him?! Answer me!"
    L "¿Qué hiciste con él? ¡Respóndeme!"

# game/Story03.rpy:4793

translate spanish akt3chapter3_91ba8ed1:

    # Fl "Ouch..."
    Fl "Oh..."

# game/Story03.rpy:4795

translate spanish akt3chapter3_14a446e9:

    # Fl "Agg-ression. How very original."
    Fl "Retrocción de agg. ¡Qué original!"

# game/Story03.rpy:4798

translate spanish akt3chapter3_6680de12:

    # L "I’m talking to you!"
    L "¡Te estoy hablando!"

# game/Story03.rpy:4800

translate spanish akt3chapter3_e17d658f:

    # mc "Calm down. Nothing happened."
    mc "No pasó nada."

# game/Story03.rpy:4803

translate spanish akt3chapter3_b280a2bd:

    # L "But she—"
    L "Pero ella..."

# game/Story03.rpy:4805

translate spanish akt3chapter3_f07801a8:

    # mc "I said — that’s enough. Please."
    mc "Dije: basta. Por favor."

# game/Story03.rpy:4811

translate spanish akt3chapter3_c2306ebf:

    # mc "Better now?"
    mc "¿Mejor ahora?"

# game/Story03.rpy:4821

translate spanish akt3chapter3_cfb67220:

    # mc "(Jumping into a fight with no intel... That part of you hasn’t changed.)"
    mc "(En una pelea sin información... Esa parte de ustedes no ha cambiado.)"

# game/Story03.rpy:4825

translate spanish akt3chapter3_757d549e:

    # mc "(But this is on me too. I should’ve stopped it earlier.)"
    mc "(Pero esto también está en mí. Debí haberlo detenido antes.)"

# game/Story03.rpy:4828

translate spanish akt3chapter3_859f55c3:

    # mc "I’m sorry. Are you okay?"
    mc "Lo siento. ¿Estás bien?"

# game/Story03.rpy:4832

translate spanish akt3chapter3_2524113b:

    # Fl "Yes. Thank you..."
    Fl "Sí, gracias..."

# game/Story03.rpy:4833

translate spanish akt3chapter3_a0c05229:

    # mc "I’m sorry. She can be... sharp. Too sharp."
    mc "Lo siento, ella puede ser... afilada."

# game/Story03.rpy:4835

translate spanish akt3chapter3_67ae2ecb:

    # Fl "I get it. We’re all on edge these days."
    Fl "Lo entiendo. Todos estamos en el borde de estos días."

# game/Story03.rpy:4838

translate spanish akt3chapter3_43ca7453:

    # mc "(And now what? They’ve gone quiet — but for how long will this fragile ceasefire last?)"
    mc "(¿Y ahora qué? Ellos se han ido callados — pero por cuánto tiempo durará esta frágil cesación del fuego?)"

# game/Story03.rpy:4841

translate spanish akt3chapter3_50fc55c6:

    # mc "Both of you — sit down. We don’t have the luxury of turning on each other."
    mc "Ambos — sentarse. No tenemos el lujo de encendernos el uno al otro."

# game/Story03.rpy:4843

translate spanish akt3chapter3_fb4d9702:

    # L "(whispers) I saw the way you clung to him. Think I’ll just pretend I didn’t?"
    L "(susurros) Vi la forma en que te aferraste a él. ¿Crees que voy a fingir que no lo hice?"

# game/Story03.rpy:4845

translate spanish akt3chapter3_3583bccd:

    # Fl "I did what had to be done. Someone needed to act."
    Fl "Hice lo que tenía que hacer, alguien necesitaba actuar."

# game/Story03.rpy:4848

translate spanish akt3chapter3_5a672918:

    # L "(whispers) You’re just toying with his feelings. Again."
    L "(susurros) Solo estás jugando con sus sentimientos. Otra vez."

# game/Story03.rpy:4850

translate spanish akt3chapter3_848eacfd:

    # Fl "And you? You hid. Let everyone else clean up the mess. Planning to do that again, too?"
    Fl "¿Y tú, te escondiste, que todos los demás limpies el desorden y planeas hacerlo de nuevo?"

# game/Story03.rpy:4855

translate spanish akt3chapter3_25236cdf:

    # Fl "You left him once. Want to finish the job?"
    Fl "Lo dejaste una vez. ¿Quieres terminar el trabajo?"

# game/Story03.rpy:4857

translate spanish akt3chapter3_54d0e568:

    # mc "(This is turning into a damn circus.)"
    mc "(Esto se está convirtiendo en un maldito circo.)"

# game/Story03.rpy:4859

translate spanish akt3chapter3_9c3859af:

    # mc "(If this keeps up, we won’t survive another night.)"
    mc "(Si esto sigue así, no sobreviviremos otra noche.)"

# game/Story03.rpy:4866

translate spanish akt3chapter3_8b9ee863:

    # mc "Enough."
    mc "Suficiente."

# game/Story03.rpy:4871

translate spanish akt3chapter3_74b7fd2e:

    # mc "(whispers) Why is it so impossible to get women to work together...?"
    mc "¿Por qué es tan imposible que las mujeres trabajen juntas?"

# game/Story03.rpy:4873

translate spanish akt3chapter3_62502621:

    # mc "You’re both smart. You know this infighting will get us all killed."
    mc "Ambos sois inteligentes. Sabes que esta lucha nos hará matar a todos."

# game/Story03.rpy:4874

translate spanish akt3chapter3_cccc66b8:

    # b "Hmph..."
    "{color=#ff8899}Ambos{/color}" "Hmph..."

# game/Story03.rpy:4879

translate spanish akt3chapter3_d5f4a898:

    # mc "Do you really want the Abyss to win — not because it’s stronger, but because we’re stubborn?"
    mc "¿De verdad quieres que el Abismo gane, no porque sea más fuerte, sino porque somos tercos?"

# game/Story03.rpy:4881

translate spanish akt3chapter3_d9cec443:

    # L "I was just worried about you..."
    L "Estaba preocupada por ti..."

# game/Story03.rpy:4883

translate spanish akt3chapter3_66c42bf9:

    # Fl "And I was trying to secure support. My way."
    Fl "Y estaba tratando de asegurar el apoyo."

# game/Story03.rpy:4890

translate spanish akt3chapter3_1c71c4fc:

    # mc "I’m not choosing between you. Not now. Not in this nightmare."
    mc "No estoy eligiendo entre ustedes. No ahora. No en esta pesadilla."

# game/Story03.rpy:4892

translate spanish akt3chapter3_c4901386:

    # mc "Here’s the deal. I tell you everything I know — and you stop this feud."
    mc "Aquí está el trato. Te digo todo lo que sé, y detienes esta disputa."

# game/Story03.rpy:4894

translate spanish akt3chapter3_690bfed3:

    # mc "Work together. No more rival crap. Deal?"
    mc "Trabajar juntos. ¿Trato?"

# game/Story03.rpy:4896

translate spanish akt3chapter3_f51f3210:

    # mc "I’m waiting."
    mc "Estoy esperando."

# game/Story03.rpy:4902

translate spanish akt3chapter3_58b2f2b2:

    # Fl "You’re seriously going to tell us everything?"
    Fl "¿De verdad nos vas a contar todo?"

# game/Story03.rpy:4904

translate spanish akt3chapter3_b4ca1312:

    # mc "Only if you act like allies. Not enemies."
    mc "Solo si actúas como aliados, no como enemigos."

# game/Story03.rpy:4907

translate spanish akt3chapter3_afd342ab:

    # L "I’m not sure I can..."
    L "No estoy seguro de que pueda..."

# game/Story03.rpy:4909

translate spanish akt3chapter3_f8ff64a1:

    # Fl "I’ll try. If you do."
    Fl "Lo intentaré."

# game/Story03.rpy:4911

translate spanish akt3chapter3_6d4f651a:

    # L "Fine. For his sake."
    L "Bien, por su bien."

# game/Story03.rpy:4918

translate spanish akt3chapter3_9d71812b:

    # mc "What do you know about the mutants?"
    mc "¿Qué sabes de los mutantes?"

# game/Story03.rpy:4920

translate spanish akt3chapter3_bdf7c589:

    # Fl "That they’re disgusting, deadly, and slightly smarter than the Security Council."
    Fl "Que son repugnantes, mortales y ligeramente más inteligentes que el Consejo de Seguridad."

# game/Story03.rpy:4924

translate spanish akt3chapter3_199578df:

    # mc "You know more, don’t you?"
    mc "Sabes más, ¿no?"

# game/Story03.rpy:4926

translate spanish akt3chapter3_14f37b77:

    # L "So... she told you after all."
    L "Así que... te lo dijo después de todo."

# game/Story03.rpy:4932

translate spanish akt3chapter3_9a5e9bc7:

    # Fl "Okay, what the hell are you two hiding?"
    Fl "¿Qué demonios están escondiendo?"

# game/Story03.rpy:4934

translate spanish akt3chapter3_cdb379a5:

    # L "All this time... we weren’t killing monsters. We were killing people."
    L "Todo este tiempo... no estábamos matando monstruos."

# game/Story03.rpy:4936

translate spanish akt3chapter3_3bb43600_1:

    # Fl "...What?"
    Fl "¿Qué?"

# game/Story03.rpy:4938

translate spanish akt3chapter3_bc1320b3:

    # L "Or what’s left of them."
    L "O lo que queda de ellos."

# game/Story03.rpy:4940

translate spanish akt3chapter3_7ab45580:

    # Fl "You’ve got to be joking..."
    Fl "Tienes que estar bromeando..."

# game/Story03.rpy:4947

translate spanish akt3chapter3_971d2cd2:

    # L "(whispers) I guess I don’t have a choice anymore..."
    L "Supongo que ya no tengo elección..."

# game/Story03.rpy:4952

translate spanish akt3chapter3_7da2eb6d:

    # L "The tower we’re heading to — it’s a junction. Part of a massive mechanism."
    L "La torre a la que nos dirigimos es una unión. Parte de un mecanismo masivo."

# game/Story03.rpy:4954

translate spanish akt3chapter3_b8c01c89:

    # Fl "A mechanism? You mean the tomb?"
    Fl "¿Te refieres a la tumba?"

# game/Story03.rpy:4961

translate spanish akt3chapter3_109280b3:

    # L "Yes."
    L "Sí."

# game/Story03.rpy:4963

translate spanish akt3chapter3_bf175132:

    # mc "And what’s the connection to the mutants?"
    mc "¿Y cuál es la conexión con los mutantes?"

# game/Story03.rpy:4965

translate spanish akt3chapter3_03804d12:

    # L "To activate the mechanism... it needs the blood of the Ancients."
    L "Para activar el mecanismo... necesita la sangre de los Antiguos."

# game/Story03.rpy:4967

translate spanish akt3chapter3_7949d67b:

    # Fl "...Excuse me?"
    Fl "...¿Disculpe?"

# game/Story03.rpy:4969

translate spanish akt3chapter3_7fa00d82:

    # mc "The Ancients’ blood — that’s what you were dealing with, right?"
    mc "La sangre de los Antiguos — con la que estabas tratando, ¿verdad?"

# game/Story03.rpy:4976

translate spanish akt3chapter3_3b2c01d7:

    # L "Energy."
    L "Energía."

# game/Story03.rpy:4978

translate spanish akt3chapter3_f35116b8:

    # Fl "...Don’t look at me like that. I know as much as you."
    Fl "...No me mires así. Sé tanto como tú."

# game/Story03.rpy:4981

translate spanish akt3chapter3_43ba3dcf:

    # mc "So... where does this energy come from?"
    mc "Entonces... ¿de dónde viene esta energía?"

# game/Story03.rpy:4983

translate spanish akt3chapter3_f35a172a:

    # L "From absorbing living organisms."
    L "De absorber organismos vivos."

# game/Story03.rpy:4986

translate spanish akt3chapter3_4478d7ce:

    # Fl "...Wait. So the mutants — they’re just a side effect?"
    Fl "...Espera. Entonces los mutantes - son solo un efecto secundario?"

# game/Story03.rpy:4987

translate spanish akt3chapter3_bc922369:

    # Fl "And even if we kill them — the process still goes on?"
    Fl "Y aunque los matemos, ¿el proceso sigue adelante?"

# game/Story03.rpy:4989

translate spanish akt3chapter3_b42c9b91:

    # L "...Not in practice. But in theory? The Abyss can reuse the same organism. Even post-mortem."
    L "El Abismo puede reutilizar el mismo organismo, incluso después de la muerte."

# game/Story03.rpy:4991

translate spanish akt3chapter3_fee8dcd8:

    # Fl "...So even the dead are still useful to it. Fantastic."
    Fl "...así que incluso los muertos son útiles para ello."

# game/Story03.rpy:4993

translate spanish akt3chapter3_62903e12:

    # L "As long as blood flows — they’re still vessels. Even corpses."
    L "Mientras la sangre fluya, todavía son vasos. Incluso cuerpos."

# game/Story03.rpy:4997

translate spanish akt3chapter3_45110eda:

    # mc "(So every kill... just speeds up the activation?)"
    mc "(Entonces cada asesinato... ¿acelera la activación?)"

# game/Story03.rpy:4998

translate spanish akt3chapter3_b58751b7:

    # mc "Great. Just... brilliant."
    mc "Genial, solo... brillante."

# game/Story03.rpy:5000

translate spanish akt3chapter3_c03bc906:

    # mc "What if we freeze them?"
    mc "¿Y si los congelamos?"

# game/Story03.rpy:5001

translate spanish akt3chapter3_fb4a1719:

    # L "That... could work."
    L "Eso... podría funcionar."

# game/Story03.rpy:5003

translate spanish akt3chapter3_73b1b36d:

    # mc "You pulled it off once, didn’t you?"
    mc "Lo sacaste una vez, ¿no?"

# game/Story03.rpy:5009

translate spanish akt3chapter3_a7a5b260:

    # Fl "The mission failed. But we did manage to freeze a couple hundred thousand. Sloppy job, but better than nothing."
    Fl "La misión falló, pero logramos congelar un par de cientos de miles de personas, pero mejor que nada."

# game/Story03.rpy:5012

translate spanish akt3chapter3_c6b41095:

    # mc "Still just a drop in the ocean..."
    mc "Aún así, una gota en el océano..."

# game/Story03.rpy:5019

translate spanish akt3chapter3_1f634cf2:

    # mc "(So now what? The mutants matter — but the tower takes priority.)"
    mc "(¿Y ahora qué? Los mutantes importan - pero la torre toma prioridad.)"

# game/Story03.rpy:5022

translate spanish akt3chapter3_242e90b0:

    # mc "Flora, round up every commander you can find."
    mc "Flora, redondea a cada comandante que encuentres."

# game/Story03.rpy:5024

translate spanish akt3chapter3_0cc3e927:

    # Fl "On it. But if anyone makes a move again — I won’t be so forgiving."
    Fl "Pero si alguien vuelve a hacer un movimiento, no seré tan indulgente."

# game/Story03.rpy:5026

translate spanish akt3chapter3_dd92beda:

    # mc "Lora, write down everything you know. The Artifact, the attackers — everything. We need answers."
    mc "Lora, escribe todo lo que sabes. El artefacto, los atacantes — todo. Necesitamos respuestas."

# game/Story03.rpy:5028

translate spanish akt3chapter3_29d01ac0:

    # L "Yes, my love!"
    L "¡Sí, mi amor!"

# game/Story03.rpy:5030

translate spanish akt3chapter3_5779514a:

    # mc "And I’ll try to rally whatever support we’ve got left."
    mc "Y trataré de reunir cualquier apoyo que nos queda."


# game/Story03.rpy:5050

translate spanish akt3chapter5_0df736ef:

    # L "(Was it really the right decision...)"
    L "(Fue realmente la decisión correcta...)"

# game/Story03.rpy:5053

translate spanish akt3chapter5_37a46956:

    # Fl "And you? Hiding in a corner, hoping someone else would do the hard part for you?"
    Fl "¿Y tú? ¿Escondiendo en un rincón, esperando que alguien más hiciera lo difícil para ti?"

# game/Story03.rpy:5058

translate spanish akt3chapter5_f6131be1:

    # Fl "Walked away again, huh?"
    Fl "¿Te has marchado otra vez?"

# game/Story03.rpy:5066

translate spanish akt3chapter5_ee6422f9:

    # L "(She’s right... I left him... again.)"
    L "(Tiene razón... lo dejé... otra vez.)"

# game/Story03.rpy:5069

translate spanish akt3chapter5_38436deb:

    # L "(Why does it always have to be so complicated... why can’t we just go back?)"
    L "(¿Por qué siempre tiene que ser tan complicado... por qué no podemos simplemente volver?)"

# game/Story03.rpy:5072

translate spanish akt3chapter5_deda8956:

    # L "(Out of everyone... why did it have to be my husband?)"
    L "(De todos... ¿por qué tenía que ser mi marido?)"

# game/Story03.rpy:5080

translate spanish akt3chapter5_5412ab20:

    # L "(Focus, Lora. Now’s not the time. You need to act!)"
    L "(Focus, Lora. Ahora no es el momento. ¡Necesitas actuar!)"

# game/Story03.rpy:5082

translate spanish akt3chapter5_260b5d37:

    # L "(But... where to even start?)"
    L "(Pero... ¿dónde empezar?)"

# game/Story03.rpy:5091

translate spanish akt3chapter5_cb9145b4:

    # mc "So. What’s the situation?"
    mc "Entonces. ¿Cuál es la situación?"

# game/Story03.rpy:5093

translate spanish akt3chapter5_f0348365:

    # Fl "Same as always — panic, idiocy, and ill-timed heroism."
    Fl "Igual que siempre: pánico, idiotez y heroísmo mal tiempo."

# game/Story03.rpy:5096

translate spanish akt3chapter5_041785de:

    # mc "Care to elaborate?"
    mc "¿Le importaría elaborar?"

# game/Story03.rpy:5099

translate spanish akt3chapter5_d2d1084d:

    # Fl "Commander’s gone. The rest are running around in circles and calling it 'coordination'."
    Fl "Los comandantes se han ido, los otros se están quedando y lo llaman coordinación."

# game/Story03.rpy:5100

translate spanish akt3chapter5_f977b11f:

    # Fl "Everyone’s doing whatever they please. Some are hiding. Some are playing general."
    Fl "Todos están haciendo lo que quieran. Algunos se esconden. Algunos están jugando en general."

# game/Story03.rpy:5103

translate spanish akt3chapter5_b631f7ce:

    # mc "But you’ve already managed to take some control, haven’t you?"
    mc "Pero ya has conseguido tomar algún control, ¿no?"

# game/Story03.rpy:5113

translate spanish akt3chapter5_9255398a:

    # Fl "Only the ones who served my father — the ones who still remember how things used to be."
    Fl "Solo los que sirvieron a mi padre — los que aún recuerdan cómo eran las cosas."

# game/Story03.rpy:5114

translate spanish akt3chapter5_3a6b4acc:

    # Fl "The rest? They either ran... or act like I was never born."
    Fl "O corrieron o actuaron como si nunca hubiera nacido."

# game/Story03.rpy:5116

translate spanish akt3chapter5_f6738cc7:

    # mc "That’s why you went to the Lower City."
    mc "Por eso fuiste a la Ciudad Baja."

# game/Story03.rpy:5122

translate spanish akt3chapter5_0bef0afa:

    # Fl "Thought if I showed my face — someone might remember who I am. Or at least get scared."
    Fl "Pensamos que si mostré mi cara, alguien podría recordar quién soy. O al menos tener miedo."

# game/Story03.rpy:5124

translate spanish akt3chapter5_095ddf5e:

    # mc "And Ember?"
    mc "¿Y Ember?"

# game/Story03.rpy:5129

translate spanish akt3chapter5_b1cec4b8:

    # Fl "She made an offer. I had to refuse."
    Fl "Ella hizo una oferta, tuve que rechazarla."

# game/Story03.rpy:5131

translate spanish akt3chapter5_5b75a526:

    # mc "But... aren’t you two supposed to be friends?"
    mc "Pero... ¿no se supone que ustedes dos sean amigos?"

# game/Story03.rpy:5135

translate spanish akt3chapter5_6bad95eb:

    # Fl "Power isn’t about friendship. When it’s about control — nothing else matters."
    Fl "El poder no se trata de la amistad. Cuando se trata de control, nada más importa."

# game/Story03.rpy:5136

translate spanish akt3chapter5_9791edd9:

    # Fl "Only strength counts. And what it costs."
    Fl "Solo la fuerza cuenta y lo que cuesta."

# game/Story03.rpy:5138

translate spanish akt3chapter5_30c9afb2:

    # mc "(Strength, of course. The eternal classic.)"
    mc "(Fuerza, por supuesto. El clásico eterno.)"

# game/Story03.rpy:5144

translate spanish akt3chapter5_d6d040f9:

    # mc "(The one currency that never devalues.)"
    mc "(La única moneda que nunca devalua.)"

# game/Story03.rpy:5146

translate spanish akt3chapter5_ecfd4e8d:

    # mc "So. Strength, is it?"
    mc "Así que... fuerza, ¿verdad?"

# game/Story03.rpy:5150

translate spanish akt3chapter5_e02b5376:

    # mc "Then here’s the deal. Draw up a plan."
    mc "Entonces este es el trato."

# game/Story03.rpy:5153

translate spanish akt3chapter5_8851e609:

    # Fl "What plan?"
    Fl "¿Qué plan?"

# game/Story03.rpy:5155

translate spanish akt3chapter5_05ea62a6:

    # mc "The freeze."
    mc "La congelación."

# game/Story03.rpy:5157

translate spanish akt3chapter5_492fda07:

    # Fl "But... it didn’t work. Already."
    Fl "Pero... no funcionó."

# game/Story03.rpy:5160

translate spanish akt3chapter5_a652a4fc:

    # mc "Didn’t work because it was miscalculated?"
    mc "¿No funcionó porque fue mal calculado?"

# game/Story03.rpy:5162

translate spanish akt3chapter5_c9956029:

    # mc "Or because no one listened to you?"
    mc "¿O porque nadie te escuchó?"

# game/Story03.rpy:5165

translate spanish akt3chapter5_e7080968:

    # Fl "...No one listened. Like I was air — invisible and irrelevant."
    Fl "...Nadie escuchó, como si yo fuera aire, invisible e irrelevante."

# game/Story03.rpy:5167

translate spanish akt3chapter5_b0cf92e7:

    # mc "Then focus on what you’re best at. I’ll handle the rest."
    mc "Luego, concéntrate en lo que más te conviene. Yo me encargaré del resto."

# game/Story03.rpy:5172

translate spanish akt3chapter5_cd779858:

    # Fl "...Thanks. It’s been a long time since someone said that to me — and actually meant it."
    Fl "...Gracias. Ha pasado mucho tiempo desde que alguien me dijo eso — y en realidad lo significaba."

# game/Story03.rpy:5176

translate spanish akt3chapter5_370ff582:

    # mc "Not doing this for thanks. Just... we both know how these 'elites' operate."
    mc "No estoy haciendo esto por gratitud, es solo que ambos sabemos cómo funcionan estas élites."

# game/Story03.rpy:5178

translate spanish akt3chapter5_716019b8:

    # mc "Right."
    Fl "Cierto."

# game/Story03.rpy:5181

translate spanish akt3chapter5_a6030d2d:

    # mc "(If reason falls on deaf ears... the crowd will make itself heard.)"
    mc "(Si la razón cae en oídos sordos... la multitud se hará oír.)"

# game/Story03.rpy:5198

translate spanish akt3chapter5_37becf81:

    # mc "(Feels like the air down here forgot how to breathe...)"
    mc "(Los tacones como el aire aquí abajo se olvidó cómo respirar...)"

# game/Story03.rpy:5200

translate spanish akt3chapter5_bb3fd65b:

    # mc "Come out. I know you’re here."
    mc "Sé que estás aquí."

# game/Story03.rpy:5205

translate spanish akt3chapter5_88ebbfd6:

    # a "Speak."
    a "Habla."

# game/Story03.rpy:5207

translate spanish akt3chapter5_566d630c:

    # mc "I need your help."
    mc "Necesito tu ayuda."

# game/Story03.rpy:5210

translate spanish akt3chapter5_59643b2a:

    # k "And what little scheme have you cooked up this time? I’m all ears."
    k "¿Y qué pequeño plan te has cocinado esta vez? Soy todo oídos."

# game/Story03.rpy:5213

translate spanish akt3chapter5_3d10100f:

    # a "Left the water warm. In the bath."
    a "Dejó el agua caliente en el baño."

# game/Story03.rpy:5216

translate spanish akt3chapter5_b8431d8b:

    # k "Thanks, sister dearest."
    k "Gracias, hermana querida."

# game/Story03.rpy:5218

translate spanish akt3chapter5_7a179be7:

    # mc "I’m taking command of the army."
    mc "Estoy tomando el mando del ejército."

# game/Story03.rpy:5223

translate spanish akt3chapter5_374eea2b:

    # k "Ohoho, there it is — that familiar madness in your eyes! Delightful. Like coming home in a blaze."
    k "Ohoho, ahí está — esa locura familiar en tus ojos! Encantador. Como volver a casa en un resplandor."

# game/Story03.rpy:5229

translate spanish akt3chapter5_a6cdd6be:

    # a "But?"
    a "¿Pero?"

# game/Story03.rpy:5231

translate spanish akt3chapter5_d71645f2:

    # mc "But I don’t have enough authority for anyone to follow me."
    mc "Pero no tengo suficiente autoridad para que alguien me siga."

# game/Story03.rpy:5233

translate spanish akt3chapter5_e21905b1:

    # a "And you thought we’d help you with that?"
    a "¿Y pensaste que te ayudaríamos con eso?"

# game/Story03.rpy:5239

translate spanish akt3chapter5_a1f14f5a:

    # mc "You both know how this ends."
    mc "Ambos saben cómo termina esto."

# game/Story03.rpy:5240

translate spanish akt3chapter5_4ef8007b:

    # mc "You don’t have a choice."
    mc "No tienes elección."

# game/Story03.rpy:5242

translate spanish akt3chapter5_2df17c35:

    # k "So you’re the predator now? Intriguing... But don’t forget — even mice have teeth. Sometimes venomous."
    k "¿Así que ahora eres el depredador? Intrigante... Pero no olvides – incluso los ratones tienen dientes. A veces venomosos."

# game/Story03.rpy:5246

translate spanish akt3chapter5_721d45ff:

    # a "That sounded like a threat."
    a "Eso sonaba como una amenaza."

# game/Story03.rpy:5249

translate spanish akt3chapter5_2034c056:

    # mc "Maybe."
    mc "Tal vez."

# game/Story03.rpy:5251

translate spanish akt3chapter5_7281ea99:

    # mc "You can kill me later — if you think I deserve it. For now — I need you."
    mc "Puedes matarme más tarde, si crees que me lo merezco. Por ahora, te necesito."

# game/Story03.rpy:5254

translate spanish akt3chapter5_5cbbd218:

    # mc "So? What’s your answer?"
    mc "¿Cuál es tu respuesta?"

# game/Story03.rpy:5260

translate spanish akt3chapter5_75507e23:

    # a "Unexpected. But accepted."
    a "Sin esperar, pero aceptado."

# game/Story03.rpy:5264

translate spanish akt3chapter5_bb0eeaf4:

    # mc "Thank you."
    mc "Gracias."

# game/Story03.rpy:5266

translate spanish akt3chapter5_b016e587:

    # k "We can influence the small fry. But what about the big fish?"
    k "Podemos influir en la pequeña freír, pero ¿qué hay del pez grande?"

# game/Story03.rpy:5268

translate spanish akt3chapter5_385d68a7:

    # k "Your approach won’t work on them."
    k "Tu enfoque no funcionará en ellos."

# game/Story03.rpy:5270

translate spanish akt3chapter5_5c7940de:

    # mc "Then I’ll find other levers to pull."
    mc "Entonces encontraré otras palancas para tirar."

# game/Story03.rpy:5276

translate spanish akt3chapter5_9247b832:

    # k "How curious..."
    k "Qué curioso..."

# game/Story03.rpy:5279

translate spanish akt3chapter5_6e3f8dd5:

    # k "Let’s hope you know what you’re doing."
    k "Esperemos que sepas lo que estás haciendo."

# game/Story03.rpy:5282

translate spanish akt3chapter5_aa3909c8:

    # mc "Better than anyone else."
    mc "Mejor que nadie más."

# game/Story03.rpy:5284

translate spanish akt3chapter5_f848e410:

    # g "Who are you? This area is off li—"
    g "¿Quién eres?"

# game/Story03.rpy:5291

translate spanish akt3chapter5_8a8c2a58:

    # gg "And who the hell are you?"
    gg "¿Y quién demonios eres tú?"

# game/Story03.rpy:5294

translate spanish akt3chapter5_d6f80076:

    # ggg "What are you doing?!"
    ggg "¿Qué estás haciendo?"

# game/Story03.rpy:5296

translate spanish akt3chapter5_4bb2f63d:

    # mc "What none of you had the guts to."
    mc "Lo que ninguno de ustedes tenía las agallas."

# game/Story03.rpy:5299

translate spanish akt3chapter5_906c02d0:

    # mc "Resistance is out of fashion. Let’s go."
    mc "La resistencia está fuera de moda. Vamos."

# game/Story03.rpy:5302

translate spanish akt3chapter5_6232376b:

    # g "Drop your weapon! I’m asking nicely!"
    g "¡Suelta el arma! ¡Te pido amablemente!"

# game/Story03.rpy:5304

translate spanish akt3chapter5_d9b94ade:

    # mc "We don’t have time for 'nice'."
    mc "No tenemos tiempo para esto."

# game/Story03.rpy:5307

translate spanish akt3chapter5_314154c5:

    # k "What would you even do without me... Let me guess — die boringly?"
    k "¿Qué harías sin mí... déjame adivinar... morir aburridamente?"

# game/Story03.rpy:5309

translate spanish akt3chapter5_8f782852:

    # mc "Kalestra, gather everyone in the hangar. It’s open season."
    mc "Kalestra, reúne a todos en el hangar. Es temporada abierta."

# game/Story03.rpy:5311

translate spanish akt3chapter5_def8f168:

    # a "They won’t like this."
    a "No les gustará esto."

# game/Story03.rpy:5313

translate spanish akt3chapter5_fd595372:

    # mc "It’s the only way."
    mc "Es la única manera."

# game/Story03.rpy:5317

translate spanish akt3chapter5_83b21bf6:

    # k "Yes, yes, your excellency..."
    k "Sí, sí, su excelencia..."

# game/Story03.rpy:5320

translate spanish akt3chapter5_c01b0e08:

    # ggg "(Whispering) This is treason..."
    ggg "Esto es traición..."

# game/Story03.rpy:5321

translate spanish akt3chapter5_16452ef9:

    # ggg "(Whispering) Then you go tell her that to her face..."
    ggg "Entonces le dices eso a su cara..."

# game/Story03.rpy:5322

translate spanish akt3chapter5_65a8a3ca:

    # k "Out of the way, dolls. The lady’s ready for her entrance."
    k "Fuera del camino, muñecas. La señora está lista para su entrada."

# game/Story03.rpy:5325

translate spanish akt3chapter5_d15a7eb3:

    # k "You — you’re in charge here, right? Turn on the PA for me."
    k "Usted - usted está a cargo aquí, ¿verdad? Enciende la PA para mí."

# game/Story03.rpy:5328

translate spanish akt3chapter5_42c7a354:

    # gg "Y-yes, ma’am, right away..."
    gg "Sí, señora, de inmediato..."

# game/Story03.rpy:5330

translate spanish akt3chapter5_8285d225:

    # k "Thank you, darling. Good listener — means you’ll live a bit longer."
    k "Gracias, cariño. Buen oyente significa que vivirás un poco más."

# game/Story03.rpy:5331

translate spanish akt3chapter5_0274ea6e:

    # k "Ahem... Can you hear me, my lovely ghosts of the revolution?"
    k "¿Puedes oírme, mis encantadores fantasmas de la revolución?"

# game/Story03.rpy:5333

translate spanish akt3chapter5_07a6ae99:

    # k "If anyone’s still asleep — don’t worry. I’ll claw the morning into you."
    k "Si alguien todavía está dormido — no se preocupe. Voy a garra la mañana en usted."

# game/Story03.rpy:5335

translate spanish akt3chapter5_40fb63b4:

    # h "What the...?"
    h "¿Qué...?"

# game/Story03.rpy:5337

translate spanish akt3chapter5_9625f945:

    # Mi "I know that voice."
    Mi "Conozco esa voz."

# game/Story03.rpy:5340

translate spanish akt3chapter5_d15bbb53:

    # k "You’d better."
    k "Mejor."

# game/Story03.rpy:5341

translate spanish akt3chapter5_819ee949:

    # k "Now, what was I supposed to say... Ah, right."
    k "Ahora, ¿qué se suponía que dijera..."

# game/Story03.rpy:5343

translate spanish akt3chapter5_fb7d727a:

    # h "She’s just the same as ever."
    h "Es igual que nunca."

# game/Story03.rpy:5352

translate spanish akt3chapter5_103becde:

    # k "This is Kalestra Elverin Ord’Laria speaking."
    k "Aquí Calestra Elverine Ord'Laria."

# game/Story03.rpy:5355

translate spanish akt3chapter5_f2cd8f3e:

    # k "By order of the Inquisition, the current command is hereby relieved. Immediately."
    k "Por orden de la Inquisición, el comando actual se encuentra aquí aliviado. Inmediatamente."

# game/Story03.rpy:5359

translate spanish akt3chapter5_4c325193:

    # em "Now things are getting interesting."
    em "Ahora las cosas se están poniendo interesantes."

# game/Story03.rpy:5361

translate spanish akt3chapter5_de055f8c:

    # gg "What do we do, Miss Ember?"
    gg "¿Qué hacemos, Srta. Ember?"

# game/Story03.rpy:5363

translate spanish akt3chapter5_47c95552:

    # em "The chessboard is shifting. Let’s see who falls first."
    em "El tablero de ajedrez está cambiando. Veamos quién cae primero."

# game/Story03.rpy:5365

translate spanish akt3chapter5_6475a8a2:

    # k "This isn’t improvisation. It’s protocol. All dissenters — sentenced to death. On the spot."
    k "Esto no es improvisación. Es protocolo. Todos los disidentes — sentenciados a muerte. En el lugar."

# game/Story03.rpy:5367

translate spanish akt3chapter5_ef232c34:

    # Fl "...They... actually handed me command?"
    Fl "... ¿En realidad me dieron el mando?"

# game/Story03.rpy:5369

translate spanish akt3chapter5_1a82d3cc:

    # L "What are you doing, darling..."
    L "¿Qué estás haciendo, cariño?"

# game/Story03.rpy:5373

translate spanish akt3chapter5_1b7687a1:

    # L "So... you’re officially a commander now?"
    L "¿Así que ahora eres oficialmente un comandante?"

# game/Story03.rpy:5383

translate spanish akt3chapter5_0ab7764d:

    # k "That’s all! Now — to the hangar. Chop-chop. We’ve got murders to plan and not enough time."
    k "¡Eso es todo! Ahora — al hangar. Chop-chop. Tenemos asesinatos para planear y no suficiente tiempo."

# game/Story03.rpy:5386

translate spanish akt3chapter5_46165e04:

    # gg "You’re way out of line!"
    gg "¡Estás fuera de línea!"

# game/Story03.rpy:5387

translate spanish akt3chapter5_c6f3f8db:

    # ggg "Have you all lost your minds?!"
    ggg "¿Han perdido la cabeza?"

# game/Story03.rpy:5391

translate spanish akt3chapter5_e2141b7c:

    # k "No, no — you are far too sane. Try madness, darling — it paints the world in honest colors."
    k "No, no — estás demasiado sano. Prueba la locura, cariño — pinta el mundo en colores honestos."

# game/Story03.rpy:5392

translate spanish akt3chapter5_c34efa9d:

    # k "Sis, remind me — what’s the punishment for mouthing off to an Inquisitor?"
    k "Sis, recuérdame: ¿Cuál es el castigo por deshacerse de un Inquisitor?"

# game/Story03.rpy:5394

translate spanish akt3chapter5_434e6ed7:

    # a "Tribunal. In wartime — execution."
    a "Tribunal. En tiempos de guerra - ejecución."

# game/Story03.rpy:5396

translate spanish akt3chapter5_bf689b28:

    # k "Oh my, how harsh. I’m trembling... with pleasure."
    k "Oh, Dios, qué duro. Estoy temblando... con placer."

# game/Story03.rpy:5398

translate spanish akt3chapter5_5f760176:

    # k "So, what were you saying, boys? Couldn’t hear you over your teeth chattering."
    k "¿Qué decían, chicos? No pudieron oírlos sobre sus dientes charlando."

# game/Story03.rpy:5400

translate spanish akt3chapter5_0769102a:

    # k "Take them away. Gently. With nails."
    k "Llévenselos con uñas."

# game/Story03.rpy:5402

translate spanish akt3chapter5_131f4000:

    # k "Justice prevails, as always!"
    k "¡La justicia prevalece, como siempre!"

# game/Story03.rpy:5404

translate spanish akt3chapter5_632438b3:

    # a "You haven’t changed. Still mad."
    a "No has cambiado. Todavía estás loco."

# game/Story03.rpy:5406

translate spanish akt3chapter5_87ad08db:

    # k "Madness is following protocol when the stage is on fire. I’m not mad... I’m just free."
    k "La locura sigue el protocolo cuando el escenario está en llamas. No estoy enojado... Solo soy libre."

# game/Story03.rpy:5407

translate spanish akt3chapter5_f47b3dd5:

    # k "And freedom, sister, smells like fire and steel."
    k "Y la libertad, hermana, huele a fuego y acero."

# game/Story03.rpy:5411

translate spanish akt3chapter5_460c62ed:

    # mc "Let’s move. We don’t have time for pleasantries."
    mc "Vamos a movernos. No tenemos tiempo para las agradables."

# game/Story03.rpy:5425

translate spanish akt3chapter5_d8df9d56:

    # mc "(Quite a crowd out there.)"
    mc "(Una multitud muy por ahí)."

# game/Story03.rpy:5427

translate spanish akt3chapter5_7468f756:

    # L "Calm down, girl. We've been through this already."
    L "Cálmate, chica, ya hemos discutido esto."

# game/Story03.rpy:5429

translate spanish akt3chapter5_c4f330ff:

    # Fl "I... I can't. There are too many people..."
    Fl "No puedo, hay demasiada gente ahí fuera."

# game/Story03.rpy:5430

translate spanish akt3chapter5_a9e7acde:

    # Fl "What if... What if they won’t agree? Then it’s all over!"
    Fl "¿Y si... y si no están de acuerdo? ¡Entonces todo terminó!"

# game/Story03.rpy:5433

translate spanish akt3chapter5_fa8bac44:

    # gg "Because of your plan, many of our comrades are still alive."
    gg "Debido a su plan, muchos de nuestros camaradas siguen vivos."

# game/Story03.rpy:5434

translate spanish akt3chapter5_2c2983cf:

    # gggg "Exactly! We’ll back you—no matter what it costs!"
    gggg "¡Exactamente! ¡Te apoyaremos, no importa lo que cueste!"

# game/Story03.rpy:5436

translate spanish akt3chapter5_90e8d73c:

    # Fl "(That’s enough. Stop trembling.)"
    Fl "(Es suficiente. Deja de temblar.)"

# game/Story03.rpy:5437

translate spanish akt3chapter5_655fd017:

    # Fl "(They don’t need perfection — they need someone who tells them where to go.)"
    Fl "(No necesitan perfección — necesitan a alguien que les diga dónde ir.)"

# game/Story03.rpy:5438

translate spanish akt3chapter5_9026bf15:

    # Fl "Yeah, you’re... right. I need to pull myself together."
    Fl "Sí, tienes razón. Necesito reunirme."

# game/Story03.rpy:5440

translate spanish akt3chapter5_1f56feb7:

    # mc "Ready?"
    mc "¿Listo?"

# game/Story03.rpy:5442

translate spanish akt3chapter5_0a4b47c2:

    # Fl "No... But I’ll do everything I can."
    Fl "No... pero haré todo lo que pueda."

# game/Story03.rpy:5444

translate spanish akt3chapter5_0297642d:

    # mc "Lora?"
    mc "¿Lora?"

# game/Story03.rpy:5446

translate spanish akt3chapter5_467d1c75:

    # L "Of course, darling!"
    L "¡Por supuesto, cariño!"

# game/Story03.rpy:5448

translate spanish akt3chapter5_b330cab0:

    # mc "And remember — this is our only shot. No margin for error."
    mc "Y recuerden: esta es nuestra única oportunidad. No hay margen para el error."

# game/Story03.rpy:5452

translate spanish akt3chapter5_abc5cc1f:

    # L "You don’t need to worry about that."
    L "No necesitas preocuparte por eso."

# game/Story03.rpy:5455

translate spanish akt3chapter5_77980029:

    # g "(Whispering) Is that her?"
    g "¿Es ella?"

# game/Story03.rpy:5456

translate spanish akt3chapter5_d5751315:

    # gg "(Whispering) The one with the cat ears? Yeah, that’s her."
    gg "¿El que tiene orejas de gato? Sí, es ella."

# game/Story03.rpy:5458

translate spanish akt3chapter5_43b86625:

    # g "(Whispering) What’s the Inquisition thinking, letting beasts command us..."
    g "(Susurrando) ¿Qué piensa la Inquisición, dejando que las bestias nos ordenen..."

# game/Story03.rpy:5463

translate spanish akt3chapter5_93394a34:

    # k "You hear that? Gossiping about us. Wait 'til they find out the truth — what a joke."
    k "Son los que nos hablan, y serán tan graciosos cuando descubran la verdad."

# game/Story03.rpy:5465

translate spanish akt3chapter5_3bdfe8c7:

    # L "How are you holding up?"
    L "¿Cómo estás?"

# game/Story03.rpy:5470

translate spanish akt3chapter5_968789a3:

    # Fl "I-I think I’m okay... apart from the mild shaking."
    Fl "Creo que estoy bien... aparte de la suave temblor."

# game/Story03.rpy:5472

translate spanish akt3chapter5_85ed116b:

    # Fl "Are you sure they’ll even listen to us?"
    Fl "¿Estás seguro de que nos escucharán?"

# game/Story03.rpy:5474

translate spanish akt3chapter5_0cc4c70c:

    # mc "Not sure. But it’s worth trying."
    mc "No estoy seguro, pero vale la pena intentarlo."

# game/Story03.rpy:5475

translate spanish akt3chapter5_4b6a5fde:

    # mc "Besides..."
    mc "Además..."

# game/Story03.rpy:5478

translate spanish akt3chapter5_f36519fa:

    # mc "(There won’t be a better moment than this.)"
    mc "(No habrá un momento mejor que este.)"

# game/Story03.rpy:5480

translate spanish akt3chapter5_03116a06:

    # ggg "(Whispering) Who do they think they are, ordering us around?"
    ggg "¿Quién creen que son, ordenándonos por ahí?"

# game/Story03.rpy:5483

translate spanish akt3chapter5_eacfde6f:

    # g "Who needs that mutt anyway?"
    g "¿Quién necesita ese mocoso?"

# game/Story03.rpy:5484

translate spanish akt3chapter5_f35d5059:

    # gg "Wasting our time... We’re doomed either way..."
    gg "Estamos perdidos nuestro tiempo... estamos condenados de cualquier manera..."

# game/Story03.rpy:5486

translate spanish akt3chapter5_0a317cc2:

    # mc "(Tired. Angry. Starving for someone to lead them.)"
    mc "(Cansado. Enojado. Mirándolos para que alguien los guíe.)"

# game/Story03.rpy:5490

translate spanish akt3chapter5_8f13d9d7:

    # mc "SILENCE!"
    mc "¡Silencio!"

# game/Story03.rpy:5493

translate spanish akt3chapter5_4e519e3e:

    # mc "I know. You're scared. Angry. Broken."
    mc "Lo sé, estás asustado, enfadado, roto."

# game/Story03.rpy:5494

translate spanish akt3chapter5_51112ac0:

    # mc "Some of you already buried hope. Some just wait to be next."
    mc "Algunos ya han enterrado la esperanza, algunos esperan ser los siguientes."

# game/Story03.rpy:5495

translate spanish akt3chapter5_9e7b0ee4:

    # mc "You don’t owe me trust. And hell, you sure as hell didn’t lose your people for my sake."
    mc "No me debes confianza. Y el infierno, seguro que no perdiste a tu gente por mi bien."

# game/Story03.rpy:5497

translate spanish akt3chapter5_aadcbdd3:

    # g "(Whispering) He’s right..."
    g "(Susurrando) Tiene razón..."

# game/Story03.rpy:5498

translate spanish akt3chapter5_d3578cc3:

    # mc "But if you’re looking for something—anything—to hold on to..."
    mc "Pero si estás buscando algo —nada— para aferrarte a..."

# game/Story03.rpy:5499

translate spanish akt3chapter5_a569775e:

    # mc "...hold on to this: we’re still alive."
    mc "...continúe con esto: seguimos vivos."

# game/Story03.rpy:5501

translate spanish akt3chapter5_3e058f65:

    # mc "Some of you left families behind."
    mc "Algunos de ustedes dejaron atrás a las familias."

# game/Story03.rpy:5503

translate spanish akt3chapter5_325d0612:

    # mc "Some had brothers-in-arms."
    mc "Algunos tenían hermanos en armas."

# game/Story03.rpy:5505

translate spanish akt3chapter5_04e207fc:

    # mc "Some are still holding a photograph in their pocket."
    mc "Algunos todavía tienen una fotografía en su bolsillo."

# game/Story03.rpy:5507

translate spanish akt3chapter5_f5bbbe5b:

    # mc "We fight for life. Not for ideas. Not flags. People."
    mc "Luchamos por la vida, no por ideas, no banderas, gente."

# game/Story03.rpy:5513

translate spanish akt3chapter5_aa53f735:

    # mc "This is Flora Sevin."
    mc "Soy Flora Sevin."

# game/Story03.rpy:5514

translate spanish akt3chapter5_141aa9dc:

    # mc "Not a hero. Not a savior. Just someone who showed up with a plan..."
    mc "No un héroe, no un salvador, solo alguien que apareció con un plan..."

# game/Story03.rpy:5515

translate spanish akt3chapter5_97389040:

    # mc "...while the rest stood around arguing and dying."
    mc "Mientras el resto se quedó discutiendo y muriendo."

# game/Story03.rpy:5517

translate spanish akt3chapter5_a0906736:

    # g "(Whispering) She’s a beast..."
    g "(Susurrando) Ella es una bestia..."

# game/Story03.rpy:5518

translate spanish akt3chapter5_4560c805:

    # gg "(Whispering) But she has a plan…?"
    gg "¿Pero tiene un plan...?"

# game/Story03.rpy:5520

translate spanish akt3chapter5_3cc6188d:

    # mc "Yes, she’s not human."
    mc "Sí, no es humana."

# game/Story03.rpy:5532

translate spanish akt3chapter5_3a78d76b:

    # mc "But if you’re looking for someone to call your own — look to the ones who stood tall when everything burned. She stood."
    mc "Pero si estás buscando a alguien que llame a tu propio, mira a los que se pusieron de pie cuando todo se quemó. Se quedó de pie."

# game/Story03.rpy:5534

translate spanish akt3chapter5_64df8345:

    # mc "(Voice is shaking... Hope they didn’t catch that.)"
    mc "(Voice está temblando... Espero que no hayan atrapado eso.)"

# game/Story03.rpy:5536

translate spanish akt3chapter5_282f980e:

    # mc "(Every word feels like a rock in my throat.)"
    mc "(Cada palabra se siente como una roca en mi garganta.)"

# game/Story03.rpy:5541

translate spanish akt3chapter5_52c0f96b:

    # mc "(Screw it. Enough self-pity.)"
    mc "¡Basta de autocompasión!"

# game/Story03.rpy:5543

translate spanish akt3chapter5_f26055fa:

    # mc "I know some of you call us traitors."
    mc "Sé que algunos de ustedes nos llaman traidores."

# game/Story03.rpy:5545

translate spanish akt3chapter5_75f652cc:

    # mc "So be it."
    mc "Así que sea."

# game/Story03.rpy:5547

translate spanish akt3chapter5_c95094d0:

    # mc "But when that thing from beneath the earth comes to devour your home — we’ll be the first to stand."
    mc "Pero cuando esa cosa de abajo de la tierra venga a devorar su casa — seremos los primeros en ponerse de pie."

# game/Story03.rpy:5548

translate spanish akt3chapter5_af89540a:

    # mc "Not because you're right. But because there’s no one else left."
    mc "No porque tengas razón, pero porque no queda nadie más."

# game/Story03.rpy:5551

translate spanish akt3chapter5_3d8f2fc3:

    # mc "(They look at me like I’ve lost my mind. Fine. As long as they listen.)"
    mc "(Me miran como si hubiera perdido la cabeza. Bien. Mientras ellos escuchen.)"

# game/Story03.rpy:5552

translate spanish akt3chapter5_c1415be6:

    # mc "We fight as long as we breathe. As long as we have purpose. As long as someone’s still standing."
    mc "Luchamos mientras respiramos. Mientras tengamos propósito. Mientras alguien esté de pie."

# game/Story03.rpy:5559

translate spanish akt3chapter5_9a370dbe:

    # mc "From now on — we’re one. No more 'them.' Only 'us.'"
    mc "A partir de ahora, somos uno, ya no hay \"ellos\" sino \"nosotros\"."

# game/Story03.rpy:5560

translate spanish akt3chapter5_ab7f4757:

    # mc "Think you can do better? Be my guest. Prove it."
    mc "- ¿Crees que puedes hacerlo mejor?"

# game/Story03.rpy:5561

translate spanish akt3chapter5_b1f1f547:

    # mc "If you stay — follow orders. There’s no room for mistakes anymore."
    mc "Si te quedas — sigue órdenes. Ya no hay lugar para errores."

# game/Story03.rpy:5563

translate spanish akt3chapter5_13f09734:

    # mc "One chance. There won’t be another."
    mc "Una oportunidad. No habrá otra."

# game/Story03.rpy:5564

translate spanish akt3chapter5_4f740eea:

    # mc "Together — we live."
    mc "Juntos — vivimos."

# game/Story03.rpy:5565

translate spanish akt3chapter5_9ef52384:

    # mc "Alone — we rot."
    mc "Solos, nos pudrimos."

# game/Story03.rpy:5567

translate spanish akt3chapter5_a56690f8:

    # L "Don’t worry, girl. If it all goes to hell — we’ll have your back."
    L "No te preocupes, chica. Si todo va al infierno - tendremos tu espalda."

# game/Story03.rpy:5569

translate spanish akt3chapter5_c01b0c7a:

    # Fl "(They... believe in me. I don’t get to fall apart now.)"
    Fl "(Ellos... creen en mí. No puedo desmoronarme ahora.)"

# game/Story03.rpy:5571

translate spanish akt3chapter5_7108fc77:

    # Fl "(No matter what it costs.)"
    Fl "(No importa lo que cueste)."

# game/Story03.rpy:5573

translate spanish akt3chapter5_ead321f2:

    # Fl "Thank you... I... I’ll do my best."
    Fl "Gracias... haré lo mejor que pueda."

# game/Story03.rpy:5582

translate spanish akt3chapter5_226e69d0:

    # g "What’s your plan?"
    g "¿Cuál es tu plan?"

# game/Story03.rpy:5585

translate spanish akt3chapter5_b359d44f:

    # Fl "To freeze the Soulless. With cryogen."
    Fl "Congelar a los Desalmados."

# game/Story03.rpy:5587

translate spanish akt3chapter5_30775db2:

    # gg "You think cryogen can stop the Soulless?"
    gg "¿Crees que el criógeno puede detener a los Desalmados?"

# game/Story03.rpy:5588

translate spanish akt3chapter5_e2153c13:

    # Fl "I don’t believe. I know."
    Fl "No creo. Lo sé."

# game/Story03.rpy:5589

translate spanish akt3chapter5_354baf61:

    # ggg "That’s suicide!"
    ggg "¡Eso es suicidio!"

# game/Story03.rpy:5590

translate spanish akt3chapter5_069a17cb:

    # Fl "Then we have the same expectations. The only question is — do you want to die for nothing, or for something that matters?"
    Fl "Entonces tenemos las mismas expectativas. La única pregunta es: ¿quieres morir por nada, o por algo que importa?"

# game/Story03.rpy:5593

translate spanish akt3chapter5_a46bb0f1:

    # Fl "Second phase is taking back the central tower."
    Fl "La segunda fase está devolviendo la torre central."

# game/Story03.rpy:5595

translate spanish akt3chapter5_59ab45a3:

    # gg "And you think we’re strong enough for that?"
    gg "¿Y crees que somos lo suficientemente fuertes para eso?"

# game/Story03.rpy:5599

translate spanish akt3chapter5_3836ec07:

    # Fl "(Even now, they’re looking for an excuse to doubt. Habit. Fear.)"
    Fl "(Incluso ahora, están buscando una excusa para dudar. Hábito. Miedo.)"

# game/Story03.rpy:5600

translate spanish akt3chapter5_ae7ae1fb:

    # Fl "(Breathe... Just breathe. You prepared for this.)"
    Fl "(Tranquilo... respira."

# game/Story03.rpy:5602

translate spanish akt3chapter5_92f716a9:

    # Fl "(Don’t let them control the moment. Don’t let their faith in you fade.)"
    Fl "(No dejes que ellos controlen el momento. No dejes que su fe en ti se desvaneca.)"

# game/Story03.rpy:5607

translate spanish akt3chapter5_0f459a39:

    # Fl "(Yes! I don’t want to hide anymore. Not now. Not in front of them.)"
    Fl "(Sí! No quiero esconderme más. No ahora. No delante de ellos.)"

# game/Story03.rpy:5609

translate spanish akt3chapter5_6dbfd782:

    # Fl "(If I don’t say this now — everything falls apart. I have to.)"
    Fl "(Si no digo esto ahora — todo se desmorona. Tengo que hacerlo.)"

# game/Story03.rpy:5612

translate spanish akt3chapter5_72923443:

    # Fl "(whispering) Enough with the doubt. We don’t have time for fear. Only for action.)"
    Fl "(susurando) Basta con la duda. No tenemos tiempo para el miedo. Solo para la acción.)"

# game/Story03.rpy:5615

translate spanish akt3chapter5_137f0eef:

    # Fl "If you want to survive — shut up and listen!"
    Fl "Si quieres sobrevivir — ¡Cállate y escucha!"

# game/Story03.rpy:5617

translate spanish akt3chapter5_a6b1657b:

    # g "How are you going to pull that off?"
    g "¿Cómo vas a sacar eso?"

# game/Story03.rpy:5630

translate spanish akt3chapter5_b2cc0e49:

    # Fl "Our entire city is fitted with an air processing system."
    Fl "Toda nuestra ciudad está equipada con un sistema de procesamiento de aire."

# game/Story03.rpy:5631

translate spanish akt3chapter5_8e7a647c:

    # Fl "The first team will head to the pumping station to load the cryogen."
    Fl "El primer equipo irá a la estación de bombeo para cargar el criógeno."

# game/Story03.rpy:5632

translate spanish akt3chapter5_26b2b992:

    # Fl "The second will provide cover."
    Fl "El segundo proporcionará cobertura."

# game/Story03.rpy:5635

translate spanish akt3chapter5_d19cb6e3:

    # g "And if the plan fails? Who takes the fall?"
    g "¿Y si el plan falla?"

# game/Story03.rpy:5637

translate spanish akt3chapter5_a94bdc54:

    # gg "Why should we trust a beast none of us knew yesterday?"
    gg "¿Por qué deberíamos confiar en una bestia que ninguno de nosotros sabía ayer?"

# game/Story03.rpy:5638

translate spanish akt3chapter5_fd8609c8:

    # gg "And what about the civilians? Planning to leave them behind?"
    gg "¿Y qué hay de los civiles?"

# game/Story03.rpy:5640

translate spanish akt3chapter5_eb459e1e:

    # em "My people have taken care of that."
    em "Mi gente se ha encargado de eso."

# game/Story03.rpy:5642

translate spanish akt3chapter5_c65bb771:

    # gg "Hmph... Then where are all these survivors you claim to have saved?"
    gg "Hmph... ¿dónde están todos estos sobrevivientes que afirmas haber salvado?"

# game/Story03.rpy:5643

translate spanish akt3chapter5_7e4ebe83:

    # em "In the Lower City."
    em "En la Ciudad Baja."

# game/Story03.rpy:5645

translate spanish akt3chapter5_b779f06c:

    # em "We’re not the hypocrites you think we are."
    em "No somos los hipócritas que crees que somos."

# game/Story03.rpy:5647

translate spanish akt3chapter5_4536ecd3:

    # em "And we’re ready to fight for our people. Unlike you."
    em "Y estamos listos para luchar por nuestra gente. A diferencia de ti."

# game/Story03.rpy:5655

translate spanish akt3chapter5_c13b11d4:

    # Fl "(Thank you.)"
    Fl "(Gracias.)"

# game/Story03.rpy:5658

translate spanish akt3chapter5_e0563b47:

    # g "But what about the Tower?"
    g "¿Pero qué hay de la Torre?"

# game/Story03.rpy:5659

translate spanish akt3chapter5_42d6f64e:

    # g "We don’t have the strength to take it back from the enemy. And we don’t even know who’s attacking."
    g "No tenemos la fuerza para recuperarla del enemigo. Y ni siquiera sabemos quién está atacando."

# game/Story03.rpy:5660

translate spanish akt3chapter5_39e0faad:

    # g "So why fight for it?"
    g "¿Por qué luchar por ello?"

# game/Story03.rpy:5663

translate spanish akt3chapter5_022d8a84:

    # L "Because if we don’t — everyone dies."
    L "Porque si no lo hacemos, todos mueren."

# game/Story03.rpy:5668

translate spanish akt3chapter5_8ba599ae:

    # L "The Tower is a tomb."
    L "La Torre es una tumba."

# game/Story03.rpy:5669

translate spanish akt3chapter5_a0cb3f70:

    # L "If we let the enemy take it — they’ll activate the core. It’s over. Not just the city — the whole planet."
    L "Si dejamos que el enemigo lo tome, activarán el núcleo. Se acabó. No solo la ciudad — todo el planeta."

# game/Story03.rpy:5672

translate spanish akt3chapter5_067e8185:

    # ggg "A tomb?! What are you even saying?"
    ggg "¿Qué estás diciendo?"

# game/Story03.rpy:5673

translate spanish akt3chapter5_7c61ce42:

    # gggg "That can’t be... that’s just some old legend!"
    gggg "Eso no puede ser... ¡es solo una vieja leyenda!"

# game/Story03.rpy:5674

translate spanish akt3chapter5_c3bd15fc:

    # g "You’re insane! The Tower is the command center!"
    g "¡Estás loco! ¡La Torre es el centro de mando!"

# game/Story03.rpy:5676

translate spanish akt3chapter5_bd314158:

    # k "Sis... What do we do? The crowd’s buzzing like a hornet’s nest. Show one crack — they’ll tear us apart."
    k "Sis... ¿Qué hacemos? La multitud está zumbido como un nido de hornet. Mostrar una grieta — nos destrozarán."

# game/Story03.rpy:5688

translate spanish akt3chapter5_63c9f7ff:

    # a "Silence!"
    a "¡Silencio!"

# game/Story03.rpy:5690

translate spanish akt3chapter5_66cbdc61:

    # k "Gods... how does she do that every time..."
    k "Dioses... ¿cómo lo hace cada vez..."

# game/Story03.rpy:5694

translate spanish akt3chapter5_ffd98329:

    # a "What this girl says — is true."
    a "Lo que esta chica dice es verdad."

# game/Story03.rpy:5695

translate spanish akt3chapter5_60e660a2:

    # a "And if we don’t take it back — our entire Federation falls."
    a "Y si no lo recuperamos — toda nuestra Federación cae."

# game/Story03.rpy:5699

translate spanish akt3chapter5_f7c9fc1d:

    # k "Remind me, sis, what was that you said earlier about caring for the common folk?"
    k "Recuérdame, hermana, ¿qué dijiste antes sobre cuidar a la gente común?"

# game/Story03.rpy:5702

translate spanish akt3chapter5_f36161d2:

    # a "Shut up."
    a "Cállate."

# game/Story03.rpy:5707

translate spanish akt3chapter5_d1ff28c0:

    # ggg "But we still don’t have the manpower to take it..."
    ggg "Pero todavía no tenemos el poder de tomarlo..."

# game/Story03.rpy:5708

translate spanish akt3chapter5_64e7d7de:

    # g "Where... Where are you going to get people for this?"
    g "¿Dónde... dónde vas a conseguir gente para esto?"

# game/Story03.rpy:5710

translate spanish akt3chapter5_520da0f1:

    # mc "We’ll send a small strike team."
    mc "Enviaremos un pequeño equipo de huelga."

# game/Story03.rpy:5712

translate spanish akt3chapter5_d864cc0a:

    # Fl "While the Syndicate and the Peacekeepers are focused on destroying the Soulless..."
    Fl "Mientras que el Sindicato y los Pacificadores están enfocados en destruir a los Insalubres..."

# game/Story03.rpy:5713

translate spanish akt3chapter5_3e22db4e:

    # Fl "The team — led by [mc] — will head straight to the tower's core."
    if mc == "Kael" or persistent.mc_name == "Kael":
        Fl "El grupo, liderado por Kael, se dirigirá directamente al núcleo de la Torre."
    else:
        Fl "El grupo bajo la dirección [mc!t] Va directo al núcleo de la Torre."

# game/Story03.rpy:5715

translate spanish akt3chapter5_8f8f1e13:

    # g "This whole plan is a death sentence!"
    g "¡Todo este plan es una sentencia de muerte!"

# game/Story03.rpy:5716

translate spanish akt3chapter5_2cff9a14:

    # gg "Who the hell would agree to join a suicide squad?"
    gg "¿Quién demonios aceptaría unirse a un equipo suicida?"

# game/Story03.rpy:5722

translate spanish akt3chapter5_20a26d58:

    # mc "You have one choice: stay here… or fight. For yourselves. For those who can’t anymore."
    mc "Ustedes tienen una opción: quedarse aquí... o luchar. Por ustedes mismos. Para aquellos que ya no pueden."

# game/Story03.rpy:5725

translate spanish akt3chapter5_f89d0470:

    # mc "I’m not going to sit around and wait for them to come for me."
    mc "No voy a sentarme y esperar a que vengan por mí."

# game/Story03.rpy:5727

translate spanish akt3chapter5_774a04e1:

    # mc "I’m going. Alone — if I have to."
    mc "Yo voy. Solo — si tengo que hacerlo."

# game/Story03.rpy:5729

translate spanish akt3chapter5_057b2d5b:

    # mc "(That’s it. It’s now or never.)"
    mc "(Eso es todo. Es ahora o nunca.)"

# game/Story03.rpy:5732

translate spanish akt3chapter5_f98f0dcf:

    # mc "(So… No one?)"
    mc "(Entonces... ¿Nadie?)"

# game/Story03.rpy:5736

translate spanish akt3chapter5_7246e336:

    # mc "(Whispering) Then I have no choice but to go alone."
    mc "Entonces no tengo más remedio que ir solo."

# game/Story03.rpy:5743

translate spanish akt3chapter5_c99e07f7:

    # L "Without me, you won’t stand a chance."
    L "Sin mí, no tendrás oportunidad."

# game/Story03.rpy:5745

translate spanish akt3chapter5_11cf044b:

    # mc "Time to make up for lost time, right?"
    mc "Es hora de compensar el tiempo perdido, ¿verdad?"

# game/Story03.rpy:5749

translate spanish akt3chapter5_f613659c:

    # mc "Anyone else?"
    mc "¿Alguien más?"

# game/Story03.rpy:5752

translate spanish akt3chapter5_1da63c9b:

    # Mi "I’m in."
    Mi "Estoy dentro."

# game/Story03.rpy:5755

translate spanish akt3chapter5_556c194f:

    # el "What are you doing, you idiot?!"
    el "¿Qué estás haciendo, idiota?"

# game/Story03.rpy:5760

translate spanish akt3chapter5_9b5e828e:

    # h "Like I’d let you go alone."
    h "Como si te dejara ir solo."

# game/Story03.rpy:5763

translate spanish akt3chapter5_3afe9822:

    # k "Let you two have all the fun? Not a chance."
    k "¿Que os dejeis divertiros?"

# game/Story03.rpy:5772

translate spanish akt3chapter5_d8638cbb:

    # ggg "We’re with you!"
    ggg "¡Estamos contigo!"

# game/Story03.rpy:5776

translate spanish akt3chapter5_b0ba6e55:

    # gg "What the hell are you doing?!"
    gg "¿Qué demonios estás haciendo?"

# game/Story03.rpy:5778

translate spanish akt3chapter5_0b7d5e38:

    # g "...Damn it. After a speech like that... I just can’t stay behind."
    g "...Démela. Después de un discurso como ese... no puedo quedarme atrás."

# game/Story03.rpy:5779

translate spanish akt3chapter5_a2866d2b:

    # gg "But it’s suici—"
    gg "Pero es suici..."

# game/Story03.rpy:5780

translate spanish akt3chapter5_2b247cce:

    # g "Maybe. But I’d rather die with a gun in my hands than under their boots in some filthy hole."
    g "Quizás. Pero preferiría morir con un arma en mis manos que bajo sus botas en un agujero sucio."

# game/Story03.rpy:5785

translate spanish akt3chapter5_4f655c15:

    # gg "Yeah? Screw it then, I’m in too!"
    gg "¿Sí? ¡Al diablo entonces, yo también estoy dentro!"

# game/Story03.rpy:5787

translate spanish akt3chapter5_bc3915d8:

    # ggg "Same here!"
    ggg "¡Lo mismo aquí!"

# game/Story03.rpy:5788

translate spanish akt3chapter5_a600ef17:

    # mc "That’s — enough."
    mc "Eso es suficiente."

# game/Story03.rpy:5789

translate spanish akt3chapter5_4366c8c6:

    # mc "Now — they’re with us."
    mc "Ahora, están con nosotros."

# game/Story03.rpy:5791

translate spanish akt3chapter5_e5df6447:

    # mc "Now we fight not just for ourselves — but so they get to see tomorrow."
    mc "Ahora luchamos no solo por nosotros mismos, sino que llegan a ver mañana."

# game/Story03.rpy:5793

translate spanish akt3chapter5_1f60dd06:

    # em "This young man... never ceases to surprise me."
    em "Este joven... nunca deja de sorprenderme."

# game/Story03.rpy:5795

translate spanish akt3chapter5_0bd28ccb:

    # em "This was your plan all along, wasn’t it, Astoria?"
    em "Este era tu plan todo el tiempo, ¿no es así, Astoria?"

# game/Story03.rpy:5797

translate spanish akt3chapter5_ead8f03c:

    # scar "Not bad."
    scar "No está mal."

# game/Story03.rpy:5799

translate spanish akt3chapter5_52007fd3:

    # scar "You’ve gained quite the ally, Flora."
    scar "Has ganado bastante el aliado, Flora."

# game/Story03.rpy:5816

translate spanish akt3chapter5_397c4916:

    # aa "The view from up here suits you, lady Astoria."
    aa "La vista desde aquí arriba le queda bien, señora Astoria."

# game/Story03.rpy:5817

translate spanish akt3chapter5_b89cf2d2:

    # aa "Almost imperial — grand, with just a hint of mass grave."
    aa "Casi imperial — grandes, con solo un toque de fosa de masa."

# game/Story03.rpy:5820

translate spanish akt3chapter5_03d73107:

    # aa "Still playing statue?"
    aa "¿Sigues jugando a la estatua?"

# game/Story03.rpy:5822

translate spanish akt3chapter5_03b6b523:

    # sel "Leave her. One more word and you’ll find out what death in silk gloves looks like."
    sel "Déjala. Una palabra más y descubrirás cómo es la muerte en guantes de seda."

# game/Story03.rpy:5827

translate spanish akt3chapter5_5cf519eb:

    # aa "Yes, my queen."
    aa "Sí, mi reina."

# game/Story03.rpy:5830

translate spanish akt3chapter5_08384062:

    # am "How long do you plan to drag out this opera you call 'liberation'?"
    am "¿Cuánto tiempo planeas hacer esta ópera que llamas \"liberación\"?"

# game/Story03.rpy:5833

translate spanish akt3chapter5_2681630e:

    # sel "We’re on the brink, Astoria. The blood of the Ancients — almost gathered."
    sel "Estamos en el borde, Astoria. La sangre de los Antiguos — casi reunida."

# game/Story03.rpy:5834

translate spanish akt3chapter5_1bc59a61:

    # sel "Only one last step remains."
    sel "Queda solo un último paso."

# game/Story03.rpy:5836

translate spanish akt3chapter5_d7fa06d6:

    # am "Do you realize you’ve sparked an interspecies massacre for that 'blood'? Billions — for a drop?"
    am "¿Te das cuenta de que has causado matanzas por la inspección por esta sangre?"

# game/Story03.rpy:5838

translate spanish akt3chapter5_077d1c05:

    # sel "The blood is just a symbol. We’re fighting for the right to exist outside the shadows."
    sel "La sangre es solo un símbolo. Estamos luchando por el derecho a existir fuera de las sombras."

# game/Story03.rpy:5839

translate spanish akt3chapter5_5219d582:

    # sel "To restore the Elven order, where intellect isn’t a death sentence — but a claim to the throne."
    sel "Para restaurar el orden Elven, donde el intelecto no es una sentencia de muerte, sino una reclamación al trono."

# game/Story03.rpy:5841

translate spanish akt3chapter5_a3a3f4d8:

    # am "Motives don’t hide behind flags. You see them in burning cities and children’s bones beneath your fleets."
    am "Los motivos no se esconden detrás de las banderas. Los ves en ciudades quemandas y huesos de niños debajo de tus flotas."

# game/Story03.rpy:5846

translate spanish akt3chapter5_41c06004:

    # sel "You wouldn’t understand. Even your blood is sterile."
    sel "No lo entenderías. Incluso tu sangre es estéril."

# game/Story03.rpy:5848

translate spanish akt3chapter5_8849980a:

    # am "Emotion is a virus. And you — are infected."
    am "La emoción es un virus. Y tú, estás infectado."

# game/Story03.rpy:5850

translate spanish akt3chapter5_f74e3679:

    # sel "And now you’re the one giving diagnoses?"
    sel "¿Y ahora eres tú quien da diagnósticos?"

# game/Story03.rpy:5854

translate spanish akt3chapter5_04aa628b:

    # am "You overthrew Gorem. Usurped his throne. He was at least a fanatic — you’re just a calculator wrapped in powdered ethics."
    am "Le derrotaste a Gorem. Le envolviste el trono. Era al menos un fanático — eres solo una calculadora envuelta en ética en polvo."

# game/Story03.rpy:5856

translate spanish akt3chapter5_7739891c:

    # sel "Following your example."
    sel "Siguiendo su ejemplo."

# game/Story03.rpy:5862

translate spanish akt3chapter5_cba6400d:

    # am "If I destroy you — will this circus of corpses and delusions end?"
    am "Si te destruyo, ¿acaso terminará este circo de cadáveres y delirios?"

# game/Story03.rpy:5864

translate spanish akt3chapter5_7c2b6696:

    # sel "Perhaps. Or maybe... you’ll just lose the one person who still understands what you’ve become."
    sel "Quizás. O tal vez... perderás a la única persona que aún entiende lo que te has convertido."

# game/Story03.rpy:5867

translate spanish akt3chapter5_c22a4cd3:

    # am "I don’t tolerate uncertainty."
    am "No toleraré la incertidumbre."

# game/Story03.rpy:5876

translate spanish akt3chapter5_c28c00dd:

    # sel "That hurts..."
    sel "Eso duele..."

# game/Story03.rpy:5878

translate spanish akt3chapter5_93736dc6:

    # am "...Predictable."
    am "...predicible."

# game/Story03.rpy:5881

translate spanish akt3chapter5_eed00208:

    # sel "You could’ve warned me. Blasting my head apart is, at the very least, bad manners."
    sel "Podrías haberme advertido. Destrozar mi cabeza es, al menos, malos modales."

# game/Story03.rpy:5883

translate spanish akt3chapter5_72012397:

    # am "I didn’t lay a finger on you."
    am "No te puse un dedo."

# game/Story03.rpy:5885

translate spanish akt3chapter5_ef0a63fd:

    # sel "You shattered my skull."
    sel "Me rompiste el cráneo."

# game/Story03.rpy:5889

translate spanish akt3chapter5_58c1b8df:

    # am "Yours? Or that thing you call 'you'?"
    am "¿O cómo te llamas?"

# game/Story03.rpy:5894

translate spanish akt3chapter5_3fa6487c:

    # sel "You knew. And still did it. That’s not like you, Astoria..."
    sel "Lo sabías, y aún así lo hiciste."

# game/Story03.rpy:5907

translate spanish akt3chapter5_c1d02e44:

    # Fl "You know… I still can’t believe you didn’t run the moment you got the chance."
    Fl "Sabes... todavía no puedo creer que no hayas corrido el momento en que tengas la oportunidad."

# game/Story03.rpy:5910

translate spanish akt3chapter5_58006ad4:

    # mc "And you’re still shocked someone could actually stand your personality?"
    mc "¿Y aún estás conmocionado que alguien pueda soportar tu personalidad?"

# game/Story03.rpy:5913

translate spanish akt3chapter5_6c4609f2:

    # Fl "It’s not every day a genius growls at you."
    Fl "No es cada día que un genio te crece."

# game/Story03.rpy:5914

translate spanish akt3chapter5_6ad84013:

    # Fl "Though in my case, it’s more of a… venomous hiss."
    Fl "Aunque en mi caso, es más de un... venenoso suyo."

# game/Story03.rpy:5917

translate spanish akt3chapter5_21398537:

    # mc "You didn’t just hiss. You were a goddamn drill bit — screwing straight into my cortex."
    mc "No solo el suyo. Eras un maldito pedazo de perforación, atornillando directamente a mi corteza."

# game/Story03.rpy:5918

translate spanish akt3chapter5_5ada6331:

    # mc "But you dragged us through three layers of hell. For that — thanks."
    mc "Pero nos arrastraste a través de tres capas del infierno. Para eso — gracias."

# game/Story03.rpy:5922

translate spanish akt3chapter5_ca5efc42:

    # Fl "...Thanks."
    Fl "Gracias."

# game/Story03.rpy:5925

translate spanish akt3chapter5_32206aac:

    # Fl "For believing in me. Even when I didn’t."
    Fl "Por creer en mí. Incluso cuando no lo hice."

# game/Story03.rpy:5927

translate spanish akt3chapter5_62727855:

    # mc "You? Doubting?"
    mc "¿Dudas?"

# game/Story03.rpy:5928

translate spanish akt3chapter5_0b8442e8:

    # mc "Who are you and what did you do with Flora?"
    mc "¿Quién eres tú y qué hiciste con Flora?"

# game/Story03.rpy:5931

translate spanish akt3chapter5_4d484526:

    # Fl "I buried her. Deep. Somewhere even I can’t dig her out."
    Fl "La enterré. En el fondo, incluso en algún lugar no puedo sacarla."

# game/Story03.rpy:5933

translate spanish akt3chapter5_1fb84e72:

    # mc "What now?"
    mc "¿Y ahora qué?"

# game/Story03.rpy:5935

translate spanish akt3chapter5_75c6246b:

    # Fl "Comm link. I’ll try to reach my father."
    Fl "Comm link. Intentaré llegar a mi padre."

# game/Story03.rpy:5937

translate spanish akt3chapter5_1eda0920:

    # Fl "If he’s... still alive."
    Fl "Si él está... aún vivo."

# game/Story03.rpy:5939

translate spanish akt3chapter5_8af492ff:

    # mc "(Sure. Not worried at all. You're practically vibrating.)"
    mc "(Por supuesto, no te preocupas en absoluto, casi te estás sacudiendo)."

# game/Story03.rpy:5940

translate spanish akt3chapter5_ba5215ec:

    # Fl "R-right, Flora! Of course he's okay, he’s—"
    Fl "Sí, Flora, está totalmente bien, es él."

# game/Story03.rpy:5941

translate spanish akt3chapter5_0191c37b:

    # mc "(She’s spiraling. {w}Maybe I should—)"
    mc "(Ella está en espiral. {w}Tal vez debería...)"

# game/Story03.rpy:5942

translate spanish akt3chapter5_9a18e138:

    # Fl "You’re just overthinki—"
    Fl "Estás demasiado pensado..."

# game/Story03.rpy:5946

translate spanish akt3chapter5_8ee75081:

    # mc "You’re shaking."
    mc "Te estás sacudiendo."

# game/Story03.rpy:5948

translate spanish akt3chapter5_d46b71a3:

    # mc "He’ll be fine. Even barely knowing him... I can feel that."
    mc "Estará bien. Incluso apenas lo conozco... puedo sentirlo."

# game/Story03.rpy:5949

translate spanish akt3chapter5_ff1af37e:

    # mc "He raised you — so that alone makes him some kind of legend."
    mc "Él te crió, así que solo le hace una especie de leyenda."

# game/Story03.rpy:5951

translate spanish akt3chapter5_19f528c1:

    # mc "But right now, you need to take care of yourself first. {w}Alright?"
    mc "Pero ahora mismo, tienes que cuidarte primero. {w}¿De acuerdo?"

# game/Story03.rpy:5953

translate spanish akt3chapter5_522c95f4:

    # mc "(Great pep talk, [mc]. Motivational genius. Who’s saving who here again?)"
    mc "(Gran charla de la pipa, [mc]. genio motivacional. ¿Quién está salvando a quién aquí otra vez?)"

# game/Story03.rpy:5954

translate spanish akt3chapter5_3783bba9:

    # Fl "You and him... hopeless optimists."
    Fl "Tú y él... optimistas sin esperanza."

# game/Story03.rpy:5958

translate spanish akt3chapter5_14330d71:

    # Fl "You know, for someone clinging so close, you’re awfully moral."
    Fl "Sabes, para alguien aferrarse tan cerca, eres terriblemente moral."

# game/Story03.rpy:5961

translate spanish akt3chapter5_15371585:

    # Fl "In the other side..."
    Fl "En el otro lado..."

# game/Story03.rpy:5964

translate spanish akt3chapter5_c86ee6ae:

    # Fl "I don’t mind."
    Fl "No me importa."

# game/Story03.rpy:5966

translate spanish akt3chapter5_37bf6e39:

    # Fl "I wouldn’t mind picking up where we left off..."
    Fl "No me importaría recoger donde nos fuimos..."

# game/Story03.rpy:5969

translate spanish akt3chapter5_70ce71e1:

    # mc "Not now."
    mc "Ahora no."

# game/Story03.rpy:5970

translate spanish akt3chapter5_b2dbb847:

    # Fl "No...? You sure?"
    Fl "¿Estás seguro?"

# game/Story03.rpy:5979

translate spanish akt3chapter5_be85719e:

    # Fl "Boop... Believe me, I’d love to feel you again — every inch of you—"
    Fl "Boop... Créeme, me encantaría sentirte de nuevo — cada pulgada de ti—"

# game/Story03.rpy:5983

translate spanish akt3chapter5_182989fd:

    # Fl "...but you’re right. Now’s not the time."
    Fl "... pero tienes razón. Ahora no es el momento."

# game/Story03.rpy:5989

translate spanish akt3chapter5_5e11b74b:

    # Fl "So... gonna let me go?"
    Fl "Entonces... ¿me dejará ir?"

# game/Story03.rpy:5990

translate spanish akt3chapter5_28b8c7f3:

    # mc "I’m not holding you. It’s you who won’t let go."
    mc "No te sostendré. Eres tú quien no te dejará ir."

# game/Story03.rpy:5994

translate spanish akt3chapter5_58942413:

    # Fl "Tell the short one I said hi."
    Fl "Dile al pequeño que te saludé."

# game/Story03.rpy:5996

translate spanish akt3chapter5_8a68d655:

    # mc "Take care of yourself."
    mc "Cuídate."

# game/Story03.rpy:5998

translate spanish akt3chapter5_96b6b8af:

    # mc "(Time to go. I owe a visit... to one wicked little girl.)"
    mc "(Hora de irse. Debo una visita... a una niña mala.)"

# game/Story03.rpy:6005

translate spanish akt3chapter5_d879c7ef:

    # Mi "Don't fall behind, Olivia."
    Mi "Sigue, Olivia."

# game/Story03.rpy:6007

translate spanish akt3chapter5_cf5ef594:

    # h "Me? Fall behind? Keep dreaming, elf-girl. I’m about to wipe the floor with you."
    h "¿Yo? ¿Me dejas caer? Sigue soñando, elf-girl. Estoy a punto de limpiar el suelo contigo."

# game/Story03.rpy:6029

translate spanish akt3chapter5_be88d995:

    # Mi "Color me impressed. You’d usually be wheezing on the floor by now."
    Mi "Color me impresionó. Normalmente estarías azotando en el suelo por ahora."

# game/Story03.rpy:6034

translate spanish akt3chapter5_420adc9f:

    # h "Gotcha!"
    h "¡Te tengo!"

# game/Story03.rpy:6037

translate spanish akt3chapter5_19d73308:

    # h "Time for a little payback!"
    h "¡Es hora de una pequeña recompensa!"

# game/Story03.rpy:6049

translate spanish akt3chapter5_fd061f03:

    # Mi "One–zero, Olivia. Want me to keep going?"
    Mi "Uno-cero, Olivia. ¿Quieres que siga?"

# game/Story03.rpy:6052

translate spanish akt3chapter5_1b85c54f:

    # h "That’s not fair! We agreed — no implants, no cheap tricks!"
    h "¡Eso no es justo! Acordamos — no implantes, no trucos baratos!"

# game/Story03.rpy:6058

translate spanish akt3chapter5_8c1ca3c6:

    # Mi "(I’m in the air…)"
    Mi "(Estoy en el aire...)"

# game/Story03.rpy:6061

translate spanish akt3chapter5_6e7ff19b:

    # mc "Having fun, are we?"
    mc "Diviértete, ¿verdad?"

# game/Story03.rpy:6063

translate spanish akt3chapter5_f804cb0d:

    # Mi "Put me down…"
    Mi "Bájame..."

# game/Story03.rpy:6065

translate spanish akt3chapter5_47a7d7c6:

    # mc "Looks like the training’s paying off."
    mc "Parece que el entrenamiento está pagando."

# game/Story03.rpy:6067

translate spanish akt3chapter5_1fe071d1:

    # h "Oh, look who finally remembered I exist."
    h "Mira quién finalmente recordó que existí."

# game/Story03.rpy:6068

translate spanish akt3chapter5_be27a66a:

    # mc "Saving the best for last."
    mc "Salvando lo mejor para el último."

# game/Story03.rpy:6070

translate spanish akt3chapter5_f28b979b:

    # h "You’re looking way better than a few days ago."
    h "Estás mucho mejor que hace unos días."

# game/Story03.rpy:6071

translate spanish akt3chapter5_e087a34e:

    # mc "I’ll take that… I think?"
    mc "Me lo tomaré... ¿Creo?"

# game/Story03.rpy:6072

translate spanish akt3chapter5_d10cde38:

    # h "Let me guess — Lora’s handiwork?"
    h "Déjame adivinar: ¿La obra de Lora?"

# game/Story03.rpy:6074

translate spanish akt3chapter5_deb9a320:

    # mc "No idea."
    mc "Ni idea."

# game/Story03.rpy:6078

translate spanish akt3chapter5_1bef6b5d:

    # mc "Not gonna say anything?"
    mc "¿No va a decir nada?"

# game/Story03.rpy:6082

translate spanish akt3chapter5_eedcf11b:

    # Mi "I think I’ll head out."
    Mi "Creo que saldré."

# game/Story03.rpy:6091

translate spanish akt3chapter5_590aa206:

    # h "You two are acting weird. Like, seriously weird."
    h "Ustedes dos están actuando raros."

# game/Story03.rpy:6093

translate spanish akt3chapter5_d38c2456:

    # h "What did you do this time?"
    h "¿Qué hiciste esta vez?"

# game/Story03.rpy:6095

translate spanish akt3chapter5_6e0cbc41:

    # mc "Nothing?"
    mc "¿Nada?"

# game/Story03.rpy:6097

translate spanish akt3chapter5_12f1676c:

    # h "Uh-huh. You sure about that?"
    h "¿Estás seguro de eso?"

# game/Story03.rpy:6099

translate spanish akt3chapter5_f58649e6:

    # mc "(What does she want me to say?)"
    mc "(¿Qué quiere que diga?)"

# game/Story03.rpy:6105

translate spanish akt3chapter5_dcd0017e:

    # h "How’s Lora, by the way? Not losing her mind over your little harem?"
    h "¿Cómo está Lora, por cierto? ¿No perder su mente sobre su pequeño harén?"

# game/Story03.rpy:6106

translate spanish akt3chapter5_eccc7153:

    # mc "Harem?"
    mc "¿Harem?"

# game/Story03.rpy:6108

translate spanish akt3chapter5_550610f9:

    # h "Oh, come on. Don’t play innocent. You’ve got girls circling you like you're the last man on Earth."
    h "Vamos, no finjas ser inocentes, chicas rodeandote como si fueras el último hombre de la Tierra."

# game/Story03.rpy:6110

translate spanish akt3chapter5_3ad41076:

    # mc "And you? What do you think about that?"
    mc "¿Y tú?"

# game/Story03.rpy:6112

translate spanish akt3chapter5_f71f86ad:

    # h "Your ‘harem’? Hah."
    h "¿Tu ‘harem’?"

# game/Story03.rpy:6113

translate spanish akt3chapter5_b7050ab2:

    # h "As long as you don’t lie to me — and you don’t forget I’m still here — the rest isn’t my problem."
    h "Mientras no me mientas —y no olvides que aún estoy aquí— el resto no es mi problema."

# game/Story03.rpy:6114

translate spanish akt3chapter5_a39a1d50:

    # mc "You're serious?"
    mc "¿Hablas en serio?"

# game/Story03.rpy:6117

translate spanish akt3chapter5_21e48207:

    # h "Do I look like I’ve got a choice?"
    h "¿Parezco que tengo una opción?"

# game/Story03.rpy:36

translate spanish story04_9693ff4f:

    # mc "I buried you, Lora. A hundred times. Inside myself, every single day."
    mc "Te enterré, Lora, cien veces, dentro de mí, cada día."

# game/Story03.rpy:66

translate spanish story04_d7c60a8b:

    # Lor "Too much time passed. You should’ve forgotten me. And if you didn’t, it means you didn’t even try."
    Lor "Pasaron demasiado tiempo. Debiste haberme olvidado. Y si no lo hiciste, significa que ni siquiera lo intentaste."

# game/Story03.rpy:94

translate spanish story04_8466c3b9:

    # mc "No! I tried to keep him alive."
    mc "Traté de mantenerlo vivo."

# game/Story03.rpy:95

translate spanish story04_58dbe82c:

    # mc "I warned him. Told him it wasn’t safe."
    mc "Le advertí. Le dije que no era seguro."

# game/Story03.rpy:97

translate spanish story04_18bcbb23:

    # mc "He didn’t listen."
    mc "No escuchó."

# game/Story03.rpy:107

translate spanish story04_450985e2:

    # mc "…It should’ve been me."
    mc "...debí haber sido yo."

# game/Story03.rpy:115

translate spanish story04_55c64335:

    # mc "(…Is it really…?)"
    mc "(...¿Es realmente...?)"

# game/Story03.rpy:123

translate spanish story04_b74da216:

    # mc "…I don’t even know what to say."
    mc "...Ni siquiera sé qué decir."

# game/Story03.rpy:129

translate spanish story04_96759569:

    # mc "Every second. Without you, they were all the same."
    mc "Sin ti, eran todos iguales."

# game/Story03.rpy:132

translate spanish story04_24e53ddb:

    # L "I shouldn't have come back. Not like this."
    L "No debería haber vuelto."

# game/Story03.rpy:134

translate spanish story04_7fc6a47c:

    # mc "But you did."
    mc "Pero lo hiciste."

# game/Story03.rpy:144

translate spanish story04_8ff4a7cf:

    # mc "Lora… what is it?"
    mc "Lora... ¿qué pasa?"

# game/Story03.rpy:153

translate spanish story04_8aa651f2:

    # mc "(A scar?.. No. More like... miasma.)"
    mc "¿Una cicatriz?. No. Más como... miasma."

# game/Story03.rpy:154

translate spanish story04_26be1618:

    # mc "…Hey."
    mc "...Hey."

# game/Story03.rpy:158

translate spanish story04_099892fb:

    # mc "Who did this?"
    mc "¿Quién hizo esto?"

# game/Story03.rpy:163

translate spanish story04_a09b8be3:

    # L "And now... I don’t even know what hurts more, that I left..."
    L "Y ahora... ni siquiera sé qué duele más, que me fui..."

# game/Story03.rpy:167

translate spanish story04_a9d41133:

    # L "Or that you were still waiting."
    L "O que aún estabas esperando."

# game/Story03.rpy:169

translate spanish story04_69210536:

    # mc "What are you talking about?.."
    mc "¿De qué estás hablando?."

# game/Story03.rpy:173

translate spanish story04_76f31adf:

    # mc "(That look… you’re hiding something.)"
    mc "(Ese look... estás escondiendo algo.)"

# game/Story03.rpy:176

translate spanish story04_7f1d93fd:

    # L "I missed you. Your voice. Just... an ordinary day with you."
    L "Te extrañé, tu voz, solo un día ordinario contigo."

# game/Story03.rpy:177

translate spanish story04_fe6fb19d:

    # L "All those years, I was alive. Physically."
    L "Todos esos años, estaba vivo."

# game/Story03.rpy:178

translate spanish story04_16904d01:

    # L "But every day, it was like an equation with no variable."
    L "Pero cada día, era como una ecuación sin variable."

# game/Story03.rpy:192

translate spanish story04_c09b6015_2:

    # mc "What happened to you?"
    mc "¿Qué te pasó?"

# game/Story03.rpy:195

translate spanish story04_61ec747c:

    # mc "I’ll find out."
    mc "Lo averiguaré."

# game/Story03.rpy:196

translate spanish story04_7147ceab:

    # mc "Today or tomorrow, doesn’t matter."
    mc "Hoy o mañana, no importa."

# game/Story03.rpy:198

translate spanish story04_b85195f7:

    # mc "But I’m not pretending this is okay."
    mc "Pero no estoy fingiendo que esto está bien."

# game/Story03.rpy:202

translate spanish story04_a3fc761c:

    # mc "Then tell me."
    mc "Entonces dime."

# game/Story03.rpy:203

translate spanish story04_622524e1:

    # L "(Whispering) They followed us."
    L "Nos siguieron."

# game/Story03.rpy:208

translate spanish story04_cfcc2293:

    # mc "I know."
    mc "Lo sé."

# game/Story03.rpy:209

translate spanish story04_e4c77888:

    # L "You..."
    L "Tú..."

# game/Story03.rpy:213

translate spanish story04_2ba0bdc4:

    # L "...How?"
    L "¿Cómo?"

# game/Story03.rpy:221

translate spanish story04_745afed5:

    # L "Of course..."
    L "Por supuesto..."

# game/Story03.rpy:240

translate spanish story04_052cb094:

    # h "Lora... if you can’t tell him, then show him. Let him feel it. That bastard’s not going anywhere. You know him."
    h "Lora... si no puedes decírselo, entonces muéstrale. Deja que lo sienta. Ese bastardo no va a ninguna parte. Lo conoces."

# game/Story03.rpy:245

translate spanish story04_d9e5f7d7:

    # h "And you, stop burning holes in her with that stare. You’re not her executioner."
    h "Y tú, deja de quemar agujeros en ella con esa mirada. No eres su verdugo."

# game/Story03.rpy:246

translate spanish story04_2c9a0519:

    # mc "…Yeah."
    mc "...Sí."

# game/Story03.rpy:247

translate spanish story04_f3c5e835:

    # mc "Guess I don’t have much to add."
    mc "Supongo que no tengo mucho que añadir."

# game/Story03.rpy:248

translate spanish story04_d26074a8:

    # mc "Well… maybe one thing."
    mc "Bueno... tal vez una cosa."

# game/Story03.rpy:249

translate spanish story04_38b71016:

    # mc "That time you blew up half the house with that rose experiment."
    mc "Esa vez volaste la mitad de la casa con ese experimento de rosas."

# game/Story03.rpy:250

translate spanish story04_59708e36:

    # mc "Took me forever to fix it."
    mc "Me llevó para siempre arreglarlo."

# game/Story03.rpy:252

translate spanish story04_3c7e26c7:

    # mc "…Still worth it."
    mc "...hasta que valga la pena."

# game/Story03.rpy:256

translate spanish story04_606cf633:

    # L "But we both know, chaos was always your element, not mine."
    L "Pero ambos sabemos que el caos siempre fue tu elemento, no el mío."

# game/Story03.rpy:258

translate spanish story04_6947410e:

    # mc "(That’s not like her.)"
    mc "(Eso no es como ella.)"

# game/Story03.rpy:260

translate spanish story04_ab72f821:

    # mc "(Too calm.)"
    mc "(Demasiado tranquilo.)"

# game/Story03.rpy:261

translate spanish story04_ae37c2cf:

    # mc "You remember that trip we planned?"
    mc "¿Recuerdas ese viaje que planeamos?"

# game/Story03.rpy:263

translate spanish story04_087b569c:

    # mc "To take Olivia and Anya on-"
    mc "Para llevar a Olivia y Anya a..."

# game/Story03.rpy:270

translate spanish story04_7974f397:

    # mc "Lora… you okay?"
    mc "Lora... ¿estás bien?"

# game/Story03.rpy:282

translate spanish story04_2369dd01:

    # L "(whispering) I'm scared..."
    L "Tengo miedo..."

# game/Story03.rpy:284

translate spanish story04_b633dac2:

    # L "(whispering) ...to losing you again..."
    L "...para perderte de nuevo..."

# game/Story03.rpy:286

translate spanish story04_174d390f:

    # h "Take the step, even if it scares you. He’ll be there to catch you."
    h "Da el paso, aunque te asuste. Estará allí para atraparte."

# game/Story03.rpy:293

translate spanish story04_9861b9aa:

    # mc "Why."
    mc "¿Por qué?"

# game/Story03.rpy:300

translate spanish story04_085fe47d:

    # mc "No secrets."
    mc "No hay secretos."

# game/Story03.rpy:302

translate spanish story04_1c4b4b57:

    # L "...I saw."
    L "...Lo vi."

# game/Story03.rpy:303

translate spanish story04_b7437275:

    # L "...Your death."
    L "...Tu muerte."

# game/Story03.rpy:310

translate spanish story04_160d35e0:

    # L "A lot... of time."
    L "Mucho tiempo."

# game/Story03.rpy:312

translate spanish story04_2fd078aa:

    # L "Again. And again."
    L "Otra vez, y otra vez."

# game/Story03.rpy:314

translate spanish story04_39bb903f:

    # mc "My… death?"
    mc "¿Mi... muerte?"

# game/Story03.rpy:316

translate spanish story04_79f5f4d6:

    # L "Sometimes knowing ruins more than not knowing ever could."
    L "A veces sabiendo que las ruinas son más que no saber que nunca."

# game/Story03.rpy:323

translate spanish story04_79c3a04e:

    # mc "(That tone… she’s holding something back.)"
    mc "(Ese tono... ella está reteniendo algo.)"

# game/Story03.rpy:332

translate spanish story04_d5cf79d5:

    # mc "…Why would you ask that?"
    mc "¿Por qué preguntas eso?"

# game/Story03.rpy:337

translate spanish story04_0fe7e331:

    # mc "Of course we-"
    mc "Por supuesto que..."

# game/Story03.rpy:339

translate spanish story04_b8989d76:

    # mc "(Inquisition?)"
    mc "(Inquisición?)"

# game/Story03.rpy:342

translate spanish story04_41f19d44:

    # mc "(First Kalestra, now this one...)"
    mc "(Primero Kalestra, ahora este...)"

# game/Story03.rpy:361

translate spanish story04_14c49c9b:

    # L "But... I need this."
    L "Pero... necesito esto."

# game/Story03.rpy:368

translate spanish story04_1fa854c9:

    # a "Make it quick."
    a "Hazlo rápido."

# game/Story03.rpy:376

translate spanish story04_8eb62a7b:

    # mc "…And?"
    mc "¿Y?"

# game/Story03.rpy:382

translate spanish story04_845c4c57:

    # mc "What was that?"
    mc "¿Qué fue eso?"

# game/Story03.rpy:399

translate spanish story04_384f897d:

    # L "I sleep, she files a report. I stay silent, they monitor my breathing. I think about you, they..."
    L "Duermo, ella presenta un informe, me quedo callado, ellos monitorean mi respiración."

# game/Story03.rpy:403

translate spanish story04_99572bcd:

    # mc "…Right."
    mc "...derecha."

# game/Story03.rpy:406

translate spanish story04_57364719:

    # mc "Doesn’t sound like freedom."
    mc "No suena como libertad."

# game/Story03.rpy:416

translate spanish story04_394b8b2e:

    # h "Although, if you want the latter, we do have some ideas."
    h "Aunque, si quieres este último, tenemos algunas ideas."

# game/Story03.rpy:422

translate spanish story04_6a7adb0c:

    # mc "I’ll bring something next time."
    mc "Traeré algo la próxima vez."

# game/Story03.rpy:424

translate spanish story04_39dec636:

    # mc "We’ll figure something out."
    mc "Vamos a averiguar algo."

# game/Story03.rpy:433

translate spanish story04_a34fa0dd:

    # L "But seriously, how did you get here?"
    L "Pero en serio, ¿cómo llegaste aquí?"

# game/Story03.rpy:438

translate spanish story04_17171e8e:

    # h "One moment you’re staring at some rift, next thing, boom. Different galaxy."
    h "Un momento estás mirando un grifo, siguiente cosa, boom. Diferente galaxia."

# game/Story03.rpy:441

translate spanish story04_ff853847:

    # mc "Everything else?"
    mc "¿Todo lo demás?"

# game/Story03.rpy:450

translate spanish story04_6410bc11:

    # mc "Complicated."
    mc "Complicado."

# game/Story03.rpy:455

translate spanish story04_ab5bdcd7:

    # mc "You seem better now."
    mc "Pareces mejor ahora."

# game/Story03.rpy:457

translate spanish story04_4a4f1156:

    # mc "Was it because of her?"
    mc "¿Fue por ella?"

# game/Story03.rpy:458

translate spanish story04_c53091ff:

    # L "Partially. But not really."
    L "En parte, pero no en realidad."

# game/Story03.rpy:464

translate spanish story04_9055231a:

    # L "I want to. Just..."
    L "Quiero hacerlo."

# game/Story03.rpy:466

translate spanish story04_5d7b4cfa:

    # L "I’ve lost too much already to ruin this moment too."
    L "He perdido demasiado para arruinar este momento también."

# game/Story03.rpy:467

translate spanish story04_94ce1bed:

    # mc "(…Why?)"
    mc "(...¿Por qué?)"

# game/Story03.rpy:468

translate spanish story04_b4154502:

    # mc "(We’re not strangers.)"
    mc "(No somos extraños.)"

# game/Story03.rpy:469

translate spanish story04_280e93cc:

    # mc "(So what’s stopping you?)"
    mc "(¿Qué te detiene?)"

# game/Story03.rpy:474

translate spanish story04_0b348ba0:

    # mc "…Alright."
    mc "...de acuerdo."

# game/Story03.rpy:484

translate spanish story04_b6cdb87f:

    # mc "You know you’re a grandmother now?"
    mc "¿Sabes que ahora eres abuela?"

# game/Story03.rpy:492

translate spanish story04_035af7ae:

    # mc "…You still remember."
    mc "...Aún lo recuerdas."

# game/Story03.rpy:501

translate spanish story04_7c895712:

    # mc "She’s doing alright."
    mc "Está bien."

# game/Story03.rpy:504

translate spanish story04_a3fe42da:

    # mc "Anya?"
    mc "Anya?"

# game/Story03.rpy:506

translate spanish story04_a7955f60:

    # mc "Still the same."
    mc "Sigue igual."

# game/Story03.rpy:528

translate spanish story04_0ac3693b:

    # h "Too late, Lora. He’s mine now, willingly and begrudgingly."
    h "Demasiado tarde, Lora. Es mío ahora, voluntariamente y con frisura."

# game/Story03.rpy:532

translate spanish story04_7ecdcdb3:

    # mc "You never add sugar."
    mc "Nunca agregas azúcar."

# game/Story03.rpy:536

translate spanish story04_78bfc019:

    # mc "Should’ve stayed in the coma…"
    mc "Debería haber estado en coma..."

# game/Story03.rpy:545

translate spanish story04_c6a1f96b:

    # mc "(Seeing them smile…)"
    mc "(Verles sonreír...)"

# game/Story03.rpy:549

translate spanish story04_83344d3d:

    # mc "(…That’s enough.)"
    mc "(...eso es suficiente.)"

# game/Story03.rpy:574

translate spanish story04_7fa181fb:

    # mc "…Don’t make me wait too long."
    mc "...No me hagas esperar demasiado tiempo."

# game/Story03.rpy:585

translate spanish akt3chapter1_2_f5f79f61:

    # "Sector 6. Blue Moon."
    "Sector 6. Luna Azul."

# game/Story03.rpy:587

translate spanish akt3chapter1_2_37bc3011:

    # mc "(…Tension’s thick.)"
    mc "(...La tensión es gruesa.)"

# game/Story03.rpy:591

translate spanish akt3chapter1_2_64a9699a:

    # mc "(Give it time, something’s gonna snap.)"
    mc "(Déle tiempo, algo va a romper.)"

# game/Story03.rpy:598

translate spanish akt3chapter1_2_0f527b40:

    # h "No clue."
    h "Ni idea."

# game/Story03.rpy:603

translate spanish akt3chapter1_2_ae38f0ee:

    # h "You’ll get more words out of a brick wall than out of Miss Silent here."
    h "Tendrás más palabras de un muro de ladrillo que de la Srta. Silent aquí."

# game/Story03.rpy:614

translate spanish akt3chapter1_2_81c849f9:

    # h "Don't know."
    h "No lo sé."

# game/Story03.rpy:615

translate spanish akt3chapter1_2_b0ee278f:

    # h "The cat said they’re short on people, literally."
    h "El gato dijo que son cortos de gente, literalmente."

# game/Story03.rpy:619

translate spanish akt3chapter1_2_a73f5623:

    # h "She needs Ember's answer."
    h "Necesita la respuesta de Amber."

# game/Story03.rpy:624

translate spanish akt3chapter1_2_1334db12:

    # L "Sorry… couldn’t help overhearing."
    L "Lo siento... no pudo evitar escuchar."

# game/Story03.rpy:628

translate spanish akt3chapter1_2_df212ef4:

    # L "Flora?.."
    L "Flora..."

# game/Story03.rpy:632

translate spanish akt3chapter1_2_6bcb0b13:

    # L "...That figures."
    L "...que figura."

# game/Story03.rpy:634

translate spanish akt3chapter1_2_bb19f620:

    # h "Whoa. That reaction, don’t tell me you know her?"
    h "Esa reacción, ¿no me digas que la conoces?"

# game/Story03.rpy:638

translate spanish akt3chapter1_2_09975d21:

    # mc "Any problem?"
    mc "¿Algún problema?"

# game/Story03.rpy:641

translate spanish akt3chapter1_2_94fc0bf9:

    # L "Her mother was my mentor."
    L "Su madre era mi mentor."

# game/Story03.rpy:642

translate spanish akt3chapter1_2_ce662af1:

    # L "I owe her more than I can explain."
    L "Le debo más de lo que puedo explicar."

# game/Story03.rpy:644

translate spanish akt3chapter1_2_d0263dc2:

    # L "I wouldn’t be standing here without her."
    L "No estaría aquí sin ella."

# game/Story03.rpy:655

translate spanish akt3chapter1_2_1975860a:

    # L "...So that’s how it is."
    L "...Así es como es."

# game/Story03.rpy:657

translate spanish akt3chapter1_2_a1b44c2e:

    # mc "(whispering) Something wrong with Flora?"
    mc "¿Algo va mal con Flora?"

# game/Story03.rpy:658

translate spanish akt3chapter1_2_256a6538:

    # L "(whispers) Flora’s not the problem."
    L "Flora no es el problema."

# game/Story03.rpy:662

translate spanish akt3chapter1_2_1c57a87f:

    # L "(whispers) Her mother… that’s where things get complicated."
    L "Su madre... ahí es donde las cosas se complican."

# game/Story03.rpy:663

translate spanish akt3chapter1_2_66aa968d:

    # L "(whispers) The Inquisition has a history with them."
    L "La Inquisición tiene una historia con ellos."

# game/Story03.rpy:665

translate spanish akt3chapter1_2_35842eae:

    # L "(whispers) And it’s not a friendly one."
    L "(susurros) Y no es un amigo."

# game/Story03.rpy:669

translate spanish akt3chapter1_2_f61a286d:

    # mc "(What did you get yourself into…?)"
    mc "(¿Qué te metiste en...?)"

# game/Story03.rpy:673

translate spanish akt3chapter1_2_279af9ea:

    # h "Okay, can we finally talk about what we’re doing next?"
    h "Vale, ¿podemos hablar por fin de lo que estamos haciendo después?"

# game/Story03.rpy:685

translate spanish akt3chapter1_2_aea6cb36:

    # mc "That the official line?"
    mc "¿Esa es la línea oficial?"

# game/Story03.rpy:690

translate spanish akt3chapter1_2_815bd241:

    # L "(whispers) We’re already too late."
    L "Ya estamos demasiado tarde."

# game/Story03.rpy:702

translate spanish akt3chapter1_2_a484b3ad:

    # mc "(…What the hell does that mean?)"
    mc "(...¿Qué diablos significa eso?)"

# game/Story03.rpy:706

translate spanish akt3chapter1_2_93fdd356:

    # mc "What do we call you?"
    mc "¿Cómo te llamamos?"

# game/Story03.rpy:714

translate spanish akt3chapter1_2_75f652cc:

    # mc "So be it."
    mc "Así que sea."

# game/Story03.rpy:715

translate spanish akt3chapter1_2_976ee3f5:

    # mc "You and Kalestra."
    mc "Tú y Kalestra."

# game/Story03.rpy:717

translate spanish akt3chapter1_2_9db04097:

    # mc "Same kind?"
    mc "¿De la misma clase?"

# game/Story03.rpy:737

translate spanish akt3chapter1_2_dc6c0d6a:

    # mc "Then why bring us here?"
    mc "¿Entonces por qué nos traen aquí?"

# game/Story03.rpy:741

translate spanish akt3chapter1_2_603fd34e:

    # mc "You don’t show up without Astoria’s say-so."
    mc "No apareces sin el dicho de Astoria."

# game/Story03.rpy:744

translate spanish akt3chapter1_2_6240ec20:

    # mc "So stop wasting time."
    mc "Así que deja de perder el tiempo."

# game/Story03.rpy:748

translate spanish akt3chapter1_2_91c3ef79:

    # mc "(…Right. Talking to a wall.)"
    mc "(...derecha. Hablando con una pared.)"

# game/Story03.rpy:749

translate spanish akt3chapter1_2_36eadfd7:

    # mc "Then answer this."
    mc "Entonces contesta esto."

# game/Story03.rpy:751

translate spanish akt3chapter1_2_9d83a8e2:

    # mc "What are you doing here?"
    mc "¿Qué haces aquí?"

# game/Story03.rpy:754

translate spanish akt3chapter1_2_76980de4:

    # mc "And us?"
    mc "¿Y nosotros?"

# game/Story03.rpy:756

translate spanish akt3chapter1_2_efc6895f:

    # mc "Where do we fit?"
    mc "¿Dónde encajamos?"

# game/Story03.rpy:760

translate spanish akt3chapter1_2_abc4a408:

    # a "Chaplain order."
    a "Orden de capellán."

# game/Story03.rpy:765

translate spanish akt3chapter1_2_a7a878c6:

    # mc "We’re heading for the tower."
    mc "Nos dirigimos a la torre."

# game/Story03.rpy:771

translate spanish akt3chapter1_2_97149d21:

    # mc "To shut the gate down."
    mc "Para cerrar la puerta."

# game/Story03.rpy:792

translate spanish akt3chapter1_2_3eb73908:

    # mc "We don’t have time for that."
    mc "No tenemos tiempo para eso."

# game/Story03.rpy:793

translate spanish akt3chapter1_2_59616d71:

    # k "Sprint blindfolded into the meat grinder and pray louder than the enemy shoots?"
    k "¿Sprint vendado en la trituradora de carne y orar más alto que los disparos enemigos?"

# game/Story03.rpy:794

translate spanish akt3chapter1_2_5e71a4bb:

    # k "Funny."
    k "Qué gracioso."

# game/Story03.rpy:795

translate spanish akt3chapter1_2_1e03d37d:

    # k "Weren’t you whining about that cat-man using the exact same method?"
    k "¿No estabas lloriqueando con ese hombre gato usando el mismo método exactamente?"

# game/Story03.rpy:796

translate spanish akt3chapter1_2_326786cd:

    # k "Besides... I already dragged your corpses out once."
    k "Además... ya saqué tus cadáveres una vez."

# game/Story03.rpy:800

translate spanish akt3chapter1_2_78e2650b:

    # k "Don’t grow entitled."
    k "No crezcas derecho."

# game/Story03.rpy:806

translate spanish akt3chapter1_2_e517651c:

    # k "More like the dragon."
    k "Más como el dragón."

# game/Story03.rpy:808

translate spanish akt3chapter1_2_31b8146c:

    # k "Speaking of, where is pointy-ears?"
    k "Hablando de, ¿dónde está el puntiagudo?"

# game/Story03.rpy:831

translate spanish akt3chapter1_2_dc11c0fc:

    # k "As always. And as always, tight-lipped."
    k "Como siempre, y como siempre, apretado."

# game/Story03.rpy:834

translate spanish akt3chapter1_2_e2a95985:

    # k "You guys hang here. I need a word with miss broody over here."
    k "Necesito hablar con la señorita Broody."

# game/Story03.rpy:919

translate spanish akt3chapter1_3_f68fb0b2:

    # L "Well?"
    L "¿Y bien?"

# game/Story03.rpy:926

translate spanish akt3chapter1_3_0c85d999:

    # L "…Good to know."
    L "...que bueno saber."

# game/Story03.rpy:928

translate spanish akt3chapter1_3_47faff2b:

    # L "And I’m glad we’re together again."
    L "Y me alegro de que estemos juntos de nuevo."

# game/Story03.rpy:929

translate spanish akt3chapter1_3_c3aaca30:

    # L "It’s bigger than I expected."
    L "Es más grande de lo que esperaba."

# game/Story03.rpy:931

translate spanish akt3chapter1_3_c8e88140:

    # L "Strangely cozy, too."
    L "Extrañamente acogedor, también."

# game/Story03.rpy:934

translate spanish akt3chapter1_3_dcee8c8b:

    # mc "(You’re dodging it...)"
    mc "(Lo estás haciendo...)"

# game/Story03.rpy:935

translate spanish akt3chapter1_3_f2a9d106:

    # mc "The cozy part, that’s you. The room’s just an empty box."
    mc "La parte acogedora, que es usted. La habitación es solo una caja vacía."

# game/Story03.rpy:950

translate spanish akt3chapter1_3_891b02c1:

    # L "Oh come on, you’re exaggerating, those were good memories."
    L "Oh, vamos, estás exagerando, esos eran buenos recuerdos."

# game/Story03.rpy:958

translate spanish akt3chapter1_3_26de8d45:

    # mc "Tell me, do they always mess up names like that around here?"
    mc "Dime, ¿siempre se meten nombres como ese por aquí?"

# game/Story03.rpy:965

translate spanish akt3chapter1_3_87914250:

    # L "I’d pass."
    L "Yo pasaría."

# game/Story03.rpy:966

translate spanish akt3chapter1_3_6e8fc0c7:

    # L "And I wouldn’t recommend it to you either."
    L "Y yo tampoco te lo recomendaría."

# game/Story03.rpy:969

translate spanish akt3chapter1_3_8fc7a981:

    # L "That’s what everyone says…"
    L "Eso es lo que todos dicen..."

# game/Story03.rpy:971

translate spanish akt3chapter1_3_fd73adf7:

    # L "Right before it starts eating through them."
    L "Justo antes de que empiece a comer a través de ellos."

# game/Story03.rpy:974

translate spanish akt3chapter1_3_4f8b99c1:

    # L "Relax. I’m joking."
    L "Relájate. Estoy bromeando."

# game/Story03.rpy:976

translate spanish akt3chapter1_3_f2a62bfb:

    # L "...Mostly."
    L "...Lo más importante."

# game/Story03.rpy:1002

translate spanish akt3chapter1_3_df9bdc07:

    # L "There are things I can’t tell you."
    L "Hay cosas que no puedo decirte."

# game/Story03.rpy:1004

translate spanish akt3chapter1_3_c14b089b:

    # L "...Even if I wanted to."
    L "... incluso si quisiera."

# game/Story03.rpy:1014

translate spanish akt3chapter1_3_7e1e7e51:

    # L "I was already there."
    L "Ya estaba allí."

# game/Story03.rpy:1015

translate spanish akt3chapter1_3_75e085dd:

    # L "On Earth."
    L "En la Tierra."

# game/Story03.rpy:1019

translate spanish akt3chapter1_3_ca07f7dc:

    # L "After the incident."
    L "Después del incidente."

# game/Story03.rpy:1037

translate spanish akt3chapter1_3_a899b983:

    # mc "While I sat every night staring at an empty comm, praying for a sound, a word, a breath?!"
    mc "Mientras me sentaba todas las noches mirando un coma vacío, rezando por un sonido, una palabra, un aliento!"

# game/Story03.rpy:1040

translate spanish akt3chapter1_3_0002cea4:

    # L "You think I was ignoring you?"
    L "¿Crees que te estaba ignorando?"

# game/Story03.rpy:1041

translate spanish akt3chapter1_3_bbb15591:

    # L "You think I had the luxury of waiting for your voice?"
    L "¿Crees que tuve el lujo de esperar tu voz?"

# game/Story03.rpy:1042

translate spanish akt3chapter1_3_0f633cb2:

    # L "I didn’t hear silence, [mc]."
    L "No escuché silencio, [mc]."

# game/Story03.rpy:1043

translate spanish akt3chapter1_3_48960cab:

    # L "I heard them."
    L "Los oí."

# game/Story03.rpy:1044

translate spanish akt3chapter1_3_e78b3a91:

    # L "Again."
    L "Otra vez."

# game/Story03.rpy:1045

translate spanish akt3chapter1_3_396c7eee:

    # L "And again."
    L "Y otra vez."

# game/Story03.rpy:1053

translate spanish akt3chapter1_3_396c7eee_1:

    # L "And again."
    L "Y otra vez."

# game/Story03.rpy:1063

translate spanish akt3chapter1_3_3416c153:

    # L "Family…?"
    L "¿Familia?"

# game/Story03.rpy:1064

translate spanish akt3chapter1_3_e29ce428:

    # L "…Family?"
    L "¿Familia?"

# game/Story03.rpy:1065

translate spanish akt3chapter1_3_2e0fd158:

    # L "Ahahah—"
    L "Ahahah..."

# game/Story03.rpy:1067

translate spanish akt3chapter1_3_d08554ea:

    # L "You still believe in that?"
    L "¿Aún crees en eso?"

# game/Story03.rpy:1072

translate spanish akt3chapter1_3_615a2be0:

    # L "I wanted to die there…"
    L "Quería morir allí..."

# game/Story03.rpy:1073

translate spanish akt3chapter1_3_f76ebaa6:

    # L "I tried to die there."
    L "Traté de morir allí."

# game/Story03.rpy:1076

translate spanish akt3chapter1_3_46fe9950:

    # L "...More than once."
    L "Más de una vez."

# game/Story03.rpy:1084

translate spanish akt3chapter1_3_322e4d52:

    # L "Because I’m no longer someone you can come to."
    L "Porque ya no soy alguien a quien puedas venir."

# game/Story03.rpy:1086

translate spanish akt3chapter1_3_0e0d8e7f:

    # L "I’m what’s left."
    L "Soy lo que queda."

# game/Story03.rpy:1087

translate spanish akt3chapter1_3_0ed7883a:

    # mc "I cursed your name."
    mc "Maldije tu nombre."

# game/Story03.rpy:1089

translate spanish akt3chapter1_3_c9808cc0:

    # mc "And still... I waited."
    mc "Y aún así... esperé."

# game/Story03.rpy:1100

translate spanish akt3chapter1_3_849a4f45:

    # L "You think I didn’t try?"
    L "¿Crees que no lo intenté?"

# game/Story03.rpy:1102

translate spanish akt3chapter1_3_7fbb8c05:

    # L "I did."
    L "Lo hice."

# game/Story03.rpy:1104

translate spanish akt3chapter1_3_95325b70:

    # L "Over… and over."
    L "Cambio... y cambio."

# game/Story03.rpy:1106

translate spanish akt3chapter1_3_0dc0703f:

    # L "Same ending."
    L "El mismo final."

# game/Story03.rpy:1115

translate spanish akt3chapter1_3_3bd181ae:

    # L "I’ve watched them die."
    L "Los he visto morir."

# game/Story03.rpy:1116

translate spanish akt3chapter1_3_cc2e8ab6:

    # L "I've watched you die..."
    L "Te vi morir..."

# game/Story03.rpy:1118

translate spanish akt3chapter1_3_e78b3a91_1:

    # L "Again."
    L "Otra vez."

# game/Story03.rpy:1120

translate spanish akt3chapter1_3_396c7eee_2:

    # L "And again."
    L "Y otra vez."

# game/Story03.rpy:1122

translate spanish akt3chapter1_3_396c7eee_3:

    # L "And again."
    L "Y otra vez."

# game/Story03.rpy:1125

translate spanish akt3chapter1_3_3d3eddb4:

    # L "I’m not asking for forgiveness."
    L "No pido perdón."

# game/Story03.rpy:1127

translate spanish akt3chapter1_3_3d1b3b64:

    # L "I don’t think it’s even possible."
    L "No creo que sea posible."

# game/Story03.rpy:1131

translate spanish akt3chapter1_3_df375fcf:

    # L "So you know. So that if you hate me, it’s for the truth. Not for what you imagined."
    L "Así que, si me odias, es por la verdad. No por lo que imaginabas."

# game/Story03.rpy:1133

translate spanish akt3chapter1_3_24d075b5:

    # mc "...You want me to hate you?"
    mc "¿Quieres que te odie?"

# game/Story03.rpy:1135

translate spanish akt3chapter1_3_bf82e1a1:

    # L "You want the truth? I ran. And then I disappeared."
    L "Corrí y luego desaparecí."

# game/Story03.rpy:1138

translate spanish akt3chapter1_3_2876efd9:

    # mc "Why?"
    mc "¿Por qué?"

# game/Story03.rpy:1139

translate spanish akt3chapter1_3_09437d02:

    # L "Afraid."
    L "Me temo."

# game/Story03.rpy:1141

translate spanish akt3chapter1_3_38f018d5:

    # L "If I came back and saw in your eyes..."
    L "Si volví y vi en tus ojos..."

# game/Story03.rpy:1143

translate spanish akt3chapter1_3_6ea51cde:

    # L "I couldn't."
    L "No pude."

# game/Story03.rpy:1147

translate spanish akt3chapter1_3_6ca481f0:

    # mc "You were everything I had. Everything."
    mc "Tú eras todo lo que tenía."

# game/Story03.rpy:1156

translate spanish akt3chapter1_3_a92b5d1e:

    # L "Hate me!"
    L "¡Odiome!"

# game/Story03.rpy:1158

translate spanish akt3chapter1_3_fa928b9b:

    # L "Please..."
    L "Por favor..."

# game/Story03.rpy:1173

translate spanish akt3chapter1_3_f1febc7b:

    # L "You were the worst kind of choice, the one I couldn't unmake..."
    L "Tú fuiste la opción más aterradora, la que no pude cancelar."

# game/Story03.rpy:1174

translate spanish akt3chapter1_3_1a8b5ef1:

    # mc "You’ve been through hell, Lora."
    mc "Has pasado por el infierno, Lora."

# game/Story03.rpy:1176

translate spanish akt3chapter1_3_b5b4172e:

    # mc "I’m just glad you let it spill."
    mc "Me alegro de que lo deje derramar."

# game/Story03.rpy:1209

translate spanish akt3chapter1_3_5f25b44e:

    # mc "So... how does your sudden appearance tie into my... {b}almost{/b} death?"
    mc "Así que... ¿cómo se mete tu apariencia repentina en mi... {b}casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi casi{/b} ¿Muerte?"

# game/Story03.rpy:1279

translate spanish akt3chapter1_3_a187cd75:

    # mc "Now that sounds suspicious."
    mc "Ahora eso suena sospechoso."

# game/Story03.rpy:1281

translate spanish akt3chapter1_3_f2ad8f6c:

    # mc "Makes me nervous."
    mc "Me pone nervioso."

# game/Story03.rpy:1282

translate spanish akt3chapter1_3_29ec66b4:

    # L "Nothing complicated."
    L "Nada complicado."

# game/Story03.rpy:1286

translate spanish akt3chapter1_3_726a753f:

    # L "Just stay with me tonight."
    L "Quédate conmigo esta noche."

# game/Story03.rpy:1292

translate spanish akt3chapter1_3_03171757:

    # L "So..."
    L "Así que..."

# game/Story03.rpy:1294

translate spanish akt3chapter1_3_9a9a8b6c:

    # L "How do we even begin after all this time?"
    L "¿Cómo empezamos después de todo este tiempo?"

# game/Story03.rpy:1295

translate spanish akt3chapter1_3_5c13ec43:

    # L "Careful."
    L "Cuidado."

# game/Story03.rpy:1297

translate spanish akt3chapter1_3_9a41363d:

    # L "I missed you enough already."
    L "Ya te extrañé bastante."

# game/Story03.rpy:1299

translate spanish akt3chapter1_3_0ac14cc8:

    # mc "Wouldn’t be the first time."
    mc "No sería la primera vez."

# game/Story03.rpy:1302

translate spanish akt3chapter1_3_fca52711:

    # mc "No."
    mc "No."

# game/Story03.rpy:1304

translate spanish akt3chapter1_3_88f754ea:

    # mc "I just know you."
    mc "Te conozco."

# game/Story03.rpy:1311

translate spanish akt3chapter1_3_5ec9adcd:

    # L "(Those eyes...)"
    L "(Esos ojos...)"

# game/Story03.rpy:1313

translate spanish akt3chapter1_3_22bb8e2b:

    # L "(I thought I’d never see them look at me like that again.)"
    L "(Pensé que nunca volvería a ver que me miraban así.)"

# game/Story03.rpy:1324

translate spanish akt3chapter1_3_707911a9:

    # L "You don’t know how many nights I wished for this..."
    L "No sabes cuántas noches he querido por esto..."

# game/Story03.rpy:1325

translate spanish akt3chapter1_3_d70953bf:

    # mc "This?"
    mc "¿Esto?"

# game/Story03.rpy:1326

translate spanish akt3chapter1_3_43a77fd3:

    # L "Still teasing me?"
    L "¿Todavía me estás burlando?"

# game/Story03.rpy:1327

translate spanish akt3chapter1_3_70358391:

    # L "(Good...)"
    L "(Bien...)"

# game/Story03.rpy:1329

translate spanish akt3chapter1_3_268918ae:

    # L "(He still sounds like himself.)"
    L "(Aún suena a sí mismo.)"

# game/Story03.rpy:1331

translate spanish akt3chapter1_3_850d4f1e:

    # mc "Thought this conversation would go differently."
    mc "Pensé que esta conversación iba a ir de forma diferente."

# game/Story03.rpy:1334

translate spanish akt3chapter1_3_80f03c5a:

    # mc "Still couldn’t help myself."
    mc "Todavía no podía evitarlo."

# game/Story03.rpy:1342

translate spanish akt3chapter1_3_5c13ec43_1:

    # L "Careful."
    L "Cuidado."

# game/Story03.rpy:1344

translate spanish akt3chapter1_3_305bfffe:

    # L "(Don’t disappear again...)"
    L "(No desaparezcas de nuevo...)"

# game/Story03.rpy:1345

translate spanish akt3chapter1_3_b00f9937:

    # L "You keep talking like that..."
    L "Sigues hablando así..."

# game/Story03.rpy:1346

translate spanish akt3chapter1_3_d94cefc3:

    # L "...and I might start believing you."
    L "...y podría empezar a creerte."

# game/Story03.rpy:1347

translate spanish akt3chapter1_3_73d05893:

    # mc "...You okay?"
    mc "¿Estás bien?"

# game/Story03.rpy:1354

translate spanish akt3chapter1_3_7f077ce1:

    # mc "Feels different?"
    mc "¿Se siente diferente?"

# game/Story03.rpy:1355

translate spanish akt3chapter1_3_76155097:

    # L "(Warm...)"
    L "(Warm...)"

# game/Story03.rpy:1356

translate spanish akt3chapter1_3_eea349f7:

    # L "(I almost forgot what this felt like.)"
    L "(Casi olvido lo que esto sentía.)"

# game/Story03.rpy:1357

translate spanish akt3chapter1_3_343ac107:

    # L "(If this is a dream… don’t wake me.)"
    L "(Si esto es un sueño... no me despiertes.)"

# game/Story03.rpy:1358

translate spanish akt3chapter1_3_c47e6076:

    # mc "(…She’s still here.)"
    mc "(...ella todavía está aquí.)"

# game/Story03.rpy:1360

translate spanish akt3chapter1_3_64114a64:

    # mc "(Not gone. Not yet.)"
    mc "(No se ha ido."

# game/Story03.rpy:1362

translate spanish akt3chapter1_3_76c99569:

    # mc "…Don’t disappear again."
    mc "...No desaparezcas de nuevo."

# game/Story03.rpy:1365

translate spanish akt3chapter1_3_59812da5:

    # L "(I’ll try…)"
    L "(Lo intentaré...)"

# game/Story03.rpy:1385

translate spanish akt3chapter1_3_12b46ce9:

    # L "(Just a little longer…)"
    L "(Solo un poco más...)"

# game/Story03.rpy:1387

translate spanish akt3chapter1_3_7dcc798e_1:

    # L "Take off the uniform. I’ll find you something dry."
    L "Quítate el uniforme. Te encontraré algo seco."

# game/Story03.rpy:1389

translate spanish akt3chapter1_3_095a783f:

    # mc "I think I’ll take a shower."
    mc "Creo que me voy a duchar."

# game/Story03.rpy:1401

translate spanish akt3chapter1_3_5c413788:

    # L "...sure."
    L "...seguro."

# game/Story03.rpy:1405

translate spanish akt3chapter1_3_f03fe041:

    # L "There it is again, that look. Stop it, [mc]."
    L "Ahí está otra vez, esa mirada. [mc]."

# game/Story03.rpy:1406

translate spanish akt3chapter1_3_b5e51c97:

    # L "For once, just let go."
    L "Por una vez, solo déjalo ir."

# game/Story03.rpy:1408

translate spanish akt3chapter1_3_73158ab7:

    # L "Even for a moment."
    L "Incluso por un momento."

# game/Story03.rpy:1409

translate spanish akt3chapter1_3_351b7eaf:

    # mc "I can’t... It’s too much."
    mc "No puedo... es demasiado."

# game/Story03.rpy:1410

translate spanish akt3chapter1_3_1e27fb48:

    # mc "Too complicated."
    mc "Demasiado complicado."

# game/Story03.rpy:1416

translate spanish akt3chapter1_3_7f0caa32:

    # mc "So... what happened to you?"
    mc "Entonces... ¿qué te pasó?"

# game/Story03.rpy:1418

translate spanish akt3chapter1_3_fff7e047:

    # L "In short? I know things I shouldn’t."
    L "¿En resumen? Sé cosas que no debería."

# game/Story03.rpy:1420

translate spanish akt3chapter1_3_3f9df27f_1:

    # mc "...What?"
    mc "¿Qué?"

# game/Story03.rpy:1421

translate spanish akt3chapter1_3_f67cb3fb:

    # L "The truth."
    L "La verdad."

# game/Story03.rpy:1423

translate spanish akt3chapter1_3_ec1c09e7:

    # L "Or… part of it."
    L "O... parte de ella."

# game/Story03.rpy:1424

translate spanish akt3chapter1_3_c4b75d84:

    # mc "And I’m supposed to just live with that?"
    mc "¿Y se supone que debo vivir con eso?"

# game/Story03.rpy:1425

translate spanish akt3chapter1_3_b7d8e078:

    # L "...Sorry."
    L "Lo siento."

# game/Story03.rpy:1426

translate spanish akt3chapter1_3_c5d62c3a:

    # L "I can’t explain it properly yet."
    L "No puedo explicarlo correctamente todavía."

# game/Story03.rpy:1428

translate spanish akt3chapter1_3_c9bf13af:

    # mc "The gate. This is about the gate, isn’t it?"
    mc "La puerta. Esto es sobre la puerta, ¿no?"

# game/Story03.rpy:1431

translate spanish akt3chapter1_3_d4e6c18c:

    # L "...Yeah."
    L "...Sí."

# game/Story03.rpy:1432

translate spanish akt3chapter1_3_ffe42956:

    # mc "What I heard before..."
    mc "Lo que escuché antes..."

# game/Story03.rpy:1433

translate spanish akt3chapter1_3_b8cc4033:

    # mc "You saw me die, didn’t you?"
    mc "Me viste morir, ¿no?"

# game/Story03.rpy:1437

translate spanish akt3chapter1_3_9bb690ed:

    # L "Let’s just..."
    L "Vamos a..."

# game/Story03.rpy:1439

translate spanish akt3chapter1_3_170cfc61:

    # L "Enjoy this moment a little longer."
    L "Disfruta de este momento un poco más."

# game/Story03.rpy:1443

translate spanish akt3chapter1_3_5552bbc4:

    # mc "Avoiding it again?"
    mc "¿Evitarlo de nuevo?"

# game/Story03.rpy:1447

translate spanish akt3chapter1_3_09406ff7:

    # L "Please."
    L "Por favor."

# game/Story03.rpy:1448

translate spanish akt3chapter1_3_86d75e27:

    # L "I’ll explain... Just not now."
    L "Te lo explicaré... pero no ahora."

# game/Story03.rpy:1451

translate spanish akt3chapter1_3_46543b5c:

    # L "Okay?"
    L "¿De acuerdo?"

# game/Story03.rpy:1458

translate spanish akt3chapter1_3_f201598b:

    # L "Come here."
    L "Ven aquí."

# game/Story03.rpy:1460

translate spanish akt3chapter1_3_0eb1bd99:

    # L "Let me forget about all of this for a while."
    L "Déjame olvidarte de todo esto por un tiempo."

# game/Story03.rpy:1470

translate spanish akt3chapter1_3_d7bee0bd:

    # L "God... I missed you."
    L "Dios... te extrañé."

# game/Story03.rpy:1471

translate spanish akt3chapter1_3_d12ded33:

    # mc "You’re different tonight..."
    mc "Eres diferente esta noche..."

# game/Story03.rpy:1473

translate spanish akt3chapter1_3_742c0d49:

    # L "I’m trying not to think."
    L "Estoy tratando de no pensar."

# game/Story03.rpy:1475

translate spanish akt3chapter1_3_1b738645:

    # L "You still look at me like I’m me."
    L "Todavía me miras como yo."

# game/Story03.rpy:1476

translate spanish akt3chapter1_3_bf45bc7a:

    # L "Even now..."
    L "Incluso ahora..."

# game/Story03.rpy:1478

translate spanish akt3chapter1_3_bc1b572a:

    # L "you still let your guard down around me."
    L "Todavía dejas que tu guardia caiga a mi alrededor."

# game/Story03.rpy:1480

translate spanish akt3chapter1_3_a40c1e32:

    # L "Even now... you still trust me."
    L "Incluso ahora... todavía confías en mí."

# game/Story03.rpy:1482

translate spanish akt3chapter1_3_70b11ee7:

    # mc "I’m trying to."
    mc "Estoy tratando de hacerlo."

# game/Story03.rpy:1491

translate spanish akt3chapter1_3_65e77a79:

    # mc "You always knew exactly what to do."
    mc "Siempre sabías exactamente qué hacer."

# game/Story03.rpy:1492

translate spanish akt3chapter1_3_55aeb35c:

    # L "...No."
    L "...no."

# game/Story03.rpy:1494

translate spanish akt3chapter1_3_935b2046:

    # L "I was terrified of losing it."
    L "Estaba aterrorizada de perderla."

# game/Story03.rpy:1495

translate spanish akt3chapter1_3_6f887114:

    # mc "Then stop thinking."
    mc "Entonces deja de pensar."

# game/Story03.rpy:1497

translate spanish akt3chapter1_3_d0ee8d4c:

    # mc "Just be here with me."
    mc "Solo ven conmigo."

# game/Story03.rpy:1498

translate spanish akt3chapter1_3_6411bb44:

    # L "Careful..."
    L "Cuidado..."

# game/Story03.rpy:1499

translate spanish akt3chapter1_3_e55e5833:

    # L "I still know all your weak spots."
    L "Todavía conozco todos tus puntos débiles."

# game/Story03.rpy:1507

translate spanish akt3chapter1_3_83f2c02c:

    # mc "You already do."
    mc "Ya lo sabes."

# game/Story03.rpy:1509

translate spanish akt3chapter1_3_bf3d67aa:

    # mc "Still resisting?"
    mc "¿Sigue resistiendo?"

# game/Story03.rpy:1512

translate spanish akt3chapter1_3_49816fbb:

    # mc "You can stop anytime."
    mc "Puedes parar en cualquier momento."

# game/Story03.rpy:1513

translate spanish akt3chapter1_3_2653b46c:

    # L "No."
    L "No."

# game/Story03.rpy:1514

translate spanish akt3chapter1_3_eb60968a:

    # L "Not yet."
    L "Aún no."

# game/Story03.rpy:1528

translate spanish akt3chapter1_3_234a62b4:

    # L "…I missed this version of us."
    L "...Me perdí esta versión de nosotros."

# game/Story03.rpy:1530

translate spanish akt3chapter1_3_74fc6761:

    # mc "Me too."
    mc "Yo también."

# game/Story03.rpy:1540

translate spanish akt3chapter1_3_c2f2ade4:

    # mc "Good night, Lora."
    mc "Buenas noches, Lora."

# game/Story03.rpy:1612

translate spanish akt3chapter1_4_be8f1a89:

    # L "I'm sorry..."
    L "Lo siento."

# game/Story03.rpy:1614

translate spanish akt3chapter1_4_65c425c5:

    # L "I pushed too far. It’s just... all of it’s been piling up."
    L "Yo he empujado demasiado lejos. Es solo que... todo ha estado acechando."

# game/Story03.rpy:1618

translate spanish akt3chapter1_4_e5544801:

    # mc "I get it."
    mc "Lo entiendo."

# game/Story03.rpy:1619

translate spanish akt3chapter1_4_c877e2a7:

    # mc "Still... when you said you could’ve died in agony..."
    mc "Aún así... cuando dijiste que podrías haber muerto en agonía..."

# game/Story03.rpy:1620

translate spanish akt3chapter1_4_deddb069:

    # mc "What did you mean?"
    mc "¿Qué querías decir?"

# game/Story03.rpy:1628

translate spanish akt3chapter1_4_7e046f79:

    # L "I’m being... hunted."
    L "Estoy siendo... cazado."

# game/Story03.rpy:1630

translate spanish akt3chapter1_4_4cad93bd:

    # mc "By who?"
    mc "¿Por quién?"

# game/Story03.rpy:1632

translate spanish akt3chapter1_4_7654d757:

    # L "Everyone. In small pieces. Humans, elves, dragons... even insects."
    L "En pequeños pedazos, humanos, elfos, dragones... incluso insectos."

# game/Story03.rpy:1633

translate spanish akt3chapter1_4_8c39d73f:

    # L "Surprised?"
    L "¿Sorprendido?"

# game/Story03.rpy:1635

translate spanish akt3chapter1_4_fb3be0f3:

    # mc "Sounds insane. But somehow, I believe you."
    mc "Suena loco, pero de alguna manera, te creo."

# game/Story03.rpy:1637

translate spanish akt3chapter1_4_d7fc8fe8:

    # L "As you should. The reason is simple..."
    L "Como deberías, la razón es simple..."

# game/Story03.rpy:1638

translate spanish akt3chapter1_4_771c08dc:

    # L "I know what’s hidden in the Abyss."
    L "Sé lo que está escondido en el Abismo."

# game/Story03.rpy:1640

translate spanish akt3chapter1_4_9556576d:

    # mc "That’s not enough to make people want you dead."
    mc "Eso no es suficiente para que la gente te quiera muerto."

# game/Story03.rpy:1642

translate spanish akt3chapter1_4_c46b1f38:

    # L "I’m one of the few who can enter it."
    L "Soy uno de los pocos que pueden entrar en él."

# game/Story03.rpy:1644

translate spanish akt3chapter1_4_af38c14f:

    # mc "Now that is a different story."
    mc "Ahora es una historia diferente."

# game/Story03.rpy:1646

translate spanish akt3chapter1_4_fd100e5b:

    # L "And you still don’t understand..."
    L "Y aún no entiendes..."

# game/Story03.rpy:1648

translate spanish akt3chapter1_4_b1098a20:

    # mc "I know. But I still don’t understand."
    mc "Lo sé, pero aún no entiendo."

# game/Story03.rpy:1650

translate spanish akt3chapter1_4_19e706b6:

    # L "Let me put it simply. The Abyss isn’t just another dimension. It’s... layers of broken, entangled realities."
    L "Deja que lo ponga simplemente. El Abismo no es solo otra dimensión. Es... capas de realidades rotas y enredadas."

# game/Story03.rpy:1652

translate spanish akt3chapter1_4_10fc187f:

    # L "There are artifacts connected to it. They allow access."
    L "Hay artefactos conectados a él. Permiten el acceso."

# game/Story03.rpy:1654

translate spanish akt3chapter1_4_c236f5b0:

    # L "Still following?"
    L "¿Sigues?"

# game/Story03.rpy:1656

translate spanish akt3chapter1_4_f800bed0:

    # mc "Yes."
    mc "Sí."

# game/Story03.rpy:1658

translate spanish akt3chapter1_4_82d9987e:

    # L "Good."
    L "Bien."

# game/Story03.rpy:1660

translate spanish akt3chapter1_4_2872e70d:

    # L "Now the obvious question — why does everyone want in?"
    L "Ahora la pregunta obvia - ¿por qué todos quieren entrar?"

# game/Story03.rpy:1661

translate spanish akt3chapter1_4_78f1808f:

