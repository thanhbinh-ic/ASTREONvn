    # L "...don’t you think I already would have?"
    L "... ¿No crees que ya lo habría hecho?"

# game/Story03.rpy:5076

translate spanish akt3chapter4_a7146250:

    # mc "That changes nothing."
    mc "Eso no cambia nada."

# game/Story03.rpy:5082

