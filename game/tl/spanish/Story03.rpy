    # k "Yeah, yeah."
    k "Sí, sí."

# game/Story03.rpy:4638

translate spanish akt3chapter3_4_3cb631cd:

    # Fl "You, with me. Now."
    Fl "Tú, conmigo."

# game/Story03.rpy:4644

