    # mc "Lora, write everything down."
    mc "Lora, escribe todo."

# game/Story03.rpy:5102

translate spanish akt3chapter4_8479533f:

    # mc "Even the parts that sound insane."
    mc "Incluso las partes que suenan locas."

# game/Story03.rpy:5104

translate spanish akt3chapter4_2c5dd124:

    # L "And you?"
    L "¿Y tú?"

# game/Story03.rpy:5106

translate spanish akt3chapter4_b5ac1cd2:

    # mc "I’m gonna find us a way out."
    mc "Voy a encontrarnos una salida."

# game/Story03.rpy:5127

