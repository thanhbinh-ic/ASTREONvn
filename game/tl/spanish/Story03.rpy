translate spanish act3_5chapter2_2_c56d8e88:

    # y "Fine. Then may I?"
    y "Bien. ¿Entonces puedo?"

# game/Story03.rpy:7650

translate spanish act3_5chapter2_2_50e57c3b:

    # am "Later. You’re being followed."
    am "Más tarde. Te siguen."

# game/Story03.rpy:7652

translate spanish act3_5chapter2_2_71a86863_4:

    # y "..."
    y "..."

# game/Story03.rpy:7654

translate spanish act3_5chapter2_2_7cc313fd:

    # am "And this is how you repay me for saving you?"
    am "¿Y así me pagas por salvarte?"

# game/Story03.rpy:7668

