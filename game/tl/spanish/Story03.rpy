    # Fl "It’s all collapsing!"
    Fl "¡Todo está colapsando!"

# game/Story03.rpy:4798

translate spanish akt3chapter4_0a002e6d:

    # Fl "All of it!"
    Fl "¡Todo!"

# game/Story03.rpy:4800

