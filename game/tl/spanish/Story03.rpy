translate spanish act3_5chapter2_2_c7443293:

    # mc "W-weak!"
    mc "¡W-weak!"

# game/Story03.rpy:7642

translate spanish act3_5chapter2_2_8b797fa0:

    # am "That’s enough."
    am "Es suficiente."

# game/Story03.rpy:7645

translate spanish act3_5chapter2_2_b9bd232b:

    # y "(whispering) Why did you…"
    y "¿Por qué..."

