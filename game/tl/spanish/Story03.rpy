    # gg "Hmph... Then where are all these survivors you claim to have saved?"
    gg "Hmph... ¿dónde están todos estos sobrevivientes que afirmas haber salvado?"

# game/Story03.rpy:5677

translate spanish akt3chapter5_1_7e4ebe83:

    # em "In the Lower City."
    em "En la Ciudad Baja."

# game/Story03.rpy:5679

