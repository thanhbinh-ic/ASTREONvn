translate spanish akt3chapter4_73edf2b9:

    # mc "You always go for the things people try hardest not to remember."
    mc "Siempre vas por las cosas que la gente intenta más difícil de no recordar."

# game/Story03.rpy:4693

translate spanish akt3chapter4_d74c0807:

    # mc "Ever thought about changing that?"
    mc "¿Alguna vez pensó en cambiar eso?"

# game/Story03.rpy:4696

translate spanish akt3chapter4_08fc1af8:

    # Fl "No."
    Fl "No."

# game/Story03.rpy:4697

translate spanish akt3chapter4_d27a60f0:

    # Fl "Not my style."
    Fl "No es mi estilo."

# game/Story03.rpy:4700

translate spanish akt3chapter4_444b7c1e:

    # Fl "I’m after something else."
    Fl "Estoy buscando otra cosa."

# game/Story03.rpy:4704

translate spanish akt3chapter4_2034c056:

    # mc "Maybe."
    mc "Tal vez."

# game/Story03.rpy:4708

translate spanish akt3chapter4_effb41f4:

    # mc "Maybe not."
    mc "Tal vez no."

# game/Story03.rpy:4709

translate spanish akt3chapter4_a1715063:

    # mc "It’s complicated."
    mc "Es complicado."

# game/Story03.rpy:4713

translate spanish akt3chapter4_d5f9bf75:

    # Fl "(quietly) Of course."
    Fl "Por supuesto."

# game/Story03.rpy:4714

