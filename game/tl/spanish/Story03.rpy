translate spanish act3_5chapter2_3_d175e169:

    # mc "Yong?"
    mc "¿Yong?"

# game/Story03.rpy:7694

translate spanish act3_5chapter2_3_78a22df8:

    # Mi "Talking with Winter. Nothing urgent."
    Mi "Hablando con Winter, nada urgente."

# game/Story03.rpy:7698

translate spanish act3_5chapter2_3_2b35b6fe_2:

    # mc "..."
    mc "..."

# game/Story03.rpy:7700

translate spanish act3_5chapter2_3_3c9f286c:

    # mc "Lora..."
    mc "Lora..."

