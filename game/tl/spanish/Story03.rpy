    mc "Recuerdo muscular."

# game/Story03.rpy:4897

translate spanish akt3chapter4_49ec1ce5:

    # L "...Let go."
    L "...Suéltame."

# game/Story03.rpy:4899

translate spanish akt3chapter4_5e2cb588:

    # mc "(Normally she'd already be furious.)"
    mc "(Ella normalmente estaría enojada por ahora.)"

# game/Story03.rpy:4903

translate spanish akt3chapter4_a22e8f5a:

    # mc "(But now...)"
    mc "(Pero ahora...)"

# game/Story03.rpy:4909

translate spanish akt3chapter4_6651ab87:

    # mc "Alright."
    mc "Muy bien."

# game/Story03.rpy:4910

translate spanish akt3chapter4_542c2412:

    # mc "Someone want to explain what exactly is happening here?"
    mc "¿Alguien quiere explicar qué está pasando exactamente aquí?"

# game/Story03.rpy:4912

translate spanish akt3chapter4_f190b946:

    # L "(whispers) I came to talk, but..."
    L "Vine a hablar, pero..."

# game/Story03.rpy:4914

translate spanish akt3chapter4_190ab1a1:

    # Fl "Nothing you need to worry about."
    Fl "Nada de lo que necesitas preocuparte."

# game/Story03.rpy:4917

translate spanish akt3chapter4_e3834ec7:

    # L "(whispers) I know."
    L "Lo sé."

# game/Story03.rpy:4920

translate spanish akt3chapter4_4245de2c:

    # mc "So what the hell was that?"
    mc "¿Qué demonios fue eso?"

# game/Story03.rpy:4941

translate spanish akt3chapter4_cea723ef:

    # mc "I asked a question."
    mc "Hice una pregunta."

# game/Story03.rpy:4943

translate spanish akt3chapter4_e943d1ed:

    # L "I..."
    L "Yo..."

# game/Story03.rpy:4945

translate spanish akt3chapter4_ab473ab9:

    # Fl "Right."
    Fl "Cierto."

# game/Story03.rpy:4952

translate spanish akt3chapter4_bfa9d6fa:

    # mc "I’m getting real tired of this shit."
    mc "Me estoy cansando mucho de esta mierda."

# game/Story03.rpy:4954

translate spanish akt3chapter4_2713488d:

    # mc "This is getting old."
    mc "Esto se está haciendo viejo."

# game/Story03.rpy:4956

translate spanish akt3chapter4_3faf49fd:

    # mc "Either talk straight."
    mc "O hablar directamente."

# game/Story03.rpy:4957

translate spanish akt3chapter4_45367d3f:

    # mc "Or start acting normal."
    mc "O empieza a actuar normal."

# game/Story03.rpy:4960

translate spanish akt3chapter4_4d9ab87a:

    # Fl "Let’s just say..."
    Fl "Digamos..."

# game/Story03.rpy:4965

translate spanish akt3chapter4_e1823a68:

    # Fl "we had a disagreement."
    Fl "Teníamos un desacuerdo."

# game/Story03.rpy:4967

translate spanish akt3chapter4_c42b05ac:

    # mc "And?"
    mc "¿Y?"

# game/Story03.rpy:4970

translate spanish akt3chapter4_49e7621f:

    # L "I said..."
    L "Dije..."

# game/Story03.rpy:4971

translate spanish akt3chapter4_f0a1fab4:

    # L "We need to leave this planet."
    L "Tenemos que dejar este planeta."

# game/Story03.rpy:4973

translate spanish akt3chapter4_9a5056f5:

    # Fl "And she refused to explain why."
    Fl "Y se negó a explicar por qué."

# game/Story03.rpy:4975

translate spanish akt3chapter4_a8aa0765:

    # L "And I’m not explaining why."
    L "Y no estoy explicando por qué."

# game/Story03.rpy:4980

translate spanish akt3chapter4_1c7d22c2:

    # mc "Problem with the plan?"
    mc "¿Problemas con el plan?"

# game/Story03.rpy:4982

translate spanish akt3chapter4_8320dad3:

    # Fl "She keeps shooting it down."
    Fl "Ella sigue disparándolo."

# game/Story03.rpy:4983

translate spanish akt3chapter4_7efe5a63:

    # Fl "Hard."
    Fl "Difícil."

# game/Story03.rpy:4984

translate spanish akt3chapter4_3fbb6973:

    # Fl "...and yeah."
    Fl "...y sí."

# game/Story03.rpy:4985

translate spanish akt3chapter4_c0299f55:

    # Fl "I might’ve said a few things."
    Fl "Podría haber dicho algunas cosas."

# game/Story03.rpy:4987

translate spanish akt3chapter4_be250528:

    # mc "One question."
    mc "Una pregunta."

# game/Story03.rpy:4990

translate spanish akt3chapter4_e943d1ed_1:

    # L "I..."
    L "Yo..."

# game/Story03.rpy:4994

translate spanish akt3chapter4_28c618d2:

    # L "We won’t make it."
    L "No lo lograremos."

# game/Story03.rpy:4995

translate spanish akt3chapter4_c9ec8556:

    # L "You all die."
    L "Todos ustedes mueren."

# game/Story03.rpy:4997

translate spanish akt3chapter4_368910a2:

    # Fl "Oh, so now you're a prophet?"
    Fl "¿Así que ahora eres un profeta?"

# game/Story03.rpy:4998

translate spanish akt3chapter4_2ab1ebac:

    # Fl "That’s cute."
    Fl "Eso es lindo."

# game/Story03.rpy:5000

translate spanish akt3chapter4_442776c8:

    # Fl "See, [mc]? She’s not even trying to—"
    Fl "Mira, [mc]Ella ni siquiera está tratando de..."

# game/Story03.rpy:5001

translate spanish akt3chapter4_b268db7b:

    # Fl "[mc]?"
    Fl "[mc]?"

# game/Story03.rpy:5003

translate spanish akt3chapter4_fbc7d4cb:

    # mc "You’re desperate."
    mc "Estás desesperado."

# game/Story03.rpy:5005

translate spanish akt3chapter4_ddcd6a1f:

    # L "...Yes."
    L "Sí."

# game/Story03.rpy:5007

translate spanish akt3chapter4_77970c33:

    # Fl "What are you talk-"
    Fl "¿Qué estás diciendo?"

# game/Story03.rpy:5009

translate spanish akt3chapter4_fb7ac99a:

    # mc "She knows what’s coming."
    mc "Ella sabe lo que viene."

# game/Story03.rpy:5011

translate spanish akt3chapter4_64754ce1:

    # L "I don’t see the path."
    L "No veo el camino."

# game/Story03.rpy:5014

translate spanish akt3chapter4_b9686f2b:

    # L "Only the outcome."
    L "Solo el resultado."

# game/Story03.rpy:5016

translate spanish akt3chapter4_cfff6d08:

    # L "There’s a story."
    L "Hay una historia."

# game/Story03.rpy:5029

translate spanish akt3chapter4_c8655f59:

    # L "About immortality."
    L "Sobre la inmortalidad."

# game/Story03.rpy:5030

