    # mc "(Those trembling fingers, that shaky breath... You’re barely holding it together.)"
    mc "(Esos dedos temblantes, ese soplo de sombreado... apenas lo estás sosteniendo juntos)."

# game/Story03.rpy:6265

translate spanish akt3chapter5_2_2ba95f5d:

    # h "You think I’ll just give in? That easy?"
    h "¿Crees que me rendiré?"

# game/Story03.rpy:6266

translate spanish akt3chapter5_2_d561ad9d:

    # mc "You already have. You’re just too proud to say it."
    mc "Ya lo has hecho. Solo estás demasiado orgulloso para decirlo."

# game/Story03.rpy:6267

translate spanish akt3chapter5_2_51fb6e7a:

    # h "Tch... You arrogant...!"
    h "Tch... ¡Eres arrogante!"

# game/Story03.rpy:6268

translate spanish akt3chapter5_2_b94dd734:

    # h "Fine. Then stop talking—"
    h "Bien, entonces deja de hablar..."

# game/Story03.rpy:6269

translate spanish akt3chapter5_2_610d06f4:

    # h "And *show* me."
    h "Y *muéstrame*"

# game/Story03.rpy:6270

translate spanish akt3chapter5_2_a505cedb:

    # mc "Heh. Don’t say I didn’t warn you."
    mc "No digas que no te lo advertí."

# game/Story03.rpy:6271

translate spanish akt3chapter5_2_0d712ebc:

    # h "Bring it on."
    h "Tráelo."

# game/Story03.rpy:6272

translate spanish akt3chapter5_2_1fa32e70:

    # mc "(She’s fire and thorns... but even fire can melt.)"
    mc "(Es fuego y espinas... pero incluso el fuego puede derretirse.)"

# game/Story03.rpy:6273

translate spanish akt3chapter5_2_1f664adf:

    # h "(I hate how much I want this... How much I want *him.*)"
    h "(Odio cuánto quiero esto... cuánto quiero * él*)"

# game/Story03.rpy:6274

translate spanish akt3chapter5_2_18a36f72:

    # mc "Still think you’re in charge?"
    mc "¿Todavía crees que estás a cargo?"

# game/Story03.rpy:6275

translate spanish akt3chapter5_2_ce6ef817:

    # h "No. But I know how to take it back."
    h "No, pero sé cómo recuperarlo."

# game/Story03.rpy:6276

translate spanish akt3chapter5_2_8d574d23:

    # mc "Then try. I dare you."
    mc "Entonces intenta, te reto."

# game/Story03.rpy:6277

translate spanish akt3chapter5_2_93d014be:

    # h "You’ll regret asking for that."
    h "Te arrepentirás de pedir eso."

# game/Story03.rpy:6278

translate spanish akt3chapter5_2_a0ba430f:

    # mc "I doubt it. In fact—"
    mc "Lo dudo."

# game/Story03.rpy:6279

translate spanish akt3chapter5_2_01779fee:

    # mc "I’m counting on it."
    mc "Cuento con ello."

# game/Story03.rpy:6285

translate spanish akt3chapter5_2_6d89ff97:

    # k "Quite a show, don’t you think?"
    k "Un espectáculo, ¿no crees?"

# game/Story03.rpy:6287

translate spanish akt3chapter5_2_bb8e4b4e:

    # a "..."
    a "..."

# game/Story03.rpy:6289

translate spanish akt3chapter5_2_e4926c84:

    # a "What does Lora even see in him..."
    a "¿Qué ve Lora en él?"

# game/Story03.rpy:6291

translate spanish akt3chapter5_2_dece2c2f:

    # k "Oh come on, it’s not like she minds."
    k "Oh, vamos, no es como si le importara."

# game/Story03.rpy:6293

translate spanish akt3chapter5_2_3ab13d85:

    # a "Eow..."
    a "Eow..."

# game/Story03.rpy:6295

translate spanish akt3chapter5_2_90cff3ba:

    # a "You could’ve at least waited until I was gone."
    a "Podrías haber esperado hasta que me fuera."

# game/Story03.rpy:6296

translate spanish akt3chapter5_2_eaba8075:

    # k "I don’t care."
    k "No me importa."

# game/Story03.rpy:6298

translate spanish akt3chapter5_2_bb9f8b7c:

    # a "Doesn’t matter."
    a "No importa."

# game/Story03.rpy:6299

translate spanish akt3chapter5_2_76d5ea92:

    # a "She doesn’t even know he’s cheating on her."
    a "Ni siquiera sabe que la está engañando."

# game/Story03.rpy:6301

translate spanish akt3chapter5_2_64d4e4c1:

    # k "Well, she dumped him first."
    k "Bueno, ella lo dejó primero."

# game/Story03.rpy:6307

translate spanish akt3chapter5_2_0802638d:

    # a "Why is all this happening to me..."
    a "¿Por qué me está pasando todo esto?"

# game/Story03.rpy:6584

translate spanish act3_5chapter1_1_d795864b:

    # gg "Stick together. Devices ready. If the Faceless shows up — shoot on sight."
    gg "Mantengase unidos. Dispositivos listos. Si el sin rostro aparece — dispara a la vista."

# game/Story03.rpy:6587

translate spanish act3_5chapter1_1_f658a9ec:

    # mc "(Hard to breathe in here… like drowning on dry land.)"
    mc "(Hard to respirar aquí... como ahogarse en tierra seca.)"

# game/Story03.rpy:6589

translate spanish act3_5chapter1_1_812b1ee1:

    # mc "Head's cracking… Feels like someone’s splitting my skull with a hammer."
    mc "Me está partiendo la cabeza... parece que alguien me está rompiendo el cráneo con un martillo."

# game/Story03.rpy:6591

translate spanish act3_5chapter1_1_4025c210:

    # mc "(But whatever, Kalestra mention something about comms…)"
    mc "(Pero lo que sea, Kalestra menciona algo sobre las comunicaciones...)"

# game/Story03.rpy:6595

translate spanish act3_5chapter1_1_2406c0cf:

    # mc "(Messages… Yeah, right there.)"
    mc "Sí, justo ahí."

# game/Story03.rpy:6598

translate spanish act3_5chapter1_1_96af3308:

    # "Notification from Lora."
    "Notificación de Lora."

# game/Story03.rpy:6600

translate spanish act3_5chapter1_1_a3da06cd:

    # L "Thank you... for last night. I didn’t expect, after everything... for something inside to finally go quiet."
    L "Gracias... por anoche. No esperaba, después de todo... que algo dentro se callara."

# game/Story03.rpy:6602

translate spanish act3_5chapter1_1_868ada83:

    # L "You became something like... a quiet place. Just for a few hours."
    L "Te convertiste en algo como... un lugar tranquilo."

# game/Story03.rpy:6603

translate spanish act3_5chapter1_1_8da59526:

    # L "I saw you sleeping. Didn’t want to wake you. You earned it."
    L "Te vi durmiendo. No quería despertarte. Te lo ganaste."

# game/Story03.rpy:6605

translate spanish act3_5chapter1_1_f1fdae68:

    # mc "(…There she is. The Lora I remember. Or at least… I want to believe so.)"
    mc "(... ahí está. La Lora que recuerdo, o al menos... quiero creerlo.)"

# game/Story03.rpy:6607

translate spanish act3_5chapter1_1_9fdcd41a:

    # L "I’m waiting at the command post. Left corridor, second door."
    L "Estoy esperando en el puesto de mando. Corredor izquierdo, segunda puerta."

# game/Story03.rpy:6608

translate spanish act3_5chapter1_1_2b35b6fe:

    # mc "..."
    mc "..."

# game/Story03.rpy:6610

translate spanish act3_5chapter1_1_49064845:

    # "Notification from Lora, a few hours later."
    "Notificación de Lora, unas horas más tarde."

# game/Story03.rpy:6612

translate spanish act3_5chapter1_1_ac95a26a:

    # L "[mc], someone sold us out. It all went to hell."
    L "[mc]Alguien nos vendió, todo fue al infierno."

# game/Story03.rpy:6613

translate spanish act3_5chapter1_1_45814f48:

    # L "We tried to reach you. I swear. But we barely had anything left..."
    L "Intentamos contactarte, lo juro, pero apenas nos quedamos nada..."

# game/Story03.rpy:6615

translate spanish act3_5chapter1_1_49064845_1:

    # "Notification from Lora, a few hours later."
    "Notificación de Lora, unas horas más tarde."

# game/Story03.rpy:6616

translate spanish act3_5chapter1_1_897d24fe:

    # "5 missed calls."
    "5 llamadas perdidas."

# game/Story03.rpy:6618

translate spanish act3_5chapter1_1_994078b8:

    # L "Pick up. Please. I can’t just sit here. Not knowing..."
    L "Recoge. Por favor. No puedo simplemente sentarme aquí. No saber..."

# game/Story03.rpy:6620

translate spanish act3_5chapter1_1_8323d9c2:

    # "16 missed calls."
    "16 llamadas perdidas."

# game/Story03.rpy:6621

translate spanish act3_5chapter1_1_4938d32b:

    # "Notification from Lora, a few minutes ago."
    "Notificación de Lora, hace unos minutos."

# game/Story03.rpy:6623

translate spanish act3_5chapter1_1_5947287e:

    # L "They’re evacuating us to Sector Three. Me and Olivia."
    L "Nos están evacuando al Sector Tres. Yo y Olivia."

# game/Story03.rpy:6624

translate spanish act3_5chapter1_1_d42872ab:

    # L "If you’re reading this — it means you’re alive. Which means: hold on. No heroics. Just... survive."
    L "Si estás leyendo esto, significa que estás vivo. Lo que significa: espera. No hay heroicos. Solo... sobreviva."

# game/Story03.rpy:6625

translate spanish act3_5chapter1_1_40b466f2:

    # L "I’ll come back. I swear."
    L "Volveré. Lo juro."

# game/Story03.rpy:6627

translate spanish act3_5chapter1_1_6811166d:

    # mc "(You’ll come back… and I just have to stay alive long enough. Otherwise, what the hell was all this for?)"
    mc "(Volverás... y tengo que seguir vivo lo suficiente. De lo contrario, ¿para qué demonios fue todo esto?)"

# game/Story03.rpy:6628

translate spanish act3_5chapter1_1_43c3b59c:

    # mc "(Alone again. Tradition never dies, huh.)"
    mc "La tradición nunca muere, ¿eh?"

# game/Story03.rpy:6631

translate spanish act3_5chapter1_1_af306000:

    # mc "(Fine. Get up. Keep moving.)"
    mc "(Bien, levántate."

# game/Story03.rpy:6632

translate spanish act3_5chapter1_1_e0f9a635:

    # mc "(Pick up Miriel, find transport, meet Lora. That’s the list.)"
    mc "(Entrar Miriel, encontrar transporte, conocer a Lora. Esa es la lista.)"

# game/Story03.rpy:6633

translate spanish act3_5chapter1_1_9e67394e:

    # mc "(Though… what made me think any plan around here ever holds together?)"
    mc "(Aunque... ¿qué me hizo pensar que algún plan por aquí se mantiene unido?)"

# game/Story03.rpy:6636

translate spanish act3_5chapter1_1_b0db7455:

    # k "So, hero. Savior. Tell me — is that glory on your breath, or just the stench of your own blood?"
    k "Entonces, héroe. Salvador. Dime - ¿Es esa gloria en tu aliento, o solo el hedor de tu propia sangre?"

# game/Story03.rpy:6638

translate spanish act3_5chapter1_1_2117ee83:

    # mc "More like emptiness. Did what needed doing — but inside? Still feels like shit."
    mc "Más bien vacío. ¿Qué necesitaba hacer, pero dentro? Todavía se siente como una mierda."

# game/Story03.rpy:6645

translate spanish act3_5chapter1_1_9281e535:

    # k "Good. Welcome to the freak show, then."
    k "Bien, bienvenido al espectáculo de monstruos, entonces."

# game/Story03.rpy:6650

translate spanish act3_5chapter1_1_2ec7b8f8:

    # mc "Pretty sorry excuse for a show. But hey — still breathing. That’s worth something."
    mc "Bastante lamento excusa para un espectáculo. Pero hey — todavía respirando. Eso vale algo."

# game/Story03.rpy:6653

translate spanish act3_5chapter1_1_75efbf1c:

    # k "Breathing is cheap. Dying spectacularly - Now thats priceless."
    k "Respirar es barato. Morir espectacularmente - Ahora eso es inestimable."

# game/Story03.rpy:6655

translate spanish act3_5chapter1_1_a3d66542:

    # k "Hm..."
    k "Hm..."

# game/Story03.rpy:6657

translate spanish act3_5chapter1_1_aa44912e:

    # k "Look at them. All starry-eyed because someone noticed their miserable existence."
    k "Míralos, todos los ojos de estrella porque alguien notó su miserable existencia."

# game/Story03.rpy:6659

translate spanish act3_5chapter1_1_36e4cc20:

    # mc "What are you on about?"
    mc "¿De qué estás hablando?"

# game/Story03.rpy:6663

translate spanish act3_5chapter1_1_a4f4912f:

    # k "Cannon fodder. Fireworks in human skin. They’d have been corpses already if they walked in alone."
    k "Fíjido de cañones. Fuegos artificiales en la piel humana. Habrían sido cadáveres ya si hubieran entrado solos."

# game/Story03.rpy:6667

translate spanish act3_5chapter1_1_cb0ec4ed:

    # k "But then you stumbled in, slapped my sister down, and dragged them out."
    k "Pero luego tropezó, arrojó a mi hermana y los arrastró."

# game/Story03.rpy:6669

translate spanish act3_5chapter1_1_14e6cd0c:

    # mc "Don’t call them meat. Everyone has their worth."
    mc "No los llames carne. Todo el mundo tiene su valor."

# game/Story03.rpy:6672

translate spanish act3_5chapter1_1_0e4738b9:

    # mc "And yeah, I was in the dirt while you cleaned up."
    mc "Y sí, estaba en la suciedad mientras limpiabas."

# game/Story03.rpy:6674

translate spanish act3_5chapter1_1_19a93b0b:

    # k "True."
    k "Cierto."

# game/Story03.rpy:6677

translate spanish act3_5chapter1_1_73efd777:

    # k "But you had guts. Or the kind of stupidity I find entertaining."
    k "Pero tenías coraje, o la clase de estupidez que encuentro entretenido."

# game/Story03.rpy:6683

translate spanish act3_5chapter1_1_91aa9ee6:

    # mc "Thanks. I’ll take that as a compliment — stupidity included."
    mc "Gracias. Lo tomaré como un cumplido — la estupidez incluida."

# game/Story03.rpy:6685

translate spanish act3_5chapter1_1_504c96a0:

    # k "She’ll sulk for a while."
    k "Se va a secar por un tiempo."

# game/Story03.rpy:6688

translate spanish act3_5chapter1_1_59912dee:

    # k "Then either forgive you or slit your throat. Fifty-fifty."
    k "Entonces o te perdones o te cortas la garganta."

# game/Story03.rpy:6690

translate spanish act3_5chapter1_1_c959b280:

    # mc "Calculations... You know, I’m starting to understand why you are the way you are."
    mc "Cálculos... ya sabes, estoy empezando a entender por qué eres la forma en que eres."

# game/Story03.rpy:6693

translate spanish act3_5chapter1_1_0e5a681d:

    # k "Oh? Do enlighten me."
    k "Oh, ilumíname."

# game/Story03.rpy:6695

translate spanish act3_5chapter1_1_737f097e:

    # mc "Cold. Like everything’s the mission. Like machines."
    mc "Frío. Como todo es la misión. Como máquinas."

# game/Story03.rpy:6698

translate spanish act3_5chapter1_1_812b74ec:

    # k "Mmm. Sharp tongue. Half-right. But unlike machines, I enjoy the mess."
    k "Lengüeta de afeitar, pero a diferencia de las máquinas, disfruto el desorden."

# game/Story03.rpy:6700

translate spanish act3_5chapter1_1_debcc36a:

    # mc "Maybe, but don’t you think there’s something off about this place?"
    mc "Tal vez, pero ¿no crees que hay algo fuera de este lugar?"

# game/Story03.rpy:6701

translate spanish act3_5chapter1_1_3f21e5ce:

    # k "Too quiet. Too clean. Like a stage before the slaughter."
    k "Demasiado tranquilo, muy limpio, como un escenario antes de la masacre."

# game/Story03.rpy:6705

translate spanish act3_5chapter1_1_fc60f0c6:

    # mc "Yeah. Stay sharp."
    mc "Sí, quédate afilado."

# game/Story03.rpy:6706

translate spanish act3_5chapter1_1_4074beb7:

    # g "What's wrong with this place? Why's my head tearing apart?"
    g "¿Por qué me mezcló la cabeza?"

# game/Story03.rpy:6708

translate spanish act3_5chapter1_1_a0f962ef:

    # gggg "Uh... I thought it was just me."
    gggg "Pensé que era solo yo."

# game/Story03.rpy:6725

translate spanish act3_5chapter1_1_08cdef3d:

    # k "Maybe we should keep him. He looks fake enough to be useful bait."
    k "Tal vez deberíamos mantenerlo, parece lo suficientemente falso para ser un cebo útil."

# game/Story03.rpy:6727

translate spanish act3_5chapter1_1_76f558a8:

    # mc "Kalestra?"
    mc "¿Kalestra?"

# game/Story03.rpy:6729

translate spanish act3_5chapter1_1_93334484:

    # k "What?"
    k "¿Qué?"

# game/Story03.rpy:6731

translate spanish act3_5chapter1_1_443cdf07:

    # mc "Since when can the Faceless affect the subconscious?"
    mc "¿Desde cuándo puede el Infraseable afectar al subconsciente?"

# game/Story03.rpy:6733

translate spanish act3_5chapter1_1_82091822:

    # k "..."
    k "..."

# game/Story03.rpy:6738

translate spanish act3_5chapter1_1_e72b01c4:

    # gggg "Who... is that?"
    gggg "¿Quién... es?"

# game/Story03.rpy:6741

translate spanish act3_5chapter1_1_64783cc9:

    # gg "Looks like a Faceless."
    gg "Parece un sin rostro."

# game/Story03.rpy:6743

translate spanish act3_5chapter1_1_9f880b0b:

    # gggg "Nyx, we need to get out of here."
    gggg "Nyx, tenemos que salir de aquí."

# game/Story03.rpy:6744

translate spanish act3_5chapter1_1_b4f7ad31:

    # gg "Cut the panic, grab the data for research. That’ll be more useful."
    gg "Cortar el pánico, tomar los datos para la investigación. Eso será más útil."

# game/Story03.rpy:6746

translate spanish act3_5chapter1_1_174ec2be:

    # a "They’ve started evolving."
    a "Han empezado a evolucionar."

# game/Story03.rpy:6748

translate spanish act3_5chapter1_1_9c4a7209:

    # k "If that’s true… then everything just turned deliciously worse."
    k "Si eso es cierto... entonces todo se volvió deliciosamente peor."

# game/Story03.rpy:6756

translate spanish act3_5chapter1_1_b6529b9b:

    # a "Leave. Now."
    a "Vete."

# game/Story03.rpy:6759

translate spanish act3_5chapter1_1_850ef128:

    # b "..."
    b "..."

# game/Story03.rpy:6763

translate spanish act3_5chapter1_1_0472cfef:

    # g "What the hell was that monster!?"
    g "¿Qué demonios fue ese monstruo?"

# game/Story03.rpy:6765

translate spanish act3_5chapter1_1_789611ab:

    # gggg "How are we supposed to know."
    gggg "¿Cómo se supone que lo sabemos?"

# game/Story03.rpy:6767

translate spanish act3_5chapter1_1_4ce08dcd:

    # g "Why didn't the device work?! It identifies those things fast!"
    g "¿Por qué no funcionó el dispositivo? ¡Reconoce cosas así muy rápido!"

# game/Story03.rpy:6770

translate spanish act3_5chapter1_1_8f65ac9b:

    # gggg "I DON'T KNOW! HEAR ME, I DON'T KNOW!"
    gggg "No lo sé, ¡no lo sé!"

# game/Story03.rpy:6772

translate spanish act3_5chapter1_1_124a7f4e:

    # gg "Cut the panic, both of you."
    gg "Corta el pánico, los dos."

# game/Story03.rpy:6775

translate spanish act3_5chapter1_1_c2bdcbca:

    # mc "(Something’s off here… doesn’t add up.)"
    mc "(Algo está aquí fuera... no se sumerge.)"

# game/Story03.rpy:6777

translate spanish act3_5chapter1_1_6612100d:

    # mc "(Their reactions — they know. But why are they hiding it?)"
    mc "(Sus reacciones - lo saben. Pero, ¿por qué lo ocultan?)"

# game/Story03.rpy:6780

translate spanish act3_5chapter1_1_f5ff0417:

    # mc "You {b}do{/b} know what that was, don’t you?"
    mc "Tú {b}do{/b} ¿Sabes qué fue eso, no?"

# game/Story03.rpy:6782

translate spanish act3_5chapter1_1_0484d506:

    # mc "(Aha. Wonderful. A wall of silence.)"
    mc "(Ajá. Maravilloso. Una pared de silencio.)"

# game/Story03.rpy:6784

translate spanish act3_5chapter1_1_dd0860a7:

    # mc "Well, Kalestra? Always clever. Maybe for once, be useful?"
    mc "Bueno, Kalestra siempre inteligente. ¿Tal vez por una vez, ser útil?"

# game/Story03.rpy:6785

translate spanish act3_5chapter1_1_bf4d335d:

    # k "Not the slightest clue."
    k "No es la más mínima pista."

# game/Story03.rpy:6788

translate spanish act3_5chapter1_1_cc6c9da1:

    # k "(But if you don’t stick to me, you’ll be nothing but stains on the floor.)"
    k "(Pero si no te pegas a mí, no serás más que manchas en el suelo.)"

# game/Story03.rpy:6790

translate spanish act3_5chapter1_1_9ad54191:

    # mc "Ah, your living shield? Great prospect."
    mc "Ah, tu escudo vivo?"

# game/Story03.rpy:6792

translate spanish act3_5chapter1_1_3386e15d:

    # k "Better a shield than a corpse. Stay close, or start digging your grave."
    k "Mejor un escudo que un cadáver. Mantente cerca, o empieza a cavar tu tumba."

# game/Story03.rpy:6793

translate spanish act3_5chapter1_1_2b35b6fe_1:

    # mc "..."
    mc "..."

# game/Story03.rpy:6794

translate spanish act3_5chapter1_1_b0068f89:

    # mc "(I’ve… never seen her like that.)"
    mc "(Yo nunca la he visto así.)"

# game/Story03.rpy:6797

translate spanish act3_5chapter1_1_0d345e03:

    # k "And you really shouldn’t have."
    k "Y realmente no deberías haberlo hecho."

# game/Story03.rpy:6810

translate spanish act3_5chapter1_1_bf2aef3b:

    # mc "You give terrible directions..."
    mc "Das direcciones terribles..."

# game/Story03.rpy:6811

translate spanish act3_5chapter1_1_db0bfed6:

    # k "And you follow them anyway."
    k "Y tú los sigues de todos modos."

# game/Story03.rpy:6813

translate spanish act3_5chapter1_1_56cefe88:

    # k "Follow me, unless you’re tired of breathing."
    k "Sígueme, a menos que estés cansado de respirar."

# game/Story03.rpy:6816

translate spanish act3_5chapter1_1_47442c15:

    # gggg "What?! She just did that?!"
    gggg "¿Qué? ¿Ella acaba de hacer eso?"

# game/Story03.rpy:6817

translate spanish act3_5chapter1_1_a18ec3af:

    # gg "Yeah, after her! Stick to her!"
    gg "¡Sí, después de ella!"

# game/Story03.rpy:6830

translate spanish act3_5chapter2_9dcb3407:

    # gg "Come on, quick. Move in!"
    gg "Vamos, rápido. ¡Entra!"

# game/Story03.rpy:6837

translate spanish act3_5chapter2_f9b263fd:

    # mc "(Quiet. Just the hum of the generators. Strange… but right now it almost feels calming.)"
    mc "(Quieto. Solo el hum de los generadores. Extraño... pero ahora casi se siente calmante.)"

# game/Story03.rpy:6843

translate spanish act3_5chapter2_3b69dd5f:

    # mc "(The road’s only starting, and they already look worn out. Like ghosts.)"
    mc "(La carretera está empezando, y ya se ven agotadas. Como fantasmas.)"

# game/Story03.rpy:6845

translate spanish act3_5chapter2_3f537c6a:

    # mc "(And me? Back in the mess again. Playing the hero. Figures.)"
    mc "(¿Y yo? Volver al desastre otra vez."

# game/Story03.rpy:6853

translate spanish act3_5chapter2_82091822:

    # k "..."
    k "..."

# game/Story03.rpy:6857

translate spanish act3_5chapter2_b60a13ec:

    # mc "You’re usually the loud one. What’s with the silence?"
    mc "Usted es generalmente el fuerte. ¿Qué es con el silencio?"

# game/Story03.rpy:6860

translate spanish act3_5chapter2_df11187d:

    # k "Bored. Put on a show for me."
    k "Bored, ponme un espectáculo."

# game/Story03.rpy:6865

translate spanish act3_5chapter2_b45dbbf4:

    # mc "Bored? After all that? We’re lucky we’re still breathing."
    mc "¿Aburrido? Después de todo eso? Tenemos suerte de que todavía estamos respirando."

# game/Story03.rpy:6875

translate spanish act3_5chapter2_fce91983:

    # k "Fear and sacrifice are so predictable. No theatrics — no worth. This whole thing tastes like wet ash."
    k "El miedo y el sacrificio son tan predecibles. Sin teatricia — no vale. Todo esto sabe como la ceniza mojada."

# game/Story03.rpy:6877

translate spanish act3_5chapter2_1648d5a4:

    # mc "(Crazy. Definitely.)"
    mc "(Crazy. Definitivamente.)"

# game/Story03.rpy:6879

translate spanish act3_5chapter2_8ca36d9e:

    # k "Don't call me crazy right away. Just… different."
    k "No me llames loco de inmediato."

# game/Story03.rpy:6881

translate spanish act3_5chapter2_6d26a197:

    # mc "Fine. Different. Be that way."
    mc "Bien, diferente, por ahí."

# game/Story03.rpy:6886

translate spanish act3_5chapter2_82091822_1:

    # k "..."
    k "..."

# game/Story03.rpy:6888

translate spanish act3_5chapter2_e3e600ac:

    # k "(whisper) Boredom is the last thing in me that still counts as human."
    k "El aburrimiento es lo último en mí que aún cuenta como humano."

# game/Story03.rpy:6890

translate spanish act3_5chapter2_0c328ca6:

    # mc "What? Did you say something?"
    mc "¿Dijiste algo?"

# game/Story03.rpy:6892

translate spanish act3_5chapter2_82091822_2:

    # k "..."
    k "..."

# game/Story03.rpy:6896

translate spanish act3_5chapter2_cbdba510:

    # k "I said: I’m bored! {w=1.0}Say something already — entertain me."
    k "Dije: ¡Estoy aburrido! {w=1.0}Di algo ya - entretenerme."

# game/Story03.rpy:6902

translate spanish act3_5chapter2_0d46d1f5:

    # mc "Alright then. You want words, I’ll keep them simple."
    mc "Muy bien entonces. Si quieres palabras, las mantendré simples."

# game/Story03.rpy:6903

translate spanish act3_5chapter2_68f7bd7a:

    # mc "So? What do you want to hear?"
    mc "¿Qué quieres oír?"

# game/Story03.rpy:6906

translate spanish act3_5chapter2_581e9bbe:

    # k "The whole world’s a stage, and we’re all actors. Deep thoughts in your head, aren't they?"
    k "Todo el mundo es teatro, y todos somos actores."

# game/Story03.rpy:6908

translate spanish act3_5chapter2_7ad5f242:

    # mc "First, stop crawling into my head. Second, that's just a quote."
    mc "En primer lugar, deja de molestarme, en segundo lugar, es solo una cita."

# game/Story03.rpy:6910

translate spanish act3_5chapter2_748df167:

    # k "Is it? Then tell me — what do you think of actresses?"
    k "Entonces dime, ¿qué piensas de las actrices?"

# game/Story03.rpy:6912

translate spanish act3_5chapter2_8fcfabf2:

    # mc "You can read my mind can't you?"
    mc "Puedes leer mentes, ¿recuerdas?"

# game/Story03.rpy:6915

translate spanish act3_5chapter2_6223efba:

    # k "I want to hear it, not steal it from your skull. A live voice is so much more fun."
    k "Quiero oírlo, no robarlo de tu cráneo."

# game/Story03.rpy:6919

translate spanish act3_5chapter2_d6314bd9:

    # mc "Actresses? They play their part, crowd claps, curtain falls. That’s it."
    mc "¿Actuaciones? Ellos juegan su parte, aplausos de la multitud, caídas de la cortina. Eso es todo."

# game/Story03.rpy:6921

translate spanish act3_5chapter2_db6ccace:

    # mc "What else is there to understand?"
    mc "¿Qué más hay que entender?"

# game/Story03.rpy:6923

translate spanish act3_5chapter2_82091822_3:

    # k "..."
    k "..."

# game/Story03.rpy:6925

translate spanish act3_5chapter2_bee86476:

    # mc "But you asked for a reason. Why? What’s on your mind?"
    mc "Pero usted pidió una razón. ¿Por qué? ¿Qué está en su mente?"

# game/Story03.rpy:6926

translate spanish act3_5chapter2_963ac8d7:

    # k "Not curious?"
    k "¿No tiene curiosidad?"

# game/Story03.rpy:6929

translate spanish act3_5chapter2_45bb1b77:

    # k "They’re true artists. Life’s the stage, and their paints are pain and suffering."
    k "Son verdaderos artistas. La vida es el escenario, y sus pinturas son dolor y sufrimiento."

# game/Story03.rpy:6933

translate spanish act3_5chapter2_db037c4d:

    # k "Every stroke, every ounce of misery becomes… beautiful."
    k "Cada golpe, cada onza de miseria se convierte en... hermoso."

# game/Story03.rpy:6937

translate spanish act3_5chapter2_497ceee9:

    # mc "You see beauty where most don’t. Strange taste, but… fine. I’ll take your word for it."
    mc "Usted ve la belleza donde la mayoría no. Extraño gusto, pero... bien. Tomaré su palabra para ello."

# game/Story03.rpy:6939

translate spanish act3_5chapter2_82091822_4:

    # k "..."
    k "..."

# game/Story03.rpy:6941

translate spanish act3_5chapter2_92413685:

    # mc "How long are we stuck in this can?"
    mc "¿Cuánto tiempo estamos atrapados en esta lata?"

# game/Story03.rpy:6943

translate spanish act3_5chapter2_bd97dd6c:

    # gg "Another ten minutes."
    gg "Otros diez minutos."

# game/Story03.rpy:6950

translate spanish act3_5chapter2_00ebe152:

    # mc "Ten minutes. Long enough to think too much. Any ideas, what was that?"
    mc "Diez minutos, lo suficiente para pensar demasiado. ¿Alguna idea, qué fue eso?"

# game/Story03.rpy:6952

translate spanish act3_5chapter2_a5a8d775:

    # gg "There are a couple of theories, but none really explain what's happening."
    gg "Hay varias teorías, pero ninguna de ellas explica lo que está pasando."

# game/Story03.rpy:6954

translate spanish act3_5chapter2_6b4e4f1d:

    # mc "Not much. I was hoping for at least a hint."
    mc "Esperaba al menos una pista."

# game/Story03.rpy:6956

translate spanish act3_5chapter2_15f75b71:

    # gg "By appearance — a Faceless, but with an abnormal ability. Either a mutation, or something new."
    gg "Por apariencia — un sin rostro, pero con una habilidad anormal. O una mutación, o algo nuevo."

# game/Story03.rpy:6959

translate spanish act3_5chapter2_900695d0:

    # gggg "I've never had the honor of being a test rat before."
    gggg "Nunca he tenido el honor de ser una rata antes."

# game/Story03.rpy:6961

translate spanish act3_5chapter2_b6d3481c:

    # mc "(That thing came for us. Something doesn’t add up…)"
    mc "(Eso vino por nosotros. Algo no se suma...)"

# game/Story03.rpy:6963

translate spanish act3_5chapter2_48fa1c88:

    # mc "What was the plan before all this fell apart?"
    mc "¿Cuál era el plan antes de que todo esto se desmoronara?"

# game/Story03.rpy:6965

translate spanish act3_5chapter2_c13ba05b:

    # gg "Originally, we were evacuating your civilians. But later the order was revoked, and we were told to return."
    gg "Originalmente, evacuábamos a sus civiles, pero más tarde se revocó la orden y nos dijeron que regresaran."

# game/Story03.rpy:6966

translate spanish act3_5chapter2_fea73b5d:

    # gg "With no explanation."
    gg "Sin explicación."

# game/Story03.rpy:6969

translate spanish act3_5chapter2_9d9d6f45:

    # g "You received that; The rest have different orders. They'll head to assist the peacekeepers"
    g "Tienes esta orden, los otros tienen otro, para ir a la ayuda de los pacificadores."

# game/Story03.rpy:6970

translate spanish act3_5chapter2_26258c3b:

    # g "Back where you came from."
    g "De donde viniste."

# game/Story03.rpy:6972

translate spanish act3_5chapter2_6bd24c89:

    # gggg "All of this looks like madness. As if command itself has no clue what's going on."
    gggg "Es una locura, como el comando en sí no tiene idea de lo que está pasando."

# game/Story03.rpy:6976

translate spanish act3_5chapter2_2e81bcd4:

    # gg "For now, we need to come back alive. We'll deal with the rest later."
    gg "Tenemos que volver con vida por ahora, nos ocuparemos del resto más tarde."

# game/Story03.rpy:6978

translate spanish act3_5chapter2_dc12a94c:

    # gggg "That's for sure, and with hope and faith it's easier to walk toward a goal. Right, commander?"
    gggg "Y con esperanza y fe, es más fácil llegar allí. ¿Verdad, comandante?"

# game/Story03.rpy:6985

translate spanish act3_5chapter2_c5af235e:

    # mc "(Summing up...)"
    mc "(Resumiendo...)"

# game/Story03.rpy:6986

translate spanish act3_5chapter2_d0964bc0:

    # mc "(Maiden is silent, Kalestra... as always. Little is known about the mutant, the orders from above are strange.)"
    mc "(Maiden es silencioso, Kalestra... como siempre. Poco se sabe sobre el mutante, las órdenes de arriba son extrañas.)"

# game/Story03.rpy:6987

translate spanish act3_5chapter2_c3cb703f:

    # mc "(The situation is unstable. We need to stick together to survive.)"
    mc "(La situación es inestable, tenemos que mantenernos unidos para sobrevivir.)"

# game/Story03.rpy:6988

translate spanish act3_5chapter2_f9f4b5c6:

    # mc "(Indeed, we can't do without faith and hope.)"
    mc "(De hecho, no hay esperanza ni fe.)"

# game/Story03.rpy:6991

translate spanish act3_5chapter2_93457446:

    # L "If you're reading — it means you're alive. Which means — hold on. Just survive. No heroics. Just… survive."
    L "Si lees esto, estás vivo, es decir, espera, no seas un héroe, solo... sobreviva."

# game/Story03.rpy:6996

translate spanish act3_5chapter2_00b5f77c:

    # mc "Right, for their sake."
    mc "Claro, por su bien."

# game/Story03.rpy:6997

translate spanish act3_5chapter2_fcfb7c20:

    # mc "I have to survive, whatever it costs."
    mc "Tengo que sobrevivir, lo que sea que cueste."

# game/Story03.rpy:7004

translate spanish act3_5chapter2_a68496df:

    # mc "Nothing to say?"
    mc "¿Nada que decir?"

# game/Story03.rpy:7009

translate spanish act3_5chapter2_a69f6d14:

    # mc "Understood. So be it."
    mc "Entendido, así que sea."

# game/Story03.rpy:7012

translate spanish act3_5chapter2_aaa27d53:

    # mc "Since we're supposed to work as a team — maybe introduce ourselves?"
    mc "Si se supone que estamos en un equipo, ¿por qué no nos presentamos?"

# game/Story03.rpy:7013

translate spanish act3_5chapter2_a7b35a62:

    # mc "Your names."
    mc "Tus nombres."

# game/Story03.rpy:7016

translate spanish act3_5chapter2_f9acd091:

    # gg "My name is Nyx."
    gg "Me llamo Nyx."

# game/Story03.rpy:7019

translate spanish act3_5chapter2_b76bb8ca:

    # gg "This big guy is Echo."
    gg "Este gran chico es Echo."

# game/Story03.rpy:7020

translate spanish act3_5chapter2_d6dbc95f:

    # gggg "Ha-ha... It's odd to hear my name outside the kitchen. Nice to meet you."
    gggg "Es extraño oír tu nombre fuera de la cocina."

# game/Story03.rpy:7022

translate spanish act3_5chapter2_a28e71ff:

    # gg "The one who was rude to you — Brain."
    gg "El que te era grosero — Brain."

# game/Story03.rpy:7023

translate spanish act3_5chapter2_d053a68f:

    # g "Hmph. They don't need to know the delivery guy's name."
    g "No necesitan saber el nombre del repartidor."

# game/Story03.rpy:7026

translate spanish act3_5chapter2_d286d82d:

    # gg "This is Leo, our tech specialist and pyro."
    gg "Este es Leo, nuestro especialista en tecnología y Pyro."

# game/Story03.rpy:7027

translate spanish act3_5chapter2_a3d5572e:

    # gggg "Need something fixed, stolen, or just implants checked? I'm at your service."
    gggg "¿Necesitas arreglar algo, robar algo o revisar los implantes?"

# game/Story03.rpy:7029

translate spanish act3_5chapter2_9a99737b:

    # gg "The others, right to left: Nemo, Hedy, Sike, and Ava."
    gg "Los otros, derecho a la izquierda: Nemo, Hedy, Sike y Ava."

# game/Story03.rpy:7032

translate spanish act3_5chapter2_0ae2de7b:

    # mc "My name is [mc]."
    mc "Mi nombre es [mc]."

# game/Story03.rpy:7035

translate spanish act3_5chapter2_f0d1c72b:

    # mc "And hers..."
    mc "Y la suya..."

# game/Story03.rpy:7038

translate spanish act3_5chapter2_7e1d8063:

    # k "Kalestra. One and only. I'm here only because of him… and with him — because of boredom."
    k "Calestra, la única y única, estoy aquí por él, y con él, por el aburrimiento."

# game/Story03.rpy:7042

translate spanish act3_5chapter2_4f5437dd:

    # mc "And the second..."
    mc "Y el segundo..."

# game/Story03.rpy:7046

translate spanish act3_5chapter2_c469651c:

    # mc "Got it. Stubborn."
    mc "Lo tengo, Stubborn."

# game/Story03.rpy:7050

translate spanish act3_5chapter2_82091822_5:

    # k "..."
    k "..."

# game/Story03.rpy:7052

translate spanish act3_5chapter2_93334484:

    # k "What?"
    k "¿Qué?"

# game/Story03.rpy:7054

translate spanish act3_5chapter2_a0cae81e:

    # mc "(whisper) I wanted to ask about her, but you know... forget it."
    mc "Quería preguntar por ella, pero ya sabes... olvídalo."

# game/Story03.rpy:7056

translate spanish act3_5chapter2_f17be527:

    # k "(Don't look at me like that — I answer for myself, and no one else.)"
    k "(No me mires así. Soy responsable de mí mismo, y nadie más.)"

# game/Story03.rpy:7058

translate spanish act3_5chapter2_bb753343:

    # mc "From now on we'll call each other by name. No nicknames, no monikers. You don't mind?"
    mc "A partir de ahora, nos llamaremos por nombre, sin apodos, sin apodos."

# game/Story03.rpy:7060

translate spanish act3_5chapter2_8d049099:

    # gg "Fine."
    gg "Bien."

# game/Story03.rpy:7062

translate spanish act3_5chapter2_f85ee3df:

    # mc "(For her... for everyone who still breathes. I have to survive. Even if I have to bite my way through.)"
    mc "(Para ella... para todos los que aún respiran, tengo que sobrevivir, aunque tenga que pasar por mi camino.)"

# game/Story03.rpy:7064

translate spanish act3_5chapter2_0512330b:

    # mc "Now we know each other's names. So if we end up dying — we'll die as people. But better yet — let's die as the living."
    mc "Ahora nos conocemos los nombres, así que si vamos a enfrentarnos a la muerte, vamos a encontrarnos con la gente, pero aún mejor, vamos a encontrarlo vivo."

# game/Story03.rpy:7065

translate spanish act3_5chapter2_cc6b5234:

    # mc "Alright then, let's go."
    mc "Muy bien, vamos."

# game/Story03.rpy:7083

translate spanish act3_5chapter2_5c558797:

    # a "Ah… history repeats itself. Predictable as ever."
    a "La historia se repite, predecible como siempre."

# game/Story03.rpy:7084

translate spanish act3_5chapter2_26694e5f:

    # y "You… you swore! The Lower City was off-limits!"
    y "¡Juraste que la Ciudad Baja estaba fuera de límites!"

# game/Story03.rpy:7087

translate spanish act3_5chapter2_1dae9a31:

    # a "And you believed that oath meant anything?"
    a "¿Y creías que el juramento significaba algo?"

# game/Story03.rpy:7088

translate spanish act3_5chapter2_87ba2748:

    # a "One task. Escort the boy to the tower. Simple. Elegant. And yet — he’s here."
    a "Una tarea. Escort al niño a la torre. Simple. Elegante. Y sin embargo, está aquí."

# game/Story03.rpy:7090

translate spanish act3_5chapter2_b5852ef1:

    # a "Pathetic. Mortals always crumble when it matters most. So once again, I must correct your failure."
    a "Los mortales siempre se desmoronan cuando más importa. Así que una vez más, debo corregir su fracaso."

# game/Story03.rpy:7113

translate spanish act3_5chapter2_1_09b69430:

    # mc "(The smell of burning, scorched walls, mutant corpses. A sight not for the faint-hearted.)"
    mc "(El olor de paredes ardedoras, desgarradas, cadáveres mutantes. Una vista no para los débiles-hearted.)"

# game/Story03.rpy:7117

translate spanish act3_5chapter2_1_ee87ded2:

    # k "Ah… the smell. Charred walls, rotting freaks. Feels almost cozy."
    k "El olor, paredes de colores, monstruos podridos, se siente casi acogedor."

# game/Story03.rpy:7119

translate spanish act3_5chapter2_1_2b35b6fe:

    # mc "..."
    mc "..."

# game/Story03.rpy:7125

translate spanish act3_5chapter2_1_e35dbfbd:

    # mc "Whoever did this knew exactly what they were doing."
    mc "Quienquiera que hizo esto sabía exactamente lo que estaban haciendo."

# game/Story03.rpy:7127

translate spanish act3_5chapter2_1_9621c198:

    # k "Or rather — whoever did this had style. A true artist at work."
    k "O más bien, quien hizo esto tenía estilo. Un verdadero artista en el trabajo."

# game/Story03.rpy:7132

translate spanish act3_5chapter2_1_61308746:

    # k "Almost makes me jealous."
    k "Casi me pone celoso."

# game/Story03.rpy:7135

translate spanish act3_5chapter2_1_87762c12:

    # mc "I have no doubt about that."
    mc "No tengo duda de eso."

# game/Story03.rpy:7138

translate spanish act3_5chapter2_1_bb8e4b4e:

    # a "..."
    a "..."

# game/Story03.rpy:7140

translate spanish act3_5chapter2_1_5794f5b7:

    # mc "Well? Anything worth noting?"
    mc "¿Algo que valga la pena notar?"

# game/Story03.rpy:7148

translate spanish act3_5chapter2_1_ba08faf1:

    # mc "(So you’re staying quiet till the end? Fine…)"
    mc "(¿Así que te quedas quieto hasta el final?"

# game/Story03.rpy:7150

translate spanish act3_5chapter2_1_1ae5d572:

    # gg "[mc] over here! Might be useful."
    gg "[mc] Podría ser útil."

# game/Story03.rpy:7153

translate spanish act3_5chapter2_1_13274333:

    # mc "Nyx? What’ve you got?"
    mc "¿Nyx? ¿Qué tienes?"

# game/Story03.rpy:7156

translate spanish act3_5chapter2_1_02a5098b:

    # gg "We found this on him."
    gg "Encontramos esto en él."

# game/Story03.rpy:7157

translate spanish act3_5chapter2_1_3f1db724:

    # gg "I don't know if it's real or a setup."
    gg "No sé si es real o falso."

# game/Story03.rpy:7159

translate spanish act3_5chapter2_1_d4504e70:

    # gggg "We're in deep, that's for sure."
    gggg "Estamos en una mierda, eso es seguro."

# game/Story03.rpy:7163

translate spanish act3_5chapter2_1_b2b9e19d:

    # mc "What do you mean?"
    mc "¿Qué quieres decir?"

# game/Story03.rpy:7168

translate spanish act3_5chapter2_1_0690d607:

    # mc "Gather in Sector Three before time runs out. Or..."
    mc "Reúne en el sector Tres antes de que se acabe el tiempo."

# game/Story03.rpy:7170

translate spanish act3_5chapter2_1_1873ff8d:

    # mc "...the lower city will be purged."
    mc "...la ciudad baja será purgada."

# game/Story03.rpy:7172

translate spanish act3_5chapter2_1_48d39340:

    # mc "Can we trust it?"
    mc "¿Podemos confiar en ello?"

# game/Story03.rpy:7175

translate spanish act3_5chapter2_1_05562853:

    # gg "Don't know, but if it's true — we need to hurry."
    gg "No lo sé, pero si eso es verdad, tenemos que darnos prisa."

# game/Story03.rpy:7177

translate spanish act3_5chapter2_1_bb8e4b4e_1:

    # a "..."
    a "..."

# game/Story03.rpy:7179

translate spanish act3_5chapter2_1_b09d52c5:

    # mc "So that’s why you didn’t want us heading there?"
    mc "¿Por eso no querías que nos dirigimos allí?"

# game/Story03.rpy:7181

translate spanish act3_5chapter2_1_615667ff:

    # a "You're reading between the lines too fast."
    a "Leíste entre las líneas demasiado rápido."

# game/Story03.rpy:7183

translate spanish act3_5chapter2_1_244164d6:

    # mc "Listen, I didn't give a damn that you were silent."
    mc "Mira, no me importaba que estuvieras callado..."

# game/Story03.rpy:7188

translate spanish act3_5chapter2_1_f6c5ed4f:

    # mc "(No, [mc]. Hold it. Breathe. Don’t lose it now…)"
    mc "(No, [mc]. Sostenlo. Respirar. No lo pierda ahora ...)"

# game/Story03.rpy:7196

translate spanish act3_5chapter2_1_9c9013cc:

    # mc "But right here, right now — I need answers. Especially about that note."
    mc "Pero aquí mismo, ahora mismo — necesito respuestas, especialmente sobre esa nota."

# game/Story03.rpy:7198

translate spanish act3_5chapter2_1_bb8e4b4e_2:

    # a "..."
    a "..."

# game/Story03.rpy:7200

translate spanish act3_5chapter2_1_5b455ade:

    # mc "Are you really going to keep quiet? Or will you finally speak?"
    mc "¿De verdad vas a callarte o finalmente hablarás?"

# game/Story03.rpy:7202

translate spanish act3_5chapter2_1_76115544:

    # a "You're the leader now. My place is behind you — unseen."
    a "Ahora eres el líder, mi lugar está detrás de ti, en las sombras."

# game/Story03.rpy:7204

translate spanish act3_5chapter2_1_978174fd:

    # k "Cut it out. You’re only digging yourself a deeper grave."
    k "Basta. Solo te estás cavando una tumba más profunda."

# game/Story03.rpy:7210

translate spanish act3_5chapter2_1_feff63bd:

    # mc "We're not leaving until you tell me everything."
    mc "No nos vamos hasta que me digas todo."

# game/Story03.rpy:7212

translate spanish act3_5chapter2_1_df619773:

    # mc "And if I'm the leader now, you'll follow my orders — understood?"
    mc "Y si soy el líder ahora, vas a seguir mis órdenes, ¿de acuerdo?"

# game/Story03.rpy:7213

translate spanish act3_5chapter2_1_bb8e4b4e_3:

    # a "..."
    a "..."

# game/Story03.rpy:7214

translate spanish act3_5chapter2_1_e0d9e8e7:

    # a "Hmpf."
    a "Hmpf."

# game/Story03.rpy:7218

translate spanish act3_5chapter2_1_159f586b:

    # mc "Are you kidding me!"
    mc "¡Me estás tomando el pelo!"

# game/Story03.rpy:7223

translate spanish act3_5chapter2_1_9b1210bb:

    # k "One more twitch, and I’ll carve your throat open. Try me."
    k "Una cosa más, y te abriré la garganta. Pruébame."

# game/Story03.rpy:7225

translate spanish act3_5chapter2_1_2b35b6fe_1:

    # mc "..."
    mc "..."

# game/Story03.rpy:7227

translate spanish act3_5chapter2_1_ab998e08:

    # mc "(She’s right. Cool it down, [mc].)"
    mc "(Ella tiene razón. Enfríe, [mc].)"

# game/Story03.rpy:7231

translate spanish act3_5chapter2_1_40f71b31:

    # mc "(Even silent, she’s still one of us.)"
    mc "(Incluso en silencio, ella es todavía uno de nosotros.)"

# game/Story03.rpy:7234

translate spanish act3_5chapter2_1_12b6fd0f:

    # mc "(Yeah, that's the best move.)"
    mc "(Sí, esa es la mejor opción.)"

# game/Story03.rpy:7236

translate spanish act3_5chapter2_1_71fae008:

    # mc "Maybe you know something?"
    mc "¿Quizás sabes algo?"

# game/Story03.rpy:7240

translate spanish act3_5chapter2_1_e56be2ad:

    # k "Neither I nor my mute sister had a hand in this. Stop whining — it’s making you look pitiful."
    k "Ni yo ni mi hermana muda tuve una mano en esto. Deja de lloriquear — te hace parecer piadoso."

# game/Story03.rpy:7242

translate spanish act3_5chapter2_1_9995c2fe:

    # mc "So it wasn’t your hand?"
    mc "¿Así que no fue tu mano?"

# game/Story03.rpy:7244

translate spanish act3_5chapter2_1_04f1ae85:

    # k "Who do you take me for? A murderer?"
    k "¿Para quién me tomas?"

# game/Story03.rpy:7246

translate spanish act3_5chapter2_1_2b35b6fe_2:

    # mc "..."
    mc "..."

# game/Story03.rpy:7249

translate spanish act3_5chapter2_1_2cdc06dc:

    # mc "You’ve cut down more than most armies. Don’t act like the word doesn’t fit."
    mc "Has cortado más que la mayoría de los ejércitos. No actúes como si la palabra no encajara."

# game/Story03.rpy:7252

translate spanish act3_5chapter2_1_9c268761:

    # k "Don’t play dumb. You’ve slaughtered enough to know. The only difference is motive."
    k "No juegues tonto. Has matado lo suficiente para saber. La única diferencia es el motivo."

# game/Story03.rpy:7255

translate spanish act3_5chapter2_1_51e52378:

    # k "I kill because it’s beautiful."
    k "Yo mato porque es hermoso."

# game/Story03.rpy:7258

translate spanish act3_5chapter2_1_7d95b7f7:

    # k "You kill because someone told you to. That’s your tragedy."
    k "Matas porque alguien te lo dijo. Esa es tu tragedia."

# game/Story03.rpy:7260

translate spanish act3_5chapter2_1_2b35b6fe_3:

    # mc "..."
    mc "..."

# game/Story03.rpy:7262

translate spanish act3_5chapter2_1_6494bad5:

    # mc "Fair enough. Truth is, if I wasn’t dragged into saving this place…"
    mc "La verdad es que si no me arrastraron a salvar este lugar..."

# game/Story03.rpy:7265

translate spanish act3_5chapter2_1_9e28d6ad:

    # mc "I’m not even from here. Not from this planet. From the other side of the universe."
    mc "Ni siquiera soy de aquí. No de este planeta. Del otro lado del universo."

# game/Story03.rpy:7267

translate spanish act3_5chapter2_1_8a1ff4a0:

    # mc "And what do I get back? Suspicion. Aggression. Treated like dirt."
    mc "¿Y qué puedo recuperar?"

# game/Story03.rpy:7268

translate spanish act3_5chapter2_1_c54c0120:

    # mc "Yet still — I chose to help."
    mc "Aún así, elegí ayudar."

# game/Story03.rpy:7271

translate spanish act3_5chapter2_1_3c0439aa:

    # mc "You. Your mistress. With no intel, no backup, nothing."
    mc "Tu, tu amante, sin información, sin respaldo, nada."

# game/Story03.rpy:7276

translate spanish act3_5chapter2_1_bb8e4b4e_4:

    # a "..."
    a "..."

# game/Story03.rpy:7281

translate spanish act3_5chapter2_1_dc607cbe:

    # k "(Don’t.)"
    k "(No lo hagas.)"

# game/Story03.rpy:7283

translate spanish act3_5chapter2_1_a6e657f2:

    # gggg "(whisper) What do we do? He's on edge..."
    gggg "{i}*Whispers*{/i} Está al borde de..."

# game/Story03.rpy:7284

translate spanish act3_5chapter2_1_a05f8c97:

    # gg "(whisper) We watch."
    gg "Lo vemos."

# game/Story03.rpy:7287

translate spanish act3_5chapter2_1_752b8262:

    # gg "..."
    gg "..."

# game/Story03.rpy:7301

translate spanish act3_5chapter2_1_790221dc:

    # mc "Right, I forgot..."
    mc "Cierto, olvidé..."

# game/Story03.rpy:7304

translate spanish act3_5chapter2_1_7a97854f:

    # mc "You understand only the language of violence."
    mc "Usted entiende solo el lenguaje de la violencia."

# game/Story03.rpy:7308

translate spanish act3_5chapter2_1_65535b28:

    # mc "Talk. Tell me what you know."
    mc "Dime lo que sabes."

# game/Story03.rpy:7312

translate spanish act3_5chapter2_1_bb8e4b4e_5:

    # a "..."
    a "..."

# game/Story03.rpy:7316

translate spanish act3_5chapter2_1_a79c5b00:

    # k "Please. Don’t make me waste my blade on you."
    k "Por favor. No me hagas desperdiciar mi espada en ti."

# game/Story03.rpy:7317

translate spanish act3_5chapter2_1_dbdef2f7:

    # k "(quiet) Begging doesn't suit you."
    k "{i}*Whispers*{/i} La oración no te queda bien."

# game/Story03.rpy:7319

translate spanish act3_5chapter2_1_bdc5efa2:

    # mc "I’ve been patient long enough. That’s over."
    mc "He sido paciente lo suficiente."

# game/Story03.rpy:7322

translate spanish act3_5chapter2_1_01e35740:

    # mc "If she won’t listen, then I’ll make her listen."
    mc "Si no quiere escuchar, entonces haré que escuche."

# game/Story03.rpy:7338

translate spanish act3_5chapter2_1_b2323341:

    # k "Don’t push me."
    k "No me empujes."

# game/Story03.rpy:7340

translate spanish act3_5chapter2_1_d465bd31:

    # mc "I won`t repeat, answer. Now!"
    mc "No lo repetiré, contesto. ¡Ahora!"

# game/Story03.rpy:7351

translate spanish act3_5chapter2_1_37af4d3a:

    # k "If you do, I’ll finish this in a heartbeat. That’s your last chance."
    k "Si lo haces, terminaré esto en un latido de corazón. Esa es tu última oportunidad."

# game/Story03.rpy:7353

translate spanish act3_5chapter2_1_1d01ed27:

    # mc "Do you want it to end here? Fine. But you'll tell me first — who ordered it?"
    mc "Quieres que termine aquí, ¿pero primero me dices quién lo ordenó?"

# game/Story03.rpy:7361

translate spanish act3_5chapter2_1_45ee8c1e:

    # mc "(whisper) Seems, I have no choice..."
    mc "Parece que no tengo elección..."

# game/Story03.rpy:7379

translate spanish act3_5chapter2_2_3ed7f492:

    # y "Enough. Both of you."
    y "Suficiente, los dos."

# game/Story03.rpy:7381

translate spanish act3_5chapter2_2_7fce9bbd:

    # Mi "You've crossed the line."
    Mi "Has cruzado la línea."

# game/Story03.rpy:7384

translate spanish act3_5chapter2_2_43a45d9f:

    # y "You. With me. The rest — to Intelligence HQ."
    y "Tú. Conmigo. El resto, al cuartel general de inteligencia."

# game/Story03.rpy:7387

translate spanish act3_5chapter2_2_1d9165ae:

    # y "This concerns everyone. No exceptions."
    y "Esto concierne a todos, sin excepciones."

# game/Story03.rpy:7389

translate spanish act3_5chapter2_2_bb8e4b4e:

    # a "..."
    a "..."

# game/Story03.rpy:7394

translate spanish act3_5chapter2_2_f2ab70af:

    # a "Yes, chaplain."
    a "Sí, capellán."

# game/Story03.rpy:7396

translate spanish act3_5chapter2_2_a1bbd0ba:

    # k "Understood."
    k "Entendido."

# game/Story03.rpy:7398

translate spanish act3_5chapter2_2_45e8037e:

    # y "Miriel — lead them."
    y "Miriel, guíenlos."

# game/Story03.rpy:7400

translate spanish act3_5chapter2_2_10356780:

    # y "And listen well: do not engage. Not a word, not a blade."
    y "Y escucha bien: no te atrevas, ni una palabra, ni una espada."

# game/Story03.rpy:7402

translate spanish act3_5chapter2_2_6e910f0b:

    # Mi "Yes, Teacher."
    Mi "Sí, Maestro."

# game/Story03.rpy:7405

translate spanish act3_5chapter2_2_6669ff6e:

    # k "(whisper) You’ve no idea how much I wanted you to show up."
    k "No tienes idea de cuánto quería que aparecieras."

# game/Story03.rpy:7406

translate spanish act3_5chapter2_2_61bc2e42:

    # Mi "(whisper) I doubt it."
    Mi "Lo dudo."

# game/Story03.rpy:7407

translate spanish act3_5chapter2_2_bb8e4b4e_1:

    # a "..."
    a "..."

# game/Story03.rpy:7409

translate spanish act3_5chapter2_2_850ef128:

    # b "..."
    b "..."

# game/Story03.rpy:7411

translate spanish act3_5chapter2_2_bdb0e556:

    # y "Now. What are you doing here?"
    y "¿Qué haces aquí?"

# game/Story03.rpy:7413

translate spanish act3_5chapter2_2_f1ea2780:

    # mc "Trying to help, Miriel. As much as I can — in the Lower City."
    mc "Tratando de ayudar, Miriel. Tanto como pueda — en la Ciudad Baja."

# game/Story03.rpy:7415

translate spanish act3_5chapter2_2_12aed2c5:

    # y "And what did I tell you?"
    y "¿Y qué te dije?"

# game/Story03.rpy:7417

translate spanish act3_5chapter2_2_e29b2c45:

    # mc "Go to the tower. I remember."
    mc "Ve a la torre, lo recuerdo."

# game/Story03.rpy:7419

translate spanish act3_5chapter2_2_9f8c5c60:

    # mc "(This can’t go on.)"
    mc "(Esto no puede continuar.)"

# game/Story03.rpy:7421

translate spanish act3_5chapter2_2_fcf845a0:

    # mc "With all respect — I’ve had enough. I need answers."
    mc "Con todo respeto — he tenido suficiente. Necesito respuestas."

# game/Story03.rpy:7424

translate spanish act3_5chapter2_2_7bf8b03a:

    # mc "What are we even fighting for? What am I fighting for?"
    mc "¿Por qué luchamos?"

# game/Story03.rpy:7427

translate spanish act3_5chapter2_2_bc942f3f:

    # mc "This silence — it isn’t protection. It’s humiliation."
    mc "Este silencio —no es protección. Es humillación."

# game/Story03.rpy:7430

translate spanish act3_5chapter2_2_f8aa0477:

    # mc "You all know what’s going on. You know everything about me. And I’m left in the dark."
    mc "Todos saben lo que está pasando. Lo saben todo sobre mí. Y me quedo en la oscuridad."

# game/Story03.rpy:7433

translate spanish act3_5chapter2_2_991ab2c5:

    # mc "So please… tell me something. Anything."
    mc "Así que por favor... dime algo."

# game/Story03.rpy:7435

translate spanish act3_5chapter2_2_71a86863:

    # y "..."
    y "..."

# game/Story03.rpy:7437

translate spanish act3_5chapter2_2_2b7ff1db:

    # aa "We decide who lives and who disappears without a trace."
    aa "Decidimos quién vive y quién desaparece sin rastro."

# game/Story03.rpy:7438

translate spanish act3_5chapter2_2_294aa7c4:

    # aa "So don’t do anything stupid. {w}You understand me?"
    aa "Así que no hagas nada estúpido. {w}¿Me entiendes?"

# game/Story03.rpy:7441

translate spanish act3_5chapter2_2_b70ee927:

    # am "(If the presence behind him reacts to her, we may have less time than I thought...)"
    am "(Si la presencia detrás de él reacciona a ella, podemos tener menos tiempo de lo que pensé...)"

# game/Story03.rpy:7442

translate spanish act3_5chapter2_2_e0513d45:

    # y "(She woke something in it. Just like in the anomaly.)"
    y "(Se despertó algo en ella, como en la anomalía.)"

# game/Story03.rpy:7445

translate spanish act3_5chapter2_2_a901cd97:

    # a "This is your final move. Fail me again… and your piece is swept from the board."
    a "Esta es tu última jugada, vuelve a fallarme... y tu pieza está barrida de la tabla."

# game/Story03.rpy:7447

translate spanish act3_5chapter2_2_71a86863_1:

    # y "..."
    y "..."

# game/Story03.rpy:7459

translate spanish act3_5chapter2_2_b357cb82:

    # y "Alright. I’ll give you this chance."
    y "Muy bien. Te daré esta oportunidad."

# game/Story03.rpy:7461

translate spanish act3_5chapter2_2_9ccf2ff9:

    # y "But whether you can handle it or not — that’s up to you."
    y "Pero si usted puede manejarlo o no — eso depende de usted."

# game/Story03.rpy:7469

translate spanish act3_5chapter2_2_01d523d1:

    # mc "(ARGH, MY HEAD IS SPLITTING OPEN!)"
    mc "(¡Antes, mi cabeza está abriendo!)"

# game/Story03.rpy:7470

translate spanish act3_5chapter2_2_b1c08076:

    # mc "(NO, STOP FEELING SORRY FOR YOURSELF, HOLD IT TOGETHER, HOLD IT...)"
    mc "(No, deja de sentirte orgulloso por ti mismo, póntelo de nuevo, póntelo...)"

# game/Story03.rpy:7472

translate spanish act3_5chapter2_2_b19f209b:

    # mc "(WHY DOES IT HURT SO DAMN MUCH!)"
    mc "(¡Qué hace que hiera tan mal!)"

# game/Story03.rpy:7480

translate spanish act3_5chapter2_2_2b35b6fe:

    # mc "..."
    mc "..."

# game/Story03.rpy:7482

translate spanish act3_5chapter2_2_f3d09fd8:

    # y "Don’t leave my side. Not an inch."
    y "No dejes mi lado."

# game/Story03.rpy:7484

translate spanish act3_5chapter2_2_36b45995:

    # mc "We’re… floating in midair?!"
    mc "Estamos... flotando en el aire?!"

# game/Story03.rpy:7486

translate spanish act3_5chapter2_2_e1c02d4b:

    # y "No. We haven’t moved from the starting point. Not even a hair’s breadth."
    y "No. No nos hemos movido desde el punto de partida. Ni siquiera la anchura del pelo."

# game/Story03.rpy:7489

translate spanish act3_5chapter2_2_d35a52e6:

    # mc "This — this is the same device from the Ark."
    mc "Este es el mismo dispositivo del Arca."

# game/Story03.rpy:7492

translate spanish act3_5chapter2_2_bf20aeb4:

    # y "This is your goal. And the only way back home."
    y "Esta es tu meta, y la única manera de volver a casa."

# game/Story03.rpy:7493

translate spanish act3_5chapter2_2_a759d206:

    # mc "(If this gets me home, it’s the only shot I’ve got.)"
    mc "(Si esto me lleva a casa, es el único disparo que tengo.)"

# game/Story03.rpy:7496

translate spanish act3_5chapter2_2_fcc7eca0:

    # mc "You’ve got to be kidding me. Lora!"
    mc "Tienes que estar bromeando. ¡Lora!"

# game/Story03.rpy:7497

translate spanish act3_5chapter2_2_bf413aff:

    # L "Status reports, now! And you — get those BAR crates moved, don’t just stand there!"
    L "¡Informes de estado, ahora! Y tú — ¡muevas esas cajas de BAR, no te quedes ahí!"

# game/Story03.rpy:7500

translate spanish act3_5chapter2_2_762d61ac:

    # ggg "On it!"
    ggg "¡En eso!"

# game/Story03.rpy:7502

translate spanish act3_5chapter2_2_561bf8ea:

    # L "We don’t have time to waste. The gates won’t wait for us!"
    L "No tenemos tiempo para perder. ¡Las puertas no nos esperan!"

# game/Story03.rpy:7505

translate spanish act3_5chapter2_2_b6799be6:

    # a "Yes, ma’am!"
    a "¡Sí, señora!"

# game/Story03.rpy:7511

translate spanish act3_5chapter2_2_37c402c1:

    # ggg "All hail Astoria!"
    ggg "¡Todos aclamen a Astoria!"

# game/Story03.rpy:7512

translate spanish act3_5chapter2_2_d6e78091:

    # aa "With faith and glory!"
    aa "¡Con fe y gloria!"

# game/Story03.rpy:7514

translate spanish act3_5chapter2_2_7b1b6d39:

    # aa "I see my expectations of you were right. Keep it up!"
    aa "Veo que mis expectativas de ti tenían razón. ¡Mantenlo al día!"

# game/Story03.rpy:7516

translate spanish act3_5chapter2_2_fe58472f:

    # L "You’ve given me so much already… so many discoveries, so many mysteries to unravel. It makes me feel alive again."
    L "Ya me has dado tanto... tantos descubrimientos, tantos misterios para desentrañar. Me hace sentir vivo de nuevo."

# game/Story03.rpy:7520

translate spanish act3_5chapter2_2_6d5f9924:

    # aa "And despite all that, you still wish to return?"
    aa "Y a pesar de todo eso, ¿todavía deseas regresar?"

# game/Story03.rpy:7522

translate spanish act3_5chapter2_2_06f35b7b:

    # L "Even with all of this, my heart is restless. He’s still there, without me… I can’t leave him waiting forever."
    L "Incluso con todo esto, mi corazón está inquieto. Él todavía está allí, sin mí... No puedo dejarlo esperar para siempre."

# game/Story03.rpy:7525

translate spanish act3_5chapter2_2_f7cc8ef1:

    # aa "I know those feelings well, my dear. And believe me, I want to see you happy too, but… We cannot."
    aa "Conozco bien esos sentimientos, querida, y créeme, quiero verte feliz también, pero... no podemos."

# game/Story03.rpy:7526

translate spanish act3_5chapter2_2_0afd4568:

    # aa "And your brilliant mind knows this. Doesn’t it?"
    aa "Y tu mente brillante sabe esto. ¿No es así?"

# game/Story03.rpy:7535

translate spanish act3_5chapter2_2_3b66c7b4:

    # aa "You really are a treasure."
    aa "Realmente eres un tesoro."

# game/Story03.rpy:7536

translate spanish act3_5chapter2_2_d3996593:

    # aa "Every time I watch you from afar — I can’t help but admire you."
    aa "Cada vez que te veo desde lejos, no puedo evitar admirarte."

# game/Story03.rpy:7537

translate spanish act3_5chapter2_2_680b050f:

    # aa "You remind me of my little daughter… You and she share such similar views on science."
    aa "Me recuerdas a mi hija... tú y ella comparten opiniones similares sobre la ciencia."

# game/Story03.rpy:7539

translate spanish act3_5chapter2_2_fddc4234:

    # L "You mean Flora?"
    L "¿Te refieres a Flora?"

# game/Story03.rpy:7545

translate spanish act3_5chapter2_2_f507a007:

    # g "Doctor Lora! We’re ready to open the gates!"
    g "¡Doctor Lora! ¡Estamos listos para abrir las puertas!"

# game/Story03.rpy:7547

translate spanish act3_5chapter2_2_6843dca4:

    # L "Good work."
    L "Buen trabajo."

# game/Story03.rpy:7550

translate spanish act3_5chapter2_2_5aefce8a:

    # mc "(She doesn’t have the scar yet… So this happened afterward.)"
    mc "(Ella todavía no tiene la cicatriz... Así que esto sucedió después.)"

# game/Story03.rpy:7552

translate spanish act3_5chapter2_2_07240511:

    # mc "They’re going to send her back? That can’t be right."
    mc "¿La van a enviar de vuelta? Eso no puede estar bien."

# game/Story03.rpy:7554

translate spanish act3_5chapter2_2_71a86863_2:

    # y "..."
    y "..."

# game/Story03.rpy:7555

translate spanish act3_5chapter2_2_db85b50c:

    # y "Not exactly."
    y "No exactamente."

# game/Story03.rpy:7556

translate spanish act3_5chapter2_2_02e15a7b:

    # y "Miriel told you, didn’t she? About our race’s mistake."
    y "Miriel te lo dijo, ¿no? Sobre el error de nuestra raza."

# game/Story03.rpy:7558

translate spanish act3_5chapter2_2_d04b62d2:

    # mc "About the ears? Yeah, I kind of remember."
    mc "- ¿Sobre las orejas?"

# game/Story03.rpy:7560

translate spanish act3_5chapter2_2_977d5ea2:

    # y "The truth is… we weren’t the first to defy the laws of creation."
    y "La verdad es que no éramos los primeros en desafiar las leyes de la creación."

# game/Story03.rpy:7561

translate spanish act3_5chapter2_2_a2c63ab2:

    # y "Long before us, the younger lady did."
    y "Mucho antes que nosotros, la joven dama lo hizo."

# game/Story03.rpy:7563

translate spanish act3_5chapter2_2_83d29ecb:

    # y "In the end, Astoria was forced to imprison her own sister in the depths of a tomb."
    y "Al final, Astoria fue obligada a encarcelar a su propia hermana en las profundidades de una tumba."

# game/Story03.rpy:7565

translate spanish act3_5chapter2_2_7f811734:

    # y "However..."
    y "Sin embargo..."

# game/Story03.rpy:7568

