    # y "She refused to accept it, deciding she’d get her back by any means necessary."
    y "Se negó a aceptarlo, decidiendo que la recuperaría por cualquier medio necesario."

# game/Story03.rpy:7577

translate spanish act3_5chapter2_2_35271698:

    # y "И она, является ключевой фигурой в этом."
    y "Y ella es una figura clave en eso."

