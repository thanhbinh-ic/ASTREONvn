    # mc "(Of all possible moments... she had to walk in now.)"
    mc "(De todos los momentos posibles... tenía que entrar ahora.)"

# game/Story03.rpy:4891

translate spanish akt3chapter4_d5fd2eaf:

    # L "...What are you doing?"
    L "¿Qué estás haciendo?"

# game/Story03.rpy:4895

translate spanish akt3chapter4_a398643d:

