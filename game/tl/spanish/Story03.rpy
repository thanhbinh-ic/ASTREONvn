    # L "Please..."
    L "Por favor..."

# game/Story03.rpy:5134

translate spanish akt3chapter5_9a2bb62f:

    # L "(Again…)"
    L "(Regresar...)"

# game/Story03.rpy:5140

translate spanish akt3chapter5_628d6346:

    # L "(Watching it happen…)"
    L "(Esperando que suceda...)"

# game/Story03.rpy:5145

translate spanish akt3chapter5_9cbdb9ab:

    # L "(He survives.)"
    L "(Él sobrevive.)"

# game/Story03.rpy:5154

translate spanish akt3chapter5_24bd9d9b:

    # L "(This time… he...)"
    L "(Esta vez... él...)"

# game/Story03.rpy:5165

translate spanish akt3chapter5_52597078:

    # mc "You holding up?"
    mc "¿Estás aguantando?"

# game/Story03.rpy:5167

translate spanish akt3chapter5_1b073a14:

    # Fl "I..."
    Fl "Yo..."

# game/Story03.rpy:5170

translate spanish akt3chapter5_8ed0c1b0:

    # mc "Scared?"
    mc "¿Miedo?"

# game/Story03.rpy:5173

translate spanish akt3chapter5_b84af5bf:

    # Fl "What do you think?"
    Fl "¿Qué opinas?"

# game/Story03.rpy:5174

translate spanish akt3chapter5_7ac7ed60:

    # Fl "She just told us we’re going to die!"
    Fl "¡Nos dijo que vamos a morir!"

# game/Story03.rpy:5175

translate spanish akt3chapter5_1b073a14_1:

    # Fl "I..."
    Fl "Yo..."

# game/Story03.rpy:5176

translate spanish akt3chapter5_b24defdf:

    # Fl "(whispering) I don’t want to die."
    Fl "No quiero morir."

# game/Story03.rpy:5179

translate spanish akt3chapter5_cf1adef2:

    # mc "Yeah."
    mc "Sí."

# game/Story03.rpy:5180

translate spanish akt3chapter5_98d19c29:

    # mc "Me neither."
    mc "Yo tampoco."

# game/Story03.rpy:5190

translate spanish akt3chapter5_2d82a0eb:

    # Fl "You don’t get it..."
    Fl "No lo entiendes..."

# game/Story03.rpy:5191

translate spanish akt3chapter5_fbfb49e5:

    # Fl "Everyone sees me as some naive, spoiled little pet."
    Fl "Todos me ven como una pequeña mascota ingenua y malcriada."

# game/Story03.rpy:5192

translate spanish akt3chapter5_eeebf6fe:

    # Fl "No one takes me seriously."
    Fl "Nadie me toma en serio."

# game/Story03.rpy:5193

translate spanish akt3chapter5_67ec577e:

    # Fl "...not even you."
    Fl "...ni siquiera tú."

# game/Story03.rpy:5195

translate spanish akt3chapter5_31eff69d:

    # mc "I—"
    mc "Yo..."

# game/Story03.rpy:5201

translate spanish akt3chapter5_d03c74b7:

    # Fl "Exactly."
    Fl "Exactamente."

# game/Story03.rpy:5203

translate spanish akt3chapter5_9763be76:

    # mc "What about Ember?"
    mc "¿Qué hay de Ember?"

# game/Story03.rpy:5208

translate spanish akt3chapter5_3ef5cb5e:

    # Fl "She..."
    Fl "Ella..."

# game/Story03.rpy:5211

translate spanish akt3chapter5_dc16ebcd:

    # mc "Got it."
    mc "Lo tengo."

# game/Story03.rpy:5212

translate spanish akt3chapter5_eab0b344:

    # mc "Even now, she wanted something in return."
    mc "Incluso ahora, quería algo a cambio."

# game/Story03.rpy:5214

translate spanish akt3chapter5_d1674048:

    # Fl "Power isn’t about friendship."
    Fl "El poder no es sobre la amistad."

# game/Story03.rpy:5226

translate spanish akt3chapter5_04e4b842:

    # mc "(whispering) ...Strength."
    mc "Fuerza."

# game/Story03.rpy:5230

translate spanish akt3chapter5_7e02afc0:

    # mc "Go to Lora."
    mc "Ve a Lora."

# game/Story03.rpy:5231

translate spanish akt3chapter5_823e29cb:

    # mc "Get the plan ready."
    mc "Prepara el plan."

# game/Story03.rpy:5234

translate spanish akt3chapter5_00e6018e:

    # Fl "But-"
    Fl "Pero..."

# game/Story03.rpy:5241

translate spanish akt3chapter5_688a3fb0:

    # mc "Go."
    mc "Ve."

# game/Story03.rpy:5243

translate spanish akt3chapter5_f1403c76:

    # Fl "...No one will listened."
    Fl "...Nadie escuchará."

# game/Story03.rpy:5247

translate spanish akt3chapter5_b31dd769:

    # mc "I’ll handle the rest."
    mc "Yo me encargaré del resto."

# game/Story03.rpy:5256

