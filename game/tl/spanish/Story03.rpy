translate spanish act3_5chapter2_3_1e0e2567:

    # mc "Not the one I met here."
    mc "No es el que conocí aquí."

# game/Story03.rpy:7711

translate spanish act3_5chapter2_3_5711a4fd:

    # mc "Tell me…"
    mc "Dime..."

# game/Story03.rpy:7713

translate spanish act3_5chapter2_3_60cf0c61:

    # mc "what would you do if the person you loved was gone for good?"
    mc "¿Qué harías si la persona que amabas se hubiera ido para siempre?"

# game/Story03.rpy:7719

translate spanish act3_5chapter2_3_d852b200:

    # mc "If everything you leaned on was just… out of reach forever?"
    mc "Si todo lo que te apoyaste fue... ¿para siempre?"

# game/Story03.rpy:7725

translate spanish act3_5chapter2_3_da3fdbf1:

    # Mi "..."
    Mi "..."

# game/Story03.rpy:7728

translate spanish act3_5chapter2_3_4fde1df4:

    # Mi "She’d want you to keep moving. To survive."
    Mi "Ella querría que siguieras moviéndote."

# game/Story03.rpy:7732

translate spanish act3_5chapter2_3_e7288f07:

    # Mi "…That’s all you can do."
    Mi "...Eso es todo lo que puedes hacer."

# game/Story03.rpy:7736

translate spanish act3_5chapter2_3_2b35b6fe_3:

    # mc "..."
    mc "..."

# game/Story03.rpy:7740

translate spanish act3_5chapter2_3_da3fdbf1_1:

    # Mi "..."
    Mi "..."

# game/Story03.rpy:7748

translate spanish act3_5chapter2_3_c4a530d7:

    # mc "Sorry. Didn’t think I had any tears left."
    mc "Lo siento. No pensé que me quedaban lágrimas."

# game/Story03.rpy:7751

translate spanish act3_5chapter2_3_c8ae85d3:

    # Mi "Not exactly the time for it… but I get it."
    Mi "No es exactamente el momento para ello... pero lo entiendo."

# game/Story03.rpy:7754

translate spanish act3_5chapter2_3_e7367d2a:

    # Mi "Still… glad to see you made it back."
    Mi "Aún así... me alegro de ver que lo hiciste de vuelta."

# game/Story03.rpy:7758

translate spanish act3_5chapter2_3_05df7b5e:

    # Mi "And thank you… for not leaving us behind."
    Mi "Y gracias... por no dejarnos atrás."

# game/Story03.rpy:7760

translate spanish act3_5chapter2_3_dd66998d:

    # mc "How could I ever walk away, after everything?"
    mc "¿Cómo podría irme, después de todo?"

# game/Story03.rpy:7762

translate spanish act3_5chapter2_3_da3fdbf1_2:

    # Mi "..."
    Mi "..."

# game/Story03.rpy:7767

translate spanish act3_5chapter2_3_b79edc31:

    # Mi "…Thank you."
    Mi "...Gracias."

# game/Story03.rpy:7774

translate spanish act3_5chapter2_3_92f1bcbf:

    # y "Awake?"
    y "¿Despertar?"

# game/Story03.rpy:7777

translate spanish act3_5chapter2_3_964e3083:

    # mc "Looks like it."
    mc "Parece que sí."

# game/Story03.rpy:7779

translate spanish act3_5chapter2_3_598b874f:

    # y "Good. Then let's move. They're waiting for you in there."
    y "Muy bien, entonces vamos, te están esperando allí."

# game/Story03.rpy:7789

translate spanish act3_5chapter2_3_3ba1b1d2:

    # w "Our mission is to secure the safety of our people. At any cost."
    w "Nuestra misión es asegurar la seguridad de nuestra gente."

# game/Story03.rpy:7799

translate spanish act3_5chapter2_3_825b9da4:

    # g "With all due respect, that's absolute nonsense! The Arks Federation has been ignoring us this whole time."
    g "Con todo respeto, esto es una tontería total! La Federación de Arks nos ha estado ignorando todo este tiempo."

# game/Story03.rpy:7802

translate spanish act3_5chapter2_3_d6950376:

    # g "Why should we be the ones to—"
    g "¿Por qué deberíamos ser los que...?"

# game/Story03.rpy:7804

translate spanish act3_5chapter2_3_0d04128e:

    # w "..."
    w "..."

# game/Story03.rpy:7807

translate spanish act3_5chapter2_3_56826835:

    # w "Anyone else agree with him?"
    w "¿Alguien más está de acuerdo con él?"

# game/Story03.rpy:7810

translate spanish act3_5chapter2_3_4b340443:

    # g "..."
    g "..."

# game/Story03.rpy:7811

translate spanish act3_5chapter2_3_85381107:

    # w "We all make mistakes; they're no exception."
    w "Todos cometemos errores, no son una excepción."

# game/Story03.rpy:7814

translate spanish act3_5chapter2_3_3bde74c3:

    # w "The question is whether our pride is strong enough to bury the hatchet."
    w "La pregunta es si nuestro orgullo es lo suficientemente fuerte para enterrar el hacha."

# game/Story03.rpy:7817

translate spanish act3_5chapter2_3_53ad53a4:

    # w "I understand how you feel. But right now, we must survive!"
    w "Entiendo cómo te sientes, pero ahora mismo, debemos sobrevivir."

# game/Story03.rpy:7819

translate spanish act3_5chapter2_3_54cae50b:

    # ggg "(Rumours)"
    ggg "(Rumores)"

# game/Story03.rpy:7821

translate spanish act3_5chapter2_3_d1ea851a:

    # w "And again we meet."
    w "Y otra vez nos vemos."

# game/Story03.rpy:7824

translate spanish act3_5chapter2_3_09e90edd:

    # w "The first time I wasn't sure. But seeing you here - accept my greeting."
    w "No estaba segura la primera vez, pero cuando estás aquí, felicidades."

# game/Story03.rpy:7827

translate spanish act3_5chapter2_3_015080fd:

    # mc "Glad to meet you. What’s the situation?"
    mc "Encantado de conocerte. ¿Cuál es la situación?"

# game/Story03.rpy:7832

translate spanish act3_5chapter2_3_5b055e29:

    # w "Monsters surround us like wolves. If they close the ring — there won't be an exit left."
    w "Los monstruos nos rodean como lobos, y si cierran el anillo, no hay salida."

# game/Story03.rpy:7836

translate spanish act3_5chapter2_3_5aa9ed78:

    # w "Our way is through the northern tunnel. Old, half-collapsed, but it still holds. That's where we'll force our path."
    w "Nuestro camino es a través del túnel norte, que es viejo, medio colapsado, pero todavía permanece, y ahí es donde vamos a atravesar."

# game/Story03.rpy:7838

translate spanish act3_5chapter2_3_8b3034f8:

    # y "It's blocked. Half the people won't fit through."
    y "Está cerrada, la mitad de la gente no pasará."

# game/Story03.rpy:7839

translate spanish act3_5chapter2_3_6570d3bb:

    # w "I know. But there's no other route. Either we go and take the risk, or we wait here until we're eaten."
    w "Lo sé, pero no hay otra manera, o vamos a correr riesgos o esperamos aquí hasta que nos den."

# game/Story03.rpy:7842

translate spanish act3_5chapter2_3_4e6a411a:

    # Mi "And what if it's a trap?"
    Mi "¿Y si es una trampa?"

# game/Story03.rpy:7844

translate spanish act3_5chapter2_3_ea3e4f70:

    # w "Then we'll die with weapons in our hands. Not cowering in basements like rats."
    w "Entonces moriremos con armas en nuestras manos, no escondiendonos en sótanos como ratas."

# game/Story03.rpy:7846

translate spanish act3_5chapter2_3_ed23b569:

    # mc "What if we put up a fight?"
    mc "¿Y si peleamos?"

# game/Story03.rpy:7848

translate spanish act3_5chapter2_3_2f1c6a0a:

    # w "Too many of them. It won't work."
    w "Hay demasiados, no va a funcionar."

# game/Story03.rpy:7849

translate spanish act3_5chapter2_3_147dc9ee:

    # w "And with civilians around, it would turn into a slaughter."
    w "Y con civiles alrededor, se convertiría en una masacre."

# game/Story03.rpy:7852

translate spanish act3_5chapter2_3_c1c2ad6a:

    # y "That many people won't get through. There's no choice."
    y "No lo lograrán muchas personas."

# game/Story03.rpy:7853

translate spanish act3_5chapter2_3_7be1ebc5:

    # w "I'd give my life to get everyone out — no exceptions."
    w "Daré mi vida para sacar a todos, sin excepciones."

# game/Story03.rpy:7855

translate spanish act3_5chapter2_3_640ca5ee:

    # mc "Yong’s right. It’s suicide."
    mc "Yong tiene razón. Es suicidio."

# game/Story03.rpy:7856

translate spanish act3_5chapter2_3_d5b50506:

    # mc "Clearing a path for hundreds is already near impossible. And you want more than that…"
    mc "Limpiar un camino para cientos ya es casi imposible. Y quieres más que eso..."

# game/Story03.rpy:7858

translate spanish act3_5chapter2_3_ceece35d:

    # w "So what do you propose?"
    w "¿Qué propones?"

# game/Story03.rpy:7860

translate spanish act3_5chapter2_3_6a6b86f0:

    # mc "Do you know about Sector 3?"
    mc "¿Sabe lo del Sector 3?"

# game/Story03.rpy:7863

translate spanish act3_5chapter2_3_7f5ee279:

    # mc "Could their numbers be enough to hold the lower city?"
    mc "¿Podrían tener sus números suficientes para mantener la ciudad baja?"

# game/Story03.rpy:7870

translate spanish act3_5chapter2_3_f13f8809:

    # y "That would be an advantage."
    y "Eso sería una ventaja."

# game/Story03.rpy:7872

translate spanish act3_5chapter2_3_97679a9c:

    # y "But if you send them all — our front will collapse, and then it will be the end for everyone."
    y "Pero si los envías a todos, nuestro frente se derrumbe, y entonces será el fin para todos."

# game/Story03.rpy:7874

translate spanish act3_5chapter2_3_1c04ce1e:

    # w "We'll manage without their help."
    w "Podemos hacerlo sin su ayuda."

# game/Story03.rpy:7878

translate spanish act3_5chapter2_3_c72e6b67:

    # mc "(Without them, reaching the tower will be impossible. And asking the peacekeepers now would be too late.)"
    mc "(Sin ellos, llegar a la torre será imposible. Y pedir a los pacificadores ahora sería demasiado tarde.)"

# game/Story03.rpy:7880

translate spanish act3_5chapter2_3_4a8de014:

    # Mi "If I may, I know someone who can actually help."
    Mi "Si puedo, conozco a alguien que puede ayudar."

# game/Story03.rpy:7884

translate spanish act3_5chapter2_3_c651dfa6:

    # Mi "Flora Sevin. Sharp, capable… and reliable."
    Mi "Flora Sevin, capaz y confiable."

# game/Story03.rpy:7886

translate spanish act3_5chapter2_3_7470b4b8:

    # mc "(Exactly — if she can help them, they'll have reason to return the favor!)"
    mc "(Exactamente. ¡Si puede ayudarlos, tendrán una razón para pagarnos a cambio!)"

# game/Story03.rpy:7895

translate spanish act3_5chapter2_3_6b3a8b6e:

    # mc "I need to contact her."
    mc "Necesito contactarla."

# game/Story03.rpy:7899

translate spanish act3_5chapter2_3_6917bf14:

    # w "A hopeless task. At best you'll get a narcissistic commander on the line."
    w "En el mejor de los casos, conseguirás un comandante narcisista."

# game/Story03.rpy:7901

translate spanish act3_5chapter2_3_8daa42b6:

    # mc "You’re not the last authority here. Don’t tell me you’ve got no pull."
    mc "No eres la última autoridad aquí. No me digas que no tienes ninguna atracción."

# game/Story03.rpy:7903

translate spanish act3_5chapter2_3_71a86863:

    # y "..."
    y "..."

# game/Story03.rpy:7905

translate spanish act3_5chapter2_3_3d2def36:

    # w "He has his own demons."
    w "Tiene sus propios demonios."

# game/Story03.rpy:7910

translate spanish act3_5chapter2_3_4c29bf9b:

    # w "You go to Sector 3. We stay here until you return."
    w "Tú ve al Sector 3. Nos quedamos aquí hasta que regreses."

# game/Story03.rpy:7912

translate spanish act3_5chapter2_3_38d29f73:

    # w "Two days. If you don't come back… you'll be the ones blamed for sending us into the tunnel."
    w "Si no vuelves, te acusarán de enviarnos al túnel."

# game/Story03.rpy:7920

translate spanish act3_5chapter2_3_13f1a8bd:

    # gg "Mr. Winter, for that they need a transport to get—"
    gg "Sr. Winter, por eso necesitan un transporte para..."

# game/Story03.rpy:7922

translate spanish act3_5chapter2_3_2ca2db85:

    # w "He will take them there."
    w "Los llevará allí."

# game/Story03.rpy:7924

translate spanish act3_5chapter2_3_71a86863_1:

    # y "..."
    y "..."

# game/Story03.rpy:7925

translate spanish act3_5chapter2_3_25079f96:

    # w "We'll keep an eye on your Elves."
    w "Mantendremos un ojo en los elfos."

# game/Story03.rpy:7927

translate spanish act3_5chapter2_3_37ba6b04:

    # w "Then let's get to it. I pray for your success."
    w "Entonces empecemos, rezaré por tu éxito."

# game/Story03.rpy:7939

translate spanish act3_5chapter2_3_1a47af84:

    # mc "(All this time here… and I’ve barely learned a thing.)"
    mc "(Todo este tiempo aquí... y apenas he aprendido algo.)"

# game/Story03.rpy:7940

translate spanish act3_5chapter2_3_a9cb99ce:

    # mc "(Why are we here? What really happened with Lora? How are we stuck in the middle of this mess?)"
    mc "¿Qué pasó realmente con Lora? ¿Cómo estamos atrapados en medio de este desastre?"

# game/Story03.rpy:7941

translate spanish act3_5chapter2_3_4e7ebda2:

    # mc "(And why does it have to be me dragging it forward?)"
    mc "(¿Y por qué tengo que ser yo arrastrando hacia adelante?)"

# game/Story03.rpy:7944

translate spanish act3_5chapter2_3_366c3259:

    # mc "(Lora… I started for you. But now?)"
    mc "(Lora... empecé por ti. ¿Pero ahora?)"

# game/Story03.rpy:7947

translate spanish act3_5chapter2_3_430392f7:

    # mc "(Save the planet, save them all — but what for?)"
    mc "(Salven el planeta, salven a todos — pero ¿para qué?)"

# game/Story03.rpy:7950

translate spanish act3_5chapter2_3_9de6c889:

    # mc "(They’ve treated me like a child from the start. Secrets, half-truths… it’s almost funny.)"
    mc "(Me han tratado como un niño desde el principio. Secretos, medias verdades... es casi gracioso.)"

# game/Story03.rpy:7951

translate spanish act3_5chapter2_3_a976a5da:

    # mc "(And Norman… for what did he have to die?)"
    mc "(Y Norman... ¿por qué tuvo que morir?)"

# game/Story03.rpy:7954

translate spanish act3_5chapter2_3_7c55f8f8:

    # Mi "You okay?"
    Mi "¿Estás bien?"

# game/Story03.rpy:7956

translate spanish act3_5chapter2_3_2b35b6fe_4:

    # mc "..."
    mc "..."

# game/Story03.rpy:7958

translate spanish act3_5chapter2_3_cc6dd611:

    # mc "Just thinking. About everything."
    mc "Solo pensaba en todo."

# game/Story03.rpy:7962

translate spanish act3_5chapter2_3_00b51a26:

    # mc "So? What’s next?"
    mc "¿Qué sigue?"

# game/Story03.rpy:7965

translate spanish act3_5chapter2_3_11848f39:

    # y "I need to gather a few more people. You just wai—"
    y "Necesito reunir a algunas personas más."

# game/Story03.rpy:7967

translate spanish act3_5chapter2_3_964899a2:

    # mc "Not that. I mean answers."
    mc "No, quiero decir respuestas."

# game/Story03.rpy:7970

translate spanish act3_5chapter2_3_71a86863_2:

    # y "..."
    y "..."

# game/Story03.rpy:7972

translate spanish act3_5chapter2_3_72a47a2b:

    # mc "Back there, you showed me the goal. But it wasn’t enough."
    mc "De vuelta, me mostraste el objetivo, pero no era suficiente."

# game/Story03.rpy:7973

translate spanish act3_5chapter2_3_425f3894:

    # mc "Time to lift the curtain, don’t you think?"
    mc "Es hora de levantar la cortina, ¿no crees?"

# game/Story03.rpy:7975

translate spanish act3_5chapter2_3_71a86863_3:

    # y "..."
    y "..."

# game/Story03.rpy:7978

translate spanish act3_5chapter2_3_2084e530:

    # y "Fine."
    y "Bien."

# game/Story03.rpy:7979

translate spanish act3_5chapter2_3_509ede87:

    # y "Four answers. No more."
    y "Cuatro respuestas."

# game/Story03.rpy:8169

translate spanish act3_5chapter3_f4ecb51c:

    # mc "Yeah, not exactly a pleasant sight."
    mc "Sí, no es una vista agradable."

# game/Story03.rpy:8170

translate spanish act3_5chapter3_193c9cde:

    # mc "Despair and fear feel right at home here."
    mc "El miedo y el miedo se sienten en casa aquí."

# game/Story03.rpy:8174

translate spanish act3_5chapter3_3144b5d0:

    # Mi "Sometimes people will do far worse to survive."
    Mi "A veces la gente hará mucho peor para sobrevivir."

# game/Story03.rpy:8175

translate spanish act3_5chapter3_9c392618:

    # mc "I don't doubt that. Still, conditions here are a hell of a lot nicer than on the surface."
    mc "Estoy seguro de que es verdad, pero las condiciones aquí son mucho mejores que la superficie."

# game/Story03.rpy:8178

translate spanish act3_5chapter3_c1a70c16:

    # Mi "For now. Many here live only for the thought of tomorrow."
    Mi "Por ahora, muchos aquí viven solo para el pensamiento de mañana."

# game/Story03.rpy:8181

translate spanish act3_5chapter3_d12dd8da:

    # Mi "And with every hour things only get sh—"
    Mi "Y con cada hora las cosas solo se hacen tímidas..."

# game/Story03.rpy:8185

translate spanish act3_5chapter3_7dbbb20d:

    # "Ma’am, it’s you... The very one. Thank you, thank you."
    "Señora, es usted... el mismo. Gracias, gracias."

# game/Story03.rpy:8186

translate spanish act3_5chapter3_d1f3e53f:

    # "Savior! The savior is with us!"
    "¡El salvador está con nosotros!"

# game/Story03.rpy:8188

translate spanish act3_5chapter3_73393eaa:

    # mc "What... is going on?"
    mc "¿Qué... está pasando?"

# game/Story03.rpy:8190

translate spanish act3_5chapter3_8e84eb15:

    # y "The will to live does strange things to people's minds."
    y "El deseo de vivir hace cosas extrañas a la mente de la gente."

# game/Story03.rpy:8192

translate spanish act3_5chapter3_76ae5c75:

    # y "She became a sign of salvation for a lot of them. A faith they desperately needed."
    y "Se convirtió en un signo de salvación para muchos de ellos, una fe que necesitaban desesperadamente."

# game/Story03.rpy:8194

translate spanish act3_5chapter3_489ac329:

    # mc "How ironic. From traitor and 'third-rate race' to symbol of hope."
    mc "De la raza traidora y de tercera clase a símbolo de esperanza."

# game/Story03.rpy:8195

translate spanish act3_5chapter3_eabc9e14:

    # mc "Their memories fade fast."
    mc "Sus recuerdos se desvanecen rápido."

# game/Story03.rpy:8197

translate spanish act3_5chapter3_d095eaf4:

    # y "You don't get to choose. Sometimes people need someone to put their faith in. Even if yesterday they hated that person."
    y "A veces la gente necesita algo que creer, incluso si odiaban a esa persona ayer."

# game/Story03.rpy:8199

translate spanish act3_5chapter3_727be09f:

    # mc "I'd love some of your mercy."
    mc "Me gustaría un poco de misericordia de ti."

# game/Story03.rpy:8201

translate spanish act3_5chapter3_9212bb36:

    # Mi "I have to go."
    Mi "Tengo que irme."

# game/Story03.rpy:8205

translate spanish act3_5chapter3_f152e139:

    # mc "The savior, huh."
    mc "El salvador, eh."

# game/Story03.rpy:8209

translate spanish act3_5chapter3_b771e899:

    # Mi "If it helps them, I don't mind."
    Mi "Si les ayuda, no me importa."

# game/Story03.rpy:8210

translate spanish act3_5chapter3_68af51fa:

    # mc "A cold reaper, a savior... You really never stop surprising me."
    mc "Un segador frío, un salvador... nunca dejas de sorprenderme."

# game/Story03.rpy:8212

translate spanish act3_5chapter3_b219b53f:

    # Mi "I do what I think is right."
    Mi "Hago lo que creo que es correcto."

# game/Story03.rpy:8215

translate spanish act3_5chapter3_8c172152:

    # y "Take him to the house, and wait for me there."
    y "Llévenlo a la casa, y espérenme allí."

# game/Story03.rpy:8219

translate spanish act3_5chapter3_850ef128:

    # b "..."
    b "..."

# game/Story03.rpy:8221

translate spanish act3_5chapter3_42bae7dd:

    # mc "So it's just the two of us now."
    mc "Así que ahora estamos aquí juntos."

# game/Story03.rpy:8223

translate spanish act3_5chapter3_72742ff3:

    # Mi "Let's go before someone jumps us."
    Mi "Vamos antes de que alguien venga tras nosotros."

# game/Story03.rpy:8224

translate spanish act3_5chapter3_f5df3fe6:

    # mc "Yeah, I'm coming."
    mc "Sí, ya voy."

# game/Story03.rpy:8234

translate spanish act3_5chapter3_2b35b6fe:

    # mc "..."
    mc "..."

# game/Story03.rpy:8235

translate spanish act3_5chapter3_2170b42f:

    # mc "Miriel?"
    mc "¿Miriel?"

# game/Story03.rpy:8236

translate spanish act3_5chapter3_ad6d264d:

    # Mi "Yes?"
    Mi "¿Sí?"

# game/Story03.rpy:8239

translate spanish act3_5chapter3_02f9b6ec:

    # mc "How did you end up in this place?"
    mc "¿Cómo acabaste en este lugar?"

# game/Story03.rpy:8240

translate spanish act3_5chapter3_de281a89:

    # Mi "It's... a long story. Why?"
    Mi "Es... es una larga historia. ¿Por qué?"

# game/Story03.rpy:8244

translate spanish act3_5chapter3_e77f0e52:

    # mc "Back when I served, our squad had a weird tradition."
    mc "Cuando serví, nuestro equipo tenía una tradición rara."

# game/Story03.rpy:8245

translate spanish act3_5chapter3_b135e9da:

    # mc "Every Tuesday we'd pick a 'victim' and grill them about their life. Supposed to make us closer."
    mc "Cada martes, escogeríamos a una víctima y le preguntamos sobre la vida, y eso nos acercaría más."

# game/Story03.rpy:8246

translate spanish act3_5chapter3_14966565:

    # mc "You know my story. Now it's your turn."
    mc "Ya sabes mi historia, ahora es tu turno."

# game/Story03.rpy:8248

translate spanish act3_5chapter3_fe010c5a:

    # Mi "This..."
    Mi "Esto..."

# game/Story03.rpy:8254

translate spanish act3_5chapter3_1ce5d2b3:

    # Mi "I barely remember when it all started."
    Mi "Apenas recuerdo cuando todo empezó."

# game/Story03.rpy:8260

translate spanish act3_5chapter3_f09755c3:

    # Mi "I've lived here for decades. The people around... became my family."
    Mi "He vivido aquí durante décadas, la gente que me rodea se ha convertido en mi familia."

# game/Story03.rpy:8263

translate spanish act3_5chapter3_ec288a84:

    # Mi "But meeting you wasn't exactly a pleasant start."
    Mi "Pero conocerte no fue particularmente agradable."

# game/Story03.rpy:8265

translate spanish act3_5chapter3_64884e0b:

    # mc "What, were you also hiding in the shadows, waiting for a dramatic entrance?"
    mc "¿Qué, también te escondiste en las sombras, esperando una entrada dramática?"

# game/Story03.rpy:8268

translate spanish act3_5chapter3_8b9bbad9:

    # mc "Sorry, dumb joke."
    mc "Lo siento, broma tonta."

# game/Story03.rpy:8271

translate spanish act3_5chapter3_da3fdbf1:

    # Mi "..."
    Mi "..."

# game/Story03.rpy:8273

translate spanish act3_5chapter3_49ffd6ca:

    # Mi "It was like that..."
    Mi "Fue así..."

# game/Story03.rpy:8275

translate spanish act3_5chapter3_cb531f36:

    # mc "Wait, are you serious?"
    mc "Espera, ¿en serio?"

# game/Story03.rpy:8276

translate spanish act3_5chapter3_da3fdbf1_1:

    # Mi "..."
    Mi "..."

# game/Story03.rpy:8279

translate spanish act3_5chapter3_ccfe6cd2:

    # Mi "Kidding. Saw your face."
    Mi "Te vi la cara."

# game/Story03.rpy:8280

translate spanish act3_5chapter3_6eebe4de:

    # mc "Well thanks — almost gave me a heart attack."
    mc "Bueno, gracias, casi me dio un ataque al corazón."

# game/Story03.rpy:8281

translate spanish act3_5chapter3_4a03a81f:

    # mc "Turns out you've got a sense of humor, huh."
    mc "Resulta que tienes sentido del humor, ¿no?"

# game/Story03.rpy:8282

translate spanish act3_5chapter3_fbf9fea3:

    # Mi "Surprised?"
    Mi "¿Sorprendido?"

# game/Story03.rpy:8283

translate spanish act3_5chapter3_27320961:

    # mc "A little."
    mc "Un poco."

# game/Story03.rpy:8284

translate spanish act3_5chapter3_d42c7366:

    # Mi "... Now — my turn to ask."
    Mi "Ahora, mi turno de preguntar."

# game/Story03.rpy:8285

translate spanish act3_5chapter3_2043b617:

    # Mi "What's going on with Lora?"
    Mi "¿Qué pasa con Laura?"

# game/Story03.rpy:8292

translate spanish act3_5chapter3_8bdaaf09:

    # Mi "I've already been the 'victim'. Now it's your turn."
    Mi "Ya era una víctima, ahora es tu turno."

# game/Story03.rpy:8294

translate spanish act3_5chapter3_7c3e6d8f:

    # mc "It's... {w=1}complicated."
    mc "Esto es... {w=1}difícil."

# game/Story03.rpy:8295

translate spanish act3_5chapter3_a9a80a49:

    # mc "Part of me says it's the same Lora, just... {w=1}after everything..."
    mc "Parte de mí dice que es la misma Laura, solo... {w=1}después de todo"

# game/Story03.rpy:8296

translate spanish act3_5chapter3_2883c5d4:

    # mc "Her act... {w=1}a lie to protect? {w=1}I don't know."
    mc "Su comportamiento... {w=1}¿Mentiras para proteger? {w=1}No lo sé."

# game/Story03.rpy:8300

translate spanish act3_5chapter3_322b820d:

    # mc "But another part still wants to believe it's just circumstances."
    mc "Pero la otra parte todavía quiere creer que son solo circunstancias."

# game/Story03.rpy:8302

translate spanish act3_5chapter3_ff7eb8f3:

    # Mi "When we first made it to the surface, she always talked about you."
    Mi "Cuando llegamos a la superficie, siempre habló de ti."

# game/Story03.rpy:8303

translate spanish act3_5chapter3_64a67479:

    # Mi "She was aching to meet you. But then..."
    Mi "Ella estaba ansioso por conocerte, pero luego..."

# game/Story03.rpy:8304

translate spanish act3_5chapter3_f613c3cb:

    # Mi "Something changed in her."
    Mi "Algo cambió en ella."

# game/Story03.rpy:8305

translate spanish act3_5chapter3_2b35b6fe_1:

    # mc "..."
    mc "..."

# game/Story03.rpy:8307

translate spanish act3_5chapter3_06dcb99d:

    # mc "So you were on the surface afterwards."
    mc "Entonces estabas en la superficie después."

# game/Story03.rpy:8313

translate spanish act3_5chapter3_8cf73394:

    # Mi "Yes — sorry."
    Mi "Sí, lo siento."

# game/Story03.rpy:8314

translate spanish act3_5chapter3_8e0469a2:

    # mc "Forget it. But what were you doing up there?"
    mc "Olvídalo, ¿pero qué hacías ahí arriba?"

# game/Story03.rpy:8316

translate spanish act3_5chapter3_9f91e119:

    # Mi "Lora wanted to make sure you were safe. And the other thing..."
    Mi "Lora quería asegurarse de que estuvieras a salvo y lo otro..."

# game/Story03.rpy:8320

translate spanish act3_5chapter3_62e63f11:

    # mc "The other thing?"
    mc "¿La otra cosa?"

# game/Story03.rpy:8323

translate spanish act3_5chapter3_1aa14803:

    # Mi "We were supposed to meet one of her old acquaintances."
    Mi "Se suponía que debíamos conocer a uno de sus conocidos."

# game/Story03.rpy:8324

translate spanish act3_5chapter3_80691371:

    # Mi "A girl in glasses..."
    Mi "Una chica con gafas..."

# game/Story03.rpy:8326

translate spanish act3_5chapter3_930dfabf:

    # mc "And why?"
    mc "¿Y por qué?"

# game/Story03.rpy:8328

translate spanish act3_5chapter3_aa32ee0f:

    # Mi "She had something that could help us... And we had a way to get her father back."
    Mi "Tenía algo que podía ayudarnos... y teníamos una manera de recuperar a su padre."

# game/Story03.rpy:8329

translate spanish act3_5chapter3_5ecfc8f6:

    # Mi "I don't know the rest. The teacher replaced me after that."
    Mi "Después de eso, el profesor me reemplazó."

# game/Story03.rpy:8331

translate spanish act3_5chapter3_2b35b6fe_2:

    # mc "..."
    mc "..."

# game/Story03.rpy:8333

translate spanish act3_5chapter3_8085b49c:

    # az "And my daughter — poor, faithful girl — made a deal."
    az "Y mi hija —la pobre y fiel— hizo un trato."

# game/Story03.rpy:8334

translate spanish act3_5chapter3_90a3c2f1:

    # az "I never saw the face. Could’ve been a god. Or a child. Or just a man who stopped blinking."
    az "Nunca vi la cara. Podría haber sido un dios o un niño. O un hombre que dejó de parpadear."

# game/Story03.rpy:8336

translate spanish act3_5chapter3_b5f37fb3:

    # N "Father, it’s what mom was working on..."
    N "Padre, es en lo que mamá estaba trabajando..."

# game/Story03.rpy:8343

translate spanish act3_5chapter3_5d0a2b38:

    # mc "(No, [mc], it's just a coincidence. It can't be. It just can't.)"
    mc "(No, no, no, no. [mc!t]Es una coincidencia, no puede ser, no puede ser."

# game/Story03.rpy:8345

translate spanish act3_5chapter3_971e9c01:

    # mc "Alright then..."
    mc "Muy bien, entonces..."

# game/Story03.rpy:8348

translate spanish act3_5chapter3_a58d16e1:

    # mc "Thank you for trusting me."
    mc "Gracias por confiar en mí."

# game/Story03.rpy:8351

translate spanish act3_5chapter3_c9418b08:

    # mc "It really means a lot."
    mc "Significa mucho."

# game/Story03.rpy:8355

translate spanish act3_5chapter3_da3fdbf1_2:

    # Mi "..."
    Mi "..."

# game/Story03.rpy:8356

translate spanish act3_5chapter3_cdd1079d:

    # mc "(Her eyes — they draw you in... Maybe I should. {w=0.3}No. {w=0.3}No.)"
    mc "(Sus ojos - te dibujan en ... Tal vez debería. {w=0.3}No. {w=0.3}No.)"

# game/Story03.rpy:8357

translate spanish act3_5chapter3_ec36da87:

    # mc "(Not now. At least not now.)"
    mc "(Ahora no. Al menos ahora no)."

# game/Story03.rpy:8360

translate spanish act3_5chapter3_b8f21195:

    # mc "Miriel? Are you okay?"
    mc "¿Estás bien?"

# game/Story03.rpy:8365

translate spanish act3_5chapter3_a60a4425:

    # Mi "Y-yeah, come in... We're arrived."
    Mi "Sí, entra... estamos aquí."

# game/Story03.rpy:8368

translate spanish act3_5chapter3_2b35b6fe_3:

    # mc "..."
    mc "..."

# game/Story03.rpy:8371

translate spanish act3_5chapter3_f800bed0:

    # mc "Yes."
    mc "Sí."

# game/Story03.rpy:8374

translate spanish act3_5chapter3_dd0bb808:

    # Mi "Sit down."
    Mi "Siéntate."

# game/Story03.rpy:8375

translate spanish act3_5chapter3_0f6cd269:

    # mc "This your room?"
    mc "¿Esta es tu habitación?"

# game/Story03.rpy:8378

translate spanish act3_5chapter3_1cb66195:

    # Mi "Just a place to stay the night, nothing more."
    Mi "Un lugar para quedarse la noche, nada más."

# game/Story03.rpy:8379

translate spanish act3_5chapter3_dfbd76ec:

    # mc "Pretty... decisive."
    mc "Bastante... decisivo."

# game/Story03.rpy:8381

translate spanish act3_5chapter3_50f94a52:

    # Mi "There are reasons."
    Mi "Hay razones."

# game/Story03.rpy:8382

translate spanish act3_5chapter3_2b35b6fe_4:

    # mc "..."
    mc "..."

# game/Story03.rpy:8384

translate spanish act3_5chapter3_52aaa766:

    # mc "Because of Scarlei?"
    mc "¿Por Scarlei?"

# game/Story03.rpy:8390

translate spanish act3_5chapter3_63450149:

    # Mi "How did you—"
    Mi "¿Cómo..."

# game/Story03.rpy:8395

translate spanish act3_5chapter3_612dab75:

    # mc "Her name came up a lot around here. Not hard to put two and two together."
    mc "Su nombre se puso mucho por aquí, no es difícil juntar dos y dos."

# game/Story03.rpy:8398

translate spanish act3_5chapter3_14368c5d:

    # mc "Someone close?"
    mc "¿Alguien cercano?"

# game/Story03.rpy:8400

translate spanish act3_5chapter3_23484651:

    # Mi "Closer than close..."
    Mi "Más cerca que cerca..."

# game/Story03.rpy:8401

translate spanish act3_5chapter3_91ff6a7e:

    # Mi "She was the one who gave me a reason to keep living."
    Mi "Ella fue la que me dio una razón para seguir viviendo."

# game/Story03.rpy:8402

translate spanish act3_5chapter3_af774f46:

    # Mi "And the one who showed me this place."
    Mi "Y el que me mostró este lugar."

# game/Story03.rpy:8404

translate spanish act3_5chapter3_470d6dd1:

    # mc "Wait, wasn't that Yong?"
    mc "Espera, ¿no era Yong?"

# game/Story03.rpy:8406

translate spanish act3_5chapter3_80bdd2d2:

    # Mi "You're not the first to think that. No, not him."
    Mi "No eres el primero en pensar eso."

# game/Story03.rpy:8407

translate spanish act3_5chapter3_ea2341fa:

    # Mi "When I needed it most, she reached out."
    Mi "Cuando más lo necesitaba, se puso en contacto."

# game/Story03.rpy:8410

translate spanish act3_5chapter3_1b6c4a91:

    # mc "(Was that before you worked as a merc, or after?)"
    mc "¿Fue antes de que trabajaras como un médico o después?"

# game/Story03.rpy:8411

translate spanish act3_5chapter3_d0e913e4:

    # Mi "(Around the time I was a merc, yeah.)"
    Mi "(En el tiempo que era un médico, sí.)"

# game/Story03.rpy:8413

translate spanish act3_5chapter3_67c1d068:

    # Mi "(Hunger, murder, stench and abuse. Most of my life can be summed up by those words.)"
    Mi "(Hunger, murder, stench and abuse. La mayor parte de mi vida puede ser resumida por esas palabras.)"

# game/Story03.rpy:8415

translate spanish act3_5chapter3_da90e894:

    # Mi "(I'd take any job I could get.)"
    Mi "(Hice cualquier trabajo que pudiera encontrar.)"

# game/Story03.rpy:8418

translate spanish act3_5chapter3_2002c124:

    # Mi "(Killing and stealing became my day-to-day.)"
    Mi "(El llanto y el robo se convirtieron en mi día a día.)"

# game/Story03.rpy:8421

translate spanish act3_5chapter3_cb89ec0c:

    # mc "(Not so different then, huh?)"
    mc "(No tan diferente entonces, ¿eh?)"

# game/Story03.rpy:8422

translate spanish act3_5chapter3_f448a6eb:

    # Mi "(Maybe.)"
    Mi "(Quizás.)"

# game/Story03.rpy:8425

translate spanish act3_5chapter3_e59d3514:

    # "You clear? Plan’s simple: go in, grab the data — get out."
    "¿Está claro? Plan es simple: entrar, coger los datos — salir."

# game/Story03.rpy:8427

translate spanish act3_5chapter3_53ef6d81:

    # "No theatrics, got it?"
    "No hay teatricia, ¿entendido?"

# game/Story03.rpy:8429

translate spanish act3_5chapter3_bddc88bb:

    # Mi "Yes."
    Mi "Sí."

# game/Story03.rpy:8431

translate spanish act3_5chapter3_2119d129:

    # "And move it, we don't have much time."
    "Y date prisa, no tenemos mucho tiempo."

# game/Story03.rpy:8435

translate spanish act3_5chapter3_fd218539:

    # Mi "(Most of my operators were real assholes.)"
    Mi "(La mayoría de mis operadores eran verdaderos idiotas.)"

# game/Story03.rpy:8437

translate spanish act3_5chapter3_7ff1dc2b:

    # Mi "(I couldn't stand their arrogance and vanity, but I had to put up with them.)"
    Mi "(No podía soportar su arrogancia y vanidad, pero tuve que aguantarlo)."

# game/Story03.rpy:8439

translate spanish act3_5chapter3_cc100b6e:

    # Mi "I'm at the door."
    Mi "Estoy en la puerta."

# game/Story03.rpy:8440

translate spanish act3_5chapter3_b4424f5c:

    # "And what are you waiting for? An invitation?"
    "¿Y qué esperas?"

# game/Story03.rpy:8443

translate spanish act3_5chapter3_dca0e291:

    # "Nice scene, huh? I knew you'd like it. Now quickly, room on the left — the data — and you're out."
    "Sabía que te gustaría, y ahora, rápido, la habitación de la izquierda, tomas los datos y lo limpias."

# game/Story03.rpy:8444

translate spanish act3_5chapter3_f7442f51:

    # Mi "(Every time I saw scenes like that, I was glad it wasn't me in their place.)"
    Mi "(Cada vez que vi estas escenas, me alegré de que no fuera yo.)"

# game/Story03.rpy:8446

translate spanish act3_5chapter3_2af488e8:

    # Mi "(But at the same time I hated myself for it.)"
    Mi "(Pero al mismo tiempo me odiaba por ello)."

# game/Story03.rpy:8447

translate spanish act3_5chapter3_e21f0a16:

    # Mi "(For my helplessness.)"
    Mi "(Por mi impotencia.)"

# game/Story03.rpy:8449

translate spanish act3_5chapter3_26cc464b:

    # "No ego, got it?"
    "No hay ego, ¿lo entiendes?"

# game/Story03.rpy:8450

translate spanish act3_5chapter3_bddc88bb_1:

    # Mi "Yes."
    Mi "Sí."

# game/Story03.rpy:8451

translate spanish act3_5chapter3_27f50fd0:

    # mc "(Was it really that bad?)"
    mc "¿Fue tan malo?"

# game/Story03.rpy:8452

translate spanish act3_5chapter3_1a6eea55:

    # Mi "(Life was worth less than a magazine of ammo. Nobody cared about things like that.)"
    Mi "(La vida valía menos que una revista de munición. Nadie se preocupaba por cosas como esas.)"

# game/Story03.rpy:8454

translate spanish act3_5chapter3_c26e77e8:

    # Mi "(Some tried, but their bodies were found the next day — nobody sane would stand up to that.)"
    Mi "(Algunos lo intentaron, pero sus cuerpos fueron encontrados al día siguiente - nadie se asentía ante eso.)"

# game/Story03.rpy:8457

translate spanish act3_5chapter3_ae401e9b:

    # Mi "(I wasn't an exception.)"
    Mi "(No era una excepción.)"

# game/Story03.rpy:8458

translate spanish act3_5chapter3_4a17bee1:

    # Mi "(Usually I would have gotten out with the data and forgotten it like a nightmare.)"
    Mi "(Usualmente habría salido con los datos y lo había olvidado como una pesadilla.)"

# game/Story03.rpy:8460

translate spanish act3_5chapter3_d340bd67:

    # Mi "(But that night, maybe from exhaustion, maybe from thinking about justice...)"
    Mi "(Pero esa noche, tal vez de agotamiento, tal vez de pensar en la justicia...)"

# game/Story03.rpy:8462

translate spanish act3_5chapter3_ce7d4800:

    # Mi "(I decided to take matters into my own hands.)"
    Mi "(Decidí tomar las cosas en mis propias manos.)"

# game/Story03.rpy:8465

translate spanish act3_5chapter3_6b047587:

    # "Hey, hey, what have you done? Stay where you are you freak—"
    "Oye, oye, ¿qué has hecho?"

# game/Story03.rpy:8482

translate spanish act3_5chapter3_d51ad37a:

    # Mi "(In the end, a dozen bodies marked the start of my path.)"
    Mi "(Al final, una docena de cuerpos marcaron el comienzo de mi camino.)"

# game/Story03.rpy:8486

translate spanish act3_5chapter3_25c88c0a:

    # Mi "(I sparked a massacre, a genocide of all those who treated elves badly.)"
    Mi "(Desperté una masacre, un genocidio de todos los que trataron mal a los elfos)."

# game/Story03.rpy:8487

translate spanish act3_5chapter3_4f712f9f:

    # Mi "(Became a serial killer.)"
    Mi "(He encontrado un asesino en serie)."

# game/Story03.rpy:8489

translate spanish act3_5chapter3_2e7ac9dd:

    # Mi "(It didn't take long before the search notices went up.)"
    Mi "(No fue mucho antes de que los anuncios de búsqueda se publicaran.)"

# game/Story03.rpy:8491

translate spanish act3_5chapter3_f7262037:

    # g "Did you find her?"
    g "¿La encontraste?"

# game/Story03.rpy:8492

translate spanish act3_5chapter3_dc20d975:

    # gg "No, she vanished like the ground swallowed her."
    gg "No, desapareció como si la tierra se la tragase."

# game/Story03.rpy:8494

translate spanish act3_5chapter3_ba0361a2:

    # g "Search! We can't let her go!"
    g "¡No podemos dejarla ir!"

# game/Story03.rpy:8496

translate spanish act3_5chapter3_c2c3e9d8:

    # gg "There! Grab that little bitch!"
    gg "¡Toma a esa perra!"

# game/Story03.rpy:8501

translate spanish act3_5chapter3_ec79dd04:

    # mc "(And the police?)"
    mc "(¿Y la policía?)"

# game/Story03.rpy:8502

translate spanish act3_5chapter3_aa8100b6:

    # Mi "(Ironically, the two men I killed at the start turned out to be police colonels.)"
    Mi "(Irónicamente, los dos hombres que maté al principio resultaron ser coroneles de la policía)."

# game/Story03.rpy:8505

translate spanish act3_5chapter3_b6a59562:

    # Mi "(Instead of protecting citizens... they were tormenting two missing elven girls.)"
    Mi "(En lugar de proteger a los ciudadanos... estaban atormentando a dos chicas elvenidas desaparecidas.)"

# game/Story03.rpy:8506

translate spanish act3_5chapter3_a46de91a:

    # g "Caught, don't—"
    g "¡Te tengo!"

# game/Story03.rpy:8525

translate spanish act3_5chapter3_b097a980:

    # Mi "(But there was another side: the abuse in our district dropped significantly.)"
    Mi "(Pero había otro lado: el abuso en nuestro distrito cayó significativamente.)"

# game/Story03.rpy:8526

translate spanish act3_5chapter3_8156c873:

    # Mi "(All it took was a couple hundred corpses. But the song didn't play long; once whispers of the Inquisition started...)"
    Mi "(Tomaba solo unos cientos de cadáveres, pero la canción no duró mucho, tan pronto como se rumoreaba la Inquisición)."

# game/Story03.rpy:8530

translate spanish act3_5chapter3_73696c46:

    # g "Executioner-3, Dome-1, requesting target data."
    g "Ejecutor-3, Dome-1, solicitando datos de destino."

# game/Story03.rpy:8531

translate spanish act3_5chapter3_e520448a:

    # "Dome-1 here. Redirecting termination data. Target — a Syndicate rat."
    "Dome-1 aquí. Redirección de datos de terminación. Meta — una rata sindicada."

# game/Story03.rpy:8532

translate spanish act3_5chapter3_bfb8ebcb:

    # g "Executioner-3, data received, end of transmission."
    g "Ejecutor-3, datos recibidos, final de transmisión."

# game/Story03.rpy:8534

translate spanish act3_5chapter3_4e00fa7c:

    # gg "The seal's broken, use-of-force authorization — activated."
    gg "El sello está roto, la autorización para usar la fuerza se activa."

# game/Story03.rpy:8535

translate spanish act3_5chapter3_dc09b32c:

    # g "7 minutes to landing."
    g "7 minutos para aterrizar."

# game/Story03.rpy:8538

translate spanish act3_5chapter3_21216a81:

    # gg "Objective: clear the Syndicate rats' hideout. Leave no one alive."
    gg "Propósito: para limpiar el refugio de ratas del sindicato, para no mantener a nadie vivo."

# game/Story03.rpy:8539

translate spanish act3_5chapter3_7bd50908:

    # k "Ugh, the Syndicate won't like that."
    k "Al Sindicato no le gustará esto."

# game/Story03.rpy:8540

translate spanish act3_5chapter3_07ae9f20:

    # gg "That's none of your concern, Kalestra."
    gg "No es asunto tuyo, Calestra."

# game/Story03.rpy:8541

translate spanish act3_5chapter3_25407fa9:

    # k "Sure, sure."
    k "Claro, claro."

# game/Story03.rpy:8546

translate spanish act3_5chapter3_3e04caa5:

    # gg "Commence execution."
    gg "Ejecución de la conducta."

# game/Story03.rpy:8547

translate spanish act3_5chapter3_2b4dbb82:

    # k "Well, time to have some fun."
    k "Bueno, es hora de divertirse."

# game/Story03.rpy:8551

translate spanish act3_5chapter3_7f983f09:

    # Mi "I had to go down to the Lower City, where light was a luxury and clean air a myth."
    Mi "Tuve que bajar a la Ciudad Baja, donde la luz era un lujo y un aire limpio un mito."

# game/Story03.rpy:8552

translate spanish act3_5chapter3_4d6fe7c0:

    # Mi "I stayed there for a few weeks. Thinking it would settle, but..."
    Mi "Me quedé allí unas semanas pensando que se arreglaría, pero..."

# game/Story03.rpy:8553

translate spanish act3_5chapter3_6dd8eee3:

    # Mi "(Whispering) Then everything only got worse..."
    Mi "Entonces todo se puso peor..."

# game/Story03.rpy:8555

translate spanish act3_5chapter3_e61b4e3c:

    # Mi "I've done too much to live a normal life after that."
    Mi "He hecho demasiado para vivir una vida normal después de eso."

# game/Story03.rpy:8556

translate spanish act3_5chapter3_cf355909:

    # Mi "Deciding it was time to end it all."
    Mi "Decidir que era hora de terminarlo todo."

# game/Story03.rpy:8558

translate spanish act3_5chapter3_388a70d3:

    # Mi "But then I met her."
    Mi "Pero luego la conocí."

# game/Story03.rpy:8561

translate spanish act3_5chapter3_b74122d5:

    # scar "Do you want to die? Fine. But be honest — you already died down there."
    scar "¿Quieres morir? Bien. Pero sé honesto, ya has muerto ahí abajo."

# game/Story03.rpy:8562

translate spanish act3_5chapter3_2eb7a581:

    # scar "Here you're only finishing off what's left."
    scar "Acabas de terminar lo que queda."

# game/Story03.rpy:8564

translate spanish act3_5chapter3_4caa0975:

    # scar "Maybe I can offer you something else?"
    scar "¿Quizás pueda ofrecerte algo más?"

# game/Story03.rpy:8566

translate spanish act3_5chapter3_da3fdbf1_3:

    # Mi "..."
    Mi "..."

# game/Story03.rpy:8571

translate spanish act3_5chapter3_6f46d5c5:

    # mc "What happened after that?"
    mc "¿Qué pasó después de eso?"

# game/Story03.rpy:8573

translate spanish act3_5chapter3_55735709:

    # Mi "And then..."
    Mi "Y luego..."

# game/Story03.rpy:8575

translate spanish act3_5chapter3_2b35b6fe_5:

    # mc "..."
    mc "..."

# game/Story03.rpy:8577

translate spanish act3_5chapter3_2ea261af:

    # Mi "I..."
    Mi "Yo..."

# game/Story03.rpy:8582

translate spanish act3_5chapter3_0cf4db38:

    # zo "Why did you bring her here?! Because of her they'll destroy us all!"
    zo "¿Por qué la trajiste aquí?"

# game/Story03.rpy:8583

translate spanish act3_5chapter3_361b35a6:

    # scar "They'd been planning this for a long time; she was only the pretext."
    scar "Lo planearon hace mucho tiempo, era una excusa."

# game/Story03.rpy:8585

translate spanish act3_5chapter3_a4c9ed56:

    # zo "What do they gain from this?! Killing the innocent for... what?!"
    zo "¿Qué ganan de esto?! Matar a los inocentes por... ¿Qué?"

# game/Story03.rpy:8586

translate spanish act3_5chapter3_49d226c2:

    # scar "I heard their Mistress, after losing her sister, became too cruel."
    scar "Oí que su señora, después de perder a su hermana, se volvió demasiado cruel."

# game/Story03.rpy:8588

translate spanish act3_5chapter3_d679bddf:

    # zo "And because of that, she decided to declare war on Ember?! She's gone mad!"
    zo "¿Y por eso decidió declarar la guerra contra Amber?"

# game/Story03.rpy:8589

translate spanish act3_5chapter3_ef1eeb0d:

    # scar "Maybe, but many believe she was the reason."
    scar "Quizás, pero muchos creen que ella era la razón."

# game/Story03.rpy:8594

translate spanish act3_5chapter3_c24b34e1:

    # Mi "I can't..."
    Mi "No puedo..."

# game/Story03.rpy:8597

translate spanish act3_5chapter3_a0c77ab2:

    # Mi "Because of her... I'll kill them all!"
    Mi "Por ella... ¡Los mataré a todos!"

# game/Story03.rpy:8599

translate spanish act3_5chapter3_fc0c3dfb:

    # scar "Stop — your death won't change anything. We're leaving."
    scar "Vamos, tu muerte no cambiará nada."

# game/Story03.rpy:8601

translate spanish act3_5chapter3_59b080d7:

    # zo "And what will we do? Hand her over and betray our principles."
    zo "¿Y qué haremos? Déjala pasar y traiciona nuestros principios."

# game/Story03.rpy:8602

translate spanish act3_5chapter3_1e135636:

    # scar "No. That's not up for discussion. We must find another way."
    scar "No, no es una pregunta, tenemos que encontrar otra salida."

# game/Story03.rpy:8604

translate spanish act3_5chapter3_fb8bf786:

    # zo "This is all because of you! You..."
    zo "¡Todo esto es por ti!"

# game/Story03.rpy:8605

translate spanish act3_5chapter3_fa4e8855:

    # zo "It would've been better if you'd never been here!"
    zo "¡Ojalá nunca hubieras estado aquí!"

# game/Story03.rpy:8608

translate spanish act3_5chapter3_75d4ca9b:

    # mc "(And... what am I supposed to do?)"
    mc "(Y... ¿qué se supone que debo hacer?)"

# game/Story03.rpy:8614

translate spanish act3_5chapter3_eeb1dfb9:

    # mc "(I can’t just walk away. Not after everything she’s done for me.)"
    mc "(No puedo simplemente alejarme. No después de todo lo que ha hecho por mí.)"

# game/Story03.rpy:8618

translate spanish act3_5chapter3_db079be0:

    # mc "(Sorry, Miriel... I can’t. I’m not the kind of guy who’s good at comforting anyone anyway.)"
    mc "(Lo siento, Miriel... no puedo. No soy el tipo de tipo que es bueno para consolar a cualquiera de todos modos.)"

# game/Story03.rpy:8620

translate spanish act3_5chapter3_11b1f5e8:

    # mc "I’m sorry."
    mc "Lo siento."

# game/Story03.rpy:8621

translate spanish act3_5chapter3_dcb142ec:

    # Mi "Huh? For what?"
    Mi "¿Para qué?"

# game/Story03.rpy:8623

translate spanish act3_5chapter3_26cd811b:

    # mc "You’ve been through hell... just felt like saying that."
    mc "Has pasado por el infierno... solo sentías que decías eso."

# game/Story03.rpy:8624

translate spanish act3_5chapter3_da3fdbf1_4:

    # Mi "..."
    Mi "..."

# game/Story03.rpy:8626

translate spanish act3_5chapter3_5bb6b13a:

    # Mi "...Thank you."
    Mi "...Gracias."

# game/Story03.rpy:8629

translate spanish act3_5chapter3_2725fb99:

    # i "Yo! Long time no see, Mir."
    i "¡Hace mucho que no lo ves, Mir!"

# game/Story03.rpy:8630

translate spanish act3_5chapter3_94983d76:

    # Mi "Ivy?! What are you doing here?"
    Mi "¿Qué haces aquí?"

# game/Story03.rpy:8631

translate spanish act3_5chapter3_e80f4d18:

    # i "Oh, don’t play dumb — you know why I’m here."
    i "Oh, no juegues tonto, ya sabes por qué estoy aquí."

# game/Story03.rpy:8632

translate spanish act3_5chapter3_8325a296:

    # i "Mind giving us a minute? I’ve got a few things to discuss with this guy."
    i "¿Te importa darnos un minuto? Tengo algunas cosas que discutir con este tipo."

# game/Story03.rpy:8633

translate spanish act3_5chapter3_da3fdbf1_5:

    # Mi "..."
    Mi "..."

# game/Story03.rpy:8634

translate spanish act3_5chapter3_a7995cad:

    # Mi "Make it quick."
    Mi "Hazlo rápido."

# game/Story03.rpy:8637

translate spanish act3_5chapter3_2b35b6fe_6:

    # mc "..."
    mc "..."

# game/Story03.rpy:8638

translate spanish act3_5chapter3_a6be913e:

    # mc "So?"
    mc "¿Y?"

# game/Story03.rpy:8640

translate spanish act3_5chapter3_059dfc55:

    # i "Nothing to say?"
    i "¿Nada que decir?"

# game/Story03.rpy:8642

translate spanish act3_5chapter3_27fe7123:

    # mc "Do we know each other?"
    mc "¿Nos conocemos?"

# game/Story03.rpy:8644

translate spanish act3_5chapter3_c09518ea:

    # i "Sort of — five days ago someone was beating an elf in the street. Remember?"
    i "Hace cinco días alguien golpeaba a un elfo en la calle. ¿Recuerdas?"

# game/Story03.rpy:8646

translate spanish act3_5chapter3_7ed632fa:

    # mc "Something like that. And?"
    mc "Algo así. ¿Y?"

# game/Story03.rpy:8648

translate spanish act3_5chapter3_cf5ff576:

    # i "I thought maybe someone among the rest could help."
    i "Pensé que alguien entre los demás podría ayudar."

# game/Story03.rpy:8651

translate spanish act3_5chapter3_7ca971c2:

    # mc "You want me to risk my life for someone I don’t even know?"
    mc "¿Quieres que arriesgue mi vida por alguien que ni siquiera conozco?"

# game/Story03.rpy:8654

translate spanish act3_5chapter3_a22f04dc:

    # i "Would you stand aside while your loved ones were beaten?"
    i "¿Podrías quedarte a un lado mientras tus seres queridos fueron golpeados?"

# game/Story03.rpy:8656

translate spanish act3_5chapter3_b3485305:

    # mc "Listen. Family, friends — sure, I’d step in. But a stranger?"
    mc "Familia, amigos, claro, me gustaría entrar. ¿Pero un extraño?"

# game/Story03.rpy:8658

translate spanish act3_5chapter3_43d01b39:

    # mc "That’s not courage, that’s recklessness. So cut the sermon and tell me why you’re here."
    mc "Eso no es coraje, eso es imprudencia. Así que corte el sermón y dime por qué estás aquí."

# game/Story03.rpy:8661

translate spanish act3_5chapter3_3e6a9159:

    # i "Unlike you, I'm ready to lend a hand."
    i "A diferencia de ti, estoy dispuesto a echar una mano."

# game/Story03.rpy:8665

translate spanish act3_5chapter3_2456491c:

    # mc "If we end up working together — fine. But keep your speeches short."
    mc "Si terminamos trabajando juntos —bien. Pero mantén tus discursos cortos."

# game/Story03.rpy:8671

translate spanish act3_5chapter3_1452b26e:

    # i "Good to see you again. Sorry to have interrupted."
    i "Me alegro de verte de nuevo."

# game/Story03.rpy:8673

translate spanish act3_5chapter3_5e9c6fb2:

    # mc "It’s fine. Don’t worry about it. But what brings you here?"
    mc "Está bien. No te preocupes por eso. ¿Pero qué te trae aquí?"

# game/Story03.rpy:8675

translate spanish act3_5chapter3_ca2f6229:

    # i "Oh, nothing serious. I just happened to overhear you two talking and got a little... curious, that’s all."
    i "No es nada serio. Acabo de escuchar a ustedes dos hablando y tengo un poco... curioso, eso es todo."

# game/Story03.rpy:8677

translate spanish act3_5chapter3_0b5aa7c4:

    # i "But I’ll admit, that was a surprise. Miriel—of all people—usually so cold and composed..."
    i "Pero lo admito, eso fue una sorpresa. Miriel -de todas las personas- por lo general tan fría y compuesta..."

# game/Story03.rpy:8678

translate spanish act3_5chapter3_90823c49:

    # i "She’s never been too fond of humans either. But with you... it’s different?"
    i "Ella nunca ha sido demasiado cariñosa con los humanos tampoco. Pero contigo... ¿es diferente?"

# game/Story03.rpy:8680

translate spanish act3_5chapter3_5189de1f:

    # mc "I’m not blind, I see it. Even I can’t figure out what she sees in me."
    mc "No soy ciego, lo veo. Incluso no puedo entender lo que ella ve en mí."

# game/Story03.rpy:8681

translate spanish act3_5chapter3_cbbd0add:

    # mc "Just an ordinary washed-up guy tossed into a world he doesn’t belong in."
    mc "Solo un tipo común lavado arrojó en un mundo en el que no pertenece."

# game/Story03.rpy:8682

translate spanish act3_5chapter3_c7e56c97:

    # mc "(Guess that’s on me too. Should’ve stayed home instead of chasing ghosts.)"
    mc "(La compañía que está en mí también. Debió haber permanecido en casa en lugar de perseguir fantasmas.)"

# game/Story03.rpy:8685

translate spanish act3_5chapter3_bfea8df2:

    # i "You’re not that bad yourself. Deep down, there’s more to you than you let on. After all, you’re the one who saved me."
    i "No eres tan malo. En el fondo, hay más que lo que dejas. Después de todo, eres tú quien me salvó."

# game/Story03.rpy:8686

translate spanish act3_5chapter3_08197b7d:

    # mc "...Couldn’t just walk away."
    mc "...No podría simplemente irse."

# game/Story03.rpy:8689

translate spanish act3_5chapter3_b9ac1da0:

    # i "Exactly! That’s what I mean. We elves see what’s inside a person—that’s why she reacted that way."
    i "¡Exactamente! Eso es lo que quiero decir. Nosotros los elfos vemos lo que hay dentro de una persona, por eso reaccionó de esa manera."

# game/Story03.rpy:8691

translate spanish act3_5chapter3_6f3d4875:

    # i "..."
    i "..."

# game/Story03.rpy:8692

translate spanish act3_5chapter3_2b35b6fe_7:

    # mc "..."
    mc "..."

# game/Story03.rpy:8693

translate spanish act3_5chapter3_0d8c9159:

    # mc "So? That all, or you got another speech lined up?"
    mc "¿Eso es todo, o tienes otro discurso alineado?"

# game/Story03.rpy:8695

translate spanish act3_5chapter3_ecdd24b7:

    # i "There was another, but... I forgot it."
    i "Había otro, pero... lo olvidé."

# game/Story03.rpy:8697

translate spanish act3_5chapter3_2b35b6fe_8:

    # mc "..."
    mc "..."

# game/Story03.rpy:8698

translate spanish act3_5chapter3_9d9b865d:

    # mc "Liar."
    mc "Mentiroso."

# game/Story03.rpy:8700

translate spanish act3_5chapter3_869f6da2:

    # i "Maybe. Well, come on, we'll still have time alone later."
    i "Bueno, vamos, tendremos más tiempo para estar solos más tarde."

# game/Story03.rpy:8702

translate spanish act3_5chapter3_d13a3a1c:

    # mc "If you insist."
    mc "Si insistes."

# game/Story03.rpy:8703

translate spanish act3_5chapter3_bc672062:

    # i "Hee-hee."
    i "Hee-hee."

# game/Story03.rpy:8709

translate spanish act3_5chapter3_03798924:

    # Mi "I don't want you to see me like this."
    Mi "No quiero que me veas así."

# game/Story03.rpy:8711

translate spanish act3_5chapter3_06cff204:

    # mc "(She’s keeping her walls up… but she hasn’t walked away either.)"
    mc "(Ella mantiene sus paredes arriba... pero ella tampoco se ha marchado.)"

# game/Story03.rpy:8714

translate spanish act3_5chapter3_ea4b642a:

    # mc "(If I push, I’ll scare her off. If I freeze, I’ll lose her. Got to find the balance.)"
    mc "(Si empujo, la asustaré. Si me congelo, la perderé. Tengo que encontrar el equilibrio.)"

# game/Story03.rpy:8723

translate spanish act3_5chapter3_da3fdbf1_6:

    # Mi "..."
    Mi "..."

# game/Story03.rpy:8724

translate spanish act3_5chapter3_e4ece9ee:

    # Mi "(A warm palm... It doesn't press, doesn't force. It just... supports.)"
    Mi "No empuja, no fuerza."

# game/Story03.rpy:8726

translate spanish act3_5chapter3_b98e3a9f:

    # Mi "(When was the last time someone touched me so gently?..)"
    Mi "(¿Cuándo fue la última vez que alguien me tocó tan suavemente?.)"

# game/Story03.rpy:8729

translate spanish act3_5chapter3_f84b2bbe:

    # Mi "...I don't know if I deserve such softness."
    Mi "No sé si merezco tal ternura."

# game/Story03.rpy:8731

translate spanish act3_5chapter3_92533c9a:

    # mc "You don’t have to earn kindness, Miriel. It’s yours already."
    mc "No tienes que ganar bondad, Miriel. Ya es tuya."

