translate spanish akt3chapter1_3_9eae57c5:

    # L "(After all these years... After all the pain I put him through.)"
    L "(Después de todos estos años... Después de todo el dolor que le hice pasar.)"

# game/Story03.rpy:1262
translate spanish akt3chapter1_3_cc609dc2:

    # L "...Yes, darling."
    L "...Sí, cariño."

# game/Story03.rpy:1275
translate spanish akt3chapter1_3_1c5ea56d:

    # "Still chuckling softly, Lora steps into the bathroom, though the nervousness in her eyes betrays her."
