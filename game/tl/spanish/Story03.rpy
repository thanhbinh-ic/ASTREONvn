# game/Story03.rpy:1295
translate spanish akt3chapter1_3_4c7a4d42:

    # L "(Don’t you dare start crying now.)"
    L "(Ni se te ocurra empezar a llorar ahora.)"

# game/Story03.rpy:1296
translate spanish akt3chapter1_3_59d88f6f:

    # L "You look wonderful too, darling!"
    L "¡Tú también te ves maravilloso, cariño!"

# game/Story03.rpy:1298
translate spanish akt3chapter1_3_f819780b:

    # "Her gaze lingers on him, catching even the slightest tremble that runs through his body."
    "Su mirada se queda en él, captando hasta el menor temblor que recorre su cuerpo."

# game/Story03.rpy:1299
translate spanish akt3chapter1_3_ec57dba5:

    # mc "You're not exactly being subtle."
    mc "No estás siendo precisamente discreta."

# game/Story03.rpy:1300
translate spanish akt3chapter1_3_b2916647:

    # L "I’m just... gathering my thoughts!"
    L "¡Solo estoy... ordenando mis pensamientos!"

# game/Story03.rpy:1301
translate spanish akt3chapter1_3_7e113fd4:

    # mc "You're trembling..."
    mc "Estás temblando..."

# game/Story03.rpy:1302
translate spanish akt3chapter1_3_6880bbf6:

    # L "Because I can hardly wait to feel your warmth again."
    L "Porque apenas puedo esperar para sentir otra vez tu calor."

# game/Story03.rpy:1303
translate spanish akt3chapter1_3_491c16b4:

    # mc "(Is that really all it is...?)"
    mc "(¿De verdad es solo eso...?)"

# game/Story03.rpy:1304
translate spanish akt3chapter1_3_0297642d:

    # mc "Lora?"
    mc "¿Lora?"

# game/Story03.rpy:1305
translate spanish akt3chapter1_3_aca3d56e:

    # L "(...You still see right through me.)"
    L "(...Sigues viendo a través de mí.)"

# game/Story03.rpy:1307
translate spanish akt3chapter1_3_c077cf16:

    # L "I don’t know what I’m supposed to do..."
    L "No sé qué se supone que debo hacer..."

# game/Story03.rpy:1308
translate spanish akt3chapter1_3_0d58cd1b:

    # L "Part of me wants to tell you everything..."
    L "Una parte de mí quiere contártelo todo..."

# game/Story03.rpy:1309
translate spanish akt3chapter1_3_229909a7:

    # L "To finally unload this burden, but..."
    L "Por fin soltar esta carga, pero..."

# game/Story03.rpy:1314
translate spanish akt3chapter1_3_4d36b383:

    # L "...I’m afraid."
    L "...Tengo miedo."

# game/Story03.rpy:1315
translate spanish akt3chapter1_3_b0d960ef:

    # "A sudden shiver courses through her, leaving her entire body trembling with anticipation."
    "Un escalofrío repentino la recorre, dejando todo su cuerpo temblando de expectación."

# game/Story03.rpy:1316
translate spanish akt3chapter1_3_0d42a7db:

    # L "I only... wanted to protect you."
    L "Solo... quería protegerte."

# game/Story03.rpy:1317
translate spanish akt3chapter1_3_d0eb9b98:

    # L "(But I watched you die again and again. Olivia, Norman, Mina... Everyone I ever loved...)"
    L "(Pero te vi morir una y otra vez. Olivia, Norman, Mina... Todos los que alguna vez amé...)"

# game/Story03.rpy:1322
translate spanish akt3chapter1_3_1f47fd15:

    # L "Aren’t you going to say anything?"
    L "¿No vas a decir nada?"

# game/Story03.rpy:1324
translate spanish akt3chapter1_3_c26e09b2:

    # "An uneasy silence hangs between them, heavy with everything neither of them dares to say."
    "Un silencio incómodo queda suspendido entre ellos, cargado con todo lo que ninguno se atreve a decir."

# game/Story03.rpy:1325
translate spanish akt3chapter1_3_6a2650f0:

    # mc "Just one thing."
    mc "Solo una cosa."

# game/Story03.rpy:1327
translate spanish akt3chapter1_3_c8da87b8:

    # mc "You did well, darling."
    mc "Lo hiciste bien, cariño."

# game/Story03.rpy:1330
translate spanish akt3chapter1_3_bd7a2aaa:

    # L "(You’re so...)"
    L "(Eres tan...)"

# game/Story03.rpy:1331
translate spanish akt3chapter1_3_53ddaa57:

    # L "(One word. Just one word from you, and I’m already floating somewhere beyond the seventh heaven.)"
    L "(Una palabra. Una sola palabra tuya, y ya estoy flotando más allá del séptimo cielo.)"

# game/Story03.rpy:1333
translate spanish akt3chapter1_3_46bb05a5:

    # L "(Whispering) I love you."
    L "(Susurrando) Te amo."

# game/Story03.rpy:1334
translate spanish akt3chapter1_3_57a17647:

    # L "God, how I love you!"
    L "¡Dios, cuánto te amo!"

# game/Story03.rpy:1335
translate spanish akt3chapter1_3_cc8b0c23:

    # mc "I love you too, darling."
    mc "Yo también te amo, cariño."

# game/Story03.rpy:1336
translate spanish akt3chapter1_3_58f8288f:

    # "Slowly, he closes the distance between them."
    "Lentamente, él acorta la distancia entre los dos."

# game/Story03.rpy:1345
translate spanish akt3chapter1_3_4ab33ecf:

    # "He slips inside her with surprising ease, drawing a sharp breath from her lips."
    "Él se desliza dentro de ella con sorprendente facilidad, arrancándole una inspiración brusca."

# game/Story03.rpy:1346
translate spanish akt3chapter1_3_31486bd5:

    # mc "(S-she's still so tight...)"
    mc "(S-sigue estando tan apretada...)"

# game/Story03.rpy:1347
translate spanish akt3chapter1_3_2afafb99:

    # mc "How I've missed you..."
    mc "Cuánto te he extrañado..."

# game/Story03.rpy:1348
translate spanish akt3chapter1_3_a9f3b983:

    # mc "All those years... all that pain..."
    mc "Todos esos años... todo ese dolor..."

# game/Story03.rpy:1349
translate spanish akt3chapter1_3_d0a8201d:

    # mc "And now, finally... you're here."
    mc "Y ahora, por fin... estás aquí."

# game/Story03.rpy:1350
translate spanish akt3chapter1_3_08e8d7ff:

    # "His grip around her tightens, holding her even closer."
    "Él la rodea con más fuerza, acercándola todavía más."

# game/Story03.rpy:1351
translate spanish akt3chapter1_3_e8c7f7d0:

    # mc "I thought I'd lose my mind without you..."
    mc "Pensé que perdería la cabeza sin ti..."

# game/Story03.rpy:1352
translate spanish akt3chapter1_3_7d055bd1:

    # "Trying to hold back her moans, she struggles to force out a few words."
    "Intentando contener sus gemidos, ella se esfuerza por sacar unas pocas palabras."

# game/Story03.rpy:1353
translate spanish akt3chapter1_3_aa36d20f:

    # L "(It feels so good... The way he pulses inside me... the way he moves...)"
    L "(Se siente tan bien... Cómo palpita dentro de mí... cómo se mueve...)"

# game/Story03.rpy:1354
translate spanish akt3chapter1_3_7ce91a20:

    # L "(I don’t want to let him go ever again... Never.)"
    L "(No quiero volver a soltarlo nunca más... Nunca.)"

# game/Story03.rpy:1355
translate spanish akt3chapter1_3_d33e1e32:

    # L "What do you... feel?"
    L "¿Qué... sientes?"

# game/Story03.rpy:1356
translate spanish akt3chapter1_3_5d97ce09:

    # "Her hips begin to sway beneath him, slowly searching for the rhythm."
    "Sus caderas empiezan a moverse bajo él, buscando lentamente el ritmo."

# game/Story03.rpy:1357
translate spanish akt3chapter1_3_a5035d65:

    # L "Do you like it?"
    L "¿Te gusta?"

# game/Story03.rpy:1358
translate spanish akt3chapter1_3_1ab8fec7:

    # mc "You have no idea..."
    mc "No tienes idea..."

# game/Story03.rpy:1359
translate spanish akt3chapter1_3_fbdbccaa:

    # mc "And from the sound of it, I'm not the only one enjoying this."
    mc "Y por cómo suena, no soy el único que lo está disfrutando."

# game/Story03.rpy:1360
translate spanish akt3chapter1_3_f9c20ee8:

    # mc "The way your body answers me... those soft moans..."
    mc "La forma en que tu cuerpo me responde... esos gemidos suaves..."

# game/Story03.rpy:1361
translate spanish akt3chapter1_3_16701aa5:

    # mc "They tell me everything."
    mc "Me lo dicen todo."

# game/Story03.rpy:1362
translate spanish akt3chapter1_3_fe85b438:

    # mc "Don't hold back."
    mc "No te contengas."

# game/Story03.rpy:1363
translate spanish akt3chapter1_3_feb2a0d4:

    # L "I-I just didn’t want anyone to hear us."
    L "S-solo no quería que nadie nos oyera."

# game/Story03.rpy:1364
translate spanish akt3chapter1_3_14c80f49:

    # L "...I still have to look Olivia in the eye after this."
    L "...Después de esto todavía tengo que mirar a Olivia a los ojos."

# game/Story03.rpy:1365
translate spanish akt3chapter1_3_440569aa:

    # mc "Thinking about someone else while you're with me?"
    mc "¿Pensando en otra persona mientras estás conmigo?"

# game/Story03.rpy:1366
translate spanish akt3chapter1_3_3ee90cce:

    # "With one shallow thrust, he brushes against a particularly sensitive spot."
    "Con una embestida superficial, él roza un punto especialmente sensible."

# game/Story03.rpy:1367
translate spanish akt3chapter1_3_57fe6bbe:

    # L "AAAHH~!"
    L "¡AAAHH~!"

# game/Story03.rpy:1368
translate spanish akt3chapter1_3_b2712df8:

    # "As though something inside her finally breaks free, her moans burst from her all at once, filling the entire room."
    "Como si algo dentro de ella por fin se liberara, sus gemidos brotan de golpe y llenan toda la habitación."

# game/Story03.rpy:1369
translate spanish akt3chapter1_3_d084198a:

    # L "AAAHHHHH~~"
    L "¡¡AAAHHHHH~~"

# game/Story03.rpy:1370
translate spanish akt3chapter1_3_a3f291a9:

    # L "Th-that was dirty!"
    L "¡E-eso fue sucio!"

# game/Story03.rpy:1371
translate spanish akt3chapter1_3_9a1af37f:

    # mc "But you liked it."
    mc "Pero te gustó."

# game/Story03.rpy:1372
translate spanish akt3chapter1_3_91b08b90:

    # L "...Very much."
    L "...Mucho."

# game/Story03.rpy:1373
translate spanish akt3chapter1_3_854d721b:

    # L "But you know, darling... two can play that game."
    L "Pero sabes, cariño... dos pueden jugar a ese juego."

# game/Story03.rpy:1374
translate spanish akt3chapter1_3_4e1ce326:

    # mc "(Finally got her out of her own head...)"
    mc "(Por fin conseguí sacarla de sus propios pensamientos...)"

# game/Story03.rpy:1375
translate spanish akt3chapter1_3_31b71794:

    # mc "(Though I may have pushed her a little too far—)"
    mc "(Aunque quizá la presioné un poco demasiado—)"

# game/Story03.rpy:1380
translate spanish akt3chapter1_3_c19e94ae:

    # "She tightens around him with every movement, each thrust drawing an even firmer embrace from her body."
    "Ella se contrae alrededor de él con cada movimiento, y cada embestida arranca de su cuerpo un abrazo aún más firme."

# game/Story03.rpy:1381
translate spanish akt3chapter1_3_f676b064:

    # mc "Ah... easy, darling."
    mc "Ah... tranquila, cariño."

# game/Story03.rpy:1382
translate spanish akt3chapter1_3_ac16b286:

    # mc "Loosen your grip a little."
    mc "Afloja un poco."

# game/Story03.rpy:1383
translate spanish akt3chapter1_3_3b5f1dc8:

    # L "Mmm... I don’t want to let go, darling."
    L "Mmm... No quiero soltarte, cariño."

# game/Story03.rpy:1384
translate spanish akt3chapter1_3_f9fb58b8:

    # L "Besides... I know how good it feels."
    L "Además... sé lo bien que se siente."

# game/Story03.rpy:1385
translate spanish akt3chapter1_3_4f259fe8:

    # mc "At this rate, I won't last much longer."
    mc "A este ritmo, no aguantaré mucho más."

# game/Story03.rpy:1386
translate spanish akt3chapter1_3_85c07bec:

    # "She leans closer, her warm breath brushing against [mc]'s ear."
    "Ella se inclina más cerca, y su cálido aliento roza el oído de [mc]."

# game/Story03.rpy:1387
translate spanish akt3chapter1_3_a49ff1a8:

    # L "(Whispering) Then fill me to the brim."
    L "(Susurrando) Entonces lléname por completo."

# game/Story03.rpy:1388
translate spanish akt3chapter1_3_0eec09e7:

    # L "(Whispering) We’ve always wanted a baby... haven’t we?"
    L "(Susurrando) Siempre quisimos un bebé... ¿verdad?"

# game/Story03.rpy:1389
translate spanish akt3chapter1_3_19a399e8:

    # mc "Y-you fight dirty..."
    mc "J-juegas sucio..."

# game/Story03.rpy:1390
translate spanish akt3chapter1_3_443e4361:

    # "A strained groan slips through [mc]'s clenched teeth."
    "Un gemido tenso se escapa entre los dientes apretados de [mc]."

# game/Story03.rpy:1391
translate spanish akt3chapter1_3_97693948:

    # mc "You know we were never able to—"
    mc "Sabes que nunca pudimos—"

# game/Story03.rpy:1392
translate spanish akt3chapter1_3_b914915f:

    # L "Exactly. So don’t you dare deny yourself now."
    L "Exacto. Así que ni se te ocurra negártelo ahora."

# game/Story03.rpy:1393
translate spanish akt3chapter1_3_d7bc00ca:

    # L "We are... husband and wife, after all."
    L "Somos... marido y mujer, después de todo."

# game/Story03.rpy:1394
translate spanish akt3chapter1_3_e644badd:

    # mc "You asked for it!"
    mc "¡Tú lo pediste!"

# game/Story03.rpy:1395
translate spanish akt3chapter1_3_e0579cc1:

    # L "(So warm...)"
    L "(Tan cálido...)"

# game/Story03.rpy:1396
translate spanish akt3chapter1_3_d9f51f93:

    # L "(If only... we hadn’t been infertile, perhaps...)"
    L "(Si tan solo... no hubiéramos sido infértiles, quizá...)"

# game/Story03.rpy:1397
translate spanish akt3chapter1_3_0daeb492:

    # L "(Perhaps our entire life would’ve turned out differently.)"
    L "(Quizá toda nuestra vida habría sido distinta.)"

# game/Story03.rpy:1398
translate spanish akt3chapter1_3_30c59968:

    # mc "Darling—!"
    mc "¡Cariño—!"

# game/Story03.rpy:1434
translate spanish akt3chapter1_3_cbbfcb71:

    # mc "(Back in the shower...)"
    mc "(Antes, en la ducha...)"

# game/Story03.rpy:1435
translate spanish akt3chapter1_3_41ef7a77:

    # mc "(She said something about protecting me.)"
    mc "(Dijo algo sobre protegerme.)"

# game/Story03.rpy:1436
translate spanish akt3chapter1_3_c862da63:

    # mc "(But from what? Or who?)"
    mc "(¿Pero de qué? ¿O de quién?)"

# game/Story03.rpy:1437
translate spanish akt3chapter1_3_25be60e8:

    # L "Tell me, darling... Is something troubling you?"
    L "Dime, cariño... ¿Hay algo que te preocupe?"

# game/Story03.rpy:1439
translate spanish akt3chapter1_3_f87e56a4:

    # L "Although... what a foolish question."
    L "Aunque... qué pregunta tan tonta."

# game/Story03.rpy:1440
translate spanish akt3chapter1_3_f795c40a:

    # L "Of course something is. The only question is what."
    L "Claro que hay algo. La única pregunta es qué."

# game/Story03.rpy:1441
translate spanish akt3chapter1_3_6a2650f0_1:

    # mc "Just one thing."
    mc "Solo una cosa."

# game/Story03.rpy:1442
translate spanish akt3chapter1_3_c09b6015:

    # mc "What happened to you?"
    mc "¿Qué te pasó?"

# game/Story03.rpy:1444
translate spanish akt3chapter1_3_7f3fc9d8:

    # L "I’m afraid I can’t tell you that yet."
    L "Me temo que todavía no puedo contarte eso."

# game/Story03.rpy:1445
translate spanish akt3chapter1_3_c61200ad:

    # L "I’m doing this to protect you."
    L "Estoy haciendo esto para protegerte."

# game/Story03.rpy:1446
translate spanish akt3chapter1_3_93a9b2a0:

    # mc "Lor—"
    mc "Lor—"

# game/Story03.rpy:1447
translate spanish akt3chapter1_3_47c485c3:

    # L "And before you start pressing me, if I told you the truth now, then, let us say..."
    L "Y antes de que empieces a presionarme, si te dijera la verdad ahora, digamos que..."

# game/Story03.rpy:1448
translate spanish akt3chapter1_3_be86c20b:

    # L "I would only hasten the inevitable."
    L "Solo aceleraría lo inevitable."

# game/Story03.rpy:1450
translate spanish akt3chapter1_3_0048c5e5:

    # L "And I... would rather remain in this moment a little longer..."
    L "Y yo... preferiría quedarme en este momento un poco más..."

# game/Story03.rpy:1451
translate spanish akt3chapter1_3_b9ec6ea2:

    # L "(For the first time in twenty deaths, I found you again... My darling...)"
    L "(Por primera vez en veinte muertes, volví a encontrarte... Mi amor...)"

# game/Story03.rpy:1452
translate spanish akt3chapter1_3_252c524a:

    # mc "But I need to—"
    mc "Pero necesito—"

# game/Story03.rpy:1453
translate spanish akt3chapter1_3_8f55d119:

    # L "It would break you..."
    L "Te rompería..."

# game/Story03.rpy:1454
translate spanish akt3chapter1_3_18b8e1a5:

    # mc "Lora, you know I'm stronger than I look."
    mc "Lora, sabes que soy más fuerte de lo que parezco."

# game/Story03.rpy:1455
translate spanish akt3chapter1_3_cac99607:

    # L "(Whispering) ...But you haven’t died yet."
    L "(Susurrando) ...Pero aún no has muerto."

# game/Story03.rpy:1457
translate spanish akt3chapter1_3_a97668c8:

    # "She throws herself into [mc]'s arms."
    "Ella se lanza a los brazos de [mc]."

# game/Story03.rpy:1459
translate spanish akt3chapter1_3_110d9398:

    # mc "Alright... if you won't tell me, so be it."
    mc "Está bien... si no vas a decírmelo, que así sea."

# game/Story03.rpy:1460
translate spanish akt3chapter1_3_2a59240e:

    # mc "That's what I'd like to say."
    mc "Eso es lo que me gustaría decir."

# game/Story03.rpy:1461
translate spanish akt3chapter1_3_ed24910c:

    # mc "But I need something, darling. Anything you can give me."
    mc "Pero necesito algo, cariño. Cualquier cosa que puedas darme."

# game/Story03.rpy:1462
translate spanish akt3chapter1_3_2ea66e78:

    # mc "You say you wanted to protect me... But all you did was leave me helpless."
    mc "Dices que querías protegerme... pero lo único que hiciste fue dejarme indefenso."

# game/Story03.rpy:1464
translate spanish akt3chapter1_3_04ead3c0:

    # L "...That isn’t the problem, darling."
    L "...Ese no es el problema, cariño."

# game/Story03.rpy:1465
translate spanish akt3chapter1_3_c3a41dff:

    # L "The problem is that even if you knew the whole truth, you still couldn’t change anything."
    L "El problema es que, aunque supieras toda la verdad, aun así no podrías cambiar nada."

# game/Story03.rpy:1467
translate spanish akt3chapter1_3_c9742425:

    # mc "...That's a bleak way of looking at it."
    mc "...Es una forma bastante sombría de verlo."

# game/Story03.rpy:1468
translate spanish akt3chapter1_3_d27efc64:

    # mc "There has to be a way out."
    mc "Tiene que haber una salida."

# game/Story03.rpy:1469
translate spanish akt3chapter1_3_fdfc520b:

    # mc "I'm sure of it."
    mc "Estoy seguro."

# game/Story03.rpy:1471
translate spanish akt3chapter1_3_a190e728:

    # L "A way out..."
    L "Una salida..."

# game/Story03.rpy:1472
translate spanish akt3chapter1_3_811fac5a:

    # L "There were references to Gates in the ruins beyond the walls."
    L "Había referencias a portales en las ruinas más allá de las murallas."

# game/Story03.rpy:1474
translate spanish akt3chapter1_3_4cf22874:

    # mc "Gates?"
    mc "¿Portales?"

# game/Story03.rpy:1475
translate spanish akt3chapter1_3_4b29455c:

    # mc "The same kind that exploded a few moments ago?"
    mc "¿Del mismo tipo que explotó hace unos momentos?"

# game/Story03.rpy:1477
translate spanish akt3chapter1_3_1cfdca51:

    # L "...I haven’t had the chance to enter one myself."
    L "...Yo misma aún no he tenido oportunidad de entrar en uno."

# game/Story03.rpy:1478
translate spanish akt3chapter1_3_7ab689cc:

    # L "But Astoria has a plan that might change that."
    L "Pero Astoria tiene un plan que podría cambiar eso."

# game/Story03.rpy:1480
translate spanish akt3chapter1_3_45f71878:

    # mc "So those gates are our way out?"
    mc "¿Así que esos portales son nuestra salida?"

# game/Story03.rpy:1484
translate spanish akt3chapter1_3_18e14eba:

    # L "I don’t know where they lead, but... they’re the only possibility we haven’t exhausted yet."
    L "No sé adónde llevan, pero... son la única posibilidad que aún no hemos agotado."

# game/Story03.rpy:1486
translate spanish akt3chapter1_3_45407191:

    # mc "...Sounds promising."
    mc "...Suena prometedor."

# game/Story03.rpy:1487
translate spanish akt3chapter1_3_7f31e1bc:

    # mc "But if it were that simple, you wouldn't be trying so hard to hide it from me."
    mc "Pero si fuera tan sencillo, no te esforzarías tanto por ocultármelo."

# game/Story03.rpy:1488
translate spanish akt3chapter1_3_876dfb39:

    # mc "What's the catch?"
    mc "¿Dónde está la trampa?"

# game/Story03.rpy:1493
translate spanish akt3chapter1_3_01adfc13:

    # L "Stay like this a little longer."
    L "Quédate así un poco más."

# game/Story03.rpy:1499
translate spanish akt3chapter1_3_9993b94e_11:

    # L "..."
    L "..."

# game/Story03.rpy:1500
translate spanish akt3chapter1_3_2012380b:

    # L "Because..."
    L "Porque..."

# game/Story03.rpy:1636
translate spanish akt3chapter1_3_18161244:

    # L "Let me put it simply."
    L "Déjame decirlo de forma sencilla."

# game/Story03.rpy:1637
translate spanish akt3chapter1_3_a3c58b04:

    # L "The Abyss isn’t a place."
    L "El Abismo no es un lugar."

# game/Story03.rpy:1638
translate spanish akt3chapter1_3_6766d41f:

    # L "It’s what the gates tear open."
    L "Es lo que los portales desgarran al abrirse."

# game/Story03.rpy:1640
translate spanish akt3chapter1_3_8db017d5:

    # L "And I can survive inside it."
    L "Y yo puedo sobrevivir dentro de él."

# game/Story03.rpy:1644
translate spanish akt3chapter1_3_a2b34481:

    # mc "That’s why they’re hunting you."
    mc "Por eso te están cazando."

# game/Story03.rpy:1646
translate spanish akt3chapter1_3_109280b3:

    # L "Yes."
    L "Sí."

# game/Story03.rpy:1647
translate spanish akt3chapter1_3_36e8449b:

    # L "Not because they want me dead."
    L "No porque me quieran muerta."

# game/Story03.rpy:1648
translate spanish akt3chapter1_3_5bfded4b:

    # L "Because they want what I know."
    L "Sino porque quieren lo que sé."

# game/Story03.rpy:1651
translate spanish akt3chapter1_3_73856d49:

    # mc "(The Abyss... She says it like it’s just part of her daily life...)"
    mc "(El Abismo... Lo dice como si fuera una parte más de su vida diaria...)"

# game/Story03.rpy:1710
translate spanish akt3chapter1_4_18161244:

    # L "Let me put it simply."
    L "Déjame decirlo de forma sencilla."

# game/Story03.rpy:1711
translate spanish akt3chapter1_4_a3c58b04:

    # L "The Abyss isn’t a place."
    L "El Abismo no es un lugar."

# game/Story03.rpy:1712
translate spanish akt3chapter1_4_6766d41f:

    # L "It’s what the gates tear open."
    L "Es lo que los portales desgarran al abrirse."

# game/Story03.rpy:1714
translate spanish akt3chapter1_4_8db017d5:

    # L "And I can survive inside it."
    L "Y yo puedo sobrevivir dentro de él."

# game/Story03.rpy:1718
translate spanish akt3chapter1_4_a2b34481:

    # mc "That’s why they’re hunting you."
    mc "Por eso te están cazando."

# game/Story03.rpy:1720
translate spanish akt3chapter1_4_109280b3:

    # L "Yes."
    L "Sí."

# game/Story03.rpy:1721
translate spanish akt3chapter1_4_36e8449b:

    # L "Not because they want me dead."
    L "No porque me quieran muerta."

# game/Story03.rpy:1722
translate spanish akt3chapter1_4_5bfded4b:

    # L "Because they want what I know."
    L "Sino porque quieren lo que sé."

# game/Story03.rpy:1815
translate spanish akt3chapter2_577c5298:

    # aa "Not the gates."
    aa "No los portales."

# game/Story03.rpy:1817
translate spanish akt3chapter2_52f842db:

    # aa "What waits behind them."
    aa "Lo que espera detrás de ellos."

# game/Story03.rpy:1818
translate spanish akt3chapter2_e8404196:

    # mc "...The Abyss?"
    mc "...¿El Abismo?"

# game/Story03.rpy:1847
translate spanish akt3chapter2_46f16f1d:

    # R "Not enough energy to open the gate."
    R "No hay energía suficiente para abrir el portal."

# game/Story03.rpy:2466
translate spanish akt3chapter2_1_6553e5d6:

    # mc "(Lora and Olivia are in Sector Three. Alive. For now.)"
    mc "(Lora y Olivia están en el Sector Tres. Vivas. Por ahora.)"

# game/Story03.rpy:2467
translate spanish akt3chapter2_1_d0ea411e:

    # mc "(But if the Peacekeepers fall, no one holds the line around the Tower.)"
    mc "(Pero si caen los Pacificadores, nadie sostendrá la línea alrededor de la Torre.)"

# game/Story03.rpy:2469
translate spanish akt3chapter2_1_eb5d2e69:

    # mc "(Then Lower City, Sector Three, everyone... gone.)"
    mc "(Entonces la Ciudad Baja, el Sector Tres, todos... desaparecerán.)"

# game/Story03.rpy:2470
translate spanish akt3chapter2_1_04e429bb:

    # mc "(So first, the Peacekeepers. Then I get back to them.)"
    mc "(Así que primero, los Pacificadores. Luego vuelvo con ellas.)"

# game/Story03.rpy:3191
translate spanish akt3chapter3_f4cc7e48:

    # a "You saw the gate open. But you never asked what they opened on."
    a "Viste abrirse el portal. Pero nunca preguntaste hacia qué se abrían."

# game/Story03.rpy:4026
translate spanish akt3chapter3_2_030d78f5:

    # Mi "But it only holds a route once someone sets it manually."
    Mi "Pero solo mantiene una ruta cuando alguien la configura manualmente."

# game/Story03.rpy:4027
translate spanish akt3chapter3_2_cce2f0e1:

    # Mi "It couldn't have launched us. Not from that bay. Not under fire."
    Mi "No pudo habernos lanzado. No desde esa bahía. No bajo fuego."

# game/Story03.rpy:4480
translate spanish akt3chapter3_4_9fc136e2:

    # Mi "(That’s... a gate to the Abyss?!)"
    Mi "(Eso es... ¿un portal al Abismo?!)"

# game/Story03.rpy:4555
translate spanish akt3chapter3_4_495a65f1:

    # Mi "You almost killed us all!"
    Mi "¡Casi nos matas a todos!"

# game/Story03.rpy:4595
translate spanish akt3chapter3_4_144ab5eb:

    # Mi "An unstable breach."
    Mi "Una brecha inestable."

# game/Story03.rpy:4596
translate spanish akt3chapter3_4_0c158b40:

    # Mi "One mistake, and half the bay gets scattered into the Abyss."
    Mi "Un error, y media bahía queda dispersa en el Abismo."

# game/Story03.rpy:4597
translate spanish akt3chapter3_4_99c07510:

    # a "We survived because it was short."
    a "Sobrevivimos porque duró poco."

# game/Story03.rpy:4598
translate spanish akt3chapter3_4_dd5e7a8a:

    # a "And because I was lucky."
    a "Y porque tuve suerte."

# game/Story03.rpy:4604
translate spanish akt3chapter3_4_d4aa063b:

    # mc "(Gate? What kind of...)"
    mc "(¿Portal? ¿Qué clase de...?)"

# game/Story03.rpy:5041
translate spanish akt3chapter4_64288e43:

    # L "We need to find a way out."
    L "Necesitamos encontrar una salida."

# game/Story03.rpy:5730
translate spanish akt3chapter5_1_59242a8a:

    # Fl "Freezing is the priority."
    Fl "La congelación es la prioridad."

# game/Story03.rpy:5731
translate spanish akt3chapter5_1_044afcc9:

    # Fl "If they breach the line, shoot. But only then."
    Fl "Si rompen la línea, disparen. Pero solo entonces."

# game/Story03.rpy:5732
translate spanish akt3chapter5_1_76982a3a:

    # Fl "Every dead Soulless feeds the substance."
    Fl "Cada Desalmado muerto alimenta la sustancia."

# game/Story03.rpy:5733
translate spanish akt3chapter5_1_4eae6bae:

    # Fl "So we don't kill to win. We kill only to buy seconds."
    Fl "Así que no matamos para ganar. Matamos solo para ganar unos segundos."

# game/Story03.rpy:5803
translate spanish akt3chapter5_1_ef395dc6:

    # L "The Tower is about to activate."
    L "La Torre está a punto de activarse."

# game/Story03.rpy:5844
translate spanish akt3chapter5_1_2909dd39:

    # Fl "While the Syndicate and the Peacekeepers are focused on containing the Soulless..."
    Fl "Mientras el Sindicato y los Pacificadores se concentran en contener a los Desalmados..."

# game/Story03.rpy:5970
translate spanish akt3chapter5_2_964f8ad9:

    # am "A smaller grave than the one she would make of the world."
    am "Una tumba más pequeña que la que ella haría del mundo."

# game/Story03.rpy:8137
translate spanish choiceY_da387ff3:

    # mc "So — gates and breaches. Different things?"
    mc "Entonces: portales y brechas. ¿Son cosas distintas?"

# game/Story03.rpy:8139
translate spanish choiceY_bcd130de:

    # y "branch are one system. Their natural function is to link worlds."
    y "Las brechas forman un solo sistema. Su función natural es conectar mundos."

# game/Story03.rpy:8143
translate spanish choiceY_83f9fc35:

    # y "Machines built to control them."
    y "Máquinas construidas para controlarlas."

# game/Story03.rpy:8145
translate spanish choiceY_4bd39382:

    # mc "So, put simply? Breaches happen naturally. Gates force them open?"
    mc "Entonces, en pocas palabras: las brechas ocurren de forma natural. ¿Los portales las fuerzan a abrirse?"

# game/Story03.rpy:8139
translate spanish choiceY_6750d58d:

    # y "Breaches are natural tears between worlds."
    y "Las brechas son desgarros naturales entre mundos."

# game/Story03.rpy:8120
translate spanish choiceY_da80308f:

    # y "Not because of her death. Because they can destroy the Gate to the Abyss."
    y "No por su muerte. Porque pueden destruir el portal al Abismo."

# game/Story03.rpy:8192
translate spanish choiceY_be68fca3:

    # mc "So I can activate that Gate?"
    mc "¿Así que puedo activar ese portal?"


