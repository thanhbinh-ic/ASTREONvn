    mc "Arriesgué mi vida."

# game/Story03.rpy:4784

translate spanish akt3chapter4_80380bee:

    # mc "Almost died more than once."
    mc "Casi muere más de una vez."

# game/Story03.rpy:4785

translate spanish akt3chapter4_0068191e:

    # mc "And this is what I get when I finally make it here?"
    mc "¿Y esto es lo que obtengo cuando finalmente llego aquí?"

