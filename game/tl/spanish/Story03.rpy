    # Fl "No..."
    Fl "No..."

# game/Story03.rpy:5083

translate spanish akt3chapter4_d83ed31e:

    # Fl "The tower—"
    Fl "La torre..."

# game/Story03.rpy:5086

translate spanish akt3chapter4_9dc4fd2b:

    # mc "We don’t have another option."
    mc "No tenemos otra opción."

# game/Story03.rpy:5096

translate spanish akt3chapter4_73005691:

    # mc "Flora."
    mc "Flora."

# game/Story03.rpy:5097

