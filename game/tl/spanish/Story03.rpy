    Fl "(Mantén una cara recta... no muestres ese lado de ti mismo.)"

# game/Story03.rpy:9440

translate spanish act3_5chapter4_333605a6:

    # Fl "You sound like the galaxy’s hanging by a thread again. Déjà vu, really."
    Fl "Suenas como si la galaxia estuviera colgando de un hilo otra vez. Déjà vu, en realidad."

# game/Story03.rpy:9442

translate spanish act3_5chapter4_1d8ce67e:

    # mc "(Breathe. Don’t raise your voice… not now.)"
    mc "(Tranquilo. No levantes tu voz... no ahora.)"

# game/Story03.rpy:9444

translate spanish act3_5chapter4_778079e9:

    # Fl "What, interrogating me? Or do you just like bossing people around?"
    Fl "¿O te gusta dirigir a la gente?"

# game/Story03.rpy:9447

translate spanish act3_5chapter4_61b11b64:

    # mc "Please, Flora. Enough games."
    mc "Por favor, Flora, basta de juegos."

# game/Story03.rpy:9450

translate spanish act3_5chapter4_f8495c19:

    # Fl "No! I’m not your reporting machine!"
    Fl "¡No! ¡No soy tu máquina de reportar!"

# game/Story03.rpy:9452

translate spanish act3_5chapter4_c7116752:

    # mc "(This is starting to annoy me… why is she dodging the answer?)"
    mc "(Esto está empezando a molestarme... ¿por qué está haciendo la respuesta?)"

# game/Story03.rpy:9455

translate spanish act3_5chapter4_63aeda98:

    # mc "(Don’t yell, [mc], don’t yell — keep it together.)"
    mc "(No grites, [mc], no grites — manténgalo unido.)"

# game/Story03.rpy:9456

translate spanish act3_5chapter4_794a727c:

    # mc "Flora, please… stop this."
    mc "Flora, por favor... para esto."

# game/Story03.rpy:9462

translate spanish act3_5chapter4_61087bdf:

    # Fl "Interesting tactic — show up after everything and demand a report. You haven’t changed."
    Fl "Interesante táctica — aparecer después de todo y exigir un informe. No has cambiado."

# game/Story03.rpy:9464

translate spanish act3_5chapter4_8d2484e7:

    # mc "I didn’t come here to argue. I came for answers."
    mc "No vine aquí para discutir. Vine para responder."

# game/Story03.rpy:9465

translate spanish act3_5chapter4_048bd42c:

    # mc "(No choice left… sorry.)"
    mc "(No queda elección... lo siento.)"

# game/Story03.rpy:9468

translate spanish act3_5chapter4_5005863b:

    # Fl "You decided to raise—"
    Fl "Decidiste criar..."

# game/Story03.rpy:9473

translate spanish act3_5chapter4_99e51102:

    # mc "Flora… just tell me straight. Please."
    mc "Flora... solo dime derecho."

# game/Story03.rpy:9474

translate spanish act3_5chapter4_621c87e0:

    # mc "(Breathe… don’t push her over the edge.)"
    mc "(Tranquilo... no la empujes por el borde.)"

# game/Story03.rpy:9476

translate spanish act3_5chapter4_0f57326a:

    # mc "Did it fail?"
    mc "¿Fructuó?"

# game/Story03.rpy:9484

translate spanish act3_5chapter4_89b7c9ae:

    # Fl "You want the truth? The plan failed. Yes. Happy now?"
    Fl "¿Quieres la verdad?"

# game/Story03.rpy:9485

translate spanish act3_5chapter4_fd58dfc9:

    # Fl "And on top of that, everyone blames me for the failure! Understand?!"
    Fl "Y encima de eso, todos me culpan por el fracaso. ¿Entiendes?"

# game/Story03.rpy:9487

translate spanish act3_5chapter4_5fdf7d40:

    # Fl "As if it were my fault, not theirs."
    Fl "Como si fuera mi culpa, no la suya."

# game/Story03.rpy:9488

translate spanish act3_5chapter4_2b35b6fe_1:

    # mc "..."
    mc "..."

# game/Story03.rpy:9489

translate spanish act3_5chapter4_48ae0bf1:

    # Fl "And then you come and say you’ll help?! With what? Death?!"
    Fl "¿Y luego vienes y dices que ayudarás?! ¿Con qué? ¿Muerte?"

# game/Story03.rpy:9492

translate spanish act3_5chapter4_6e9cf21c:

    # Fl "I didn’t ask for this… They dumped everything they could on me."
    Fl "No pedí esto... dejaron todo lo que podían sobre mí."

# game/Story03.rpy:9493

translate spanish act3_5chapter4_740fde20:

    # Fl "And even with all that, I did everything I could!"
    Fl "¡Y con todo eso hice todo lo que pude!"

# game/Story03.rpy:9495

translate spanish act3_5chapter4_b0eed018:

    # Fl "(Whisper) Worthless junk, not even able to figure out what’s on a normal flash drive."
    Fl "(Whisper) basura sin sentido, ni siquiera capaz de averiguar lo que está en una unidad flash normal."

# game/Story03.rpy:9497

translate spanish act3_5chapter4_504482c1:

    # mc "...And they all pinned it on you."
    mc "...y todos te lo clavaron."

# game/Story03.rpy:9499

translate spanish act3_5chapter4_945649de:

    # Fl "GET OUT!"
    Fl "¡Fuera!"

# game/Story03.rpy:9504

translate spanish act3_5chapter4_209d276e:

    # mc "(No. Give her space. You need her more than she needs you.)"
    mc "(No. Dale espacio. La necesitas más de lo que te necesita.)"

# game/Story03.rpy:9510

translate spanish act3_5chapter4_41da62cb:

    # Fl "..."
    Fl "..."

# game/Story03.rpy:9513

translate spanish act3_5chapter4_bad91444:

    # mc "...Right. What do we do now?"
    mc "- Bien. ¿Qué hacemos ahora?"

# game/Story03.rpy:9516

translate spanish act3_5chapter4_e6f35cf4:

    # Fl "What do you need?"
    Fl "¿Qué necesitas?"

# game/Story03.rpy:9518

translate spanish act3_5chapter4_183629b5:

    # mc "I thought you had it covered… didn’t expect leadership to fold."
    mc "Pensé que lo tenías cubierto... no esperaba que el liderazgo se doblara."

# game/Story03.rpy:9519

translate spanish act3_5chapter4_b98ddae5:

    # mc "So they left you with scraps, and you still tried."
    mc "Así que te dejaron con chatarras, y aún lo intentaste."

# game/Story03.rpy:9520

translate spanish act3_5chapter4_5547f5df:

    # mc "Even so… they followed you. That says enough."
    mc "Incluso así... te siguieron, eso dice suficiente."

# game/Story03.rpy:9523

translate spanish act3_5chapter4_432c225b:

    # Fl "It’s viable…"
    Fl "Es viable..."

# game/Story03.rpy:9525

translate spanish act3_5chapter4_73c85e74:

    # mc "...It hurts, doesn’t it?"
    mc "...Duele, ¿no?"

# game/Story03.rpy:9528

translate spanish act3_5chapter4_5329e9f1:

    # Fl "It would have worked if it weren’t for cowardly leadership."
    Fl "Habría funcionado si no fuera por el liderazgo cobarde."

# game/Story03.rpy:9529

translate spanish act3_5chapter4_77682ec1:

    # Fl "I needed people, and trust. I asked him for help, but…"
    Fl "Necesitaba gente, y confío en él. Le pedí ayuda, pero..."

# game/Story03.rpy:9530

translate spanish act3_5chapter4_b9ee487c:

    # Fl "In the end, the only ones who agreed were my father’s men."
    Fl "Al final, los únicos que estuvieron de acuerdo eran los hombres de mi padre."

# game/Story03.rpy:9533

translate spanish act3_5chapter4_d38580ca:

    # Fl "They’re far from soldiers — just regular cops without proper equipment."
    Fl "Están lejos de los soldados, solo policías regulares sin equipo adecuado."

# game/Story03.rpy:9534

translate spanish act3_5chapter4_c2c8fd84:

    # Fl "As a result, they were all wiped out, only a handful returned."
    Fl "Como resultado, todos fueron borrados, solo un puñado devuelto."

# game/Story03.rpy:9536

translate spanish act3_5chapter4_78184282:

    # Fl "And the worst part — they still believe in me. Even after losing so many brothers…"
    Fl "Y la peor parte, aún creen en mí, incluso después de perder a tantos hermanos..."

# game/Story03.rpy:9537

translate spanish act3_5chapter4_59deca69:

    # Fl "Not one, not one of three thousand people… blamed me for it. I—"
    Fl "Ni uno, ni uno de tres mil personas... me culparon por ello."

# game/Story03.rpy:9540

translate spanish act3_5chapter4_53817884:

    # Fl "It hurts. It hurts so much."
    Fl "Duele mucho."

# game/Story03.rpy:9545

translate spanish act3_5chapter4_1ee1b20f:

    # i "(Whisper) And… what do we do?"
    i "¿Y qué hacemos?"

# game/Story03.rpy:9546

translate spanish act3_5chapter4_73538006:

    # Mi "(Whisper) I think he can handle it himself. Better leave them."
    Mi "Creo que puede manejarlo él mismo, mejor déjalos."

# game/Story03.rpy:9552

translate spanish act3_5chapter4_57711e93:

    # Mi "(Whisper) We’ll leave you — don’t fail us."
    Mi "(Susurrador) Te dejaremos - no nos falle."

# game/Story03.rpy:9554

translate spanish act3_5chapter4_2b35b6fe_2:

    # mc "..."
    mc "..."

# game/Story03.rpy:9555

translate spanish act3_5chapter4_b10cfe7f:

    # Fl "Who was that?"
    Fl "¿Quién era?"

# game/Story03.rpy:9557

translate spanish act3_5chapter4_47450cdd:

    # mc "Elves. Not very talkative ones."
    mc "Los elfos, no muy habladores."

# game/Story03.rpy:9558

translate spanish act3_5chapter4_dcb52f01:

    # mc "About that plan of yours…"
    mc "Sobre ese plan tuyo..."

# game/Story03.rpy:9559

translate spanish act3_5chapter4_f17e4659:

    # mc "Anything we can do?"
    mc "¿Algo que podamos hacer?"

# game/Story03.rpy:9561

translate spanish act3_5chapter4_e1e64713:

    # Fl "And what are we supposed to do? Take matters into our own hands and overthrow the commander?"
    Fl "¿Y qué se supone que hagamos? ¿Tomar las cosas en nuestras propias manos y derrocar al comandante?"

# game/Story03.rpy:9562

translate spanish act3_5chapter4_191db4aa:

    # Fl "Yeah… no chance."
    Fl "Sí... sin posibilidad."

# game/Story03.rpy:9564

translate spanish act3_5chapter4_b9128e78:

    # mc "You know… if we take the risk"
    mc "Sabes... si nos arriesgamos."

# game/Story03.rpy:9569

translate spanish act3_5chapter4_154082da:

    # em "Trying a coup, bold move. Reckless, but bold."
    em "Intrépido, pero audaz."

# game/Story03.rpy:9571

translate spanish act3_5chapter4_1a6bc84d:

    # mc "If necessary."
    mc "Si es necesario."

# game/Story03.rpy:9574

translate spanish act3_5chapter4_04c2dfb2:

    # em "You have teeth. You’ll go far."
    em "Tienes dientes. Vas a ir lejos."

# game/Story03.rpy:9575

translate spanish act3_5chapter4_9bbd6349:

    # em "So tell me, boy… why are you here?"
    em "Dime, muchacho... ¿por qué estás aquí?"

# game/Story03.rpy:9577

translate spanish act3_5chapter4_5e27d163:

    # mc "(God, their arrogance is infuriating. Makes you want to say: ‘Do what you can’t.’)"
    mc "(Dios, su arrogancia es infuriante. Te hace querer decir: 'Haz lo que no puedes')."

# game/Story03.rpy:9579

translate spanish act3_5chapter4_0ee38b57:

    # mc "I need your strength."
    mc "Necesito tu fuerza."

# game/Story03.rpy:9581

translate spanish act3_5chapter4_650f5c19:

    # em "I’m listening."
    em "Estoy escuchando."

# game/Story03.rpy:9583

translate spanish act3_5chapter4_380f1f7d:

    # mc "Give me enough power to overthrow the current commander, and I’ll do everything to save your people. And this planet."
    mc "Dame suficiente poder para derrocar al comandante actual, y haré todo para salvar a tu pueblo. Y este planeta."

# game/Story03.rpy:9586

translate spanish act3_5chapter4_f925d8ba:

    # em "Tempting. But what’s in it for me?"
    em "¿Pero qué hay para mí?"

# game/Story03.rpy:9590

translate spanish act3_5chapter4_90e522d9:

    # mc "If you’re afraid of risk… standing still is worse."
    mc "Si tienes miedo del riesgo... permanecer de pie es peor."

# game/Story03.rpy:9592

translate spanish act3_5chapter4_7c8593f5:

    # em "Risk erases reward."
    em "La recompensa de las eras de riesgo."

# game/Story03.rpy:9594

translate spanish act3_5chapter4_d9ef081f:

    # mc "So you’ll watch them burn? That’s leadership?"
    mc "¿Así que los verás quemar?"

# game/Story03.rpy:9597

translate spanish act3_5chapter4_0736af5c:

    # mc "You blamed Astoria for weakness. But are you any better?"
    mc "Culpó a Astoria por debilidad, pero ¿estás mejor?"

# game/Story03.rpy:9599

translate spanish act3_5chapter4_0aba83e1:

    # em "Drop it. Provocation doesn’t work on me."
    em "Suéltala. La defensa no funciona en mí."

# game/Story03.rpy:9601

translate spanish act3_5chapter4_623c6722:

    # mc "You’re all the same here — arrogant, ego-driven rulers. I thought at least you might be different…"
    mc "Ustedes son todos iguales aquí — gobernantes arrogantes y impulsados por el ego. Pensé que al menos ustedes podrían ser diferentes..."

# game/Story03.rpy:9603

translate spanish act3_5chapter4_308499a6:

    # mc "(No… she wouldn’t just sit idle. Not her. Something’s choking the fire.)"
    mc "(No... ella no se sentaría sola. No ella. Algo está ahogando el fuego.)"

# game/Story03.rpy:9605

translate spanish act3_5chapter4_7906050c:

    # mc "Or someone."
    mc "O alguien."

# game/Story03.rpy:9611

translate spanish act3_5chapter4_a657d843:

    # mc "Could it be… you’re afraid…"
    mc "¿Podría ser... que tengas miedo..."

# game/Story03.rpy:9618

translate spanish act3_5chapter4_487d4dfc:

    # em "You’re playing with fire, boy."
    em "Estás jugando con fuego, muchacho."

# game/Story03.rpy:9620

translate spanish act3_5chapter4_31e0213c:

    # mc "(There it is. Fear.)"
    mc "(Ahí está. miedo.)"

# game/Story03.rpy:9622

translate spanish act3_5chapter4_dbdc2f92:

    # mc "Never thought I’d see Ember herself—chained by another’s shadow."
    mc "Nunca pensé que vería a Ember ella misma, encadenada por la sombra de otro."

# game/Story03.rpy:9624

translate spanish act3_5chapter4_2731811e:

    # em "Careful. Don’t tease me."
    em "Cuidado. No me engañes."

# game/Story03.rpy:9626

translate spanish act3_5chapter4_e69bae3f:

    # mc "So? Will you kill me for saying it out loud? For trying to save what you claim to protect?"
    mc "¿Me matarás por decirlo en voz alta?"

# game/Story03.rpy:9627

translate spanish act3_5chapter4_2ede96c3:

    # Fl "(Whisper) Don’t provoke her."
    Fl "No la provoques."

# game/Story03.rpy:9628

translate spanish act3_5chapter4_3c22ce1a:

    # mc "Or just for scratching that pride of yours?"
    mc "¿O solo por rascarte ese orgullo tuyo?"

# game/Story03.rpy:9633

translate spanish act3_5chapter4_b592c5d2:

    # mc "Kgh—"
    mc "Kgh..."

# game/Story03.rpy:9635

translate spanish act3_5chapter4_2484f3cb:

    # Fl "Ember, please stop!"
    Fl "¡Ember, por favor, para!"

# game/Story03.rpy:9638

translate spanish act3_5chapter4_8b0e5203:

    # Fl "He means well."
    Fl "Significa bien."

# game/Story03.rpy:9641

translate spanish act3_5chapter4_91ba8ed1:

    # Fl "Ouch..."
    Fl "Oh..."

# game/Story03.rpy:9643

translate spanish act3_5chapter4_d33ba310:

    # em "Don’t interfere, Flora. This worm needs manners."
    em "No interfiera, Flora. Este gusano necesita modales."

# game/Story03.rpy:9646

translate spanish act3_5chapter4_f64a4dcf:

    # em "I don’t care what Astoria saw in him. I won’t tolerate his insolence."
    em "No me importa lo que Astoria vio en él. No toleraré su insolencia."

# game/Story03.rpy:9649

translate spanish act3_5chapter4_b592c5d2_1:

    # mc "Kgh—"
    mc "Kgh..."

# game/Story03.rpy:9650

translate spanish act3_5chapter4_f3912906:

    # mc "(Think... Think!)"
    mc "(Piensa... ¡Piensa!)"

# game/Story03.rpy:9652

translate spanish act3_5chapter4_643f0fd5:

    # y "Ember. If they learn I'm here, it'll cause big problems."
    y "Si se enteran de que estoy aquí, va a ser un gran problema."

# game/Story03.rpy:9654

translate spanish act3_5chapter4_5878613e:

    # k "Besides the fact he killed her father? Nope, nothing."
    k "¿Además del hecho de que mató a su padre?"

# game/Story03.rpy:9656

translate spanish act3_5chapter4_59ea329f:

    # mc "Yong…"
    mc "Yong..."

# game/Story03.rpy:9657

translate spanish act3_5chapter4_2e2b8da5:

    # em "What did you say?"
    em "¿Qué dijiste?"

# game/Story03.rpy:9659

translate spanish act3_5chapter4_684b6de7:

    # mc "(Sorry, Miriel.)"
    mc "(Lo siento, Miriel.)"

# game/Story03.rpy:9660

translate spanish act3_5chapter4_04affa8e:

    # mc "Yong is alive."
    mc "Yong está vivo."

# game/Story03.rpy:9665

translate spanish act3_5chapter4_621bfa78:

    # Fl "[mc]!"
    Fl "[mc]!"

# game/Story03.rpy:9667

translate spanish act3_5chapter4_42ea513c:

    # mc "(My voice… did she hurt my vocal cords?!)"
    mc "(Mi voz... ¿me lastimó las cuerdas vocales?!)"

# game/Story03.rpy:9670

translate spanish act3_5chapter4_5767686d:

    # Fl "Say something, are you okay?!"
    Fl "Di algo, ¿estás bien?"

# game/Story03.rpy:9673

translate spanish act3_5chapter4_6bf3c292:

    # em "What you said — is it true?"
    em "Lo que dijiste, ¿es verdad?"

# game/Story03.rpy:9674

translate spanish act3_5chapter4_db3da3d5:

    # em "Speak. No second chance."
    em "No hay segunda oportunidad."

# game/Story03.rpy:9676

translate spanish act3_5chapter4_1d46ea27:

    # mc "Yes. You know that name, don’t you? You once—"
    mc "Sí. ¿Conoces ese nombre, no?"

# game/Story03.rpy:9679

translate spanish act3_5chapter4_8985195a:

    # Mi "Don’t!"
    Mi "¡No!"

# game/Story03.rpy:9681

translate spanish act3_5chapter4_03f82730:

    # Mi "Don’t you dare!"
    Mi "¡No te atrevas!"

# game/Story03.rpy:9690

translate spanish act3_5chapter4_3b77626f:

    # em "(So there’s truth in him.)"
    em "(Así que hay verdad en él.)"

# game/Story03.rpy:9692

translate spanish act3_5chapter4_234109e1:

    # em "(Foolish child.)"
    em "(Niño de comida.)"

# game/Story03.rpy:9699

translate spanish act3_5chapter4_3f1f7d7e:

    # Mi "Ah—!"
    Mi "¡Ah!"

# game/Story03.rpy:9700

translate spanish act3_5chapter4_2543a088:

    # em "Show’s over."
    em "El espectáculo terminó."

# game/Story03.rpy:9703

translate spanish act3_5chapter4_2cecd8d3:

    # em "No one leaves until I have what I came for."
    em "Nadie se va hasta que yo tenga lo que vine a buscar."

# game/Story03.rpy:9706

translate spanish act3_5chapter4_daf00a0e:

    # Mi "(Whisper) What are you planning…?"
    Mi "¿Qué estás planeando...?"

# game/Story03.rpy:9708

translate spanish act3_5chapter4_2555711b:

    # mc "Dancing with death."
    mc "Bailando con la muerte."

# game/Story03.rpy:9711

translate spanish act3_5chapter4_d323802d:

    # mc "(Sell Yong’s name and Miriel will never trust me again. Stay silent and Ember tears me apart. Perfect trap.)"
    mc "(El nombre de Sell Yong y Miriel nunca volverán a confiar en mí. Mantente en silencio y Ember me desgarra."

# game/Story03.rpy:9712

translate spanish act3_5chapter4_f5868a16:

    # em "What do you want?"
    em "¿Qué quieres?"

# game/Story03.rpy:9714

translate spanish act3_5chapter4_2cac1744:

    # mc "The same deal. Power. Enough to take the commander down."
    mc "El mismo trato, poder, suficiente para derribar al comandante."

# game/Story03.rpy:9716

translate spanish act3_5chapter4_747cf820:

    # em "Impossible."
    em "Imposible."

# game/Story03.rpy:9718

translate spanish act3_5chapter4_17b7ee30:

    # mc "So you’d rather cut them loose than trust me?"
    mc "¿Prefieres soltarlos que confiar en mí?"

# game/Story03.rpy:9720

translate spanish act3_5chapter4_85fc1da2:

    # mc "(Come on, dragon. Bite the hook.)"
    mc "Vamos, dragón. ¡Búscate el gancho!"

# game/Story03.rpy:9723

translate spanish act3_5chapter4_a4cdd8cc:

    # mc "(Information, people — you’re already in a huge advantage.)"
    mc "(Información, gente – ya estás en una gran ventaja.)"

# game/Story03.rpy:9727

translate spanish act3_5chapter4_5e4ce364:

    # mc "(She’s thinking. Good.)"
    mc "(Ella está pensando. Bien.)"

# game/Story03.rpy:9729

translate spanish act3_5chapter4_886b00ba:

    # em "…On my terms."
    em "...en mis términos."

# game/Story03.rpy:9731

translate spanish act3_5chapter4_8ac5cb41:

    # em "I won’t help you. I’ll give you… a chance."
    em "No te ayudaré. Te daré una oportunidad."

# game/Story03.rpy:9733

translate spanish act3_5chapter4_9f92e38d:

    # mc "(What? A chance? Screw that!)"
    mc "¡A la mierda!"

# game/Story03.rpy:9737

translate spanish act3_5chapter4_341068b0:

    # mc "Then in exchange—"
    mc "Entonces a cambio..."

# game/Story03.rpy:9739

translate spanish act3_5chapter4_4695db45:

    # em "Everything. You. Have."
    em "Todo, tú, tú."

# game/Story03.rpy:9741

translate spanish act3_5chapter4_651a5298:

    # mc "(Crap. Just crap.)"
    mc "Mierda."

# game/Story03.rpy:9743

translate spanish act3_5chapter4_08ec0f65:

    # mc "Everything I know? …So be it."
    mc "¿Todo lo que sé?"

# game/Story03.rpy:9752

translate spanish act3_5chapter4_30ba1dd6:

    # em "Now your life is in my hands."
    em "Ahora tu vida está en mis manos."

# game/Story03.rpy:9757

translate spanish act3_5chapter4_de5c3667:

    # mc "(Worst case sealed. May Alejandro’s crocodiles choke on your bones.)"
    mc "(El peor caso sellado. Los cocodrilos de Alejandro se ahogan en sus huesos.)"

# game/Story03.rpy:9759

translate spanish act3_5chapter4_aa48fd8d:

    # mc "(Exactly, Miriel!)"
    mc "(Exactamente, Miriel!)"

# game/Story03.rpy:9762

translate spanish act3_5chapter4_66810d40:

    # mc "Hold still. I’ll find something for that wound."
    mc "Aguanta. Encontraré algo para esa herida."

# game/Story03.rpy:9765

translate spanish act3_5chapter4_49379116:

    # Fl "Why… why did you agree?"
    Fl "¿Por qué... por qué estás de acuerdo?"

# game/Story03.rpy:9767

translate spanish act3_5chapter4_a79cb68d:

    # mc "Why? …Because I’m tired of being powerless."
    mc "¿Por qué? ...Porque estoy cansado de ser impotente."

# game/Story03.rpy:9772

translate spanish act3_5chapter4_d9e18538:

    # Mi "You decided to betray the teacher?! How could you?!"
    Mi "¿Decidiste traicionar al profesor?!"

# game/Story03.rpy:9775

translate spanish act3_5chapter4_0577c5a9:

    # mc "It wasn’t betrayal."
    mc "No fue traición."

# game/Story03.rpy:9777

translate spanish act3_5chapter4_23071bbd:

    # mc "It was survival. What choice did I have?"
    mc "Era supervivencia. ¿Qué opción tenía?"

# game/Story03.rpy:9779

translate spanish act3_5chapter4_30d004f1:

    # Mi "Coward."
    Mi "Cobarde."

# game/Story03.rpy:9782

translate spanish act3_5chapter4_41da62cb_1:

    # Fl "..."
    Fl "..."

# game/Story03.rpy:9787

translate spanish act3_5chapter4_9ac8a523:

    # mc "(Whisper) Deserved."
    mc "Merecía."

# game/Story03.rpy:9789

translate spanish act3_5chapter4_94f2bdea:

    # Fl "Sorry… this is my fault… If not for me…"
    Fl "Lo siento... es mi culpa... si no es por mí..."

# game/Story03.rpy:9790

translate spanish act3_5chapter4_24f4b657:

    # mc "Don’t. This isn’t on you."
    mc "No lo hagas. Esto no está en ti."

# game/Story03.rpy:9793

translate spanish act3_5chapter4_8944fd22:

    # mc "Flora… where’s Lora? I need to see her."
    mc "Flora... ¿dónde está Lora? Necesito verla."

# game/Story03.rpy:9795

translate spanish act3_5chapter4_39a8ab78:

    # Fl "In her room. I’ll send you the location now."
    Fl "En su habitación. Te enviaré la ubicación ahora."

# game/Story03.rpy:9798

translate spanish act3_5chapter4_bb0eeaf4:

    # mc "Thank you."
    mc "Gracias."

# game/Story03.rpy:9800

translate spanish act3_5chapter4_20671ab7:

    # Fl "(whisper) You too..."
    Fl "Tú también..."

# game/Story03.rpy:9823

translate spanish ivy_meetings_ac9f11f3:

    # mc "(Why is it that whatever I touch turns into a mess?)"
    mc "(¿Por qué es que lo que toque se convierte en un desastre?)"

# game/Story03.rpy:9824

translate spanish ivy_meetings_ef6b17b3:

    # mc "(Haven’t felt this drained in a long time...)"
    mc "(No ha sentido que esto se drenara en mucho tiempo...)"

# game/Story03.rpy:9826

translate spanish ivy_meetings_81d99089:

    # i "[mc]! What happened?"
    i "[mc]¿Qué pasó?"

# game/Story03.rpy:9828

translate spanish ivy_meetings_58c321c6:

    # mc "Ivy? ...A lot went down."
    mc "¿Ivy?"

# game/Story03.rpy:9830

translate spanish ivy_meetings_3b656acf:

    # i "Be clearer. You look like you’re about to jump off a roof."
    i "Más claro. Parece que estás a punto de saltar de un techo."

# game/Story03.rpy:9831

translate spanish ivy_meetings_ad35ac65:

    # i "More than once, actually..."
    i "Más de una vez, en realidad..."

# game/Story03.rpy:9834

translate spanish ivy_meetings_80e8df9f:

    # i "And tell me it wasn’t *you* who pushed Miriel into that state?"
    i "Y dime que no fue *usted* quien empujó a Miriel a ese estado?"

# game/Story03.rpy:9836

translate spanish ivy_meetings_e0b52c65:

    # mc "Call it a misunderstanding."
    mc "Llámalo un malentendido."

# game/Story03.rpy:9839

translate spanish ivy_meetings_950a57d7:

    # mc "Ember wanted answers, Miriel tried to shield me… and it spiraled."
    mc "Ember quería respuestas, Miriel trató de protegerme... y en espiral."

# game/Story03.rpy:9843

translate spanish ivy_meetings_3a89f0ee:

    # i "Wait. What’s with your neck?"
    i "Espera. ¿Qué pasa con tu cuello?"

# game/Story03.rpy:9845

translate spanish ivy_meetings_88cf2e63:

    # mc "It’s nothing."
    mc "No es nada."

# game/Story03.rpy:9847

translate spanish ivy_meetings_4db26f2a:

    # i "Doesn’t look like ‘nothing’ to me."
    i "No me parece nada."

# game/Story03.rpy:9850

translate spanish ivy_meetings_0d78b770:

    # i "If I remember right... you were talking with Flora, weren’t you?"
    i "Si recuerdo bien... estabas hablando con Flora, ¿no?"

# game/Story03.rpy:9851

translate spanish ivy_meetings_f1a9719d:

    # i "And Ember showed up around then… so you clashed?"
    i "Y Ember apareció por ahí... ¿así que chocaste?"

# game/Story03.rpy:9856

translate spanish ivy_meetings_63addb4d:

    # i "Information… you said something that struck a nerve. Otherwise she wouldn’t have lost it enough to burn you."
    i "Información... dijiste algo que golpeó el nervio. De lo contrario ella no habría perdido lo suficiente para quemarte."

# game/Story03.rpy:9857

translate spanish ivy_meetings_4bd60baf:

    # i "So either you provoked her, or you told her something important."
    i "Así que o la provocaste, o le dijiste algo importante."

# game/Story03.rpy:9862

translate spanish ivy_meetings_48ba3306:

    # i "Miriel, judging by the look of her, tried to step in but couldn’t. And yet—you’re still standing here."
    i "Miriel, a juzgar por su mirada, trató de entrar pero no pudo. Y sin embargo, todavía estás parado aquí."

# game/Story03.rpy:9864

translate spanish ivy_meetings_bf407efd:

    # i "So? Am I close?"
    i "¿Estoy cerca?"

# game/Story03.rpy:9865

translate spanish ivy_meetings_2b35b6fe:

    # mc "..."
    mc "..."

# game/Story03.rpy:9867

translate spanish ivy_meetings_854887cc:

    # mc "That whole deduction of yours — you pulled it out of thin air?"
    mc "Toda esa deducción tuya - lo sacaste del aire delgado?"

# game/Story03.rpy:9870

translate spanish ivy_meetings_334b91be:

    # i "Just thinking out loud."
    i "Solo pensaba en voz alta."

# game/Story03.rpy:9872

translate spanish ivy_meetings_65b68815:

    # i "So… was I right?"
    i "Entonces... ¿tenía razón?"

# game/Story03.rpy:9874

translate spanish ivy_meetings_881e1ab2:

    # mc "Impressive."
    mc "Impresionante."

# game/Story03.rpy:9875

translate spanish ivy_meetings_b0f73ca4:

    # mc "(Hard to believe this is the same girl who used to work at that club…)"
    mc "(Es difícil creer que esta es la misma chica que solía trabajar en ese club...)"

# game/Story03.rpy:9881

translate spanish ivy_meetings_ced3b159:

    # mc "Spot on."
    mc "En posición."

# game/Story03.rpy:9884

translate spanish ivy_meetings_974f004a:

    # mc "Honestly, I didn’t expect it to turn out like this either."
    mc "Sinceramente, tampoco esperaba que fuera así."

# game/Story03.rpy:9885

translate spanish ivy_meetings_2670ceaf:

    # mc "Everyone keeps saying ‘don’t do this, don’t do that,’ but no one ever explains a damn thing. Just makes my life unbearable."
    mc "Todo el mundo sigue diciendo 'no hagas esto, no hagas eso,' pero nadie explica una maldita cosa. Solo hace que mi vida sea insoportable."

# game/Story03.rpy:9888

translate spanish ivy_meetings_38504b0c:

    # i "I could…"
    i "Podría..."

# game/Story03.rpy:9890

translate spanish ivy_meetings_0054e596:

    # mc "You’re serious?"
    mc "¿Hablas en serio?"

# game/Story03.rpy:9892

translate spanish ivy_meetings_aa2c368b:

    # i "Why not. Let’s sit down somewhere — I’ll tell you."
    i "Por qué no. Sentémonos en algún lugar — te lo diré."

# game/Story03.rpy:9894

translate spanish ivy_meetings_6f3d4875:

    # i "..."
    i "..."

# game/Story03.rpy:9896

translate spanish ivy_meetings_5d74a51b:

    # mc "That’s it? Just like that?"
    mc "¿Así es? ¿Así?"

# game/Story03.rpy:9898

translate spanish ivy_meetings_8938d056:

    # i "What, were you expecting an interrogation? No, just a talk. And yeah, I’m in the mood for a little exposition tour."
    i "¿Qué, esperabas un interrogatorio? No, solo una charla. Y sí, estoy de humor para un pequeño tour de exposición."

# game/Story03.rpy:9900

translate spanish ivy_meetings_e6b7da04:

    # mc "Expo what?"
    mc "¿Exponer qué?"

# game/Story03.rpy:9903

translate spanish ivy_meetings_2942e1c2:

    # i "Forget it. Just move before Ember finds someone else to take it out on."
    i "Olvídalo, solo muévete antes de que Ember encuentre a alguien más para que lo saque."

# game/Story03.rpy:9922

translate spanish ivy_meetings_bd1f39c3:

    # i "Come on in, don’t be shy. No one’s been here for ages."
    i "Entra, no seas tímido. Nadie ha estado aquí por siglos."

# game/Story03.rpy:9925

translate spanish ivy_meetings_e2ec93ab:

    # mc "So… what are we doing here?"
    mc "Entonces... ¿qué estamos haciendo aquí?"

# game/Story03.rpy:9929

translate spanish ivy_meetings_e94af233:

    # i "You need info. And I need to get properly drunk before I spill it."
    i "Necesitas información y necesito emborracharme adecuadamente antes de que lo derrame."

# game/Story03.rpy:9931

translate spanish ivy_meetings_0d945193:

    # mc "Those two things… connected somehow?"
    mc "¿Esos dos cosas... conectados de alguna manera?"

# game/Story03.rpy:9933

translate spanish ivy_meetings_79eaef6f:

    # i "Hmm… yeah, that’ll work."
    i "Sí, eso funcionará."

# game/Story03.rpy:9936

translate spanish ivy_meetings_ddfa0364:

    # i "Everybody’s got skeletons. And I’m not the type to dig up the past sober."
    i "Todos tienen esqueletos y no soy el tipo que debe cavar el pasado sobrio."

# game/Story03.rpy:9939

translate spanish ivy_meetings_89d43927:

    # i "And here comes the cavalry."
    i "Y aquí viene la caballería."

# game/Story03.rpy:9944

translate spanish ivy_meetings_e75a2ef8:

    # mc "Used to be my friend too, once."
    mc "Era mi amigo también, una vez."

# game/Story03.rpy:9946

translate spanish ivy_meetings_6f3d4875_1:

    # i "..."
    i "..."

# game/Story03.rpy:9948

translate spanish ivy_meetings_2b0aa5d7:

    # i "Divorce?"
    i "¿Divorcio?"

# game/Story03.rpy:9953

translate spanish ivy_meetings_31eaad1e:

    # i "Thought so. Want a drink?"
    i "Eso pensé. ¿Quieres un trago?"

# game/Story03.rpy:9960

translate spanish ivy_meetings_0b7ce6ef:

    # mc "Quit a while back."
    mc "Deja de hacer un rato."

# game/Story03.rpy:9962

translate spanish ivy_meetings_6f3d4875_2:

    # i "..."
    i "..."

# game/Story03.rpy:9965

translate spanish ivy_meetings_ff32cea2:

    # i "Smart."
    i "Inteligente."

# game/Story03.rpy:9971

translate spanish ivy_meetings_45580243:

    # i "So what did you promise Ember?"
    i "¿Qué le prometiste a Ember?"

# game/Story03.rpy:9973

translate spanish ivy_meetings_841818e8:

    # mc "Everything I’ve got."
    mc "Todo lo que tengo."

# game/Story03.rpy:9975

translate spanish ivy_meetings_5f798eb5:

    # i "No wonder you pissed her off. And Miriel?"
    i "No me extraña que la hayas molestado. ¿Y Miriel?"

# game/Story03.rpy:9979

translate spanish ivy_meetings_ee6f3223:

    # mc "I traded info about Yong for power. She… didn’t take it well."
    mc "Cambié información sobre Yong para el poder. Ella... no lo tomó bien."

# game/Story03.rpy:9984

translate spanish ivy_meetings_fcac034b:

    # i "You realize you’re standing between two fires now?"
    i "¿Te das cuenta de que estás entre dos fuegos ahora?"

# game/Story03.rpy:9985

translate spanish ivy_meetings_99e9ca99:

    # i "For Ember, he’s her father’s killer. For Miriel—he’s family."
    i "Para Ember, es el asesino de su padre. Para Miriel, él es familia."

# game/Story03.rpy:9987

translate spanish ivy_meetings_c00e4e98:

    # mc "Hold up — he really killed her father?"
    mc "¿De verdad mató a su padre?"

# game/Story03.rpy:9990

translate spanish ivy_meetings_4bc1332c:

    # i "On Astoria’s orders. Funny, huh?"
    i "Por órdenes de Astoria. ¿Qué gracioso?"

# game/Story03.rpy:9992

translate spanish ivy_meetings_49e6755a:

    # mc "What? But why?!"
    mc "¿Pero por qué?"

# game/Story03.rpy:9996

translate spanish ivy_meetings_9faea5ae:

    # i "Didn’t share her candy, so she threw a tantrum. Kidding."
    i "No compartió su caramelo, así que ella lanzó un tantrum. Bromeando."

# game/Story03.rpy:9998

translate spanish ivy_meetings_30bd89e0:

    # i "It was over the Tomb in the main tower. The old guard wanted it destroyed. Astoria didn’t. Her love for her sister clouded her judgment."
    i "Estaba sobre la tumba en la torre principal. La vieja guardia quería que la destruyera. Astoria no lo hizo. Su amor por su hermana nublaba su juicio."

# game/Story03.rpy:10000

translate spanish ivy_meetings_5bb6c988:

    # i "So now Ember ‘helps.’ In reality, she just watches. Doesn’t even value her own people."
    i "Así que ahora Ember ‘ayuda’. En realidad, ella solo mira. Ni siquiera valora a su propia gente."

# game/Story03.rpy:10002

translate spanish ivy_meetings_741dc9dc:

    # mc "But weren’t she and Astoria friends?"
    mc "¿Pero no eran ella y Astoria amigos?"

# game/Story03.rpy:10004

translate spanish ivy_meetings_2f629775:

    # i "No. Just a deal. Strictly business."
    i "No, solo un trato, es un asunto estrictamente."

# game/Story03.rpy:10010

translate spanish ivy_meetings_a2651c75:

    # i "And if anyone finds out I’m talking — we’re both dead and buried before dawn."
    i "Y si alguien se entera de que estoy hablando, ambos estamos muertos y enterrados antes del amanecer."

# game/Story03.rpy:10011

translate spanish ivy_meetings_074a3807:

    # i "And they’ll probably say we were some tragic couple. Horrifying, really."
    i "Y probablemente dirán que éramos una pareja trágica. Horrificante, en realidad."

# game/Story03.rpy:10013

translate spanish ivy_meetings_5e095bc2:

    # mc "That’s one rumor I could live without."
    mc "Ese es un rumor que podría vivir sin."

# game/Story03.rpy:10016

translate spanish ivy_meetings_371e7efb:

    # i "Tch, you could’ve played along, you know."
    i "Tch, podrías haber jugado juntos, sabes."

# game/Story03.rpy:10020

translate spanish ivy_meetings_e5b549ee:

    # i "Your turn now. What, thought this was free?"
    i "Tu turno ahora. ¿Qué, pensaba que esto era gratis?"

# game/Story03.rpy:10022

translate spanish ivy_meetings_ed87226f:

    # mc "What do you want?"
    mc "¿Qué quieres?"

# game/Story03.rpy:10028

translate spanish ivy_meetings_782302e5:

    # i "A story about your broken heart. We women eat that stuff up."
    i "Una historia sobre tu corazón roto, las mujeres comemos esas cosas."

# game/Story03.rpy:10029

translate spanish ivy_meetings_f76abebe:

    # i "And besides - You owe me for running my mouth."
    i "Y además me debes por correr mi boca."

# game/Story03.rpy:10031

translate spanish ivy_meetings_d836cdb6:

    # mc "(When did it all fall apart… Was it when I tried to bring her back? Or when I lost my son?)"
    mc "(¿Cuándo se desmoronó todo... fue cuando intenté traerla de vuelta? ¿O cuando perdí a mi hijo?)"

# game/Story03.rpy:10033

translate spanish ivy_meetings_e2e3c42e:

    # mc "Most of my life, I lived in the dark. First hiding from my parents. Then from bullets. Just… trying to survive."
    mc "La mayor parte de mi vida, vivía en la oscuridad, primero escondiéndome de mis padres, luego de balas, solo... tratando de sobrevivir."

# game/Story03.rpy:10036

translate spanish ivy_meetings_91623206:

    # mc "Coward. That’s me in a word."
    mc "Cobarde. Soy yo en una palabra."

# game/Story03.rpy:10037

translate spanish ivy_meetings_6ac78bf5:

    # mc "And I’d have probably ended up in a ditch if not for her. My sun in the dark."
    mc "Y probablemente habría terminado en una zanja si no por ella. Mi sol en la oscuridad."

# game/Story03.rpy:10038

translate spanish ivy_meetings_00ebbaab:

    # mc "Until she was gone. Vanished. And when I saw her again… I was terrified."
    mc "Hasta que se fue, desapareció y cuando la vi de nuevo... estaba aterrorizada."

# game/Story03.rpy:10041

translate spanish ivy_meetings_6f3d4875_3:

    # i "..."
    i "..."

# game/Story03.rpy:10043

translate spanish ivy_meetings_8c46a397:

    # i "Really not gonna drink?"
    i "¿De verdad no vas a beber?"

# game/Story03.rpy:10045

translate spanish ivy_meetings_774e74cd:

    # mc "Yeah. No chance."
    mc "No hay posibilidad."

# game/Story03.rpy:10047

translate spanish ivy_meetings_86417fbc:

    # mc "The longer we were together, the more I realized — I didn’t know her at all."
    mc "Cuanto más tiempo estábamos juntos, más me di cuenta — no la conocía en absoluto."

# game/Story03.rpy:10048

translate spanish ivy_meetings_1fbc3140:

    # mc "And everything happening around us… just kept pressing down harder."
    mc "Y todo lo que pasa a nuestro alrededor... sigue presionando más."

# game/Story03.rpy:10053

translate spanish ivy_meetings_2998bd0d:

    # "Your eyes… you’ve been through a lot, haven’t you?"
    i "Tus ojos... has pasado por mucho, ¿no?"

# game/Story03.rpy:10055

translate spanish ivy_meetings_f575734b:

    # i "Working at the bar gave me some… perspective. And right now, it feels like you’re running on empty."
    i "Trabajar en el bar me dio una perspectiva... y ahora mismo, parece que estás huyendo."

# game/Story03.rpy:10056

translate spanish ivy_meetings_1b698103:

    # i "Maybe it’s time for a little reset? To unwind… what do you think?"
    i "Tal vez es hora de un pequeño reseteo? Para relajarse ... ¿Qué piensas?"

# game/Story03.rpy:10061

translate spanish ivy_meetings_a9dd689f:

    # i "To be honest, I`m.... A little wet there."
    i "Para ser honesto, estoy un poco mojado allí."

# game/Story03.rpy:10062

translate spanish ivy_meetings_d6764404:

    # i "And... It`s come out."
    i "Y... ha salido."

# game/Story03.rpy:10064

translate spanish ivy_meetings_eda93888:

    # mc "The current situation aside..."
    mc "La situación actual a un lado..."

# game/Story03.rpy:10065

translate spanish ivy_meetings_6ccd27b9:

    # mc "(Her unique scent and the odor of her sweat.)"
    mc "(Su olor único y el olor de su sudor.)"

# game/Story03.rpy:10066

translate spanish ivy_meetings_f263be33:

    # mc "(Keep clouding my mind.)"
    mc "(Mantengo nublando mi mente.)"

# game/Story03.rpy:10068

translate spanish ivy_meetings_8fd0aa02:

    # mc "(I don`t even know if I shoud be doing this right now.)"
    mc "(Ni siquiera sé si estoy haciendo esto ahora mismo)."

# game/Story03.rpy:10071

translate spanish ivy_meetings_9679a5de:

    # mc "(But...)"
    mc "(Pero...)"

# game/Story03.rpy:10079

translate spanish ivy_meetings_836c2dd8:

    # b "I don`t think I can just sit there and do nothing."
    b "No creo que pueda sentarme ahí y no hacer nada."

# game/Story03.rpy:10080

translate spanish ivy_meetings_eaf308af:

    # mc "Bigger than they look. I can admit..."
    mc "Más grande de lo que parecen."

# game/Story03.rpy:10081

translate spanish ivy_meetings_ed91868f:

    # mc "And heavy."
    mc "Y pesado."

# game/Story03.rpy:10082

translate spanish ivy_meetings_3123e11a:

    # i "Mmm… you really don’t waste time, do you?"
    i "Mmm... realmente no pierdes tiempo, ¿verdad?"

# game/Story03.rpy:10083

translate spanish ivy_meetings_d0513fad:

    # mc "Hard to resist when you’re this close."
    mc "Es difícil resistir cuando estás tan cerca."

# game/Story03.rpy:10084

translate spanish ivy_meetings_3198b206:

    # i "Ahh… careful— the way you touch me… it makes my head spin."
    i "Cuidado... la forma en que me tocas... me hace girar la cabeza."

# game/Story03.rpy:10085

translate spanish ivy_meetings_7ffccb94:

    # mc "Then I’ll be gentle… for now."
    mc "Entonces seré amable... por ahora."

# game/Story03.rpy:10086

translate spanish ivy_meetings_3c641fc2:

    # i "Don’t tease me like that. Every little move— I can feel it."
    i "No me engañes así. Cada pequeño movimiento - puedo sentirlo."

# game/Story03.rpy:10087

translate spanish ivy_meetings_a343fd67:

    # mc "You’re trembling. Do you like it this much?"
    mc "Estás temblando. ¿Te gusta tanto?"

# game/Story03.rpy:10088

translate spanish ivy_meetings_f9a20d87:

    # i "...More than I’d ever admit. Just… keep going."
    i "Más de lo que jamás admitiría."

# game/Story03.rpy:10089

translate spanish ivy_meetings_c2ba0730:

    # mc "Tell me what you want, Ivy."
    mc "Dime lo que quieras, Ivy."

# game/Story03.rpy:10090

translate spanish ivy_meetings_26b27d9b:

    # i "I want… all of you. Right here, right now."
