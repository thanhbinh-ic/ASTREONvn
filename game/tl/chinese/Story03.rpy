translate chinese endof3_5chapter_74800e06:

    # L "Calm down… don't get angry. We've been through this."
    L "冷静……别生气。这事我们已经过过一遍了。"

# game/Story03.rpy:10426
translate chinese endof3_5chapter_67a3c5f5:

    # L "You have no right to blame him."
    L "你没资格怪他。"

# game/Story03.rpy:10427
translate chinese endof3_5chapter_4236161c:

    # L "Alright… time to get to work."
    L "好了……该干活了。"

