translate chinese act3_5chapter1_ea4e48cd:

    # a "Move."
    a "走。"

# game/Story03.rpy:6677
translate chinese act3_5chapter1_1_d795864b:

    # gg "Stick together. Devices ready. If the Faceless shows up — shoot on sight."
    gg "跟紧了。设备准备好。无面者一出现——见着就开枪。"

# game/Story03.rpy:6680
translate chinese act3_5chapter1_1_f658a9ec:

    # mc "(Hard to breathe in here… like drowning on dry land.)"
    mc "（这儿呼吸困难……像在旱地上溺水。）"

# game/Story03.rpy:6682
translate chinese act3_5chapter1_1_812b1ee1:

    # mc "Head's cracking… Feels like someone’s splitting my skull with a hammer."
    mc "头疼得厉害……感觉有人拿锤子劈我脑袋。"

# game/Story03.rpy:6684
translate chinese act3_5chapter1_1_4025c210:

    # mc "(But whatever, Kalestra mention something about comms…)"
    mc "（不过算了，卡莱斯特拉提过通讯的事……）"

# game/Story03.rpy:6688
translate chinese act3_5chapter1_1_2406c0cf:

    # mc "(Messages… Yeah, right there.)"
    mc "（消息……对，就在那儿。）"

# game/Story03.rpy:6691
translate chinese act3_5chapter1_1_96af3308:

    # "Notification from Lora."
    "来自洛拉的通知。"

# game/Story03.rpy:6693
translate chinese act3_5chapter1_1_a3da06cd:

    # L "Thank you... for last night. I didn’t expect, after everything... for something inside to finally go quiet."
    L "谢谢你……为了昨晚。我没想到，经历了这一切之后……心里居然能有一部分终于安静下来。"

# game/Story03.rpy:6695
translate chinese act3_5chapter1_1_868ada83:

    # L "You became something like... a quiet place. Just for a few hours."
    L "你成了某种……安静的地方。哪怕只有几个小时。"

# game/Story03.rpy:6696
translate chinese act3_5chapter1_1_8da59526:

    # L "I saw you sleeping. Didn’t want to wake you. You earned it."
    L "我看见你睡着了。不想叫醒你。你值得这一觉。"

# game/Story03.rpy:6698
translate chinese act3_5chapter1_1_f1fdae68:

    # mc "(…There she is. The Lora I remember. Or at least… I want to believe so.)"
    mc "（……她在这儿。我记忆里的洛拉。或者至少……我愿意这么相信。）"

# game/Story03.rpy:6700
translate chinese act3_5chapter1_1_9fdcd41a:

    # L "I’m waiting at the command post. Left corridor, second door."
    L "我在指挥所等你。左边走廊，第二扇门。"

# game/Story03.rpy:6701
translate chinese act3_5chapter1_1_2b35b6fe:

    # mc "..."
    mc "……"

# game/Story03.rpy:6703
translate chinese act3_5chapter1_1_49064845:

    # "Notification from Lora, a few hours later."
    "几小时后，来自洛拉的通知。"

# game/Story03.rpy:6705
translate chinese act3_5chapter1_1_ac95a26a:

    # L "[mc], someone sold us out. It all went to hell."
    L "[mc]，有人出卖了我们。全完了。"

# game/Story03.rpy:6706
translate chinese act3_5chapter1_1_45814f48:

    # L "We tried to reach you. I swear. But we barely had anything left..."
    L "我们试过联系你。我发誓。可我们几乎什么都不剩了……"

# game/Story03.rpy:6708
translate chinese act3_5chapter1_1_49064845_1:

    # "Notification from Lora, a few hours later."
    "几小时后，来自洛拉的通知。"

# game/Story03.rpy:6709
translate chinese act3_5chapter1_1_897d24fe:

    # "5 missed calls."
    "5 个未接来电。"

# game/Story03.rpy:6711
translate chinese act3_5chapter1_1_994078b8:

    # L "Pick up. Please. I can’t just sit here. Not knowing..."
    L "接电话。求你。我不能就这么坐在这儿。什么都不知道……"

# game/Story03.rpy:6713
translate chinese act3_5chapter1_1_8323d9c2:

    # "16 missed calls."
    "16 个未接来电。"

# game/Story03.rpy:6714
translate chinese act3_5chapter1_1_4938d32b:

    # "Notification from Lora, a few minutes ago."
    "几分钟前，来自洛拉的通知。"

# game/Story03.rpy:6716
translate chinese act3_5chapter1_1_5947287e:

    # L "They’re evacuating us to Sector Three. Me and Olivia."
    L "他们要把我们撤到第 3 区。我和奥利维亚。"

# game/Story03.rpy:6717
translate chinese act3_5chapter1_1_d42872ab:

    # L "If you’re reading this — it means you’re alive. Which means: hold on. No heroics. Just... survive."
    L "你看到这条消息，就说明你还活着。也就是说：撑住。别逞英雄。只要……活下去。"

# game/Story03.rpy:6718
translate chinese act3_5chapter1_1_40b466f2:

    # L "I’ll come back. I swear."
    L "我会回来的。我发誓。"

# game/Story03.rpy:6720
translate chinese act3_5chapter1_1_6811166d:

    # mc "(You’ll come back… and I just have to stay alive long enough. Otherwise, what the hell was all this for?)"
    mc "（你会回来……我只要活得够久就行。不然这一切到底是为了什么？）"

# game/Story03.rpy:6721
translate chinese act3_5chapter1_1_43c3b59c:

    # mc "(Alone again. Tradition never dies, huh.)"
    mc "（又是一个人。老传统死不了，是吧。）"

# game/Story03.rpy:6724
translate chinese act3_5chapter1_1_af306000:

    # mc "(Fine. Get up. Keep moving.)"
    mc "（行。起来。继续走。）"

# game/Story03.rpy:6725
translate chinese act3_5chapter1_1_e0f9a635:

    # mc "(Pick up Miriel, find transport, meet Lora. That’s the list.)"
    mc "（接上米莉尔，找运输船，跟洛拉会合。就这几件事。）"

# game/Story03.rpy:6726
translate chinese act3_5chapter1_1_9e67394e:

    # mc "(Though… what made me think any plan around here ever holds together?)"
    mc "（不过……我怎么会以为这儿的计划能撑得住？）"

# game/Story03.rpy:6729
translate chinese act3_5chapter1_1_b0db7455:

    # k "So, hero. Savior. Tell me — is that glory on your breath, or just the stench of your own blood?"
    k "那么，英雄。救世主。告诉我——你呼出来的是荣耀，还是你自己血的味道？"

# game/Story03.rpy:6731
translate chinese act3_5chapter1_1_2117ee83:

    # mc "More like emptiness. Did what needed doing — but inside? Still feels like shit."
    mc "更像是空。该做的都做了——可心里？还是一团糟。"

# game/Story03.rpy:6738
translate chinese act3_5chapter1_1_9281e535:

    # k "Good. Welcome to the freak show, then."
    k "很好。那就欢迎加入怪胎秀。"

# game/Story03.rpy:6743
translate chinese act3_5chapter1_1_2ec7b8f8:

    # mc "Pretty sorry excuse for a show. But hey — still breathing. That’s worth something."
    mc "这秀可真够寒酸的。不过嘛——还喘着气。这就有点价值。"

# game/Story03.rpy:6746
translate chinese act3_5chapter1_1_75efbf1c:

    # k "Breathing is cheap. Dying spectacularly - Now thats priceless."
    k "喘气不值钱。死得惊天动地——那才叫无价。"

# game/Story03.rpy:6748
translate chinese act3_5chapter1_1_a3d66542:

    # k "Hm..."
    k "嗯……"

# game/Story03.rpy:6750
translate chinese act3_5chapter1_1_aa44912e:

    # k "Look at them. All starry-eyed because someone noticed their miserable existence."
    k "看看他们。就因为有人注意到他们那点可怜的存在，一个个眼冒星星。"

# game/Story03.rpy:6752
translate chinese act3_5chapter1_1_36e4cc20:

    # mc "What are you on about?"
    mc "你在说什么？"

# game/Story03.rpy:6756
translate chinese act3_5chapter1_1_a4f4912f:

    # k "Cannon fodder. Fireworks in human skin. They’d have been corpses already if they walked in alone."
    k "炮灰。披着人皮的烟花。要是他们自己进去，早成尸体了。"

# game/Story03.rpy:6760
translate chinese act3_5chapter1_1_cb0ec4ed:

    # k "But then you stumbled in, slapped my sister down, and dragged them out."
    k "可然后你闯进来，把我姐妹按下去，把他们拖了出来。"

# game/Story03.rpy:6762
translate chinese act3_5chapter1_1_14e6cd0c:

    # mc "Don’t call them meat. Everyone has their worth."
    mc "别管他们叫肉。每个人都有价值。"

# game/Story03.rpy:6765
translate chinese act3_5chapter1_1_0e4738b9:

    # mc "And yeah, I was in the dirt while you cleaned up."
    mc "是，你收拾残局的时候我在地上趴着。"

# game/Story03.rpy:6767
translate chinese act3_5chapter1_1_19a93b0b:

    # k "True."
    k "没错。"

# game/Story03.rpy:6770
translate chinese act3_5chapter1_1_73efd777:

    # k "But you had guts. Or the kind of stupidity I find entertaining."
    k "但你有胆。或者是那种我觉得有意思的蠢。"

# game/Story03.rpy:6776
translate chinese act3_5chapter1_1_91aa9ee6:

    # mc "Thanks. I’ll take that as a compliment — stupidity included."
    mc "谢了。我就当是夸奖——连蠢一起收下。"

# game/Story03.rpy:6778
translate chinese act3_5chapter1_1_504c96a0:

    # k "She’ll sulk for a while."
    k "她会生一阵闷气。"

# game/Story03.rpy:6781
translate chinese act3_5chapter1_1_59912dee:

    # k "Then either forgive you or slit your throat. Fifty-fifty."
    k "然后要么原谅你，要么割你喉咙。五五开。"

# game/Story03.rpy:6783
translate chinese act3_5chapter1_1_c959b280:

    # mc "Calculations... You know, I’m starting to understand why you are the way you are."
    mc "算概率……你知道吗，我开始明白你为什么是现在这样了。"

# game/Story03.rpy:6786
translate chinese act3_5chapter1_1_0e5a681d:

    # k "Oh? Do enlighten me."
    k "哦？说来听听。"

# game/Story03.rpy:6788
translate chinese act3_5chapter1_1_737f097e:

    # mc "Cold. Like everything’s the mission. Like machines."
    mc "冷。好像一切都是任务。像机器。"

# game/Story03.rpy:6791
translate chinese act3_5chapter1_1_812b74ec:

    # k "Mmm. Sharp tongue. Half-right. But unlike machines, I enjoy the mess."
    k "嗯。嘴挺利。对了一半。可跟机器不同，我享受这团乱。"

# game/Story03.rpy:6793
translate chinese act3_5chapter1_1_debcc36a:

    # mc "Maybe, but don’t you think there’s something off about this place?"
    mc "也许吧，可你不觉得这地方有点不对劲？"

# game/Story03.rpy:6794
translate chinese act3_5chapter1_1_3f21e5ce:

    # k "Too quiet. Too clean. Like a stage before the slaughter."
    k "太安静。太干净。像屠宰前的舞台。"

# game/Story03.rpy:6798
translate chinese act3_5chapter1_1_fc60f0c6:

    # mc "Yeah. Stay sharp."
    mc "嗯。保持警惕。"

# game/Story03.rpy:6799
translate chinese act3_5chapter1_1_4074beb7:

    # g "What's wrong with this place? Why's my head tearing apart?"
    g "这地方怎么回事？我头怎么像要裂开？"

# game/Story03.rpy:6801
translate chinese act3_5chapter1_1_a0f962ef:

    # gggg "Uh... I thought it was just me."
    gggg "呃……我还以为只有我这样。"

# game/Story03.rpy:6818
translate chinese act3_5chapter1_1_08cdef3d:

    # k "Maybe we should keep him. He looks fake enough to be useful bait."
    k "也许该留着他。他假得刚好能当诱饵。"

# game/Story03.rpy:6820
translate chinese act3_5chapter1_1_76f558a8:

    # mc "Kalestra?"
    mc "卡莱斯特拉？"

# game/Story03.rpy:6822
translate chinese act3_5chapter1_1_93334484:

    # k "What?"
    k "怎么？"

# game/Story03.rpy:6824
translate chinese act3_5chapter1_1_443cdf07:

    # mc "Since when can the Faceless affect the subconscious?"
    mc "无面者什么时候能影响潜意识了？"

# game/Story03.rpy:6826
translate chinese act3_5chapter1_1_82091822:

    # k "..."
    k "……"

# game/Story03.rpy:6831
translate chinese act3_5chapter1_1_e72b01c4:

    # gggg "Who... is that?"
    gggg "那……是谁？"

# game/Story03.rpy:6834
translate chinese act3_5chapter1_1_64783cc9:

    # gg "Looks like a Faceless."
    gg "看着像无面者。"

# game/Story03.rpy:6836
translate chinese act3_5chapter1_1_9f880b0b:

    # gggg "Nyx, we need to get out of here."
    gggg "尼克斯，我们得离开这儿。"

# game/Story03.rpy:6837
translate chinese act3_5chapter1_1_b4f7ad31:

    # gg "Cut the panic, grab the data for research. That’ll be more useful."
    gg "别慌，抓数据回去研究。那更有用。"

# game/Story03.rpy:6839
translate chinese act3_5chapter1_1_174ec2be:

    # a "They’ve started evolving."
    a "它们开始进化了。"

# game/Story03.rpy:6841
translate chinese act3_5chapter1_1_9c4a7209:

    # k "If that’s true… then everything just turned deliciously worse."
    k "要是真的……那一切就变得美味地更糟了。"

# game/Story03.rpy:6849
translate chinese act3_5chapter1_1_b6529b9b:

    # a "Leave. Now."
    a "撤。现在。"

# game/Story03.rpy:6852
translate chinese act3_5chapter1_1_850ef128:

    # b "..."
    b "……"

# game/Story03.rpy:6856
translate chinese act3_5chapter1_1_0472cfef:

    # g "What the hell was that monster!?"
    g "那怪物到底是什么？！"

# game/Story03.rpy:6858
translate chinese act3_5chapter1_1_789611ab:

    # gggg "How are we supposed to know."
    gggg "我们怎么知道。"

# game/Story03.rpy:6860
translate chinese act3_5chapter1_1_4ce08dcd:

    # g "Why didn't the device work?! It identifies those things fast!"
    g "设备怎么没反应？！它认那些东西一向很快！"

# game/Story03.rpy:6863
translate chinese act3_5chapter1_1_8f65ac9b:

    # gggg "I DON'T KNOW! HEAR ME, I DON'T KNOW!"
    gggg "我不知道！听清楚，我不知道！"

# game/Story03.rpy:6865
translate chinese act3_5chapter1_1_124a7f4e:

    # gg "Cut the panic, both of you."
    gg "别慌，你们两个。"

# game/Story03.rpy:6868
translate chinese act3_5chapter1_1_c2bdcbca:

    # mc "(Something’s off here… doesn’t add up.)"
    mc "（这儿不对劲……说不通。）"

# game/Story03.rpy:6870
translate chinese act3_5chapter1_1_6612100d:

    # mc "(Their reactions — they know. But why are they hiding it?)"
    mc "（他们的反应——他们知道。可为什么要藏？）"

# game/Story03.rpy:6873
translate chinese act3_5chapter1_1_f5ff0417:

    # mc "You {b}do{/b} know what that was, don’t you?"
    mc "你{b}确实{/b}知道那是什么，对吧？"

# game/Story03.rpy:6875
translate chinese act3_5chapter1_1_0484d506:

    # mc "(Aha. Wonderful. A wall of silence.)"
    mc "（啊哈。好极了。一堵沉默的墙。）"

# game/Story03.rpy:6877
translate chinese act3_5chapter1_1_dd0860a7:

    # mc "Well, Kalestra? Always clever. Maybe for once, be useful?"
    mc "怎么样，卡莱斯特拉？一向聪明。也许这次能派上用场？"

# game/Story03.rpy:6878
translate chinese act3_5chapter1_1_bf4d335d:

    # k "Not the slightest clue."
    k "一点头绪都没有。"

# game/Story03.rpy:6881
translate chinese act3_5chapter1_1_cc6c9da1:

    # k "(But if you don’t stick to me, you’ll be nothing but stains on the floor.)"
    k "（可你要是不黏着我，就只会变成地上的一摊污渍。）"

# game/Story03.rpy:6883
translate chinese act3_5chapter1_1_9ad54191:

    # mc "Ah, your living shield? Great prospect."
    mc "哦，你的活体盾牌？前景不错。"

# game/Story03.rpy:6885
translate chinese act3_5chapter1_1_3386e15d:

    # k "Better a shield than a corpse. Stay close, or start digging your grave."
    k "当盾总比当尸体强。跟紧点，不然就开始给自己挖坟。"

# game/Story03.rpy:6886
translate chinese act3_5chapter1_1_2b35b6fe_1:

    # mc "..."
    mc "……"

# game/Story03.rpy:6887
translate chinese act3_5chapter1_1_b0068f89:

    # mc "(I’ve… never seen her like that.)"
    mc "（我……从没见过她那样。）"

# game/Story03.rpy:6890
translate chinese act3_5chapter1_1_0d345e03:

    # k "And you really shouldn’t have."
    k "而你本来也不该见到。"

# game/Story03.rpy:6903
translate chinese act3_5chapter1_1_bf2aef3b:

    # mc "You give terrible directions..."
    mc "你指路指得真烂……"

# game/Story03.rpy:6904
translate chinese act3_5chapter1_1_db0bfed6:

    # k "And you follow them anyway."
    k "而你还不是照样跟着。"

# game/Story03.rpy:6906
translate chinese act3_5chapter1_1_56cefe88:

    # k "Follow me, unless you’re tired of breathing."
    k "跟我来，除非你活够了。"

# game/Story03.rpy:6909
translate chinese act3_5chapter1_1_47442c15:

    # gggg "What?! She just did that?!"
    gggg "什么？！她刚那么干了？！"

# game/Story03.rpy:6910
translate chinese act3_5chapter1_1_a18ec3af:

    # gg "Yeah, after her! Stick to her!"
    gg "对，跟上她！黏住她！"

# game/Story03.rpy:6923
translate chinese act3_5chapter2_9dcb3407:

    # gg "Come on, quick. Move in!"
    gg "快，动作快点。进去！"

# game/Story03.rpy:6929
translate chinese act3_5chapter2_2b35b6fe:

    # mc "..."
    mc "……"

# game/Story03.rpy:6930
translate chinese act3_5chapter2_f9b263fd:

    # mc "(Quiet. Just the hum of the generators. Strange… but right now it almost feels calming.)"
    mc "（安静。只有发电机的嗡鸣。奇怪……可现在几乎让人觉得平静。）"

# game/Story03.rpy:6936
translate chinese act3_5chapter2_3b69dd5f:

    # mc "(The road’s only starting, and they already look worn out. Like ghosts.)"
    mc "（路才刚开始，他们就已经看着累垮了。像鬼一样。）"

# game/Story03.rpy:6938
translate chinese act3_5chapter2_3f537c6a:

    # mc "(And me? Back in the mess again. Playing the hero. Figures.)"
    mc "（那我呢？又陷进这摊烂事里。又在演英雄。果然。）"

# game/Story03.rpy:6946
translate chinese act3_5chapter2_82091822:

    # k "..."
    k "……"

# game/Story03.rpy:6948
translate chinese act3_5chapter2_2b35b6fe_1:

    # mc "..."
    mc "……"

# game/Story03.rpy:6950
translate chinese act3_5chapter2_b60a13ec:

    # mc "You’re usually the loud one. What’s with the silence?"
    mc "你平时最吵。怎么突然安静了？"

# game/Story03.rpy:6953
translate chinese act3_5chapter2_df11187d:

    # k "Bored. Put on a show for me."
    k "无聊。给我演一出。"

# game/Story03.rpy:6955
translate chinese act3_5chapter2_2b35b6fe_2:

    # mc "..."
    mc "……"

# game/Story03.rpy:6958
translate chinese act3_5chapter2_b45dbbf4:

    # mc "Bored? After all that? We’re lucky we’re still breathing."
    mc "无聊？经历了那些？我们还活着就该谢天谢地了。"

# game/Story03.rpy:6968
translate chinese act3_5chapter2_fce91983:

    # k "Fear and sacrifice are so predictable. No theatrics — no worth. This whole thing tastes like wet ash."
    k "恐惧和牺牲太好猜了。没有戏剧性——就没价值。这一切尝起来像湿灰。"

# game/Story03.rpy:6970
translate chinese act3_5chapter2_1648d5a4:

    # mc "(Crazy. Definitely.)"
    mc "（疯。绝对疯了。）"

# game/Story03.rpy:6972
translate chinese act3_5chapter2_8ca36d9e:

    # k "Don't call me crazy right away. Just… different."
    k "别急着说我疯。只是……不一样。"

# game/Story03.rpy:6974
translate chinese act3_5chapter2_6d26a197:

    # mc "Fine. Different. Be that way."
    mc "行。不一样。随你。"

# game/Story03.rpy:6979
translate chinese act3_5chapter2_82091822_1:

    # k "..."
    k "……"

# game/Story03.rpy:6981
translate chinese act3_5chapter2_e3e600ac:

    # k "(whisper) Boredom is the last thing in me that still counts as human."
    k "（低声）无聊是我身上最后还算人的部分。"

# game/Story03.rpy:6983
translate chinese act3_5chapter2_0c328ca6:

