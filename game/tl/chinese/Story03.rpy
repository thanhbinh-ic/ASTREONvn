translate chinese endof3_5chapter_ba34bcb4:

    # L "I'll bring your sister back, no matter what it costs me. In return, I beg—"
    L "我会把你妹妹带回来，不管代价是什么。作为交换，我求你——"

# game/Story03.rpy:10375
translate chinese endof3_5chapter_efb02165:

    # L "Please... save my husband...."
    L "求你……救救我丈夫……"

