# game/Story03.rpy:19
translate chinese story04_00d95610:

    # mc "(...no. It can't be...)"
    mc "（……不。不可能……）"

# game/Story03.rpy:20
translate chinese story04_1787f1f5:

    # mc "You?.. Is that... you, Lora?"
    mc "你？……是你吗……洛拉？"

# game/Story03.rpy:22
translate chinese story04_e06376f1:

    # L "Yes. It's me."
    L "是我。真的是我。"

# game/Story03.rpy:28
translate chinese story04_b2e547a6:

    # L "You came back. I never thought I’d hear your voice again."
    L "你回来了。我本以为，这辈子再也听不到你的声音了。"

# game/Story03.rpy:29
translate chinese story04_689c8947:

    # L "I missed you. Though maybe that word no longer fits."
    L "我想你。虽然……这个词现在可能已经不合适了。"

# game/Story03.rpy:33
translate chinese story04_6edeb9bf:

    # mc "Where have you been..."
    mc "你这些年去哪儿了……"

# game/Story03.rpy:34
translate chinese story04_9693ff4f:

    # mc "I buried you, Lora. A hundred times. Inside myself, every single day."
    mc "我埋葬过你，洛拉。一百次。每一天，都在我心里。"

# game/Story03.rpy:36
translate chinese story04_4bff1c62:

    # L "I know."
    L "我知道。"

# game/Story03.rpy:39
translate chinese story04_2104d9cc:

    # Lor "I saw it. I knew you were suffering, and I still didn’t come back."
    Lor "我看得见。我知道你在受苦，可我还是没有回来。"

# game/Story03.rpy:41
translate chinese story04_091c44b3:

    # mc "No. Don’t say 'sorry'. You left. Without a word. No sign. Not even a trace."
    mc "别。别说“对不起”。你走了。一声不吭。没有消息。连一点痕迹都没有。"

# game/Story03.rpy:42
translate chinese story04_a102a2a9:

    # mc "You knew where we were… where I was?"
    mc "你知道我们在哪儿……知道我在哪儿？"

# game/Story03.rpy:44
translate chinese story04_109280b3:

    # L "Yes."
    L "知道。"

# game/Story03.rpy:47
translate chinese story04_c2e3037b:

    # Lor "Yes, I knew. But what would you have done, if you’d seen me then? You would’ve left everything behind... and I couldn’t allow that."
    Lor "是，我知道。可要是那时候你见到我，你会怎么做？你会抛下一切……我不能让你那么做。"

# game/Story03.rpy:49
translate chinese story04_447d9e02:

    # mc "Then why the hell didn’t you come back, Lora?!"
    mc "那你他妈为什么不回来，洛拉？！"

# game/Story03.rpy:51
translate chinese story04_e134de77:

    # L "Because I was afraid."
    L "因为我怕。"

# game/Story03.rpy:54
translate chinese story04_46808b66:

    # Lor "Afraid that I had become something... foreign to you. Not the one you loved. And maybe I was right."
    Lor "怕我已经变成了某种……对你来说很陌生的东西。不再是那个你爱的人了。也许我想得没错。"

# game/Story03.rpy:57
translate chinese story04_0dd22f79:

    # mc "Did you really think it would all just end like that?"
    mc "你真以为一切就这么结束了？"

# game/Story03.rpy:58
translate chinese story04_7fac3b9d:

    # mc "That I’d forget you? Lora... I couldn’t."
    mc "以为我会忘了你？洛拉……我做不到。"

# game/Story03.rpy:63
translate chinese story04_d7c60a8b:

    # Lor "Too much time passed. You should’ve forgotten me. And if you didn’t, it means you didn’t even try."
    Lor "过了太久了。你本该忘了我。要是没忘，那说明你根本没试过。"

# game/Story03.rpy:65
translate chinese story04_f7c2b896:

    # mc "I did. I really tried."
    mc "我试过。我真的试过。"

# game/Story03.rpy:67
translate chinese story04_aedac61c:

    # mc "But you... you were here. This whole time."
    mc "可你……你一直在这儿。一直都在。"

# game/Story03.rpy:68
translate chinese story04_82731c49:

    # mc "And I never did learn how to live without you."
    mc "而我始终没学会，怎么在没有你的日子里活下去。"

# game/Story03.rpy:70
translate chinese story04_981b7eb6:

    # h "(whispering) What the... Who's he talking to?"
    h "（低声）搞什么……他在跟谁说话？"

# game/Story03.rpy:75
translate chinese story04_6f6282c5:

    # Lor "But without him, you learned how to live, somehow..."
    Lor "可没有他，你居然还是学会了怎么活下去……"

# game/Story03.rpy:79
translate chinese story04_e97ead16:

    # Lor "Without Norman... like he never even existed."
    Lor "没有诺曼……就好像他从来没存在过一样。"

# game/Story03.rpy:80
translate chinese story04_2149c470:

    # Lor "Or do you really think another death is going to fix anything?"
    Lor "还是说，你真觉得再死一个人，就能解决什么？"

# game/Story03.rpy:82
translate chinese story04_3cbe046e:

    # mc "Don’t use him against me."
    mc "别拿他来戳我。"

# game/Story03.rpy:83
translate chinese story04_e58ba996:

    # mc "Norman was my son. Losing him broke what was left of me."
    mc "诺曼是我儿子。失去他，把我仅剩的那点东西也打碎了。"

# game/Story03.rpy:89
translate chinese story04_3d95eabc:

    # Lor "But darling... he died because of you. Or is one death not enough anymore?"
    Lor "可亲爱的……他是因为你才死的。还是说，现在死一个已经不够了？"

# game/Story03.rpy:91
translate chinese story04_5692bc1c:

    # mc "I tried to keep him alive."
    mc "我尽力想让他活下来。"

# game/Story03.rpy:92
translate chinese story04_1468a32e:

    # mc "I warned him. I thought that was enough."
    mc "我警告过他。我以为那就够了。"

# game/Story03.rpy:94
translate chinese story04_f7caa822:

    # mc "It wasn’t."
    mc "可不够。"

# game/Story03.rpy:95
translate chinese story04_450985e2:

    # mc "…It should’ve been me."
    mc "……该死的本该是我。"

# game/Story03.rpy:109
translate chinese story04_9f7e9294:

    # L "(whispers) Don’t you dare..."
    L "（低声）你敢……"

# game/Story03.rpy:111
translate chinese story04_55c64335:

    # mc "(…Is it really…?)"
    mc "（……真的是……？）"

# game/Story03.rpy:113
translate chinese story04_4037283f:

    # mc "(Whispering)...You..."
    mc "（低声）……你……"

# game/Story03.rpy:119
translate chinese story04_b74da216:

    # mc "…I don’t even know what to say."
    mc "……我都不知道该说什么了。"

# game/Story03.rpy:121
translate chinese story04_4013b666:

    # L "...Do you still remember how to do this?"
    L "……你还记得该怎么做吗？"

# game/Story03.rpy:125
translate chinese story04_96759569:

    # mc "Every second. Without you, they were all the same."
    mc "每一秒。没有你，每一秒都一样。"

# game/Story03.rpy:127
translate chinese story04_8fe462ec:

    # L "This... isn't right."
    L "这……不对。"

# game/Story03.rpy:128
translate chinese story04_24e53ddb:

    # L "I shouldn't have come back. Not like this."
    L "我不该回来的。不该这样回来。"

# game/Story03.rpy:130
translate chinese story04_7fc6a47c:

    # mc "But you did."
    mc "可你回来了。"

# game/Story03.rpy:132
translate chinese story04_c09b6015:

    # mc "What happened to you?"
    mc "你到底经历了什么？"

# game/Story03.rpy:140
translate chinese story04_8ff4a7cf:

    # mc "Lora… what is it?"
    mc "洛拉……怎么了？"

# game/Story03.rpy:142
translate chinese story04_4f00bda4:

    # L "I’m sorry."
    L "对不起。"

# game/Story03.rpy:149
translate chinese story04_63b146ae:

    # mc "(A scar?.. No. Something darker.)"
    mc "（一道疤？……不。是更黑暗的东西。）"

# game/Story03.rpy:151
translate chinese story04_26be1618:

    # mc "…Hey."
    mc "……喂。"

# game/Story03.rpy:152
translate chinese story04_c09b6015_1:

    # mc "What happened to you?"
    mc "你到底经历了什么？"

# game/Story03.rpy:155
translate chinese story04_099892fb:

    # mc "Who did this?"
    mc "谁干的？"

# game/Story03.rpy:157
translate chinese story04_7fbb8c05:

    # L "I did."
    L "我自己。"

# game/Story03.rpy:158
translate chinese story04_a09b8be3:

    # L "And now... I don’t even know what hurts more, that I left..."
    L "而现在……我都不知道哪样更痛，是我离开了……"

# game/Story03.rpy:160
translate chinese story04_a9d41133:

    # L "Or that you were still waiting."
    L "还是你一直在等我。"

# game/Story03.rpy:164
translate chinese story04_69210536:

    # mc "What are you talking about?.."
    mc "你在说什么……？"

# game/Story03.rpy:168
translate chinese story04_76f31adf:

    # mc "(That look… you’re hiding something.)"
    mc "（那个眼神……你在瞒着我什么。）"

# game/Story03.rpy:170
translate chinese story04_7f1d93fd:

    # L "I missed you. Your voice. Just... an ordinary day with you."
    L "我想你。想你的声音。只是……和你一起过个普普通通的日子。"

# game/Story03.rpy:173
translate chinese story04_fe6fb19d:

    # L "All those years, I was alive. Physically."
    L "这些年，我活着。只是身体活着。"

# game/Story03.rpy:174
translate chinese story04_16904d01:

    # L "But every day, it was like an equation with no variable."
    L "可每一天，都像一道没有未知数的方程。"

# game/Story03.rpy:175
translate chinese story04_5110e779:

    # L "Without you... everything was zero."
    L "没有你……一切都归零。"

# game/Story03.rpy:186
translate chinese story04_7fcccf49:

    # mc "(Consequences? What consequences is she talking about?)"
    mc "（代价？她在说什么代价？）"

# game/Story03.rpy:188
translate chinese story04_c09b6015_2:

    # mc "What happened to you?"
    mc "你到底经历了什么？"

# game/Story03.rpy:189
translate chinese story04_558667b5:

    # L "I... I can’t."
    L "我……我不能说。"

# game/Story03.rpy:191
translate chinese story04_61ec747c:

    # mc "I’ll find out."
    mc "我会查出来的。"

# game/Story03.rpy:192
translate chinese story04_7147ceab:

    # mc "Today or tomorrow, doesn’t matter."
    mc "今天还是明天，都无所谓。"

# game/Story03.rpy:193
translate chinese story04_b85195f7:

    # mc "But I’m not pretending this is okay."
    mc "但我不会装作这一切都没问题。"

# game/Story03.rpy:195
translate chinese story04_d59826a8:

    # L "If only you knew... If only you knew..."
    L "你要是知道就好了……你要是知道就好了……"

# game/Story03.rpy:197
translate chinese story04_a3fc761c:

    # mc "Then tell me."
    mc "那就告诉我。"

# game/Story03.rpy:199
translate chinese story04_622524e1:

    # L "(Whispering) They followed us."
    L "（低声）他们跟过来了。"

# game/Story03.rpy:200
translate chinese story04_f469b75f:

    # L "Just... not now. Please."
    L "只是……不是现在。求你。"

# game/Story03.rpy:202
translate chinese story04_cfcc2293:

    # mc "I know."
    mc "我知道。"

# game/Story03.rpy:204
translate chinese story04_e4c77888:

    # L "You..."
    L "你……"

# game/Story03.rpy:205
translate chinese story04_2ba0bdc4:

    # L "...How?"
    L "……怎么会？"

# game/Story03.rpy:209
translate chinese story04_745afed5:

    # L "Of course..."
    L "当然了……"

# game/Story03.rpy:217
translate chinese story04_f089ed0c:

    # h "But why didn’t you come back?"
    h "可你为什么不回来？"

# game/Story03.rpy:219
translate chinese story04_a3be6999:

    # h "You had a chance to, didn’t you? So why?"
    h "你本来有机会的，对吧？那为什么？"

# game/Story03.rpy:221
translate chinese story04_2653b46c:

    # L "No."
    L "没有。"

# game/Story03.rpy:222
translate chinese story04_59c0a608:

    # L "There was no way back to Earth."
    L "没有回地球的路。"

# game/Story03.rpy:223
translate chinese story04_d179bf39:

    # mc "Then how did you find me now?"
    mc "那你现在怎么找到我的？"

# game/Story03.rpy:224
translate chinese story04_ed86f246:

    # L "The marker you picked up in the tomb."
    L "你在墓里捡到的那个标记物。"

# game/Story03.rpy:225
translate chinese story04_a78e1c09:

    # L "When the Tower came online, it briefly opened an old Ark channel."
    L "高塔上线的时候，短暂打开了一条旧的方舟频道。"

# game/Story03.rpy:226
translate chinese story04_7fad189c:

    # L "Your friend managed to send me a message."
    L "你的朋友设法给我发了条消息。"

# game/Story03.rpy:227
translate chinese story04_fb7de46e:

    # L "Said you’d be waiting at Blue Moon."
    L "说你在蓝月等我。"

# game/Story03.rpy:228
translate chinese story04_03171757:

    # L "So..."
    L "所以……"

# game/Story03.rpy:229
translate chinese story04_7bf8dd80:

    # L "Here I am."
    L "我来了。"

# game/Story03.rpy:238
translate chinese story04_b145c72e:

    # h "Ahem..."
    h "咳……"

# game/Story03.rpy:240
translate chinese story04_052cb094:

    # h "Lora... if you can’t tell him, then show him. Let him feel it. That bastard’s not going anywhere. You know him."
    h "洛拉……你要是说不出口，就做给他看。让他感受到。那混蛋又不会跑。你了解他。"

# game/Story03.rpy:242
translate chinese story04_d9e5f7d7:

    # h "And you, stop burning holes in her with that stare. You’re not her executioner."
    h "还有你，别拿那种眼神把她盯出洞来。你又不是她的刽子手。"

# game/Story03.rpy:247
translate chinese story04_2c9a0519:

    # mc "…Yeah."
    mc "……嗯。"

# game/Story03.rpy:248
translate chinese story04_f3c5e835:

    # mc "Guess I don’t have much to add."
    mc "看来我也没什么好补充的。"

# game/Story03.rpy:249
translate chinese story04_d26074a8:

    # mc "Well… maybe one thing."
    mc "好吧……也许有一件事。"

# game/Story03.rpy:250
translate chinese story04_38b71016:

    # mc "That time you blew up half the house with that rose experiment."
    mc "那次你搞那个玫瑰实验，炸了半栋房子。"

# game/Story03.rpy:251
translate chinese story04_59708e36:

    # mc "Took me forever to fix it."
    mc "我修了老半天才修好。"

# game/Story03.rpy:252
translate chinese story04_3c7e26c7:

    # mc "…Still worth it."
    mc "……但还是值。"

# game/Story03.rpy:254
translate chinese story04_91950207:

    # L "Yeah. My calculations were off."
    L "是啊。我算错了。"

# game/Story03.rpy:255
translate chinese story04_606cf633:

    # L "But we both know, chaos was always your element, not mine."
    L "可我们都知道，混乱一直是你的主场，不是我的。"

# game/Story03.rpy:258
translate chinese story04_6947410e:

    # mc "(That’s not like her.)"
    mc "（这不像她。）"

# game/Story03.rpy:259
translate chinese story04_ab72f821:

    # mc "(Too calm.)"
    mc "（太冷静了。）"

# game/Story03.rpy:261
translate chinese story04_ae37c2cf:

    # mc "You remember that trip we planned?"
    mc "你还记得我们计划的那次旅行吗？"

# game/Story03.rpy:262
translate chinese story04_087b569c:

    # mc "To take Olivia and Anya on-"
    mc "带奥利维亚和安雅去——"

# game/Story03.rpy:264
translate chinese story04_6e2a6180:

    # h "...There’s so much in both your eyes right now, and I can’t read any of it."
    h "……你们俩现在眼里都装着太多东西，可我一个字都读不懂。"

# game/Story03.rpy:269
translate chinese story04_7974f397:

    # mc "Lora… you okay?"
    mc "洛拉……你没事吧？"

# game/Story03.rpy:271
translate chinese story04_32f63395:

    # L "I’m fine. As much as one can be."
    L "我没事。能多好就多好吧。"

# game/Story03.rpy:272
translate chinese story04_a32d8505:

    # L "Don’t get hung up on it."
    L "别揪着不放。"

# game/Story03.rpy:274
translate chinese story04_7d010a14:

    # mc "What happened?"
    mc "出什么事了？"

# game/Story03.rpy:276
translate chinese story04_649f8f8c:

    # L "You’re mistaken."
    L "你弄错了。"

# game/Story03.rpy:277
translate chinese story04_9a797f5e:

    # L "Everything’s fine. Just..."
    L "一切都好。只是……"

# game/Story03.rpy:281
translate chinese story04_2369dd01:

    # L "(whispering) I'm scared..."
    L "（低声）我怕……"

# game/Story03.rpy:283
translate chinese story04_b633dac2:

    # L "(whispering) ...to losing you again..."
    L "（低声）……怕再一次失去你……"

# game/Story03.rpy:285
translate chinese story04_174d390f:

    # h "Take the step, even if it scares you. He’ll be there to catch you."
    h "迈出那一步，就算怕也要迈。他会接住你的。"

# game/Story03.rpy:291
translate chinese story04_9861b9aa:

    # mc "Why."
    mc "为什么。"

# game/Story03.rpy:296
translate chinese story04_b37827eb:

    # mc "Look at me."
    mc "看着我。"

# game/Story03.rpy:297
translate chinese story04_085fe47d:

    # mc "No secrets."
    mc "不许有秘密。"

# game/Story03.rpy:301
translate chinese story04_1c4b4b57:

    # L "...I saw."
    L "……我看见了。"

# game/Story03.rpy:303
translate chinese story04_b7437275:

    # L "...Your death."
    L "……你的死。"

# game/Story03.rpy:304
translate chinese story04_160d35e0:

    # L "A lot... of time."
    L "很多次……很多次。"

# game/Story03.rpy:311
translate chinese story04_2fd078aa:

    # L "Again. And again."
    L "一次又一次。"

# game/Story03.rpy:313
translate chinese story04_39bb903f:

    # mc "My… death?"
    mc "我的……死？"

# game/Story03.rpy:315
translate chinese story04_79f5f4d6:

    # L "Sometimes knowing ruins more than not knowing ever could."
    L "有时候，知道了比不知道毁得更多。"

# game/Story03.rpy:319
translate chinese story04_fbd4fe29:

    # L "You haven’t changed. Still stubborn as ever."
    L "你没变。还是那么犟。"

# game/Story03.rpy:322
translate chinese story04_79c3a04e:

    # mc "(That tone… she’s holding something back.)"
    mc "（那个语气……她藏着什么。）"

# game/Story03.rpy:324
translate chinese story04_af8d8acb:

    # L "Do we have time?"
    L "我们还有时间吗？"

# game/Story03.rpy:332
translate chinese story04_d5cf79d5:

    # mc "…Why would you ask that?"
    mc "……你为什么这么问？"

# game/Story03.rpy:333
translate chinese story04_410527e4:

    # L "...Because I’m not sure we do."
    L "……因为我不确定我们还有。"

# game/Story03.rpy:334
translate chinese story04_0fe7e331:

    # mc "Of course we-"
    mc "我们当然——"

# game/Story03.rpy:338
translate chinese story04_b8989d76:

    # mc "(Inquisition?)"
    mc "（审判庭？）"

# game/Story03.rpy:340
translate chinese story04_bb8e4b4e:

    # a "..."
    a "……"

# game/Story03.rpy:341
translate chinese story04_41f19d44:

    # mc "(First Kalestra, now this one...)"
    mc "（先是卡莱斯特拉，现在又来一个……）"

# game/Story03.rpy:343
translate chinese story04_4b624790:

    # aa "..."
    aa "……"

# game/Story03.rpy:347
translate chinese story04_9a58adc6:

    # a "No."
    a "不行。"

# game/Story03.rpy:353
translate chinese story04_f0581a1d:

    # L "Please. I know you disapprove."
    L "求你了。我知道你不同意。"

# game/Story03.rpy:355
translate chinese story04_14c49c9b:

    # L "But... I need this."
    L "可是……我需要这个。"

# game/Story03.rpy:362
translate chinese story04_bb8e4b4e_1:

    # a "..."
    a "……"

# game/Story03.rpy:367
translate chinese story04_1fa854c9:

    # a "Make it quick."
    a "快点。"

# game/Story03.rpy:369
translate chinese story04_5516dce5:

    # L "How generous of you. In your own way."
    L "你可真大方。用你自己的方式。"

# game/Story03.rpy:372
translate chinese story04_bb8e4b4e_2:

    # a "..."
    a "……"

# game/Story03.rpy:376
translate chinese story04_8eb62a7b:

    # mc "…And?"
    mc "……然后呢？"

# game/Story03.rpy:377
translate chinese story04_845c4c57:

    # mc "What was that?"
    mc "刚刚那是什么？"

# game/Story03.rpy:383
translate chinese story04_7389f188:

    # L "A reminder."
    L "一个提醒。"

# game/Story03.rpy:386
translate chinese story04_e7e4542c:

    # L "That I’m free to do as I please..."
    L "提醒我，我可以随心所欲……"

# game/Story03.rpy:387
translate chinese story04_99643d72:

    # L "...until something I do interferes with Astoria’s plan."
    L "……直到我做的事碍着阿斯托里亚的计划。"

# game/Story03.rpy:388
translate chinese story04_97ba344a:

    # mc "And she decides where that line is?"
    mc "那条线由她来定？"

# game/Story03.rpy:397
translate chinese story04_dd06bbeb:

    # L "That’s why she follows me."
    L "所以她跟着我。"

# game/Story03.rpy:398
translate chinese story04_4e08a439:

    # L "Not to keep me in a cage."
    L "不是为了把我关进笼子。"

# game/Story03.rpy:399
translate chinese story04_96b19c71:

    # L "To make sure I remain useful."
    L "是为了确保我还有用。"

# game/Story03.rpy:401
translate chinese story04_b123a601:

    # L "I sleep, she files a report."
    L "我睡觉，她打报告。"

# game/Story03.rpy:402
translate chinese story04_e91570b5:

    # L "I stay silent, they monitor my breathing."
    L "我不说话，他们监测我的呼吸。"

# game/Story03.rpy:405
translate chinese story04_850ef128:

    # b "..."
    b "……"

# game/Story03.rpy:406
translate chinese story04_b2e20135:

    # L "And now she’s gone. For a few minutes. I almost feel alive."
    L "现在她走了。就几分钟。我几乎觉得自己还活着。"

# game/Story03.rpy:408
translate chinese story04_99572bcd:

    # mc "…Right."
    mc "……是啊。"

# game/Story03.rpy:409
translate chinese story04_57364719:

    # mc "Doesn’t sound like freedom."
    mc "这听起来可不叫自由。"

# game/Story03.rpy:412
translate chinese story04_cdf17c90:

    # h "Heard you’re kind of a big deal around here... So why’s your cage all rust and no gold?"
    h "听说你在这儿算个人物……那你这笼子怎么全是锈，没一点金？"

# game/Story03.rpy:415
translate chinese story04_e13941b9:

    # h "Where are the servants, the wine cellar, the friendly beast who doesn’t try to eat your face?"
    h "仆从呢？酒窖呢？那只不咬你脸的温顺野兽呢？"

# game/Story03.rpy:416
translate chinese story04_394b8b2e:

    # h "Although, if you want the latter, we do have some ideas."
    h "不过，你要是想要最后那个，我们倒是有几个主意。"

# game/Story03.rpy:422
translate chinese story04_a4d4c4bb:

    # L "A broom closet for a home, a warden for a nanny, and creatures who think I’m dinner with a side of fear."
    L "家是个扫帚间，保姆是个狱警，还有一群把我当晚餐、配菜是恐惧的东西。"

# game/Story03.rpy:423
translate chinese story04_ab6ba2a5:

    # L "Yeah, I’ve really made it."
    L "是啊，我可真是混出头了。"

# game/Story03.rpy:425
translate chinese story04_c38253f0:

    # h "Ironically? Yeah. You definitely win this round of misery bingo."
    h "讽刺的是？是啊。这轮比惨大会你稳赢。"

# game/Story03.rpy:427
translate chinese story04_6a7adb0c:

    # mc "I’ll bring something next time."
    mc "下次我带点东西来。"

# game/Story03.rpy:428
translate chinese story04_39dec636:

    # mc "We’ll figure something out."
    mc "我们会想办法的。"

# game/Story03.rpy:430
translate chinese story04_ed4d1fb3:

    # h "Knew it. You’re not here by choice. Fairy tales always lie..."
    h "我就知道。你不是自愿待在这儿的。童话全是骗人的……"

# game/Story03.rpy:431
translate chinese story04_a4bf996b:

    # L "Give me a heads up. I’ll pick out someone’s arm for a treat."
    L "提前跟我说一声。我挑条胳膊当零食。"

# game/Story03.rpy:433
translate chinese story04_850ef128_1:

    # b "..."
    b "……"

# game/Story03.rpy:438
translate chinese story04_a34fa0dd:

    # L "But seriously, how did you get here?"
    L "不过说真的，你们怎么到这儿来的？"

# game/Story03.rpy:439
translate chinese story04_bd645c39:

    # L "You both look... worn out. But just as stubborn as ever."
    L "你们俩看着……都累坏了。可还是跟以前一样犟。"

# game/Story03.rpy:441
translate chinese story04_3858a940:

    # h "Great question... We’ve got no idea ourselves."
    h "问得好……我们自己也不知道。"

# game/Story03.rpy:442
translate chinese story04_17171e8e:

    # h "One moment you’re staring at some rift, next thing, boom. Different galaxy."
    h "前一秒还在盯着什么裂隙，下一秒，砰。换了个星系。"

# game/Story03.rpy:444
translate chinese story04_385043df:

    # mc "We’re somewhere in the Ark Federation. Got pulled in through a gate."
    mc "我们在方舟联邦的某处。被一道门吸进来的。"

# game/Story03.rpy:446
translate chinese story04_ff853847:

    # mc "Everything else?"
    mc "其他的？"

# game/Story03.rpy:447
translate chinese story04_6410bc11:

    # mc "Complicated."
    mc "一言难尽。"

# game/Story03.rpy:456
translate chinese story04_cbf53f8d:

    # L "Yeah, sounds like their style..."
    L "是啊，听着就像他们的作风……"

# game/Story03.rpy:460
translate chinese story04_ab5bdcd7:

    # mc "You seem better now."
    mc "你现在看着好多了。"

# game/Story03.rpy:461
translate chinese story04_4a4f1156:

    # mc "Was it because of her?"
    mc "是因为她吗？"

# game/Story03.rpy:463
translate chinese story04_c53091ff:

    # L "Partially. But not really."
    L "有一部分。但也不全是。"

# game/Story03.rpy:464
translate chinese story04_a3c688b1:

    # L "It’s still hard to meet your eyes. For what I did... or failed to do."
    L "还是很难直视你的眼睛。为了我做过的事……或者没做成的事。"

# game/Story03.rpy:466
translate chinese story04_1fd2a000:

    # mc "No desire to talk about it?"
    mc "不想聊聊？"

# game/Story03.rpy:468
translate chinese story04_9055231a:

    # L "I want to. Just..."
    L "我想。只是……"

# game/Story03.rpy:470
translate chinese story04_5d7b4cfa:

    # L "I’ve lost too much already to ruin this moment too."
    L "我已经失去太多了，不能再毁掉这一刻。"

# game/Story03.rpy:472
translate chinese story04_94ce1bed:

    # mc "(…Why?)"
    mc "（……为什么？）"

# game/Story03.rpy:473
translate chinese story04_b4154502:

    # mc "(We’re not strangers.)"
    mc "（我们又不是陌生人。）"

# game/Story03.rpy:474
translate chinese story04_280e93cc:

    # mc "(So what’s stopping you?)"
    mc "（那是什么拦着你？）"

# game/Story03.rpy:476
translate chinese story04_0b348ba0:

    # mc "…Alright."
    mc "……好吧。"

# game/Story03.rpy:479
translate chinese story04_c75a513b:

    # h "Seriously, [mc]? We crawled through a grinder to get here, and now you’re acting like some schoolboy too shy to confess a crush?"
    h "不是吧，[mc]？我们一路从绞肉机里爬过来，你现在倒像个不敢表白的男学生？"

# game/Story03.rpy:480
translate chinese story04_601a66eb:

    # h "Where’s the fist on the table, the big words? All that dramatic crap you usually throw at us?"
    h "拍桌子呢？狠话呢？你平时冲我们甩的那套戏剧腔呢？"

# game/Story03.rpy:483
translate chinese story04_06763333:

    # h "Where’s the explosion? The storm of emotions? Where’s your damn passion!"
    h "爆发呢？情绪风暴呢？你那股该死的激情呢！"

# game/Story03.rpy:485
translate chinese story04_6cba907f:

    # mc "You know what, she’s got a point. We haven’t seen each other in so long..."
    mc "说得也是，她说得对。我们这么久没见了……"

# game/Story03.rpy:486
translate chinese story04_b6cdb87f:

    # mc "You know you’re a grandmother now?"
    mc "你知道自己已经当奶奶了吗？"

# game/Story03.rpy:489
translate chinese story04_4eefabd0:

    # L "WHAT?!"
    L "什么？！"

# game/Story03.rpy:492
translate chinese story04_25a271ee:

    # L "Wait. I already was, wasn’t I? You mean Mina?"
    L "等等。我本来就是了吧？你是说米娜？"

# game/Story03.rpy:495
translate chinese story04_035af7ae:

    # mc "…You still remember."
    mc "……你还记得。"

# game/Story03.rpy:497
translate chinese story04_c475d1b7:

    # L "Of course! How could I forget that darling. How’s she doing?"
    L "当然！我怎么会忘了那孩子。她怎么样了？"

# game/Story03.rpy:499
translate chinese story04_3e6cb3d6:

    # mc "You wouldn’t recognize her now."
    mc "你现在见了都认不出来了。"

# game/Story03.rpy:501
translate chinese story04_d12a027a:

    # L "Ha, I don’t doubt it. It’s been so many years..."
    L "哈，我不怀疑。都这么多年了……"

# game/Story03.rpy:502
translate chinese story04_8f0b9724:

    # L "Mina was always the light of my life. Those big eyes... I hope she’s happy."
    L "米娜一直是我生命里的光。那双大眼睛……我希望她过得开心。"

# game/Story03.rpy:504
translate chinese story04_7c895712:

    # mc "She’s doing alright."
    mc "她过得还行。"

# game/Story03.rpy:506
translate chinese story04_9843fbce:

    # L "And Anya?"
    L "安雅呢？"

# game/Story03.rpy:508
translate chinese story04_a3fe42da:

    # mc "Anya?"
    mc "安雅？"

# game/Story03.rpy:509
translate chinese story04_a7955f60:

    # mc "Still the same."
    mc "还是老样子。"

# game/Story03.rpy:511
translate chinese story04_3cf0cef0:

    # h "She’s a bit more tolerable now. Well... mostly."
    h "她现在稍微能忍一点了。好吧……大部分时候。"

# game/Story03.rpy:512
translate chinese story04_7f1d2572:

    # h "Sometimes you can even forget she’s a walking disaster wrapped in a cute package."
    h "有时候你甚至能忘了，她是个包在可爱外壳里的行走灾难。"

# game/Story03.rpy:515
translate chinese story04_ffe217b7:

    # L "You still run that bar?"
    L "你还在开那家酒吧？"

# game/Story03.rpy:517
translate chinese story04_866b7c7a:

    # h "Of course. It’s my life! {w}Okay, third place. First is Anya."
    h "当然。那是我的命！{w}好吧，排第三。第一是安雅。"

# game/Story03.rpy:519
translate chinese story04_7495d250:

    # mc "Third? Not second?"
    mc "第三？不是第二？"

# game/Story03.rpy:522
translate chinese story04_8dde6d4c:

    # h "Nope. Second’s personal."
    h "不。第二是私事。"

# game/Story03.rpy:524
translate chinese story04_6ef9730a:

    # h "And don’t go digging. Nothing pretty down there."
    h "别刨根问底。底下没什么好看的。"

# game/Story03.rpy:528
translate chinese story04_0b1cb94a:

    # L "You two got close. Maybe too close."
    L "你们俩挺亲近。也许太亲近了。"

# game/Story03.rpy:530
translate chinese story04_3eff1c52:

    # L "I’m beginning to suspect you’re poaching my husband."
    L "我开始怀疑你在挖我丈夫的墙角。"

# game/Story03.rpy:532
translate chinese story04_0ac3693b:

    # h "Too late, Lora. He’s mine now, willingly and begrudgingly."
    h "晚了，洛拉。他现在是我的了，心甘情愿，又满不情愿。"

# game/Story03.rpy:533
translate chinese story04_c3482f25:

    # h "Every Friday: coffee, complaining, and my genius plans. I think he’s even starting to enjoy it. Or he’s just given up."
    h "每周五：咖啡、抱怨、还有我的天才计划。我觉得他甚至开始享受了。要么就是认命了。"

# game/Story03.rpy:535
translate chinese story04_7ecdcdb3:

    # mc "You never add sugar."
    mc "你从来不加糖。"

# game/Story03.rpy:537
translate chinese story04_96aae327:

    # h "Lies and slander. He just doesn’t get real coffee without vanilla fancy foam."
    h "胡说八道，纯属诽谤。没有香草花式奶泡，他就喝不出什么叫真咖啡。"

# game/Story03.rpy:539
translate chinese story04_78bfc019:

    # mc "Should’ve stayed in the coma…"
    mc "我当初就该继续昏迷……"

# game/Story03.rpy:541
translate chinese story04_9cf4b8ad:

    # h "You chose a coma without me?!"
    h "你选了个没有我的昏迷？！"

# game/Story03.rpy:542
translate chinese story04_0abca9d1:

    # h "Wow, [mc]. Even betrayal sounds softer than that."
    h "哇，[mc]。连“背叛”这词听起来都比你这句温柔。"

# game/Story03.rpy:549
translate chinese story04_c6a1f96b:

    # mc "(Seeing them smile…)"
    mc "（看着她们笑……）"

# game/Story03.rpy:550
translate chinese story04_83344d3d:

    # mc "(…That’s enough.)"
    mc "（……这就够了。）"

# game/Story03.rpy:557
translate chinese story04_bbd34ff3:

    # a "Time’s up."
    a "时间到了。"

# game/Story03.rpy:559
translate chinese story04_7329681e:

    # E "..."
    E "……"

# game/Story03.rpy:562
translate chinese story04_c933f6af:

    # L "I will tell you everything. Just... let me hold onto this moment a bit longer."
    L "我会把一切都告诉你。只是……让我再抓住这一刻久一点。"

# game/Story03.rpy:567
translate chinese story04_7fa181fb:

    # mc "…Don’t make me wait too long."
    mc "……别让我等太久。"

    # game/Story03.rpy:579
translate chinese akt3chapter1_2_f5f79f61:

    # "Sector 6. Blue Moon."
    "第 6 区。蓝月。"

# game/Story03.rpy:590
translate chinese akt3chapter1_2_37bc3011:

    # mc "(…Tension’s thick.)"
    mc "（……气氛绷得很紧。）"

# game/Story03.rpy:592
translate chinese akt3chapter1_2_64a9699a:

    # mc "(Give it time, something’s gonna snap.)"
    mc "（再这么下去，迟早要炸。）"

# game/Story03.rpy:596
translate chinese akt3chapter1_2_d2c80bad:

    # mc "Where are we going?"
    mc "我们去哪儿？"

# game/Story03.rpy:599
translate chinese akt3chapter1_2_0f527b40:

    # h "No clue."
    h "不知道。"

# game/Story03.rpy:603
translate chinese akt3chapter1_2_ae38f0ee:

    # h "You’ll get more words out of a brick wall than out of Miss Silent here."
    h "你跟这堵墙说话，都比跟这位沉默小姐说话能多蹦出几个字。"

# game/Story03.rpy:608
translate chinese akt3chapter1_2_bcb2f423:

    # mc "And the plan?"
    mc "那计划呢？"

# game/Story03.rpy:618
translate chinese akt3chapter1_2_81c849f9:

    # h "Don't know."
    h "不知道。"

# game/Story03.rpy:619
translate chinese akt3chapter1_2_b0ee278f:

    # h "The cat said they’re short on people, literally."
    h "那只猫说他们缺人，字面意义上的缺人。"

# game/Story03.rpy:620
translate chinese akt3chapter1_2_a73f5623:

    # h "She needs Ember's answer."
    h "她在等恩伯的答复。"

# game/Story03.rpy:624
translate chinese akt3chapter1_2_0c94c54b:

    # L "Who are you talking about?"
    L "你们在说谁？"

# game/Story03.rpy:626
translate chinese akt3chapter1_2_1334db12:

    # L "Sorry… couldn’t help overhearing."
    L "抱歉……不小心听到了。"

# game/Story03.rpy:629
translate chinese akt3chapter1_2_1d38e810:

    # h "About the arrogant cat. Flora. Everyone here knows her."
    h "说那只傲慢的猫。弗洛拉。这儿没人不认识她。"

# game/Story03.rpy:630
translate chinese akt3chapter1_2_2ea4fb50:

    # h "She’s basically the acting commander now."
    h "她现在基本就是代理指挥官。"

# game/Story03.rpy:632
translate chinese akt3chapter1_2_df212ef4:

    # L "Flora?.."
    L "弗洛拉……？"

# game/Story03.rpy:633
translate chinese akt3chapter1_2_6bcb0b13:

    # L "...That figures."
    L "……果然。"

# game/Story03.rpy:637
translate chinese akt3chapter1_2_bb19f620:

    # h "Whoa. That reaction, don’t tell me you know her?"
    h "哟。这反应，别告诉我你认识她？"

# game/Story03.rpy:641
translate chinese akt3chapter1_2_f810296e:

    # h "(whispers) Why’s she staring like that...?"
    h "（低声）她干嘛那样盯着看……？"

# game/Story03.rpy:642
translate chinese akt3chapter1_2_09975d21:

    # mc "Any problem?"
    mc "有什么问题吗？"

# game/Story03.rpy:644
translate chinese akt3chapter1_2_94fc0bf9:

    # L "Her mother was my mentor."
    L "她母亲是我的导师。"

# game/Story03.rpy:645
translate chinese akt3chapter1_2_ce662af1:

    # L "I owe her more than I can explain."
    L "我欠她的，说不清有多少。"

# game/Story03.rpy:646
translate chinese akt3chapter1_2_d0263dc2:

    # L "I wouldn’t be standing here without her."
    L "没有她，我不会站在这儿。"

# game/Story03.rpy:648
translate chinese akt3chapter1_2_bb8e4b4e:

    # a "..."
    a "……"

# game/Story03.rpy:649
translate chinese akt3chapter1_2_1975860a:

    # L "...So that’s how it is."
    L "……原来是这么回事。"

# game/Story03.rpy:659
translate chinese akt3chapter1_2_a1b44c2e:

    # mc "(whispering) Something wrong with Flora?"
    mc "（低声）弗洛拉有什么问题吗？"

# game/Story03.rpy:661
translate chinese akt3chapter1_2_256a6538:

    # L "(whispers) Flora’s not the problem."
    L "（低声）问题不在弗洛拉。"

# game/Story03.rpy:662
translate chinese akt3chapter1_2_1c57a87f:

    # L "(whispers) Her mother… that’s where things get complicated."
    L "（低声）是她母亲……事情一扯到她母亲就复杂了。"

# game/Story03.rpy:666
translate chinese akt3chapter1_2_66aa968d:

    # L "(whispers) The Inquisition has a history with them."
    L "（低声）审判庭和他们有过节。"

# game/Story03.rpy:667
translate chinese akt3chapter1_2_35842eae:

    # L "(whispers) And it’s not a friendly one."
    L "（低声）而且不是什么愉快的过节。"

# game/Story03.rpy:669
translate chinese akt3chapter1_2_f61a286d:

    # mc "(What did you get yourself into…?)"
    mc "（你到底把自己卷进什么事里了……？）"

# game/Story03.rpy:673
translate chinese akt3chapter1_2_279af9ea:

    # h "Okay, can we finally talk about what we’re doing next?"
    h "好了，我们能不能终于聊聊接下来干什么？"

# game/Story03.rpy:677
translate chinese akt3chapter1_2_38bf86db:

    # L "We’re here to deliver intel to Central Command."
    L "我们来是把情报送到中央指挥部。"

# game/Story03.rpy:680
translate chinese akt3chapter1_2_a81d7fbe:

    # h "Seriously? What kind of intel?"
    h "真的？什么情报？"

# game/Story03.rpy:682
translate chinese akt3chapter1_2_f7b7d848:

    # a "No help is coming."
    a "不会有援军来。"

# game/Story03.rpy:685
translate chinese akt3chapter1_2_aea6cb36:

    # mc "That the official line?"
    mc "这是官方说法？"

# game/Story03.rpy:689
translate chinese akt3chapter1_2_0d1f38b5:

    # a "It’s an order. From the Lady herself."
    a "这是命令。夫人亲自下的。"

# game/Story03.rpy:691
translate chinese akt3chapter1_2_815bd241:

    # L "(whispers) We’re already too late."
    L "（低声）我们已经太迟了。"

# game/Story03.rpy:694
translate chinese akt3chapter1_2_a484b3ad:

    # mc "(…What the hell does that mean?)"
    mc "（……这他妈是什么意思？）"

# game/Story03.rpy:706
translate chinese akt3chapter1_2_93fdd356:

    # mc "What do we call you?"
    mc "我们该怎么称呼你？"

# game/Story03.rpy:710
translate chinese akt3chapter1_2_8b346338:

    # a "I have no name."
    a "我没有名字。"

# game/Story03.rpy:713
translate chinese akt3chapter1_2_2b35b6fe:

    # mc "..."
    mc "……"

# game/Story03.rpy:714
translate chinese akt3chapter1_2_75f652cc:

    # mc "So be it."
    mc "那就这样吧。"

# game/Story03.rpy:718
translate chinese akt3chapter1_2_976ee3f5:

    # mc "You and Kalestra."
    mc "你和卡莱斯特拉。"

# game/Story03.rpy:719
translate chinese akt3chapter1_2_9db04097:

    # mc "Same kind?"
    mc "同类？"

# game/Story03.rpy:721
translate chinese akt3chapter1_2_bb8e4b4e_1:

    # a "..."
    a "……"

# game/Story03.rpy:724
translate chinese akt3chapter1_2_f9cfefa3:

    # a "How do you know her?"
    a "你怎么认识她的？"

# game/Story03.rpy:726
translate chinese akt3chapter1_2_2d425c4e:

    # h "She watches over us. And unlike you, she actually talks."
    h "她照看我们。而且不像你，她至少会说话。"

# game/Story03.rpy:728
translate chinese akt3chapter1_2_580df0b0:

    # a "I see."
    a "原来如此。"

# game/Story03.rpy:734
translate chinese akt3chapter1_2_ec0aaab4:

    # h "(whispers) Who would’ve thought that gorilla would end up being the reasonable one."
    h "（低声）谁能想到，那只大猩猩反倒成了讲道理的那个。"

# game/Story03.rpy:737
translate chinese akt3chapter1_2_dc6c0d6a:

    # mc "Then why bring us here?"
    mc "那为什么把我们带到这儿来？"

# game/Story03.rpy:741
translate chinese akt3chapter1_2_764d48ae:

    # a "Irrelevant to you."
    a "与你无关。"

# game/Story03.rpy:744
translate chinese akt3chapter1_2_603fd34e:

    # mc "You don’t show up without Astoria’s say-so."
    mc "没有阿斯托里亚点头，你不会出现。"

# game/Story03.rpy:745
translate chinese akt3chapter1_2_6240ec20:

    # mc "So stop wasting time."
    mc "所以别浪费时间了。"

# game/Story03.rpy:748
translate chinese akt3chapter1_2_15d1fe5b:

    # a "We came."
    a "我们来了。"

# game/Story03.rpy:749
translate chinese akt3chapter1_2_91c3ef79:

    # mc "(…Right. Talking to a wall.)"
    mc "（……行吧。对牛弹琴。）"

# game/Story03.rpy:752
translate chinese akt3chapter1_2_36eadfd7:

    # mc "Then answer this."
    mc "那就回答这个。"

# game/Story03.rpy:753
translate chinese akt3chapter1_2_9d83a8e2:

    # mc "What are you doing here?"
    mc "你在这儿做什么？"

# game/Story03.rpy:755
translate chinese akt3chapter1_2_78686255:

    # a "Protecting Doctor Lora’s life."
    a "保护洛拉博士的性命。"

# game/Story03.rpy:757
translate chinese akt3chapter1_2_76980de4:

    # mc "And us?"
    mc "那我们呢？"

# game/Story03.rpy:758
translate chinese akt3chapter1_2_efc6895f:

    # mc "Where do we fit?"
    mc "我们算什么？"

# game/Story03.rpy:760
translate chinese akt3chapter1_2_1735eccd:

    # a "The Chaplain ordered it."
    a "随军牧师下的令。"

# game/Story03.rpy:764
translate chinese akt3chapter1_2_850ef128:

    # b "..."
    b "……"

# game/Story03.rpy:768
translate chinese akt3chapter1_2_a7a878c6:

    # mc "We’re heading for the tower."
    mc "我们要去高塔。"

# game/Story03.rpy:769
translate chinese akt3chapter1_2_97149d21:

    # mc "To shut the gate down."
    mc "去把门关上。"

# game/Story03.rpy:775
translate chinese akt3chapter1_2_3677ebb9:

    # k "She just wants you to take a breather."
    k "她只是想让你们喘口气。"

# game/Story03.rpy:778
translate chinese akt3chapter1_2_81342ccc:

    # k "Or stay out of the way. Depends how you look at it."
    k "或者别碍事。看你怎么理解了。"

# game/Story03.rpy:780
translate chinese akt3chapter1_2_5f4de4b0:

    # h "And saying that like a normal person was too hard?"
    h "好好说人话就那么难吗？"

# game/Story03.rpy:781
translate chinese akt3chapter1_2_82091822:

    # k "..."
    k "……"

# game/Story03.rpy:788
translate chinese akt3chapter1_2_bb8e4b4e_2:

    # a "..."
    a "……"

# game/Story03.rpy:791
translate chinese akt3chapter1_2_82091822_1:

    # k "..."
    k "……"

# game/Story03.rpy:793
translate chinese akt3chapter1_2_3eb73908:

    # mc "We don’t have time for that."
    mc "我们没时间耗这个。"

# game/Story03.rpy:796
translate chinese akt3chapter1_2_59616d71:

    # k "Sprint blindfolded into the meat grinder and pray louder than the enemy shoots?"
    k "蒙着眼往绞肉机里冲，然后祈祷声比敌人开枪还响？"

# game/Story03.rpy:797
translate chinese akt3chapter1_2_5e71a4bb:

    # k "Funny."
    k "真有意思。"

# game/Story03.rpy:798
translate chinese akt3chapter1_2_1e03d37d:

    # k "Weren’t you whining about that cat-man using the exact same method?"
    k "你不是刚还在抱怨那个猫男用的就是这一套？"

# game/Story03.rpy:799
translate chinese akt3chapter1_2_326786cd:

    # k "Besides... I already dragged your corpses out once."
    k "再说……我已经把你们的尸体拖出来过一次了。"

# game/Story03.rpy:800
translate chinese akt3chapter1_2_78e2650b:

    # k "Don’t grow entitled."
    k "别得寸进尺。"

# game/Story03.rpy:804
translate chinese akt3chapter1_2_df4cd1e3:

    # k "Relax. The team’s not ready yet. The locals aren’t exactly eager to work with us."
    k "放松点。队伍还没准备好。本地人也不太愿意跟我们合作。"

# game/Story03.rpy:806
translate chinese akt3chapter1_2_fa2145e6:

    # h "So once again, it all comes down to the cat?"
    h "所以又一次，全卡在那只猫身上？"

# game/Story03.rpy:809
translate chinese akt3chapter1_2_e517651c:

    # k "More like the dragon."
    k "更像是那条龙。"

# game/Story03.rpy:810
translate chinese akt3chapter1_2_31b8146c:

    # k "Speaking of, where is pointy-ears?"
    k "说到这个，尖耳朵呢？"

# game/Story03.rpy:812
translate chinese akt3chapter1_2_d549633d:

    # mc "Said she had to step out. Didn’t say where."
    mc "她说要出去一趟。没说去哪儿。"

# game/Story03.rpy:814
translate chinese akt3chapter1_2_82091822_2:

    # k "..."
    k "……"

# game/Story03.rpy:815
translate chinese akt3chapter1_2_148dcf87:

    # k "So you’re the reason he’s here?"
    k "所以他就是因为你才来的？"

# game/Story03.rpy:819
translate chinese akt3chapter1_2_99d3b1da:

    # mc "Yeah, she is. Problem?"
    mc "是，就是因为她。有问题？"

# game/Story03.rpy:821
translate chinese akt3chapter1_2_9e5cb84a:

    # k "Nope... not yet."
    k "没有……暂时没有。"

# game/Story03.rpy:826
translate chinese akt3chapter1_2_032195b7:

    # k "And you’re her babysitter? Wouldn’t have guessed."
    k "那你是她的保姆？还真没看出来。"

# game/Story03.rpy:828
translate chinese akt3chapter1_2_14b08739:

    # a "I had no choice."
    a "我别无选择。"

# game/Story03.rpy:831
translate chinese akt3chapter1_2_82091822_3:

    # k "..."
    k "……"

# game/Story03.rpy:834
translate chinese akt3chapter1_2_dc11c0fc:

    # k "As always. And as always, tight-lipped."
    k "跟以前一样。还是跟以前一样，嘴严得很。"

# game/Story03.rpy:835
translate chinese akt3chapter1_2_e2a95985:

    # k "You guys hang here. I need a word with miss broody over here."
    k "你们在这儿等着。我要跟这位忧郁小姐说句话。"

# game/Story03.rpy:838
translate chinese akt3chapter1_2_f31a0753:

    # a "I’m under orders not to leave her side."
    a "我奉命不能离开她身边。"

# game/Story03.rpy:840
translate chinese akt3chapter1_2_1d000dc8:

    # k "And I’m under orders to take you to the chaplain. So let’s skip the dramatics."
    k "我奉命带你去见随军牧师。所以别演了。"

# game/Story03.rpy:850
translate chinese akt3chapter1_2_9bcf3854:

    # k "Still haven’t learned manners, huh? Though really, you—"
    k "还是没学会礼貌，是吧？不过说真的，你——"

# game/Story03.rpy:853
translate chinese akt3chapter1_2_bb8e4b4e_3:

    # a "..."
    a "……"

# game/Story03.rpy:855
translate chinese akt3chapter1_2_aa911206:

    # k "Yeah, yeah, save your outrage for later."
    k "行了行了，你的火气留着以后发。"

# game/Story03.rpy:857
translate chinese akt3chapter1_2_89876043:

    # k "You too."
    k "还有你。"

# game/Story03.rpy:862
translate chinese akt3chapter1_2_94142a29:

    # h "Me? Why?"
    h "我？为什么？"

# game/Story03.rpy:865
translate chinese akt3chapter1_2_cc6dbfc3:

    # k "Business. And for company."
    k "有正事。也顺便做个伴。"

# game/Story03.rpy:869
translate chinese akt3chapter1_2_26265c18:

    # h "Huh?!"
    h "哈？！"

# game/Story03.rpy:872
translate chinese akt3chapter1_2_13d3c304:

    # k "Let’s go. Let the lovebirds have their moment."
    k "走吧。让这对小情侣待会儿。"

# game/Story03.rpy:877
translate chinese akt3chapter1_2_3d8be1cd:

    # h "Alright, I’m off..."
    h "行吧，我走了……"

# game/Story03.rpy:878
translate chinese akt3chapter1_2_408a7a4b:

    # h "Try not to break anything while we’re gone."
    h "我们不在的时候，别把东西弄坏了。"

# game/Story03.rpy:881
translate chinese akt3chapter1_2_b21541d8:

    # mc "No promises."
    mc "不敢保证。"

# game/Story03.rpy:882
translate chinese akt3chapter1_2_dfd0e56e:

    # mc "Take care."
    mc "保重。"

# game/Story03.rpy:897
translate chinese akt3chapter1_2_fbf793c0:

    # h "You two, don’t get too carried away."
    h "你们俩，别太忘形了。"

# game/Story03.rpy:902
translate chinese akt3chapter1_2_862723df:

    # mc "Now that we’re alone... I think it’s time we talked."
    mc "既然只剩我们了……我想该谈谈了。"

# game/Story03.rpy:904
translate chinese akt3chapter1_2_d75cf13e:

    # L "Yeah..."
    L "嗯……"

# game/Story03.rpy:908
translate chinese akt3chapter1_2_c54fda8b:

    # L "(whispers) I was afraid this conversation would happen after all."
    L "（低声）我就怕这场谈话终究还是躲不掉。"

    # game/Story03.rpy:921
translate chinese akt3chapter1_3_f68fb0b2:

    # L "Well?"
    L "怎么样？"

# game/Story03.rpy:922
translate chinese akt3chapter1_3_71b85ce8:

    # L "What do you think?"
    L "你觉得呢？"

# game/Story03.rpy:924
translate chinese akt3chapter1_3_b57042c2:

    # mc "About the room? I’ve seen worse."
    mc "说这房间？我见过更差的。"

# game/Story03.rpy:925
translate chinese akt3chapter1_3_8a539ab4:

    # mc "Everything else?.. Crap, honestly."
    mc "其他的？……说实话，一塌糊涂。"

# game/Story03.rpy:926
translate chinese akt3chapter1_3_c5b4e487:

    # mc "But you know... I'm glad you're here. Even like this."
    mc "不过你知道……我很高兴你在这儿。哪怕是现在这样。"

# game/Story03.rpy:928
translate chinese akt3chapter1_3_0c85d999:

    # L "…Good to know."
    L "……知道就好。"

# game/Story03.rpy:929
translate chinese akt3chapter1_3_47faff2b:

    # L "And I’m glad we’re together again."
    L "我也很高兴，我们又在一起了。"

# game/Story03.rpy:931
translate chinese akt3chapter1_3_c3aaca30:

    # L "It’s bigger than I expected."
    L "比我预想的要大。"

# game/Story03.rpy:932
translate chinese akt3chapter1_3_c8e88140:

    # L "Strangely cozy, too."
    L "而且奇怪地挺温馨。"

# game/Story03.rpy:934
translate chinese akt3chapter1_3_2b35b6fe:

    # mc "..."
    mc "……"

# game/Story03.rpy:935
translate chinese akt3chapter1_3_dcee8c8b:

    # mc "(You’re dodging it...)"
    mc "（你在躲……）"

# game/Story03.rpy:937
translate chinese akt3chapter1_3_f2a9d106:

    # mc "The cozy part, that’s you. The room’s just an empty box."
    mc "温馨的是你。这房间不过是个空盒子。"

# game/Story03.rpy:938
translate chinese akt3chapter1_3_d34c2f32:

    # L "Oh, my silver-tongued poet… Just give it a little clean—"
    L "哦，我这张嘴抹了蜜的诗人……稍微打扫一下——"

# game/Story03.rpy:939
translate chinese akt3chapter1_3_7d57ef15:

    # L "You’ll see. It’ll come to life."
    L "你就知道了。它会活过来的。"

# game/Story03.rpy:942
translate chinese akt3chapter1_3_3c2f682a:

    # mc "Still the same… perfectionist."
    mc "还是老样子……完美主义者。"

# game/Story03.rpy:946
translate chinese akt3chapter1_3_8a144bba:

    # L "Darling, you say it like it’s a bad thing..."
    L "亲爱的，你说得好像这是什么坏事似的……"

# game/Story03.rpy:949
translate chinese akt3chapter1_3_ad1ed176:

    # mc "I remember the shows you'd put on just for a deep clean... Dust still refuses to set foot near us."
    mc "我还记得你为了大扫除演的那出戏……灰到现在都不敢靠近我们家。"

# game/Story03.rpy:951
translate chinese akt3chapter1_3_891b02c1:

    # L "Oh come on, you’re exaggerating, those were good memories."
    L "得了吧，你夸张了，那些都是好回忆。"

# game/Story03.rpy:953
translate chinese akt3chapter1_3_577835a1:

    # mc "...Yeah. That they were."
    mc "……是啊。确实是。"

# game/Story03.rpy:954
translate chinese akt3chapter1_3_8ca4eb76:

    # mc "Not gonna argue."
    mc "不跟你争。"

# game/Story03.rpy:959
translate chinese akt3chapter1_3_13616450:

    # mc "By the way... you've been here longer than I have."
    mc "对了……你在这儿待得比我久。"

# game/Story03.rpy:960
translate chinese akt3chapter1_3_26de8d45:

    # mc "Tell me, do they always mess up names like that around here?"
    mc "跟我说说，这儿的人起名都这么乱七八糟的吗？"

# game/Story03.rpy:961
translate chinese akt3chapter1_3_0ffd001e:

    # mc "‘Wild Non-Carbonated’? And it’s fizzy? What kind of twisted joke is that?"
    mc "“野性无碳酸”？结果还带气？这什么恶趣味玩笑？"

# game/Story03.rpy:964
translate chinese akt3chapter1_3_9d9188f7:

    # L "What’s wrong with it?"
    L "有什么问题吗？"

# game/Story03.rpy:965
translate chinese akt3chapter1_3_2b35b6fe_1:

    # mc "..."
    mc "……"

# game/Story03.rpy:966
translate chinese akt3chapter1_3_1a09fae5:

    # mc "Just... ah, screw it. You want one?"
    mc "就……唉，算了。你要来一罐吗？"

# game/Story03.rpy:967
translate chinese akt3chapter1_3_87914250:

    # L "I’d pass."
    L "算了。"

# game/Story03.rpy:968
translate chinese akt3chapter1_3_6e8fc0c7:

    # L "And I wouldn’t recommend it to you either."
    L "我也不建议你喝。"

# game/Story03.rpy:969
translate chinese akt3chapter1_3_c4843cea:

    # mc "Don’t be dramatic. Looks decent enough."
    mc "别大惊小怪。看着还行。"

# game/Story03.rpy:971
translate chinese akt3chapter1_3_8fc7a981:

    # L "That’s what everyone says…"
    L "大家都这么说……"

# game/Story03.rpy:972
translate chinese akt3chapter1_3_fd73adf7:

    # L "Right before it starts eating through them."
    L "然后它就开始腐蚀他们的内脏。"

# game/Story03.rpy:976
translate chinese akt3chapter1_3_4f8b99c1:

    # L "Relax. I’m joking."
    L "放松。开玩笑的。"

# game/Story03.rpy:977
translate chinese akt3chapter1_3_f2a62bfb:

    # L "...Mostly."
    L "……大半是。"

# game/Story03.rpy:979
translate chinese akt3chapter1_3_4d9d84b6:

    # mc "All these years, and your jokes still catch me off guard."
    mc "这么多年了，你的玩笑还是能把我打个措手不及。"

# game/Story03.rpy:981
translate chinese akt3chapter1_3_d03d467c:

    # L "And I missed that little scowl you always gave me after."
    L "我也想念你每次听完之后皱起的那张小脸。"

# game/Story03.rpy:982
translate chinese akt3chapter1_3_25dcc43a:

    # L "Besides, they’re not that bad. {w}Well... mostly."
    L "再说，它们也没那么糟。{w}好吧……大部分时候。"

# game/Story03.rpy:984
translate chinese akt3chapter1_3_f16c798b:

    # mc "If you say so."
    mc "你说是就是吧。"

# game/Story03.rpy:991
translate chinese akt3chapter1_3_918e6f51:

    # mc "So, here we are. Just the two of us."
    mc "所以，我们到了。就我们两个。"

# game/Story03.rpy:993
translate chinese akt3chapter1_3_d75cf13e:

    # L "Yeah..."
    L "嗯……"

# game/Story03.rpy:997
translate chinese akt3chapter1_3_39e95b64:

    # mc "...So. What happened to you?"
    mc "……那么。你到底经历了什么？"

# game/Story03.rpy:1002
translate chinese akt3chapter1_3_d6185d2a:

    # mc "You’ve got no reason to stay silent now."
    mc "你现在没理由再瞒着了。"

# game/Story03.rpy:1004
translate chinese akt3chapter1_3_df9bdc07:

    # L "There are things I can’t tell you."
    L "有些事我不能告诉你。"

# game/Story03.rpy:1005
translate chinese akt3chapter1_3_c14b089b:

    # L "...Even if I wanted to."
    L "……就算我想说也不行。"

# game/Story03.rpy:1007
translate chinese akt3chapter1_3_3c1def74:

    # mc "And I’m someone whose patience isn’t infinite, you know."
    mc "而我的耐心也不是无限的，你知道的。"

# game/Story03.rpy:1014
translate chinese akt3chapter1_3_6f8610c8:

    # mc "So what are those things—"
    mc "那到底是些什么事——"

# game/Story03.rpy:1016
translate chinese akt3chapter1_3_7e1e7e51:

    # L "I was already there."
    L "我当时就在那儿。"

# game/Story03.rpy:1017
translate chinese akt3chapter1_3_75e085dd:

    # L "On Earth."
    L "在地球上。"

# game/Story03.rpy:1018
translate chinese akt3chapter1_3_ca07f7dc:

    # L "After the incident."
    L "那场事故之后。"

# game/Story03.rpy:1026
translate chinese akt3chapter1_3_3f9df27f:

    # mc "...What?"
    mc "……什么？"

# game/Story03.rpy:1027
translate chinese akt3chapter1_3_72639988:

    # mc "You were... {w=0.2}there? {w=0.2}On that fucking planet?!"
    mc "你当时……{w=0.2}在那儿？{w=0.2}在那该死的星球上？！"

# game/Story03.rpy:1030
translate chinese akt3chapter1_3_ec14f117:

    # L "I knew you’d—"
    L "我就知道你会——"

# game/Story03.rpy:1032
translate chinese akt3chapter1_3_11bcf877:

    # mc "You knew what?!"
    mc "你知道什么？！"

# game/Story03.rpy:1033
translate chinese akt3chapter1_3_071c8918:

    # mc "That I was dying slowly, not knowing if you were dead or just erased from my life?!"
    mc "知道我一点点死去，却不知道你是死了，还是就这么从我生命里被抹掉了？！"

# game/Story03.rpy:1035
translate chinese akt3chapter1_3_9452bee5:

    # L "I—"
    L "我——"

