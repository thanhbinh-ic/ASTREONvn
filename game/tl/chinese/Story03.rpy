    b "……"

# game/Story03.rpy:2597
translate chinese akt3chapter2_2_fa47ef4c:

    # mc "Appreciate the honesty."
    mc "谢你坦诚。"

# game/Story03.rpy:2599
translate chinese akt3chapter2_2_76d0e924:

    # gg "You don’t see many first-timers with implants. Especially in your division."
    gg "第一次用植入体的人不多见。尤其是你们那个部门。"

# game/Story03.rpy:2601
translate chinese akt3chapter2_2_b6aa6c43:

    # mc "Yeah. That sounds about right."
    mc "是啊。听着挺合理。"

# game/Story03.rpy:2602
translate chinese akt3chapter2_2_fe7da75b:

    # mc "How do you handle this?"
    mc "你们是怎么扛过来的？"

# game/Story03.rpy:2603
translate chinese akt3chapter2_2_dd2888d3:

    # gg "Experience. Takes a couple years, usually."
    gg "靠经验。一般得几年。"

# game/Story03.rpy:2604
translate chinese akt3chapter2_2_bcd9f4ee:

    # mc "And if I don’t have years to spare?"
    mc "要是我没几年可以耗呢？"

# game/Story03.rpy:2606
translate chinese akt3chapter2_2_098dd180:

    # gg "Implants are your best shot. Sure, they’re hell at first. But later... they become part of you. You won’t even notice."
    gg "植入体是你最好的选择。刚开始确实像下地狱。可后来……它们就成了你的一部分。你甚至察觉不到。"

# game/Story03.rpy:2608
translate chinese akt3chapter2_2_f9b21562:

    # mc "(Breathe.)"
    mc "（呼吸。）"

# game/Story03.rpy:2609
translate chinese akt3chapter2_2_ab7d7e77:

    # mc "(Don’t panic.)"
    mc "（别慌。）"

# game/Story03.rpy:2610
translate chinese akt3chapter2_2_ec576201:

    # mc "(Stay alive.)"
    mc "（活下去。）"

# game/Story03.rpy:2612
translate chinese akt3chapter2_2_96af3308:

    # "Notification from Lora."
    "来自洛拉的通知。"

# game/Story03.rpy:2614
translate chinese akt3chapter2_2_a3da06cd:

    # L "Thank you... for last night. I didn’t expect, after everything... for something inside to finally go quiet."
    L "谢谢你……为了昨晚。我没想到，经历了这一切之后……心里居然能有一部分终于安静下来。"

# game/Story03.rpy:2616
translate chinese akt3chapter2_2_868ada83:

    # L "You became something like... a quiet place. Just for a few hours."
    L "你成了某种……安静的地方。哪怕只有几个小时。"

# game/Story03.rpy:2617
translate chinese akt3chapter2_2_8da59526:

    # L "I saw you sleeping. Didn’t want to wake you. You earned it."
    L "我看见你睡着了。不想叫醒你。你值得这一觉。"

# game/Story03.rpy:2619
translate chinese akt3chapter2_2_444ee177:

    # mc "(Lora...)"
    mc "（洛拉……）"

# game/Story03.rpy:2620
translate chinese akt3chapter2_2_a336f09a:

    # mc "(Still you.)"
    mc "（还是你。）"

# game/Story03.rpy:2621
translate chinese akt3chapter2_2_9fdcd41a:

    # L "I’m waiting at the command post. Left corridor, second door."
    L "我在指挥所等你。左边走廊，第二扇门。"

# game/Story03.rpy:2622
translate chinese akt3chapter2_2_2b35b6fe:

    # mc "..."
    mc "……"

# game/Story03.rpy:2625
translate chinese akt3chapter2_2_49064845:

    # "Notification from Lora, a few hours later."
    "几小时后，来自洛拉的通知。"

# game/Story03.rpy:2627
translate chinese akt3chapter2_2_ac95a26a:

    # L "[mc], someone sold us out. It all went to hell."
    L "[mc]，有人出卖了我们。全完了。"

# game/Story03.rpy:2628
translate chinese akt3chapter2_2_45814f48:

    # L "We tried to reach you. I swear. But we barely had anything left..."
    L "我们试过联系你。我发誓。可我们几乎什么都不剩了……"

# game/Story03.rpy:2630
translate chinese akt3chapter2_2_49064845_1:

    # "Notification from Lora, a few hours later."
    "几小时后，来自洛拉的通知。"

# game/Story03.rpy:2631
translate chinese akt3chapter2_2_897d24fe:

    # "5 missed calls."
    "5 个未接来电。"

# game/Story03.rpy:2633
translate chinese akt3chapter2_2_994078b8:

    # L "Pick up. Please. I can’t just sit here. Not knowing..."
    L "接电话。求你。我不能就这么坐在这儿。什么都不知道……"

# game/Story03.rpy:2635
translate chinese akt3chapter2_2_8323d9c2:

    # "16 missed calls."
    "16 个未接来电。"

# game/Story03.rpy:2636
translate chinese akt3chapter2_2_4938d32b:

    # "Notification from Lora, a few minutes ago."
    "几分钟前，来自洛拉的通知。"

# game/Story03.rpy:2638
translate chinese akt3chapter2_2_5947287e:

    # L "They’re evacuating us to Sector Three. Me and Olivia."
    L "他们要把我们撤到第 3 区。我和奥利维亚。"

# game/Story03.rpy:2639
translate chinese akt3chapter2_2_d42872ab:

    # L "If you’re reading this — it means you’re alive. Which means: hold on. No heroics. Just... survive."
    L "你看到这条消息，就说明你还活着。也就是说：撑住。别逞英雄。只要……活下去。"

# game/Story03.rpy:2640
translate chinese akt3chapter2_2_40b466f2:

    # L "I’ll come back. I swear."
    L "我会回来的。我发誓。"

# game/Story03.rpy:2642
translate chinese akt3chapter2_2_3bd87198:

    # mc "(You’ll come back.)"
    mc "（你会回来的。）"

# game/Story03.rpy:2643
translate chinese akt3chapter2_2_051f897d:

    # mc "(So I stay alive.)"
    mc "（那我就活下去。）"

# game/Story03.rpy:2646
translate chinese akt3chapter2_2_2b35b6fe_1:

    # mc "..."
    mc "……"

# game/Story03.rpy:2649
translate chinese akt3chapter2_2_a9dfb011:

    # mc "(Alone again.)"
    mc "（又是一个人。）"

# game/Story03.rpy:2650
translate chinese akt3chapter2_2_47b6c65f:

    # mc "(Of course.)"
    mc "（当然了。）"

# game/Story03.rpy:2653
translate chinese akt3chapter2_2_120e7a56:

    # mc "(They’re alive.)"
    mc "（她们还活着。）"

# game/Story03.rpy:2654
translate chinese akt3chapter2_2_01f229da:

    # mc "(That’s enough.)"
    mc "（这就够了。）"

# game/Story03.rpy:2655
translate chinese akt3chapter2_2_fb0674d9:

    # mc "(Move.)"
    mc "（走。）"

# game/Story03.rpy:2656
translate chinese akt3chapter2_2_bb8e4b4e_1:

    # a "..."
    a "……"

# game/Story03.rpy:2659
translate chinese akt3chapter2_2_997e07de:

    # mc "Sector Three."
    mc "第 3 区。"

# game/Story03.rpy:2660
translate chinese akt3chapter2_2_dcac0483:

    # mc "They’re regrouping."
    mc "她们在重新集结。"

# game/Story03.rpy:2663
translate chinese akt3chapter2_2_67eca88f:

    # gg "Sector Three?.. Are you sure?"
    gg "第 3 区……？你确定？"

# game/Story03.rpy:2665
translate chinese akt3chapter2_2_d07e9066:

    # mc "Not really in the mood for second guesses."
    mc "没心情听人唱反调。"

# game/Story03.rpy:2666
translate chinese akt3chapter2_2_f40f67a5:

    # gg "You won’t make it there without air transport."
    gg "没有空中载具，你到不了那儿。"

# game/Story03.rpy:2668
translate chinese akt3chapter2_2_416f7614:

    # mc "(Air... transport?)"
    mc "（空中……载具？）"

# game/Story03.rpy:2673
translate chinese akt3chapter2_2_381a9fc5:

    # mc "BLEEUUUGH."
    mc "呕——"

# game/Story03.rpy:2676
translate chinese akt3chapter2_2_2b35b6fe_2:

    # mc "..."
    mc "……"

# game/Story03.rpy:2678
translate chinese akt3chapter2_2_e37e8fa9:

    # mc "And that’s... the only way?"
    mc "而这……是唯一的办法？"

# game/Story03.rpy:2680
translate chinese akt3chapter2_2_91a707ee:

    # gg "Not the only one. Just the fastest."
    gg "不是唯一。只是最快的。"

# game/Story03.rpy:2687
translate chinese akt3chapter2_2_68f72674:

    # mc "So we find a flyer."
    mc "那就找一架飞行器。"

# game/Story03.rpy:2688
translate chinese akt3chapter2_2_ac6f8112:

    # mc "Underground."
    mc "在地下。"

# game/Story03.rpy:2689
translate chinese akt3chapter2_2_0edcb3f1_1:

    # mc "...Great."
    mc "……好极了。"

# game/Story03.rpy:2690
translate chinese akt3chapter2_2_675c8f0c:

    # mc "Where?"
    mc "在哪儿？"

# game/Story03.rpy:2692
translate chinese akt3chapter2_2_bb8e4b4e_2:

    # a "..."
    a "……"

# game/Story03.rpy:2694
translate chinese akt3chapter2_2_c1860ef0:

    # gg "There’s an old hangar not far from here. With luck, something’s still inside."
    gg "离这儿不远有个旧机库。运气好的话，里面还有东西。"

# game/Story03.rpy:2707
translate chinese akt3chapter2_2_fb364877:

    # mc "Lead."
    mc "带路。"

# game/Story03.rpy:2709
translate chinese akt3chapter2_2_d69da573:

    # gg "I do. But it won’t be easy."
    gg "我知道路。但不会轻松。"

# game/Story03.rpy:2711
translate chinese akt3chapter2_2_6721b823:

    # gg "You’ll stay in the rear. We’ll take point."
    gg "你待在后头。我们打头阵。"

# game/Story03.rpy:2719
translate chinese akt3chapter2_2_4ba52ba6:

    # gg "Now, let’s mo—"
    gg "好，那我们走——"

# game/Story03.rpy:2735
translate chinese akt3chapter2_2_6fb165f8:

    # k "Hmm..."
    k "嗯……"

# game/Story03.rpy:2737
translate chinese akt3chapter2_2_5f20b38f:

    # k "Bullets. How touching. Haven’t seen that kind of 'affection' in ages."
    k "子弹。真感人。这种“深情”我可有日子没见了。"

# game/Story03.rpy:2738
translate chinese akt3chapter2_2_f7aeb100:

    # k "Well? What’s the excuse this time, sister? Or is pulling the trigger still easier than using your voice?"
    k "怎么？这次又是什么借口，姐妹？还是说扣扳机依然比开口容易？"

# game/Story03.rpy:2740
translate chinese akt3chapter2_2_3ecdd609:

    # a "Tch."
    a "啧。"

# game/Story03.rpy:2742
translate chinese akt3chapter2_2_bff25426:

    # k "Still... familiar faces are always a treat. Even the crooked ones."
    k "不过……熟人总是让人高兴。哪怕是歪瓜裂枣的那种。"

# game/Story03.rpy:2744
translate chinese akt3chapter2_2_42ba5ce1:

    # mc "Of course. Trouble shows up, and there you are. With fanfare, obviously."
    mc "当然了。麻烦一来，你就出现。还非得敲锣打鼓。"

# game/Story03.rpy:2746
translate chinese akt3chapter2_2_210c06eb_1:

    # a "Yes."
    a "是。"

# game/Story03.rpy:2749
translate chinese akt3chapter2_2_8e987af1:

    # k "Keep talking like that, and I’ll start thinking you actually missed me."
    k "你再这么说下去，我可要以为你真想我了。"

# game/Story03.rpy:2750
translate chinese akt3chapter2_2_5ac82a9f:

    # k "Wipe that look off your face. I didn’t bleed through hell to be greeted with your theatrics."
    k "把你那表情收起来。我流着血穿过地狱，可不是为了看你这套戏。"

# game/Story03.rpy:2752
translate chinese akt3chapter2_2_57f3fbab:

    # mc "You’re supposed to be with Lora and Olivia. What are you doing here?"
    mc "你本该跟洛拉和奥利维亚在一起。你在这儿干嘛？"

# game/Story03.rpy:2755
translate chinese akt3chapter2_2_00b8258e:

    # k "Maybe you’ll finally learn to listen. Or is that still too much for you to handle?"
    k "也许你终于能学会听话了。还是说这对你来说还是太难？"

# game/Story03.rpy:2756
translate chinese akt3chapter2_2_f8144d16:

    # g "(Whispering) Is that... Her?"
    g "（低声）那是……她？"

# game/Story03.rpy:2757
translate chinese akt3chapter2_2_3711cd40:

    # gg "You’re..."
    gg "你是……"

# game/Story03.rpy:2760
translate chinese akt3chapter2_2_46700a2a:

    # k "Spare me. The names, the threats, the gasps, I’ve heard them all a hundred times. Be original for once."
    k "省省吧。名字、威胁、倒吸气，我都听过一百遍了。来点新鲜的。"

# game/Story03.rpy:2762
translate chinese akt3chapter2_2_4f3fbff3:

    # mc "You still haven’t answered. Why are you here?"
    mc "你还没回答。你为什么在这儿？"

# game/Story03.rpy:2765
translate chinese akt3chapter2_2_feb629ba:

    # k "You. The princess. And sweet little Lora. One loud, desperate cry for help."
    k "你。那位公主。还有可爱的小洛拉。一声响亮又绝望的求救。"

# game/Story03.rpy:2766
translate chinese akt3chapter2_2_d8291caa:

    # k "So I came. Did you miss me?"
    k "所以我来了。想我了吗？"

# game/Story03.rpy:2768
translate chinese akt3chapter2_2_2b35b6fe_3:

    # mc "..."
    mc "……"

# game/Story03.rpy:2770
translate chinese akt3chapter2_2_cc594085:

    # mc "I’m moved. Deeply."
    mc "我感动了。深深地。"

# game/Story03.rpy:2771
translate chinese akt3chapter2_2_ed5d4173:

    # mc "Wait... You’re getting us out of here?"
    mc "等等……你是来带我们出去的？"

# game/Story03.rpy:2773
translate chinese akt3chapter2_2_363dd4c2:

    # k "You want to stay? Adorable. But yes, I’ll get you out. Though I won’t lie, leaving you here is… tempting."
    k "你想留下？真可爱。不过没错，我会带你们出去。虽然老实说，把你们扔在这儿……挺诱人的。"

# game/Story03.rpy:2775
translate chinese akt3chapter2_2_0054e596:

    # mc "You’re serious?"
    mc "你说真的？"

# game/Story03.rpy:2777
translate chinese akt3chapter2_2_8529ccd2:

    # k "Completely. But don’t flatter yourself, I just don’t leave things unfinished."
    k "完全认真。但别自作多情，我只是不喜欢半途而废。"

# game/Story03.rpy:2781
translate chinese akt3chapter2_2_82091822:

    # k "..."
    k "……"

# game/Story03.rpy:2783
translate chinese akt3chapter2_2_53f69968:

    # k "Just don’t stare at me like I’m a monster. Or go ahead, doesn’t matter to me."
    k "别那样盯着我，好像我是个怪物。或者你接着盯，我无所谓。"

# game/Story03.rpy:2785
translate chinese akt3chapter2_2_752b8262:

    # gg "..."
    gg "……"

# game/Story03.rpy:2787
translate chinese akt3chapter2_2_955fba72:

    # gg "Now’s not the time for old grudges."
    gg "现在不是算旧账的时候。"

# game/Story03.rpy:2788
translate chinese akt3chapter2_2_82091822_1:

    # k "..."
    k "……"

# game/Story03.rpy:2789
translate chinese akt3chapter2_2_95c7633a:

    # mc "Are you okay?"
    mc "你没事吧？"

# game/Story03.rpy:2791
translate chinese akt3chapter2_2_0fbef901:

    # k "I’m always fine. It’s when others forget that things start falling apart."
    k "我一直没事。别人一忘事，事情才开始散架。"

# game/Story03.rpy:2792
translate chinese akt3chapter2_2_9aa282ea:

    # k "Move. I’m not here for your soul-searching."
    k "走。我不是来陪你做灵魂拷问的。"

# game/Story03.rpy:2794
translate chinese akt3chapter2_2_752b8262_1:

    # gg "..."
    gg "……"

# game/Story03.rpy:2796
translate chinese akt3chapter2_2_56763e0f:

    # ggg "(whispering) You can’t be serious… She killed our people."
    ggg "（低声）你不是认真的吧……她杀了我们的人。"

# game/Story03.rpy:2797
translate chinese akt3chapter2_2_d7f1c947:

    # gg "(whispering) And you want to stay here? Die here?"
    gg "（低声）你想留在这儿？死在这儿？"

# game/Story03.rpy:2798
translate chinese akt3chapter2_2_f2cd03b0:

    # gg "(whispering) We don’t choose allies. We choose survival."
    gg "（低声）我们不挑盟友。我们挑活路。"

# game/Story03.rpy:2800
translate chinese akt3chapter2_2_b9978003:

    # gg "She’s not just an executioner. She’s the nightmare our nightmares fear."
    gg "她不只是刽子手。她是我们噩梦都会怕的噩梦。"

# game/Story03.rpy:2802
translate chinese akt3chapter2_2_201288e6:

    # gg "I’m responsible for you. And if I have to walk with Astoria’s dogs to get you out, I will."
    gg "我对你们负责。要是为了带你们出去，得跟阿斯托里亚的狗一起走，我也走。"

# game/Story03.rpy:2822
translate chinese akt3chapter2_2_d2c70b58:

    # mc "(...Slaughter.)"
    mc "（……屠杀。）"

# game/Story03.rpy:2823
translate chinese akt3chapter2_2_6f5fd1a1:

    # mc "(Clean. Fast.)"
    mc "（干净。利落。）"

# game/Story03.rpy:2824
translate chinese akt3chapter2_2_f2be55a0:

    # k "(You noticed. I put my soul into it.)"
    k "（你注意到了。我可是把灵魂都放进去了。）"

# game/Story03.rpy:2826
translate chinese akt3chapter2_2_6fe354fe:

    # mc "You did this?"
    mc "这是你干的？"

# game/Story03.rpy:2829
translate chinese akt3chapter2_2_44640dd4:

    # k "They chose death. I just made sure it was... artfully done."
    k "他们选了死。我只是确保它……死得有点艺术。"

# game/Story03.rpy:2832
translate chinese akt3chapter2_2_347a4121:

    # mc "Enjoying it?"
    mc "享受吗？"

# game/Story03.rpy:2835
translate chinese akt3chapter2_2_0db91082:

    # k "No. Boredom. And only two cures for that, art or death."
    k "不。是无聊。治无聊只有两味药：艺术，或者死亡。"

# game/Story03.rpy:2836
translate chinese akt3chapter2_2_196cd2ef:

    # k "Sometimes, the line blurs."
    k "有时候，这两条线就糊在一起了。"

# game/Story03.rpy:2839
translate chinese akt3chapter2_2_73f99694:

    # mc "Do you always cause this much carnage when you're bored?"
    mc "你一无聊就搞这么大屠杀？"

# game/Story03.rpy:2841
translate chinese akt3chapter2_2_679562b4:

    # k "Not always. Sometimes I slice fabric."
    k "也不是。有时候我切布。"

# game/Story03.rpy:2842
translate chinese akt3chapter2_2_bce9b817:

    # k "Other times, throats. Depends on the mood."
    k "有时候切喉咙。看心情。"

# game/Story03.rpy:2844
translate chinese akt3chapter2_2_c6d30ed0:

    # mc "Why didn’t you go with Lora and Olivia?"
    mc "你为什么没跟洛拉和奥利维亚走？"

# game/Story03.rpy:2847
translate chinese akt3chapter2_2_caa476b6:

    # k "I wasn’t in the mood for whining. Even theirs."
    k "没心情听人哭哭啼啼。就算是她们的也没心情。"

# game/Story03.rpy:2850
translate chinese akt3chapter2_2_36d1bfd9:

    # mc "Stop pretending."
    mc "别装了。"

# game/Story03.rpy:2852
translate chinese akt3chapter2_2_bb8e4b4e_3:

    # a "..."
    a "……"

# game/Story03.rpy:2854
translate chinese akt3chapter2_2_0b014af2:

    # a "Perceptive."
    a "眼挺尖。"

# game/Story03.rpy:2862
translate chinese akt3chapter2_2_0b556877:

    # k "...Fine. I was bored and wanted some fun."
    k "……行吧。我无聊，想找点乐子。"

# game/Story03.rpy:2864
translate chinese akt3chapter2_2_ebfb01ab:

    # k "And you looked... fragile enough."
    k "而且你看着……够脆弱。"

# game/Story03.rpy:2868
translate chinese akt3chapter2_2_b6af152b:

    # k "Perfect warm-up material."
    k "完美的热身材料。"

# game/Story03.rpy:2870
translate chinese akt3chapter2_2_09a5d2d9:

    # mc "(And again, everyone’s saving me... Am I really that helpless?!)"
    mc "（又一次，所有人都在救我……我真就这么没用？！）"

# game/Story03.rpy:2871
translate chinese akt3chapter2_2_cf953a06:

    # mc "(Pull yourself together. When did you turn into this? Where’s your fire?)"
    mc "（振作起来。你什么时候变成这样了？你的火呢？）"

# game/Story03.rpy:2874
translate chinese akt3chapter2_2_954c13c3:

    # mc "(You’ve already lost your son. And if you keep sitting on your hands…)"
    mc "（你已经失去了儿子。要是你再这么袖手旁观……）"

# game/Story03.rpy:2875
translate chinese akt3chapter2_2_5dc95fe6:

    # mc "(You don’t get to stand by. Not again. Not after everything.)"
    mc "（你没资格袖手旁观。不能再有下次。经历了这一切之后，不能。）"

# game/Story03.rpy:2877
translate chinese akt3chapter2_2_98dc88c6:

    # k "(Oh, stop pitying yourself...)"
    k "（哦，别自怜自艾了……）"

# game/Story03.rpy:2882
translate chinese akt3chapter2_2_9be052d1:

    # k "—Ouch!"
    k "——哎哟！"

# game/Story03.rpy:2884
translate chinese akt3chapter2_2_f6f22481:

    # a "(Whispering) Try silence more often."
    a "（低声）多试试闭嘴。"

# game/Story03.rpy:2887
translate chinese akt3chapter2_2_981502f3:

    # a "(Whispering) And next time, stay out of what isn’t yours."
    a "（低声）还有下次，别碰不属于你的东西。"

# game/Story03.rpy:2889
translate chinese akt3chapter2_2_afeec0a4:

    # a "(Whispering) Last warning."
    a "（低声）最后一次警告。"

# game/Story03.rpy:2891
translate chinese akt3chapter2_2_99b254fb:

    # k "Killjoy."
    k "扫兴鬼。"

# game/Story03.rpy:2894
translate chinese akt3chapter2_2_bb8e4b4e_4:

    # a "..."
    a "……"

# game/Story03.rpy:2896
translate chinese akt3chapter2_2_e9dbe232:

    # mc "She’s acting like a child..."
    mc "她表现得像个小孩……"

# game/Story03.rpy:2901
translate chinese akt3chapter2_2_2a982dca:

    # a "Defense mechanism. Or habit."
    a "防御机制。或者习惯。"

# game/Story03.rpy:2903
translate chinese akt3chapter2_2_a72e2fb8:

    # mc "I get the feeling you two are... pretty close."
    mc "我感觉你们俩……挺亲近的。"

# game/Story03.rpy:2904
translate chinese akt3chapter2_2_bb8e4b4e_5:

    # a "..."
    a "……"

# game/Story03.rpy:2906
translate chinese akt3chapter2_2_02cfa38c:

    # a "We are weapons. Forged sisters clash, sparks are expected."
    a "我们是武器。同炉铸出的姐妹相撞，溅出火星是意料之中的。"

# game/Story03.rpy:2908
translate chinese akt3chapter2_2_1556dcfd:

    # k "You should see how she looks at me when I take the last coffee..."
    k "你真该看看我拿走最后一杯咖啡时她看我的眼神……"

# game/Story03.rpy:2910
translate chinese akt3chapter2_2_63baaa49:

    # a "She does it on purpose."
    a "她故意的。"

# game/Story03.rpy:2912
translate chinese akt3chapter2_2_a1e094b0:

    # k "Of course. {w}Little wars make strong bonds."
    k "当然。{w}小打小闹才能结成硬邦邦的羁绊。"

# game/Story03.rpy:2913
translate chinese akt3chapter2_2_c9f06c4c:

    # k "We’re like any sisters: we love, we fight, we drive each other insane..."
    k "我们跟任何姐妹一样：相爱、吵架、把对方逼疯……"

# game/Story03.rpy:2914
translate chinese akt3chapter2_2_53c38082:

    # k "But when the time comes, we’ll fall together. No doubts. Right?"
    k "可到了该倒下的时候，我们会一起倒。毫无疑问。对吧？"

# game/Story03.rpy:2919
translate chinese akt3chapter2_2_bb8e4b4e_6:

    # a "..."
    a "……"

# game/Story03.rpy:2921
translate chinese akt3chapter2_2_fba49164:

    # a "Without hesitation."
    a "毫不犹豫。"

# game/Story03.rpy:2922
translate chinese akt3chapter2_2_8ac5cee3:

    # a "Loyalty. And the will to die, if needed."
    a "忠诚。以及必要时赴死的意志。"

# game/Story03.rpy:2924
translate chinese akt3chapter2_2_64c9ed20:

    # mc "(I thought th—)"
    mc "（我还以为——）"

# game/Story03.rpy:2926
translate chinese akt3chapter2_2_e341ba96:

    # k "After our Lady’s orders, of course."
    k "当然，是在夫人下令之后。"

# game/Story03.rpy:2928
translate chinese akt3chapter2_2_bb8e4b4e_7:

    # a "..."
    a "……"

# game/Story03.rpy:2930
translate chinese akt3chapter2_2_6896212c:

    # a "You made the right choice. It will be remembered."
    a "你做了正确的选择。这会被记住的。"

# game/Story03.rpy:2933
translate chinese akt3chapter2_2_530bb51a:

    # mc "(What the hell was that?)"
    mc "（这又是什么鬼？）"

# game/Story03.rpy:2935
translate chinese akt3chapter2_2_1b6a4552:

    # k "(Whispering) That was her version of ‘thank you’. Adorable, right?"
    k "（低声）那是她的“谢谢”。可爱吧？"

# game/Story03.rpy:2940
translate chinese akt3chapter2_2_2b35b6fe_4:

    # mc "..."
    mc "……"

# game/Story03.rpy:2942
translate chinese akt3chapter2_2_ada47138:

    # mc "He was getting on my nerves."
    mc "他烦到我了。"

# game/Story03.rpy:2944
translate chinese akt3chapter2_2_dfba945c:

    # k "Thanks..."
    k "谢了……"

# game/Story03.rpy:2948
translate chinese akt3chapter2_2_e4ad04c2:

    # k "(Pull it together. We have company...)"
    k "（稳住。有人看着呢……）"

# game/Story03.rpy:2954
translate chinese akt3chapter2_2_c99b5fce:

    # a "Cover the rear. We move ahead."
    a "掩护后方。我们往前走。"

# game/Story03.rpy:2956
translate chinese akt3chapter2_2_69bf3109:

    # gg "Understood."
    gg "明白。"

# game/Story03.rpy:2959
translate chinese akt3chapter2_2_103699df:

    # gg "They took our people, let them pay in full."
    gg "他们杀了我们的人，让他们血债血偿。"

# game/Story03.rpy:2962
translate chinese akt3chapter2_2_ff2a0f71:

    # k "So, a little pain in the name of Astoria?"
    k "所以，以阿斯托里亚之名，来点痛苦？"

# game/Story03.rpy:2970
translate chinese akt3chapter2_2_1c59acdd:

    # mc "Let them come."
    mc "让他们来。"

# game/Story03.rpy:2971
translate chinese akt3chapter2_2_5af9b061:

    # mc "I’m ready."
    mc "我准备好了。"

# game/Story03.rpy:2973
translate chinese akt3chapter2_2_740b22b2:

    # mc "(You’ve already lost your son… and you’re not losing anyone else.)"
    mc "（你已经失去儿子了……不能再失去任何人。）"

# game/Story03.rpy:2983
translate chinese akt3chapter2_2_4cd4a0e2:

    # k "Now that’s a voice. Finally, someone here who doesn’t flinch at the scent of blood."
    k "这才叫声音。终于有个闻到血腥味不缩脖子的人了。"

# game/Story03.rpy:2984
translate chinese akt3chapter2_2_d8ad6ad0:

    # k "Stick close, hero. Die later, I hate being bored."
    k "跟紧点，英雄。晚点再死，我可讨厌无聊。"

# game/Story03.rpy:2998
translate chinese akt3chapter2_2_1bad2bb5:

    # mc "Don’t bother thanking me."
    mc "不用谢我。"

# game/Story03.rpy:2999
translate chinese akt3chapter2_2_82091822_2:

    # k "..."
    k "……"

# game/Story03.rpy:3000
translate chinese akt3chapter2_2_9649516a:

    # k "Wasn’t planning to. But if you need it that badly, you looked almost worthy. Briefly."
    k "没打算谢。不过你要是那么需要，你看着几乎还像回事。就一瞬。"

# game/Story03.rpy:3003
translate chinese akt3chapter2_2_522a3d44:

    # mc "Last one."
    mc "最后一个。"

# game/Story03.rpy:3013
translate chinese akt3chapter2_2_28033310:

    # a "Enough. Move out."
    a "够了。出发。"

# game/Story03.rpy:3020
translate chinese akt3chapter2_2_7e10cdd5:

    # gg "Copy."
    gg "收到。"

# game/Story03.rpy:3022
translate chinese akt3chapter2_2_2d1f62d3:

    # gg "Stick together!"
    gg "跟紧了！"

# game/Story03.rpy:3025
translate chinese akt3chapter2_2_5bcfe907:

    # gg "Move! Like we trained, no wasted steps!"
    gg "走！按训练来，别多走一步废步！"

# game/Story03.rpy:3026
translate chinese akt3chapter2_2_f2c813e3:

    # gg "The rest, toward the corridor. Hustle, or I’ll finish you off myself!"
    gg "其余人，往走廊去。快点，不然我亲手了结你们！"

# game/Story03.rpy:3040
translate chinese akt3chapter3_debcd0a0:

    # "Sector 4. A ventilation shaft."
    "第 4 区。一处通风井。"

# game/Story03.rpy:3041
translate chinese akt3chapter3_c1670847:

    # mc "...Holy shit."
    mc "……我靠。"

# game/Story03.rpy:3042
translate chinese akt3chapter3_2b90d5d4:

    # a "Ventilation sector. Air from the surface used to flow through here."
    a "通风区。以前地表的空气从这里流过。"

# game/Story03.rpy:3045
translate chinese akt3chapter3_6e9b66cc:

    # a "When they released the gas, the floors collapsed one after another."
    a "他们放毒气的时候，楼层一层接一层塌了。"

# game/Story03.rpy:3046
translate chinese akt3chapter3_b6e6a2f9:

    # a "The city rotted from the bottom up."
    a "这座城市从底下烂了上来。"

# game/Story03.rpy:3049
translate chinese akt3chapter3_fc6a0035:

    # mc "Gas? That's what killed them?"
    mc "毒气？他们就是这么死的？"

# game/Story03.rpy:3050
translate chinese akt3chapter3_53e83df6:

    # mc "But the mutants... they’re not human."
    mc "可那些变异体……它们不是人。"

# game/Story03.rpy:3052
translate chinese akt3chapter3_bb8e4b4e:

    # a "..."
    a "……"

# game/Story03.rpy:3053
translate chinese akt3chapter3_5948b769:

    # k "No wonder I felt like I was stepping on someone's ribs again."
    k "怪不得我又觉得踩在谁肋骨上了。"

# game/Story03.rpy:3055
translate chinese akt3chapter3_be5cc369:

    # mc "(You could at least pretend this isn’t normal.)"
    mc "（你至少可以装一下，这并不正常。）"

# game/Story03.rpy:3057
translate chinese akt3chapter3_00dec9b0:

    # k "(Sweetheart. We're on a station held together by duct tape, screaming, and someone’s bones.)"
    k "（甜心。我们待的这地方，是靠胶带、惨叫，还有谁的骨头拼起来的。）"

# game/Story03.rpy:3060
translate chinese akt3chapter3_e1d29dea:

    # k "(Nothing here is normal. I just adapted.)"
    k "（这儿没什么是正常的。我只是适应了。）"

# game/Story03.rpy:3063
translate chinese akt3chapter3_93aa5d79:

    # mc "I'm not you."
    mc "我不是你。"

# game/Story03.rpy:3065
translate chinese akt3chapter3_8213ea34:

    # mc "I won’t pretend this is okay."
    mc "我不会装作这一切都没问题。"

# game/Story03.rpy:3068
translate chinese akt3chapter3_94930995:

    # k "Good. One lunatic per square meter is already too much."
    k "很好。每平方米一个疯子已经太多了。"

# game/Story03.rpy:3071
translate chinese akt3chapter3_3cb18e7c:

    # k "Just... don’t overthink it. Mutants aren’t people. Keeps it cleaner. For you."
    k "只是……别想太多。变异体不是人。这样对你来说干净些。"

# game/Story03.rpy:3073
translate chinese akt3chapter3_a913904e:

    # k "If the real nightmare ever breaks loose — get behind me."
    k "要是真正的噩梦挣脱出来——躲我后面。"

# game/Story03.rpy:3076
translate chinese akt3chapter3_7eafddce:

    # k "{b}It’s cozy there. It’s... nice."
    k "{b}那儿挺舒服的。挺……不错。"

# game/Story03.rpy:3078
translate chinese akt3chapter3_af24c268:

    # mc "(Yeah, and I’ll be your human shield again, when you run out of ammo.)"
    mc "（是啊，等你没子弹了，我又得当你的肉盾。）"

# game/Story03.rpy:3079
translate chinese akt3chapter3_b1e8fce6:

    # k "(You know? I like how that sounds...)"
    k "（你知道吗？我喜欢这话……）"

# game/Story03.rpy:3081
translate chinese akt3chapter3_6118b17e:

    # mc "Figures. Let’s keep moving."
    mc "果然。继续走。"

# game/Story03.rpy:3084
translate chinese akt3chapter3_beee153b:

    # k "There it is. A little crack in the mask. Now you’re starting to feel real."
    k "来了。面具上终于有条裂缝了。现在你开始像个真人了。"

# game/Story03.rpy:3085
translate chinese akt3chapter3_caffef16:

    # k "Keep your head up."
    k "把头抬起来。"

# game/Story03.rpy:3087
translate chinese akt3chapter3_5e44a000:

    # mc "Right..."
    mc "嗯……"

# game/Story03.rpy:3089
translate chinese akt3chapter3_b5b448e0:

    # mc "And thanks."
    mc "谢了。"

# game/Story03.rpy:3092
translate chinese akt3chapter3_dc0e3738:

    # k "Always a pleasure."
    k "随时乐意。"

# game/Story03.rpy:3094
translate chinese akt3chapter3_2b35b6fe:

    # mc "..."
    mc "……"

# game/Story03.rpy:3097
translate chinese akt3chapter3_8c9c7f34:

    # mc "You know something."
    mc "你知道些什么。"

# game/Story03.rpy:3098
translate chinese akt3chapter3_86782263:

    # mc "About them."
    mc "关于它们。"

# game/Story03.rpy:3100
translate chinese akt3chapter3_bb8e4b4e_1:

    # a "..."
    a "……"

# game/Story03.rpy:3105
translate chinese akt3chapter3_fdf4cc37:

    # mc "Talk."
    mc "说。"

# game/Story03.rpy:3107
translate chinese akt3chapter3_763d88b4:

    # mc "Or at least tell me — does this tie back to Lora?"
    mc "或者至少告诉我——这跟洛拉有关吗？"

# game/Story03.rpy:3109
translate chinese akt3chapter3_b5efc462:

    # a "You want the truth?"
    a "你想听真话？"

# game/Story03.rpy:3112
translate chinese akt3chapter3_f800bed0:

    # mc "Yes."
    mc "想。"

# game/Story03.rpy:3116
translate chinese akt3chapter3_61bf9ec8:

    # a "Lora and the man with the patch. They worked together."
    a "洛拉和那个戴眼罩的男人。他们一起工作过。"

# game/Story03.rpy:3118
translate chinese akt3chapter3_3c5a0c96:

    # a "Studying. Testing. Under the Lady’s orders."
    a "研究。试验。奉夫人之命。"

# game/Story03.rpy:3119
translate chinese akt3chapter3_2c0b1bfb:

    # a "Lora passed. He didn’t."
    a "洛拉通过了。他没有。"

# game/Story03.rpy:3121
translate chinese akt3chapter3_dc057b0f:

    # mc "Dr. Li?"
    mc "李博士？"

# game/Story03.rpy:3128
translate chinese akt3chapter3_6e2d5d7b:

    # a "The Lady handed him over to Ostorius. As a trophy. As disposable."
    a "夫人把他交给了奥斯特里乌斯。当作战利品。当作可弃之物。"

# game/Story03.rpy:3129
translate chinese akt3chapter3_34ea003c:

    # a "He kept experimenting. Until the end."
    a "他一直做实验。直到最后。"

# game/Story03.rpy:3131
translate chinese akt3chapter3_342c5ccf:

    # a "You knew him?"
    a "你认识他？"

# game/Story03.rpy:3133
translate chinese akt3chapter3_cf1adef2:

    # mc "Yeah."
    mc "认识。"

# game/Story03.rpy:3140
translate chinese akt3chapter3_04967ad2:

    # a "He never discovered the mutants’ origin."
    a "他一直没查出变异体的来源。"

# game/Story03.rpy:3143
translate chinese akt3chapter3_5d1729bf:

    # a "He had theories. But no proof."
    a "他有推测。但没有证据。"

# game/Story03.rpy:3146
translate chinese akt3chapter3_bb8e4b4e_2:

    # a "..."
    a "……"

# game/Story03.rpy:3147
translate chinese akt3chapter3_6fad8b99:

    # mc "(Wait. Something’s off…)"
    mc "（等等。不对劲……）"

# game/Story03.rpy:3152
translate chinese akt3chapter3_9a838154:

    # R "They think we’re behind this?"
    R "他们以为这是我们干的？"

# game/Story03.rpy:3153
translate chinese akt3chapter3_f413af47:

    # mc "(He’s nervous… and it’s not the Inquisition.)"
    mc "（他很紧张……不是因为审判庭。）"

# game/Story03.rpy:3156
translate chinese akt3chapter3_77448e7a:

    # mc "He found something, didn’t he?"
    mc "他查到了什么，对吧？"

# game/Story03.rpy:3158
translate chinese akt3chapter3_e4476ff4:

    # a "It was in his report. But he didn’t believe himself."
    a "就写在他的报告里。可他自己不信。"

# game/Story03.rpy:3160
translate chinese akt3chapter3_d45b13c5:

    # mc "So you’re telling me, you know where they came from?"
    mc "所以你是说，你知道它们从哪儿来的？"

# game/Story03.rpy:3165
translate chinese akt3chapter3_c88aa9db:

    # a "Do you know why they’re called soulless?"
    a "你知道它们为什么叫无魂者吗？"

# game/Story03.rpy:3167
translate chinese akt3chapter3_2b35b6fe_1:

    # mc "..."
    mc "……"

# game/Story03.rpy:3170
translate chinese akt3chapter3_797c51cf:

    # a "Soulless... because there was a soul before the gate took it."
    a "无魂……因为在门夺走它之前，那里曾有一个灵魂。"

# game/Story03.rpy:3171
translate chinese akt3chapter3_f9be4f81:

    # a "The gate strips the mind away and leaves the body behind."
    a "门把心智剥走，只留下躯壳。"

# game/Story03.rpy:3173
translate chinese akt3chapter3_3d8f9aab:

    # mc "You..."
    mc "你……"

# game/Story03.rpy:3176
translate chinese akt3chapter3_e08af8b7:

    # mc "No. I... I don’t understand."
    mc "不。我……我不明白。"

# game/Story03.rpy:3177
translate chinese akt3chapter3_24c0190c:

    # mc "Then they’re victims."
    mc "那它们是受害者。"

# game/Story03.rpy:3178
translate chinese akt3chapter3_643d291f:

    # mc "Every one of them."
    mc "每一个都是。"

# game/Story03.rpy:3181
translate chinese akt3chapter3_f4cc7e48:

    # a "You saw the gate open. But you never asked what they opened on."
    a "你见过门打开。可你从没问过，门打开后通向的是什么。"

# game/Story03.rpy:3183
translate chinese akt3chapter3_7c1dcde0:

    # mc "Through energy. Through instability—"
    mc "通过能量。通过不稳定——"

# game/Story03.rpy:3189
translate chinese akt3chapter3_d81eba0b:

    # a "Where does the energy come from. And where do the bodies go."
    a "能量从哪儿来。尸体又去了哪儿。"

# game/Story03.rpy:3191
translate chinese akt3chapter3_8e34c139:

    # mc "(They... were human?)"
    mc "（它们……曾经是人？）"

    # game/Story03.rpy:3197
translate chinese akt3chapter3_4d9a817f:

    # Fl "Mutants driven by hunger and rage. And no one knows where they came from."
    Fl "变异体被饥饿和狂怒驱使。没人知道它们从哪儿来。"

# game/Story03.rpy:3200
translate chinese akt3chapter3_31777a57:

    # mc "(Right now, they’re just cannon fodder.)"
    mc "（眼下，它们不过是炮灰。）"

# game/Story03.rpy:3204
translate chinese akt3chapter3_0c39750b:

    # mc "But why? What kind of mind creates something like this?"
    mc "可为什么？什么样的脑子会造出这种东西？"

# game/Story03.rpy:3208
translate chinese akt3chapter3_9a397c22:

    # k "Just... don’t think about it. Mutants aren’t people."
    k "就……别去想它。变异体不是人。"

# game/Story03.rpy:3212
translate chinese akt3chapter3_24a5a506:

    # mc "(All this time...)"
    mc "（这么久以来……）"

# game/Story03.rpy:3213
translate chinese akt3chapter3_6b642644:

    # mc "(They weren’t monsters.)"
    mc "（它们不是怪物。）"

# game/Story03.rpy:3217
translate chinese akt3chapter3_2b15474b:

    # mc "...You knew."
    mc "……你知道。"

# game/Story03.rpy:3219
translate chinese akt3chapter3_b15d94ce:

    # mc "All of you."
    mc "你们全都知道。"

# game/Story03.rpy:3220
translate chinese akt3chapter3_d4661ad2:

    # a "You suspect."
    a "你在猜。"

# game/Story03.rpy:3221
translate chinese akt3chapter3_fd5865b3:

    # a "That’s why you’re angry."
    a "所以你才生气。"

# game/Story03.rpy:3227
translate chinese akt3chapter3_e176a807:

    # a "People die over less."
    a "为比这更小的事，人都能死。"

# game/Story03.rpy:3228
translate chinese akt3chapter3_16a26557:

    # a "They can’t know. No one can."
    a "他们不能知道。谁都不能。"

# game/Story03.rpy:3229
translate chinese akt3chapter3_fd0357d3:

    # mc "(So that’s it.)"
    mc "（原来如此。）"

# game/Story03.rpy:3230
translate chinese akt3chapter3_cba3f744:

    # mc "(Say the truth, and you disappear.)"
    mc "（说出真相，你就消失。）"

# game/Story03.rpy:3236
translate chinese akt3chapter3_7ca33b5b:

    # a "Arkgh!"
    a "啊咳！"

# game/Story03.rpy:3238
translate chinese akt3chapter3_62356372:

    # mc "Now I get it."
    mc "现在我懂了。"

# game/Story03.rpy:3239
translate chinese akt3chapter3_5307f7d0:

    # mc "Lora wasn’t broken."
    mc "洛拉不是崩了。"

# game/Story03.rpy:3241
translate chinese akt3chapter3_3a9fe4df:

    # mc "You did that to her."
    mc "是你们把她弄成那样的。"

# game/Story03.rpy:3243
translate chinese akt3chapter3_c98ab144:

    # mc "...Not happening to me."
    mc "……别想用在我身上。"

# game/Story03.rpy:3246
translate chinese akt3chapter3_0061b368:

    # ggg "..."
    ggg "……"

# game/Story03.rpy:3250
translate chinese akt3chapter3_705eec7e:

    # a "(Whispering) Watch over him."
    a "（低声）看好他。"

# game/Story03.rpy:3252
translate chinese akt3chapter3_2145c24a:

    # k "(You could’ve been gentler. But... who am I kidding.)"
    k "（你本可以温柔点。可……我骗谁呢。）"

# game/Story03.rpy:3253
translate chinese akt3chapter3_a7fecff0:

    # k "(You just wanted to snap his wings. See how much it hurt when they cracked.)"
    k "（你就是想折断他的翅膀。看看裂开的时候有多疼。）"

# game/Story03.rpy:3256
translate chinese akt3chapter3_63056cb1:

    # a "(Whispering) You care about a simple man? {w}Since when?"
    a "（低声）你在乎一个普通人？{w}从什么时候起？"

# game/Story03.rpy:3258
translate chinese akt3chapter3_bfd87274:

    # k "(He’s not simple. He’s... amusing.)"
    k "（他不普通。他……挺有意思。）"

# game/Story03.rpy:3259
translate chinese akt3chapter3_e9ad328d:

    # k "(And I don’t like people breaking my toys without warning.)"
    k "（而且我不喜欢别人不打招呼就弄坏我的玩具。）"

# game/Story03.rpy:3263
translate chinese akt3chapter3_57cc1caa:

    # a "(Whispering) Stay focused. The Lady is our priority."
    a "（低声）专心。夫人才是我们的首要任务。"

# game/Story03.rpy:3264
translate chinese akt3chapter3_a9f2e04c:

    # a "No emotions change that."
    a "任何感情都改变不了这点。"

# game/Story03.rpy:3266
translate chinese akt3chapter3_df8c2444:

    # a "Is that clear?"
    a "清楚了吗？"

# game/Story03.rpy:3271
translate chinese akt3chapter3_bb8e4b4e_3:

    # a "..."
    a "……"

# game/Story03.rpy:3273
translate chinese akt3chapter3_647e80cd:

    # k "(You’re not protecting him from breaking. You’re just setting the stage...)"
    k "（你不是在护着他不碎。你只是在铺台子……）"

# game/Story03.rpy:3274
translate chinese akt3chapter3_a97711f4:

    # k "(Pain without rhythm is just noise.)"
    k "（没有节奏的痛，只是噪音。）"

# game/Story03.rpy:3276
translate chinese akt3chapter3_5bbc432b:

    # k "Tch..."
    k "啧……"

# game/Story03.rpy:3280
translate chinese akt3chapter3_bbf7cf59:

    # k "So? Boiling yet?"
    k "怎么？快沸了没？"

# game/Story03.rpy:3283
translate chinese akt3chapter3_f8a33d04:

    # k "(Angry? Good. I can feel it from here.)"
    k "（生气了？很好。我这儿都能感觉到。）"

# game/Story03.rpy:3286
translate chinese akt3chapter3_5ea271a9:

    # mc "(I thought I finally found someone I could trust.)"
    mc "（我以为终于找到一个能信的人了。）"

# game/Story03.rpy:3288
translate chinese akt3chapter3_78b62800:

    # mc "(...Wrong.)"
    mc "（……错了。）"

# game/Story03.rpy:3290
translate chinese akt3chapter3_2b15474b_1:

    # mc "...You knew."
    mc "……你知道。"

# game/Story03.rpy:3292
translate chinese akt3chapter3_57c62461:

    # mc "And you said nothing."
    mc "而你什么都没说。"

# game/Story03.rpy:3295
translate chinese akt3chapter3_0634651e:

    # k "Oh? Curtain’s up already? Spare me the tragedy."
    k "哦？这就开演了？省省你那套悲剧吧。"

# game/Story03.rpy:3298
translate chinese akt3chapter3_3085095d:

    # mc "So that’s it."
    mc "原来如此。"

# game/Story03.rpy:3299
translate chinese akt3chapter3_48f75eee:

    # mc "Everyone knew."
    mc "所有人都知道。"

# game/Story03.rpy:3301
translate chinese akt3chapter3_8a4f514c:

    # mc "...Except me."
    mc "……除了我。"

# game/Story03.rpy:3307
translate chinese akt3chapter3_1bc15095:

    # k "(Yeah... He’s burning now. Feels good. Warm all over.)"
    k "（没错……他现在烧起来了。感觉真好。浑身都暖。）"

# game/Story03.rpy:3310
translate chinese akt3chapter3_4b227d9f:

    # k "(Whispering) It always gets messy when you don’t know how to lie. Gracefully. Or even... humanly."
    k "（低声）不会撒谎的人，场面总是一团糟。优雅地撒，或者……像个人一样撒。"

# game/Story03.rpy:3313
translate chinese akt3chapter3_1e1b51c3:

    # k "(Try saying it once, 'I failed.')"
    k "（试着说一次，“我失败了。”）"

# game/Story03.rpy:3318
translate chinese akt3chapter3_55cfb131:

    # k "(No? Of course not. You always did overact.)"
    k "（不说？当然不。你一直都演得太用力。）"

# game/Story03.rpy:3321
translate chinese akt3chapter3_33dd240d:

    # k "(Here we go again, dancing around conscience.)"
    k "（又来了，围着良心打转。）"

# game/Story03.rpy:3324
translate chinese akt3chapter3_fb9245ea:

    # k "Please. Kill me already."
    k "拜托。干脆杀了我吧。"

# game/Story03.rpy:3328
translate chinese akt3chapter3_a5ec69d4:

    # k "(But not now. Don’t ruin the show in the first act.)"
    k "（但不是现在。别在第一幕就把戏毁了。）"

# game/Story03.rpy:3330
translate chinese akt3chapter3_96289803:

    # k "Actually, wait..."
    k "其实，等等……"

# game/Story03.rpy:3334
translate chinese akt3chapter3_048b5630:

    # k "As adorable as this panic attack is, who’s flying this winged coffin?"
    k "这场恐慌发作虽然挺可爱，可谁在开这口带翅膀的棺材？"

# game/Story03.rpy:3338
translate chinese akt3chapter3_c919e9fa:

    # mc "Wait, don’t tell me... no one’s flying this thing?"
    mc "等等，别告诉我……没人在开这东西？"

# game/Story03.rpy:3341
translate chinese akt3chapter3_752b8262:

    # gg "..."
    gg "……"

# game/Story03.rpy:3343
translate chinese akt3chapter3_4de01bd8:

    # gg "We... didn’t think that far ahead..."
    gg "我们……没想那么远……"

# game/Story03.rpy:3346
translate chinese akt3chapter3_8d68d766:

    # g "I can."
    g "我会。"

# game/Story03.rpy:3348
translate chinese akt3chapter3_ef178b3a:

    # gg "Brain, what are you—"
    gg "布雷恩，你搞什——"

# game/Story03.rpy:3351
translate chinese akt3chapter3_b4a519d0:

    # g "Worked air delivery as a kid."
    g "小时候干过空运。"

# game/Story03.rpy:3353
translate chinese akt3chapter3_db007c6d:

    # g "Just need a second hand."
    g "只需要个帮手。"

# game/Story03.rpy:3356
translate chinese akt3chapter3_2b35b6fe_2:

    # mc "..."
    mc "……"

# game/Story03.rpy:3358
translate chinese akt3chapter3_9e6f11df:

    # mc "Me?"
    mc "我？"

# game/Story03.rpy:3361
translate chinese akt3chapter3_bcb93426:

    # mc "...Never done this."
    mc "……我从没干过。"

# game/Story03.rpy:3363
translate chinese akt3chapter3_e3fb8912:

    # g "You’ll just sit there and not touch anything. Think you can manage?"
    g "你就坐那儿，什么都别碰。做得到吗？"

# game/Story03.rpy:3368
translate chinese akt3chapter3_2b35b6fe_3:

    # mc "..."
    mc "……"

# game/Story03.rpy:3370
translate chinese akt3chapter3_480890f2:

    # mc "I’ll manage."
    mc "做得到。"

# game/Story03.rpy:3377
translate chinese akt3chapter3_f702af86:

    # gg "One problem down, I guess."
    gg "算是解决一个问题了。"

# game/Story03.rpy:3379
translate chinese akt3chapter3_9769d7a5:

    # mc "How much further?"
    mc "还有多远？"

# game/Story03.rpy:3381
translate chinese akt3chapter3_966e75bc:

    # gg "We’re here. Just need to go in."
    gg "到了。只要进去就行。"

# game/Story03.rpy:3386
translate chinese akt3chapter3_6cd20e48:

    # gg "How’s the door coming?"
    gg "门弄得怎么样了？"

# game/Story03.rpy:3389
translate chinese akt3chapter3_e7be1092:

    # ggggg "Locked. From the other side."
    ggggg "锁着。从另一边锁的。"

# game/Story03.rpy:3391
translate chinese akt3chapter3_814b4855:

    # gg "No other way in?"
    gg "没别的路进去？"

# game/Story03.rpy:3398
translate chinese akt3chapter3_4a0fd56d:

    # ggggg "Technically? Yeah. But you won’t like it."
    ggggg "严格说？有。但你不会喜欢。"

# game/Story03.rpy:3401
translate chinese akt3chapter3_b7f1c999:

    # gggggg "What do you mea—"
    gggggg "你什么意——"

# game/Story03.rpy:3406
translate chinese akt3chapter3_9c150573:

    # a "Step aside."
    a "让开。"

# game/Story03.rpy:3407
translate chinese akt3chapter3_deadb412:

    # ggggg "You don’t give me orders."
    ggggg "你命令不了我。"

# game/Story03.rpy:3408
translate chinese akt3chapter3_9e257187:

    # a "I don’t negotiate commands."
    a "我不跟命令讨价还价。"

# game/Story03.rpy:3415
translate chinese akt3chapter3_bf9054ac:

    # gggggg "Do as she says."
    gggggg "照她说的做。"

# game/Story03.rpy:3423
translate chinese akt3chapter3_bb8e4b4e_4:

    # a "..."
    a "……"

# game/Story03.rpy:3424
translate chinese akt3chapter3_09425915:

    # g "(whispering) What’s she doing?"
    g "（低声）她干嘛呢？"

# game/Story03.rpy:3425
translate chinese akt3chapter3_9cdab376:

    # ggggg "(whispering) Thinks she can move it one-handed. Lunatics..."
    ggggg "（低声）她以为自己能单手挪开。疯子……"

# game/Story03.rpy:3428
translate chinese akt3chapter3_58415143:

    # gg "(whispering) Kids… You haven’t seen what they’re capable of."
    gg "（低声）小子……你没见过她们有多能。"

# game/Story03.rpy:3440
translate chinese akt3chapter3_7c1eb5f8:

    # g "...?"
    g "……？"

# game/Story03.rpy:3441
translate chinese akt3chapter3_0061b368_1:

    # ggg "..."
    ggg "……"

# game/Story03.rpy:3443
translate chinese akt3chapter3_4a349266:

    # gggggg "She… she moved the door. One hand. Is that even legal?"
    gggggg "她……她一只手就把门挪开了。这合法吗？"

# game/Story03.rpy:3446
translate chinese akt3chapter3_fabef0c1:

    # a "Let’s go."
    a "走。"

# game/Story03.rpy:3448
translate chinese akt3chapter3_12f7b17d:

    # mc "(Do they all have a family kink for brute force?)"
    mc "（她们家是不是都有暴力癖？）"

# game/Story03.rpy:3452
translate chinese akt3chapter3_f57e5e89:

    # k "(Strength’s the only language that doesn’t lie.)"
    k "（力量是唯一不会撒谎的语言。）"

# game/Story03.rpy:3454
translate chinese akt3chapter3_86b0bfad:

    # mc "(You’re in my head again.)"
    mc "（你又钻进我脑子里了。）"

# game/Story03.rpy:3457
translate chinese akt3chapter3_95b44fab:

    # k "(And you’re still pouting like a boy with a broken toy.)"
    k "（而你还像个玩具坏了的小孩一样撅着嘴。）"

# game/Story03.rpy:3464
translate chinese akt3chapter3_c8a894ae:

    # mc "(Then why lie to me?)"
    mc "（那为什么骗我？）"

# game/Story03.rpy:3479
translate chinese akt3chapter3_36041560:

    # k "(I couldn’t, okay? If you’d found out then, it would’ve torn you apart.)"
    k "（我不能说，行吗？那时候你要是知道了，你会被撕碎的。）"

# game/Story03.rpy:3481
translate chinese akt3chapter3_b5ec5fc4:

    # k "(You would’ve fallen. And we don’t allow weak allies.)"
    k "（你会垮。而我们不允许有软弱的盟友。）"

# game/Story03.rpy:3482
translate chinese akt3chapter3_43195097:

    # mc "(You think I couldn’t handle it?)"
    mc "（你觉得我扛不住？）"

# game/Story03.rpy:3485
translate chinese akt3chapter3_7477bab9:

    # k "(You don’t get it. It’s not about being strong.)"
    k "（你不懂。这跟强不强没关系。）"

# game/Story03.rpy:3487
translate chinese akt3chapter3_04cdc2f7:

    # k "(It’s about how death breaks you… when you still believe they were people.)"
    k "（关键在于，当你还相信它们曾经是人时……死亡会怎么把你压垮。）"

# game/Story03.rpy:3488
translate chinese akt3chapter3_2b35b6fe_4:

    # mc "..."
    mc "……"

# game/Story03.rpy:3491
translate chinese akt3chapter3_79d64210:

    # k "We’re not machines."
    k "我们不是机器。"

# game/Story03.rpy:3492
translate chinese akt3chapter3_826e6b17:

    # k "We breathe, we feel… and we break."
    k "我们会呼吸，会感受……也会碎。"

# game/Story03.rpy:3500
translate chinese akt3chapter3_288945c1:

    # k "I’ve seen it."
    k "我见过。"

# game/Story03.rpy:3502
translate chinese akt3chapter3_a7cf177e:

    # k "Seen strong ones bend when the truth hit."
    k "见过强者在真相砸下来的时候弯了。"

# game/Story03.rpy:3504
translate chinese akt3chapter3_816a1c65:

    # k "So yeah, sorry I lied."
    k "所以是，抱歉我撒了谎。"

# game/Story03.rpy:3506
translate chinese akt3chapter3_0b17be9e:

    # mc "...I get it."
    mc "……我明白。"

# game/Story03.rpy:3508
translate chinese akt3chapter3_b4e4f80b:

    # mc "Doesn’t make it easier."
    mc "但这并不会让我好受点。"

# game/Story03.rpy:3513
translate chinese akt3chapter3_404a266a:

    # k "Move before I regret explaining myself."
    k "走，趁我还没后悔跟你解释。"

# game/Story03.rpy:3521
translate chinese akt3chapter3_1_8f65b5a8:

    # "Sector 4-S. Warehouse area."
    "第 4-S 区。仓库区。"

# game/Story03.rpy:3524
translate chinese akt3chapter3_1_94829569:

    # k "Used to be bones, flies, and silence down here."
    k "以前这下面只有骨头、苍蝇，和死寂。"

# game/Story03.rpy:3525
translate chinese akt3chapter3_1_f89521da:

    # k "Now it’s pipes, lights, and the smell of old corpses. Progress… almost."
    k "现在是管道、灯，还有陈年尸体的味道。进步……差不多吧。"

# game/Story03.rpy:3526
translate chinese akt3chapter3_1_c060c641:

    # mc "(Wouldn’t be surprised if the corpses are still here.)"
    mc "（就算尸体还在，我也不意外。）"

# game/Story03.rpy:3527
translate chinese akt3chapter3_1_4eb225e8:

    # mc "(Just… better hidden.)"
    mc "（只是……藏得更好了。）"

# game/Story03.rpy:3530
translate chinese akt3chapter3_1_9b609ed8:

    # gg "Fan out. There’s got to be at least one transport left."
    gg "散开。至少得还剩一艘运输船。"

# game/Story03.rpy:3533
translate chinese akt3chapter3_1_bd75da86:

    # gggg "This pit’s been abandoned, sir. Doubt anything’s functional."
    gggg "这坑早废弃了，长官。我怀疑没东西还能用。"

# game/Story03.rpy:3534
translate chinese akt3chapter3_1_5d97d04e:

    # gg "Then we believe in miracles. Or go make one."
    gg "那就信奇迹。或者去造一个。"

# game/Story03.rpy:3536
translate chinese akt3chapter3_1_b69f6829:

    # mc "Looks promising..."
    mc "看着挺有戏……"

# game/Story03.rpy:3539
translate chinese akt3chapter3_1_3710a0f9:

    # g "You. You’re coming with me."
    g "你。跟我来。"

# game/Story03.rpy:3541
translate chinese akt3chapter3_1_f149133f:

    # mc "Why me. Specifically?"
    mc "为什么偏偏是我？"

# game/Story03.rpy:3543
translate chinese akt3chapter3_1_e6a7b655:

    # g "Need another pair of hands. To check the fuel."
    g "需要多一双手。检查燃料。"

# game/Story03.rpy:3545
translate chinese akt3chapter3_1_2bd5e0d8:

    # mc "You don’t look like you need help."
    mc "你看着不像需要帮忙。"

# game/Story03.rpy:3547
translate chinese akt3chapter3_1_db25554c:

    # g "Can. But with you, it’s faster."
    g "我自己也行。但带上你，快些。"

# game/Story03.rpy:3550
translate chinese akt3chapter3_1_42102a88:

    # g "You can stay behind, of course. But don’t blame anyone if we run out of time."
    g "你当然可以留下。但要是时间不够，别怪任何人。"

# game/Story03.rpy:3552
translate chinese akt3chapter3_1_83fd040a:

    # k "(Going with him? Brave.)"
    k "（跟他走？胆子不小。）"

# game/Story03.rpy:3554
translate chinese akt3chapter3_1_6abb0a67:

    # k "(Or just stupid.)"
    k "（或者就是蠢。）"

# game/Story03.rpy:3559
translate chinese akt3chapter3_1_9b9c96f0:

    # mc "(Do I even have a choice?)"
    mc "（我有得选吗？）"

# game/Story03.rpy:3562
translate chinese akt3chapter3_1_a8eb1af5:

    # k "(You always have a choice. Sometimes it’s just between a {b}bullet to the chest{/b} and a {b}bullet to the back{/b}.)"
    k "（你一直都有选择。有时候只是{b}胸口挨一枪{/b}和{b}后背挨一枪{/b}的区别。）"

# game/Story03.rpy:3564
translate chinese akt3chapter3_1_77f1e2ff:

    # mc "He reminds me of you."
    mc "他让我想起你。"

# game/Story03.rpy:3566
translate chinese akt3chapter3_1_36338f19:

    # mc "When you stop pretending."
    mc "是你不装的时候。"

# game/Story03.rpy:3569
translate chinese akt3chapter3_1_de2b2888:

    # k "Difference is, I don’t lie about my intentions."
    k "区别在于，我从不掩饰自己的意图。"

# game/Story03.rpy:3571
translate chinese akt3chapter3_1_82091822:

    # k "..."
    k "……"

# game/Story03.rpy:3572
translate chinese akt3chapter3_1_bb8e4b4e:

    # a "..."
    a "……"

# game/Story03.rpy:3573
translate chinese akt3chapter3_1_eee5ed20:

    # k "(Not gonna say anything, huh?)"
    k "（什么都不说，是吧？）"

# game/Story03.rpy:3575
translate chinese akt3chapter3_1_eaf08bf4:

    # g "We’re heading out. Going to check the fuel tanks."
    g "我们出发。去检查燃料箱。"

# game/Story03.rpy:3578
translate chinese akt3chapter3_1_e7d4348e:

    # gg "Wait."
    gg "等等。"

# game/Story03.rpy:3581
translate chinese akt3chapter3_1_4ceeb90e:

    # gg "Catch. You hear even one step behind you, use it."
    gg "接着。要是听见身后有哪怕一步，就用它。"

# game/Story03.rpy:3584
translate chinese akt3chapter3_1_33570131:

    # gg "These walls breathe. You never know what’ll crawl out of the dark. Remember what to do?"
    gg "这些墙会喘气。你永远不知道黑暗里会爬出什么。记得该怎么做吗？"

# game/Story03.rpy:3591
translate chinese akt3chapter3_1_3432103f:

    # g "First sign, we run."
    g "一有动静，就跑。"

# game/Story03.rpy:3592
translate chinese akt3chapter3_1_006f1365:

    # gg "Go."
    gg "去吧。"

# game/Story03.rpy:3605
translate chinese akt3chapter3_1_6ada3060:

    # mc "So."
    mc "那么。"

# game/Story03.rpy:3606
translate chinese akt3chapter3_1_5164590e:

    # mc "Why me?"
    mc "为什么是我？"

# game/Story03.rpy:3608
translate chinese akt3chapter3_1_6ac0bf72:

    # g "I noticed. You’re not like them."
    g "我注意到了。你跟他们不一样。"

# game/Story03.rpy:3611
translate chinese akt3chapter3_1_3d996037:

    # mc "What are you talking about?"
    mc "你在说什么？"

# game/Story03.rpy:3614
translate chinese akt3chapter3_1_69bc08ec:

    # g "Don’t play dumb. We’re lower city folk. We read people like cracked glass."
    g "别装傻。我们是下城人。看人就像看裂开的玻璃。"

# game/Story03.rpy:3617
translate chinese akt3chapter3_1_2b35b6fe:

    # mc "..."
    mc "……"

# game/Story03.rpy:3619
translate chinese akt3chapter3_1_153d0ce7:

    # g "It’s simple. You either fake it — or say it straight."
    g "很简单。要么装，要么直说。"

# game/Story03.rpy:3624
translate chinese akt3chapter3_1_0eb29620:

    # mc "Yeah. Fair."
    mc "嗯。有道理。"

# game/Story03.rpy:3627
translate chinese akt3chapter3_1_b7773ec2:

    # g "Ha. Didn’t think you’d actually say yes."
    g "哈。没想到你真会认。"

# game/Story03.rpy:3630
translate chinese akt3chapter3_1_20365eff:

    # g "Glad you didn’t bullshit me."
    g "还好你没跟我胡扯。"

# game/Story03.rpy:3633
translate chinese akt3chapter3_1_8c117f9a:

    # g "I need your help."
    g "我需要你帮忙。"

# game/Story03.rpy:3635
translate chinese akt3chapter3_1_5514cbd1:

    # mc "(Here we go...)"
    mc "（来了……）"

# game/Story03.rpy:3636
translate chinese akt3chapter3_1_c6b16b8c:

    # mc "(It’s either blackmail or a begging plea.)"
    mc "（不是敲诈就是哀求。）"

# game/Story03.rpy:3643
translate chinese akt3chapter3_1_2b35b6fe_1:

    # mc "..."
    mc "……"

# game/Story03.rpy:3645
translate chinese akt3chapter3_1_27bb7259:

    # mc "Say it."
    mc "说吧。"

# game/Story03.rpy:3647
translate chinese akt3chapter3_1_871ff683:

    # g "Help me. My wife and daughter… They won’t survive this place."
    g "帮帮我。我老婆和女儿……她们在这地方活不下去。"

# game/Story03.rpy:3648
translate chinese akt3chapter3_1_6b53a4f7:

    # g "I’m not asking much. Just a ride. It’s close — I’ll handle everything else. Just..."
    g "我不求多。就捎一程。很近——其他我自己搞定。只要……"

# game/Story03.rpy:3649
translate chinese akt3chapter3_1_8f588f24:

    # g "They’re waiting. They believe I’ll come back."
    g "她们在等。她们相信我会回去。"

# game/Story03.rpy:3651
translate chinese akt3chapter3_1_215fbb6a:

    # mc "(He’s like Norman… Doing it all for family. But this is our only shot.)"
    mc "（他像诺曼……一切都是为了家人。可这是我们唯一的机会。）"

# game/Story03.rpy:3652
translate chinese akt3chapter3_1_fca52711:

    # mc "No."
    mc "不行。"

# game/Story03.rpy:3654
translate chinese akt3chapter3_1_892fd1ce:

    # g "Please..."
    g "求你了……"

# game/Story03.rpy:3656
translate chinese akt3chapter3_1_bfa3ac19:

    # mc "(He’s our only pilot.)"
    mc "（他是我们唯一的飞行员。）"

# game/Story03.rpy:3658
translate chinese akt3chapter3_1_d62dcfc6:

    # mc "(If we help — he gets us out.)"
    mc "（要是帮他——他就带我们出去。）"

# game/Story03.rpy:3661
translate chinese akt3chapter3_1_ebd80908:

    # mc "(But every extra minute puts us all at risk. And how do I face Lora then?...)"
    mc "（可每多一分钟，所有人就多一分危险。那到时候我怎么面对洛拉？……）"

# game/Story03.rpy:3663
translate chinese akt3chapter3_1_db1d03c7:

    # mc "(One life… or everyone else.)"
    mc "（一条命……还是其他所有人。）"

# game/Story03.rpy:3665
translate chinese akt3chapter3_1_16411555:

    # mc "(No.)"
    mc "（不行。）"

# game/Story03.rpy:3667
translate chinese akt3chapter3_1_8b9dbe8c:

    # mc "I wish I could. But if I say yes — we all burn."
    mc "我也想帮。可要是我答应——我们都得完。"

# game/Story03.rpy:3670
translate chinese akt3chapter3_1_4b340443:

    # g "..."
    g "……"

# game/Story03.rpy:3673
translate chinese akt3chapter3_1_8a43d5eb:

    # g "I see."
    g "我明白了。"

# game/Story03.rpy:3679
translate chinese akt3chapter3_1_3c59f45c:

    # g "So what now?"
    g "那现在怎么办？"

# game/Story03.rpy:3681
translate chinese akt3chapter3_1_749b8edc:

    # mc "Wait. Don’t do anything stupid."
    mc "等等。别干蠢事。"

# game/Story03.rpy:3684
translate chinese akt3chapter3_1_a24b133e:

    # mc "I know this is hard, but we hav—"
    mc "我知道这很难，可我们——"

# game/Story03.rpy:3686
translate chinese akt3chapter3_1_975ef168:

    # g "I’m not going without them! Either we go together, or not at all!"
    g "没有她们我不走！要么一起走，要么都不走！"

# game/Story03.rpy:3689
translate chinese akt3chapter3_1_c3bd0649:

    # mc "Alright, let’s calm down first."
    mc "好，先冷静下来。"

# game/Story03.rpy:3692
translate chinese akt3chapter3_1_28dcbde3:

    # mc "I had a son."
    mc "我也有过儿子。"

# game/Story03.rpy:3694
translate chinese akt3chapter3_1_a2273163:

    # mc "...Same story."
    mc "……一样的故事。"

# game/Story03.rpy:3696
translate chinese akt3chapter3_1_88227939:

    # mc "So trust me, I get what you’re feeling—"
    mc "所以信我，我懂你的感受——"

# game/Story03.rpy:3700
translate chinese akt3chapter3_1_39a84955:

    # g "DON’T COME ANY CLOSER! You think I don’t see what you’re trying to do?!"
    g "别靠近！你以为我看不出你想干嘛？！"

# game/Story03.rpy:3701
translate chinese akt3chapter3_1_7c877ac9:

    # g "STAY BACK!"
    g "退后！"

# game/Story03.rpy:3703
translate chinese akt3chapter3_1_29b2d7ea:

    # mc "Okay, okay. We’ll talk from here. Just lower the gun, alright?"
    mc "好，好。我们就在这儿说。把枪放下，行吗？"

# game/Story03.rpy:3705
translate chinese akt3chapter3_1_ff97d55e:

    # g "IT’S NOT YOUR CALL!"
    g "这轮不到你决定！"

# game/Story03.rpy:3707
translate chinese akt3chapter3_1_3386ff5a:

    # g "TELL ME NOW! Are you—"
    g "现在告诉我！你到底——"

# game/Story03.rpy:3720
translate chinese akt3chapter3_1_c8b06020:

    # a "That’s what happens when you trust vermin."
    a "信耗子的下场就是这样。"

# game/Story03.rpy:3723
translate chinese akt3chapter3_1_3a358241:

    # mc "...What the hell did you just do?"
    mc "……你他妈干了什么？"

# game/Story03.rpy:3725
translate chinese akt3chapter3_1_c7055a1c:

    # mc "He was our pilot!"
    mc "他是我们的飞行员！"

# game/Story03.rpy:3728
translate chinese akt3chapter3_1_cdbcef6c:

    # mc "(Stay calm.)"
    mc "（保持冷静。）"

# game/Story03.rpy:3731
translate chinese akt3chapter3_1_9baa6b07:

    # mc "He was the only one who could fly this."
    mc "他是唯一会开这东西的人。"

# game/Story03.rpy:3735
translate chinese akt3chapter3_1_8f3562d2:

    # a "The transporter uses assisted controls."
    a "运输船有辅助操控。"

# game/Story03.rpy:3736
translate chinese akt3chapter3_1_df30f9f0:

    # a "Your implants can interface with the system."
    a "你的植入体可以接入系统。"

# game/Story03.rpy:3739
translate chinese akt3chapter3_1_be378d9f:

    # mc "Responding to me and obeying me are two different things."
    mc "响应我和听我命令是两回事。"

# game/Story03.rpy:3740
translate chinese akt3chapter3_1_8dc5bf0b:

    # a "Then make them obey."
    a "那就让它们听话。"

# game/Story03.rpy:3743
translate chinese akt3chapter3_1_cbeb9203:

    # mc "You gambled our lives on a guess."
    mc "你拿我们的命赌一个猜测。"

# game/Story03.rpy:3745
translate chinese akt3chapter3_1_9a58adc6:

    # a "No."
    a "不。"

# game/Story03.rpy:3746
translate chinese akt3chapter3_1_cd6e74ad:

    # a "I gambled them on you."
    a "我赌的是你。"

# game/Story03.rpy:3749
translate chinese akt3chapter3_1_c50e415b:

    # mc "And him?"
    mc "那他呢？"

# game/Story03.rpy:3751
translate chinese akt3chapter3_1_1a8e1d62:

    # mc "What do we tell them?"
    mc "我们怎么跟他们说？"

# game/Story03.rpy:3754
translate chinese akt3chapter3_1_9e1351f8:

    # a "That’s my problem now."
    a "那是我的事了。"

# game/Story03.rpy:3765
translate chinese akt3chapter3_1_27be8719:

    # gg "Check the storage bays. Maybe someone left something behind."
    gg "检查储藏舱。也许有人落下了什么。"

# game/Story03.rpy:3766
translate chinese akt3chapter3_1_2c11d821:

    # ggg "On it."
    ggg "这就去。"

# game/Story03.rpy:3767
translate chinese akt3chapter3_1_933e4d29:

    # k "(Bored...)"
    k "（无聊……）"

# game/Story03.rpy:3770
translate chinese akt3chapter3_1_8f594cc2:

    # gg "I'm heading to the turbines. Gonna check the tanks."
    gg "我去涡轮那边。检查燃料箱。"

# game/Story03.rpy:3771
translate chinese akt3chapter3_1_50ee686b:

    # k "(Well, well. Look who's back with news. Only one of them, ain’t a hero anymore.)"
    k "（哟，哟。看看谁带消息回来了。就回来一个，不再是英雄了。）"

# game/Story03.rpy:3774
translate chinese akt3chapter3_1_1f0bd129:

    # mc "...You’re serious?"
    mc "……你说真的？"

# game/Story03.rpy:3775
translate chinese akt3chapter3_1_97534b87:

    # mc "I’ve never flown anything."
    mc "我从没开过任何飞行器。"

# game/Story03.rpy:3776
translate chinese akt3chapter3_1_46a250e6:

    # mc "Tried a simulator once as a kid… didn’t make it halfway."
    mc "小时候试过一次模拟器……连一半都没撑到。"

# game/Story03.rpy:3779
translate chinese akt3chapter3_1_cd6aa4e7:

    # a "You'll have time to remember. In flight."
    a "你有时间回忆。飞行途中。"

# game/Story03.rpy:3782
translate chinese akt3chapter3_1_bd558f76:

    # mc "This would be funny if it weren't... you know, fatal."
    mc "要不是……会死人，这事还挺好笑。"

# game/Story03.rpy:3785
translate chinese akt3chapter3_1_8ceca8bf:

    # mc "You killed our way out."
    mc "你杀了我们的出路。"

# game/Story03.rpy:3787
translate chinese akt3chapter3_1_cdcff9ce:

    # gg "You're back?"
    gg "你回来了？"

# game/Story03.rpy:3793
translate chinese akt3chapter3_1_6f90a720:

    # gg "Where’s Bra—"
    gg "布雷呢——"

# game/Story03.rpy:3796
translate chinese akt3chapter3_1_f51c71cc:

    # a "Dead."
    a "死了。"

# game/Story03.rpy:3801
translate chinese akt3chapter3_1_b4e517f7:

    # gg "What?"
    gg "什么？"

# game/Story03.rpy:3805
translate chinese akt3chapter3_1_5b5caad2:

    # a "I shot him."
    a "我开的枪。"

# game/Story03.rpy:3807
translate chinese akt3chapter3_1_c588f656:

    # mc "(...Just like that.)"
    mc "（……就这么简单。）"

# game/Story03.rpy:3810
translate chinese akt3chapter3_1_5baf2c93:

    # gg "Explain. Now."
    gg "解释。现在。"

# game/Story03.rpy:3812
translate chinese akt3chapter3_1_61fdf4bb:

    # a "He pointed a weapon at him. Made threats. Wanted to break out, save his family."
    a "他拿武器指着他。出言威胁。想冲出去救家人。"

# game/Story03.rpy:3813
translate chinese akt3chapter3_1_560b354a:

    # gg "So you... just decided?"
    gg "所以你就……自己决定了？"

# game/Story03.rpy:3815
translate chinese akt3chapter3_1_b9a7c5f4:

    # a "I made a choice."
    a "我做了选择。"

# game/Story03.rpy:3817
translate chinese akt3chapter3_1_0b4a4ec5:

    # mc "You killed the only one who could get us out of here!"
    mc "你杀了唯一能带我们出去的人！"

# game/Story03.rpy:3819
translate chinese akt3chapter3_1_739178da:

    # a "We still have him."
    a "我们还有他。"

# game/Story03.rpy:3821
translate chinese akt3chapter3_1_9e6f11df:

    # mc "Me?"
    mc "我？"

# game/Story03.rpy:3822
translate chinese akt3chapter3_1_31aeaa32:

    # mc "I drove trucks. Not this."
    mc "我开过卡车。不是这玩意儿。"

# game/Story03.rpy:3826
translate chinese akt3chapter3_1_a7b24434:

    # ggg "You just erased our only shot! Damn it, you..."
    ggg "你刚把唯一的希望抹了！该死，你……"

# game/Story03.rpy:3829
translate chinese akt3chapter3_1_b59e3a77:

    # gg "Enough!"
    gg "够了！"

# game/Story03.rpy:3831
translate chinese akt3chapter3_1_15c2302f:

    # k "(Ohhh, now it's heating up...)"
    k "（哦哦，这下热闹了……）"

# game/Story03.rpy:3833
translate chinese akt3chapter3_1_c9d13edd:

    # gg "Did you have the right? Who gave you that damn right?"
    gg "你有这个权力吗？谁他妈给你的权力？"

# game/Story03.rpy:3836
translate chinese akt3chapter3_1_9f9532eb:

    # a "No one. I took it."
    a "没人给。我自己拿的。"

# game/Story03.rpy:3838
translate chinese akt3chapter3_1_7cac32ac:

    # mc "(...There she is.)"
    mc "（……她就是这样。）"

# game/Story03.rpy:3840
translate chinese akt3chapter3_1_16a0fdf0:

    # gg "He was a friend. Yeah, impulsive, but he didn’t deserve a bullet in the back."
    gg "他是朋友。是，他冲动，但他不该后背挨一枪。"

# game/Story03.rpy:3842
translate chinese akt3chapter3_1_0e0be1b2:

    # a "He would’ve gotten us killed. Everyone knows how that ends. A panicking man with a gun? Worse than the enemy."
    a "他会害死我们。谁都知道那是什么下场。一个拿着枪慌神的男人？比敌人还糟。"

# game/Story03.rpy:3844
translate chinese akt3chapter3_1_bcfc8a06:

    # ggg "And who are you now?! Judge? Executioner?!"
    ggg "那你现在算什么？！法官？刽子手？！"

# game/Story03.rpy:3846
translate chinese akt3chapter3_1_97438224:

    # a "If needed, both."
    a "需要的话，都是。"

# game/Story03.rpy:3847
translate chinese akt3chapter3_1_fd22e77e:

    # mc "...No."
    mc "……不。"

# game/Story03.rpy:3848
translate chinese akt3chapter3_1_71904949:

    # mc "I’m not doing it."
    mc "我不干。"

# game/Story03.rpy:3851
translate chinese akt3chapter3_1_ff5c8c31:

    # k "So it's a {b}bullet in the back{/b}, after all?"
    k "所以终究还是{b}后背挨一枪{/b}？"

# game/Story03.rpy:3854
translate chinese akt3chapter3_1_2b35b6fe_2:

    # mc "..."
    mc "……"

# game/Story03.rpy:3857
translate chinese akt3chapter3_1_ee01286a:

    # mc "If I fly, someone lives."
    mc "要是我开，有人能活。"

# game/Story03.rpy:3859
translate chinese akt3chapter3_1_6a8b7c10:

    # mc "If I walk away, we’re all dead."
    mc "要是我走开，我们都得死。"

# game/Story03.rpy:3861
translate chinese akt3chapter3_1_2b35b6fe_3:

    # mc "..."
    mc "……"

# game/Story03.rpy:3863
translate chinese akt3chapter3_1_8ac00661:

    # mc "...I’ll do it."
    mc "……我来开。"

# game/Story03.rpy:3865
translate chinese akt3chapter3_1_e2390ffe:

    # gg "He’s actually going."
    gg "他真要上。"

# game/Story03.rpy:3869
translate chinese akt3chapter3_1_4610aef8:

    # mc "And that blood better not be wasted."
    mc "那这血最好别白流。"

# game/Story03.rpy:3879
translate chinese akt3chapter3_1_451b5c6f:

    # gg "To the Transporter. Now!"
    gg "去运输船。快！"

# game/Story03.rpy:3888
translate chinese akt3chapter3_1_605a7f54:

    # mc "(Don’t screw this up...)"
    mc "（别搞砸了……）"

# game/Story03.rpy:3890
translate chinese akt3chapter3_1_bf4958b8:

    # mc "(Where’s the panel...?)"
    mc "（面板在哪儿……？）"

# game/Story03.rpy:3893
translate chinese akt3chapter3_1_30a01531:

    # mc "(The implant is feeding me prompts through the interface.)"
    mc "（植入体正通过界面给我提示。）"

# game/Story03.rpy:3894
translate chinese akt3chapter3_1_b63013f4:

    # mc "(Not enough to make me a pilot. Enough to stop guessing.)"
    mc "（不足以让我变成飞行员。但够让我不用瞎猜。）"

# game/Story03.rpy:3895
translate chinese akt3chapter3_1_0faf7c5a:

    # mc "(Start... there.)"
    mc "（从……那儿开始。）"

# game/Story03.rpy:3900
translate chinese akt3chapter3_1_813c7211:

    # mc "(Got it. Turbines...)"
    mc "（找到了。涡轮……）"

# game/Story03.rpy:3901
translate chinese akt3chapter3_1_ab629576:

    # mc "(Come on...)"
    mc "（来吧……）"

# game/Story03.rpy:3904
translate chinese akt3chapter3_1_280e5c12:

    # mc "(...No.)"
    mc "（……不行。）"

# game/Story03.rpy:3905
translate chinese akt3chapter3_1_2af83fc1:

    # mc "(Not now.)"
    mc "（别是现在。）"

# game/Story03.rpy:3908
translate chinese akt3chapter3_1_757be55a:

    # mc "(Fuel’s dropping. Red light. Pressure’s crashing.)"
    mc "（燃料在掉。红灯。压力在崩。）"

# game/Story03.rpy:3913
translate chinese akt3chapter3_1_1e74a45e:

    # mc "(Where’s the drain? Where’s the failsafe?! Where—)"
    mc "（排流阀在哪儿？保险装置在哪儿？！在哪——）"

# game/Story03.rpy:3916
translate chinese akt3chapter3_1_d6a7a0d4:

    # Mi "Your safety is the priority. The rest is mine to handle."
    Mi "你的安全是第一位的。剩下的交给我。"

# game/Story03.rpy:3917
translate chinese akt3chapter3_1_4da8e47d:

    # Mi "Move to the ship. Now."
    Mi "上船。现在。"

# game/Story03.rpy:3920
translate chinese akt3chapter3_1_aa27878e:

    # el "Mir... Please be careful, alright?"
    el "米尔……千万小心，好吗？"

# game/Story03.rpy:3923
translate chinese akt3chapter3_1_15d9ce2d:

    # el "Go! Anyone who can move — get to the bays! This is our shot!"
    el "走！能动的人都去舱口！这是我们唯一的机会！"

# game/Story03.rpy:3924
translate chinese akt3chapter3_1_da3fdbf1:

    # Mi "..."
    Mi "……"

# game/Story03.rpy:3925
translate chinese akt3chapter3_1_dae17119:

    # Mi "How many more are there..?"
    Mi "还有多少……？"

# game/Story03.rpy:3927
translate chinese akt3chapter3_1_76a4db82:

    # H "Scan... 783 targets. Total elimination — impossible."
    H "扫描……783 个目标。全部清除——不可能。"

# game/Story03.rpy:3928
translate chinese akt3chapter3_1_565eee6f:

    # Mi "(Time till breach?..)"
    Mi "（还有多久被突破……？）"

# game/Story03.rpy:3929
translate chinese akt3chapter3_1_eb4846ec:

    # H "Defense will collapse in 7 minutes."
    H "防线将在 7 分钟后崩溃。"

# game/Story03.rpy:3930
translate chinese akt3chapter3_1_396d612f:

    # Mi "(Patch me to the pilot.)"
    Mi "（给我接飞行员。）"

# game/Story03.rpy:3933
translate chinese akt3chapter3_1_fd5e8cfa:

    # Mi "Cold Reaper. Who's at the helm? I need full status."
    Mi "冷酷收割者。谁在驾驶？我要完整状态。"

# game/Story03.rpy:3935
translate chinese akt3chapter3_1_69872871:

    # mc "Miriel?! That you?! What the hell are you doing here?!"
    mc "米莉尔？！是你？！你他妈在这儿干嘛？！"

# game/Story03.rpy:3936
translate chinese akt3chapter3_1_7b014783:

    # Mi "[mc]? Patch me through to the lead pilot. Now."
    Mi "[mc]？给我接主飞行员。现在。"

# game/Story03.rpy:3937
translate chinese akt3chapter3_1_a75b9746:

    # mc "I am the goddamn lead pilot!"
    mc "我就是他妈的主飞行员！"

# game/Story03.rpy:3939
translate chinese akt3chapter3_1_a134b853:

    # mc "And we’ve got a problem — fuel locks won’t seal. The whole thing’s held together with duct tape and prayers!"
    mc "而且我们有麻烦了——燃料锁封不上。整艘船就是靠胶带和祈祷撑着的！"

# game/Story03.rpy:3945
translate chinese akt3chapter3_1_4297302a:

    # mc "Look outside. Fast!"
    mc "看外面。快！"

# game/Story03.rpy:3947
translate chinese akt3chapter3_1_eaa1fd0b:

    # Mi "Bad. One's stuck. For good. If I pull it — we explode."
    Mi "糟。有一个卡死了。彻底卡死。要是我硬拔——我们就炸。"

# game/Story03.rpy:3949
translate chinese akt3chapter3_1_428b4a2c:

    # mc "Wonderful. Just freaking great."
    mc "好极了。真他妈好极了。"

# game/Story03.rpy:3950
translate chinese akt3chapter3_1_6a82a8c1:

    # mc "Tell me. Can you pull it out or not?!"
    mc "告诉我。你到底能不能拔出来？！"

# game/Story03.rpy:3952
translate chinese akt3chapter3_1_6619b253:

    # Mi "...Risk of blowing the whole bay. But yes. I can."
    Mi "……有可能炸掉整个舱。但能。我可以。"

# game/Story03.rpy:3953
translate chinese akt3chapter3_1_12d7d528:

    # mc "Pull it."
    mc "拔。"

# game/Story03.rpy:3954
translate chinese akt3chapter3_1_32691724:

    # mc "If we wait, we’re dead anyway."
    mc "等下去，反正都是死。"

# game/Story03.rpy:3957
translate chinese akt3chapter3_1_7726fb4c:

    # Mi "(I can’t afford a mistake. Not for them. Not for all the elves inside.)"
    Mi "（我不能出错。为了他们不行。为了里面所有精灵也不行。）"

# game/Story03.rpy:3958
translate chinese akt3chapter3_1_62bb6b73:

    # H "Reaper system activation. Initializing..."
    H "收割者系统启动。初始化中……"

# game/Story03.rpy:3961
translate chinese akt3chapter3_1_c0f8140d:

    # H "All phases complete. Reaper mode activated. Happy hunting, Miss Miriel."
    H "全部阶段完成。收割者模式已激活。狩猎愉快，米莉尔小姐。"

# game/Story03.rpy:3963
translate chinese akt3chapter3_1_4a7b308c:

    # Mi "Beginning sweep."
    Mi "开始清扫。"

# game/Story03.rpy:3966
translate chinese akt3chapter3_1_46cdda5b:

    # mc "(Too many lives on this...)"
    mc "（这上面系着太多条命……）"

# game/Story03.rpy:3967
translate chinese akt3chapter3_1_0814eb95:

    # mc "(Focus.)"
    mc "（专注。）"

# game/Story03.rpy:3970
translate chinese akt3chapter3_1_e8991f85:

    # mc "(There you are...)"
    mc "（找到你了……）"

# game/Story03.rpy:3971
translate chinese akt3chapter3_1_ab629576_1:

    # mc "(Come on...)"
    mc "（来吧……）"

# game/Story03.rpy:3975
translate chinese akt3chapter3_1_d8d2e292:

    # mc "(IT WORKED! HOLY SHIT, IT’S WORKING!)"
    mc "（成了！我靠，真成了！）"

# game/Story03.rpy:3977
translate chinese akt3chapter3_1_100e2981:

    # Mi "...That’ll slow them down."
    Mi "……这能拖住它们。"

# game/Story03.rpy:3980
translate chinese akt3chapter3_1_021cdd16:

    # mc "Miriel, get your ass out of there. We’re getting out."
    mc "米莉尔，赶紧撤出来。我们要走了。"

# game/Story03.rpy:4004
translate chinese akt3chapter3_2_da6c1eb6:

    # mc "(Barely made it... thought it was over for a second...)"
    mc "（差点没赶上……有那么一瞬以为完了……）"

# game/Story03.rpy:4007
translate chinese akt3chapter3_2_d345d2cd:

    # mc "How’s everyone else?"
    mc "其他人怎么样？"

# game/Story03.rpy:4009
translate chinese akt3chapter3_2_4b7353a4:

    # Mi "Mixed. Some are stitching themselves back together. Some are just lying still."
    Mi "有好有坏。有的在把自己缝回去。有的就那么躺着不动。"

# game/Story03.rpy:4011
translate chinese akt3chapter3_2_095d8692:

    # mc "(Could use a bit of stitching myself, but…)"
    mc "（我自己也该缝几针，不过……）"

# game/Story03.rpy:4012
translate chinese akt3chapter3_2_75cd710f:

    # mc "(As always, no time to think about myself.)"
    mc "（老样子，没时间顾自己。）"

# game/Story03.rpy:4013
translate chinese akt3chapter3_2_5cf1faeb:

    # mc "And you?"
    mc "你呢？"

# game/Story03.rpy:4016
translate chinese akt3chapter3_2_aefae15e:

    # Mi "Counting losses."
    Mi "清点损失。"

# game/Story03.rpy:4018
translate chinese akt3chapter3_2_ea7f6c81:

    # mc "(She came here... just to see me?)"
    mc "（她来这儿……就为了见我？）"

# game/Story03.rpy:4020
translate chinese akt3chapter3_2_94075107:

    # mc "Thanks, I guess."
    mc "谢了，大概吧。"

# game/Story03.rpy:4022
translate chinese akt3chapter3_2_0a26bf77:

    # Mi "There’s an autopilot here."
    Mi "这里有自动驾驶。"

# game/Story03.rpy:4025
translate chinese akt3chapter3_2_f4a6cf1c:

    # mc "Wait, really?!"
    mc "等等，真的？！"

# game/Story03.rpy:4026
translate chinese akt3chapter3_2_030d78f5:

    # Mi "But it only holds a route once someone sets it manually."
    Mi "但得有人先手动设定，它才能保持航线。"

# game/Story03.rpy:4027
translate chinese akt3chapter3_2_cce2f0e1:

    # Mi "It couldn't have launched us. Not from that bay. Not under fire."
    Mi "它不可能带我们起飞。从那个舱不行。在火力下更不行。"

# game/Story03.rpy:4029
translate chinese akt3chapter3_2_da3fdbf1:

    # Mi "..."
    Mi "……"

# game/Story03.rpy:4033
translate chinese akt3chapter3_2_2b35b6fe:

    # mc "..."
    mc "……"

# game/Story03.rpy:4036
translate chinese akt3chapter3_2_27dd6e80:

    # mc "You’ve got to be kidding me..."
    mc "你开玩笑吧……"

# game/Story03.rpy:4038
translate chinese akt3chapter3_2_3d18f680:

    # Mi "Joking isn’t in my nature."
    Mi "我天生不会开玩笑。"

# game/Story03.rpy:4040
translate chinese akt3chapter3_2_db427f4c:

    # Mi "Better save your strength now."
    Mi "最好现在省点力气。"

# game/Story03.rpy:4041
translate chinese akt3chapter3_2_3acd2c07:

    # Mi "Where are the others?"
    Mi "其他人在哪儿？"

# game/Story03.rpy:4043
translate chinese akt3chapter3_2_ab0eb14b:

    # mc "Far as I know — Sector Three."
    mc "据我所知——第 3 区。"

# game/Story03.rpy:4045
translate chinese akt3chapter3_2_c72dd2ac:

    # Mi "Understood."
    Mi "明白。"

# game/Story03.rpy:4047
translate chinese akt3chapter3_2_2b35b6fe_1:

    # mc "..."
    mc "……"

# game/Story03.rpy:4048
translate chinese akt3chapter3_2_da3fdbf1_1:

    # Mi "..."
    Mi "……"

# game/Story03.rpy:4051
translate chinese akt3chapter3_2_a2b93d28:

    # mc "So… what about Winter? And the lower city?"
    mc "那……温特呢？下城呢？"

# game/Story03.rpy:4054
translate chinese akt3chapter3_2_addbed3f:

    # Mi "He agreed."
    Mi "他答应了。"

# game/Story03.rpy:4057
translate chinese akt3chapter3_2_b77ad661:

    # mc "Seriously?!"
    mc "真的？！"

# game/Story03.rpy:4060
translate chinese akt3chapter3_2_42a9d288:

    # Mi "He didn’t have a choice."
    Mi "他没得选。"

# game/Story03.rpy:4064
translate chinese akt3chapter3_2_52649b70:

    # mc "Honestly didn’t see that coming. He struck me as the kind of man who never backs down."
    mc "老实说没想到。他给我的印象是那种绝不退让的人。"

# game/Story03.rpy:4067
translate chinese akt3chapter3_2_015dd9d8:

    # Mi "When it’s the ones you love on the line — pride means nothing."
    Mi "当赌上的是你爱的人——自尊一文不值。"

# game/Story03.rpy:4069
translate chinese akt3chapter3_2_698e7949:

    # mc "You’ve had to make that choice too, haven’t you?"
    mc "你也做过这种选择，对吧？"

# game/Story03.rpy:4071
translate chinese akt3chapter3_2_7ffa6c43:

    # Mi "It’s not a ‘had to’. It’s just how things are."
    Mi "不是“不得不”。事情本来就是这样。"

# game/Story03.rpy:4077
translate chinese akt3chapter3_2_da67fb92:

    # mc "No choice, huh..."
    mc "没得选，是吗……"

# game/Story03.rpy:4079
translate chinese akt3chapter3_2_4a4a0fcc:

    # mc "And the ones with you… all of them?"
    mc "那你带出来的人……全都活着？"

# game/Story03.rpy:4080
translate chinese akt3chapter3_2_d4bb0e92:

    # Mi "The ones I managed to pull out."
    Mi "我拉出来的那些活着。"

# game/Story03.rpy:4081
translate chinese akt3chapter3_2_111fb31d:

    # mc "So… not all."
    mc "所以……不是全部。"

# game/Story03.rpy:4082
translate chinese akt3chapter3_2_95ce11d4:

    # Mi "The rest were taken by Yong."
    Mi "其余的，被勇带走了。"

# game/Story03.rpy:4083
translate chinese akt3chapter3_2_0614a5a9:

    # mc "But where are you headed now?"
    mc "那你现在要去哪儿？"

# game/Story03.rpy:4084
translate chinese akt3chapter3_2_7e4480d9:

    # Mi "Safe zone. After that — doesn’t matter."
    Mi "安全区。之后——无所谓了。"

# game/Story03.rpy:4085
translate chinese akt3chapter3_2_46fe282c:

    # mc "Got it..."
    mc "明白了……"

# game/Story03.rpy:4089
translate chinese akt3chapter3_2_e26ea0f8:

    # mc "About what happened… I’m sorry I vanished like that."
    mc "关于之前的事……抱歉我就那么消失了。"

# game/Story03.rpy:4093
translate chinese akt3chapter3_2_da3fdbf1_2:

    # Mi "..."
    Mi "……"

# game/Story03.rpy:4095
translate chinese akt3chapter3_2_ac5d8a1e:

    # Mi "They told me what happened."
    Mi "他们告诉我发生了什么。"

# game/Story03.rpy:4096
translate chinese akt3chapter3_2_a5019b35:

    # Mi "I’d have done the same."
    Mi "换我也会那样做。"

# game/Story03.rpy:4098
translate chinese akt3chapter3_2_a7a5c89c:

    # mc "So you’re not mad?"
    mc "所以你不生气？"

# game/Story03.rpy:4101
translate chinese akt3chapter3_2_2b35b6fe_2:

    # mc "..."
    mc "……"

# game/Story03.rpy:4104
translate chinese akt3chapter3_2_2b35b6fe_3:

    # mc "..."
    mc "……"

# game/Story03.rpy:4106
translate chinese akt3chapter3_2_1111532b:

    # Mi "We’re even."
    Mi "我们扯平了。"

# game/Story03.rpy:4107
translate chinese akt3chapter3_2_59169f25:

    # Mi "And… how is she?"
    Mi "还有……她怎么样？"

# game/Story03.rpy:4110
translate chinese akt3chapter3_2_f835a620:

    # mc "Who do you mean?"
    mc "你说谁？"

# game/Story03.rpy:4112
translate chinese akt3chapter3_2_b9a57403:

    # Mi "The one you’re here for."
    Mi "你为之而来的那个人。"

# game/Story03.rpy:4114
translate chinese akt3chapter3_2_c5d19339:

    # mc "...You mean Lora? It’s complicated. She’s changed. Too much."
    mc "……你说洛拉？很复杂。她变了。变得太多。"

# game/Story03.rpy:4115
translate chinese akt3chapter3_2_e6ea2897:

    # mc "I still recognize her... but deep down, something says — that’s not the same Lora."
    mc "我还认得出她……可心底有个声音说——那不是同一个洛拉了。"

# game/Story03.rpy:4117
translate chinese akt3chapter3_2_6757d0fc:

    # mc "I thought once we met again, everything would go back to how it was."
    mc "我以为再见面之后，一切就能回到从前。"

# game/Story03.rpy:4118
translate chinese akt3chapter3_2_8bf4c9d8:

    # mc "But I was wrong. We both changed. And…"
    mc "可我错了。我们都变了。而且……"

# game/Story03.rpy:4120
translate chinese akt3chapter3_2_65c577a3:

    # Mi "You carry too much on your shoulders."
    Mi "你肩上扛得太多了。"

# game/Story03.rpy:4122
translate chinese akt3chapter3_2_a455fcb2:

    # mc "Maybe… But if not me, then who?"
    mc "也许吧……可要不是我，还能是谁？"

# game/Story03.rpy:4124
translate chinese akt3chapter3_2_ce76d0ff:

    # mc "She’s been through so much. I have to try. Somehow."
    mc "她受了太多苦。我得试试。无论如何。"

    # game/Story03.rpy:4126
translate chinese akt3chapter3_2_641dcf98:

    # mc "(That’s right, [mc], even if it means losing yourself…)"
    mc "（没错，[mc]，哪怕这意味着弄丢你自己……）"

# game/Story03.rpy:4129
translate chinese akt3chapter3_2_da3fdbf1_3:

    # Mi "..."
    Mi "……"

# game/Story03.rpy:4131
translate chinese akt3chapter3_2_bde4ed72:

    # Mi "You once told me: asking for help isn’t weakness."
    Mi "你以前告诉过我：求助不是软弱。"

# game/Story03.rpy:4133
translate chinese akt3chapter3_2_abb4083f:

    # mc "Maybe you’re right, but…"
    mc "也许你说得对，可是……"

# game/Story03.rpy:4144
translate chinese akt3chapter3_2_3489aed8:

    # Mi "You’re doing it."
    Mi "你在做。"

# game/Story03.rpy:4145
translate chinese akt3chapter3_2_c648ff15:

    # Mi "Not everyone could."
    Mi "不是谁都做得到。"

# game/Story03.rpy:4147
translate chinese akt3chapter3_2_d9956fbf:

    # mc "But this is different. Lives depend on me."
    mc "可这次不一样。好几条命都指着我。"

# game/Story03.rpy:4149
translate chinese akt3chapter3_2_f9991d93:

    # mc "If I break — it all collapses."
    mc "我一垮——全都塌。"

# game/Story03.rpy:4153
translate chinese akt3chapter3_2_eb6c1032:

    # Mi "Enough."
    Mi "够了。"

# game/Story03.rpy:4154
translate chinese akt3chapter3_2_a2f3f1cd:

    # Mi "I don’t care what kind of nonsense you’ve built up in your head."
    Mi "我不管你脑子里攒了多少胡话。"

# game/Story03.rpy:4156
translate chinese akt3chapter3_2_14767483:

    # Mi "You’re not alone. I’m with you. Whatever that means, whatever it takes. Got it?"
    Mi "你不是一个人。我在你身边。不管那意味着什么，不管要付出什么。明白吗？"

# game/Story03.rpy:4158
translate chinese akt3chapter3_2_2b35b6fe_4:

    # mc "..."
    mc "……"

# game/Story03.rpy:4159
translate chinese akt3chapter3_2_bf930c05:

    # mc "(She’s so close… and her hand’s trembling…)"
    mc "（她离得好近……她的手在抖……）"

# game/Story03.rpy:4161
translate chinese akt3chapter3_2_ab2d6bae:

    # mc "You’re shaking… Are you okay?"
    mc "你在发抖……你没事吧？"

# game/Story03.rpy:4163
translate chinese akt3chapter3_2_c8c91fa9:

    # Mi "I don’t know…"
    Mi "我不知道……"

# game/Story03.rpy:4165
translate chinese akt3chapter3_2_88342d7a:

    # mc "(Her eyes… so much pain… and hope?)"
    mc "（她的眼睛……那么多痛……还有希望？）"

# game/Story03.rpy:4169
translate chinese akt3chapter3_2_2b35b6fe_5:

    # mc "..."
    mc "……"

# game/Story03.rpy:4171
translate chinese akt3chapter3_2_da3fdbf1_4:

    # Mi "..."
    Mi "……"

# game/Story03.rpy:4175
translate chinese akt3chapter3_2_c6ced3b3:

    # Mi "No…"
    Mi "不……"

# game/Story03.rpy:4176
translate chinese akt3chapter3_2_180af67f:

    # mc "Miriel—"
    mc "米莉尔——"

# game/Story03.rpy:4179
translate chinese akt3chapter3_2_37c761dc:

    # Mi "I’m sorry. That was a mistake."
    Mi "对不起。那是我的错。"

# game/Story03.rpy:4181
translate chinese akt3chapter3_2_a0d8248b:

    # mc "(No… it wasn’t. Just… too sudden.)"
    mc "（不……那不是错。只是……太突然了。）"

# game/Story03.rpy:4183
translate chinese akt3chapter3_2_85d135e3:

    # mc "(I wonder… if things had gone differently… could I have held on to her?)"
    mc "（不知道……要是事情不是这样……我能不能留住她？）"

# game/Story03.rpy:4200
translate chinese akt3chapter3_3_2226b703:

    # "Sector 3-S."
    "第 3-S 区。"

# game/Story03.rpy:4202
translate chinese akt3chapter3_3_eab69095:

    # Fl "Come on, dammit, don’t break on me now. Just a little more…"
    Fl "拜托，该死的，别现在给我坏。再撑一点……"

# game/Story03.rpy:4205
translate chinese akt3chapter3_3_673f5ea4:

    # Fl "If you’re not some Empire-flash, get lost."
    Fl "你要不是帝国那边的狗腿子，就给我滚。"

# game/Story03.rpy:4207
translate chinese akt3chapter3_3_2f1695d8:

    # em "Still no luck?"
    em "还是没戏？"

# game/Story03.rpy:4210
translate chinese akt3chapter3_3_0ace4b5a:

    # Fl "Ah, Ember. It’s you."
    Fl "啊，恩伯。是你。"

# game/Story03.rpy:4212
translate chinese akt3chapter3_3_08fc1af8:

    # Fl "No."
    Fl "没。"

# game/Story03.rpy:4215
translate chinese akt3chapter3_3_5495681b:

    # Fl "Dad risked his life for this."
    Fl "我爸拿命换来的这个。"

# game/Story03.rpy:4220
translate chinese akt3chapter3_3_1fba655c:

    # Fl "And me… I can’t even peek inside. Hilarious, huh?"
    Fl "而我……连往里看一眼都做不到。好笑吧？"

# game/Story03.rpy:4222
translate chinese akt3chapter3_3_c0c4dd5e:

    # em "Giving up?"
    em "要放弃？"

# game/Story03.rpy:4225
translate chinese akt3chapter3_3_ee355051:

    # Fl "(whispering) I won’t give up. Ever."
    Fl "（低声）我不会放弃。绝不。"

# game/Story03.rpy:4226
translate chinese akt3chapter3_3_a76dc049:

    # Fl "Let my whole damn bloodline burn, but I’m finishing this!"
    Fl "就算我家血脉全烧光，我也要把这事做完！"

# game/Story03.rpy:4229
translate chinese akt3chapter3_3_8b482f5c:

    # Fl "So, what are you here for?"
    Fl "那你来干嘛？"

# game/Story03.rpy:4231
translate chinese akt3chapter3_3_c9a87a94:

    # em "Came to check the genius hasn’t burned herself out in her own chains."
    em "来看看这位天才有没有被自己的枷锁烧干。"

# game/Story03.rpy:4233
translate chinese akt3chapter3_3_41da62cb:

    # Fl "..."
    Fl "……"

# game/Story03.rpy:4236
translate chinese akt3chapter3_3_da1542f9:

    # Fl "You’d be surprised how fast this place turns a genius into a leper."
    Fl "你会惊讶，这地方多快就能把天才变成麻风病人。"

# game/Story03.rpy:4239
translate chinese akt3chapter3_3_00a0b108:

    # Fl "To them, I’m just the girl who signed the death warrant for hundreds, oh, sorry, thousands. Classic, right?"
    Fl "在他们眼里，我就是那个签了几百人死刑令的姑娘，哦抱歉，是几千人。老套吧？"

# game/Story03.rpy:4242
translate chinese akt3chapter3_3_f2bb268e:

    # em "In exchange for hundred thousand mutants."
    em "换来十万变异体。"

# game/Story03.rpy:4245
translate chinese akt3chapter3_3_8d3f7461:

    # Fl "At the cost of almost everyone who still believed in my father."
    Fl "代价是几乎所有还信我父亲的人。"

# game/Story03.rpy:4247
translate chinese akt3chapter3_3_85559fbf:

    # em "We’re all going to die, Flora."
    em "我们都会死，弗洛拉。"

# game/Story03.rpy:4248
translate chinese akt3chapter3_3_bd83b348:

    # em "The question is how we lived."
    em "问题在于我们怎么活过。"

# game/Story03.rpy:4252
translate chinese akt3chapter3_3_af9e0a50:

    # em "..."
    em "……"

# game/Story03.rpy:4254
translate chinese akt3chapter3_3_2a362a0c:

    # em "...They died as heroes."
    em "……他们死得像英雄。"

# game/Story03.rpy:4256
translate chinese akt3chapter3_3_c536bb12:

    # Fl "And we stayed behind."
    Fl "而我们留了下来。"

# game/Story03.rpy:4258
translate chinese akt3chapter3_3_d49eeb22:

    # Fl "To watch it all spiral into the gate."
    Fl "眼睁睁看着一切卷进门里。"

# game/Story03.rpy:4259
translate chinese akt3chapter3_3_32747935:

    # Fl "To watch everything they fought for get erased."
    Fl "看着他们为之奋斗的一切被抹掉。"

# game/Story03.rpy:4260
translate chinese akt3chapter3_3_83da2052:

    # Fl "To watch no one be held accountable."
    Fl "看着没人被追责。"

# game/Story03.rpy:4262
translate chinese akt3chapter3_3_49d9212f:

    # em "Command’s a joke. Bureaucrats with implants where their souls should be."
    em "指挥部就是个笑话。一群官僚，灵魂的位置上装着植入体。"

# game/Story03.rpy:4265
translate chinese akt3chapter3_3_3699bab2:

    # em "To them, you’re just a number. Your people, numbers. The dead, statistics."
    em "对他们来说，你只是个数字。你的人，数字。死人，统计数。"

# game/Story03.rpy:4267
translate chinese akt3chapter3_3_5a009dc8:

    # em "People like them will rot on their thrones till they tear each other apart."
    em "他们那种人会在王座上烂掉，直到互相撕碎。"

# game/Story03.rpy:4271
translate chinese akt3chapter3_3_633b408d:

    # Fl "That’s why I’m angry. We let the innocent die."
    Fl "所以我生气。我们任由无辜的人去死。"

# game/Story03.rpy:4273
translate chinese akt3chapter3_3_78263d4d:

    # Fl "We keep making the same damn mistake."
    Fl "我们一直在犯同一个该死的错。"

# game/Story03.rpy:4275
translate chinese akt3chapter3_3_0c4df5ee:

    # em "You take after your mother…"
    em "你随你母亲……"

# game/Story03.rpy:4277
translate chinese akt3chapter3_3_546e0809:

    # Fl "No. She was naive. Wanted to change the world — and it devoured her alive."
    Fl "不。她太天真。想改变世界——结果被世界活活吞了。"

# game/Story03.rpy:4280
translate chinese akt3chapter3_3_09013f97:

    # em "You’d know best."
    em "你最清楚。"

# game/Story03.rpy:4281
translate chinese akt3chapter3_3_41da62cb_1:

    # Fl "..."
    Fl "……"

# game/Story03.rpy:4282
translate chinese akt3chapter3_3_f2b5c327:

    # em "If you ever need help — just say the word."
    em "要是需要帮忙——说一声就行。"

# game/Story03.rpy:4285
translate chinese akt3chapter3_3_b45d1f37:

    # Fl "Thanks, but… I don’t know how to share the weight. I’m used to dragging it all myself."
    Fl "谢了，可是……我不会分担重量。我习惯一个人扛。"

# game/Story03.rpy:4295
translate chinese akt3chapter3_3_70a8ebbe:

    # em "And yet you’ll pull it off."
    em "可你还是能办到。"

# game/Story03.rpy:4297
translate chinese akt3chapter3_3_b7abe60d:

    # Fl "I know. That’s the problem."
    Fl "我知道。问题就在这儿。"

# game/Story03.rpy:4302
translate chinese akt3chapter3_3_af9e0a50_1:

    # em "..."
    em "……"

# game/Story03.rpy:4305
translate chinese akt3chapter3_3_e5cb2fab:

    # Fl "What?"
    Fl "怎么？"

# game/Story03.rpy:4306
translate chinese akt3chapter3_3_af9e0a50_2:

    # em "..."
    em "……"

# game/Story03.rpy:4308
translate chinese akt3chapter3_3_f4a0a42e:

    # em "Skarlea’s already here."
    em "斯卡蕾娅已经来了。"

# game/Story03.rpy:4312
translate chinese akt3chapter3_3_e1f58152:

    # Fl "What the hell is she doing there?!"
    Fl "她他妈在那儿干嘛？！"

# game/Story03.rpy:4316
translate chinese akt3chapter3_3_f6b94157:

    # em "Ask her yourself."
    em "你自己问她。"

# game/Story03.rpy:4318
translate chinese akt3chapter3_3_c674bc1b:

    # scar "(Hmm… Security system, 2 out of 10.)"
    scar "（嗯……安保系统，十分打两分。）"

# game/Story03.rpy:4320
translate chinese akt3chapter3_3_3337434e:

    # gg "Commander, multiple hostiles en route to the lower city."
    gg "指挥官，多个敌对目标正前往下城。"

# game/Story03.rpy:4321
translate chinese akt3chapter3_3_0411fed6:

    # gg "Looks like the second mutant wave."
    gg "看着像第二波变异体。"

# game/Story03.rpy:4323
translate chinese akt3chapter3_3_9c3dce77:

    # g "Syndicate territory? Do not engage."
    g "辛迪加的地盘？别交战。"

# game/Story03.rpy:4324
translate chinese akt3chapter3_3_e705ef17:

    # gg "Sir, but that’s not tactica—"
    gg "长官，可这战术上——"

# game/Story03.rpy:4325
translate chinese akt3chapter3_3_f08b439a:

    # g "Stand down."
    g "退下。"

# game/Story03.rpy:4328
translate chinese akt3chapter3_3_0070e140:

    # gggg "Unidentified object heading straight for us."
    gggg "不明物体正径直朝我们飞来。"

# game/Story03.rpy:4329
translate chinese akt3chapter3_3_4c53a510:

    # gggg "From the cargo bays, possibly a transport."
    gggg "从货舱方向来，可能是艘运输船。"

# game/Story03.rpy:4330
translate chinese akt3chapter3_3_5bb05914:

    # g "Any response from the pilot?"
    g "飞行员有回应吗？"

# game/Story03.rpy:4332
translate chinese akt3chapter3_3_9c7cec87:

    # gg "No. No reply."
    gg "没有。无回应。"

# game/Story03.rpy:4333
translate chinese akt3chapter3_3_4da78630:

    # gg "Last known location — lower city."
    gg "最后已知位置——下城。"

# game/Story03.rpy:4335
translate chinese akt3chapter3_3_323dbd60:

    # g "Open fire."
    g "开火。"

# game/Story03.rpy:4336
translate chinese akt3chapter3_3_b3a3fccb:

    # gg "But—"
    gg "可是——"

# game/Story03.rpy:4337
translate chinese akt3chapter3_3_310d3096:

    # g "Do it."
    g "执行。"

# game/Story03.rpy:4353
translate chinese akt3chapter3_4_304ed637:

    # "Sector 3-S. Lower City."
    "第 3-S 区。下城。"

# game/Story03.rpy:4354
translate chinese akt3chapter3_4_2b009786:

    # mc "...Lower city."
    mc "……下城。"

# game/Story03.rpy:4355
translate chinese akt3chapter3_4_ad09b856:

    # mc "Shit."
    mc "妈的。"

# game/Story03.rpy:4357
translate chinese akt3chapter3_4_10bdd5c8:

    # mc "(If it’s this bad below...)"
    mc "（要是下面都这么惨……）"

# game/Story03.rpy:4359
translate chinese akt3chapter3_4_0871a804:

    # mc "(What’s happening up top?)"
    mc "（上面又是什么光景？）"

# game/Story03.rpy:4363
translate chinese akt3chapter3_4_0f69fa0f:

    # mc "(What the—)"
    mc "（什么鬼——）"

# game/Story03.rpy:4370
translate chinese akt3chapter3_4_f66dbfff:

    # mc "No. Not this."
    mc "不。别是这个。"

# game/Story03.rpy:4373
translate chinese akt3chapter3_4_806995fa:

    # a "Focus. Panic comes later."
    a "专注。恐慌留到后面。"

# game/Story03.rpy:4374
translate chinese akt3chapter3_4_c9ba6e42:

    # a "Status."
    a "报告状态。"

# game/Story03.rpy:4376
translate chinese akt3chapter3_4_d6dcbb26:

    # mc "Someone’s tearing the place apart."
    mc "有人在把这地方拆了。"

# game/Story03.rpy:4377
translate chinese akt3chapter3_4_2dec1211:

    # mc "And they’re doing it fast."
    mc "而且拆得很快。"

# game/Story03.rpy:4379
translate chinese akt3chapter3_4_7be646ee:

    # a "Time to target?"
    a "到目标还有多久？"

# game/Story03.rpy:4381
translate chinese akt3chapter3_4_3cddec90:

    # mc "No clue. Everything’s gone sideways."
    mc "不知道。全乱套了。"

# game/Story03.rpy:4383
translate chinese akt3chapter3_4_22d327a1:

    # a "I’ll handle it. You just get us there faster."
    a "我来处理。你只管把我们快点送到。"

# game/Story03.rpy:4385
translate chinese akt3chapter3_4_456bef91:

    # mc "Copy that."
    mc "收到。"

# game/Story03.rpy:4388
translate chinese akt3chapter3_4_b2a032e6:

    # a "(Time to test this beast.)"
    a "（该试试这头野兽了。）"

# game/Story03.rpy:4392
translate chinese akt3chapter3_4_0c9c8e31:

    # H "Auto-turret system: Switching to manual control."
    H "自动炮塔系统：切换至手动控制。"

# game/Story03.rpy:4394
translate chinese akt3chapter3_4_8046d5bb:

    # a "Manual mode. Target in sight."
    a "手动模式。目标已锁定。"

# game/Story03.rpy:4404
translate chinese akt3chapter3_4_90e317fe:

    # mc "(No idea how this works...)"
    mc "（完全不知道这玩意儿怎么运作……）"

# game/Story03.rpy:4405
translate chinese akt3chapter3_4_b7efd87f:

    # mc "(Figure it out or die.)"
    mc "（要么搞明白，要么死。）"

# game/Story03.rpy:4409
translate chinese akt3chapter3_4_25f78c35:

    # mc "This won’t be smooth."
    mc "这趟不会平稳。"

# game/Story03.rpy:4412
translate chinese akt3chapter3_4_595ef682:

    # gg "We’ll chew through it. {w=0.2}Missile, eight o’clock!"
    gg "我们能啃过去。{w=0.2}导弹，八点钟方向！"

# game/Story03.rpy:4414
translate chinese akt3chapter3_4_26c56264:

    # a "Neutralized."
    a "已清除。"

# game/Story03.rpy:4415
translate chinese akt3chapter3_4_78b18c5f:

    # gg "Another one! Four o’clock!"
    gg "又来一枚！四点钟方向！"

# game/Story03.rpy:4417
translate chinese akt3chapter3_4_d213e880:

    # k "This baby’s mine."
    k "这个小宝贝归我了。"

# game/Story03.rpy:4418
translate chinese akt3chapter3_4_b4a10064:

    # k "(whispering) Time to break the boredom..."
    k "（低声）该打破无聊了……"

# game/Story03.rpy:4420
translate chinese akt3chapter3_4_558bd34b:

    # mc "Kalestra?! Get back inside!"
    mc "卡莱斯特拉？！回里面去！"

# game/Story03.rpy:4422
translate chinese akt3chapter3_4_b5409310:

    # k "Relax, I’ve got this. {w=0.2}Kinda."
    k "放松，我搞得定。{w=0.2}大概吧。"

# game/Story03.rpy:4424
translate chinese akt3chapter3_4_5e9225ed:

    # k "Everything's..."
    k "一切都在……"

# game/Story03.rpy:4429
translate chinese akt3chapter3_4_da6c618b:

    # k "…under control!"
    k "……掌控之中！"

# game/Story03.rpy:4431
translate chinese akt3chapter3_4_eca204e8:

    # mc "(She... cut a missile?)"
    mc "（她……把导弹切了？）"

# game/Story03.rpy:4433
translate chinese akt3chapter3_4_d48afd49:

    # mc "(...Noted.)"
    mc "（……记下了。）"

# game/Story03.rpy:4435
translate chinese akt3chapter3_4_68f24920:

    # mc "(Okay, focus, [mc], we’re almost there.)"
    mc "（好，专注，[mc]，快到了。）"

# game/Story03.rpy:4438
translate chinese akt3chapter3_4_914c7109:

    # mc "(There’s the command post!)"
    mc "（指挥所在那儿！）"

# game/Story03.rpy:4440
translate chinese akt3chapter3_4_bda9abd0:

    # mc "We’re almost there — hold tight!"
    mc "快到了——抓稳！"

# game/Story03.rpy:4444
translate chinese akt3chapter3_4_6edadb59:

    # mc "(What the — fuel!)"
    mc "（搞什么——燃料！）"

# game/Story03.rpy:4445
translate chinese akt3chapter3_4_9b80b661:

    # mc "We’re out!"
    mc "没油了！"

# game/Story03.rpy:4446
translate chinese akt3chapter3_4_73045ce4:

    # gg "What?! So we’re crashing?!"
    gg "什么？！我们要坠机了？！"

# game/Story03.rpy:4449
translate chinese akt3chapter3_4_4824fdf1:

    # k "Perfect. We'll die the way we lived — beautifully and unpredictably."
    k "完美。我们会像活着时那样死去——漂亮又出人意料。"

# game/Story03.rpy:4452
translate chinese akt3chapter3_4_3ecba540:

    # a "Situation?"
    a "情况？"

# game/Story03.rpy:4454
translate chinese akt3chapter3_4_4901b32d:

    # mc "No control. We’re falling!"
    mc "失控了。我们在往下掉！"

# game/Story03.rpy:4461
translate chinese akt3chapter3_4_12d7e588:

    # a "{font=Cybertron.otf}Something in a strange language."
    a "{font=Cybertron.otf}某种陌生语言。"

# game/Story03.rpy:4477
translate chinese akt3chapter3_4_da3fdbf1:

    # Mi "..."
    Mi "……"

# game/Story03.rpy:4480
translate chinese akt3chapter3_4_9fc136e2:

    # Mi "(That’s... a gate to the Abyss?!)"
    Mi "（那是……通往深渊的门？！）"

# game/Story03.rpy:4482
translate chinese akt3chapter3_4_955584b2:

    # mc "(What... is that?)"
    mc "（那……是什么？）"

# game/Story03.rpy:4498
translate chinese akt3chapter3_4_0edcb57a:

    # gggg "We can't reach the crew, sir."
    gggg "联系不上机组，长官。"

# game/Story03.rpy:4499
translate chinese akt3chapter3_4_61d49a58:

    # gggg "Might be a system failure."
    gggg "可能是系统故障。"

# game/Story03.rpy:4500
translate chinese akt3chapter3_4_f6c2a4c8:

    # g "I don’t like this..."
    g "我不喜欢这样……"

# game/Story03.rpy:4504
translate chinese akt3chapter3_4_3b65910f:

    # g "Deploy Assault Group Three."
    g "部署第三突击组。"

# game/Story03.rpy:4505
translate chinese akt3chapter3_4_270f37cc:

    # g "We need to be ready for anything."
    g "我们得做好万全准备。"

# game/Story03.rpy:4511
translate chinese akt3chapter3_4_609dfaee:

    # gg "We’re alive…"
    gg "我们还活着……"

# game/Story03.rpy:4514
translate chinese akt3chapter3_4_534bf4b6:

    # ggg "YES!"
    ggg "太好了！"

# game/Story03.rpy:4518
translate chinese akt3chapter3_4_0a4ea72a:

    # k "(whispering) Not exactly a genius performance, sis."
    k "（低声）这表现可算不上天才，姐妹。"

# game/Story03.rpy:4519
translate chinese akt3chapter3_4_711d7e7a:

    # k "(whispering) You look like a character on the edge of a breakdown."
    k "（低声）你看着像个随时要崩的角色。"

# game/Story03.rpy:4522
translate chinese akt3chapter3_4_e4ae307f:

    # a "That’s for me to decide."
    a "那由我决定。"

# game/Story03.rpy:4525
translate chinese akt3chapter3_4_2d284bd8:

    # k "(whispering) Sure."
    k "（低声）行吧。"

# game/Story03.rpy:4526
translate chinese akt3chapter3_4_e638115f:

    # k "(whispering) Just don’t say I didn’t cue my line on time."
    k "（低声）别说我没按时念台词。"

# game/Story03.rpy:4528
translate chinese akt3chapter3_4_acb1e295:

    # ry "Tell me I didn’t just see what I think I saw..."
    ry "告诉我，我刚刚没看见我以为看见的东西……"

# game/Story03.rpy:4530
translate chinese akt3chapter3_4_d9ae0a26:

    # el "To see it with our own eyes… We’re damn lucky."
    el "能亲眼看见……我们真他妈走运。"

# game/Story03.rpy:4532
translate chinese akt3chapter3_4_e496a7e0:

    # ry "I’m not sure what’s more shocking, seeing it, or surviving it?"
    ry "我说不清哪个更震撼，是看见它，还是活下来。"

# game/Story03.rpy:4534
translate chinese akt3chapter3_4_e494d3a5:

    # el "One thing’s certain. The world will be furious."
    el "有一点可以肯定。全世界都会暴怒。"

# game/Story03.rpy:4536
translate chinese akt3chapter3_4_05cec37b:

    # el "And there’s the—"
    el "而且那边还有——"

# game/Story03.rpy:4537
translate chinese akt3chapter3_4_7cc42076:

    # el "Oh no. That’s bad. Very bad."
    el "哦不。糟了。非常糟。"

# game/Story03.rpy:4542
translate chinese akt3chapter3_4_2bdcde07:

    # el "Wait, Mir, don’t do anything stupid."
    el "等等，米尔，别干傻事。"

# game/Story03.rpy:4545
translate chinese akt3chapter3_4_6b2041c5:

    # Mi "Not now, Eleyna."
    Mi "现在不行，艾蕾娜。"

# game/Story03.rpy:4549
translate chinese akt3chapter3_4_80fd3988:

    # Mi "What did you just do?!"
    Mi "你刚刚干了什么？！"

# game/Story03.rpy:4551
translate chinese akt3chapter3_4_bb8e4b4e:

    # a "..."
    a "……"

# game/Story03.rpy:4553
translate chinese akt3chapter3_4_8aff3a4c:

    # a "Alive. That’s enough."
    a "活着。这就够了。"

# game/Story03.rpy:4555
translate chinese akt3chapter3_4_495a65f1:

    # Mi "You almost killed us all!"
    Mi "你差点把我们全杀了！"

# game/Story03.rpy:4556
translate chinese akt3chapter3_4_97df86f1:

    # Mi "Or did you forget?!"
    Mi "还是你忘了？！"

# game/Story03.rpy:4559
translate chinese akt3chapter3_4_e0e8a5e8:

    # Mi "Millions died because of this!"
    Mi "因为这玩意儿，死了几百万人！"

# game/Story03.rpy:4564
translate chinese akt3chapter3_4_431107f3:

    # Mi "Answer me!"
    Mi "回答我！"

# game/Story03.rpy:4567
translate chinese akt3chapter3_4_ec6d64e4:

    # a "You were trembling. I acted."
    a "你在抖。我出手了。"

# game/Story03.rpy:4568
translate chinese akt3chapter3_4_84a84d51:

    # a "And I’ll do it again if I have to."
    a "需要的话，我还会再做。"

# game/Story03.rpy:4570
translate chinese akt3chapter3_4_f44abf61:

    # Mi "You arro—"
    Mi "你这傲慢——"

# game/Story03.rpy:4573
translate chinese akt3chapter3_4_32a55576:

    # el "Mir, this isn’t the time."
    el "米尔，现在不是时候。"

# game/Story03.rpy:4575
translate chinese akt3chapter3_4_da3fdbf1_1:

    # Mi "..."
    Mi "……"

# game/Story03.rpy:4578
translate chinese akt3chapter3_4_30dbbf74:

    # el "We need to take care of them."
    el "我们得安顿他们。"

# game/Story03.rpy:4580
translate chinese akt3chapter3_4_da3fdbf1_2:

    # Mi "..."
    Mi "……"

# game/Story03.rpy:4582
translate chinese akt3chapter3_4_d041895d:

    # Mi "Yeah… I lost it a little."
    Mi "嗯……我有点失控了。"

# game/Story03.rpy:4585
translate chinese akt3chapter3_4_beec8655:

    # el "You keep surprising me more every damn time!"
    el "你他妈每次都越来越让我吃惊！"

# game/Story03.rpy:4588
translate chinese akt3chapter3_4_1b3a695b:

    # mc "(That’s the angriest I’ve ever seen her…)"
    mc "（这是我见过她最愤怒的样子……）"

# game/Story03.rpy:4593
translate chinese akt3chapter3_4_dbd8eee1:

    # mc "What... was that?"
    mc "那……是什么？"

# game/Story03.rpy:4595
translate chinese akt3chapter3_4_144ab5eb:

    # Mi "An unstable breach."
    Mi "一道不稳定的裂隙。"

# game/Story03.rpy:4596
translate chinese akt3chapter3_4_0c158b40:

    # Mi "One mistake, and half the bay gets scattered into the Abyss."
    Mi "一个失误，半个舱就会被散进深渊。"

# game/Story03.rpy:4597
translate chinese akt3chapter3_4_99c07510:

    # a "We survived because it was short."
    a "我们活下来，是因为它很短。"

# game/Story03.rpy:4598
translate chinese akt3chapter3_4_dd5e7a8a:

    # a "And because I was lucky."
    a "还有因为我运气好。"

# game/Story03.rpy:4602
translate chinese akt3chapter3_4_054c5ee0:

    # mc "I see."
    mc "我明白了。"

# game/Story03.rpy:4604
translate chinese akt3chapter3_4_d4aa063b:

    # mc "(Gate? What kind of...)"
    mc "（门？什么样的……）"

# game/Story03.rpy:4605
translate chinese akt3chapter3_4_78939b24:

    # mc "(No, better not bring it up now.)"
    mc "（不，最好现在别提。）"

# game/Story03.rpy:4606
translate chinese akt3chapter3_4_77ccc3ba:

    # mc "(They’re all too wound up.)"
    mc "（他们全都绷得太紧了。）"

# game/Story03.rpy:4610
translate chinese akt3chapter3_4_82091822:

    # k "..."
    k "……"

# game/Story03.rpy:4615
translate chinese akt3chapter3_4_8ad8a4d9:

    # ggg "Nobody move—"
    ggg "都不许动——"

# game/Story03.rpy:4617
translate chinese akt3chapter3_4_82091822_1:

    # k "..."
    k "……"

# game/Story03.rpy:4618
translate chinese akt3chapter3_4_fe13fe0b:

    # ggg "Inquisition?!"
    ggg "审判庭？！"

# game/Story03.rpy:4619
translate chinese akt3chapter3_4_d67f1ed2:

    # ggg "Our deepest apologies!"
    ggg "我们万分抱歉！"

# game/Story03.rpy:4622
translate chinese akt3chapter3_4_66306037:

    # k "Hm… Attention, reverence, drawn pistols, how sweet."
    k "嗯……立正、敬畏、拔枪，真贴心。"

# game/Story03.rpy:4624
translate chinese akt3chapter3_4_2b785d99:

    # a "Don't start. They're scared of your presence."
    a "别挑事。他们只是怕你。"

# game/Story03.rpy:4627
translate chinese akt3chapter3_4_073a5943:

    # k "Boring..."
    k "无聊……"

# game/Story03.rpy:4629
translate chinese akt3chapter3_4_e5620868:

    # a "Who's in command here?"
    a "这儿谁指挥？"

# game/Story03.rpy:4632
translate chinese akt3chapter3_4_ab3e781a:

    # Fl "You’re late."
    Fl "你迟到了。"

# game/Story03.rpy:4633
translate chinese akt3chapter3_4_8f3e7169:

    # Fl "And judging by that entrance, still not thinking ahead."
    Fl "看你们那出场方式，还是不动脑子。"

# game/Story03.rpy:4634
translate chinese akt3chapter3_4_e1e21c13:

    # Fl "Maybe next time you’ll show up before half my people are dead."
    Fl "也许下次你们能在我一半人死光之前赶到。"

# game/Story03.rpy:4636
translate chinese akt3chapter3_4_94671f37:

    # k "What matters is {b}how{/b} we pull it off!"
    k "关键在于我们{b}怎么{/b}办到！"

# game/Story03.rpy:4639
translate chinese akt3chapter3_4_a98f2e89:

    # em "With honors, that’s for sure."
    em "肯定是风光地办到。"

# game/Story03.rpy:4642
translate chinese akt3chapter3_4_7626e7b5:

    # a "You're in charge?"
    a "你指挥？"

# game/Story03.rpy:4645
translate chinese akt3chapter3_4_34ece62e:

    # Fl "Yes."
    Fl "是。"

# game/Story03.rpy:4646
translate chinese akt3chapter3_4_b4254f11:

    # Fl "And I’m glad you’re here."
    Fl "而且我很高兴你们来了。"

# game/Story03.rpy:4647
translate chinese akt3chapter3_4_76d12d5a:

    # Fl "Because I’m short on people."
    Fl "因为我缺人。"

# game/Story03.rpy:4649
translate chinese akt3chapter3_4_bb8e4b4e_1:

    # a "..."
    a "……"

# game/Story03.rpy:4653
translate chinese akt3chapter3_4_10153469:

    # a "They let children command armies now."
    a "现在都让小孩指挥军队了。"

# game/Story03.rpy:4655
translate chinese akt3chapter3_4_5704fc94:

    # Fl "You’ve got a problem with that?"
    Fl "你有意见？"

# game/Story03.rpy:4656
translate chinese akt3chapter3_4_bb8e4b4e_2:

    # a "..."
    a "……"

# game/Story03.rpy:4657
translate chinese akt3chapter3_4_2bad3711:

    # Fl "Good."
    Fl "很好。"

# game/Story03.rpy:4658
translate chinese akt3chapter3_4_68e2272e:

    # Fl "Then shut up and listen."
    Fl "那就闭嘴听着。"

# game/Story03.rpy:4660
translate chinese akt3chapter3_4_bb8e4b4e_3:

    # a "..."
    a "……"

# game/Story03.rpy:4662
translate chinese akt3chapter3_4_6b0b9631:

    # a "Don’t test me."
    a "别试探我。"

# game/Story03.rpy:4665
translate chinese akt3chapter3_4_9196b310:

    # Fl "My rules. Accept it or stay mad, quietly."
    Fl "我的规矩。要么接受，要么安静地生闷气。"

# game/Story03.rpy:4667
translate chinese akt3chapter3_4_54d13c01:

    # a "You're loud."
    a "你声音太大。"

# game/Story03.rpy:4669
translate chinese akt3chapter3_4_3d067ff8:

    # Fl "Ok."
    Fl "行。"

# game/Story03.rpy:4670
translate chinese akt3chapter3_4_bb8e4b4e_4:

    # a "..."
    a "……"

# game/Story03.rpy:4671
translate chinese akt3chapter3_4_41da62cb:

    # Fl "..."
    Fl "……"

# game/Story03.rpy:4672
translate chinese akt3chapter3_4_bb8e4b4e_5:

    # a "..."
    a "……"

# game/Story03.rpy:4675
translate chinese akt3chapter3_4_80b97f3c:

    # k "You wouldn't last against Ember anyway."
    k "反正你也撑不过恩伯。"

# game/Story03.rpy:4676
translate chinese akt3chapter3_4_fccd60ee:

    # k "You need rest. Urgently."
    k "你需要休息。紧急的。"

# game/Story03.rpy:4678
translate chinese akt3chapter3_4_bb8e4b4e_6:

    # a "..."
    a "……"

# game/Story03.rpy:4682
translate chinese akt3chapter3_4_bb8e4b4e_7:

    # a "..."
    a "……"

# game/Story03.rpy:4684
translate chinese akt3chapter3_4_bb82788b:

    # Fl "Every conversation with you is a headache."
    Fl "跟你每说一次话都头疼。"

# game/Story03.rpy:4688
translate chinese akt3chapter3_4_338ad1c4:

    # Fl "All wounded to the medbay. Everyone else, to your rooms."
    Fl "所有伤员去医疗舱。其余人回各自房间。"

# game/Story03.rpy:4689
translate chinese akt3chapter3_4_4fe3728e:

    # Fl "And if I see anyone still here in ten minutes, go straight to the morgue."
    Fl "十分钟后要是还让我看见有人在这儿，就直接去停尸房。"

# game/Story03.rpy:4692
translate chinese akt3chapter3_4_26530924:

    # Fl "Miriel, keep your people in line."
    Fl "米莉尔，管好你的人。"

# game/Story03.rpy:4702
translate chinese akt3chapter3_4_2cb042fd:

    # Fl "Kalestra, your sister’s your responsibility."
    Fl "卡莱斯特拉，你妹妹归你负责。"

# game/Story03.rpy:4705
translate chinese akt3chapter3_4_3d97c635:

    # k "Yeah, yeah."
    k "行行行。"

# game/Story03.rpy:4708
translate chinese akt3chapter3_4_e15331ee:

    # k "Let’s just hope she doesn’t snap again."
    k "但愿她别再崩一次。"

# game/Story03.rpy:4710
translate chinese akt3chapter3_4_053eee4d:

    # mc "(Snap again? Side effect from the activation?)"
    mc "（再崩一次？激活的副作用？）"

# game/Story03.rpy:4712
translate chinese akt3chapter3_4_3cb631cd:

    # Fl "You, with me. Now."
    Fl "你，跟我来。现在。"

# game/Story03.rpy:4714
translate chinese akt3chapter3_4_ad2ba4ed:

    # mc "I need to see Olivia and Lora."
    mc "我得见奥利维亚和洛拉。"

# game/Story03.rpy:4716
translate chinese akt3chapter3_4_e62dfc9d:

    # Fl "I don't think so."
    Fl "我看不行。"

# game/Story03.rpy:4719
translate chinese akt3chapter3_4_a5341718:

    # Fl "Remember? You promised."
    Fl "记得吗？你答应过的。"

# game/Story03.rpy:4720
translate chinese akt3chapter3_4_8489819f:

    # Fl "And I don’t have time to wait. Got it?"
    Fl "而我没时间等。明白吗？"

# game/Story03.rpy:4722
translate chinese akt3chapter3_4_2b35b6fe:

    # mc "..."
    mc "……"

# game/Story03.rpy:4725
translate chinese akt3chapter3_4_5106d1fd:

    # mc "You’ve got something twisted, girl."
    mc "你这脑子有点拧巴，姑娘。"

# game/Story03.rpy:4726
translate chinese akt3chapter3_4_1b9b815a:

    # mc "I need to make sure they’re safe. And until I do..."
    mc "我得确认她们安全。在那之前……"

# game/Story03.rpy:4729
translate chinese akt3chapter3_4_e352e2a2:

    # Fl "They’re fine. So let’s drop this."
    Fl "她们没事。所以这事就打住。"

# game/Story03.rpy:4731
translate chinese akt3chapter3_4_4fcecb30:

    # mc "(What’s with her? She’s unusually docile... and afraid?)"
    mc "（她怎么了？反常地温顺……还带着怕？）"

# game/Story03.rpy:4733
translate chinese akt3chapter3_4_e3c4889f:

    # mc "Did something happen?"
    mc "出什么事了吗？"

# game/Story03.rpy:4736
translate chinese akt3chapter3_4_84dcb8a4:

    # Fl "It’s..."
    Fl "是……"

# game/Story03.rpy:4737
translate chinese akt3chapter3_4_6743d88a:

    # Fl "(Whispers) Over there. I’ll explain. Just... not here. Not now."
    Fl "（低声）去那边。我会解释。只是……别在这儿。别现在。"

# game/Story03.rpy:4739
translate chinese akt3chapter3_4_315d63ac:

    # mc "(Her voice… it’s shaking. This is the first time I’ve seen her like this.)"
    mc "（她的声音……在抖。这是我头一回见她这样。）"

# game/Story03.rpy:4740
translate chinese akt3chapter3_4_5be3d4df:

    # mc "Alright. Lead the way."
    mc "好。带路。"

# game/Story03.rpy:4742
translate chinese akt3chapter3_4_4fc34a4d:

    # em "Get this ship in shape. We’ll need it again."
    em "把这艘船修好。我们还会用上它。"

# game/Story03.rpy:4743
translate chinese akt3chapter3_4_6c165d2e:

    # ggg "Yes, ma’am."
    ggg "是，长官。"

# game/Story03.rpy:4757
translate chinese akt3chapter4_9fdc8fdf:

    # Fl "So tell me—"
    Fl "那告诉我——"

# game/Story03.rpy:4758
translate chinese akt3chapter4_9c8849ac:

    # Fl "how did you end up stuck at the outpost…"
    Fl "你怎么会困在前哨站……"

# game/Story03.rpy:4759
translate chinese akt3chapter4_0ba4d44f:

    # Fl "while your darling wife and Olivia made it here?"
    Fl "而你亲爱的老婆和奥利维亚却到了这儿？"

# game/Story03.rpy:4762
translate chinese akt3chapter4_73edf2b9:

    # mc "You always go for the things people try hardest not to remember."
    mc "你总是专挑别人最不想记起的事。"

# game/Story03.rpy:4763
translate chinese akt3chapter4_d74c0807:

    # mc "Ever thought about changing that?"
    mc "想过改改吗？"

# game/Story03.rpy:4766
translate chinese akt3chapter4_08fc1af8:

    # Fl "No."
    Fl "没。"

# game/Story03.rpy:4767
translate chinese akt3chapter4_d27a60f0:

    # Fl "Not my style."
    Fl "不是我的风格。"

# game/Story03.rpy:4770
translate chinese akt3chapter4_444b7c1e:

    # Fl "I’m after something else."
    Fl "我另有所图。"

# game/Story03.rpy:4774
translate chinese akt3chapter4_1ea74283:

    # Fl "Did you manage to bring Miriel under control?"
    Fl "你把米莉尔收服了吗？"

# game/Story03.rpy:4777
translate chinese akt3chapter4_2034c056:

    # mc "Maybe."
    mc "也许吧。"

# game/Story03.rpy:4778
translate chinese akt3chapter4_effb41f4:

    # mc "Maybe not."
    mc "也许没有。"

# game/Story03.rpy:4779
translate chinese akt3chapter4_a1715063:

    # mc "It’s complicated."
    mc "很复杂。"

# game/Story03.rpy:4783
translate chinese akt3chapter4_d5f9bf75:

    # Fl "(quietly) Of course."
    Fl "（轻声）当然了。"

# game/Story03.rpy:4784
translate chinese akt3chapter4_161c2e55:

    # Fl "It’s never that simple…"
    Fl "从来就没那么简单……"

# game/Story03.rpy:4785
translate chinese akt3chapter4_89a8d5d5:

    # Fl "Be honest."
    Fl "说实话。"

# game/Story03.rpy:4786
translate chinese akt3chapter4_3456e9a9:

    # Fl "Did you drop everything for her?"
    Fl "你为她抛下了一切？"

# game/Story03.rpy:4788
translate chinese akt3chapter4_cb9704d6:

    # mc "Some things are harder to explain than you think."
    mc "有些事比你以为的更难解释。"

# game/Story03.rpy:4790
translate chinese akt3chapter4_40a99654:

    # Fl "Have you always been like this—"
    Fl "你一直是这样——"

# game/Story03.rpy:4791
translate chinese akt3chapter4_324c16ec:

    # Fl "or is this new?"
    Fl "还是最近才这样？"

# game/Story03.rpy:4794
translate chinese akt3chapter4_a488ac32:

    # mc "You’re pushing too hard."
    mc "你逼得太紧了。"

# game/Story03.rpy:4796
translate chinese akt3chapter4_92447ec5:

    # Fl "That never used to stop you."
    Fl "以前这可拦不住你。"

# game/Story03.rpy:4799
translate chinese akt3chapter4_2b35b6fe:

    # mc "..."
    mc "……"

# game/Story03.rpy:4800
translate chinese akt3chapter4_8a84f750:

    # Fl "So?"
    Fl "那？"

# game/Story03.rpy:4801
translate chinese akt3chapter4_a48150a5:

    # Fl "What did you find?"
    Fl "你查到了什么？"

# game/Story03.rpy:4805
translate chinese akt3chapter4_f21b3964:

    # mc "You could’ve just asked me directly."
    mc "你本来可以直接问我。"

# game/Story03.rpy:4807
translate chinese akt3chapter4_c5cd3d15:

    # Fl "If you’d prefer—"
    Fl "你要是愿意——"

# game/Story03.rpy:4808
translate chinese akt3chapter4_b6bc6642:

    # Fl "I can make it an order."
    Fl "我可以把它变成命令。"

# game/Story03.rpy:4810
translate chinese akt3chapter4_12b38da7:

    # Fl "Won’t change the outcome."
    Fl "结果不会变。"

# game/Story03.rpy:4812
translate chinese akt3chapter4_9ccc63d0:

    # mc "Quit playing games."
    mc "别玩花样了。"

# game/Story03.rpy:4814
translate chinese akt3chapter4_ce819397:

    # Fl "Because... everything’s falling apart."
    Fl "因为……一切都在崩塌。"

# game/Story03.rpy:4816
translate chinese akt3chapter4_2b35b6fe_1:

    # mc "..."
    mc "……"

# game/Story03.rpy:4818
translate chinese akt3chapter4_381e664a:

    # Fl "And she might be the only thing we have left."
    Fl "而她可能是我们仅剩的东西。"

# game/Story03.rpy:4822
translate chinese akt3chapter4_949ca777:

    # mc "You really don't know how to ask, do you?"
    mc "你是真不会开口求人，对吧？"

# game/Story03.rpy:4827
translate chinese akt3chapter4_be67b6d3:

    # Fl "Right now— MILLIONS of lives depend on my decisions!"
    Fl "现在——几百万条命都取决于我的决定！"

# game/Story03.rpy:4829
translate chinese akt3chapter4_2f4db67a:

    # Fl "And whatever it takes—"
    Fl "不管要付出什么代价——"

# game/Story03.rpy:4830
translate chinese akt3chapter4_4fddcea5:

    # Fl "you’re going to tell me everything!"
    Fl "你都得把一切都告诉我！"

# game/Story03.rpy:4831
translate chinese akt3chapter4_af076d1e:

    # Fl "Do you understand me?!"
    Fl "听懂了吗？！"

# game/Story03.rpy:4833
translate chinese akt3chapter4_c3cd955e:

    # mc "And your best idea was jumping me the second I walked in?"
    mc "而你最好的主意，就是我一进门就扑上来？"

# game/Story03.rpy:4835
translate chinese akt3chapter4_493ac62e:

    # Fl "What else was I supposed to do?!"
    Fl "那我还能怎么办？！"

# game/Story03.rpy:4836
translate chinese akt3chapter4_7786dd07:

    # Fl "You were supposed to help me!"
    Fl "你本该帮我的！"

# game/Story03.rpy:4838
translate chinese akt3chapter4_4300402f:

    # mc "So this was your plan?"
    mc "这就是你的计划？"

# game/Story03.rpy:4844
translate chinese akt3chapter4_a550c833:

    # mc "Let me go."
    mc "放开我。"

# game/Story03.rpy:4847
translate chinese akt3chapter4_95d13048:

    # Fl "…You don’t get it."
    Fl "……你不懂。"

# game/Story03.rpy:4848
translate chinese akt3chapter4_e4ab53e2:

    # Fl "You REFUSE to get it!"
    Fl "你就是不肯懂！"

# game/Story03.rpy:4853
translate chinese akt3chapter4_8339ec02:

    # mc "I risked my life."
    mc "我拿命冒险。"

# game/Story03.rpy:4854
translate chinese akt3chapter4_80380bee:

    # mc "Almost died more than once."
    mc "差点死了不止一次。"

# game/Story03.rpy:4855
translate chinese akt3chapter4_0068191e:

    # mc "And this is what I get when I finally make it here?"
    mc "我好不容易到了这儿，就得到这个？"

# game/Story03.rpy:4856
translate chinese akt3chapter4_1db1fa88:

    # mc "A breakdown?"
    mc "一场崩溃？"

# game/Story03.rpy:4857
translate chinese akt3chapter4_0754010a:

    # mc "Threats?"
    mc "威胁？"

# game/Story03.rpy:4861
translate chinese akt3chapter4_3a8251e0:

    # Fl "—I KNOW, alright?!"
    Fl "——我知道，行了吧？！"

# game/Story03.rpy:4862
translate chinese akt3chapter4_0c4eb731:

    # Fl "Nothing is going according to plan!"
    Fl "什么都没按计划走！"

# game/Story03.rpy:4865
translate chinese akt3chapter4_160a6f8b:

    # Fl "Everything I built—"
    Fl "我建起来的一切——"

# game/Story03.rpy:4866
translate chinese akt3chapter4_fef54098:

    # Fl "Everything I calculated—"
    Fl "我算好的一切——"

# game/Story03.rpy:4867
translate chinese akt3chapter4_9a46f5ad:

    # Fl "It’s all collapsing!"
    Fl "全都在塌！"

# game/Story03.rpy:4868
translate chinese akt3chapter4_0a002e6d:

    # Fl "All of it!"
    Fl "全部！"

# game/Story03.rpy:4870
translate chinese akt3chapter4_64b58791:

    # mc "Don’t pin this shit on me."
    mc "别把这破事赖我头上。"

# game/Story03.rpy:4873
translate chinese akt3chapter4_ac79912b:

    # Fl "...I’m not—"
    Fl "……我没有——"

# game/Story03.rpy:4876
translate chinese akt3chapter4_cf1adef2:

    # mc "Yeah."
    mc "有。"

# game/Story03.rpy:4877
translate chinese akt3chapter4_d459d718:

    # mc "That’s exactly what you’re doing."
    mc "你就是在赖我。"

# game/Story03.rpy:4880
translate chinese akt3chapter4_a2104853:

    # Fl "Because..."
    Fl "因为……"

    # game/Story03.rpy:4891
translate chinese akt3chapter4_acc1c356:

    # Fl "You always needed things spelled out emotionally."
    Fl "你总要别人把话掰开揉碎，讲到感情上你才听得懂。"

# game/Story03.rpy:4893
translate chinese akt3chapter4_656551f8:

    # Fl "So I push."
    Fl "所以我逼你。"

# game/Story03.rpy:4894
translate chinese akt3chapter4_84094cc4:

    # Fl "Because it works."
    Fl "因为有效。"

# game/Story03.rpy:4896
translate chinese akt3chapter4_9e19a94a:

    # Fl "Usually."
    Fl "通常有效。"

# game/Story03.rpy:4898
translate chinese akt3chapter4_2b35b6fe_2:

    # mc "..."
    mc "……"

# game/Story03.rpy:4901
translate chinese akt3chapter4_716931f4:

    # Fl "If you want to laugh, go ahead."
    Fl "你想笑就笑吧。"

# game/Story03.rpy:4902
translate chinese akt3chapter4_108da70c:

    # Fl "Smart enough to build systems."
    Fl "聪明到能搭系统。"

# game/Story03.rpy:4903
translate chinese akt3chapter4_c24f223c:

    # Fl "Too stupid to talk to people."
