translate chinese endof3_5chapter_3a443a4c:

    # L "There are things I can’t tell you... no matter how much I might want to."
    L "有些事我不能告诉你……不管我有多想说。"

# game/Story03.rpy:10405
translate chinese endof3_5chapter_ede19693:

    # L "Maybe I should've told everything?..."
    L "也许我该把一切都说了……？"

# game/Story03.rpy:10409
translate chinese endof3_5chapter_0ed15f5c:

    # L "No… Lora, you've gone too far."
    L "不……洛拉，你走得太远了。"

# game/Story03.rpy:10415
translate chinese endof3_5chapter_6ef9730a:

    # h "And don’t go digging. Nothing pretty down there."
    h "别刨根问底。底下没什么好看的。"

# game/Story03.rpy:10417
translate chinese endof3_5chapter_9993b94e_2:

    # L "..."
    L "……"

# game/Story03.rpy:10419
translate chinese endof3_5chapter_0b1cb94a:

    # L "You two got close. Maybe too close."
    L "你们俩挺亲近。也许太亲近了。"

