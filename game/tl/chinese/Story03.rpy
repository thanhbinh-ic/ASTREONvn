translate chinese ivy_meetings_954e7c59:

    # mc "Says the girl who’s been teasing me all night."
    mc "这话出自一晚上都在逗我的姑娘。"

# game/Story03.rpy:10247
translate chinese ivy_meetings_7dc6dced_1:

    # i "Touché…"
    i "说得好……"

