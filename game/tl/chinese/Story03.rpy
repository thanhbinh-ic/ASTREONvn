    # Mi "She was aching to meet you. But then..."
    Mi "她巴不得见到你。可后来……"

# game/Story03.rpy:8397
translate chinese act3_5chapter3_f613c3cb:

    # Mi "Something changed in her."
    Mi "她身上有什么变了。"

# game/Story03.rpy:8398
translate chinese act3_5chapter3_2b35b6fe_1:

    # mc "..."
    mc "……"

# game/Story03.rpy:8400
translate chinese act3_5chapter3_06dcb99d:

    # mc "So you were on the surface afterwards."
    mc "所以后来你们上了地表。"

# game/Story03.rpy:8406
translate chinese act3_5chapter3_8cf73394:

    # Mi "Yes — sorry."
    Mi "是——抱歉。"

# game/Story03.rpy:8407
translate chinese act3_5chapter3_8e0469a2:

    # mc "Forget it. But what were you doing up there?"
    mc "算了。可你们在上面干什么？"

# game/Story03.rpy:8409
translate chinese act3_5chapter3_9f91e119:

    # Mi "Lora wanted to make sure you were safe. And the other thing..."
    Mi "洛拉想确认你平安。还有另一件事……"

# game/Story03.rpy:8413
translate chinese act3_5chapter3_62e63f11:

    # mc "The other thing?"
    mc "另一件事？"

# game/Story03.rpy:8416
translate chinese act3_5chapter3_1aa14803:

    # Mi "We were supposed to meet one of her old acquaintances."
    Mi "我们本来要去见她的一个旧相识。"

# game/Story03.rpy:8417
translate chinese act3_5chapter3_80691371:

    # Mi "A girl in glasses..."
    Mi "一个戴眼镜的姑娘……"

# game/Story03.rpy:8419
translate chinese act3_5chapter3_930dfabf:

    # mc "And why?"
    mc "为什么？"

# game/Story03.rpy:8421
translate chinese act3_5chapter3_aa32ee0f:

    # Mi "She had something that could help us... And we had a way to get her father back."
    Mi "她手上有能帮我们的东西……而我们有办法把她父亲弄回来。"

# game/Story03.rpy:8422
translate chinese act3_5chapter3_5ecfc8f6:

    # Mi "I don't know the rest. The teacher replaced me after that."
    Mi "后面的事我不知道。那之后老师就把我换下来了。"

# game/Story03.rpy:8424
translate chinese act3_5chapter3_2b35b6fe_2:

    # mc "..."
    mc "……"

# game/Story03.rpy:8426
translate chinese act3_5chapter3_8085b49c:

    # az "And my daughter — poor, faithful girl — made a deal."
    az "而我女儿——可怜、忠心的姑娘——做了笔交易。"

# game/Story03.rpy:8427
translate chinese act3_5chapter3_90a3c2f1:

    # az "I never saw the face. Could’ve been a god. Or a child. Or just a man who stopped blinking."
    az "我没看见那张脸。可能是神。可能是个孩子。也可能只是个不再眨眼的人。"

# game/Story03.rpy:8429
translate chinese act3_5chapter3_b5f37fb3:

    # N "Father, it’s what mom was working on..."
    N "父亲，这是妈妈一直在做的东西……"

# game/Story03.rpy:8436
translate chinese act3_5chapter3_5d0a2b38:

    # mc "(No, [mc], it's just a coincidence. It can't be. It just can't.)"
    mc "（不，[mc]，这只是巧合。不可能。绝不可能。）"

# game/Story03.rpy:8438
translate chinese act3_5chapter3_971e9c01:

    # mc "Alright then..."
    mc "那好吧……"

# game/Story03.rpy:8441
translate chinese act3_5chapter3_a58d16e1:

    # mc "Thank you for trusting me."
    mc "谢谢你信我。"

# game/Story03.rpy:8444
translate chinese act3_5chapter3_c9418b08:

    # mc "It really means a lot."
    mc "这对我真的很重要。"

# game/Story03.rpy:8448
translate chinese act3_5chapter3_da3fdbf1_2:

    # Mi "..."
    Mi "……"

# game/Story03.rpy:8449
translate chinese act3_5chapter3_cdd1079d:

    # mc "(Her eyes — they draw you in... Maybe I should. {w=0.3}No. {w=0.3}No.)"
    mc "（她的眼睛——把人往里吸……也许我该。{w=0.3}不。{w=0.3}不。）"

# game/Story03.rpy:8450
translate chinese act3_5chapter3_ec36da87:

    # mc "(Not now. At least not now.)"
    mc "（不是现在。至少不是现在。）"

# game/Story03.rpy:8453
translate chinese act3_5chapter3_b8f21195:

    # mc "Miriel? Are you okay?"
    mc "米莉尔？你没事吧？"

# game/Story03.rpy:8458
translate chinese act3_5chapter3_a60a4425:

    # Mi "Y-yeah, come in... We're arrived."
    Mi "嗯、嗯，进来吧……我们到了。"

# game/Story03.rpy:8461
translate chinese act3_5chapter3_2b35b6fe_3:

    # mc "..."
    mc "……"

# game/Story03.rpy:8464
translate chinese act3_5chapter3_f800bed0:

    # mc "Yes."
    mc "嗯。"

# game/Story03.rpy:8467
translate chinese act3_5chapter3_dd0bb808:

    # Mi "Sit down."
    Mi "坐吧。"

# game/Story03.rpy:8468
translate chinese act3_5chapter3_0f6cd269:

    # mc "This your room?"
    mc "这是你的房间？"

# game/Story03.rpy:8471
translate chinese act3_5chapter3_1cb66195:

    # Mi "Just a place to stay the night, nothing more."
    Mi "就是个过夜的地方，没别的。"

# game/Story03.rpy:8472
translate chinese act3_5chapter3_dfbd76ec:

    # mc "Pretty... decisive."
    mc "挺……果断的。"

# game/Story03.rpy:8474
translate chinese act3_5chapter3_50f94a52:

    # Mi "There are reasons."
    Mi "有原因。"

# game/Story03.rpy:8475
translate chinese act3_5chapter3_2b35b6fe_4:

    # mc "..."
    mc "……"

# game/Story03.rpy:8477
translate chinese act3_5chapter3_52aaa766:

    # mc "Because of Scarlei?"
    mc "因为斯卡蕾娅？"

# game/Story03.rpy:8483
translate chinese act3_5chapter3_63450149:

    # Mi "How did you—"
    Mi "你怎么——"

# game/Story03.rpy:8488
translate chinese act3_5chapter3_612dab75:

    # mc "Her name came up a lot around here. Not hard to put two and two together."
    mc "她的名字在这儿被提了很多次。不难拼出来。"

# game/Story03.rpy:8491
translate chinese act3_5chapter3_14368c5d:

    # mc "Someone close?"
    mc "很亲近的人？"

# game/Story03.rpy:8493
translate chinese act3_5chapter3_23484651:

    # Mi "Closer than close..."
    Mi "比亲近还亲近……"

# game/Story03.rpy:8494
translate chinese act3_5chapter3_91ff6a7e:

    # Mi "She was the one who gave me a reason to keep living."
    Mi "是她给了我继续活下去的理由。"

# game/Story03.rpy:8495
translate chinese act3_5chapter3_af774f46:

    # Mi "And the one who showed me this place."
    Mi "也是她带我来了这个地方。"

# game/Story03.rpy:8497
translate chinese act3_5chapter3_470d6dd1:

    # mc "Wait, wasn't that Yong?"
    mc "等等，不是勇吗？"

# game/Story03.rpy:8499
translate chinese act3_5chapter3_80bdd2d2:

    # Mi "You're not the first to think that. No, not him."
    Mi "你不是第一个这么想的。不，不是他。"

# game/Story03.rpy:8500
translate chinese act3_5chapter3_ea2341fa:

    # Mi "When I needed it most, she reached out."
    Mi "我最需要的时候，是她伸出了手。"

# game/Story03.rpy:8503
translate chinese act3_5chapter3_1b6c4a91:

    # mc "(Was that before you worked as a merc, or after?)"
    mc "（那是在你当雇佣兵之前，还是之后？）"

# game/Story03.rpy:8504
translate chinese act3_5chapter3_d0e913e4:

    # Mi "(Around the time I was a merc, yeah.)"
    Mi "（大概就是我当雇佣兵那阵子。）"

# game/Story03.rpy:8506
translate chinese act3_5chapter3_67c1d068:

    # Mi "(Hunger, murder, stench and abuse. Most of my life can be summed up by those words.)"
    Mi "（饥饿、杀戮、恶臭、虐待。我这大半辈子，用这几个词就能概括。）"

# game/Story03.rpy:8508
translate chinese act3_5chapter3_da90e894:

    # Mi "(I'd take any job I could get.)"
    Mi "（什么活儿我都接。）"

# game/Story03.rpy:8511
translate chinese act3_5chapter3_2002c124:

    # Mi "(Killing and stealing became my day-to-day.)"
    Mi "（杀人偷东西成了日常。）"

# game/Story03.rpy:8514
translate chinese act3_5chapter3_cb89ec0c:

    # mc "(Not so different then, huh?)"
    mc "（那咱俩也没多大差别，是吧？）"

# game/Story03.rpy:8515
translate chinese act3_5chapter3_f448a6eb:

    # Mi "(Maybe.)"
    Mi "（也许吧。）"

# game/Story03.rpy:8518
translate chinese act3_5chapter3_e59d3514:

    # "You clear? Plan’s simple: go in, grab the data — get out."
    "听清楚了吗？计划很简单：进去，拿数据——撤出来。"

# game/Story03.rpy:8520
translate chinese act3_5chapter3_53ef6d81:

    # "No theatrics, got it?"
    "别搞花样，明白吗？"

# game/Story03.rpy:8522
translate chinese act3_5chapter3_bddc88bb:

    # Mi "Yes."
    Mi "明白。"

# game/Story03.rpy:8524
translate chinese act3_5chapter3_2119d129:

    # "And move it, we don't have much time."
    "动作快点，我们时间不多。"

# game/Story03.rpy:8528
translate chinese act3_5chapter3_fd218539:

    # Mi "(Most of my operators were real assholes.)"
    Mi "（我那帮上司大多都是真正的混蛋。）"

# game/Story03.rpy:8530
translate chinese act3_5chapter3_7ff1dc2b:

    # Mi "(I couldn't stand their arrogance and vanity, but I had to put up with them.)"
    Mi "（我受不了他们的傲慢和虚荣，可我只能忍着。）"

# game/Story03.rpy:8532
translate chinese act3_5chapter3_cc100b6e:

    # Mi "I'm at the door."
    Mi "我到门口了。"

# game/Story03.rpy:8533
translate chinese act3_5chapter3_b4424f5c:

    # "And what are you waiting for? An invitation?"
    "那你还等什么？等请帖？"

# game/Story03.rpy:8536
translate chinese act3_5chapter3_dca0e291:

    # "Nice scene, huh? I knew you'd like it. Now quickly, room on the left — the data — and you're out."
    "场面不错吧？我就知道你会喜欢。快点，左边那间房——拿数据——然后滚出来。"

# game/Story03.rpy:8537
translate chinese act3_5chapter3_f7442f51:

    # Mi "(Every time I saw scenes like that, I was glad it wasn't me in their place.)"
    Mi "（每次看到这种场面，我都庆幸站在那儿的不是我。）"

# game/Story03.rpy:8539
translate chinese act3_5chapter3_2af488e8:

    # Mi "(But at the same time I hated myself for it.)"
    Mi "（可同时我又恨自己这么想。）"

# game/Story03.rpy:8540
translate chinese act3_5chapter3_e21f0a16:

    # Mi "(For my helplessness.)"
    Mi "（恨自己无能为力。）"

# game/Story03.rpy:8542
translate chinese act3_5chapter3_26cc464b:

    # "No ego, got it?"
    "别耍个性，明白吗？"

# game/Story03.rpy:8543
translate chinese act3_5chapter3_bddc88bb_1:

    # Mi "Yes."
    Mi "明白。"

# game/Story03.rpy:8544
translate chinese act3_5chapter3_27f50fd0:

    # mc "(Was it really that bad?)"
    mc "（真有那么糟吗？）"

# game/Story03.rpy:8545
translate chinese act3_5chapter3_1a6eea55:

    # Mi "(Life was worth less than a magazine of ammo. Nobody cared about things like that.)"
    Mi "（命比一梭子弹还便宜。没人管这些。）"

# game/Story03.rpy:8547
translate chinese act3_5chapter3_c26e77e8:

    # Mi "(Some tried, but their bodies were found the next day — nobody sane would stand up to that.)"
    Mi "（有人试过，可第二天就被人发现了尸体——神志正常的人都不会去顶这个。）"

# game/Story03.rpy:8550
translate chinese act3_5chapter3_ae401e9b:

    # Mi "(I wasn't an exception.)"
    Mi "（我也不例外。）"

# game/Story03.rpy:8551
translate chinese act3_5chapter3_4a17bee1:

    # Mi "(Usually I would have gotten out with the data and forgotten it like a nightmare.)"
    Mi "（换平时，我会带着数据撤出来，然后把它当噩梦一样忘掉。）"

# game/Story03.rpy:8553
translate chinese act3_5chapter3_d340bd67:

    # Mi "(But that night, maybe from exhaustion, maybe from thinking about justice...)"
    Mi "（可那天晚上，也许是累极了，也许是想到了什么公道……）"

# game/Story03.rpy:8555
translate chinese act3_5chapter3_ce7d4800:

    # Mi "(I decided to take matters into my own hands.)"
    Mi "（我决定自己动手。）"

# game/Story03.rpy:8558
translate chinese act3_5chapter3_6b047587:

    # "Hey, hey, what have you done? Stay where you are you freak—"
    "喂，喂，你干了什么？站住别动，你这怪物——"

# game/Story03.rpy:8575
translate chinese act3_5chapter3_d51ad37a:

    # Mi "(In the end, a dozen bodies marked the start of my path.)"
    Mi "（最后，十几具尸体标志着我这条路的起点。）"

# game/Story03.rpy:8579
translate chinese act3_5chapter3_25c88c0a:

    # Mi "(I sparked a massacre, a genocide of all those who treated elves badly.)"
    Mi "（我点燃了一场屠杀，一场对所有虐待精灵者的种族清洗。）"

# game/Story03.rpy:8580
translate chinese act3_5chapter3_4f712f9f:

    # Mi "(Became a serial killer.)"
    Mi "（成了连环杀手。）"

# game/Story03.rpy:8582
translate chinese act3_5chapter3_2e7ac9dd:

    # Mi "(It didn't take long before the search notices went up.)"
    Mi "（没过多久，通缉令就贴出来了。）"

# game/Story03.rpy:8584
translate chinese act3_5chapter3_f7262037:

    # g "Did you find her?"
    g "找到她了吗？"

# game/Story03.rpy:8585
translate chinese act3_5chapter3_dc20d975:

    # gg "No, she vanished like the ground swallowed her."
    gg "没有，她就像被地吞了一样消失了。"

# game/Story03.rpy:8587
translate chinese act3_5chapter3_ba0361a2:

    # g "Search! We can't let her go!"
    g "搜！不能让她跑了！"

# game/Story03.rpy:8589
translate chinese act3_5chapter3_c2c3e9d8:

    # gg "There! Grab that little bitch!"
    gg "在那儿！抓住那个小婊子！"

# game/Story03.rpy:8594
translate chinese act3_5chapter3_ec79dd04:

    # mc "(And the police?)"
    mc "（那警察呢？）"

# game/Story03.rpy:8595
translate chinese act3_5chapter3_aa8100b6:

    # Mi "(Ironically, the two men I killed at the start turned out to be police colonels.)"
    Mi "（讽刺的是，我一开始杀的那两个人，居然是警察上校。）"

# game/Story03.rpy:8598
translate chinese act3_5chapter3_b6a59562:

    # Mi "(Instead of protecting citizens... they were tormenting two missing elven girls.)"
    Mi "（他们不保护市民……却在折磨两个失踪的精灵姑娘。）"

# game/Story03.rpy:8599
translate chinese act3_5chapter3_a46de91a:

    # g "Caught, don't—"
    g "抓到了，别——"

# game/Story03.rpy:8618
translate chinese act3_5chapter3_b097a980:

    # Mi "(But there was another side: the abuse in our district dropped significantly.)"
    Mi "（但还有另一面：我们区的虐待事件大幅下降。）"

# game/Story03.rpy:8619
translate chinese act3_5chapter3_8156c873:

    # Mi "(All it took was a couple hundred corpses. But the song didn't play long; once whispers of the Inquisition started...)"
    Mi "（代价不过是几百具尸体。可这歌没唱多久；审判庭的风声一起……）"

# game/Story03.rpy:8623
translate chinese act3_5chapter3_73696c46:

    # g "Executioner-3, Dome-1, requesting target data."
    g "刽子手-3，穹顶-1，请求目标数据。"

# game/Story03.rpy:8624
translate chinese act3_5chapter3_e520448a:

    # "Dome-1 here. Redirecting termination data. Target — a Syndicate rat."
    "这里是穹顶-1。转发出处决数据。目标——一只辛迪加老鼠。"

# game/Story03.rpy:8625
translate chinese act3_5chapter3_bfb8ebcb:

    # g "Executioner-3, data received, end of transmission."
    g "刽子手-3，数据已收到，通讯结束。"

# game/Story03.rpy:8627
translate chinese act3_5chapter3_4e00fa7c:

    # gg "The seal's broken, use-of-force authorization — activated."
    gg "封印已破，使用武力授权——已激活。"

# game/Story03.rpy:8628
translate chinese act3_5chapter3_dc09b32c:

    # g "7 minutes to landing."
    g "距降落还有 7 分钟。"

# game/Story03.rpy:8631
translate chinese act3_5chapter3_21216a81:

    # gg "Objective: clear the Syndicate rats' hideout. Leave no one alive."
    gg "目标：清剿辛迪加老鼠的窝点。不留活口。"

# game/Story03.rpy:8632
translate chinese act3_5chapter3_7bd50908:

    # k "Ugh, the Syndicate won't like that."
    k "呃，辛迪加可不会喜欢这个。"

# game/Story03.rpy:8633
translate chinese act3_5chapter3_07ae9f20:

    # gg "That's none of your concern, Kalestra."
    gg "这不关你的事，卡莱斯特拉。"

# game/Story03.rpy:8634
translate chinese act3_5chapter3_25407fa9:

    # k "Sure, sure."
    k "行，行。"

# game/Story03.rpy:8639
translate chinese act3_5chapter3_3e04caa5:

    # gg "Commence execution."
    gg "开始处决。"

# game/Story03.rpy:8640
translate chinese act3_5chapter3_2b4dbb82:

    # k "Well, time to have some fun."
    k "那么，该找点乐子了。"

    # game/Story03.rpy:8644
translate chinese act3_5chapter3_7f983f09:

    # Mi "I had to go down to the Lower City, where light was a luxury and clean air a myth."
    Mi "我只能下到下城，那儿光都是奢侈品，干净空气是神话。"

# game/Story03.rpy:8645
translate chinese act3_5chapter3_4d6fe7c0:

    # Mi "I stayed there for a few weeks. Thinking it would settle, but..."
    Mi "我在那儿待了几周。以为风头会过去，可是……"

# game/Story03.rpy:8646
translate chinese act3_5chapter3_6dd8eee3:

    # Mi "(Whispering) Then everything only got worse..."
    Mi "（低声）结果一切只是越来越糟……"

# game/Story03.rpy:8648
translate chinese act3_5chapter3_e61b4e3c:

    # Mi "I've done too much to live a normal life after that."
    Mi "我干过的事太多，之后想过正常日子已经不可能了。"

# game/Story03.rpy:8649
translate chinese act3_5chapter3_cf355909:

    # Mi "Deciding it was time to end it all."
    Mi "我决定是时候了结这一切了。"

# game/Story03.rpy:8651
translate chinese act3_5chapter3_388a70d3:

    # Mi "But then I met her."
    Mi "可就在那时，我遇见了她。"

# game/Story03.rpy:8654
translate chinese act3_5chapter3_b74122d5:

    # scar "Do you want to die? Fine. But be honest — you already died down there."
    scar "你想死？行。但说实话——你在下城的时候就已经死了。"

# game/Story03.rpy:8655
translate chinese act3_5chapter3_2eb7a581:

    # scar "Here you're only finishing off what's left."
    scar "在这儿，你只是在处理剩下的那部分。"

# game/Story03.rpy:8657
translate chinese act3_5chapter3_4caa0975:

    # scar "Maybe I can offer you something else?"
    scar "也许我能给你点别的选择？"

# game/Story03.rpy:8659
translate chinese act3_5chapter3_da3fdbf1_3:

    # Mi "..."
    Mi "……"

# game/Story03.rpy:8664
translate chinese act3_5chapter3_6f46d5c5:

    # mc "What happened after that?"
    mc "那之后呢？"

# game/Story03.rpy:8666
translate chinese act3_5chapter3_55735709:

    # Mi "And then..."
    Mi "然后……"

# game/Story03.rpy:8668
translate chinese act3_5chapter3_2b35b6fe_5:

    # mc "..."
    mc "……"

# game/Story03.rpy:8670
translate chinese act3_5chapter3_2ea261af:

    # Mi "I..."
    Mi "我……"

# game/Story03.rpy:8675
translate chinese act3_5chapter3_0cf4db38:

