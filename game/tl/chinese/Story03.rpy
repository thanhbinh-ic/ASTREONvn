translate chinese ivy_meetings_9511405d:

    # mc "Oh, I think I do."
    mc "哦，我觉得我知道。"

# game/Story03.rpy:10245
translate chinese ivy_meetings_a690b7a4:

    # i "You’re so unfair… ngh… making me feel like this…"
    i "你太不公平了……嗯……让我有这种感觉……"

