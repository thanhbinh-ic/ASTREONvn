    # Fl "You really are an asshole."
    Fl "你真是个混蛋。"

# game/Story03.rpy:4941
translate chinese akt3chapter4_e186c9b3:

    # mc "Yeah. Probably."
    mc "嗯。大概吧。"

# game/Story03.rpy:4947
translate chinese akt3chapter4_9452bee5:

    # L "I—"
    L "我——"

# game/Story03.rpy:4948
