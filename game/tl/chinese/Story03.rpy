translate chinese ivy_meetings_fc180784:

    # mc "You’re dangerous."
    mc "你很危险。"

# game/Story03.rpy:10223
translate chinese ivy_meetings_1905f59c:

    # i "And you love it."
    i "而你就爱这个。"

# game/Story03.rpy:10224
