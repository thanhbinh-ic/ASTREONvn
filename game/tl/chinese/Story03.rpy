    # i "Mmh… god, I can feel every bit of you…"
    i "嗯……天哪，我能感觉到你的每一寸……"

# game/Story03.rpy:10241
translate chinese ivy_meetings_bdf79d25:

    # i "You don’t know what you’re doing to me right now."
    i "你不知道你现在在对我做什么。"

