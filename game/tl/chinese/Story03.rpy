    R "是。多得多。"

# game/Story03.rpy:1840
translate chinese akt3chapter2_4acb9992:

    # aa "You."
    aa "你。"

# game/Story03.rpy:1844
translate chinese akt3chapter2_70c8041e:

    # ggg "Yes, ma’am!"
    ggg "是，夫人！"

# game/Story03.rpy:1846
translate chinese akt3chapter2_66eedf5a:

    # aa "Throw bait into the lower town."
    aa "往下城区扔诱饵。"

# game/Story03.rpy:1848
translate chinese akt3chapter2_11cb946b:

    # ggg "Right away."
    ggg "马上办。"

# game/Story03.rpy:1850
translate chinese akt3chapter2_c7d15ea4:

    # aa "And warn the elves there, tell them to run."
    aa "还有，警告那儿的精灵，让他们跑。"

# game/Story03.rpy:1852
translate chinese akt3chapter2_59a17453:

    # R "Now that’s a twist."
    R "这倒是个转折。"

# game/Story03.rpy:1853
translate chinese akt3chapter2_4b624790_2:

    # aa "..."
    aa "……"

# game/Story03.rpy:1870
translate chinese akt3chapter2_f5f79f61:

    # "Sector 6. Blue Moon."
    "第 6 区。蓝月。"

# game/Story03.rpy:1871
translate chinese akt3chapter2_5ac44e1f:

    # mc "My head’s splitting..."
    mc "我头都要裂开了……"

# game/Story03.rpy:1872
translate chinese akt3chapter2_b7feb858:

    # mc "Did I black out?"
    mc "我昏过去了吗？"

# game/Story03.rpy:1873
translate chinese akt3chapter2_29709543:

    # mc "First time in days..."
    mc "这么多天来头一回……"

# game/Story03.rpy:1875
translate chinese akt3chapter2_60735426:

    # mc "(And for what?)"
    mc "（可图什么呢？）"

# game/Story03.rpy:1876
translate chinese akt3chapter2_a857f184:

    # mc "(Feel like I got run over.)"
    mc "（感觉像被车碾过一样。）"

# game/Story03.rpy:1878
translate chinese akt3chapter2_81362217:

    # mc "(These dreams...)"
    mc "（这些梦……）"

# game/Story03.rpy:1880
translate chinese akt3chapter2_8b9ee863:

    # mc "Enough."
    mc "够了。"

# game/Story03.rpy:1881
translate chinese akt3chapter2_2562ad6f:

    # mc "Move."
    mc "走。"

# game/Story03.rpy:1883
translate chinese akt3chapter2_03367861:

    # mc "(Need to find the others.)"
    mc "（得找到其他人。）"

# game/Story03.rpy:1884
translate chinese akt3chapter2_494c55b7:

    # mc "(Before they kill each other.)"
    mc "（在他们互相弄死之前。）"

# game/Story03.rpy:1886
translate chinese akt3chapter2_adfb2742:

    # mc "(Especially Olivia... Kalestra... Lora.)"
    mc "（尤其是奥利维亚……卡莱斯特拉……洛拉。）"

# game/Story03.rpy:1888
translate chinese akt3chapter2_3c9f286c:

    # mc "Lora..."
    mc "洛拉……"

# game/Story03.rpy:1892
translate chinese akt3chapter2_ef13739c:

    # mc "Left. Right."
    mc "左。右。"

# game/Story03.rpy:1893
translate chinese akt3chapter2_4078dcd2:

    # mc "Doesn’t matter."
    mc "无所谓。"

# game/Story03.rpy:1899
translate chinese akt3chapter2_b8e13fb0:

    # mc "(Bare metal.)"
    mc "（光秃秃的金属。）"

# game/Story03.rpy:1900
translate chinese akt3chapter2_7d39ec26:

    # mc "(No people. Nothing.)"
    mc "（没人。什么都没有。）"

# game/Story03.rpy:1903
translate chinese akt3chapter2_9914f789:

    # mc "(Every step echoes.)"
    mc "（每一步都有回音。）"

# game/Story03.rpy:1904
translate chinese akt3chapter2_7c3920c7:

    # mc "(If someone’s here, they already heard me.)"
    mc "（要是这儿有人，早听见我了。）"

# game/Story03.rpy:1907
translate chinese akt3chapter2_3ad15b1a:

    # mc "(Good.)"
    mc "（很好。）"

# game/Story03.rpy:1908
translate chinese akt3chapter2_36dd2701:

    # mc "(Silence is worse.)"
    mc "（死寂更糟。）"

# game/Story03.rpy:1910
translate chinese akt3chapter2_5eec69e5:

    # mc "Endless damn corridors..."
    mc "这该死的走廊没完没了……"

# game/Story03.rpy:1912
translate chinese akt3chapter2_f711ae47:

    # mc "(Should I call out...?)"
    mc "（我该喊一嗓子吗……？）"

# game/Story03.rpy:1914
translate chinese akt3chapter2_78f33f44:

    # mc "(Quiet as a graveyard.)"
    mc "（静得像坟场。）"

# game/Story03.rpy:1917
translate chinese akt3chapter2_8a6b32bf:

    # mc "Might as well sing."
    mc "还不如唱首歌。"

# game/Story03.rpy:1922
translate chinese akt3chapter2_a55ee5f5:

    # mc "(Too much happened too fast.)"
    mc "（事情太多，太快了。）"

# game/Story03.rpy:1929
translate chinese akt3chapter2_a43d473c:

    # mc "(…Wait.)"
    mc "（……等等。）"

# game/Story03.rpy:1934
translate chinese akt3chapter2_742a7621:

    # mc "Too quiet."
    mc "太安静了。"

# game/Story03.rpy:1936
translate chinese akt3chapter2_b9b63a11:

    # mc "(Not one person...)"
    mc "（一个人都没有……）"

# game/Story03.rpy:1942
translate chinese akt3chapter2_a9862efa:

    # mc "(Empty...)"
    mc "（空的……）"

# game/Story03.rpy:1945
translate chinese akt3chapter2_8bd9693d:

    # mc "(Here too.)"
    mc "（这儿也是。）"

# game/Story03.rpy:1948
translate chinese akt3chapter2_0b2f90a6:

    # mc "(A dream?)"
    mc "（一场梦？）"

# game/Story03.rpy:1950
translate chinese akt3chapter2_699878f6:

    # mc "Hey!"
    mc "喂！"

# game/Story03.rpy:1951
translate chinese akt3chapter2_0cb0755e:

    # mc "Anyone here?!"
    mc "有人吗？！"

# game/Story03.rpy:1952
translate chinese akt3chapter2_fdaa1d8c:

    # mc "Lora?! Olivia?!"
    mc "洛拉？！奥利维亚？！"

    # game/Story03.rpy:1953
translate chinese akt3chapter2_7f7cc56b:

    # mc "Answer me!"
    mc "回答我！"

# game/Story03.rpy:1960
translate chinese akt3chapter2_7cddc058:

    # a "Quiet."
    a "小声点。"

# game/Story03.rpy:1967
translate chinese akt3chapter2_8a3197bb:

    # mc "(whispering) What the hell happened here?"
    mc "（低声）这儿到底出什么事了？"

# game/Story03.rpy:1969
translate chinese akt3chapter2_bb8e4b4e:

    # a "..."
    a "……"

# game/Story03.rpy:1972
translate chinese akt3chapter2_ebb64590:

    # a "(whispers) They found out."
    a "（低声）他们发现了。"

# game/Story03.rpy:1974
translate chinese akt3chapter2_b4dff877:

    # mc "(whispering) Who found out?"
    mc "（低声）谁发现了？"

# game/Story03.rpy:1975
translate chinese akt3chapter2_b699af18:

    # mc "Where is everyone?"
    mc "人呢？都去哪儿了？"

# game/Story03.rpy:1984
translate chinese akt3chapter2_850ef128:

    # b "..."
    b "……"

# game/Story03.rpy:1986
translate chinese akt3chapter2_ea4e48cd:

    # a "Move."
    a "走。"

# game/Story03.rpy:1991
translate chinese akt3chapter2_68919a8f:

    # a "You armed?"
    a "你有武器吗？"

# game/Story03.rpy:1994
translate chinese akt3chapter2_fca52711:

    # mc "No."
    mc "没有。"

# game/Story03.rpy:1997
translate chinese akt3chapter2_b83a40f9:

    # mc "(Good enough.)"
    mc "（凑合吧。）"

# game/Story03.rpy:1999
translate chinese akt3chapter2_bfe5c751:

    # a "Cover me."
    a "掩护我。"

# game/Story03.rpy:2001
translate chinese akt3chapter2_fb364877:

    # mc "Lead."
    mc "带路。"

# game/Story03.rpy:2003
translate chinese akt3chapter2_bb8e4b4e_1:

    # a "..."
    a "……"

# game/Story03.rpy:2005
translate chinese akt3chapter2_ef85c08c:

    # a "Good."
    a "很好。"

# game/Story03.rpy:2019
translate chinese akt3chapter2_c7a7dfac:

    # mc "You mean these things?"
    mc "你说的是这些东西？"

# game/Story03.rpy:2020
translate chinese akt3chapter2_baafafd4:

    # mc "How the hell did they get in?"
    mc "它们他妈怎么进来的？"

# game/Story03.rpy:2022
translate chinese akt3chapter2_406a0704:

    # a "Doesn't matter."
    a "不重要。"

# game/Story03.rpy:2027
translate chinese akt3chapter2_db8f77f4:

    # mc "The others?"
    mc "其他人呢？"

# game/Story03.rpy:2030
translate chinese akt3chapter2_e91de204:

    # mc "Alive?"
    mc "还活着？"

# game/Story03.rpy:2032
translate chinese akt3chapter2_7d430ec0:

    # a "Alive. I didn't come for them."
    a "活着。我不是为他们来的。"

# game/Story03.rpy:2040
translate chinese akt3chapter2_6d3f3a4d:

    # mc "You never stop."
    mc "你从来不停。"

# game/Story03.rpy:2050
translate chinese akt3chapter2_2b35b6fe_2:

    # mc "..."
    mc "……"

# game/Story03.rpy:2051
translate chinese akt3chapter2_97936a09:

    # mc "(Too easy.)"
    mc "（太容易了。）"

# game/Story03.rpy:2053
translate chinese akt3chapter2_7022e0d3:

    # a "Last one."
    a "最后一个。"

# game/Story03.rpy:2056
translate chinese akt3chapter2_891ed671:

    # a "Clean job."
    a "干得干净。"

# game/Story03.rpy:2057
translate chinese akt3chapter2_54fdbc26:

    # a "He’ll work."
    a "他还能用。"

# game/Story03.rpy:2059
translate chinese akt3chapter2_8970399d:

    # mc "…Thanks."
    mc "……谢了。"

# game/Story03.rpy:2060
translate chinese akt3chapter2_9e4b2a8f:

    # mc "({b}He’ll work{/b}… like I'm a tool.)"
    mc "（{b}他还能用{/b}……好像我是个工具。）"

# game/Story03.rpy:2063
translate chinese akt3chapter2_5875b757:

    # mc "…A survivor?"
    mc "……幸存者？"

# game/Story03.rpy:2065
translate chinese akt3chapter2_e6111f74:

    # g "Kh... More like what’s left of me..."
    g "咳……说我是剩下的一口气还差不多……"

# game/Story03.rpy:2066
translate chinese akt3chapter2_2b35b6fe_3:

    # mc "..."
    mc "……"

# game/Story03.rpy:2068
translate chinese akt3chapter2_14961f49:

    # g "Don’t waste time... I’m done for."
    g "别浪费时间……我不行了。"

# game/Story03.rpy:2069
translate chinese akt3chapter2_76bfd1ac:

    # g "All I wanted was to go home..."
    g "我只想回家……"

# game/Story03.rpy:2072
translate chinese akt3chapter2_d5d8435b:

    # a "Who attacked?"
    a "谁袭击的？"

# game/Story03.rpy:2074
translate chinese akt3chapter2_b51d8e2d:

    # g "The Soulless... Someone directed them. Straight to us."
    g "无魂者……有人在操控它们。直冲我们来的。"

# game/Story03.rpy:2075
translate chinese akt3chapter2_b3d71468:

    # g "We... didn’t even have time to react..."
    g "我们……连反应的时间都没有……"

# game/Story03.rpy:2077
translate chinese akt3chapter2_a584a677:

    # mc "You’re alone?"
    mc "就你一个人？"

# game/Story03.rpy:2078
translate chinese akt3chapter2_2f73677e:

    # mc "Where are the others?"
    mc "其他人呢？"

# game/Story03.rpy:2081
translate chinese akt3chapter2_26bc6a20:

    # g "Over there... survivors. I tried to cover them, but..."
    g "那边……还有幸存者。我想护住他们，可是……"

# game/Story03.rpy:2088
translate chinese akt3chapter2_19f5fb8b:

    # g "Now they’re in danger. The Faceless are here."
    g "现在他们危险了。无面者来了。"

# game/Story03.rpy:2089
translate chinese akt3chapter2_e09c7c21:

    # g "Not Soulless. Faceless think. They direct the packs."
    g "不是无魂者。无面者会思考。它们指挥那些兽群。"

# game/Story03.rpy:2090
translate chinese akt3chapter2_11ef5ede:

    # g "The others won’t make it against them."
    g "其他人扛不住它们。"

# game/Story03.rpy:2092
translate chinese akt3chapter2_7880afc0:

    # mc "(Bad...)"
    mc "（糟了……）"

# game/Story03.rpy:2093
translate chinese akt3chapter2_2a14d9be:

    # g "You... you're one of them. The Maiden of War..."
    g "你……你是她们的人。战争少女……"

# game/Story03.rpy:2094
translate chinese akt3chapter2_191f6dda:

    # g "I know I shouldn’t ask but…"
    g "我知道我不该开口，可是……"

# game/Story03.rpy:2096
translate chinese akt3chapter2_83f74e10:

    # g "End it..."
    g "结束它……"

# game/Story03.rpy:2098
translate chinese akt3chapter2_941dcd09:

    # mc "What are you ta—"
    mc "你在说什——"

# game/Story03.rpy:2104
translate chinese akt3chapter2_7c44d3a4:

    # mc "Wait—!"
    mc "等等——！"

# game/Story03.rpy:2105
translate chinese akt3chapter2_d8cf9260:

    # g "I... just wanted to go home..."
    g "我……只想回家……"

# game/Story03.rpy:2108
translate chinese akt3chapter2_bb8e4b4e_2:

    # a "..."
    a "……"

# game/Story03.rpy:2111
translate chinese akt3chapter2_5d65dc3e:

    # mc "…He was ours."
    mc "……他是我们的人。"

# game/Story03.rpy:2116
translate chinese akt3chapter2_703ac693:

    # a "He was already dying."
    a "他已经快死了。"

# game/Story03.rpy:2119
translate chinese akt3chapter2_219668a5:

    # mc "He was still there."
    mc "可他还在。"

# game/Story03.rpy:2121
translate chinese akt3chapter2_2c7767f2:

    # a "You would’ve let him suffer?"
    a "你想让他活受罪？"

# game/Story03.rpy:2122
translate chinese akt3chapter2_e80a5349:

    # a "Better a clean end than a slow death."
    a "痛快的了结，好过慢慢死。"

# game/Story03.rpy:2124
translate chinese akt3chapter2_27f72556:

    # a "That’s it. Let’s go."
    a "就这样。走吧。"

# game/Story03.rpy:2125
translate chinese akt3chapter2_2b35b6fe_4:

    # mc "..."
    mc "……"

# game/Story03.rpy:2127
translate chinese akt3chapter2_2b35b6fe_5:

    # mc "..."
    mc "……"

# game/Story03.rpy:2128
translate chinese akt3chapter2_95e32e5d:

    # mc "(…Would she do the same to me?)"
    mc "（……她也会这样对我吗？）"

# game/Story03.rpy:2131
translate chinese akt3chapter2_ea4e48cd_1:

    # a "Move."
    a "走。"

# game/Story03.rpy:2136
translate chinese akt3chapter2_71acc0ba:

    # mc "...Yeah. Coming."
    mc "……嗯。来了。"

# game/Story03.rpy:2145
translate chinese akt3chapter2_3d5a2470:

    # mc "(If that’s the only choice…)"
    mc "（如果这是唯一的选择……）"

# game/Story03.rpy:2146
translate chinese akt3chapter2_8ad2407f:

    # mc "(…then what’s waiting for me?)"
    mc "（……那等着我的又是什么？）"

# game/Story03.rpy:2149
translate chinese akt3chapter2_d47207ae:

    # mc "If it were me."
    mc "如果换成我。"

# game/Story03.rpy:2150
translate chinese akt3chapter2_ecaadc16:

    # mc "Same call?"
    mc "也一样处理？"

# game/Story03.rpy:2153
translate chinese akt3chapter2_210c06eb:

    # a "Yes."
    a "是。"

# game/Story03.rpy:2157
translate chinese akt3chapter2_fdd7f752:

    # mc "(Find Lora. Find Olivia.)"
    mc "（找到洛拉。找到奥利维亚。）"

# game/Story03.rpy:2158
translate chinese akt3chapter2_560ac6e8:

    # mc "(Now.)"
    mc "（就现在。）"

# game/Story03.rpy:2160
translate chinese akt3chapter2_6651ab87:

    # mc "Alright."
    mc "行。"

# game/Story03.rpy:2161
translate chinese akt3chapter2_377838b4:

    # mc "Enough guessing."
    mc "别猜了。"

# game/Story03.rpy:2162
translate chinese akt3chapter2_f27f72e5:

    # mc "What’s going on?"
    mc "到底怎么回事？"

# game/Story03.rpy:2165
translate chinese akt3chapter2_bb8e4b4e_3:

    # a "..."
    a "……"

# game/Story03.rpy:2166
translate chinese akt3chapter2_2b35b6fe_6:

    # mc "..."
    mc "……"

# game/Story03.rpy:2172
translate chinese akt3chapter2_1e540330:

    # a "Someone’s controlling the Soulless."
    a "有人在操控无魂者。"

# game/Story03.rpy:2181
translate chinese akt3chapter2_ece63c8d:

    # mc "…"
    mc "……"

# game/Story03.rpy:2184
translate chinese akt3chapter2_9c4ed0aa:

    # mc "The Faceless."
    mc "无面者。"

# game/Story03.rpy:2187
translate chinese akt3chapter2_a9a26a7d:

    # a "Most likely. Soulless are victims. Faceless are the hands directing them."
    a "多半是。无魂者是受害者。无面者是操控它们的手。"

# game/Story03.rpy:2190
translate chinese akt3chapter2_ec25c3bb:

    # mc "“Most likely”?"
    mc "“多半”？"

# game/Story03.rpy:2191
translate chinese akt3chapter2_0b033f18:

    # mc "You don’t know."
    mc "你也不知道。"

# game/Story03.rpy:2192
translate chinese akt3chapter2_bb8e4b4e_4:

    # a "..."
    a "……"

# game/Story03.rpy:2194
translate chinese akt3chapter2_ccce35ff:

    # a "Lots of gaps."
    a "空白太多。"

# game/Story03.rpy:2195
translate chinese akt3chapter2_8f0778a3:

    # a "Few facts."
    a "事实太少。"

# game/Story03.rpy:2198
translate chinese akt3chapter2_212c1030:

    # mc "Then how did they find this place?"
    mc "那它们怎么找到这地方的？"

# game/Story03.rpy:2205
translate chinese akt3chapter2_bb8e4b4e_5:

    # a "..."
    a "……"

# game/Story03.rpy:2206
translate chinese akt3chapter2_9cc65a10:

    # mc "Sound?"
    mc "声音？"

# game/Story03.rpy:2209
translate chinese akt3chapter2_3898012d:

    # a "They’re very sensitive to sound."
    a "它们对声音极其敏感。"

# game/Story03.rpy:2211
translate chinese akt3chapter2_487a0cb1:

    # a "That’s not your priority right now."
    a "那不是你现在该操心的。"

# game/Story03.rpy:2213
translate chinese akt3chapter2_8e359492:

    # mc "Fine."
    mc "行。"

# game/Story03.rpy:2214
translate chinese akt3chapter2_28fcb52b:

    # mc "I’ll figure it out."
    mc "我自己会弄明白。"

# game/Story03.rpy:2215
translate chinese akt3chapter2_75485dbb:

    # mc "(Just don’t lose it.)"
    mc "（别乱了阵脚。）"

# game/Story03.rpy:2226
translate chinese akt3chapter2_88386251:

    # mc "…Gunshots."
    mc "……枪声。"

# game/Story03.rpy:2229
translate chinese akt3chapter2_1c2947fa:

    # a "Hear that?"
    a "听见了吗？"

# game/Story03.rpy:2231
translate chinese akt3chapter2_2ee356db:

    # mc "That’s them."
    mc "是他们。"

# game/Story03.rpy:2232
translate chinese akt3chapter2_f305dd1e:

    # mc "If they’re alive, we move."
    mc "要是他们还活着，我们就上。"

# game/Story03.rpy:2233
translate chinese akt3chapter2_d2c6b9dd:

    # mc "If not, we find out why."
    mc "要是没了，就查清楚为什么。"

# game/Story03.rpy:2239
translate chinese akt3chapter2_7a529063:

    # g "We’re not making it out alive! Commander?!"
    g "我们活不出去了！指挥官？！"

# game/Story03.rpy:2240
translate chinese akt3chapter2_40862426:

    # gg "Hold the line! Valens is on reload!"
    gg "顶住！瓦伦斯在装弹！"

# game/Story03.rpy:2241
translate chinese akt3chapter2_ecf90cfb:

    # g "Then tell him to reload faster!"
    g "那就让他装快点！"

# game/Story03.rpy:2242
translate chinese akt3chapter2_bcffdde7:

    # g "(They’re coming from every side... A little more, and we’re finished!)"
    g "（它们从四面围上来了……再撑一会儿，我们就完了！）"

# game/Story03.rpy:2245
translate chinese akt3chapter2_6d49edca:

    # g "Not today, freaks!"
