translate chinese akt3chapter4_85f28ade:

    # Fl "What about Astoria?"
    Fl "那阿斯托里亚呢？"

# game/Story03.rpy:5135
translate chinese akt3chapter4_d7a46d19:

    # L "She tried too."
    L "她也试过。"

# game/Story03.rpy:5136
translate chinese akt3chapter4_7408d90e:

    # L "Same result."
    L "结果一样。"

# game/Story03.rpy:5138
translate chinese akt3chapter4_10a4cb79:

    # Fl "...how?!"
    Fl "……怎么可能？！"

# game/Story03.rpy:5141
translate chinese akt3chapter4_2b35b6fe_5:

    # mc "..."
    mc "……"

# game/Story03.rpy:5142
translate chinese akt3chapter4_ef0288f9:

    # mc "So there’s no way out?"
    mc "所以没有出路？"

# game/Story03.rpy:5143
translate chinese akt3chapter4_75b42395:

    # L "If I could change it…"
    L "要是我能改……"

# game/Story03.rpy:5144
translate chinese akt3chapter4_56a04b19:

    # L "...don’t you think I already would have?"
    L "……你觉得我还会等到现在？"

