    # mc "Get the commanders together."
    mc "把所有指挥官叫来。"

# game/Story03.rpy:5168
translate chinese akt3chapter4_1b073a14:

    # Fl "I..."
    Fl "我……"

# game/Story03.rpy:5169
translate chinese akt3chapter4_bc4e820a:

    # Fl "...got it."
    Fl "……明白。"

# game/Story03.rpy:5171
translate chinese akt3chapter4_9f25e89d:

    # mc "Lora, write everything down."
    mc "洛拉，全部记下来。"

# game/Story03.rpy:5172
translate chinese akt3chapter4_8479533f:

    # mc "Even the parts that sound insane."
    mc "哪怕听着荒唐的部分也记。"

# game/Story03.rpy:5174
translate chinese akt3chapter4_2c5dd124:

    # L "And you?"
    L "那你呢？"

# game/Story03.rpy:5176
translate chinese akt3chapter4_b5ac1cd2:

    # mc "I’m gonna find us a way out."
    mc "我去给我们找条出路。"

# game/Story03.rpy:5197
translate chinese akt3chapter5_0df736ef:

    # L "(Was it really the right decision...)"
    L "（那真是正确的决定吗……）"

# game/Story03.rpy:5201
translate chinese akt3chapter5_fa928b9b:

    # L "Please..."
    L "求你……"

# game/Story03.rpy:5204
translate chinese akt3chapter5_9993b94e:

    # L "..."
    L "……"

# game/Story03.rpy:5205
translate chinese akt3chapter5_9a2bb62f:

    # L "(Again…)"
    L "（又一次……）"

# game/Story03.rpy:5210
translate chinese akt3chapter5_628d6346:

    # L "(Watching it happen…)"
    L "（眼睁睁看着它发生……）"

# game/Story03.rpy:5215
translate chinese akt3chapter5_9993b94e_1:

    # L "..."
    L "……"

# game/Story03.rpy:5223
translate chinese akt3chapter5_9cbdb9ab:

    # L "(He survives.)"
    L "（他活下来了。）"

# game/Story03.rpy:5224
translate chinese akt3chapter5_24bd9d9b:

    # L "(This time… he...)"
    L "（这一次……他……）"

# game/Story03.rpy:5235
translate chinese akt3chapter5_52597078:

    # mc "You holding up?"
    mc "你还撑得住吗？"

# game/Story03.rpy:5237
translate chinese akt3chapter5_1b073a14:

    # Fl "I..."
    Fl "我……"

# game/Story03.rpy:5240
translate chinese akt3chapter5_8ed0c1b0:

    # mc "Scared?"
    mc "怕了？"

# game/Story03.rpy:5243
translate chinese akt3chapter5_b84af5bf:

    # Fl "What do you think?"
    Fl "你觉得呢？"

# game/Story03.rpy:5244
translate chinese akt3chapter5_7ac7ed60:

    # Fl "She just told us we’re going to die!"
    Fl "她刚说了我们都会死！"

# game/Story03.rpy:5245
translate chinese akt3chapter5_1b073a14_1:

    # Fl "I..."
    Fl "我……"

# game/Story03.rpy:5246
translate chinese akt3chapter5_b24defdf:

    # Fl "(whispering) I don’t want to die."
    Fl "（低声）我不想死。"

# game/Story03.rpy:5249
translate chinese akt3chapter5_cf1adef2:

    # mc "Yeah."
    mc "嗯。"

# game/Story03.rpy:5250
translate chinese akt3chapter5_98d19c29:

    # mc "Me neither."
    mc "我也不想。"

# game/Story03.rpy:5260
translate chinese akt3chapter5_2d82a0eb:

    # Fl "You don’t get it..."
    Fl "你不懂……"

# game/Story03.rpy:5261
translate chinese akt3chapter5_fbfb49e5:

    # Fl "Everyone sees me as some naive, spoiled little pet."
    Fl "所有人都把我当成个天真、被惯坏的小宠物。"

# game/Story03.rpy:5262
translate chinese akt3chapter5_eeebf6fe:

    # Fl "No one takes me seriously."
    Fl "没人拿我当回事。"

# game/Story03.rpy:5263
translate chinese akt3chapter5_67ec577e:

    # Fl "...not even you."
    Fl "……连你也是。"

# game/Story03.rpy:5265
translate chinese akt3chapter5_31eff69d:

    # mc "I—"
    mc "我——"

# game/Story03.rpy:5271
translate chinese akt3chapter5_d03c74b7:

    # Fl "Exactly."
    Fl "就是这样。"

# game/Story03.rpy:5273
translate chinese akt3chapter5_9763be76:

    # mc "What about Ember?"
    mc "恩伯呢？"

# game/Story03.rpy:5278
translate chinese akt3chapter5_3ef5cb5e:

    # Fl "She..."
    Fl "她……"

# game/Story03.rpy:5281
translate chinese akt3chapter5_dc16ebcd:

    # mc "Got it."
    mc "明白了。"

# game/Story03.rpy:5282
translate chinese akt3chapter5_eab0b344:

    # mc "Even now, she wanted something in return."
    mc "都到这份上了，她还要回报。"

# game/Story03.rpy:5284
translate chinese akt3chapter5_41da62cb:

    # Fl "..."
    Fl "……"

# game/Story03.rpy:5286
translate chinese akt3chapter5_d1674048:

    # Fl "Power isn’t about friendship."
    Fl "权力跟交情没关系。"

# game/Story03.rpy:5296
translate chinese akt3chapter5_04e4b842:

    # mc "(whispering) ...Strength."
    mc "（低声）……是力量。"

# game/Story03.rpy:5300
translate chinese akt3chapter5_7e02afc0:

    # mc "Go to Lora."
    mc "去找洛拉。"

# game/Story03.rpy:5301
translate chinese akt3chapter5_823e29cb:

    # mc "Get the plan ready."
    mc "把计划准备好。"

# game/Story03.rpy:5304
translate chinese akt3chapter5_8851e609:

    # Fl "What plan?"
    Fl "什么计划？"

# game/Story03.rpy:5306
translate chinese akt3chapter5_05ea62a6:

    # mc "The freeze."
    mc "冻结方案。"

# game/Story03.rpy:5308
translate chinese akt3chapter5_00e6018e:

    # Fl "But-"
    Fl "可是——"

# game/Story03.rpy:5311
translate chinese akt3chapter5_688a3fb0:

    # mc "Go."
    mc "去。"

# game/Story03.rpy:5313
translate chinese akt3chapter5_41da62cb_1:

    # Fl "..."
    Fl "……"

# game/Story03.rpy:5315
translate chinese akt3chapter5_221fa0f7:

    # Fl "No one will listen."
    Fl "没人会听的。"

# game/Story03.rpy:5317
translate chinese akt3chapter5_b31dd769:

    # mc "I’ll handle the rest."
    mc "剩下的我来处理。"

# game/Story03.rpy:5326
translate chinese akt3chapter5_5e44a000:

    # mc "Right..."
    mc "好……"

# game/Story03.rpy:5328
translate chinese akt3chapter5_ea0294a0:

    # mc "(Pull yourself together.)"
    mc "（振作起来。）"

# game/Story03.rpy:5329
translate chinese akt3chapter5_93cfe2d7:

    # mc "(And stop shaking.)"
    mc "（别抖了。）"

# game/Story03.rpy:5349
translate chinese akt3chapter5_1_2b35b6fe:

    # mc "..."
    mc "……"

# game/Story03.rpy:5351
translate chinese akt3chapter5_1_37becf81:

    # mc "(Feels like the air down here forgot how to breathe...)"
    mc "（感觉这下面的空气都忘了怎么呼吸……）"

# game/Story03.rpy:5353
translate chinese akt3chapter5_1_bb3fd65b:

    # mc "Come out. I know you’re here."
    mc "出来吧。我知道你在。"

# game/Story03.rpy:5356
translate chinese akt3chapter5_1_bb8e4b4e:

    # a "..."
    a "……"

# game/Story03.rpy:5358
translate chinese akt3chapter5_1_88ebbfd6:

    # a "Speak."
    a "说。"

# game/Story03.rpy:5360
translate chinese akt3chapter5_1_566d630c:

    # mc "I need your help."
    mc "我需要你帮忙。"

# game/Story03.rpy:5361
translate chinese akt3chapter5_1_bb8e4b4e_1:

    # a "..."
    a "……"

# game/Story03.rpy:5363
translate chinese akt3chapter5_1_2e8b37ee:

    # k "And what little scheme have you cooked up this time?"
    k "这次又鼓捣出什么小算盘了？"

# game/Story03.rpy:5366
translate chinese akt3chapter5_1_3d10100f:

    # a "Left the water warm. In the bath."
    a "洗澡水给你留着温的。"

# game/Story03.rpy:5369
translate chinese akt3chapter5_1_c30a63ea:

    # k "Thanks, sister."
    k "谢了，姐妹。"

# game/Story03.rpy:5371
translate chinese akt3chapter5_1_7a179be7:

    # mc "I’m taking command of the army."
    mc "我要接管这支军队的指挥权。"

# game/Story03.rpy:5373
translate chinese akt3chapter5_1_850ef128:

    # b "..."
    b "……"

# game/Story03.rpy:5376
translate chinese akt3chapter5_1_0a9d723c:

    # k "Ohoho! Delightful."
    k "哦呵呵！有意思。"

# game/Story03.rpy:5380
translate chinese akt3chapter5_1_bb8e4b4e_2:

    # a "..."
    a "……"

# game/Story03.rpy:5382
translate chinese akt3chapter5_1_a6cdd6be:

    # a "But?"
    a "但是？"

# game/Story03.rpy:5384
translate chinese akt3chapter5_1_d71645f2:

    # mc "But I don’t have enough authority for anyone to follow me."
    mc "但我威信不够，没人会跟我。"

# game/Story03.rpy:5386
translate chinese akt3chapter5_1_e21905b1:

    # a "And you thought we’d help you with that?"
    a "你觉得我们会帮你搞定这个？"

# game/Story03.rpy:5392
translate chinese akt3chapter5_1_6d548c5d:

    # mc "You’d rather die?"
    mc "你宁愿死？"

# game/Story03.rpy:5398
translate chinese akt3chapter5_1_721d45ff:

    # a "That sounded like a threat."
    a "这听着像威胁。"

# game/Story03.rpy:5401
translate chinese akt3chapter5_1_ea147d35:

    # mc "I’m trying to keep us alive."
    mc "我只是想让大家活下来。"

# game/Story03.rpy:5403
translate chinese akt3chapter5_1_b4838f5b:

    # mc "You can decide what to do with me later."
    mc "之后你们想怎么处置我都行。"

# game/Story03.rpy:5404
translate chinese akt3chapter5_1_b18e4b33:

    # mc "But now, I need you."
    mc "但现在，我需要你们。"

# game/Story03.rpy:5406
translate chinese akt3chapter5_1_bb8e4b4e_3:

    # a "..."
    a "……"

# game/Story03.rpy:5407
translate chinese akt3chapter5_1_6d460376:

    # mc "Your answer?"
    mc "答复呢？"

# game/Story03.rpy:5413
translate chinese akt3chapter5_1_75507e23:

    # a "Unexpected. But accepted."
    a "出乎意料。但接受。"

# game/Story03.rpy:5417
translate chinese akt3chapter5_1_bb0eeaf4:

    # mc "Thank you."
    mc "谢谢。"

# game/Story03.rpy:5419
translate chinese akt3chapter5_1_b016e587:

    # k "We can influence the small fry. But what about the big fish?"
    k "小鱼小虾我们能压住。可大鱼呢？"

# game/Story03.rpy:5421
translate chinese akt3chapter5_1_385d68a7:

    # k "Your approach won’t work on them."
    k "你那一套对他们不管用。"

# game/Story03.rpy:5423
translate chinese akt3chapter5_1_5c7940de:

    # mc "Then I’ll find other levers to pull."
    mc "那我就找别的杠杆来撬。"

# game/Story03.rpy:5425
translate chinese akt3chapter5_1_82091822:

    # k "..."
    k "……"

# game/Story03.rpy:5429
translate chinese akt3chapter5_1_9247b832:

    # k "How curious..."
    k "真有意思……"

# game/Story03.rpy:5437
translate chinese akt3chapter5_1_f848e410:

    # g "Who are you? This area is off li—"
    g "你是谁？这区域禁止——"

# game/Story03.rpy:5444
translate chinese akt3chapter5_1_8a8c2a58:

    # gg "And who the hell are you?"
    gg "你他妈又是谁？"

# game/Story03.rpy:5447
translate chinese akt3chapter5_1_d6f80076:

    # ggg "What are you doing?!"
    ggg "你干什么？！"

# game/Story03.rpy:5449
translate chinese akt3chapter5_1_b22f8d16:

    # mc "Surviving."
    mc "活着。"

# game/Story03.rpy:5452
translate chinese akt3chapter5_1_88ad5c5e:

    # mc "Don’t make this harder than it needs to be."
    mc "别把事弄复杂了。"

# game/Story03.rpy:5455
translate chinese akt3chapter5_1_efadbefc:

    # g "Drop weapon! Now!"
    g "放下武器！现在！"

# game/Story03.rpy:5457
translate chinese akt3chapter5_1_572473be:

    # mc "We’re past diplomacy."
    mc "外交阶段已经过了。"

# game/Story03.rpy:5460
translate chinese akt3chapter5_1_ceb61bca:

    # k "What would you do without me?"
    k "没了我你可怎么办？"

# game/Story03.rpy:5461
translate chinese akt3chapter5_1_7296948a:

    # k "Die, probably."
    k "大概会死吧。"

# game/Story03.rpy:5463
translate chinese akt3chapter5_1_6f274295:

    # mc "Kalestra. Your turn."
    mc "卡莱斯特拉。该你了。"

# game/Story03.rpy:5465
translate chinese akt3chapter5_1_def8f168:

    # a "They won’t like this."
    a "他们不会喜欢这样。"

# game/Story03.rpy:5467
translate chinese akt3chapter5_1_a78edaca:

    # mc "Survival rarely looks clean."
    mc "活命这事，很少干净。"

# game/Story03.rpy:5471
translate chinese akt3chapter5_1_83b21bf6:

    # k "Yes, yes, your excellency..."
    k "是，是，大人……"

# game/Story03.rpy:5474
translate chinese akt3chapter5_1_c01b0e08:

    # ggg "(Whispering) This is treason..."
    ggg "（低声）这是叛国……"

# game/Story03.rpy:5475
translate chinese akt3chapter5_1_16452ef9:

    # ggg "(Whispering) Then you go tell her that to her face..."
    ggg "（低声）那你去当着她的面说啊……"

# game/Story03.rpy:5476
translate chinese akt3chapter5_1_6f59d2aa:

    # k "Out of the way."
    k "让开。"

# game/Story03.rpy:5477
translate chinese akt3chapter5_1_b9597520:

    # k "Authority just arrived."
    k "权威到了。"

# game/Story03.rpy:5480
translate chinese akt3chapter5_1_897e78ac:

    # k "Turn on the PA."
    k "打开广播。"

# game/Story03.rpy:5483
translate chinese akt3chapter5_1_42c7a354:

    # gg "Y-yes, ma’am, right away..."
    gg "是、是，长官，马上……"

# game/Story03.rpy:5485
translate chinese akt3chapter5_1_16153dc4:

    # k "Wonderful."
    k "好极了。"

# game/Story03.rpy:5486
translate chinese akt3chapter5_1_42f0cb23:

    # k "Can everyone hear me now?"
    k "现在所有人都能听见我了吗？"

# game/Story03.rpy:5488
translate chinese akt3chapter5_1_db053b07:

    # k "Anyone still sleeping gets dragged out by the throat."
    k "还在睡的，会被掐着脖子拖出来。"

# game/Story03.rpy:5490
translate chinese akt3chapter5_1_40fb63b4:

    # h "What the...?"
    h "搞什么……？"

# game/Story03.rpy:5492
translate chinese akt3chapter5_1_9625f945:

    # Mi "I know that voice."
    Mi "这声音我认得。"

# game/Story03.rpy:5495
translate chinese akt3chapter5_1_d15bbb53:

    # k "You’d better."
    k "你最好认得。"

# game/Story03.rpy:5496
translate chinese akt3chapter5_1_819ee949:

    # k "Now, what was I supposed to say... Ah, right."
    k "那么，我该说什么来着……啊，对了。"

# game/Story03.rpy:5498
translate chinese akt3chapter5_1_fb7d727a:

    # h "She’s just the same as ever."
    h "她还是老样子。"

# game/Story03.rpy:5507
translate chinese akt3chapter5_1_103becde:

    # k "This is Kalestra Elverin Ord’Laria speaking."
    k "我是卡莱斯特拉·艾尔维林·奥德·拉里亚。"

# game/Story03.rpy:5510
translate chinese akt3chapter5_1_f2cd8f3e:

    # k "By order of the Inquisition, the current command is hereby relieved. Immediately."
    k "奉审判庭之命，现任指挥部即刻解职。立刻生效。"

# game/Story03.rpy:5511
translate chinese akt3chapter5_1_a2519b01:

    # g "(Whispering) That’s the man who brought the Sector Six transport back."
    g "（低声）就是他把第 6 区的运输船带回来的。"

# game/Story03.rpy:5512
translate chinese akt3chapter5_1_53ff0e13:

    # gg "(Whispering) And the old command was ready to leave them there."
    gg "（低声）而老指挥部本来打算把他们扔在那儿。"

# game/Story03.rpy:5516
translate chinese akt3chapter5_1_4c325193:

    # em "Now things are getting interesting."
    em "现在有意思了。"

# game/Story03.rpy:5518
translate chinese akt3chapter5_1_de055f8c:

    # gg "What do we do, Miss Ember?"
    gg "我们怎么办，恩伯小姐？"

# game/Story03.rpy:5520
translate chinese akt3chapter5_1_7c1faae7:

    # em "Nothing."
    em "什么都不做。"

# game/Story03.rpy:5522
translate chinese akt3chapter5_1_cdf3852b:

    # k "This isn’t improvisation. It’s wartime protocol."
    k "这不是临场发挥。这是战时条例。"

# game/Story03.rpy:5523
translate chinese akt3chapter5_1_c0a94019:

    # k "Any officer obstructing evacuation is relieved and detained. Armed resistance will be treated as treason."
    k "任何妨碍撤离的军官，一律解职扣押。武装抵抗按叛国论处。"

# game/Story03.rpy:5524
translate chinese akt3chapter5_1_6d1dbdd6:

    # mc "(No choice. No appeal. Exactly the kind of authority I despise.)"
    mc "（没得选。没得上诉。正是我最厌恶的那种权威。）"

# game/Story03.rpy:5525
translate chinese akt3chapter5_1_fb42c328:

    # mc "(And I’m using it anyway.)"
    mc "（可我还是在用它。）"

# game/Story03.rpy:5527
translate chinese akt3chapter5_1_d262f0e8:

    # Fl "They... actually handed me command?"
    Fl "他们……真把指挥权交给我了？"

# game/Story03.rpy:5529
translate chinese akt3chapter5_1_1a82d3cc:

    # L "What are you doing, darling..."
    L "你在做什么，亲爱的……"

# game/Story03.rpy:5530
translate chinese akt3chapter5_1_41da62cb:

    # Fl "..."
    Fl "……"

# game/Story03.rpy:5533
translate chinese akt3chapter5_1_1b7687a1:

    # L "So... you’re officially a commander now?"
    L "所以……你正式成为指挥官了？"

# game/Story03.rpy:5534
translate chinese akt3chapter5_1_41da62cb_1:

    # Fl "..."
    Fl "……"

# game/Story03.rpy:5543
translate chinese akt3chapter5_1_4ca66fb4:

    # k "That’s all! Now, to the hangar. Chop-chop. We’ve got murders to plan and not enough time."
    k "就这些！现在，去机库。快点。我们还有一堆人要杀，时间不够。"

# game/Story03.rpy:5546
translate chinese akt3chapter5_1_46165e04:

    # gg "You’re way out of line!"
    gg "你太过分了！"

# game/Story03.rpy:5547
translate chinese akt3chapter5_1_c6f3f8db:

    # ggg "Have you all lost your minds?!"
    ggg "你们都疯了吗？！"

# game/Story03.rpy:5551
translate chinese akt3chapter5_1_692ec8f7:

    # k "No. You’re just cowards hiding behind procedure."
    k "不。你们只是躲在程序后面的懦夫。"

# game/Story03.rpy:5552
translate chinese akt3chapter5_1_134fc383:

    # k "Sis, remind me, what’s the punishment for mouthing off to an Inquisitor?"
    k "姐妹，提醒我一下，对审判官出言不逊是什么惩罚？"

# game/Story03.rpy:5554
translate chinese akt3chapter5_1_33c873ff:

    # a "Tribunal. In wartime, execution."
    a "军事法庭。战时，处决。"

# game/Story03.rpy:5556
translate chinese akt3chapter5_1_b310aa38:

    # k "Execution?"
    k "处决？"

# game/Story03.rpy:5557
translate chinese akt3chapter5_1_fe8fb784:

    # k "Mm. Efficient."
    k "嗯。效率高。"

# game/Story03.rpy:5559
translate chinese akt3chapter5_1_5f760176:

    # k "So, what were you saying, boys? Couldn’t hear you over your teeth chattering."
    k "那你们刚才说什么，小伙子们？你们牙打颤的声音太大，我没听清。"

# game/Story03.rpy:5560
translate chinese akt3chapter5_1_752b8262:

    # gg "..."
    gg "……"

# game/Story03.rpy:5561
translate chinese akt3chapter5_1_0769102a:

    # k "Take them away. Gently. With nails."
    k "带走他们。温柔点。用钉子。"

# game/Story03.rpy:5563
translate chinese akt3chapter5_1_131f4000:

    # k "Justice prevails, as always!"
    k "正义必胜，一如既往！"

# game/Story03.rpy:5565
translate chinese akt3chapter5_1_632438b3:

    # a "You haven’t changed. Still mad."
    a "你没变。还是疯。"

# game/Story03.rpy:5567
translate chinese akt3chapter5_1_01cbc88e:

    # k "People call it madness whenever someone stops asking permission."
    k "只要有人不再请示许可，别人就管那叫疯。"

# game/Story03.rpy:5568
translate chinese akt3chapter5_1_f47b3dd5:

    # k "And freedom, sister, smells like fire and steel."
    k "而自由的味道，姐妹，是火和钢。"

# game/Story03.rpy:5570
translate chinese akt3chapter5_1_5449345d:

    # mc "(And that’s exactly why people fear you.)"
    mc "（而这就是人们怕你的原因。）"

# game/Story03.rpy:5571
translate chinese akt3chapter5_1_2b35b6fe_1:

    # mc "..."
    mc "……"

# game/Story03.rpy:5573
translate chinese akt3chapter5_1_cfcc8fd5:

    # mc "Enough spectacle."
    mc "戏演够了。"

# game/Story03.rpy:5574
translate chinese akt3chapter5_1_2562ad6f:

    # mc "Move."
    mc "走。"

# game/Story03.rpy:5588
translate chinese akt3chapter5_1_d8df9d56:

    # mc "(Quite a crowd out there.)"
    mc "（外面人还真不少。）"

# game/Story03.rpy:5590
translate chinese akt3chapter5_1_7468f756:

    # L "Calm down, girl. We've been through this already."
    L "冷静点，姑娘。这些我们都过过一遍了。"

# game/Story03.rpy:5592
translate chinese akt3chapter5_1_c4f330ff:

    # Fl "I... I can't. There are too many people..."
    Fl "我……我做不到。人太多了……"

# game/Story03.rpy:5593
translate chinese akt3chapter5_1_7faf5913:

    # Fl "What if... they won’t agree? Then it’s all over!"
    Fl "万一……他们不同意呢？那就全完了！"

# game/Story03.rpy:5596
translate chinese akt3chapter5_1_fa8bac44:

    # gg "Because of your plan, many of our comrades are still alive."
    gg "多亏你的计划，我们很多战友还活着。"

# game/Story03.rpy:5597
translate chinese akt3chapter5_1_ef3e37a6:

    # gggg "Exactly! We’ll back you, no matter what it costs!"
    gggg "没错！不管代价多大，我们都撑你！"

# game/Story03.rpy:5599
translate chinese akt3chapter5_1_1c347c1d:

    # Fl "Yeah, you’re... right."
    Fl "嗯，你说得……对。"

# game/Story03.rpy:5600
translate chinese akt3chapter5_1_a250644c:

    # Fl "I need to pull myself together."
    Fl "我得振作起来。"

# game/Story03.rpy:5602
translate chinese akt3chapter5_1_1f56feb7:

    # mc "Ready?"
    mc "准备好了吗？"

# game/Story03.rpy:5604
translate chinese akt3chapter5_1_0a4b47c2:

    # Fl "No... But I’ll do everything I can."
    Fl "没有……但我会尽全力。"

# game/Story03.rpy:5606
translate chinese akt3chapter5_1_0297642d:

    # mc "Lora?"
    mc "洛拉？"

# game/Story03.rpy:5607
translate chinese akt3chapter5_1_e4423a79:

    # mc "Outcome?"
    mc "结果呢？"

# game/Story03.rpy:5609
translate chinese akt3chapter5_1_22d0ef64:

    # L "I... don't know."
    L "我……不知道。"

# game/Story03.rpy:5610
translate chinese akt3chapter5_1_2b35b6fe_2:

    # mc "..."
    mc "……"

# game/Story03.rpy:5612
translate chinese akt3chapter5_1_712df1b0:

    # mc "No point backing out now."
    mc "现在退也没意义了。"

# game/Story03.rpy:5619
translate chinese akt3chapter5_1_77980029:

    # g "(Whispering) Is that her?"
    g "（低声）就是她？"

# game/Story03.rpy:5620
translate chinese akt3chapter5_1_d5751315:

    # gg "(Whispering) The one with the cat ears? Yeah, that’s her."
    gg "（低声）那个长猫耳朵的？对，就是她。"

# game/Story03.rpy:5622
translate chinese akt3chapter5_1_43b86625:

    # g "(Whispering) What’s the Inquisition thinking, letting beasts command us..."
    g "（低声）审判庭怎么想的，让野兽来指挥我们……"

# game/Story03.rpy:5624
translate chinese akt3chapter5_1_bb8e4b4e_4:

    # a "..."
    a "……"

# game/Story03.rpy:5627
translate chinese akt3chapter5_1_93394a34:

    # k "You hear that? Gossiping about us. Wait 'til they find out the truth — what a joke."
    k "听见没？在背后嚼我们舌根。等他们知道真相——那才叫笑话。"

    # game/Story03.rpy:5629
translate chinese akt3chapter5_1_3bdfe8c7:

    # L "How are you holding up?"
    L "你还撑得住吗？"

# game/Story03.rpy:5634
translate chinese akt3chapter5_1_968789a3:

    # Fl "I-I think I’m okay... apart from the mild shaking."
    Fl "我、我还行……除了有点抖。"

# game/Story03.rpy:5636
translate chinese akt3chapter5_1_85ed116b:

    # Fl "Are you sure they’ll even listen to us?"
    Fl "你确定他们会听我们的？"

# game/Story03.rpy:5638
translate chinese akt3chapter5_1_0cc4c70c:

    # mc "Not sure. But it’s worth trying."
    mc "不确定。但值得一试。"

# game/Story03.rpy:5639
translate chinese akt3chapter5_1_4b6a5fde:

    # mc "Besides..."
    mc "再说……"

# game/Story03.rpy:5642
translate chinese akt3chapter5_1_f36519fa:

    # mc "(There won’t be a better moment than this.)"
    mc "（不会再有比这更好的时机了。）"

# game/Story03.rpy:5644
translate chinese akt3chapter5_1_03116a06:

    # ggg "(Whispering) Who do they think they are, ordering us around?"
    ggg "（低声）他们以为他们是谁，对我们发号施令？"

# game/Story03.rpy:5647
translate chinese akt3chapter5_1_eacfde6f:

    # g "Who needs that mutt anyway?"
    g "谁需要那条杂种狗？"

# game/Story03.rpy:5648
translate chinese akt3chapter5_1_f35d5059:

    # gg "Wasting our time... We’re doomed either way..."
    gg "浪费时间……横竖都是死……"

# game/Story03.rpy:5650
translate chinese akt3chapter5_1_0a317cc2:

    # mc "(Tired. Angry. Starving for someone to lead them.)"
    mc "（疲惫。愤怒。渴望有人来带队。）"

# game/Story03.rpy:5652
translate chinese akt3chapter5_1_2b35b6fe_3:

    # mc "..."
    mc "……"

# game/Story03.rpy:5654
translate chinese akt3chapter5_1_d0e40f57:

    # mc "SURVIVE!"
    mc "活下去！"

# game/Story03.rpy:5655
translate chinese akt3chapter5_1_0061b368:

    # ggg "..."
    ggg "……"

# game/Story03.rpy:5656
translate chinese akt3chapter5_1_86a2a077:

    # gg "HOW?!"
    gg "怎么活？！"

# game/Story03.rpy:5657
translate chinese akt3chapter5_1_a6c2c66e:

    # g "WE'VE ALREADY LOST!"
    g "我们早就输了！"

# game/Story03.rpy:5660
translate chinese akt3chapter5_1_6235d204:

    # mc "(They think I’m insane.)"
    mc "（他们觉得我疯了。）"

# game/Story03.rpy:5661
translate chinese akt3chapter5_1_3517da4b:

    # mc "(Maybe they’re right.)"
    mc "（也许他们说得对。）"

# game/Story03.rpy:5662
translate chinese akt3chapter5_1_51dcac5a:

    # mc "Listen."
    mc "听着。"

# game/Story03.rpy:5664
translate chinese akt3chapter5_1_36581657:

    # mc "I’m not going to stand here and promise survival."
    mc "我不会站在这儿保证大家都能活。"

# game/Story03.rpy:5665
translate chinese akt3chapter5_1_639617cb:

    # mc "Some of us probably won’t make it."
    mc "我们当中有些人，大概活不下来。"

# game/Story03.rpy:5667
translate chinese akt3chapter5_1_fa6ce8c2:

    # g "Then why are you even here?!"
    g "那你来这儿干嘛？！"

# game/Story03.rpy:5669
translate chinese akt3chapter5_1_b15f30bd:

    # mc "Waiting to die isn’t a strategy."
    mc "等死不是战略。"

# game/Story03.rpy:5673
translate chinese akt3chapter5_1_0f47fc0d:

    # mc "Maybe Flora’s wrong."
    mc "也许弗洛拉错了。"

# game/Story03.rpy:5674
translate chinese akt3chapter5_1_28737f53:

    # mc "Maybe I’m wrong."
    mc "也许我错了。"

# game/Story03.rpy:5676
translate chinese akt3chapter5_1_f0396b93:

    # mc "Doing nothing guarantees the outcome."
    mc "什么都不做，结果才注定。"

# game/Story03.rpy:5682
translate chinese akt3chapter5_1_64df8345:

    # mc "(Voice is shaking... Hope they didn’t catch that.)"
    mc "（声音在抖……希望他们没听出来。）"

# game/Story03.rpy:5691
translate chinese akt3chapter5_1_d3c8de34:

    # mc "Right now that’s all we have left."
    mc "现在，我们就剩这个了。"

# game/Story03.rpy:5693
translate chinese akt3chapter5_1_dc676b5b:

    # mc "Right now, all we have is a direction."
    mc "现在，我们有的只是一个方向。"

# game/Story03.rpy:5695
translate chinese akt3chapter5_1_24c78e8b:

    # mc "And each other."
    mc "还有彼此。"

# game/Story03.rpy:5696
translate chinese akt3chapter5_1_b5fd579d:

    # mc "And people willing to stand beside you."
    mc "还有愿意站到你身边的人。"

# game/Story03.rpy:5699
translate chinese akt3chapter5_1_05592b27:

    # mc "If you can still stand — stand."
    mc "要是你还站得起来——就站。"

# game/Story03.rpy:5706
translate chinese akt3chapter5_1_fbaa6d26:

    # mc "And if you’re afraid..."
    mc "要是你怕……"

# game/Story03.rpy:5707
translate chinese akt3chapter5_1_ac313663:

    # mc "So am I."
    mc "我也怕。"

# game/Story03.rpy:5708
translate chinese akt3chapter5_1_29610376:

    # mc "Move anyway."
    mc "但还是动起来。"

# game/Story03.rpy:5711
translate chinese akt3chapter5_1_0061b368_1:

    # ggg "..."
    ggg "……"

# game/Story03.rpy:5712
translate chinese akt3chapter5_1_7cf243cc:

    # gg "...This is madness. And this is your plan?"
    gg "……这是疯了。这就是你的计划？"

# game/Story03.rpy:5713
translate chinese akt3chapter5_1_94374d89:

    # g "I'd rather run than... this."
    g "我宁愿跑，也不要……这个。"

# game/Story03.rpy:5716
translate chinese akt3chapter5_1_9939c474:

    # L "Don’t worry, girl."
    L "别担心，姑娘。"

# game/Story03.rpy:5718
translate chinese akt3chapter5_1_7ad4516a:

    # Fl "(They... believe in me.)"
    Fl "（他们……信我。）"

# game/Story03.rpy:5720
translate chinese akt3chapter5_1_2c77e49d:

    # Fl "(I don’t get to fall apart now.)"
    Fl "（现在我没资格垮。）"

# game/Story03.rpy:5722
translate chinese akt3chapter5_1_c665a285:

    # Fl "I... I’ll do my best."
    Fl "我……我会尽全力。"

# game/Story03.rpy:5731
translate chinese akt3chapter5_1_226e69d0:

    # g "What’s your plan?"
    g "你的计划是什么？"

# game/Story03.rpy:5734
translate chinese akt3chapter5_1_b359d44f:

    # Fl "To freeze the Soulless. With cryogen."
    Fl "用冷冻剂冻住无魂者。"

# game/Story03.rpy:5735
translate chinese akt3chapter5_1_59242a8a:

    # Fl "Freezing is the priority."
    Fl "冻结是第一优先。"

# game/Story03.rpy:5736
translate chinese akt3chapter5_1_044afcc9:

    # Fl "If they breach the line, shoot. But only then."
    Fl "要是它们突破防线，就开枪。但只有那时候才能开。"

# game/Story03.rpy:5737
translate chinese akt3chapter5_1_76982a3a:

    # Fl "Every dead Soulless feeds the substance."
    Fl "每死一个无魂者，都会喂养那东西。"

# game/Story03.rpy:5738
translate chinese akt3chapter5_1_4eae6bae:

    # Fl "So we don't kill to win. We kill only to buy seconds."
    Fl "所以我们杀，不是为了赢。杀，只是为了多争几秒。"

# game/Story03.rpy:5740
translate chinese akt3chapter5_1_30775db2:

    # gg "You think cryogen can stop the Soulless?"
    gg "你觉得冷冻剂能挡住无魂者？"

# game/Story03.rpy:5741
translate chinese akt3chapter5_1_354baf61:

    # ggg "That’s suicide!"
    ggg "那是自杀！"

# game/Story03.rpy:5742
translate chinese akt3chapter5_1_d29a4c68:

    # Fl "Then we have the same expectations."
    Fl "那我们的预期一致。"

# game/Story03.rpy:5743
translate chinese akt3chapter5_1_0061b368_2:

    # ggg "..."
    ggg "……"

# game/Story03.rpy:5745
translate chinese akt3chapter5_1_a46bb0f1:

    # Fl "Second phase is taking back the central tower."
    Fl "第二阶段是夺回中央高塔。"

# game/Story03.rpy:5747
translate chinese akt3chapter5_1_59ab45a3:

    # gg "And you think we’re strong enough for that?"
    gg "你觉得我们强到能干这个？"

# game/Story03.rpy:5750
translate chinese akt3chapter5_1_41da62cb_2:

    # Fl "..."
    Fl "……"

# game/Story03.rpy:5751
translate chinese akt3chapter5_1_fd3be89e:

    # Fl "(Breathe... Just breathe.)"
    Fl "（呼吸……只管呼吸。）"

# game/Story03.rpy:5753
translate chinese akt3chapter5_1_ecc543cf:

    # Fl "(You prepared for this.)"
    Fl "（你为这个准备过。）"

# game/Story03.rpy:5763
translate chinese akt3chapter5_1_48b7d7cc:

    # Fl "(Stop shaking.)"
    Fl "（别抖了。）"

# game/Story03.rpy:5766
translate chinese akt3chapter5_1_85465385:

    # Fl "If you want to survive, listen!"
    Fl "想活命，就听好了！"

# game/Story03.rpy:5768
translate chinese akt3chapter5_1_a6b1657b:

    # g "How are you going to pull that off?"
    g "你打算怎么做到？"

# game/Story03.rpy:5781
translate chinese akt3chapter5_1_baeabc28:

    # Fl "Our entire lower city is fitted with an air processing system."
    Fl "我们整个下城都装了空气处理系统。"

# game/Story03.rpy:5782
translate chinese akt3chapter5_1_260d2ad7:

    # Fl "The first team will head to the pumping station to load the cryog-"
    Fl "第一队去泵站装载冷冻——"

# game/Story03.rpy:5785
translate chinese akt3chapter5_1_4c384397:

    # g "And if the plan fails?"
    g "那要是计划失败呢？"

# game/Story03.rpy:5787
translate chinese akt3chapter5_1_fd8609c8:

    # gg "And what about the civilians? Planning to leave them behind?"
    gg "那平民呢？打算把他们扔下？"

# game/Story03.rpy:5789
translate chinese akt3chapter5_1_a76d5095:

    # em "We’ll evacua—"
    em "我们会撤——"

# game/Story03.rpy:5791
translate chinese akt3chapter5_1_fb3b0572:

    # gg "Where ar-"
    gg "撤到哪——"

# game/Story03.rpy:5792
translate chinese akt3chapter5_1_cda8c2f5:

    # em "Cut me off again, and you die."
    em "你再打断我一次，就得死。"

# game/Story03.rpy:5794
translate chinese akt3chapter5_1_57d31baa:

    # em "I’ll get my people out."
    em "我会把我的人带出去。"

# game/Story03.rpy:5795
translate chinese akt3chapter5_1_c69329cb:

    # em "That’s the last time."
    em "这是最后一次。"

# game/Story03.rpy:5797
translate chinese akt3chapter5_1_752b8262_1:

    # gg "..."
    gg "……"

# game/Story03.rpy:5800
translate chinese akt3chapter5_1_d81137e0:

    # g "Why don’t we just run?!"
    g "我们干嘛不干脆跑？！"

# game/Story03.rpy:5803
translate chinese akt3chapter5_1_920f8a6d:

    # L "It’s already too late."
    L "已经太迟了。"

# game/Story03.rpy:5805
translate chinese akt3chapter5_1_bb8e4b4e_5:

    # a "..."
    a "……"

# game/Story03.rpy:5808
translate chinese akt3chapter5_1_ef395dc6:

    # L "The Tower is about to activate."
    L "高塔即将启动。"

# game/Story03.rpy:5809
translate chinese akt3chapter5_1_4a45358c:

    # L "It’s over. Not just the city, the whole planet."
    L "完了。不只是这座城市，是整个星球。"

# game/Story03.rpy:5812
translate chinese akt3chapter5_1_38132948:

    # ggg "WHAT?! What are you even saying?"
    ggg "什么？！你在说什么？"

# game/Story03.rpy:5813
translate chinese akt3chapter5_1_86529014:

    # gggg "That can't be..."
    gggg "不可能……"

# game/Story03.rpy:5814
translate chinese akt3chapter5_1_c3bd15fc:

    # g "You’re insane! The Tower is the command center!"
    g "你疯了！高塔是指挥中心！"

# game/Story03.rpy:5816
translate chinese akt3chapter5_1_45c37613:

    # k "Sis... What do we do?"
    k "姐妹……我们怎么办？"

# game/Story03.rpy:5818
translate chinese akt3chapter5_1_bb8e4b4e_6:

    # a "..."
    a "……"

# game/Story03.rpy:5825
translate chinese akt3chapter5_1_bb8e4b4e_7:

    # a "..."
    a "……"

# game/Story03.rpy:5828
translate chinese akt3chapter5_1_63c9f7ff:

    # a "Silence!"
    a "安静！"

# game/Story03.rpy:5830
translate chinese akt3chapter5_1_66cbdc61:

    # k "Gods... how does she do that every time..."
    k "天哪……她每次是怎么做到的……"

# game/Story03.rpy:5834
translate chinese akt3chapter5_1_bcc1523c:

    # a "It's true."
    a "是真的。"

# game/Story03.rpy:5838
translate chinese akt3chapter5_1_f36161d2:

    # a "Shut up."
    a "闭嘴。"

# game/Story03.rpy:5839
translate chinese akt3chapter5_1_82091822_1:

    # k "..."
    k "……"

# game/Story03.rpy:5841
translate chinese akt3chapter5_1_0061b368_3:

    # ggg "..."
    ggg "……"

# game/Story03.rpy:5844
translate chinese akt3chapter5_1_0529ebd9:

    # ggg "But we don’t have the manpower to take it..."
    ggg "可我们没那么多兵力去夺它……"

# game/Story03.rpy:5845
translate chinese akt3chapter5_1_64e7d7de:

    # g "Where... Where are you going to get people for this?"
    g "你……你上哪儿找人来干这个？"

# game/Story03.rpy:5847
translate chinese akt3chapter5_1_520da0f1:

    # mc "We’ll send a small strike team."
    mc "我们派一支小型突击队。"

# game/Story03.rpy:5849
translate chinese akt3chapter5_1_2909dd39:

    # Fl "While the Syndicate and the Peacekeepers are focused on containing the Soulless..."
    Fl "趁辛迪加和维和部队专注遏制无魂者的时候……"

# game/Story03.rpy:5850
translate chinese akt3chapter5_1_2c242fe3:

    # Fl "The team, led by [mc] will head straight to the tower's core."
    Fl "由 [mc] 带领的队伍，会直插高塔核心。"

# game/Story03.rpy:5852
translate chinese akt3chapter5_1_8f8f1e13:

    # g "This whole plan is a death sentence!"
    g "这整个计划就是死刑判决！"

# game/Story03.rpy:5853
translate chinese akt3chapter5_1_2cff9a14:

    # gg "Who the hell would agree to join a suicide squad?"
    gg "谁会答应加入自杀小队？"

# game/Story03.rpy:5856
translate chinese akt3chapter5_1_2b35b6fe_4:

    # mc "..."
    mc "……"

# game/Story03.rpy:5859
translate chinese akt3chapter5_1_b0787021:

    # mc "You have one choice: stay here… or fight."
    mc "你们只有一个选择：留在这儿……还是打。"

# game/Story03.rpy:5862
translate chinese akt3chapter5_1_ec129253:

    # mc "I’m not going to sit around."
    mc "我不会干坐着。"

# game/Story03.rpy:5863
translate chinese akt3chapter5_1_a600edea:

    # mc "I’m going."
    mc "我去。"

# game/Story03.rpy:5865
translate chinese akt3chapter5_1_7d1f3def:

    # mc "Alone, if I have to."
    mc "没人跟，我也一个人去。"

# game/Story03.rpy:5867
translate chinese akt3chapter5_1_0061b368_4:

    # ggg "..."
    ggg "……"

# game/Story03.rpy:5869
translate chinese akt3chapter5_1_f98f0dcf:

    # mc "(So… No one?)"
    mc "（所以……没人？）"

# game/Story03.rpy:5871
translate chinese akt3chapter5_1_0061b368_5:

    # ggg "..."
    ggg "……"

# game/Story03.rpy:5873
translate chinese akt3chapter5_1_2c1640cb:

    # mc "(Whispering) No choice..."
    mc "（低声）没得选……"

# game/Story03.rpy:5880
translate chinese akt3chapter5_1_c99e07f7:

    # L "Without me, you won’t stand a chance."
    L "没我，你一点机会都没有。"

# game/Story03.rpy:5882
translate chinese akt3chapter5_1_11cf044b:

    # mc "Time to make up for lost time, right?"
    mc "该把失去的时间补回来了，对吧？"

# game/Story03.rpy:5884
translate chinese akt3chapter5_1_2b35b6fe_5:

    # mc "..."
    mc "……"

# game/Story03.rpy:5886
translate chinese akt3chapter5_1_f613659c:

    # mc "Anyone else?"
    mc "还有谁？"

# game/Story03.rpy:5889
translate chinese akt3chapter5_1_1da63c9b:

    # Mi "I’m in."
    Mi "我加入。"

# game/Story03.rpy:5892
translate chinese akt3chapter5_1_556c194f:

    # el "What are you doing, you idiot?!"
    el "你干什么，你这白痴？！"

# game/Story03.rpy:5894
translate chinese akt3chapter5_1_da3fdbf1:

    # Mi "..."
    Mi "……"

# game/Story03.rpy:5897
translate chinese akt3chapter5_1_9b5e828e:

    # h "Like I’d let you go alone."
    h "我怎么可能让你一个人去。"

# game/Story03.rpy:5900
translate chinese akt3chapter5_1_3afe9822:

    # k "Let you two have all the fun? Not a chance."
    k "让你们俩独占乐子？想都别想。"

# game/Story03.rpy:5902
translate chinese akt3chapter5_1_bb8e4b4e_8:

    # a "..."
    a "……"

# game/Story03.rpy:5906
translate chinese akt3chapter5_1_bb8e4b4e_9:

    # a "..."
    a "……"

# game/Story03.rpy:5909
translate chinese akt3chapter5_1_060ab042:

    # ggg "Fuck it. Better than waiting."
    ggg "去他的。总比干等强。"

# game/Story03.rpy:5912
translate chinese akt3chapter5_1_4b340443:

    # g "..."
    g "……"

# game/Story03.rpy:5913
translate chinese akt3chapter5_1_b0ba6e55:

    # gg "What the hell are you doing?!"
    gg "你他妈干什么？！"

# game/Story03.rpy:5915
translate chinese akt3chapter5_1_0b7d5e38:

    # g "...Damn it. After a speech like that... I just can’t stay behind."
    g "……该死。听完那种话……我实在没法留下。"

# game/Story03.rpy:5916
translate chinese akt3chapter5_1_a2866d2b:

    # gg "But it’s suici—"
    gg "可那是自——"

# game/Story03.rpy:5917
translate chinese akt3chapter5_1_66158ff4:

    # g "I’d rather die with a gun, than under their boots in some filthy hole."
    g "我宁愿拿着枪死，也不愿在哪个脏坑里被他们踩在靴子下。"

# game/Story03.rpy:5922
translate chinese akt3chapter5_1_4f655c15:

    # gg "Yeah? Screw it then, I’m in too!"
    gg "是吗？那去他的，我也加入！"

# game/Story03.rpy:5950
translate chinese akt3chapter5_2_397c4916:

    # aa "The view from up here suits you, lady Astoria."
    aa "这上面的景色挺配你，阿斯托里亚夫人。"

# game/Story03.rpy:5951
translate chinese akt3chapter5_2_2625fddd:

    # aa "Almost imperial, grand, with just a hint of mass grave."
    aa "几乎有点帝王气象，宏伟，还带着一丝万人坑的味道。"

# game/Story03.rpy:5953
translate chinese akt3chapter5_2_1c8acf17:

    # am "..."
    am "……"

# game/Story03.rpy:5954
translate chinese akt3chapter5_2_03d73107:

    # aa "Still playing statue?"
    aa "还在装雕像？"

# game/Story03.rpy:5956
translate chinese akt3chapter5_2_35dffb23:

    # sel "Leave her."
    sel "别管她。"

# game/Story03.rpy:5958
translate chinese akt3chapter5_2_4b624790:

    # aa "..."
    aa "……"

# game/Story03.rpy:5961
translate chinese akt3chapter5_2_5cf519eb:

    # aa "Yes, my queen."
    aa "是，我的女王。"

# game/Story03.rpy:5964
translate chinese akt3chapter5_2_08384062:

    # am "How long do you plan to drag out this opera you call 'liberation'?"
    am "你打算把你那出叫“解放”的歌剧拖多久？"

# game/Story03.rpy:5967
translate chinese akt3chapter5_2_7a92fef3:

    # sel "Don’t worry. This will end soon enough."
    sel "别急。很快就会结束。"

# game/Story03.rpy:5968
translate chinese akt3chapter5_2_8ebdca62:

    # sel "Though abandoning your own people…"
    sel "不过，抛下你自己的人……"

# game/Story03.rpy:5970
translate chinese akt3chapter5_2_86694098:

    # am "Not betrayal."
    am "不是背叛。"

# game/Story03.rpy:5972
translate chinese akt3chapter5_2_666ff92b:

    # sel "Is that what you call it?"
    sel "你是这么叫的？"

# game/Story03.rpy:5974
translate chinese akt3chapter5_2_18b55e4f:

    # am "Mercy."
    am "是慈悲。"

# game/Story03.rpy:5975
translate chinese akt3chapter5_2_964f8ad9:

    # am "A smaller grave than the one she would make of the world."
    am "比起她要把整个世界变成的坟场，这算小坟。"

# game/Story03.rpy:5980
translate chinese akt3chapter5_2_5935d0ed:

    # sel "If that comforts you… keep it."
    sel "要是那能安慰你……就留着吧。"

# game/Story03.rpy:5981
translate chinese akt3chapter5_2_a67525ab:

    # sel "Judgment was never my role."
    sel "审判从来不是我的角色。"

# game/Story03.rpy:5983
translate chinese akt3chapter5_2_1a5bc27a:

    # am "Emotion is weakness."
    am "情感就是软弱。"

# game/Story03.rpy:5984
translate chinese akt3chapter5_2_4ef316d7:

    # am "And you’ve surrendered to it."
    am "而你向它投降了。"

# game/Story03.rpy:5986
translate chinese akt3chapter5_2_1afa2acd:

    # sel "Then why do you still want her back?"
    sel "那你为什么还想把她弄回来？"

# game/Story03.rpy:5990
translate chinese akt3chapter5_2_624c47f0:

    # am "So I can finally be done with this."
    am "这样我才能终于了结这一切。"

# game/Story03.rpy:5992
translate chinese akt3chapter5_2_095d5754:

    # sel "We’re not as different as you pretend."
    sel "我们没你装出来的那么不同。"

# game/Story03.rpy:5998
translate chinese akt3chapter5_2_b1f87fea:

    # am "You still confuse desire with purpose."
    am "你还是分不清欲望和目的。"

# game/Story03.rpy:6000
translate chinese akt3chapter5_2_41973757:

    # sel "Perhaps."
    sel "也许吧。"

# game/Story03.rpy:6003
translate chinese akt3chapter5_2_c22a4cd3:

    # am "I don’t tolerate uncertainty."
    am "我不容忍不确定。"

# game/Story03.rpy:6008
