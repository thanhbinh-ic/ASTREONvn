    # L "...What are you two doing?"
    L "……你们俩在干嘛？"

# game/Story03.rpy:4951
translate chinese akt3chapter4_4851f5a4:

    # Fl "Talking."
    Fl "说话。"

# game/Story03.rpy:4953
translate chinese akt3chapter4_76d8f649:

    # mc "(Of all possible moments... she had to walk in now.)"
    mc "（偏偏是这个时候……她非得现在进来。）"

# game/Story03.rpy:4961
translate chinese akt3chapter4_9993b94e:

    # L "..."
    L "……"

# game/Story03.rpy:4963
translate chinese akt3chapter4_d5fd2eaf:

    # L "...What are you doing?"
    L "……你在干什么？"

# game/Story03.rpy:4965
translate chinese akt3chapter4_a398643d:

    # mc "Muscle memory."
    mc "肌肉记忆。"

# game/Story03.rpy:4967
translate chinese akt3chapter4_49ec1ce5:

    # L "...Let go."
    L "……放开。"

# game/Story03.rpy:4969
translate chinese akt3chapter4_5e2cb588:

    # mc "(Normally she'd already be furious.)"
    mc "（换平时她早该发火了。）"

# game/Story03.rpy:4973
translate chinese akt3chapter4_a22e8f5a:

    # mc "(But now...)"
    mc "（可现在……）"

# game/Story03.rpy:4979
translate chinese akt3chapter4_6651ab87:

    # mc "Alright."
    mc "行。"

# game/Story03.rpy:4980
translate chinese akt3chapter4_542c2412:

    # mc "Someone want to explain what exactly is happening here?"
    mc "谁给我解释一下，这儿到底怎么回事？"

# game/Story03.rpy:4982
translate chinese akt3chapter4_f190b946:

    # L "(whispers) I came to talk, but..."
    L "（低声）我是来说话的，可是……"

# game/Story03.rpy:4984
translate chinese akt3chapter4_190ab1a1:

    # Fl "Nothing you need to worry about."
    Fl "没什么你需要操心的。"

# game/Story03.rpy:4987
translate chinese akt3chapter4_e3834ec7:

    # L "(whispers) I know."
    L "（低声）我知道。"

# game/Story03.rpy:4990
translate chinese akt3chapter4_9993b94e_1:

    # L "..."
    L "……"

# game/Story03.rpy:4999
translate chinese akt3chapter4_8b9ee863:

    # mc "Enough."
    mc "够了。"

# game/Story03.rpy:5006
translate chinese akt3chapter4_4245de2c:

    # mc "So what the hell was that?"
    mc "那到底他妈是怎么回事？"

# game/Story03.rpy:5011
translate chinese akt3chapter4_cea723ef:

    # mc "I asked a question."
    mc "我问了问题。"

# game/Story03.rpy:5013
translate chinese akt3chapter4_e943d1ed:

    # L "I..."
    L "我……"

# game/Story03.rpy:5015
translate chinese akt3chapter4_ab473ab9:

    # Fl "Right."
    Fl "行。"

# game/Story03.rpy:5022
translate chinese akt3chapter4_bfa9d6fa:

    # mc "I’m getting real tired of this shit."
    mc "这套破事我真受够了。"

# game/Story03.rpy:5024
translate chinese akt3chapter4_2713488d:

    # mc "This is getting old."
    mc "这招已经不新鲜了。"

# game/Story03.rpy:5026
translate chinese akt3chapter4_3faf49fd:

    # mc "Either talk straight."
    mc "要么直说。"

# game/Story03.rpy:5027
translate chinese akt3chapter4_45367d3f:

    # mc "Or start acting normal."
    mc "要么开始正常点。"

# game/Story03.rpy:5030
translate chinese akt3chapter4_850ef128:

    # b "..."
    b "……"

# game/Story03.rpy:5033
translate chinese akt3chapter4_4d9ab87a:

    # Fl "Let’s just say..."
    Fl "这么说吧……"

# game/Story03.rpy:5035
translate chinese akt3chapter4_e1823a68:

    # Fl "we had a disagreement."
    Fl "我们有点分歧。"

# game/Story03.rpy:5037
translate chinese akt3chapter4_c42b05ac:

    # mc "And?"
    mc "然后？"

# game/Story03.rpy:5040
translate chinese akt3chapter4_49e7621f:

    # L "I said..."
    L "我说……"

# game/Story03.rpy:5041
translate chinese akt3chapter4_64288e43:

    # L "We need to find a way out."
    L "我们得找条出路。"

# game/Story03.rpy:5043
translate chinese akt3chapter4_9a5056f5:

    # Fl "And she refused to explain why."
    Fl "而她拒绝解释为什么。"

# game/Story03.rpy:5045
translate chinese akt3chapter4_a8aa0765:

    # L "And I’m not explaining why."
    L "而我不会解释为什么。"

# game/Story03.rpy:5050
translate chinese akt3chapter4_1c7d22c2:

    # mc "Problem with the plan?"
    mc "计划有问题？"

# game/Story03.rpy:5052
translate chinese akt3chapter4_8320dad3:

    # Fl "She keeps shooting it down."
    Fl "她一直在否它。"

# game/Story03.rpy:5053
translate chinese akt3chapter4_7efe5a63:

    # Fl "Hard."
    Fl "否得死死的。"

# game/Story03.rpy:5054
translate chinese akt3chapter4_3fbb6973:

    # Fl "...and yeah."
    Fl "……而且是的。"

# game/Story03.rpy:5055
translate chinese akt3chapter4_c0299f55:

    # Fl "I might’ve said a few things."
    Fl "我可能说了几句难听的。"

# game/Story03.rpy:5057
translate chinese akt3chapter4_9993b94e_2:

    # L "..."
    L "……"

# game/Story03.rpy:5059
translate chinese akt3chapter4_be250528:

    # mc "One question."
    mc "一个问题。"

# game/Story03.rpy:5060
translate chinese akt3chapter4_2876efd9:

    # mc "Why?"
    mc "为什么？"

# game/Story03.rpy:5062
translate chinese akt3chapter4_e943d1ed_1:

    # L "I..."
    L "我……"

# game/Story03.rpy:5064
translate chinese akt3chapter4_28c618d2:

    # L "We won’t make it."
    L "我们撑不过去。"

# game/Story03.rpy:5065
translate chinese akt3chapter4_c9ec8556:

    # L "You all die."
    L "你们全都会死。"

# game/Story03.rpy:5067
translate chinese akt3chapter4_368910a2:

    # Fl "Oh, so now you're a prophet?"
    Fl "哦，现在你成先知了？"

# game/Story03.rpy:5068
translate chinese akt3chapter4_2ab1ebac:

    # Fl "That’s cute."
    Fl "真可爱。"

# game/Story03.rpy:5070
translate chinese akt3chapter4_442776c8:

    # Fl "See, [mc]? She’s not even trying to—"
    Fl "看见没，[mc]？她连试着——"

# game/Story03.rpy:5071
translate chinese akt3chapter4_2b35b6fe_3:

    # mc "..."
    mc "……"

# game/Story03.rpy:5072
translate chinese akt3chapter4_b268db7b:

    # Fl "[mc]?"
    Fl "[mc]？"

# game/Story03.rpy:5073
translate chinese akt3chapter4_fbc7d4cb:

    # mc "You’re desperate."
    mc "你是走投无路了。"

# game/Story03.rpy:5075
translate chinese akt3chapter4_ddcd6a1f:

    # L "...Yes."
    L "……是。"

# game/Story03.rpy:5077
translate chinese akt3chapter4_77970c33:

    # Fl "What are you talk-"
    Fl "你在说什——"

# game/Story03.rpy:5079
translate chinese akt3chapter4_fb7ac99a:

    # mc "She knows what’s coming."
    mc "她知道要发生什么。"

# game/Story03.rpy:5081
translate chinese akt3chapter4_3bb43600_1:

    # Fl "...What?"
    Fl "……什么？"

# game/Story03.rpy:5083
translate chinese akt3chapter4_64754ce1:

    # L "I don’t see the path."
    L "我看不见路。"

# game/Story03.rpy:5084
translate chinese akt3chapter4_b9686f2b:

    # L "Only the outcome."
    L "只看得见结果。"

# game/Story03.rpy:5086
translate chinese akt3chapter4_7ab45580:

    # Fl "You’ve got to be joking..."
    Fl "你开玩笑吧……"

# game/Story03.rpy:5093
translate chinese akt3chapter4_971d2cd2:

    # L "(whispers) I guess I don’t have a choice anymore..."
    L "（低声）看来我已经没得选了……"

# game/Story03.rpy:5098
translate chinese akt3chapter4_cfff6d08:

    # L "There’s a story."
    L "有个传说。"

# game/Story03.rpy:5099
translate chinese akt3chapter4_c8655f59:

    # L "About immortality."
    L "关于永生的。"

# game/Story03.rpy:5100
translate chinese akt3chapter4_ec04ce5f:

    # L "They say… whoever passes through the gate, comes back."
    L "他们说……穿过那道门的人，会回来。"

# game/Story03.rpy:5102
translate chinese akt3chapter4_7ec6c53b:

    # Fl "Immortality?"
    Fl "永生？"

# game/Story03.rpy:5103
translate chinese akt3chapter4_613c3cb2:

    # Fl "...and you actually believe that?"
    Fl "……你居然真信这个？"

# game/Story03.rpy:5108
translate chinese akt3chapter4_9993b94e_3:

    # L "..."
    L "……"

# game/Story03.rpy:5110
translate chinese akt3chapter4_109280b3:

    # L "Yes."
    L "信。"

# game/Story03.rpy:5112
translate chinese akt3chapter4_fca52711:

    # mc "No."
    mc "不。"

# game/Story03.rpy:5113
translate chinese akt3chapter4_87c06655:

    # mc "That doesn’t sound like you."
    mc "这不像你说的话。"

# game/Story03.rpy:5114
translate chinese akt3chapter4_fcde0016:

    # mc "Not without proof."
    mc "没有证据，你不会这么说。"

# game/Story03.rpy:5116
translate chinese akt3chapter4_9993b94e_4:

    # L "..."
    L "……"

# game/Story03.rpy:5118
translate chinese akt3chapter4_4d425600:

    # Fl "That’s insane—"
    Fl "这太荒唐了——"

# game/Story03.rpy:5120
translate chinese akt3chapter4_49274452:

    # Fl "No, that’s not how this works."
    Fl "不，事情不该是这么运作的。"

# game/Story03.rpy:5123
translate chinese akt3chapter4_d4a2608b:

    # Fl "...Don’t look at me like that."
    Fl "……别那样看我。"

# game/Story03.rpy:5124
translate chinese akt3chapter4_aefe54cf:

    # Fl "Like I’m supposed to have an answer."
    Fl "好像我该有答案似的。"

# game/Story03.rpy:5125
translate chinese akt3chapter4_2b35b6fe_4:

    # mc "..."
    mc "……"

# game/Story03.rpy:5127
translate chinese akt3chapter4_0d059c5a:

    # mc "And you did nothing?"
    mc "而你什么都没做？"

