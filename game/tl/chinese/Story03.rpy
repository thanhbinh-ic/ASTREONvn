# game/Story03.rpy:9238
translate chinese next_kalestra_meeting_c3b40072:

    # k "Yeah."
    k "是啊。"

# game/Story03.rpy:9240
translate chinese next_kalestra_meeting_bba36f61:

    # y "There are too many eyes here. From now on you go without me."
    y "这儿眼睛太多。从现在起，你们自己去，别带上我。"

# game/Story03.rpy:9242
translate chinese next_kalestra_meeting_8a2139c9:

    # mc "What? On what grounds?"
    mc "什么？凭什么？"

# game/Story03.rpy:9244
translate chinese next_kalestra_meeting_f59c48fd:

    # y "If most people see me — there'll be a panic."
    y "要是大多数人看见我——会引起恐慌。"

# game/Story03.rpy:9248
translate chinese next_kalestra_meeting_3a2be0b0:

    # mc "At the sight of those two it will start anyway."
    mc "光看见那两位，恐慌也照样会起。"

# game/Story03.rpy:9251
translate chinese next_kalestra_meeting_649d5d6a:

    # y "No. That's too big a risk. I can't."
    y "不行。风险太大。我不能。"

# game/Story03.rpy:9254
translate chinese next_kalestra_meeting_0f4cd710:

    # mc "But—"
    mc "可是——"

# game/Story03.rpy:9257
translate chinese next_kalestra_meeting_33687d89:

    # y "No. Final answer."
    y "不行。最终答复。"

# game/Story03.rpy:9259
translate chinese next_kalestra_meeting_3c1a6bfc:

    # mc "Again dumping your work on others?"
    mc "又把自己的活儿甩给别人？"

# game/Story03.rpy:9263
translate chinese next_kalestra_meeting_507d7806:

    # Mi "Cut it out, [mc]."
    Mi "别这样，[mc]。"

# game/Story03.rpy:9266
translate chinese next_kalestra_meeting_dc9df4a5:

    # mc "A straight answer. No excuses."
    mc "给我个直截了当的答复。别找借口。"

# game/Story03.rpy:9273
translate chinese next_kalestra_meeting_2b35b6fe_4:

    # mc "..."
    mc "……"

# game/Story03.rpy:9275
translate chinese next_kalestra_meeting_71a86863_1:

    # y "..."
    y "……"

# game/Story03.rpy:9278
translate chinese next_kalestra_meeting_643f0fd5:

    # y "Ember. If they learn I'm here, it'll cause big problems."
    y "恩伯。要是他们知道我在，会出大麻烦。"

# game/Story03.rpy:9280
translate chinese next_kalestra_meeting_51b804f5:

    # mc "Something I should know?"
    mc "有什么我该知道的事？"

# game/Story03.rpy:9282
translate chinese next_kalestra_meeting_5878613e:

    # k "Besides the fact he killed her father? Nope, nothing."
    k "除了他杀了她父亲这件事？没了，没什么。"

# game/Story03.rpy:9285
translate chinese next_kalestra_meeting_24cd75e4:

    # mc "(This is getting worse by the minute. Where am I supposed to find the patience and strength for all this...)"
    mc "（这事一分钟比一分钟糟。我上哪儿找这么多耐心和力气……）"

# game/Story03.rpy:9286
translate chinese next_kalestra_meeting_7329681e_1:

    # E "..."
    E "……"

# game/Story03.rpy:9288
translate chinese next_kalestra_meeting_1b6eed03:

    # mc "Alright. If this goes sideways, it’s on you."
    mc "行。这事要出了岔子，算你的。"

# game/Story03.rpy:9291
translate chinese next_kalestra_meeting_4820f22e:

    # mc "How do we get back to Winter after this?"
    mc "这之后我们怎么回到温特那儿？"

# game/Story03.rpy:9293
translate chinese next_kalestra_meeting_98e64a2e:

    # y "I'll take care of that."
    y "这个我来处理。"

# game/Story03.rpy:9295
translate chinese next_kalestra_meeting_50d97a1f:

    # y "You... know the plan."
    y "你们……知道计划。"

# game/Story03.rpy:9297
translate chinese next_kalestra_meeting_9af136ea:

    # k "Yes, yes."
    k "知道，知道。"

# game/Story03.rpy:9299
translate chinese next_kalestra_meeting_e4751b94:

    # mc "Plan? You left us in the dark again?"
    mc "计划？你们又把我们蒙在鼓里？"

# game/Story03.rpy:9302
translate chinese next_kalestra_meeting_57150731:

    # y "Your task is Flora. Leave the rest to them."
    y "你们的任务是弗洛拉。剩下的交给她们。"

# game/Story03.rpy:9305
translate chinese next_kalestra_meeting_342e4b8c:

    # y "Miriel and Ivy will take you to her."
    y "米莉尔和艾薇会带你们去找她。"

# game/Story03.rpy:9307
translate chinese next_kalestra_meeting_5cf1faeb:

    # mc "And you?"
    mc "那你呢？"

# game/Story03.rpy:9309
translate chinese next_kalestra_meeting_bab2226f:

    # y "Reconnaissance."
    y "侦察。"

# game/Story03.rpy:9314
translate chinese next_kalestra_meeting_2c6a516f:

    # mc "I don't like this setup."
    mc "我不喜欢这个安排。"

# game/Story03.rpy:9316
translate chinese next_kalestra_meeting_589631f8:

    # mc "We go after Flora. You do your part."
    mc "我们去找弗洛拉。你做你那部分。"

# game/Story03.rpy:9319
translate chinese next_kalestra_meeting_b95525da:

    # mc "Whatever that means..."
    mc "不管那是什么意思……"

# game/Story03.rpy:9334
translate chinese next_kalestra_meeting_1075bb0f:

    # mc "Of all the routes, why did they pick this one for us?"
    mc "这么多条路，他们为什么偏偏给我们挑了这条？"

# game/Story03.rpy:9336
translate chinese next_kalestra_meeting_fe90e581:

    # Mi "Because it's the shortest. Even if it's not the nicest."
    Mi "因为这条最短。虽然不算最好走。"

# game/Story03.rpy:9339
translate chinese next_kalestra_meeting_f6128463:

    # mc "(Shortest route, huh... so we get to walk a tightrope of rotten beams. Lovely.)"
    mc "（最短的路，是吧……所以我们得在烂梁上走钢丝。好极了。）"

# game/Story03.rpy:9340
translate chinese next_kalestra_meeting_88a7b044:

    # mc "How much farther?"
    mc "还有多远？"

# game/Story03.rpy:9344
translate chinese next_kalestra_meeting_54a7b417:

    # Mi "We're almost there. Hang on a bit."
    Mi "快到了。再撑一会儿。"

# game/Story03.rpy:9347
translate chinese next_kalestra_meeting_d17d8bd7:

    # mc "Ivy?"
    mc "艾薇？"

# game/Story03.rpy:9348
translate chinese next_kalestra_meeting_4cd9e9d3:

    # i "Yes?"
    i "嗯？"

# game/Story03.rpy:9349
translate chinese next_kalestra_meeting_ae951c04:

    # mc "What's your angle here? What are you doing with us?"
    mc "你打的什么算盘？跟着我们干什么？"

# game/Story03.rpy:9352
translate chinese next_kalestra_meeting_fb84bdd5:

    # i "Hm? I'm… here to help."
    i "嗯？我……是来帮忙的。"

# game/Story03.rpy:9355
translate chinese next_kalestra_meeting_5e44a000:

    # mc "Right..."
    mc "是啊……"

# game/Story03.rpy:9359
translate chinese next_kalestra_meeting_3d8514ec:

    # i "No, I'm not a— a kept woman!"
    i "不，我不是——不是被包养的女人！"

# game/Story03.rpy:9361
translate chinese next_kalestra_meeting_01195881:

    # mc "I didn't say that."
    mc "我没那么说。"

# game/Story03.rpy:9376
translate chinese next_kalestra_meeting_adaf68f0:

    # i "Could’ve fooled me, looking at you."
    i "就你那表情，我还真以为你那么想了。"

# game/Story03.rpy:9377
translate chinese next_kalestra_meeting_675f3255:

    # i "My job is support… and a bit of tech."
    i "我的活是支援……还管点技术。"

# game/Story03.rpy:9380
translate chinese next_kalestra_meeting_073a8ea8:

    # mc "Wait, wait, so you're an engineer?"
    mc "等等，等等，所以你是工程师？"

# game/Story03.rpy:9382
translate chinese next_kalestra_meeting_a73905fa:

    # i "Well, something like that, yeah."
    i "嗯，差不多吧。"

# game/Story03.rpy:9384
translate chinese next_kalestra_meeting_032effea:

    # mc "(Technical work? Fine, I'll buy that. Hope it's true.)"
    mc "（技术活？行，我信了。希望是真的。）"

# game/Story03.rpy:9385
translate chinese next_kalestra_meeting_7e602632:

    # mc "Hard to believe you’d need to sleep with men just to do your job."
    mc "很难相信你干这活还得跟男人上床。"

# game/Story03.rpy:9388
translate chinese next_kalestra_meeting_79e659b5:

    # i "I was needed, not for that reason!"
    i "他们需要我，不是因为那个！"

# game/Story03.rpy:9391
translate chinese next_kalestra_meeting_f89336b9:

    # mc "Then why the club? What's the real reason you worked there?"
    mc "那为什么去那家夜店？你真正的原因是什么？"

# game/Story03.rpy:9402
translate chinese next_kalestra_meeting_98666b20:

    # i "Not what you're thinking. Time together — nothing more."
    i "不是你想的那样。就是陪着待一会儿——没别的。"

# game/Story03.rpy:9405
translate chinese next_kalestra_meeting_28126d10:

    # i "It's just, with lecherous men it's easier to steal information..."
    i "只是，对付好色的男人，偷情报更容易……"

# game/Story03.rpy:9407
translate chinese next_kalestra_meeting_2d6986e2:

    # mc "Hold on… you really spent time with men for advantage?"
    mc "等等……你真为了套好处去陪男人？"

    # game/Story03.rpy:9409
translate chinese next_kalestra_meeting_fe61266b:

    # mc "And slept with them for the same reason..."
    mc "顺便还跟他们睡，也是同一个原因……"

# game/Story03.rpy:9412
translate chinese next_kalestra_meeting_9e97f505:

    # i "No! I'll repeat — I do NOT sleep with men! We JUST spent time together."
    i "不！我再说一遍——我不跟男人上床！我们只是待在一起。"

# game/Story03.rpy:9416
translate chinese next_kalestra_meeting_5b910c3f:

    # Mi "She's basically like... a companion. An escort for an hour."
    Mi "她基本上就是……陪聊。陪一个小时。"

# game/Story03.rpy:9418
translate chinese next_kalestra_meeting_da3fdbf1:

    # Mi "..."
    Mi "……"

# game/Story03.rpy:9420
translate chinese next_kalestra_meeting_03cfce52:

    # Mi "But without intimacy."
    Mi "但没有亲密接触。"

# game/Story03.rpy:9424
translate chinese next_kalestra_meeting_6504f99b:

    # i "No intimacy!"
    i "没有亲密接触！"

# game/Story03.rpy:9426
translate chinese next_kalestra_meeting_a14d85ad:

    # mc "Alright. Still — why did those bastards beat you?"
    mc "行。不过——那些混蛋为什么打你？"

# game/Story03.rpy:9429
translate chinese next_kalestra_meeting_d14eadc8:

    # i "Forgot already? We're elves — people hate us."
    i "这就忘了？我们是精灵——人们恨我们。"

# game/Story03.rpy:9432
translate chinese next_kalestra_meeting_a7253cbd:

    # mc "I haven't seen that level of open hate around here lately."
    mc "最近这儿我可没见着这种程度的公开仇视。"

# game/Story03.rpy:9439
translate chinese next_kalestra_meeting_4c7bcab4:

    # Mi "Right now they're more afraid of dying than of hating us. If not for the threat, things would be as before."
    Mi "眼下他们怕死多过恨我们。要不是有这威胁，一切还会跟从前一样。"

# game/Story03.rpy:9442
translate chinese next_kalestra_meeting_701ac947:

    # Mi "Anyway, we're above Flora. Time to go down."
    Mi "总之，我们到弗洛拉上方了。该下去了。"

# game/Story03.rpy:9444
translate chinese next_kalestra_meeting_9c771a86:

    # mc "Okay. What's the plan? How do we get down?"
    mc "好。计划是什么？怎么下去？"

# game/Story03.rpy:9446
translate chinese next_kalestra_meeting_dfa8a629:

    # Mi "We're going to jump."
    Mi "我们跳下去。"

# game/Story03.rpy:9448
translate chinese next_kalestra_meeting_d2ff1f2b:

    # mc "Wait… ju—"
    mc "等等……跳——"

# game/Story03.rpy:9450
translate chinese next_kalestra_meeting_824a1dba:

    # mc "Jump?!"
    mc "跳？！"

# game/Story03.rpy:9456
translate chinese next_kalestra_meeting_99ea45da:

    # mc "From these beams? I'm not ready—"
    mc "从这些横梁上？我还没准备——"

# game/Story03.rpy:9477
translate chinese act3_5chapter4_0a27a043:

    # Fl "Come on… just a little… a bit more…"
    Fl "来吧……就差一点……再一点……"

# game/Story03.rpy:9480
translate chinese act3_5chapter4_8d5a2fb9:

    # "Error."
    "错误。"

# game/Story03.rpy:9486
translate chinese act3_5chapter4_9d2180bd:

    # Fl "Damn code… Why does everything have to be so complicated?"
    Fl "该死的代码……为什么一切都非得这么复杂？"

# game/Story03.rpy:9489
translate chinese act3_5chapter4_2f41ddce:

    # Fl "(Whisper) Maybe I should just quit all this?"
    Fl "（低声）也许我该干脆撂挑子不干了？"

# game/Story03.rpy:9491
translate chinese act3_5chapter4_b0641398:

    # Fl "(Running away, getting as far from all this as possible… doesn't sound that bad.)"
    Fl "（跑掉，离这一切越远越好……听着也不算太坏。）"

# game/Story03.rpy:9495
translate chinese act3_5chapter4_4d4a91fb:

    # Fl "(No. I've gone too far with this already — no turning back.)"
    Fl "（不。我已经走得太远——回不了头了。）"

# game/Story03.rpy:9497
translate chinese act3_5chapter4_32e1ea3a:

    # Fl "(I'll dissect this world byte by byte if I have to.)"
    Fl "（必要的话，我就把这个世界的每一个字节都拆开来。）"

# game/Story03.rpy:9500
translate chinese act3_5chapter4_671e8e3b:

    # Fl "But it’s still so difficult!"
    Fl "可还是太难了！"

# game/Story03.rpy:9505
translate chinese act3_5chapter4_89f73046:

    # Fl "Alright, pull yourself together and move forward."
    Fl "行了，振作起来，往前走。"

# game/Story03.rpy:9509
translate chinese act3_5chapter4_61d1e261:

    # Fl "Attempt seventy-two — failure."
    Fl "第 72 次尝试——失败。"

# game/Story03.rpy:9512
translate chinese act3_5chapter4_58e32d11:

    # Fl "Looks like I'll have to try seventy-three…"
    Fl "看来得试第 73 次了……"

# game/Story03.rpy:9515
translate chinese act3_5chapter4_2b35b6fe:

    # mc "..."
    mc "……"

# game/Story03.rpy:9517
translate chinese act3_5chapter4_843a6b2e:

    # Fl "Ember? What's going on? Did something happen?"
    Fl "恩伯？怎么了？出什么事了？"

# game/Story03.rpy:9519
translate chinese act3_5chapter4_e60a7e8d:

    # mc "Save the theatrics for later, Flora. We don’t have that luxury right now."
    mc "戏留到以后演，弗洛拉。我们现在没那个余裕。"

# game/Story03.rpy:9520
translate chinese act3_5chapter4_852b4647:

    # Fl "(It can't be…)"
    Fl "（不可能……）"

# game/Story03.rpy:9525
translate chinese act3_5chapter4_dd64bc02:

    # Fl "[mc]? Are you serious? Since when do you just show up without warning?"
    Fl "[mc]？你说真的？你什么时候开始不打招呼就冒出来了？"

# game/Story03.rpy:9528
translate chinese act3_5chapter4_e31cdce6:

    # mc "You’re avoiding the question. Why?"
    mc "你在回避问题。为什么？"

# game/Story03.rpy:9530
translate chinese act3_5chapter4_46dc5859:

    # Fl "(Keep a straight face… don’t show that side of yourself.)"
    Fl "（绷住脸……别露出那一面。）"

# game/Story03.rpy:9533
translate chinese act3_5chapter4_333605a6:

    # Fl "You sound like the galaxy’s hanging by a thread again. Déjà vu, really."
    Fl "你这语气，好像整个星系又悬在一根线上了。真是既视感。"

# game/Story03.rpy:9535
translate chinese act3_5chapter4_1d8ce67e:

    # mc "(Breathe. Don’t raise your voice… not now.)"
    mc "（呼吸。别拔高嗓门……不是现在。）"

# game/Story03.rpy:9537
translate chinese act3_5chapter4_778079e9:

    # Fl "What, interrogating me? Or do you just like bossing people around?"
    Fl "怎么，审问我？还是你就喜欢对人发号施令？"

# game/Story03.rpy:9540
translate chinese act3_5chapter4_61b11b64:

    # mc "Please, Flora. Enough games."
    mc "拜托，弗洛拉。别玩花样了。"

# game/Story03.rpy:9543
translate chinese act3_5chapter4_f8495c19:

    # Fl "No! I’m not your reporting machine!"
    Fl "不！我不是你的报告生成器！"

# game/Story03.rpy:9545
translate chinese act3_5chapter4_c7116752:

    # mc "(This is starting to annoy me… why is she dodging the answer?)"
    mc "（这开始让我烦了……她为什么躲着不答？）"

# game/Story03.rpy:9548
translate chinese act3_5chapter4_63aeda98:

    # mc "(Don’t yell, [mc], don’t yell — keep it together.)"
    mc "（别吼，[mc]，别吼——稳住。）"

# game/Story03.rpy:9549
translate chinese act3_5chapter4_794a727c:

    # mc "Flora, please… stop this."
    mc "弗洛拉，求你……别这样了。"

# game/Story03.rpy:9555
translate chinese act3_5chapter4_61087bdf:

    # Fl "Interesting tactic — show up after everything and demand a report. You haven’t changed."
    Fl "有意思的套路——等一切都结束了才冒出来，还要报告。你没变。"

# game/Story03.rpy:9557
translate chinese act3_5chapter4_8d2484e7:

    # mc "I didn’t come here to argue. I came for answers."
    mc "我不是来吵架的。我是来要答案的。"

# game/Story03.rpy:9558
translate chinese act3_5chapter4_048bd42c:

    # mc "(No choice left… sorry.)"
    mc "（没别的办法了……抱歉。）"

# game/Story03.rpy:9561
translate chinese act3_5chapter4_5005863b:

    # Fl "You decided to raise—"
    Fl "你居然抬高——"

# game/Story03.rpy:9566
translate chinese act3_5chapter4_99e51102:

    # mc "Flora… just tell me straight. Please."
    mc "弗洛拉……直说吧。求你。"

# game/Story03.rpy:9567
translate chinese act3_5chapter4_621c87e0:

    # mc "(Breathe… don’t push her over the edge.)"
    mc "（呼吸……别把她逼到边上。）"

# game/Story03.rpy:9569
translate chinese act3_5chapter4_0f57326a:

    # mc "Did it fail?"
    mc "失败了？"

# game/Story03.rpy:9577
translate chinese act3_5chapter4_89b7c9ae:

    # Fl "You want the truth? The plan failed. Yes. Happy now?"
    Fl "你想听实话？计划失败了。对。满意了？"

# game/Story03.rpy:9578
translate chinese act3_5chapter4_fd58dfc9:

    # Fl "And on top of that, everyone blames me for the failure! Understand?!"
    Fl "而且除此之外，所有人都把失败怪到我头上！明白吗？！"

# game/Story03.rpy:9580
translate chinese act3_5chapter4_5fdf7d40:

    # Fl "As if it were my fault, not theirs."
    Fl "好像那是我的错，不是他们的。"

# game/Story03.rpy:9581
translate chinese act3_5chapter4_2b35b6fe_1:

    # mc "..."
    mc "……"

# game/Story03.rpy:9582
translate chinese act3_5chapter4_48ae0bf1:

    # Fl "And then you come and say you’ll help?! With what? Death?!"
    Fl "然后你来了，说你要帮忙？！帮什么？帮死吗？！"

# game/Story03.rpy:9585
translate chinese act3_5chapter4_6e9cf21c:

    # Fl "I didn’t ask for this… They dumped everything they could on me."
    Fl "我没求过这个……他们把能甩的都甩给我了。"

# game/Story03.rpy:9586
translate chinese act3_5chapter4_740fde20:

    # Fl "And even with all that, I did everything I could!"
    Fl "即便这样，我也尽了全力！"

# game/Story03.rpy:9588
translate chinese act3_5chapter4_b0eed018:

    # Fl "(Whisper) Worthless junk, not even able to figure out what’s on a normal flash drive."
    Fl "（低声）一堆没用的破烂，连个普通闪存里存了什么都没法弄明白。"

# game/Story03.rpy:9590
translate chinese act3_5chapter4_504482c1:

    # mc "...And they all pinned it on you."
    mc "……然后他们全推到你头上。"

# game/Story03.rpy:9592
translate chinese act3_5chapter4_945649de:

    # Fl "GET OUT!"
    Fl "出去！"

# game/Story03.rpy:9597
