    # L "Yeah, Lora — you're just awful."
    L "是啊，洛拉——你就是个烂人。"

# game/Story03.rpy:10389
translate chinese endof3_5chapter_49a8888a:

    # L "Let him hate me, let them despise me."
    L "让他恨我，让他们鄙视我。"

# game/Story03.rpy:10390
translate chinese endof3_5chapter_7728af51:

    # L "Let the whole world turn against me."
    L "让全世界与我为敌。"

# game/Story03.rpy:10395
translate chinese endof3_5chapter_72f2e7d2:

    # L "I won't let him die… not this time."
    L "我不会让他死……这次不会。"

