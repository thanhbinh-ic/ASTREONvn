translate chinese gate2_747c7043:

    # Fl "But people talk."
    Fl "但人们有传言。"

# game/Story01.rpy:7717
translate chinese gate2_f90cf75e:

    # Fl "They say those sectors hide tech way beyond our time."
    Fl "说那些区藏着远超我们时代的技术。"

# game/Story01.rpy:7719
translate chinese gate2_eaf58366:

    # mc "Tombs…"
    mc "陵墓……"

# game/Story01.rpy:7722
translate chinese gate2_cf27e7e9:

    # Fl "Now you get it."
    Fl "现在你懂了。"

# game/Story01.rpy:7724
translate chinese gate2_9a75f0ea:

    # Fl "But later."
    Fl "但以后再说。"

# game/Story01.rpy:7725
translate chinese gate2_deed242c:

    # Fl "Your team’s here."
    Fl "你的队伍到了。"

# game/Story01.rpy:7729
translate chinese gate2_463fa17b:

    # g "Our best shot is Sector 6, northeast gate."
    g "最好的机会是 6 区东北门。"

# game/Story01.rpy:7730
translate chinese gate2_d2ed5632:

    # g "There’s an underground passage there. That’s how we get out of the city."
    g "那儿有条地下通道。我们从那儿出城。"

