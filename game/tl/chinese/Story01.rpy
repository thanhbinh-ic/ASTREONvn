    # L "(whispering) Easy, sweetheart… don’t tense up."
    L "（低声）放松，宝贝……别绷着。"

# game/Story01.rpy:9029
translate chinese olivia_fr_scene_0b57ebdf:

    # L "Alright, sweetheart— we’re curious."
    L "好了，宝贝——我们很好奇。"

# game/Story01.rpy:9030
translate chinese olivia_fr_scene_71b85ce8:

    # L "What do you think?"
    L "你觉得怎么样？"

# game/Story01.rpy:9032
translate chinese olivia_fr_scene_4a45fc66:

    # h "I… how much do I need to pay for this?"
    h "我……这要付多少钱？"

