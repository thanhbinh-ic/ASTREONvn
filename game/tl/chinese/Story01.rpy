translate chinese path_second_up_3_3_d8595d8d:

    # g "Shit! Reloading!"
    g "操！换弹！"

# game/Story01.rpy:7212
translate chinese path_second_up_3_3_e90d4bad:

    # gg "I’ve got you! Make it fast. I’m down to fumes myself!"
    gg "我掩护你！快点。我自己也快见底了！"

