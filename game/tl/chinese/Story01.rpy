    # mc "(What’s next…)"
    mc "（接下来呢……）"

# game/Story01.rpy:2154
translate chinese norman_1_2148a15a:

    # h "So this is where you—"
    h "原来你在这儿——"

# game/Story01.rpy:2155
translate chinese norman_1_7e06c1c3:

    # h "Hey!"
    h "嘿！"

# game/Story01.rpy:2159
translate chinese norman_1_d7672d6c:

    # h "You quit, remember?"
    h "你戒了，记得吗？"

# game/Story01.rpy:2161
translate chinese norman_1_2fded262:

    # h "..."
    h "……"

# game/Story01.rpy:2163
translate chinese norman_1_2b35b6fe_1:

    # mc "..."
    mc "……"

# game/Story01.rpy:2168
translate chinese norman_1_8172d7a0:

    # h "Alright. Talk."
    h "好。说吧。"

# game/Story01.rpy:2169
translate chinese norman_1_68c7d64f:

    # h "What happened?"
    h "发生什么了？"

# game/Story01.rpy:2171
translate chinese norman_1_9d83a8e2:

    # mc "What are you doing here?"
    mc "你来这儿干嘛？"

# game/Story01.rpy:2173
translate chinese norman_1_a41ea71d:

    # h "I was looking for you."
    h "我在找你。"

# game/Story01.rpy:2174
translate chinese norman_1_77d2088f:

    # h "You disappeared after that meeting like you fell off the map."
    h "那次会面后你就消失了，像从地图上掉下去一样。"

# game/Story01.rpy:2175
translate chinese norman_1_80812851:

    # h "I tore half the place apart before I found you…"
    h "我找遍了半个地方才找到你……"

# game/Story01.rpy:2176
translate chinese norman_1_d8b3f95b:

    # h "...brooding up here alone."
    h "……一个人在这儿闷着。"

# game/Story01.rpy:2178
translate chinese norman_1_4fe1d8ea:

    # h "So come on."
    h "所以，说吧。"

# game/Story01.rpy:2179
translate chinese norman_1_020d0497:

    # h "What’s eating you?"
    h "什么事让你这么难受？"

# game/Story01.rpy:2187
translate chinese norman_1_faa0d2e2:

    # mc "Norman’s dead."
    mc "诺曼死了。"

# game/Story01.rpy:2188
translate chinese norman_1_2fded262_1:

    # h "..."
    h "……"

# game/Story01.rpy:2190
translate chinese norman_1_c3953189:

    # h "...I’m sorry."
    h "……对不起。"

# game/Story01.rpy:2192
translate chinese norman_1_322faffe:

    # mc "Why are you apologizing?"
    mc "你道什么歉？"

# game/Story01.rpy:2194
translate chinese norman_1_78070e9a:

    # h "If it wasn’t for me, he—"
    h "要不是我，他——"

# game/Story01.rpy:2202
translate chinese norman_1_e2b79e43:

    # mc "It’s not your fault."
    mc "不是你的错。"

# game/Story01.rpy:2203
translate chinese norman_1_91f7c169:

    # h "I can see it in your eyes—"
    h "我从你眼里看得出来——"

# game/Story01.rpy:2205
translate chinese norman_1_c2519fb4:

    # mc "(Enough.)"
    mc "（够了。）"

# game/Story01.rpy:2207
translate chinese norman_1_e6c7af28:

    # mc "(…I said I wouldn’t look away.)"
    mc "（……我说过不会再移开视线。）"

# game/Story01.rpy:2208
translate chinese norman_1_aad1870f:

    # mc "(So why can’t I let it go—)"
    mc "（那为什么我放不下——）"

# game/Story01.rpy:2209
translate chinese norman_1_b006b40c:

    # mc "(…No. Not now.)"
    mc "（……不。不是现在。）"

# game/Story01.rpy:2211
translate chinese norman_1_f2753b4b:

    # mc "Nice view, huh?"
    mc "景色不错，是吧？"

# game/Story01.rpy:2213
translate chinese norman_1_2fded262_2:

    # h "..."
    h "……"

# game/Story01.rpy:2215
translate chinese norman_1_daedd3b9:

    # h "...Yeah."
    h "……是啊。"

# game/Story01.rpy:2217
translate chinese norman_1_ba387ea6:

    # mc "(I’ve buried so many…)"
    mc "（我埋葬过太多人……）"

# game/Story01.rpy:2218
translate chinese norman_1_1b5f9528:

    # mc "(So why…)"
    mc "（那为什么……）"

# game/Story01.rpy:2221
translate chinese norman_1_541ca8e0:

    # mc "(Why can’t I let this go…?)"
    mc "（为什么我放不下这个……？）"

# game/Story01.rpy:2222
translate chinese norman_1_2fded262_3:

    # h "..."
    h "……"

# game/Story01.rpy:2224
translate chinese norman_1_a663d988:

    # mc "(No… get it together.)"
    mc "（不……振作起来。）"

# game/Story01.rpy:2228
translate chinese norman_1_983a8f23:

    # h "You did everything you could."
    h "你已经尽力了。"

# game/Story01.rpy:2231
translate chinese norman_1_e6116733:

    # h "And I’m pretty sure he wouldn’t want to see you like this."
    h "而且我敢肯定他不想看到你这样。"

# game/Story01.rpy:2232
translate chinese norman_1_2c6caaf2:

    # h "So stop."
    h "所以停下。"

# game/Story01.rpy:2233
translate chinese norman_1_29c67eee:

    # h "You hear me?"
    h "听见了吗？"

# game/Story01.rpy:2240
translate chinese norman_1_f1895a1f:

    # h "Stop blaming yourself."
    h "别再怪自己了。"

# game/Story01.rpy:2243
translate chinese norman_1_8970399d:

    # mc "…Thanks."
    mc "……谢谢。"

# game/Story01.rpy:2247
translate chinese norman_1_05595e69:

    # h "We’re a team."
    h "我们是一队的。"

# game/Story01.rpy:2248
translate chinese norman_1_e29caef6:

    # h "Remember?"
    h "记得吗？"

# game/Story01.rpy:2254
translate chinese norman_1_0faa46ad:

    # mc "Yeah…"
    mc "嗯……"

# game/Story01.rpy:2255
translate chinese norman_1_a29eeb8e:

    # mc "Grown man… and I’m falling apart."
    mc "一个大男人……还在这垮掉。"

# game/Story01.rpy:2257
translate chinese norman_1_db320b10:

    # h "So what?"
    h "那又怎样？"

# game/Story01.rpy:2258
translate chinese norman_1_8ab736c3:

    # h "Old man not allowed to fall apart now?"
    h "老头现在不许垮掉了？"

# game/Story01.rpy:2259
translate chinese norman_1_a1aa01a7:

    # h "That’s bullshit."
    h "扯淡。"

# game/Story01.rpy:2261
translate chinese norman_1_9715480f:

    # mc "...Old man, huh?"
    mc "……老头，是吧？"

# game/Story01.rpy:2263
translate chinese norman_1_9660975b:

    # h "Listen."
    h "听着。"

# game/Story01.rpy:2264
translate chinese norman_1_ed7cd83c:

    # h "If anyone ever tells you that crap…"
    h "要是有人跟你说这种屁话……"

# game/Story01.rpy:2265
translate chinese norman_1_0720b2fd:

    # h "Spit in their face."
    h "就往他脸上吐口水。"

# game/Story01.rpy:2266
translate chinese norman_1_9dd58a41:

    # h "Full force."
    h "用力吐。"

# game/Story01.rpy:2268
translate chinese norman_1_92f3ad8e:

    # mc "…I’ll remember that."
    mc "……我会记住。"

# game/Story01.rpy:2272
translate chinese norman_1_5695c6e6:

    # "Several minutes pass."
    "几分钟过去了。"

# game/Story01.rpy:2274
translate chinese norman_1_8e7c9998:

    # mc "(…Quieter.)"
    mc "（……安静点了。）"

# game/Story01.rpy:2276
translate chinese norman_1_3d5338ad:

    # mc "Liv?"
    mc "莉芙？"

# game/Story01.rpy:2277
translate chinese norman_1_b65bef1e:

    # h "Hm?"
    h "嗯？"

# game/Story01.rpy:2278
translate chinese norman_1_70492537:

    # mc "One of the beastmen wanted to see me."
    mc "有个兽人要见我。"

# game/Story01.rpy:2280
translate chinese norman_1_408c773c:

    # h "Beastman?"
    h "兽人？"

# game/Story01.rpy:2281
translate chinese norman_1_4f39ee7f:

    # mc "Ostorius. I think."
    mc "奥斯托里乌斯。大概。"

# game/Story01.rpy:2283
translate chinese norman_1_967e2b48:

    # mc "You know where I can find him?"
    mc "你知道我在哪能找到他？"

# game/Story01.rpy:2295
translate chinese norman_1_3497d313:

    # h "...Yeah, this looks like a torture room."
    h "……是啊，这看着像刑讯室。"

# game/Story01.rpy:2296
translate chinese norman_1_63cec8bf:

    # h "You sure we’re in the right place?"
    h "你确定我们来对地方了？"

# game/Story01.rpy:2297
translate chinese norman_1_4ebd1f86:

    # mc "You know any other implant labs?"
    mc "你知道别的植入体实验室吗？"

# game/Story01.rpy:2298
translate chinese norman_1_38d700df:

    # h "Didn’t think so."
    h "我也觉得你不知道。"

# game/Story01.rpy:2302
translate chinese norman_1_f7fc6c0a:

    # h "Alright… so why do you need him?"
    h "行……那你为什么需要他？"

# game/Story01.rpy:2303
translate chinese norman_1_6042806c:

    # h "Because of your eye?"
    h "因为你眼睛？"

# game/Story01.rpy:2304
translate chinese norman_1_75292096:

    # h "Speaking of, how bad is it?"
    h "说到这个，有多严重？"

# game/Story01.rpy:2308
translate chinese norman_1_ec3e61e8:

    # mc "I’ve had worse."
    mc "更糟的我都经历过。"

# game/Story01.rpy:2309
translate chinese norman_1_87e66eaa:

    # h "And the Lady?"
    h "那夫人呢？"

# game/Story01.rpy:2310
translate chinese norman_1_94a481bd:

    # h "What did she tell you?"
    h "她跟你说了什么？"

# game/Story01.rpy:2312
translate chinese norman_1_2d94626f:

    # mc "She knows about Lora."
    mc "她知道洛拉的事。"

# game/Story01.rpy:2313
translate chinese norman_1_2d4c9b41:

    # h "...Then we’re in the right place?"
    h "……那我们找对地方了？"

# game/Story01.rpy:2315
translate chinese norman_1_cf1adef2:

    # mc "Yeah."
    mc "嗯。"

# game/Story01.rpy:2317
translate chinese norman_1_9152dd62:

    # h "And… that’s it?"
    h "就……这些？"

# game/Story01.rpy:2319
translate chinese norman_1_59185cea:

    # mc "That’s all I’m sure of."
    mc "我只确定这些。"

# game/Story01.rpy:2320
translate chinese norman_1_dd6e471d:

    # mc "(Lora is alive. She worked in a tomb outside the city.)"
    mc "（洛拉还活着。她在城外的一座墓里工作。）"

# game/Story01.rpy:2321
translate chinese norman_1_488c3fc7:

    # mc "(If I want answers, I need access to those tombs—and someone who knows the routes.)"
    mc "（想要答案，我得进那些墓——还得找个认识路的人。）"

# game/Story01.rpy:2324
translate chinese norman_1_86d4ddc4:

    # mc "The rest… I’m not sure I can trust it."
    mc "其余的……我不确定能不能信。"

# game/Story01.rpy:2325
translate chinese norman_1_53c72467:

    # mc "(What the hell…)"
    mc "（什么鬼……）"

# game/Story01.rpy:2327
translate chinese norman_1_f893ec76:

    # ss "Authorizing..."
    ss "授权中……"

# game/Story01.rpy:2328
translate chinese norman_1_aade8fd6:

    # ss "Authorization successful."
    ss "授权成功。"

# game/Story01.rpy:2331
translate chinese norman_1_869266b3:

    # ss "What the hell are you doing here?"
    ss "你们他妈在这儿干嘛？"

# game/Story01.rpy:2332
translate chinese norman_1_6b7cbc35:

    # h "…Okay, what is that?"
    h "……好吧，那是什么？"

# game/Story01.rpy:2333
translate chinese norman_1_a16062ee:

    # mc "Ostorius… here?"
    mc "奥斯托里乌斯……在这儿？"

# game/Story01.rpy:2335
translate chinese norman_1_299a5061:

    # ss "Beep-beep. Visitors for Father? Please wait."
    ss "嘀嘀。有人拜访父亲？请稍等。"

# game/Story01.rpy:2336
translate chinese norman_1_f0b47ec1:

    # mc "(Father?..)"
    mc "（父亲？……）"

# game/Story01.rpy:2345
translate chinese norman_1_ad6040be:

    # Fl "Yo. Fluffy. What do you want?"
    Fl "哟。毛球。干嘛？"

# game/Story01.rpy:2346
translate chinese norman_1_f0204c7f:

    # ss "Flora! Two individuals have come to see Father."
    ss "弗洛拉！有两个人来见父亲。"

# game/Story01.rpy:2349
translate chinese norman_1_2a850784:

    # Fl "Huh? Guests? For father?"
    Fl "哈？客人？来找父亲的？"

# game/Story01.rpy:2350
translate chinese norman_1_c2250850:

    # ss "Yes! He didn’t mention anything, but I reviewed his report."
    ss "是的！他没提过，但我看了他的报告。"

# game/Story01.rpy:2352
translate chinese norman_1_71c31e6e:

    # ss "O-O-O-O1... System rebooting."
    ss "O-O-O-O1……系统重启中。"

# game/Story01.rpy:2356
translate chinese norman_1_f854b9f5:

    # o "Sweetheart, can you hear me? Come in, come in!"
    o "宝贝，能听见吗？回话，回话！"

# game/Story01.rpy:2360
translate chinese norman_1_9cdfc6c7:

    # o "I just caught a glimpse, looks like we’ve got guests. Can you believe that?"
    o "我刚瞄了一眼，好像有客人。你敢信？"

# game/Story01.rpy:2361
translate chinese norman_1_677ac816:

    # o "Be a dear and keep an eye on them for me, alright? They’re important."
    o "乖，帮我看着他们，好吗？他们很重要。"

# game/Story01.rpy:2365
translate chinese norman_1_a78ce26e:

    # Fl "What? No."
    Fl "什么？不。"

# game/Story01.rpy:2366
translate chinese norman_1_948de8da:

    # Fl "I’ve got classes, dad. And where are you?"
    Fl "我还有课，爸。你人在哪？"

# game/Story01.rpy:2369
translate chinese norman_1_69f4700d:

    # o "Ah, just dealing with the Inquisition. You know, routine stuff!"
    o "啊，就是应付审判庭。你知道的，例行公事！"

# game/Story01.rpy:2370
translate chinese norman_1_b211dfe9:

    # o "So I’m counting on my amazing, brilliant daughter, the best mechanic in the whole city!"
    o "所以我就指望我那了不起、聪明绝顶的女儿了，全城最好的机械师！"

# game/Story01.rpy:2371
translate chinese norman_1_256fb4c5:

    # o "Show them how things are done, yeah?"
    o "让他们见识见识怎么做事的，好吗？"

# game/Story01.rpy:2374
translate chinese norman_1_026eee08:

    # Fl "Fine. But you owe me. Big time."
    Fl "行。但你欠我的。欠大了。"

# game/Story01.rpy:2375
translate chinese norman_1_72446a07:

    # o "Oh, absolutely! Dinner, a day off, your call!"
    o "哦，那当然！晚饭、放假一天，随你挑！"

# game/Story01.rpy:2376
translate chinese norman_1_492c9d06:

    # o "Thanks, kiddo. You’re saving me again."
    o "谢了，孩子。你又救了我一次。"

# game/Story01.rpy:2378
translate chinese norman_1_7517bcdb:

    # mc "('Implant lab.' Right.)"
    mc "（‘植入体实验室’。是啊。）"

# game/Story01.rpy:2379
translate chinese norman_1_224254f2:

    # Fl "Hey, what are you standing around for? Get in."
    Fl "嘿，你们站那儿干嘛？进来。"

# game/Story01.rpy:2382
translate chinese norman_1_e6264cd7:

    # Fl "Well, well… look what walked in."
    Fl "哟，哟……看看谁进来了。"

# game/Story01.rpy:2383
translate chinese norman_1_be269df1:

    # h "Yeah, I’d take literally anywhere else over this."
    h "是啊，我宁愿待在任何别的地方。"

# game/Story01.rpy:2389
translate chinese norman_1_f23f50c8:

    # Fl "Heh. Then leave. No one’s stopping you."
    Fl "嘿。那就走啊。没人拦你。"

# game/Story01.rpy:2390
translate chinese norman_1_cae121c5:

    # Fl "Now… last touches."
    Fl "现在……最后收尾。"

# game/Story01.rpy:2401
translate chinese norman_1_e93e05e2:

    # Fl "And here it is, the one and only Reassembler 4000."
    Fl "就是它，独一无二的重组者 4000。"

# game/Story01.rpy:2402
translate chinese norman_1_d392cba7:

    # Fl "And me, the best mechanic in the entire Federation. You’re welcome."
    Fl "还有我，全联邦最好的机械师。不客气。"

# game/Story01.rpy:2404
translate chinese norman_1_52241ae3:

    # h "Best mechanic?"
    h "最好的机械师？"

# game/Story01.rpy:2405
translate chinese norman_1_29407580:

    # h "At talking, maybe."
    h "论嘴皮子，也许吧。"

# game/Story01.rpy:2407
translate chinese norman_1_4b5339f1:

    # mc "Olivia, enough."
    mc "奥利维亚，够了。"

# game/Story01.rpy:2408
translate chinese norman_1_d4da047b:

    # Fl "Careful. You’re getting a little bold for someone on my table—"
    Fl "小心。躺在我台子上的人可没资格这么横——"

# game/Story01.rpy:2409
translate chinese norman_1_52895d8f:

    # mc "Flora, right?"
    mc "弗洛拉，对吧？"

# game/Story01.rpy:2410
translate chinese norman_1_8e59af82:

    # mc "I’ll keep it simple. We’re here on business."
    mc "我简单说。我们来办事的。"

# game/Story01.rpy:2411
translate chinese norman_1_979be82d:

    # mc "Can you help, or not?"
    mc "你能帮，还是不能？"

# game/Story01.rpy:2412
translate chinese norman_1_41da62cb:

    # Fl "..."
    Fl "……"

# game/Story01.rpy:2415
translate chinese norman_1_b4448904:

    # Fl "Your augmentative system is running unstable."
    Fl "你的增强系统运行不稳定。"

# game/Story01.rpy:2416
translate chinese norman_1_4be8140d:

    # mc "Augment— what?"
    mc "增强——什么？"

# game/Story01.rpy:2417
translate chinese norman_1_e4361379:

    # Fl "Augmentative system."
    Fl "增强系统。"

# game/Story01.rpy:2418
translate chinese norman_1_8f9c2378:

    # Fl "That little thing keeping your brain from frying itself while synced with implants."
    Fl "那玩意儿能让你的大脑在和植入体同步时不烧坏自己。"

# game/Story01.rpy:2421
translate chinese norman_1_035b398b:

    # mc "That’s not what I was told."
    mc "我听到的不是这样。"

# game/Story01.rpy:2422
translate chinese norman_1_f1210074:

    # mc "They said compatibility was… exceptional."
    mc "他们说兼容性……极好。"

# game/Story01.rpy:2423
translate chinese norman_1_c847205e:

    # Fl "And that’s exactly where the difference is."
    Fl "区别就在这。"

# game/Story01.rpy:2424
translate chinese norman_1_264d7a18:

    # Fl "Body rejection and neural sync are not the same thing."
    Fl "身体排斥和神经同步不是一回事。"

# game/Story01.rpy:2425
translate chinese norman_1_4d2f6ed9:

    # Fl "First one? Your body stops being yours."
    Fl "第一个？你的身体不再属于你。"

# game/Story01.rpy:2426
translate chinese norman_1_17ac5bef:

    # Fl "Second?"
    Fl "第二个？"

# game/Story01.rpy:2427
translate chinese norman_1_be9200c1:

    # Fl "You start seeing things."
    Fl "你开始看见东西。"

# game/Story01.rpy:2429
translate chinese norman_1_6f7676d6:

    # h "The hell do you mean ‘seeing things’?"
    h "你说的‘看见东西’是什么意思？"

# game/Story01.rpy:2431
translate chinese norman_1_35347bce:

    # Fl "Literally."
    Fl "字面意思。"

# game/Story01.rpy:2432
translate chinese norman_1_00fef9a3:

    # Fl "You see what you don’t understand. Hear what you’re not supposed to."
    Fl "你看到你不理解的。听到你不该听的。"

# game/Story01.rpy:2433
translate chinese norman_1_eb35acca:

    # Fl "Pretty standard when your implants are… let’s say, not exactly cutting-edge."
    Fl "当你的植入体……这么说吧，不算最新款的时候，这很常见。"

# game/Story01.rpy:2436
translate chinese norman_1_8de44baf:

    # h "Wait! Hold on."
    h "等等！等一下。"

# game/Story01.rpy:2437
translate chinese norman_1_c31a6274:

    # h "You’re telling me he got patched together from scrap?"
    h "你是说他用破烂拼起来的？"

# game/Story01.rpy:2438
translate chinese norman_1_9b0a0e21:

    # ss "Analyzing... Analysis complete."
    ss "分析中……分析完成。"

# game/Story01.rpy:2439
translate chinese norman_1_fc582611:

    # ss "Classification: Experimental subject 378."
    ss "分类：实验体 378。"

# game/Story01.rpy:2442
translate chinese norman_1_7eb46f6f:

    # mc "(Subject-378?)"
    mc "（实验体-378？）"

# game/Story01.rpy:2447
translate chinese norman_1_3d1e6fc5:

    # aa "-Ark..."
    aa "——方舟……"

# game/Story01.rpy:2449
translate chinese norman_1_997c86ef:

    # aaa "We must—"
    aaa "我们必须——"

# game/Story01.rpy:2451
translate chinese norman_1_4a38a2b2:

    # aa "...unanimously."
    aa "……一致同意。"

# game/Story01.rpy:2452
translate chinese norman_1_0f69fa0f:

    # mc "(What the—)"
    mc "（什么——）"

# game/Story01.rpy:2461
translate chinese norman_1_244fd6a9:

    # a "(The Ark… that’s where all the answers are.)"
    a "（方舟……所有答案都在那儿。）"

# game/Story01.rpy:2469
translate chinese norman_1_d1e63dd2:

    # mc "Wh—"
    mc "什——"

# game/Story01.rpy:2470
translate chinese norman_1_b3db295f:

    # h "[mc]!"
    h "[mc]！"

# game/Story01.rpy:2473
translate chinese norman_1_205d7381:

    # h "What the hell did you do?!"
    h "你他妈干了什么？！"

# game/Story01.rpy:2474
translate chinese norman_1_155a997b:

    # Fl "...I don’t know, he—"
    Fl "……我不知道，他——"

# game/Story01.rpy:2475
translate chinese norman_1_1d8e0935:

    # mc "(…Where am I?)"
    mc "（……我在哪？）"

# game/Story01.rpy:2476
translate chinese norman_1_5b59eaec:

    # mc "(What are these voices…?)"
    mc "（这些声音是什么……？）"

# game/Story01.rpy:2484
translate chinese norman_1_616de294:

    # o "No. Not this time. Even for you."
    o "不。这次不行。就算是你也不行。"

# game/Story01.rpy:2485
translate chinese norman_1_19a082f5:

    # Mi "…Teacher’s orders."
    Mi "……老师的命令。"

# game/Story01.rpy:2494
translate chinese norman_1_46801678:

    # o "The Inquisition’s on you this time."
    o "这次审判庭盯上你了。"

# game/Story01.rpy:2495
translate chinese norman_1_7b613a2b:

    # o "I’ve got enough on my plate already."
    o "我这儿事已经够多了。"

# game/Story01.rpy:2496
translate chinese norman_1_97054340:

    # Mi "…Fine."
    Mi "……行。"

# game/Story01.rpy:2505
translate chinese norman_1_aebd6c68:

    # "Analyzing... Analys-"
    "分析中……分析——"

# game/Story01.rpy:2506
translate chinese norman_1_28d4a2cb:

    # o "...don’t know. Something’s interfering."
    o "……不知道。有东西在干扰。"

# game/Story01.rpy:2507
translate chinese norman_1_ad638835:

    # o "I’ve locked part of it down, for now. It should hold."
    o "我先封锁了一部分。应该能撑住。"

# game/Story01.rpy:2510
translate chinese norman_1_7677936f:

    # Mi "…I won’t forget this."
    Mi "……我不会忘。"

# game/Story01.rpy:2512
translate chinese norman_1_73df52b2:

    # o "Since you’re here… mind telling me why you’re so interested in him?"
    o "既然你来了……说说你为什么对他这么感兴趣？"

# game/Story01.rpy:2514
translate chinese norman_1_3fd19999:

    # Mi "…He’s like the other two scientists."
    Mi "……他像另外那两个科学家。"

# game/Story01.rpy:2516
translate chinese norman_1_07abc845:

    # o "..."
    o "……"

# game/Story01.rpy:2517
translate chinese norman_1_b193edff:

    # o "...Don’t tell me you used the gates again."
    o "……别告诉我你又用了门。"

# game/Story01.rpy:2518
translate chinese norman_1_49161752:

    # o "…He’s going to burn himself out like this."
    o "……这样下去他会把自己烧干。"

# game/Story01.rpy:2520
translate chinese norman_1_eb3600a8:

    # Mi "…My teacher knew the risk."
    Mi "……我老师知道风险。"

# game/Story01.rpy:2522
translate chinese norman_1_07f45910:

    # o "How bad is he?"
    o "他有多严重？"

# game/Story01.rpy:2523
translate chinese norman_1_da3fdbf1:

    # Mi "..."
    Mi "……"

# game/Story01.rpy:2524
translate chinese norman_1_cbc0023f:

    # o "...Yeah. Thought so."
    o "……是啊。我就知道。"

# game/Story01.rpy:2526
translate chinese norman_1_9482dd12:

    # mc "Two scientists?"
    mc "两个科学家？"

# game/Story01.rpy:2527
translate chinese norman_1_2ac84032:

    # o "Hey… you’re back."
    o "嘿……你醒了。"

# game/Story01.rpy:2528
translate chinese norman_1_0cc5f668:

    # o "How are you holding up?"
    o "你感觉怎么样？"

# game/Story01.rpy:2529
translate chinese norman_1_c045bc73:

    # mc "Could be worse."
    mc "还能更糟。"

# game/Story01.rpy:2532
translate chinese norman_1_b1943d57:

    # o "You’ve got a talent for timing."
    o "你挑时候的本事挺厉害。"

# game/Story01.rpy:2533
translate chinese norman_1_781e6628:

    # o "One day, and we’re already meeting again."
    o "才一天，我们就又见面了。"

# game/Story01.rpy:2535
translate chinese norman_1_c354b7d1:

    # mc "A day?.."
    mc "一天？……"

# game/Story01.rpy:2536
translate chinese norman_1_40ab9e67:

    # mc "I was out for a full day?"
    mc "我昏了一整天？"

# game/Story01.rpy:2537
translate chinese norman_1_fa15e927:

    # o "Data conflict."
    o "数据冲突。"

# game/Story01.rpy:2538
translate chinese norman_1_ba0d21f0:

    # o "Your brain couldn’t decide what was real and what wasn’t."
    o "你的大脑分不清什么是真的什么不是。"

# game/Story01.rpy:2539
translate chinese norman_1_711f5e12:

    # o "So it shut you down."
    o "所以它把你关机了。"

# game/Story01.rpy:2540
translate chinese norman_1_19c29175:

    # o "Roughly… sixty-six cycles."
    o "大概……六十六个周期。"

# game/Story01.rpy:2541
translate chinese norman_1_66e08a72:

    # mc "...cycles?"
    mc "……周期？"

# game/Story01.rpy:2544
translate chinese norman_1_9f94ac2b:

    # Mi "Twenty-two hours… by your standards."
    Mi "二十二小时……按你们的标准。"

# game/Story01.rpy:2546
translate chinese norman_1_31cb4e35:

    # mc "(…almost a day?)"
    mc "（……快一天了？）"

# game/Story01.rpy:2547
translate chinese norman_1_7e28b19b:

    # Mi "…Consider yourself lucky."
    Mi "……算你走运。"

# game/Story01.rpy:2548
translate chinese norman_1_8e359492:

    # mc "Fine."
    mc "行。"

# game/Story01.rpy:2549
translate chinese norman_1_9239328d:

    # mc "We’ll deal with that later."
    mc "这事以后再说。"

# game/Story01.rpy:2550
translate chinese norman_1_f289f965:

    # mc "Right now, those two scientists."
    mc "现在，那两个科学家。"

# game/Story01.rpy:2552
translate chinese norman_1_dc0be7d0:

    # mc "First Lora."
    mc "第一个是洛拉。"

# game/Story01.rpy:2553
translate chinese norman_1_421dff92:

    # mc "Who’s the second?"
    mc "第二个是谁？"

# game/Story01.rpy:2555
translate chinese norman_1_da3fdbf1_1:

    # Mi "..."
    Mi "……"

# game/Story01.rpy:2556
translate chinese norman_1_7d82bc9a:

    # mc "And don’t dodge the question."
    mc "别回避问题。"

# game/Story01.rpy:2559
translate chinese norman_1_23445d83:

    # Mi "I’ll call for transport."
    Mi "我去叫车。"

# game/Story01.rpy:2560
translate chinese norman_1_c13f9086:

    # mc "Stop running."
    mc "别跑了。"

# game/Story01.rpy:2561
translate chinese norman_1_76e6fe4a:

    # Mi "I’ll be waiting outside."
    Mi "我在外面等。"

# game/Story01.rpy:2562
translate chinese norman_1_36e53908:

    # mc "(Of course… she’s gone.)"
    mc "（当然……她走了。）"

# game/Story01.rpy:2564
translate chinese norman_1_33ea7988:

    # o "Dr. Li."
    o "李博士。"

# game/Story01.rpy:2565
translate chinese norman_1_5a0ff5b3:

    # o "He’s the one who saved your life."
    o "是他救了你的命。"

# game/Story01.rpy:2566
translate chinese norman_1_ebe13ee2:

    # mc "(Norman mentioned him…)"
    mc "（诺曼提到过他……）"

# game/Story01.rpy:2570
translate chinese norman_1_32aefc47:

    # o "Your brain’s going to need about a month to adjust to the implants."
    o "你的大脑大概需要一个月来适应植入体。"

# game/Story01.rpy:2573
translate chinese norman_1_99b2c42e:

    # mc "So I’ll keep blacking out."
    mc "所以我还会继续晕过去。"

# game/Story01.rpy:2575
translate chinese norman_1_4e5b6292:

    # o "There is a way to manage it."
    o "有办法控制。"

# game/Story01.rpy:2578
translate chinese norman_1_5e3ff0dd:

    # o "You’ll need to take them every thirty cycles or so."
    o "你大概每三十个周期就得服一次。"

# game/Story01.rpy:2579
translate chinese norman_1_858fcc2c:

    # o "Keeps things… stable."
    o "保持……稳定。"

# game/Story01.rpy:2580
translate chinese norman_1_fca52711:

    # mc "No."
    mc "不。"

# game/Story01.rpy:2581
translate chinese norman_1_627052c3:

    # mc "Not without knowing what they do."
    mc "不知道它们干什么之前，不行。"

# game/Story01.rpy:2583
translate chinese norman_1_b858794a:

    # o "Neuro-catalysts."
    o "神经催化剂。"

# game/Story01.rpy:2584
translate chinese norman_1_02364732:

    # o "They help your brain keep up with the load."
    o "帮你大脑跟上负荷。"

# game/Story01.rpy:2586
translate chinese norman_1_a9ef67dd:

    # mc "You brought me back."
    mc "你们把我带回来。"

# game/Story01.rpy:2587
translate chinese norman_1_61654bcf:

    # mc "Fixed my eye."
    mc "修好我的眼睛。"

# game/Story01.rpy:2588
translate chinese norman_1_0026a7c3:

    # mc "Ran your tests."
    mc "做你们的测试。"

# game/Story01.rpy:2589
translate chinese norman_1_9f102aaa:

    # mc "Now pills."
    mc "现在又是药片。"

# game/Story01.rpy:2590
translate chinese norman_1_2876efd9:

    # mc "Why?"
    mc "为什么？"

# game/Story01.rpy:2592
translate chinese norman_1_74ee6844:

    # o "Call it an investment in staying alive."
    o "就当是对活命的投资。"

# game/Story01.rpy:2594
translate chinese norman_1_2a1bb4e4:

    # mc "That doesn’t add up."
    mc "这说不通。"

# game/Story01.rpy:2596
translate chinese norman_1_25e12291:

    # o "Call it repaying a debt."
    o "就当是还债。"

# game/Story01.rpy:2597
translate chinese norman_1_347cef63:

    # mc "A debt?"
    mc "还债？"

# game/Story01.rpy:2598
translate chinese norman_1_1bfe4036:

    # mc "From what?"
    mc "还什么债？"

# game/Story01.rpy:2599
translate chinese norman_1_444ee177:

    # mc "(Lora...)"
    mc "（洛拉……）"

# game/Story01.rpy:2600
translate chinese norman_1_59f90608:

    # mc "…I’ll return the favor."
    mc "……我会还这个人情。"

# game/Story01.rpy:2601
translate chinese norman_1_07abc845_1:

    # o "..."
    o "……"

# game/Story01.rpy:2612
translate chinese norman_1_4c2d3251:

    # Mi "Advice… don’t breathe too deep here."
    Mi "劝你一句……在这儿别深呼吸。"

# game/Story01.rpy:2613
translate chinese norman_1_d8530be3:

    # mc "Let’s be clear."
    mc "说清楚点。"

# game/Story01.rpy:2614
translate chinese norman_1_fa7a61ac:

    # mc "Why are we here."
    mc "我们为什么来这儿。"

# game/Story01.rpy:2615
translate chinese norman_1_da3fdbf1_2:

    # Mi "..."
    Mi "……"

# game/Story01.rpy:2616
translate chinese norman_1_b04bf338:

    # mc "You didn’t answer me about the scientists."
    mc "科学家的事你没回答我。"

# game/Story01.rpy:2617
translate chinese norman_1_cb698e0d:

    # mc "So answer this instead."
    mc "那就回答这个。"

# game/Story01.rpy:2619
translate chinese norman_1_dd132ac7:

    # Mi "We’re heading to a tomb… outside the city."
    Mi "我们去城外的一座墓……"

# game/Story01.rpy:2620
translate chinese norman_1_1edb4a3a:

    # Mi "That’s where your wife works."
    Mi "你妻子在那儿工作。"

# game/Story01.rpy:2621
translate chinese norman_1_025e9575:

    # Mi "Outside the walls."
    Mi "在墙外。"

# game/Story01.rpy:2622
translate chinese norman_1_b7755a37:

    # Mi "Past the zones most patrols refuse to cross."
    Mi "过了大多数巡逻队都不愿越过的区域。"

# game/Story01.rpy:2624
translate chinese norman_1_60247a18:

    # mc "A tomb?"
    mc "墓？"

# game/Story01.rpy:2626
translate chinese norman_1_3feed9d6:

    # Mi "Mistakes of the past… buried by time and war."
    Mi "过去的错误……被时间和战争掩埋。"

# game/Story01.rpy:2627
translate chinese norman_1_4f15fca8:

    # mc "What do you mean by 'mistakes'?"
    mc "你说的‘错误’是什么意思？"

# game/Story01.rpy:2628
translate chinese norman_1_a11ad7d9:

    # Mi "The ancients... they did something... something we all are paying for."
    Mi "古人……做了些事……我们都在为此付出代价。"

# game/Story01.rpy:2629
translate chinese norman_1_6593b5f1:

    # mc "(She doesn't sound like she's willing to explain more)"
    mc "（她听起来不愿多解释）"

# game/Story01.rpy:2631
translate chinese norman_1_e893a298:

    # mc "And Lora, how does she fit into this?"
    mc "那洛拉呢，她怎么牵扯进来的？"

# game/Story01.rpy:2632
translate chinese norman_1_ce4e7220:

    # mc "She was working… on the ship."
    mc "她当时在……那艘船上工作。"

# game/Story01.rpy:2634
translate chinese norman_1_12c8abd5:

    # Mi "That ship, where we find you... was a tomb."
    Mi "我们发现你的那艘船……是座墓。"

# game/Story01.rpy:2635
translate chinese norman_1_5d5078e0:

    # mc "And the Ark?"
    mc "那方舟呢？"

# game/Story01.rpy:2636
translate chinese norman_1_06bd11c8:

    # Mi "Something connected to it."
    Mi "和它有关的东西。"

# game/Story01.rpy:2637
translate chinese norman_1_3ab4b958:

    # Mi "Something Lora should never have touched."
    Mi "洛拉本不该碰的东西。"

# game/Story01.rpy:2640
translate chinese norman_1_e175fbe1:

    # mc "(…so many of them.)"
    mc "（……这么多。）"

# game/Story01.rpy:2641
translate chinese norman_1_f629b59b:

    # mc "(Flying… everywhere.)"
    mc "（到处……飞。）"

# game/Story01.rpy:2643
translate chinese norman_1_ce6df2f7:

    # mc "How advanced is the current civilisation considering you have flying vehicles?"
    mc "既然你们有飞行器，现在的文明有多先进？"

# game/Story01.rpy:2644
translate chinese norman_1_ddd736e5:

    # Mi "Advanced? Not really. The tomb had most of the technologies we currently use."
    Mi "先进？不算。我们现在用的大多数技术都来自那座墓。"

# game/Story01.rpy:2647
translate chinese norman_1_487a84b3:

    # mc "A tomb…"
    mc "墓……"

# game/Story01.rpy:2648
translate chinese norman_1_954fe593:

    # mc "Like some kind of storage?"
    mc "像某种仓库？"

# game/Story01.rpy:2649
translate chinese norman_1_da3fdbf1_3:

    # Mi "..."
    Mi "……"

# game/Story01.rpy:2651
translate chinese norman_1_2170b42f:

    # mc "Miriel?"
    mc "米莉尔？"

# game/Story01.rpy:2653
translate chinese norman_1_53aa653b:

    # Mi "A graveyard, not a storage."
    Mi "是墓地，不是仓库。"

# game/Story01.rpy:2654
translate chinese norman_1_6e9469e1:

    # Mi "A vessel left behind by the Ancients."
    Mi "古人留下的飞船。"

# game/Story01.rpy:2656
translate chinese norman_1_b0668e8b:

    # mc "And you call it a tomb because its creators are dead."
    mc "你们叫它墓，是因为它的建造者死了。"

# game/Story01.rpy:2658
translate chinese norman_1_a64f4092:

    # mc "And no one has a problem with that?"
    mc "没人觉得有问题？"

# game/Story01.rpy:2659
translate chinese norman_1_d63c6e69:

    # Mi "…Should they?"
    Mi "……该有吗？"

# game/Story01.rpy:2660
translate chinese norman_1_826c438d:

    # mc "A graveyard means people were buried there... and you are stealing technology from them..."
    mc "墓地意味着有人葬在那儿……而你们在偷他们的技术……"

# game/Story01.rpy:2662
translate chinese norman_1_430e54a7:

    # Mi "…So?"
    Mi "……所以？"

# game/Story01.rpy:2663
translate chinese norman_1_5a40040f:

    # mc "(Graves being looted...{w=0.5} Jack...{w=0.5} Mona...)"
    mc "（盗墓……{w=0.5}杰克……{w=0.5}莫娜……）"

# game/Story01.rpy:2664
translate chinese norman_1_6891eabc:

    # mc "You are just looting graves."
    mc "你们就是在盗墓。"

# game/Story01.rpy:2666
translate chinese norman_1_816443cf:

    # Mi "The dead… don’t need their belongings."
    Mi "死人……不需要他们的东西。"

# game/Story01.rpy:2669
translate chinese norman_1_729a8fd1:

    # Mi "Every day… millions die at the front."
    Mi "每天……前线死几百万人。"

# game/Story01.rpy:2670
translate chinese norman_1_a030d25c:

    # Mi "Numbers stopped meaning anything a long time ago."
    Mi "数字早就不代表什么了。"

# game/Story01.rpy:2671
translate chinese norman_1_21891237:

    # Mi "Do you really think anyone cares about a tomb?"
    Mi "你真觉得有人在乎一座墓？"

# game/Story01.rpy:2673
translate chinese norman_1_360091b8:

    # Mi "We’re just trying to survive."
    Mi "我们只是想活下去。"

# game/Story01.rpy:2675
translate chinese norman_1_92dcf7bf:

    # mc "(…No.)"
    mc "（……不。）"

# game/Story01.rpy:2676
translate chinese norman_1_0247f554:

    # mc "I don’t agree."
    mc "我不同意。"

# game/Story01.rpy:2678
translate chinese norman_1_3ae78382:

    # mc "If this is nothing to you…"
    mc "如果这对你不算什么……"

# game/Story01.rpy:2679
translate chinese norman_1_a3fc761c:

    # mc "Then tell me."
    mc "那告诉我。"

# game/Story01.rpy:2680
translate chinese norman_1_e53df8b0:

    # mc "What did you do with my son’s body?"
    mc "你们把我儿子的尸体怎么了？"

# game/Story01.rpy:2682
translate chinese norman_1_da3fdbf1_4:

    # Mi "..."
    Mi "……"

# game/Story01.rpy:2686
translate chinese norman_1_037999e2:

    # Mi "…We burned it."
    Mi "……烧了。"

# game/Story01.rpy:2688
