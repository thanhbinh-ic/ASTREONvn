translate chinese olivia_fr_scene_e4fa8128:

    # mc "Miriel stepped out. She’ll be back."
    mc "米莉尔出去了。她会回来的。"

# game/Story01.rpy:9134
translate chinese olivia_fr_scene_2fded262_1:

    # h "..."
    h "……"

# game/Story01.rpy:9136
translate chinese olivia_fr_scene_b97d5541:

    # mc "How do you feel?"
    mc "感觉怎么样？"

# game/Story01.rpy:9137
translate chinese olivia_fr_scene_f0d89745:

    # mc "You had us worried."
    mc "你吓到我们了。"

# game/Story01.rpy:9139
