    g "不确定它们是突破进来的。"

# game/Story01.rpy:7294
translate chinese path_second_up_3_3_223e2784:

    # gg "Yeah… they hit us from behind."
    gg "对……它们从背后袭击我们。"

# game/Story01.rpy:7296
translate chinese path_second_up_3_3_4cb4bea4:

    # Fl "I asked around about that thing."
    Fl "我打听过那东西。"

# game/Story01.rpy:7297
translate chinese path_second_up_3_3_8eaab4cf:

    # Fl "From what I got? It’s a real pain in the ass."
    Fl "就我打听到的？真他妈难缠。"

# game/Story01.rpy:7298
translate chinese path_second_up_3_3_0982a43a:

    # mc "(whispering) Anything more useful?"
    mc "（低声）有更有用的吗？"

# game/Story01.rpy:7299
translate chinese path_second_up_3_3_a593da63:

    # Fl "They move alone."
    Fl "它们单独行动。"

# game/Story01.rpy:7300
translate chinese path_second_up_3_3_2c51de35:

    # Fl "Can go invisible…"
    Fl "能隐身……"

# game/Story01.rpy:7301
translate chinese path_second_up_3_3_f8e2b060:

    # Fl "But they give off heat signatures."
    Fl "但会散发热信号。"

# game/Story01.rpy:7304
translate chinese path_second_up_3_3_8ceb05f1:

    # mc "Sector 8. The comm tower. You know anything about it?"
    mc "8区。通讯塔。你知道什么吗？"

# game/Story01.rpy:7305
translate chinese path_second_up_3_3_161413b5:

    # g "Uh— yeah."
    g "呃——知道。"

# game/Story01.rpy:7306
translate chinese path_second_up_3_3_40deb052:

    # g "Come with us. We’ll take you to the commander."
    g "跟我们来。我们带你去见指挥官。"

# game/Story01.rpy:7308
translate chinese path_second_up_3_3_ccff529e:

    # gg "We tried to get backup from the eastern sector..."
    gg "我们试着从东区调增援……"

# game/Story01.rpy:7309
translate chinese path_second_up_3_3_b3a3fccb:

    # gg "But—"
    gg "但——"

# game/Story01.rpy:7311
translate chinese path_second_up_3_3_a5ad53ee:

    # mc "That’s enough. Move."
    mc "够了。走。"

# game/Story01.rpy:7314
translate chinese path_second_up_3_3_850ef128_1:

    # b "..."
    b "……"

# game/Story01.rpy:7316
translate chinese path_second_up_3_3_eb47cfba:

    # mc "Now!"
    mc "现在！"

# game/Story01.rpy:7318
translate chinese path_second_up_3_3_449bdc16:

    # gg "FOLLOW ME!"
    gg "跟我来！"

# game/Story01.rpy:7328
translate chinese path_second_up_3_3_3413110f:

    # gg "First door, that’s the command post."
    gg "第一扇门，就是指挥所。"

# game/Story01.rpy:7329
translate chinese path_second_up_3_3_51bcca72:

    # gg "You’ll find the commander there."
    gg "指挥官在那儿。"

# game/Story01.rpy:7331
translate chinese path_second_up_3_3_bb0eeaf4:

    # mc "Thank you."
    mc "谢谢。"

# game/Story01.rpy:7338
translate chinese path_second_up_3_3_f32b33d3:

    # Fl "Well, would you look at that…"
    Fl "哟，看看这个……"

# game/Story01.rpy:7339
translate chinese path_second_up_3_3_27543aba:

    # Fl "Brings back memories."
    Fl "勾起回忆了。"

# game/Story01.rpy:7341
translate chinese path_second_up_3_3_182c210d:

    # mc "You’ve been here before?"
    mc "你来过这儿？"

# game/Story01.rpy:7343
translate chinese path_second_up_3_3_a001a5a6:

    # Fl "Sadly, yeah."
    Fl "可惜，是啊。"

# game/Story01.rpy:7344
translate chinese path_second_up_3_3_333917d1:

    # Fl "Grew up around here."
    Fl "在这儿长大的。"

# game/Story01.rpy:7345
translate chinese path_second_up_3_3_811a5135:

    # mc "Didn’t expect that. Thought you came from money."
    mc "没想到。以为你出身富贵。"

# game/Story01.rpy:7349
translate chinese path_second_up_3_3_47e1e607:

    # Fl "Oh wow~ so I made a good first impression, then?"
    Fl "哦哇~那我第一印象还不错？"

# game/Story01.rpy:7350
translate chinese path_second_up_3_3_67d2ecd9:

    # mc "Your father’s a big shot, isn’t he? So how’d that happen?"
    mc "你父亲是大人物，对吧？那怎么会这样？"

# game/Story01.rpy:7352
translate chinese path_second_up_3_3_22910cdb:

    # Fl "My dad..."
    Fl "我爸……"

# game/Story01.rpy:7353
translate chinese path_second_up_3_3_1533fab0:

    # Fl "the old man always had his principles."
    Fl "那老头一直有自己的原则。"

# game/Story01.rpy:7354
translate chinese path_second_up_3_3_860a1f8b:

    # Fl "Thought he could make this sector… a little safer."
    Fl "以为他能让这个区……安全一点。"

# game/Story01.rpy:7357
translate chinese path_second_up_3_3_9c9aedbb:

    # mc "So you know people from around here?"
    mc "所以你认识这儿的人？"

# game/Story01.rpy:7358
translate chinese path_second_up_3_3_b974504b:

    # Fl "...Yeah."
    Fl "……认识。"

# game/Story01.rpy:7359
translate chinese path_second_up_3_3_61a4b84f:

    # Fl "Or what’s left of them."
    Fl "或者说他们剩下的。"

# game/Story01.rpy:7360
translate chinese path_second_up_3_3_2b35b6fe_3:

    # mc "..."
    mc "……"

# game/Story01.rpy:7363
translate chinese path_second_up_3_3_291135f7:

    # mc "Hey, Flor?"
    mc "嘿，弗洛？"

# game/Story01.rpy:7364
translate chinese path_second_up_3_3_42f1fa33:

    # mc "What did the blind man say when he walked into a bar?"
    mc "盲人走进酒吧说了什么？"

# game/Story01.rpy:7365
translate chinese path_second_up_3_3_19949fd0:

    # mc "“Hello to everyone I couldn’t see!”"
    mc "“向所有我看不见的人问好！”"

# game/Story01.rpy:7367
translate chinese path_second_up_3_3_41da62cb:

    # Fl "..."
    Fl "……"

# game/Story01.rpy:7368
translate chinese path_second_up_3_3_109b2e6e:

    # Fl "*A faint, almost reluctant chuckle.*"
    Fl "*勉强笑了一声。*"

# game/Story01.rpy:7370
translate chinese path_second_up_3_3_035be45d:

    # Fl "…Okay, yeah."
    Fl "……好吧，是啊。"

# game/Story01.rpy:7371
translate chinese path_second_up_3_3_60399158:

    # Fl "That was stupid."
    Fl "挺蠢的。"

# game/Story01.rpy:7372
translate chinese path_second_up_3_3_1df7826f:

    # Fl "But I’ll give you that— it was funny."
    Fl "不过得承认——挺好笑的。"

# game/Story01.rpy:7374
translate chinese path_second_up_3_3_4f1f813b:

    # Fl "…and..."
    Fl "……还有……"

# game/Story01.rpy:7375
translate chinese path_second_up_3_3_56de9b62:

    # Fl "...thanks."
    Fl "……谢谢。"

# game/Story01.rpy:7378
translate chinese path_second_up_3_3_2b35b6fe_4:

    # mc "..."
    mc "……"

# game/Story01.rpy:7381
translate chinese path_second_up_3_3_8b9a44df:

    # mc "We don’t forget."
    mc "我们不会忘。"

# game/Story01.rpy:7384
translate chinese path_second_up_3_3_ab473ab9:

    # Fl "Right."
    Fl "嗯。"

# game/Story01.rpy:7386
translate chinese path_second_up_3_3_2cd89ca2:

    # Fl "Focus."
    Fl "集中。"

# game/Story01.rpy:7387
translate chinese path_second_up_3_3_616a575e:

    # Fl "We’re here for information."
    Fl "我们来是要情报的。"

# game/Story01.rpy:7390
translate chinese path_second_up_3_3_643ddf19:

    # mc "I’ll handle it."
    mc "我来处理。"

# game/Story01.rpy:7393
translate chinese path_second_up_3_3_ea62f8dd:

    # g "What about the civilians? We can’t deploy Titans in here."
    g "平民怎么办？我们不能在这儿部署泰坦。"

# game/Story01.rpy:7395
translate chinese path_second_up_3_3_f5b68726:

    # gg "If we just sit on this, the city’s going down!"
    gg "再这么干坐着，城就完了！"

# game/Story01.rpy:7397
translate chinese path_second_up_3_3_231f5771:

    # ex "We clear the civilians. Fast."
    ex "快速疏散平民。"

# game/Story01.rpy:7398
translate chinese path_second_up_3_3_214cc10b:

    # ex "Then we burn this sector to the ground. No hesitation."
    ex "然后把这一区烧成灰。毫不犹豫。"

# game/Story01.rpy:7400
translate chinese path_second_up_3_3_52ed70c5:

    # g "That’s insanity!"
    g "这太疯狂了！"

# game/Story01.rpy:7401
translate chinese path_second_up_3_3_d23dcf01:

    # ex "No. That’s containment."
    ex "不。这叫围堵。"

# game/Story01.rpy:7402
translate chinese path_second_up_3_3_ff65d8f7:

    # ex "Sector 6 is still holding."
    ex "6区还在撑着。"

# game/Story01.rpy:7403
translate chinese path_second_up_3_3_c91c8793:

    # ex "When it breaks and it will— we’re next in line."
    ex "等它破——而且一定会破——下一个就是我们。"

# game/Story01.rpy:7406
translate chinese path_second_up_3_3_a4285e2b:

    # ex "...You."
    ex "……你。"

# game/Story01.rpy:7407
translate chinese path_second_up_3_3_53e77041:

    # ex "...you’re that ear-girl’s friend, aren’t you?"
    ex "……你是那个尖耳朵丫头的朋友，对吧？"

# game/Story01.rpy:7408
translate chinese path_second_up_3_3_d411768e:

    # ex "What’s an Inquisition lapdog doing in my warzone?"
    ex "审判庭的走狗跑我战区来干嘛？"

# game/Story01.rpy:7409
translate chinese path_second_up_3_3_f8825e66:

    # mc "Lower your voice."
    mc "小点声。"

# game/Story01.rpy:7410
translate chinese path_second_up_3_3_9dc9dacf:

    # mc "If you had this under control, I wouldn’t be here."
    mc "你要是控制得住，我就不用来。"

# game/Story01.rpy:7411
translate chinese path_second_up_3_3_513aa69e:

    # ex "..."
    ex "……"

# game/Story01.rpy:7412
translate chinese path_second_up_3_3_59d323b1:

    # Fl "You know him?"
    Fl "你认识他？"

# game/Story01.rpy:7413
translate chinese path_second_up_3_3_9243a12e:

    # Fl "Full story later."
    Fl "以后再细说。"

# game/Story01.rpy:7415
translate chinese path_second_up_3_3_7b9f3229:

    # mc "I’ve seen the streets."
    mc "我见过外面的街道。"

# game/Story01.rpy:7416
translate chinese path_second_up_3_3_59605c1e:

    # mc "You need backup."
    mc "你需要增援。"

# game/Story01.rpy:7417
translate chinese path_second_up_3_3_dbe6495c:

    # mc "So talk. What’s left?"
    mc "说吧。还剩什么？"

# game/Story01.rpy:7420
translate chinese path_second_up_3_3_9eab1f41:

    # ex "We’re bleeding out."
    ex "我们在流血。"

# game/Story01.rpy:7421
translate chinese path_second_up_3_3_114ee6fe:

    # ex "Supplies - gone."
    ex "补给——没了。"

# game/Story01.rpy:7422
translate chinese path_second_up_3_3_2265e7c4:

    # ex "Comms- dead."
    ex "通讯——死了。"

# game/Story01.rpy:7423
translate chinese path_second_up_3_3_e7b5ada0:

    # ex "And my people are dropping one by one while we stand here talking."
    ex "我们站这儿说话的时候，我的人一个个倒下。"

# game/Story01.rpy:7426
translate chinese path_second_up_3_3_a07c9ea4:

    # ex "One man…"
    ex "一个人……"

# game/Story01.rpy:7427
translate chinese path_second_up_3_3_e6706e77:

    # ex "is not going to fix my battlefield."
    ex "救不了我的战场。"

# game/Story01.rpy:7428
translate chinese path_second_up_3_3_d6fd6bd5:

    # mc "Information."
    mc "情报。"

# game/Story01.rpy:7429
translate chinese path_second_up_3_3_f03f6a0a:

    # mc "Sector 8. The tower."
    mc "8区。那座塔。"

# game/Story01.rpy:7430
translate chinese path_second_up_3_3_513aa69e_1:

    # ex "..."
    ex "……"

# game/Story01.rpy:7433
translate chinese path_second_up_3_3_529a9f48:

    # ex "Dave. Report."
    ex "戴夫。汇报。"

# game/Story01.rpy:7435
translate chinese path_second_up_3_3_c1d7719d:

    # gg "That blast fried everything it could."
    gg "那次爆炸把所有能烧的都烧了。"

# game/Story01.rpy:7436
translate chinese path_second_up_3_3_11e14b33:

    # gg "We’re deaf. Blind. Completely cut off."
    gg "我们聋了。瞎了。完全被切断。"

# game/Story01.rpy:7438
translate chinese path_second_up_3_3_f44355db:

    # g "That’s exactly my point."
    g "这正是我的意思。"

# game/Story01.rpy:7439
translate chinese path_second_up_3_3_b6956508:

    # g "We can’t afford to take any more risks!"
    g "我们冒不起更多险了！"

# game/Story01.rpy:7440
translate chinese path_second_up_3_3_d0c98c99:

    # g "We wait for a signal from the tower."
    g "我们等塔的信号。"

# game/Story01.rpy:7442
translate chinese path_second_up_3_3_afce60e2:

    # mc "I’m not here for panic."
    mc "我不是来听恐慌的。"

# game/Story01.rpy:7443
translate chinese path_second_up_3_3_0ada63d0:

    # mc "Sector 8. Tower. Now."
    mc "8区。塔。现在。"

# game/Story01.rpy:7445
translate chinese path_second_up_3_3_92b0be44:

    # ex "Sector 8. Old relay tower."
    ex "8区。旧中继塔。"

# game/Story01.rpy:7448
translate chinese path_second_up_3_3_7b1b9d54:

    # ex "Only way out of this mess."
    ex "摆脱这烂摊子的唯一出路。"

# game/Story01.rpy:7449
translate chinese path_second_up_3_3_61a4df81:

    # ex "Problem is— getting there alive."
    ex "问题是——活着到那儿。"

# game/Story01.rpy:7451
translate chinese path_second_up_3_3_5c4e71e8:

    # mc "How far?"
    mc "多远？"

# game/Story01.rpy:7453
translate chinese path_second_up_3_3_971d3fe6:

    # gggg "Beyond the wall."
    gggg "墙外。"

# game/Story01.rpy:7454
translate chinese path_second_up_3_3_3ab8984f:

    # mc "(Beyond the wall… this is gonna be rough.)"
    mc "（墙外……这会很难。）"

# game/Story01.rpy:7456
translate chinese path_second_up_3_3_3c3a9f74:

    # g "No one’s going beyond the wall right now."
    g "现在没人去墙外。"

# game/Story01.rpy:7457
translate chinese path_second_up_3_3_917248f3:

    # g "And if they do... they’re not coming back."
    g "就算去了……也回不来。"

# game/Story01.rpy:7458
translate chinese path_second_up_3_3_aa23d6cd:

    # g "We wait for word from the to—"
    g "我们等塔的消息——"

# game/Story01.rpy:7460
translate chinese path_second_up_3_3_6c9723aa:

    # gg "We don’t have time to wait!"
    gg "我们没时间等了！"

# game/Story01.rpy:7461
translate chinese path_second_up_3_3_bdbfb929:

    # mc "(Lora… she was out there too…)"
    mc "（洛拉……她也去过那儿……）"

# game/Story01.rpy:7463
translate chinese path_second_up_3_3_a600edea:

    # mc "I’m going."
    mc "我去。"

# game/Story01.rpy:7464
translate chinese path_second_up_3_3_da78095e:

    # Fl "Hey— hey, are you out of your mind?!"
    Fl "嘿——嘿，你疯了吗？！"

# game/Story01.rpy:7465
translate chinese path_second_up_3_3_cdcc3d47:

    # Fl "You were just supposed to—"
    Fl "你本来只是要——"

# game/Story01.rpy:7466
translate chinese path_second_up_3_3_2b35b6fe_5:

    # mc "..."
    mc "……"

# game/Story01.rpy:7467
translate chinese path_second_up_3_3_d8d8555d:

    # g "Alone?"
    g "一个人？"

# game/Story01.rpy:7469
translate chinese path_second_up_3_3_d4727206:

    # mc "Less people, better odds."
    mc "人越少，胜算越大。"

# game/Story01.rpy:7471
translate chinese path_second_up_3_3_b04c93cd:

    # ex "No."
    ex "不行。"

# game/Story01.rpy:7472
translate chinese path_second_up_3_3_e87499d1:

    # ex "You don’t get to die on your own terms in my command."
    ex "在我的指挥下，你不能按自己的方式去死。"

# game/Story01.rpy:7473
translate chinese path_second_up_3_3_791a6845:

    # mc "You gonna stop me?"
    mc "你要拦我？"

# game/Story01.rpy:7474
translate chinese path_second_up_3_3_b04c93cd_1:

    # ex "No."
    ex "不。"

# game/Story01.rpy:7475
translate chinese path_second_up_3_3_f5649a22:

    # ex "I’m going to make sure your death isn’t useless."
    ex "我要确保你的死不是白费。"

# game/Story01.rpy:7477
translate chinese path_second_up_3_3_a826d1f3:

    # gg "I’m going with him."
    gg "我跟他去。"

# game/Story01.rpy:7478
translate chinese path_second_up_3_3_f0a85022:

    # gg "Better that than sitting around waiting for a miracle."
    gg "总比坐这儿等奇迹强。"

# game/Story01.rpy:7480
translate chinese path_second_up_3_3_513aa69e_2:

    # ex "..."
    ex "……"

# game/Story01.rpy:7481
translate chinese path_second_up_3_3_f4f25436:

    # ex "Fine."
    ex "行。"

# game/Story01.rpy:7482
translate chinese path_second_up_3_3_6618df2a:

    # ex "I’ll scrape together whoever’s still breathing."
    ex "我把还能喘气的都凑起来。"

# game/Story01.rpy:7483
translate chinese path_second_up_3_3_42e9edce:

    # ex "You move as a unit. You follow orders."
    ex "你们作为一个单位行动。服从命令。"

# game/Story01.rpy:7484
translate chinese path_second_up_3_3_e554908f:

    # ex "You screw this up— don’t bother coming back."
    ex "要是搞砸了——就别回来了。"

# game/Story01.rpy:7485
translate chinese path_second_up_3_3_6651ab87:

    # mc "Alright."
    mc "好。"

# game/Story01.rpy:7495
translate chinese path_second_up_3_3_eff3b895:

    # R "(The Inquisition…)"
    R "（审判庭……）"

# game/Story01.rpy:7496
translate chinese path_second_up_3_3_e65574a0:

    # R "(They don’t even let you breathe.)"
    R "（他们连喘气都不让你喘。）"

# game/Story01.rpy:7499
translate chinese path_second_up_3_3_c76e24e6:

    # R "(From a respected scientist....)"
    R "（从一个受人尊敬的科学家……）"

# game/Story01.rpy:7500
translate chinese path_second_up_3_3_164fb155:

    # R "(To a glorified errand boy.)"
    R "（变成一个高级跑腿的。）"

# game/Story01.rpy:7501
translate chinese path_second_up_3_3_cad3ac66:

    # R "(…Just wait.)"
    R "（……等着吧。）"

# game/Story01.rpy:7502
translate chinese path_second_up_3_3_57b355b8:

    # R "(All of you.)"
    R "（你们所有人。）"

# game/Story01.rpy:7505
translate chinese path_second_up_3_3_53f79f81:

    # R "(whisper) You’ll pay for this."
    R "（低语）你们会为此付出代价。"

# game/Story01.rpy:7508
translate chinese path_second_up_3_3_a812b5fd:

    # R "What the—"
    R "什么——"

# game/Story01.rpy:7510
translate chinese path_second_up_3_3_c389ec03:

    # aa "You’re late."
    aa "你迟到了。"

# game/Story01.rpy:7511
translate chinese path_second_up_3_3_12cdef87:

    # R "…I was delayed."
    R "……我被耽误了。"

# game/Story01.rpy:7513
translate chinese path_second_up_3_3_d1f73ef0:

    # aa "You won’t share their fate."
    aa "你不会和他们同命运。"

# game/Story01.rpy:7515
translate chinese path_second_up_3_3_3213991b:

    # R "…I released them."
    R "……我放了他们。"

# game/Story01.rpy:7516
translate chinese path_second_up_3_3_3437cadb:

