    # mc "(…Something’s off about her.)"
    mc "（……她有点不对劲。）"

# game/Story01.rpy:9267
translate chinese final2_926d698e:

    # mc "Miriel."
    mc "米莉尔。"

# game/Story01.rpy:9268
