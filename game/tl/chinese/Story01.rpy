translate chinese olivia_fr_scene_e0549b2e:

    # L "Where did you find this beauty?"
    L "你从哪儿找到这个小美人的？"

# game/Story01.rpy:8971
translate chinese olivia_fr_scene_54aa1f79:

    # mc "Found her wandering the streets. Looking for work."
    mc "在街上游荡的时候找到的。在找工作。"

# game/Story01.rpy:8973
translate chinese olivia_fr_scene_7e30e6b0:

    # mc "...Couldn’t just walk past that."
    mc "……没法就这么走过去。"

# game/Story01.rpy:8975
translate chinese olivia_fr_scene_18b0bfaf:

    # mc "(Truth is… she reminded me of myself back then.)"
    mc "（说实话……她让我想起当年的自己。）"

# game/Story01.rpy:8976
translate chinese olivia_fr_scene_3b8aee1b:

    # mc "(And something in me just… clicked.)"
    mc "（我心里有什么……一下就通了。）"

# game/Story01.rpy:8978
translate chinese olivia_fr_scene_ad5ceb57:

    # L "You know… I’m starting to question your talent."
    L "你知道吗……我开始怀疑你的本事了。"

# game/Story01.rpy:8979
translate chinese olivia_fr_scene_d3d665fe:

    # L "The number of girls in trouble you somehow keep finding?"
    L "你总能找到落难的姑娘？"

