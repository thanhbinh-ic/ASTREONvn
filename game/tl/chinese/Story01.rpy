translate chinese olivia_fr_scene_ed0fc6eb:

    # mc "(…Dreaming?)"
    mc "（……做梦？）"

# game/Story01.rpy:9117
translate chinese olivia_fr_scene_b04c4153:

    # mc "Olivia... hey."
    mc "奥利维亚……嘿。"

