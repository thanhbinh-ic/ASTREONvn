translate chinese path_second_up_3_3_47bf7195:

    # gg "Back pocket, top right! Spare mag! Drop it, and I’ll drop you!"
    gg "后兜，右上！备用弹匣！丢了它我就丢了你！"

# game/Story01.rpy:7246
translate chinese path_second_up_3_3_2b35b6fe_1:

    # mc "..."
    mc "……"

# game/Story01.rpy:7247
translate chinese path_second_up_3_3_c1b6dc27:

    # mc "(Hot…)"
    mc "（好烫……）"

# game/Story01.rpy:7249
