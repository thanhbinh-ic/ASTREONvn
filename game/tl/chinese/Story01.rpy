    h "等等，那爆炸是——？"

# game/Story01.rpy:8080
translate chinese gate3_70cc1df9:

    # mc "Purge."
    mc "清洗。"

# game/Story01.rpy:8082
translate chinese gate3_4dfe6038:

    # h "A purge—?"
    h "清洗——？"

# game/Story01.rpy:8084
translate chinese gate3_1fcebf2d:

    # mc "I’ll explain later."
    mc "以后再解释。"

# game/Story01.rpy:8085
translate chinese gate3_89dba142:

    # mc "Where’s Miriel?"
    mc "米莉尔在哪？"

# game/Story01.rpy:8088
translate chinese gate3_7337637c:

    # Mi "We’re leaving."
    Mi "我们得走了。"

# game/Story01.rpy:8089
translate chinese gate3_df620762:

    # Mi "The horde is almost here."
    Mi "兽群快到了。"

# game/Story01.rpy:8092
translate chinese gate3_2b35b6fe_4:

    # mc "..."
    mc "……"

# game/Story01.rpy:8093
translate chinese gate3_b2111bf7:

    # mc "We need to move."
    mc "我们得动身。"

# game/Story01.rpy:8094
translate chinese gate3_97a7228d:

    # mc "This is getting worse by the second."
    mc "情况一秒比一秒糟。"

# game/Story01.rpy:8097
translate chinese gate3_18ddcaa0:

    # o "Everyone, into the tunnel! Move!"
    o "所有人，进隧道！快！"

# game/Story01.rpy:8108
translate chinese gate4_e764af6d:

    # "Sector 6. Level 2. Ancient tunnels."
    "6区。第二层。古代隧道。"

# game/Story01.rpy:8113
translate chinese gate4_edcb0a93:

    # mc "(Don’t like this place.)"
    mc "（不喜欢这地方。）"

# game/Story01.rpy:8114
translate chinese gate4_e4054e3a:

    # mc "Status?"
    mc "汇报情况？"

# game/Story01.rpy:8115
translate chinese gate4_c4323a71:

    # g "...I’ve got nothing. Visibility’s garbage."
    g "……我什么都看不到。能见度太差。"

# game/Story01.rpy:8117
translate chinese gate4_0a92f4e7:

    # o "Stay close."
    o "跟紧。"

# game/Story01.rpy:8118
translate chinese gate4_ea072537:

    # o "Easy to get lost down here."
    o "这下面很容易迷路。"

# game/Story01.rpy:8120
translate chinese gate4_7f23a6b5:

    # mc "Where do we go?"
    mc "我们往哪走？"

# game/Story01.rpy:8122
translate chinese gate4_9c3c43bf:

    # o "The nav-device still works locally."
    o "导航器还能在本地工作。"

# game/Story01.rpy:8123
translate chinese gate4_b9588e07:

    # o "Short range only. Enough to keep us from getting lost."
    o "只能短距。够我们不迷路。"

# game/Story01.rpy:8125
translate chinese gate4_05608981:

    # o "Without it, we’re dead."
    o "没它我们就死定了。"

# game/Story01.rpy:8132
translate chinese gate4_cbb8280b:

    # o "Target’s a couple kilometers east."
    o "目标在东边几公里外。"

# game/Story01.rpy:8133
translate chinese gate4_6c1ffc7b:

    # o "Sector 8-S."
    o "8-S区。"

# game/Story01.rpy:8136
translate chinese gate4_b5bfc510:

    # o "Shortest route’s through this tunnel."
    o "最短路线是穿过这条隧道。"

# game/Story01.rpy:8139
translate chinese gate4_13f4f617:

    # g "That one? That’s a death trap."
    g "那条？那是死亡陷阱。"

# game/Story01.rpy:8140
translate chinese gate4_7d74c370:

    # g "One wrong shot and we’re buried."
    g "一枪打偏我们就得被埋。"

# game/Story01.rpy:8141
translate chinese gate4_d0d73fc3:

    # o "Got a better idea?"
    o "有更好的主意？"

# game/Story01.rpy:8143
translate chinese gate4_047eb0a3:

    # g "We take the service route."
    g "走维护通道。"

# game/Story01.rpy:8147
translate chinese gate4_b16b88cd:

    # g "Slower… but it won’t cave in on us."
    g "慢点……但不会塌。"

# game/Story01.rpy:8148
translate chinese gate4_48b3408f:

    # mc "We don’t have time for a detour."
    mc "没时间绕路。"

# game/Story01.rpy:8149
translate chinese gate4_d3cca77a:

    # g "Too risky."
    g "太冒险。"

# game/Story01.rpy:8152
translate chinese gate4_b26dec1a:

    # mc "We take the risk."
    mc "就冒这个险。"

# game/Story01.rpy:8153
translate chinese gate4_285343e1:

    # gg "Inquisitor’s got a point."
    gg "审判庭的说得对。"

# game/Story01.rpy:8154
translate chinese gate4_5f8fe0b9:

    # o "Risk it is."
    o "那就冒险。"

# game/Story01.rpy:8155
translate chinese gate4_20a0bdf6:

    # o "Check your ammo."
    o "检查弹药。"

# game/Story01.rpy:8156
translate chinese gate4_bd477a70:

    # o "We don’t get a second try."
    o "我们没有第二次机会。"

# game/Story01.rpy:8158
translate chinese gate4_5477a0fd:

    # gg "Full."
    gg "满弹。"

# game/Story01.rpy:8160
translate chinese gate4_6ee746cd:

    # o "And you?"
    o "你呢？"

# game/Story01.rpy:8162
translate chinese gate4_38fb36e6:

    # mc "Locked, loaded, and not in the mood to die."
    mc "上膛，满弹，不想死。"

# game/Story01.rpy:8165
translate chinese gate4_2fded262:

    # h "..."
    h "……"

# game/Story01.rpy:8167
translate chinese gate4_90172481:

    # h "Same. Let’s get this over with."
    h "一样。赶紧结束这事。"

# game/Story01.rpy:8169
translate chinese gate4_4601371b:

    # o "He’s right."
    o "他说得对。"

# game/Story01.rpy:8170
translate chinese gate4_3fd15f3a:

    # o "Shortest route’s our only shot."
    o "最短路线是我们唯一的机会。"

# game/Story01.rpy:8171
translate chinese gate4_5b95ee84:

    # g "(whispering) This is insane..."
    g "（低声）这太疯了……"

# game/Story01.rpy:8177
translate chinese gate4_980411a1:

    # o "Right turn ahead."
    o "前面右转。"

# game/Story01.rpy:8179
translate chinese gate4_6602609f:

    # o "No contacts—"
    o "没有接触——"

# game/Story01.rpy:8180
translate chinese gate4_c3703970:

    # o "...wait. Got the entrance."
    o "……等等。找到入口了。"

# game/Story01.rpy:8183
translate chinese gate4_e132ebc4:

    # Mi "So this is it."
    Mi "就是这里。"

# game/Story01.rpy:8186
translate chinese gate4_1fb8a9b5:

    # o "According to the nav, yeah."
    o "导航显示，是的。"

# game/Story01.rpy:8187
translate chinese gate4_047e5603:

    # Mi "…This is their territory."
    Mi "……这是它们的地盘。"

# game/Story01.rpy:8189
translate chinese gate4_deeb3f20:

    # mc "What are we walking into?"
    mc "我们要走进什么？"

# game/Story01.rpy:8195
translate chinese gate4_e1fa2708:

    # Mi "…They didn’t tell you?"
    Mi "……他们没告诉你？"

# game/Story01.rpy:8197
translate chinese gate4_d7abb7b1:

    # mc "Clearly not."
    mc "显然没。"

# game/Story01.rpy:8199
translate chinese gate4_72ccad46:

    # Mi "…You should know."
    Mi "……你该知道。"

# game/Story01.rpy:8201
translate chinese gate4_ba134435:

    # o "Agreed..."
    o "同意……"

# game/Story01.rpy:8202
translate chinese gate4_ce115aa6:

    # o "Tell me…"
    o "告诉我……"

# game/Story01.rpy:8203
translate chinese gate4_d901aade:

    # o "you scared of something big enough to bite your head clean off?"
    o "你怕不怕一口就能把你脑袋咬掉的东西？"

# game/Story01.rpy:8204
translate chinese gate4_68fbc645:

    # mc "Not enough to turn back."
    mc "没怕到要回头。"

# game/Story01.rpy:8206
translate chinese gate4_7619faae:

    # gg "Or we stop talking and just blow it open."
    gg "或者别废话，直接炸开。"

# game/Story01.rpy:8207
translate chinese gate4_fc58015c:

    # g "You and your bombs…"
    g "你就知道炸……"

# game/Story01.rpy:8208
translate chinese gate4_f62a8777:

    # g "It’s already open."
    g "门已经开了。"

# game/Story01.rpy:8210
translate chinese gate4_54d93876:

    # g "Move. Stay close. Eyes up."
    g "走。跟紧。抬头看。"

# game/Story01.rpy:8219
translate chinese gate4_8ab474d6:

    # "Sector 7-S. Level 2. Ventilation drains."
    "7-S区。第二层。通风排水道。"

# game/Story01.rpy:8220
translate chinese gate4_d174b490:

    # h "(whispering) It’s so damn dark… feels like we’re crawling through someone’s ass. Smells like it too."
    h "（低声）黑得要命……像在谁肠子里爬。闻着也像。"

# game/Story01.rpy:8222
translate chinese gate4_0074ff0e:

    # mc "Right behind me."
    mc "跟在我后面。"

# game/Story01.rpy:8224
translate chinese gate4_789b3ff9:

    # o "Eyes up."
    o "抬头看。"

# game/Story01.rpy:8225
translate chinese gate4_5dcecc7e:

    # o "No talking."
    o "别说话。"

# game/Story01.rpy:8226
translate chinese gate4_dd9ab435:

    # o "Comms silent."
    o "通讯静默。"

# game/Story01.rpy:8231
translate chinese gate4_ba30065f:

    # o "Stay sharp."
    o "保持警觉。"

# game/Story01.rpy:8232
translate chinese gate4_baef32c3:

    # o "Crawlers don’t like company."
    o "爬行者不喜欢有伴。"

# game/Story01.rpy:8235
translate chinese gate4_188f59e0:

    # h "You still haven’t told us what those things actually are…"
    h "你还没告诉我们那些东西到底是什么……"

# game/Story01.rpy:8238
translate chinese gate4_65792bbc:

    # Mi "Spiders… in your terms."
    Mi "蜘蛛……按你们的说法。"

# game/Story01.rpy:8241
translate chinese gate4_d06bcfd3:

    # mc "(whispering) Spiders? That’s what we’re worried about?"
    mc "（低声）蜘蛛？我们就怕这个？"

# game/Story01.rpy:8244
translate chinese gate4_e1ec247f:

    # Mi "The smallest ones run about one to five meters."
    Mi "最小的有一到五米。"

# game/Story01.rpy:8245
translate chinese gate4_1e4916dc:

    # mc "...You’re kidding me."
    mc "……你开玩笑吧。"

# game/Story01.rpy:8246
translate chinese gate4_14ac4cdb:

    # Mi "The rest…"
    Mi "其余的……"

# game/Story01.rpy:8249
translate chinese gate4_a335e22c:

    # h "(whispering) Okay… yeah, maybe we turn around? Just saying."
    h "（低声）好吧……也许我们该回头？随口一说。"

# game/Story01.rpy:8250
translate chinese gate4_a14ceb93:

    # mc "(whispering) You scared?"
    mc "（低声）怕了？"

# game/Story01.rpy:8252
translate chinese gate4_48fd7577:

    # mc "(whispering) Yeah. Me too."
    mc "（低声）嗯。我也是。"

# game/Story01.rpy:8254
translate chinese gate4_6fc2f52b:

    # h "(whispering) I really don’t want to see those things, [mc]."
    h "（低声）我真的不想看到那些东西，[mc]。"

# game/Story01.rpy:8255
translate chinese gate4_30edf822:

    # mc "(whispering) Stay close."
    mc "（低声）跟紧。"

# game/Story01.rpy:8256
translate chinese gate4_2fded262_1:

    # h "..."
    h "……"

# game/Story01.rpy:8257
translate chinese gate4_daedd3b9:

    # h "...Yeah."
    h "……嗯。"

# game/Story01.rpy:8259
translate chinese gate4_75b516fd:

    # mc "What is this place supposed to be?"
    mc "这地方是干什么的？"

# game/Story01.rpy:8260
translate chinese gate4_970d503d:

    # o "Ventilation shaft."
    o "通风井。"

# game/Story01.rpy:8261
translate chinese gate4_2f252106:

    # o "Used to push air into the lower city."
    o "以前往下城送风。"

# game/Story01.rpy:8263
translate chinese gate4_c9a66e49:

    # mc "...Used to?"
    mc "……以前？"

# game/Story01.rpy:8264
translate chinese gate4_07abc845:

    # o "..."
    o "……"

# game/Story01.rpy:8265
translate chinese gate4_0d655036:

    # o "...Crawlers."
    o "……爬行者。"

# game/Story01.rpy:8268
translate chinese gate4_3ddf3b65:

    # o "They didn’t like us being here."
    o "它们不喜欢我们待在这儿。"

# game/Story01.rpy:8269
translate chinese gate4_19cd1e24:

    # o "Started sealing everything."
    o "开始封死一切。"

# game/Story01.rpy:8270
translate chinese gate4_50bc492a:

    # o "Webbing the tunnels shut."
    o "用网把隧道封住。"

# game/Story01.rpy:8271
translate chinese gate4_5e3e1f51:

    # o "Anyone who tried to push through…"
    o "任何想强行通过的……"

# game/Story01.rpy:8273
translate chinese gate4_bbaf0e6b:

    # Mi "No survivors."
    Mi "无人生还。"

# game/Story01.rpy:8275
translate chinese gate4_2c167a6a:

    # mc "Then we change that."
    mc "那我们来改写。"

# game/Story01.rpy:8276
translate chinese gate4_ade09a9c:

    # h "(whispering) It’s fine… I’ve got [mc]."
    h "（低声）没事……我有 [mc]。"

# game/Story01.rpy:8279
translate chinese gate4_f98766cd:

    # Mi "(whispering) Hey… Liv. You good?"
    Mi "（低声）嘿……莉芙。你还好吗？"

# game/Story01.rpy:8281
translate chinese gate4_5fe60ddf:

    # h "(whispering) M-me? Yeah… I just... I hate spiders, okay?"
    h "（低声）我……我？嗯……我只是……我讨厌蜘蛛，行吧？"

# game/Story01.rpy:8283
translate chinese gate4_2b35b6fe:

    # mc "..."
    mc "……"

# game/Story01.rpy:8286
translate chinese gate4_22900410:

    # mc "...We’re not alone."
    mc "……我们不孤单。"

# game/Story01.rpy:8288
translate chinese gate4_53daf884:

    # mc "That’s them?"
    mc "是它们？"

# game/Story01.rpy:8290
translate chinese gate4_3002841a:

    # o "What did you—"
    o "你说什——"

# game/Story01.rpy:8291
translate chinese gate4_56ac1680:

    # mc "Ceiling. Look."
    mc "天花板。看。"

# game/Story01.rpy:8295
translate chinese gate4_07abc845_1:

    # o "..."
    o "……"

# game/Story01.rpy:8296
translate chinese gate4_48a7d093:

    # o "Weapons up!"
    o "举枪！"

# game/Story01.rpy:8297
translate chinese gate4_d94117e4:

    # o "Lights on them— NOW!"
    o "照亮它们——现在！"

# game/Story01.rpy:8300
translate chinese gate4_32576952:

    # mc "Now I see why you hesitated…"
    mc "现在我知道你为什么犹豫了……"

# game/Story01.rpy:8302
translate chinese gate4_ff037e60:

    # o "Move! Push through!"
    o "走！冲过去！"

# game/Story01.rpy:8304
translate chinese gate4_571350fe:

    # h "Behind us!"
    h "我们后面！"

# game/Story01.rpy:8314
translate chinese gate4_2b6e83ba:

    # mc "I owe you one."
    mc "我欠你一次。"

# game/Story01.rpy:8316
translate chinese gate4_d7dc3ecd:

    # h "...just like Drake."
    h "……跟德雷克那次一样。"

# game/Story01.rpy:8318
translate chinese gate4_5d73ced1:

    # h "Chaos, smoke, no backup… good times."
    h "混乱、硝烟、没增援……真是好日子。"

# game/Story01.rpy:8322
translate chinese gate4_cf1adef2:

    # mc "Yeah."
    mc "是啊。"

# game/Story01.rpy:8324
translate chinese gate4_eeb99413:

    # mc "Except back then, they didn’t have eight legs and acid blood."
    mc "只是那时候，敌人没八条腿和酸血。"

# game/Story01.rpy:8329
translate chinese gate4_675b131b:

    # g "They’re closing in! We’re surrounded!"
    g "它们围上来了！我们被包围了！"

# game/Story01.rpy:8341
translate chinese gate4_821e1d74:

    # o "Miriel, status?"
    o "米莉尔，情况如何？"

# game/Story01.rpy:8348
translate chinese gate4_82de296b:

    # Mi "One inhibitor left. Almost there!"
    Mi "抑制剂只剩一个。快好了！"

# game/Story01.rpy:8351
translate chinese gate4_c0f8140d:

    # H "All phases complete. Reaper mode activated. Happy hunting, Miss Miriel."
    H "所有阶段完成。收割者模式已激活。狩猎愉快，米莉尔小姐。"

# game/Story01.rpy:8362
translate chinese gate4_e839e47b:

    # H "Task complete. Enemy casualties: 67."
    H "任务完成。敌方伤亡：67。"

# game/Story01.rpy:8367
translate chinese gate4_9381fe3d:

    # H "Warning. Activation code denied. Weapons deactivated."
    H "警告。激活码被拒。武器已停用。"

# game/Story01.rpy:8368
translate chinese gate4_28054f39:

    # Mi "…Every time…"
    Mi "……每次都……"

# game/Story01.rpy:8369
translate chinese gate4_06e9de83:

    # Mi "it gets worse."
    Mi "越来越糟。"

# game/Story01.rpy:8371
translate chinese gate4_367c654f:

    # mc "What was that? She... how did she—?"
    mc "那是什么？她……她怎么做到的——？"

# game/Story01.rpy:8373
translate chinese gate4_4a8ff697:

    # o "She was built for war."
    o "她天生就是为战争造的。"

# game/Story01.rpy:8375
translate chinese gate4_317b2dea:

    # o "Just like you."
    o "和你一样。"

# game/Story01.rpy:8379
translate chinese gate4_850ef128:

    # b "..."
    b "……"

# game/Story01.rpy:8381
translate chinese gate4_9fffb729:

    # h "...That didn’t sound friendly."
    h "……那声音听着不友善。"

# game/Story01.rpy:8383
translate chinese gate4_558e0ff3:

    # o "...That’s bad."
    o "……不妙。"

# game/Story01.rpy:8384
translate chinese gate4_0a5fdb70:

    # o "That’s really bad."
    o "真的很不妙。"

# game/Story01.rpy:8388
translate chinese gate4_0d714f3a:

    # o "RUN!"
    o "跑！"

# game/Story01.rpy:8390
translate chinese gate4_4ff1cef7:

    # mc "What the hell are we running from?!"
    mc "我们他妈在躲什么？！"

# game/Story01.rpy:8392
translate chinese gate4_a5f74e6f:

    # o "Trust me, you don’t want to know."
    o "相信我，你不会想知道的。"

# game/Story01.rpy:8393
translate chinese gate4_1172ff99:

    # o "Move! Now!"
    o "走！现在！"

# game/Story01.rpy:8395
translate chinese gate4_a31e8a1a:

    # mc "(What the hell did we just walk into…?)"
    mc "（我们他妈走进了什么……？）"

# game/Story01.rpy:8403
translate chinese gate4_b4a98409:

    # mc "(…Okay. Now I get it.)"
    mc "（……好吧。现在我懂了。）"

# game/Story01.rpy:8405
translate chinese gate4_c970abee:

    # gg "Over here! Move!"
    gg "这边！快！"

# game/Story01.rpy:8406
translate chinese gate4_e1792f13:

    # gg "We’ll hold it!"
    gg "我们拖住它！"

# game/Story01.rpy:8415
translate chinese gate4_31bf77cd:

    # gg "TAKE THAT, YOU BASTARD!"
    gg "吃这个，混蛋！"

# game/Story01.rpy:8418
translate chinese gate4_5650c0c0:

    # gg "Keep it back!"
    gg "挡住它！"

