    # mc "Let me put it simpler."
    mc "我换个简单的说法。"

# game/Story01.rpy:9273
translate chinese final2_b67d388f:

    # mc "What exactly is in that tomb?"
    mc "那座陵墓里到底有什么？"

# game/Story01.rpy:9274
translate chinese final2_da3fdbf1_3:

    # Mi "..."
    Mi "……"

# game/Story01.rpy:9275
translate chinese final2_c3a7592a:

    # Mi "…Your wife."
