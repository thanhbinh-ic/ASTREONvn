translate chinese final2_d991423c:

    # h "Just the three of us… yeah, I really don’t like this."
    h "就我们三个……说真的，我一点都不喜欢这样。"

# game/Story01.rpy:9241
translate chinese final2_7c284e83:

    # mc "You didn’t bring us here for nothing."
    mc "你不会无缘无故带我们来这儿。"

# game/Story01.rpy:9242
translate chinese final2_19a02689:

    # mc "What did you find?"
    mc "你发现了什么？"

# game/Story01.rpy:9243
translate chinese final2_cdd8127b:

    # Mi "I-I think…"
    Mi "我……我想……"

# game/Story01.rpy:9244
translate chinese final2_c28f49ae:

    # Mi "this is one of the tombs."
    Mi "这是一座陵墓。"

# game/Story01.rpy:9246
translate chinese final2_0b3921a0:

    # h "Mhm… or maybe, we wait for the others?"
    h "嗯……或者，我们等等其他人？"

# game/Story01.rpy:9247
translate chinese final2_afb2456b:

    # h "And maybe not go playing heroes-"
    h "别去逞什么英雄——"

# game/Story01.rpy:9249
translate chinese final2_a6cc360f:

    # Mi "Olivia… this is a tomb."
    Mi "奥利维亚……这是陵墓。"

# game/Story01.rpy:9251
translate chinese final2_2d2b6b42:

    # mc "...She’s got a point."
    mc "……她说得有道理。"

# game/Story01.rpy:9252
translate chinese final2_741fd254:

    # mc "Walking in blind is stupid."
    mc "闭着眼往里闯是蠢。"

# game/Story01.rpy:9254
translate chinese final2_b69f5e29:

    # h "See?! He agrees with me!"
    h "看吧？！他也同意我！"

# game/Story01.rpy:9255
translate chinese final2_da3fdbf1:

    # Mi "..."
    Mi "……"

# game/Story01.rpy:9256
translate chinese final2_5b840b70:

    # Mi "We’re going."
    Mi "我们走。"

# game/Story01.rpy:9257
translate chinese final2_6ccd815b:

    # h "Wha- hey, Mir!"
    h "什——嘿，米儿！"

# game/Story01.rpy:9260
translate chinese final2_da3fdbf1_1:

    # Mi "..."
    Mi "……"

# game/Story01.rpy:9263
