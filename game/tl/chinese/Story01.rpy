translate chinese olivia_fr_scene_d01628f3:

    # L "It’s getting a little suspicious."
    L "这有点可疑了。"

# game/Story01.rpy:8981
translate chinese olivia_fr_scene_1a1ee55c:

    # L "...But I’ll allow it."
    L "……不过我准了。"

# game/Story01.rpy:8982
translate chinese olivia_fr_scene_21f72498:

    # L "Sweetheart, give us a smile."
    L "宝贝，笑一个。"

# game/Story01.rpy:8984
translate chinese olivia_fr_scene_79649a15:

    # h "Like this?"
    h "这样？"

# game/Story01.rpy:8985
translate chinese olivia_fr_scene_850ef128_1:

    # b "..."
    b "……"

# game/Story01.rpy:8986
translate chinese olivia_fr_scene_1ea6310a:

    # L "Mmm… close."
    L "嗯……差不多。"

# game/Story01.rpy:8987
translate chinese olivia_fr_scene_6e24bc48:

    # L "We’ll work on that."
    L "这个我们再练练。"

# game/Story01.rpy:8989
translate chinese olivia_fr_scene_8505e311:

    # mc "She’s got heart."
    mc "她有股劲。"

# game/Story01.rpy:8990
translate chinese olivia_fr_scene_29c1e556:

    # mc "Just… doesn’t quite fit yet."
    mc "就是……还不太合身。"

# game/Story01.rpy:8992
translate chinese olivia_fr_scene_850ef128_2:

    # b "..."
    b "……"

# game/Story01.rpy:8993
translate chinese olivia_fr_scene_46539d89:

    # h "Did I do something wrong?"
    h "我做错什么了吗？"

# game/Story01.rpy:8995
translate chinese olivia_fr_scene_01665cfa:

    # mc "…I don’t say this often… but you’re beautiful."
    mc "……我不常说这种话……但你很漂亮。"

# game/Story01.rpy:8997
translate chinese olivia_fr_scene_a2aaa9ec:

    # h "Wha—"
    h "什——"

# game/Story01.rpy:8998
translate chinese olivia_fr_scene_4910aec6:

    # h "But your wife—"
    h "可你妻子——"

# game/Story01.rpy:9000
translate chinese olivia_fr_scene_63db9107:

    # L "I agree with him."
    L "我同意他。"

# game/Story01.rpy:9002
translate chinese olivia_fr_scene_26265c18:

    # h "Huh?!"
    h "哈？！"

# game/Story01.rpy:9004
translate chinese olivia_fr_scene_847f32f4:

    # mc "Hey… love, mind bringing that over?"
    mc "嘿……亲爱的，把那个拿过来？"

# game/Story01.rpy:9007
translate chinese olivia_fr_scene_1b2a95fd:

    # L "You read my mind."
    L "你懂我。"

# game/Story01.rpy:9009
translate chinese olivia_fr_scene_2b35b6fe_2:

    # mc "..."
    mc "……"

# game/Story01.rpy:9010
translate chinese olivia_fr_scene_2c051c27:

    # mc "...Hey."
    mc "……嘿。"

