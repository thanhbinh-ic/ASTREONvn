    # Mi "Then we move."
    Mi "那我们走。"

# game/Story01.rpy:9154
translate chinese olivia_fr_scene_46b1fc51:

    # mc "Where’s the rush?"
    mc "急什么？"

# game/Story01.rpy:9155
translate chinese olivia_fr_scene_a8ff419a:

    # Mi "I… found tracks."
    Mi "我……发现了脚印。"

# game/Story01.rpy:9156
translate chinese olivia_fr_scene_e5c0b650:

    # mc "(Tracks…?)"
    mc "（脚印……？）"

