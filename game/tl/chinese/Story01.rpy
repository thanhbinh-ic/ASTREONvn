translate chinese olivia_fr_scene_9b1e90b9:

    # mc "(Back then… I had no idea that shy little girl would end up changing everything for us.)"
    mc "（当时……我完全没想到那个害羞的小姑娘会改变我们的一切。）"

# game/Story01.rpy:9024
translate chinese olivia_fr_scene_b8eca3d1:

    # L "Funny, isn’t it?"
    L "有意思，对吧？"

# game/Story01.rpy:9025
translate chinese olivia_fr_scene_6bfb6141:

    # L "Such a small detail… and everything changes."
    L "一个小小的细节……一切都变了。"

