    # Mi "For now… I’ll check the perimeter."
    Mi "现在……我去检查外围。"

# game/Story01.rpy:9101
translate chinese olivia_fr_scene_8f2f84b9:

    # mc "(…Miriel’s been gone too long.)"
    mc "（……米莉尔去太久了。）"

