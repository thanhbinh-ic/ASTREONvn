    mc "……"

# game/Story01.rpy:7081
translate chinese cyberstreet1_bb15f912_1:

    # mc "Flora?"
    mc "弗洛拉？"

# game/Story01.rpy:7082
translate chinese cyberstreet1_2b35b6fe_1:

    # mc "..."
    mc "……"

# game/Story01.rpy:7083
translate chinese cyberstreet1_c6ff6432:

