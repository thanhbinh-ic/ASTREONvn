    # Fl "Try not to keep me waiting."
    Fl "尽量别让我等太久。"

# game/Story01.rpy:3565
translate chinese norman_1_94679376:

    # h "Hey… you okay, Miriel?"
    h "嘿……你没事吧，米莉尔？"

# game/Story01.rpy:3567
translate chinese norman_1_1182069b:

    # Mi "I’m fine… just…"
    Mi "我没事……只是……"

# game/Story01.rpy:3568
translate chinese norman_1_8f08ceb1:

    # Mi "I need to stop by somewhere."
    Mi "我得去个地方。"

# game/Story01.rpy:3570
translate chinese norman_1_95bbf152:

    # mc "Then we’re coming with you."
    mc "那我们跟你一起去。"

# game/Story01.rpy:3575
translate chinese norman_1_50b3fac4:

    # "Sector 6. Command post."
    "6区。指挥所。"

# game/Story01.rpy:3579
translate chinese norman_1_1ae3171c:

    # g "No."
    g "不行。"

# game/Story01.rpy:3580
translate chinese norman_1_b99405b8:

    # Mi "Reason?"
    Mi "理由？"

# game/Story01.rpy:3581
translate chinese norman_1_b0c498d3:

    # g "Listen up, pointy-ears."
    g "听着，尖耳朵。"

# game/Story01.rpy:3582
translate chinese norman_1_23ef4175:

    # g "I don’t give a damn who gave you orders."
    g "我不管谁给你下的命令。"

# game/Story01.rpy:3584
translate chinese norman_1_d27ceb4d:

    # g "I’m in charge here."
    g "这儿我说了算。"

# game/Story01.rpy:3585
translate chinese norman_1_2e1825bf:

    # g "And I’m not authorizing anyone to leave the city. Got it?"
    g "我不会批准任何人出城。明白？"

# game/Story01.rpy:3586
translate chinese norman_1_da3fdbf1_17:

    # Mi "..."
    Mi "……"

# game/Story01.rpy:3587
translate chinese norman_1_cce55af0:

    # g "I don’t hear an answer, pointy-ears."
    g "我没听到回答，尖耳朵。"

# game/Story01.rpy:3589
translate chinese norman_1_c72dd2ac:

    # Mi "Understood."
    Mi "明白。"

# game/Story01.rpy:3591
translate chinese norman_1_e6bb0740:

    # g "Now get the hell out of my office!"
    g "现在滚出我的办公室！"

# game/Story01.rpy:3596
translate chinese norman_1_38aa4fcd:

    # Mi "…Tch."
    Mi "……啧。"

# game/Story01.rpy:3597
translate chinese norman_1_f2674fb4_1:

    # Mi "Let’s go."
    Mi "走。"

# game/Story01.rpy:3600
translate chinese norman_1_017063be:

    # h "Hey, wait, Mir—"
    h "嘿，等等，米儿——"

# game/Story01.rpy:3604
translate chinese norman_1_5f22e5de:

    # g "What are you staring at?"
    g "你看什么看？"

# game/Story01.rpy:3605
translate chinese norman_1_61cd84ef:

    # g "You think that uniform scares me?"
    g "你以为那身制服能吓到我？"

# game/Story01.rpy:3608
translate chinese norman_1_cf3cf208:

    # g "Look at you… fussing over some elf girl..."
    g "看看你……为个精灵丫头忙前忙后……"

# game/Story01.rpy:3609
translate chinese norman_1_a4d8e210:

    # g "Pathetic."
    g "可悲。"

# game/Story01.rpy:3612
translate chinese norman_1_78486174:

    # h "Huh?"
    h "哈？"

# game/Story01.rpy:3613
translate chinese norman_1_e7045a70:

    # h "Say that again, I dare you."
    h "再说一遍，我你敢。"

# game/Story01.rpy:3615
translate chinese norman_1_ce20dbf2:

    # g "Just thinking out loud."
    g "就是自言自语。"

# game/Story01.rpy:3616
translate chinese norman_1_48f033e7:

    # g "Though you’re just like that scientist, just as messed up."
    g "不过你跟那个科学家一样，一样有毛病。"

# game/Story01.rpy:3619
translate chinese norman_1_c328e377:

    # g "What do you—"
    g "你干嘛——"

# game/Story01.rpy:3620
translate chinese norman_1_86fffba8:

    # h "Old man, don’t!"
    h "老头，别！"

# game/Story01.rpy:3624
translate chinese norman_1_fb4495cb:

    # g "Kh—"
    g "咳——"

# game/Story01.rpy:3626
translate chinese norman_1_7ad0b0dd:

    # mc "Apologize."
    mc "道歉。"

# game/Story01.rpy:3628
translate chinese norman_1_73f363fb:

    # g "I- arch"
    g "我——啊"

# game/Story01.rpy:3629
translate chinese norman_1_58455c1e:

    # g "You think this is gonna save you- kh—"
    g "你以为这样能救你——咳——"

# game/Story01.rpy:3632
translate chinese norman_1_42b85d93:

    # mc "…I’m waiting."
    mc "……我等着。"

# game/Story01.rpy:3633
translate chinese norman_1_c6e967da:

    # h "[mc]! That’s enough—"
    h "[mc]！够了——"

# game/Story01.rpy:3634
translate chinese norman_1_090706f5:

    # g "You—"
    g "你——"

# game/Story01.rpy:3635
translate chinese norman_1_fd0a2eaf:

    # g "have no idea who you’re dealing with—"
    g "根本不知道你在惹谁——"

# game/Story01.rpy:3638
translate chinese norman_1_da9c6da3:

    # h "Stop! You’re gonna kill him!"
    h "住手！你要杀了他了！"

# game/Story01.rpy:3640
translate chinese norman_1_a00ecc94:

    # mc "Don’t interfere."
    mc "别插手。"

# game/Story01.rpy:3642
translate chinese norman_1_da3fdbf1_18:

    # Mi "..."
    Mi "……"

# game/Story01.rpy:3645
translate chinese norman_1_6d6f35a2:

    # Mi "(whispering) …That’s enough…"
    Mi "（低声）……够了……"

# game/Story01.rpy:3646
translate chinese norman_1_ccaea03f:

    # g "The hell—kh—"
    g "什么——咳——"

# game/Story01.rpy:3648
translate chinese norman_1_9a5dea4b:

    # g "F-fine—sorry—"
    g "好……好——对不起——"

# game/Story01.rpy:3650
translate chinese norman_1_c63f8ef7:

    # mc "Next time…"
    mc "下次……"

# game/Story01.rpy:3652
translate chinese norman_1_ee4af383:

    # mc "I won’t stop."
    mc "我不会停手。"

# game/Story01.rpy:3655
translate chinese norman_1_7a5fdacd:

    # g "arch-"
    g "啊——"

# game/Story01.rpy:3656
translate chinese norman_1_2b35b6fe_16:

    # mc "..."
    mc "……"

# game/Story01.rpy:3660
translate chinese norman_1_e1efa167:

    # "He coughs, struggling to breathe."
    "他咳嗽，挣扎着喘气。"

# game/Story01.rpy:3661
translate chinese norman_1_7b471f6f:

    # mc "Good."
    mc "很好。"

# game/Story01.rpy:3662
translate chinese norman_1_5efaa59b:

    # mc "Then we understand each other."
    mc "那我们彼此明白了。"

# game/Story01.rpy:3665
translate chinese norman_1_83cf2ac7:

    # g "...you’re gonna regret this."
    g "……你会后悔的。"

# game/Story01.rpy:3667
translate chinese norman_1_f7fc5af8:

    # mc "Let’s go."
    mc "走。"

# game/Story01.rpy:3668
translate chinese norman_1_b4b2fd77:

    # mc "…before he finds his spine again."
    mc "……趁他还没找回胆子。"

# game/Story01.rpy:3672
translate chinese norman_1_6322cd12:

    # h "He deserved to be put in his place."
    h "他活该被收拾。"

# game/Story01.rpy:3674
translate chinese norman_1_d924f228:

    # h "But you weren’t trying to scare him, [mc]."
    h "但你不是想吓唬他，[mc]。"

# game/Story01.rpy:3676
translate chinese norman_1_a5bf82bc:

    # h "You almost killed him."
    h "你差点杀了他。"

# game/Story01.rpy:3678
translate chinese norman_1_5b78dfd4:

    # mc "I stopped."
    mc "我停了。"

# game/Story01.rpy:3680
translate chinese norman_1_968e56b5:

    # h "Only after we told you to."
    h "是我们叫你停你才停的。"

# game/Story01.rpy:3681
translate chinese norman_1_c908963b:

    # h "Now the real question is, how screwed are we?"
    h "现在真正的问题是，我们有多麻烦？"

# game/Story01.rpy:3683
translate chinese norman_1_d48c95a5:

    # h "Mir, what do you think?"
    h "米儿，你怎么看？"

# game/Story01.rpy:3690
translate chinese norman_1_da3fdbf1_19:

    # Mi "..."
    Mi "……"

# game/Story01.rpy:3692
translate chinese norman_1_7ad0b0dd_1:

    # mc "Apologize."
    mc "道歉。"

# game/Story01.rpy:3694
translate chinese norman_1_7a55d386:

    # Mi "(They stood up for me.)"
    Mi "（他们替我出头了。）"

# game/Story01.rpy:3695
translate chinese norman_1_bd44a55b:

    # Mi "(And for a moment… I was afraid he wouldn’t stop.)"
    Mi "（有那么一瞬间……我怕他不会停手。）"

# game/Story01.rpy:3697
translate chinese norman_1_22216d67:

    # h "Mir? Heeey, anyone home?"
    h "米儿？嘿，有人在家吗？"

# game/Story01.rpy:3698
translate chinese norman_1_0de2d20a:

    # Mi "…Mm."
    Mi "……嗯。"

# game/Story01.rpy:3701
translate chinese norman_1_a073b8d6:

    # Mi "…Sorry."
    Mi "……抱歉。"

# game/Story01.rpy:3702
translate chinese norman_1_9b44213c:

    # Mi "I got lost in thought."
    Mi "我走神了。"

# game/Story01.rpy:3704
translate chinese norman_1_2fded262_10:

    # h "..."
    h "……"

# game/Story01.rpy:3705
translate chinese norman_1_fb55105f:

    # h "...Look at her."
    h "……看看她。"

# game/Story01.rpy:3706
translate chinese norman_1_e4903cc1:

    # h "...she’s smiling."
    h "……她在笑。"

# game/Story01.rpy:3707
translate chinese norman_1_d3d48175:

    # mc "I see it."
    mc "我看到了。"

# game/Story01.rpy:3709
translate chinese norman_1_4e16c29b:

    # Mi "I can hear you…"
    Mi "我听得见……"

# game/Story01.rpy:3711
translate chinese norman_1_5dbbf454:

    # h "Good. So… what now?"
    h "好。那……现在怎么办？"

# game/Story01.rpy:3712
translate chinese norman_1_da3fdbf1_20:

    # Mi "..."
    Mi "……"

# game/Story01.rpy:3713
translate chinese norman_1_d717968f:

    # Mi "(…Teacher…?)"
    Mi "（……老师……？）"

# game/Story01.rpy:3716
translate chinese norman_1_e2c9324a:

    # Mi "...What if he refuses?"
    Mi "……要是他拒绝呢？"

# game/Story01.rpy:3719
translate chinese norman_1_2f53364b:

    # a "Take him to Ember. I’ll put in a word for him."
    a "带他去见恩伯。我会替他说句话。"

# game/Story01.rpy:3722
translate chinese norman_1_134321a5:

    # Mi "But why not ask the Madam directly?"
    Mi "但干嘛不直接找夫人？"

# game/Story01.rpy:3725
translate chinese norman_1_7773ea59:

    # a "Do as I say."
    a "照我说的做。"

# game/Story01.rpy:3727
translate chinese norman_1_da3fdbf1_21:

    # Mi "..."
    Mi "……"

# game/Story01.rpy:3728
translate chinese norman_1_f810322d:

    # Mi "(…I understand.)"
    Mi "（……我明白了。）"

# game/Story01.rpy:3729
translate chinese norman_1_f2674fb4_2:

    # Mi "Let’s go."
    Mi "走。"

# game/Story01.rpy:3739
translate chinese sectors_ruin_ad29808a:

    # mc "(…That’s… on a whole different scale.)"
    mc "（……那……完全是另一个量级。）"

# game/Story01.rpy:3740
translate chinese sectors_ruin_106d5f40:

    # mc "(But…)"
    mc "（但是……）"

# game/Story01.rpy:3741
translate chinese sectors_ruin_2170b42f:

    # mc "Miriel?"
    mc "米莉尔？"

# game/Story01.rpy:3744
translate chinese sectors_ruin_0c14303e:

    # mc "What are those ruins out there…?"
    mc "外面那些废墟是什么……？"

# game/Story01.rpy:3748
translate chinese sectors_ruin_27665ec8:

    # Mi "...buried by time and war."
    Mi "……被时间和战争掩埋的。"

# game/Story01.rpy:3751
translate chinese sectors_ruin_3d0ad226:

    # mc "...A graveyard…"
    mc "……一座墓地……"

# game/Story01.rpy:3752
translate chinese sectors_ruin_da3fdbf1:

    # Mi "..."
    Mi "……"

# game/Story01.rpy:3754
translate chinese sectors_ruin_8b1f3d25:

    # Mi "Tombs."
    Mi "陵墓。"

# game/Story01.rpy:3755
translate chinese sectors_ruin_9c94c371:

    # mc "And Lora… she works there?"
    mc "那洛拉……在那儿工作？"

# game/Story01.rpy:3756
translate chinese sectors_ruin_562667b7:

    # Mi "…Yes."
    Mi "……对。"

# game/Story01.rpy:3758
translate chinese sectors_ruin_79c068cb:

    # "(Olivia snores softly.)"
    "（奥利维亚轻轻打着鼾。）"

    # game/Story01.rpy:3760
translate chinese sectors_ruin_ccd1afc8:

    # mc "(whispering) …She’s worn out."
    mc "（低声）……她累坏了。"

# game/Story01.rpy:3762
translate chinese sectors_ruin_3455e181:

    # Mi "[mc]?"
    Mi "[mc]？"

# game/Story01.rpy:3763
translate chinese sectors_ruin_c6131d2f:

    # Mi "(whispering) About what happened with the commander…"
    Mi "（低声）关于指挥官那件事……"

# game/Story01.rpy:3764
translate chinese sectors_ruin_555d3b37:

    # Mi "(whispering) Thank you."
    Mi "（低声）谢谢你。"

# game/Story01.rpy:3765
translate chinese sectors_ruin_1d686b3f:

    # Mi "(whispering) But next time… stop when I ask you to."
    Mi "（低声）但下次……我叫你停就停。"

# game/Story01.rpy:3767
translate chinese sectors_ruin_c4ce3648:

    # mc "(whispering) I will."
    mc "（低声）我会的。"

# game/Story01.rpy:3768
translate chinese sectors_ruin_fa6bda10:

    # mc "(whispering) We’re a team. Remember?"
    mc "（低声）我们是一队的。记得吗？"

# game/Story01.rpy:3770
translate chinese sectors_ruin_fb12b2e7:

    # Mi "Yes..."
    Mi "记得……"

# game/Story01.rpy:3782
translate chinese taxi_3f305232:

    # "Sector 5-S. Third level. Residential zone."
    "5-S区。第三层。居住区。"

# game/Story01.rpy:3783
translate chinese taxi_3aa4e106:

    # Fl "(Where is she?)"
    Fl "（她在哪？）"

# game/Story01.rpy:3785
translate chinese taxi_b7a89e94:

    # h "So what, we just sit around and wait for Lora to come back on her own?"
    h "那怎么办，我们就干坐着等洛拉自己回来？"

# game/Story01.rpy:3786
translate chinese taxi_c5b28ee6:

    # h "And what about that desert trip you promised?!"
    h "还有你答应的沙漠之行呢？！"

# game/Story01.rpy:3787
translate chinese taxi_91c20d65:

    # Mi "The commander revoked our clearance after what happened."
    Mi "那事之后，指挥官撤销了我们的通行权限。"

# game/Story01.rpy:3789
translate chinese taxi_322e620a:

    # h "Gee, wonder whose fault that is, huh, [mc]?"
    h "哎哟，不知道这是谁的锅呢，[mc]？"

# game/Story01.rpy:3790
translate chinese taxi_7501a703:

    # mc "He crossed the line."
    mc "他越线了。"

# game/Story01.rpy:3791
translate chinese taxi_d0e800d0:

    # Mi "And now the official route to Lora’s tomb is closed."
    Mi "现在去洛拉陵墓的官方路线也封了。"

# game/Story01.rpy:3793
translate chinese taxi_75ceb83f:

    # mc "…That part is on me."
    mc "……这部分算我的。"

# game/Story01.rpy:3796
translate chinese taxi_ff79cae4:

    # h "Ahem… anyway. What now?"
    h "咳……总之。现在怎么办？"

# game/Story01.rpy:3797
translate chinese taxi_a1b613f4:

    # Mi "The lower city."
    Mi "下城区。"

# game/Story01.rpy:3800
translate chinese taxi_6ab51eab:

    # mc "Why there?"
    mc "为什么去那儿？"

# game/Story01.rpy:3803
translate chinese taxi_7026f305:

    # h "Astoria controls the upper sectors. The Inquisition follows its own chain of command."
    h "阿斯托里亚控制上城区。审判庭有自己的指挥体系。"

# game/Story01.rpy:3804
translate chinese taxi_c14687a9:

    # h "Down there, neither of them matters much."
    h "在那下面，两边都管不着。"

# game/Story01.rpy:3806
translate chinese taxi_f7290470:

    # mc "Who does?"
    mc "那谁说了算？"

# game/Story01.rpy:3807
translate chinese taxi_86cd1c28:

    # Mi "Emberlyn. Most people call her Ember."
    Mi "恩伯琳。大部分人都叫她恩伯。"

# game/Story01.rpy:3808
translate chinese taxi_4df50cd5:

    # Mi "If you want an unofficial route to Lora’s tomb, you need her."
    Mi "想要去洛拉陵墓的非官方路线，就得找她。"

# game/Story01.rpy:3811
translate chinese taxi_f0c7e7c1:

    # h "Fine. While you chase Lora, I’m finding out who sent Norman into that forest."
    h "行。你去追洛拉，我去查是谁把诺曼派进那片森林的。"

# game/Story01.rpy:3812
translate chinese taxi_e736c13d:

    # mc "You’re not doing that alone."
    mc "你不能一个人去。"

# game/Story01.rpy:3813
translate chinese taxi_acd016e8:

    # h "Wasn’t asking."
    h "我没问你。"

# game/Story01.rpy:3814
translate chinese taxi_e0319edd:

    # Mi "And I need to know why my teacher sent us to Ember instead of the Madam."
    Mi "我得知道我老师为什么让我们去找恩伯而不是夫人。"

# game/Story01.rpy:3817
translate chinese taxi_240bea84:

    # mc "Then we all have a reason to go."
    mc "那我们都有理由去。"

# game/Story01.rpy:3820
translate chinese taxi_282d5e26:

    # Mi "But first, Flora."
    Mi "但首先，弗洛拉。"

# game/Story01.rpy:3821
translate chinese taxi_1b000af4:

    # Mi "The best mechanic in the city."
    Mi "全城最好的机械师。"

# game/Story01.rpy:3824
translate chinese taxi_2d5d4c48:

    # Mi "Brilliant, if a little—"
    Mi "聪明，就是有点——"

# game/Story01.rpy:3826
translate chinese taxi_2bec6303:

    # h "—Intolerable?"
    h "——让人受不了？"

# game/Story01.rpy:3828
translate chinese taxi_da3fdbf1:

    # Mi "..."
    Mi "……"

# game/Story01.rpy:3830
translate chinese taxi_e2e85998:

    # Mi "I was going to say ‘prickly.’"
    Mi "我本来想说‘刺头’。"

# game/Story01.rpy:3831
translate chinese taxi_7e68eafd:

    # Mi "But yes… teamwork isn’t exactly her strength."
    Mi "不过没错……团队合作不是她的强项。"

# game/Story01.rpy:3833
translate chinese taxi_ccb9ca07:

    # h "Mir, because of her the old man lost his head."
    h "米儿，因为她，老头差点没命。"

# game/Story01.rpy:3834
translate chinese taxi_d7ffaed1:

    # h "I’m not getting involved with her. No way."
    h "我不跟她掺和。绝不。"

# game/Story01.rpy:3836
translate chinese taxi_da3fdbf1_1:

    # Mi "..."
    Mi "……"

# game/Story01.rpy:3838
translate chinese taxi_2786cb19:

    # Mi "Even so… the fact remains."
    Mi "就算这样……事实摆在眼前。"

# game/Story01.rpy:3839
translate chinese taxi_01cb3419:

    # Mi "She’s the best at what she does."
    Mi "她干这行是最强的。"

# game/Story01.rpy:3841
translate chinese taxi_e7e3c7f8:

    # h "The best? Sure, I won’t argue that. But I’m not working with her."
    h "最强？行，我不争。但我不跟她共事。"

# game/Story01.rpy:3843
translate chinese taxi_996589af:

    # mc "Olivia, that’s enough."
    mc "奥利维亚，够了。"

# game/Story01.rpy:3845
translate chinese taxi_2fded262:

    # h "..."
    h "……"

# game/Story01.rpy:3847
translate chinese taxi_c83ab4d8:

    # mc "Listen. You don’t have to like her, just ignore her. Alright?"
    mc "听着。你不用喜欢她，无视她就行。行吗？"

# game/Story01.rpy:3849
translate chinese taxi_bfb50083:

    # Mi "If she steps out of line… I’ll deal with it."
    Mi "她要是越线……我来处理。"

# game/Story01.rpy:3850
translate chinese taxi_4d7f36a5:

    # Mi "I promise."
    Mi "我保证。"

# game/Story01.rpy:3852
translate chinese taxi_21baffc2:

    # h "Fine. I’ll play nice."
    h "行。我配合。"

# game/Story01.rpy:3854
translate chinese taxi_55d6efc4:

    # Fl "Hey, shorty. I told you, fix that look on your face."
    Fl "嘿，矮子。我说过了，把你那表情收一收。"

# game/Story01.rpy:3855
translate chinese taxi_2fded262_1:

    # h "..."
    h "……"

# game/Story01.rpy:3856
translate chinese taxi_fcf10a23:

    # h "You hear that?"
    h "你听见了吗？"

# game/Story01.rpy:3859
translate chinese taxi_24cfb175:

    # h "You got a problem or something?"
    h "你有意见还是怎么着？"

# game/Story01.rpy:3861
translate chinese taxi_b4ae3eea:

    # Fl "It’s your attitude, shorty."
    Fl "是你的态度，矮子。"

# game/Story01.rpy:3862
translate chinese taxi_a282f71e:

    # Fl "...Not a fan of that tone."
    Fl "……我不喜欢这语气。"

# game/Story01.rpy:3864
translate chinese taxi_bc19f712:

    # mc "(This is spiraling. Fast.)"
    mc "（这事在迅速失控。）"

# game/Story01.rpy:3867
translate chinese taxi_5b17c96e:

    # h "I’m not scared of you—"
    h "我不怕你——"

# game/Story01.rpy:3869
translate chinese taxi_559978ae:

    # mc "Olivia, please."
    mc "奥利维亚，拜托。"

# game/Story01.rpy:3871
translate chinese taxi_f094d120:

    # h "(whispering) Let me handle this."
    h "（低声）让我来。"

# game/Story01.rpy:3872
translate chinese taxi_2b35b6fe:

    # mc "..."
    mc "……"

# game/Story01.rpy:3873
translate chinese taxi_cf94f2b1:

    # mc "…Fine."
    mc "……行。"

# game/Story01.rpy:3875
translate chinese taxi_07e6fd38:

    # h "Hey, stretch, let’s get one thing straight."
    h "嘿，竹竿，我们把话说清楚。"

# game/Story01.rpy:3876
translate chinese taxi_c166bd39:

    # h "You stay out of my way, I stay out of yours."
    h "你别碍我事，我不碍你事。"

# game/Story01.rpy:3877
translate chinese taxi_41da62cb:

    # Fl "..."
    Fl "……"

# game/Story01.rpy:3879
translate chinese taxi_63924ebd:

    # Fl "What did you just call me?"
    Fl "你刚叫我什么？"

# game/Story01.rpy:3880
translate chinese taxi_f5ea6e26:

    # h "...Seriously?"
    h "……认真的？"

# game/Story01.rpy:3881
translate chinese taxi_53177d11:

    # h "Alright. Stretch."
    h "行。竹竿。"

# game/Story01.rpy:3882
translate chinese taxi_009adb85:

    # Fl "Say that again."
    Fl "再说一遍。"

# game/Story01.rpy:3884
translate chinese taxi_41b3f0cd:

    # Fl "...to my face."
    Fl "……当我面说。"

# game/Story01.rpy:3886
translate chinese taxi_fbe15437:

    # Mi "Calm down. Don’t do anything stupid."
    Mi "冷静。别干蠢事。"

# game/Story01.rpy:3889
translate chinese taxi_41da62cb_1:

    # Fl "..."
    Fl "……"

# game/Story01.rpy:3890
translate chinese taxi_2fded262_2:

    # h "..."
    h "……"

# game/Story01.rpy:3892
translate chinese taxi_42af7219:

    # h "Wow… height issues? That’s rich."
    h "哇……身高问题？真有意思。"

# game/Story01.rpy:3894
translate chinese taxi_1dd2bc71:

    # Fl "Shorty."
    Fl "矮子。"

# game/Story01.rpy:3896
translate chinese taxi_5b93fc3b:

    # h "Streeetch."
    h "竹——竿。"

# game/Story01.rpy:3904
translate chinese taxi_37e60944:

    # mc "Enough!"
    mc "够了！"

# game/Story01.rpy:3906
translate chinese taxi_408a01c6:

    # h "She’s the one starting shit."
    h "是她先挑事的。"

# game/Story01.rpy:3908
translate chinese taxi_2ee80ce6:

    # Mi "Why did you provoke her?"
    Mi "你干嘛激她？"

# game/Story01.rpy:3909
translate chinese taxi_6c4b6fc6:

    # h "Hey, she started it!"
    h "嘿，是她先的！"

# game/Story01.rpy:3910
translate chinese taxi_41da62cb_2:

    # Fl "..."
    Fl "……"

# game/Story01.rpy:3912
translate chinese taxi_3677e2ff:

    # Fl "(…That was reckless.)"
    Fl "（……太莽了。）"

# game/Story01.rpy:3913
translate chinese taxi_331809ce:

    # mc "Liv."
    mc "莉芙。"

# game/Story01.rpy:3915
translate chinese taxi_64ce44c7:

    # mc "You went too far."
    mc "你过分了。"

# game/Story01.rpy:3916
translate chinese taxi_2b35b6fe_1:

    # mc "..."
    mc "……"

# game/Story01.rpy:3917
translate chinese taxi_0de8c704:

    # h "...sorry."
    h "……抱歉。"

# game/Story01.rpy:3921
translate chinese taxi_da3fdbf1_2:

    # Mi "..."
    Mi "……"

# game/Story01.rpy:3922
translate chinese taxi_1ce30028:

    # Mi "…We’ll split up."
    Mi "……我们分开走。"

# game/Story01.rpy:3923
translate chinese taxi_5855f5f4:

    # Mi "I’ll send Flora the data."
    Mi "我把数据发给弗洛拉。"

# game/Story01.rpy:3924
translate chinese taxi_ea22f38c:

    # Mi "She’ll brief you on the way."
    Mi "路上她会跟你说明。"

# game/Story01.rpy:3927
translate chinese taxi_39588ca6:

    # Mi "Liv, you’re with me."
    Mi "莉芙，你跟我。"

# game/Story01.rpy:3928
translate chinese taxi_cdb9d8a3:

    # h "Hey, but sending him with—"
    h "嘿，但让他跟——"

# game/Story01.rpy:3931
translate chinese taxi_5549c387:

    # h "(whispering) No… she’s right. What was I thinking…"
    h "（低声）不……她说得对。我刚才想什么呢……"

# game/Story01.rpy:3933
translate chinese taxi_fa815d9b:

    # Mi "Sorry for the inconvenience."
    Mi "抱歉添麻烦了。"

# game/Story01.rpy:3934
translate chinese taxi_965eac42:

    # Mi "I’ll speak with your father later."
    Mi "回头我跟你父亲谈。"

# game/Story01.rpy:3936
translate chinese taxi_29555808:

    # Fl "It’s fine."
    Fl "没事。"

# game/Story01.rpy:3937
translate chinese taxi_369f16c5:

    # Fl "I like stacking debts on him."
    Fl "我喜欢往他身上堆人情债。"

# game/Story01.rpy:3938
translate chinese taxi_413c9423:

    # Fl "He pays them back. Eventually."
    Fl "他迟早会还的。"

# game/Story01.rpy:3940
translate chinese taxi_c8559424:

    # mc "You look way too calm."
    mc "你看着也太淡定了。"

# game/Story01.rpy:3942
translate chinese taxi_0ba826c7:

    # Fl "After that punch…"
    Fl "那一拳之后……"

# game/Story01.rpy:3944
translate chinese taxi_21ef3132:

    # Fl "I decided not to test her limits."
    Fl "我决定不去试探她的底线。"

# game/Story01.rpy:3945
translate chinese taxi_123ab226:

    # Fl "Figured I’d cool it."
    Fl "想想还是算了。"

# game/Story01.rpy:3947
translate chinese taxi_e1398bb7:

    # mc "That’s it? You just… decided to calm down?"
    mc "就这样？你就……决定冷静了？"

# game/Story01.rpy:3949
translate chinese taxi_78f49786:

    # Fl "I ran the risk. Made the call."
    Fl "我评估了风险。做了判断。"

# game/Story01.rpy:3950
translate chinese taxi_99844e9e:

    # Fl "Oh! Perfect example, actually."
    Fl "哦！正好是个好例子。"

# game/Story01.rpy:3952
translate chinese taxi_589f8e3f:

    # Fl "Remember that. You’ll need it where we’re going."
    Fl "记住这个。我们去的地方用得上。"

# game/Story01.rpy:3953
translate chinese taxi_41d8c094:

    # Fl "Come on."
    Fl "来吧。"

# game/Story01.rpy:3954
translate chinese taxi_6015c856:

    # Fl "We’ve got work to do."
    Fl "有活要干。"

# game/Story01.rpy:3969
translate chinese flashback_2fded262:

    # h "..."
    h "……"

# game/Story01.rpy:3972
translate chinese flashback_9a81b818:

    # Mi "Hey, Liv…"
    Mi "嘿，莉芙……"

# game/Story01.rpy:3973
translate chinese flashback_11345315:

    # Mi "Are you alright?"
    Mi "你还好吗？"

# game/Story01.rpy:3976
translate chinese flashback_4ff02231:

    # h "Hm? Yeah."
    h "嗯？还好。"

# game/Story01.rpy:3977
translate chinese flashback_e682c0fb:

    # h "Just… something from my past."
    h "就是……想起点过去的事。"

# game/Story01.rpy:3979
translate chinese flashback_232433a1:

    # h "So… what did you want to talk about, Mir?"
    h "那……你想聊什么，米儿？"

# game/Story01.rpy:3984
translate chinese flashback_375ef5ab:

    # Mi "Why… are you so attached to him?"
    Mi "你为什么……对他那么上心？"

# game/Story01.rpy:3987
translate chinese flashback_7e24dc79:

    # h "You mean the old man?"
    h "你是说那老头？"

# game/Story01.rpy:3988
translate chinese flashback_c2615a64:

    # h "Since when are you so curious?"
    h "你什么时候这么好奇了？"

# game/Story01.rpy:3990
translate chinese flashback_b10fb890:

    # Mi "You and him…"
    Mi "你和他……"

# game/Story01.rpy:3992
translate chinese flashback_6619e696:

    # Mi "It’s more than just a team."
    Mi "不只是队友。"

# game/Story01.rpy:3995
translate chinese flashback_53a7e195:

    # h "Well, look at that…"
    h "哟，看看这个……"

# game/Story01.rpy:3996
translate chinese flashback_48013837:

    # h "Mir, you’re getting curious."
    h "米儿，你开始好奇了。"

# game/Story01.rpy:4000
translate chinese flashback_a735d2b7:

    # h "You know… it’s a long story."
    h "你知道……说来话长。"

# game/Story01.rpy:4002
translate chinese flashback_dde3b983:

    # Mi "…I understand."
    Mi "……我明白。"

# game/Story01.rpy:4006
translate chinese flashback_2fded262_1:

    # h "..."
    h "……"

# game/Story01.rpy:4008
translate chinese flashback_505436df:

    # h "Before I start… tell me something."
    h "开始之前……告诉我一件事。"

# game/Story01.rpy:4009
translate chinese flashback_3bf5d57d:

    # h "What are we to you?"
    h "我们对你来说算什么？"

# game/Story01.rpy:4011
translate chinese flashback_da3fdbf1:

    # Mi "..."
    Mi "……"

# game/Story01.rpy:4012
translate chinese flashback_5b9b857f:

    # Mi "…A team, I suppose."
    Mi "……算是……一队人吧。"

# game/Story01.rpy:4017
translate chinese flashback_6d0baa06:

    # h "Huh… funny. You used to be against that."
    h "哈……有意思。你以前可不认这个。"

# game/Story01.rpy:4019
translate chinese flashback_6c6b411e:

    # h "So what changed?"
    h "那什么变了？"

# game/Story01.rpy:4021
translate chinese flashback_49d9bad7:

    # Mi "You showed me…"
    Mi "你用行动……"

# game/Story01.rpy:4023
translate chinese flashback_cad2aaeb:

    # Mi "Through your actions."
    Mi "告诉了我。"

# game/Story01.rpy:4025
translate chinese flashback_2fded262_2:

    # h "..."
    h "……"

# game/Story01.rpy:4026
translate chinese flashback_a6197252:

    # h "Well… yeah. The story."
    h "嗯……是啊。故事。"

# game/Story01.rpy:4027
translate chinese flashback_9c7ee7a0:

    # h "Long story short… I owe him."
    h "长话短说……我欠他的。"

# game/Story01.rpy:4029
translate chinese flashback_e156b1f4:

    # h "But if I’m being honest…"
    h "但说实话……"

# game/Story01.rpy:4033
translate chinese flashback_fe3e11f5:

    # h "It started long before we ever met."
    h "这事在我们认识之前就开始了。"

# game/Story01.rpy:4037
translate chinese flashback_183aa567:

    # h "We were poor."
    h "我们很穷。"

# game/Story01.rpy:4038
translate chinese flashback_b3e147ad:

    # h "The kind that sticks to your bones and doesn’t let go."
    h "穷到骨子里，甩都甩不掉。"

# game/Story01.rpy:4039
translate chinese flashback_749dcec9:

    # h "I don’t remember my father."
    h "我不记得我爸。"

# game/Story01.rpy:4040
translate chinese flashback_3a2e496c:

    # h "And honestly? Good."
    h "说实话？挺好。"

# game/Story01.rpy:4042
translate chinese flashback_2a27b5dd:

    # h "He was a bastard."
    h "他是个混蛋。"

# game/Story01.rpy:4043
translate chinese flashback_18f0f211:

    # h "Only decent thing he ever did was pay off our debts… then disappear."
    h "他唯一做的好事就是还清了债……然后消失了。"

# game/Story01.rpy:4045
translate chinese flashback_797975e7:

    # h "Mom handled the rest."
    h "剩下的都是妈妈扛的。"

# game/Story01.rpy:4046
translate chinese flashback_d23e5513:

    # h "Took whatever work she could get."
    h "什么活都接。"

# game/Story01.rpy:4047
translate chinese flashback_6c3f685d:

    # h "Cleaning. Lifting. Bleeding hands and sleepless nights."
    h "清洁。搬运。流血的手，无眠的夜。"

# game/Story01.rpy:4048
translate chinese flashback_997484cc:

    # h "Still smiled through it."
    h "但她还是笑着撑过去了。"

# game/Story01.rpy:4049
translate chinese flashback_3021dd45:

    # h "Kept saying we had to live. Laugh."
    h "总说我们得活下去。得笑。"

# game/Story01.rpy:4050
translate chinese flashback_7ed46fcc:

    # h "But mom didn’t last long."
    h "但妈妈没撑多久。"

# game/Story01.rpy:4051
translate chinese flashback_7afa7f7c:

    # h "Work took everything out of her."
    h "工作把她掏空了。"

# game/Story01.rpy:4054
translate chinese flashback_2fded262_3:

    # h "..."
    h "……"

# game/Story01.rpy:4056
translate chinese flashback_f4661d75:

    # h "School?"
    h "学校？"

# game/Story01.rpy:4057
translate chinese flashback_faf2dd05:

    # h "Hell."
    h "地狱。"

# game/Story01.rpy:4058
translate chinese flashback_2ecaca54:

    # h "Bullies. Looks. Whispers."
    h "霸凌。眼神。窃窃私语。"

# game/Story01.rpy:4060
translate chinese flashback_c140262a:

    # h "Changed schools more times than I can count."
    h "转学次数多到数不清。"

# game/Story01.rpy:4062
translate chinese flashback_d2cd358a:

    # h "Truth is… I didn’t transfer."
    h "真相是……我不是转学。"

# game/Story01.rpy:4063
translate chinese flashback_e8253b49:

    # h "I got kicked out."
    h "我是被开除的。"

# game/Story01.rpy:4067
translate chinese flashback_996ae6ce:

    # h "Who's the ugly little freak now, huh?! Come on, say something!"
    h "现在谁才是丑八怪，啊？！来啊，说话啊！"

# game/Story01.rpy:4070
translate chinese flashback_da3fdbf1_1:

    # Mi "..."
    Mi "……"

# game/Story01.rpy:4072
translate chinese flashback_acd0c2e2:

    # Mi "That explains... {w=0.7}a lot."
    Mi "那就解释了……{w=0.7}很多事。"

# game/Story01.rpy:4074
translate chinese flashback_f0d9dee1:

    # h "That anger?"
    h "那股火？"

# game/Story01.rpy:4075
translate chinese flashback_3eb0888f:

    # h "Wasn’t about me."
    h "不是为我。"

# game/Story01.rpy:4076
translate chinese flashback_fa3178b0:

    # h "It was about her."
    h "是为她。"

# game/Story01.rpy:4077
translate chinese flashback_3f511f84:

    # h "My sister."
    h "我妹妹。"

# game/Story01.rpy:4079
translate chinese flashback_4fc33752:

    # h "Nobody touches her."
    h "谁都不许碰她。"

# game/Story01.rpy:4080
translate chinese flashback_f5a0223f:

    # h "Ever."
    h "永远。"

# game/Story01.rpy:4083
translate chinese flashback_51859c3f:

    # h "I'm home."
    h "我回来了。"

# game/Story01.rpy:4085
translate chinese flashback_1e06cad9:

    # C "You’re late."
    C "你回来晚了。"

# game/Story01.rpy:4086
translate chinese flashback_a8c25438:

    # C "Something happen?"
    C "出什么事了？"

# game/Story01.rpy:4088
translate chinese flashback_ab2a12dd:

    # h "Nah, nothing serious."
    h "没，没什么大事。"

# game/Story01.rpy:4089
translate chinese flashback_14dcacdd:

    # h "Just had to deal with a couple of idiots."
    h "就收拾了两个蠢货。"

# game/Story01.rpy:4090
translate chinese flashback_a871fd87:

    # h "Don’t worry."
    h "别担心。"

# game/Story01.rpy:4091
translate chinese flashback_6659bfc9:

    # h "Handled it."
    h "处理好了。"

# game/Story01.rpy:4093
translate chinese flashback_ac164e2c:

    # C "Well… if you say it’s nothing, I’ll pretend I believe you."
    C "行……你说没事，我就假装信你。"

# game/Story01.rpy:4094
translate chinese flashback_c2399158:

    # C "Just hope your ‘nothing’ didn’t end with someone in a hospital."
    C "只希望你那个‘没事’没闹到有人进医院。"

# game/Story01.rpy:4096
translate chinese flashback_451bd87e:

    # C "Because if they decide to press charges..."
    C "因为他们要是决定起诉……"

# game/Story01.rpy:4097
translate chinese flashback_2d0d25ba:

    # C "We’re screwed. You know that, right?"
    C "我们就完了。你知道吧？"

# game/Story01.rpy:4099
translate chinese flashback_1dc438d9:

    # h "Oh?"
    h "哦？"

# game/Story01.rpy:4100
translate chinese flashback_5eeeab74:

    # h "Is that concern I’m hearing?"
    h "我听到的是关心吗？"

# game/Story01.rpy:4101
translate chinese flashback_26ba2297:

    # h "Wow… my little sister’s going soft on me."
    h "哇……我妹妹对我心软了。"

# game/Story01.rpy:4102
translate chinese flashback_63b26657:

    # h "Cute."
    h "可爱。"

# game/Story01.rpy:4104
translate chinese flashback_550b5436:

    # h "(She always felt older than me.)"
    h "（她总像比我大。）"

# game/Story01.rpy:4105
translate chinese flashback_d22cbc48:

    # h "(Smarter.)"
    h "（比我聪明。）"

# game/Story01.rpy:4106
translate chinese flashback_c1065107:

    # h "(Sharper.)"
    h "（比我敏锐。）"

# game/Story01.rpy:4107
translate chinese flashback_fcb03d7d:

    # h "(Saw things I didn’t.)"
    h "（看得比我透。）"

# game/Story01.rpy:4109
translate chinese flashback_06419996:

    # h "…I got lucky, you know that?"
    h "……我运气好，你知道吗？"

# game/Story01.rpy:4111
translate chinese flashback_03b52ab0:

    # h "Without you… I’d be screwed."
    h "没你……我就完了。"

# game/Story01.rpy:4113
translate chinese flashback_15539f3a:

    # h "Probably dead."
    h "可能早就死了。"

# game/Story01.rpy:4114
translate chinese flashback_180df5f2:

    # h "Or worse."
    h "或者更惨。"

# game/Story01.rpy:4118
translate chinese flashback_86de1bdf:

    # h "…Hey."
    h "……嘿。"

# game/Story01.rpy:4119
translate chinese flashback_54549f74:

    # h "What’s up?"
    h "怎么了？"

# game/Story01.rpy:4121
translate chinese flashback_a69b8b50:

    # C "I KNEW IT!"
    C "我就知道！"

# game/Story01.rpy:4122
translate chinese flashback_08887c5e:

    # C "That smell, your sleeves! That’s blood again, isn’t it?!"
    C "这味道，你袖子！又是血，对吧？！"

# game/Story01.rpy:4124
translate chinese flashback_29c064ed:

    # C "You got into another fight? Seriously?!"
    C "你又打架了？认真的？！"

# game/Story01.rpy:4125
translate chinese flashback_0b9603af:

    # C "How many times are we doing this?!"
    C "这事要重复多少次？！"

# game/Story01.rpy:4126
translate chinese flashback_15313ac9:

    # C "Sit. Down."
    C "坐下。"

# game/Story01.rpy:4127
translate chinese flashback_401113b1:

    # C "Don’t argue, I’m getting the med kit."
    C "别争，我去拿医药箱。"

# game/Story01.rpy:4128
translate chinese flashback_a3b0a5c5:

    # C "Last thing we need is you rotting from an infection."
    C "我们最不需要的就是你感染烂掉。"

# game/Story01.rpy:4130
translate chinese flashback_6789f0f3:

    # Mi "She really cares for you."
    Mi "她真的很在乎你。"

# game/Story01.rpy:4132
translate chinese flashback_8e4658e4:

    # h "After that…"
    h "那之后……"

# game/Story01.rpy:4134
translate chinese flashback_a50f3c48:

    # h "She was all I had."
    h "我就只剩她了。"

# game/Story01.rpy:4136
translate chinese flashback_a120d698:

    # C "So? What was it this time?"
    C "说吧？这次又是什么？"

# game/Story01.rpy:4137
translate chinese flashback_97fc62d6:

    # C "Was there really no other way?"
    C "真没别的办法？"

# game/Story01.rpy:4138
translate chinese flashback_fdf08afd:

    # C "Or do your fists just solve everything now?"
    C "还是现在你拳头能解决一切了？"

# game/Story01.rpy:4140
translate chinese flashback_6cc515fb:

    # h "I’m sorry..."
    h "对不起……"

# game/Story01.rpy:4142
translate chinese flashback_40ee8f43:

    # C "Hey, look at me when I’m talking to you!"
    C "嘿，我跟你说话看着我！"

# game/Story01.rpy:4144
translate chinese flashback_406ac9eb:

    # h "(I had a plan. A stupid one.)"
    h "（我有个计划。很蠢的计划。）"

# game/Story01.rpy:4145
translate chinese flashback_c460c903:

    # h "(Drop out. Get a job.)"
    h "（退学。找工作。）"

# game/Story01.rpy:4146
translate chinese flashback_4c7178f3:

    # h "(Help us survive.)"
    h "（帮我们活下去。）"

# game/Story01.rpy:4147
translate chinese flashback_478582b3:

    # h "(Pay for Anya’s future.)"
    h "（供安雅的未来。）"

# game/Story01.rpy:4149
translate chinese flashback_71d281f2:

    # h "Anya..."
    h "安雅……"

# game/Story01.rpy:4151
translate chinese flashback_6e3a2a53:

    # C "What?"
    C "什么？"

# game/Story01.rpy:4153
translate chinese flashback_108b57fa:

    # h "What if I just quit school and got a job?"
    h "要不我退学去找份工作？"

# game/Story01.rpy:4154
translate chinese flashback_c6d3564b:

    # h "Help Mom out a bit… take some weight off her."
    h "帮妈妈分担点……减轻她的负担。"

# game/Story01.rpy:4155
translate chinese flashback_b42633c4:

    # h "We could save up."
    h "我们可以攒钱。"

# game/Story01.rpy:4156
translate chinese flashback_90beecad:

    # h "For your college."
    h "供你上大学。"

# game/Story01.rpy:4157
translate chinese flashback_04fd245c:

    # h "You’ve always wanted that, right?"
    h "你一直想上的，对吧？"

# game/Story01.rpy:4159
translate chinese flashback_7bc7f045:

    # h "Ow!"
    h "哎！"

# game/Story01.rpy:4161
translate chinese flashback_bcae5980:

    # C "Stop moving."
    C "别动。"

# game/Story01.rpy:4162
translate chinese flashback_2ee62f5f:

    # C "And no, you’re not dropping out."
    C "还有，不行，你不能退学。"

# game/Story01.rpy:4163
translate chinese flashback_114377a9:

    # C "Don’t make dumb decisions because you think you’re helping."
    C "别以为自己在帮忙就做蠢决定。"

# game/Story01.rpy:4165
translate chinese flashback_3c2c221a:

    # C "Because knowing you, you’d end up in some disgusting strip club."
    C "因为我了解你，你最后肯定进什么恶心的脱衣舞俱乐部。"

# game/Story01.rpy:4166
translate chinese flashback_44f322fb:

    # C "Or worse."
    C "或者更糟。"

# game/Story01.rpy:4168
translate chinese flashback_37236d31:

    # h "She never sugarcoated anything."
    h "她从来不粉饰任何事。"

# game/Story01.rpy:4169
translate chinese flashback_bb9aeb1b:

    # h "Brutally honest. Always."
    h "永远直白得吓人。"

# game/Story01.rpy:4170
translate chinese flashback_1abf649c:

    # h "Still is."
    h "现在也是。"

# game/Story01.rpy:4172
translate chinese flashback_d59e39d7:

    # h "By the time I met [mc]… I was desperate."
    h "遇到 [mc] 的时候……我已经走投无路了。"

# game/Story01.rpy:4173
translate chinese flashback_b6921fb0:

    # h "Tried everywhere."
    h "到处都试过。"

# game/Story01.rpy:4175
translate chinese flashback_7ba70fa7:

    # h "Didn’t matter."
    h "没用。"

# game/Story01.rpy:4176
translate chinese flashback_290d4dbf:

    # h "Every place wanted the same thing—"
    h "每个地方都要同一样东西——"

# game/Story01.rpy:4177
translate chinese flashback_d5ddaaa9:

    # h "a stupid piece of paper."
    h "一张破纸。"

# game/Story01.rpy:4178
translate chinese flashback_2d4d1c6a:

    # h "Even for a basic job."
    h "连份普通工作都要。"

# game/Story01.rpy:4180
translate chinese flashback_2fded262_4:

    # h "..."
    h "……"

# game/Story01.rpy:4182
translate chinese flashback_775aa07a:

    # h "Then one night…"
    h "然后有一天晚上……"

# game/Story01.rpy:4183
translate chinese flashback_ae2d9967:

    # h "Rain pouring like hell…"
    h "雨下得像地狱……"

# game/Story01.rpy:4184
translate chinese flashback_a74f4b12:

    # h "I met him."
    h "我遇到了他。"

# game/Story01.rpy:4188
translate chinese flashback_1f4cd599:

    # h "You know what [mc] told me that night?"
    h "你知道那晚 [mc] 跟我说了什么吗？"

# game/Story01.rpy:4190
translate chinese flashback_4db62cdd:

    # h "He said, ‘Sometimes, spilling your guts to a stranger is the healthiest thing you can do.’"
    h "他说：‘有时候，对陌生人掏心掏肺，是你最健康的选择。’"

# game/Story01.rpy:4192
translate chinese flashback_380ee27a:

    # h "(Back then I thought, what a weirdo.)"
    h "（当时我想，真是个怪人。）"

# game/Story01.rpy:4194
translate chinese flashback_d6aa4506:

    # h "You're kind of strange, you know."
    h "你挺怪的，知道吗。"

# game/Story01.rpy:4195
translate chinese flashback_08cd3d8c:

    # h "(And he just replied...)"
    h "（他就回了一句……）"

# game/Story01.rpy:4197
translate chinese flashback_5f9dc4b5:

    # mc "My wife’s a crazy scientist… and I’m just a bar owner."
    mc "我妻子是个疯科学家……我就是个开酒吧的。"

# game/Story01.rpy:4198
translate chinese flashback_04a20166:

    # mc "Can’t even find someone to hire — funny, right?"
    mc "连个人都招不到——好笑吧？"

# game/Story01.rpy:4199
translate chinese flashback_24fc11c3:

    # mc "Does that make me strange? Yeah."
    mc "这算怪吗？算。"

# game/Story01.rpy:4200
translate chinese flashback_73e2a891:

    # mc "Do I care? Not really."
    mc "我在乎吗？不太在乎。"

# game/Story01.rpy:4202
translate chinese flashback_2fded262_5:

    # h "..."
    h "……"

# game/Story01.rpy:4203
translate chinese flashback_c1f515ad:

    # h "You’re looking for... {w}an employee?"
    h "你在招……{w}员工？"

# game/Story01.rpy:4205
translate chinese flashback_8e666101:

    # mc "Yeah, been a couple of weeks now, and I still can’t find anyone."
    mc "对，好几周了，还是找不到人。"

# game/Story01.rpy:4207
translate chinese flashback_7927066a:

    # h "I couldn’t help it."
    h "我忍不住。"

# game/Story01.rpy:4208
translate chinese flashback_cc7141d6:

    # h "And I just…"
    h "然后我就……"

# game/Story01.rpy:4210
translate chinese flashback_e0dcd193:

    # h "laughed."
    h "笑了。"

# game/Story01.rpy:4211
translate chinese flashback_5c6a93b5:

    # h "Because it made sense."
    h "因为这一切说得通。"

# game/Story01.rpy:4213
translate chinese flashback_2fded262_6:

    # h "..."
    h "……"

# game/Story01.rpy:4215
translate chinese flashback_2f93b5aa:

    # h "...He gave me a place."
    h "……他给了我一个落脚的地方。"

# game/Story01.rpy:4216
translate chinese flashback_a5ddb957:

    # h "A job."
    h "一份工作。"

# game/Story01.rpy:4217
translate chinese flashback_8819c1fc:

    # h "Food that wasn’t stolen or expired."
    h "不用偷、没过期的食物。"

# game/Story01.rpy:4218
translate chinese flashback_ec5a18b5:

    # h "And silence."
    h "还有安静。"

# game/Story01.rpy:4219
translate chinese flashback_d970b980:

    # h "No questions."
    h "没人追问。"

# game/Story01.rpy:4220
translate chinese flashback_260b071a:

    # h "No judgment."
    h "没人评断。"

# game/Story01.rpy:4221
translate chinese flashback_a4a0c4c3:

    # h "Just… space."
    h "就是……空间。"

# game/Story01.rpy:4223
translate chinese flashback_2fded262_7:

    # h "..."
    h "……"

# game/Story01.rpy:4225
translate chinese flashback_a117ba2b:

    # h "And sometimes…"
    h "而有时候……"

# game/Story01.rpy:4226
translate chinese flashback_b7945ac3:

    # h "that’s all you need."
    h "你要的就只是这个。"

# game/Story01.rpy:4227
translate chinese flashback_ada197cb:

    # h "To start again."
    h "好重新开始。"

# game/Story01.rpy:4239
translate chinese street3_55eaf2c1:

    # "Sector 5-S. Down in the Lower Level. The slums."
    "5-S区。下城区。贫民窟。"

# game/Story01.rpy:4242
translate chinese street3_43e90da0:

    # Fl "Oh please. It’s just a taxi."
    Fl "拜托。就是个出租车。"

# game/Story01.rpy:4245
translate chinese street3_3d47b3db:

    # mc "Taxi? That wasn’t a taxi."
    mc "出租车？那才不是出租车。"

# game/Story01.rpy:4246
translate chinese street3_7850921f:

    # mc "We were diving straight down, headfirst."
    mc "我们是头朝下直接往下扎。"

# game/Story01.rpy:4248
translate chinese street3_7e7db372:

    # Fl "Oh, relax. It wasn’t that bad."
    Fl "哦，放松。没那么糟。"

# game/Story01.rpy:4249
translate chinese street3_597243fd:

    # Fl "Well… for me, anyway."
    Fl "嗯……至少对我来说。"

# game/Story01.rpy:4251
translate chinese street3_54d27906:

    # mc "Right… just casually mentioning we almost slammed into a couple of buildings."
    mc "是啊……随口提一句我们差点撞上几栋楼。"

# game/Story01.rpy:4252
translate chinese street3_917b3685:

    # mc "Totally normal."
    mc "完全正常。"

# game/Story01.rpy:4254
translate chinese street3_bba86373:

    # Fl "Anyway..."
    Fl "总之……"

# game/Story01.rpy:4257
translate chinese street3_aea38bf5:

    # Fl "So? Still shaking, or did your stomach finally find its assigned quadrant again?"
    Fl "怎么？还在抖，还是胃终于找回自己的位置了？"

# game/Story01.rpy:4260
translate chinese street3_d896acfb:

    # mc "Mostly stable… though there’s still a bit left—"
    mc "基本稳住了……不过还有一点——"

# game/Story01.rpy:4264
translate chinese street3_381a9fc5:

    # mc "BLEEUUUGH."
    mc "呕——"

# game/Story01.rpy:4266
translate chinese street3_87508c09:

    # Fl "Oh, that’s adorable."
    Fl "哦，真可爱。"

# game/Story01.rpy:4267
translate chinese street3_a5883995:

    # Fl "Nothing like a near-death experience to really bring people together."
    Fl "没什么比濒死体验更能拉近感情了。"

# game/Story01.rpy:4269
translate chinese street3_bccb5115:

    # Fl "Take your time."
    Fl "慢慢来。"

# game/Story01.rpy:4270
translate chinese street3_f062043b:

    # Fl "This alley’s not going anywhere."
    Fl "这巷子又不会跑。"

# game/Story01.rpy:4272
translate chinese street3_81100454:

    # Fl "Smells like death, rust, and poor life choices."
    Fl "闻着像死亡、铁锈，还有糟糕的人生选择。"

# game/Story01.rpy:4273
translate chinese street3_9a11bcbc:

    # Fl "You’ll fit right in."
    Fl "你会很适应的。"

# game/Story01.rpy:4276
translate chinese street3_9ed383b1:

    # mc "Alright, alright. I’m coming."
    mc "行行行。来了。"

# game/Story01.rpy:4283
translate chinese street3_f9e1c7fe:

    # Fl "Better?"
    Fl "好点了？"

# game/Story01.rpy:4286
translate chinese street3_a3c382ee:

    # Fl "Or are you developing a taste for dumpsters and industrial decay?"
    Fl "还是你开始喜欢垃圾箱和工业废墟了？"

# game/Story01.rpy:4288
translate chinese street3_ae80f9e0:

    # mc "Ha-ha."
    mc "哈哈。"

# game/Story01.rpy:4289
translate chinese street3_eae824d4:

    # mc "Mocking the wounded. Very noble of you."
    mc "嘲笑伤员。真高尚。"

# game/Story01.rpy:4290
translate chinese street3_3fa03a17:

    # mc "But seriously, what the hell is that?"
    mc "但说真的，那玩意儿到底是什么？"

# game/Story01.rpy:4292
translate chinese street3_a89d3017:

    # ss "Scanning..."
    ss "扫描中……"

# game/Story01.rpy:4294
translate chinese street3_92855003:

    # Fl "That?"
    Fl "那个？"

# game/Story01.rpy:4295
translate chinese street3_2fd92dd4:

    # Fl "That’s our friendly neighborhood sky warden."
    Fl "那是我们友好的街区天巡者。"

# game/Story01.rpy:4297
translate chinese street3_9fa5bccb:

    # Fl "Fully autonomous, super-efficient."
    Fl "完全自主，超级高效。"

# game/Story01.rpy:4299
translate chinese street3_e8377592:

    # mc "And what exactly does it do?"
    mc "它具体干什么？"

# game/Story01.rpy:4301
translate chinese street3_7eadd775:

    # Fl "It scans everything."
    Fl "扫描一切。"

# game/Story01.rpy:4302
translate chinese street3_14ff8652:

    # Fl "Docs, DNA… probably your worst decisions too."
    Fl "证件、DNA……大概连你最糟的决定也扫。"

# game/Story01.rpy:4304
translate chinese street3_07a7eea9:

    # Fl "And if something doesn’t line up?"
    Fl "要是有哪里对不上？"

# game/Story01.rpy:4305
translate chinese street3_4c460073:

    # Fl "It calls in backup."
    Fl "它就叫增援。"

# game/Story01.rpy:4307
translate chinese street3_c03a34fd:

    # Fl "Unless it glitches."
    Fl "除非它出故障。"

# game/Story01.rpy:4308
translate chinese street3_2b914252:

    # Fl "Which it does."
    Fl "而它确实会。"

# game/Story01.rpy:4310
translate chinese street3_4f97edde:

    # Fl "More often than they’ll ever admit."
    Fl "比他们愿意承认的频繁得多。"

# game/Story01.rpy:4312
translate chinese street3_23ac2ec0:

    # Fl "If your eyes start burning?"
    Fl "要是你眼睛开始烧？"

# game/Story01.rpy:4313
translate chinese street3_ad2d4921:

    # Fl "Run."
    Fl "跑。"

# game/Story01.rpy:4314
translate chinese street3_da06ce09:

    # Fl "No questions. Just run."
    Fl "别问。直接跑。"

# game/Story01.rpy:4316
translate chinese street3_626b153f:

    # mc "And how long does it take?"
    mc "要多久？"

# game/Story01.rpy:4318
translate chinese street3_8e792a6e:

    # Fl "Depends."
    Fl "看情况。"

# game/Story01.rpy:4319
translate chinese street3_f868ebdc:

    # Fl "Usually instant."
    Fl "通常是一瞬间。"

# game/Story01.rpy:4322
translate chinese street3_2b35b6fe:

    # mc "..."
    mc "……"

# game/Story01.rpy:4331
translate chinese street3_bf8a48da:

    # Fl "Rule one."
    Fl "第一条规矩。"

# game/Story01.rpy:4332
translate chinese street3_84b33d76:

    # Fl "Stay sharp."
    Fl "保持警觉。"

# game/Story01.rpy:4333
translate chinese street3_4bfea2ea:

    # Fl "People who drift off don’t last long here."
    Fl "走神的人在这儿活不长。"

# game/Story01.rpy:4336
translate chinese street3_6fb1465c:

    # mc "Noted."
    mc "记下了。"

# game/Story01.rpy:4337
translate chinese street3_49dc5dfd:

    # mc "But why are we here?"
    mc "但我们为什么来这儿？"

# game/Story01.rpy:4340
translate chinese street3_d59b8377:

    # Fl "Because of you, actually."
    Fl "其实是因为你。"

# game/Story01.rpy:4341
translate chinese street3_37acfc09:

    # Fl "So tell me… what does it look like?"
    Fl "所以告诉我……它什么样？"

# game/Story01.rpy:4342
translate chinese street3_1ef706f6:

    # mc "Who?"
    mc "谁？"

# game/Story01.rpy:4343
translate chinese street3_3d0d9053:

    # Fl "Don’t play dumb."
    Fl "别装傻。"

# game/Story01.rpy:4344
translate chinese street3_e77f6c37:

    # Fl "I mean the Ark."
    Fl "我是说方舟。"

# game/Story01.rpy:4347
translate chinese street3_c82693a7:

    # mc "The Ark?"
    mc "方舟？"

# game/Story01.rpy:4348
translate chinese street3_088a7b28:

    # mc "Looks like a ship, I guess?"
    mc "大概……像艘船？"

# game/Story01.rpy:4349
translate chinese street3_32f1c7ec:

    # Fl "…You’re weird."
    Fl "……你真怪。"

# game/Story01.rpy:4350
translate chinese street3_d77790fd:

    # Fl "Most people thought it was a myth."
    Fl "大部分人以为那是传说。"

# game/Story01.rpy:4351
translate chinese street3_5b2c50e6:

    # Fl "Others would tear each other apart to be in your place."
    Fl "还有人为坐你的位置能互相撕碎。"

# game/Story01.rpy:4354
translate chinese street3_c7c201f1:

    # mc "I never asked for any of this."
    mc "我从没要求过这些。"

# game/Story01.rpy:4355
translate chinese street3_aef83bf0:

    # Fl "Yeah."
    Fl "是啊。"

# game/Story01.rpy:4356
translate chinese street3_e0216b8c:

    # Fl "I’m a little jealous."
    Fl "我有点嫉妒。"

# game/Story01.rpy:4359
translate chinese street3_25a9332c:

    # mc "Tell me, this Ark of yours… what is it?"
    mc "告诉我，你们的方舟……到底是什么？"

# game/Story01.rpy:4362
translate chinese street3_f2baf678:

    # Fl "No idea."
    Fl "不知道。"

# game/Story01.rpy:4363
