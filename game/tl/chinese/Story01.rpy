    # Fl "Hey, [mc]?"
    Fl "嘿，[mc]？"

# game/Story01.rpy:7787
translate chinese gate3_f49fff8f:

    # mc "Yeah?"
    mc "嗯？"

# game/Story01.rpy:7791
translate chinese gate3_3b1976cc:

    # Fl "Once you step past those walls…"
    Fl "你一旦跨过那道墙……"

# game/Story01.rpy:7792
translate chinese gate3_9b64044a:

    # Fl "I lose you."
    Fl "我就联系不上你了。"

# game/Story01.rpy:7793
translate chinese gate3_2247a50c:

    # Fl "And…"
    Fl "还有……"

# game/Story01.rpy:7795
translate chinese gate3_ac143671:

    # Fl "...yeah, about that."
    Fl "……对，就这事。"

# game/Story01.rpy:7799
translate chinese gate3_336880a4:

    # Fl "Come back alive."
    Fl "活着回来。"

# game/Story01.rpy:7800
translate chinese gate3_61fa8fb0:

    # Fl "Got it?"
    Fl "听到没？"

    # game/Story01.rpy:7801
translate chinese gate3_f7aa5352:

    # mc "I’ll do my best."
    mc "我尽力。"

# game/Story01.rpy:7802
translate chinese gate3_5fbe1d1b:

    # Fl "You might be a weird old man…"
    Fl "你可能是个奇怪的老头……"

# game/Story01.rpy:7803
translate chinese gate3_27a3aee5:

    # Fl "but you’re… entertaining."
    Fl "但你还……挺有意思的。"

# game/Story01.rpy:7804
translate chinese gate3_8366eec1:

    # Fl "Would be a shame to lose that."
    Fl "失去这个就太可惜了。"

# game/Story01.rpy:7808
translate chinese gate3_a44bdab9:

    # mc "…Since when?"
    mc "……什么时候开始的？"

# game/Story01.rpy:7809
translate chinese gate3_9de45941:

    # mc "You’re burying me already, and I haven’t even left yet."
    mc "我还没走呢，你就开始给我送葬了。"

# game/Story01.rpy:7812
translate chinese gate3_7db5d771:

    # Fl "I just said it, okay?!"
    Fl "我就说了一句，行吗？！"

# game/Story01.rpy:7816
translate chinese gate3_e0de62c2:

    # Fl "...fine."
    Fl "……行吧。"

# game/Story01.rpy:7817
translate chinese gate3_92f9dd77:

    # Fl "So tell me instead..."
    Fl "那不如告诉我……"

# game/Story01.rpy:7818
translate chinese gate3_1a7b75e4:

    # Fl "how did you meet Lora?"
    Fl "你是怎么认识洛拉的？"

# game/Story01.rpy:7821
translate chinese gate3_e9608219:

    # Fl "I’ve heard things about her, but…"
    Fl "我听过关于她的一些事，但……"

# game/Story01.rpy:7824
translate chinese gate3_cfd9688b:

    # mc "And what kind of rumors are going around about her?"
    mc "都有什么关于她的传言？"

# game/Story01.rpy:7825
translate chinese gate3_34eba52e:

    # Fl "Hey! I asked first!"
    Fl "嘿！是我先问的！"

# game/Story01.rpy:7828
translate chinese gate3_4a8c1317:

    # mc "We met, yeah…"
    mc "我们确实见过……"

# game/Story01.rpy:7829
translate chinese gate3_9b695ab2:

    # mc "One night, a girl walks into my restaurant. Bunny suit. Says no one can see her but me."
    mc "有天晚上，一个女孩走进我的餐厅。兔女郎装。说除了我没人能看见她。"

# game/Story01.rpy:7831
translate chinese gate3_bd57c0d5:

    # mc "I laugh it off, until I realize no one actually does. Not until I say her name out loud."
    mc "我一笑置之，直到发现真的没人看得见她。除非我念出她的名字。"

# game/Story01.rpy:7832
translate chinese gate3_12cb65a7:

    # mc "Wild story, right?"
    mc "故事够疯吧？"

# game/Story01.rpy:7837
translate chinese gate3_7a364287:

    # mc "Too wild. None of that happened."
    mc "太疯了。没那回事。"

# game/Story01.rpy:7838
translate chinese gate3_417472ba:

    # mc "We met at university. Went on a date. That’s it."
    mc "我们在大学认识。约会过一次。就这样。"

# game/Story01.rpy:7839
translate chinese gate3_f5a2cbe6:

    # mc "…At least, that’s the version I stick to."
    mc "……至少，我一直用这个版本。"

# game/Story01.rpy:7841
translate chinese gate3_41da62cb_1:

    # Fl "..."
    Fl "……"

# game/Story01.rpy:7843
translate chinese gate3_ce9a747e:

    # Fl "...You absolute bastard."
    Fl "……你这混蛋。"

# game/Story01.rpy:7844
translate chinese gate3_35fbcdeb:

    # Fl "I almost believed you."
    Fl "我差点就信了。"

# game/Story01.rpy:7845
translate chinese gate3_9423195d:

    # Fl "Almost."
    Fl "差点。"

# game/Story01.rpy:7850
translate chinese gate3_165a7f83:

    # Fl "...wait."
    Fl "……等等。"

# game/Story01.rpy:7851
translate chinese gate3_ca138870:

    # Fl "Movement."
    Fl "有动静。"

# game/Story01.rpy:7852
translate chinese gate3_9ad7657b:

    # Fl "West."
    Fl "西边。"

# game/Story01.rpy:7856
translate chinese gate3_84b33d76:

    # Fl "Stay sharp."
    Fl "保持警觉。"

# game/Story01.rpy:7861
translate chinese gate3_2051d66a:

    # mc "Understood."
    mc "明白。"

# game/Story01.rpy:7863
translate chinese gate3_2fded262:

    # h "..."
    h "……"

# game/Story01.rpy:7867
translate chinese gate3_1279cf5e:

    # mc "Olivia...?!"
    mc "奥利维亚……？！"

# game/Story01.rpy:7869
translate chinese gate3_612b43aa:

    # mc "What are you doing here?!"
    mc "你怎么在这儿？！"

# game/Story01.rpy:7870
translate chinese gate3_7d94f0a9:

    # mc "I thought you were back at HQ!"
    mc "我以为你回总部了！"

# game/Story01.rpy:7872
translate chinese gate3_13f51dda:

    # h "I was looking for you!"
    h "我在找你！"

# game/Story01.rpy:7874
translate chinese gate3_df4629a2:

    # h "After what happened… I couldn’t just sit still."
    h "出了那事之后……我坐不住。"

# game/Story01.rpy:7876
translate chinese gate3_fd670096:

    # h "So yeah… here I am."
    h "所以……我就来了。"

# game/Story01.rpy:7878
translate chinese gate3_d1fd6961:

    # mc "But how did you find me?"
    mc "但你怎么找到我的？"

# game/Story01.rpy:7880
translate chinese gate3_2dbd3f3a:

    # h "Miriel’s teacher told us where you were…"
    h "米莉尔的老师告诉我们你在哪……"

# game/Story01.rpy:7881
translate chinese gate3_2d580faa:

    # h "Without him… I don’t know what we would’ve done."
    h "要不是他……我不知道我们该怎么办。"

# game/Story01.rpy:7883
translate chinese gate3_3b582eec:

    # h "Speaking of help where’s that annoying cat?"
    h "说到帮忙，那只烦人的猫呢？"

# game/Story01.rpy:7884
translate chinese gate3_9d23004d:

    # h "Don’t tell me she bailed the second things got messy."
    h "别告诉我一出事她就跑了。"

# game/Story01.rpy:7887
translate chinese gate3_4b6f1238:

    # Fl "TELL THAT SELF-RIGHTEOUS GREMLIN I CAN HEAR HER—"
    Fl "告诉那个自以为是的小鬼，我听得见她——"

# game/Story01.rpy:7888
translate chinese gate3_014c2b9c:

    # Fl "and she’d better WATCH HER DAMN MOUTH."
    Fl "她最好管好她那张该死的嘴。"

# game/Story01.rpy:7889
translate chinese gate3_9ab8f673:

    # Fl "Without me, she’d be crying in some bunker right now!"
    Fl "没我，她现在还在哪个地堡里哭呢！"

# game/Story01.rpy:7891
translate chinese gate3_2b35b6fe:

    # mc "..."
    mc "……"

# game/Story01.rpy:7893
translate chinese gate3_bff28cee:

    # h "...Something wrong? You went quiet."
    h "……怎么了？你突然不说话。"

# game/Story01.rpy:7895
translate chinese gate3_56cfbada:

    # mc "Flora’s here."
    mc "弗洛拉在。"

# game/Story01.rpy:7896
translate chinese gate3_f1c2eeea:

    # mc "She’s… in my ear. And she heard everything."
    mc "她……在我耳边。她全听见了。"

# game/Story01.rpy:7899
translate chinese gate3_cf250af0:

    # Fl "And I demand an apology."
    Fl "我要求道歉。"

# game/Story01.rpy:7902
translate chinese gate3_0b5a943a:

    # h "Aww, poor thing. Want a medal?"
    h "哎呀，可怜的小东西。要给你发枚奖章吗？"

# game/Story01.rpy:7903
translate chinese gate3_57b0922c:

    # h "Or a standing ovation for doing your job?"
    h "还是为你干好本职工作起立鼓掌？"

# game/Story01.rpy:7906
translate chinese gate3_b3afd097:

    # Fl "WHAT DID SHE JUST—"
    Fl "她刚说什么——"

# game/Story01.rpy:7907
translate chinese gate3_f87738ea:

    # Fl "I SWEAR TO EVERY STAR—"
    Fl "我对所有星辰发誓——"

# game/Story01.rpy:7909
translate chinese gate3_6a3f3bef:

    # H "Connection temporarily lost. "
    H "连接暂时中断。"

# game/Story01.rpy:7911
translate chinese gate3_5402e203:

    # h "She still yelling?"
    h "她还在吼吗？"

# game/Story01.rpy:7913
translate chinese gate3_16fde370:

    # mc "Why do you keep provoking her?"
    mc "你干嘛老激她？"

# game/Story01.rpy:7915
translate chinese gate3_2b35b6fe_1:

    # mc "..."
    mc "……"

# game/Story01.rpy:7918
translate chinese gate3_aaeee80c:

    # h "The way she treated you… I didn’t like that."
    h "她对你那态度……我不喜欢。"

# game/Story01.rpy:7920
translate chinese gate3_2a1ca28d:

    # mc "In that case… you owe her an apology."
    mc "那这样的话……你该向她道歉。"

# game/Story01.rpy:7922
translate chinese gate3_17fce6d3:

    # h "That’s not something I hear from you every day…"
    h "这话可不常从你嘴里听到……"

# game/Story01.rpy:7923
translate chinese gate3_24372cd9:

    # h "Alright."
    h "好吧。"

# game/Story01.rpy:7925
translate chinese gate3_5288914b:

    # mc "Tell me, Liv… are you sure you want to do this?"
    mc "告诉我，莉芙……你确定要这么做？"

# game/Story01.rpy:7927
translate chinese gate3_2fded262_1:

    # h "..."
    h "……"

# game/Story01.rpy:7929
translate chinese gate3_2b35b6fe_2:

    # mc "..."
    mc "……"

# game/Story01.rpy:7937
translate chinese gate3_8d068a5d:

    # h "Team, remember?"
    h "一队的，记得吗？"

# game/Story01.rpy:7938
translate chinese gate3_41cff623:

    # h "From the start…"
    h "从一开始……"

# game/Story01.rpy:7939
translate chinese gate3_aa29927b:

    # mc "...to the end."
    mc "……到最后。"

# game/Story01.rpy:7943
translate chinese gate3_f2721de9:

    # h "...they’re here already?"
    h "……他们已经到了？"

# game/Story01.rpy:7947
translate chinese gate3_093e5752:

    # o "Sector 6, east side’s already fallen."
    o "6区东侧已经沦陷。"

# game/Story01.rpy:7948
translate chinese gate3_89fbf67c:

    # o "The rest… I don’t know yet."
    o "其余的……还不知道。"

# game/Story01.rpy:7949
translate chinese gate3_ca74b71a:

    # g "So that’s it? No backup?"
    g "就这样？没增援？"

# game/Story01.rpy:7950
translate chinese gate3_b84ffb5c:

    # o "Someone has to hold the city."
    o "总得有人守住城。"

# game/Story01.rpy:7952
translate chinese gate3_4b340443:

    # g "..."
    g "……"

# game/Story01.rpy:7953
translate chinese gate3_481f0439:

    # gg "Chin up! Time to be heroes!"
    gg "打起精神！该当英雄了！"

# game/Story01.rpy:7956
translate chinese gate3_cd5ea5d5:

    # Mi "Why did you rush ahead?"
    Mi "你干嘛冲那么前？"

# game/Story01.rpy:7957
translate chinese gate3_a9ebd551:

    # Mi "You could’ve been killed."
    Mi "你可能会死的。"

# game/Story01.rpy:7959
translate chinese gate3_c3de2d26:

    # h "Oh, come on, I was a scout, remember?"
    h "哦得了吧，我是侦察兵，记得吗？"

# game/Story01.rpy:7960
translate chinese gate3_efb92258:

    # h "I know how to get out of a mess in one piece."
    h "我知道怎么全身而退。"

# game/Story01.rpy:7962
translate chinese gate3_e94ad793:

    # h "Besides, you weren’t exactly calm when all this started either."
    h "再说，这事一开始你也不淡定。"

# game/Story01.rpy:7964
translate chinese gate3_7990990a:

    # mc "Is it just me, or did you two get closer?"
    mc "是我错觉，还是你们俩关系变近了？"

# game/Story01.rpy:7966
translate chinese gate3_024c4c28:

    # h "Hm? You think so?"
    h "嗯？你觉得？"

# game/Story01.rpy:7968
translate chinese gate3_9293a506:

    # h "We talked a bit."
    h "我们聊了聊。"

# game/Story01.rpy:7969
translate chinese gate3_89a8c19c:

    # h "Turns out we’re not that different."
    h "发现我们其实没那么不同。"

# game/Story01.rpy:7971
translate chinese gate3_7c8bdd18:

    # h "Then we just sat there complaining about how unfair the world is."
    h "然后我们就坐着抱怨这世界多不公平。"

# game/Story01.rpy:7973
translate chinese gate3_da3fdbf1:

    # Mi "..."
    Mi "……"

# game/Story01.rpy:7976
translate chinese gate3_da3fdbf1_1:

    # Mi "..."
    Mi "……"

# game/Story01.rpy:7978
translate chinese gate3_a1ecb362:

    # Mi "And what exactly do you think you’re doing?"
    Mi "你到底在干什么？"

# game/Story01.rpy:7980
translate chinese gate3_429652f7:

    # h "Oh, I noticed a little... tension in the atmosphere."
    h "哦，我注意到气氛有点……紧张。"

# game/Story01.rpy:7982
translate chinese gate3_d56e24ea:

    # h "So I figured I’d distract you a little!"
    h "所以我想稍微转移下你的注意力！"

# game/Story01.rpy:7983
translate chinese gate3_39130e5b:

    # h "(whispering) and looks like it worked."
    h "（低声）看起来奏效了。"

# game/Story01.rpy:7986
translate chinese gate3_3bfd9f7d:

    # Mi "…Let go."
    Mi "……放开。"

# game/Story01.rpy:7987
translate chinese gate3_2fded262_2:

    # h "..."
    h "……"

# game/Story01.rpy:7989
translate chinese gate3_da3fdbf1_2:

    # Mi "..."
    Mi "……"

# game/Story01.rpy:7992
translate chinese gate3_1d721ea6:

    # h "Love you too!"
    h "我也爱你！"

# game/Story01.rpy:7993
translate chinese gate3_7d751f68:

    # Mi "…!"
    Mi "……！"

# game/Story01.rpy:7994
translate chinese gate3_5def8aa1:

    # mc "Don’t wander too far."
    mc "别走太远。"

# game/Story01.rpy:7997
translate chinese gate3_02ec2e5e:

    # o "*quiet chuckle*"
    o "*低声笑*"

# game/Story01.rpy:7999
translate chinese gate3_07abc845:

    # o "..."
    o "……"

# game/Story01.rpy:8000
translate chinese gate3_aaab1ff9:

    # o "...I heard what you did."
    o "……我听说了你做的事。"

# game/Story01.rpy:8002
translate chinese gate3_f1160080:

    # o "I owe you my daughter’s life."
    o "我欠你一条我女儿的命。"

# game/Story01.rpy:8004
translate chinese gate3_b2b9e19d:

    # mc "What do you mean?"
    mc "什么意思？"

# game/Story01.rpy:8006
translate chinese gate3_07abc845_1:

    # o "..."
    o "……"

# game/Story01.rpy:8007
translate chinese gate3_f01b2d6f:

    # o "I saw it myself."
    o "我亲眼看见了。"

# game/Story01.rpy:8008
translate chinese gate3_066c6646:

    # o "You pulled her out of that."
    o "是你把她从那里拉出来的。"

# game/Story01.rpy:8010
translate chinese gate3_25ed595a:

    # o "Thank you."
    o "谢谢。"

# game/Story01.rpy:8012
translate chinese gate3_cf1adef2:

    # mc "Yeah."
    mc "嗯。"

# game/Story01.rpy:8015
translate chinese gate3_c426b8d8:

    # Fl "[mc]— do you hear me?!"
    Fl "[mc]——听得见吗？！"

# game/Story01.rpy:8016
translate chinese gate3_e76904bf:

    # Fl "The signal— it’s breaking up—!"
    Fl "信号——要断了——！"

# game/Story01.rpy:8017
translate chinese gate3_d48cdfb0:

    # Fl "Stay alive—"
    Fl "活下去——"

# game/Story01.rpy:8019
translate chinese gate3_bbde45a5:

    # mc "...you too."
    mc "……你也是。"

# game/Story01.rpy:8023
translate chinese gate3_2b35b6fe_3:

    # mc "..."
    mc "……"

# game/Story01.rpy:8025
translate chinese gate3_6a90e73c:

    # o "Flora?!"
    o "弗洛拉？！"

# game/Story01.rpy:8026
translate chinese gate3_ce30e8e6:

    # o "What happened?!"
    o "出什么事了？！"

# game/Story01.rpy:8028
translate chinese gate3_a73d8dff:

    # mc "Just the comms. It’s happened before."
    mc "只是通讯。之前也发生过。"

# game/Story01.rpy:8032
translate chinese gate3_aab804c1:

    # g "Sir. We’ve got a problem."
    g "长官。有问题。"

# game/Story01.rpy:8033
translate chinese gate3_6a67c302:

    # o "What happened?"
    o "怎么了？"

# game/Story01.rpy:8035
translate chinese gate3_caf3e0c4:

    # g "This."
    g "这个。"

# game/Story01.rpy:8037
translate chinese gate3_9723677d:

    # o "Why isn’t it open?"
    o "为什么门没开？"

# game/Story01.rpy:8039
translate chinese gate3_a916f3d6:

    # g "We… miscalculated."
    g "我们……算错了。"

# game/Story01.rpy:8040
translate chinese gate3_c89c1c78:

    # g "After that surge, the gate jammed."
    g "那次电涌之后，门卡住了。"

# game/Story01.rpy:8041
translate chinese gate3_9d029a0d:

    # g "I can’t get it open."
    g "我打不开。"

# game/Story01.rpy:8043
translate chinese gate3_b187a933:

    # gg "We’ve got explosives."
    gg "我们有炸药。"

# game/Story01.rpy:8044
translate chinese gate3_ae91df4d:

    # gg "Let’s just turn the whole damn gate into dust!"
    gg "干脆把整扇门炸成渣！"

# game/Story01.rpy:8046
translate chinese gate3_12f496bb:

    # g "Blow it open? Waste every round we’ve got on a door? Brilliant."
    g "炸开？把所有弹药浪费在一扇门上？真聪明。"

# game/Story01.rpy:8047
translate chinese gate3_d353d45c:

    # g "And what do we fight with after that? Sharp looks and angry words?"
    g "之后拿什么打？靠眼神和骂人？"

# game/Story01.rpy:8049
translate chinese gate3_02a83b11:

    # g "That thing’s made of quantum titanium. It could shrug off a tank."
    g "那玩意儿是量子钛做的。坦克都打不动。"

# game/Story01.rpy:8051
translate chinese gate3_a25742b4:

    # mc "We were supposed to go underground from the start."
    mc "我们本来就该走地下。"

# game/Story01.rpy:8052
translate chinese gate3_24daff03:

    # mc "What’s the problem?"
    mc "问题在哪？"

# game/Story01.rpy:8054
translate chinese gate3_42d0e488:

    # o "Problem is, the maps are a mess."
    o "问题是，地图一团糟。"

# game/Story01.rpy:8055
translate chinese gate3_31508c9b:

    # o "And even if we had a clean route…"
    o "就算有干净的路线……"

# game/Story01.rpy:8056
translate chinese gate3_c3c281f1:

    # o "We’d still have to deal with the locals."
    o "还是得应付本地的东西。"

# game/Story01.rpy:8059
translate chinese gate3_1d82a7e7:

    # mc "...!"
    mc "……！"

# game/Story01.rpy:8061
translate chinese gate3_0f69fa0f:

    # mc "(What the—)"
    mc "（什么——）"

# game/Story01.rpy:8063
translate chinese gate3_0f0907dc:

    # mc "(OLIVIA!)"
    mc "（奥利维亚！）"

# game/Story01.rpy:8064
translate chinese gate3_53db3d28:

    # g "They started purging Sector 6?!"
    g "他们开始清洗6区了？！"

