translate chinese path_second_up_3_3_ad3cdafc:

    # mc "(…behind me. Too hot.)"
    mc "（……我身后。太烫了。）"

# game/Story01.rpy:7257
translate chinese path_second_up_3_3_ab092e39:

    # Fl "BEHIND YOU!"
    Fl "你后面！"

# game/Story01.rpy:7259
translate chinese path_second_up_3_3_183cce60:

    # mc "(…I know.)"
    mc "（……我知道。）"

# game/Story01.rpy:7265
translate chinese path_second_up_3_3_ebb9da9d:

    # mc "(…die—)"
    mc "（……死——）"

# game/Story01.rpy:7270
translate chinese path_second_up_3_3_2b35b6fe_2:

    # mc "..."
    mc "……"

# game/Story01.rpy:7271
translate chinese path_second_up_3_3_239493a4:

    # mc "(That wasn’t a soulless.)"
    mc "（那不是无魂者。）"

# game/Story01.rpy:7273
translate chinese path_second_up_3_3_731c66f9:

    # mc "Flora, I need everything you’ve got on that thing."
    mc "弗洛拉，把那东西的资料全给我。"

# game/Story01.rpy:7274
translate chinese path_second_up_3_3_cd93bcc9:

    # Fl "Y-yeah! Give me a second— I’m checking."
    Fl "好……好！等一下——我在查。"

