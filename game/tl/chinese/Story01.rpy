    mc "蜥蜴？"

# game/Story01.rpy:4384
translate chinese street3_83af87e1:

    # Fl "You’ll see."
    Fl "你会知道的。"

# game/Story01.rpy:4385
translate chinese street3_db714bd7:

    # Fl "Try to keep up."
