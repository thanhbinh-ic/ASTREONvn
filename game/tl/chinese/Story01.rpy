    # a "Everything’s spinning… What the hell happened?"
    a "天旋地转……到底出什么事了？"

# game/Story01.rpy:4777
translate chinese HelpArc_f627cc0e:

    # aa "One of those peacekeeper bastards decided you were his."
    aa "有个治安队的混蛋觉得你是他的。"

# game/Story01.rpy:4778
translate chinese HelpArc_3c5cc45f:

    # aa "You fought back, and he snapped."
    aa "你还手了，他就失控了。"

# game/Story01.rpy:4779
translate chinese HelpArc_2c83a379:

    # aa "Didn’t expect inqusition to step in. Hell, no one did."
    aa "没想到审判庭的人会插手。说实话，谁都没料到。"

# game/Story01.rpy:4781
translate chinese HelpArc_9aee11f9:

    # a "...He saved me?"
    a "……他救了我？"

# game/Story01.rpy:4783
translate chinese HelpArc_8cf218e9:

    # aa "Didn’t even hesitate."
    aa "连犹豫都没有。"

# game/Story01.rpy:4784
translate chinese HelpArc_6d48156d:

    # aa "Just, moved."
    aa "直接就动了。"

# game/Story01.rpy:4786
translate chinese HelpArc_2726acb8:

    # aa "You have no idea what that means to us."
    aa "你不知道这对我意味着什么。"

# game/Story01.rpy:4787
translate chinese HelpArc_ba4ef580:

    # aa "If you ever need a place to hide, Sector 6-S. {w}Blue Moon."
    aa "要是你需要藏身的地方，6-S区。{w}蓝月。"

# game/Story01.rpy:4788
translate chinese HelpArc_2fb8ceb1:

    # aa "Tell them Mira sent you."
    aa "就说米拉让你来的。"

# game/Story01.rpy:4791
translate chinese HelpArc_c47099e7:

    # aa "Go. Now."
    aa "走。现在。"

# game/Story01.rpy:4794
translate chinese HelpArc_fa99e42c:

    # g "Sir, targets are pulling back."
    g "长官，目标正在撤退。"

# game/Story01.rpy:4796
translate chinese HelpArc_9e3b654d:

    # gg "Forget them. Focus on the inqusition."
    gg "别管他们。盯住审判庭的人。"

# game/Story01.rpy:4798
translate chinese HelpArc_b5d843fb:

    # g "On your knees."
    g "跪下。"

# game/Story01.rpy:4800
translate chinese HelpArc_9d452db6:

    # g "Now."
    g "现在。"

# game/Story01.rpy:4802
translate chinese HelpArc_079e20f6:

    # g "No sudden moves."
    g "别突然乱动。"

# game/Story01.rpy:4803
translate chinese HelpArc_00f489c3:

    # g "Don’t make this worse than it already is."
    g "别让事情更糟。"

# game/Story01.rpy:4821
translate chinese HelpArc_86528505:

    # mc "Ninety-seven… ninety-eight…"
    mc "九十七……九十八……"

# game/Story01.rpy:4832
translate chinese HelpArc_dab4b232:

    # g "This way, please."
    g "请这边走。"

# game/Story01.rpy:4841
translate chinese HelpArc_56f4969c:

    # g "Here he is. This the one?"
    g "人在这儿。是这个吗？"

# game/Story01.rpy:4843
translate chinese HelpArc_8662d721:

    # Mi "Yes, it’s him."
    Mi "对，就是他。"

# game/Story01.rpy:4844
translate chinese HelpArc_4b340443:

    # g "..."
    g "……"

# game/Story01.rpy:4847
translate chinese HelpArc_e0457c8c:

    # g "Alright, you’ve got 15 minutes."
    g "行，给你十五分钟。"

# game/Story01.rpy:4849
translate chinese HelpArc_1f2f3498:

    # Mi "Thanks."
    Mi "谢了。"

# game/Story01.rpy:4853
translate chinese HelpArc_9ab389e1:

    # mc "Didn’t go as planned."
    mc "计划赶不上变化。"

# game/Story01.rpy:4856
translate chinese HelpArc_4ced73ac:

    # Mi "You stood up for me… so I returned the favor."
    Mi "你替我出头……所以我还你人情。"

# game/Story01.rpy:4857
translate chinese HelpArc_2138d3cd:

    # Mi "That’s what a team does… right?"
    Mi "队友就该这样……对吧？"

# game/Story01.rpy:4859
translate chinese HelpArc_6a1e4848:

    # mc "Already getting used to the idea?"
    mc "已经开始习惯了？"

# game/Story01.rpy:4860
translate chinese HelpArc_7b471f6f:

    # mc "Good."
    mc "很好。"

# game/Story01.rpy:4862
translate chinese HelpArc_9133da3b:

    # mc "What about the girl?"
    mc "那姑娘呢？"

# game/Story01.rpy:4865
translate chinese HelpArc_a1c7e446:

    # mc "The one they were beating to a pulp. I need to know if she made it."
    mc "被他们打得半死的那个。我得知道她活下来没有。"

# game/Story01.rpy:4867
translate chinese HelpArc_ead69efa:

    # Mi "She’s fine."
    Mi "她没事。"

# game/Story01.rpy:4870
translate chinese HelpArc_7b471f6f_1:

    # mc "Good."
    mc "好。"

# game/Story01.rpy:4872
translate chinese HelpArc_5dbc8ee8:

    # Mi "And… it’s a good thing you saved her."
    Mi "而且……幸好你救了她。"

# game/Story01.rpy:4877
translate chinese HelpArc_b2b9e19d:

    # mc "What do you mean?"
    mc "什么意思？"

# game/Story01.rpy:4879
translate chinese HelpArc_4eba4b46:

    # Mi "She… works for someone very important."
    Mi "她……给一个非常重要的人做事。"

# game/Story01.rpy:4881
translate chinese HelpArc_041785de:

    # mc "Care to elaborate?"
    mc "能说详细点吗？"

# game/Story01.rpy:4883
translate chinese HelpArc_da3fdbf1:

    # Mi "..."
    Mi "……"

# game/Story01.rpy:4888
translate chinese HelpArc_3e10c8d0:

    # Mi "…Her name is Ember."
    Mi "……她叫恩伯。"

# game/Story01.rpy:4889
translate chinese HelpArc_50e5642f:

    # Mi "She’s the one you were supposed to meet."
    Mi "你要见的人就是她。"

# game/Story01.rpy:4890
translate chinese HelpArc_2b35b6fe:

    # mc "..."
    mc "……"

# game/Story01.rpy:4900
translate chinese HelpArc_31c5e6d8:

    # mc "The lizard?"
    mc "那只蜥蜴？"

# game/Story01.rpy:4902
translate chinese HelpArc_e874e0d8:

    # Mi "…Forget that word."
    Mi "……忘了那个词。"

# game/Story01.rpy:4903
translate chinese HelpArc_0d29e38c:

    # Mi "If you don’t want to die."
    Mi "除非你想死。"

# game/Story01.rpy:4905
translate chinese HelpArc_c5c09466:

    # mc "That bad?"
    mc "有那么严重？"

# game/Story01.rpy:4907
translate chinese HelpArc_f6315b41:

    # Mi "If she decides to kill you…"
    Mi "要是她决定杀你……"

# game/Story01.rpy:4908
translate chinese HelpArc_1d36f232:

    # Mi "no one will stop her."
    Mi "没人拦得住。"

# game/Story01.rpy:4909
translate chinese HelpArc_38745df8:

    # Mi "No one."
    Mi "没人。"

# game/Story01.rpy:4911
translate chinese HelpArc_10ed5807:

    # mc "…And you’re sending me to her anyway. Why?"
    mc "……你还是要把我送去见她。为什么？"

# game/Story01.rpy:4914
translate chinese HelpArc_e823a012:

    # Mi "If anyone knows anything… it’s her."
    Mi "要是有人知道什么……那就是她。"

# game/Story01.rpy:4915
translate chinese HelpArc_ed4ca8eb:

    # Mi "You won’t get much from the Lady… but Ember is an informant."
    Mi "从夫人那儿你问不出什么……但恩伯是情报贩子。"

# game/Story01.rpy:4916
translate chinese HelpArc_5230c53e:

    # Mi "My teacher pulled some strings."
    Mi "我老师动用了些关系。"

# game/Story01.rpy:4917
translate chinese HelpArc_203ddec6:

    # Mi "We’ve arranged a meeting."
    Mi "我们安排了一次会面。"

# game/Story01.rpy:4920
translate chinese HelpArc_0ac61967:

    # g "Sorry to interrupt, ma’am. You’re free to go."
    g "抱歉打扰，女士。你们可以走了。"

# game/Story01.rpy:4934
translate chinese HelpArc_facfac04:

    # o "BRING ME THOSE SCUMS! I won’t let this stand!"
    o "把那些渣滓给我带来！这事我不会就这么算了！"

# game/Story01.rpy:4937
translate chinese HelpArc_478160b3:

    # g "Sir, please—"
    g "长官，请——"

# game/Story01.rpy:4939
translate chinese HelpArc_668a758b:

    # o "You had no idea who she was working for?!"
    o "你根本不知道她在给谁做事？！"

# game/Story01.rpy:4940
translate chinese HelpArc_c910d5ff:

    # o "What the hell were you thinking?!"
    o "你他妈想什么呢？！"

# game/Story01.rpy:4943
translate chinese HelpArc_e236d8ea:

    # g "But... she was just an elf, sir..."
    g "可是……她就是个精灵啊，长官……"

# game/Story01.rpy:4945
translate chinese HelpArc_72347ac0:

    # o "...What did you say?"
    o "……你说什么？"

# game/Story01.rpy:4947
translate chinese HelpArc_b85df2b3:

    # g "She’s an elf—"
    g "她是个精灵——"

# game/Story01.rpy:4949
translate chinese HelpArc_f6acdc62:

    # o "Say it again."
    o "再说一遍。"

# game/Story01.rpy:4952
translate chinese HelpArc_2870bf0b:

    # g "She’s—"
    g "她——"

# game/Story01.rpy:4958
translate chinese HelpArc_9193724c:

    # o "AN ELF, YOU SAY?"
    o "精灵，是吗？"

# game/Story01.rpy:4959
translate chinese HelpArc_909fb913:

    # o "So that makes it fine?"
    o "所以这就没事了？"

# game/Story01.rpy:4960
translate chinese HelpArc_3f93ee2e:

    # o "Get out. Now."
    o "滚出去。现在。"

# game/Story01.rpy:4961
translate chinese HelpArc_6242f2a8:

    # o "Before I personally send you to have a word with her."
    o "趁我还没亲自送你去跟她谈话。"

# game/Story01.rpy:4963
translate chinese HelpArc_001c6daf:

    # Mi "She’ll be furious… when she finds out."
    Mi "她要是知道了……会暴怒的。"

# game/Story01.rpy:4966
translate chinese HelpArc_3faf70d8:

    # o "I’ve already sent my apologies."
    o "我已经送去道歉了。"

# game/Story01.rpy:4968
translate chinese HelpArc_af61c2d0:

    # o "…let’s hope that’s enough."
    o "……但愿这就够了。"

# game/Story01.rpy:4969
translate chinese HelpArc_bf337c42:

    # mc "(All that… over one beating.)"
    mc "（这么大动静……就因为打了一个人。）"

# game/Story01.rpy:4972
translate chinese HelpArc_5dfbdc5e:

    # o "Ah… there you are."
    o "啊……你在这儿。"

# game/Story01.rpy:4973
translate chinese HelpArc_0e22df3e:

    # o "Good to see you still in one piece, my friend."
    o "很高兴看到你还完好无损，朋友。"

# game/Story01.rpy:4974
translate chinese HelpArc_3150bc37:

    # o "Sorry you had to walk in on that."
    o "抱歉让你撞见那一幕。"

# game/Story01.rpy:4975
translate chinese HelpArc_e17eb912:

    # o "We’re usually… a bit more civilized than this."
    o "我们平时……比这文明点。"

# game/Story01.rpy:4977
translate chinese HelpArc_ffb0e06e:

    # mc "Yeah… not exactly a pleasant experience."
    mc "是啊……算不上愉快的经历。"

# game/Story01.rpy:4979
translate chinese HelpArc_cace4228:

    # o "How’s your eye holding up?"
    o "你眼睛怎么样了？"

# game/Story01.rpy:4980
translate chinese HelpArc_839c3dbe:

    # o "You taking the meds?"
    o "药有在吃吗？"

# game/Story01.rpy:4981
translate chinese HelpArc_2b35b6fe_1:

    # mc "..."
    mc "……"

# game/Story01.rpy:4984
translate chinese HelpArc_778751ff:

    # mc "Slipped my mind."
    mc "忘了。"

# game/Story01.rpy:4985
translate chinese HelpArc_eb6803a4:

    # o "Yeah… figures."
    o "是啊……猜到了。"

# game/Story01.rpy:4988
translate chinese HelpArc_a258a39e:

    # o "When you step out, don’t forget to take them."
    o "出去的时候别忘了吃。"

# game/Story01.rpy:4989
translate chinese HelpArc_30a3ee49:

    # o "Seriously."
    o "说真的。"

# game/Story01.rpy:4991
translate chinese HelpArc_4b11f3bd:

    # Mi "We should move."
    Mi "我们该走了。"

# game/Story01.rpy:4992
translate chinese HelpArc_f4298efe:

    # Mi "We’re running late."
    Mi "要迟到了。"

# game/Story01.rpy:4994
translate chinese HelpArc_38079510:

    # o "Take care of yourself out there."
    o "在外面照顾好自己。"

# game/Story01.rpy:4995
translate chinese HelpArc_1cd3c238:

    # o "I expect you back in one piece."
    o "我指望你完整回来。"

# game/Story01.rpy:4997
translate chinese HelpArc_9bae515b:

    # mc "...thanks."
    mc "……谢了。"

# game/Story01.rpy:5007
translate chinese HelpArc_2b35b6fe_2:

    # mc "..."
    mc "……"

# game/Story01.rpy:5010
translate chinese HelpArc_13e0ba5d:

    # mc "Before I meet… Ember."
    mc "在见……恩伯之前。"

# game/Story01.rpy:5011
translate chinese HelpArc_6ec0a103:

    # mc "If I want to walk out alive, what do I need to know?"
    mc "要想活着出来，我得知道什么？"

# game/Story01.rpy:5014
translate chinese HelpArc_6306b36b:

    # Mi "Tell me…"
    Mi "告诉我……"

# game/Story01.rpy:5015
translate chinese HelpArc_16e96c75:

    # Mi "Do you know how to keep your mouth shut when it matters?"
    Mi "关键时刻你能管住嘴吗？"

# game/Story01.rpy:5018
translate chinese HelpArc_782130c7:

    # mc "Depends on the situation."
    mc "看情况。"

# game/Story01.rpy:5021
translate chinese HelpArc_448c2735:

    # Mi "We have something she might want."
    Mi "我们有她可能想要的东西。"

# game/Story01.rpy:5022
translate chinese HelpArc_552db165:

    # Mi "Information."
    Mi "情报。"

# game/Story01.rpy:5025
translate chinese HelpArc_75222bf7:

    # Mi "Control what you say."
    Mi "管住你说的话。"

# game/Story01.rpy:5026
translate chinese HelpArc_8dab035e:

    # Mi "And say as little as possible."
    Mi "说得越少越好。"

# game/Story01.rpy:5028
translate chinese HelpArc_5009a6f4:

    # Fl "Like he’s capable of that..."
    Fl "好像他做得到似的……"

# game/Story01.rpy:5030
translate chinese HelpArc_0a302009:

    # Fl "Did you forget how she plays?"
    Fl "你忘了她怎么玩的了？"

# game/Story01.rpy:5031
translate chinese HelpArc_0064cf3f:

    # Fl "And don’t even tell me he’s walking in like that."
    Fl "别告诉我他就这么进去。"

# game/Story01.rpy:5034
translate chinese HelpArc_4ae46cab:

    # Mi "That’s not what you should be worried about."
    Mi "你该担心的不是这个。"

# game/Story01.rpy:5035
translate chinese HelpArc_5834cae5:

    # Mi "Your father already took care of his clearance."
    Mi "你父亲已经搞定他的通行权限了。"

# game/Story01.rpy:5036
translate chinese HelpArc_3553d55f:

    # Mi "Your job is to keep her in—"
    Mi "你的任务是让她留在——"

# game/Story01.rpy:5038
translate chinese HelpArc_0f2a57d2:

    # mc "Alright, hold on."
    mc "好了，等等。"

# game/Story01.rpy:5039
translate chinese HelpArc_0232708a:

    # mc "Short version, keep my mouth shut, right?"
    mc "简单说，就是管住嘴，对吧？"

# game/Story01.rpy:5040
translate chinese HelpArc_0de6d30e:

    # mc "And if I don’t?"
    mc "要是我不呢？"

# game/Story01.rpy:5042
translate chinese HelpArc_73c50271:

    # Fl "Death."
    Fl "死。"

# game/Story01.rpy:5043
translate chinese HelpArc_04c37dac:

    # Fl "Immediate."
    Fl "立刻。"

# game/Story01.rpy:5045
translate chinese HelpArc_14903917:

    # Mi "You won’t even get the chance to react."
    Mi "你连反应的机会都没有。"

# game/Story01.rpy:5046
translate chinese HelpArc_4fd005de:

    # Mi "And if you do…"
    Mi "就算你反应了……"

# game/Story01.rpy:5047
translate chinese HelpArc_3944676f:

    # Mi "you’ll regret surviving."
    Mi "你也会后悔活下来。"

# game/Story01.rpy:5049
translate chinese HelpArc_9865920f:

    # mc "If the odds of dying are that high… why take the risk?"
    mc "要是死的概率那么高……为什么要冒这个险？"

# game/Story01.rpy:5050
translate chinese HelpArc_d9efc5e8:

    # mc "For information that might not even be worth it?"
    mc "为了可能根本不值的情报？"

# game/Story01.rpy:5052
translate chinese HelpArc_da3fdbf1_1:

    # Mi "..."
    Mi "……"

# game/Story01.rpy:5054
translate chinese HelpArc_d91e9ce0:

    # Mi "You asked for answers."
    Mi "是你要答案。"

# game/Story01.rpy:5055
translate chinese HelpArc_b993c767:

    # Mi "This is the price."
    Mi "这就是代价。"

# game/Story01.rpy:5057
translate chinese HelpArc_2e1c75eb:

    # Mi "If you don’t agree… you can walk away."
    Mi "要是你不愿意……可以走。"

# game/Story01.rpy:5058
translate chinese HelpArc_87165404:

    # Mi "But—"
    Mi "但——"

# game/Story01.rpy:5061
translate chinese HelpArc_d5ae2301:

    # mc "Fair enough."
    mc "行。"

# game/Story01.rpy:5062
translate chinese HelpArc_91094407:

    # mc "Without your help, I’d still be rotting in that hole."
    mc "没你帮忙，我还烂在那个洞里。"

# game/Story01.rpy:5064
translate chinese HelpArc_da3fdbf1_2:

    # Mi "..."
    Mi "……"

# game/Story01.rpy:5066
translate chinese HelpArc_52981d4f:

    # Mi "…Don’t make me pull you out again."
    Mi "……别让我再捞你一次。"

# game/Story01.rpy:5069
translate chinese HelpArc_c52b28d6:

    # mc "Then I won’t screw it up."
    mc "那我不会搞砸。"

# game/Story01.rpy:5319
translate chinese bar_cyber_5711a4fd:

    # mc "Tell me…"
    mc "告诉我……"

# game/Story01.rpy:5320
translate chinese bar_cyber_d2e32f1f:

    # mc "What are the odds I die the moment I walk in?"
    mc "我一进去就死的概率有多大？"

# game/Story01.rpy:5323
translate chinese bar_cyber_3b98fb61:

    # Fl "Scared?"
    Fl "怕了？"

# game/Story01.rpy:5324
translate chinese bar_cyber_334d75b4:

    # mc "I don’t know what to expect, and—"
    mc "我不知道会遇上什么，而且——"

# game/Story01.rpy:5325
translate chinese bar_cyber_4f81c7a0:

    # Fl "Can’t blame you."
    Fl "不怪你。"

# game/Story01.rpy:5326
translate chinese bar_cyber_2b35b6fe:

    # mc "..."
    mc "……"

# game/Story01.rpy:5328
translate chinese bar_cyber_e23f88c2:

    # Fl "That means your instincts aren’t completely useless."
    Fl "说明你的直觉还没完全废掉。"

# game/Story01.rpy:5329
translate chinese bar_cyber_044c3d8e:

    # Fl "Don’t get me wrong, I’m not trying to scare you."
    Fl "别误会，我不是想吓你。"

# game/Story01.rpy:5330
translate chinese bar_cyber_6c658b20:

    # Fl "But about half the people who walk in there?"
    Fl "但进去的人里大概有一半？"

# game/Story01.rpy:5331
translate chinese bar_cyber_1a3f253a:

    # Fl "Don’t walk back out."
    Fl "没能走出来。"

# game/Story01.rpy:5333
translate chinese bar_cyber_53e5427c:

    # mc "How do I make sure I’m in the half that walks out?"
    mc "我怎么确保自己是走出来的那一半？"

# game/Story01.rpy:5335
translate chinese bar_cyber_f758b6a2:

    # Fl "You already improved your odds."
    Fl "你已经提高了胜算。"

# game/Story01.rpy:5336
translate chinese bar_cyber_e0aaf1ce:

    # Fl "Saving that elf girl bought you a little goodwill."
    Fl "救了那个精灵丫头，替你攒了点人情。"

# game/Story01.rpy:5338
translate chinese bar_cyber_88b4bc98:

    # mc "I’m serious."
    mc "我说真的。"

# game/Story01.rpy:5340
translate chinese bar_cyber_315e0d87:

    # Fl "Me too."
    Fl "我也是。"

# game/Story01.rpy:5342
translate chinese bar_cyber_57475bed:

    # mc "Wait. If things go sideways…"
    mc "等等。要是出了岔子……"

# game/Story01.rpy:5344
translate chinese bar_cyber_73c50271:

    # Fl "Death."
    Fl "死。"

# game/Story01.rpy:5345
translate chinese bar_cyber_1bfdc47b:

    # Fl "You think I’m joking?"
