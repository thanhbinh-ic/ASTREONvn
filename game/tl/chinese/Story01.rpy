translate chinese gate2_9ed5c0a4:

    # g "You ready to move?"
    g "准备好动身了吗？"

# game/Story01.rpy:7737
translate chinese gate2_0817892e:

    # mc "Always."
    mc "随时。"

# game/Story01.rpy:7739
translate chinese gate2_ffaaa07f:

    # g "Good. Coordinates are on their way."
    g "好。坐标发过去了。"

# game/Story01.rpy:7740
translate chinese gate2_dbf66c82:

    # g "We’ll link up with the other squad en route."
    g "路上和另一队会合。"

