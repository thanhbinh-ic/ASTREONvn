translate chinese olivia_fr_scene_cfe138ab:

    # mc "Pay? No. It’s on the house."
    mc "付钱？不用。算店里请的。"

# game/Story01.rpy:9036
translate chinese olivia_fr_scene_a2aaa9ec_1:

    # h "Wha—"
    h "什——"

# game/Story01.rpy:9037
translate chinese olivia_fr_scene_d3dcc01c:

    # h "THANK YOU!"
    h "谢谢！"

# game/Story01.rpy:9038
translate chinese olivia_fr_scene_e2a62e6f:

    # h "Thank you so much for this opportunity!"
    h "太感谢你给我这个机会了！"

