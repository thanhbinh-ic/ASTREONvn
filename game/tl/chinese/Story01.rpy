translate chinese olivia_fr_scene_4ab7c756:

    # Mi "How… is Olivia?"
    Mi "奥利维亚……怎么样？"

# game/Story01.rpy:9149
translate chinese olivia_fr_scene_52fcebbf:

    # h "Oh, Mir. Just woke up."
    h "哦，米儿。刚醒。"

# game/Story01.rpy:9150
translate chinese olivia_fr_scene_f6c4f6fc:

    # Mi "How are you feeling?"
    Mi "你感觉怎么样？"

# game/Story01.rpy:9151
translate chinese olivia_fr_scene_5a75fe8b:

    # h "I’ll live."
    h "死不了。"

# game/Story01.rpy:9153
