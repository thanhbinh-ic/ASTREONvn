# game/Story01.rpy:28
translate chinese story02_a4f627a7:

    # C "(…Weird.)"
    C "（……怪。）"

# game/Story01.rpy:29
translate chinese story02_ba70757d:

    # C "(Feels like I haven’t been somewhere this… dead in years.)"
    C "（感觉好多年没待过这么……死气沉沉的地方了。）"

# game/Story01.rpy:31
translate chinese story02_08f84672:

    # C "(I wonder how Olivia’s doing…)"
    C "（不知道奥利维亚怎么样了……）"

# game/Story01.rpy:32
translate chinese story02_6145ad7f:

    # C "(It’s been quiet since last night…)"
    C "（从昨晚起就一直很安静……）"

# game/Story01.rpy:34
translate chinese story02_1411fa05:

    # C "(What if something went wrong?)"
    C "（要是出事了怎么办？）"

# game/Story01.rpy:36
translate chinese story02_ffbea665:

    # C "(No. Stop.)"
    C "（不。打住。）"

# game/Story01.rpy:37
translate chinese story02_61aee206:

    # C "(Don’t start that.)"
    C "（别开始想这些。）"

# game/Story01.rpy:38
translate chinese story02_c4afaa63:

    # C "(It’s just bad signal. That’s it.)"
    C "（只是信号差。就这样。）"

# game/Story01.rpy:39
translate chinese story02_37efb99b:

    # C "(Nothing more.)"
    C "（没别的。）"

# game/Story01.rpy:43
translate chinese story02_e51fac86:

    # new "In the early hours of the morning, sometime between midnight and 8 AM, a massive explosion ripped through the eastern sector."
    new "凌晨时分，午夜至早上八点之间，一场大规模爆炸撕裂了东区。"

# game/Story01.rpy:49
translate chinese story02_dfe6ade5:

    # new "Witnesses describe a deafening blast..."
    new "目击者称爆炸震耳欲聋……"

# game/Story01.rpy:50
translate chinese story02_1dfc6ae8:

    # new "Authorities believe this may have been an act of sabotage at a major oil facility."
    new "当局认为这可能是针对一座大型石油设施的破坏行动。"

# game/Story01.rpy:52
translate chinese story02_a9b0cdbb:

    # new "Fires are still raging out of control."
    new "大火仍在失控蔓延。"

# game/Story01.rpy:53
translate chinese story02_6058bb9a:

    # new "Officials are calling this one of the darkest days in recent history."
    new "官员称这是近期历史上最黑暗的日子之一。"

# game/Story01.rpy:58
translate chinese story02_ce098bc8:

    # new "Sources now report that those responsible may be a rogue group of former military personnel."
    new "消息源称，肇事者可能是一伙叛变的前军方人员。"

# game/Story01.rpy:59
translate chinese story02_f64266bb:

    # new "They are allegedly led by General Richard..."
    new "据称他们由理查德将军领导……"

# game/Story01.rpy:60
translate chinese story02_cc479bcf:

    # new "...who has just been placed on the country's most-wanted list."
    new "……他刚被列入全国头号通缉名单。"

# game/Story01.rpy:61
translate chinese story02_d8e4ed4b:

    # new "Authorities urge anyone with information to come forward immediately."
    new "当局呼吁知情者立即提供线索。"

# game/Story01.rpy:63
translate chinese story02_9462dfd7:

    # new "Several additional suspects have been identified."
    new "另有数名嫌疑人已被确认。"

# game/Story01.rpy:64
translate chinese story02_d255b98a:

    # new "Among them: Olivia... Norman... [mc]... Shiy..."
    new "其中包括：奥利维亚……诺曼……[mc]……诗雅……"

# game/Story01.rpy:66
translate chinese story02_7f68ff6d:

    # new "At this time, the situation remains unstable."
    new "目前局势仍不稳定。"

# game/Story01.rpy:67
translate chinese story02_353a5bc9:

    # new "We will continue to monitor developments and bring you updates as soon as they come in."
    new "我们将持续关注事态发展，一有消息会立即播报。"

# game/Story01.rpy:71
translate chinese story02_77133247:

    # D "Sir... there’s an urgent call for you."
    D "长官……有您的紧急电话。"

# game/Story01.rpy:73
translate chinese story02_3e938594:

    # a "...I’m listening."
    a "……我在听。"

# game/Story01.rpy:74
translate chinese story02_008e8116:

    # a "Is there anything else you need from me?"
    a "还需要我做什么吗？"

# game/Story01.rpy:76
translate chinese story02_e1554201:

    # s "..."
    s "……"

# game/Story01.rpy:77
translate chinese story02_34fc5d0a:

    # a "I’ve done everything you asked."
    a "你要求的我都做了。"

# game/Story01.rpy:78
translate chinese story02_d31186c1:

    # a "Every target. Every betrayal."
    a "每一个目标。每一次背叛。"

# game/Story01.rpy:79
translate chinese story02_e3f1a8ae:

    # a "Now it’s your turn."
    a "现在轮到你了。"

# game/Story01.rpy:80
translate chinese story02_0406cc2e:

    # a "Let my family go."
    a "放了我的家人。"

# game/Story01.rpy:82
translate chinese story02_35bddc26:

    # s "Heh..."
    s "嘿……"

# game/Story01.rpy:83
translate chinese story02_831b1755:

    # s "You’ve been... exceptional."
    s "你一直……表现出色。"

# game/Story01.rpy:84
translate chinese story02_0d65ce5b:

    # s "Efficient. Precise. Obedient."
    s "高效。精准。听话。"

# game/Story01.rpy:86
translate chinese story02_9931ddb7:

    # a "...What’s that supposed to mean?"
    a "……你这话什么意思？"

# game/Story01.rpy:88
translate chinese story02_d00b005e:

    # s "It means you did exactly what we needed."
    s "意思是你完全做到了我们需要你做的事。"

# game/Story01.rpy:89
translate chinese story02_9113285e:

    # s "But your family?"
    s "但你的家人？"

# game/Story01.rpy:90
translate chinese story02_629e621b:

    # s "...They were never part of the deal."
    s "……他们从来就不在交易里。"

# game/Story01.rpy:92
translate chinese story02_4449cdef:

    # a "...No."
    a "……不。"

# game/Story01.rpy:93
translate chinese story02_b4231bba:

    # a "No, that’s not true."
    a "不，这不是真的。"

# game/Story01.rpy:94
translate chinese story02_d34e85ef:

    # a "That’s NOT what we agreed!"
    a "我们不是这么约定的！"

# game/Story01.rpy:96
translate chinese story02_393a175c:

    # a "You said they’d be safe!"
    a "你说过他们会安全的！"

# game/Story01.rpy:97
translate chinese story02_b132e961:

    # a "You said—"
    a "你说过——"

# game/Story01.rpy:99
translate chinese story02_a6f6bc83:

    # s "You knew the risks."
    s "你知道风险。"

# game/Story01.rpy:100
translate chinese story02_7f158e89:

    # s "And you made your choice."
    s "你做了你的选择。"

# game/Story01.rpy:102
translate chinese story02_7d24dd49:

    # a "You bastards..."
    a "你们这些混蛋……"

# game/Story01.rpy:103
translate chinese story02_cb9d8155:

    # a "I gave you EVERYTHING!"
    a "我把一切都给了你们！"

# game/Story01.rpy:105
translate chinese story02_594d532d:

    # a "And this is how you repay me?!"
    a "你们就这么报答我？！"

# game/Story01.rpy:107
translate chinese story02_63fd9bf2:

    # s "You should be proud."
    s "你该感到骄傲。"

# game/Story01.rpy:108
translate chinese story02_152b931b:

    # s "...Goodbye."
    s "……再见。"

# game/Story01.rpy:110
translate chinese story02_7f7287c5:

    # a "Wait!"
    a "等等！"

# game/Story01.rpy:111
translate chinese story02_60af5283:

    # a "PLEASE—!"
    a "求你了——！"

# game/Story01.rpy:112
translate chinese story02_76186a72:

    # a "DON’T DO THIS!!"
    a "别这么做！！"

# game/Story01.rpy:128
translate chinese story02_a1456179:

    # a "It’s a miracle he’s still breathing..."
    a "他还能呼吸简直是奇迹……"

# game/Story01.rpy:131
translate chinese story02_bea7194b:

    # a "Sir, tomography shows the artery is ruptured and has caused internal bleeding. We need to repair it immediately."
    a "长官，断层扫描显示动脉破裂，已造成内出血。必须立刻修复。"

# game/Story01.rpy:133
translate chinese story02_25490aca:

    # a "We have to operate on the artery right now, or the damage will be irreversible."
    a "现在就得给动脉做手术，否则损伤将不可逆。"

# game/Story01.rpy:144
translate chinese story02_1678d9e4:

    # a "Damn it, I told you this was reckless. Cybernetic heart implantation is almost always a guaranteed death."
    a "该死，我说过这太冒险了。机械心脏移植几乎等于必死。"

# game/Story01.rpy:147
translate chinese story02_dc3fac37:

    # a "We don’t have time for this. Scalpel!"
    a "没时间了。手术刀！"

# game/Story01.rpy:160
translate chinese story02_852dcd31:

    # h "Please... don’t leave me here alone..."
    h "求你了……别把我一个人丢在这儿……"

# game/Story01.rpy:161
translate chinese story02_2b17c6ac:

    # h "You promised me... Please..."
    h "你答应过我的……求你了……"

# game/Story01.rpy:189
translate chinese story02_2b35b6fe:

    # mc "..."
    mc "……"

# game/Story01.rpy:192
translate chinese story02_4b3356bd:

    # mc "Where…"
    mc "我这是在哪……"

# game/Story01.rpy:194
translate chinese story02_72a4ce55:

    # mc "How did I even get here…?"
    mc "我怎么到这儿来的……？"

# game/Story01.rpy:196
translate chinese story02_2e8f579a:

    # mc "What is this place…?"
    mc "这地方是什么……？"

# game/Story01.rpy:197
translate chinese story02_b9306177:

    # mc "Messing with me."
    mc "耍我。"

# game/Story01.rpy:199
translate chinese story02_edf35add:

    # mc "…Nothing."
    mc "……什么都没有。"

# game/Story01.rpy:200
translate chinese story02_4726a806:

    # mc "I can’t remember anything."
    mc "我什么都想不起来。"

# game/Story01.rpy:202
translate chinese story02_3435593b:

    # mc "I should move…"
    mc "我该走了……"

# game/Story01.rpy:203
translate chinese story02_2a4a2b07:

    # mc "…But there’s nothing here."
    mc "……但这里什么都没有。"

# game/Story01.rpy:205
translate chinese story02_2182f1d2:

    # mc "No choice."
    mc "没得选。"

# game/Story01.rpy:207
translate chinese story02_59248d70:

    # mc "Alright… here goes nothing"
    mc "好吧……豁出去了。"

# game/Story01.rpy:214
translate chinese story02_2b35b6fe_1:

    # mc "..."
    mc "……"

# game/Story01.rpy:215
translate chinese story02_6cddaf9d:

    # mc "…Wait."
    mc "……等等。"

# game/Story01.rpy:216
translate chinese story02_25a60c16:

    # mc "I’ve been here."
    mc "我来过这儿。"

# game/Story01.rpy:218
translate chinese story02_710fbd0f:

    # mc "No…"
    mc "不……"

# game/Story01.rpy:220
translate chinese story02_192e4743:

    # mc "Just the dark."
    mc "只有黑暗。"

# game/Story01.rpy:222
translate chinese story02_b9306177_1:

    # mc "Messing with me."
    mc "耍我。"

# game/Story01.rpy:229
translate chinese story02_2b35b6fe_2:

    # mc "..."
    mc "……"

# game/Story01.rpy:231
translate chinese story02_d71adc78:

    # mc "Is anyone out there?!"
    mc "外面有人吗？！"

# game/Story01.rpy:233
translate chinese story02_2b35b6fe_3:

    # mc "..."
    mc "……"

# game/Story01.rpy:235
translate chinese story02_a9af5f58:

    # mc "HEY!"
    mc "喂！"

# game/Story01.rpy:236
translate chinese story02_88c2db0f:

    # mc "ANYONE?!"
    mc "有人吗？！"

# game/Story01.rpy:238
translate chinese story02_2b35b6fe_4:

    # mc "..."
    mc "……"

# game/Story01.rpy:239
translate chinese story02_edf35add_1:

    # mc "…Nothing."
    mc "……什么都没有。"

# game/Story01.rpy:240
translate chinese story02_cff13afd:

    # mc "Not even an echo."
    mc "连回声都没有。"

# game/Story01.rpy:242
translate chinese story02_6cddaf9d_1:

    # mc "…Wait."
    mc "……等等。"

# game/Story01.rpy:243
translate chinese story02_ac05676a:

    # mc "Light?"
    mc "光？"

# game/Story01.rpy:244
translate chinese story02_c172e388:

    # mc "If not for that…"
    mc "要不是那个……"

# game/Story01.rpy:246
translate chinese story02_2c9a0519:

    # mc "…Yeah."
    mc "……是啊。"

# game/Story01.rpy:247
translate chinese story02_8decc918:

    # mc "I’m alone."
    mc "我孤身一人。"

# game/Story01.rpy:249
translate chinese story02_6ddea609:

    # mc "I have to keep hoping I’ll find a way out of here."
    mc "我得一直抱有希望，找到出去的路。"

# game/Story01.rpy:250
translate chinese story02_d0c42e25:

    # mc "(Find Lora. Find a way home.)"
    mc "（找到洛拉。找到回家的路。）"

# game/Story01.rpy:251
translate chinese story02_95a54c49:

    # mc "(Everything else comes after that.)"
    mc "（其他都得排在这之后。）"

# game/Story01.rpy:260
translate chinese story02_2b35b6fe_5:

    # mc "..."
    mc "……"

# game/Story01.rpy:261
translate chinese story02_15790dd4:

    # mc "No way out…?"
    mc "没有出口……？"

# game/Story01.rpy:262
translate chinese story02_ee4c2bb5:

    # mc "Am I stuck here…?"
    mc "我困在这儿了……？"

# game/Story01.rpy:264
translate chinese story02_fca52711:

    # mc "No."
    mc "不。"

# game/Story01.rpy:273
translate chinese story02_2b35b6fe_6:

    # mc "..."
    mc "……"

# game/Story01.rpy:275
translate chinese story02_6ae6e1a0:

    # mc "Is anyone here?!"
    mc "有人在这儿吗？！"

# game/Story01.rpy:278
translate chinese story02_22dd7dac:

    # a "To your left."
    a "在你左边。"

# game/Story01.rpy:280
translate chinese story02_99be54dd:

    # mc "…What?"
    mc "……什么？"

# game/Story01.rpy:282
translate chinese story02_8ab6042e:

    # mc "It can’t be…"
    mc "不可能……"

# game/Story01.rpy:284
translate chinese story02_f06c3754:

    # mc "Light…"
    mc "光……"

# game/Story01.rpy:294
translate chinese story02_1bcb71b9:

    # mc "…What is this…"
    mc "……这是什么……"

# game/Story01.rpy:296
translate chinese story02_76208da9:

    # mc "I’ve never seen anything..."
    mc "我从没见过……"

# game/Story01.rpy:298
translate chinese story02_2b35b6fe_7:

    # mc "..."
    mc "……"

# game/Story01.rpy:300
translate chinese story02_d63677d6:

    # mc "Wait, is that…"
    mc "等等，那是……"

# game/Story01.rpy:302
translate chinese story02_c080aac0:

    # mc "…Someone?"
    mc "……有人？"

# game/Story01.rpy:306
translate chinese story02_26be1618:

    # mc "…Hey."
    mc "……嘿。"

# game/Story01.rpy:308
translate chinese story02_88c417e1:

    # mc "Mind if I sit?"
    mc "介意我坐下吗？"

# game/Story01.rpy:310
translate chinese story02_7e30ac6b:

    # mc "You’re the first person I’ve seen."
    mc "你是我见到的第一个人。"

# game/Story01.rpy:311
translate chinese story02_630ab349:

    # mc "…In a while."
    mc "……好久以来。"

# game/Story01.rpy:313
translate chinese story02_39f28fd6:

    # a "Of course… sit."
    a "当然……坐吧。"

# game/Story01.rpy:315
translate chinese story02_2b35b6fe_8:

    # mc "..."
    mc "……"

# game/Story01.rpy:317
translate chinese story02_da9ae18a:

    # a "Peaceful, isn’t it…?"
    a "很平静，对吧……？"

# game/Story01.rpy:318
translate chinese story02_ee28a28a:

    # a "Makes you want to just sit here… and never leave."
    a "让人就想这么坐着……永远不离开。"

# game/Story01.rpy:320
translate chinese story02_adf27f82:

    # mc "You seen anyone else?"
    mc "你还见过别人吗？"

# game/Story01.rpy:326
translate chinese story02_60dbf0fc:

    # a "Before you? No."
    a "你来之前？没有。"

# game/Story01.rpy:327
translate chinese story02_11f77bd1:

    # a "You’re the first one I’ve seen… this whole time."
    a "你是我……这段时间见到的第一个。"

# game/Story01.rpy:329
translate chinese story02_9883c7ca:

    # mc "Do you know where we are?"
    mc "你知道我们在哪吗？"

# game/Story01.rpy:330
translate chinese story02_de7167af:

    # mc "Or how you got here?"
    mc "或者你怎么到这儿来的？"

# game/Story01.rpy:334
translate chinese story02_bb8e4b4e:

    # a "..."
    a "……"

# game/Story01.rpy:338
translate chinese story02_4462c178:

    # a "…No."
    a "……不知道。"

# game/Story01.rpy:339
translate chinese story02_1db94000:

    # a "I don’t."
    a "我不知道。"

# game/Story01.rpy:341
translate chinese story02_9cab0f02:

    # mc "…I see."
    mc "……明白了。"

# game/Story01.rpy:343
translate chinese story02_2b35b6fe_9:

    # mc "..."
    mc "……"

# game/Story01.rpy:345
translate chinese story02_bb8e4b4e_1:

    # a "..."
    a "……"

# game/Story01.rpy:348
translate chinese story02_4e6f4ed5:

    # mc "Wait…"
    mc "等等……"

# game/Story01.rpy:349
translate chinese story02_126e8ea1:

    # mc "You’re leaving?"
    mc "你要走了？"

# game/Story01.rpy:350
translate chinese story02_cf3c5acb:

    # mc "We just—"
    mc "我们才刚——"

# game/Story01.rpy:358
translate chinese story02_ae76b991:

    # mc "Where are you going?"
    mc "你要去哪？"

# game/Story01.rpy:359
translate chinese story02_dfcf39f1:

    # mc "…Stay."
    mc "……留下。"

# game/Story01.rpy:361
translate chinese story02_bb8e4b4e_2:

    # a "..."
    a "……"

# game/Story01.rpy:363
translate chinese story02_eb97714c:

    # a "…One last thing."
    a "……最后一件事。"

# game/Story01.rpy:367
translate chinese story02_16a1e545:

    # a "When I go… let me go with a smile."
    a "我走的时候……让我笑着走。"

# game/Story01.rpy:368
translate chinese story02_763a7d2a:

    # a "Don’t let grief take that light from you."
    a "别让悲伤夺走你眼里的光。"

# game/Story01.rpy:369
translate chinese story02_32c28911:

    # a "Keep writing your story."
    a "继续写你的故事。"

# game/Story01.rpy:370
translate chinese story02_c75fd23c:

    # a "Live with courage… live bright."
    a "勇敢地活……活得明亮。"

# game/Story01.rpy:372
translate chinese story02_3aa8639e:

    # mc "…live bright."
    mc "……活得明亮。"

# game/Story01.rpy:376
translate chinese story02_87f2d5e2:

    # mc "…How do you know that?"
    mc "……你怎么知道这句？"

# game/Story01.rpy:377
translate chinese story02_59b7cddb:

    # Ne "You used to say that… whenever you thought of Mom."
    Ne "你以前常说这句……每次想起妈妈的时候。"

# game/Story01.rpy:378
translate chinese story02_eb061583:

    # Ne "…And I’m sorry."
    Ne "……对不起。"

# game/Story01.rpy:379
translate chinese story02_367416b0:

    # Ne "Looks like I’ll be the one going first."
    Ne "看来这次要先走的是我。"

# game/Story01.rpy:383
translate chinese story02_c4cad566:

    # Ne "One more thing…"
    Ne "还有一件事……"

# game/Story01.rpy:384
translate chinese story02_0388845b:

    # Ne "Take care of Alex… and Mina."
    Ne "照顾好亚历克斯……还有米娜。"

# game/Story01.rpy:386
translate chinese story02_e81daee8:

    # Ne "Thank you… for everything, Dad."
    Ne "谢谢你……为我做的一切，爸。"

# game/Story01.rpy:387
translate chinese story02_0ed08e61:

    # Ne "I’ll be waiting for you."
    Ne "我会等你。"

# game/Story01.rpy:389
translate chinese story02_6a6a2f33:

    # mc "Wait a minute!"
    mc "等一下！"

# game/Story01.rpy:390
translate chinese story02_c635c30e:

    # mc "Wait—"
    mc "等等——"

# game/Story01.rpy:392
translate chinese story02_4574addf:

    # mc "NORMAN!"
    mc "诺曼！"

# game/Story01.rpy:415
translate chinese laborat_5dfbdc5e:

    # o "Ah… there you are."
    o "啊……你醒了。"

# game/Story01.rpy:417
translate chinese laborat_bf394726:

    # o "Easy. Don’t rush it."
    o "慢点。别急。"

# game/Story01.rpy:418
translate chinese laborat_c56751c2:

    # o "You barely held together the first time when your artery ruptured, seams are still… questionable."
    o "你动脉破裂那次能撑住已经很勉强了，缝合处现在……还不好说。"

# game/Story01.rpy:420
translate chinese laborat_bb019795:

    # mc "Where am I?"
    mc "我在哪？"

# game/Story01.rpy:421
translate chinese laborat_602f206c:

    # mc "What did you do to me—"
    mc "你对我做了什么——"

# game/Story01.rpy:424
translate chinese laborat_b473602d:

    # mc "AH!"
    mc "啊！"

# game/Story01.rpy:426
translate chinese laborat_1eb991d4:

    # o "Your body hasn’t fully agreed on being alive."
    o "你的身体还没完全同意活过来。"

# game/Story01.rpy:427
translate chinese laborat_04a941bb:

    # o "Don’t fight it."
    o "别跟它对着干。"

# game/Story01.rpy:428
translate chinese laborat_070a6159:

    # o "Let your head catch up."
    o "让脑子慢慢跟上。"

# game/Story01.rpy:431
translate chinese laborat_bdee8dfb:

    # o "Answers will come, with time."
    o "答案会有的，慢慢来。"

# game/Story01.rpy:432
translate chinese laborat_5fc9d7aa:

    # mc "That’s not good enough."
    mc "这不够。"

# game/Story01.rpy:434
translate chinese laborat_67adfbf0:

    # o "For now… breathe."
    o "现在……先呼吸。"

# game/Story01.rpy:435
translate chinese laborat_0ffb8499:

    # o "Yeah. Like that."
    o "对。就这样。"

# game/Story01.rpy:438
translate chinese laborat_2a10ba1a:

    # mc "My head’s…"
    mc "我脑袋……"

# game/Story01.rpy:439
translate chinese laborat_fff539bf:

    # mc "It’s all a static noise."
    mc "全是噪音。"

# game/Story01.rpy:442
translate chinese laborat_6ed37cb9:

    # R "That’s because it should be."
    R "本来就该这样。"

# game/Story01.rpy:444
translate chinese laborat_e6cd6068:

    # R "You were clinically dead."
    R "你临床死亡过。"

# game/Story01.rpy:447
translate chinese laborat_6a013027:

    # R "Several minutes without oxygen."
    R "缺氧好几分钟。"

# game/Story01.rpy:448
translate chinese laborat_777e939e:

    # R "By all known parameters… you are supposed to be gone."
    R "按所有已知指标……你本该没了。"

# game/Story01.rpy:450
translate chinese laborat_3461d683:

    # R "And yet here you are."
    R "可你现在就在这儿。"

# game/Story01.rpy:452
translate chinese laborat_9c28cd9b:

    # R "We rebuilt you."
    R "我们重建了你。"

# game/Story01.rpy:453
translate chinese laborat_723df266:

    # mc "Rebuilt?! What do you mean?"
    mc "重建？！什么意思？"

# game/Story01.rpy:454
translate chinese laborat_be47df5a:

    # R "Listen."
    R "听着。"

# game/Story01.rpy:455
translate chinese laborat_a711170e:

    # R "You were dying. We had to replace all that we could replace, and stabilized the rest."
    R "你快死了。我们只能换掉能换的，稳住剩下的。"

# game/Story01.rpy:457
translate chinese laborat_27485a9a:

    # R "I will tell you more later, for now all you need to know is..."
    R "以后再告诉你更多，现在你只需要知道……"

# game/Story01.rpy:460
translate chinese laborat_74fcf195:

    # R "We brought you back."
    R "我们把你带回来了。"

# game/Story01.rpy:463
translate chinese laborat_147a4b65:

    # R "Remember anything?"
    R "记得什么吗？"

# game/Story01.rpy:464
translate chinese laborat_5e01d4cd:

    # mc "Should I?"
    mc "我该记得什么？"

# game/Story01.rpy:466
translate chinese laborat_8765836a:

    # mc "(Where…?)"
    mc "（哪儿……？）"

# game/Story01.rpy:467
translate chinese laborat_fe6ed374:

    # mc "(No...)"
    mc "（不……）"

# game/Story01.rpy:468
translate chinese laborat_4505813a:

    # mc "(Why can’t I remember?)"
    mc "（我为什么想不起来？）"

# game/Story01.rpy:470
translate chinese laborat_70bd6e6b:

    # mc "It’s all…"
    mc "全都……"

# game/Story01.rpy:471
translate chinese laborat_70405d8f:

    # mc "Just… fog."
    mc "就是……一团雾。"

# game/Story01.rpy:472
translate chinese laborat_445d1c5a:

    # mc "I can’t reach it."
    mc "我够不着。"

# game/Story01.rpy:474
translate chinese laborat_02025156:

    # o "Looks like the memory blocker’s still running."
    o "看来记忆阻断器还在运行。"

# game/Story01.rpy:475
translate chinese laborat_84540ac9:

    # o "That would explain the fog."
    o "那就解释了这团雾。"

# game/Story01.rpy:476
translate chinese laborat_16ccb179:

    # o "Sit still. Let me take a look."
    o "别动。我看看。"

# game/Story01.rpy:479
translate chinese laborat_1402a39f:

    # mc "A memory blocker…?"
    mc "记忆阻断器……？"

# game/Story01.rpy:480
translate chinese laborat_66599836:

    # mc "You put something in my head?!"
    mc "你们往我脑子里塞了东西？！"

# game/Story01.rpy:482
translate chinese laborat_26671af7:

    # o "What, surprised?"
    o "怎么，意外？"

# game/Story01.rpy:484
translate chinese laborat_046e871e:

    # o "Relax. It’s standard procedure. After trauma like yours, brains tend to melt."
    o "放松。这是标准流程。你那种创伤之后，脑子容易烧坏。"

# game/Story01.rpy:485
translate chinese laborat_976302be:

    # o "Memory blockers prevent this from happening."
    o "记忆阻断器能防止这种情况。"

# game/Story01.rpy:488
translate chinese laborat_2a3d35e8:

    # o "I’m going to ease the flow a bit."
    o "我把流量调小一点。"

# game/Story01.rpy:490
translate chinese laborat_7e184edb:

    # o "And here’s a friendly tip-"
    o "还有句友善的提醒——"

# game/Story01.rpy:491
translate chinese laborat_7421c376:

    # o "Try not to scream."
    o "尽量别叫。"

# game/Story01.rpy:493
translate chinese laborat_932c5dc9:

    # o "You will anyway, but… worth saying."
    o "你肯定会叫的，不过……还是说一句。"

# game/Story01.rpy:496
translate chinese laborat_2464810c:

    # mc "Why does it—"
    mc "为什么这么——"

# game/Story01.rpy:497
translate chinese laborat_38cb8147:

    # mc "Fuck!"
    mc "操！"

# game/Story01.rpy:498
translate chinese laborat_c686a4db:

    # mc "It’s burning!"
    mc "烧起来了！"

# game/Story01.rpy:500
translate chinese laborat_e9ecf1e5:

    # o "Pain means the signal’s getting through."
    o "疼说明信号通了。"

# game/Story01.rpy:501
translate chinese laborat_26112d55:

    # o "Feels awful, I know. But still good news."
    o "我知道很难受。但还是好消息。"

# game/Story01.rpy:502
translate chinese laborat_e5a5f31c:

    # o "Your memory should start coming back. Slowly."
    o "你的记忆应该会开始回来。慢慢地。"

# game/Story01.rpy:504
translate chinese laborat_c6a1905a:

    # R "Focus."
    R "集中。"

# game/Story01.rpy:505
translate chinese laborat_a7639c9e:

    # R "Name?"
    R "名字？"

# game/Story01.rpy:507
translate chinese laborat_b8950aef:

    # "Your memory starts coming back."
    "你的记忆开始回来了。"

# game/Story01.rpy:508
translate chinese laborat_f0f1b55f:

    # mc "(…I died?)"
    mc "（……我死了？）"

# game/Story01.rpy:510
translate chinese laborat_6bae8be1:

    # mc "(No…)"
    mc "（不……）"

# game/Story01.rpy:511
translate chinese laborat_16411555:

    # mc "(No.)"
    mc "（不。）"

# game/Story01.rpy:512
translate chinese laborat_e84f88be:

    # R "You hear me?"
    R "听见了吗？"

# game/Story01.rpy:513
translate chinese laborat_54b1f11f:

    # R "Your name."
    R "你的名字。"

# game/Story01.rpy:515
translate chinese laborat_cba3697f:

    # mc "(Name…?)"
    mc "（名字……？）"

# game/Story01.rpy:516
translate chinese laborat_cc79174b:

    # mc "(My name…)"
    mc "（我的名字……）"

# game/Story01.rpy:518
translate chinese laborat_bd7d9df9:

    # mc "[mc]."
    mc "[mc]。"

# game/Story01.rpy:520
translate chinese laborat_e6930fb4:

    # R "Age?"
    R "年龄？"

# game/Story01.rpy:522
translate chinese laborat_eb3e7e9c:

    # mc "44."
    mc "44。"

# game/Story01.rpy:523
translate chinese laborat_b0c4ab05:

    # mc "Before you ask more questions, who are you and why did you do this for me?"
    mc "在你继续问之前，你是谁，为什么为我做这些？"

# game/Story01.rpy:525
translate chinese laborat_3f5ad8b2:

    # R "We’re not here to answer questions. We are here on the orders of The Lady."
    R "我们不是来回答问题的。我们是奉夫人之命行事。"

# game/Story01.rpy:526
translate chinese laborat_42fa21ca:

    # R "We just need to make sure you function."
    R "我们只需要确认你能正常运作。"

# game/Story01.rpy:527
translate chinese laborat_41ce4368:

    # mc "Who is this Lady you are talking about?"
    mc "你说的这个夫人是谁？"

# game/Story01.rpy:528
translate chinese laborat_e5017948:

    # R "You can ask those questions later, for now answer my questions."
    R "那些问题以后再说，现在回答我的问题。"

# game/Story01.rpy:529
translate chinese laborat_aa3fbcc6:

    # R "Any irregularities?"
    R "有没有异常？"

# game/Story01.rpy:530
translate chinese laborat_cdcbed36:

    # R "Dizziness. Nausea."
    R "头晕。恶心。"

# game/Story01.rpy:531
translate chinese laborat_b8b9ae64:

    # R "Intrusive imagery… existential or otherwise."
    R "侵入性画面……存在层面或其他层面的。"

# game/Story01.rpy:533
translate chinese laborat_f9a88a3c:

    # mc "(Yeah… this doesn’t feel right. Not even close.)"
    mc "（是啊……这感觉不对劲。一点都不对。）"

# game/Story01.rpy:534
translate chinese laborat_d3a5762e:

    # mc "(And, showing weakness isn’t an option either.)"
    mc "（而且，示弱也不是选项。）"

# game/Story01.rpy:536
translate chinese laborat_fca52711:

    # mc "No."
    mc "没有。"

# game/Story01.rpy:537
translate chinese laborat_e747974e:

    # mc "Felt… normal."
    mc "感觉……正常。"

# game/Story01.rpy:539
translate chinese laborat_9e6af5ff:

    # R "Convincing."
    R "挺有说服力。"

# game/Story01.rpy:540
translate chinese laborat_8b7d0a45:

    # R "True or not doesn’t matter."
    R "真假不重要。"

# game/Story01.rpy:541
translate chinese laborat_1e6f204c:

    # R "If you believe it, it holds."
    R "你信它，它就成立。"

# game/Story01.rpy:542
translate chinese laborat_c7cd04ec:

    # R "Let’s proceed."
    R "继续。"

# game/Story01.rpy:543
translate chinese laborat_15e6617d:

    # R "The last memory before you woke u-"
    R "你醒来之前的最后一个记忆——"

# game/Story01.rpy:544
translate chinese laborat_788ee394:

    # mc "What’s the point of all this?"
    mc "这一切到底为了什么？"

# game/Story01.rpy:545
translate chinese laborat_9439f40f:

    # R "I already—"
    R "我已经——"

# game/Story01.rpy:546
translate chinese laborat_b3f50f9e:

    # mc "Details."
    mc "细节。"

# game/Story01.rpy:547
translate chinese laborat_c6841c25:

    # R "..."
    R "……"

# game/Story01.rpy:548
translate chinese laborat_7a20561e:

    # R "I can’t."
    R "我不能说。"

# game/Story01.rpy:549
translate chinese laborat_1c447368:

    # R "That’s above me."
    R "这超出我的权限。"

# game/Story01.rpy:551
translate chinese laborat_2d7fb07c:

    # mc "(That’s all I’m getting out of him?)"
    mc "（就只能从他嘴里套出这些？）"

# game/Story01.rpy:553
translate chinese laborat_880719c3:

    # mc "(Then...)"
    mc "（那……）"

# game/Story01.rpy:554
translate chinese laborat_94a192d9:

    # mc "(…What was last?)"
    mc "（……最后是什么？）"

# game/Story01.rpy:557
translate chinese laborat_85ec5381:

    # mc "(Mission… a ship. {w=0.5}No data. Just coordinates...)"
    mc "（任务……一艘船。{w=0.5}没有数据。只有坐标……）"

# game/Story01.rpy:560
translate chinese laborat_06687f0c:

    # mc "(Blind orders.)"
    mc "（盲目的命令。）"

# game/Story01.rpy:563
translate chinese laborat_bd04f159:

    # mc "(Tell them the truth?)"
    mc "（告诉他们真相？）"

# game/Story01.rpy:564
translate chinese laborat_53895df7:

    # mc "(No... I don’t know them. This stays with me.)"
    mc "（不……我不认识他们。这事我自己留着。）"

# game/Story01.rpy:566
translate chinese laborat_928fe220:

    # mc "We went in."
    mc "我们进去了。"

# game/Story01.rpy:567
translate chinese laborat_49ca651e:

    # mc "A structure… gutted from the inside. {w=0.5}No light. {w=0.5}No life. {w=0.5}Just wreckage and then-"
    mc "一个结构……内部被掏空了。{w=0.5}没有光。{w=0.5}没有生命。{w=0.5}只有残骸，然后——"

# game/Story01.rpy:573
translate chinese laborat_b73f1e76:

    # mc "(We weren’t alone. There was something else there.)"
    mc "（我们不孤单。那儿还有别的东西。）"

# game/Story01.rpy:575
translate chinese laborat_29e82f45:

    # mc "(Not a survivor.)"
    mc "（不是幸存者。）"

# game/Story01.rpy:579
translate chinese laborat_7f2d6501:

    # mc "There was chaos... We saw—"
    mc "一片混乱……我们看到——"

# game/Story01.rpy:581
translate chinese laborat_fd2106ed:

    # mc "(Wait…)"
    mc "（等等……）"

# game/Story01.rpy:585
translate chinese laborat_dd71eecc:

    # mc "(Not something.)"
    mc "（不是东西。）"

# game/Story01.rpy:588
translate chinese laborat_863ccfc2:

    # mc "(Someone.)"
    mc "（是人。）"

# game/Story01.rpy:591
translate chinese laborat_d580f344:

    # N "Don’t—"
    N "别——"

# game/Story01.rpy:594
translate chinese laborat_c44180d5:

    # h "Stay with me…"
    h "撑住……"

# game/Story01.rpy:598
translate chinese laborat_2bdee30a:

    # mc "(Olivia… Norman…)"
    mc "（奥利维亚……诺曼……）"

# game/Story01.rpy:601
translate chinese laborat_13149de2:

    # mc "OLIVIA!"
    mc "奥利维亚！"

# game/Story01.rpy:602
translate chinese laborat_4574addf:

    # mc "NORMAN!"
    mc "诺曼！"

# game/Story01.rpy:603
translate chinese laborat_1e11997f:

    # mc "Where are they?!"
    mc "他们在哪？！"

# game/Story01.rpy:604
translate chinese laborat_3e874d70:

    # mc "What happened?!"
    mc "出什么事了？！"

# game/Story01.rpy:605
translate chinese laborat_7ac6df9b:

    # mc "They’re alive—"
    mc "他们还活着——"

# game/Story01.rpy:607
translate chinese laborat_24df3c27:

    # R "Calm yourself."
    R "冷静。"

# game/Story01.rpy:609
translate chinese laborat_f919669f:

    # R "They’re alive."
    R "他们还活着。"

# game/Story01.rpy:610
translate chinese laborat_2578fc2f:

    # mc "(…Alive.)"
    mc "（……活着。）"

# game/Story01.rpy:612
translate chinese laborat_5f629198:

    # R "For now… that is sufficie-."
    R "目前……这就够——"

# game/Story01.rpy:613
translate chinese laborat_e59999a2:

    # mc "...Take me to them."
    mc "……带我去见他们。"

# game/Story01.rpy:614
translate chinese laborat_81057b31:

    # mc "Now."
    mc "现在。"

# game/Story01.rpy:617
translate chinese laborat_0127efdb:

    # o "Okay, but first…"
    o "行，但先……"

# game/Story01.rpy:618
translate chinese laborat_6c08d291:

    # o "Walking the halls like that? You’ll attract attention."
    o "你这样在走廊里走？会引人注意。"

# game/Story01.rpy:630
translate chinese laborat_912166ec:

    # H "Access is restricted. Unauthorized presence will trigger protocol-level alerts."
    H "访问受限。未经授权的存在将触发协议级警报。"

# game/Story01.rpy:633
translate chinese laborat_ba960e6a:

    # mc "(It seems like I’m in some kind of cutting-edge laboratory. Far too advanced for anything I’ve ever seen...)"
    mc "（看来我在某种尖端实验室里。远比我见过的任何东西都先进……）"

# game/Story01.rpy:635
translate chinese laborat_8fdb88c1:

    # R "You know… your arrival stirred quite a bit of unease."
    R "你知道吗……你的到来引起了不少不安。"

# game/Story01.rpy:636
translate chinese laborat_88ecc694:

    # R "The right hand himself dragging someone in?"
    R "二把手亲自拖人进来？"

# game/Story01.rpy:637
translate chinese laborat_9926c4f2:

    # R "Personally? {w=0.5}That doesn't happen."
    R "亲自动手？{w=0.5}从没这种事。"

# game/Story01.rpy:639
translate chinese laborat_ba824ca9:

    # mc "The right hand?"
    mc "二把手？"

# game/Story01.rpy:641
translate chinese laborat_40e07d95:

    # R "Yeah. Big name around here."
    R "对。这儿的大人物。"

# game/Story01.rpy:642
translate chinese laborat_dab63a3f:

    # R "Which makes it… interesting."
    R "这就……有意思了。"

# game/Story01.rpy:643
translate chinese laborat_c66bfa89:

    # R "What exactly makes you worth the trouble?"
    R "你到底有什么值得这么大费周章？"

# game/Story01.rpy:645
translate chinese laborat_aa88ac1b:

    # mc "Skip the speech."
    mc "别废话。"

# game/Story01.rpy:646
translate chinese laborat_ceb2752f:

    # mc "And answer my questions."
    mc "回答我的问题。"

# game/Story01.rpy:647
translate chinese laborat_d96bd7aa:

    # mc "What have you done to my body? It feels... different"
    mc "你们对我身体做了什么？感觉……不一样了。"

# game/Story01.rpy:650
translate chinese laborat_99a1470a:

    # R "We integrated your body with implants."
    R "我们把你的身体和植入体整合了。"

# game/Story01.rpy:651
translate chinese laborat_3c4a120d:

    # R "But that’s not the problem."
    R "但问题不在那。"

# game/Story01.rpy:652
translate chinese laborat_3add8db2:

    # R "Your body… interacts with them too well."
    R "你的身体……和它们互动得太好了。"

# game/Story01.rpy:653
translate chinese laborat_89994d73:

    # R "Not like an external system."
    R "不像外部系统。"

# game/Story01.rpy:654
translate chinese laborat_86cd3478:

    # R "Like they belong to you."
    R "像它们本来就属于你。"

# game/Story01.rpy:655
translate chinese laborat_4fc2d8a1:

    # R "As if they always did."
    R "仿佛一直如此。"

# game/Story01.rpy:657
translate chinese laborat_edd489bc:

    # mc "Where’s my son?"
    mc "我儿子在哪？"

# game/Story01.rpy:658
translate chinese laborat_1d1a1555:

    # mc "Where’s Olivia?"
    mc "奥利维亚在哪？"

# game/Story01.rpy:660
translate chinese laborat_33a7cf0e:

    # R "Last time I saw your… friend, she was safe."
    R "我最后一次见你那位……朋友，她很安全。"

# game/Story01.rpy:661
translate chinese laborat_a8da0adb:

    # R "Your son…"
    R "你儿子……"

# game/Story01.rpy:662
translate chinese laborat_33019421:

    # R "That’s a different question."
    R "那是另一个问题。"

# game/Story01.rpy:663
translate chinese laborat_bb5d6b6e:

    # mc "What did you do to him—"
    mc "你们对他做了什么——"

# game/Story01.rpy:665
translate chinese laborat_a60a2cf2:

    # o "What he’s trying to say is..."
    o "他想说的是……"

# game/Story01.rpy:666
translate chinese laborat_ced64ed7:

    # o "We’re scientists. We study things most people would rather not understand."
    o "我们是科学家。我们研究大多数人宁愿不去理解的东西。"

# game/Story01.rpy:667
translate chinese laborat_ee6c47e7:

    # o "As for your friends…"
    o "至于你的朋友们……"

# game/Story01.rpy:668
translate chinese laborat_faa9f4c8:

    # o "They’re not under our protection."
    o "他们不在我们的保护范围内。"

# game/Story01.rpy:670
translate chinese laborat_ba53ba24:

    # mc "Not good enough."
    mc "这不够。"

# game/Story01.rpy:671
translate chinese laborat_937d6b13:

    # R "If we simplify things."
    R "简单来说。"

# game/Story01.rpy:673
translate chinese laborat_5fee7676:

    # R "We only know about the girl because she kept coming here."
    R "我们只知道那女孩，因为她总来这儿。"

# game/Story01.rpy:674
translate chinese laborat_346ef5f8:

    # R "Often."
    R "很频繁。"

# game/Story01.rpy:675
translate chinese laborat_7d2728a7:

    # R "More than she should have."
    R "比她该来的次数多。"

# game/Story01.rpy:676
translate chinese laborat_2405a08d:

    # R "…Looking after you, I assume."
    R "……我猜是在照看你。"

# game/Story01.rpy:678
translate chinese laborat_fe838e07:

    # mc "My son."
    mc "我儿子。"

# game/Story01.rpy:679
translate chinese laborat_81057b31_1:

    # mc "Now."
    mc "现在。"

# game/Story01.rpy:681
translate chinese laborat_6eaeb5a6:

    # R "As for your son... {w=0.5}no idea."
    R "至于你儿子……{w=0.5}不知道。"

# game/Story01.rpy:682
translate chinese laborat_276a61a1:

    # mc "That’s not an answer."
    mc "这不算回答。"

# game/Story01.rpy:683
translate chinese laborat_db0f41f5:

    # R "It’s the only one you’re getting from me."
    R "这是我唯一能给你的回答。"

# game/Story01.rpy:684
translate chinese laborat_8b5a05c0:

    # R "You’ll have to ask upstairs."
    R "你得去上面问。"

# game/Story01.rpy:686
translate chinese laborat_51176868:

    # R "…If you’re lucky."
    R "……如果你运气好。"

# game/Story01.rpy:688
translate chinese laborat_818023e1:

    # mc "Lucky…?"
    mc "运气好……？"

# game/Story01.rpy:689
translate chinese laborat_791fab43:

    # mc "(She brought me here…?)"
    mc "（她把我带到这儿的……？）"

# game/Story01.rpy:691
translate chinese laborat_8c24dafb:

    # o "He had… an unfortunate encounter with her."
    o "他……和她有过一次不幸的接触。"

# game/Story01.rpy:692
translate chinese laborat_d64c084c:

    # mc "She’s behind this, isn’t she?"
    mc "是她主使的，对吧？"

# game/Story01.rpy:693
translate chinese laborat_afe77f54:

    # o "The Lady?"
    o "夫人？"

# game/Story01.rpy:694
translate chinese laborat_0c0b5c57:

    # o "Yes."
    o "对。"

# game/Story01.rpy:696
translate chinese laborat_2eba8938:

    # o "But..."
    o "但……"

# game/Story01.rpy:697
translate chinese laborat_833e1938:

    # o "You don’t want to cross her on a bad day."
    o "你不想在她心情不好的时候得罪她。"

# game/Story01.rpy:698
translate chinese laborat_530edc9f:

    # o "Or any day, really."
    o "其实哪天都不想。"

# game/Story01.rpy:700
translate chinese laborat_bf59f2b1:

    # R "For once, I agree."
    R "这一次，我同意。"

# game/Story01.rpy:702
translate chinese laborat_68afa520:

    # mc "(Olivia’s alive. Norman no trace. Upstairs… the Lady.)"
    mc "（奥利维亚还活着。诺曼没消息。楼上……是夫人。）"

# game/Story01.rpy:703
translate chinese laborat_48345b33:

    # mc "(And they want me to meet her already...)"
    mc "（他们现在就想让我去见她……）"

# game/Story01.rpy:705
translate chinese laborat_bc9e3156:

    # mc "How is she connected to Olivia and Norman?"
    mc "她和奥利维亚、诺曼有什么关系？"

# game/Story01.rpy:706
translate chinese laborat_96681836:

    # mc "And how hard is it to get a meeting with her?"
    mc "要见她一面有多难？"

# game/Story01.rpy:708
translate chinese laborat_9c3dfe3e:

    # o "Complicated."
    o "很复杂。"

# game/Story01.rpy:709
translate chinese laborat_10ab22b6:

    # o "You don’t just walk in and ask for an audience."
    o "不是走进去求见就行的。"

# game/Story01.rpy:711
translate chinese laborat_90da918f:

    # mc "So where’s the catch?"
    mc "那问题在哪？"

# game/Story01.rpy:713
translate chinese laborat_f69e281f:

    # o "What are you getting at?"
    o "你想说什么？"

# game/Story01.rpy:715
translate chinese laborat_1e84b66a:

    # mc "I wake up, and I get an audience right away?"
    mc "我一醒就能直接见她？"

# game/Story01.rpy:716
translate chinese laborat_03b506e5:

    # mc "You take me for a fool?"
    mc "你当我是傻子？"

# game/Story01.rpy:717
translate chinese laborat_81c7c470:

    # R "She knows things she shouldn’t."
    R "她知道她不该知道的事。"

# game/Story01.rpy:718
translate chinese laborat_fad44ec6:

    # R "Things no one should."
    R "没人该知道的事。"

# game/Story01.rpy:720
translate chinese laborat_18335817:

    # R "Your awakening—"
    R "你的苏醒——"

# game/Story01.rpy:721
translate chinese laborat_549cc835:

    # R "She knew the exact moment."
    R "她知道确切时刻。"

# game/Story01.rpy:722
translate chinese laborat_116ca51d:

    # R "You would wake."
    R "你会醒。"

# game/Story01.rpy:724
translate chinese laborat_e339d677:

    # mc "...She predicted it?"
    mc "……她预言了？"

# game/Story01.rpy:726
translate chinese laborat_6f446c5e:

    # mc "Implants. Right?"
    mc "植入体。对吧？"

# game/Story01.rpy:727
translate chinese laborat_60d2d352:

    # o "If implants were the answer… this would be easy."
    o "要是植入体就能解释……这事就简单了。"

# game/Story01.rpy:729
translate chinese laborat_3c4082ba:

    # mc "(So there’s something else at play… not just implants.)"
    mc "（所以还有别的东西在起作用……不只是植入体。）"

# game/Story01.rpy:731
translate chinese laborat_f094f8f1:

    # o "Any more questions?"
    o "还有问题吗？"

# game/Story01.rpy:732
translate chinese laborat_49b1da68:

    # mc "Who exactly is the Lady?"
    mc "夫人到底是谁？"

# game/Story01.rpy:733
translate chinese laborat_e8f2e780:

    # o "Astoria."
    o "阿斯托里亚。"

# game/Story01.rpy:734
translate chinese laborat_16108fe4:

    # o "She runs the upper city."
    o "她掌管上城。"

# game/Story01.rpy:735
translate chinese laborat_4a756b67:

    # mc "And why is everyone afraid of her?"
    mc "为什么所有人都怕她？"

# game/Story01.rpy:737
translate chinese laborat_63e49178:

    # o "Because her decisions rarely leave room for appeals."
    o "因为她的决定很少留有申诉余地。"

# game/Story01.rpy:738
translate chinese laborat_1e157879:

    # o "You’ll see the rest for yourself."
    o "剩下的你自己看吧。"

# game/Story01.rpy:740
translate chinese laborat_32fed399:

    # o "But before we proceed—"
    o "但在我们继续之前——"

# game/Story01.rpy:741
translate chinese laborat_fca52711_1:

    # mc "No."
    mc "不。"

# game/Story01.rpy:742
translate chinese laborat_223e1df4:

    # mc "You said she’s dangerous. I need to know why."
    mc "你说她危险。我得知道为什么。"

# game/Story01.rpy:743
translate chinese laborat_8e48ef14:

    # o "You value your life?"
    o "你珍惜自己的命吗？"

# game/Story01.rpy:744
translate chinese laborat_bb813031:

    # o "Then don’t piss her off."
    o "那就别惹她。"

# game/Story01.rpy:745
translate chinese laborat_b736317c:

    # mc "What kind of power is that?"
    mc "那是什么样的权力？"

# game/Story01.rpy:746
translate chinese laborat_07abc845:

    # o "..."
    o "……"

# game/Story01.rpy:747
translate chinese laborat_d64c63e0:

    # o "From this point on… you’re with the Inquisiti-"
    o "从现在起……你归审判——"

# game/Story01.rpy:748
translate chinese laborat_defd9cf7:

    # mc "Stay on topic."
    mc "说正题。"

# game/Story01.rpy:749
translate chinese laborat_9adce021:

    # o "Let me give you a piece of advice."
    o "给你一句忠告。"

# game/Story01.rpy:750
translate chinese laborat_0bf34200:

    # o "Keep pushing like that, you won’t walk out of her office."
    o "再这么逼下去，你走不出她的办公室。"

# game/Story01.rpy:751
translate chinese laborat_2b35b6fe:

    # mc "..."
    mc "……"

# game/Story01.rpy:752
translate chinese laborat_f35eb75c:

    # o "You’re with the Inquisition."
    o "你归审判庭。"

# game/Story01.rpy:754
translate chinese laborat_aa30db42:

    # mc "The Inquisition…?"
    mc "审判庭……？"

# game/Story01.rpy:755
translate chinese laborat_176d4968:

    # mc "I’m not joining."
    mc "我不加入。"

# game/Story01.rpy:757
translate chinese laborat_2f728048:

    # o "You don’t really have a choice."
    o "你其实没得选。"

# game/Story01.rpy:758
translate chinese laborat_ae7a8f37:

    # mc "There’s always a choice."
    mc "总有的选。"

# game/Story01.rpy:759
translate chinese laborat_1195a281:

    # o "The fewer questions people ask about you…"
    o "问起你的人越少……"

# game/Story01.rpy:760
translate chinese laborat_c35eb940:

    # o "The cleaner your story sounds."
    o "你的故事就越干净。"

# game/Story01.rpy:762
translate chinese laborat_968409e7:

    # o "People don’t just appear here out of nowhere."
    o "人不会凭空出现在这儿。"

# game/Story01.rpy:764
translate chinese laborat_d09122ed:

    # R "Oh, so beastmen get a free pass now?"
    R "哦，所以兽人现在有免死金牌了？"

# game/Story01.rpy:765
translate chinese laborat_91eab829:

    # o "Old man… don’t start."
    o "老头子……别开始。"

# game/Story01.rpy:767
translate chinese laborat_8353d46f:

    # mc "(Tension between them… noted.)"
    mc "（他们之间有矛盾……记下了。）"

# game/Story01.rpy:769
translate chinese laborat_cf6edfa1:

    # mc "Fine. I’ll play along."
    mc "行。我配合。"

# game/Story01.rpy:770
translate chinese laborat_2f9028a8:

    # mc "Anything else?"
    mc "还有别的吗？"

# game/Story01.rpy:772
translate chinese laborat_f263b9d9:

    # R "Survive."
    R "活下去。"

# game/Story01.rpy:773
translate chinese laborat_f44367e1:

    # R "That’s all that matters."
    R "这才是最重要的。"

# game/Story01.rpy:775
translate chinese laborat_55b995d7:

    # sci "Dr. Li, it’s urgent. They’ve made their move!"
    sci "李博士，紧急情况。他们动手了！"

# game/Story01.rpy:777
translate chinese laborat_68a1a47c:

    # R "Slow down."
    R "慢点。"

# game/Story01.rpy:778
translate chinese laborat_1ef97a58:

    # R "Start again."
    R "重说。"

# game/Story01.rpy:779
translate chinese laborat_1b801cd9:

    # R "Clearly."
    R "说清楚。"

# game/Story01.rpy:781
translate chinese laborat_b5d814bc:

    # sci "The Inquisition! They’ve found out about our plans!"
    sci "审判庭！他们发现了我们的计划！"

# game/Story01.rpy:783
translate chinese laborat_08a2100e:

    # mc "What is the Inquisition?"
    mc "审判庭是什么？"

# game/Story01.rpy:784
translate chinese laborat_9fc1e327:

    # o "Internal enforcement."
    o "内部执法机构。"

# game/Story01.rpy:785
translate chinese laborat_db9cd22e:

    # o "They control restricted technology, implants included."
    o "他们管控受限技术，包括植入体。"

# game/Story01.rpy:786
translate chinese laborat_2021cead:

    # mc "So those implants belong to them."
    mc "所以那些植入体是他们的。"

# game/Story01.rpy:787
translate chinese laborat_bcfcbbbc:

    # o "They think so."
    o "他们这么认为。"

# game/Story01.rpy:788
translate chinese laborat_939d10d9:

    # mc "(The Inquisition… Is this about me?)"
    mc "（审判庭……这是冲我来的？）"

# game/Story01.rpy:790
translate chinese laborat_c6e04af2:

    # mc "Something happened?"
    mc "出什么事了？"

# game/Story01.rpy:792
translate chinese laborat_0de5054d:

    # o "Yeah. You."
    o "是啊。你。"

# game/Story01.rpy:793
translate chinese laborat_d8bf4384:

    # o "Your implants…"
    o "你的植入体……"

# game/Story01.rpy:794
translate chinese laborat_77a29376:

    # o "Let’s just say, they don’t like that we took them... {w=0.5}without asking."
    o "这么说吧，他们不喜欢我们拿走它们……{w=0.5}没经过允许。"

# game/Story01.rpy:796
translate chinese laborat_d3183bce:

    # mc "Right. So you stole them."
    mc "行。所以你们偷的。"

# game/Story01.rpy:798
translate chinese laborat_54ac4a01:

    # mc "Fantastic. Can't your so called Lady handle this?"
    mc "太好了。你们那位所谓的夫人处理不了这事？"

# game/Story01.rpy:799
translate chinese laborat_6fa2f3cf:

    # o "It's... complicated"
    o "这……很复杂。"

# game/Story01.rpy:801
translate chinese laborat_d6d275e9:

    # R "Did they send someone?"
    R "他们派人来了？"

# game/Story01.rpy:802
translate chinese laborat_253a3bfd:

    # R "Or is this just noise?"
    R "还是只是虚张声势？"

# game/Story01.rpy:803
translate chinese laborat_13b68a3d:

    # sci "Not just someone… a War Maiden. She’s here herself."
    sci "不只是一般人……是战争少女。她亲自来了。"

# game/Story01.rpy:805
translate chinese laborat_4a933981:

    # o "Hold on. What makes you think she’s here for us?"
    o "等等。你凭什么觉得她是冲我们来的？"

# game/Story01.rpy:807
translate chinese laborat_d348364a:

    # sci "She’s... waiting at the entrance."
    sci "她……在入口等着。"

# game/Story01.rpy:809
translate chinese laborat_ce49674b:

    # sci "And we’ve received an inspection request from the Inquisition department."
    sci "而且我们收到了审判庭部门的检查请求。"

# game/Story01.rpy:811
translate chinese laborat_7f290b6e:

    # sci "It’s written here, black and white."
    sci "白纸黑字写着的。"

# game/Story01.rpy:812
translate chinese laborat_5eb94f76:

    # sci "The Inquisition believes we’re behind the emergence of those monsters behind the wall."
    sci "审判庭认为墙后那些怪物的出现是我们造成的。"

# game/Story01.rpy:814
translate chinese laborat_404f0100:

    # R "Wait... soulless?"
    R "等等……无魂者？"

# game/Story01.rpy:815
translate chinese laborat_9a838154:

    # R "They think we’re behind this?"
    R "他们觉得是我们干的？"

# game/Story01.rpy:817
translate chinese laborat_efa29a5c:

    # R "And the implants?"
    R "那植入体呢？"

# game/Story01.rpy:818
translate chinese laborat_b6e2129b:

    # sci "Second page, sir."
    sci "第二页，长官。"

# game/Story01.rpy:820
translate chinese laborat_c6841c25_1:

    # R "..."
    R "……"

# game/Story01.rpy:821
translate chinese laborat_f413af47:

    # mc "(He’s nervous… and it’s not the Inquisition.)"
    mc "（他紧张……但不是因为审判庭。）"

# game/Story01.rpy:822
translate chinese laborat_a9bfd4c7:

    # mc "(The others aren’t.)"
    mc "（其他人不紧张。）"

# game/Story01.rpy:824
translate chinese laborat_afa834f4:

    # R "I'm afraid our conversation ends here."
    R "恐怕我们的谈话到此为止。"

# game/Story01.rpy:826
translate chinese laborat_2f5856d5:

    # R "I need to deal with this."
    R "我得去处理这事。"

# game/Story01.rpy:828
translate chinese laborat_cf0ec2ce:

    # o "Don’t worry. I’ll handle things from here. You’ve got fire to put out."
    o "别担心。这儿我来处理。你有火要灭。"

# game/Story01.rpy:830
translate chinese laborat_b2366f19:

    # mc "(Ship crash. Body-hacking scientists. Now the Inquisition…)"
    mc "（飞船坠毁。改造人体的科学家。现在又是审判庭……）"

# game/Story01.rpy:831
translate chinese laborat_920ef4ea:

    # mc "(What the hell did I walk into?)"
    mc "（我他妈卷进了什么？）"

# game/Story01.rpy:834
translate chinese laborat_1be8f848:

    # a "Help..."
    a "救命……"

# game/Story01.rpy:842
translate chinese laborat_d4812f08:

    # mc "(That voice again... what’s happening to me?)"
    mc "（又是那个声音……我怎么了？）"

# game/Story01.rpy:844
translate chinese laborat_7df7941f:

    # mc "(Or was it just my imagination? Could it be... side effects?)"
    mc "（还是只是我的幻觉？会不会是……副作用？）"

# game/Story01.rpy:846
translate chinese laborat_2634588f:

    # o "Hey… you good?"
    o "嘿……你没事吧？"

# game/Story01.rpy:848
translate chinese laborat_fca52711_2:

    # mc "No."
    mc "不。"

# game/Story01.rpy:849
translate chinese laborat_700c3b9d:

    # mc "I’m hearing something."
    mc "我听到什么了。"

# game/Story01.rpy:850
translate chinese laborat_634bc88c:

    # mc "Someone calling for help."
    mc "有人在求救。"

# game/Story01.rpy:852
translate chinese laborat_07abc845_1:

    # o "..."
    o "……"

# game/Story01.rpy:854
translate chinese laborat_638c89e0:

    # o "After your meeting, come see me."
    o "见完面后来找我。"

# game/Story01.rpy:855
translate chinese laborat_51228f76:

    # o "Your implant needs tuning."
    o "你的植入体需要调校。"

# game/Story01.rpy:856
translate chinese laborat_d47afe9f:

    # o "Don’t drag your feet."
    o "别磨蹭。"

# game/Story01.rpy:867
translate chinese laborat_97efb8a9:

    # o "Alright… this is where I stop."
    o "好……我就送到这儿。"

# game/Story01.rpy:868
translate chinese laborat_b98cc89c:

    # o "Past that door, I’m not exactly welcome."
    o "过了那扇门，我就不太受欢迎了。"

# game/Story01.rpy:869
translate chinese laborat_2876efd9:

    # mc "Why?"
    mc "为什么？"

# game/Story01.rpy:870
translate chinese laborat_91cc3f81:

    # o "Security protocols."
    o "安全协议。"

# game/Story01.rpy:871
translate chinese laborat_abc2652f:

    # mc "Then why am I allowed in?"
    mc "那为什么我能进？"

# game/Story01.rpy:873
translate chinese laborat_5537cdb4:

    # o "You’re a special case."
    o "你是特例。"

# game/Story01.rpy:874
translate chinese laborat_9e152687:

    # o "But first, one more thing."
    o "但首先，还有一件事。"

# game/Story01.rpy:877
translate chinese laborat_efb9971d:

    # o "Name."
    o "名字。"

# game/Story01.rpy:879
translate chinese laborat_cba3697f_1:

    # mc "(Name…?)"
    mc "（名字……？）"

# game/Story01.rpy:880
translate chinese laborat_f70d6156:

    # mc "(He wants me to shake his hand?)"
