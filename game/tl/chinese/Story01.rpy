translate chinese olivia_fr_scene_0906f749:

    # mc "(Always dropping something.)"
    mc "（老是掉东西。）"

# game/Story01.rpy:9053
translate chinese olivia_fr_scene_34d5d07e:

    # mc "(...but we never made a big deal out of it.)"
    mc "（……但我们从没当回事。）"

# game/Story01.rpy:9054
translate chinese olivia_fr_scene_2801d44d:

    # mc "(Didn’t feel right.)"
    mc "（觉得那样不对。）"

# game/Story01.rpy:9055
translate chinese olivia_fr_scene_6a5c4062:

    # mc "(Honestly… most people would’ve kicked her out in a week.)"
    mc "（说实话……大多数人一周就会把她赶走。）"

# game/Story01.rpy:9058
translate chinese olivia_fr_scene_4e515863:

    # mc "(We didn’t even think about it.)"
    mc "（我们连想都没想过。）"

# game/Story01.rpy:9059
translate chinese olivia_fr_scene_0cd518b4:

    # mc "(We just… stuck with her.)"
    mc "（我们就……留下了她。）"

# game/Story01.rpy:9060
translate chinese olivia_fr_scene_c93abadc:

    # mc "(’Cause we knew exactly what that felt like.)"
    mc "（因为我们太清楚那种感觉了。）"

# game/Story01.rpy:9066
translate chinese olivia_fr_scene_e0ec3028:

    # mc "I think… that’s why she got so attached to us."
    mc "我觉得……所以她才会那么依赖我们。"

