translate chinese gate2_e08f0b3e:

    # g "He was already heading our way, we managed to reach him."
    g "他本来就往这边来，我们联系上他了。"

# game/Story01.rpy:7747
translate chinese gate2_cb7224f3:

    # mc "Comms? I thought they were down."
    mc "通讯？我以为断了。"

