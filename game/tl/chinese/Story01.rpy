translate chinese olivia_fr_scene_71dabdfd:

    # mc "(Should I check…?)"
    mc "（要不要去看看……？）"

# game/Story01.rpy:9104
translate chinese olivia_fr_scene_a6a6e71e:

    # mc "(No. Can’t leave Olivia alone.)"
    mc "（不。不能把奥利维亚一个人留下。）"

