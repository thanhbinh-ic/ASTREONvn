translate chinese olivia_fr_scene_39557157:

    # h "I’ll do everything I can, I won’t let you down."
    h "我会尽全力，不会让你们失望。"

# game/Story01.rpy:9040
translate chinese olivia_fr_scene_681ab449:

    # mc "(She really did try… like, really try. But—)"
    mc "（她真的很努力……是真的努力。可是——）"

# game/Story01.rpy:9048
translate chinese olivia_fr_scene_9f55d655:

    # h "OH COME ON! Not again..."
    h "哦得了吧！又来了……"

# game/Story01.rpy:9049
translate chinese olivia_fr_scene_504ad8c6:

    # mc "(God… she was clumsy.)"
    mc "（天哪……她真笨手笨脚。）"

