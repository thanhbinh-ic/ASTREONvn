translate chinese olivia_fr_scene_82dd4568:

    # mc "...She didn’t."
    mc "……她没有。"

# game/Story01.rpy:9072
translate chinese olivia_fr_scene_938720d6:

    # mc "Not once."
    mc "一次都没有。"

# game/Story01.rpy:9074
translate chinese olivia_fr_scene_f25e3715:

    # Mi "…That’s quite a story."
    Mi "……真是个好故事。"

# game/Story01.rpy:9076
translate chinese olivia_fr_scene_58de9670:

    # Mi "It makes me wonder…"
    Mi "让我忍不住想……"

# game/Story01.rpy:9077
translate chinese olivia_fr_scene_932dd9d5:

    # Mi "how different things might’ve been…"
    Mi "要是当初也有人……"

# game/Story01.rpy:9078
translate chinese olivia_fr_scene_15363a21:

    # Mi "if someone had given me that chance."
    Mi "给我那样的机会，一切会多不一样。"

