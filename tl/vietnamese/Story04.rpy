translate vietnamese story05_5_4_4a6b467f:

    # Go "My father. My mother. My friends."
    Go "Cha tôi. Mẹ tôi. Bạn bè tôi."

# game/Story04.rpy:7726
translate vietnamese story05_5_4_af8847a3:

