    # mc "We keep going. I’ll deal with everything else later."
    mc "Chúng ta tiếp tục. Mọi chuyện khác tôi sẽ lo sau."

# game/Story04.rpy:4110
translate vietnamese mcchoice1_8bac112a:

    # h "Then I’ve got an idea how to really grab your attention."
    h "Vậy thì em có một ý để thật sự thu hút sự chú ý của anh."

# game/Story04.rpy:4111
