    # k "(What’s the catch? What does he get out of this?)"
    k "(Có mưu gì đây? Anh ta được lợi gì từ chuyện này?)"

# game/Story04.rpy:9772
translate vietnamese story05_5_6_74ff01f4:

    # k "(No… I don’t want him looking at me like that.)"
    k "(Không… tôi không muốn anh ta nhìn tôi như thế.)"

# game/Story04.rpy:9775
