translate vietnamese story05_6_1b1c8dcc:

    # h "You know, [mc]…"
    h "Anh biết không, [mc]…"

# game/Story04.rpy:3971
translate vietnamese story05_6_d1b0e31f:

    # h "I’m a mess of a girl. Loud. Hot-headed. Dumb. Useless—"
    h "Tôi đúng là một cô gái lộn xộn. Ồn ào. Nóng nảy. Ngốc nghếch. Vô dụng—"
# game/Story04.rpy:3972
translate vietnamese story05_6_0f098f83:

    # mc "No. Stop. Where did you even get that idea?"
    mc "Không. Dừng lại. Cậu lấy đâu ra ý nghĩ đó vậy?"

# game/Story04.rpy:3974
translate vietnamese story05_6_326dbc74:

    # h "Isn’t it true though?"
    h "Nhưng chẳng phải đúng thế sao?"

# game/Story04.rpy:3975
translate vietnamese story05_6_1ff2cacc:

    # mc "Your optimism. Your experience. Your confidence. Your skills."
    mc "Sự lạc quan của cậu. Kinh nghiệm của cậu. Sự tự tin của cậu. Kỹ năng của cậu."

# game/Story04.rpy:3976
translate vietnamese story05_6_9cc76550:

    # h "Yeah, but compared to the others, I’m just—"
    h "Ừ, nhưng so với những người khác, em chỉ là—"

# game/Story04.rpy:3977
translate vietnamese story05_6_aff53f61:

    # mc "You’ve got your own kind of charm."
    mc "Cậu có nét duyên của riêng mình."

# game/Story04.rpy:3980
translate vietnamese story05_6_9bf1b482:

