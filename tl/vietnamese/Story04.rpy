    # mc "The pattern?"
    mc "Khuôn mẫu ư?"

# game/Story04.rpy:4737
translate vietnamese story05_7_dd2b1277:

    # L "Every choice leads to another outcome."
    L "Mỗi lựa chọn dẫn tới một kết quả khác."

# game/Story04.rpy:4738
translate vietnamese story05_7_2e5a91be:

    # L "Astoria and I were trying to find the one where everyone survives."
    L "Astoria và em đã cố tìm ra con đường mà mọi người đều sống sót."

# game/Story04.rpy:4740
translate vietnamese story05_7_c8992b1c:

    # L "And for that… we had to keep things hidden."
    L "Và vì thế… chúng em đã phải giữ kín mọi chuyện."

# game/Story04.rpy:4741
translate vietnamese story05_7_23078864:

    # mc "(This is absurd… and I’m just supposed to believe this?)"
    mc "(Chuyện này thật vô lý… và tôi cứ thế mà tin sao?)"

# game/Story04.rpy:4742
translate vietnamese story05_7_02bb9192:

    # mc "I’ll be honest, this sounds like complete nonsense."
    mc "Thành thật mà nói, nghe cứ như toàn chuyện nhảm nhí."

# game/Story04.rpy:4743
translate vietnamese story05_7_64960f08:

    # mc "But fine."
    mc "Nhưng thôi được."

# game/Story04.rpy:4744
translate vietnamese story05_7_fcbd24cb:

    # mc "Still… if you’re telling me now, does that mean we’ve already lost the chance to choose that path?"
    mc "Nhưng mà… nếu giờ em mới nói với tôi, có phải nghĩa là chúng ta đã mất cơ hội chọn con đường đó rồi không?"

# game/Story04.rpy:4745
translate vietnamese story05_7_d144587b:

    # L "I don’t know. This is the first time I’ve dared to do it."
    L "Em không biết. Đây là lần đầu tiên em dám làm vậy."

# game/Story04.rpy:4747
translate vietnamese story05_7_d4bb82c8:

    # L "I get it, to everyone else, I must look horrible."
    L "Em hiểu mà, trong mắt mọi người khác, em hẳn trông thật tệ hại."

# game/Story04.rpy:4748
translate vietnamese story05_7_ec1f5afa:

    # L "A selfish, hypocritical bitch. But… I had to do it."
    L "Một con khốn ích kỷ, đạo đức giả. Nhưng… em đã phải làm vậy."

# game/Story04.rpy:4750
translate vietnamese story05_7_5d9f22ac:

    # mc "I…"
    mc "Tôi…"

# game/Story04.rpy:4751
translate vietnamese story05_7_03b08cef:

    # mc "(What am I even supposed to do? I can barely take care of myself… let alone protect her.)"
    mc "(Tôi thì biết làm gì đây? Tôi còn lo cho bản thân còn chưa xong… nói gì đến bảo vệ cô ấy.)"

# game/Story04.rpy:4752
translate vietnamese story05_7_978c8108:

    # mc "How can I help you?"
    mc "Tôi có thể giúp em thế nào?"

# game/Story04.rpy:4754
translate vietnamese story05_7_9993b94e:

    # L "..."
    L "..."

# game/Story04.rpy:4755
translate vietnamese story05_7_a69c9c06:

    # L "(He’s made it this far - even without the power I have.)"
    L "(Anh ấy đã đi xa tới mức này — dù không có sức mạnh như em.)"

# game/Story04.rpy:4756
translate vietnamese story05_7_5ddc20e2:

    # L "(But what if…)"
    L "(Nhưng nếu như…)"

# game/Story04.rpy:4758
translate vietnamese story05_7_b48eb54a:

    # L "(If he had it too- No. Do you really want him to suffer like that?)"
    L "(Nếu anh ấy cũng có nó— Không. Mình có thực sự muốn anh ấy chịu đựng như vậy không?)"

# game/Story04.rpy:4759
translate vietnamese story05_7_6c0d544d:

    # L "(He’s suffered enough already. I have to finish this, and then, for sure-)"
    L "(Anh ấy đã chịu đựng đủ rồi. Mình phải kết thúc chuyện này, rồi sau đó, chắc chắn—)"

# game/Story04.rpy:4761
translate vietnamese story05_7_0297642d_1:

    # mc "Lora?"
    mc "Lora?"

