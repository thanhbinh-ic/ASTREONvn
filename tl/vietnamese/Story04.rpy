    mc "Mọi thứ đặt lên bàn."

# game/Story04.rpy:9122
translate vietnamese story05_5_5_31ed3599:

    # y "Agreed."
    y "Đồng ý."

# game/Story04.rpy:9125
translate vietnamese story05_5_5_72a4a768:

    # mc "Kali."
    mc "Kali."

# game/Story04.rpy:9126
translate vietnamese story05_5_5_52e8c385:

    # mc "Your thoughts?"
    mc "Ý cô thế nào?"

# game/Story04.rpy:9127
translate vietnamese story05_5_5_d18fd985:

    # mc "I know you’re not asleep. Stop pretending."
    mc "Tôi biết cô không ngủ. Đừng giả vờ nữa."

# game/Story04.rpy:9134
translate vietnamese story05_5_5_82091822_2:

    # k "..."
    k "..."

# game/Story04.rpy:9139
translate vietnamese story05_5_5_7f6c8544:

    # k "How long have you known?"
    k "Ông biết từ khi nào?"

# game/Story04.rpy:9141
translate vietnamese story05_5_5_c6675718:

    # mc "You snore."
    mc "Cô ngáy."

# game/Story04.rpy:9142
translate vietnamese story05_5_5_1608fe92:

    # mc "Did you know?"
    mc "Cô có biết không?"

# game/Story04.rpy:9144
translate vietnamese story05_5_5_191fa3b8:

    # k "I’ll keep that in mind."
    k "Tôi sẽ nhớ điều đó."

# game/Story04.rpy:9146
translate vietnamese story05_5_5_ad676bab:

    # k "You’re starting to freak me out."
    k "Ông bắt đầu làm tôi sợ rồi đấy."

# game/Story04.rpy:9147
translate vietnamese story05_5_5_559f7676:

    # k "First Federation leaders call you friend."
    k "Đầu tiên là các lãnh đạo Liên bang gọi ông là bạn."

# game/Story04.rpy:9148
translate vietnamese story05_5_5_0da1d8b8:

    # k "Now a Chaplain."
    k "Giờ lại là một vị Tuyên úy."

# game/Story04.rpy:9149
translate vietnamese story05_5_5_d8838b2b:

    # k "You’ve got a real talent for getting powerful people on your side."
    k "Ông đúng là có tài lôi kéo những người quyền lực về phe mình."

# game/Story04.rpy:9151
translate vietnamese story05_5_5_8ec8d28b:

    # y "There’s a celebration in the camp tonight."
    y "Tối nay trong trại có lễ ăn mừng."

# game/Story04.rpy:9152
translate vietnamese story05_5_5_7991fa21:

    # y "Care to join us?"
    y "Muốn tham gia cùng chúng tôi không?"

# game/Story04.rpy:9157
translate vietnamese story05_5_5_a04fef34:

    # mc "We’ll be there."
    mc "Chúng tôi sẽ tới."

# game/Story04.rpy:9158
translate vietnamese story05_5_5_ccf7abda:

    # mc "But first..."
    mc "Nhưng trước hết..."

# game/Story04.rpy:9159
translate vietnamese story05_5_5_51d67168:

    # mc "We make sure we’re not followed."
    mc "Chúng ta phải chắc chắn là không bị theo dõi."

# game/Story04.rpy:9171
translate vietnamese story05_5_6_3b60565e:

    # "The road to the camp was quiet."
    "Con đường tới trại thật yên tĩnh."

# game/Story04.rpy:9174
translate vietnamese story05_5_6_a8d9ff5a:

    # "For a while they walked in silence."
    "Một lúc họ bước đi trong im lặng."

# game/Story04.rpy:9176
translate vietnamese story05_5_6_e5d8fbe9:

    # mc "Kali? About those other worlds… do you know anything?"
    mc "Kali? Về những thế giới khác… cô có biết gì không?"

# game/Story04.rpy:9178
translate vietnamese story05_5_6_0e7d480f:

    # k "Knowledge?"
    k "Kiến thức ư?"

# game/Story04.rpy:9181
translate vietnamese story05_5_6_c64c795c:

    # k "I prefer meat and spectacle to libraries."
    k "Tôi thích thịt và trò giải trí hơn là thư viện."

# game/Story04.rpy:9186
translate vietnamese story05_5_6_22c82afb:

    # k "But even I have heard the stories."
    k "Nhưng ngay cả tôi cũng đã nghe những câu chuyện đó."

# game/Story04.rpy:9190
translate vietnamese story05_5_6_8b5f3d06:

    # mc "I'd appreciate it."
    mc "Tôi sẽ rất cảm kích."

# game/Story04.rpy:9192
translate vietnamese story05_5_6_cff1b0d2:

    # k "Ew… don't do that, old man."
    k "Kinh quá… đừng làm thế, ông già."

# game/Story04.rpy:9193
translate vietnamese story05_5_6_1d57d86d:

    # k "Politeness looks strange on you."
    k "Lịch sự trông thật lạ lẫm trên người ông."
# game/Story04.rpy:9195
translate vietnamese story05_5_6_80eca246:

    # k "But fine."
    k "Nhưng thôi được."

# game/Story04.rpy:9196
translate vietnamese story05_5_6_452e8d53:

    # k "People say reality doesn't move in one straight line."
    k "Người ta nói thực tại không đi theo một đường thẳng duy nhất."

# game/Story04.rpy:9199
translate vietnamese story05_5_6_75e76b82:

    # k "Every major choice leaves another world behind."
    k "Mỗi lựa chọn lớn đều bỏ lại một thế giới khác phía sau."

# game/Story04.rpy:9201
translate vietnamese story05_5_6_2ca31cdd:

    # mc "Parallel worlds."
    mc "Thế giới song song."

# game/Story04.rpy:9204
translate vietnamese story05_5_6_f5f5aa01:

    # k "If you like big words."
    k "Nếu ông thích dùng từ ngữ to tát."

# game/Story04.rpy:9205
translate vietnamese story05_5_6_1deb855b:

    # k "Different choices."
    k "Những lựa chọn khác nhau."

# game/Story04.rpy:9206
translate vietnamese story05_5_6_03d1c371:

    # k "Different wars."
    k "Những cuộc chiến khác nhau."

# game/Story04.rpy:9207
translate vietnamese story05_5_6_870df9a7:

    # k "Different endings."
    k "Những kết cục khác nhau."

# game/Story04.rpy:9210
translate vietnamese story05_5_6_8f297869:

    # k "That’s everything I know."
    k "Đó là tất cả những gì tôi biết."

# game/Story04.rpy:9211
translate vietnamese story05_5_6_1cb5176c:

    # mc "Not much to go on."
    mc "Chẳng có bao nhiêu manh mối."

# game/Story04.rpy:9213
translate vietnamese story05_5_6_44ecae25:

    # k "It’s what there is."
    k "Chỉ có thế thôi."

# game/Story04.rpy:9218
translate vietnamese story05_5_6_3c2b972a:

    # keep3 "Most beings live their entire lives without ever realizing the truth."
    keep3 "Hầu hết sinh linh sống cả đời mà không bao giờ nhận ra sự thật."

# game/Story04.rpy:9219
translate vietnamese story05_5_6_b67c66c3:

    # keep3 "To them, their world is the only one that exists."
    keep3 "Với họ, thế giới của họ là thế giới duy nhất tồn tại."

# game/Story04.rpy:9222
translate vietnamese story05_5_6_1907dfc3:

    # mc "(No chance to change it…)"
    mc "(Không có cơ hội thay đổi nó…)"

# game/Story04.rpy:9223
translate vietnamese story05_5_6_e0e55ef6:

    # keep3 "They don’t need one."
    keep3 "Họ không cần cơ hội đó."

# game/Story04.rpy:9225
translate vietnamese story05_5_6_342ac109:

    # mc "(Why—)"
    mc "(Tại sao—)"

# game/Story04.rpy:9230
translate vietnamese story05_5_6_92de21c0:

    # y "Many of us would give anything for a fate like yours."
    y "Nhiều người trong chúng ta sẵn sàng đánh đổi bất cứ thứ gì để có số phận như của cậu."

# game/Story04.rpy:9231
translate vietnamese story05_5_6_c6b8f5e9:

    # y "To forget what we were."
    y "Để quên đi chúng ta từng là ai."

# game/Story04.rpy:9235
translate vietnamese story05_5_6_6d8e1d7d:

    # mc "(…Because of the memories.)"
    mc "(…Vì những ký ức.)"

# game/Story04.rpy:9237
translate vietnamese story05_5_6_dc5a4b17:

    # keep3 "Correct."
    keep3 "Chính xác."

# game/Story04.rpy:9238
translate vietnamese story05_5_6_f61b7abb:

    # keep3 "When you live the same life over and over without knowing it’s repeating…"
    keep3 "Khi ngươi sống cùng một cuộc đời lặp đi lặp lại mà không biết nó đang lặp lại…"

# game/Story04.rpy:9239
translate vietnamese story05_5_6_1b4da978:

    # keep3 "you’re perfectly satisfied."
    keep3 "ngươi sẽ hoàn toàn thỏa mãn."

# game/Story04.rpy:9241
translate vietnamese story05_5_6_45ff424e:

    # mc "(That’s… disturbing.)"
    mc "(Thật… đáng sợ.)"

# game/Story04.rpy:9242
translate vietnamese story05_5_6_7e849547:

    # keep3 "Only if you know about it."
    keep3 "Chỉ khi ngươi biết về nó thôi."

# game/Story04.rpy:9243
translate vietnamese story05_5_6_dddbdbce:

    # keep3 "Otherwise it’s just… life."
    keep3 "Còn không thì nó chỉ là… cuộc sống."

# game/Story04.rpy:9246
translate vietnamese story05_5_6_b9d5eac0:

    # mc "(But how did they even appear? Where did they—)"
    mc "(Nhưng làm sao chúng xuất hiện được? Chúng từ đâu—)"

# game/Story04.rpy:9247
translate vietnamese story05_5_6_89c381df:

    # keep3 "From the moment time itself began."
    keep3 "Từ khoảnh khắc chính thời gian bắt đầu."

# game/Story04.rpy:9248
translate vietnamese story05_5_6_d8341b8f:

    # keep3 "Time is a fabric. Threads are the fibers it’s woven from."
    keep3 "Thời gian là một tấm vải. Các sợi chỉ là những sợi tơ dệt nên nó."

# game/Story04.rpy:9250
translate vietnamese story05_5_6_7db72d0a:

    # mc "(Haven’t felt this stupid trying to understand something in a long time…)"
    mc "(Lâu lắm rồi mới thấy mình ngu ngốc thế này khi cố hiểu một điều gì đó…)"

# game/Story04.rpy:9253
translate vietnamese story05_5_6_0085e033:

    # keep3 "..."
    keep3 "..."

# game/Story04.rpy:9254
translate vietnamese story05_5_6_764b51d9:

    # keep3 "Do you?"
    keep3 "Ngươi thì sao?"

# game/Story04.rpy:9257
translate vietnamese story05_5_6_25b41502:

    # keep3 "Think back on your life."
    keep3 "Hãy nghĩ lại về cuộc đời ngươi."

# game/Story04.rpy:9261
translate vietnamese story05_5_6_bfd4a055:

    # keep3 "The first major break in the cycle happened when you decided to go after Lora."
    keep3 "Lần phá vỡ lớn đầu tiên trong vòng lặp xảy ra khi ngươi quyết định đuổi theo Lora."

# game/Story04.rpy:9265
translate vietnamese story05_5_6_2c64a254:

    # keep3 "The second came when you ended up on the Ark."
    keep3 "Lần thứ hai là khi ngươi kết thúc trên Ark."

# game/Story04.rpy:9266
translate vietnamese story05_5_6_b9317d23:

    # keep3 "Together, they forced the cycle to branch."
    keep3 "Cùng nhau, chúng đã ép vòng lặp phải rẽ nhánh."

# game/Story04.rpy:9267
translate vietnamese story05_5_6_b92849d6:

    # keep3 "A branch changes the road. The fixed point still decides where the cycle closes."
    keep3 "Một nhánh rẽ sẽ thay đổi con đường. Điểm cố định vẫn quyết định vòng lặp khép lại ở đâu."

# game/Story04.rpy:9271
translate vietnamese story05_5_6_dcb264ef:

    # mc "(Different roads. Same wall.)"
    mc "(Những con đường khác nhau. Cùng một bức tường.)"

# game/Story04.rpy:9272
translate vietnamese story05_5_6_61485517:

    # mc "(Major shifts… So the small ones don’t matter?)"
    mc "(Những thay đổi lớn… Vậy những thay đổi nhỏ thì không quan trọng sao?)"

# game/Story04.rpy:9274
translate vietnamese story05_5_6_070123e8:

    # keep3 "Every change affects the outcome."
    keep3 "Mọi thay đổi đều ảnh hưởng tới kết quả."

# game/Story04.rpy:9275
translate vietnamese story05_5_6_828f980e:

    # keep3 "Some simply carry more weight."
    keep3 "Chỉ là một số mang trọng lượng lớn hơn."

# game/Story04.rpy:9278
translate vietnamese story05_5_6_34d1cb75:

    # keep3 "But every shift has consequences."
    keep3 "Nhưng mọi sự dịch chuyển đều có hậu quả."

# game/Story04.rpy:9279
translate vietnamese story05_5_6_94698fa3:

    # keep3 "Every outcome leads to a different moment."
    keep3 "Mọi kết quả đều dẫn tới một khoảnh khắc khác."

# game/Story04.rpy:9281
translate vietnamese story05_5_6_8f27242e:

    # mc "(So these are… literally all possible versions of my life?)"
    mc "(Vậy đây là… đúng nghĩa mọi phiên bản có thể của cuộc đời tôi sao?)"

# game/Story04.rpy:9282
translate vietnamese story05_5_6_414fa8de:

    # keep3 "Yes."
    keep3 "Đúng vậy."

# game/Story04.rpy:9285
translate vietnamese story05_5_6_db12567f:

    # k "You good?"
    k "Ông ổn chứ?"

# game/Story04.rpy:9289
translate vietnamese story05_5_6_d2944626:

    # mc "Yeah. I’m fine. Don’t worry."
    mc "Ừ. Tôi ổn. Đừng lo."

# game/Story04.rpy:9291
translate vietnamese story05_5_6_df4be6a1:

    # k "Talking to that keeper again, huh…"
    k "Lại nói chuyện với người giữ đó nữa à…"

# game/Story04.rpy:9292
translate vietnamese story05_5_6_b5c7abcf:

    # k "Well. Whatever."
    k "Thôi. Kệ đi."

# game/Story04.rpy:9293
translate vietnamese story05_5_6_c65c039f:

    # k "Not my place to tell you what to do."
    k "Tôi không có quyền bảo ông phải làm gì."

# game/Story04.rpy:9294
translate vietnamese story05_5_6_732f61d5:

    # k "Anyway, how much farther?"
    k "Dù sao thì, còn bao xa nữa?"

# game/Story04.rpy:9296
translate vietnamese story05_5_6_deb9a320:

    # mc "No idea."
    mc "Không biết."

# game/Story04.rpy:9297
translate vietnamese story05_5_6_50c84c8c:

    # mc "Yong’s supposed to meet us somewhere up ahead."
    mc "Yong sẽ gặp chúng ta ở đâu đó phía trước."

# game/Story04.rpy:9298
translate vietnamese story05_5_6_565abddc:

    # mc "After that, he’ll take us to the camp."
    mc "Sau đó, anh ta sẽ đưa chúng ta tới trại."

# game/Story04.rpy:9303
translate vietnamese story05_5_6_b5c31fa9:

    # k "Got it."
    k "Rõ rồi."

# game/Story04.rpy:9310
translate vietnamese story05_5_6_1882d3dc:

    # "The Outcasts’ Camp."
    "Trại của những kẻ bị ruồng bỏ."

# game/Story04.rpy:9312
translate vietnamese story05_5_6_dbfcf1f1:

    # y "Here we are."
    y "Tới nơi rồi."

# game/Story04.rpy:9314
translate vietnamese story05_5_6_27eaadbc:

    # y "Two rules."
    y "Hai quy tắc."

# game/Story04.rpy:9315
translate vietnamese story05_5_6_d72a44d5:

    # y "No mention of slavery."
    y "Không được nhắc tới chế độ nô lệ."

# game/Story04.rpy:9316
translate vietnamese story05_5_6_a9198e50:

    # y "And nothing about implants."
    y "Và không gì về cấy ghép."

# game/Story04.rpy:9319
translate vietnamese story05_5_6_9d1f09df:

    # mc "What about Gorem?"
    mc "Còn Gorem thì sao?"

# game/Story04.rpy:9322
translate vietnamese story05_5_6_8598b237:

    # y "Make that three."
    y "Vậy thì thành ba."

# game/Story04.rpy:9323
translate vietnamese story05_5_6_95ccb1cb:

    # y "Don’t mention His Highness."
    y "Đừng nhắc tới Điện hạ."

# game/Story04.rpy:9332
translate vietnamese story05_5_6_e673a5a1:

    # y "And… a word."
    y "Và… nói riêng một lời."

# game/Story04.rpy:9334
translate vietnamese story05_5_6_9cb23c31:

    # k "(whispering) Something’s off about him."
    k "(thì thầm) Có gì đó không ổn ở ông ta."

# game/Story04.rpy:9336
translate vietnamese story05_5_6_379fcd6e:

    # mc "You think?"
    mc "Cô nghĩ vậy sao?"

# game/Story04.rpy:9337
translate vietnamese story05_5_6_e14da1c5:

    # mc "To me, he feels more open now."
    mc "Với tôi, giờ ông ta cảm thấy cởi mở hơn."

# game/Story04.rpy:9338
translate vietnamese story05_5_6_dcb7f710:

    # mc "In his own way, sure… but still."
    mc "Theo cách riêng của ông ta, đúng vậy… nhưng vẫn thế."

# game/Story04.rpy:9340
translate vietnamese story05_5_6_4faba61d:

    # k "It’s all crap, old man. My gut says something’s wrong here."
    k "Toàn là vớ vẩn, ông già ạ. Linh cảm của tôi mách bảo có gì đó sai sai ở đây."

# game/Story04.rpy:9342
translate vietnamese story05_5_6_20815cf5:

    # mc "Wait here."
    mc "Đợi ở đây."

# game/Story04.rpy:9343
translate vietnamese story05_5_6_75011522:

    # mc "I’ll see what he wants."
    mc "Tôi sẽ xem ông ta muốn gì."

# game/Story04.rpy:9345
translate vietnamese story05_5_6_c3b40072:

    # k "Yeah."
    k "Ừ."

# game/Story04.rpy:9350
translate vietnamese story05_5_6_f3c2cd1f:

    # y "(whispering) I know you’re desperate to go back."
    y "(thì thầm) Tôi biết cậu đang tuyệt vọng muốn quay về."

# game/Story04.rpy:9351
translate vietnamese story05_5_6_abb70f60:

    # y "(whispering) To make sure they’re alright."
    y "(thì thầm) Để chắc chắn rằng họ vẫn ổn."

# game/Story04.rpy:9352
translate vietnamese story05_5_6_774fff4d:

    # y "(whispering) I have a way… but—"
    y "(thì thầm) Tôi có một cách… nhưng—"

# game/Story04.rpy:9356
translate vietnamese story05_5_6_80f35329:

    # y "It’ll take time."
    y "Sẽ mất thời gian."

# game/Story04.rpy:9357
translate vietnamese story05_5_6_297bc275:

    # y "And permission."
    y "Và cần được cho phép."

# game/Story04.rpy:9359
translate vietnamese story05_5_6_9bea3830:

    # mc "Is this about the anomaly rifts?"
    mc "Có phải chuyện này liên quan tới các khe nứt dị thường không?"

# game/Story04.rpy:9363
translate vietnamese story05_5_6_fff2d6da:

    # y "Yes."
    y "Đúng vậy."

# game/Story04.rpy:9364
translate vietnamese story05_5_6_7d0a362a:

    # y "Miriel will explain how they work."
    y "Miriel sẽ giải thích cách chúng hoạt động."

# game/Story04.rpy:9368
translate vietnamese story05_5_6_4179fbbb:

    # mc "So… you’re in charge here?"
    mc "Vậy… ông là người phụ trách ở đây sao?"

# game/Story04.rpy:9373
translate vietnamese story05_5_6_2abdd938:

    # y "More like I watch over them."
    y "Đúng hơn là tôi trông chừng họ."

# game/Story04.rpy:9374
translate vietnamese story05_5_6_356a4f9c:

    # y "Make sure they don’t hurt themselves… or anyone else."
    y "Đảm bảo họ không tự làm hại mình… hay làm hại người khác."

# game/Story04.rpy:9375
translate vietnamese story05_5_6_a52c660d:

    # mc "Then how did you convince them to let us in?"
    mc "Vậy làm sao ông thuyết phục được họ cho chúng ta vào?"

# game/Story04.rpy:9378
translate vietnamese story05_5_6_1b27d8ff:

    # y "It wasn’t my doing."
    y "Đó không phải do tôi."

# game/Story04.rpy:9379
translate vietnamese story05_5_6_9a0e5936:

    # y "Miriel made the first move."
    y "Miriel là người ra tay trước."

# game/Story04.rpy:9380
translate vietnamese story05_5_6_6dc0bb31:

    # y "Smoke?"
    y "Hút thuốc không?"

# game/Story04.rpy:9382
translate vietnamese story05_5_6_4f22aa68:

    # mc "I’ll pass."
    mc "Tôi xin phép không."

# game/Story04.rpy:9383
translate vietnamese story05_5_6_c5b7a818:

    # mc "Not the right place."
    mc "Không phải chỗ thích hợp."

# game/Story04.rpy:9388
translate vietnamese story05_5_6_8a86d85f:

    # mc "So… Miriel."
    mc "Vậy… Miriel."

# game/Story04.rpy:9389
translate vietnamese story05_5_6_2876efd9:

    # mc "Why?"
    mc "Tại sao?"

# game/Story04.rpy:9391
translate vietnamese story05_5_6_db27a9ce:

    # y "Somehow…"
    y "Bằng cách nào đó…"

# game/Story04.rpy:9392
translate vietnamese story05_5_6_88a07eb4:

    # y "she remembered another life."
    y "cô ấy đã nhớ ra một kiếp sống khác."

# game/Story04.rpy:9393
translate vietnamese story05_5_6_95fdceb9:

    # y "Not all of it."
    y "Không phải toàn bộ."

# game/Story04.rpy:9394
translate vietnamese story05_5_6_58a4a77a:

    # y "Just the one where you existed."
    y "Chỉ kiếp mà cậu tồn tại trong đó."

# game/Story04.rpy:9397
translate vietnamese story05_5_6_91905ede:

    # mc "How?"
    mc "Bằng cách nào?"

# game/Story04.rpy:9402
translate vietnamese story05_5_6_049333a8:

    # y "[mc]?"
    y "[mc]?"

# game/Story04.rpy:9404
translate vietnamese story05_5_6_2b35b6fe:

    # mc "..."
    mc "..."

# game/Story04.rpy:9406
translate vietnamese story05_5_6_00ed353e:

    # y "No. It’s nothing."
    y "Không. Không có gì."

# game/Story04.rpy:9407
translate vietnamese story05_5_6_d2036000:

    # y "Get some rest."
    y "Nghỉ ngơi đi."

# game/Story04.rpy:9409
translate vietnamese story05_5_6_ecf872dc:

    # mc "Wait."
    mc "Khoan đã."

# game/Story04.rpy:9410
translate vietnamese story05_5_6_18804ef2:

    # mc "Say what you were going to say."
    mc "Nói điều ông định nói đi."

# game/Story04.rpy:9415
translate vietnamese story05_5_6_cfe40dcf:

    # y "One question."
    y "Một câu hỏi."

# game/Story04.rpy:9416
translate vietnamese story05_5_6_44139f77:

    # y "What is hope?"
    y "Hy vọng là gì?"

# game/Story04.rpy:9418
translate vietnamese story05_5_6_3997c9e2:

    # mc "Why the sudden philosophy?"
    mc "Sao đột nhiên lại triết lý thế?"

# game/Story04.rpy:9421
translate vietnamese story05_5_6_205a9216:

    # y "Why do you keep moving forward?"
    y "Tại sao cậu cứ tiếp tục tiến lên?"

# game/Story04.rpy:9422
translate vietnamese story05_5_6_5c8880e4:

    # y "What… drives you?"
    y "Điều gì… thúc đẩy cậu?"

# game/Story04.rpy:9426
translate vietnamese story05_5_6_34196b86:

    # mc "Protect what’s mine."
    mc "Bảo vệ những gì thuộc về tôi."

# game/Story04.rpy:9427
translate vietnamese story05_5_6_db960325:

    # mc "And to survive."
    mc "Và để sống sót."

# game/Story04.rpy:9433
translate vietnamese story05_5_6_11455b53:

    # mc "What?"
    mc "Sao?"

# game/Story04.rpy:9434
translate vietnamese story05_5_6_0151f9f5:

    # mc "You expecting something profound?"
    mc "Ông đang mong đợi điều gì sâu sắc sao?"

# game/Story04.rpy:9436
translate vietnamese story05_5_6_d2237f60:

    # y "That’s your entire motivation?"
    y "Đó là toàn bộ động lực của cậu sao?"

# game/Story04.rpy:9438
translate vietnamese story05_5_6_ee45b483:

    # mc "Isn’t that enough?"
    mc "Thế chưa đủ sao?"

# game/Story04.rpy:9440
translate vietnamese story05_5_6_2e500179:

    # mc "When a lion grows weak, the pride casts him out."
    mc "Khi một con sư tử trở nên yếu đi, bầy sẽ đuổi nó ra."

# game/Story04.rpy:9441
translate vietnamese story05_5_6_4a786404:

    # mc "He’s left alone."
    mc "Nó bị bỏ lại một mình."

# game/Story04.rpy:9442
translate vietnamese story05_5_6_8f5a3603:

    # mc "No allies. No shelter."
    mc "Không đồng minh. Không nơi trú ẩn."

# game/Story04.rpy:9443
translate vietnamese story05_5_6_457c9e67:

    # mc "And still…"
    mc "Và dù vậy…"

# game/Story04.rpy:9444
translate vietnamese story05_5_6_338e7b9d:

    # mc "They don’t die of old age."
    mc "Chúng không chết vì già."

# game/Story04.rpy:9445
translate vietnamese story05_5_6_2c80f101:

    # mc "They die fighting."
    mc "Chúng chết trong chiến đấu."

# game/Story04.rpy:9447
translate vietnamese story05_5_6_ea9137a4:

    # mc "Struggle is life."
    mc "Đấu tranh chính là sự sống."

# game/Story04.rpy:9448
translate vietnamese story05_5_6_4a177878:

    # mc "Stop fighting and you’re already dead."
    mc "Ngừng chiến đấu là ngươi đã chết rồi."

# game/Story04.rpy:9449
translate vietnamese story05_5_6_8eeda518:

    # mc "That’s all there is to it."
    mc "Chỉ có vậy thôi."

# game/Story04.rpy:9453
translate vietnamese story05_5_6_9884eeed:

    # y "What’s a lion?"
    y "Sư tử là gì?"

# game/Story04.rpy:9456
translate vietnamese story05_5_6_95573fa3:

    # mc "What—"
    mc "Cái gì—"

# game/Story04.rpy:9458
translate vietnamese story05_5_6_556aef90:

    # mc "You know what? Forget it."
    mc "Ông biết không? Quên đi."

# game/Story04.rpy:9462
translate vietnamese story05_5_6_d2036000_1:

    # y "Get some rest."
    y "Nghỉ ngơi đi."

# game/Story04.rpy:9467
translate vietnamese story05_5_6_d4a13ab5:

    # mc "(Rest…)"
    mc "(Nghỉ ngơi…)"

# game/Story04.rpy:9468
translate vietnamese story05_5_6_a6dbc81b:

    # mc "(Like that’s something I can afford.)"
    mc "(Như thể đó là thứ tôi có thể đủ khả năng vậy.)"

# game/Story04.rpy:9474
translate vietnamese story05_5_6_91d8a70c:

    # mc "You okay?"
    mc "Cô ổn chứ?"

# game/Story04.rpy:9476
translate vietnamese story05_5_6_61a75ab0:

    # k "Hm? Oh, it’s you, old man."
    k "Hử? Ồ, là ông đấy à, ông già."

# game/Story04.rpy:9477
translate vietnamese story05_5_6_edf61239:

    # k "Yeah, I’m fine."
    k "Ừ, tôi ổn."

# game/Story04.rpy:9479
translate vietnamese story05_5_6_347a4121:

    # mc "Enjoying it?"
    mc "Đang tận hưởng đấy à?"

# game/Story04.rpy:9481
translate vietnamese story05_5_6_d63f0d2d:

    # k "Nah. I’m more interested in watching him."
    k "Không. Tôi hứng thú nhìn ông ta hơn."

# game/Story04.rpy:9485
translate vietnamese story05_5_6_2e9afd27:

    # k "So… what were you whispering about?"
    k "Vậy… hai người thì thầm chuyện gì thế?"

# game/Story04.rpy:9487
translate vietnamese story05_5_6_bd886342:

    # mc "That obvious?"
    mc "Rõ ràng đến thế sao?"

# game/Story04.rpy:9490
translate vietnamese story05_5_6_6229046d:

    # k "Two old men whispering behind everyone’s backs?"
    k "Hai ông già thì thầm sau lưng mọi người ư?"

# game/Story04.rpy:9491
translate vietnamese story05_5_6_de29071f:

    # k "The whole camp noticed."
    k "Cả trại đều để ý đấy."

# game/Story04.rpy:9495
translate vietnamese story05_5_6_917a12cb:

    # mc "How’s your wound?"
    mc "Vết thương của cô thế nào rồi?"

# game/Story04.rpy:9498
translate vietnamese story05_5_6_dcc678cf:

    # k "Honestly?"
    k "Thật lòng mà nói?"

# game/Story04.rpy:9499
translate vietnamese story05_5_6_ff8ee4e6:

    # k "Like shit. I’ll live, but it hurts like hell."
    k "Như cứt vậy. Tôi sẽ sống, nhưng đau như điên."

# game/Story04.rpy:9503
translate vietnamese story05_5_6_51d48dc6:

    # mc "Take it off. I need to check how it—"
    mc "Cởi ra đi. Tôi cần kiểm tra xem nó—"

# game/Story04.rpy:9506
translate vietnamese story05_5_6_bf832a13:

    # k "No."
    k "Không."

# game/Story04.rpy:9508
translate vietnamese story05_5_6_9b60042c:

    # mc "I’ve already seen it, so—"
    mc "Tôi đã thấy nó rồi, nên—"

# game/Story04.rpy:9510
translate vietnamese story05_5_6_1ffaf74c:

    # mc "(She’s red. Is she… embarrassed? No, wait, what am I doing?)"
    mc "(Cô ấy đỏ mặt. Cô ấy… đang xấu hổ sao? Không, khoan, mình đang làm gì vậy?)"

# game/Story04.rpy:9512
translate vietnamese story05_5_6_91f1affe:

    # k "Others are watching."
    k "Người khác đang nhìn kìa."

# game/Story04.rpy:9516
translate vietnamese story05_5_6_0f0f8f78:

    # mc "(Not even trying to hide it.)"
    mc "(Thậm chí còn không cố giấu.)"

# game/Story04.rpy:9519
translate vietnamese story05_5_6_9d0dd685:

    # mc "But… that never bothered you before. What changed?"
    mc "Nhưng… trước đây chuyện đó có bao giờ làm phiền cô đâu. Có gì đã thay đổi?"

# game/Story04.rpy:9521
translate vietnamese story05_5_6_c6edbff3:

    # k "No means no."
    k "Không là không."

# game/Story04.rpy:9524
translate vietnamese story05_5_6_96de68f4:

    # keep3 "It’s the miasma."
    keep3 "Là do chướng khí."

# game/Story04.rpy:9526
translate vietnamese story05_5_6_97dade16:

    # mc "(Care to elaborate?)"
    mc "(Giải thích rõ hơn được không?)"

# game/Story04.rpy:9527
translate vietnamese story05_5_6_4b70651f:

    # keep3 "The implants used to dull emotions completely."
    keep3 "Các cấy ghép từng làm cảm xúc hoàn toàn tê liệt."

# game/Story04.rpy:9529
translate vietnamese story05_5_6_790c4588:

    # keep3 "But once you damaged them, that effect stopped working."
    keep3 "Nhưng một khi ngươi làm hỏng chúng, hiệu ứng đó đã ngừng hoạt động."

# game/Story04.rpy:9530
translate vietnamese story05_5_6_27e6ae11:

    # keep3 "What you see now is the result."
    keep3 "Những gì ngươi thấy giờ là kết quả."

# game/Story04.rpy:9531
translate vietnamese story05_5_6_2ce665f2:

    # mc "(Maybe. Or maybe there’s more to it.)"
    mc "(Có thể. Hoặc có thể còn hơn thế.)"

# game/Story04.rpy:9534
translate vietnamese story05_5_6_a8be934d:

    # mc "Listen. I’m responsible for you."
    mc "Nghe này. Tôi chịu trách nhiệm về cô."

# game/Story04.rpy:9535
translate vietnamese story05_5_6_8dd1ac38:

    # mc "And I need to know if you’re alright."
    mc "Và tôi cần biết cô có ổn không."

# game/Story04.rpy:9538
translate vietnamese story05_5_6_6651ab87:

    # mc "Alright."
    mc "Được rồi."

# game/Story04.rpy:9539
translate vietnamese story05_5_6_4f94a11d:

    # mc "We’ll find somewhere more private."
    mc "Chúng ta sẽ tìm một chỗ kín đáo hơn."

# game/Story04.rpy:9540
translate vietnamese story05_5_6_82091822:

    # k "..."
    k "..."

# game/Story04.rpy:9543
translate vietnamese story05_5_6_996f037d:

    # k "Thanks, old man."
    k "Cảm ơn, ông già."

# game/Story04.rpy:9546
translate vietnamese story05_5_6_bdc003c0:

    # Mi "I… overheard that you were having some trouble."
    Mi "Tôi… nghe lỏm được rằng anh đang gặp chút rắc rối."

# game/Story04.rpy:9548
translate vietnamese story05_5_6_352ab7f2:

    # Mi "And… I could show you a place."
    Mi "Và… tôi có thể chỉ cho anh một nơi."

# game/Story04.rpy:9554
translate vietnamese story05_5_6_9e0efdff:

    # Mi "(whispering) If you’d like."
    Mi "(thì thầm) Nếu anh muốn."

# game/Story04.rpy:9556
translate vietnamese story05_5_6_0b348ba0:

    # mc "…Alright."
    mc "…Được rồi."

# game/Story04.rpy:9558
translate vietnamese story05_5_6_71f825dc:

    # Mi "Then… follow me."
    Mi "Vậy… đi theo tôi."

# game/Story04.rpy:9562
translate vietnamese story05_5_6_38c2c890:

    # mc "So… what’s the occasion?"
    mc "Vậy… dịp gì thế?"

# game/Story04.rpy:9564
translate vietnamese story05_5_6_b0442d1a:

    # Mi "It is… our annual day of remembrance. We honor those who perished in the tragedy."
    Mi "Đó là… ngày tưởng niệm hằng năm của chúng tôi. Chúng tôi tôn vinh những người đã thiệt mạng trong thảm kịch."

# game/Story04.rpy:9565
translate vietnamese story05_5_6_5414458b:

    # mc "You mean El— …your Highness’s grandfather?"
    mc "Ý cô là El— …ông của Điện hạ nhà cô sao?"

# game/Story04.rpy:9567
translate vietnamese story05_5_6_bddc88bb:

    # Mi "Yes."
    Mi "Vâng."

# game/Story04.rpy:9568
translate vietnamese story05_5_6_ac242372:

    # Mi "The deeds of our progenitor, Eldrindor."
    Mi "Công trạng của tổ tiên chúng tôi, Eldrindor."

# game/Story04.rpy:9570
translate vietnamese story05_5_6_1c260c86:

    # k "Funny. I don’t see much mourning."
    k "Buồn cười thật. Tôi chẳng thấy mấy ai than khóc."

# game/Story04.rpy:9571
translate vietnamese story05_5_6_afe4b16c:

    # k "More like celebration."
    k "Giống ăn mừng hơn."

# game/Story04.rpy:9572
translate vietnamese story05_5_6_11ed92ca:

    # k "Looks strange."
    k "Trông lạ thật."

# game/Story04.rpy:9574
translate vietnamese story05_5_6_d07a9da0:

    # Mi "Tears won’t bring the dead back."
    Mi "Nước mắt sẽ không đưa người chết trở lại."

# game/Story04.rpy:9575
translate vietnamese story05_5_6_1cb6a1b7:

    # Mi "And I don’t think they’d want to see their loved ones weep."
    Mi "Và tôi không nghĩ họ muốn thấy người thân của mình khóc than."

# game/Story04.rpy:9576
translate vietnamese story05_5_6_f54ce31b:

    # Mi "So we celebrate."
    Mi "Vì vậy chúng tôi ăn mừng."

# game/Story04.rpy:9577
translate vietnamese story05_5_6_53368c23:

    # Mi "We remember with life, not sorrow."
    Mi "Chúng tôi tưởng nhớ bằng sự sống, không phải bằng nỗi buồn."

# game/Story04.rpy:9579
translate vietnamese story05_5_6_984bb045:

    # k "I’ve heard of that. Still feels odd."
    k "Tôi từng nghe về chuyện đó. Vẫn thấy kỳ lạ."

# game/Story04.rpy:9581
translate vietnamese story05_5_6_fcfbdca9:

    # Mi "If you prefer tears, that’s your choice."
    Mi "Nếu anh thích khóc than, đó là lựa chọn của anh."

# game/Story04.rpy:9582
translate vietnamese story05_5_6_ce7ee942:

    # Mi "We chose a different path."
    Mi "Chúng tôi đã chọn một con đường khác."

# game/Story04.rpy:9585
translate vietnamese story05_5_6_885df22b:

    # elf "YEE-HEE-HEY!"
    elf "YEE-HEE-HEY!"

# game/Story04.rpy:9591
translate vietnamese story05_5_6_055e3625:

    # Mi "Reyka, Leila, you alright?"
    Mi "Reyka, Leila, hai người ổn chứ?"

# game/Story04.rpy:9594
translate vietnamese story05_5_6_316253ac:

    # elf "All good!"
    elf "Mọi thứ đều ổn!"

# game/Story04.rpy:9598
translate vietnamese story05_5_6_a21b180a:

    # mc "Sorry… if her words hit a nerve."
    mc "Xin lỗi… nếu lời cô ấy chạm vào nỗi đau."

# game/Story04.rpy:9600
translate vietnamese story05_5_6_f9d3c56f:

    # Mi "N-no, it’s alright. For us… it’s an old wound."
    Mi "Kh-không, không sao đâu. Với chúng tôi… đó là một vết thương cũ."

# game/Story04.rpy:9601
translate vietnamese story05_5_6_95fca8bb:

    # Mi "But… about that promise—"
    Mi "Nhưng… về lời hứa đó—"

# game/Story04.rpy:9603
translate vietnamese story05_5_6_dbd06f47:

    # mc "That was just an off—"
    mc "Đó chỉ là một lời—"

# game/Story04.rpy:9604
translate vietnamese story05_5_6_9e00b9f4:

    # mc "(Wait… she refused back then… and now…?)"
    mc "(Khoan… hồi đó cô ấy đã từ chối… mà giờ…?)"

# game/Story04.rpy:9606
translate vietnamese story05_5_6_4075d740:

    # mc "So… you agreed?"
    mc "Vậy… cô đã đồng ý sao?"

# game/Story04.rpy:9609
translate vietnamese story05_5_6_12b9d1aa:

    # Mi "After what you said about your bond with my teacher…"
    Mi "Sau những gì anh nói về mối liên kết của anh với thầy tôi…"

# game/Story04.rpy:9610
translate vietnamese story05_5_6_60bd3f51:

    # Mi "I went to see him."
    Mi "Tôi đã đi gặp thầy."

# game/Story04.rpy:9611
translate vietnamese story05_5_6_fe04e153:

    # Mi "He… explained the bigger picture."
    Mi "Thầy… đã giải thích bức tranh lớn hơn."

# game/Story04.rpy:9612
translate vietnamese story05_5_6_615488fb:

    # Mi "I agreed."
    Mi "Tôi đã đồng ý."

# game/Story04.rpy:9613
translate vietnamese story05_5_6_054c5ee0:

    # mc "I see."
    mc "Tôi hiểu rồi."

# game/Story04.rpy:9614
translate vietnamese story05_5_6_c15f640f:

    # Mi "But how exactly do you plan to improve our situation?"
    Mi "Nhưng chính xác thì anh định cải thiện tình hình của chúng tôi bằng cách nào?"

# game/Story04.rpy:9617
