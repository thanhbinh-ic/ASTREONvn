translate vietnamese story05_884e5813:

    # Fl "Begin the operation."
    Fl "Bắt đầu chiến dịch."

# game/Story04.rpy:134
translate vietnamese story05_ce985e4b:

    # "One hour into the operation."
    "Chiến dịch đã diễn ra được một giờ."

# game/Story04.rpy:139
translate vietnamese story05_77e85994:

    # aa "Sixty-Three to command… We’re not holding! There’s too many of them!"
    aa "Sáu Mươi Ba gọi chỉ huy… Chúng tôi không giữ được nữa! Chúng đông quá!"

# game/Story04.rpy:142
translate vietnamese story05_2db6b80d:

    # a "Command to Sixty-Three. Status?!"
    a "Chỉ huy gọi Sáu Mươi Ba. Tình hình?!"

# game/Story04.rpy:146
translate vietnamese story05_bbf346a0:

    # aaa "Mission failed, enemy numbers are overwhelming! Requesting evac-!"
    aaa "Nhiệm vụ thất bại, quân địch đông áp đảo! Xin sơ tán—!"

# game/Story04.rpy:150
translate vietnamese story05_c684e829:

    # a "Sixty-Three? …Sixty-Three!!"
    a "Sáu Mươi Ba? …Sáu Mươi Ba!!"

# game/Story04.rpy:152
translate vietnamese story05_164b07a0:

    # a "Connection to Squad Sixty-Three is lost."
    a "Đã mất liên lạc với Tiểu đội Sáu Mươi Ba."

# game/Story04.rpy:156
translate vietnamese story05_131392a3:

    # aaaa "Iron Dome to command. We’ve spotted survivors. Orders?"
    aaaa "Vòm Sắt gọi chỉ huy. Chúng tôi đã phát hiện người sống sót. Mệnh lệnh?"

# game/Story04.rpy:157
translate vietnamese story05_b072667f:

    # a "Sending transport to the marked coordinates."
    a "Đang gửi phương tiện vận chuyển tới tọa độ đã đánh dấu."

