    # k "Just… thought you’d jump me."
    k "Chỉ là… tôi tưởng anh sẽ vồ lấy tôi."

# game/Story04.rpy:9780
translate vietnamese story05_5_6_1e1ebeb5:

    # k "Not… this."
    k "Chứ không phải… thế này."

# game/Story04.rpy:9782
translate vietnamese story05_5_6_a66b2e65:

    # mc "Sometimes simple care can do more than anything else."
    mc "Đôi khi sự quan tâm giản đơn có thể làm được nhiều hơn bất cứ thứ gì khác."

# game/Story04.rpy:9784
translate vietnamese story05_5_6_aeef74c6:

    # k "Hmph…"
    k "Hừm…"

# game/Story04.rpy:9785
translate vietnamese story05_5_6_9680a338:

    # mc "(Her worldview’s not that different from Olivia’s. Both expect a trap in even the simplest kindness…)"
    mc "(Cách nhìn đời của cô ấy cũng chẳng khác Olivia là mấy. Cả hai đều chờ một cái bẫy ngay cả trong sự tử tế giản đơn nhất…)"

# game/Story04.rpy:9787
translate vietnamese story05_5_6_58942dfd:

