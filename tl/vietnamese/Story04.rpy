    # h "(What I’m getting at is… without you, I’m not sure who I’d even be.)"
    h "(Điều tôi muốn nói là… không có anh, tôi không chắc mình sẽ là ai nữa.)"

# game/Story04.rpy:3948
translate vietnamese story05_6_805067da:

    # mc "(Didn’t seem to stop you back on Earth.)"
    mc "(Điều đó dường như đã không ngăn cậu lại khi còn ở Trái Đất.)"

# game/Story04.rpy:3950
translate vietnamese story05_6_58348e3a:

    # h "(Back then, I just ran. From everything. Telling myself I was strong and independent.)"
    h "(Hồi đó, tôi chỉ chạy trốn. Khỏi mọi thứ. Tự nhủ rằng mình mạnh mẽ và độc lập.)"

# game/Story04.rpy:3951
translate vietnamese story05_6_4ed78104:

    # mc "Olivia! That’s my girl!"
    mc "Olivia! Đúng là cô gái của tôi!"

# game/Story04.rpy:3952
translate vietnamese story05_6_3bcf52b6:

    # h "(But deep down…)"
    h "(Nhưng sâu thẳm bên trong…)"

# game/Story04.rpy:3955
translate vietnamese story05_6_84b87c50:

    # mc "Hip-hip, hooray!"
    mc "Hip-hip, hoan hô!"

# game/Story04.rpy:3956
translate vietnamese story05_6_2a18d57a:

    # h "(You became the support I never asked for.)"
    h "(Anh đã trở thành chỗ dựa mà tôi chưa từng xin.)"

# game/Story04.rpy:3958
translate vietnamese story05_6_6f3fb058:

    # h "(But desperately needed.)"
    h "(Nhưng lại vô cùng cần.)"

# game/Story04.rpy:3959
translate vietnamese story05_6_c2d2ff63:

    # h "(At first, I confused gratitude with something more.)"
    h "(Lúc đầu, tôi đã nhầm lẫn lòng biết ơn với thứ gì đó hơn thế.)"

# game/Story04.rpy:3960
