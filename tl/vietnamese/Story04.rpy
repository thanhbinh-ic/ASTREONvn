    # mc "(But the mission—)"
    mc "(Nhưng nhiệm vụ—)"

# game/Story04.rpy:4096
translate vietnamese mcchoice1_803e3062:

    # h "You’re thinking about her right now, aren’t you?"
    h "Anh đang nghĩ về cô ấy ngay lúc này, phải không?"

# game/Story04.rpy:4097
translate vietnamese mcchoice1_58eac386:

    # h "I can tell by your eyes."
    h "Em nhìn mắt anh là biết."

# game/Story04.rpy:4098
translate vietnamese mcchoice1_e62410b0:

    # h "You don’t know what the right thing to do is."
    h "Anh không biết điều đúng đắn cần làm là gì."

# game/Story04.rpy:4100
translate vietnamese mcchoice1_4fc7852d:

    # mc "Sorry… Before, not knowing the reason, I could ignore it."
    mc "Xin lỗi… Trước đây, khi chưa biết lý do, tôi còn có thể phớt lờ nó."

# game/Story04.rpy:4101
translate vietnamese mcchoice1_fe8693d9:

    # mc "But now, knowing what happened, thinking about what a shitty thing I’m doing doesn’t exactly make life easier."
    mc "Nhưng giờ đây, khi đã biết chuyện gì đã xảy ra, nghĩ về việc tồi tệ mình đang làm cũng chẳng khiến cuộc sống dễ dàng hơn chút nào."

# game/Story04.rpy:4103
translate vietnamese mcchoice1_ab52b869:

    # h "So… what will it be?"
    h "Vậy… anh chọn thế nào?"

# game/Story04.rpy:4104
