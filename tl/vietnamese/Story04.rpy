translate vietnamese story05_5_6_6e06bc32:

    # mc "But I doubt that’s what you need."
    mc "Nhưng tôi nghi ngờ đó là điều cô cần."

# game/Story04.rpy:9726
translate vietnamese story05_5_6_82091822_1:

