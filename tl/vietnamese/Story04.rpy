# game/Story04.rpy:4870
translate vietnamese story05_8_0bc26a75:

    # k "(If we don’t convince her, we’re dead. No other way around it.)"
    k "(Nếu chúng ta không thuyết phục được cô ấy, chúng ta chết chắc. Không còn cách nào khác.)"

# game/Story04.rpy:4871
