# game/Story04.rpy:9649
translate vietnamese story05_5_6_5df7d9fc:

    # mc "You have a beautiful smile."
    mc "Cô có nụ cười rất đẹp."

# game/Story04.rpy:9651
translate vietnamese story05_5_6_da3fdbf1:

    # Mi "..."
    Mi "..."

# game/Story04.rpy:9654
