    # a "No chance."
    a "Không có cửa đâu."

# game/Story04.rpy:66
translate vietnamese story05_e6d7945a:

    # a "Too slow. Too dangerous."
    a "Quá chậm. Quá nguy hiểm."

# game/Story04.rpy:68
translate vietnamese story05_72c76da9:

    # Fl "Arcana’s unit will cover you with fire support. We’ll disable part of their AA."
    Fl "Đơn vị của Arcana sẽ yểm trợ hỏa lực cho mọi người. Chúng tôi sẽ vô hiệu hóa một phần hệ thống phòng không của chúng."

# game/Story04.rpy:70
translate vietnamese story05_2d3140aa:

    # Fl "And… Ember has offered her personal cruiser."
    Fl "Và… Ember đã đề nghị cho mượn tuần dương hạm cá nhân của cô ấy."

# game/Story04.rpy:71
translate vietnamese story05_629d25eb:

    # Fl "With it, you’ll break through. Any questions?"
    Fl "Với nó, mọi người sẽ xuyên qua được. Còn câu hỏi nào không?"

# game/Story04.rpy:72
translate vietnamese story05_bb8e4b4e:

    # a "..."
    a "..."

# game/Story04.rpy:75
translate vietnamese story05_ed2fe8c7:

    # Fl "Good. Then one last thing."
    Fl "Tốt. Vậy còn một điều cuối cùng."

# game/Story04.rpy:76
translate vietnamese story05_4a7166e1:

    # Fl "Your most important mission."
    Fl "Nhiệm vụ quan trọng nhất của mọi người."

# game/Story04.rpy:78
translate vietnamese story05_336880a4:

    # Fl "Come back alive."
    Fl "Hãy trở về sống sót."

# game/Story04.rpy:79
translate vietnamese story05_05a37188:

    # Fl "All of you."
    Fl "Tất cả mọi người."

# game/Story04.rpy:81
translate vietnamese story05_cbab612b:

    # h "We’ll do everything we can, but-"
    h "Chúng tôi sẽ làm hết sức có thể, nhưng—"

# game/Story04.rpy:82
translate vietnamese story05_da3fdbf1:

    # Mi "..."
    Mi "..."

# game/Story04.rpy:83
translate vietnamese story05_cf1adef2_1:

    # mc "Yeah."
    mc "Ừ."

# game/Story04.rpy:84
translate vietnamese story05_a31c8b7e:

    # k "Pff. What happened to all that fire? Come on, this is where the fun starts."
    k "Phì. Ngọn lửa đó đâu hết rồi? Thôi nào, đây mới là lúc vui bắt đầu."

# game/Story04.rpy:85
translate vietnamese story05_e93cc8aa:

    # h "Crazy…"
    h "Điên thật…"

# game/Story04.rpy:87
translate vietnamese story05_e1ae7e88:

    # k "If you’re that scared, you can hide behind my back. Actually, nah. You’d just keep whining."
    k "Nếu sợ đến thế thì cứ trốn sau lưng tôi đi. Mà thôi, không. Cô chỉ có rên rỉ mãi thôi."

# game/Story04.rpy:88
translate vietnamese story05_78486174:

    # h "Huh?"
    h "Hả?"

# game/Story04.rpy:89
translate vietnamese story05_f53bb6a4:

    # k "In the end… if not us, then who?"
    k "Cuối cùng thì… nếu không phải chúng ta, thì sẽ là ai?"

# game/Story04.rpy:92
translate vietnamese story05_e61ade48:

    # mc "Everyone here has something they’re trying to protect."
    mc "Ai ở đây cũng có thứ mình đang cố bảo vệ."

# game/Story04.rpy:93
translate vietnamese story05_ed8f611a:

    # mc "We can’t let them down."
    mc "Chúng ta không thể làm họ thất vọng."

# game/Story04.rpy:94
translate vietnamese story05_f15422b6:

    # L "Yes. If they’re putting in that much effort… then we should, too."
    L "Đúng vậy. Nếu họ đã nỗ lực đến thế… thì chúng ta cũng nên như vậy."

# game/Story04.rpy:96
translate vietnamese story05_714de269:

    # Fl "(They don’t owe us this. If anything, it’s we who should be...)"
    Fl "(Họ không nợ chúng ta điều này. Nếu có, thì chính chúng ta mới là người nên...)"

# game/Story04.rpy:97
translate vietnamese story05_4e0689d9:

    # Fl "(And yet…)"
    Fl "(Vậy mà…)"

# game/Story04.rpy:99
translate vietnamese story05_1e67f78f:

    # Fl "(No. Not now. Focus. You can repay them later, when this is over.)"
    Fl "(Không. Không phải lúc này. Tập trung đi. Mình có thể đền đáp họ sau, khi mọi chuyện kết thúc.)"

# game/Story04.rpy:100
translate vietnamese story05_b2b7a84b:

    # Fl "(Right now we need to do everything we possibly can… and we succeed.)"
    Fl "(Ngay lúc này chúng ta cần làm mọi thứ có thể… và chúng ta sẽ thành công.)"

# game/Story04.rpy:102
translate vietnamese story05_65c709cc:

    # Fl "(whisper) Yes… we will succeed. All of us."
    Fl "(thì thầm) Đúng vậy… chúng ta sẽ thành công. Tất cả chúng ta."

# game/Story04.rpy:105
translate vietnamese story05_61306a86:

    # g "Good luck."
    g "Chúc may mắn."

# game/Story04.rpy:111
translate vietnamese story05_05dda99f:

    # mc "Likewise."
    mc "Tôi cũng vậy."

# game/Story04.rpy:112
translate vietnamese story05_1e6136ef:

    # g "It’s been an honor working with you."
    g "Được làm việc cùng ngài là một vinh dự."

# game/Story04.rpy:116
translate vietnamese story05_987c2bdd:

    # "Ten minutes until the operation begins."
    "Còn mười phút nữa là chiến dịch bắt đầu."

# game/Story04.rpy:117
translate vietnamese story05_b69d5494:

    # g "Miss Flora."
    g "Cô Flora."

# game/Story04.rpy:118
translate vietnamese story05_bfcb6309:

    # Fl "Y-yeah… it’s time."
    Fl "Ừ—ừ… đến giờ rồi."

