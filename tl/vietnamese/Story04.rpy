translate vietnamese story05_0d019945:

    # a "Continue your route."
    a "Tiếp tục lộ trình của các anh."

# game/Story04.rpy:162
translate vietnamese story05_683a3671:

    # a "Miss Flora, western sector made contact with the enemy. Heavy resistance."
    a "Cô Flora, khu vực phía tây đã chạm trán địch. Kháng cự dữ dội."

# game/Story04.rpy:163
translate vietnamese story05_3f5fc691:

    # a "They’re calling for backup, numbers are too high."
    a "Họ đang xin viện trợ, quân số quá đông."

# game/Story04.rpy:166
translate vietnamese story05_ed5e33db:

    # Fl "Send a few squads from the east. They need to hold until backup arrives."
    Fl "Gửi vài tiểu đội từ phía đông sang. Họ cần giữ vững cho đến khi viện trợ tới."

# game/Story04.rpy:167
translate vietnamese story05_1703b7e0:

    # Fl "(I thought I was ready. I really did. I thought it would be like the simulations.)"
    Fl "(Mình đã tưởng mình sẵn sàng rồi. Thật sự đấy. Mình đã tưởng nó sẽ giống như các buổi mô phỏng.)"

# game/Story04.rpy:168
translate vietnamese story05_570e3496:

    # Fl "(I thought Mom was wrong, but-)"
    Fl "(Mình đã tưởng mẹ đã sai, nhưng—)"

# game/Story04.rpy:171
translate vietnamese story05_e1845ba2:

    # aa "Thirty-Eighth reports AA guns northwest!"
    aa "Ba Mươi Tám báo cáo có pháo phòng không ở phía tây bắc!"

# game/Story04.rpy:174
translate vietnamese story05_334ced28:

    # Fl "Arcana platoon, transmitting the coordinates."
    Fl "Trung đội Arcana, đang truyền tọa độ."

# game/Story04.rpy:175
translate vietnamese story05_d3003e87:

    # aaa "Copy. Working."
    aaa "Rõ. Đang xử lý."

# game/Story04.rpy:184
translate vietnamese story05_9bfcd75b:

    # aaa "Target neutralized. Runway is clear for the bird."
    aaa "Mục tiêu đã bị vô hiệu hóa. Đường băng đã trống cho tàu bay."

# game/Story04.rpy:185
translate vietnamese story05_7467db5a:

    # Fl "Good work."
    Fl "Làm tốt lắm."

# game/Story04.rpy:186
translate vietnamese story05_275207dc:

    # Fl "(The screaming. The pain. All of it…)"
    Fl "(Tiếng la hét. Nỗi đau. Tất cả…)"

# game/Story04.rpy:187
translate vietnamese story05_f2679feb:

    # Fl "(I’m sorry, Dad. I can’t, I can’t take this.)"
    Fl "(Con xin lỗi, cha. Con không thể, con không chịu nổi nữa.)"

# game/Story04.rpy:188
translate vietnamese story05_4834e3f8:

    # Fl "(whispering) I want to run."
    Fl "(thì thầm) Tôi muốn chạy trốn."

# game/Story04.rpy:191
translate vietnamese story05_8592b5dd:

    # Fl "Any updates from the other sectors? Did anyone respond to our signal?"
    Fl "Có cập nhật gì từ các khu vực khác không? Có ai phản hồi tín hiệu của chúng ta không?"

# game/Story04.rpy:192
translate vietnamese story05_d8cdd4ae:

    # a "Nothing, Miss Flora. Might be something else jamming them."
    a "Không có gì, cô Flora. Có thể có thứ gì khác đang gây nhiễu họ."

# game/Story04.rpy:195
translate vietnamese story05_04f36b31:

    # Fl "(This is bad. We’re short on people, short on supplies. They’re holding on morale alone… and that runs out.)"
    Fl "(Tệ rồi. Chúng ta thiếu người, thiếu vật tư. Họ chỉ còn bám vào tinh thần… mà tinh thần thì cũng cạn kiệt.)"

# game/Story04.rpy:196
translate vietnamese story05_fd01d515:

    # Fl "(Everything’s against us… Hope-)"
    Fl "(Mọi thứ đều chống lại chúng ta… Hy vọng—)"

# game/Story04.rpy:198
translate vietnamese story05_41da62cb_1:

    # Fl "..."
    Fl "..."

# game/Story04.rpy:201
translate vietnamese story05_2d61269a:

    # Fl "(whispering) Focus. We still have a chance."
    Fl "(thì thầm) Tập trung. Chúng ta vẫn còn cơ hội."

# game/Story04.rpy:202
translate vietnamese story05_bbb05453:

    # Fl "([mc], please… don’t let me down.)"
    Fl "([mc], làm ơn… đừng làm tôi thất vọng.)"

# game/Story04.rpy:216
translate vietnamese story05_72615205:

    # mc "(As long as I can remember, I wanted a quiet, peaceful life.)"
    mc "(Từ khi tôi còn nhớ được, tôi đã muốn một cuộc sống yên tĩnh, bình yên.)"

# game/Story04.rpy:217
translate vietnamese story05_1b253083:

    # mc "(When I came back from the army, I really thought I could make it real.)"
    mc "(Khi trở về từ quân đội, tôi thật sự đã nghĩ mình có thể biến nó thành hiện thực.)"

# game/Story04.rpy:218
translate vietnamese story05_f5ed906e:

    # mc "(A loving wife. A good family. A big house. Maybe a dog... the American dream done.)"
    mc "(Một người vợ yêu thương. Một gia đình tốt. Một ngôi nhà lớn. Có lẽ thêm một chú chó... giấc mơ Mỹ trọn vẹn.)"

# game/Story04.rpy:220
translate vietnamese story05_5f067948:

    # mc "(But now I’m here. At the ass end of the galaxy. Why?)"
    mc "(Nhưng giờ tôi lại ở đây. Ở nơi tận cùng khỉ ho cò gáy của thiên hà. Tại sao chứ?)"

# game/Story04.rpy:221
translate vietnamese story05_39f3737c:

    # mc "(Because of Lora? ...Or because of the memories of her?)"
    mc "(Vì Lora ư? ...Hay vì những ký ức về cô ấy?)"

# game/Story04.rpy:222
translate vietnamese story05_c928614d:

    # mc "(Maybe because of Norman? So his sacrifice wouldn’t be for nothing?)"
    mc "(Có lẽ vì Norman? Để sự hy sinh của anh ấy không trở nên vô nghĩa?)"

# game/Story04.rpy:223
translate vietnamese story05_c924218f:

    # mc "(Or because of my own damn ego?)"
    mc "(Hay vì cái tôi chết tiệt của chính tôi?)"

# game/Story04.rpy:225
translate vietnamese story05_c2565da4:

    # mc "Olivia?"
    mc "Olivia?"

# game/Story04.rpy:227
translate vietnamese story05_40463722:

    # h "What do you want?"
    h "Anh muốn gì?"

# game/Story04.rpy:229
translate vietnamese story05_007b6cb2:

