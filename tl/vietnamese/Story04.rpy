    # mc "Thanks, Mir."
    mc "Cảm ơn, Mir."

# game/Story04.rpy:9817
translate vietnamese story05_5_6_da3fdbf1_2:

    # Mi "..."
    Mi "..."

# game/Story04.rpy:9819
translate vietnamese story05_5_6_09752471:

    # mc "Something bothering you?"
    mc "Có chuyện gì làm cô bận tâm à?"

# game/Story04.rpy:9821
translate vietnamese story05_5_6_63450149:

    # Mi "How did you—"
    Mi "Sao anh biết—"

# game/Story04.rpy:9823
translate vietnamese story05_5_6_30c3fa28:

    # k "Your face gives you away."
    k "Mặt cậu tố cáo cậu rồi."

# game/Story04.rpy:9824
translate vietnamese story05_5_6_da3fdbf1_3:

    # Mi "..."
    Mi "..."

# game/Story04.rpy:9826
translate vietnamese story05_5_6_16765f0d:

    # Mi "I… would like to know more about you."
    Mi "Tôi… muốn biết thêm về anh."

# game/Story04.rpy:9827
translate vietnamese story05_5_6_31bd81a8:

    # Mi "But I also understand this may not be the right moment."
    Mi "Nhưng tôi cũng hiểu có lẽ đây không phải lúc thích hợp."

# game/Story04.rpy:9829
translate vietnamese story05_5_6_ea6752a0:

    # k "Why not?"
    k "Sao lại không?"

# game/Story04.rpy:9830
translate vietnamese story05_5_6_0b47e122:

    # k "We’ve got plenty of time."
    k "Chúng ta còn nhiều thời gian mà."

# game/Story04.rpy:9832
translate vietnamese story05_5_6_d799eefe:

    # Mi "Because of the ceremonial dance."
    Mi "Vì điệu nhảy nghi lễ."

# game/Story04.rpy:9833
translate vietnamese story05_5_6_9818d7d1:

    # Mi "Speaking of which… would you like to join?"
    Mi "Nhân tiện… anh có muốn tham gia không?"

# game/Story04.rpy:9835
translate vietnamese story05_5_6_732420f7:

    # k "I don’t really care either way. If the old man’s in, so am I."
    k "Tôi thì sao cũng được. Nếu ông già tham gia thì tôi cũng tham gia."

# game/Story04.rpy:9836
translate vietnamese story05_5_6_843215c2:

    # k "What do you say?"
    k "Anh nói sao?"

# game/Story04.rpy:9838
translate vietnamese story05_5_6_56c3991c:

    # mc "Why not?"
    mc "Sao lại không?"

# game/Story04.rpy:9840
translate vietnamese story05_5_6_8b18a527:

    # Mi "But… you’ll need to change your clothes."
    Mi "Nhưng… anh sẽ cần thay quần áo."

# game/Story04.rpy:9841
translate vietnamese story05_5_6_d1598945:

    # Mi "I understand you came here with good intentions, but to the others, you’re still outsiders."
    Mi "Tôi hiểu anh đến đây với thiện ý, nhưng với những người khác, các anh vẫn là người ngoài."

# game/Story04.rpy:9843
translate vietnamese story05_5_6_77777dba:

    # mc "Just clothes?"
    mc "Chỉ quần áo thôi à?"

# game/Story04.rpy:9844
translate vietnamese story05_5_6_0dff760d:

    # mc "Or anything else?"
    mc "Hay còn gì khác nữa?"

# game/Story04.rpy:9846
translate vietnamese story05_5_6_866f6a16:

    # Mi "Under no circumstances are you to draw your weapon."
    Mi "Trong bất kỳ hoàn cảnh nào anh cũng không được rút vũ khí."

# game/Story04.rpy:9847
translate vietnamese story05_5_6_ce373602:

    # Mi "No matter what happens… please don’t."
    Mi "Dù có chuyện gì xảy ra… xin đừng làm vậy."

# game/Story04.rpy:9848
translate vietnamese story05_5_6_2df38b83:

    # Mi "That’s my promise to the camp."
    Mi "Đó là lời hứa của tôi với trại."

# game/Story04.rpy:9850
translate vietnamese story05_5_6_2b35b6fe_2:

    # mc "..."
    mc "..."

# game/Story04.rpy:9851
translate vietnamese story05_5_6_cfe22840:

    # mc "Even if my life’s at risk?"
    mc "Dù mạng sống tôi gặp nguy hiểm ư?"

# game/Story04.rpy:9853
translate vietnamese story05_5_6_e48d80fb:

    # Mi "I’ll handle it."
    Mi "Tôi sẽ xử lý."

# game/Story04.rpy:9855
translate vietnamese story05_5_6_6651ab87_1:

    # mc "Alright."
    mc "Được thôi."

# game/Story04.rpy:9857
translate vietnamese story05_5_6_b8de4dad:

    # "([mc] steps away to change.)"
    "([mc] đi ra chỗ khác để thay đồ.)"

# game/Story04.rpy:9860
translate vietnamese story05_5_6_07e30edc:

    # k "Tell me, pointy-ears… what is really going on?"
    k "Nói tôi nghe đi, tai nhọn… chuyện gì thực sự đang xảy ra vậy?"

# game/Story04.rpy:9862
translate vietnamese story05_5_6_1df40c71:

    # Mi "I don’t see what you mean."
    Mi "Tôi không hiểu ý cô."

# game/Story04.rpy:9864
translate vietnamese story05_5_6_199a57cc:

    # k "You could’ve taken his weapon."
    k "Cô đã có thể lấy vũ khí của anh ta."

# game/Story04.rpy:9865
translate vietnamese story05_5_6_039ac7fe:

    # k "Why didn’t you?"
    k "Sao cô không làm vậy?"

# game/Story04.rpy:9866
translate vietnamese story05_5_6_da3fdbf1_4:

    # Mi "..."
    Mi "..."

# game/Story04.rpy:9868
translate vietnamese story05_5_6_2835b587:

    # k "Got me thinking."
    k "Làm tôi phải suy nghĩ đấy."

# game/Story04.rpy:9869
translate vietnamese story05_5_6_48ef58b4:

    # k "You sure you can protect us?"
    k "Cô chắc là mình bảo vệ được chúng tôi chứ?"

# game/Story04.rpy:9871
translate vietnamese story05_5_6_61458f41:

    # mc "We’re not children."
    mc "Chúng tôi không phải trẻ con."

# game/Story04.rpy:9872
translate vietnamese story05_5_6_16392823:

    # mc "We can handle ourselves."
    mc "Chúng tôi tự lo được cho mình."

# game/Story04.rpy:9876
translate vietnamese story05_5_6_850ef128:

    # b "..."
    b "..."

# game/Story04.rpy:9878
translate vietnamese story05_5_6_11455b53_1:

    # mc "What?"
    mc "Gì cơ?"

# game/Story04.rpy:9880
translate vietnamese story05_5_6_d1474e3e:

    # k "Pointy-ears… I’ll give you this, you’ve got great taste."
    k "Tai nhọn… tôi phải công nhận, cô có gu thẩm mỹ tuyệt lắm."

# game/Story04.rpy:9881
translate vietnamese story05_5_6_047e35a3:

    # Mi "Yes. Thank you."
    Mi "Vâng. Cảm ơn."

# game/Story04.rpy:9885
translate vietnamese story05_5_6_cadbfc1a:

    # "A moment later, they stepped out of the infirmary, making their way toward the center of the camp.."
    "Một lát sau, họ bước ra khỏi phòng bệnh và đi về phía trung tâm trại."

# game/Story04.rpy:9889
translate vietnamese story05_5_6_c1278d33:

    # k "Why the long face? We’re at a festival, at least pretend to smile."
    k "Sao mặt dài thế? Đang ở lễ hội mà, ít nhất cũng giả vờ cười đi."

# game/Story04.rpy:9891
translate vietnamese story05_5_6_e29810e6:

    # mc "I am happy."
    mc "Tôi đang vui mà."

# game/Story04.rpy:9893
translate vietnamese story05_5_6_6c3c49b9:

    # k "My ass you are."
    k "Vui cái con khỉ."

# game/Story04.rpy:9894
translate vietnamese story05_5_6_1af8690e:

    # k "Talk. What’s wrong? You were fine a minute ago."
    k "Nói đi. Có chuyện gì vậy? Một phút trước anh còn ổn cơ mà."

# game/Story04.rpy:9895
translate vietnamese story05_5_6_2b35b6fe_3:

    # mc "..."
    mc "..."

# game/Story04.rpy:9897
translate vietnamese story05_5_6_91e98007:

    # mc "The thought that I ran off and left them there…"
    mc "Ý nghĩ rằng tôi đã bỏ chạy và bỏ họ lại đó…"

# game/Story04.rpy:9898
translate vietnamese story05_5_6_7d8489e9:

    # mc "It won’t leave me alone."
    mc "Nó cứ ám ảnh tôi mãi."

# game/Story04.rpy:9899
translate vietnamese story05_5_6_bb7453a6:

    # mc "Feels… wrong."
    mc "Cảm thấy… thật sai trái."

# game/Story04.rpy:9901
translate vietnamese story05_5_6_80e357f5:

    # k "We’re all in the same boat."
    k "Tất cả chúng ta đều cùng chung một con thuyền."

# game/Story04.rpy:9902
translate vietnamese story05_5_6_cbd1e4e9:

    # k "Only difference, you don’t have a hole in your chest."
    k "Khác biệt duy nhất là anh không có một cái lỗ trên ngực."

# game/Story04.rpy:9905
translate vietnamese story05_5_6_b535bada:

    # k "You know… you should try it sometime. It really changes how you see things."
    k "Anh biết không… anh nên thử một lần xem. Nó thực sự thay đổi cách anh nhìn mọi thứ đấy."

# game/Story04.rpy:9907
translate vietnamese story05_5_6_7a83341a:

    # mc "Funny, coming from you."
    mc "Buồn cười thật, nghe từ miệng cô đấy."

# game/Story04.rpy:9909
translate vietnamese story05_5_6_cecfedf4:

    # k "I admit, you’re a bad influence."
    k "Tôi thừa nhận, anh ảnh hưởng xấu đến tôi."

# game/Story04.rpy:9910
translate vietnamese story05_5_6_0d8dd6d4:

    # k "Before, I’d charge straight into the slaughter without thinking."
    k "Trước đây, tôi cứ lao thẳng vào cuộc tàn sát mà chẳng suy nghĩ gì."

# game/Story04.rpy:9911
translate vietnamese story05_5_6_4333a3ed:

    # k "Now…"
    k "Giờ thì…"

# game/Story04.rpy:9912
translate vietnamese story05_5_6_70f6980c:

    # k "I still do, just with a thought."
    k "Tôi vẫn làm vậy, chỉ là có suy nghĩ trước thôi."

# game/Story04.rpy:9914
translate vietnamese story05_5_6_ae106357:

    # mc "Progress—"
    mc "Tiến bộ đấy—"

# game/Story04.rpy:9916
translate vietnamese story05_5_6_2f11cca2:

    # k "You okay?"
    k "Anh ổn chứ?"

# game/Story04.rpy:9923
translate vietnamese story05_5_6_6556f98b:

    # k "…Damn. She’s practically naked."
    k "…Chết tiệt. Cô ta gần như khỏa thân luôn."

# game/Story04.rpy:9928
translate vietnamese story05_5_6_50e9ed7a:

    # mc "Didn’t think that would surprise you."
    mc "Tôi không nghĩ chuyện đó lại làm cô ngạc nhiên đấy."

# game/Story04.rpy:9929
translate vietnamese story05_5_6_dde4a57c:

    # k "Old man, anyone would be surprised."
    k "Ông già à, ai mà chẳng ngạc nhiên."

# game/Story04.rpy:9930
translate vietnamese story05_5_6_731d2643:

    # k "You’ve seen how modest pointy-ears usually dresses."
    k "Ông đã thấy tai nhọn thường ăn mặc kín đáo thế nào rồi đấy."

# game/Story04.rpy:9931
translate vietnamese story05_5_6_3475db9b:

    # k "Now compare that to {b}this."
    k "Giờ hãy so sánh với {b}thứ này."

# game/Story04.rpy:9934
translate vietnamese story05_5_6_7008eaa4:

    # mc "Don’t forget, we’re still in the past."
    mc "Đừng quên, chúng ta vẫn đang ở quá khứ."

# game/Story04.rpy:9935
translate vietnamese story05_5_6_e72ecbea:

    # k "Which makes it even more interesting."
    k "Càng thế lại càng thú vị."

# game/Story04.rpy:9936
translate vietnamese story05_5_6_3cf640dc:

    # k "People don’t just flip their worldview like that."
    k "Người ta không tự dưng lật ngược cả thế giới quan như thế đâu."

# game/Story04.rpy:9939
translate vietnamese story05_5_6_6bef1101:

    # mc "Didn’t expect to see you like this…"
    mc "Không ngờ lại thấy cô như thế này…"

# game/Story04.rpy:9941
translate vietnamese story05_5_6_b19aaea8:

    # Mi "Is something wrong?"
    Mi "Có chuyện gì không ổn à?"

# game/Story04.rpy:9943
translate vietnamese story05_5_6_fc842b4e:

    # mc "You’re always so reserved… but right now there’s none of that left."
    mc "Cô lúc nào cũng kín đáo… nhưng giờ chẳng còn chút nào như vậy nữa."

# game/Story04.rpy:9945
translate vietnamese story05_5_6_7f2d3858:

    # Mi "I don’t understand."
    Mi "Tôi không hiểu."

# game/Story04.rpy:9947
translate vietnamese story05_5_6_c2e63e73:

    # k "Your outfit, pointy-ears. It barely covers anything."
    k "Bộ đồ của cô đấy, tai nhọn. Nó hầu như chẳng che được gì."

# game/Story04.rpy:9948
translate vietnamese story05_5_6_f456be65:

    # Mi "Does it?"
    Mi "Thật sao?"

# game/Story04.rpy:9949
translate vietnamese story05_5_6_babe1c96:

    # Mi "Everything essential is concealed."
    Mi "Mọi thứ cần thiết đều được che kín mà."

# game/Story04.rpy:9951
translate vietnamese story05_5_6_43b4df7b:

    # mc "If you’re comfortable, who are we to judge?"
    mc "Nếu cô thoải mái thì chúng tôi là ai mà phán xét chứ?"

# game/Story04.rpy:9952
translate vietnamese story05_5_6_a53fe81e:

    # mc "But… what is this?"
    mc "Nhưng… đây là cái gì vậy?"

# game/Story04.rpy:9953
translate vietnamese story05_5_6_f1af92db:

    # Mi "We only wear it on special occasions."
    Mi "Chúng tôi chỉ mặc nó vào những dịp đặc biệt thôi."

# game/Story04.rpy:9954
translate vietnamese story05_5_6_0fc246e8:

    # Mi "It’s a tradition passed down from ancient times."
    Mi "Đó là truyền thống được truyền lại từ thời cổ xưa."

# game/Story04.rpy:9960
translate vietnamese story05_5_6_4aa34161:

    # k "Sounds like your ancestors were just perverts."
    k "Nghe như tổ tiên của cô toàn là đồ biến thái ấy."

# game/Story04.rpy:9962
translate vietnamese story05_5_6_732c19c3:

    # Mi "People see what troubles their own hearts."
    Mi "Người ta nhìn thấy điều làm trái tim họ bận tâm."

# game/Story04.rpy:9963
translate vietnamese story05_5_6_293d740e:

    # Mi "They were pure of spirit."
    Mi "Họ thuần khiết về tâm hồn."

# game/Story04.rpy:9964
translate vietnamese story05_5_6_6fe4a46f:

    # Mi "Unlike you, pervert."
    Mi "Không như cô, đồ biến thái."

# game/Story04.rpy:9967
translate vietnamese story05_5_6_cf7897a9:

    # Mi "You are guests here. So as I respect your culture…"
    Mi "Các vị là khách ở đây. Vậy nên như tôi tôn trọng văn hóa của các vị…"

# game/Story04.rpy:9968
translate vietnamese story05_5_6_347572aa:

    # Mi "please respect mine."
    Mi "xin hãy tôn trọng văn hóa của tôi."

# game/Story04.rpy:9970
translate vietnamese story05_5_6_74a4ec79:

    # mc "(She’s right. Who am I to judge another culture?)"
    mc "(Cô ấy nói đúng. Tôi là ai mà phán xét văn hóa của người khác chứ?)"

# game/Story04.rpy:9971
translate vietnamese story05_5_6_0f247129:

    # mc "You’re right. That was tactless of us."
    mc "Cô nói đúng. Chúng tôi thật thiếu tế nhị."

# game/Story04.rpy:9973
translate vietnamese story05_5_6_55ac4c18_1:

    # Mi "I’m glad to hear that."
    Mi "Nghe vậy tôi mừng lắm."

# game/Story04.rpy:9974
translate vietnamese story05_5_6_4754f092:

    # Mi "Enjoy yourselves, I need to check on something."
    Mi "Chúc các vị vui vẻ, tôi cần đi kiểm tra một việc."

# game/Story04.rpy:9977
translate vietnamese story05_5_6_3c1b17a7:

    # k "(whispering) “Pervert”?"
    k "(thì thầm) “Đồ biến thái” ư?"

# game/Story04.rpy:9978
translate vietnamese story05_5_6_a6d10dc0:

    # k "(whispering) Hearing that from her… must’ve hit a nerve."
    k "(thì thầm) Nghe câu đó từ cô ta… chắc hẳn đã chạm đúng chỗ đau."

# game/Story04.rpy:9980
translate vietnamese story05_5_6_3b89b2a0:

    # mc "Next time, choose your words more carefully."
    mc "Lần sau, hãy chọn lời cẩn thận hơn."

# game/Story04.rpy:9981
translate vietnamese story05_5_6_b9ef785c:

    # mc "Last thing we need is to damage relations with her."
    mc "Điều cuối cùng chúng ta cần là làm tổn hại quan hệ với cô ấy."

# game/Story04.rpy:9982
translate vietnamese story05_5_6_176c1585:

    # mc "It wasn’t the outfit that surprised you."
    mc "Không phải bộ đồ làm cô ngạc nhiên đâu."

# game/Story04.rpy:9983
translate vietnamese story05_5_6_ae0ee8d6:

    # mc "It was how open she was."
    mc "Mà là sự cởi mở của cô ấy."

# game/Story04.rpy:9985
translate vietnamese story05_5_6_82091822_2:

    # k "..."
    k "..."

# game/Story04.rpy:9986
translate vietnamese story05_5_6_8a22ffaf:

    # k "I’m not promising anything."
    k "Tôi không hứa gì đâu."

# game/Story04.rpy:9988
translate vietnamese story05_5_6_209eed3d:

    # k "So, what now?"
    k "Vậy, giờ làm gì?"

# game/Story04.rpy:9989
translate vietnamese story05_5_6_f327d0d2:

    # k "I’m bored."
    k "Tôi chán rồi."

# game/Story04.rpy:9991
translate vietnamese story05_5_6_e9ddcfa8:

    # mc "Sounds like they’re having trouble."
    mc "Nghe như họ đang gặp rắc rối."

# game/Story04.rpy:9993
translate vietnamese story05_5_6_7cb88b91:

    # elf "Ú-istam si. Hi dîr tolatha erchir. Garo nin i FEB hi danna. \n(We don’t know, she should’ve arrived by now. We’re worried the FEB may have taken her.)"
    elf "Ú-istam si. Hi dîr tolatha erchir. Garo nin i FEB hi danna. \n(Chúng tôi không biết, lẽ ra cô ấy phải đến rồi. Chúng tôi lo FEB có thể đã bắt cô ấy đi.)"

# game/Story04.rpy:9994
translate vietnamese story05_5_6_fa7d22ed:

    # elf "Rau veleg danna o lû si… \n(They’ve been getting more aggressive lately…)"
    elf "Rau veleg danna o lû si… \n(Gần đây bọn chúng càng ngày càng hung hăng hơn…)"

# game/Story04.rpy:9996
translate vietnamese story05_5_6_bd1029ad:

    # Mi "An i sen angen nin i mereth hen veleg. \n(That’s exactly why we need this festival.)"
    Mi "An i sen angen nin i mereth hen veleg. \n(Chính vì vậy chúng ta mới cần lễ hội này.)"

# game/Story04.rpy:9997
translate vietnamese story05_5_6_1ad0bc4e:

    # Mi "Ae ú-badam hen… rand veleg danna na nin. \n(Without it… problems may arise.)"
    Mi "Ae ú-badam hen… rand veleg danna na nin. \n(Nếu không có nó… có thể sẽ nảy sinh rắc rối.)"

# game/Story04.rpy:9999
translate vietnamese story05_5_6_126d1caa:

    # elf "Mir, melin chen, ach… \n(Mir, I love you, but…)"
    elf "Mir, melin chen, ach… \n(Mir, tôi yêu anh, nhưng…)"

# game/Story04.rpy:10000
translate vietnamese story05_5_6_9787a67a:

    # elf "Ú-beria i narn oen nin an i lû hen. \n(Instruments alone won’t carry us.)"
    elf "Ú-beria i narn oen nin an i lû hen. \n(Chỉ nhạc cụ thôi sẽ không đủ sức gánh vác chúng ta đâu.)"

# game/Story04.rpy:10002
translate vietnamese story05_5_6_a15b8202:

    # Mi "Tegil nin beria hen oen. \n(Then we’ll have to.)"
    Mi "Tegil nin beria hen oen. \n(Vậy thì chúng ta sẽ phải làm được.)"

# game/Story04.rpy:10004
translate vietnamese story05_5_6_d840dc58:

    # elf "..."
    elf "..."

# game/Story04.rpy:10005
translate vietnamese story05_5_6_b78e0fb0:

    # elf "Nae… badam. \n(Alright.)"
    elf "Nae… badam. \n(Được thôi.)"

# game/Story04.rpy:10008
translate vietnamese story05_5_6_73d15fcd:

    # mc "Hey, is everything okay?"
    mc "Này, mọi chuyện ổn chứ?"

# game/Story04.rpy:10010
translate vietnamese story05_5_6_1e90b45f:

    # Mi "It’s fine. I’ll handle it."
