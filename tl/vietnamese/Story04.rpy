translate vietnamese story05_5_5_6b0e8b9e:

    # y "(whispering) Why didn’t it work…"
    y "(thì thầm) Sao nó lại không hoạt động…"

# game/Story04.rpy:8889
translate vietnamese story05_5_5_be9161c2:

    # mc "Can I ask you something?"
    mc "Tôi hỏi ông một chuyện được không?"

# game/Story04.rpy:8891
translate vietnamese story05_5_5_d912100d:

    # y "Go on."
    y "Cứ hỏi đi."

# game/Story04.rpy:8893
translate vietnamese story05_5_5_7aa6836c:

    # mc "What’s the point?"
    mc "Ý nghĩa là gì?"

# game/Story04.rpy:8897
translate vietnamese story05_5_5_f41269fd:

    # y "Look to your left."
    y "Nhìn sang bên trái cậu đi."

# game/Story04.rpy:8898
translate vietnamese story05_5_5_929fd42b:

    # y "What do you see?"
    y "Cậu thấy gì?"

# game/Story04.rpy:8902
translate vietnamese story05_5_5_7aad403a:

    # mc "What’s the trick?"
    mc "Có trò gì vậy?"

# game/Story04.rpy:8911
translate vietnamese story05_5_5_3efa6665:

    # y "How is she different from us?"
    y "Cô ấy khác chúng ta ở chỗ nào?"

# game/Story04.rpy:8913
translate vietnamese story05_5_5_3e2bc1d1:

    # y "She, and so many others, never had the chance to change their future."
    y "Cô ấy, và biết bao người khác, chưa bao giờ có cơ hội thay đổi tương lai của mình."

# game/Story04.rpy:8917
translate vietnamese story05_5_5_453e2cb0:

    # y "It all began the moment Eldrindor activated the Gate."
    y "Tất cả bắt đầu từ khoảnh khắc Eldrindor kích hoạt Cổng."

# game/Story04.rpy:8919
translate vietnamese story05_5_5_fd08e30b:

    # mc "Eldrindor?"
    mc "Eldrindor ư?"

# game/Story04.rpy:8921
translate vietnamese story05_5_5_66390db7:

    # y "The scientist every elf curses."
    y "Nhà khoa học mà mọi elf đều nguyền rủa."

# game/Story04.rpy:8923
translate vietnamese story05_5_5_84d67ffc:

    # mc "Gorem’s grandfather."
    mc "Ông nội của Gorem."

# game/Story04.rpy:8925
translate vietnamese story05_5_5_fff2d6da:

    # y "Yes."
    y "Phải."

# game/Story04.rpy:8926
translate vietnamese story05_5_5_3ae83abd:

    # y "He was the one who launched the Gate System."
    y "Chính ông ta là người đã khởi động Hệ thống Cổng."

# game/Story04.rpy:8928
translate vietnamese story05_5_5_5177038e:

    # mc "And half the galaxy vanished."
    mc "Và một nửa thiên hà đã biến mất."

# game/Story04.rpy:8929
translate vietnamese story05_5_5_31a38550:

    # mc "Gorem mentioned that."
    mc "Gorem đã nhắc tới chuyện đó."

# game/Story04.rpy:8940
translate vietnamese story05_5_5_9f47a418:

    # y "Good."
    y "Tốt."

# game/Story04.rpy:8941
translate vietnamese story05_5_5_86933dea:

    # y "Then answer me this."
    y "Vậy trả lời ta câu này."

# game/Story04.rpy:8942
translate vietnamese story05_5_5_7cef1169:

    # y "What did the System actually do?"
    y "Hệ thống đó thực sự đã làm gì?"

# game/Story04.rpy:8944
translate vietnamese story05_5_5_edc77061:

    # mc "They teleport."
    mc "Chúng dịch chuyển tức thời."

# game/Story04.rpy:8946
translate vietnamese story05_5_5_3fefb349:

    # y "Those are the Gates. I’m asking about the system that links them."
    y "Đó là các Cổng. Ta đang hỏi về hệ thống liên kết chúng."

# game/Story04.rpy:8948
translate vietnamese story05_5_5_4bbf92b2:

    # mc "It stopped time."
    mc "Nó đã dừng thời gian."

# game/Story04.rpy:8949
translate vietnamese story05_5_5_b6d2441b:

    # mc "For a few seconds."
    mc "Trong vài giây."

# game/Story04.rpy:8951
translate vietnamese story05_5_5_090b7094:

    # y "Half a second."
    y "Nửa giây."

# game/Story04.rpy:8952
translate vietnamese story05_5_5_aa3cf533:

    # y "At the cost of half a galaxy?"
    y "Với cái giá là nửa thiên hà ư?"

# game/Story04.rpy:8954
translate vietnamese story05_5_5_16c59d4c:

    # y "An absurd price…"
    y "Một cái giá phi lý…"

# game/Story04.rpy:8955
translate vietnamese story05_5_5_0f8bbbbb:

    # y "for half a second."
    y "cho nửa giây."

# game/Story04.rpy:8957
translate vietnamese story05_5_5_d4f78dbd:

    # mc "Paying in lives is absurd to begin with."
    mc "Trả giá bằng sinh mạng vốn đã phi lý rồi."

# game/Story04.rpy:8962
translate vietnamese story05_5_5_92539b77:

    # y "Perhaps."
    y "Có lẽ."

# game/Story04.rpy:8963
translate vietnamese story05_5_5_949cb4ce:

    # y "But the time freeze was only the visible consequence."
    y "Nhưng việc đóng băng thời gian chỉ là hậu quả nhìn thấy được."

# game/Story04.rpy:8964
translate vietnamese story05_5_5_9766d763:

    # y "The real function was something else."
    y "Chức năng thật sự lại là chuyện khác."

# game/Story04.rpy:8966
translate vietnamese story05_5_5_79ba89cc:

    # y "It created a cycle."
    y "Nó đã tạo ra một vòng lặp."

# game/Story04.rpy:8967
translate vietnamese story05_5_5_849e6cf4:

    # y "The Gate established a fixed point in the universe, a boundary we cannot cross."
    y "Cổng đã thiết lập một điểm cố định trong vũ trụ, một ranh giới mà chúng ta không thể vượt qua."

# game/Story04.rpy:8969
translate vietnamese story05_5_5_b6b1024b:

    # y "It stripped everyone of choice."
    y "Nó đã tước đi lựa chọn của mọi người."

# game/Story04.rpy:8970
translate vietnamese story05_5_5_ec943f5e:

    # y "Future. Past. Doesn’t matter."
    y "Tương lai. Quá khứ. Không quan trọng."

# game/Story04.rpy:8971
translate vietnamese story05_5_5_4a0b047d:

    # y "Everything begins at one point…"
    y "Mọi thứ bắt đầu tại một điểm…"

# game/Story04.rpy:8972
translate vietnamese story05_5_5_65e73399:

    # y "and ends the same way."
    y "và kết thúc cũng y như vậy."

# game/Story04.rpy:8974
translate vietnamese story05_5_5_ecf872dc:

    # mc "Wait."
    mc "Khoan."

# game/Story04.rpy:8975
translate vietnamese story05_5_5_1b41c7d4:

    # mc "You’re saying us being here… was planned?"
    mc "Ông đang nói việc chúng tôi ở đây… đã được sắp đặt sẵn ư?"

# game/Story04.rpy:8977
translate vietnamese story05_5_5_c17f6616:

    # y "That’s the difference."
    y "Đó chính là điểm khác biệt."

# game/Story04.rpy:8978
translate vietnamese story05_5_5_ea53f9a1:

    # y "We can’t break the principle."
    y "Chúng ta không thể phá vỡ nguyên tắc đó."

# game/Story04.rpy:8979
translate vietnamese story05_5_5_3b68130b:

    # y "But you can."
    y "Nhưng cậu thì có thể."

# game/Story04.rpy:8981
translate vietnamese story05_5_5_51c5f03b:

    # mc "Can I?"
    mc "Tôi ư?"

# game/Story04.rpy:8982
translate vietnamese story05_5_5_89fc4ac9:

    # mc "And what makes you so certain?"
    mc "Và điều gì khiến ông chắc chắn như vậy?"

# game/Story04.rpy:8984
translate vietnamese story05_5_5_f8dfc242:

    # y "Because you’re here."
    y "Vì cậu đang ở đây."

# game/Story04.rpy:8986
translate vietnamese story05_5_5_243907d7:

    # mc "What are you—"
    mc "Ông là—"

# game/Story04.rpy:8988
translate vietnamese story05_5_5_1652721c:

    # y "Astoria relives the loss of her sister."
    y "Astoria sống lại nỗi mất mát em gái mình."

# game/Story04.rpy:8989
translate vietnamese story05_5_5_8a928548:

    # y "Evreliya walks into the same tomb again and again."
    y "Evreliya bước vào cùng một ngôi mộ hết lần này tới lần khác."

# game/Story04.rpy:8990
translate vietnamese story05_5_5_a7f460fd:

    # y "Selvaria keeps killing her father."
    y "Selvaria cứ giết cha mình mãi."

# game/Story04.rpy:8991
translate vietnamese story05_5_5_2c016249:

    # y "And Lora…"
    y "Còn Lora…"

# game/Story04.rpy:8992
translate vietnamese story05_5_5_0ab28a11:

    # y "She keeps trying to keep you alive."
    y "Cô ấy cứ cố giữ cho cậu sống."

# game/Story04.rpy:8994
translate vietnamese story05_5_5_fb4d0fde:

    # mc "(So all my wife’s suffering was… for nothing?)"
    mc "(Vậy là mọi đau khổ của vợ tôi… đều vô ích ư?)"

# game/Story04.rpy:8996
translate vietnamese story05_5_5_91905ede:

    # mc "How?"
    mc "Bằng cách nào?"

# game/Story04.rpy:8998
translate vietnamese story05_5_5_1c881d34:

    # y "Motives change."
    y "Động cơ thay đổi."

# game/Story04.rpy:8999
translate vietnamese story05_5_5_6d385f12:

    # y "The outcome doesn’t."
    y "Kết quả thì không."

# game/Story04.rpy:9000
translate vietnamese story05_5_5_19a5e91a:

    # y "What’s needed is power from outside the cycle."
    y "Điều cần thiết là sức mạnh từ bên ngoài vòng lặp."

# game/Story04.rpy:9002
translate vietnamese story05_5_5_1f864a9b:

    # mc "So that’s why I matter."
    mc "Vậy nên đó là lý do tôi quan trọng."

# game/Story04.rpy:9003
translate vietnamese story05_5_5_d15d8c37:

    # mc "I can break the cycle."
    mc "Tôi có thể phá vỡ vòng lặp."

# game/Story04.rpy:9005
translate vietnamese story05_5_5_df7b27e3:

    # y "There were 378 attempts before you."
    y "Đã có 378 lần thử trước cậu."

# game/Story04.rpy:9006
translate vietnamese story05_5_5_8ed4a16c:

    # y "But somehow you’ve made it further than any of them."
    y "Nhưng bằng cách nào đó cậu đã đi xa hơn bất kỳ ai trong số họ."

# game/Story04.rpy:9008
translate vietnamese story05_5_5_659ad628:

    # mc "Three hundred seventy-eight…"
    mc "Ba trăm bảy mươi tám…"

# game/Story04.rpy:9010
translate vietnamese story05_5_5_66e59d65:

    # "A strained, humorless laugh."
    "Một tiếng cười gượng gạo, chẳng có chút hài hước nào."

# game/Story04.rpy:9011
translate vietnamese story05_5_5_eb31b531:

    # mc "That’s cruel."
    mc "Thật tàn nhẫn."

# game/Story04.rpy:9012
translate vietnamese story05_5_5_8348beeb:

    # mc "And how many of those were mine?"
    mc "Và trong số đó có bao nhiêu lần là của tôi?"

# game/Story04.rpy:9013
translate vietnamese story05_5_5_71a86863:

    # y "..."
    y "..."

# game/Story04.rpy:9014
translate vietnamese story05_5_5_a12237f7:

    # y "All of them."
    y "Tất cả."

# game/Story04.rpy:9018
translate vietnamese story05_5_5_cf8b5120:

    # mc "…again?"
    mc "…lại nữa ư?"

# game/Story04.rpy:9020
translate vietnamese story05_5_5_e1ef500b:

    # y "They were all you."
    y "Tất cả đều là cậu."

# game/Story04.rpy:9021
translate vietnamese story05_5_5_2c66875a:

    # y "Every single one."
    y "Từng lần một."

# game/Story04.rpy:9023
translate vietnamese story05_5_5_50e67c79:

    # mc "Cruel."
    mc "Tàn nhẫn."

# game/Story04.rpy:9024
translate vietnamese story05_5_5_b8c84b6d:

    # y "You think so?"
    y "Cậu nghĩ vậy sao?"

# game/Story04.rpy:9025
translate vietnamese story05_5_5_92de21c0:

    # y "Many of us would give anything for a fate like yours."
    y "Nhiều người trong chúng ta sẵn sàng đánh đổi bất cứ thứ gì để có một số phận như cậu."

# game/Story04.rpy:9026
translate vietnamese story05_5_5_c6b8f5e9:

    # y "To forget what we were."
    y "Để quên đi những gì chúng ta từng là."

# game/Story04.rpy:9028
translate vietnamese story05_5_5_8c943fbf:

    # mc "And Lora?"
    mc "Còn Lora?"

# game/Story04.rpy:9029
translate vietnamese story05_5_5_69774c55:

    # mc "She’s like me."
    mc "Cô ấy giống tôi."

# game/Story04.rpy:9030
translate vietnamese story05_5_5_728c8fd2:

    # mc "So why didn’t she—"
    mc "Vậy sao cô ấy không—"

# game/Story04.rpy:9032
translate vietnamese story05_5_5_c423975e:

    # y "Because of Evrelia."
    y "Vì Evrelia."

# game/Story04.rpy:9033
translate vietnamese story05_5_5_6f40e6d5:

    # y "And her power."
    y "Và sức mạnh của cô ấy."

# game/Story04.rpy:9034
translate vietnamese story05_5_5_51c99226:

    # mc "(whispering) I don’t understand…"
    mc "(thì thầm) Tôi không hiểu…"

# game/Story04.rpy:9036
translate vietnamese story05_5_5_16cd2d0a:

    # y "The Abyss is a consequence of the Gate."
    y "Vực thẳm là hậu quả của Cổng."

# game/Story04.rpy:9037
translate vietnamese story05_5_5_a75d85de:

    # y "Gain immortality there…"
    y "Đạt được bất tử ở đó…"

# game/Story04.rpy:9038
translate vietnamese story05_5_5_7487b0bd:

    # y "and you lose the ability to leave the cycle."
    y "và cậu sẽ mất khả năng rời khỏi vòng lặp."

# game/Story04.rpy:9039
translate vietnamese story05_5_5_0d5d6af6:

    # y "She’s no different from the rest of us."
    y "Cô ấy cũng chẳng khác gì những người còn lại trong chúng ta."

# game/Story04.rpy:9041
translate vietnamese story05_5_5_e1edc76e:

    # mc "Then I’ll ask two questions."
    mc "Vậy tôi sẽ hỏi hai câu."

# game/Story04.rpy:9042
translate vietnamese story05_5_5_f2c2c05b:

    # mc "First, what do you want from me?"
    mc "Thứ nhất, ông muốn gì ở tôi?"

# game/Story04.rpy:9043
translate vietnamese story05_5_5_6c9fbd01:

    # y "Break the cycle."
    y "Phá vỡ vòng lặp."

# game/Story04.rpy:9044
translate vietnamese story05_5_5_e0bbf01e:

    # mc "Second, what guarantees do I have?"
    mc "Thứ hai, tôi có được bảo đảm gì?"

# game/Story04.rpy:9055
translate vietnamese story05_5_5_d5371a83:

    # y "None."
    y "Không gì cả."

# game/Story04.rpy:9058
translate vietnamese story05_5_5_afb70b29:

    # mc "(So all her suffering…)"
    mc "(Vậy là mọi đau khổ của cô ấy…)"

# game/Story04.rpy:9059
translate vietnamese story05_5_5_fbf53025:

    # mc "(Every attempt to save me. To save Norman.)"
    mc "(Mọi lần cố cứu tôi. Cứu Norman.)"

# game/Story04.rpy:9060
translate vietnamese story05_5_5_fb8ff1c3:

    # mc "(Pointless?)"
    mc "(Vô nghĩa ư?)"

# game/Story04.rpy:9061
translate vietnamese story05_5_5_1a68efbd:

    # mc "(And Astoria’s attempts…)"
    mc "(Và những lần Astoria cố gắng…)"

# game/Story04.rpy:9063
translate vietnamese story05_5_5_71101df6:

    # mc "(whispering) Immortality?"
    mc "(thì thầm) Bất tử ư?"

# game/Story04.rpy:9064
translate vietnamese story05_5_5_ae631686:

    # mc "(whispering) Sounds more like eternal imprisonment."
    mc "(thì thầm) Nghe giống bị giam cầm vĩnh viễn hơn."

# game/Story04.rpy:9066
translate vietnamese story05_5_5_e7d887c0:

    # mc "How long has this been going on?"
    mc "Chuyện này đã diễn ra bao lâu rồi?"

# game/Story04.rpy:9074
translate vietnamese story05_5_5_71a86863_1:

    # y "..."
    y "..."

# game/Story04.rpy:9076
translate vietnamese story05_5_5_054c5ee0_1:

    # mc "I see."
    mc "Tôi hiểu rồi."

# game/Story04.rpy:9077
translate vietnamese story05_5_5_65dfe4e1:

    # mc "Then I refuse."
    mc "Vậy thì tôi từ chối."

# game/Story04.rpy:9085
translate vietnamese story05_5_5_7d541978:

    # y "Are you certain?"
    y "Cậu chắc chứ?"

# game/Story04.rpy:9086
translate vietnamese story05_5_5_17503904:

    # y "You don’t have a choice."
    y "Cậu không có lựa chọn đâu."

# game/Story04.rpy:9088
translate vietnamese story05_5_5_abe52859:

    # mc "If I’m destined to die either way, what’s the point?"
    mc "Nếu đằng nào tôi cũng phải chết, thì còn ý nghĩa gì?"

# game/Story04.rpy:9089
translate vietnamese story05_5_5_7844e0fd:

    # mc "You made me a hero."
    mc "Các người đã biến tôi thành anh hùng."

# game/Story04.rpy:9093
translate vietnamese story05_5_5_63df4058:

    # mc "Put a banner in my hands and told me to save the world."
    mc "Đặt một lá cờ vào tay tôi và bảo tôi cứu thế giới."

# game/Story04.rpy:9096
translate vietnamese story05_5_5_c8793936:

    # mc "Never once asking if I wanted the role."
    mc "Chưa một lần hỏi xem tôi có muốn vai trò đó không."

# game/Story04.rpy:9097
translate vietnamese story05_5_5_2440758b:

    # mc "That’s before we even talk about how you treated me."
    mc "Đó là còn chưa nói tới cách các người đã đối xử với tôi."

# game/Story04.rpy:9100
translate vietnamese story05_5_5_71a86863_2:

    # y "..."
    y "..."

# game/Story04.rpy:9102
translate vietnamese story05_5_5_99833fd8:

    # y "You’re a man of principles."
    y "Cậu là người có nguyên tắc."

# game/Story04.rpy:9103
translate vietnamese story05_5_5_36c5a29f:

    # y "Am I right?"
    y "Ta nói đúng chứ?"

# game/Story04.rpy:9105
translate vietnamese story05_5_5_3d8c1d5f:

    # mc "I like to think so."
    mc "Tôi thích nghĩ là vậy."

# game/Story04.rpy:9107
translate vietnamese story05_5_5_42d309e7:

    # y "I saved your life."
    y "Ta đã cứu mạng cậu."

# game/Story04.rpy:9108
translate vietnamese story05_5_5_874027a5:

    # y "Now it’s your turn to save mine."
    y "Giờ tới lượt cậu cứu mạng ta."

# game/Story04.rpy:9110
translate vietnamese story05_5_5_2b35b6fe_4:

    # mc "..."
    mc "..."

# game/Story04.rpy:9112
translate vietnamese story05_5_5_3b3938e0:

    # mc "(I don’t like this idea, but refusing won’t change anything.)"
    mc "(Tôi không thích ý tưởng này, nhưng từ chối cũng chẳng thay đổi được gì.)"

# game/Story04.rpy:9113
translate vietnamese story05_5_5_bec30771:

    # mc "(And he’s right… I’m alive because of him.)"
    mc "(Và ông ta nói đúng… Tôi còn sống là nhờ ông ta.)"

# game/Story04.rpy:9115
translate vietnamese story05_5_5_fcf9c325:

    # mc "Then I want your full support."
    mc "Vậy thì tôi muốn sự ủng hộ toàn diện của ông."

# game/Story04.rpy:9117
translate vietnamese story05_5_5_84ea3656:

    # mc "No games."
    mc "Không trò chơi nào."

# game/Story04.rpy:9118
translate vietnamese story05_5_5_896b381b:

    # mc "No schemes."
    mc "Không mưu đồ nào."

# game/Story04.rpy:9119
translate vietnamese story05_5_5_c06c46d8:

    # mc "A clear plan."
    mc "Một kế hoạch rõ ràng."

# game/Story04.rpy:9120
translate vietnamese story05_5_5_74647356:

