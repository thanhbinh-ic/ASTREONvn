    # k "Mhm..."
    k "Ừm..."

# game/Story04.rpy:9806
translate vietnamese story05_5_6_7881f9e6:

    # Mi "How is she?"
    Mi "Cô ấy sao rồi?"

# game/Story04.rpy:9807
translate vietnamese story05_5_6_014d4242:

    # mc "Better."
    mc "Khá hơn rồi."

# game/Story04.rpy:9809
translate vietnamese story05_5_6_55ac4c18:

    # Mi "I’m glad to hear that."
    Mi "Nghe vậy tôi mừng lắm."

# game/Story04.rpy:9811
translate vietnamese story05_5_6_9969bdbf:

    # mc "So… how are things here?"
    mc "Vậy… mọi chuyện ở đây thế nào?"

# game/Story04.rpy:9813
translate vietnamese story05_5_6_3dff179e:

    # Mi "The camp has mostly accepted your presence."
    Mi "Trại đa phần đã chấp nhận sự hiện diện của anh."

# game/Story04.rpy:9814
translate vietnamese story05_5_6_0e927f2b:

    # Mi "There were a few objections, but I handled them."
    Mi "Cũng có vài ý kiến phản đối, nhưng tôi đã xử lý rồi."

# game/Story04.rpy:9816
