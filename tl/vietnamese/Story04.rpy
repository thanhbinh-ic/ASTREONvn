translate vietnamese story05_5_4_87042096:

    # Go "Why is the blood of the Ancients required to activate a Gate?"
    Go "Tại sao máu của các Cổ nhân lại cần thiết để kích hoạt một Cánh cổng?"

# game/Story04.rpy:7753
translate vietnamese story05_5_4_81297b39:

    # mc "It’s the only viable energy source."
    mc "Đó là nguồn năng lượng khả thi duy nhất."

# game/Story04.rpy:7756
translate vietnamese story05_5_4_4388f0b9:

    # Go "Correct."
    Go "Chính xác."

# game/Story04.rpy:7757
translate vietnamese story05_5_4_0fdd036f:

    # Go "But why?"
    Go "Nhưng tại sao?"

# game/Story04.rpy:7759
translate vietnamese story05_5_4_d94b413c:

    # Go "Because it consumes life."
    Go "Vì nó tiêu thụ sinh mệnh."

# game/Story04.rpy:7760
translate vietnamese story05_5_4_5bebf0d5:

    # Go "To spare your own."
    Go "Để giữ lại sinh mệnh của chính mình."

