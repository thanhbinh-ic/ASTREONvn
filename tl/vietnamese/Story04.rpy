    # mc "(Liv...)"
    mc "(Liv...)"

# game/Story04.rpy:3961
translate vietnamese story05_6_a07063d3:

    # h "(Still… the closer we got, the more I realized, that wasn’t it.)"
    h "(Vậy mà… càng gần nhau hơn, tôi càng nhận ra, đó không phải là nó.)"

# game/Story04.rpy:3963
translate vietnamese story05_6_39f68757:

    # h "(whispering) Thank you, [mc]."
    h "(thì thầm) Cảm ơn anh, [mc]."

# game/Story04.rpy:3964
translate vietnamese story05_6_a67878c8:

    # h "(Yeah, yeah, I know how that probably sounds… but still.)"
    h "(Ừ, ừ, tôi biết nghe có vẻ thế nào… nhưng dù sao thì.)"

# game/Story04.rpy:3968
translate vietnamese story05_6_a6cb3b9e:

    # mc "And yet… here we are. Alone."
    mc "Vậy mà… chúng ta lại ở đây. Một mình."

# game/Story04.rpy:3969
translate vietnamese story05_6_2fded262:

    # h "..."
    h "..."

