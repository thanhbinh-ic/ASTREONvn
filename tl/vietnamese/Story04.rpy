translate vietnamese story05_5_6_2e1ea064:

    # mc "“You’re a coward,” they say."
    mc "“Đồ hèn nhát,” họ nói vậy."

# game/Story04.rpy:9734
translate vietnamese story05_5_6_7973272c:

    # mc "But there’s nothing wrong with valuing your life."
    mc "Nhưng trân trọng mạng sống của mình thì có gì sai đâu."

