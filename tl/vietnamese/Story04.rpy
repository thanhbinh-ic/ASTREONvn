translate vietnamese story05_4a7ab27a:

    # Fl "The Syndicate teams will evacuate survivors to the lower city."
    Fl "Các đội của Syndicate sẽ sơ tán người sống sót xuống thành phố dưới."

# game/Story04.rpy:46
translate vietnamese story05_3c1abf65:

    # Fl "My father’s special units will move into the gas chambers with cryo-units-"
    Fl "Các đơn vị đặc biệt của cha tôi sẽ tiến vào các buồng khí cùng với thiết bị đóng băng—"

# game/Story04.rpy:47
translate vietnamese story05_48b3c9fa:

    # Fl "to freeze the enemy all at once."
    Fl "để đóng băng toàn bộ kẻ địch cùng một lúc."

# game/Story04.rpy:48
translate vietnamese story05_8f5baec2:

