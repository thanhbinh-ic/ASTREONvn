    # mc "(So should I stop now? I’ll hurt them both if I don’t.)"
    mc "(Vậy mình có nên dừng lại ngay bây giờ không? Nếu không, mình sẽ làm tổn thương cả hai người.)"

# game/Story04.rpy:4087
translate vietnamese mcchoice1_6b6bd25e:

    # mc "(Yeah… I’m a real bastard.)"
    mc "(Ừ… mình đúng là một thằng khốn thật sự.)"

# game/Story04.rpy:4088
