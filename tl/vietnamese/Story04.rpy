    Go "(thì thầm) Một nửa thiên hà."

# game/Story04.rpy:7731
translate vietnamese story05_5_4_cb7eb722:

    # Go "(whispering) In a single heartbeat."
    Go "(thì thầm) Chỉ trong một nhịp tim."

# game/Story04.rpy:7733
translate vietnamese story05_5_4_1890a173:

    # mc "How…?"
    mc "Làm sao…?"

# game/Story04.rpy:7734
translate vietnamese story05_5_4_756bb34d:

    # keep3 "Payment."
    keep3 "Sự trả giá."

# game/Story04.rpy:7735
translate vietnamese story05_5_4_42b74561:

    # keep3 "For power."
    keep3 "Cho sức mạnh."

# game/Story04.rpy:7739
translate vietnamese story05_5_4_b57a10de:

    # keep3 "We didn’t realize…"
    keep3 "Chúng tôi đã không nhận ra…"

# game/Story04.rpy:7744
translate vietnamese story05_5_4_9eac7e46:

    # keep3 "The Gates were still tethered to the System."
    keep3 "Các Cánh cổng vẫn còn gắn liền với Hệ thống."

# game/Story04.rpy:7745
translate vietnamese story05_5_4_76588c2f:

    # keep3 "(That was our mistake.)"
    keep3 "(Đó là sai lầm của chúng tôi.)"

# game/Story04.rpy:7750
translate vietnamese story05_5_4_0094ddb6:

    # Go "Answer me this."
    Go "Trả lời tôi câu này."
