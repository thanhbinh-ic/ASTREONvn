    # h "I can’t stay on the sidelines anymore, pretending these feelings don’t exist."
    h "Em không thể đứng ngoài cuộc nữa, giả vờ như những cảm xúc này không tồn tại."

# game/Story04.rpy:4007
translate vietnamese story05_6_2b35b6fe_3:

    # mc "..."
    mc "..."

# game/Story04.rpy:4008
translate vietnamese story05_6_a6e978e2:

    # mc "(So… what do I do now?)"
    mc "(Vậy… giờ mình phải làm gì đây?)"

# game/Story04.rpy:4013
translate vietnamese mcchoice1_2b35b6fe:

    # mc "..."
    mc "..."

# game/Story04.rpy:4014
translate vietnamese mcchoice1_7eaa385d:

    # mc "(What am I supposed to do now?)"
    mc "(Giờ mình phải làm gì đây?)"

# game/Story04.rpy:4019
translate vietnamese mcchoice1_e5ddbbd4:

