translate vietnamese story05_5_6_02c4c5b6:

    # k "Easy for you to sa—"
    k "Nói thì dễ lắm—"

# game/Story04.rpy:9739
translate vietnamese story05_5_6_01028063:

    # k "Ah~~"
    k "Ah~~"

