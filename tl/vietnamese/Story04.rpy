    # h "(Hell… our training sessions became something sacred to me.)"
    h "(Chết tiệt… những buổi tập luyện của chúng ta đã trở thành thứ thiêng liêng đối với tôi.)"

# game/Story04.rpy:3944
translate vietnamese story05_6_2b35b6fe_2:

    # mc "..."
    mc "..."

