    # Mi "I… should go warn the others."
    Mi "Tôi… nên đi cảnh báo những người khác."

# game/Story04.rpy:9695
translate vietnamese story05_5_6_fd734325:

    # Mi "And see if I can find something for you."
    Mi "Và xem tôi có thể tìm được gì cho anh không."

# game/Story04.rpy:9696
