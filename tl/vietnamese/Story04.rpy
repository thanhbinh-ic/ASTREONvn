    # L "..."
    L "..."

# game/Story04.rpy:4873
translate vietnamese story05_8_eb60968a:

    # L "Not yet."
    L "Chưa đâu."

# game/Story04.rpy:4876
translate vietnamese story05_8_dd171ae6:

    # k "Feels like we do. There’s a Keeper’s corpse lying around. And not just one."
    k "Cảm giác như có rồi đấy. Có xác của một Keeper nằm quanh đây. Và không chỉ một."

# game/Story04.rpy:4877
translate vietnamese story05_8_eef53157:

    # L "There will be more if we don’t move."
    L "Sẽ còn nhiều hơn nếu chúng ta không di chuyển."

# game/Story04.rpy:4878
translate vietnamese story05_8_e26151fc:

    # k "Got a plan?"
    k "Có kế hoạch gì không?"

# game/Story04.rpy:4879
translate vietnamese story05_8_109280b3:

    # L "Yes."
    L "Có."

# game/Story04.rpy:4882
translate vietnamese story05_8_0f10bd2b:

    # Mi "(Pull yourself together, Miriel. Pull yourself together. The Teacher entrusted you with this. You have to see it through.)"
    Mi "(Lấy lại bình tĩnh đi, Miriel. Lấy lại bình tĩnh đi. Thầy đã giao phó chuyện này cho cậu. Cậu phải làm tới cùng.)"

# game/Story04.rpy:4883
translate vietnamese story05_8_bef89616:

    # Mi "I can’t… I—I…"
    Mi "Tôi không thể… T-Tôi…"

# game/Story04.rpy:4884
translate vietnamese story05_8_08716cfc:

    # Mi "(Push the emotions away. Push the memories-)"
    Mi "(Gạt cảm xúc sang một bên. Gạt ký ức—)"

# game/Story04.rpy:4887
translate vietnamese story05_8_52afec7d:

    # mc "We’re with you."
    mc "Chúng tôi ở bên cô."

# game/Story04.rpy:4888
translate vietnamese story05_8_da3fdbf1:

    # Mi "..."
    Mi "..."

# game/Story04.rpy:4889
translate vietnamese story05_8_efb57761:

    # Mi "(Yes… right. I’m not alone anymore. Not alone.)"
    Mi "(Phải… đúng rồi. Mình không còn một mình nữa. Không một mình.)"

# game/Story04.rpy:4892
translate vietnamese story05_8_81359aac:

    # Mi "[mc]… we have to leave. Before they arrive!"
    Mi "[mc]… chúng ta phải rời đi. Trước khi họ tới!"

# game/Story04.rpy:4893
translate vietnamese story05_8_59d4582c:

    # mc "(She’s shaking. Her voice is breaking. She’s on the verge of hysteria because of those people.)"
    mc "(Cô ấy đang run rẩy. Giọng cô ấy đang vỡ ra. Cô ấy đang ở bờ vực cuồng loạn vì những người đó.)"

# game/Story04.rpy:4895
translate vietnamese story05_8_d4a404e4:

    # Mi "I don’t want to feel that pain again… I don’t want to lose you too!"
    Mi "Tôi không muốn cảm nhận nỗi đau đó lần nữa… Tôi không muốn mất anh nữa!"

# game/Story04.rpy:4896
translate vietnamese story05_8_2b35b6fe_1:

    # mc "..."
    mc "..."

# game/Story04.rpy:4898
translate vietnamese story05_8_edf53eef:

    # Mi "I don’t want to… I don’t want to... I don’t want to…"
    Mi "Tôi không muốn… Tôi không muốn... Tôi không muốn…"

# game/Story04.rpy:4901
translate vietnamese story05_8_76f0aaba:

    # mc "Quiet, Miriel. We’re here."
    mc "Yên nào, Miriel. Chúng tôi ở đây rồi."

# game/Story04.rpy:4902
translate vietnamese story05_8_c447d351:

    # mc "(I’ve never seen her this scared.)"
    mc "(Tôi chưa bao giờ thấy cô ấy sợ hãi đến vậy.)"

# game/Story04.rpy:4904
translate vietnamese story05_8_a2ddf086:

    # L "Can I?"
    L "Tôi có thể không?"
# game/Story04.rpy:4905
translate vietnamese story05_8_2b35b6fe_2:

    # mc "..."
    mc "..."

# game/Story04.rpy:4906
translate vietnamese story05_8_f800bed0:

    # mc "Yes."
    mc "Vâng."

# game/Story04.rpy:4913
translate vietnamese story05_8_177d3eb2:

    # mc "What are you doing?"
    mc "Em đang làm gì vậy?"

# game/Story04.rpy:4915
translate vietnamese story05_8_ef2f2970:

    # L "Elven ears are their most intimate spot."
    L "Tai của người Elf là chỗ nhạy cảm nhất của họ."

# game/Story04.rpy:4916
translate vietnamese story05_8_5794ce61:

    # L "If you stroke them like this, they calm down."
    L "Nếu vuốt ve chúng như thế này, họ sẽ bình tĩnh lại."

# game/Story04.rpy:4917
translate vietnamese story05_8_4c36b43a:

    # L "What do you say, dear?"
    L "Anh thấy sao, anh yêu?"

# game/Story04.rpy:4919
translate vietnamese story05_8_bd2053d2:

    # Mi "Mmh..."
    Mi "Mmh..."

# game/Story04.rpy:4920
translate vietnamese story05_8_46f7213d:

    # Mi "P-please... just not in front of him... I-I’m embarrassed..."
    Mi "Làm ơn... chỉ là đừng trước mặt anh ấy... Em... em ngại lắm..."

# game/Story04.rpy:4921
translate vietnamese story05_8_6b40ba75:

    # L "You’re adorable."
    L "Em đáng yêu thật đấy."

# game/Story04.rpy:4922
translate vietnamese story05_8_23e22b23:

    # L "(whispering) So… did you like my husband?"
    L "(thì thầm) Vậy… em có thích chồng chị không?"

# game/Story04.rpy:4924
translate vietnamese story05_8_2ea6555e:

    # Mi "W-WHAT?! NO, I-!"
    Mi "C-CÁI GÌ?! KHÔNG, EM—!"

# game/Story04.rpy:4925
translate vietnamese story05_8_31bfb294:

    # L "In this state, she always reminds me of Mina."
    L "Ở trạng thái này, cô bé lúc nào cũng làm chị nhớ tới Mina."

# game/Story04.rpy:4926
translate vietnamese story05_8_ed03914a:

    # L "Makes me want to just squeeze those cheeks."
    L "Làm chị chỉ muốn bóp má cô bé thôi."

# game/Story04.rpy:4928
translate vietnamese story05_8_ef99283a:

    # mc "(That sadistic streak of hers... give her an inch and she bares her fangs.)"
    mc "(Đúng là máu thích hành hạ của cô ấy... cho một chút là lộ nanh ngay.)"

# game/Story04.rpy:4929
translate vietnamese story05_8_d85279a8:

    # mc "(Still, it worked. Miriel’s calmer.)"
    mc "(Nhưng mà, hiệu quả thật. Miriel đã bình tĩnh hơn.)"

# game/Story04.rpy:4931
translate vietnamese story05_8_9a0f7aba:

    # h "(whispering) The more I watch them, the more I realize..."
    h "(thì thầm) Càng nhìn họ, tôi càng nhận ra..."

# game/Story04.rpy:4932
translate vietnamese story05_8_c61a3039:

    # h "(whispering) You two are seriously creepy up close. Gives me chills."
    h "(thì thầm) Hai người nhìn gần đúng là rợn thật. Làm tôi lạnh cả sống lưng."

# game/Story04.rpy:4933
translate vietnamese story05_8_d67ffa4b:

    # h "(whispering) And these are the ones keeping balance in the galaxy? Yeah right, more like villains."
    h "(thì thầm) Mà đây lại là những kẻ giữ cân bằng cho thiên hà đấy à? Thôi đi, giống phản diện thì có."

# game/Story04.rpy:4939
translate vietnamese story05_8_efe3833f:

    # h "(No-)"
    h "(Không—)"

# game/Story04.rpy:4943
translate vietnamese story05_8_e641f310:

    # h "(No...)"
    h "(Không...)"

# game/Story04.rpy:4945
translate vietnamese story05_8_2fded262:

    # h "..."
    h "..."

# game/Story04.rpy:4946
translate vietnamese story05_8_3d69da2b:

    # h "(Fell...)"
    h "(Rơi...)"

# game/Story04.rpy:4947
translate vietnamese story05_8_c2565da4:

    # mc "Olivia?"
    mc "Olivia?"

# game/Story04.rpy:4950
translate vietnamese story05_8_d3db1433:

    # h "It wasn’t me!"
    h "Không phải em!"

# game/Story04.rpy:4959
translate vietnamese story05_8_2fecf3d4:

    # h "I think?"
    h "Em nghĩ vậy?"

# game/Story04.rpy:4961
translate vietnamese story05_8_10096254:

    # h "I mean, who would’ve thought one little poke would knock him out cold?"
    h "Ý em là, ai mà ngờ một cú chọc nhẹ lại đánh hắn bất tỉnh chứ?"

# game/Story04.rpy:4962
translate vietnamese story05_8_5287f3aa:

    # h "What are they made of, cardboard? Why are they so damn fragile?!"
    h "Bọn chúng làm bằng bìa cứng à? Sao lại mong manh chết tiệt thế?!"

# game/Story04.rpy:4964
translate vietnamese story05_8_390eaf1a:

    # mc "Olivia. Enough."
    mc "Olivia. Đủ rồi."

# game/Story04.rpy:4966
translate vietnamese story05_8_45fee4ae:

    # h "I- yeah. Sorry. That one’s on me."
    h "E-em... ừ. Xin lỗi. Lỗi này là của em."

# game/Story04.rpy:4969
translate vietnamese story05_8_c3237d01:

    # k "That hit sealed it, we need to move."
    k "Cú đánh đó đã chốt rồi, chúng ta phải di chuyển thôi."

# game/Story04.rpy:4970
translate vietnamese story05_8_c1bcff2e:

    # k "I’m afraid her little stunt aggroed pretty much everything with a pulse."
    k "Tôi e là trò nghịch nhỏ của cô ta đã chọc giận gần như mọi thứ còn thở."

# game/Story04.rpy:4971
translate vietnamese story05_8_570c24b2:

    # mc "Interesting. Where exactly are we supposed to go? We’re cornered. Lora, doors?"
    mc "Thú vị đấy. Rốt cuộc chúng ta phải đi đâu? Chúng ta bị dồn vào góc rồi. Lora, cửa thì sao?"

# game/Story04.rpy:4972
translate vietnamese story05_8_b2698d79:

    # L "Sealed shut. They won’t open."
    L "Bị niêm phong rồi. Chúng sẽ không mở đâu."

# game/Story04.rpy:4974
translate vietnamese story05_8_6d172e86:

    # h "Yo, [mc]? I think I found a way out."
    h "Này, [mc]? Em nghĩ em tìm thấy lối thoát rồi."

# game/Story04.rpy:4975
translate vietnamese story05_8_2048344f:

    # mc "Olivia, this is not the time for jokes."
    mc "Olivia, đây không phải lúc đùa đâu."

# game/Story04.rpy:4976
translate vietnamese story05_8_3675f07b:

    # h "No, seriously. I’m not joking. Look."
    h "Không, nghiêm túc đấy. Em không đùa đâu. Nhìn kìa."

# game/Story04.rpy:4978
translate vietnamese story05_8_2b35b6fe_3:

    # mc "..."
    mc "..."

# game/Story04.rpy:4979
translate vietnamese story05_8_e1cf355d:

    # mc "Any idea where it leads?"
    mc "Có ý tưởng gì nó dẫn tới đâu không?"

# game/Story04.rpy:4980
translate vietnamese story05_8_a8d7e199:

    # k "No clue. But I’m damn sure it doesn’t lead anywhere good."
    k "Không biết. Nhưng tôi dám chắc nó chẳng dẫn tới chỗ nào tốt đẹp đâu."

# game/Story04.rpy:4982
translate vietnamese story05_8_c7a98210:

    # h "For once, I agree with the gorilla. And I have zero desire to check what’s down there."
    h "Lần này thì em đồng ý với con khỉ đột. Và em chẳng có chút hứng thú nào kiểm tra xem dưới đó có gì."

# game/Story04.rpy:4984
translate vietnamese story05_8_cd099211:

    # mc "Olivia? Remember the promise?"
    mc "Olivia? Nhớ lời hứa chứ?"

# game/Story04.rpy:4986
translate vietnamese story05_8_992969d0:

    # h "{b}Giggle"
    h "{b}Cười khúc khích"

# game/Story04.rpy:4988
translate vietnamese story05_8_aa150cc4:

    # h "Nope. Not happening. I’m not crawling in there. No way in hell."
    h "Không. Không có chuyện đó đâu. Em không chui vào đó đâu. Đừng hòng."

# game/Story04.rpy:5017
translate vietnamese story05_9_8510cdca:

    # a "Move it, you worthless trash."
    a "Cút đi, đồ rác rưởi vô dụng."

# game/Story04.rpy:5019
translate vietnamese story05_9_ce129342:

    # R "H-how dare you talk to me li—"
    R "N-ngươi dám ăn nói với ta như—"

# game/Story04.rpy:5020
translate vietnamese story05_9_f03a6b69:

    # a "You humans deserve nothing better."
    a "Các ngươi, loài người, chẳng xứng đáng gì hơn thế."

# game/Story04.rpy:5022
translate vietnamese story05_9_29347032:

    # R "(So this is how you repay my work? Hypocrites!)"
    R "(Vậy đây là cách các ngươi đền đáp công việc của ta sao? Đồ đạo đức giả!)"

# game/Story04.rpy:5024
translate vietnamese story05_9_32199085:

    # am "You really couldn’t find someone… even remotely competent?"
    am "Các ngươi thật sự không tìm được ai… dù chỉ hơi có năng lực thôi sao?"

# game/Story04.rpy:5026
translate vietnamese story05_9_5ea99ac7:

    # sel "You do realize the Keepers have started hunting anyone tied to the tombs."
    sel "Cô có nhận ra là các Keeper đã bắt đầu săn lùng bất cứ ai liên quan tới các lăng mộ không."

# game/Story04.rpy:5027
translate vietnamese story05_9_d75bd3e3:

    # sel "Finding someone who won’t embarrass themselves is already an accomplishment."
    sel "Tìm được người không tự làm mình xấu hổ đã là một thành tựu rồi."
# game/Story04.rpy:5029
translate vietnamese story05_9_fd3c1758:

    # am "Could have brought your own scientists, you know."
    am "Cô cũng có thể tự mang các nhà khoa học của mình tới, cô biết đấy."

# game/Story04.rpy:5031
translate vietnamese story05_9_1ad5ec06:

    # sel "Unlike you, we consider our scientists a strategic resource."
    sel "Không như cô, chúng tôi coi các nhà khoa học là tài nguyên chiến lược."

# game/Story04.rpy:5032
translate vietnamese story05_9_58156ee7:

    # sel "And even if I agreed to this little ‘Abyss’ venture, I’m not throwing my own people into it."
    sel "Và dù tôi có đồng ý với chuyến phiêu lưu nhỏ vào ‘Vực Thẳm’ này, tôi cũng sẽ không ném người của mình vào đó."

# game/Story04.rpy:5035
translate vietnamese story05_9_13de5f3f:

    # a "My Queen, we’ve got a problem."
    a "Nữ hoàng của tôi, chúng ta gặp rắc rối rồi."

# game/Story04.rpy:5036
translate vietnamese story05_9_0a9e6245:

    # sel "What is it?"
    sel "Chuyện gì?"

# game/Story04.rpy:5039
translate vietnamese story05_9_33dda69c:

    # R "Then kill me already!"
    R "Vậy thì giết ta đi!"

# game/Story04.rpy:5040
translate vietnamese story05_9_1825690b:

    # aa "Stand down."
    aa "Lui xuống."

# game/Story04.rpy:5041
translate vietnamese story05_9_6a7c5523:

    # aa "What about the gate?"
    aa "Còn cổng thì sao?"

# game/Story04.rpy:5043
translate vietnamese story05_9_9478adc3:

    # R "There’s a problem, I can’t activate it."
    R "Có vấn đề, ta không thể kích hoạt nó."

# game/Story04.rpy:5044
translate vietnamese story05_9_842d3b3b:

    # sel "The reason? Not enough sacrifices?"
    sel "Lý do? Không đủ vật hiến tế?"

# game/Story04.rpy:5045
translate vietnamese story05_9_7434b249:

    # R "No, something’s jamming them… from the other side."
    R "Không, có thứ gì đó đang gây nhiễu chúng… từ phía bên kia."

# game/Story04.rpy:5047
translate vietnamese story05_9_14de9c4b:

    # sel "You didn’t invent that excuse… simply because you don’t know how to activate them, did you?"
    sel "Ngươi không bịa ra cái cớ đó… chỉ vì ngươi không biết cách kích hoạt chúng đấy chứ?"

# game/Story04.rpy:5049
translate vietnamese story05_9_a36b9fc6:

    # R "How dare you question my intellect!"
    R "Ngươi dám nghi ngờ trí tuệ của ta sao!"

# game/Story04.rpy:5050
translate vietnamese story05_9_2d83607a:

    # aa "Watch your tongue, boy."
    aa "Cẩn thận cái lưỡi của ngươi đấy, nhóc."

# game/Story04.rpy:5052
translate vietnamese story05_9_4a6cd9cb:

    # sel "You have exactly one hour to fix this."
    sel "Ngươi có đúng một giờ để sửa chuyện này."

# game/Story04.rpy:5053
translate vietnamese story05_9_aad3197d:

    # sel "If he fails, kill him."
    sel "Nếu hắn thất bại, giết hắn đi."

# game/Story04.rpy:5055
translate vietnamese story05_9_05418593:

    # R "How da—"
    R "Ngươi dám—"

# game/Story04.rpy:5056
translate vietnamese story05_9_562c2793:

    # a "Yes, Your Majesty."
    a "Vâng, Bệ hạ."

# game/Story04.rpy:5058
translate vietnamese story05_9_dd99f046:

    # am "The sacrifices were never part of our agreement."
    am "Vật hiến tế chưa bao giờ là một phần trong thỏa thuận của chúng ta."

# game/Story04.rpy:5059
translate vietnamese story05_9_ecb5b6d9:

    # sel "They became necessary when your clean solution stopped being sufficient."
    sel "Chúng trở nên cần thiết khi giải pháp sạch của cô không còn đủ nữa."

# game/Story04.rpy:5060
translate vietnamese story05_9_b7e71d62:

    # am "Necessary for your plan. Not mine."
    am "Cần thiết cho kế hoạch của cô. Không phải của tôi."

# game/Story04.rpy:5063
translate vietnamese story05_9_84c330cd:

    # sel "Tell me, Astoria… what’s worth more: a star you can lose for the sake of the world,"
    sel "Nói cho tôi nghe, Astoria… cái gì đáng giá hơn: một ngôi sao mà cô có thể đánh mất vì thế giới,"

# game/Story04.rpy:5064
translate vietnamese story05_9_f0786ce7:

    # sel "or a world where one star shines brighter than all the rest?"
    sel "hay một thế giới nơi một ngôi sao tỏa sáng rực rỡ hơn tất cả những ngôi sao còn lại?"

# game/Story04.rpy:5066
translate vietnamese story05_9_281e6bb9:

    # am "The star. Even a single one can set the darkness on fire."
    am "Ngôi sao. Dù chỉ một ngôi sao cũng có thể đốt cháy bóng tối."

# game/Story04.rpy:5067
translate vietnamese story05_9_a0dda036:

    # am "A world without light is nothing but emptiness."
    am "Một thế giới không có ánh sáng thì chẳng là gì ngoài khoảng trống."

# game/Story04.rpy:5068
translate vietnamese story05_9_45b2fa62:

    # am "Truth is born from sacrifice. Value comes from the one you’d give everything up for."
    am "Sự thật được sinh ra từ hy sinh. Giá trị đến từ người mà cô sẵn sàng từ bỏ mọi thứ vì họ."

# game/Story04.rpy:5070
translate vietnamese story05_9_532236ca:

    # sel "Or perhaps… the world matters more."
    sel "Hoặc có lẽ… thế giới mới quan trọng hơn."

# game/Story04.rpy:5071
translate vietnamese story05_9_a5e62fdd:

    # sel "If the star goes out, life changes, but the universe continues."
    sel "Nếu ngôi sao tắt, cuộc sống thay đổi, nhưng vũ trụ vẫn tiếp tục."

# game/Story04.rpy:5072
translate vietnamese story05_9_a0085e19:

    # sel "Value is measured by what preserves the system, not by a single life."
    sel "Giá trị được đo bằng thứ bảo toàn hệ thống, không phải bằng một mạng sống đơn lẻ."

# game/Story04.rpy:5074
translate vietnamese story05_9_6cf15b8e:

    # am "And what if the world itself is ready to abandon its star?"
    am "Và nếu chính thế giới sẵn sàng từ bỏ ngôi sao của mình thì sao?"

# game/Story04.rpy:5075
translate vietnamese story05_9_7b1af516:

    # am "Worth isn’t measured by what survives, it’s measured by who is willing to give themselves so something else can."
    am "Giá trị không được đo bằng thứ sống sót, mà bằng ai sẵn sàng hiến dâng bản thân để thứ khác có thể tồn tại."

# game/Story04.rpy:5077
translate vietnamese story05_9_87afc3ba:

    # sel "Then who is more important, the one others die for, or the one who can choose to sacrifice?"
    sel "Vậy thì ai quan trọng hơn, người mà người khác chết vì họ, hay người có thể chọn hy sinh?"

# game/Story04.rpy:5078
translate vietnamese story05_9_7731dd70:

    # sel "Truth lives in the choice: what you decide to protect… and what you’re willing to let go."
    sel "Sự thật nằm trong lựa chọn: cô quyết định bảo vệ cái gì… và cô sẵn sàng buông bỏ cái gì."

# game/Story04.rpy:5080
translate vietnamese story05_9_e50cd946:

    # am "The one people are willing to give everything for, that’s what matters."
    am "Người mà mọi người sẵn sàng cho đi tất cả vì họ, đó mới là điều quan trọng."

# game/Story04.rpy:5081
translate vietnamese story05_9_c8f42703:

    # am "Without them, sacrifice is nothing but strategy."
    am "Không có họ, hy sinh chẳng là gì ngoài chiến lược."

# game/Story04.rpy:5082
translate vietnamese story05_9_c20a51da:

    # am "Greatness is the person you’re willing to break your rules for… even if it destroys you."
    am "Vĩ đại là người mà cô sẵn sàng phá vỡ quy tắc vì họ… ngay cả khi điều đó hủy hoại cô."

# game/Story04.rpy:5084
translate vietnamese story05_9_1f75bb8c:

    # sel "And sometimes, the one who seems precious only tests who is truly willing to sacrifice."
    sel "Và đôi khi, người có vẻ quý giá chỉ thử xem ai thực sự sẵn sàng hy sinh."

# game/Story04.rpy:5085
translate vietnamese story05_9_6c9add1d:

    # sel "Worth exists in the eyes of the one who judges."
    sel "Giá trị tồn tại trong mắt người phán xét."

# game/Story04.rpy:5086
translate vietnamese story05_9_47cd6163:

    # sel "The truth of sacrifice is seeing the pain, and walking forward anyway."
    sel "Sự thật của hy sinh là nhìn thấy nỗi đau, và vẫn bước tiếp."

# game/Story04.rpy:5090
translate vietnamese story05_9_b97d5dfe:

    # am "The truth is simple: the one who makes the decision is stronger than the one who merely seems important."
    am "Sự thật rất đơn giản: người đưa ra quyết định mạnh mẽ hơn người chỉ có vẻ quan trọng."

# game/Story04.rpy:5091
translate vietnamese story05_9_281fdb12:

    # am "And sometimes sacrifice isn’t loss at all, it’s a test of whether you can live with what follows."
    am "Và đôi khi hy sinh không phải là mất mát, mà là thử thách xem cô có thể sống với những gì xảy ra sau đó hay không."

# game/Story04.rpy:5093
translate vietnamese story05_9_2e2902de:

    # am "(But the real power lies in the one who can do the impossible… for the person they cannot afford to lose.)"
    am "(Nhưng sức mạnh thật sự nằm ở người có thể làm điều không thể… vì người mà họ không thể để mất.)"

# game/Story04.rpy:5097
translate vietnamese story05_9_a31353a7:

    # am "(Sometimes the ‘rational’ choice is just a mask… hiding what has already begun inside.)"
    am "(Đôi khi lựa chọn ‘hợp lý’ chỉ là một chiếc mặt nạ… che giấu thứ đã bắt đầu bên trong.)"

# game/Story04.rpy:5101
translate vietnamese story05_9_2707a773:

    # am "(I’ve already stepped onto this path.)"
    am "(Tôi đã bước lên con đường này rồi.)"

# game/Story04.rpy:5105
translate vietnamese story05_9_b43326bb:

    # am "(No one will notice… not until it ends.)"
    am "(Sẽ không ai để ý… cho đến khi mọi chuyện kết thúc.)"

# game/Story04.rpy:5109
translate vietnamese story05_9_6a8c1ca9:

    # am "(If my principles brought me to this ending…)"
    am "(Nếu nguyên tắc của tôi đã đưa tôi tới kết cục này…)"

# game/Story04.rpy:5115
translate vietnamese story05_9_7e719909:

    # am "(What were they ever worth?)"
    am "(Vậy chúng từng có giá trị gì?)"

# game/Story04.rpy:5120
translate vietnamese story05_9_05779cd7:

    # am "(If a flower is meant to begin a new life…)"
    am "(Nếu một bông hoa được định sẵn để bắt đầu một cuộc sống mới…)"

# game/Story04.rpy:5126
translate vietnamese story05_9_770176d2:

    # am "(Then I will become the soil for it.)"
    am "(Vậy thì tôi sẽ trở thành đất cho nó.)"

# game/Story04.rpy:5145
translate vietnamese story05_9_96972950:

    # C "(A customer? At this hour?)"
    C "(Một vị khách? Vào giờ này sao?)"
# game/Story04.rpy:5147
translate vietnamese story05_9_4987d20d:

    # CC "*whistles* Now that’s a big fish."
    CC "*huýt sáo* Đúng là một con cá lớn thật."

# game/Story04.rpy:5148
translate vietnamese story05_9_9ec2ae39:

    # CC "(whispering) What’s a lady like that doing in a bar this dead?"
    CC "(thì thầm) Một quý cô như thế làm gì trong một quán bar vắng tanh thế này?"

# game/Story04.rpy:5150
translate vietnamese story05_9_1deed48e:

    # CC "What can I do for you?"
    CC "Tôi có thể giúp gì cho cô?"

# game/Story04.rpy:5152
translate vietnamese story05_9_4e260567:

    # Evrel "..."
    Evrel "..."

# game/Story04.rpy:5153
translate vietnamese story05_9_88f47ad4:

    # Evrel "I’m looking for a girl..."
    Evrel "Tôi đang tìm một cô gái..."

# game/Story04.rpy:5154
translate vietnamese story05_9_915e367e:

    # Evrel "Named Lora."
    Evrel "Tên là Lora."

# game/Story04.rpy:5177
translate vietnamese story05_5_1_9902a657:

    # "A ventilation shaft stood just a few steps from the gate."
    "Một ống thông gió nằm cách cổng chỉ vài bước chân."

# game/Story04.rpy:5182
translate vietnamese story05_5_1_e4054e3a:

    # mc "Status?"
    mc "Tình hình?"

# game/Story04.rpy:5183
translate vietnamese story05_5_1_b292e793:

    # k "You can come down."
    k "Các cậu có thể xuống được rồi."

# game/Story04.rpy:5192
translate vietnamese story05_5_1_62e6bb7d:

    # mc "So this is our bypass route?"
    mc "Vậy đây là tuyến đường vòng của chúng ta à?"

# game/Story04.rpy:5193
translate vietnamese story05_5_1_21c6e533:

    # mc "Smells off…"
    mc "Mùi khó chịu thật…"

# game/Story04.rpy:5195
translate vietnamese story05_5_1_c32219e9:

    # k "Ventilation’s dead. Where exactly would clean air come from?"
    k "Hệ thống thông gió đã chết. Không khí sạch thì lấy đâu ra chứ?"

# game/Story04.rpy:5196
translate vietnamese story05_5_1_84266e33:

    # k "Not that there was any left topside either."
    k "Mà trên mặt đất cũng chẳng còn chút nào đâu."

# game/Story04.rpy:5198
translate vietnamese story05_5_1_ab3df8fc:

    # mc "You sure this route is safe?"
    mc "Cô chắc tuyến này an toàn chứ?"

# game/Story04.rpy:5201
translate vietnamese story05_5_1_902f6130:

    # k "Safe? Pfft."
    k "An toàn á? Hừ."

# game/Story04.rpy:5202
translate vietnamese story05_5_1_6b5b501d:

    # k "As long as it’s not a dead end, good enough."
    k "Miễn không phải ngõ cụt là đủ tốt rồi."

# game/Story04.rpy:5203
translate vietnamese story05_5_1_61dbac4d:

    # h "Yo! How’s it looking? We coming down?"
    h "Này! Tình hình sao rồi? Bọn em xuống được chưa?"

# game/Story04.rpy:5207
translate vietnamese story05_5_1_64a8ca27:

    # k "Don’t overthink it. Might be a lousy option, but hey-"
    k "Đừng suy nghĩ nhiều quá. Có thể là lựa chọn tệ, nhưng mà—"

# game/Story04.rpy:5208
translate vietnamese story05_5_1_393d210a:

    # k "sharing the fate of the guys upstairs isn’t on my to-do list."
    k "chung số phận với đám trên kia không nằm trong danh sách việc cần làm của tôi."

# game/Story04.rpy:5211
translate vietnamese story05_5_1_551b8412:

    # mc "Same here."
    mc "Tôi cũng vậy."

# game/Story04.rpy:5214
translate vietnamese story05_5_1_acd6e0e6:

    # mc "Come down!"
    mc "Xuống đi!"

# game/Story04.rpy:5221
translate vietnamese story05_5_1_2fded262:

    # h "..."
    h "..."

# game/Story04.rpy:5223
translate vietnamese story05_5_1_5f6f84be:

    # h "Put me down."
    h "Thả em xuống."

# game/Story04.rpy:5225
translate vietnamese story05_5_1_5d6f637b:

    # mc "On the bright side, you finally got some height."
    mc "Mặt tích cực là, cuối cùng em cũng có chút chiều cao rồi."

# game/Story04.rpy:5227
translate vietnamese story05_5_1_1343054b:

    # h "On the dark side, I might die of embarrassment."
    h "Mặt tiêu cực là, em có thể chết vì xấu hổ mất."

# game/Story04.rpy:5229
translate vietnamese story05_5_1_e8fbef1e:

    # mc "Pick your poison."
    mc "Tùy em chọn."

# game/Story04.rpy:5232
translate vietnamese story05_5_1_56c76061:

    # h "Oh, shut up."
    h "Ôi, im đi."

# game/Story04.rpy:5236
translate vietnamese story05_5_1_b63bac94:

    # h "(whispering) Look… I do value what we’ve got. Really."
    h "(thì thầm) Nghe này… em thực sự trân trọng những gì chúng ta có. Thật đấy."

# game/Story04.rpy:5237
translate vietnamese story05_5_1_eeeb75ba:

    # h "(whispering) But maybe don’t do that while the gorilla’s watching, yeah?"
    h "(thì thầm) Nhưng có lẽ đừng làm thế trong khi con khỉ đột đang nhìn, nhé?"

# game/Story04.rpy:5239
translate vietnamese story05_5_1_6fb1465c:

    # mc "Noted."
    mc "Ghi nhận."

# game/Story04.rpy:5242
translate vietnamese story05_5_1_682e89fa:

    # mc "Next!"
    mc "Người tiếp theo!"

# game/Story04.rpy:5245
translate vietnamese story05_5_1_833f4414:

    # Mi "Thank you… but I can manage."
    Mi "Cảm ơn… nhưng em tự lo được."

# game/Story04.rpy:5247
translate vietnamese story05_5_1_30f41abf:

    # h "Oh! That reminds me-"
    h "Ồ! Nhắc mới nhớ—"

# game/Story04.rpy:5248
translate vietnamese story05_5_1_12e82dff:

    # h "The Soulless… they’re basically humans in mutant bodies, right?"
    h "Những kẻ Vô Hồn… về cơ bản là con người trong thân xác đột biến, phải không?"

# game/Story04.rpy:5250
translate vietnamese story05_5_1_694a4fa2:

    # k "Where are you going with this?"
    k "Cô định đi tới đâu với chuyện này?"

# game/Story04.rpy:5251
translate vietnamese story05_5_1_92a52439:

    # h "How… do they spread?"
    h "Chúng… lây lan như thế nào?"

# game/Story04.rpy:5255
translate vietnamese story05_5_1_1ba69910:

    # mc "That’s—"
    mc "Đó là—"

# game/Story04.rpy:5257
translate vietnamese story05_5_1_80ef4c61:

    # L "Through the air."
    L "Qua không khí."

# game/Story04.rpy:5258
translate vietnamese story05_5_1_5b98c85d:

    # L "(whispering) Thank you, dear."
    L "(thì thầm) Cảm ơn anh, anh yêu."

# game/Story04.rpy:5260
translate vietnamese story05_5_1_53dda515:

    # h "Wait wait, what do you mean {b}through the air{/b}?!"
    h "Khoan khoan, ý cô là {b}qua không khí{/b} là sao?!"

# game/Story04.rpy:5261
translate vietnamese story05_5_1_f79bb8fc:

    # h "There are mutants everywhere outside, how are we still alive?!"
    h "Ngoài kia đầy rẫy đột biến, sao chúng ta vẫn còn sống?!"

# game/Story04.rpy:5263
translate vietnamese story05_5_1_de9595e8:

    # k "Hey. Old man."
    k "Này. Ông già."

# game/Story04.rpy:5264
translate vietnamese story05_5_1_ab635f33:

    # k "You planning on putting her down anytime soon?"
    k "Ông định thả cô ta xuống sớm không?"

# game/Story04.rpy:5266
translate vietnamese story05_5_1_1cb78db2:

    # h "Funny."
    h "Buồn cười nhỉ."

# game/Story04.rpy:5267
translate vietnamese story05_5_1_27d7f257:

    # h "Didn’t look like you had a problem getting close earlier."
    h "Trông chẳng giống ông có vấn đề gì khi lại gần lúc nãy."

# game/Story04.rpy:5269
translate vietnamese story05_5_1_afd941c6:

    # k "That was necessary."
    k "Đó là cần thiết."

# game/Story04.rpy:5270
translate vietnamese story05_5_1_f7d953ec:

    # k "You want him stable, or sentimental?"
    k "Cô muốn hắn ổn định, hay đa cảm?"

# game/Story04.rpy:5272
translate vietnamese story05_5_1_b043f8ef:

    # mc "Enough. Not here."
    mc "Đủ rồi. Không phải ở đây."

# game/Story04.rpy:5273
translate vietnamese story05_5_1_9cf63763:

    # mc "We’re talking about the air."
    mc "Chúng ta đang nói về không khí."

# game/Story04.rpy:5275
translate vietnamese story05_5_1_09d19a7d:

    # L "Airborne, yes."
    L "Lây qua không khí, đúng vậy."
# game/Story04.rpy:5276
translate vietnamese story05_5_1_3fcae73d:

    # L "But it depends on the concentration."
    L "Nhưng còn tùy vào nồng độ."

# game/Story04.rpy:5282
translate vietnamese story05_5_1_1ba69910_1:

    # mc "That’s—"
    mc "Đó là—"

# game/Story04.rpy:5285
translate vietnamese story05_5_1_80ef4c61_1:

    # L "Through the air."
    L "Qua không khí."

# game/Story04.rpy:5287
translate vietnamese story05_5_1_53dda515_1:

    # h "Wait wait, what do you mean {b}through the air{/b}?!"
    h "Khoan khoan, ý cô là {b}qua không khí{/b} là sao?!"

# game/Story04.rpy:5288
translate vietnamese story05_5_1_f79bb8fc_1:

    # h "There are mutants everywhere outside, how are we still alive?!"
    h "Ngoài kia đầy rẫy đột biến, sao chúng ta vẫn còn sống?!"

# game/Story04.rpy:5290
translate vietnamese story05_5_1_09d19a7d_1:

    # L "Airborne, yes."
    L "Lây qua không khí, đúng vậy."

# game/Story04.rpy:5291
translate vietnamese story05_5_1_3fcae73d_1:

    # L "But it depends on the concentration."
    L "Nhưng còn tùy vào nồng độ."

# game/Story04.rpy:5301
translate vietnamese story05_5_1_d14216c9:

    # h "Oh."
    h "Ồ."

# game/Story04.rpy:5302
translate vietnamese story05_5_1_b197b574:

    # h "So the miasma’s already down here."
    h "Vậy là miasma đã xuống tới đây rồi."

# game/Story04.rpy:5303
translate vietnamese story05_5_1_1452f338:

    # L "Miasma isn’t a cloud."
    L "Miasma không phải là một đám mây."

# game/Story04.rpy:5304
translate vietnamese story05_5_1_052ba4ff:

    # L "It’s what leaks from unstable Gates."
    L "Nó là thứ rò rỉ ra từ các Cổng không ổn định."

# game/Story04.rpy:5305
translate vietnamese story05_5_1_a687bc06:

    # L "It poisons places first. Then bodies."
    L "Nó đầu độc nơi chốn trước. Rồi tới thân xác."

# game/Story04.rpy:5308
translate vietnamese story05_5_1_26457832:

    # mc "Why the sudden question?"
    mc "Sao đột nhiên lại hỏi vậy?"

# game/Story04.rpy:5312
translate vietnamese story05_5_1_da4058bd:

    # h "Lower City run."
    h "Chuyến đi Hạ Thành."

# game/Story04.rpy:5313
translate vietnamese story05_5_1_a0096862:

    # h "Same smell there as here."
    h "Ở đó cũng có mùi giống như ở đây."

# game/Story04.rpy:5315
translate vietnamese story05_5_1_ac096bbf:

    # h "And those massive ventilation shafts… like someone was deliberately spreading it—"
    h "Và những ống thông gió khổng lồ đó… cứ như có ai đó cố tình phát tán nó—"

# game/Story04.rpy:5317
translate vietnamese story05_5_1_9da91900:

    # h "(coughs)"
    h "(ho)"

# game/Story04.rpy:5320
translate vietnamese story05_5_1_1f0f2838:

    # L "Breathe…"
    L "Thở đi…"

# game/Story04.rpy:5321
translate vietnamese story05_5_1_ff79c8ca:

    # L "I thought it was strange too, but—"
    L "Tôi cũng thấy lạ, nhưng—"

# game/Story04.rpy:5323
translate vietnamese story05_5_1_95042f17:

    # mc "Lora. A word."
    mc "Lora. Nói chuyện riêng một lát."

# game/Story04.rpy:5324
translate vietnamese story05_5_1_da5a1401:

    # L "Of course, dear."
    L "Tất nhiên rồi, anh yêu."

# game/Story04.rpy:5325
translate vietnamese story05_5_1_e6050af1:

    # L "You feeling better?"
    L "Em thấy đỡ hơn chưa?"

# game/Story04.rpy:5327
translate vietnamese story05_5_1_fc809da6:

    # h "Y-yeah… thanks."
    h "V-vâng… cảm ơn."

# game/Story04.rpy:5330
translate vietnamese story05_5_1_a2f4c5ce:

    # mc "That device."
    mc "Thiết bị đó."

# game/Story04.rpy:5331
translate vietnamese story05_5_1_49791b99:

    # mc "Why did you give it to me?"
    mc "Sao em lại đưa nó cho anh?"

# game/Story04.rpy:5334
translate vietnamese story05_5_1_a7a878b9:

    # L "The Blood of the Ancients…"
    L "Máu của Cổ nhân…"

# game/Story04.rpy:5335
translate vietnamese story05_5_1_52fb14ca:

    # L "That’s what they call the charge inside the device."
    L "Đó là cách họ gọi năng lượng bên trong thiết bị."

# game/Story04.rpy:5336
translate vietnamese story05_5_1_6f9cea84:

    # L "It and the miasma come from the same living source."
    L "Nó và miasma đều đến từ cùng một nguồn sống."

# game/Story04.rpy:5337
translate vietnamese story05_5_1_61b9ed66:

    # L "Contained, it can power a Gate."
    L "Khi được chứa đựng, nó có thể cấp năng lượng cho một Cổng."

# game/Story04.rpy:5338
translate vietnamese story05_5_1_7e603981:

    # L "Released, it spreads through living tissue and takes control."
    L "Khi được giải phóng, nó lan qua mô sống và chiếm quyền kiểm soát."

# game/Story04.rpy:5339
translate vietnamese story05_5_1_5a736d53:

    # mc "Fuel and infection."
    mc "Nhiên liệu và lây nhiễm."

# game/Story04.rpy:5340
translate vietnamese story05_5_1_47edc985:

    # L "The same source. A different state."
    L "Cùng một nguồn. Trạng thái khác nhau."

# game/Story04.rpy:5341
translate vietnamese story05_5_1_c0613909:

    # L "Please, don’t be angry. I’ll explain."
    L "Làm ơn, đừng giận. Em sẽ giải thích."

# game/Story04.rpy:5344
translate vietnamese story05_5_1_2b35b6fe:

    # mc "..."
    mc "..."

# game/Story04.rpy:5347
