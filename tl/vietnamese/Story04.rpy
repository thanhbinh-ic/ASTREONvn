    k "Hứa đi."

# game/Story04.rpy:4840
translate vietnamese story05_8_2b35b6fe:

    # mc "..."
    mc "..."

# game/Story04.rpy:4841
translate vietnamese story05_8_6651ab87:

    # mc "Alright."
    mc "Được rồi."

# game/Story04.rpy:4843
