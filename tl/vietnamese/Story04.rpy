# game/Story04.rpy:4844
translate vietnamese story05_8_fcdbdfee:

    # mc "(We came this far, only to realize this journey might be our last.)"
    mc "(Chúng ta đã đi xa tới vậy, chỉ để nhận ra chuyến đi này có thể là cuối cùng.)"

# game/Story04.rpy:4846
translate vietnamese story05_8_d0e1886d:

    # mc "(No. No matter the cost, we survive. We have to.)"
    mc "(Không. Dù phải trả giá nào, chúng ta cũng sống sót. Chúng ta phải sống sót.)"

