    Mi "(Họ làm gì ở đây thế?! Mình phải cảnh báo thầy mình...)"

# game/Story04.rpy:4865
translate vietnamese story05_8_e43f6daa:

    # L "What happened to you?!"
    L "Chuyện gì đã xảy ra với cô thế?!"

