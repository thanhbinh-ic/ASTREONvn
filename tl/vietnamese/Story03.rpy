translate vietnamese akt3chapter2_2_42ba5ce1:

    # mc "Of course. Trouble shows up, and there you are. With fanfare, obviously."
    mc "Đương nhiên rồi. Rắc rối vừa xuất hiện, cô đã ở đó. Dĩ nhiên là phải ầm ĩ một phen."

# game/Story03.rpy:2746
translate vietnamese akt3chapter2_2_210c06eb_1:

    # a "Yes."
    a "Đúng vậy."

