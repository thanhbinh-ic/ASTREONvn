# game/Story03.rpy:5570
translate vietnamese akt3chapter5_1_5449345d:

    # mc "(And that’s exactly why people fear you.)"
    mc "(Và đó chính là lý do người ta sợ cô.)"

# game/Story03.rpy:5571
translate vietnamese akt3chapter5_1_2b35b6fe_1:

    # mc "..."
    mc "..."

# game/Story03.rpy:5573
