translate vietnamese ivy_meetings_4898c539:

    # mc "Then take it, Ivy. It’s yours."
    mc "Vậy thì lấy đi, Ivy. Nó là của em."

# game/Story03.rpy:10251
translate vietnamese ivy_meetings_9c4f06ca:

    # i "Yes… yes… just like that…! Ahh—"
