    mc "(Aha. Tuyệt vời. Một bức tường im lặng.)"

# game/Story03.rpy:6877
translate vietnamese act3_5chapter1_1_dd0860a7:

    # mc "Well, Kalestra? Always clever. Maybe for once, be useful?"
    mc "Này, Kalestra? Lúc nào cũng thông minh. Có lẽ lần này, hãy tỏ ra hữu ích đi?"

# game/Story03.rpy:6878
translate vietnamese act3_5chapter1_1_bf4d335d:

    # k "Not the slightest clue."
    k "Chẳng có manh mối nào cả."

# game/Story03.rpy:6881
translate vietnamese act3_5chapter1_1_cc6c9da1:

    # k "(But if you don’t stick to me, you’ll be nothing but stains on the floor.)"
    k "(Nhưng nếu cậu không bám sát tôi, cậu sẽ chỉ còn là vết bẩn trên sàn nhà thôi.)"

# game/Story03.rpy:6883
translate vietnamese act3_5chapter1_1_9ad54191:

    # mc "Ah, your living shield? Great prospect."
    mc "À, tấm khiên sống của cô sao? Triển vọng tuyệt vời đấy."

# game/Story03.rpy:6885
translate vietnamese act3_5chapter1_1_3386e15d:

    # k "Better a shield than a corpse. Stay close, or start digging your grave."
    k "Thà làm khiên còn hơn làm xác chết. Ở sát tôi, hoặc bắt đầu đào mộ của cậu đi."

# game/Story03.rpy:6886
translate vietnamese act3_5chapter1_1_2b35b6fe_1:

    # mc "..."
    mc "..."

# game/Story03.rpy:6887
translate vietnamese act3_5chapter1_1_b0068f89:

    # mc "(I’ve… never seen her like that.)"
    mc "(Tôi… chưa bao giờ thấy cô ấy như thế.)"

# game/Story03.rpy:6890
translate vietnamese act3_5chapter1_1_0d345e03:

    # k "And you really shouldn’t have."
    k "Và cậu thật sự không nên thấy."

# game/Story03.rpy:6903
translate vietnamese act3_5chapter1_1_bf2aef3b:

    # mc "You give terrible directions..."
    mc "Cô chỉ đường tệ thật đấy..."

# game/Story03.rpy:6904
translate vietnamese act3_5chapter1_1_db0bfed6:

    # k "And you follow them anyway."
    k "Và cậu vẫn cứ đi theo chúng."

# game/Story03.rpy:6906
translate vietnamese act3_5chapter1_1_56cefe88:

    # k "Follow me, unless you’re tired of breathing."
    k "Đi theo tôi, trừ khi cậu chán thở rồi."

# game/Story03.rpy:6909
translate vietnamese act3_5chapter1_1_47442c15:

    # gggg "What?! She just did that?!"
    gggg "Cái gì?! Cô ta vừa làm vậy sao?!"

# game/Story03.rpy:6910
translate vietnamese act3_5chapter1_1_a18ec3af:

    # gg "Yeah, after her! Stick to her!"
    gg "Ừ, đuổi theo cô ta! Bám sát cô ta!"

# game/Story03.rpy:6923
translate vietnamese act3_5chapter2_9dcb3407:

    # gg "Come on, quick. Move in!"
    gg "Nhanh lên, mau vào trong!"

# game/Story03.rpy:6929
translate vietnamese act3_5chapter2_2b35b6fe:

    # mc "..."
    mc "..."

# game/Story03.rpy:6930
translate vietnamese act3_5chapter2_f9b263fd:

    # mc "(Quiet. Just the hum of the generators. Strange… but right now it almost feels calming.)"
    mc "(Yên tĩnh. Chỉ có tiếng vo vo của máy phát điện. Lạ thật… nhưng lúc này nó gần như mang lại cảm giác bình yên.)"

# game/Story03.rpy:6936
translate vietnamese act3_5chapter2_3b69dd5f:

    # mc "(The road’s only starting, and they already look worn out. Like ghosts.)"
    mc "(Con đường mới chỉ bắt đầu, mà họ đã trông kiệt sức rồi. Như những bóng ma.)"

# game/Story03.rpy:6938
translate vietnamese act3_5chapter2_3f537c6a:

    # mc "(And me? Back in the mess again. Playing the hero. Figures.)"
    mc "(Còn tôi? Lại quay về mớ hỗn độn. Đóng vai anh hùng. Đúng là vậy mà.)"

# game/Story03.rpy:6946
translate vietnamese act3_5chapter2_82091822:

    # k "..."
    k "..."

# game/Story03.rpy:6948
translate vietnamese act3_5chapter2_2b35b6fe_1:

    # mc "..."
    mc "..."

# game/Story03.rpy:6950
translate vietnamese act3_5chapter2_b60a13ec:

    # mc "You’re usually the loud one. What’s with the silence?"
    mc "Cô thường là người ồn ào nhất. Sao lại im lặng thế?"

# game/Story03.rpy:6953
translate vietnamese act3_5chapter2_df11187d:

    # k "Bored. Put on a show for me."
    k "Chán quá. Diễn một màn cho tôi xem đi."

# game/Story03.rpy:6955
translate vietnamese act3_5chapter2_2b35b6fe_2:

    # mc "..."
    mc "..."

# game/Story03.rpy:6958
translate vietnamese act3_5chapter2_b45dbbf4:

    # mc "Bored? After all that? We’re lucky we’re still breathing."
    mc "Chán sao? Sau tất cả những chuyện đó? Chúng ta may mắn vì vẫn còn thở đấy."

# game/Story03.rpy:6968
translate vietnamese act3_5chapter2_fce91983:

    # k "Fear and sacrifice are so predictable. No theatrics — no worth. This whole thing tastes like wet ash."
    k "Nỗi sợ và sự hy sinh thật dễ đoán. Không có kịch tính — không có giá trị. Toàn bộ chuyện này có vị như tro ướt."

# game/Story03.rpy:6970
translate vietnamese act3_5chapter2_1648d5a4:

    # mc "(Crazy. Definitely.)"
    mc "(Điên rồi. Chắc chắn vậy.)"

# game/Story03.rpy:6972
translate vietnamese act3_5chapter2_8ca36d9e:

    # k "Don't call me crazy right away. Just… different."
    k "Đừng vội gọi tôi là điên. Chỉ là… khác biệt thôi."

# game/Story03.rpy:6974
translate vietnamese act3_5chapter2_6d26a197:

    # mc "Fine. Different. Be that way."
    mc "Thôi được. Khác biệt. Cứ như vậy đi."

# game/Story03.rpy:6979
translate vietnamese act3_5chapter2_82091822_1:

    # k "..."
    k "..."

# game/Story03.rpy:6981
translate vietnamese act3_5chapter2_e3e600ac:

    # k "(whisper) Boredom is the last thing in me that still counts as human."
    k "(thì thầm) Chán nản là thứ cuối cùng trong tôi vẫn còn tính là con người."

# game/Story03.rpy:6983
translate vietnamese act3_5chapter2_0c328ca6:

    # mc "What? Did you say something?"
    mc "Cái gì? Cô vừa nói gì sao?"

# game/Story03.rpy:6985
translate vietnamese act3_5chapter2_82091822_2:

    # k "..."
    k "..."

# game/Story03.rpy:6989
translate vietnamese act3_5chapter2_cbdba510:

    # k "I said: I’m bored! {w=1.0}Say something already — entertain me."
    k "Tôi nói: Tôi chán! {w=1.0}Nói gì đi — mua vui cho tôi đi."

# game/Story03.rpy:6991
translate vietnamese act3_5chapter2_2b35b6fe_3:

    # mc "..."
    mc "..."

# game/Story03.rpy:6995
translate vietnamese act3_5chapter2_0d46d1f5:

    # mc "Alright then. You want words, I’ll keep them simple."
    mc "Được rồi. Cô muốn lời nói, tôi sẽ giữ chúng đơn giản."

# game/Story03.rpy:6996
translate vietnamese act3_5chapter2_68f7bd7a:

    # mc "So? What do you want to hear?"
    mc "Vậy? Cô muốn nghe gì?"

# game/Story03.rpy:6999
translate vietnamese act3_5chapter2_581e9bbe:

    # k "The whole world’s a stage, and we’re all actors. Deep thoughts in your head, aren't they?"
    k "Cả thế giới là một sân khấu, và tất cả chúng ta đều là diễn viên. Những suy nghĩ sâu sắc trong đầu cậu, phải không?"

# game/Story03.rpy:7001
translate vietnamese act3_5chapter2_7ad5f242:

    # mc "First, stop crawling into my head. Second, that's just a quote."
    mc "Thứ nhất, đừng chui vào đầu tôi nữa. Thứ hai, đó chỉ là một câu trích dẫn thôi."

# game/Story03.rpy:7003
translate vietnamese act3_5chapter2_748df167:

    # k "Is it? Then tell me — what do you think of actresses?"
    k "Thật sao? Vậy nói tôi nghe — cậu nghĩ gì về các nữ diễn viên?"

# game/Story03.rpy:7005
translate vietnamese act3_5chapter2_8fcfabf2:

    # mc "You can read my mind can't you?"
    mc "Cô có thể đọc suy nghĩ của tôi, phải không?"

# game/Story03.rpy:7008
translate vietnamese act3_5chapter2_6223efba:

    # k "I want to hear it, not steal it from your skull. A live voice is so much more fun."
    k "Tôi muốn nghe nó, chứ không phải đánh cắp nó từ trong sọ cậu. Một giọng nói sống động vui hơn nhiều."

# game/Story03.rpy:7012
translate vietnamese act3_5chapter2_d6314bd9:

    # mc "Actresses? They play their part, crowd claps, curtain falls. That’s it."
    mc "Nữ diễn viên sao? Họ diễn vai của mình, khán giả vỗ tay, màn hạ xuống. Chỉ vậy thôi."

# game/Story03.rpy:7014
translate vietnamese act3_5chapter2_db6ccace:

    # mc "What else is there to understand?"
    mc "Còn gì nữa để hiểu chứ?"

# game/Story03.rpy:7016
translate vietnamese act3_5chapter2_82091822_3:

    # k "..."
    k "..."

# game/Story03.rpy:7018
translate vietnamese act3_5chapter2_bee86476:

    # mc "But you asked for a reason. Why? What’s on your mind?"
    mc "Nhưng cô hỏi vì một lý do. Tại sao? Cô đang nghĩ gì vậy?"

# game/Story03.rpy:7019
translate vietnamese act3_5chapter2_963ac8d7:

    # k "Not curious?"
    k "Không tò mò sao?"

# game/Story03.rpy:7022
translate vietnamese act3_5chapter2_45bb1b77:

    # k "They’re true artists. Life’s the stage, and their paints are pain and suffering."
    k "Họ là nghệ sĩ đích thực. Cuộc sống là sân khấu, và màu vẽ của họ là nỗi đau và sự khổ sở."

# game/Story03.rpy:7026
translate vietnamese act3_5chapter2_db037c4d:

    # k "Every stroke, every ounce of misery becomes… beautiful."
    k "Mỗi nét vẽ, mỗi chút khốn khổ đều trở nên… đẹp đẽ."

# game/Story03.rpy:7030
translate vietnamese act3_5chapter2_497ceee9:

    # mc "You see beauty where most don’t. Strange taste, but… fine. I’ll take your word for it."
    mc "Cô thấy vẻ đẹp ở nơi hầu hết mọi người không thấy. Gu kỳ lạ, nhưng… thôi được. Tôi tin lời cô."

# game/Story03.rpy:7032
translate vietnamese act3_5chapter2_82091822_4:

    # k "..."
    k "..."

# game/Story03.rpy:7034
translate vietnamese act3_5chapter2_92413685:

    # mc "How long are we stuck in this can?"
    mc "Chúng ta còn kẹt trong cái hộp này bao lâu nữa?"

# game/Story03.rpy:7036
translate vietnamese act3_5chapter2_bd97dd6c:

    # gg "Another ten minutes."
    gg "Mười phút nữa."

# game/Story03.rpy:7043
translate vietnamese act3_5chapter2_00ebe152:

    # mc "Ten minutes. Long enough to think too much. Any ideas, what was that?"
    mc "Mười phút. Đủ lâu để suy nghĩ quá nhiều. Có ý tưởng gì không, thứ đó là gì?"

# game/Story03.rpy:7045
translate vietnamese act3_5chapter2_a5a8d775:

    # gg "There are a couple of theories, but none really explain what's happening."
    gg "Có vài giả thuyết, nhưng không giả thuyết nào thật sự giải thích được chuyện đang xảy ra."

# game/Story03.rpy:7047
translate vietnamese act3_5chapter2_6b4e4f1d:

    # mc "Not much. I was hoping for at least a hint."
    mc "Không nhiều lắm. Tôi đã hy vọng ít nhất có một manh mối."

# game/Story03.rpy:7049
translate vietnamese act3_5chapter2_15f75b71:

    # gg "By appearance — a Faceless, but with an abnormal ability. Either a mutation, or something new."
    gg "Nhìn bề ngoài — một Kẻ Vô Diện, nhưng với khả năng bất thường. Hoặc là đột biến, hoặc là thứ gì đó mới."

# game/Story03.rpy:7052
translate vietnamese act3_5chapter2_900695d0:

    # gggg "I've never had the honor of being a test rat before."
    gggg "Tôi chưa bao giờ có vinh dự làm chuột bạch trước đây."

# game/Story03.rpy:7054
translate vietnamese act3_5chapter2_b6d3481c:

    # mc "(That thing came for us. Something doesn’t add up…)"
    mc "(Thứ đó tới vì chúng ta. Có gì đó không khớp…)"

# game/Story03.rpy:7056
translate vietnamese act3_5chapter2_48fa1c88:

    # mc "What was the plan before all this fell apart?"
    mc "Kế hoạch trước khi tất cả chuyện này đổ vỡ là gì?"

# game/Story03.rpy:7058
translate vietnamese act3_5chapter2_c13ba05b:

    # gg "Originally, we were evacuating your civilians. But later the order was revoked, and we were told to return."
    gg "Ban đầu, chúng tôi đang sơ tán dân thường của cậu. Nhưng sau đó mệnh lệnh bị thu hồi, và chúng tôi được bảo quay trở lại."

# game/Story03.rpy:7059
translate vietnamese act3_5chapter2_fea73b5d:

    # gg "With no explanation."
    gg "Không có lời giải thích nào cả."

# game/Story03.rpy:7062
translate vietnamese act3_5chapter2_9d9d6f45:

    # g "You received that; The rest have different orders. They'll head to assist the peacekeepers"
    g "Cậu nhận được lệnh đó; những người còn lại có mệnh lệnh khác. Họ sẽ tới hỗ trợ lực lượng giữ gìn hòa bình"

# game/Story03.rpy:7063
translate vietnamese act3_5chapter2_26258c3b:

    # g "Back where you came from."
    g "Quay về nơi cậu tới."

# game/Story03.rpy:7065
translate vietnamese act3_5chapter2_6bd24c89:

    # gggg "All of this looks like madness. As if command itself has no clue what's going on."
    gggg "Tất cả chuyện này trông như điên rồ. Như thể chính bộ chỉ huy cũng không biết chuyện gì đang xảy ra."

# game/Story03.rpy:7069
translate vietnamese act3_5chapter2_2e81bcd4:

    # gg "For now, we need to come back alive. We'll deal with the rest later."
    gg "Trước mắt, chúng ta cần trở về còn sống. Những chuyện còn lại để sau hãy tính."

# game/Story03.rpy:7071
translate vietnamese act3_5chapter2_dc12a94c:

    # gggg "That's for sure, and with hope and faith it's easier to walk toward a goal. Right, commander?"
    gggg "Chắc chắn rồi, và với hy vọng và niềm tin thì đi về phía mục tiêu sẽ dễ dàng hơn. Phải không, chỉ huy?"

# game/Story03.rpy:7078
translate vietnamese act3_5chapter2_c5af235e:

    # mc "(Summing up...)"
    mc "(Tóm tắt lại...)"

# game/Story03.rpy:7079
translate vietnamese act3_5chapter2_d0964bc0:

    # mc "(Maiden is silent, Kalestra... as always. Little is known about the mutant, the orders from above are strange.)"
    mc "(Maiden im lặng, Kalestra... như mọi khi. Biết rất ít về tên đột biến, mệnh lệnh từ trên xuống thì kỳ lạ.)"

# game/Story03.rpy:7080
translate vietnamese act3_5chapter2_c3cb703f:

    # mc "(The situation is unstable. We need to stick together to survive.)"
    mc "(Tình hình không ổn định. Chúng ta cần ở sát nhau để sống sót.)"

# game/Story03.rpy:7081
translate vietnamese act3_5chapter2_f9f4b5c6:

    # mc "(Indeed, we can't do without faith and hope.)"
    mc "(Quả thật, chúng ta không thể thiếu niềm tin và hy vọng.)"

# game/Story03.rpy:7084
translate vietnamese act3_5chapter2_93457446:

    # L "If you're reading — it means you're alive. Which means — hold on. Just survive. No heroics. Just… survive."
    L "Nếu anh đang đọc — nghĩa là anh còn sống. Nghĩa là — cố gắng lên. Chỉ cần sống sót. Đừng làm anh hùng. Chỉ cần… sống sót."

# game/Story03.rpy:7086
translate vietnamese act3_5chapter2_2b35b6fe_4:

    # mc "..."
    mc "..."

# game/Story03.rpy:7089
translate vietnamese act3_5chapter2_00b5f77c:

    # mc "Right, for their sake."
    mc "Đúng vậy, vì họ."

# game/Story03.rpy:7090
translate vietnamese act3_5chapter2_fcfb7c20:

    # mc "I have to survive, whatever it costs."
    mc "Tôi phải sống sót, bất kể phải trả giá nào."

# game/Story03.rpy:7097
translate vietnamese act3_5chapter2_a68496df:

    # mc "Nothing to say?"
    mc "Không có gì để nói sao?"

# game/Story03.rpy:7099
translate vietnamese act3_5chapter2_bb8e4b4e:

    # a "..."
    a "..."

# game/Story03.rpy:7102
translate vietnamese act3_5chapter2_a69f6d14:

    # mc "Understood. So be it."
    mc "Hiểu rồi. Cứ vậy đi."

# game/Story03.rpy:7105
translate vietnamese act3_5chapter2_aaa27d53:

    # mc "Since we're supposed to work as a team — maybe introduce ourselves?"
    mc "Vì chúng ta được cho là làm việc theo nhóm — có lẽ giới thiệu bản thân đi?"

# game/Story03.rpy:7106
translate vietnamese act3_5chapter2_a7b35a62:

    # mc "Your names."
    mc "Tên của các bạn."

# game/Story03.rpy:7109
translate vietnamese act3_5chapter2_f9acd091:

    # gg "My name is Nyx."
    gg "Tên tôi là Nyx."

# game/Story03.rpy:7112
translate vietnamese act3_5chapter2_b76bb8ca:

    # gg "This big guy is Echo."
    gg "Gã to con này là Echo."

# game/Story03.rpy:7113
translate vietnamese act3_5chapter2_d6dbc95f:

    # gggg "Ha-ha... It's odd to hear my name outside the kitchen. Nice to meet you."
    gggg "Ha-ha... Nghe tên mình ngoài bếp thật kỳ lạ. Rất vui được gặp cậu."

# game/Story03.rpy:7115
translate vietnamese act3_5chapter2_a28e71ff:

    # gg "The one who was rude to you — Brain."
    gg "Người đã thô lỗ với cậu — Brain."

# game/Story03.rpy:7116
translate vietnamese act3_5chapter2_d053a68f:

    # g "Hmph. They don't need to know the delivery guy's name."
    g "Hmph. Họ không cần biết tên của tay giao hàng đâu."

# game/Story03.rpy:7119
translate vietnamese act3_5chapter2_d286d82d:

    # gg "This is Leo, our tech specialist and pyro."
    gg "Đây là Leo, chuyên gia kỹ thuật và chất nổ của chúng tôi."

# game/Story03.rpy:7120
translate vietnamese act3_5chapter2_a3d5572e:

    # gggg "Need something fixed, stolen, or just implants checked? I'm at your service."
    gggg "Cần sửa thứ gì, trộm thứ gì, hay chỉ kiểm tra cấy ghép? Tôi luôn sẵn sàng phục vụ."

# game/Story03.rpy:7122
translate vietnamese act3_5chapter2_9a99737b:

    # gg "The others, right to left: Nemo, Hedy, Sike, and Ava."
    gg "Những người còn lại, từ phải sang trái: Nemo, Hedy, Sike, và Ava."

# game/Story03.rpy:7125
translate vietnamese act3_5chapter2_0ae2de7b:

    # mc "My name is [mc]."
    mc "Tên tôi là [mc]."

# game/Story03.rpy:7128
translate vietnamese act3_5chapter2_f0d1c72b:

    # mc "And hers..."
    mc "Còn cô ấy..."

# game/Story03.rpy:7131
translate vietnamese act3_5chapter2_7e1d8063:

    # k "Kalestra. One and only. I'm here only because of him… and with him — because of boredom."
    k "Kalestra. Có một không hai. Tôi ở đây chỉ vì hắn… và ở cùng hắn — vì chán nản."

# game/Story03.rpy:7135
translate vietnamese act3_5chapter2_4f5437dd:

    # mc "And the second..."
    mc "Và người thứ hai..."

# game/Story03.rpy:7137
translate vietnamese act3_5chapter2_bb8e4b4e_1:

    # a "..."
    a "..."

# game/Story03.rpy:7139
translate vietnamese act3_5chapter2_c469651c:

    # mc "Got it. Stubborn."
    mc "Hiểu rồi. Bướng bỉnh."

# game/Story03.rpy:7141
translate vietnamese act3_5chapter2_2b35b6fe_5:

    # mc "..."
    mc "..."

# game/Story03.rpy:7143
translate vietnamese act3_5chapter2_82091822_5:

    # k "..."
    k "..."

# game/Story03.rpy:7145
translate vietnamese act3_5chapter2_93334484:

    # k "What?"
    k "Cái gì?"

# game/Story03.rpy:7147
translate vietnamese act3_5chapter2_a0cae81e:

    # mc "(whisper) I wanted to ask about her, but you know... forget it."
    mc "(thì thầm) Tôi muốn hỏi về cô ấy, nhưng cô biết đấy... quên đi."

# game/Story03.rpy:7149
translate vietnamese act3_5chapter2_f17be527:

    # k "(Don't look at me like that — I answer for myself, and no one else.)"
    k "(Đừng nhìn tôi kiểu đó — tôi chỉ trả lời cho bản thân mình, không phải cho ai khác.)"

# game/Story03.rpy:7151
translate vietnamese act3_5chapter2_bb753343:

    # mc "From now on we'll call each other by name. No nicknames, no monikers. You don't mind?"
    mc "Từ giờ chúng ta sẽ gọi nhau bằng tên. Không biệt danh, không tên hiệu. Các bạn không phiền chứ?"

# game/Story03.rpy:7153
translate vietnamese act3_5chapter2_8d049099:

    # gg "Fine."
    gg "Được thôi."

# game/Story03.rpy:7155
translate vietnamese act3_5chapter2_f85ee3df:

    # mc "(For her... for everyone who still breathes. I have to survive. Even if I have to bite my way through.)"
    mc "(Vì cô ấy... vì tất cả những ai vẫn còn thở. Tôi phải sống sót. Dù có phải cắn xé để vượt qua.)"

# game/Story03.rpy:7157
translate vietnamese act3_5chapter2_0512330b:

    # mc "Now we know each other's names. So if we end up dying — we'll die as people. But better yet — let's die as the living."
    mc "Giờ chúng ta đã biết tên nhau. Vậy nên nếu chúng ta có chết — chúng ta sẽ chết như con người. Nhưng tốt hơn nữa — hãy chết khi vẫn đang sống."

# game/Story03.rpy:7158
translate vietnamese act3_5chapter2_cc6b5234:

    # mc "Alright then, let's go."
    mc "Được rồi, đi thôi."

# game/Story03.rpy:7176
translate vietnamese act3_5chapter2_5c558797:

    # a "Ah… history repeats itself. Predictable as ever."
    a "À… lịch sử lặp lại. Dễ đoán như mọi khi."

# game/Story03.rpy:7177
translate vietnamese act3_5chapter2_26694e5f:

    # y "You… you swore! The Lower City was off-limits!"
    y "Anh… anh đã thề! Hạ thành là khu vực cấm!"

# game/Story03.rpy:7178
translate vietnamese act3_5chapter2_bb8e4b4e_2:

    # a "..."
    a "..."

# game/Story03.rpy:7180
translate vietnamese act3_5chapter2_1dae9a31:

    # a "And you believed that oath meant anything?"
    a "Và anh tin rằng lời thề đó có ý nghĩa gì sao?"

# game/Story03.rpy:7181
translate vietnamese act3_5chapter2_87ba2748:

    # a "One task. Escort the boy to the tower. Simple. Elegant. And yet — he’s here."
    a "Một nhiệm vụ. Hộ tống thằng bé tới tòa tháp. Đơn giản. Thanh lịch. Vậy mà — nó lại ở đây."

# game/Story03.rpy:7182
translate vietnamese act3_5chapter2_71a86863:

    # y "..."
    y "..."

# game/Story03.rpy:7183
translate vietnamese act3_5chapter2_b5852ef1:

    # a "Pathetic. Mortals always crumble when it matters most. So once again, I must correct your failure."
    a "Thật thảm hại. Phàm nhân luôn sụp đổ khi chuyện quan trọng nhất xảy ra. Vậy nên một lần nữa, ta phải sửa chữa thất bại của ngươi."

# game/Story03.rpy:7185
translate vietnamese act3_5chapter2_a901cd97:

    # a "This is your final move. Fail me again… and your piece is swept from the board."
    a "Đây là nước đi cuối cùng của ngươi. Thất bại với ta lần nữa… và quân cờ của ngươi sẽ bị hất khỏi bàn cờ."

# game/Story03.rpy:7206
translate vietnamese act3_5chapter2_1_09b69430:

    # mc "(The smell of burning, scorched walls, mutant corpses. A sight not for the faint-hearted.)"
    mc "(Mùi cháy khét, tường cháy xém, xác đột biến. Một cảnh tượng không dành cho người yếu tim.)"

# game/Story03.rpy:7210
translate vietnamese act3_5chapter2_1_ee87ded2:

    # k "Ah… the smell. Charred walls, rotting freaks. Feels almost cozy."
    k "À… mùi đó. Tường cháy đen, lũ quái vật đang thối rữa. Cảm giác gần như ấm cúng."

# game/Story03.rpy:7212
translate vietnamese act3_5chapter2_1_2b35b6fe:

    # mc "..."
    mc "..."

# game/Story03.rpy:7218
translate vietnamese act3_5chapter2_1_e35dbfbd:

    # mc "Whoever did this knew exactly what they were doing."
    mc "Kẻ nào làm chuyện này cũng biết chính xác mình đang làm gì."

# game/Story03.rpy:7220
translate vietnamese act3_5chapter2_1_9621c198:

    # k "Or rather — whoever did this had style. A true artist at work."
    k "Hay đúng hơn — kẻ nào làm chuyện này cũng có phong cách. Một nghệ sĩ đích thực đang làm việc."

# game/Story03.rpy:7225
translate vietnamese act3_5chapter2_1_61308746:

    # k "Almost makes me jealous."
    k "Gần như khiến tôi ghen tị."

# game/Story03.rpy:7228
translate vietnamese act3_5chapter2_1_87762c12:

    # mc "I have no doubt about that."
    mc "Tôi không nghi ngờ gì về điều đó."

# game/Story03.rpy:7231
translate vietnamese act3_5chapter2_1_bb8e4b4e:

    # a "..."
    a "..."
# game/Story03.rpy:7233
translate vietnamese act3_5chapter2_1_5794f5b7:

    # mc "Well? Anything worth noting?"
    mc "Sao rồi? Có gì đáng chú ý không?"
# game/Story03.rpy:7241
translate vietnamese act3_5chapter2_1_ba08faf1:

    # mc "(So you’re staying quiet till the end? Fine…)"
    mc "(Vậy là cô định im lặng tới cùng à? Được thôi…)"
# game/Story03.rpy:7243
translate vietnamese act3_5chapter2_1_1ae5d572:

    # gg "[mc] over here! Might be useful."
    gg "[mc] qua đây này! Cái này có thể hữu ích đấy."
# game/Story03.rpy:7246
translate vietnamese act3_5chapter2_1_13274333:

    # mc "Nyx? What’ve you got?"
    mc "Nyx? Cậu có gì vậy?"
# game/Story03.rpy:7249
translate vietnamese act3_5chapter2_1_02a5098b:

    # gg "We found this on him."
    gg "Bọn tôi tìm thấy cái này trên người hắn."
# game/Story03.rpy:7250
translate vietnamese act3_5chapter2_1_3f1db724:

    # gg "I don't know if it's real or a setup."
    gg "Tôi không biết nó là thật hay là một cái bẫy được giăng sẵn."
# game/Story03.rpy:7252
translate vietnamese act3_5chapter2_1_d4504e70:

    # gggg "We're in deep, that's for sure."
    gggg "Chắc chắn là chúng ta đang lún sâu rồi."
# game/Story03.rpy:7256
translate vietnamese act3_5chapter2_1_b2b9e19d:

    # mc "What do you mean?"
    mc "Ý cậu là sao?"
# game/Story03.rpy:7261
translate vietnamese act3_5chapter2_1_0690d607:

    # mc "Gather in Sector Three before time runs out. Or..."
    mc "Tập hợp ở Khu vực Ba trước khi hết thời gian. Hoặc là…"
# game/Story03.rpy:7263
translate vietnamese act3_5chapter2_1_1873ff8d:

    # mc "...the lower city will be purged."
    mc "…thành phố dưới sẽ bị thanh trừng."
# game/Story03.rpy:7265
translate vietnamese act3_5chapter2_1_48d39340:

    # mc "Can we trust it?"
    mc "Liệu chúng ta có tin được nó không?"
# game/Story03.rpy:7268
translate vietnamese act3_5chapter2_1_05562853:

    # gg "Don't know, but if it's true — we need to hurry."
    gg "Không biết, nhưng nếu nó là thật — chúng ta cần nhanh lên."
# game/Story03.rpy:7270
translate vietnamese act3_5chapter2_1_bb8e4b4e_1:

    # a "..."
    a "..."
# game/Story03.rpy:7272
translate vietnamese act3_5chapter2_1_b09d52c5:

    # mc "So that’s why you didn’t want us heading there?"
    mc "Vậy đó là lý do cô không muốn chúng ta tới đó à?"
# game/Story03.rpy:7274
translate vietnamese act3_5chapter2_1_615667ff:

    # a "You're reading between the lines too fast."
    a "Anh suy diễn quá nhanh rồi."
# game/Story03.rpy:7276
translate vietnamese act3_5chapter2_1_244164d6:

    # mc "Listen, I didn't give a damn that you were silent."
    mc "Nghe này, tôi chẳng quan tâm việc cô im lặng."
# game/Story03.rpy:7281
translate vietnamese act3_5chapter2_1_f6c5ed4f:

    # mc "(No, [mc]. Hold it. Breathe. Don’t lose it now…)"
    mc "(Không, [mc]. Kiềm lại. Hít thở đi. Đừng mất bình tĩnh lúc này…)"
# game/Story03.rpy:7289
translate vietnamese act3_5chapter2_1_9c9013cc:

    # mc "But right here, right now — I need answers. Especially about that note."
    mc "Nhưng ngay tại đây, ngay lúc này — tôi cần câu trả lời. Nhất là về tờ giấy đó."
# game/Story03.rpy:7291
translate vietnamese act3_5chapter2_1_bb8e4b4e_2:

    # a "..."
    a "..."
# game/Story03.rpy:7293
translate vietnamese act3_5chapter2_1_5b455ade:

    # mc "Are you really going to keep quiet? Or will you finally speak?"
    mc "Cô thật sự định im lặng tiếp à? Hay cuối cùng cô sẽ chịu nói?"
# game/Story03.rpy:7295
translate vietnamese act3_5chapter2_1_76115544:

    # a "You're the leader now. My place is behind you — unseen."
    a "Anh là người dẫn đầu bây giờ. Vị trí của tôi là ở phía sau anh — không ai thấy."
# game/Story03.rpy:7297
translate vietnamese act3_5chapter2_1_978174fd:

    # k "Cut it out. You’re only digging yourself a deeper grave."
    k "Thôi đi. Cậu chỉ đang tự đào mồ cho mình sâu thêm thôi."
# game/Story03.rpy:7303
translate vietnamese act3_5chapter2_1_feff63bd:

    # mc "We're not leaving until you tell me everything."
    mc "Chúng ta sẽ không đi đâu cho tới khi cô kể hết cho tôi."
# game/Story03.rpy:7305
translate vietnamese act3_5chapter2_1_df619773:

    # mc "And if I'm the leader now, you'll follow my orders — understood?"
    mc "Và nếu tôi là người dẫn đầu bây giờ, cô sẽ tuân theo lệnh của tôi — rõ chưa?"
# game/Story03.rpy:7306
translate vietnamese act3_5chapter2_1_bb8e4b4e_3:

    # a "..."
    a "..."
# game/Story03.rpy:7307
translate vietnamese act3_5chapter2_1_e0d9e8e7:

    # a "Hmpf."
    a "Hừm."
# game/Story03.rpy:7311
translate vietnamese act3_5chapter2_1_159f586b:

    # mc "Are you kidding me!"
    mc "Cô đùa tôi đấy à!"
# game/Story03.rpy:7316
translate vietnamese act3_5chapter2_1_9b1210bb:

    # k "One more twitch, and I’ll carve your throat open. Try me."
    k "Nhúc nhích thêm một cái nữa, tôi sẽ rạch cổ họng cô ra. Cứ thử xem."
# game/Story03.rpy:7318
translate vietnamese act3_5chapter2_1_2b35b6fe_1:

    # mc "..."
    mc "..."
# game/Story03.rpy:7320
translate vietnamese act3_5chapter2_1_ab998e08:

    # mc "(She’s right. Cool it down, [mc].)"
    mc "(Cô ấy nói đúng. Bình tĩnh lại đi, [mc].)"
# game/Story03.rpy:7324
translate vietnamese act3_5chapter2_1_40f71b31:

    # mc "(Even silent, she’s still one of us.)"
    mc "(Dù im lặng, cô ấy vẫn là một trong số chúng ta.)"
# game/Story03.rpy:7327
translate vietnamese act3_5chapter2_1_12b6fd0f:

    # mc "(Yeah, that's the best move.)"
    mc "(Ừ, đó là nước đi tốt nhất.)"
# game/Story03.rpy:7329
translate vietnamese act3_5chapter2_1_71fae008:

    # mc "Maybe you know something?"
    mc "Có lẽ cô biết gì đó?"
# game/Story03.rpy:7333
translate vietnamese act3_5chapter2_1_e56be2ad:

    # k "Neither I nor my mute sister had a hand in this. Stop whining — it’s making you look pitiful."
    k "Cả tôi lẫn cô em gái câm của tôi đều không nhúng tay vào chuyện này. Ngừng than vãn đi — trông cậu thảm hại lắm."
# game/Story03.rpy:7335
translate vietnamese act3_5chapter2_1_9995c2fe:

    # mc "So it wasn’t your hand?"
    mc "Vậy không phải do cô ra tay?"
# game/Story03.rpy:7337
translate vietnamese act3_5chapter2_1_04f1ae85:

    # k "Who do you take me for? A murderer?"
    k "Cậu coi tôi là ai? Một kẻ sát nhân à?"
# game/Story03.rpy:7339
translate vietnamese act3_5chapter2_1_2b35b6fe_2:

    # mc "..."
    mc "..."
# game/Story03.rpy:7342
translate vietnamese act3_5chapter2_1_2cdc06dc:

    # mc "You’ve cut down more than most armies. Don’t act like the word doesn’t fit."
    mc "Cô đã chém giết còn nhiều hơn cả đa số quân đội. Đừng làm như từ đó không hợp với cô."
# game/Story03.rpy:7345
translate vietnamese act3_5chapter2_1_9c268761:

    # k "Don’t play dumb. You’ve slaughtered enough to know. The only difference is motive."
    k "Đừng giả ngốc. Cậu đã tàn sát đủ nhiều để hiểu. Khác biệt duy nhất là động cơ."
# game/Story03.rpy:7348
translate vietnamese act3_5chapter2_1_51e52378:

    # k "I kill because it’s beautiful."
    k "Tôi giết vì nó đẹp."
# game/Story03.rpy:7351
translate vietnamese act3_5chapter2_1_7d95b7f7:

    # k "You kill because someone told you to. That’s your tragedy."
    k "Cậu giết vì có người bảo cậu làm vậy. Đó là bi kịch của cậu."
# game/Story03.rpy:7353
translate vietnamese act3_5chapter2_1_2b35b6fe_3:

    # mc "..."
    mc "..."
# game/Story03.rpy:7355
translate vietnamese act3_5chapter2_1_6494bad5:

    # mc "Fair enough. Truth is, if I wasn’t dragged into saving this place…"
    mc "Cũng phải. Thật ra, nếu tôi không bị kéo vào việc cứu lấy nơi này…"
# game/Story03.rpy:7358
translate vietnamese act3_5chapter2_1_9e28d6ad:

    # mc "I’m not even from here. Not from this planet. From the other side of the universe."
    mc "Tôi thậm chí còn không phải người ở đây. Không phải từ hành tinh này. Từ phía bên kia của vũ trụ."
# game/Story03.rpy:7360
translate vietnamese act3_5chapter2_1_8a1ff4a0:

    # mc "And what do I get back? Suspicion. Aggression. Treated like dirt."
    mc "Và tôi nhận lại được gì? Sự nghi ngờ. Sự thù địch. Bị đối xử như rác rưởi."
# game/Story03.rpy:7361
translate vietnamese act3_5chapter2_1_c54c0120:

    # mc "Yet still — I chose to help."
    mc "Thế mà — tôi vẫn chọn giúp đỡ."
# game/Story03.rpy:7364
translate vietnamese act3_5chapter2_1_3c0439aa:

    # mc "You. Your mistress. With no intel, no backup, nothing."
    mc "Cô. Chủ nhân của cô. Không tin tức, không viện trợ, chẳng có gì cả."
# game/Story03.rpy:7369
translate vietnamese act3_5chapter2_1_bb8e4b4e_4:

    # a "..."
    a "..."
# game/Story03.rpy:7374
translate vietnamese act3_5chapter2_1_dc607cbe:

    # k "(Don’t.)"
    k "(Đừng.)"
# game/Story03.rpy:7376
translate vietnamese act3_5chapter2_1_a6e657f2:

    # gggg "(whisper) What do we do? He's on edge..."
    gggg "(thì thầm) Chúng ta làm gì đây? Anh ta đang căng thẳng lắm…"
# game/Story03.rpy:7377
translate vietnamese act3_5chapter2_1_a05f8c97:

    # gg "(whisper) We watch."
    gg "(thì thầm) Chúng ta cứ quan sát."
# game/Story03.rpy:7380
translate vietnamese act3_5chapter2_1_752b8262:

    # gg "..."
    gg "..."
# game/Story03.rpy:7394
translate vietnamese act3_5chapter2_1_790221dc:

    # mc "Right, I forgot..."
    mc "Phải rồi, tôi quên mất…"
# game/Story03.rpy:7397
translate vietnamese act3_5chapter2_1_7a97854f:

    # mc "You understand only the language of violence."
    mc "Cô chỉ hiểu ngôn ngữ của bạo lực thôi."
# game/Story03.rpy:7401
translate vietnamese act3_5chapter2_1_65535b28:

    # mc "Talk. Tell me what you know."
    mc "Nói đi. Kể cho tôi những gì cô biết."
# game/Story03.rpy:7405
translate vietnamese act3_5chapter2_1_bb8e4b4e_5:

    # a "..."
    a "..."
# game/Story03.rpy:7409
translate vietnamese act3_5chapter2_1_a79c5b00:

    # k "Please. Don’t make me waste my blade on you."
    k "Làm ơn. Đừng bắt tôi phí lưỡi kiếm của mình vào cậu."
# game/Story03.rpy:7410
translate vietnamese act3_5chapter2_1_dbdef2f7:

    # k "(quiet) Begging doesn't suit you."
    k "(khẽ) Cầu xin không hợp với cậu đâu."
# game/Story03.rpy:7412
translate vietnamese act3_5chapter2_1_bdc5efa2:

    # mc "I’ve been patient long enough. That’s over."
    mc "Tôi đã kiên nhẫn đủ lâu rồi. Chấm dứt rồi."
# game/Story03.rpy:7415
translate vietnamese act3_5chapter2_1_01e35740:

    # mc "If she won’t listen, then I’ll make her listen."
    mc "Nếu cô ta không chịu nghe, thì tôi sẽ bắt cô ta phải nghe."
# game/Story03.rpy:7431
translate vietnamese act3_5chapter2_1_b2323341:

    # k "Don’t push me."
    k "Đừng ép tôi."
# game/Story03.rpy:7433
translate vietnamese act3_5chapter2_1_d465bd31:

    # mc "I won`t repeat, answer. Now!"
    mc "Tôi sẽ không nhắc lại đâu, trả lời đi. Ngay bây giờ!"
# game/Story03.rpy:7444
translate vietnamese act3_5chapter2_1_37af4d3a:

    # k "If you do, I’ll finish this in a heartbeat. That’s your last chance."
    k "Nếu cậu làm vậy, tôi sẽ kết thúc chuyện này trong nháy mắt. Đó là cơ hội cuối cùng của cậu."
# game/Story03.rpy:7446
translate vietnamese act3_5chapter2_1_1d01ed27:

    # mc "Do you want it to end here? Fine. But you'll tell me first — who ordered it?"
    mc "Cô muốn nó kết thúc ở đây à? Được thôi. Nhưng trước hết cô sẽ nói cho tôi biết — ai đã ra lệnh?"
# game/Story03.rpy:7454
translate vietnamese act3_5chapter2_1_45ee8c1e:

    # mc "(whisper) Seems, I have no choice..."
    mc "(thì thầm) Dường như, tôi không còn lựa chọn nào khác…"
# game/Story03.rpy:7472
translate vietnamese act3_5chapter2_2_3ed7f492:

    # y "Enough. Both of you."
    y "Đủ rồi. Cả hai người."
