translate vietnamese ivy_meetings_3c641fc2:

    # i "Don’t tease me like that. Every little move— I can feel it."
    i "Đừng trêu tôi như thế. Từng cử động nhỏ — tôi đều cảm nhận được."

# game/Story03.rpy:10180
translate vietnamese ivy_meetings_a343fd67:

    # mc "You’re trembling. Do you like it this much?"
    mc "Em đang run rẩy đấy. Em thích đến thế sao?"

# game/Story03.rpy:10181
translate vietnamese ivy_meetings_f9a20d87:

    # i "...More than I’d ever admit. Just… keep going."
    i "…Hơn bất cứ điều gì tôi từng thừa nhận. Chỉ là… cứ tiếp tục đi."

# game/Story03.rpy:10182
translate vietnamese ivy_meetings_c2ba0730:

    # mc "Tell me what you want, Ivy."
    mc "Nói cho anh biết em muốn gì, Ivy."

# game/Story03.rpy:10183
translate vietnamese ivy_meetings_26b27d9b:

    # i "I want… all of you. Right here, right now."
    i "Tôi muốn… tất cả con người anh. Ngay đây, ngay lúc này."

# game/Story03.rpy:10184
translate vietnamese ivy_meetings_e18d5ae7:

    # i "Mmh… you’re making it hard to think straight."
    i "Mmh… anh làm tôi khó mà nghĩ cho tỉnh táo."

# game/Story03.rpy:10185
translate vietnamese ivy_meetings_2ba1906f:

    # mc "Then don’t think. Just feel."
    mc "Vậy thì đừng nghĩ nữa. Chỉ cảm nhận thôi."

# game/Story03.rpy:10186
translate vietnamese ivy_meetings_189eda96:

    # i "Easy for you to say… I’m the one melting here."
    i "Anh nói thì dễ… Người đang tan chảy ở đây là tôi."

# game/Story03.rpy:10187
translate vietnamese ivy_meetings_7b03c16e:

    # mc "Good. That means I’m doing something right."
    mc "Tốt. Nghĩa là anh đang làm đúng rồi."

# game/Story03.rpy:10188
translate vietnamese ivy_meetings_746f6f3f:

    # i "You know, sitting like this… it almost feels like you’re claiming me."
    i "Anh biết không, ngồi thế này… cứ như thể anh đang chiếm lấy tôi vậy."

# game/Story03.rpy:10189
translate vietnamese ivy_meetings_b4a1a81e:

    # mc "Almost?"
    mc "Gần như thôi sao?"

# game/Story03.rpy:10190
translate vietnamese ivy_meetings_732fde24:

    # i "Tch, don’t get cocky. I didn’t say I mind."
    i "Chậc, đừng có tự mãn. Tôi đâu có nói là tôi phiền."

# game/Story03.rpy:10191
translate vietnamese ivy_meetings_68fa01f7:

    # mc "I can tell."
    mc "Anh nhận ra mà."

# game/Story03.rpy:10192
translate vietnamese ivy_meetings_df4e3dcf:

    # i "Hah… damn you. Every time I think I’ve got the upper hand, you flip it back on me."
    i "Hah… đáng ghét thật. Mỗi lần tôi nghĩ mình đang chiếm thế thượng phong, anh lại lật ngược tình thế."

# game/Story03.rpy:10193
translate vietnamese ivy_meetings_fa89785f:

    # mc "Maybe you never had it to begin with."
