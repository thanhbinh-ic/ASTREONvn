    # mc "I’m not going to stand here and promise survival."
    mc "Tôi sẽ không đứng đây mà hứa hẹn sự sống sót."

# game/Story03.rpy:5665
translate vietnamese akt3chapter5_1_639617cb:

    # mc "Some of us probably won’t make it."
    mc "Một số người trong chúng ta có lẽ sẽ không qua được."

# game/Story03.rpy:5667
translate vietnamese akt3chapter5_1_fa6ce8c2:

    # g "Then why are you even here?!"
    g "Vậy thì anh tới đây làm gì?!"

