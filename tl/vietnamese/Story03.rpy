    L "Em đã nhìn anh chết."

# game/Story03.rpy:1118
translate vietnamese akt3chapter1_3_e78b3a91_1:

    # L "Again."
    L "Lần nữa."

# game/Story03.rpy:1120
translate vietnamese akt3chapter1_3_396c7eee_2:

    # L "And again."
    L "Và lần nữa."

# game/Story03.rpy:1122
translate vietnamese akt3chapter1_3_396c7eee_3:

    # L "And again."
    L "Và lần nữa."

# game/Story03.rpy:1124
