    # mc "N-not…"
    mc "Kh-không…"
# game/Story03.rpy:7732
translate vietnamese act3_5chapter2_2_c7443293:

    # mc "W-weak!"
    mc "…yếu đâu!"
# game/Story03.rpy:7735
translate vietnamese act3_5chapter2_2_8b797fa0:

    # am "That’s enough."
    am "Thế là đủ rồi."
# game/Story03.rpy:7738
translate vietnamese act3_5chapter2_2_b9bd232b:

    # y "(whispering) Why did you…"
    y "(thì thầm) Sao cô lại…"
# game/Story03.rpy:7739
translate vietnamese act3_5chapter2_2_d779cba2:

    # am "Everything that happens next will be on your conscience."
    am "Mọi chuyện xảy ra tiếp theo sẽ đè nặng lên lương tâm của cô."
# game/Story03.rpy:7741
translate vietnamese act3_5chapter2_2_c56d8e88:

    # y "Fine. Then may I?"
    y "Được thôi. Vậy tôi có thể chứ?"
# game/Story03.rpy:7743
translate vietnamese act3_5chapter2_2_50e57c3b:

    # am "Later. You’re being followed."
    am "Để sau. Cô đang bị theo dõi."
# game/Story03.rpy:7745
translate vietnamese act3_5chapter2_2_71a86863_4:

    # y "..."
    y "..."
# game/Story03.rpy:7747
translate vietnamese act3_5chapter2_2_7cc313fd:

    # am "And this is how you repay me for saving you?"
    am "Và đây là cách cô đền đáp tôi vì đã cứu cô sao?"
# game/Story03.rpy:7761
translate vietnamese act3_5chapter2_3_2b35b6fe:

    # mc "..."
    mc "..."
# game/Story03.rpy:7764
translate vietnamese act3_5chapter2_3_2170b42f:

    # mc "Miriel?"
    mc "Miriel?"
# game/Story03.rpy:7769
translate vietnamese act3_5chapter2_3_efb5df2b:

    # Mi "Awake, finally?"
    Mi "Cuối cùng cũng tỉnh rồi à?"
# game/Story03.rpy:7772
translate vietnamese act3_5chapter2_3_2b35b6fe_1:

    # mc "..."
    mc "..."
# game/Story03.rpy:7776
translate vietnamese act3_5chapter2_3_5d5ea5a2:

    # Mi "How are you holding up?"
    Mi "Anh vẫn ổn chứ?"
# game/Story03.rpy:7778
translate vietnamese act3_5chapter2_3_22cc9567:

    # mc "Where are we?"
    mc "Chúng ta đang ở đâu?"
# game/Story03.rpy:7781
translate vietnamese act3_5chapter2_3_661d2740:

    # Mi "Recon HQ. Safe, for now."
    Mi "Bộ chỉ huy Trinh sát. An toàn, tạm thời thì vậy."
# game/Story03.rpy:7784
translate vietnamese act3_5chapter2_3_d175e169:

    # mc "Yong?"
    mc "Yong?"
# game/Story03.rpy:7787
translate vietnamese act3_5chapter2_3_78a22df8:

    # Mi "Talking with Winter. Nothing urgent."
    Mi "Đang nói chuyện với Winter. Không có gì gấp."
# game/Story03.rpy:7791
translate vietnamese act3_5chapter2_3_2b35b6fe_2:

    # mc "..."
    mc "..."
# game/Story03.rpy:7793
translate vietnamese act3_5chapter2_3_3c9f286c:

    # mc "Lora..."
    mc "Lora…"
# game/Story03.rpy:7795
translate vietnamese act3_5chapter2_3_1dcb9a5e:

    # mc "I saw her… like I remembered, but not the same."
    mc "Tôi đã thấy cô ấy… giống như tôi nhớ, nhưng lại không giống."
# game/Story03.rpy:7800
translate vietnamese act3_5chapter2_3_1e0e2567:

    # mc "Not the one I met here."
    mc "Không phải người tôi đã gặp ở đây."
# game/Story03.rpy:7804
translate vietnamese act3_5chapter2_3_5711a4fd:

    # mc "Tell me…"
    mc "Nói cho tôi biết…"
# game/Story03.rpy:7806
translate vietnamese act3_5chapter2_3_60cf0c61:

    # mc "what would you do if the person you loved was gone for good?"
    mc "cô sẽ làm gì nếu người cô yêu đã ra đi mãi mãi?"
# game/Story03.rpy:7812
translate vietnamese act3_5chapter2_3_d852b200:

    # mc "If everything you leaned on was just… out of reach forever?"
    mc "Nếu mọi thứ cô dựa vào chỉ là… mãi mãi ngoài tầm với?"
# game/Story03.rpy:7818
translate vietnamese act3_5chapter2_3_da3fdbf1:

    # Mi "..."
    Mi "..."
# game/Story03.rpy:7821
translate vietnamese act3_5chapter2_3_4fde1df4:

    # Mi "She’d want you to keep moving. To survive."
    Mi "Cô ấy sẽ muốn anh tiếp tục bước đi. Để sống sót."
# game/Story03.rpy:7825
translate vietnamese act3_5chapter2_3_e7288f07:

    # Mi "…That’s all you can do."
    Mi "…Đó là tất cả những gì anh có thể làm."
# game/Story03.rpy:7829
translate vietnamese act3_5chapter2_3_2b35b6fe_3:

    # mc "..."
    mc "..."
# game/Story03.rpy:7833
translate vietnamese act3_5chapter2_3_da3fdbf1_1:

    # Mi "..."
    Mi "..."
# game/Story03.rpy:7841
translate vietnamese act3_5chapter2_3_c4a530d7:

    # mc "Sorry. Didn’t think I had any tears left."
    mc "Xin lỗi. Tôi không nghĩ mình còn nước mắt nữa."
# game/Story03.rpy:7844
translate vietnamese act3_5chapter2_3_c8ae85d3:

    # Mi "Not exactly the time for it… but I get it."
    Mi "Không hẳn là lúc thích hợp cho chuyện đó… nhưng tôi hiểu."
# game/Story03.rpy:7847
translate vietnamese act3_5chapter2_3_e7367d2a:

    # Mi "Still… glad to see you made it back."
    Mi "Dù sao… mừng vì anh đã trở về được."
# game/Story03.rpy:7851
translate vietnamese act3_5chapter2_3_05df7b5e:

    # Mi "And thank you… for not leaving us behind."
    Mi "Và cảm ơn anh… vì đã không bỏ rơi chúng tôi."
# game/Story03.rpy:7853
translate vietnamese act3_5chapter2_3_dd66998d:

    # mc "How could I ever walk away, after everything?"
    mc "Làm sao tôi có thể bỏ đi được, sau tất cả mọi chuyện?"
# game/Story03.rpy:7855
translate vietnamese act3_5chapter2_3_da3fdbf1_2:

    # Mi "..."
    Mi "..."
# game/Story03.rpy:7860
translate vietnamese act3_5chapter2_3_b79edc31:

    # Mi "…Thank you."
    Mi "…Cảm ơn anh."
# game/Story03.rpy:7867
translate vietnamese act3_5chapter2_3_92f1bcbf:

    # y "Awake?"
    y "Tỉnh rồi à?"
# game/Story03.rpy:7870
translate vietnamese act3_5chapter2_3_964e3083:

    # mc "Looks like it."
    mc "Có vẻ vậy."
# game/Story03.rpy:7872
translate vietnamese act3_5chapter2_3_598b874f:

    # y "Good. Then let's move. They're waiting for you in there."
    y "Tốt. Vậy thì đi thôi. Họ đang chờ cậu ở trong đó."
# game/Story03.rpy:7882
translate vietnamese act3_5chapter2_3_3ba1b1d2:

    # w "Our mission is to secure the safety of our people. At any cost."
    w "Nhiệm vụ của chúng ta là đảm bảo an toàn cho người dân của chúng ta. Bằng mọi giá."
# game/Story03.rpy:7892
translate vietnamese act3_5chapter2_3_825b9da4:

    # g "With all due respect, that's absolute nonsense! The Arks Federation has been ignoring us this whole time."
    g "Với tất cả sự tôn trọng, đó là chuyện hoàn toàn vô lý! Liên bang Ark đã phớt lờ chúng ta suốt thời gian qua."
# game/Story03.rpy:7895
translate vietnamese act3_5chapter2_3_d6950376:

    # g "Why should we be the ones to—"
    g "Sao chúng ta lại phải là những người—"
# game/Story03.rpy:7897
translate vietnamese act3_5chapter2_3_0d04128e:

    # w "..."
    w "..."
# game/Story03.rpy:7900
translate vietnamese act3_5chapter2_3_56826835:

    # w "Anyone else agree with him?"
    w "Còn ai khác đồng ý với anh ta không?"
# game/Story03.rpy:7903
translate vietnamese act3_5chapter2_3_4b340443:

    # g "..."
    g "..."
# game/Story03.rpy:7904
translate vietnamese act3_5chapter2_3_85381107:

    # w "We all make mistakes; they're no exception."
    w "Ai cũng mắc sai lầm; họ cũng không ngoại lệ."
# game/Story03.rpy:7907
translate vietnamese act3_5chapter2_3_3bde74c3:

    # w "The question is whether our pride is strong enough to bury the hatchet."
    w "Vấn đề là liệu lòng kiêu hãnh của chúng ta có đủ mạnh để giảng hòa hay không."
# game/Story03.rpy:7910
translate vietnamese act3_5chapter2_3_53ad53a4:

    # w "I understand how you feel. But right now, we must survive!"
    w "Tôi hiểu cảm giác của anh. Nhưng ngay lúc này, chúng ta phải sống sót!"
# game/Story03.rpy:7912
translate vietnamese act3_5chapter2_3_54cae50b:

    # ggg "(Rumours)"
    ggg "(Tiếng xì xào)"
# game/Story03.rpy:7914
translate vietnamese act3_5chapter2_3_d1ea851a:

    # w "And again we meet."
    w "Và chúng ta lại gặp nhau."
# game/Story03.rpy:7917
translate vietnamese act3_5chapter2_3_09e90edd:

    # w "The first time I wasn't sure. But seeing you here - accept my greeting."
    w "Lần đầu tôi không chắc. Nhưng khi thấy anh ở đây — xin nhận lời chào của tôi."
# game/Story03.rpy:7920
translate vietnamese act3_5chapter2_3_015080fd:

    # mc "Glad to meet you. What’s the situation?"
    mc "Rất vui được gặp ông. Tình hình thế nào?"
# game/Story03.rpy:7925
translate vietnamese act3_5chapter2_3_5b055e29:

    # w "Monsters surround us like wolves. If they close the ring — there won't be an exit left."
    w "Quái vật bao vây chúng ta như bầy sói. Nếu chúng khép kín vòng vây — sẽ không còn lối thoát nào nữa."
# game/Story03.rpy:7929
translate vietnamese act3_5chapter2_3_5aa9ed78:

    # w "Our way is through the northern tunnel. Old, half-collapsed, but it still holds. That's where we'll force our path."
    w "Đường của chúng ta là qua đường hầm phía bắc. Cũ, đã sụp một nửa, nhưng vẫn còn trụ được. Đó là nơi chúng ta sẽ mở đường máu."
# game/Story03.rpy:7931
translate vietnamese act3_5chapter2_3_8b3034f8:

    # y "It's blocked. Half the people won't fit through."
    y "Nó bị chặn rồi. Một nửa số người sẽ không lọt qua được."
# game/Story03.rpy:7932
translate vietnamese act3_5chapter2_3_6570d3bb:

    # w "I know. But there's no other route. Either we go and take the risk, or we wait here until we're eaten."
    w "Tôi biết. Nhưng không còn tuyến đường nào khác. Hoặc chúng ta đi và chấp nhận rủi ro, hoặc chúng ta chờ ở đây cho tới khi bị ăn thịt."
# game/Story03.rpy:7935
translate vietnamese act3_5chapter2_3_4e6a411a:

    # Mi "And what if it's a trap?"
    Mi "Và nếu đó là một cái bẫy thì sao?"
# game/Story03.rpy:7937
translate vietnamese act3_5chapter2_3_ea3e4f70:

    # w "Then we'll die with weapons in our hands. Not cowering in basements like rats."
    w "Vậy thì chúng ta sẽ chết với vũ khí trong tay. Chứ không phải co rúm trong tầng hầm như lũ chuột."
# game/Story03.rpy:7939
translate vietnamese act3_5chapter2_3_ed23b569:

    # mc "What if we put up a fight?"
    mc "Nếu chúng ta đánh trả thì sao?"
# game/Story03.rpy:7941
translate vietnamese act3_5chapter2_3_2f1c6a0a:

    # w "Too many of them. It won't work."
    w "Chúng quá đông. Sẽ không hiệu quả đâu."
# game/Story03.rpy:7942
translate vietnamese act3_5chapter2_3_147dc9ee:

    # w "And with civilians around, it would turn into a slaughter."
    w "Và với dân thường ở quanh đây, nó sẽ biến thành một cuộc tàn sát."
# game/Story03.rpy:7945
translate vietnamese act3_5chapter2_3_c1c2ad6a:

    # y "That many people won't get through. There's no choice."
    y "Số người đông như vậy sẽ không qua được. Không còn lựa chọn nào khác."
# game/Story03.rpy:7946
translate vietnamese act3_5chapter2_3_7be1ebc5:

    # w "I'd give my life to get everyone out — no exceptions."
    w "Tôi sẽ hy sinh mạng sống của mình để đưa mọi người ra ngoài — không ngoại lệ."
# game/Story03.rpy:7948
translate vietnamese act3_5chapter2_3_640ca5ee:

    # mc "Yong’s right. It’s suicide."
    mc "Yong nói đúng. Đó là tự sát."
# game/Story03.rpy:7949
translate vietnamese act3_5chapter2_3_d5b50506:

    # mc "Clearing a path for hundreds is already near impossible. And you want more than that…"
    mc "Dọn đường cho hàng trăm người vốn đã gần như không thể. Mà ông còn muốn nhiều hơn thế…"
# game/Story03.rpy:7951
translate vietnamese act3_5chapter2_3_ceece35d:

    # w "So what do you propose?"
    w "Vậy anh đề xuất gì?"
# game/Story03.rpy:7953
translate vietnamese act3_5chapter2_3_6a6b86f0:

    # mc "Do you know about Sector 3?"
    mc "Ông có biết về Khu vực 3 không?"
# game/Story03.rpy:7956
translate vietnamese act3_5chapter2_3_7f5ee279:

    # mc "Could their numbers be enough to hold the lower city?"
    mc "Liệu quân số của họ có đủ để giữ thành phố dưới không?"
# game/Story03.rpy:7963
translate vietnamese act3_5chapter2_3_f13f8809:

    # y "That would be an advantage."
    y "Đó sẽ là một lợi thế."
# game/Story03.rpy:7965
translate vietnamese act3_5chapter2_3_97679a9c:

    # y "But if you send them all — our front will collapse, and then it will be the end for everyone."
    y "Nhưng nếu ông điều tất cả bọn họ đi — mặt trận của chúng ta sẽ sụp đổ, và rồi đó sẽ là dấu chấm hết cho tất cả mọi người."
# game/Story03.rpy:7967
translate vietnamese act3_5chapter2_3_1c04ce1e:

    # w "We'll manage without their help."
    w "Chúng tôi sẽ xoay xở mà không cần sự giúp đỡ của họ."
# game/Story03.rpy:7971
translate vietnamese act3_5chapter2_3_c72e6b67:

    # mc "(Without them, reaching the tower will be impossible. And asking the peacekeepers now would be too late.)"
    mc "(Không có họ, việc tới được tòa tháp sẽ là không thể. Và giờ mà nhờ tới lực lượng gìn giữ hòa bình thì đã quá muộn.)"
# game/Story03.rpy:7973
translate vietnamese act3_5chapter2_3_4a8de014:

    # Mi "If I may, I know someone who can actually help."
    Mi "Cho tôi nói một câu, tôi biết một người thực sự có thể giúp."
# game/Story03.rpy:7977
translate vietnamese act3_5chapter2_3_c651dfa6:

    # Mi "Flora Sevin. Sharp, capable… and reliable."
    Mi "Flora Sevin. Sắc sảo, có năng lực… và đáng tin cậy."
# game/Story03.rpy:7979
translate vietnamese act3_5chapter2_3_7470b4b8:

    # mc "(Exactly — if she can help them, they'll have reason to return the favor!)"
    mc "(Chính xác — nếu cô ấy có thể giúp họ, họ sẽ có lý do để đáp lại ân huệ!)"
# game/Story03.rpy:7988
translate vietnamese act3_5chapter2_3_6b3a8b6e:

    # mc "I need to contact her."
    mc "Tôi cần liên lạc với cô ấy."
# game/Story03.rpy:7992
translate vietnamese act3_5chapter2_3_6917bf14:

    # w "A hopeless task. At best you'll get a narcissistic commander on the line."
    w "Một nhiệm vụ vô vọng. Tốt nhất thì anh cũng chỉ gặp được một vị chỉ huy tự ái trên đường dây."
# game/Story03.rpy:7994
translate vietnamese act3_5chapter2_3_8daa42b6:

    # mc "You’re not the last authority here. Don’t tell me you’ve got no pull."
    mc "Ông không phải là quyền lực cuối cùng ở đây. Đừng nói với tôi là ông không có tầm ảnh hưởng gì."
# game/Story03.rpy:7996
translate vietnamese act3_5chapter2_3_71a86863:

    # y "..."
    y "..."
# game/Story03.rpy:7998
translate vietnamese act3_5chapter2_3_3d2def36:

    # w "He has his own demons."
    w "Hắn ta có những con quỷ của riêng mình."
# game/Story03.rpy:8003
translate vietnamese act3_5chapter2_3_4c29bf9b:

    # w "You go to Sector 3. We stay here until you return."
    w "Anh tới Khu vực 3. Chúng tôi ở lại đây cho tới khi anh trở về."
# game/Story03.rpy:8005
translate vietnamese act3_5chapter2_3_38d29f73:

    # w "Two days. If you don't come back… you'll be the ones blamed for sending us into the tunnel."
    w "Hai ngày. Nếu anh không trở về… các cậu sẽ là những người bị đổ lỗi vì đã đẩy chúng tôi vào đường hầm."
# game/Story03.rpy:8013
translate vietnamese act3_5chapter2_3_13f1a8bd:

    # gg "Mr. Winter, for that they need a transport to get—"
    gg "Ngài Winter, để làm vậy họ cần một phương tiện để tới—"
# game/Story03.rpy:8015
translate vietnamese act3_5chapter2_3_2ca2db85:

    # w "He will take them there."
    w "Hắn ta sẽ đưa họ tới đó."
# game/Story03.rpy:8017
translate vietnamese act3_5chapter2_3_71a86863_1:

    # y "..."
    y "..."
# game/Story03.rpy:8018
translate vietnamese act3_5chapter2_3_25079f96:

    # w "We'll keep an eye on your Elves."
    w "Chúng tôi sẽ để mắt tới các Elf của anh."
# game/Story03.rpy:8020
translate vietnamese act3_5chapter2_3_37ba6b04:

    # w "Then let's get to it. I pray for your success."
    w "Vậy thì bắt tay vào việc thôi. Tôi cầu nguyện cho sự thành công của anh."
# game/Story03.rpy:8032
translate vietnamese act3_5chapter2_3_1a47af84:

    # mc "(All this time here… and I’ve barely learned a thing.)"
    mc "(Ở đây bao lâu nay… mà tôi hầu như chẳng học được gì.)"
# game/Story03.rpy:8033
translate vietnamese act3_5chapter2_3_a9cb99ce:

    # mc "(Why are we here? What really happened with Lora? How are we stuck in the middle of this mess?)"
    mc "(Sao chúng ta lại ở đây? Chuyện gì thực sự đã xảy ra với Lora? Sao chúng ta lại kẹt giữa mớ hỗn độn này?)"
# game/Story03.rpy:8034
translate vietnamese act3_5chapter2_3_4e7ebda2:

    # mc "(And why does it have to be me dragging it forward?)"
    mc "(Và tại sao cứ phải là tôi kéo mọi thứ tiến lên?)"

# game/Story03.rpy:8037
translate vietnamese act3_5chapter2_3_366c3259:

    # mc "(Lora… I started for you. But now?)"
    mc "(Lora… Tôi bắt đầu vì em. Nhưng giờ thì sao?)"

# game/Story03.rpy:8040
translate vietnamese act3_5chapter2_3_430392f7:

    # mc "(Save the planet, save them all — but what for?)"
    mc "(Cứu hành tinh, cứu tất cả mọi người — nhưng để làm gì?)"

# game/Story03.rpy:8043
translate vietnamese act3_5chapter2_3_9de6c889:

    # mc "(They’ve treated me like a child from the start. Secrets, half-truths… it’s almost funny.)"
    mc "(Họ đối xử với tôi như một đứa trẻ ngay từ đầu. Bí mật, những nửa sự thật… thật buồn cười.)"

# game/Story03.rpy:8044
translate vietnamese act3_5chapter2_3_a976a5da:

