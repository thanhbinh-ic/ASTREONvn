    L "...Dù em có muốn đi nữa."

# game/Story03.rpy:1007
translate vietnamese akt3chapter1_3_3c1def74:

    # mc "And I’m someone whose patience isn’t infinite, you know."
    mc "Và em biết đấy, sự kiên nhẫn của anh cũng có hạn thôi."

# game/Story03.rpy:1014
translate vietnamese akt3chapter1_3_6f8610c8:

    # mc "So what are those things—"
    mc "Vậy những chuyện đó là gì—"

# game/Story03.rpy:1016
translate vietnamese akt3chapter1_3_7e1e7e51:

    # L "I was already there."
    L "Em vốn đã ở đó rồi."

# game/Story03.rpy:1017
translate vietnamese akt3chapter1_3_75e085dd:

    # L "On Earth."
    L "Trên Trái Đất."

# game/Story03.rpy:1018
