    # g "Caught, don't—"
    g "Bắt được rồi, đừng—"

# game/Story03.rpy:8618
translate vietnamese act3_5chapter3_b097a980:

    # Mi "(But there was another side: the abuse in our district dropped significantly.)"
    Mi "(Nhưng còn có mặt khác: tình trạng ngược đãi ở quận của chúng tôi đã giảm đáng kể.)"

# game/Story03.rpy:8619
translate vietnamese act3_5chapter3_8156c873:

    # Mi "(All it took was a couple hundred corpses. But the song didn't play long; once whispers of the Inquisition started...)"
    Mi "(Tất cả chỉ cần vài trăm thi thể. Nhưng bản nhạc đó không kéo dài lâu; một khi những lời thì thầm về Tòa án Dị giáo bắt đầu...)"

# game/Story03.rpy:8623
translate vietnamese act3_5chapter3_73696c46:

    # g "Executioner-3, Dome-1, requesting target data."
    g "Executioner-3, Dome-1, yêu cầu dữ liệu mục tiêu."

# game/Story03.rpy:8624
translate vietnamese act3_5chapter3_e520448a:

    # "Dome-1 here. Redirecting termination data. Target — a Syndicate rat."
    "Dome-1 đây. Đang chuyển tiếp dữ liệu tiêu diệt. Mục tiêu — một tên chuột của Syndicate."

# game/Story03.rpy:8625
translate vietnamese act3_5chapter3_bfb8ebcb:

    # g "Executioner-3, data received, end of transmission."
    g "Executioner-3, đã nhận dữ liệu, kết thúc truyền tin."

# game/Story03.rpy:8627
translate vietnamese act3_5chapter3_4e00fa7c:

    # gg "The seal's broken, use-of-force authorization — activated."
    gg "Niêm phong đã bị phá, ủy quyền sử dụng vũ lực — đã kích hoạt."

# game/Story03.rpy:8628
translate vietnamese act3_5chapter3_dc09b32c:

    # g "7 minutes to landing."
    g "7 phút nữa sẽ hạ cánh."

# game/Story03.rpy:8631
translate vietnamese act3_5chapter3_21216a81:

    # gg "Objective: clear the Syndicate rats' hideout. Leave no one alive."
    gg "Mục tiêu: dọn sạch hang ổ của lũ chuột Syndicate. Không để ai sống sót."

# game/Story03.rpy:8632
translate vietnamese act3_5chapter3_7bd50908:

    # k "Ugh, the Syndicate won't like that."
    k "Chà, Syndicate sẽ không thích chuyện đó đâu."

# game/Story03.rpy:8633
translate vietnamese act3_5chapter3_07ae9f20:

    # gg "That's none of your concern, Kalestra."
    gg "Đó không phải việc của cô, Kalestra."

# game/Story03.rpy:8634
translate vietnamese act3_5chapter3_25407fa9:

    # k "Sure, sure."
    k "Được rồi, được rồi."

# game/Story03.rpy:8639
translate vietnamese act3_5chapter3_3e04caa5:

    # gg "Commence execution."
    gg "Bắt đầu thi hành."

# game/Story03.rpy:8640
translate vietnamese act3_5chapter3_2b4dbb82:

    # k "Well, time to have some fun."
    k "Chà, tới lúc vui vẻ rồi đây."

# game/Story03.rpy:8644
translate vietnamese act3_5chapter3_7f983f09:

    # Mi "I had to go down to the Lower City, where light was a luxury and clean air a myth."
    Mi "Tôi phải xuống Hạ Thành, nơi ánh sáng là thứ xa xỉ còn không khí trong lành chỉ là chuyện hoang đường."

# game/Story03.rpy:8645
translate vietnamese act3_5chapter3_4d6fe7c0:

    # Mi "I stayed there for a few weeks. Thinking it would settle, but..."
    Mi "Tôi ở đó vài tuần. Nghĩ rằng mọi chuyện sẽ lắng xuống, nhưng..."

# game/Story03.rpy:8646
translate vietnamese act3_5chapter3_6dd8eee3:

    # Mi "(Whispering) Then everything only got worse..."
    Mi "(Thì thầm) Rồi mọi thứ chỉ càng tệ hơn..."

# game/Story03.rpy:8648
translate vietnamese act3_5chapter3_e61b4e3c:

    # Mi "I've done too much to live a normal life after that."
    Mi "Tôi đã làm quá nhiều chuyện để có thể sống một cuộc đời bình thường sau đó."

# game/Story03.rpy:8649
translate vietnamese act3_5chapter3_cf355909:

    # Mi "Deciding it was time to end it all."
    Mi "Quyết định rằng đã tới lúc kết thúc tất cả."

# game/Story03.rpy:8651
translate vietnamese act3_5chapter3_388a70d3:

    # Mi "But then I met her."
    Mi "Nhưng rồi tôi đã gặp cô ấy."

# game/Story03.rpy:8654
translate vietnamese act3_5chapter3_b74122d5:

    # scar "Do you want to die? Fine. But be honest — you already died down there."
    scar "Cô muốn chết sao? Được thôi. Nhưng hãy thành thật đi — cô đã chết ở dưới đó rồi."

# game/Story03.rpy:8655
translate vietnamese act3_5chapter3_2eb7a581:

    # scar "Here you're only finishing off what's left."
    scar "Ở đây cô chỉ đang kết liễu những gì còn sót lại thôi."

# game/Story03.rpy:8657
translate vietnamese act3_5chapter3_4caa0975:

    # scar "Maybe I can offer you something else?"
    scar "Có lẽ tôi có thể cho cô thứ khác?"

# game/Story03.rpy:8659
translate vietnamese act3_5chapter3_da3fdbf1_3:

    # Mi "..."
    Mi "..."

# game/Story03.rpy:8664
translate vietnamese act3_5chapter3_6f46d5c5:

    # mc "What happened after that?"
    mc "Sau đó đã xảy ra chuyện gì?"

# game/Story03.rpy:8666
translate vietnamese act3_5chapter3_55735709:

    # Mi "And then..."
    Mi "Và rồi..."

# game/Story03.rpy:8668
translate vietnamese act3_5chapter3_2b35b6fe_5:

    # mc "..."
    mc "..."

# game/Story03.rpy:8670
translate vietnamese act3_5chapter3_2ea261af:

    # Mi "I..."
    Mi "Tôi..."

# game/Story03.rpy:8675
translate vietnamese act3_5chapter3_0cf4db38:

    # zo "Why did you bring her here?! Because of her they'll destroy us all!"
    zo "Tại sao cô lại đưa cô ta tới đây?! Vì cô ta mà bọn chúng sẽ hủy diệt tất cả chúng ta!"

# game/Story03.rpy:8676
translate vietnamese act3_5chapter3_361b35a6:

    # scar "They'd been planning this for a long time; she was only the pretext."
    scar "Bọn chúng đã lên kế hoạch chuyện này từ lâu rồi; cô ta chỉ là cái cớ thôi."

# game/Story03.rpy:8678
translate vietnamese act3_5chapter3_a4c9ed56:

    # zo "What do they gain from this?! Killing the innocent for... what?!"
    zo "Bọn chúng được gì từ chuyện này?! Giết người vô tội để... làm gì?!"

# game/Story03.rpy:8679
translate vietnamese act3_5chapter3_49d226c2:

    # scar "I heard their Mistress, after losing her sister, became too cruel."
    scar "Tôi nghe nói Nữ chủ nhân của bọn chúng, sau khi mất em gái, đã trở nên quá tàn nhẫn."

# game/Story03.rpy:8681
translate vietnamese act3_5chapter3_d679bddf:

    # zo "And because of that, she decided to declare war on Ember?! She's gone mad!"
    zo "Và vì thế, bà ta đã quyết định tuyên chiến với Ember?! Bà ta điên rồi!"

# game/Story03.rpy:8682
translate vietnamese act3_5chapter3_ef1eeb0d:

    # scar "Maybe, but many believe she was the reason."
    scar "Có thể, nhưng nhiều người tin rằng cô ta chính là nguyên nhân."

# game/Story03.rpy:8687
translate vietnamese act3_5chapter3_c24b34e1:

    # Mi "I can't..."
    Mi "Tôi không thể..."

# game/Story03.rpy:8690
translate vietnamese act3_5chapter3_a0c77ab2:

    # Mi "Because of her... I'll kill them all!"
    Mi "Vì cô ta... Tôi sẽ giết hết bọn chúng!"

# game/Story03.rpy:8692
translate vietnamese act3_5chapter3_fc0c3dfb:

    # scar "Stop — your death won't change anything. We're leaving."
    scar "Dừng lại — cái chết của cô sẽ không thay đổi gì đâu. Chúng ta đi thôi."

# game/Story03.rpy:8694
translate vietnamese act3_5chapter3_59b080d7:

    # zo "And what will we do? Hand her over and betray our principles."
    zo "Và chúng ta sẽ làm gì? Giao nộp cô ta và phản bội nguyên tắc của mình sao."

# game/Story03.rpy:8695
translate vietnamese act3_5chapter3_1e135636:

    # scar "No. That's not up for discussion. We must find another way."
    scar "Không. Chuyện đó không cần bàn cãi. Chúng ta phải tìm cách khác."

# game/Story03.rpy:8697
translate vietnamese act3_5chapter3_fb8bf786:

    # zo "This is all because of you! You..."
    zo "Tất cả là vì cô! Cô..."

# game/Story03.rpy:8698
translate vietnamese act3_5chapter3_fa4e8855:

    # zo "It would've been better if you'd never been here!"
    zo "Thà rằng cô chưa từng tới đây còn hơn!"

# game/Story03.rpy:8701
translate vietnamese act3_5chapter3_75d4ca9b:

    # mc "(And... what am I supposed to do?)"
    mc "(Và... mình phải làm gì đây?)"

# game/Story03.rpy:8707
translate vietnamese act3_5chapter3_eeb1dfb9:

    # mc "(I can’t just walk away. Not after everything she’s done for me.)"
    mc "(Mình không thể cứ thế bỏ đi. Không phải sau tất cả những gì cô ấy đã làm cho mình.)"

# game/Story03.rpy:8711
translate vietnamese act3_5chapter3_db079be0:

    # mc "(Sorry, Miriel... I can’t. I’m not the kind of guy who’s good at comforting anyone anyway.)"
    mc "(Xin lỗi, Miriel... Tôi không thể. Dù sao tôi cũng không phải kiểu người giỏi an ủi ai cả.)"

# game/Story03.rpy:8713
translate vietnamese act3_5chapter3_11b1f5e8:

    # mc "I’m sorry."
    mc "Tôi xin lỗi."

# game/Story03.rpy:8714
translate vietnamese act3_5chapter3_dcb142ec:

    # Mi "Huh? For what?"
    Mi "Hả? Vì cái gì?"

# game/Story03.rpy:8716
translate vietnamese act3_5chapter3_26cd811b:

    # mc "You’ve been through hell... just felt like saying that."
    mc "Cô đã trải qua địa ngục... chỉ là tôi muốn nói vậy thôi."

# game/Story03.rpy:8717
translate vietnamese act3_5chapter3_da3fdbf1_4:

    # Mi "..."
    Mi "..."

# game/Story03.rpy:8719
translate vietnamese act3_5chapter3_5bb6b13a:

    # Mi "...Thank you."
    Mi "...Cảm ơn anh."

# game/Story03.rpy:8722
translate vietnamese act3_5chapter3_2725fb99:

    # i "Yo! Long time no see, Mir."
    i "Này! Lâu rồi không gặp, Mir."

# game/Story03.rpy:8723
translate vietnamese act3_5chapter3_94983d76:

    # Mi "Ivy?! What are you doing here?"
    Mi "Ivy?! Cô làm gì ở đây vậy?"

# game/Story03.rpy:8724
translate vietnamese act3_5chapter3_e80f4d18:

    # i "Oh, don’t play dumb — you know why I’m here."
    i "Ồ, đừng giả ngây — cô biết vì sao tôi ở đây mà."

# game/Story03.rpy:8725
translate vietnamese act3_5chapter3_8325a296:

    # i "Mind giving us a minute? I’ve got a few things to discuss with this guy."
    i "Cho chúng tôi một lát được không? Tôi có vài chuyện cần bàn với gã này."

# game/Story03.rpy:8726
translate vietnamese act3_5chapter3_da3fdbf1_5:

    # Mi "..."
    Mi "..."

# game/Story03.rpy:8727
translate vietnamese act3_5chapter3_a7995cad:

    # Mi "Make it quick."
    Mi "Nhanh lên đấy."

# game/Story03.rpy:8730
translate vietnamese act3_5chapter3_2b35b6fe_6:

    # mc "..."
    mc "..."

# game/Story03.rpy:8731
translate vietnamese act3_5chapter3_a6be913e:

    # mc "So?"
    mc "Sao nào?"

# game/Story03.rpy:8733
translate vietnamese act3_5chapter3_059dfc55:

    # i "Nothing to say?"
    i "Không có gì để nói à?"

# game/Story03.rpy:8735
translate vietnamese act3_5chapter3_27fe7123:

    # mc "Do we know each other?"
    mc "Chúng ta có quen nhau không?"

# game/Story03.rpy:8737
translate vietnamese act3_5chapter3_c09518ea:

    # i "Sort of — five days ago someone was beating an elf in the street. Remember?"
    i "Cũng gần như vậy — năm ngày trước có người đang đánh một elf giữa đường. Nhớ không?"

# game/Story03.rpy:8739
translate vietnamese act3_5chapter3_7ed632fa:

    # mc "Something like that. And?"
    mc "Cũng na ná vậy. Rồi sao?"

# game/Story03.rpy:8741
translate vietnamese act3_5chapter3_cf5ff576:

    # i "I thought maybe someone among the rest could help."
    i "Tôi nghĩ có lẽ ai đó trong số còn lại có thể giúp được."

# game/Story03.rpy:8744
translate vietnamese act3_5chapter3_7ca971c2:

    # mc "You want me to risk my life for someone I don’t even know?"
    mc "Cô muốn tôi liều mạng vì một người mà tôi còn chẳng biết à?"

# game/Story03.rpy:8747
translate vietnamese act3_5chapter3_a22f04dc:

    # i "Would you stand aside while your loved ones were beaten?"
    i "Anh có đứng nhìn trong khi người thân của mình bị đánh không?"

# game/Story03.rpy:8749
translate vietnamese act3_5chapter3_b3485305:

    # mc "Listen. Family, friends — sure, I’d step in. But a stranger?"
    mc "Nghe này. Gia đình, bạn bè — chắc chắn tôi sẽ can thiệp. Nhưng một người xa lạ thì sao?"

# game/Story03.rpy:8751
translate vietnamese act3_5chapter3_43d01b39:

    # mc "That’s not courage, that’s recklessness. So cut the sermon and tell me why you’re here."
    mc "Đó không phải dũng cảm, mà là liều lĩnh. Vậy nên đừng giảng đạo nữa, nói thẳng cô tới đây làm gì đi."

# game/Story03.rpy:8754
translate vietnamese act3_5chapter3_3e6a9159:

    # i "Unlike you, I'm ready to lend a hand."
    i "Không giống anh, tôi sẵn sàng giúp một tay."

# game/Story03.rpy:8758
translate vietnamese act3_5chapter3_2456491c:

    # mc "If we end up working together — fine. But keep your speeches short."
    mc "Nếu cuối cùng chúng ta làm việc cùng nhau — thì được thôi. Nhưng bài diễn văn của cô ngắn gọn lại."

# game/Story03.rpy:8764
translate vietnamese act3_5chapter3_1452b26e:

    # i "Good to see you again. Sorry to have interrupted."
    i "Gặp lại anh thật vui. Xin lỗi vì đã làm phiền."

# game/Story03.rpy:8766
translate vietnamese act3_5chapter3_5e9c6fb2:

    # mc "It’s fine. Don’t worry about it. But what brings you here?"
    mc "Không sao đâu. Đừng bận tâm. Nhưng điều gì đưa cô tới đây?"

# game/Story03.rpy:8768
translate vietnamese act3_5chapter3_ca2f6229:

    # i "Oh, nothing serious. I just happened to overhear you two talking and got a little... curious, that’s all."
    i "Ồ, không có gì nghiêm trọng đâu. Tôi chỉ tình cờ nghe lén hai người nói chuyện và hơi... tò mò một chút, thế thôi."

# game/Story03.rpy:8770
translate vietnamese act3_5chapter3_0b5aa7c4:

    # i "But I’ll admit, that was a surprise. Miriel—of all people—usually so cold and composed..."
    i "Nhưng tôi phải thừa nhận, đó là một bất ngờ. Miriel — trong tất cả mọi người — vốn luôn lạnh lùng và điềm tĩnh..."

# game/Story03.rpy:8771
translate vietnamese act3_5chapter3_90823c49:

    # i "She’s never been too fond of humans either. But with you... it’s different?"
    i "Cô ấy cũng chưa bao giờ ưa con người lắm. Nhưng với anh... thì khác à?"

# game/Story03.rpy:8773
translate vietnamese act3_5chapter3_5189de1f:

    # mc "I’m not blind, I see it. Even I can’t figure out what she sees in me."
    mc "Tôi không mù, tôi thấy chứ. Ngay cả tôi cũng không hiểu cô ấy thấy gì ở tôi."

# game/Story03.rpy:8774
translate vietnamese act3_5chapter3_cbbd0add:

    # mc "Just an ordinary washed-up guy tossed into a world he doesn’t belong in."
    mc "Chỉ là một gã tầm thường hết thời bị ném vào một thế giới mà hắn không thuộc về."

# game/Story03.rpy:8775
translate vietnamese act3_5chapter3_c7e56c97:

    # mc "(Guess that’s on me too. Should’ve stayed home instead of chasing ghosts.)"
    mc "(Chắc cũng tại tôi thôi. Lẽ ra nên ở nhà thay vì chạy theo những bóng ma.)"

# game/Story03.rpy:8778
translate vietnamese act3_5chapter3_bfea8df2:

    # i "You’re not that bad yourself. Deep down, there’s more to you than you let on. After all, you’re the one who saved me."
    i "Bản thân anh cũng không tệ đến vậy đâu. Sâu thẳm bên trong, anh còn nhiều hơn những gì anh thể hiện. Dù sao thì, chính anh là người đã cứu tôi."

# game/Story03.rpy:8779
translate vietnamese act3_5chapter3_08197b7d:

    # mc "...Couldn’t just walk away."
    mc "...Tôi không thể cứ bỏ đi như vậy."

# game/Story03.rpy:8782
translate vietnamese act3_5chapter3_b9ac1da0:

    # i "Exactly! That’s what I mean. We elves see what’s inside a person—that’s why she reacted that way."
    i "Chính xác! Đó là điều tôi muốn nói. Chúng tôi, elf, nhìn thấy bên trong một con người — đó là lý do cô ấy phản ứng như vậy."

# game/Story03.rpy:8784
translate vietnamese act3_5chapter3_6f3d4875:

    # i "..."
    i "..."

# game/Story03.rpy:8785
translate vietnamese act3_5chapter3_2b35b6fe_7:

    # mc "..."
    mc "..."

# game/Story03.rpy:8786
translate vietnamese act3_5chapter3_0d8c9159:

    # mc "So? That all, or you got another speech lined up?"
    mc "Sao nào? Hết rồi, hay cô còn chuẩn bị thêm bài diễn văn nào nữa?"

# game/Story03.rpy:8788
translate vietnamese act3_5chapter3_ecdd24b7:

    # i "There was another, but... I forgot it."
    i "Vốn còn một bài nữa, nhưng... tôi quên mất rồi."

# game/Story03.rpy:8790
translate vietnamese act3_5chapter3_2b35b6fe_8:

    # mc "..."
    mc "..."

# game/Story03.rpy:8791
translate vietnamese act3_5chapter3_9d9b865d:

    # mc "Liar."
    mc "Nói dối."

# game/Story03.rpy:8793
translate vietnamese act3_5chapter3_869f6da2:

    # i "Maybe. Well, come on, we'll still have time alone later."
    i "Có lẽ vậy. Thôi nào, sau này chúng ta vẫn còn thời gian riêng mà."

# game/Story03.rpy:8795
translate vietnamese act3_5chapter3_d13a3a1c:

    # mc "If you insist."
    mc "Nếu cô nhất quyết vậy."

# game/Story03.rpy:8796
translate vietnamese act3_5chapter3_bc672062:

    # i "Hee-hee."
    i "Hi hi."

# game/Story03.rpy:8802
translate vietnamese act3_5chapter3_03798924:

    # Mi "I don't want you to see me like this."
    Mi "Tôi không muốn anh thấy tôi như thế này."

# game/Story03.rpy:8804
translate vietnamese act3_5chapter3_06cff204:

    # mc "(She’s keeping her walls up… but she hasn’t walked away either.)"
    mc "(Cô ấy vẫn dựng tường phòng thủ... nhưng cô ấy cũng chưa bỏ đi.)"

# game/Story03.rpy:8807
translate vietnamese act3_5chapter3_ea4b642a:

    # mc "(If I push, I’ll scare her off. If I freeze, I’ll lose her. Got to find the balance.)"
    mc "(Nếu tôi ép, tôi sẽ dọa cô ấy chạy mất. Nếu tôi đứng yên, tôi sẽ mất cô ấy. Phải tìm được sự cân bằng.)"

# game/Story03.rpy:8816
translate vietnamese act3_5chapter3_da3fdbf1_6:

    # Mi "..."
    Mi "..."

# game/Story03.rpy:8817
translate vietnamese act3_5chapter3_e4ece9ee:

    # Mi "(A warm palm... It doesn't press, doesn't force. It just... supports.)"
