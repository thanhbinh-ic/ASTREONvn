# game/Story03.rpy:926
translate vietnamese akt3chapter1_3_c5b4e487:

    # mc "But you know... I'm glad you're here. Even like this."
    mc "Nhưng em biết không... anh mừng vì em ở đây. Dù là như thế này."

# game/Story03.rpy:928
