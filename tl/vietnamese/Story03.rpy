translate vietnamese act3_5chapter2_2_1d42bf2e:

    # L "Adjust parameters and flood the BAR, now!"
    L "Điều chỉnh thông số và bơm đầy BAR, ngay bây giờ!"
# game/Story03.rpy:7664
translate vietnamese act3_5chapter2_2_95231eb8:

    # g "Yes, ma’am!"
    g "Vâng, thưa bà!"
# game/Story03.rpy:7666
translate vietnamese act3_5chapter2_2_202b8315:

    # mc "However?"
    mc "Thế nhưng sao?"
