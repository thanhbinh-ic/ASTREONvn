    Fl "Họ... thật sự giao quyền chỉ huy cho tôi sao?"

# game/Story03.rpy:5529
translate vietnamese akt3chapter5_1_1a82d3cc:

    # L "What are you doing, darling..."
    L "Em đang làm gì vậy, cưng..."

# game/Story03.rpy:5530
