translate vietnamese endof3_5chapter_04a7d34b:

    # mc "You were the reason I dropped everything — to save your ass."
    mc "Em là lý do tôi bỏ hết mọi thứ — để cứu em."

# game/Story03.rpy:10457
translate vietnamese endof3_5chapter_5be7e1fc:

    # mc "And then I find out you could've come back the whole time?!"
    mc "Và rồi tôi phát hiện ra em đã có thể quay về suốt thời gian qua?!"

