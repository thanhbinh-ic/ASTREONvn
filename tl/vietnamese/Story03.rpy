    # mc "Ah... easy, darling."
    mc "Ah... từ từ thôi, em yêu."

# game/Story03.rpy:1375
translate vietnamese akt3chapter1_3_ac16b286:

    # mc "Loosen your grip a little."
    mc "Nới lỏng ra một chút đi."

# game/Story03.rpy:1376
translate vietnamese akt3chapter1_3_3b5f1dc8:

    # L "Mmm... I don’t want to let go, darling."
    L "Mmm... Em không muốn buông ra, anh yêu."

# game/Story03.rpy:1377
translate vietnamese akt3chapter1_3_f9fb58b8:

    # L "Besides... I know how good it feels."
    L "Với lại... em biết cảm giác đó tuyệt thế nào mà."

# game/Story03.rpy:1378
translate vietnamese akt3chapter1_3_4f259fe8:

    # mc "At this rate, I won't last much longer."
    mc "Cứ thế này, anh sẽ không trụ được lâu nữa đâu."

# game/Story03.rpy:1379
translate vietnamese akt3chapter1_3_85c07bec:

    # "She leans closer, her warm breath brushing against [mc]'s ear."
    "Cô ghé sát lại, hơi thở ấm áp lướt qua tai [mc]."

# game/Story03.rpy:1380
translate vietnamese akt3chapter1_3_a49ff1a8:

    # L "(Whispering) Then fill me to the brim."
    L "(Thì thầm) Vậy thì hãy lấp đầy em đi."

# game/Story03.rpy:1381
translate vietnamese akt3chapter1_3_0eec09e7:

    # L "(Whispering) We’ve always wanted a baby... haven’t we?"
    L "(Thì thầm) Chúng ta vẫn luôn muốn có một đứa con... phải không?"

# game/Story03.rpy:1382
translate vietnamese akt3chapter1_3_19a399e8:

    # mc "Y-you fight dirty..."
    mc "A-anh chơi xấu..."

# game/Story03.rpy:1383
translate vietnamese akt3chapter1_3_443e4361:

    # "A strained groan slips through [mc]'s clenched teeth."
    "Một tiếng rên căng thẳng thoát ra qua hàm răng nghiến chặt của [mc]."

# game/Story03.rpy:1384
translate vietnamese akt3chapter1_3_97693948:

    # mc "You know we were never able to—"
    mc "Em biết chúng ta chưa bao giờ có thể—"

# game/Story03.rpy:1385
translate vietnamese akt3chapter1_3_b914915f:

    # L "Exactly. So don’t you dare deny yourself now."
    L "Chính thế. Nên anh đừng có mà kìm nén nữa."

# game/Story03.rpy:1386
translate vietnamese akt3chapter1_3_d7bc00ca:

    # L "We are... husband and wife, after all."
    L "Dù sao thì chúng ta cũng là... vợ chồng mà."

# game/Story03.rpy:1387
translate vietnamese akt3chapter1_3_e644badd:

    # mc "You asked for it!"
    mc "Em tự chuốc lấy đấy!"

# game/Story03.rpy:1388
translate vietnamese akt3chapter1_3_e0579cc1:

    # L "(So warm...)"
    L "(Ấm quá...)"

# game/Story03.rpy:1389
translate vietnamese akt3chapter1_3_d9f51f93:

    # L "(If only... we hadn’t been infertile, perhaps...)"
    L "(Giá như... chúng ta không bị vô sinh, có lẽ...)"

# game/Story03.rpy:1390
translate vietnamese akt3chapter1_3_0daeb492:

    # L "(Perhaps our entire life would’ve turned out differently.)"
    L "(Có lẽ cả cuộc đời chúng ta đã rẽ sang một hướng khác.)"

# game/Story03.rpy:1391
translate vietnamese akt3chapter1_3_30c59968:

    # mc "Darling—!"
    mc "Em yêu—!"

# game/Story03.rpy:1411
translate vietnamese akt3chapter1_3_7dcc798e:

    # L "Take off the uniform. I’ll find you something dry."
    L "Cởi bộ đồng phục ra đi. Em sẽ tìm cho anh thứ gì đó khô ráo."

# game/Story03.rpy:1413
translate vietnamese akt3chapter1_3_095a783f:

    # mc "I think I’ll take a shower."
    mc "Anh nghĩ anh sẽ đi tắm."

# game/Story03.rpy:1415
translate vietnamese akt3chapter1_3_5c413788:

    # L "...sure."
    L "...được thôi."

# game/Story03.rpy:1426
translate vietnamese akt3chapter1_3_cbbfcb71:

    # mc "(Back in the shower...)"
    mc "(Quay lại với vòi tắm...)"

# game/Story03.rpy:1427
translate vietnamese akt3chapter1_3_41ef7a77:

    # mc "(She said something about protecting me.)"
    mc "(Em đã nói gì đó về việc bảo vệ anh.)"

# game/Story03.rpy:1428
translate vietnamese akt3chapter1_3_c862da63:

    # mc "(But from what? Or who?)"
    mc "(Nhưng khỏi cái gì? Hay khỏi ai?)"

# game/Story03.rpy:1429
translate vietnamese akt3chapter1_3_25be60e8:

    # L "Tell me, darling... Is something troubling you?"
    L "Nói cho em nghe đi, anh yêu... Có chuyện gì đang làm anh phiền lòng sao?"

# game/Story03.rpy:1431
translate vietnamese akt3chapter1_3_f87e56a4:

    # L "Although... what a foolish question."
    L "Dù sao thì... đúng là câu hỏi ngớ ngẩn thật."

# game/Story03.rpy:1432
translate vietnamese akt3chapter1_3_f795c40a:

    # L "Of course something is. The only question is what."
    L "Dĩ nhiên là có rồi. Vấn đề duy nhất là chuyện gì."

# game/Story03.rpy:1433
translate vietnamese akt3chapter1_3_6a2650f0_1:

    # mc "Just one thing."
    mc "Chỉ một điều thôi."

# game/Story03.rpy:1434
translate vietnamese akt3chapter1_3_c09b6015:

    # mc "What happened to you?"
    mc "Chuyện gì đã xảy ra với em vậy?"

# game/Story03.rpy:1436
translate vietnamese akt3chapter1_3_7f3fc9d8:

    # L "I’m afraid I can’t tell you that yet."
    L "Em sợ là em chưa thể nói cho anh biết được."

# game/Story03.rpy:1437
translate vietnamese akt3chapter1_3_c61200ad:

    # L "I’m doing this to protect you."
    L "Em làm vậy là để bảo vệ anh."

# game/Story03.rpy:1438
translate vietnamese akt3chapter1_3_93a9b2a0:

    # mc "Lor—"
    mc "Lor—"

# game/Story03.rpy:1439
translate vietnamese akt3chapter1_3_47c485c3:

    # L "And before you start pressing me, if I told you the truth now, then, let us say..."
    L "Và trước khi anh gặng hỏi em, nếu giờ em nói hết sự thật cho anh nghe thì... cứ cho là..."

# game/Story03.rpy:1440
translate vietnamese akt3chapter1_3_be86c20b:

    # L "I would only hasten the inevitable."
    L "Em chỉ khiến điều không thể tránh khỏi đến nhanh hơn mà thôi."

# game/Story03.rpy:1442
translate vietnamese akt3chapter1_3_0048c5e5:

    # L "And I... would rather remain in this moment a little longer..."
    L "Và em... thà ở lại khoảnh khắc này thêm một chút nữa..."

# game/Story03.rpy:1443
translate vietnamese akt3chapter1_3_b9ec6ea2:

    # L "(For the first time in twenty deaths, I found you again... My darling...)"
    L "(Lần đầu tiên sau hai mươi cái chết, em lại tìm thấy anh... Anh yêu của em...)"

# game/Story03.rpy:1444
translate vietnamese akt3chapter1_3_252c524a:

    # mc "But I need to—"
    mc "Nhưng anh cần phải—"

# game/Story03.rpy:1445
translate vietnamese akt3chapter1_3_8f55d119:

    # L "It would break you..."
    L "Nó sẽ khiến anh suy sụp..."

# game/Story03.rpy:1446
translate vietnamese akt3chapter1_3_18b8e1a5:

    # mc "Lora, you know I'm stronger than I look."
    mc "Lora, em biết anh mạnh mẽ hơn vẻ ngoài mà."

# game/Story03.rpy:1447
translate vietnamese akt3chapter1_3_cac99607:

    # L "(Whispering) ...But you haven’t died yet."
    L "(Thì thầm) ...Nhưng anh vẫn chưa chết."

# game/Story03.rpy:1449
translate vietnamese akt3chapter1_3_a97668c8:

    # "She throws herself into [mc]'s arms."
    "Cô lao vào vòng tay [mc]."

# game/Story03.rpy:1451
translate vietnamese akt3chapter1_3_110d9398:

    # mc "Alright... if you won't tell me, so be it."
    mc "Được rồi... nếu em không chịu nói, vậy thì thôi."

# game/Story03.rpy:1452
translate vietnamese akt3chapter1_3_2a59240e:

    # mc "That's what I'd like to say."
    mc "Đó là điều anh muốn nói."

# game/Story03.rpy:1453
translate vietnamese akt3chapter1_3_ed24910c:

    # mc "But I need something, darling. Anything you can give me."
    mc "Nhưng anh cần một điều gì đó, em yêu. Bất cứ thứ gì em có thể cho anh."

# game/Story03.rpy:1454
translate vietnamese akt3chapter1_3_2ea66e78:

    # mc "You say you wanted to protect me... But all you did was leave me helpless."
    mc "Em nói em muốn bảo vệ anh... Nhưng rốt cuộc em chỉ để mặc anh bất lực."

# game/Story03.rpy:1456
translate vietnamese akt3chapter1_3_04ead3c0:

    # L "...That isn’t the problem, darling."
    L "...Đó không phải là vấn đề, anh yêu."

# game/Story03.rpy:1457
translate vietnamese akt3chapter1_3_c3a41dff:

    # L "The problem is that even if you knew the whole truth, you still couldn’t change anything."
    L "Vấn đề là dù anh có biết toàn bộ sự thật, anh vẫn không thể thay đổi được gì."

# game/Story03.rpy:1459
translate vietnamese akt3chapter1_3_c9742425:

    # mc "...That's a bleak way of looking at it."
    mc "...Nhìn như vậy ảm đạm quá."

# game/Story03.rpy:1460
translate vietnamese akt3chapter1_3_d27efc64:

    # mc "There has to be a way out."
    mc "Chắc chắn phải có lối thoát."

# game/Story03.rpy:1461
translate vietnamese akt3chapter1_3_fdfc520b:

    # mc "I'm sure of it."
    mc "Anh chắc chắn như vậy."

# game/Story03.rpy:1463
translate vietnamese akt3chapter1_3_a190e728:

    # L "A way out..."
    L "Một lối thoát..."

# game/Story03.rpy:1464
translate vietnamese akt3chapter1_3_811fac5a:

    # L "There were references to Gates in the ruins beyond the walls."
    L "Trong đống tàn tích bên ngoài bức tường đã có nhắc tới các Cổng."

# game/Story03.rpy:1466
translate vietnamese akt3chapter1_3_4cf22874:

    # mc "Gates?"
    mc "Cổng ư?"

# game/Story03.rpy:1467
translate vietnamese akt3chapter1_3_4b29455c:

    # mc "The same kind that exploded a few moments ago?"
    mc "Cùng loại với cái mới nổ tung cách đây không lâu sao?"

# game/Story03.rpy:1469
translate vietnamese akt3chapter1_3_1cfdca51:

    # L "...I haven’t had the chance to enter one myself."
    L "...Em vẫn chưa có cơ hội bước vào cái nào cả."

# game/Story03.rpy:1470
translate vietnamese akt3chapter1_3_7ab689cc:

    # L "But Astoria has a plan that might change that."
    L "Nhưng Astoria có một kế hoạch có thể thay đổi điều đó."

# game/Story03.rpy:1472
translate vietnamese akt3chapter1_3_45f71878:

    # mc "So those gates are our way out?"
    mc "Vậy những cánh cổng đó là lối thoát của chúng ta sao?"

# game/Story03.rpy:1474
translate vietnamese akt3chapter1_3_d4e6c18c:

    # L "...Yeah."
    L "...Ừ."

# game/Story03.rpy:1475
translate vietnamese akt3chapter1_3_18e14eba:

    # L "I don’t know where they lead, but... they’re the only possibility we haven’t exhausted yet."
    L "Em không biết chúng dẫn tới đâu, nhưng... đó là khả năng duy nhất chúng ta chưa thử qua."

# game/Story03.rpy:1477
translate vietnamese akt3chapter1_3_45407191:

    # mc "...Sounds promising."
    mc "...Nghe có vẻ hứa hẹn đấy."

# game/Story03.rpy:1478
translate vietnamese akt3chapter1_3_7f31e1bc:

    # mc "But if it were that simple, you wouldn't be trying so hard to hide it from me."
    mc "Nhưng nếu đơn giản như vậy, em đã không cố giấu anh kỹ thế."

# game/Story03.rpy:1479
translate vietnamese akt3chapter1_3_876dfb39:

    # mc "What's the catch?"
    mc "Cái bẫy ở đây là gì?"

# game/Story03.rpy:1481
translate vietnamese akt3chapter1_3_9bb690ed:

    # L "Let’s just..."
    L "Cứ như thế này đã..."

# game/Story03.rpy:1483
translate vietnamese akt3chapter1_3_01adfc13:

    # L "Stay like this a little longer."
    L "Ở như thế này thêm một lúc nữa đi."

# game/Story03.rpy:1486
translate vietnamese akt3chapter1_3_5552bbc4:

    # mc "Avoiding it again?"
    mc "Lại tránh né nữa sao?"

# game/Story03.rpy:1488
translate vietnamese akt3chapter1_3_2012380b:

    # L "Because..."
    L "Bởi vì..."

# game/Story03.rpy:1494
translate vietnamese akt3chapter1_3_86d75e27:

    # L "I’ll explain... Just not now."
    L "Em sẽ giải thích... Chỉ là không phải bây giờ."

# game/Story03.rpy:1495
translate vietnamese akt3chapter1_3_46543b5c:

    # L "Okay?"
    L "Được không?"

# game/Story03.rpy:1498
translate vietnamese akt3chapter1_3_e2651856:

    # mc "You’re insatiable..."
    mc "Em thật là không biết đủ..."

# game/Story03.rpy:1504
translate vietnamese akt3chapter1_3_f201598b:

    # L "Come here."
    L "Lại đây."

# game/Story03.rpy:1505
translate vietnamese akt3chapter1_3_0eb1bd99:

    # L "Let me forget about all of this for a while."
    L "Để em quên hết mọi chuyện này đi một lúc."

# game/Story03.rpy:1507
translate vietnamese akt3chapter1_3_55951dd8:

    # mc "Oh... What are you—"
    mc "Ồ... Em đang—"

# game/Story03.rpy:1509
translate vietnamese akt3chapter1_3_26b99e20:

    # L "Just thinking out loud."
    L "Chỉ là đang nghĩ thành tiếng thôi."

# game/Story03.rpy:1513
translate vietnamese akt3chapter1_3_d7bee0bd:

    # L "God... I missed you."
    L "Trời ơi... Em nhớ anh quá."

# game/Story03.rpy:1516
translate vietnamese akt3chapter1_3_d12ded33:

    # mc "You’re different tonight..."
    mc "Tối nay em khác lạ..."

# game/Story03.rpy:1517
translate vietnamese akt3chapter1_3_742c0d49:

    # L "I’m trying not to think."
    L "Em đang cố không nghĩ ngợi."

# game/Story03.rpy:1519
translate vietnamese akt3chapter1_3_1b738645:

    # L "You still look at me like I’m me."
    L "Anh vẫn nhìn em như thể em vẫn là em."

# game/Story03.rpy:1521
translate vietnamese akt3chapter1_3_bf45bc7a:

    # L "Even now..."
    L "Ngay cả bây giờ..."

# game/Story03.rpy:1522
translate vietnamese akt3chapter1_3_bc1b572a:

    # L "you still let your guard down around me."
    L "anh vẫn thả lỏng cảnh giác khi ở bên em."

# game/Story03.rpy:1524
translate vietnamese akt3chapter1_3_a40c1e32:

    # L "Even now... you still trust me."
    L "Ngay cả bây giờ... anh vẫn tin tưởng em."

# game/Story03.rpy:1526
translate vietnamese akt3chapter1_3_70b11ee7:

    # mc "I’m trying to."
    mc "Anh đang cố đấy."

# game/Story03.rpy:1528
translate vietnamese akt3chapter1_3_096e26d8:

    # L "What?"
    L "Cái gì?"

# game/Story03.rpy:1536
translate vietnamese akt3chapter1_3_65e77a79:

    # mc "You always knew exactly what to do."
    mc "Em luôn biết chính xác phải làm gì."

# game/Story03.rpy:1537
translate vietnamese akt3chapter1_3_55aeb35c:

    # L "...No."
    L "...Không."

# game/Story03.rpy:1538
translate vietnamese akt3chapter1_3_935b2046:

    # L "I was terrified of losing it."
    L "Em đã sợ chết khiếp vì sợ mình đánh mất điều đó."

# game/Story03.rpy:1540
translate vietnamese akt3chapter1_3_6f887114:

    # mc "Then stop thinking."
    mc "Vậy thì đừng nghĩ nữa."

# game/Story03.rpy:1541
translate vietnamese akt3chapter1_3_d0ee8d4c:

    # mc "Just be here with me."
    mc "Chỉ cần ở đây với anh thôi."

# game/Story03.rpy:1543
translate vietnamese akt3chapter1_3_6411bb44:

    # L "Careful..."
    L "Cẩn thận đấy..."

# game/Story03.rpy:1544
translate vietnamese akt3chapter1_3_e55e5833:

    # L "I still know all your weak spots."
    L "Em vẫn biết hết mọi điểm yếu của anh."

# game/Story03.rpy:1545
translate vietnamese akt3chapter1_3_83f2c02c:

    # mc "You already do."
    mc "Em vốn đã thế rồi."

# game/Story03.rpy:1553
translate vietnamese akt3chapter1_3_583c9f0d:

    # L "UGHH♥"
    L "UGHH♥"

# game/Story03.rpy:1554
translate vietnamese akt3chapter1_3_bf3d67aa:

    # mc "Still resisting?"
    mc "Vẫn còn chống cự sao?"

# game/Story03.rpy:1555
translate vietnamese akt3chapter1_3_1d7016ef:

    # L "UGHHHHH♥"
    L "UGHHHHH♥"

# game/Story03.rpy:1556
translate vietnamese akt3chapter1_3_78741f58:

    # L "I... I can still resist..."
    L "E... Em vẫn còn chống cự được..."

# game/Story03.rpy:1557
translate vietnamese akt3chapter1_3_49816fbb:

    # mc "You can stop anytime."
    mc "Em có thể dừng lại bất cứ lúc nào."

# game/Story03.rpy:1558
translate vietnamese akt3chapter1_3_2653b46c:

    # L "No."
    L "Không."

# game/Story03.rpy:1559
translate vietnamese akt3chapter1_3_eb60968a:

    # L "Not yet."
    L "Chưa đâu."

# game/Story03.rpy:1560
translate vietnamese akt3chapter1_3_daa40ee2:

    # L "MHM♥♥...."
    L "MHM♥♥...."

# game/Story03.rpy:1573
translate vietnamese akt3chapter1_3_46654574:

    # L "I missed this version of us."
    L "Em nhớ chúng ta như thế này."

# game/Story03.rpy:1574
translate vietnamese akt3chapter1_3_74fc6761:

    # mc "Me too."
    mc "Anh cũng vậy."

# game/Story03.rpy:1575
translate vietnamese akt3chapter1_3_7c0cd174:

    # L "This doesn’t erase what happened. We’re not back where we were."
    L "Điều này không xóa được những gì đã xảy ra. Chúng ta không quay lại như trước được."

# game/Story03.rpy:1576
translate vietnamese akt3chapter1_3_bb9b902d:

    # mc "I know. We start with the truth."
    mc "Anh biết. Chúng ta bắt đầu từ sự thật."

# game/Story03.rpy:1577
translate vietnamese akt3chapter1_3_6e728946:

    # L "Then one truth before you sleep."
    L "Vậy thì một sự thật trước khi anh ngủ."

# game/Story03.rpy:1578
translate vietnamese akt3chapter1_3_40280eb2:

    # L "The Abyss isn’t a place. It’s what the gates tear open."
    L "Vực Thẳm không phải là một nơi. Nó là thứ mà các cánh cổng xé toạc ra."

# game/Story03.rpy:1579
translate vietnamese akt3chapter1_3_3eae62ec:

    # L "I can survive inside it. That’s why they’re hunting me."
    L "Em có thể sống sót bên trong nó. Đó là lý do họ săn lùng em."

# game/Story03.rpy:1580
translate vietnamese akt3chapter1_3_08fa3c25:

    # mc "We finish this conversation when we wake up."
    mc "Chúng ta sẽ nói nốt chuyện này khi tỉnh dậy."

# game/Story03.rpy:1581
translate vietnamese akt3chapter1_3_c2f2ade4:

    # mc "Good night, Lora."
    mc "Ngủ ngon nhé, Lora."

# game/Story03.rpy:1590
translate vietnamese akt3chapter1_3_be8f1a89:

    # L "I'm sorry..."
    L "Em xin lỗi..."

# game/Story03.rpy:1591
translate vietnamese akt3chapter1_3_65c425c5:

    # L "I pushed too far. It’s just... all of it’s been piling up."
    L "Em đã đi quá xa. Chỉ là... mọi chuyện cứ chất chồng lên nhau."

# game/Story03.rpy:1595
translate vietnamese akt3chapter1_3_e5544801:

    # mc "I get it."
    mc "Anh hiểu mà."

# game/Story03.rpy:1596
