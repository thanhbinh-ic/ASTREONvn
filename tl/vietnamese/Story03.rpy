    gg "Các người quá đáng lắm rồi!"

# game/Story03.rpy:5547
translate vietnamese akt3chapter5_1_c6f3f8db:

    # ggg "Have you all lost your minds?!"
    ggg "Tất cả các người mất trí hết rồi sao?!"

