translate vietnamese act3_5chapter2_2_7f811734:

    # y "However..."
    y "Thế nhưng…"
# game/Story03.rpy:7661
translate vietnamese act3_5chapter2_2_d2558c8a:

    # L "The readings are shifting — this isn’t Earth!"
    L "Các chỉ số đang thay đổi — đây không phải là Trái Đất!"
