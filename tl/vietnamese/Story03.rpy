    mc "Đủ trò phô trương rồi."

# game/Story03.rpy:5574
translate vietnamese akt3chapter5_1_2562ad6f:

    # mc "Move."
    mc "Di chuyển đi."

# game/Story03.rpy:5588
translate vietnamese akt3chapter5_1_d8df9d56:

    # mc "(Quite a crowd out there.)"
    mc "(Ngoài kia đông người thật.)"

# game/Story03.rpy:5590
translate vietnamese akt3chapter5_1_7468f756:

    # L "Calm down, girl. We've been through this already."
    L "Bình tĩnh nào, cô bé. Chúng ta đã trải qua chuyện này rồi."

