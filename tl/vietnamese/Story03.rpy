translate vietnamese akt3chapter1_3_c4843cea:

    # mc "Don’t be dramatic. Looks decent enough."
    mc "Đừng làm quá lên. Trông cũng ổn mà."

# game/Story03.rpy:971
translate vietnamese akt3chapter1_3_8fc7a981:

