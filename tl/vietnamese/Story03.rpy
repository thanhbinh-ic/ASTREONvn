# game/Story03.rpy:7687
translate vietnamese act3_5chapter2_2_7c1e1c9f:

    # aa "(whispering) No…"
    aa "(thì thầm) Không…"
# game/Story03.rpy:7694
translate vietnamese act3_5chapter2_2_c1fe3d7f:

    # mc "LORA!"
    mc "LORA!"
# game/Story03.rpy:7697
