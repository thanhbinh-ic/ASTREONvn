# game/Story03.rpy:10382
translate vietnamese endof3_5chapter_eeaccfd8:

    # L "I lie to my husband, I make him suffer even more."
    L "Em nói dối chồng em, em làm anh ấy đau khổ thêm nữa."

# game/Story03.rpy:10383
translate vietnamese endof3_5chapter_9e334457:

    # L "Yeah, Lora — you're just awful."
    L "Ừ, Lora — cô thật tệ hại."

# game/Story03.rpy:10389
translate vietnamese endof3_5chapter_49a8888a:

    # L "Let him hate me, let them despise me."
    L "Cứ để anh ấy ghét em, cứ để họ khinh bỉ em."

# game/Story03.rpy:10390
translate vietnamese endof3_5chapter_7728af51:

    # L "Let the whole world turn against me."
