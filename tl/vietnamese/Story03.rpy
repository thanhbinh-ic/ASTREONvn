    L "Hai người đã trở nên thân thiết. Có lẽ là quá thân thiết."

# game/Story03.rpy:10425
translate vietnamese endof3_5chapter_74800e06:

    # L "Calm down… don't get angry. We've been through this."
    L "Bình tĩnh lại… đừng nổi giận. Chúng ta đã trải qua chuyện này rồi."

