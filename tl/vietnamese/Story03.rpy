    L "Ai cũng nói vậy..."

# game/Story03.rpy:972
translate vietnamese akt3chapter1_3_fd73adf7:

    # L "Right before it starts eating through them."
    L "Ngay trước khi nó bắt đầu ăn mòn họ."

# game/Story03.rpy:976
translate vietnamese akt3chapter1_3_4f8b99c1:

    # L "Relax. I’m joking."
    L "Thư giãn đi. Em đùa thôi."

# game/Story03.rpy:977
translate vietnamese akt3chapter1_3_f2a62bfb:

    # L "...Mostly."
    L "...Phần lớn là vậy."

# game/Story03.rpy:979
translate vietnamese akt3chapter1_3_4d9d84b6:

    # mc "All these years, and your jokes still catch me off guard."
    mc "Bao nhiêu năm rồi, mà trò đùa của em vẫn khiến anh bất ngờ."

# game/Story03.rpy:981
translate vietnamese akt3chapter1_3_d03d467c:

    # L "And I missed that little scowl you always gave me after."
    L "Và em đã nhớ cái cau mày nho nhỏ anh vẫn luôn dành cho em sau đó."

# game/Story03.rpy:982
translate vietnamese akt3chapter1_3_25dcc43a:

    # L "Besides, they’re not that bad. {w}Well... mostly."
    L "Với lại, chúng cũng không tệ lắm đâu. {w}À... phần lớn là vậy."

# game/Story03.rpy:984
translate vietnamese akt3chapter1_3_f16c798b:

    # mc "If you say so."
    mc "Nếu em nói vậy."

# game/Story03.rpy:991
translate vietnamese akt3chapter1_3_918e6f51:

    # mc "So, here we are. Just the two of us."
    mc "Vậy, chúng ta ở đây rồi. Chỉ có hai chúng ta."

