translate vietnamese akt3chapter2_2_feb629ba:

    # k "You. The princess. And sweet little Lora. One loud, desperate cry for help."
    k "Cậu. Công chúa. Và Lora bé bỏng đáng yêu. Một tiếng kêu cứu to và tuyệt vọng."

# game/Story03.rpy:2766
translate vietnamese akt3chapter2_2_d8291caa:

    # k "So I came. Did you miss me?"
    k "Nên tôi đã tới. Cậu có nhớ tôi không?"

