# game/Story03.rpy:10370
translate vietnamese endof3_5chapter_4d605578:

    # L "(I'm sorry, darling... this is for our own safety.)"
    L "(Em xin lỗi, anh yêu… chuyện này là vì sự an toàn của chúng ta.)"

