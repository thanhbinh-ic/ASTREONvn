    # ggg "That’s suicide!"
    ggg "Đó là tự sát!"

# game/Story03.rpy:5742
translate vietnamese akt3chapter5_1_d29a4c68:

    # Fl "Then we have the same expectations."
    Fl "Vậy thì chúng ta có cùng kỳ vọng rồi."

# game/Story03.rpy:5743
translate vietnamese akt3chapter5_1_0061b368_2:

    # ggg "..."
    ggg "..."

# game/Story03.rpy:5745
translate vietnamese akt3chapter5_1_a46bb0f1:

    # Fl "Second phase is taking back the central tower."
