    L "Những lựa chọn khác nhau."

# game/Story03.rpy:1106
translate vietnamese akt3chapter1_3_930a5d6d:

    # L "Every cycle ended the same way."
    L "Mọi vòng lặp đều kết thúc cùng một cách."

# game/Story03.rpy:1108
