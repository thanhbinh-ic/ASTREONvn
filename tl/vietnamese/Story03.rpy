    mc "Em thật sự không định cho anh lựa chọn gì, phải không?"

# game/Story03.rpy:10232
translate vietnamese ivy_meetings_7204c85f:

    # i "What can I say… I like the view from here."
    i "Tôi biết nói sao… Tôi thích góc nhìn từ đây."

# game/Story03.rpy:10235
translate vietnamese ivy_meetings_732ab812:

