translate vietnamese akt3chapter3_1_ebd80908:

    # mc "(But every extra minute puts us all at risk. And how do I face Lora then?...)"
    mc "(Nhưng mỗi phút thừa ra đều khiến tất cả chúng ta gặp nguy hiểm. Và rồi tôi biết đối mặt với Lora thế nào đây?...)"

# game/Story03.rpy:3663
translate vietnamese akt3chapter3_1_db1d03c7:

