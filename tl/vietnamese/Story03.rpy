translate vietnamese akt3chapter1_3_d75cf13e:

    # L "Yeah..."
    L "Ừ..."

# game/Story03.rpy:997
translate vietnamese akt3chapter1_3_39e95b64:

    # mc "...So. What happened to you?"
    mc "...Vậy. Đã có chuyện gì xảy ra với em?"

# game/Story03.rpy:1002
translate vietnamese akt3chapter1_3_d6185d2a:

    # mc "You’ve got no reason to stay silent now."
    mc "Giờ em chẳng có lý do gì để im lặng nữa."

# game/Story03.rpy:1004
translate vietnamese akt3chapter1_3_df9bdc07:

    # L "There are things I can’t tell you."
    L "Có những chuyện em không thể nói với anh."

# game/Story03.rpy:1005
translate vietnamese akt3chapter1_3_c14b089b:

