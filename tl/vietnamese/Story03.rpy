    # L "I don’t think I deserve it."
    L "Em không nghĩ mình xứng đáng được tha thứ."

# game/Story03.rpy:1129
translate vietnamese akt3chapter1_3_dbc24939:

    # mc "Then why are you here?"
    mc "Vậy tại sao em lại ở đây?"

# game/Story03.rpy:1131
translate vietnamese akt3chapter1_3_14e771d1:

    # L "So you hate me for the truth. Not for what you imagined."
    L "Để anh ghét em vì sự thật. Chứ không phải vì những gì anh tưởng tượng."

# game/Story03.rpy:1133
translate vietnamese akt3chapter1_3_fc9d01dd:

    # mc "I don’t know if I can hate you."
    mc "Anh không biết mình có ghét nổi em không."

# game/Story03.rpy:1135
translate vietnamese akt3chapter1_3_9ae11234:

    # L "You should."
    L "Anh nên ghét."

# game/Story03.rpy:1136
translate vietnamese akt3chapter1_3_5c317059:

    # L "I ran. Then I disappeared."
    L "Em đã bỏ chạy. Rồi em biến mất."

# game/Story03.rpy:1140
translate vietnamese akt3chapter1_3_bb3bbdf0:

    # L "I was afraid that if I came back and saw what I’d done to you... I wouldn’t survive it."
    L "Em sợ rằng nếu em quay lại và thấy những gì em đã gây ra cho anh... em sẽ không chịu nổi."

# game/Story03.rpy:1145
translate vietnamese akt3chapter1_3_1efff873:

    # mc "You were everything I had."
    mc "Em là tất cả những gì anh có."

# game/Story03.rpy:1146
