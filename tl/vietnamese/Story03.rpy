    # Mi "(Life was worth less than a magazine of ammo. Nobody cared about things like that.)"
    Mi "(Mạng sống còn rẻ hơn một băng đạn. Chẳng ai quan tâm tới những chuyện như vậy.)"

# game/Story03.rpy:8547
translate vietnamese act3_5chapter3_c26e77e8:

    # Mi "(Some tried, but their bodies were found the next day — nobody sane would stand up to that.)"
    Mi "(Có người đã thử, nhưng thi thể của họ được tìm thấy vào ngày hôm sau — chẳng người tỉnh táo nào dám chống lại chuyện đó.)"

# game/Story03.rpy:8550
translate vietnamese act3_5chapter3_ae401e9b:

    # Mi "(I wasn't an exception.)"
    Mi "(Tôi cũng không phải ngoại lệ.)"

# game/Story03.rpy:8551
translate vietnamese act3_5chapter3_4a17bee1:

    # Mi "(Usually I would have gotten out with the data and forgotten it like a nightmare.)"
    Mi "(Thông thường tôi sẽ thoát ra cùng dữ liệu và quên nó đi như một cơn ác mộng.)"

# game/Story03.rpy:8553
translate vietnamese act3_5chapter3_d340bd67:

    # Mi "(But that night, maybe from exhaustion, maybe from thinking about justice...)"
    Mi "(Nhưng đêm đó, có lẽ vì kiệt sức, có lẽ vì nghĩ về công lý...)"

# game/Story03.rpy:8555
