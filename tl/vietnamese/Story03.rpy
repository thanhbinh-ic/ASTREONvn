    # mc "And each other."
    mc "Và lẫn nhau."

# game/Story03.rpy:5696
translate vietnamese akt3chapter5_1_b5fd579d:

    # mc "And people willing to stand beside you."
    mc "Và những người sẵn sàng đứng bên cạnh các bạn."

# game/Story03.rpy:5699
translate vietnamese akt3chapter5_1_05592b27:

    # mc "If you can still stand — stand."
    mc "Nếu các bạn vẫn còn đứng được — thì hãy đứng lên."

# game/Story03.rpy:5706
translate vietnamese akt3chapter5_1_fbaa6d26:

    # mc "And if you’re afraid..."
    mc "Và nếu các bạn sợ hãi..."

# game/Story03.rpy:5707
translate vietnamese akt3chapter5_1_ac313663:

    # mc "So am I."
    mc "Tôi cũng vậy."

# game/Story03.rpy:5708
translate vietnamese akt3chapter5_1_29610376:

    # mc "Move anyway."
    mc "Dù vậy vẫn phải tiến lên."

# game/Story03.rpy:5711
translate vietnamese akt3chapter5_1_0061b368_1:

    # ggg "..."
    ggg "..."

# game/Story03.rpy:5712
translate vietnamese akt3chapter5_1_7cf243cc:

    # gg "...This is madness. And this is your plan?"
    gg "...Đây là điên rồ. Và đây là kế hoạch của các người sao?"

# game/Story03.rpy:5713
translate vietnamese akt3chapter5_1_94374d89:

    # g "I'd rather run than... this."
    g "Tôi thà chạy trốn còn hơn... làm chuyện này."

# game/Story03.rpy:5716
translate vietnamese akt3chapter5_1_9939c474:

