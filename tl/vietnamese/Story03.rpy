translate vietnamese akt3chapter5_1_f35d5059:

    # gg "Wasting our time... We’re doomed either way..."
    gg "Phí thời gian của chúng ta... Đằng nào chúng ta cũng tiêu rồi..."

# game/Story03.rpy:5650
translate vietnamese akt3chapter5_1_0a317cc2:

    # mc "(Tired. Angry. Starving for someone to lead them.)"
    mc "(Mệt mỏi. Tức giận. Khao khát có người dẫn dắt.)"

# game/Story03.rpy:5652
translate vietnamese akt3chapter5_1_2b35b6fe_3:

    # mc "..."
    mc "..."

# game/Story03.rpy:5654
translate vietnamese akt3chapter5_1_d0e40f57:

    # mc "SURVIVE!"
    mc "SỐNG SÓT!"

# game/Story03.rpy:5655
translate vietnamese akt3chapter5_1_0061b368:

    # ggg "..."
    ggg "..."

