    mc "(Em đang lảng tránh...)"

# game/Story03.rpy:937
translate vietnamese akt3chapter1_3_f2a9d106:

    # mc "The cozy part, that’s you. The room’s just an empty box."
    mc "Phần ấm cúng ấy, chính là em. Căn phòng chỉ là một cái hộp trống thôi."

# game/Story03.rpy:938
translate vietnamese akt3chapter1_3_d34c2f32:

    # L "Oh, my silver-tongued poet… Just give it a little clean—"
    L "Ôi, nhà thơ miệng lưỡi ngọt ngào của em... Chỉ cần dọn dẹp một chút thôi—"

# game/Story03.rpy:939
translate vietnamese akt3chapter1_3_7d57ef15:

    # L "You’ll see. It’ll come to life."
    L "Anh sẽ thấy. Nó sẽ trở nên sống động."

# game/Story03.rpy:942
translate vietnamese akt3chapter1_3_3c2f682a:

