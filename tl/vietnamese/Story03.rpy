translate vietnamese act3_5chapter2_2_cdf683da:

    # y "And she’s a key figure in all of this."
    y "Và cô ấy là nhân vật chủ chốt trong tất cả chuyện này."
# game/Story03.rpy:7671
translate vietnamese act3_5chapter2_2_15258e30:

    # g "We’ve done it—"
    g "Chúng ta làm được rồi—"
