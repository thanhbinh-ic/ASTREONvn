    Fl "(Họ... tin tưởng mình.)"

# game/Story03.rpy:5720
translate vietnamese akt3chapter5_1_2c77e49d:

    # Fl "(I don’t get to fall apart now.)"
    Fl "(Giờ mình không được phép gục ngã.)"

# game/Story03.rpy:5722
translate vietnamese akt3chapter5_1_c665a285:

    # Fl "I... I’ll do my best."
    Fl "Tôi... Tôi sẽ cố hết sức."

