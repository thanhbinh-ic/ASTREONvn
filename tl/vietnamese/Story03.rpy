# game/Story03.rpy:10405
translate vietnamese endof3_5chapter_ede19693:

    # L "Maybe I should've told everything?..."
    L "Có lẽ em nên kể hết mọi chuyện?…"

# game/Story03.rpy:10409
translate vietnamese endof3_5chapter_0ed15f5c:

