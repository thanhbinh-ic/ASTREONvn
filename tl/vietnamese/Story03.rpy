    # k "Mm. Efficient."
    k "Ừm. Hiệu quả đấy."

# game/Story03.rpy:5559
translate vietnamese akt3chapter5_1_5f760176:

    # k "So, what were you saying, boys? Couldn’t hear you over your teeth chattering."
    k "Vậy, các anh vừa nói gì thế? Tôi không nghe rõ vì răng các anh đang va vào nhau."

# game/Story03.rpy:5560
translate vietnamese akt3chapter5_1_752b8262:

    # gg "..."
    gg "..."

# game/Story03.rpy:5561
translate vietnamese akt3chapter5_1_0769102a:

    # k "Take them away. Gently. With nails."
    k "Lôi chúng đi. Nhẹ nhàng thôi. Bằng móng tay."

# game/Story03.rpy:5563
translate vietnamese akt3chapter5_1_131f4000:

    # k "Justice prevails, as always!"
    k "Công lý luôn chiến thắng, như mọi khi!"

