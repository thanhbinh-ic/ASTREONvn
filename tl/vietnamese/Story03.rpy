    # gg "(Whispering) And the old command was ready to leave them there."
    gg "(Thì thầm) Và bộ chỉ huy cũ đã sẵn sàng bỏ mặc họ ở đó."

# game/Story03.rpy:5516
translate vietnamese akt3chapter5_1_4c325193:

    # em "Now things are getting interesting."
    em "Giờ thì mọi chuyện bắt đầu thú vị rồi."

# game/Story03.rpy:5518
translate vietnamese akt3chapter5_1_de055f8c:

