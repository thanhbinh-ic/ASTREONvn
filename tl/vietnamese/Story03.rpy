# game/Story03.rpy:10247
translate vietnamese ivy_meetings_7dc6dced_1:

    # i "Touché…"
    i "Chạm đúng chỗ đau rồi…"

# game/Story03.rpy:10248
translate vietnamese ivy_meetings_d2050b3e:

    # i "Don’t… don’t slow down now. Please—"
