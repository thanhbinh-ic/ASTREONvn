# game/Story03.rpy:10395
translate vietnamese endof3_5chapter_72f2e7d2:

    # L "I won't let him die… not this time."
    L "Em sẽ không để anh ấy chết… không phải lần này."

# game/Story03.rpy:10400
translate vietnamese endof3_5chapter_39e95b64:

