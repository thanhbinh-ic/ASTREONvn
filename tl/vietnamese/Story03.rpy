translate vietnamese akt3chapter5_1_b359d44f:

    # Fl "To freeze the Soulless. With cryogen."
    Fl "Đóng băng bọn Vô hồn. Bằng cryogen."

# game/Story03.rpy:5735
translate vietnamese akt3chapter5_1_59242a8a:

    # Fl "Freezing is the priority."
    Fl "Đóng băng là ưu tiên hàng đầu."

# game/Story03.rpy:5736
translate vietnamese akt3chapter5_1_044afcc9:

    # Fl "If they breach the line, shoot. But only then."
    Fl "Nếu chúng vượt qua phòng tuyến, hãy bắn. Nhưng chỉ khi đó thôi."

