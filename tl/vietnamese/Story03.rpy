    L "Thôi, em xin kiếu."

# game/Story03.rpy:968
translate vietnamese akt3chapter1_3_6e8fc0c7:

    # L "And I wouldn’t recommend it to you either."
    L "Và em cũng không khuyên anh uống đâu."

