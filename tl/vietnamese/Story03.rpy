translate vietnamese akt3chapter2_2_363dd4c2:

    # k "You want to stay? Adorable. But yes, I’ll get you out. Though I won’t lie, leaving you here is… tempting."
    k "Muốn ở lại sao? Đáng yêu thật. Nhưng đúng vậy, tôi sẽ đưa cậu ra ngoài. Dù không nói dối, để cậu lại đây cũng... cám dỗ lắm."

# game/Story03.rpy:2775
translate vietnamese akt3chapter2_2_0054e596:

    # mc "You’re serious?"
    mc "Cô nghiêm túc sao?"

# game/Story03.rpy:2777
translate vietnamese akt3chapter2_2_8529ccd2:

    # k "Completely. But don’t flatter yourself, I just don’t leave things unfinished."
    k "Hoàn toàn nghiêm túc. Nhưng đừng tự tâng bốc mình, tôi chỉ không bỏ dở việc gì mà thôi."

# game/Story03.rpy:2781
translate vietnamese akt3chapter2_2_82091822:

    # k "..."
    k "..."

# game/Story03.rpy:2783
translate vietnamese akt3chapter2_2_53f69968:

    # k "Just don’t stare at me like I’m a monster. Or go ahead, doesn’t matter to me."
    k "Chỉ đừng nhìn tôi như thể tôi là quái vật. Hoặc cứ nhìn đi, tôi cũng chẳng quan tâm."

# game/Story03.rpy:2785
translate vietnamese akt3chapter2_2_752b8262:

    # gg "..."
    gg "..."

# game/Story03.rpy:2787
translate vietnamese akt3chapter2_2_955fba72:

    # gg "Now’s not the time for old grudges."
    gg "Bây giờ không phải lúc để ôm hận cũ."

# game/Story03.rpy:2788
translate vietnamese akt3chapter2_2_82091822_1:

    # k "..."
    k "..."

# game/Story03.rpy:2789
translate vietnamese akt3chapter2_2_95c7633a:

    # mc "Are you okay?"
    mc "Cô ổn chứ?"

# game/Story03.rpy:2791
translate vietnamese akt3chapter2_2_0fbef901:

    # k "I’m always fine. It’s when others forget that things start falling apart."
    k "Tôi lúc nào cũng ổn. Chỉ khi người khác quên điều đó thì mọi chuyện mới bắt đầu đổ vỡ."

# game/Story03.rpy:2792
translate vietnamese akt3chapter2_2_9aa282ea:

    # k "Move. I’m not here for your soul-searching."
    k "Di chuyển đi. Tôi không tới đây để nghe cậu tự vấn lương tâm."

# game/Story03.rpy:2794
translate vietnamese akt3chapter2_2_752b8262_1:

    # gg "..."
    gg "..."

# game/Story03.rpy:2796
translate vietnamese akt3chapter2_2_56763e0f:

    # ggg "(whispering) You can’t be serious… She killed our people."
    ggg "(Thì thầm) Cậu không thể nghiêm túc được... Cô ta đã giết người của chúng ta."

# game/Story03.rpy:2797
translate vietnamese akt3chapter2_2_d7f1c947:

    # gg "(whispering) And you want to stay here? Die here?"
    gg "(Thì thầm) Còn cậu muốn ở lại đây sao? Chết ở đây sao?"

# game/Story03.rpy:2798
translate vietnamese akt3chapter2_2_f2cd03b0:

    # gg "(whispering) We don’t choose allies. We choose survival."
    gg "(Thì thầm) Chúng ta không chọn đồng minh. Chúng ta chọn sự sống còn."

# game/Story03.rpy:2800
translate vietnamese akt3chapter2_2_b9978003:

    # gg "She’s not just an executioner. She’s the nightmare our nightmares fear."
    gg "Cô ta không chỉ là một đao phủ. Cô ta là cơn ác mộng mà chính những cơn ác mộng cũng sợ."

# game/Story03.rpy:2802
translate vietnamese akt3chapter2_2_201288e6:

    # gg "I’m responsible for you. And if I have to walk with Astoria’s dogs to get you out, I will."
    gg "Tôi chịu trách nhiệm về anh. Và nếu tôi phải sánh bước cùng lũ chó của Astoria để đưa anh ra ngoài, tôi sẽ làm."

# game/Story03.rpy:2822
translate vietnamese akt3chapter2_2_d2c70b58:

    # mc "(...Slaughter.)"
    mc "(...Tàn sát.)"

# game/Story03.rpy:2823
translate vietnamese akt3chapter2_2_6f5fd1a1:

    # mc "(Clean. Fast.)"
    mc "(Sạch sẽ. Nhanh gọn.)"

# game/Story03.rpy:2824
translate vietnamese akt3chapter2_2_f2be55a0:

    # k "(You noticed. I put my soul into it.)"
    k "(Cậu nhận ra rồi đấy. Tôi đã dồn cả tâm hồn vào đó.)"

# game/Story03.rpy:2826
translate vietnamese akt3chapter2_2_6fe354fe:

    # mc "You did this?"
    mc "Cô làm chuyện này sao?"

# game/Story03.rpy:2829
translate vietnamese akt3chapter2_2_44640dd4:

    # k "They chose death. I just made sure it was... artfully done."
    k "Họ đã chọn cái chết. Tôi chỉ khiến nó trở nên... thật nghệ thuật."

# game/Story03.rpy:2832
translate vietnamese akt3chapter2_2_347a4121:

    # mc "Enjoying it?"
    mc "Thích thú sao?"

# game/Story03.rpy:2835
translate vietnamese akt3chapter2_2_0db91082:

    # k "No. Boredom. And only two cures for that, art or death."
    k "Không. Chán nản. Và chỉ có hai cách chữa chán nản, nghệ thuật hoặc cái chết."

# game/Story03.rpy:2836
translate vietnamese akt3chapter2_2_196cd2ef:

    # k "Sometimes, the line blurs."
    k "Đôi khi, ranh giới mờ đi."

# game/Story03.rpy:2839
translate vietnamese akt3chapter2_2_73f99694:

    # mc "Do you always cause this much carnage when you're bored?"
    mc "Cô lúc nào cũng gây ra nhiều tàn sát thế này khi chán sao?"

# game/Story03.rpy:2841
translate vietnamese akt3chapter2_2_679562b4:

    # k "Not always. Sometimes I slice fabric."
    k "Không phải lúc nào. Đôi khi tôi cắt vải."

# game/Story03.rpy:2842
translate vietnamese akt3chapter2_2_bce9b817:

    # k "Other times, throats. Depends on the mood."
    k "Lúc khác thì cắt cổ họng. Tùy tâm trạng."

# game/Story03.rpy:2844
translate vietnamese akt3chapter2_2_c6d30ed0:

    # mc "Why didn’t you go with Lora and Olivia?"
    mc "Tại sao cô không đi cùng Lora và Olivia?"

# game/Story03.rpy:2847
translate vietnamese akt3chapter2_2_caa476b6:

    # k "I wasn’t in the mood for whining. Even theirs."
    k "Tôi không có tâm trạng nghe than vãn. Kể cả của họ."

# game/Story03.rpy:2850
translate vietnamese akt3chapter2_2_36d1bfd9:

    # mc "Stop pretending."
    mc "Đừng giả vờ nữa."

# game/Story03.rpy:2852
translate vietnamese akt3chapter2_2_bb8e4b4e_3:

    # a "..."
    a "..."

# game/Story03.rpy:2854
translate vietnamese akt3chapter2_2_0b014af2:

    # a "Perceptive."
    a "Tinh tường đấy."

# game/Story03.rpy:2862
translate vietnamese akt3chapter2_2_0b556877:

    # k "...Fine. I was bored and wanted some fun."
    k "...Thôi được. Tôi chán và muốn vui chơi một chút."

# game/Story03.rpy:2864
translate vietnamese akt3chapter2_2_ebfb01ab:

    # k "And you looked... fragile enough."
    k "Và cậu trông... đủ mong manh."

# game/Story03.rpy:2868
translate vietnamese akt3chapter2_2_b6af152b:

    # k "Perfect warm-up material."
    k "Chất liệu khởi động hoàn hảo."

# game/Story03.rpy:2870
translate vietnamese akt3chapter2_2_09a5d2d9:

    # mc "(And again, everyone’s saving me... Am I really that helpless?!)"
    mc "(Và lại nữa, mọi người đều đang cứu mình... Mình thật sự bất lực đến thế sao?!)"

# game/Story03.rpy:2871
translate vietnamese akt3chapter2_2_cf953a06:

    # mc "(Pull yourself together. When did you turn into this? Where’s your fire?)"
    mc "(Bình tĩnh lại đi. Từ khi nào mình trở thành thế này? Ngọn lửa của mình đâu rồi?)"

# game/Story03.rpy:2874
translate vietnamese akt3chapter2_2_954c13c3:

    # mc "(You’ve already lost your son. And if you keep sitting on your hands…)"
    mc "(Mình đã mất con trai rồi. Và nếu mình cứ tiếp tục khoanh tay đứng nhìn...)"

# game/Story03.rpy:2875
translate vietnamese akt3chapter2_2_5dc95fe6:

    # mc "(You don’t get to stand by. Not again. Not after everything.)"
    mc "(Mình không được đứng ngoài nữa. Không lần nữa. Không sau tất cả mọi chuyện.)"

# game/Story03.rpy:2877
translate vietnamese akt3chapter2_2_98dc88c6:

    # k "(Oh, stop pitying yourself...)"
    k "(Ôi, thôi tự thương hại bản thân đi...)"

# game/Story03.rpy:2882
translate vietnamese akt3chapter2_2_9be052d1:

    # k "—Ouch!"
    k "—Ái!"

# game/Story03.rpy:2884
translate vietnamese akt3chapter2_2_f6f22481:

    # a "(Whispering) Try silence more often."
    a "(Thì thầm) Thử im lặng thường xuyên hơn xem."

# game/Story03.rpy:2887
translate vietnamese akt3chapter2_2_981502f3:

    # a "(Whispering) And next time, stay out of what isn’t yours."
    a "(Thì thầm) Và lần sau, đừng xen vào chuyện không phải của mình."

# game/Story03.rpy:2889
translate vietnamese akt3chapter2_2_afeec0a4:

    # a "(Whispering) Last warning."
    a "(Thì thầm) Cảnh báo lần cuối."

# game/Story03.rpy:2891
translate vietnamese akt3chapter2_2_99b254fb:

    # k "Killjoy."
    k "Kẻ phá đám."

# game/Story03.rpy:2894
translate vietnamese akt3chapter2_2_bb8e4b4e_4:

    # a "..."
    a "..."

# game/Story03.rpy:2896
translate vietnamese akt3chapter2_2_e9dbe232:

    # mc "She’s acting like a child..."
    mc "Cô ấy hành xử như một đứa trẻ..."

# game/Story03.rpy:2901
translate vietnamese akt3chapter2_2_2a982dca:

    # a "Defense mechanism. Or habit."
    a "Cơ chế phòng vệ. Hoặc thói quen."

# game/Story03.rpy:2903
translate vietnamese akt3chapter2_2_a72e2fb8:

    # mc "I get the feeling you two are... pretty close."
    mc "Tôi có cảm giác hai người... khá thân nhau."

# game/Story03.rpy:2904
translate vietnamese akt3chapter2_2_bb8e4b4e_5:

    # a "..."
    a "..."

# game/Story03.rpy:2906
translate vietnamese akt3chapter2_2_02cfa38c:

    # a "We are weapons. Forged sisters clash, sparks are expected."
    a "Chúng tôi là vũ khí. Những chị em được rèn giũa va chạm nhau, tia lửa là điều tất yếu."

# game/Story03.rpy:2908
translate vietnamese akt3chapter2_2_1556dcfd:

    # k "You should see how she looks at me when I take the last coffee..."
    k "Em nên thấy cô ấy nhìn tôi thế nào khi tôi lấy tách cà phê cuối cùng..."

# game/Story03.rpy:2910
translate vietnamese akt3chapter2_2_63baaa49:

    # a "She does it on purpose."
    a "Cô ấy làm vậy cố ý đấy."

# game/Story03.rpy:2912
translate vietnamese akt3chapter2_2_a1e094b0:

    # k "Of course. {w}Little wars make strong bonds."
    k "Đương nhiên rồi. {w}Những cuộc chiến nhỏ tạo nên tình gắn bó bền chặt."

# game/Story03.rpy:2913
translate vietnamese akt3chapter2_2_c9f06c4c:

    # k "We’re like any sisters: we love, we fight, we drive each other insane..."
    k "Chúng ta giống như bao chị em khác: chúng ta yêu thương, chúng ta cãi nhau, chúng ta khiến nhau phát điên..."

# game/Story03.rpy:2914
translate vietnamese akt3chapter2_2_53c38082:

    # k "But when the time comes, we’ll fall together. No doubts. Right?"
    k "Nhưng khi thời khắc tới, chúng ta sẽ cùng ngã xuống. Không nghi ngờ gì. Phải không?"

# game/Story03.rpy:2919
translate vietnamese akt3chapter2_2_bb8e4b4e_6:

    # a "..."
    a "..."

# game/Story03.rpy:2921
translate vietnamese akt3chapter2_2_fba49164:

    # a "Without hesitation."
    a "Không chút do dự."

# game/Story03.rpy:2922
translate vietnamese akt3chapter2_2_8ac5cee3:

    # a "Loyalty. And the will to die, if needed."
    a "Lòng trung thành. Và ý chí hy sinh nếu cần."

# game/Story03.rpy:2924
translate vietnamese akt3chapter2_2_64c9ed20:

    # mc "(I thought th—)"
    mc "(Mình tưởng—)"

# game/Story03.rpy:2926
translate vietnamese akt3chapter2_2_e341ba96:

    # k "After our Lady’s orders, of course."
    k "Tất nhiên là sau mệnh lệnh của Quý bà."

# game/Story03.rpy:2928
translate vietnamese akt3chapter2_2_bb8e4b4e_7:

    # a "..."
    a "..."

# game/Story03.rpy:2930
translate vietnamese akt3chapter2_2_6896212c:

    # a "You made the right choice. It will be remembered."
    a "Anh đã chọn đúng. Người ta sẽ ghi nhớ điều này."

# game/Story03.rpy:2933
translate vietnamese akt3chapter2_2_530bb51a:

    # mc "(What the hell was that?)"
    mc "(Chuyện quái gì vừa xảy ra vậy?)"

# game/Story03.rpy:2935
translate vietnamese akt3chapter2_2_1b6a4552:

    # k "(Whispering) That was her version of ‘thank you’. Adorable, right?"
    k "(Thì thầm) Đó là phiên bản 'cảm ơn' của cô ấy đấy. Đáng yêu phải không?"

# game/Story03.rpy:2940
translate vietnamese akt3chapter2_2_2b35b6fe_4:

    # mc "..."
    mc "..."

# game/Story03.rpy:2942
translate vietnamese akt3chapter2_2_ada47138:

    # mc "He was getting on my nerves."
    mc "Hắn làm tôi khó chịu."

# game/Story03.rpy:2944
translate vietnamese akt3chapter2_2_dfba945c:

    # k "Thanks..."
    k "Cảm ơn..."

# game/Story03.rpy:2948
translate vietnamese akt3chapter2_2_e4ad04c2:

    # k "(Pull it together. We have company...)"
    k "(Bình tĩnh lại đi. Chúng ta có khách...)"

# game/Story03.rpy:2954
translate vietnamese akt3chapter2_2_c99b5fce:

    # a "Cover the rear. We move ahead."
    a "Yểm trợ phía sau. Chúng ta tiến lên trước."

# game/Story03.rpy:2956
translate vietnamese akt3chapter2_2_69bf3109:

    # gg "Understood."
    gg "Đã rõ."

# game/Story03.rpy:2959
translate vietnamese akt3chapter2_2_103699df:

    # gg "They took our people, let them pay in full."
    gg "Họ đã bắt người của chúng ta, bắt họ trả giá đầy đủ."

# game/Story03.rpy:2962
translate vietnamese akt3chapter2_2_ff2a0f71:

    # k "So, a little pain in the name of Astoria?"
    k "Vậy là, một chút đau đớn nhân danh Astoria sao?"

# game/Story03.rpy:2970
translate vietnamese akt3chapter2_2_1c59acdd:

    # mc "Let them come."
    mc "Cứ để chúng tới."

# game/Story03.rpy:2971
translate vietnamese akt3chapter2_2_5af9b061:

    # mc "I’m ready."
    mc "Tôi sẵn sàng rồi."

# game/Story03.rpy:2973
translate vietnamese akt3chapter2_2_740b22b2:

    # mc "(You’ve already lost your son… and you’re not losing anyone else.)"
    mc "(Mình đã mất con trai rồi... và mình sẽ không mất thêm ai nữa.)"

# game/Story03.rpy:2983
translate vietnamese akt3chapter2_2_4cd4a0e2:

    # k "Now that’s a voice. Finally, someone here who doesn’t flinch at the scent of blood."
    k "Giờ mới đúng là một giọng nói. Cuối cùng, cũng có người ở đây không chùn bước trước mùi máu."

# game/Story03.rpy:2984
translate vietnamese akt3chapter2_2_d8ad6ad0:

    # k "Stick close, hero. Die later, I hate being bored."
    k "Bám sát vào, anh hùng. Chết sau đi, tôi ghét cảm giác chán."

# game/Story03.rpy:2998
translate vietnamese akt3chapter2_2_1bad2bb5:

    # mc "Don’t bother thanking me."
    mc "Không cần cảm ơn tôi đâu."

# game/Story03.rpy:2999
translate vietnamese akt3chapter2_2_82091822_2:

    # k "..."
    k "..."

# game/Story03.rpy:3000
translate vietnamese akt3chapter2_2_9649516a:

    # k "Wasn’t planning to. But if you need it that badly, you looked almost worthy. Briefly."
    k "Tôi cũng không định cảm ơn. Nhưng nếu cậu cần điều đó đến vậy, trông cậu cũng gần như xứng đáng. Trong chốc lát."

# game/Story03.rpy:3003
translate vietnamese akt3chapter2_2_522a3d44:

    # mc "Last one."
    mc "Tên cuối cùng."

# game/Story03.rpy:3013
translate vietnamese akt3chapter2_2_28033310:

    # a "Enough. Move out."
    a "Đủ rồi. Rút quân."

# game/Story03.rpy:3020
translate vietnamese akt3chapter2_2_7e10cdd5:

    # gg "Copy."
    gg "Đã rõ."

# game/Story03.rpy:3022
translate vietnamese akt3chapter2_2_2d1f62d3:

    # gg "Stick together!"
    gg "Bám sát nhau!"

# game/Story03.rpy:3025
translate vietnamese akt3chapter2_2_5bcfe907:

    # gg "Move! Like we trained, no wasted steps!"
    gg "Di chuyển! Như đã luyện tập, không bước thừa!"

# game/Story03.rpy:3026
translate vietnamese akt3chapter2_2_f2c813e3:

    # gg "The rest, toward the corridor. Hustle, or I’ll finish you off myself!"
    gg "Những người còn lại, về phía hành lang. Nhanh lên, không tôi sẽ tự tay kết liễu các người!"

# game/Story03.rpy:3040
translate vietnamese akt3chapter3_debcd0a0:

    # "Sector 4. A ventilation shaft."
    "Khu vực 4. Một giếng thông gió."

# game/Story03.rpy:3041
translate vietnamese akt3chapter3_c1670847:

    # mc "...Holy shit."
    mc "...Mẹ kiếp."

# game/Story03.rpy:3042
translate vietnamese akt3chapter3_2b90d5d4:

    # a "Ventilation sector. Air from the surface used to flow through here."
    a "Khu thông gió. Không khí từ mặt đất từng chảy qua đây."

# game/Story03.rpy:3045
translate vietnamese akt3chapter3_6e9b66cc:

    # a "When they released the gas, the floors collapsed one after another."
    a "Khi họ xả khí, các tầng sụp đổ lần lượt từng tầng một."

# game/Story03.rpy:3046
translate vietnamese akt3chapter3_b6e6a2f9:

    # a "The city rotted from the bottom up."
    a "Thành phố thối rữa từ dưới lên trên."

# game/Story03.rpy:3049
translate vietnamese akt3chapter3_fc6a0035:

    # mc "Gas? That's what killed them?"
    mc "Khí sao? Đó là thứ đã giết họ sao?"

# game/Story03.rpy:3050
translate vietnamese akt3chapter3_53e83df6:

    # mc "But the mutants... they’re not human."
    mc "Nhưng những dị nhân... chúng không phải con người."

# game/Story03.rpy:3052
translate vietnamese akt3chapter3_bb8e4b4e:

    # a "..."
    a "..."

# game/Story03.rpy:3053
translate vietnamese akt3chapter3_5948b769:

    # k "No wonder I felt like I was stepping on someone's ribs again."
    k "Chẳng trách tôi cứ có cảm giác mình đang giẫm lên xương sườn của ai đó."

# game/Story03.rpy:3055
translate vietnamese akt3chapter3_be5cc369:

    # mc "(You could at least pretend this isn’t normal.)"
    mc "(Cô ít nhất cũng giả vờ như chuyện này không bình thường đi.)"

# game/Story03.rpy:3057
translate vietnamese akt3chapter3_00dec9b0:

    # k "(Sweetheart. We're on a station held together by duct tape, screaming, and someone’s bones.)"
    k "(Cưng à. Chúng ta đang ở trên một trạm được giữ với nhau bằng băng keo, tiếng la hét, và xương của ai đó.)"

# game/Story03.rpy:3060
translate vietnamese akt3chapter3_e1d29dea:

    # k "(Nothing here is normal. I just adapted.)"
    k "(Ở đây chẳng có gì bình thường cả. Tôi chỉ thích nghi thôi.)"

# game/Story03.rpy:3063
translate vietnamese akt3chapter3_93aa5d79:

    # mc "I'm not you."
    mc "Tôi không giống cô."

# game/Story03.rpy:3065
translate vietnamese akt3chapter3_8213ea34:

    # mc "I won’t pretend this is okay."
    mc "Tôi sẽ không giả vờ chuyện này là ổn."

# game/Story03.rpy:3068
translate vietnamese akt3chapter3_94930995:

    # k "Good. One lunatic per square meter is already too much."
    k "Tốt. Một kẻ điên trên mỗi mét vuông đã là quá đủ rồi."

# game/Story03.rpy:3071
translate vietnamese akt3chapter3_3cb18e7c:

    # k "Just... don’t overthink it. Mutants aren’t people. Keeps it cleaner. For you."
    k "Chỉ... đừng suy nghĩ quá nhiều. Dị nhân không phải con người. Như vậy sẽ sạch sẽ hơn. Cho cậu."

# game/Story03.rpy:3073
translate vietnamese akt3chapter3_a913904e:

    # k "If the real nightmare ever breaks loose — get behind me."
    k "Nếu cơn ác mộng thật sự thoát ra — hãy nấp sau tôi."

# game/Story03.rpy:3076
translate vietnamese akt3chapter3_7eafddce:

    # k "{b}It’s cozy there. It’s... nice."
    k "{b}Ở đó ấm cúng lắm. Thật... dễ chịu."

# game/Story03.rpy:3078
translate vietnamese akt3chapter3_af24c268:

    # mc "(Yeah, and I’ll be your human shield again, when you run out of ammo.)"
    mc "(Ừ, và tôi sẽ lại làm lá chắn sống cho cô, khi cô hết đạn.)"

# game/Story03.rpy:3079
translate vietnamese akt3chapter3_b1e8fce6:

    # k "(You know? I like how that sounds...)"
    k "(Cậu biết không? Tôi thích nghe như vậy đấy...)"

# game/Story03.rpy:3081
translate vietnamese akt3chapter3_6118b17e:

    # mc "Figures. Let’s keep moving."
    mc "Đương nhiên rồi. Tiếp tục di chuyển thôi."

# game/Story03.rpy:3084
translate vietnamese akt3chapter3_beee153b:

    # k "There it is. A little crack in the mask. Now you’re starting to feel real."
    k "Kìa. Một vết nứt nhỏ trên chiếc mặt nạ. Giờ cậu bắt đầu cảm thấy thật rồi."

# game/Story03.rpy:3085
translate vietnamese akt3chapter3_caffef16:

    # k "Keep your head up."
    k "Ngẩng cao đầu lên."

# game/Story03.rpy:3087
translate vietnamese akt3chapter3_5e44a000:

    # mc "Right..."
    mc "Đúng vậy..."

# game/Story03.rpy:3089
translate vietnamese akt3chapter3_b5b448e0:

    # mc "And thanks."
    mc "Và cảm ơn."

# game/Story03.rpy:3092
translate vietnamese akt3chapter3_dc0e3738:

    # k "Always a pleasure."
    k "Lúc nào cũng sẵn lòng."

# game/Story03.rpy:3094
translate vietnamese akt3chapter3_2b35b6fe:

    # mc "..."
    mc "..."

# game/Story03.rpy:3097
translate vietnamese akt3chapter3_8c9c7f34:

    # mc "You know something."
    mc "Cô biết điều gì đó."

# game/Story03.rpy:3098
translate vietnamese akt3chapter3_86782263:

    # mc "About them."
    mc "Về họ."

# game/Story03.rpy:3100
translate vietnamese akt3chapter3_bb8e4b4e_1:

    # a "..."
    a "..."

# game/Story03.rpy:3105
translate vietnamese akt3chapter3_fdf4cc37:

    # mc "Talk."
    mc "Nói đi."

# game/Story03.rpy:3107
translate vietnamese akt3chapter3_763d88b4:

    # mc "Or at least tell me — does this tie back to Lora?"
    mc "Hoặc ít nhất hãy nói cho tôi biết — chuyện này có liên quan tới Lora không?"

# game/Story03.rpy:3109
translate vietnamese akt3chapter3_b5efc462:

    # a "You want the truth?"
    a "Anh muốn sự thật sao?"

# game/Story03.rpy:3112
translate vietnamese akt3chapter3_f800bed0:

    # mc "Yes."
    mc "Đúng vậy."

# game/Story03.rpy:3116
translate vietnamese akt3chapter3_61bf9ec8:

    # a "Lora and the man with the patch. They worked together."
    a "Lora và người đàn ông có miếng che mắt. Họ đã làm việc cùng nhau."

# game/Story03.rpy:3118
translate vietnamese akt3chapter3_3c5a0c96:

    # a "Studying. Testing. Under the Lady’s orders."
    a "Nghiên cứu. Thử nghiệm. Theo mệnh lệnh của Quý bà."

# game/Story03.rpy:3119
translate vietnamese akt3chapter3_2c0b1bfb:

    # a "Lora passed. He didn’t."
    a "Lora đã qua. Còn hắn thì không."

# game/Story03.rpy:3121
translate vietnamese akt3chapter3_dc057b0f:

    # mc "Dr. Li?"
    mc "Tiến sĩ Li sao?"

# game/Story03.rpy:3128
translate vietnamese akt3chapter3_6e2d5d7b:

    # a "The Lady handed him over to Ostorius. As a trophy. As disposable."
    a "Quý bà đã giao hắn cho Ostorius. Như một chiến lợi phẩm. Như thứ dùng rồi bỏ."

# game/Story03.rpy:3129
translate vietnamese akt3chapter3_34ea003c:

    # a "He kept experimenting. Until the end."
    a "Hắn vẫn tiếp tục thí nghiệm. Cho tới cuối cùng."

# game/Story03.rpy:3131
translate vietnamese akt3chapter3_342c5ccf:

    # a "You knew him?"
    a "Anh từng biết hắn sao?"

# game/Story03.rpy:3133
translate vietnamese akt3chapter3_cf1adef2:

    # mc "Yeah."
    mc "Ừ."

# game/Story03.rpy:3140
translate vietnamese akt3chapter3_04967ad2:

    # a "He never discovered the mutants’ origin."
    a "Hắn chưa bao giờ khám phá ra nguồn gốc của dị nhân."

# game/Story03.rpy:3143
translate vietnamese akt3chapter3_5d1729bf:

    # a "He had theories. But no proof."
    a "Hắn có giả thuyết. Nhưng không có bằng chứng."

# game/Story03.rpy:3146
translate vietnamese akt3chapter3_bb8e4b4e_2:

    # a "..."
    a "..."

# game/Story03.rpy:3147
translate vietnamese akt3chapter3_6fad8b99:

    # mc "(Wait. Something’s off…)"
    mc "(Khoan. Có gì đó không ổn...)"

# game/Story03.rpy:3152
translate vietnamese akt3chapter3_9a838154:

    # R "They think we’re behind this?"
    R "Họ nghĩ chúng ta đứng sau chuyện này sao?"

# game/Story03.rpy:3153
translate vietnamese akt3chapter3_f413af47:

    # mc "(He’s nervous… and it’s not the Inquisition.)"
    mc "(Hắn đang lo lắng... và không phải vì Tòa án Dị giáo.)"

# game/Story03.rpy:3156
translate vietnamese akt3chapter3_77448e7a:

    # mc "He found something, didn’t he?"
    mc "Hắn đã tìm ra thứ gì đó, phải không?"

# game/Story03.rpy:3158
translate vietnamese akt3chapter3_e4476ff4:

    # a "It was in his report. But he didn’t believe himself."
    a "Nó nằm trong báo cáo của hắn. Nhưng chính hắn cũng không tin mình."

# game/Story03.rpy:3160
translate vietnamese akt3chapter3_d45b13c5:

    # mc "So you’re telling me, you know where they came from?"
    mc "Vậy cô đang nói với tôi là, cô biết chúng tới từ đâu sao?"

# game/Story03.rpy:3165
translate vietnamese akt3chapter3_c88aa9db:

    # a "Do you know why they’re called soulless?"
    a "Anh có biết tại sao chúng được gọi là vô hồn không?"

# game/Story03.rpy:3167
translate vietnamese akt3chapter3_2b35b6fe_1:

    # mc "..."
    mc "..."

# game/Story03.rpy:3170
translate vietnamese akt3chapter3_797c51cf:

    # a "Soulless... because there was a soul before the gate took it."
    a "Vô hồn... vì trước khi cánh cổng lấy đi, đã từng có một linh hồn."

# game/Story03.rpy:3171
translate vietnamese akt3chapter3_f9be4f81:

    # a "The gate strips the mind away and leaves the body behind."
    a "Cánh cổng tước đi tâm trí và để lại thân xác phía sau."

# game/Story03.rpy:3173
translate vietnamese akt3chapter3_3d8f9aab:

    # mc "You..."
    mc "Cô..."
# game/Story03.rpy:3176
translate vietnamese akt3chapter3_e08af8b7:

    # mc "No. I... I don’t understand."
    mc "Không. Tôi... tôi không hiểu."

# game/Story03.rpy:3177
translate vietnamese akt3chapter3_24c0190c:

    # mc "Then they’re victims."
    mc "Vậy thì họ là nạn nhân."

# game/Story03.rpy:3178
translate vietnamese akt3chapter3_643d291f:

    # mc "Every one of them."
    mc "Tất cả bọn họ."

# game/Story03.rpy:3181
translate vietnamese akt3chapter3_f4cc7e48:

    # a "You saw the gate open. But you never asked what they opened on."
    a "Anh đã thấy cổng mở ra. Nhưng anh chưa bao giờ hỏi nó được mở ra bằng cái gì."

# game/Story03.rpy:3183
translate vietnamese akt3chapter3_7c1dcde0:

    # mc "Through energy. Through instability—"
    mc "Bằng năng lượng. Bằng sự bất ổn—"

# game/Story03.rpy:3189
translate vietnamese akt3chapter3_d81eba0b:

    # a "Where does the energy come from. And where do the bodies go."
    a "Năng lượng từ đâu mà có. Và những thi thể đi về đâu."

# game/Story03.rpy:3191
translate vietnamese akt3chapter3_8e34c139:

    # mc "(They... were human?)"
    mc "(Họ... từng là con người sao?)"

# game/Story03.rpy:3197
translate vietnamese akt3chapter3_4d9a817f:

    # Fl "Mutants driven by hunger and rage. And no one knows where they came from."
    Fl "Những dị nhân bị đói khát và giận dữ thúc đẩy. Và chẳng ai biết chúng từ đâu tới."

# game/Story03.rpy:3200
translate vietnamese akt3chapter3_31777a57:

    # mc "(Right now, they’re just cannon fodder.)"
    mc "(Ngay lúc này, chúng chỉ là bia đỡ đạn.)"

# game/Story03.rpy:3204
translate vietnamese akt3chapter3_0c39750b:

    # mc "But why? What kind of mind creates something like this?"
    mc "Nhưng tại sao? Đầu óc kiểu gì mới tạo ra thứ như thế này?"

# game/Story03.rpy:3208
translate vietnamese akt3chapter3_9a397c22:

    # k "Just... don’t think about it. Mutants aren’t people."
    k "Thôi... đừng nghĩ về chuyện đó nữa. Dị nhân không phải con người."

# game/Story03.rpy:3212
translate vietnamese akt3chapter3_24a5a506:

    # mc "(All this time...)"
    mc "(Suốt bấy lâu nay...)"

# game/Story03.rpy:3213
translate vietnamese akt3chapter3_6b642644:

    # mc "(They weren’t monsters.)"
    mc "(Chúng không phải quái vật.)"

# game/Story03.rpy:3217
translate vietnamese akt3chapter3_2b15474b:

    # mc "...You knew."
    mc "...Anh đã biết."

# game/Story03.rpy:3219
translate vietnamese akt3chapter3_b15d94ce:

    # mc "All of you."
    mc "Tất cả các anh."

# game/Story03.rpy:3220
translate vietnamese akt3chapter3_d4661ad2:

    # a "You suspect."
    a "Anh chỉ nghi ngờ thôi."

# game/Story03.rpy:3221
translate vietnamese akt3chapter3_fd5865b3:

    # a "That’s why you’re angry."
    a "Đó là lý do anh tức giận."

# game/Story03.rpy:3227
translate vietnamese akt3chapter3_e176a807:

    # a "People die over less."
    a "Người ta chết vì những chuyện còn nhỏ hơn thế."

# game/Story03.rpy:3228
translate vietnamese akt3chapter3_16a26557:

    # a "They can’t know. No one can."
    a "Họ không thể biết được. Không một ai được biết."

# game/Story03.rpy:3229
translate vietnamese akt3chapter3_fd0357d3:

    # mc "(So that’s it.)"
    mc "(Ra là vậy.)"

# game/Story03.rpy:3230
translate vietnamese akt3chapter3_cba3f744:

    # mc "(Say the truth, and you disappear.)"
    mc "(Nói ra sự thật, và anh sẽ biến mất.)"

# game/Story03.rpy:3236
translate vietnamese akt3chapter3_7ca33b5b:

    # a "Arkgh!"
    a "Arkgh!"

# game/Story03.rpy:3238
translate vietnamese akt3chapter3_62356372:

    # mc "Now I get it."
    mc "Giờ thì tôi hiểu rồi."

# game/Story03.rpy:3239
translate vietnamese akt3chapter3_5307f7d0:

    # mc "Lora wasn’t broken."
    mc "Lora không hề bị hỏng."

# game/Story03.rpy:3241
translate vietnamese akt3chapter3_3a9fe4df:

    # mc "You did that to her."
    mc "Chính các người đã làm vậy với cô ấy."

# game/Story03.rpy:3243
translate vietnamese akt3chapter3_c98ab144:

    # mc "...Not happening to me."
    mc "...Chuyện đó sẽ không xảy ra với tôi đâu."

# game/Story03.rpy:3246
translate vietnamese akt3chapter3_0061b368:

    # ggg "..."
    ggg "..."

# game/Story03.rpy:3250
translate vietnamese akt3chapter3_705eec7e:

    # a "(Whispering) Watch over him."
    a "(Thì thầm) Trông chừng anh ta."

# game/Story03.rpy:3252
translate vietnamese akt3chapter3_2145c24a:

    # k "(You could’ve been gentler. But... who am I kidding.)"
    k "(Đáng lẽ cậu có thể nhẹ tay hơn. Nhưng... tôi tự lừa mình làm gì chứ.)"

# game/Story03.rpy:3253
translate vietnamese akt3chapter3_a7fecff0:

    # k "(You just wanted to snap his wings. See how much it hurt when they cracked.)"
    k "(Cậu chỉ muốn bẻ gãy đôi cánh của anh ta. Xem chúng nứt ra đau đến mức nào.)"

# game/Story03.rpy:3256
translate vietnamese akt3chapter3_63056cb1:

    # a "(Whispering) You care about a simple man? {w}Since when?"
    a "(Thì thầm) Anh quan tâm tới một người đàn ông bình thường sao? {w}Từ khi nào vậy?"

# game/Story03.rpy:3258
translate vietnamese akt3chapter3_bfd87274:

    # k "(He’s not simple. He’s... amusing.)"
    k "(Anh ta không hề bình thường. Anh ta... thú vị đấy.)"

# game/Story03.rpy:3259
translate vietnamese akt3chapter3_e9ad328d:

    # k "(And I don’t like people breaking my toys without warning.)"
    k "(Và tôi không thích người ta phá đồ chơi của tôi mà không báo trước.)"

# game/Story03.rpy:3263
translate vietnamese akt3chapter3_57cc1caa:

    # a "(Whispering) Stay focused. The Lady is our priority."
    a "(Thì thầm) Tập trung đi. Quý bà mới là ưu tiên của chúng ta."

# game/Story03.rpy:3264
translate vietnamese akt3chapter3_a9f2e04c:

    # a "No emotions change that."
    a "Không cảm xúc nào thay đổi được điều đó."

# game/Story03.rpy:3266
translate vietnamese akt3chapter3_df8c2444:

    # a "Is that clear?"
    a "Rõ chưa?"

# game/Story03.rpy:3271
translate vietnamese akt3chapter3_bb8e4b4e_3:

    # a "..."
    a "..."

# game/Story03.rpy:3273
translate vietnamese akt3chapter3_647e80cd:

    # k "(You’re not protecting him from breaking. You’re just setting the stage...)"
    k "(Cậu không bảo vệ anh ta khỏi bị tổn thương. Cậu chỉ đang dọn sân khấu thôi...)"

# game/Story03.rpy:3274
translate vietnamese akt3chapter3_a97711f4:

    # k "(Pain without rhythm is just noise.)"
    k "(Nỗi đau không có nhịp điệu thì chỉ là tiếng ồn.)"

# game/Story03.rpy:3276
translate vietnamese akt3chapter3_5bbc432b:

    # k "Tch..."
    k "Tch..."

# game/Story03.rpy:3280
translate vietnamese akt3chapter3_bbf7cf59:

    # k "So? Boiling yet?"
    k "Thế nào? Sôi lên chưa?"

# game/Story03.rpy:3283
translate vietnamese akt3chapter3_f8a33d04:

    # k "(Angry? Good. I can feel it from here.)"
    k "(Tức giận à? Tốt. Tôi cảm nhận được từ đây này.)"

# game/Story03.rpy:3286
translate vietnamese akt3chapter3_5ea271a9:

    # mc "(I thought I finally found someone I could trust.)"
    mc "(Tôi cứ tưởng cuối cùng mình đã tìm được người mà mình có thể tin tưởng.)"

# game/Story03.rpy:3288
translate vietnamese akt3chapter3_78b62800:

    # mc "(...Wrong.)"
    mc "(...Nhầm rồi.)"

# game/Story03.rpy:3290
translate vietnamese akt3chapter3_2b15474b_1:

    # mc "...You knew."
    mc "...Anh đã biết."

# game/Story03.rpy:3292
translate vietnamese akt3chapter3_57c62461:

    # mc "And you said nothing."
    mc "Vậy mà anh chẳng nói gì."

# game/Story03.rpy:3295
translate vietnamese akt3chapter3_0634651e:

    # k "Oh? Curtain’s up already? Spare me the tragedy."
    k "Ồ? Màn đã kéo lên rồi sao? Tha cho tôi cái bi kịch này đi."

# game/Story03.rpy:3298
translate vietnamese akt3chapter3_3085095d:

    # mc "So that’s it."
    mc "Ra là vậy."

# game/Story03.rpy:3299
translate vietnamese akt3chapter3_48f75eee:

    # mc "Everyone knew."
    mc "Mọi người đều biết."

# game/Story03.rpy:3301
translate vietnamese akt3chapter3_8a4f514c:

    # mc "...Except me."
    mc "...Trừ tôi."

# game/Story03.rpy:3307
translate vietnamese akt3chapter3_1bc15095:

    # k "(Yeah... He’s burning now. Feels good. Warm all over.)"
    k "(Ừ... Anh ta đang bùng cháy rồi. Cảm giác thật đã. Ấm khắp người.)"

# game/Story03.rpy:3310
translate vietnamese akt3chapter3_4b227d9f:

    # k "(Whispering) It always gets messy when you don’t know how to lie. Gracefully. Or even... humanly."
    k "(Thì thầm) Lúc nào cũng rối tung lên khi cậu không biết cách nói dối. Một cách duyên dáng. Hay thậm chí... ra dáng con người."

# game/Story03.rpy:3313
translate vietnamese akt3chapter3_1e1b51c3:

    # k "(Try saying it once, 'I failed.')"
    k "(Thử nói một lần đi, ‘Tôi đã thất bại.’)"

# game/Story03.rpy:3318
translate vietnamese akt3chapter3_55cfb131:

    # k "(No? Of course not. You always did overact.)"
    k "(Không à? Đương nhiên rồi. Cậu lúc nào cũng diễn quá lố.)"

# game/Story03.rpy:3321
translate vietnamese akt3chapter3_33dd240d:

    # k "(Here we go again, dancing around conscience.)"
    k "(Lại nữa rồi, cứ nhảy múa vòng quanh lương tâm.)"

# game/Story03.rpy:3324
translate vietnamese akt3chapter3_fb9245ea:

    # k "Please. Kill me already."
    k "Làm ơn đi. Giết tôi luôn cho rồi."

# game/Story03.rpy:3328
translate vietnamese akt3chapter3_a5ec69d4:

    # k "(But not now. Don’t ruin the show in the first act.)"
    k "(Nhưng không phải bây giờ. Đừng phá hỏng vở diễn ngay từ màn đầu tiên.)"

# game/Story03.rpy:3330
translate vietnamese akt3chapter3_96289803:

    # k "Actually, wait..."
    k "Thực ra, khoan đã..."

# game/Story03.rpy:3334
translate vietnamese akt3chapter3_048b5630:

    # k "As adorable as this panic attack is, who’s flying this winged coffin?"
    k "Ngọt ngào như cơn hoảng loạn này đấy, nhưng ai đang lái cái quan tài có cánh này vậy?"

# game/Story03.rpy:3338
translate vietnamese akt3chapter3_c919e9fa:

    # mc "Wait, don’t tell me... no one’s flying this thing?"
    mc "Khoan, đừng nói với tôi là... không có ai lái thứ này nhé?"

# game/Story03.rpy:3341
translate vietnamese akt3chapter3_752b8262:

    # gg "..."
    gg "..."

# game/Story03.rpy:3343
translate vietnamese akt3chapter3_4de01bd8:

    # gg "We... didn’t think that far ahead..."
    gg "Chúng tôi... đã không nghĩ xa tới vậy..."

# game/Story03.rpy:3346
translate vietnamese akt3chapter3_8d68d766:

    # g "I can."
    g "Tôi làm được."

# game/Story03.rpy:3348
translate vietnamese akt3chapter3_ef178b3a:

    # gg "Brain, what are you—"
    gg "Brain, cậu đang—"

# game/Story03.rpy:3351
translate vietnamese akt3chapter3_b4a519d0:

    # g "Worked air delivery as a kid."
    g "Hồi nhỏ tôi từng giao hàng bằng đường hàng không."

# game/Story03.rpy:3353
translate vietnamese akt3chapter3_db007c6d:

    # g "Just need a second hand."
    g "Chỉ cần thêm một đôi tay nữa."

# game/Story03.rpy:3356
translate vietnamese akt3chapter3_2b35b6fe_2:

    # mc "..."
    mc "..."

# game/Story03.rpy:3358
