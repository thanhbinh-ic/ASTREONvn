    # Mi "(In the end, a dozen bodies marked the start of my path.)"
    Mi "(Cuối cùng, một tá thi thể đã đánh dấu sự khởi đầu con đường của tôi.)"

# game/Story03.rpy:8579
translate vietnamese act3_5chapter3_25c88c0a:

    # Mi "(I sparked a massacre, a genocide of all those who treated elves badly.)"
    Mi "(Tôi đã châm ngòi cho một cuộc thảm sát, một cuộc diệt chủng nhắm vào tất cả những kẻ đối xử tệ với người elf.)"

# game/Story03.rpy:8580
translate vietnamese act3_5chapter3_4f712f9f:

    # Mi "(Became a serial killer.)"
    Mi "(Trở thành một kẻ giết người hàng loạt.)"

# game/Story03.rpy:8582
