    # mc "...Lora?"
    mc "...Lora?"

# game/Story03.rpy:1074
translate vietnamese akt3chapter1_3_615a2be0:

    # L "I wanted to die there…"
    L "Em đã muốn chết ở đó…"

# game/Story03.rpy:1075
translate vietnamese akt3chapter1_3_f76ebaa6:

    # L "I tried to die there."
    L "Em đã cố chết ở đó."

# game/Story03.rpy:1076
