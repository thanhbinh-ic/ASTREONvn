translate vietnamese akt3chapter3_1_8b9dbe8c:

    # mc "I wish I could. But if I say yes — we all burn."
    mc "Tôi ước gì mình có thể. Nhưng nếu tôi đồng ý — tất cả chúng ta sẽ cháy rụi."

# game/Story03.rpy:3670
translate vietnamese akt3chapter3_1_4b340443:

    # g "..."
    g "..."

# game/Story03.rpy:3673
