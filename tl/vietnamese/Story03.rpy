translate vietnamese akt3chapter3_1_bfa3ac19:

    # mc "(He’s our only pilot.)"
    mc "(Anh ta là phi công duy nhất của chúng ta.)"

# game/Story03.rpy:3658
translate vietnamese akt3chapter3_1_d62dcfc6:

    # mc "(If we help — he gets us out.)"
    mc "(Nếu chúng ta giúp — anh ta sẽ đưa chúng ta ra ngoài.)"

