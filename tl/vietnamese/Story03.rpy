translate vietnamese act3_5chapter2_2_a901cd97:

    # a "This is your final move. Fail me again… and your piece is swept from the board."
    a "Đây là nước đi cuối cùng của cậu. Thất bại với tôi lần nữa… và quân cờ của cậu sẽ bị quét khỏi bàn cờ."
# game/Story03.rpy:7540
translate vietnamese act3_5chapter2_2_71a86863_1:

    # y "..."
    y "..."
