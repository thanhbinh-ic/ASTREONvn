    # k "(It’s about how death breaks you… when you still believe they were people.)"
    k "(Mà là về cái cách cái chết phá nát cậu... khi cậu vẫn còn tin rằng họ từng là con người.)"

# game/Story03.rpy:3488
translate vietnamese akt3chapter3_2b35b6fe_4:

    # mc "..."
    mc "..."

# game/Story03.rpy:3491
