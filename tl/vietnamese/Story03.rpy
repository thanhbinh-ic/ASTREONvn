translate vietnamese akt3chapter5_1_e4423a79:

    # mc "Outcome?"
    mc "Kết quả thì sao?"

# game/Story03.rpy:5609
translate vietnamese akt3chapter5_1_22d0ef64:

    # L "I... don't know."
    L "Tôi... không biết."

# game/Story03.rpy:5610
translate vietnamese akt3chapter5_1_2b35b6fe_2:

    # mc "..."
    mc "..."

# game/Story03.rpy:5612
translate vietnamese akt3chapter5_1_712df1b0:

    # mc "No point backing out now."
    mc "Giờ rút lui cũng chẳng ích gì nữa."

