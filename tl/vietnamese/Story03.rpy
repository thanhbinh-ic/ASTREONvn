translate vietnamese akt3chapter5_1_632438b3:

    # a "You haven’t changed. Still mad."
    a "Cô vẫn không thay đổi. Vẫn điên như vậy."

# game/Story03.rpy:5567
translate vietnamese akt3chapter5_1_01cbc88e:

    # k "People call it madness whenever someone stops asking permission."
    k "Người ta gọi đó là điên rồ mỗi khi ai đó ngừng xin phép."

# game/Story03.rpy:5568
translate vietnamese akt3chapter5_1_f47b3dd5:

    # k "And freedom, sister, smells like fire and steel."
