translate vietnamese akt3chapter5_1_41da62cb_1:

    # Fl "..."
    Fl "..."

# game/Story03.rpy:5543
translate vietnamese akt3chapter5_1_4ca66fb4:

    # k "That’s all! Now, to the hangar. Chop-chop. We’ve got murders to plan and not enough time."
    k "Hết rồi đấy! Giờ thì tới nhà chứa máy bay. Nhanh lên. Chúng ta còn có những vụ giết chóc cần lên kế hoạch mà chẳng còn bao nhiêu thời gian."

# game/Story03.rpy:5546
translate vietnamese akt3chapter5_1_46165e04:

