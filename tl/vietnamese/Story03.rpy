    # L "…Good to know."
    L "…Biết vậy cũng tốt."

# game/Story03.rpy:929
translate vietnamese akt3chapter1_3_47faff2b:

    # L "And I’m glad we’re together again."
    L "Và em mừng vì chúng ta lại ở bên nhau."

# game/Story03.rpy:931
translate vietnamese akt3chapter1_3_c3aaca30:

