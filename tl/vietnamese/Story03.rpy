translate vietnamese akt3chapter5_1_c0a94019:

    # k "Any officer obstructing evacuation is relieved and detained. Armed resistance will be treated as treason."
    k "Bất kỳ sĩ quan nào cản trở sơ tán sẽ bị cách chức và giam giữ. Kháng cự vũ trang sẽ bị coi là phản quốc."

# game/Story03.rpy:5524
translate vietnamese akt3chapter5_1_6d1dbdd6:

    # mc "(No choice. No appeal. Exactly the kind of authority I despise.)"
    mc "(Không lựa chọn. Không khiếu nại. Đúng kiểu thẩm quyền mà tôi ghét.)"

# game/Story03.rpy:5525
translate vietnamese akt3chapter5_1_fb42c328:

