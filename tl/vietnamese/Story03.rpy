translate vietnamese akt3chapter2_2_2b35b6fe_3:

    # mc "..."
    mc "..."

# game/Story03.rpy:2770
translate vietnamese akt3chapter2_2_cc594085:

    # mc "I’m moved. Deeply."
    mc "Tôi cảm động lắm. Thật sâu sắc."

# game/Story03.rpy:2771
translate vietnamese akt3chapter2_2_ed5d4173:

    # mc "Wait... You’re getting us out of here?"
    mc "Khoan... Cô đang đưa chúng tôi ra khỏi đây sao?"

