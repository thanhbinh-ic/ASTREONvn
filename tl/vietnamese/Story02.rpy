translate vietnamese akt2chapter5_5_459b6198:

    # mc "How was I supposed to know it was for women?"
    mc "Làm sao tôi biết được đó là phòng dành cho nữ?"

# game/Story02.rpy:3704
translate vietnamese akt2chapter5_5_cd241ab3:

