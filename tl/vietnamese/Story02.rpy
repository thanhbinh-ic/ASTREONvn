translate vietnamese akt2chapter5_5_951fa4f4:

    # mc "Is that so? Or is it Aisha’s words playing a bigger role here?"
    mc "Thật vậy sao? Hay lời của Aisha mới đóng vai trò lớn hơn ở đây?"

# game/Story02.rpy:3723
