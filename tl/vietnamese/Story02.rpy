translate vietnamese akt2chapter5_5_0e9233a6:

    # mc "I'm old enough to be your father."
    mc "Tôi đủ tuổi làm cha cô rồi."

# game/Story02.rpy:3810
translate vietnamese akt2chapter5_5_5de69e42:

    # Fl "Whoa, hold on."
    Fl "Khoan, từ từ đã."

# game/Story02.rpy:3811
translate vietnamese akt2chapter5_5_2861a979:

    # Fl "First of all, that's my decision to make."
    Fl "Trước hết, đó là quyết định của tôi."

# game/Story02.rpy:3812
translate vietnamese akt2chapter5_5_37580000:

    # Fl "And second..."
    Fl "Và thứ hai…"

# game/Story02.rpy:3815
translate vietnamese akt2chapter5_5_af7ffb2f:

    # Fl "In two days you've won Astoria's support... {w}earned the Peacemakers' respect... {w}got through to Ember..."
    Fl "Trong hai ngày anh đã giành được sự ủng hộ của Astoria… {w}sự tôn trọng của Peacemakers… {w}thuyết phục được Ember…"

# game/Story02.rpy:3816
translate vietnamese akt2chapter5_5_41e2eee3:

    # Fl "...and looked after my father."
    Fl "…và chăm sóc cha tôi."

# game/Story02.rpy:3817
translate vietnamese akt2chapter5_5_57ef6b3e:

    # Fl "Not exactly an average resume."
    Fl "Không hẳn là một lý lịch tầm thường."

# game/Story02.rpy:3819
translate vietnamese akt2chapter5_5_410d8f61:

    # mc "Guess I’m just lucky."
    mc "Chắc tôi chỉ may mắn thôi."

# game/Story02.rpy:3821
translate vietnamese akt2chapter5_5_75c71e1c:

    # Fl "Luck alone doesn't get you this far."
    Fl "Chỉ may mắn thôi thì không đưa anh đi xa tới vậy được."

# game/Story02.rpy:3822
translate vietnamese akt2chapter5_5_73df1900:

    # "Watching Flora, you notice her eyes keep straying to your body."
    "Nhìn Flora, anh nhận thấy ánh mắt cô cứ liếc về phía cơ thể anh."

# game/Story02.rpy:3823
translate vietnamese akt2chapter5_5_971d7fd6:

    # Fl "You're... a lot more than just lucky."
    Fl "Anh… còn hơn cả may mắn nhiều."

