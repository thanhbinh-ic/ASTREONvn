    mc "Звучит почти идеально."

# game/script.rpy:1531
translate russian homedinner_88971f56:

    # mc "If it weren’t for one small thing."
    mc "Если бы не одна маленькая деталь."

# game/script.rpy:1533
translate russian homedinner_8107b7b7:

    # mc "Why that place?"
    mc "Почему именно это место?"

# game/script.rpy:1535
translate russian homedinner_62d63fc1:

    # N "I told you. It was convenient."
    N "Я же сказал. Так было удобно."

# game/script.rpy:1537
translate russian homedinner_4ae86496:

    # mc "Convenient."
    mc "Удобно."

# game/script.rpy:1539
translate russian homedinner_0563d991:

    # mc "{b}Sigh{/b}"
    mc "{i}*вздох*{/i}"

# game/script.rpy:1543
translate russian homedinner_152e55f9:

    # mc "Let me get this straight..."
    mc "Давай уточним..."

# game/script.rpy:1544
translate russian homedinner_bd08447a:

    # mc "First you say you went to the mountains, then turns out you were in the forest…"
    mc "Сначала ты говоришь, что вы поехали в горы, а потом оказывается, что вы были в лесу..."

# game/script.rpy:1545
translate russian homedinner_d7917ac8:

    # mc "What’s the truth, Norman?"
    mc "В чём же правда, Норман?"

# game/script.rpy:1547
translate russian homedinner_c8bbc0cd:

    # N "I mean... we took a detour. A long one, maybe."
    N "Я имел в виду... мы сделали крюк. Может, большой."

# game/script.rpy:1549
translate russian homedinner_8d0f132b:

    # mc "Norman..."
    mc "Норман..."

# game/script.rpy:1550
translate russian homedinner_a476baf6:

    # mc "I wouldn't have said a word if it had been {b}any{/b} other place."
    mc "Я бы ни слова не сказал, если бы это было {b}любое{/b} другое место."

# game/script.rpy:1551
translate russian homedinner_880d41c1:

    # mc "But that place?"
    mc "Но это место?"

# game/script.rpy:1553
translate russian homedinner_5f904a26:

    # mc "You {b}remember{/b} what happened there, don’t you?"
    mc "Ты ведь {b}помнишь{/b}, что там произошло?"

# game/script.rpy:1554
translate russian homedinner_ab89efeb:

    # mc "Almost the entire rescue team wiped out."
    mc "Почти вся спасательная группа погибла."

# game/script.rpy:1555
translate russian homedinner_a7ff9e9d:

    # mc "You, and two others — that’s all who came back."
    mc "Ты и ещё двое - это все, кто вернулся."

# game/script.rpy:1556
translate russian homedinner_42edeb5b:

    # mc "And now you’re telling me... {w=0.5}{b}YOU{/b} {w=0.3}took {w=0.3}{b}YOUR FAMILY{/b} back to that godforsaken place?"
    mc "И теперь ты говоришь мне... {w=0.5}{b}ТЫ {w=0.3}ОТВЁЗ {w=0.3}СВОЮ СЕМЬЮ{/b} обратно в это проклятое место?"

# game/script.rpy:1557
translate russian homedinner_1e6e8052:

    # mc "Why, Norman? {w}...Why would you even think that was okay?"
    mc "Зачем, Норман? {w}...Как ты вообще решил, что это нормально?"

# game/script.rpy:1561
translate russian homedinner_f2003b32:

    # mc "Say something."
    mc "Скажи что-нибудь."

# game/script.rpy:1562
translate russian homedinner_30e866ec:

    # mc "Norman."
    mc "Норман."

# game/script.rpy:1564
translate russian homedinner_088edc0d:

    # mc "Why the hell are you sitting there like a statue?!"
    mc "Какого чёрта ты сидишь как статуя?!"

# game/script.rpy:1567
translate russian homedinner_8e695267:

    # mc "ANSWER ME!"
    mc "ОТВЕТЬ МНЕ!"

# game/script.rpy:1570
translate russian homedinner_d4440dba:

    # mc "WHY DID YOU DO THAT!"
    mc "ПОЧЕМУ ТЫ ЭТО СДЕЛАЛ?!"

# game/script.rpy:1573
translate russian homedinner_531da185:

    # M "Grandpa... please don’t be mad at Dad..."
    M "Дедушка... пожалуйста, не злись на папу..."

# game/script.rpy:1574
translate russian homedinner_f37aac1f:

    # M "We were just trying to help you."
    M "Мы просто хотели тебе помочь."

# game/script.rpy:1576
translate russian homedinner_1c67c2c4:

    # M "Please... it’s not his fault."
    M "Пожалуйста... это не его вина."

# game/script.rpy:1577
translate russian homedinner_4973b41f:

    # M "WE WANTED TO HELP YOU!"
    M "МЫ ХОТЕЛИ ТЕБЕ ПОМОЧЬ!"

# game/script.rpy:1578
translate russian homedinner_21fb1796:

    # M "So please..."
    M "Так что, пожалуйста..."

# game/script.rpy:1585
translate russian homedinner_86d3c462:

    # L "Remember one thing, darling..."
    L "Запомни кое-что, дорогой..."

# game/script.rpy:1586
translate russian homedinner_281f81f5:

    # L "Even if the whole world turns its back on you..."
    L "Даже если весь мир отвернётся от тебя..."

# game/script.rpy:1587
translate russian homedinner_31265243:

    # L "There will always be someone willing to reach out their hand."
    L "Всегда найдётся кто-то, кто протянет тебе руку."

# game/script.rpy:1589
translate russian homedinner_aa804ecb:

    # L "So when that moment comes... please don’t push them away."
    L "И когда такой момент придёт... пожалуйста, не отталкивай эту руку."

# game/script.rpy:1596
translate russian homedinner_ad22dfaf:

    # mc "Alright, sunshine."
    mc "Хорошо, солнышко."

# game/script.rpy:1605
translate russian homedinner_398866d7:

    # mc "(So that’s what you meant back then… A helping hand, huh?)"
    mc "(Так вот что ты тогда имела в виду... рука помощи, значит?)"

# game/script.rpy:1607
translate russian homedinner_10c7bd7e:

    # mc "(They came back alive… but what if they hadn’t? What would’ve happened then?)"
    mc "(Они вернулись живыми... но если бы нет? Что бы тогда осталось?)"

# game/script.rpy:1608
translate russian homedinner_bb9db6f0:

    # mc "(But yelling won’t change anything. Calm down, [mc]. Listen first.)"
    mc "(Криками уже ничего не исправить. Успокойся, [mc!t]. Сначала выслушай.)"

# game/script.rpy:1610
translate russian homedinner_77470dfc:

    # mc "{b}Sighs{/b}"
    mc "{i}*вздох*{/i}"

# game/script.rpy:1612
translate russian homedinner_918fea83:

    # mc "I'm sorry."
    mc "Простите."

# game/script.rpy:1613
translate russian homedinner_96dc794d:

    # mc "I don’t know what came over me."
    mc "Я не знаю, что на меня нашло."

# game/script.rpy:1617
translate russian homedinner_c255645a:

    # mc "Thank you... dear."
    mc "Спасибо... дорогая."

# game/script.rpy:1621
translate russian homedinner_ec5145b3:

    # mc "You were saying?"
    mc "Что ты хотел сказать?"

# game/script.rpy:1625
translate russian homedinner_d8654138_1:

    # A "..."
    A "..."

# game/script.rpy:1629
translate russian homedinner_bf1933b3:

    # N "Thanks, honey."
    N "Спасибо, милая."

# game/script.rpy:1631
translate russian homedinner_6f547998:

    # N "Dad, will you join me outside for a bit? Just us?"
    N "Пап, выйдешь со мной ненадолго? Только мы."

# game/script.rpy:1633
translate russian homedinner_2b35b6fe_12:

    # mc "..."
    mc "..."

# game/script.rpy:1635
translate russian homedinner_159d1bfe:

    # M "But I wanted to hear more of his stories…"
    M "Но я хотела ещё послушать его рассказы..."

# game/script.rpy:1636
translate russian homedinner_ed78c13a:

    # A "Mina, Dad and Grandpa have something important to talk about. Once they’re done, you can have all the time you want."
    A "Мина, папе и дедушке нужно кое-что обсудить. Когда они закончат, он весь твой."

# game/script.rpy:1638
translate russian homedinner_30186401:

    # mc "Haha, we won’t be long, sweetheart."
    mc "Ха-ха, мы недолго, милая."

# game/script.rpy:1639
translate russian homedinner_9feec320:

    # M "Okay, you promised!"
    M "Ладно, ты обещал!"

# game/script.rpy:1640
translate russian homedinner_3fac3b71:

    # A "Alright Mina, let’s go clean up your room."
    A "Ладно, Мина, пойдём приберём твою комнату."

# game/script.rpy:1641
translate russian homedinner_2b35b6fe_13:

    # mc "..."
    mc "..."

# game/script.rpy:1643
translate russian homedinner_803ca8da:

    # mc "I’ll be waiting for you outside."
    mc "Я буду ждать тебя на улице."

# game/script.rpy:1650
translate russian homedinner_2b35b6fe_14:

    # mc "..."
    mc "..."

# game/script.rpy:1653
translate russian homedinner_03440e66:

    # mc "So. We're outside. Alone."
    mc "Ну. Мы снаружи. Одни."

# game/script.rpy:1654
translate russian homedinner_77933cbe:

    # mc "Now tell me... what was so important that you had to drag me away from the table?"
    mc "Теперь говори... что такого важного, что ты вытащил меня из-за стола?"

# game/script.rpy:1656
translate russian homedinner_61f0f8ec:

    # N "I’m... I’m not sure where to begin."
    N "Я... не знаю, с чего начать."

# game/script.rpy:1658
translate russian homedinner_800a61c0:

    # mc "Then start at the beginning. Why did you bring your family with you?"
    mc "Тогда начни сначала. Зачем ты взял с собой семью?"

# game/script.rpy:1660
translate russian homedinner_143a72a4:

    # N "Don’t worry. They weren’t in the forest — I left them in a hotel nearby."
    N "Не волнуйся. В лесу их не было - я оставил их в отеле неподалёку."

# game/script.rpy:1662
translate russian homedinner_c2320063:

    # mc "But why did you go there, Norman? I don’t need your visions. I need the truth."
    mc "Тогда зачем ты туда пошёл, Норман? Мне не нужны твои версии. Мне нужна правда."

# game/script.rpy:1665
translate russian homedinner_e74d3fa8:

    # N "Alright..."
    N "Ладно..."

# game/script.rpy:1666
translate russian homedinner_a9d62afd:

    # N "Do you remember, 7 years ago — when you got back from the army? Mom sent you a message."
    N "Помнишь, семь лет назад, когда ты вернулся из армии? Мама прислала тебе сообщение."

# game/script.rpy:1668
translate russian homedinner_6b7b2c61:

    # mc "Yeah. I remember. Said you were going to visit Grandma. Family business."
    mc "Да. Помню. Вы ехали к бабушке. Семейные дела."

# game/script.rpy:1670
translate russian homedinner_17ed4477:

    # N "Right. That’s what we told you."
    N "Да. Так мы тебе сказали."

# game/script.rpy:1672
translate russian homedinner_af899739:

    # mc "You're saying that was a lie?"
    mc "Хочешь сказать, это была ложь?"

# game/script.rpy:1674
translate russian homedinner_5a8b4a57:

    # N "...Not entirely. But it wasn't the full truth."
    N "...Не совсем. Но это была не вся правда."

# game/script.rpy:1676
translate russian homedinner_44492cfe:

    # mc "So, what was the real reason?"
    mc "Тогда какая была настоящая причина?"

# game/script.rpy:1678
translate russian homedinner_4a07f709:

    # N "...Back then, Mom had a plan. One she didn’t share with anyone."
    N "...Тогда у мамы был план. Такой, о котором она никому не сказала."

# game/script.rpy:1679
translate russian homedinner_1682c862:

    # N "Not even you."
    N "Даже тебе."

# game/script.rpy:1680
translate russian homedinner_24016b10:

    # N "She said we were stopping by the old house…"
    N "Она сказала, что мы заедем в старый дом..."

# game/script.rpy:1688
translate russian homedinner_f751205b:

    # a "Starlit Stand 2014, 7 year before the main event."
    a "Старлит Стэнд, 2014 год, за 7 лет до главных событий."

# game/script.rpy:1690
translate russian homedinner_209cf549:

    # N "Mom? This isn’t the road to our old house. Where are we really going?"
    N "Мам? Это не дорога к нашему старому дому. Куда мы на самом деле едем?"

# game/script.rpy:1692
translate russian homedinner_826f5bae:

    # L "Relax, sweetheart. We’re just making a little detour."
    L "Спокойно, милый. Мы просто сделаем небольшой крюк."

# game/script.rpy:1693
translate russian homedinner_f9378e5f:

    # L "Figured it might be nice to see the old place again. You barely remember it."
    L "Я подумала, тебе будет приятно снова увидеть старое место. Ты его почти не помнишь."

# game/script.rpy:1695
translate russian homedinner_9e9a8cf2:

    # N "But... why tell Dad something else?"
    N "Но... зачем было врать папе?"

# game/script.rpy:1697
translate russian homedinner_89eddacf:

    # L "Because some things are better left off the radar, honey."
    L "Потому что некоторые вещи лучше не показывать на радарах, милый."

# game/script.rpy:1698
translate russian homedinner_cbd4479b:

    # L "Call it a secret mission. Just you and me, alright?"
    L "Назовём это секретной миссией. Только ты и я, хорошо?"

# game/script.rpy:1700
translate russian homedinner_3b6c4b0e:

    # N "If you say so…"
    N "Если ты так говоришь..."

# game/script.rpy:1702
translate russian homedinner_2ec9ba79:

    # N "(I should’ve asked more. I should’ve {b}felt{/b} something was off.)"
    N "(Нужно было расспросить её. Нужно было {b}почувствовать{/b}, что что-то не так.)"

# game/script.rpy:1703
translate russian homedinner_e7dbe087:

    # N "(But she smiled. And when Mom smiled like that, the world felt... safe.)"
    N "(Но она улыбалась. А когда мама так улыбалась, мир казался... безопасным.)"

# game/script.rpy:1714
translate russian homedinner_ea5f0c7d:

    # L "We’ve got a meeting. A special one."
    L "У нас встреча. Особенная."

# game/script.rpy:1717
translate russian homedinner_9814a6a8:

    # L "Be polite, alright?"
    L "Будь вежлив, ладно?"

# game/script.rpy:1721
translate russian homedinner_08d49f3f:

    # L "Hey! Watch it— {w}(muttering) idiot."
    L "Эй! Осторожнее... {w}{i}*бормочет*{/i} идиот."

# game/script.rpy:1723
translate russian homedinner_a2360835:

    # R "This facility is exceptional."
    R "Место исключительное."

# game/script.rpy:1724
translate russian homedinner_13cf274f:

    # R "In all my years, I’ve never seen tech quite like this. It’s... rare."
    R "За все свои годы я не видел технологий такого уровня. Это... редкость."

# game/script.rpy:1726
translate russian homedinner_34483001:

    # a "Dr. Lee, that’s the seventh time you’ve said that this month."
    a "Доктор Ли, вы говорите это уже седьмой раз за месяц."

# game/script.rpy:1727
translate russian homedinner_32f071be:

    # a "Maybe it’s time you raised your standards."
    a "Может, пора поднять планку?"

# game/script.rpy:1729
translate russian homedinner_9855b0d1:

    # L "Apologies for the delay. Roadblock."
    L "Прошу прощения за задержку. Препятствие на дороге."

# game/script.rpy:1730
translate russian homedinner_bf3df5de:

    # L "Unplanned. Unwanted."
    L "Незапланированное. Нежелательное."

# game/script.rpy:1732
translate russian homedinner_f682acee:

    # R "Well, well. The elusive Ms. Lora. It’s been a long time coming."
    R "Ну надо же. Неуловимая мисс Лора. Давно ждал этой встречи."

# game/script.rpy:1734
translate russian homedinner_4b001033:

    # L "Dr. Li Wei. So this is the man behind the infamous theories."
    L "Доктор Ли Вэй. Так вот человек за этими печально известными теориями."

# game/script.rpy:1735
translate russian homedinner_bb547d97:

    # L "I was starting to think you were just a ghost behind a console."
    L "Я уже думала, вы просто призрак за консолью."

# game/script.rpy:1737
translate russian homedinner_21b11eac:

    # R "Ghosts don’t file patents, Ms. Lora. But I’m flattered you’ve kept up with my work."
    R "Призраки не оформляют патенты, мисс Лора. Но я польщён, что вы следите за моей работой."

# game/script.rpy:1739
translate russian homedinner_ae54e1cf:

    # L "Some of it. The rest felt like encrypted poetry with delusions of godhood."
    L "За частью. Остальное читалось как зашифрованная поэзия с манией величия."

# game/script.rpy:1741
translate russian homedinner_1ae69720:

    # R "That’s fair. Innovation tends to read like madness before it changes the world."
    R "Справедливо. Инновации часто выглядят безумием, прежде чем меняют мир."

# game/script.rpy:1745
translate russian homedinner_af8a82de:

    # R "And this would be...?"
    R "А это...?"

# game/script.rpy:1747
translate russian homedinner_2db2980d:

    # L "My son. Norman."
    L "Мой сын. Норман."

# game/script.rpy:1748
translate russian homedinner_b88e035e:

    # L "He still believes the world can be saved with equations."
    L "Он всё ещё верит, что мир можно спасти с помощью уравнений."

# game/script.rpy:1750
translate russian homedinner_2147685f:

    # R "An optimist, then. Rare breed these days."
    R "Оптимист, значит. Редкая порода в наши дни."

# game/script.rpy:1752
translate russian homedinner_a439dac1:

    # N "It’s... an honor to meet you, sir."
    N "Для меня... честь познакомиться с вами, сэр."

# game/script.rpy:1754
translate russian homedinner_13b620be:

    # R "The honor’s mine, Norman."
    R "Честь моя, Норман."

# game/script.rpy:1755
translate russian homedinner_691cd7ba:

    # R "You’re the kind of mind this world desperately needs. Untouched. Unbroken. {b}Yet{/b}."
    R "Такие умы отчаянно нужны этому миру. Нетронутый. Несломленный. {b}Пока что{/b}."

# game/script.rpy:1757
translate russian homedinner_9bd463c3:

    # a "Sir, you have a secured call from the board. Marked as priority-one."
    a "Сэр, у вас защищённый звонок от правления. Приоритет один."

# game/script.rpy:1759
translate russian homedinner_fed00cdc:

    # L "Sofia. Still playing watchdog, I see."
    L "София. Всё ещё сторожевой пёс, я смотрю."

# game/script.rpy:1761
translate russian homedinner_9005bab2:

    # s "Ms. Lora. Didn’t think I’d run into {b}you{/b} again."
    s "Мисс Лора. Не думала, что снова увижу именно {b}вас{/b}."

# game/script.rpy:1763
translate russian homedinner_caf0e002:

    # R "I wasn’t aware there was... history here."
    R "Не знал, что между вами... история."

# game/script.rpy:1765
translate russian homedinner_92fb8d81:

    # s "Oh, there is. But it’s classified under 'none of your business', sir."
