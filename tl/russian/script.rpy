    # mc "Fresh air in that forest?"
    mc "Свежий воздух в том лесу?"

# game/script.rpy:1526
translate russian homedinner_e1bdd8c1:

    # mc "...Interesting."
    mc "...Интересно."

# game/script.rpy:1528
translate russian homedinner_3775b189:

    # N "Yes, Dad. {w}It was peaceful. Just trees, sky... no traffic, no noise."
    N "Да, пап. {w}Там было спокойно. Деревья, небо... ни машин, ни шума."

