    # mc "…I never thought I’d hear that from you."
    mc "...Никогда не думал, что услышу такое от тебя."

# game/script.rpy:2272
translate russian homedinner_4536d0a0:
    # mc "No, Norman."
    mc "Нет, Норман."

# game/script.rpy:2273
translate russian homedinner_61b27e41:
    # mc "Not then. Not now."
    mc "Ни тогда. Ни сейчас."

# game/script.rpy:2275
translate russian homedinner_8e1f8f2d:
    # N "But you said it yourself…"
    N "Но ты сам сказал..."

# game/script.rpy:2276
translate russian homedinner_d147133e:
    # N "Mom was your ideal. And I was the reason she—"
    N "Мама была твоим идеалом. А я стал причиной, из-за которой она-"

# game/script.rpy:2284
translate russian homedinner_f4893451:
    # mc "…So that’s what’s been eating you."
    mc "...Значит, вот что грызло тебя всё это время."

# game/script.rpy:2289
translate russian homedinner_8a8f97b6:
    # N "I’m sorry, Dad..."
    N "Прости, пап..."

# game/script.rpy:2300
translate russian homedinner_6b05d07e:
    # mc "I should’ve said this years ago."
    mc "Я должен был сказать это много лет назад."

# game/script.rpy:2301
translate russian homedinner_0f731e6c:
    # mc "When it mattered."
    mc "Когда это ещё было важно."

# game/script.rpy:2303
translate russian homedinner_a9842cf0:
    # mc "I never blamed you for what happened to Lora."
    mc "Я никогда не винил тебя в том, что случилось с Лорой."

# game/script.rpy:2304
translate russian homedinner_333bec9e:
    # mc "Never."
    mc "Никогда."

# game/script.rpy:2305
translate russian homedinner_0eca2e81:
    # mc "But... I was angry."
    mc "Но... я был зол."

# game/script.rpy:2306
translate russian homedinner_b4547ee5:
    # mc "...I didn’t know what to do with it."
    mc "...И не знал, что с этой злостью делать."

# game/script.rpy:2307
translate russian homedinner_73b2bf3a:
    # mc "And instead of being your father…"
    mc "И вместо того, чтобы быть тебе отцом..."

# game/script.rpy:2308
translate russian homedinner_4147a07c:
    # mc "I lashed out."
    mc "я сорвался."

# game/script.rpy:2310
translate russian homedinner_4dd3e61d:
    # mc "I thought you’d hate me for it."
    mc "Я думал, ты возненавидишь меня за это."

# game/script.rpy:2311
translate russian homedinner_2c6e125c:
    # mc "So I ran."
    mc "Вот я и сбежал."

# game/script.rpy:2312
translate russian homedinner_dc876155:
    # mc "Coward."
    mc "Трус."

# game/script.rpy:2315
translate russian homedinner_b91b2589:
    # mc "If you can still hear me out…"
    mc "Если ты ещё можешь меня выслушать..."

# game/script.rpy:2317
translate russian homedinner_11b1f5e8:
    # mc "I’m sorry."
    mc "Прости."

# game/script.rpy:2321
translate russian homedinner_ce49ce38:
    # N "I… I don’t even know what to say."
    N "Я... я даже не знаю, что сказать."

# game/script.rpy:2323
translate russian homedinner_9ff07ede:
    # N "...but I hear you."
    N "...но я тебя услышал."

# game/script.rpy:2330
translate russian homedinner_10252e11:
    # N "...Dad?"
    N "...Пап?"

# game/script.rpy:2332
translate russian homedinner_1eefaa3c:
    # N "...There’s something else."
    N "...Есть ещё кое-что."

# game/script.rpy:2333
translate russian homedinner_a757f7a2:
    # N "One of my superiors asked me to give you this."
    N "Один из моих начальников попросил передать тебе это."

# game/script.rpy:2334
translate russian homedinner_64e54daf:
    # N "Said… you’d understand."
    N "Сказал... ты поймёшь."

# game/script.rpy:2337
translate russian homedinner_85d0eb7c:
    # N "All they told me was…"
    N "Всё, что мне сказали..."

# game/script.rpy:2339
translate russian homedinner_1998caff:
    # N "That it’s connected to your old mission in Al-Zahira."
    N "Что это связано с твоей старой миссией в Аль-Захире."

# game/script.rpy:2347
translate russian homedinner_92dcf7bf_1:
    # mc "(…No.)"
    mc "(...Нет.)"

# game/script.rpy:2348
translate russian homedinner_f9cd7d14:
    # mc "(That’s not possible.)"
    mc "(Это невозможно.)"

# game/script.rpy:2353
translate russian homedinner_e86e0376:
    # ri "P.S. We need you."
    ri "P.S. Ты нам нужен."

# game/script.rpy:2354
translate russian homedinner_2b35b6fe_21:
    # mc "..."
    mc "..."

# game/script.rpy:2356
translate russian homedinner_95b01614:
    # N "…What does it say?"
    N "...Что там написано?"

# game/script.rpy:2360
translate russian homedinner_922f59e9:
    # mc "then I need to call in people I swore I’d never involve again."
    mc "тогда мне придётся позвать людей, которых я поклялся больше никогда в это не втягивать."

# game/script.rpy:2378
translate russian anna_790bc65d:
    # mc "(I told myself I’d let you go…)"
    mc "(Я говорил себе, что отпущу тебя...)"

# game/script.rpy:2381
translate russian anna_6b77a0ba:
    # mc "(Even with all of this still around me.)"
    mc "(Даже когда всё вокруг всё ещё напоминает о тебе.)"

# game/script.rpy:2388
translate russian anna_87737a1c:
    # mc "(And now you’re back…)"
    mc "(А теперь ты вернулась...)"

# game/script.rpy:2389
translate russian anna_013c150b:
    # mc "(…Just enough to make me hope again.)"
    mc "(...Ровно настолько, чтобы я снова начал надеяться.)"

# game/script.rpy:2391
translate russian anna_fd1b878b:
    # mc "(All I remember… is how powerless I was.)"
    mc "(Всё, что я помню... это насколько я был беспомощен.)"

# game/script.rpy:2396
translate russian anna_f48d1f5c:
    # L "Back then… I didn’t think it would end like this."
    L "Тогда... я не думала, что всё закончится вот так."

# game/script.rpy:2398
translate russian anna_41c22eb4:
    # L "And I wasn’t planning to leave you."
    L "И я не собиралась тебя оставлять."

# game/script.rpy:2399
translate russian anna_b502ac01:
    # L "…Not like that."
    L "...Не так."

# game/script.rpy:2400
translate russian anna_b9e84e9b:
    # L "You know that."
    L "Ты ведь знаешь."

# game/script.rpy:2402
translate russian anna_55d2dc14:
    # mc "You and your jokes…"
    mc "Ты и твои шутки..."

# game/script.rpy:2403
translate russian anna_9ea35c7e:
    # mc "You’ve got no idea what those years were like."
    mc "Ты понятия не имеешь, какими были эти годы."

# game/script.rpy:2408
translate russian anna_788afdf9:
    # Lor "I know, darling."
    Lor "Я знаю, милый."

# game/script.rpy:2409
translate russian anna_08c079d2:
    # Lor "You don’t have to explain it."
    Lor "Тебе не нужно объяснять."

# game/script.rpy:2410
translate russian anna_11844110:
    # Lor "I know what it felt like."
    Lor "Я знаю, каково это."

# game/script.rpy:2412
translate russian anna_2ddb7ded:
    # mc "How would you know?"
    mc "Откуда тебе знать?"

# game/script.rpy:2413
translate russian anna_38bd3efd:
    # mc "You’re not real…"
    mc "Ты ведь не настоящая..."

# game/script.rpy:2414
translate russian anna_8bd034d1:
    # mc "(…So why does it feel like you are?)"
    mc "(...Тогда почему кажется, что настоящая?)"

# game/script.rpy:2417
translate russian anna_9ec5f51f:
    # Lor "Hey… don’t start that again."
    Lor "Эй... не начинай снова."

# game/script.rpy:2418
translate russian anna_24755f83:
    # Lor "We both know where that spiral goes."
    Lor "Мы оба знаем, куда ведёт эта спираль."

# game/script.rpy:2424
translate russian anna_844d014a:
    # Lor "You’re scared."
    Lor "Тебе страшно."

# game/script.rpy:2426
translate russian anna_3fae39b4:
    # mc "I didn’t say that."
    mc "Я этого не говорил."

# game/script.rpy:2428
translate russian anna_02c0fff1:
    # Lor "You didn’t need to say it."
    Lor "Тебе и не нужно было."

# game/script.rpy:2431
translate russian anna_8c0412ba:
    # Lor "...Alright."
    Lor "...Ладно."

# game/script.rpy:2432
translate russian anna_d0d4f056:
    # Lor "Let’s not pretend you don’t know why I’m here."
    Lor "Давай не будем притворяться, будто ты не знаешь, почему я здесь."

# game/script.rpy:2433
translate russian anna_a194443c:
    # Lor "You saw the letter."
    Lor "Ты видел письмо."

# game/script.rpy:2434
translate russian anna_9360410d:
    # Lor "That was enough."
    Lor "Этого хватило."

# game/script.rpy:2436
translate russian anna_cf1adef2:
    # mc "Yeah."
    mc "Да."

# game/script.rpy:2437
translate russian anna_d1387c49:
    # mc "They say they found out what happened to you."
    mc "Они говорят, что выяснили, что с тобой случилось."

# game/script.rpy:2438
translate russian anna_071ff729:
    # mc "Why you disappeared."
    mc "Почему ты исчезла."

# game/script.rpy:2440
translate russian anna_f5395ae9:
    # Lor "Wait…"
    Lor "Погоди..."

# game/script.rpy:2441
translate russian anna_0d778420:
    # Lor "Since when is Norman tied to the military?"
    Lor "С каких пор Норман связан с военными?"

# game/script.rpy:2442
translate russian anna_d44a1583:
    # Lor "...No, right."
    Lor "Нет... точно."

# game/script.rpy:2443
translate russian anna_4365a34d:
    # Lor "You never told me."
    Lor "Ты мне не рассказывал."

# game/script.rpy:2445
translate russian anna_09f95b5c:
    # mc "He followed in my footsteps."
    mc "Он пошёл по моим стопам."

# game/script.rpy:2446
translate russian anna_055408f6:
    # mc "Though unlike me… he’s stuck behind a desk."
    mc "Правда, в отличие от меня... он застрял за столом."

# game/script.rpy:2447
translate russian anna_84a3f8f6:
    # mc "Doesn’t see much of the front."
    mc "Фронт видит нечасто."

# game/script.rpy:2448
translate russian anna_dbcec2a5:
    # mc "Yeah… thanks for that, Richard."
    mc "Да... за это спасибо, Ричард."

# game/script.rpy:2450
translate russian anna_eb286c94:
    # Lor "Oh."
    Lor "Ох."

# game/script.rpy:2451
translate russian anna_e5e66875:
    # Lor "That’s why Alexa looked at him like that."
    Lor "Так вот почему Алекса так на него смотрела."

# game/script.rpy:2454
translate russian anna_93b42537:
    # mc "(…And just like that—)"
    mc "(...И вот так просто-)"

# game/script.rpy:2461
translate russian anna_7d99578b:
    # Lor "…Wait."
    Lor "...Погоди."

# game/script.rpy:2462
translate russian anna_37e6a11b:
    # Lor "Is that Anya?"
    Lor "Это Аня?"

# game/script.rpy:2464
translate russian anna_964e3083:
    # mc "Looks like it."
    mc "Похоже на то."

# game/script.rpy:2465
translate russian anna_253ebf86:
    # mc "Probably got herself into trouble again."
    mc "Наверное, опять вляпалась в неприятности."

# game/script.rpy:2467
translate russian anna_f46e9117:
    # Lor "So?"
    Lor "И?"

# game/script.rpy:2468
translate russian anna_d890d8a9:
    # Lor "What are you going to do?"
    Lor "Что собираешься делать?"

# game/script.rpy:2472
translate russian anna_467e0a89:
    # mc "Like I’ve got a choice."
    mc "Как будто у меня есть выбор."

# game/script.rpy:2473
translate russian anna_88b09d1e:
    # mc "If Olivia hears about this… I’m dead before sunrise."
    mc "Если Оливия об этом узнает... я не доживу до рассвета."

# game/script.rpy:2489
translate russian anna_c6b0b742:
    # C "No, Jacob. I’m not your solution tonight."
    C "Нет, Джейкоб. Сегодня я не твой запасной выход."

# game/script.rpy:2490
translate russian anna_fd322812:
    # C "Or ever. Get that through your skull."
    C "И никогда не буду. Вбей себе в голову."

# game/script.rpy:2493
translate russian anna_2d5565c2:
    # d "Damn, Jacob. Didn’t you say she wouldn’t fight it?"
    d "Чёрт, Джейкоб. Ты же говорил, она не будет сопротивляться?"

# game/script.rpy:2497
translate russian anna_30cce330:
    # C "Find yourself some other desperate girl to dump this on. I don’t do charity."
    C "Найди другую отчаявшуюся девчонку, на которую можно всё это свалить. Благотворительностью я не занимаюсь."

# game/script.rpy:2498
translate russian anna_ef6d7244:
    # C "Especially not for idiots."
    C "Особенно для идиотов."

# game/script.rpy:2507
translate russian anna_5d860d27:
    # D "I’ve got to pick up my kid from my ex."
    D "Мне ещё ребёнка у бывшей забирать."

# game/script.rpy:2513
translate russian anna_36ec17e3:
    # mc "Easy…"
    mc "Спокойно..."

# game/script.rpy:2514
translate russian anna_ddd8ffec:
    # mc "Don’t move."
    mc "Не двигайся."

# game/script.rpy:2523
translate russian anna_adadf7ee:
    # mc "(Someone’s got a death wish… going against Olivia.)"
    mc "(Кто-то явно жить устал... раз идёт против Оливии.)"

# game/script.rpy:2526
translate russian anna_3f40bee3:
    # e "And what would a girl like her see in a loser like you? What, she into weaklings?"
    e "И что такая девчонка нашла в таком неудачнике, как ты? Ей что, слабаки нравятся?"

# game/script.rpy:2528
translate russian anna_df8be869:
    # C "Oh wow… that’s your move? Beg, fail, and then stand there like furniture?"
    C "Ого... и это твой ход? Умолять, облажаться, а потом стоять как мебель?"

# game/script.rpy:2531
translate russian anna_1221c371:
    # e "Really? That’s great, mind if we get to know each other better?"
    e "Правда? Отлично. Не против, если мы познакомимся поближе?"

# game/script.rpy:2532
translate russian anna_86c1f8b1:
    # e "I’m sure we’d have a very memorable time."
    e "Уверен, время мы проведём незабываемо."

# game/script.rpy:2534
translate russian anna_f98d475a:
    # e "Might even make each other... feel things."
    e "Может, даже заставим друг друга... что-нибудь почувствовать."

# game/script.rpy:2536
translate russian anna_36a673b6:
    # C "You think this is flirting? That’s cute. Really. Almost embarrassing."
    C "Ты думаешь, это флирт? Мило. Правда. Почти неловко."

# game/script.rpy:2538
translate russian anna_28eb1bbd:
    # C "Kid, clean the milk off your lips before you start talking like you’ve seen the world."
    C "Мальчик, у тебя ещё молоко на губах не обсохло, а ты уже говоришь так, будто видел жизнь."

# game/script.rpy:2539
translate russian anna_65cf20b3:
    # C "And maybe, just maybe, learn who you’re barking at before you open your mouth again."
    C "И, может быть, хоть чуть-чуть думай, на кого лаешь, прежде чем снова открыть рот."

# game/script.rpy:2543
translate russian anna_4382d94c:
    # d "We’re gonna have some real fun with you, then dump you in a ditch."
    d "Мы с тобой как следует развлечёмся, а потом скинем в канаву."

# game/script.rpy:2545
translate russian anna_4c238468:
    # d "Though, to be fair, you’re the best catch we’ve had in a while."
    d "Хотя, честно говоря, ты лучший улов за последнее время."

# game/script.rpy:2547
translate russian anna_d1cf0328:
    # d "So thanks to this idiot for handing you over."
    d "Так что спасибо этому идиоту, что сам тебя привёл."

# game/script.rpy:2554
translate russian anna_cb904140:
    # d "How about we entertain ourselves, with him watching?"
    d "Как насчёт развлечься, пока он будет смотреть?"

# game/script.rpy:2555
translate russian anna_f5a954d4:
    # d "Bet the poor bastard loses his mind."
    d "Спорим, бедолага слетит с катушек."

# game/script.rpy:2557
translate russian anna_659468de:
    # C "Touch me… and I promise you won’t need to worry about girls ever again."
    C "Тронешь меня... и обещаю, о девушках тебе больше переживать не придётся."

# game/script.rpy:2559
translate russian anna_6b3157d4:
    # C "Actually, scratch that. Judging by the way you act? Might already be a lost cause."
    C "Хотя нет, беру назад. Судя по твоему поведению, там уже всё безнадёжно."

# game/script.rpy:2566
translate russian anna_62fcc2e4:
    # d "Would work great somewhere else."
    d "В другом месте пригодилась бы отлично."

# game/script.rpy:2568
translate russian anna_5f9346d3:
    # mc "I wouldn’t count on that."
    mc "Я бы на это не рассчитывал."

# game/script.rpy:2572
translate russian anna_7b591006:
    # d "Do you even know who I am, old man?"
    d "Ты вообще знаешь, кто я такой, старик?"

# game/script.rpy:2573
translate russian anna_5e996f76:
    # d "Get lost before we send you to a nursing home."
    d "Вали, пока мы не отправили тебя в дом престарелых."

# game/script.rpy:2580
translate russian anna_74af3728:
    # mc "Tell me something, gentlemen."
    mc "Скажите-ка мне, господа."

# game/script.rpy:2581
translate russian anna_f4e14abc_1:
    # mc "Who sent you?"
    mc "Кто вас послал?"

# game/script.rpy:2582
translate russian anna_1f432b6d:
    # mc "Choose your words carefully."
    mc "Подбирайте слова аккуратно."

# game/script.rpy:2583
translate russian anna_a1e8814c:
    # mc "I’d rather not get my hands dirty again."
    mc "Мне бы не хотелось снова марать руки."

# game/script.rpy:2588
translate russian anna_3c82d6a1:
    # d "Alright, alright! L-look, we were told to bring that girl in, alive, as a hostage."
    d "Ладно, ладно! С-слушай, нам сказали привести эту девчонку живой. В качестве заложницы."

# game/script.rpy:2592
translate russian anna_7b471f6f:
    # mc "Good."
    mc "Хорошо."

# game/script.rpy:2593
translate russian anna_8aa0e1b5:
    # mc "If I find out you lied…"
    mc "Если я узнаю, что ты соврал..."

# game/script.rpy:2594
translate russian anna_dd7680ce:
    # mc "you won’t get a second chance."
    mc "второго шанса у тебя не будет."

# game/script.rpy:2610
translate russian anna_15d75986:
    # C "That’s for putting your hands on me, you piece of shit."
    C "Это за то, что лапал меня, кусок дерьма."

# game/script.rpy:2612
translate russian anna_fa8cf989:
    # mc "Who were those guys?"
    mc "Кто были эти парни?"

# game/script.rpy:2614
translate russian anna_0874afc7:
    # C "Wish I knew… Sis is gonna flip when she hears about this."
    C "Сама бы хотела знать... Сестра с ума сойдёт, когда услышит."

# game/script.rpy:2616
translate russian anna_2b03cf49:
    # C "Still… thanks, [mc]. Seriously. I’ve lost count how many times you’ve bailed us out."
    C "И всё равно... спасибо, [mc!t]. Серьёзно. Я уже сбилась со счёта, сколько раз ты нас вытаскивал."

# game/script.rpy:2618
translate russian anna_25026f07:
    # d "You bastard! I won’t forget this!"
    d "Ублюдок! Я этого не забуду!"

# game/script.rpy:2644
translate russian anna_895037ab:
    # mc "I’m fine."
    mc "Я в порядке."

# game/script.rpy:2645
translate russian anna_7967e82f:
    # mc "What do we do with him?"
    mc "Что с ним делать?"

# game/script.rpy:2646
translate russian anna_194fd966:
    # C "This one? God, I’d love to finish him right here… but nah."
    C "С этим? Чёрт, я бы с радостью прикончила его прямо здесь... но нет."

# game/script.rpy:2647
translate russian anna_b9932f98:
    # C "Get lost. While you still can."
    C "Проваливай. Пока ещё можешь."

# game/script.rpy:2658
translate russian anna_9fe5a601:
    # C "And don’t show your face again, rat. Next time I won’t be this nice."
    C "И больше не показывайся, крыса. В следующий раз я не буду такой доброй."

# game/script.rpy:2662
translate russian anna_dd759c35:
    # C "Creepy, right? First he drags me into this, then they try to gut him."
    C "Жутковато, да? Сначала он втягивает меня в это, а потом они пытаются вспороть ему живот."

# game/script.rpy:2664
translate russian anna_17f42347:
    # C "What? I’m serious. Getting stabbed in the back? Feels like absolute garbage."
    C "Что? Я серьёзно. Удар в спину? Ощущение отвратительное."

# game/script.rpy:2669
translate russian anna_5f30dc14:
    # mc "How’d you even get into that mess?"
    mc "Как ты вообще в это влезла?"

# game/script.rpy:2679
translate russian anna_3e05e351:
    # C "Yeah, I know, I know… sounds stupid."
    C "Да, знаю, знаю... звучит тупо."

# game/script.rpy:2680
translate russian anna_00879fb8:
    # C "Jack calls me, says he’s in trouble. I’m like, fine, why not."
    C "Джек звонит, говорит, что попал в беду. Я такая: ладно, почему бы и нет."

# game/script.rpy:2682
translate russian anna_46468382:
    # C "I get there, and he’s on his knees in front of some thugs."
    C "Прихожу, а он стоит на коленях перед какими-то бандюками."

# game/script.rpy:2684
translate russian anna_2c7774db:
    # C "So I step in, thinking they’ll get scared and scatter."
    C "Ну я вмешалась, думала, испугаются и разбегутся."

# game/script.rpy:2686
translate russian anna_81640c92:
    # C "You know how it usually goes with me."
    C "Ты же знаешь, как у меня обычно бывает."

# game/script.rpy:2688
translate russian anna_1b42164e:
    # C "See someone in trouble… hype myself up… jump in headfirst."
    C "Вижу, что кто-то в беде... накручиваю себя... и прыгаю головой вперёд."

# game/script.rpy:2690
translate russian anna_84c23421:
    # C "Most of the time? They’re grateful. And I know exactly who I’m dealing with."
    C "В большинстве случаев? Люди благодарны. И я точно знаю, с кем имею дело."

# game/script.rpy:2692
translate russian anna_54aa8f8c:
    # C "If it’s some serious gang shit, I’m out."
    C "Если это серьёзные бандитские разборки, я сваливаю."

# game/script.rpy:2693
translate russian anna_76b7b032:
    # C "But punks like these? Why not have a little fun."
    C "Но такие шавки? Почему бы немного не развлечься."

# game/script.rpy:2695
translate russian anna_97334a33:
    # C "You help people like that, word spreads."
    C "Помогаешь таким людям - слухи расходятся."

# game/script.rpy:2696
translate russian anna_3693358d:
    # C "‘Oh, they’re nice, they’ve got your back’- boom, reputation up, money up. Easy."
    C "\"О, они нормальные, они прикроют\" - бум, репутация вверх, деньги вверх. Легко."

# game/script.rpy:2698
translate russian anna_2dbbfb40:
    # mc "That’s… one way to look at it."
    mc "Это... тоже взгляд."

# game/script.rpy:2699
translate russian anna_b076f446:
    # mc "But this time it went sideways."
    mc "Но в этот раз всё пошло не так."

# game/script.rpy:2701
translate russian anna_965b1579:
    # mc "What if I didn’t show up?"
    mc "А если бы я не появился?"

# game/script.rpy:2708
translate russian anna_f0247634:
    # C "Honestly? {w}No clue."
    C "Честно? {w}Без понятия."

# game/script.rpy:2709
translate russian anna_3e06dbef:
    # C "They’d probably pass me around… or just take what they want."
    C "Наверное, пустили бы по кругу... или просто взяли бы, что захотели."

# game/script.rpy:2710
translate russian anna_6fbc0ad9:
    # C "Wouldn’t be the first time someone tried."
    C "Не впервые кто-то попытался бы."

# game/script.rpy:2714
translate russian anna_9e63e9d9:
    # mc "You’ve got a strange way of looking at things."
    mc "У тебя странный взгляд на вещи."

# game/script.rpy:2718
translate russian anna_eefed0d9:
    # mc "If I hadn’t stepped in… your sister would’ve had my head."
    mc "Если бы я не вмешался... твоя сестра сняла бы мне голову."

# game/script.rpy:2721
translate russian anna_629d3482:
    # mc "You really know how to cause her trouble."
    mc "Ты правда умеешь создавать ей проблемы."

# game/script.rpy:2724
translate russian anna_6a393139:
    # C "Wouldn’t be me otherwise."
    C "Иначе это была бы уже не я."

# game/script.rpy:2725
translate russian anna_a00758fe:
    # C "Had to deal with her crap growing up—now it’s her turn."
    C "В детстве я терпела её закидоны - теперь её очередь."

# game/script.rpy:2728
translate russian anna_943118d6:
    # mc "Wait… you do this on purpose?"
    mc "Погоди... ты делаешь это специально?"

# game/script.rpy:2730
translate russian anna_b3705063:
    # C "Of course. What, you think I’m stupid or something?"
    C "Конечно. А что, ты думаешь, я тупая?"

# game/script.rpy:2734
translate russian anna_4c5115c1:
    # C "Hey! Rude!"
    C "Эй! Грубо!"

# game/script.rpy:2735
translate russian anna_556cdece:
    # mc "Kidding."
    mc "Шучу."

# game/script.rpy:2736
translate russian anna_cb0b1323:
    # C "(sigh)…you’re unbelievable."
    C "(вздыхает)...ты невозможен."

# game/script.rpy:2738
translate russian anna_4281e0a1:
    # C "So… what’s the plan for tonight?"
    C "Так... какие планы на вечер?"

# game/script.rpy:2739
translate russian anna_f0f87a6a:
    # mc "{b}We{/b} don’t have plans."
    mc "У {b}нас{/b} нет планов."

# game/script.rpy:2742
translate russian anna_21b6e183:
    # mc "{b}I{/b} do."
    mc "У {b}меня{/b} есть."

# game/script.rpy:2743
translate russian anna_1678c1f9:
    # mc "I’m meeting your sister."
    mc "Я встречаюсь с твоей сестрой."

# game/script.rpy:2772
translate russian anna_b2c5730a:
    # D "(What the hell is this?)"
    D "(Что за чёрт?)"

# game/script.rpy:2787
translate russian anna_47bf0074:
    # C "You know… I might not show it, but I was actually really glad I ran into you back there."
    C "Знаешь... может, я и не показываю, но я правда была рада, что тогда на тебя наткнулась."

# game/script.rpy:2788
translate russian anna_e9ce1a42:
    # C "So… what are you even doing here?"
    C "Так... что ты вообще здесь делаешь?"

# game/script.rpy:2791
translate russian anna_b00beead:
    # mc "Honestly… I’m a bit out of place here."
    mc "Честно... я здесь немного не в своей тарелке."

# game/script.rpy:2794
translate russian anna_bb930076:
    # C "You’re the only one who thinks that, you know."
    C "Знаешь, так думаешь только ты."

# game/script.rpy:2795
translate russian anna_e54921bf:
    # C "You should come by more often."
    C "Тебе стоит заходить почаще."

# game/script.rpy:2796
translate russian anna_efc7e09f:
    # C "Sis would be way too happy about it."
    C "Сестра была бы неприлично счастлива."

# game/script.rpy:2808
translate russian anna_32b4bc1a:
    # x "Great to see you, amigo! 15 years, and you’ve only gotten stronger!"
    x "Рад тебя видеть, амиго! Пятнадцать лет прошло, а ты только крепче стал!"

# game/script.rpy:2815
translate russian anna_3a285f4f:
    # mc "Good to see you too."
    mc "Я тоже рад тебя видеть."

# game/script.rpy:2816
translate russian anna_7156b3f9:
    # mc "But what are you doing here, Alexandro?"
    mc "Но что ты здесь делаешь, Алехандро?"

# game/script.rpy:2830
translate russian anna_3ebffef6:
    # C "If anything, we should be thanking you."
    C "Если уж на то пошло, это мы должны тебя благодарить."

# game/script.rpy:2831
translate russian anna_4c0b77d8:
    # C "Not every place gets a guard like you."
    C "Не каждому месту достаётся такой охранник, как ты."

# game/script.rpy:2832
translate russian anna_f172980f:
    # C "So yeah… works out pretty damn well for us."
    C "Так что да... для нас всё сложилось чертовски удачно."

# game/script.rpy:2834
translate russian anna_3745764e:
    # mc "I’m glad it worked out for you."
    mc "Рад, что у вас всё сложилось."

# game/script.rpy:2853
translate russian anna_f1e96b70:
    # mc "(Is it that obvious…?)"
    mc "(Это настолько заметно...?)"

# game/script.rpy:2855
translate russian anna_6fe6fa3a:
    # mc "(Or was I just lying to myself…?)"
    mc "(Или я просто врал самому себе...?)"

# game/script.rpy:2871
translate russian anna_8fd66b4b:
    # mc "…You good?"
    mc "...Ты в порядке?"

# game/script.rpy:2873
translate russian anna_41bb0b3b:
    # C "He’s like this every time someone mentions his crocodiles."
    C "Он такой каждый раз, когда кто-то упоминает его крокодилов."

# game/script.rpy:2875
translate russian anna_27e69cf6:
    # mc "…We didn’t see that."
    mc "...Мы ничего не видели."

# game/script.rpy:2877
translate russian anna_36d39742:
    # C "Yeah… let’s just pretend none of that happened."
    C "Да... давай просто сделаем вид, что ничего не было."

# game/script.rpy:2881
translate russian anna_b894cf57:
    # mc "Good seeing you again, Alex."
    mc "Рад был снова тебя увидеть, Алекс."

# game/script.rpy:2892
translate russian bar_olivica_edf5355d:
    # C "Well… welcome to our very humble little spot."
    C "Ну что... добро пожаловать в наше скромное местечко."

# game/script.rpy:2893
translate russian bar_olivica_07890832:
    # C "Try not to judge too hard."
    C "Только не суди слишком строго."

# game/script.rpy:2895
translate russian bar_olivica_c096500c:
    # mc "If this is humble, I’d hate to see what you call not humble."
    mc "Если это скромно, боюсь представить, что у вас называется нескромным."

# game/script.rpy:2897
translate russian bar_olivica_8dee34dd:
    # C "Thanks. We actually put a ton of work into this place."
    C "Спасибо. Мы правда вложили сюда кучу сил."

# game/script.rpy:2898
translate russian bar_olivica_76d92c76:
    # C "Expanded it, redid the whole interior…"
    C "Расширили, полностью переделали интерьер..."

# game/script.rpy:2900
translate russian bar_olivica_82947a6f:
    # C "Now it’s more like a proper lounge instead of that sad excuse of a bar we had before."
    C "Теперь это больше похоже на нормальный лаунж, а не на то жалкое подобие бара, что было раньше."

# game/script.rpy:2902
translate russian bar_olivica_832f3dc6:
    # C "Then again… calling it a bar back then is generous."
    C "Хотя... назвать то место баром уже было щедро."

# game/script.rpy:2903
translate russian bar_olivica_7cffe277:
    # C "It was more like a warehouse."
    C "Скорее склад."

# game/script.rpy:2904
translate russian bar_olivica_c8d77481:
    # C "…Or something worse."
    C "...Или что-то ещё хуже."

# game/script.rpy:2908
translate russian bar_olivica_0366ce67:
    # C "Anyway—"
    C "В общем-"

# game/script.rpy:2909
translate russian bar_olivica_c599426c:
    # C "What’s up with you?"
    C "А ты как?"

# game/script.rpy:2911
translate russian bar_olivica_b1feb6a8:
    # mc "I’ll admit… I’m impressed."
    mc "Признаю... впечатляет."

# game/script.rpy:2912
translate russian bar_olivica_02a994d9:
    # mc "But how the hell did you pull this off?"
    mc "Но как, чёрт возьми, вы это провернули?"

# game/script.rpy:2914
translate russian bar_olivica_567dc2b9:
    # C "(Deep sigh) …mmh."
    C "(тяжёлый вздох) ...мм."

# game/script.rpy:2916
translate russian bar_olivica_ed6af8a7:
    # C "That’s a secret I’m not ready to spill just yet."
    C "Этот секрет я пока раскрывать не готова."

# game/script.rpy:2917
translate russian bar_olivica_00bcc221:
    # C "Gotta keep some mystery, you know?"
    C "Надо же оставить немного загадочности, понимаешь?"

# game/script.rpy:2919
translate russian bar_olivica_48fc64b0:
    # mc "Yeah… figures."
    mc "Да... так я и думал."

# game/script.rpy:2920
translate russian bar_olivica_6f62820e:
    # mc "She had a hand in this, didn’t she?"
    mc "Это ведь не обошлось без неё?"

# game/script.rpy:2922
translate russian bar_olivica_c2160927:
    # C "I mean… it wasn’t just her."
    C "Ну... не только из-за неё."

# game/script.rpy:2923
translate russian bar_olivica_6e8f3500:
    # C "But yeah, Olivia carried most of it."
    C "Но да, большую часть тащила Оливия."

# game/script.rpy:2924
translate russian bar_olivica_28d29150:
    # C "Permits, paperwork, investors… she handled all that boring hell."
    C "Разрешения, бумаги, инвесторы... весь этот скучный ад был на ней."

# game/script.rpy:2926
translate russian bar_olivica_cd1ce94c:
    # C "Even pulled in some serious sponsors… no idea why they trusted us, but hey."
    C "Даже серьёзных спонсоров подтянула... понятия не имею, почему они нам поверили, но ладно."

# game/script.rpy:2927
translate russian bar_olivica_c845ee34:
    # C "…How are you holding up?"
    C "...Как ты держишься?"

# game/script.rpy:2928
translate russian bar_olivica_273687f7:
    # C "We heard what happened."
    C "Мы слышали, что случилось."

# game/script.rpy:2929
translate russian bar_olivica_97f733c6:
    # C "She really was… something else."
    C "Она правда была... невероятной."

# game/script.rpy:2933
translate russian bar_olivica_0faa46ad:
    # mc "Yeah…"
    mc "Да..."

# game/script.rpy:2934
translate russian bar_olivica_9a9ab2a0:
    # mc "She was."
    mc "Была."

# game/script.rpy:2936
translate russian bar_olivica_c0453b79:
    # mc "So… did you get into that university?"
    mc "Так... ты поступила в тот университет?"

# game/script.rpy:2937
translate russian bar_olivica_469e4353:
    # mc "That was your plan, right?"
    mc "У тебя ведь был такой план?"

# game/script.rpy:2951
translate russian bar_olivica_824d400c:
    # mc "Someone over there looks ready to blow."
    mc "Кто-то там выглядит так, будто сейчас взорвётся."

# game/script.rpy:2953
translate russian bar_olivica_0c2a221e:
    # C "No clue who you’re talking about."
    C "Без понятия, о ком ты."

# game/script.rpy:2960
translate russian bar_olivica_4d82ff0e:
    # h "Touch me again—"
    h "Ещё раз меня тронешь-"

# game/script.rpy:2961
translate russian bar_olivica_ac17b8d4:
    # h "I swear, I’ll drop you where you stand."
    h "Клянусь, уложу прямо на месте."

# game/script.rpy:2963
translate russian bar_olivica_0205bdaa:
    # h "Now."
    h "А теперь."

# game/script.rpy:2965
translate russian bar_olivica_bad1d9fe:
    # h "Run."
    h "Беги."

# game/script.rpy:2966
translate russian bar_olivica_9ec27acc:
    # h "Before I start taking fingers."
    h "Пока я не начала отрезать пальцы."

# game/script.rpy:2968
translate russian bar_olivica_7568d73f:
    # C "Oof… yeah. That’s rage mode."
    C "Уф... ага. Режим ярости включён."

# game/script.rpy:2969
translate russian bar_olivica_cd9047df:
    # C "She’s really pissed."
    C "Она реально кипит."

# game/script.rpy:2971
translate russian bar_olivica_c8d5820a:
    # mc "Yeah… she hasn’t changed."
    mc "Да... не изменилась."

# game/script.rpy:2973
translate russian bar_olivica_c19f4471:
    # C "She kinda has to be like that."
    C "Ей, в общем-то, приходится быть такой."

# game/script.rpy:2974
translate russian bar_olivica_046b908c:
    # C "Every day it’s the same story, some cocky idiot thinks he’s special."
    C "Каждый день одно и то же: какой-нибудь самоуверенный идиот решает, что он особенный."

# game/script.rpy:2975
translate russian bar_olivica_9dbc97fa:
    # C "Thinks he’s getting into her pants."
    C "Думает, что доберётся до её постели."

# game/script.rpy:2981
translate russian bar_olivica_8a2f5596:
    # mc "All these years… and you’re still the same."
    mc "Столько лет прошло... а ты всё та же."

# game/script.rpy:2983
translate russian bar_olivica_26be1618:
    # mc "…Hey."
    mc "...Привет."

# game/script.rpy:2989
translate russian bar_olivica_b12ff16f:
    # mc "Figured I’d stop by."
    mc "Решил заглянуть."

# game/script.rpy:2990
translate russian bar_olivica_cfc83f43:
    # mc "See how you’re holding up."
    mc "Посмотреть, как ты держишься."

# game/script.rpy:2992
translate russian bar_olivica_e13b5a7c:
    # C "Sis, ever thought about not scaring off the customers?"
    C "Сестрёнка, ты не думала хоть иногда не распугивать клиентов?"

# game/script.rpy:2995
translate russian bar_olivica_c1dff379:
    # h "Oh, I’m thriving."
    h "О, я цвету и пахну."

# game/script.rpy:2996
translate russian bar_olivica_0a06458c:
    # h "Can’t you tell?"
    h "Разве не видно?"

# game/script.rpy:2998
translate russian bar_olivica_2124740c:
    # h "Signed contracts."
    h "Подписала контракты."

# game/script.rpy:2999
translate russian bar_olivica_3bb1467a:
    # h "Pulled sponsors."
    h "Притащила спонсоров."

# game/script.rpy:3000
translate russian bar_olivica_5f6abc6d:
    # h "Expanded the place…"
    h "Расширила это место..."

# game/script.rpy:3001
translate russian bar_olivica_ddaf8aa4:
    # h "Even opened another bar across town."
    h "Даже открыла ещё один бар на другом конце города."

# game/script.rpy:3003
translate russian bar_olivica_6cf7a5bb:
    # C "Hey! Don’t ignore me!"
    C "Эй! Не игнорь меня!"

# game/script.rpy:3014
translate russian bar_olivica_bbff499d:
    # C "C’mon, don’t sulk."
    C "Ну хватит, не дуйся."

# game/script.rpy:3015
translate russian bar_olivica_5cc63ccb:
    # C "So I ignored your messages. Big deal."
    C "Ну проигнорировала я твои сообщения. Велика беда."

# game/script.rpy:3017
translate russian bar_olivica_d9c9dcff:
    # C "Now quit that and go charm our guest."
    C "А теперь хватит и иди очаровывай нашего гостя."

# game/script.rpy:3018
translate russian bar_olivica_bee2d9db:
    # C "You’ve got that scary-smile combo, use it."
    C "У тебя же есть этот фирменный пугающе-милый оскал. Пользуйся."

# game/script.rpy:3022
translate russian bar_olivica_c9670655:
    # h "It’s the same loop, {w=0.7}sleep, {w=0.5}work, {w=0.4}sleep, {w=0.3}work, {w=0.2}SLEEP, {w=0.1}WORK…"
    h "Один и тот же круг, {w=0.7}спать, {w=0.5}работать, {w=0.4}спать, {w=0.3}работать, {w=0.2}СПАТЬ, {w=0.1}РАБОТАТЬ..."

# game/script.rpy:3024
translate russian bar_olivica_066fc800:
    # h "I’m so fed up with it, you know? {w=0.9}HA-{w=0.2}HA-{w=0.1}HA, {w=0.5}Seven years — same damn grind. {w=1.2}And what do I have?{w=0.9} No boyfriend. {w=0.5}No husband. {w=0.3}Nothing."
    h "Меня уже тошнит от этого, понимаешь? {w=0.9}ХА-{w=0.2}ХА-{w=0.1}ХА, {w=0.5}семь лет - одна и та же чёртова пахота. {w=1.2}И что у меня есть?{w=0.9} Ни парня. {w=0.5}Ни мужа. {w=0.3}Ничего."

# game/script.rpy:3026
translate russian bar_olivica_86d7178e:
    # h "Meanwhile everyone else? Married. Kids. {w=0.9}CAN YOU BELIEVE IT? {w=0.7}AND THEY JUST LOVE REMINDING TO ME, {w=0.6}LAUGHING, {w=0.3}LIKE IT'S FUNNY."
    h "А у остальных что? Брак. Дети. {w=0.9}ТЫ МОЖЕШЬ В ЭТО ПОВЕРИТЬ? {w=0.7}И ОНИ ОБОЖАЮТ МНЕ ОБ ЭТОМ НАПОМИНАТЬ, {w=0.6}СМЕЮТСЯ, {w=0.3}БУДТО ЭТО СМЕШНО."

# game/script.rpy:3032
translate russian bar_olivica_90734342:
    # h "I’m doing amazing."
    h "У меня всё потрясающе."

# game/script.rpy:3033
translate russian bar_olivica_3c27171a:
    # h "Really."
    h "Правда."

# game/script.rpy:3034
translate russian bar_olivica_e7570b0e:
    # h "Couldn’t be better."
    h "Лучше некуда."

# game/script.rpy:3040
translate russian bar_olivica_7fb8b532:
    # h "Yeah, yeah, get lost."
    h "Да-да, проваливай."

# game/script.rpy:3042
translate russian bar_olivica_9e8f551c:
    # mc "Sounds like it’s been a long few years."
    mc "Похоже, годы выдались длинными."

# game/script.rpy:3043
translate russian bar_olivica_ebe63ac3:
    # mc "But after all this time…"
    mc "Но за всё это время..."

# game/script.rpy:3044
translate russian bar_olivica_5756eeae:
    # mc "With the way people look at you?"
    mc "С тем, как люди на тебя смотрят?"

# game/script.rpy:3045
translate russian bar_olivica_6de14027:
    # mc "You could’ve had anyone."
    mc "Ты могла бы выбрать кого угодно."

# game/script.rpy:3047
translate russian bar_olivica_b65b23e7:
    # h "(Scoffs) That’s the thing."
    h "(фыркает) Вот именно."

# game/script.rpy:3048
translate russian bar_olivica_8380d296:
    # h "It’s not about who {b}wants{/b} me."
    h "Дело не в том, кто меня {b}хочет{/b}."

# game/script.rpy:3049
translate russian bar_olivica_9d7d2f21:
    # h "It’s about who’s {b}worth{/b} it."
    h "Дело в том, кто этого {b}стоит{/b}."

# game/script.rpy:3055
translate russian bar_olivica_916603e8:
    # h "And no, it’s not about Anya. If that’s where your head went."
    h "И нет, это не про Аню. Если ты вдруг туда подумал."

# game/script.rpy:3061
translate russian bar_olivica_4489f1b5:
    # mc "…Good."
    mc "...Хорошо."

# game/script.rpy:3062
translate russian bar_olivica_632bbf91:
    # mc "Then I don’t need to step in."
    mc "Тогда мне не придётся вмешиваться."

# game/script.rpy:3065
translate russian bar_olivica_0c00b719:
    # h "I heard what happened."
    h "Я слышала, что случилось."

# game/script.rpy:3066
translate russian bar_olivica_c9deb6e0:
    # h "I’m… sorry."
    h "Мне... жаль."

# game/script.rpy:3072
translate russian bar_olivica_725dece2:
    # mc "I need a favor."
    mc "Мне нужна помощь."

# game/script.rpy:3073
translate russian bar_olivica_3ac2530a:
    # mc "Take a look at this."
    mc "Посмотри на это."

# game/script.rpy:3075
translate russian bar_olivica_d68677fd:
    # mc "I know we said we were done with this."
    mc "Знаю, мы говорили, что с этим покончено."

# game/script.rpy:3077
translate russian bar_olivica_dd3ea971:
    # mc "But the past doesn’t stay buried."
    mc "Но прошлое не лежит спокойно в земле."

# game/script.rpy:3088
translate russian bar_olivica_ffcb8198:
    # h "…Wait."
    h "...Погоди."

# game/script.rpy:3089
translate russian bar_olivica_f70f78cc:
    # h "That’s not possible…"
    h "Это невозможно..."

# game/script.rpy:3090
translate russian bar_olivica_fa4d5023:
    # h "He’s dead."
    h "Он мёртв."

# game/script.rpy:3091
translate russian bar_olivica_ea379f13:
    # h "You put him down yourself."
    h "Ты сам его уложил."

# game/script.rpy:3092
translate russian bar_olivica_6226149d:
    # h "Al-Zahira. Twenty years ago."
    h "Аль-Захира. Двадцать лет назад."

# game/script.rpy:3094
translate russian bar_olivica_08f4193e:
    # mc "Yeah… so did I."
    mc "Да... я тоже так думал."

# game/script.rpy:3095
translate russian bar_olivica_ddbda240:
    # mc "But this says otherwise."
    mc "Но вот это говорит об обратном."

# game/script.rpy:3096
translate russian bar_olivica_2fb5cb2b:
    # mc "He’s alive."
    mc "Он жив."

# game/script.rpy:3097
translate russian bar_olivica_f38e52d6:
    # mc "And looks better than both of us."
    mc "И выглядит лучше нас обоих."

# game/script.rpy:3099
translate russian bar_olivica_8583ef28:
    # mc "But that’s not why I’m here."
    mc "Но я здесь не из-за этого."

# game/script.rpy:3100
translate russian bar_olivica_a501270d:
    # mc "Look at the other one."
    mc "Посмотри на вторую."

# game/script.rpy:3102
translate russian bar_olivica_1727fc4b:
    # h "You’re serious…?"
    h "Ты серьёзно...?"

# game/script.rpy:3105
translate russian bar_olivica_cb711f44:
    # mc "I don’t know."
    mc "Я не знаю."

# game/script.rpy:3106
translate russian bar_olivica_a8b2ca56:
    # mc "But I need to find out."
    mc "Но мне нужно выяснить."

# game/script.rpy:3108
translate russian bar_olivica_8a44a794:
    # h "Anya."
    h "Аня."

# game/script.rpy:3109
translate russian bar_olivica_88fcaa18:
    # h "We’re closing early."
    h "Сегодня закрываемся раньше."

# game/script.rpy:3110
translate russian bar_olivica_7573f237:
    # h "Give them an hour. No more."
    h "Дай им час. Не больше."

# game/script.rpy:3114
translate russian bar_olivica_bc6769ce:
    # h "I’ve got bigger problems than reputation."
    h "У меня проблемы поважнее репутации."

# game/script.rpy:3134
translate russian bar_olivica_5774ad1e:
    # h "Your kid?"
    h "Твой сын?"

# game/script.rpy:3136
translate russian bar_olivica_af770035:
    # mc "My son…"
    mc "Мой сын..."

# game/script.rpy:3137
translate russian bar_olivica_610e1ad0:
    # mc "Long story."
    mc "Долгая история."

# game/script.rpy:3141
translate russian bar_olivica_6c4b4bc0:
    # mc "Enough to matter."
    mc "Достаточно надёжная, чтобы её не игнорировать."

# game/script.rpy:3145
translate russian bar_olivica_0f846bc5:
    # h "We lost Jake and Mona that day. Alexandro lost a leg, for life."
    h "В тот день мы потеряли Джека и Мону. Алехандро потерял ногу. Навсегда."

# game/script.rpy:3146
translate russian bar_olivica_b7f4533f:
    # h "All because some genius commander called friendly fire. Beautiful, right?"
    h "И всё потому, что какой-то гениальный командир вызвал огонь по своим. Красиво, правда?"

# game/script.rpy:3148
translate russian bar_olivica_d6ea48da:
    # h "And now, after all this time, they suddenly need you again?"
    h "И теперь, спустя столько времени, ты им вдруг снова понадобился?"

# game/script.rpy:3153
translate russian bar_olivica_0b7b9cf5:
    # mc "You know Richard handled it."
    mc "Ты знаешь, этим занимался Ричард."

# game/script.rpy:3155
translate russian bar_olivica_177c69b9:
    # h "Yeah… figures. So you didn’t."
    h "Да... конечно. Значит, ты - нет."

# game/script.rpy:3157
translate russian bar_olivica_54b1254f:
    # mc "Azarkhan’s people were already inside."
    mc "Люди Азархана уже были внутри."

# game/script.rpy:3159
translate russian bar_olivica_f154821a:
    # h "Don’t."
    h "Не надо."

# game/script.rpy:3160
translate russian bar_olivica_0506dede:
    # h "We both know that’s bullshit."
    h "Мы оба знаем, что это чушь."

# game/script.rpy:3161
translate russian bar_olivica_d5be1ed4:
    # h "This whole thing? It’s about that photo of Lora."
    h "Вся эта история? Она из-за той фотографии Лоры."

# game/script.rpy:3162
translate russian bar_olivica_ed098414:
    # h "That’s the only reason you’re even thinking about going back."
    h "Только поэтому ты вообще думаешь вернуться."

# game/script.rpy:3166
translate russian bar_olivica_cb89ebe5:
    # h "I get it."
    h "Я понимаю."

# game/script.rpy:3167
translate russian bar_olivica_025f9323:
    # h "You did your service. Came back. Tried to live quiet."
    h "Ты отслужил. Вернулся. Пытался жить тихо."

# game/script.rpy:3168
translate russian bar_olivica_cff6e378:
    # h "Then boom, your wife’s ‘dead’, and somehow you end up blaming your own kid for it."
    h "Потом бах - твоя жена \"мертва\", и ты каким-то образом начинаешь винить в этом собственного ребёнка."

# game/script.rpy:3170
translate russian bar_olivica_8541ef36:
    # h "And just when things start to calm down, here we go again."
    h "И только всё начинает успокаиваться - вот мы снова здесь."

# game/script.rpy:3175
translate russian bar_olivica_58db63cf:
    # h "Or {b}Oh, and your dead wife? Not so dead. Here, have some photos.{/b}"
    h "Или {b}О, кстати, твоя мёртвая жена? Не такая уж мёртвая. Держи фотографии.{/b}"

# game/script.rpy:3179
translate russian bar_olivica_f453b1a1:
    # mc "…What is that, a lollipop?"
    mc "...Это что, леденец?"

# game/script.rpy:3184
translate russian bar_olivica_47531656:
    # h "Your dumb lollipop idea actually worked."
    h "Твоя тупая идея с леденцами реально сработала."

# game/script.rpy:3185
translate russian bar_olivica_03cf958d:
    # h "So yeah… I’m sticking with it."
    h "Так что да... я её оставила."

# game/script.rpy:3189
translate russian bar_olivica_d0c95c5e:
    # h "You know… maybe it’s just not worth it."
    h "Знаешь... может, оно просто того не стоит."

# game/script.rpy:3190
translate russian bar_olivica_40110290:
    # h "Yeah, bringing Lora back sounds nice."
    h "Да, вернуть Лору звучит прекрасно."

# game/script.rpy:3191
translate russian bar_olivica_bd7db401:
    # h "But what if that’s not even her?"
    h "Но что, если это даже не она?"

# game/script.rpy:3195
translate russian bar_olivica_1fb892a4:
    # h "Maybe it’s time to stop chasing ghosts."
    h "Может, пора перестать гоняться за призраками."

# game/script.rpy:3196
translate russian bar_olivica_ac895541:
    # h "Look around."
    h "Оглянись."

# game/script.rpy:3197
translate russian bar_olivica_f9719142:
    # h "You’ve got something now."
    h "У тебя сейчас кое-что есть."

# game/script.rpy:3198
translate russian bar_olivica_bbb5080b:
    # h "And trust me, even that doesn’t last forever."
    h "И поверь мне, даже это не длится вечно."

# game/script.rpy:3202
translate russian bar_olivica_952433c1:
    # h "Just saying."
    h "Просто говорю."

# game/script.rpy:3204
translate russian bar_olivica_2034c056:
    # mc "Maybe."
    mc "Может быть."

# game/script.rpy:3205
translate russian bar_olivica_92e5ec4f:
    # mc "But if there’s even a chance I can bring her back…"
    mc "Но если есть хоть шанс вернуть её..."

# game/script.rpy:3206
translate russian bar_olivica_7a175569:
    # mc "I’m taking it."
    mc "я им воспользуюсь."

# game/script.rpy:3210
translate russian bar_olivica_57a458b0:
    # h "You’re still the same."
    h "Ты всё такой же."

# game/script.rpy:3216
translate russian bar_olivica_68c7d64f:
    # h "What happened?"
    h "Что случилось?"

# game/script.rpy:3220
translate russian bar_olivica_d3b8b40e:
    # h "Why are you just standing there? Talk."
    h "Чего ты стоишь? Говори."

# game/script.rpy:3227
translate russian bar_olivica_bb3c1e81:
    # h "We’ve got security for a reason."
    h "Охрана у нас не просто так."

# game/script.rpy:3228
translate russian bar_olivica_cdf7d9a3:
    # h "Why not let Alexandro throw them out?"
    h "Почему бы Александро их просто не выкинул?"

# game/script.rpy:3231
translate russian bar_olivica_f24f4fe4:
    # N "So, Dad, do you agree?"
    N "Так что, пап, ты согласен?"

# game/script.rpy:3233
translate russian bar_olivica_a9449331:
    # mc "I need to go."
    mc "Мне пора."

# game/script.rpy:3234
translate russian bar_olivica_56515523:
    # mc "If you’re in — tomorrow, 5:00 a.m."
    mc "Если ты с нами - завтра в пять утра."

# game/script.rpy:3235
translate russian bar_olivica_e13175e5:
    # mc "Outside my place."
    mc "У моего дома."

# game/script.rpy:3273
translate russian norman_home_eec2e5c2:
    # ri "But we’ve uncovered some information suggesting he’s backed by powerful entities."
    ri "Но мы обнаружили информацию, которая указывает, что за ним стоят могущественные силы."

# game/script.rpy:3275
translate russian norman_home_38af67a9:
    # ri "Possibly... extraterrestrial."
    ri "Возможно... внеземные."

# game/script.rpy:3281
translate russian norman_home_8de8e30b:
    # ri "I wish I could share the details..."
    ri "Хотел бы я поделиться подробностями..."

# game/script.rpy:3287
translate russian norman_home_72ad15d9:
    # ri "but I can’t do that in a letter."
    ri "но я не могу сделать это в письме."

# game/script.rpy:3307
translate russian norman_home_b1ed2926:
    # mc "(Going somewhere unknown… based on a letter.)"
    mc "(Идти в неизвестность... из-за письма.)"

# game/script.rpy:3308
translate russian norman_home_8d139eb3:
    # mc "(Most people would call that stupid.)"
    mc "(Большинство людей назвали бы это глупостью.)"

# game/script.rpy:3310
translate russian norman_home_a9275055:
    # mc "(And maybe they’d be right.)"
    mc "(И, может быть, были бы правы.)"

# game/script.rpy:3311
translate russian norman_home_db9cd3f8:
    # mc "(Maybe I should walk away.)"
    mc "(Может, мне стоит уйти.)"

# game/script.rpy:3314
translate russian norman_home_92ac0166:
    # mc "(A letter. Ghosts. Coordinates to nowhere.)"
    mc "(Письмо. Призраки. Координаты в никуда.)"

# game/script.rpy:3315
translate russian norman_home_3aa90f01:
    # mc "(Yeah… sounds insane.)"
    mc "(Да... звучит безумно.)"

# game/script.rpy:3316
translate russian norman_home_e7cafa64:
    # mc "(But I’m not turning my back on this.)"
    mc "(Но я не отвернусь.)"

# game/script.rpy:3319
translate russian norman_home_49dc7d32:
    # mc "(There are answers out there.)"
    mc "(Там есть ответы.)"

# game/script.rpy:3320
translate russian norman_home_9c683e77:
    # mc "(Answers I was never given.)"
    mc "(Ответы, которых мне так и не дали.)"

# game/script.rpy:3321
translate russian norman_home_b698a3db:
    # mc "(A life I never got to live.)"
    mc "(Жизнь, которой мне не дали прожить.)"

# game/script.rpy:3323
translate russian norman_home_d80e4225:
    # mc "(And somehow… it feels like hope.)"
    mc "(И почему-то... это похоже на надежду.)"

# game/script.rpy:3328
translate russian norman_home_ae5a2396:
    # mc "(That hope… it’s enough.)"
    mc "(Этой надежды... достаточно.)"

# game/script.rpy:3333
translate russian norman_home_3dc7acee:
    # mc "(Feels like I’m back there again.)"
    mc "(Будто я снова там.)"

# game/script.rpy:3338
translate russian norman_home_86616cc7:
    # mc "(This time… I find it.)"
    mc "(В этот раз... я найду это.)"

# game/script.rpy:3340
translate russian norman_home_f3e81283:
    # mc "(End what started.)"
    mc "(Закончу то, что началось.)"

# game/script.rpy:3341
translate russian norman_home_54a6bd68:
    # mc "(Take back what I lost.)"
    mc "(Верну то, что потерял.)"

# game/script.rpy:3343
translate russian norman_home_a49c2c10:
    # mc "Damn… sights are off again."
    mc "Чёрт... прицел снова сбился."

# game/script.rpy:3354
translate russian norman_home_d6ed2480:
    # mc "Why aren’t you asleep?"
    mc "Почему ты не спишь?"

# game/script.rpy:3355
translate russian norman_home_2ed83991:
    # mc "Something wrong?"
    mc "Что-то случилось?"

# game/script.rpy:3357
translate russian norman_home_fed672f5:
    # N "Dad… we need to talk."
    N "Пап... нам нужно поговорить."

# game/script.rpy:3362
translate russian norman_home_986dd057:
    # mc "It’s late."
    mc "Уже поздно."

# game/script.rpy:3363
translate russian norman_home_6b280b18:
    # mc "Go get some sleep."
    mc "Иди спать."

# game/script.rpy:3367
translate russian norman_home_4c9d4ac2:
    # N "I’m not a kid anymore, alright?!"
    N "Я уже не ребёнок, ясно?!"

# game/script.rpy:3370
translate russian norman_home_42937fd4:
    # N "I know what you’re planning."
    N "Я знаю, что ты задумал."

# game/script.rpy:3371
translate russian norman_home_7a7e5116:
    # N "You’re going after Mom…"
    N "Ты идёшь за мамой..."

# game/script.rpy:3372
translate russian norman_home_b0e9fca5:
    # N "But you don’t even know where to start!"
    N "Но ты даже не знаешь, с чего начать!"

# game/script.rpy:3373
translate russian norman_home_1216e26b:
    # mc "I’ve got coordinates."
    mc "У меня есть координаты."

# game/script.rpy:3374
translate russian norman_home_e4a94a9b:
    # N "Dad—!"
    N "Пап-!"

# game/script.rpy:3385
translate russian norman_home_0b348ba0:
    # mc "…Alright."
    mc "...Ладно."

# game/script.rpy:3386
translate russian norman_home_def0ad19:
    # mc "What is it?"
    mc "Что такое?"

# game/script.rpy:3392
translate russian norman_home_bb54adc5:
    # mc "We?"
    mc "Мы?"

# game/script.rpy:3393
translate russian norman_home_21882e03:
    # mc "You’re staying here."
    mc "Ты остаёшься здесь."

# game/script.rpy:3395
translate russian norman_home_39fbcbd3:
    # N "Why?! Why can’t I come with you?!"
    N "Почему?! Почему мне нельзя пойти с тобой?!"

# game/script.rpy:3399
translate russian norman_home_1e5dea99:
    # mc "Because you’ve got a life ahead of you."
    mc "Потому что у тебя впереди жизнь."

# game/script.rpy:3400
translate russian norman_home_2e34d625:
    # mc "I’m not letting that place take you too."
    mc "Я не позволю тому месту забрать и тебя."

# game/script.rpy:3402
translate russian norman_home_0aac8827:
    # N "And what about your life?!"
    N "А как же твоя жизнь?!"

# game/script.rpy:3403
translate russian norman_home_5437eb68:
    # N "What did you read in that letter?"
    N "Что было в том письме?"

# game/script.rpy:3404
translate russian norman_home_75140651:
    # N "And why the hell can’t I come with you?!"
    N "И почему, чёрт возьми, мне нельзя с тобой?!"

# game/script.rpy:3411
translate russian norman_home_54bd59ed:
    # mc "Let me ask you something."
    mc "Скажи мне вот что."

# game/script.rpy:3412
translate russian norman_home_d30fc7ed:
    # mc "You ever killed anyone?"
    mc "Ты когда-нибудь убивал человека?"

# game/script.rpy:3417
translate russian norman_home_06e622bb:
    # mc "I have."
    mc "Я - да."

# game/script.rpy:3418
translate russian norman_home_e4fbadc5:
    # mc "Dozens."
    mc "Десятки."

# game/script.rpy:3419
translate russian norman_home_d5be2dea:
    # mc "Hundreds."
    mc "Сотни."

# game/script.rpy:3423
translate russian norman_home_7eee3ca8:
    # N "W-why are you telling me this…?"
    N "З-зачем ты мне это говоришь...?"

# game/script.rpy:3426
translate russian norman_home_3c85550c:
    # mc "Because if I don’t make it… no one’s surprised."
    mc "Потому что если я не вернусь... никто не удивится."

# game/script.rpy:3427
translate russian norman_home_053fcea5:
    # mc "But you?"
    mc "А ты?"

# game/script.rpy:3428
translate russian norman_home_c5adb243:
    # mc "That’s different."
    mc "Это другое."

# game/script.rpy:3429
translate russian norman_home_745fa8fe:
    # N "Don’t say that!"
    N "Не говори так!"

# game/script.rpy:3430
translate russian norman_home_0867043c:
    # N "And besides… you don’t know that forest like I do!"
    N "И вообще... ты не знаешь тот лес так, как я!"

# game/script.rpy:3434
translate russian norman_home_8bf8f8f0:
    # mc "You sure about this?"
    mc "Ты уверен?"

# game/script.rpy:3436
translate russian norman_home_7a6a507b:
    # N "Yeah. I am."
    N "Да. Уверен."

# game/script.rpy:3443
translate russian norman_home_b632c3b2:
    # mc "You know how to use that?"
    mc "Ты знаешь, как этим пользоваться?"

# game/script.rpy:3447
translate russian norman_home_2e197ec0:
    # N "I don’t know if I’ve got the strength… or the guts."
    N "Я не знаю, хватит ли у меня сил... или смелости."

# game/script.rpy:3451
translate russian norman_home_9485ef37:
    # mc "Then if you’re coming with me… you don’t slow me down."
    mc "Тогда если идёшь со мной... не тормози."

# game/script.rpy:3455
translate russian norman_home_fc2feabf:
    # mc "You can still walk away."
    mc "Ты ещё можешь отказаться."

# game/script.rpy:3458
translate russian norman_home_c430cda6:
    # N "I’ll do whatever it takes. I promise."
    N "Я сделаю всё, что потребуется. Обещаю."

# game/script.rpy:3467
translate russian norman_home_2e7ce8c9:
    # N "…Thanks, Dad."
    N "...Спасибо, пап."

# game/script.rpy:3474
translate russian norman_home_f3ab6b64:
    # mc "You’ve grown."
    mc "Ты вырос."

# game/script.rpy:3484
translate russian norman_home_faf50b2f:
    # mc "(Was this the right call…?)"
    mc "(Правильное ли это решение...?)"

# game/script.rpy:3485
translate russian norman_home_a4717cc0:
    # mc "(Maybe I should talk him out of it…)"
    mc "(Может, мне стоит его отговорить...)"

# game/script.rpy:3487
translate russian norman_home_1fd9c707:
    # mc "(No. Enough.)"
    mc "(Нет. Хватит.)"

# game/script.rpy:3489
translate russian norman_home_3fec7c16:
    # mc "(He’s not a kid anymore.)"
    mc "(Он больше не ребёнок.)"

# game/script.rpy:3490
translate russian norman_home_4c4143cb:
    # mc "(Respect that.)"
    mc "(Уважай это.)"

# game/script.rpy:3496
translate russian norman_home_9b1d0ca0:
    # mc "(Alright… I’ve got everything.)"
    mc "(Ладно... всё собрано.)"

# game/script.rpy:3497
translate russian norman_home_f3ce1c03:
    # mc "(Just a few things left and—)"
    mc "(Осталось ещё пара вещей и-)"

# game/script.rpy:3504
translate russian norman_home_0814eb95:
    # mc "(Focus.)"
    mc "(Соберись.)"

# game/script.rpy:3505
translate russian norman_home_cc5a311f:
    # mc "(We’ve done this before.)"
    mc "(Мы уже делали это раньше.)"

# game/script.rpy:3510
translate russian norman_home_8f50b8d5:
    # L "Yeah… we thought it might be a good idea."
    L "Да... мы подумали, что это может быть хорошей идеей."

# game/script.rpy:3512
translate russian norman_home_0a7141c6:
    # L "Come on, you two."
    L "Давайте, вы двое."

# game/script.rpy:3513
translate russian norman_home_a4431043:
    # L "One picture. For the memory."
    L "Один снимок. На память."

# game/script.rpy:3527
translate russian norman_home_8e7b5abf:
    # L "Out of billions of people… and all the worlds out there—"
    L "Среди миллиардов людей... и всех миров где-то там-"

# game/script.rpy:3528
translate russian norman_home_36e59273:
    # L "we found each other here."
    L "мы нашли друг друга здесь."

# game/script.rpy:3529
translate russian norman_home_c6cc1ad6:
    # L "If that’s not fate… what is?"
    L "Если это не судьба... тогда что?"

# game/script.rpy:3535
translate russian norman_home_1ea17fc9:
    # L "You’re mine."
    L "Ты мой."

# game/script.rpy:3536
translate russian norman_home_9cdc58ac:
    # L "I’m never letting go."
    L "Я тебя никогда не отпущу."

# game/script.rpy:3539
translate russian norman_home_0faa46ad:
    # mc "Yeah…"
    mc "Да..."

# game/script.rpy:3540
translate russian norman_home_13d5535c:
    # mc "That’s how I’ll remember you."
    mc "Именно такой я тебя запомню."

# game/script.rpy:3541
translate russian norman_home_71a7e855:
    # mc "Always smiling."
    mc "Всегда улыбающейся."

# game/script.rpy:3542
translate russian norman_home_6c0d9e72:
    # mc "Always… alive."
    mc "Всегда... живой."

# game/script.rpy:3544
translate russian norman_home_b64ae0f6:
    # mc "(I’ve made my choice.)"
    mc "(Я сделал свой выбор.)"

# game/script.rpy:3545
translate russian norman_home_b635eead:
    # mc "(Thank you.)"
    mc "(Спасибо.)"

# game/script.rpy:3548
translate russian norman_home_32d52bdf:
    # mc "(…Goodbye.)"
    mc "(...Прощай.)"

# game/script.rpy:3551
translate russian norman_home_4e9dcf14:
    # Lor "...So you finally stopped running."
    Lor "...Значит, ты наконец перестал убегать."

# game/script.rpy:3553
translate russian norman_home_b75f347e:
    # Lor "...and chose to face it."
    Lor "...и решил встретить всё лицом к лицу."

# game/script.rpy:3557
translate russian norman_home_e4ac4fa7:
    # Lor "Thank you… my love."
    Lor "Спасибо тебе... любовь моя."

# game/script.rpy:3558
translate russian norman_home_061b5774:
    # Lor "For finally letting me go."
    Lor "За то, что наконец отпустил меня."

# game/script.rpy:3578
translate russian norman_home_8522a148:
    # mc "(Operation Drake. Al-Zahira, 2018.)"
    mc "(Операция «Дрейк». Аль-Захира, 2018.)"

# game/script.rpy:3579
translate russian norman_home_c59fb27c:
    # mc "(People vanished. No trace.)"
    mc "(Люди исчезали. Без следа.)"

# game/script.rpy:3581
translate russian norman_home_94ae8583:
    # mc "(Forest. Starlit Stand.)"
    mc "(Лес. Старлит-Стэнд.)"

# game/script.rpy:3582
translate russian norman_home_dadf74ea:
    # mc "(2030 incident.)"
    mc "(Инцидент 2030 года.)"

# game/script.rpy:3583
translate russian norman_home_9336b99b:
    # mc "(Same pattern. Larger scale.)"
    mc "(Та же схема. Масштаб больше.)"

# game/script.rpy:3584
translate russian norman_home_9b988aee:
    # mc "(Flash reported.)"
    mc "(Сообщалось о вспышке.)"

# game/script.rpy:3588
translate russian norman_home_83f097e3:
    # mc "(Different places… same result.)"
    mc "(Разные места... один результат.)"

# game/script.rpy:3590
translate russian norman_home_057664ee:
    # mc "(…And I was there. Both times.)"
    mc "(...И я был там. Оба раза.)"

# game/script.rpy:3594
translate russian norman_home_476a4e7d:
    # mc "(Norman mentioned a lab… in the forest.)"
    mc "(Норман говорил о лаборатории... в лесу.)"

# game/script.rpy:3595
translate russian norman_home_6772e516:
    # mc "(So Al-Zahira… had one too.)"
    mc "(Значит, в Аль-Захире... тоже была.)"

# game/script.rpy:3597
translate russian norman_home_6bae8be1:
    # mc "(No…)"
    mc "(Нет...)"

# game/script.rpy:3598
translate russian norman_home_587febbf:
    # mc "(Not a lab.)"
    mc "(Не лаборатория.)"

# game/script.rpy:3599
translate russian norman_home_87dc07b0:
    # mc "(Something inside it.)"
    mc "(Что-то внутри.)"

# game/script.rpy:3606
translate russian norman_home_0ddb25b9:
    # Lo "The topic’s kind of unsettling, It’s something related to teleportation…"
    Lo "Тема какая-то тревожная. Что-то про телепортацию..."

# game/script.rpy:3607
translate russian norman_home_35afdfd3:
    # Lo "I heard it requires energy. Living energy."
    Lo "Я слышала, для этого нужна энергия. Живая энергия."

# game/script.rpy:3611
translate russian norman_home_eb4217af:
    # mc "(Energy…)"
    mc "(Энергия...)"

# game/script.rpy:3616
translate russian norman_home_4c92d36d:
    # N "Something that was supposed to extend life."
    N "То, что должно было продлевать жизнь."

# game/script.rpy:3617
translate russian norman_home_e7904ce6:
    # N "But it turned out to be something else."
    N "Но оказалось, что это нечто другое."

# game/script.rpy:3620
translate russian norman_home_08998072:
    # N "It feeds… whatever’s inside."
    N "Оно питает... что бы там ни было внутри."

# game/script.rpy:3626
translate russian norman_home_9da6364c:
    # mc "(…Warp drive.)"
    mc "(...Варп-двигатель.)"

# game/script.rpy:3627
translate russian norman_home_5aeb54cf:
    # mc "(Norman said that before…)"
    mc "(Норман уже говорил об этом...)"

# game/script.rpy:3630
translate russian norman_home_16e0d69f:
    # mc "A warp drive?"
    mc "Варп-двигатель?"

# game/script.rpy:3631
translate russian norman_home_314befaf:
    # mc "You serious right now?"
    mc "Ты сейчас серьёзно?"

# game/script.rpy:3634
translate russian norman_home_c7ee0e67:
    # N "Dad, this is, this is real. I’m not making this up!"
    N "Пап, это... это правда. Я не выдумываю!"

# game/script.rpy:3636
translate russian norman_home_ce5d5458:
    # mc "(And I laughed at him…)"
    mc "(А я над ним смеялся...)"

# game/script.rpy:3637
translate russian norman_home_2b35b6fe_14:
    # mc "..."
    mc "..."

# game/script.rpy:3639
translate russian norman_home_d001d77a:
    # mc "(But the man in the mask…)"
    mc "(Но человек в маске...)"

# game/script.rpy:3646
translate russian norman_home_27ac3d31:
    # ri "...he’s backed by powerful entities."
    ri "...за ним стоят могущественные силы."

# game/script.rpy:3647
translate russian norman_home_38af67a9_1:
    # ri "Possibly... extraterrestrial."
    ri "Возможно... внеземные."

# game/script.rpy:3654
translate russian norman_home_30952361:
    # N "It wasn’t my choice… I was led there."
    N "Это был не мой выбор... меня туда привели."

# game/script.rpy:3655
translate russian norman_home_4f43fca7:
    # N "A man… wearing a black mask."
    N "Мужчина... в чёрной маске."

# game/script.rpy:3661
translate russian norman_home_843c0015:
    # mc "(That man…)"
    mc "(Тот человек...)"

# game/script.rpy:3662
translate russian norman_home_f0b24200:
    # mc "(The one behind all this…)"
    mc "(Тот, кто стоит за всем этим...)"

# game/script.rpy:3663
translate russian norman_home_4f04a60b:
    # mc "(It has to be him.)"
    mc "(Это должен быть он.)"

# game/script.rpy:3665
translate russian norman_home_3552c344:
    # mc "(He wasn’t random.)"
    mc "(Он появился не случайно.)"

# game/script.rpy:3666
translate russian norman_home_dc3cc150:
    # mc "(He was leading people there.)"
    mc "(Он вёл туда людей.)"

# game/script.rpy:3669
translate russian norman_home_ef6d4e8e:
    # mc "(…Or is it?)"
    mc "(...Или нет?)"

# game/script.rpy:3674
translate russian norman_home_69aac207:
    # C "(Singing a tune)"
    C "(напевает)"

# game/script.rpy:3676
translate russian norman_home_689e80c5:
    # C "Sooo… sis."
    C "Та-ак... сестрёнка."

# game/script.rpy:3677
translate russian norman_home_5576da5d:
    # C "What are you gonna do about [mc]’s little request?"
    C "Что ты собираешься делать с маленькой просьбой [mc!t]?"

# game/script.rpy:3682
translate russian norman_home_410ef59a:
    # h "After everything he’s done… walking away now would be a shitty move."
    h "После всего, что он сделал... уйти сейчас было бы паршивым поступком."

# game/script.rpy:3683
translate russian norman_home_0ce23733:
    # h "And I’ve still got a bit of pride left."
    h "И у меня ещё осталась капля гордости."

# game/script.rpy:3685
translate russian norman_home_ad988918:
    # C "Mhm… sure. Just pride."
    C "Угу... конечно. Только гордость."

# game/script.rpy:3686
translate russian norman_home_7601c879:
    # C "So what’s with the outfit?"
    C "Тогда что за наряд?"

# game/script.rpy:3687
translate russian norman_home_0ff21e2c:
    # C "You heading out on a job… or a very suspicious sleepover?"
    C "Ты на работу собралась... или на очень подозрительную ночёвку?"

# game/script.rpy:3688
translate russian norman_home_0a3fc9df:
    # h "Very funny."
    h "Очень смешно."

# game/script.rpy:3690
translate russian norman_home_b6223ac9:
    # h "Listen. I don’t know how long I’ll be gone."
    h "Слушай. Я не знаю, как долго меня не будет."

# game/script.rpy:3691
translate russian norman_home_1cf19a5f:
    # h "You’re in charge while I’m out. Don’t screw it up."
    h "Пока меня нет, ты главная. Не облажайся."

# game/script.rpy:3693
translate russian norman_home_72f868cb:
    # h "If anything comes up, go to Alexandro."
    h "Если что-то случится, иди к Алехандро."

# game/script.rpy:3695
translate russian norman_home_8eee42d2:
    # h "If it’s serious… Kayla."
    h "Если всё серьёзно... к Кейле."

# game/script.rpy:3696
translate russian norman_home_c2805f15:
    # h "But only if it’s really bad. Don’t panic-call her over nothing."
    h "Но только если правда плохо. Не звони ей в панике из-за ерунды."

# game/script.rpy:3698
translate russian norman_home_886fbfb4:
    # C "Relax. I’ve got this."
    C "Расслабься. Я справлюсь."

# game/script.rpy:3699
translate russian norman_home_f6ed6776:
    # C "I’m not a kid anymore."
    C "Я уже не ребёнок."

# game/script.rpy:3702
translate russian norman_home_18c61d40:
    # C "Just… be careful, okay?"
    C "Просто... будь осторожна, ладно?"

# game/script.rpy:3703
translate russian norman_home_fa9181a5:
    # C "I’ve heard things about that place. None of them nice."
    C "Я слышала кое-что о том месте. Ничего хорошего."

# game/script.rpy:3706
translate russian norman_home_e8c800e8:
    # h "We’ve handled worse. Don’t worry about me."
    h "Мы справлялись и с худшим. Не волнуйся за меня."

# game/script.rpy:3708
translate russian norman_home_138f8048:
    # C "Besides… he’s still stuck in the past."
    C "К тому же... он всё ещё застрял в прошлом."

# game/script.rpy:3709
translate russian norman_home_e3e6e830:
    # C "You keep going back, you’re just gonna tear yourself apart."
    C "Если будешь всё время возвращаться назад, просто разорвёшь себя на части."

# game/script.rpy:3718
translate russian norman_home_e5ae64f1:
    # h "That’s my mess to deal with."
    h "Это моя каша, мне её и расхлёбывать."

# game/script.rpy:3719
translate russian norman_home_66e1bbfc:
    # h "Take care, Anya."
    h "Береги себя, Аня."

# game/script.rpy:3720
translate russian norman_home_8b9f197c:
    # h "And seriously, don’t burn the place down."
    h "И серьёзно, не спали тут всё."

# game/script.rpy:3722
translate russian norman_home_fcffed5b:
    # C "Heh. No promises."
    C "Хех. Ничего не обещаю."

# game/script.rpy:3731
translate russian norman_home_865d11d9:
    # CC "Alone again. Cute."
    CC "Снова одна. Мило."

# game/script.rpy:3732
translate russian norman_home_d52cc140:
    # CC "Still pretending you matter… that anyone actually needs you."
    CC "Всё ещё притворяешься, что значишь хоть что-то... что ты кому-то правда нужна."

# game/script.rpy:3734
translate russian norman_home_a1689f7e:
    # CC "You wanna know the truth, Anya?"
    CC "Хочешь знать правду, Аня?"

# game/script.rpy:3735
translate russian norman_home_4dbba7e0:
    # CC "They don’t leave because they have to."
    CC "Они уходят не потому, что обязаны."

# game/script.rpy:3736
translate russian norman_home_637b35ac:
    # CC "They leave because you’re exhausting."
    CC "Они уходят, потому что ты выматываешь."

# game/script.rpy:3737
translate russian norman_home_04927438:
    # CC "Dead weight."
    CC "Мёртвый груз."

# game/script.rpy:3739
translate russian norman_home_b4167937:
    # CC "You ever wonder why Olivia’s so cold with you?"
    CC "Ты хоть раз думала, почему Оливия с тобой такая холодная?"

# game/script.rpy:3740
translate russian norman_home_5483a5b6:
    # CC "There’s a reason."
    CC "Причина есть."

# game/script.rpy:3742
translate russian norman_home_efd2f7e5:
    # CC "She {b}blames{/b} you."
    CC "Она {b}винит{/b} тебя."

# game/script.rpy:3743
translate russian norman_home_b1d297f9:
    # CC "For mom. For everything that fell apart."
    CC "За маму. За всё, что развалилось."

# game/script.rpy:3745
translate russian norman_home_a7c8469a:
    # C "—No."
    C "-Нет."

# game/script.rpy:3746
translate russian norman_home_975bd40f:
    # C "She just… trusts me."
    C "Она просто... доверяет мне."

# game/script.rpy:3747
translate russian norman_home_dae8b479:
    # C "She knows I can handle myself."
    C "Она знает, что я справлюсь."

# game/script.rpy:3749
translate russian norman_home_de9a0fa5:
    # CC "No, sweetheart."
    CC "Нет, милая."

# game/script.rpy:3750
translate russian norman_home_bccec193:
    # CC "That’s just what you tell yourself."
    CC "Это ты просто сама себе рассказываешь."

# game/script.rpy:3751
translate russian norman_home_bb6ead61:
    # CC "She’s just too tired to keep saving you."
    CC "Она просто слишком устала снова тебя спасать."

# game/script.rpy:3753
translate russian norman_home_0fc7f4e5:
    # C "We’ve been over this."
    C "Мы уже это проходили."

# game/script.rpy:3755
translate russian norman_home_0d3b4d5e:
    # CC "Yeah. And I keep repeating it for a reason."
    CC "Да. И я не просто так повторяю."

# game/script.rpy:3756
translate russian norman_home_2779d2c2:
    # CC "Because you still won’t admit it."
    CC "Потому что ты всё ещё не хочешь признать."

# game/script.rpy:3760
translate russian norman_home_e26caf48:
    # CC "Mom died saving {b}you{/b}."
    CC "Мама умерла, спасая {b}тебя{/b}."

# game/script.rpy:3761
translate russian norman_home_c544f649:
    # CC "She should’ve let you go."
    CC "Ей надо было отпустить."

# game/script.rpy:3763
translate russian norman_home_18ad576b:
    # CC "You think she chose you?"
    CC "Думаешь, она выбрала тебя?"

# game/script.rpy:3764
translate russian norman_home_8146ab4c:
    # CC "No."
    CC "Нет."

# game/script.rpy:3765
translate russian norman_home_c8dad351:
    # CC "Panic. Instinct. A mistake."
    CC "Паника. Инстинкт. Ошибка."

# game/script.rpy:3767
translate russian norman_home_9a2647b8:
    # CC "And now you just… live with it."
    CC "А теперь ты просто... живёшь с этим."

# game/script.rpy:3768
translate russian norman_home_2fd6a33a:
    # CC "Pretending you’re not the reason everything broke."
    CC "Притворяешься, что не ты причина, по которой всё сломалось."

# game/script.rpy:3770
translate russian norman_home_1233cb3e:
    # C "Stop."
    C "Хватит."

# game/script.rpy:3774
translate russian norman_home_add74554:
    # CC "Olivia had to grow up overnight."
    CC "Оливии пришлось повзрослеть за одну ночь."

# game/script.rpy:3775
translate russian norman_home_c7aed395:
    # CC "Work at fifteen. Carry you through every breakdown."
    CC "Работать с пятнадцати. Тащить тебя через каждый срыв."

# game/script.rpy:3777
translate russian norman_home_dd9930a5:
    # CC "Remember that?"
    CC "Помнишь?"

# game/script.rpy:3778
translate russian norman_home_d2c61d3d:
    # CC "When you couldn’t even eat without falling apart?"
    CC "Как ты не могла даже есть, не разваливаясь на части?"

# game/script.rpy:3780
translate russian norman_home_df51ca74:
    # CC "She gave up everything for you."
    CC "Она отказалась от всего ради тебя."

# game/script.rpy:3782
translate russian norman_home_aac19fa4:
    # CC "If it wasn’t for you—"
    CC "Если бы не ты-"

# game/script.rpy:3783
translate russian norman_home_6b0c6193:
    # CC "she’d have a normal life."
    CC "у неё была бы нормальная жизнь."

# game/script.rpy:3784
translate russian norman_home_5f24ce4e:
    # CC "A future."
    CC "Будущее."

# game/script.rpy:3785
translate russian norman_home_ac745ec0:
    # CC "{b}Without you.{/b}"
    CC "{b}Без тебя.{/b}"

# game/script.rpy:3787
translate russian norman_home_69cf3d7d:
    # C "I SAID STOP!"
    C "Я СКАЗАЛА ХВАТИТ!"

# game/script.rpy:3794
translate russian norman_home_cb7b66d6:
    # C "You don’t get to say her name."
    C "Ты не имеешь права произносить её имя."

# game/script.rpy:3822
translate russian exit_abe34850:
    # h "Barely made it. The hell is with traffic at 5 AM?!"
    h "Еле успела. Что за чёрт с пробками в пять утра?!"

# game/script.rpy:3825
translate russian exit_c88f9506:
    # h "Private Olivia reporting for duty! Ready to serve!"
    h "Рядовая Оливия прибыла на службу! Готова служить!"

# game/script.rpy:3827
translate russian exit_2cbb8b4f:
    # mc "Cut the formality. You know I hate that."
    mc "Брось эту формальность. Ты знаешь, я это ненавижу."

# game/script.rpy:3830
translate russian exit_258b859f:
    # h "So? Anyone else joining, or am I stuck with you?"
    h "Ну? Ещё кто-то будет, или я застряла с тобой?"

# game/script.rpy:3832
translate russian exit_fedf44b2:
    # mc "No one else."
    mc "Больше никого."

# game/script.rpy:3833
translate russian exit_99fade4b:
    # mc "No one left."
    mc "Никого не осталось."

# game/script.rpy:3835
translate russian exit_1d0edfed:
    # h "Oh. So just us?"
    h "Ох. Значит, только мы?"

# game/script.rpy:3836
translate russian exit_3b66d8a1:
    # h "Well... that’s…"
    h "Ну... это..."

# game/script.rpy:3855
translate russian exit_1faf912c:
    # h "Drop it."
    h "Забудь."

# game/script.rpy:3857
translate russian exit_f16c798b:
    # mc "If you say so."
    mc "Как скажешь."

# game/script.rpy:3858
translate russian exit_1dbf79d0:
    # mc "Why are you here?"
    mc "Почему ты здесь?"

# game/script.rpy:3861
translate russian exit_92632303:
    # h "Wow. Didn’t know you had such faith in me."
    h "Вау. Не знала, что ты так в меня веришь."

# game/script.rpy:3862
translate russian exit_99630e69:
    # h "Want me to turn around? Say the word."
    h "Хочешь, развернусь? Только скажи."

# game/script.rpy:3864
translate russian exit_e19f9026:
    # mc "Don’t blame me, remember what you said when we first met?"
    mc "Не вини меня. Помнишь, что ты сказала при нашей первой встрече?"

# game/script.rpy:3873
translate russian exit_882b6493:
    # h "Wait… who are {b}they{/b}? Don’t tell me we’ve got more company."
    h "Погоди... а {b}они{/b} кто? Не говори, что у нас ещё компания."

# game/script.rpy:3875
translate russian exit_fca52711:
    # mc "No."
    mc "Нет."

# game/script.rpy:3876
translate russian exit_f4701e6e:
    # mc "Alexa stays."
    mc "Алекса остаётся."

# game/script.rpy:3877
translate russian exit_da69c8b6:
    # mc "Norman’s with us."
    mc "Норман идёт с нами."

# game/script.rpy:3881
translate russian exit_607738bf:
    # h "Huh. Look at you."
    h "Хм. Смотри-ка на тебя."

# game/script.rpy:3882
translate russian exit_3d113bd0:
    # h "Something happened last night?"
    h "Что-то случилось вчера ночью?"

# game/script.rpy:3883
translate russian exit_5b6c4fdb:
    # h "Last time I saw you smile…"
    h "В последний раз я видела, как ты улыбаешься..."

# game/script.rpy:3884
translate russian exit_896d2061:
    # h "…was years ago."
    h "...много лет назад."

# game/script.rpy:3886
translate russian exit_7c5159a8:
    # h "And just like that — gone again."
    h "И вот так просто - снова исчезла."

# game/script.rpy:3893
translate russian exit_22d54f7c:
    # N "Hey… don’t worry, alright?"
    N "Эй... не волнуйся, ладно?"

# game/script.rpy:3894
translate russian exit_dbd01f04:
    # N "We’ll be back in a couple days, safe and sound."
    N "Мы вернёмся через пару дней. Целые и невредимые."

# game/script.rpy:3895
translate russian exit_455d440e:
    # N "I love you."
    N "Я люблю тебя."

# game/script.rpy:3897
translate russian exit_7ea32c82:
    # N "Take care of yourself while I’m gone, okay?"
    N "Береги себя, пока меня нет, хорошо?"

# game/script.rpy:3901
translate russian exit_1398ea10:
    # N "And when I get back… we’ll talk about that, yeah?"
    N "А когда я вернусь... мы поговорим об этом, да?"

# game/script.rpy:3902
translate russian exit_8559a0d1:
    # N "About… another baby."
    N "О... ещё одном ребёнке."

# game/script.rpy:3903
translate russian exit_455d440e_1:
    # N "I love you."
    N "Я люблю тебя."

# game/script.rpy:3917
translate russian exit_1a6f80aa:
    # h "Gear’s on me."
    h "Снаряжение на мне."

# game/script.rpy:3921
translate russian exit_4fdae79c:
    # N "Yeah. I’m good."
    N "Да. Я в порядке."

# game/script.rpy:3923
translate russian exit_4b2d2196:
    # N "So… who’s she, exactly?"
    N "Так... кто она вообще?"

# game/script.rpy:3929
translate russian exit_78ee1714:
    # h "Good question. I was about to ask the same."
    h "Хороший вопрос. Я как раз собиралась спросить то же самое."

# game/script.rpy:3939
translate russian exit_2b8a1c22:
    # mc "Not by blood…"
    mc "Не по крови..."

# game/script.rpy:3940
translate russian exit_9ea2035f:
    # mc "But it never mattered."
    mc "Но это никогда не имело значения."

# game/script.rpy:3942
translate russian exit_6d9d6cf5:
    # mc "He’s as much a son to me as anyone could ever be."
    mc "Он мне сын настолько, насколько вообще можно быть сыном."

# game/script.rpy:3944
translate russian exit_dbc80a3e:
    # mc "Lora and I… couldn’t have kids."
    mc "Мы с Лорой... не могли иметь детей."

# game/script.rpy:3945
translate russian exit_e42277f5:
    # mc "So we adopted."
    mc "Так что усыновили."

# game/script.rpy:3946
translate russian exit_ed31c777:
    # mc "Best decision we made."
    mc "Лучшее решение в нашей жизни."

# game/script.rpy:3948
translate russian exit_e5ed1470:
    # N "Hey, come on, I wasn’t that bad."
    N "Эй, ну брось, я был не настолько ужасен."

# game/script.rpy:3949
translate russian exit_2bda2e3c:
    # N "Alright… maybe a little."
    N "Ладно... может, немного."

# game/script.rpy:3950
translate russian exit_3fae39b4:
    # mc "I didn’t say that."
    mc "Я этого не говорил."

# game/script.rpy:3951
translate russian exit_2bdcc97d:
    # N "I know."
    N "Знаю."

# game/script.rpy:3952
translate russian exit_c30ae1f4:
    # N "I just... back then, I couldn’t believe someone actually wanted me."
    N "Просто... тогда я не мог поверить, что кто-то правда меня захотел."

# game/script.rpy:3954
translate russian exit_32b788f8:
    # h "Oh... so what, that makes you my little brother now?"
    h "Ох... так что, теперь ты вроде как мой младший брат?"

# game/script.rpy:3955
translate russian exit_0ba467e3:
    # N "Wait, what?"
    N "Погоди, что?"

# game/script.rpy:3956
translate russian exit_e9adf264:
    # h "Your father… and Lora…"
    h "Твой отец... и Лора..."

# game/script.rpy:3957
translate russian exit_a8ad3d4b:
    # h "They kinda became family for us."
    h "Они для нас вроде как стали семьёй."

# game/script.rpy:3958
translate russian exit_c396d2d3:
    # h "Long story."
    h "Долгая история."

# game/script.rpy:3960
translate russian exit_b50c119f:
    # h "We go way back. Before the army, before all that mess…"
    h "Мы знакомы очень давно. Ещё до армии, до всего этого бардака..."

# game/script.rpy:3970
translate russian exit_8773b0d9:
    # h "(Funny thing is… I remember that day way too well.)"
    h "(Забавно... я слишком хорошо помню тот день.)"

# game/script.rpy:3972
translate russian exit_931f4b9f:
    # h "(Rain was pouring like the city was trying to drown itself.)"
    h "(Дождь лил так, будто город пытался сам себя утопить.)"

# game/script.rpy:3974
translate russian exit_e8712ef4:
    # h "(I was freezing under some rusty shelter. Broke. Soaked. Hungry as hell.)"
    h "(Я мёрзла под каким-то ржавым навесом. Без денег. Вся мокрая. Голодная до чёртиков.)"

# game/script.rpy:3976
translate russian exit_dab51e44:
    # h "(All I wanted was a job. Anything.)"
    h "(Всё, чего я хотела, - работу. Любую.)"

# game/script.rpy:3977
translate russian exit_ff448b46:
    # h "(Help mom… maybe get Anya out of that life.)"
    h "(Помочь маме... может, вытащить Аню из той жизни.)"

# game/script.rpy:3988
translate russian exit_f265e4e3:
    # h "(Yeah… turns out life doesn’t give a damn what you want.)"
    h "(Да... оказалось, жизни плевать, чего ты хочешь.)"

# game/script.rpy:3990
translate russian exit_c84b223e:
    # h "(I learned that early.)"
    h "(Я рано это усвоила.)"

# game/script.rpy:3994
translate russian exit_588c7186:
    # h "(Another “no”. Another door slammed in my face.)"
    h "(Ещё одно «нет». Ещё одна дверь, захлопнутая перед носом.)"

# game/script.rpy:3995
translate russian exit_dd9fb839:
    # h "(And that was it. I just… dropped.)"
    h "(И всё. Я просто... сломалась.)"

# game/script.rpy:3997
translate russian exit_98e66e5c:
    # h "(Angry. Lost. Ashamed.)"
    h "(Злая. Потерянная. Пристыженная.)"

# game/script.rpy:3998
translate russian exit_522c9563:
    # h "(At the world… and mostly at myself.)"
    h "(На весь мир... и больше всего на саму себя.)"

# game/script.rpy:4000
translate russian exit_b1f7fcd8:
    # h "Well? This it, Olivia?"
    h "Ну что? Вот и всё, Оливия?"

# game/script.rpy:4001
translate russian exit_ff94df49:
    # h "This what a loser looks like?"
    h "Вот так выглядит неудачница?"

# game/script.rpy:4005
translate russian exit_19e993a6:
    # h "(Pathetic…)"
    h "(Жалко...)"

# game/script.rpy:4007
translate russian exit_c60dd27a:
    # h "Can’t even get a damn waitress job without a diploma?"
    h "Без диплома даже чёртовой официанткой не берут?"

# game/script.rpy:4008
translate russian exit_c4ad5d5c:
    # h "Seriously?!"
    h "Серьёзно?!"

# game/script.rpy:4010
translate russian exit_8a56a096:
    # h "What now?"
    h "И что теперь?"

# game/script.rpy:4011
translate russian exit_7670aa87:
    # h "How the hell am I supposed to face mom… Anya…"
    h "Как мне, чёрт возьми, смотреть в глаза маме... Ане..."

# game/script.rpy:4013
translate russian exit_35b155e4:
    # h "I really thought this time was different…"
    h "Я правда думала, что в этот раз всё будет иначе..."

# game/script.rpy:4016
translate russian exit_78ba0b09:
    # h "(Yeah… I was done. Completely.)"
    h "(Да... тогда я выдохлась. Совсем.)"

# game/script.rpy:4017
translate russian exit_850d0d41:
    # h "(Like something inside just snapped.)"
    h "(Будто внутри что-то просто оборвалось.)"

# game/script.rpy:4019
translate russian exit_5f5087bf:
    # h "(And then… this guy just sits next to me.)"
    h "(А потом... этот парень просто сел рядом.)"

# game/script.rpy:4020
translate russian exit_0c84e9bd:
    # h "(Your dad. Didn’t say a word at first.)"
    h "(Твой отец. Сначала не сказал ни слова.)"

# game/script.rpy:4027
translate russian exit_9fe594e0:
    # h "(Yeah, I know. Rude.)"
    h "(Да, знаю. Грубо.)"

# game/script.rpy:4028
translate russian exit_ba1b9a13:
    # h "(But trust me, you’d be worse in my place.)"
    h "(Но поверь, на моём месте ты был бы ещё хуже.)"

# game/script.rpy:4032
translate russian exit_6b315e5e:
    # mc "Sometimes… it’s easier to talk to a stranger."
    mc "Иногда... с незнакомцем говорить проще."

# game/script.rpy:4048
translate russian exit_dc9ed579:
    # h "Honestly? He looked like trouble."
    h "Честно? Он выглядел как проблема."

# game/script.rpy:4049
translate russian exit_a2e5e5d8:
    # h "But back then, I didn’t care."
    h "Но тогда мне было всё равно."

# game/script.rpy:4050
translate russian exit_cb0e3c40:
    # h "Trouble beats starving."
    h "Проблемы лучше, чем голод."

# game/script.rpy:4051
translate russian exit_e3baa940:
    # h "Funny thing is… that moment?"
    h "Забавно, но... тот момент?"

# game/script.rpy:4052
translate russian exit_8a639abe:
    # h "Yeah. That one changed everything."
    h "Да. Именно он всё изменил."

# game/script.rpy:4055
translate russian exit_ee08a68c:
    # mc "That’s how it started."
    mc "Вот так всё и началось."

# game/script.rpy:4056
translate russian exit_61fd570d:
    # mc "Kinda messy, but... good stories usually are, right?"
    mc "Немного сумбурно, но... хорошие истории обычно такие, верно?"

# game/script.rpy:4066
translate russian exit_2be999b2:
    # mc "(humming)"
    mc "(напевает)"

# game/script.rpy:4068
translate russian exit_e0f82c64:
    # mc "(low humming)"
    mc "(тихо напевает)"

# game/script.rpy:4078
translate russian exit_025422a5:
    # mc "See that car behind us?"
    mc "Видишь машину позади?"

# game/script.rpy:4081
translate russian exit_7fcaca79:
    # mc "Been on us for a while."
    mc "Она давно на хвосте."

# game/script.rpy:4084
translate russian exit_58ea6997:
    # h "How long have they been on us?"
    h "Как давно они за нами?"

# game/script.rpy:4086
translate russian exit_153c5161:
    # mc "Long enough."
    mc "Достаточно."

# game/script.rpy:4087
translate russian exit_55ce085a:
    # mc "Glove box."
    mc "Бардачок."

# game/script.rpy:4088
translate russian exit_36dbac10:
    # mc "Take what’s inside."
    mc "Достань, что внутри."

# game/script.rpy:4094
translate russian exit_9f9f7e4d:
    # h "...Oh, you’ve gotta be kidding me."
    h "...Ох, да ты издеваешься."

# game/script.rpy:4097
translate russian exit_91772f02:
    # h "Why the hell is there a suppressor on this thing?"
    h "Почему, чёрт возьми, на этой штуке глушитель?"

# game/script.rpy:4104
translate russian exit_173d5a9e:
    # a "They’re speeding up."
    a "Они ускоряются."

# game/script.rpy:4105
translate russian exit_f9f2efe4:
    # a "Can you slow them down?"
    a "Можешь их притормозить?"

# game/script.rpy:4107
translate russian exit_2ecb8c95:
    # aa "Orders were clear, we just watch."
    aa "Приказ был чёткий: мы только наблюдаем."

# game/script.rpy:4108
translate russian exit_b2095005:
    # a "If we don’t do something, we’ll lose them!"
    a "Если ничего не сделаем, потеряем их!"

# game/script.rpy:4109
translate russian exit_0c8edd20:
    # a "And if we lose it, Azarkhan will kill us himself!"
    a "А если мы его упустим, Азархан лично нас прикончит!"

# game/script.rpy:4117
translate russian exit_eee588f4:
    # h "—Got one!"
    h "-Попала в одного!"

# game/script.rpy:4129
translate russian exit_2f47fd71:
    # h "Hey—!"
    h "Эй-!"

# game/script.rpy:4130
translate russian exit_f451724b:
    # h "You don’t happen to keep anything bigger back there, do you?!"
    h "Ты там случайно ничего покрупнее не прячешь?!"

# game/script.rpy:4136
translate russian exit_5bf96bff:
    # h "They’re closing in—!"
    h "Они приближаются-!"

# game/script.rpy:4147
translate russian exit_8dd33ab4:
    # h "...Oh now we’re talking."
    h "...О, вот теперь разговор."

# game/script.rpy:4148
translate russian exit_778f766a:
    # h "Custom M4A1… TacticalGrip rail… suppressor…"
    h "Кастомная M4A1... планка TacticalGrip... глушитель..."

# game/script.rpy:4149
translate russian exit_f3a5bfd1:
    # h "Damn, you’ve been hiding the good stuff."
    h "Чёрт, ты прятал хорошие игрушки."

# game/script.rpy:4155
translate russian exit_13159dc0:
    # h "Come on— just drop already!"
    h "Да ну же - падай уже!"

# game/script.rpy:4184
translate russian jungle_0ee062c1:
    # mc "Still on us?"
    mc "Всё ещё на хвосте?"

# game/script.rpy:4186
translate russian jungle_9f5c960c:
    # h "We’ve gone pretty far."
    h "Мы уже далеко ушли."

# game/script.rpy:4187
translate russian jungle_29816939:
    # h "If someone was still on us, we’d know by now."
    h "Если бы кто-то всё ещё шёл за нами, мы бы уже заметили."

# game/script.rpy:4189
translate russian jungle_a9851615:
    # h "But here’s what bugs me…"
    h "Но вот что меня бесит..."

# game/script.rpy:4190
translate russian jungle_05882eef:
    # h "Why us?"
    h "Почему мы?"

# game/script.rpy:4191
translate russian jungle_61ee3dc3:
    # h "Who the hell wants us dead this badly?"
    h "Кому, чёрт возьми, так сильно хочется нашей смерти?"

# game/script.rpy:4194
translate russian jungle_027b09ef:
    # h "...Yeah. Thought so."
    h "...Да. Я так и думала."

# game/script.rpy:4196
translate russian jungle_431d2e38:
    # N "You know who it was, Dad?"
    N "Ты знаешь, кто это был, пап?"

# game/script.rpy:4198
translate russian jungle_ab08fc7c:
    # mc "Azarkhan’s people."
    mc "Люди Азархана."

# game/script.rpy:4199
translate russian jungle_67176192:
    # mc "Too familiar."
    mc "Слишком знакомо."

# game/script.rpy:4201
translate russian jungle_df83823e:
    # mc "If it’s them…"
    mc "Если это они..."

# game/script.rpy:4202
translate russian jungle_bc26c965:
    # mc "We’re on the right track."
    mc "Мы на верном пути."

# game/script.rpy:4204
translate russian jungle_b1683f59:
    # h "Seriously though…"
    h "А если серьёзно..."

# game/script.rpy:4205
translate russian jungle_4ce0af49:
    # h "What kind of world is this now?"
    h "Что это теперь за мир такой?"

# game/script.rpy:4206
translate russian jungle_00e0c5b2:
    # h "Dead men just… getting back up like nothing happened?"
    h "Мёртвые просто... встают как ни в чём не бывало?"

# game/script.rpy:4208
translate russian jungle_da856d69:
    # h "First Azarkhan."
    h "Сначала Азархан."

# game/script.rpy:4209
translate russian jungle_d18cc182:
    # h "Now his crew, all supposedly dead, and yet here they are."
    h "Теперь его люди, которые все вроде как мертвы, а они вот тут."

# game/script.rpy:4210
translate russian jungle_7af84186:
    # h "What’s next, huh?"
    h "Что дальше, а?"

# game/script.rpy:4211
translate russian jungle_9c684cd7:
    # h "Ghosts with guns?"
    h "Призраки с пушками?"

# game/script.rpy:4213
translate russian jungle_b555e454:
    # mc "You said you needed a break."
    mc "Ты сказала, тебе нужен отдых."

# game/script.rpy:4214
translate russian jungle_7b530492:
    # mc "This is it."
    mc "Вот он."

# game/script.rpy:4216
translate russian jungle_f780d94f:
    # h "Oh yeah. Amazing."
    h "О да. Потрясающе."

# game/script.rpy:4217
translate russian jungle_037a6cd5:
    # h "Exactly the kind of vacation I was dreaming about."
    h "Именно о таком отпуске я мечтала."

# game/script.rpy:4223
translate russian jungle_35550527:
    # mc "Norman. Map."
    mc "Норман. Карту."

# game/script.rpy:4225
translate russian jungle_b6286e70:
    # N "Hold on, Dad, I need to lock in our position."
    N "Подожди, пап, мне нужно зафиксировать нашу позицию."

# game/script.rpy:4226
translate russian jungle_058ec645:
    # N "…and let them know we’re almost there."
    N "...и сообщить им, что мы почти на месте."

# game/script.rpy:4227
translate russian jungle_1ef706f6:
    # mc "Who?"
    mc "Кому?"

# game/script.rpy:4228
translate russian jungle_6bc189c3:
    # N "My supervisor. She’s… good people."
    N "Моей начальнице. Она... хороший человек."

# game/script.rpy:4231
translate russian jungle_016dd687:
    # N "Take the first left up ahead."
    N "На первом повороте впереди налево."

# game/script.rpy:4233
translate russian jungle_c3700a77:
    # N "If the map's correct, that’s our fastest route."
    N "Если карта верна, это самый быстрый путь."

# game/script.rpy:4235
translate russian jungle_e74b3405:
    # N "Give it about an hour, we should be there."
    N "Примерно через час должны быть на месте."

# game/script.rpy:4246
translate russian jungle_548dedb9:
    # mc "That’s as far as we go."
    mc "Дальше на машине не проедем."

# game/script.rpy:4247
translate russian jungle_1861ed43:
    # mc "From here on, we walk."
    mc "Отсюда идём пешком."

# game/script.rpy:4248
translate russian jungle_4981463c:
    # mc "Norman, how far to the lab?"
    mc "Норман, сколько до лаборатории?"

# game/script.rpy:4251
translate russian jungle_7cf1923a:
    # mc "Norman?"
    mc "Норман?"

# game/script.rpy:4253
translate russian jungle_11f86aaa:
    # N "We’ve got a problem, Dad. GPS is dead."
    N "У нас проблема, пап. GPS умер."

# game/script.rpy:4254
translate russian jungle_2fc725b9:
    # N "Something’s jamming the signal."
    N "Что-то глушит сигнал."

# game/script.rpy:4256
translate russian jungle_e191a532:
    # mc "How bad?"
    mc "Насколько плохо?"

# game/script.rpy:4258
translate russian jungle_79a88624:
    # N "Not ideal… but not critical."
    N "Не идеально... но не критично."

# game/script.rpy:4259
translate russian jungle_f5c72e1f:
    # N "We need open ground, once we’ve got that, I can navigate off the map."
    N "Нам нужна открытая местность. Как только выйдем туда, я смогу ориентироваться по карте."

# game/script.rpy:4261
translate russian jungle_d4540d79:
    # h "Wait, hold on—"
    h "Так, подожди-"

# game/script.rpy:4262
translate russian jungle_e77ce4fa:
    # h "Are you telling me we’re lost?"
    h "Ты хочешь сказать, что мы заблудились?"

# game/script.rpy:4263
translate russian jungle_1eebc258:
    # mc "Plans changed."
    mc "План изменился."

# game/script.rpy:4264
translate russian jungle_cb717e89:
    # mc "Had to make sure we weren’t being followed."
    mc "Нужно было убедиться, что за нами не идут."

# game/script.rpy:4265
translate russian jungle_62d40295:
    # h "Oh, great. Fantastic."
    h "О, отлично. Просто прекрасно."

# game/script.rpy:4266
translate russian jungle_4a5c8a3b:
    # h "So you {b}do{/b} know where we’re going… right?"
    h "Значит, ты {b}точно{/b} знаешь, куда мы идём... да?"

# game/script.rpy:4270
translate russian jungle_f9981629:
    # N "We’re not lost. Dad logged the coordinates."
    N "Мы не заблудились. Папа записал координаты."

# game/script.rpy:4271
translate russian jungle_9b1924a9:
    # N "This just makes things… a bit messier."
    N "Просто теперь всё... немного сложнее."

# game/script.rpy:4273
translate russian jungle_e6b416ba:
    # h "No, no... hang on."
    h "Нет-нет... погоди."

# game/script.rpy:4274
translate russian jungle_52ae9db8:
    # h "I wasn’t asking you."
    h "Я не тебя спрашивала."

# game/script.rpy:4275
translate russian jungle_c3fd9c22:
    # h "[mc]."
    h "[mc!t]."

# game/script.rpy:4276
translate russian jungle_f4fbb626:
    # h "Two things."
    h "Две вещи."

# game/script.rpy:4277
translate russian jungle_66014d67:
    # h "Target."
    h "Цель."

# game/script.rpy:4278
translate russian jungle_3a2cbd7d:
    # h "And motive."
    h "И мотив."

# game/script.rpy:4280
translate russian jungle_2c037559:
    # mc "I gave you a reason back at the bar."
    mc "Я дал тебе причину ещё в баре."

# game/script.rpy:4282
translate russian jungle_78dfa234:
    # h "Let me paint you a picture."
    h "Давай нарисую тебе картину."

# game/script.rpy:4283
translate russian jungle_09a52859:
    # h "You’re in your bar."
    h "Ты в своём баре."

# game/script.rpy:4284
translate russian jungle_d3c5319f:
    # h "Someone walks in."
    h "Кто-то заходит."

# game/script.rpy:4285
translate russian jungle_ac722036:
    # h "Haven’t seen them in eight years."
    h "Ты не видел его восемь лет."

# game/script.rpy:4286
translate russian jungle_e752061c:
    # h "And suddenly they’re asking for help."
    h "И вдруг он просит о помощи."

# game/script.rpy:4287
translate russian jungle_d5d6b8b9:
    # h "I’m not asking for much."
    h "Я многого не прошу."

# game/script.rpy:4288
translate russian jungle_2ace915a:
    # h "Just don’t lie to me."
    h "Просто не ври мне."

# game/script.rpy:4290
translate russian jungle_19baf393:
    # mc "You really want to hear it?"
    mc "Ты правда хочешь это услышать?"

# game/script.rpy:4292
translate russian jungle_0fb922e6:
    # h "I’m already here."
    h "Я уже здесь."

# game/script.rpy:4293
translate russian jungle_b92a392d:
    # h "Bit late to hesitate now."
    h "Поздновато теперь сомневаться."

# game/script.rpy:4299
translate russian jungle_c9fe3339:
    # mc "Alright… simple version."
    mc "Ладно... короткая версия."

# game/script.rpy:4301
translate russian jungle_ab995604:
    # mc "Teleportation."
    mc "Телепортация."

# game/script.rpy:4303
translate russian jungle_05595850:
    # h "...You’ve gotta be kidding me."
    h "...Ты издеваешься."

# game/script.rpy:4304
translate russian jungle_d7608ad8:
    # h "Or what, you finally lost your mind?"
    h "Или ты всё-таки окончательно спятил?"

# game/script.rpy:4305
translate russian jungle_2b35b6fe_1:
    # mc "..."
    mc "..."

# game/script.rpy:4310
translate russian jungle_26f9ce20:
    # mc "Even with the facts…"
    mc "Даже с фактами..."

# game/script.rpy:4311
translate russian jungle_05bdf747:
    # mc "I’m still not sure I believe it myself."
    mc "я всё ещё не уверен, что сам в это верю."

# game/script.rpy:4313
translate russian jungle_d7db851c:
    # h "You know what? Fine."
    h "Знаешь что? Ладно."

# game/script.rpy:4314
translate russian jungle_e7f70801:
    # h "Don’t wanna talk? Don’t."
    h "Не хочешь говорить? Не говори."

# game/script.rpy:4315
translate russian jungle_3956c4b6:
    # h "(muttering) Figures… only known each other, what, twenty-five years…"
    h "(бормочет) Логично... мы же знакомы всего-то, сколько, двадцать пять лет..."

# game/script.rpy:4319
translate russian jungle_b8f81952:
    # mc "Olivia."
    mc "Оливия."

# game/script.rpy:4320
translate russian jungle_1abb6545:
    # mc "If I’m wrong about this…"
    mc "Если я ошибаюсь..."

# game/script.rpy:4321
translate russian jungle_5fd2f2e9:
    # mc "You get a wish."
    mc "с меня желание."

# game/script.rpy:4323
translate russian jungle_9f9aa8b1:
    # h "Another one?"
    h "Ещё одно?"

# game/script.rpy:4324
translate russian jungle_2fbe4877:
    # h "Wow. You’re really feeling generous today."
    h "Вау. Ты сегодня прямо щедрый."

# game/script.rpy:4326
translate russian jungle_7e467c9b:
    # h "Relax. I walked into this myself."
    h "Расслабься. Я сама в это влезла."

# game/script.rpy:4327
translate russian jungle_51bb8785:
    # h "And…"
    h "И..."

# game/script.rpy:4328
translate russian jungle_f56ff857:
    # h "Yeah, this place is kinda beautiful."
    h "Да, место тут и правда красивое."

# game/script.rpy:4329
translate russian jungle_7a704b80:
    # h "You look at those trees and almost forget—"
    h "Смотришь на эти деревья и почти забываешь-"

# game/script.rpy:4330
translate russian jungle_bdf6502a:
    # h "That forty minutes ago, some psychos were trying to kill us."
    h "Что сорок минут назад какие-то психи пытались нас убить."

# game/script.rpy:4332
translate russian jungle_49014fd7:
    # mc "Didn’t take you for the nature type."
    mc "Не думал, что ты любитель природы."

# game/script.rpy:4334
translate russian jungle_730b8b8b:
    # h "Excuse me?"
    h "Прости?"

# game/script.rpy:4335
translate russian jungle_7e533695:
    # h "You got a problem with that?"
    h "У тебя с этим проблема?"

# game/script.rpy:4337
translate russian jungle_04cd4a35:
    # mc "You’re different when you look at this stuff."
    mc "Ты становишься другой, когда смотришь на такое."

# game/script.rpy:4338
translate russian jungle_937d07f5:
    # mc "In a good way."
    mc "В хорошем смысле."

# game/script.rpy:4341
translate russian jungle_d30fadbc:
    # h "Wow."
    h "Вау."

# game/script.rpy:4342
translate russian jungle_2d59c3a3:
    # h "And what did I do to earn that, huh?"
    h "И чем я заслужила такой комплимент, а?"

# game/script.rpy:4343
translate russian jungle_2d908e97:
    # h "...Thanks."
    h "...Спасибо."

# game/script.rpy:4345
translate russian jungle_e615c6a6:
    # mc "Norman. Status."
    mc "Норман. Статус."

# game/script.rpy:4348
translate russian jungle_4f997413:
    # N "No luck reaching my handler."
    N "С куратором связаться не вышло."

# game/script.rpy:4350
translate russian jungle_1408e3e4:
    # N "I’ve tried, no response."
    N "Я пытался. Ответа нет."

# game/script.rpy:4352
translate russian jungle_fda9d8ee:
    # mc "Before she disappeared… your mother made a few calls from work."
    mc "Перед исчезновением... твоя мать сделала несколько звонков с работы."

# game/script.rpy:4353
translate russian jungle_098ae161:
    # mc "Didn’t know the details."
    mc "Деталей я не знал."

# game/script.rpy:4354
translate russian jungle_3594c294:
    # mc "But the signal was the same."
    mc "Но сигнал был такой же."

# game/script.rpy:4355
translate russian jungle_857e3e82:
    # mc "Dead."
    mc "Мёртвый."

# game/script.rpy:4357
translate russian jungle_4112597f:
    # N "Yeah… but we thought we fixed that."
    N "Да... но мы думали, что исправили это."

# game/script.rpy:4359
translate russian jungle_ed71b73d:
    # mc "Guess not."
    mc "Похоже, нет."

# game/script.rpy:4360
translate russian jungle_7cf1923a_1:
    # mc "Norman?"
    mc "Норман?"

# game/script.rpy:4365
translate russian jungle_3d826554:
    # N "…What’s this?"
    N "...Что это?"

# game/script.rpy:4367
translate russian jungle_9ff43c05:
    # mc "Your protection."
    mc "Твоя защита."

# game/script.rpy:4368
translate russian jungle_c36e8603:
    # mc "And a promise I made to Alexa."
    mc "И обещание, которое я дал Алексе."

# game/script.rpy:4369
translate russian jungle_c17ca67b:
    # mc "Now go get changed."
    mc "А теперь иди переоденься."

# game/script.rpy:4371
translate russian jungle_4d275639:
    # N "But the signal—"
    N "Но сигнал-"

# game/script.rpy:4372
translate russian jungle_0a8aa971:
    # mc "Take a breather."
    mc "Передохни."

# game/script.rpy:4373
translate russian jungle_88dcfc45:
    # mc "You’re wound too tight."
    mc "Ты слишком натянут."

# game/script.rpy:4374
translate russian jungle_b5c321df:
    # N "…Alright."
    N "...Ладно."

# game/script.rpy:4379
translate russian jungle_45189c64:
    # mc "What do you think of him?"
    mc "Что думаешь о нём?"

# game/script.rpy:4382
translate russian jungle_67af5045:
    # h "If things go loud?"
    h "Если начнётся стрельба?"

# game/script.rpy:4383
translate russian jungle_eaab07e8:
    # h "He would be the first one to die"
    h "Он умрёт первым."

# game/script.rpy:4385
translate russian jungle_236b0ca5:
    # h "Why’d you even bring him?"
    h "Зачем ты вообще взял его?"

# game/script.rpy:4387
translate russian jungle_4415f200:
    # mc "Tried to talk him out of it."
    mc "Пытался отговорить."

# game/script.rpy:4388
translate russian jungle_23683aec:
    # mc "Didn’t work."
    mc "Не вышло."

# game/script.rpy:4392
translate russian jungle_34a01b78:
    # h "Figures."
    h "Ну конечно."

# game/script.rpy:4393
translate russian jungle_e0002ad0:
    # h "Stubborn, just like you, huh?"
    h "Упрямый, прямо как ты, да?"

# game/script.rpy:4394
translate russian jungle_4338d359:
    # h "Still… if he stays in the back he might actually make it."
    h "Но... если будет держаться позади, может и выживет."

# game/script.rpy:4397
translate russian jungle_ad17a2a5:
    # N "Bit oversized… but yeah, solid."
    N "Немного великовато... но да, крепко."

# game/script.rpy:4398
translate russian jungle_44dbbf19:
    # N "Feels reliable."
    N "Выглядит надёжно."

# game/script.rpy:4400
translate russian jungle_3486baab:
    # h "Hey, kid."
    h "Эй, парень."

# game/script.rpy:4401
translate russian jungle_787ca900:
    # h "That vest? Doesn’t make you bulletproof."
    h "Этот жилет? Он не делает тебя неуязвимым."

# game/script.rpy:4402
translate russian jungle_3a975633:
    # h "Shots fired? You hit the ground and stay there."
    h "Начнётся стрельба - падаешь на землю и лежишь."

# game/script.rpy:4403
translate russian jungle_a4231084:
    # h "Don’t be dead weight."
    h "Не будь балластом."

# game/script.rpy:4405
translate russian jungle_1db4077f:
    # N "…Got it."
    N "...Понял."

# game/script.rpy:4408
translate russian jungle_4350c951:
    # mc "We’ll need him."
    mc "Он нам понадобится."

# game/script.rpy:4410
translate russian jungle_2ed9073b:
    # h "Oh yeah?"
    h "Да ну?"

# game/script.rpy:4411
translate russian jungle_9386b644:
    # h "And when exactly is that supposed to be?"
    h "И когда именно это должно случиться?"

# game/script.rpy:4413
translate russian jungle_858483b1:
    # mc "He’s the only one who can get us in."
    mc "Он единственный, кто может провести нас внутрь."

# game/script.rpy:4415
translate russian jungle_6c560a32:
    # N "I’m not much of a fighter, I’ll admit that."
    N "Я не боец, признаю."

# game/script.rpy:4417
translate russian jungle_be66ef0d:
    # N "But you’re gonna need me once we reach that lab."
    N "Но когда мы доберёмся до лаборатории, я вам понадоблюсь."

# game/script.rpy:4419
translate russian jungle_d181a398:
    # h "Hold up—"
    h "Стоп-"

# game/script.rpy:4420
translate russian jungle_ee5b3169:
    # h "What lab?"
    h "Какая лаборатория?"

# game/script.rpy:4421
translate russian jungle_ae4ebe93:
    # mc "According to Norman… there’s a lab at the center."
    mc "По словам Нормана... в центре есть лаборатория."

# game/script.rpy:4423
translate russian jungle_2fded262_2:
    # h "..."
    h "..."

# game/script.rpy:4426
translate russian jungle_b0d6f560:
    # h "And what’s the plan with it?"
    h "И какой с ней план?"

# game/script.rpy:4428
translate russian jungle_ed933789:
    # N "…She’s got a point."
    N "...Она права."

# game/script.rpy:4430
translate russian jungle_2b35b6fe_2:
    # mc "..."
    mc "..."

# game/script.rpy:4432
translate russian jungle_81d52519:
    # mc "We don’t have a choice."
    mc "У нас нет выбора."

# game/script.rpy:4433
translate russian jungle_5f2d8436:
    # mc "Right now… it’s just dead weight."
    mc "Сейчас... это просто мёртвый груз."

# game/script.rpy:4435
translate russian jungle_1b98a873:
    # h "Heh…"
    h "Хех..."

# game/script.rpy:4436
translate russian jungle_61e957a5:
    # h "Same old you."
    h "Всё тот же."

# game/script.rpy:4437
translate russian jungle_a16e8e41:
    # h "Glad nothing’s changed."
    h "Рада, что ничего не изменилось."

# game/script.rpy:4440
translate russian jungle_eab51ec6:
    # h "Hey, Norman… mind if I ask something?"
    h "Эй, Норман... можно спросить кое-что?"

# game/script.rpy:4441
translate russian jungle_f44eba9f:
    # N "Go ahead."
    N "Давай."

# game/script.rpy:4444
translate russian jungle_e8f11a91:
    # N "…That’s a long story."
    N "...Это длинная история."

# game/script.rpy:4445
translate russian jungle_94d37d67:
    # N "Feels like a different life."
    N "Будто другая жизнь."

# game/script.rpy:4447
translate russian jungle_9627e2c1:
    # h "We’ve got a long walk anyway."
    h "Нам всё равно долго идти."

# game/script.rpy:4449
translate russian jungle_9f7f326d:
    # h "Hey, are you not curious about your son’s love life?"
    h "Эй, тебе разве не интересно узнать о любовной жизни сына?"

# game/script.rpy:4451
translate russian jungle_74f6c040:
    # mc "I’m coming."
    mc "Иду."

# game/script.rpy:4453
translate russian jungle_9be863b0:
    # h "Go on, Norman."
    h "Продолжай, Норман."

# game/script.rpy:4454
translate russian jungle_962af931:
    # h "We’ve got time."
    h "Время у нас есть."

# game/script.rpy:4455
translate russian jungle_9b1bfb7e:
    # N "Back in the day, back when dinosaurs still roamed the earth, I was a broke university student."
    N "Давным-давно, когда динозавры ещё ходили по земле, я был бедным студентом."

# game/script.rpy:4456
translate russian jungle_5ebb1cd0:
    # N "Spent more time with books than people."
    N "С книгами проводил больше времени, чем с людьми."

# game/script.rpy:4458
translate russian jungle_add80bc4:
    # N "Didn’t think anyone would even notice me."
    N "И не думал, что кто-то вообще меня заметит."

# game/script.rpy:4459
translate russian jungle_f7b7ac27:
    # N "Least of all her."
    N "Тем более она."

# game/script.rpy:4565
translate russian junglenext_9b5d1dbc:
    # h "Hey… [mc]."
    h "Эй... [mc]."

# game/script.rpy:4566
translate russian junglenext_69621b8c:
    # h "Why now?"
    h "Почему сейчас?"

# game/script.rpy:4567
translate russian junglenext_ababa309:
    # h "After all this time… why go back?"
    h "После стольких лет... зачем возвращаться?"

# game/script.rpy:4568
translate russian junglenext_982ff762:
    # mc "If I waited any longer… I wouldn’t have made it."
    mc "Если бы я ждал ещё дольше... я бы не выдержал."

# game/script.rpy:4570
translate russian junglenext_40244502:
    # h "If I were you… I wouldn’t let it get to my head like that."
    h "На твоём месте... я бы не позволила этому так забраться в голову."

# game/script.rpy:4571
translate russian junglenext_44fa84c0:
    # mc "Heh."
    mc "Хех."

# game/script.rpy:4572
translate russian junglenext_c613da8e:
    # h "No, I mean it, [mc]. Serious."
    h "Нет, я серьёзно, [mc!t]. Правда."

# game/script.rpy:4573
translate russian junglenext_cb89ebe5:
    # h "I get it."
    h "Я понимаю."

# game/script.rpy:4574
translate russian junglenext_617784d6:
    # h "Lora meant everything to you."
    h "Лора значила для тебя всё."

# game/script.rpy:4575
translate russian junglenext_81343336:
    # h "But it’s been too long."
    h "Но прошло слишком много времени."

# game/script.rpy:4579
translate russian junglenext_bf96f826:
    # h "I’m all for digging up the truth."
    h "Я только за то, чтобы докопаться до правды."

# game/script.rpy:4580
translate russian junglenext_0ccd46e0:
    # h "But if this goes sideways…"
    h "Но если всё пойдёт не так..."

# game/script.rpy:4581
translate russian junglenext_d5bbee43:
    # h "(quietly) I don’t wanna see you like you were before."
    h "(тихо) Я не хочу снова видеть тебя таким, каким ты был раньше."

# game/script.rpy:4583
translate russian junglenext_66fa3968:
    # mc "You won’t."
    mc "Не увидишь."

# game/script.rpy:4584
translate russian junglenext_bbed952c:
    # mc "That version of me is gone."
    mc "Того меня больше нет."

# game/script.rpy:4586
translate russian junglenext_7889da18:
    # mc "…Norman."
    mc "...Норман."

# game/script.rpy:4587
translate russian junglenext_5c4e71e8:
    # mc "How far?"
    mc "Сколько ещё?"

# game/script.rpy:4590
translate russian junglenext_10252e11:
    # N "...Dad?"
    N "...Пап?"

# game/script.rpy:4591
translate russian junglenext_7cf1923a:
    # mc "Norman?"
    mc "Норман?"

# game/script.rpy:4592
translate russian junglenext_b8b14b2c:
    # N "According to the coordinates… we’re there, but—"
    N "По координатам... мы на месте, но-"

# game/script.rpy:4594
translate russian junglenext_9cc531bc:
    # N "The lab should be just past those cliffs."
    N "Лаборатория должна быть сразу за теми скалами."

# game/script.rpy:4595
translate russian junglenext_e1442345:
    # N "I don’t get it…"
    N "Не понимаю..."

# game/script.rpy:4597
translate russian junglenext_01539dd0:
    # N "The coordinates are precise…"
    N "Координаты точные..."

# game/script.rpy:4599
translate russian junglenext_858267f5:
    # N "But there’s nothing here."
    N "Но здесь ничего нет."

# game/script.rpy:4611
translate russian junglenext_29d95b82:
    # mc "Still hiding in bushes, huh?"
    mc "Всё ещё прячешься в кустах, да?"

# game/script.rpy:4612
translate russian junglenext_4717abe5:
    # mc "Some things don’t change."
    mc "Некоторые вещи не меняются."

# game/script.rpy:4614
translate russian junglenext_23c81f63:
    # S "Guilty as charged. Old habits."
    S "Виновна. Старые привычки."

# game/script.rpy:4615
translate russian junglenext_835eef81:
    # S "Still… it’s good to see you again."
    S "И всё же... рада снова тебя видеть."

# game/script.rpy:4616
translate russian junglenext_63d3dedb:
    # S "Now, mind lowering the guns? We’re not enemies."
    S "А теперь, может, опустите оружие? Мы не враги."

# game/script.rpy:4619
translate russian junglenext_507d95fa:
    # mc "Hope so."
    mc "Надеюсь."

# game/script.rpy:4620
translate russian junglenext_d9aab11f:
    # mc "Fifteen years."
    mc "Пятнадцать лет."

# game/script.rpy:4621
translate russian junglenext_6bd3f7e4:
    # mc "A lot can change."
    mc "Многое могло измениться."

# game/script.rpy:4624
translate russian junglenext_3ec243e2:
    # N "Let me introduce you, Shiya Gray."
    N "Позвольте представить: Шия Грей."

# game/script.rpy:4625
translate russian junglenext_44ec6081:
    # N "Senior Sergeant. And… my handler."
    N "Старший сержант. И... мой куратор."

# game/script.rpy:4627
translate russian junglenext_7a3c3d5b:
    # mc "...Handler?"
    mc "...Куратор?"

# game/script.rpy:4629
translate russian junglenext_6816a4da:
    # S "Yeah. That’s me."
    S "Да. Это я."

# game/script.rpy:4630
translate russian junglenext_5b4d15af:
    # S "Hello, Commander… or should I say {b}former{/b} Commander."
    S "Здравствуйте, командир... или лучше сказать {b}бывший{/b} командир."

# game/script.rpy:4633
translate russian junglenext_8b8c5e46:
    # h "...You really haven’t changed."
    h "...Ты правда не изменилась."

# game/script.rpy:4637
translate russian junglenext_1827b8c3:
    # S "Heard you took Alexandro in."
    S "Слышала, ты приютила Алехандро."

# game/script.rpy:4639
translate russian junglenext_ed3d5200:
    # h "Yeah. Someone had to."
    h "Да. Кто-то должен был."

# game/script.rpy:4643
translate russian junglenext_7f55bc84:
    # mc "And Richard?"
    mc "А Ричард?"

# game/script.rpy:4644
translate russian junglenext_2bbcebb8:
    # mc "Still messing with his inventions?"
    mc "Всё ещё возится со своими изобретениями?"

# game/script.rpy:4646
translate russian junglenext_ff37d682:
    # S "Father? Lost his mind in his old age, but the army still respects him. So they let his quirks slide."
    S "Отец? На старости лет совсем чудит, но армия всё ещё его уважает. Так что на его странности закрывают глаза."

# game/script.rpy:4648
translate russian junglenext_28411d41:
    # h "Sounds like him."
    h "Похоже на него."

# game/script.rpy:4649
translate russian junglenext_a8a4a433:
    # h "Good to know he’s still kicking."
    h "Приятно знать, что он ещё держится."

# game/script.rpy:4651
translate russian junglenext_66b8d6c1:
    # S "Honestly… when my father asked me to pass that letter on,"
    S "Честно... когда отец попросил меня передать это письмо,"

# game/script.rpy:4652
translate russian junglenext_b9572ef8:
    # S "I didn’t think it would actually work."
    S "я не думала, что это правда сработает."

# game/script.rpy:4653
translate russian junglenext_2968952a:
    # S "Nice to see I was wrong."
    S "Рада, что ошиблась."

# game/script.rpy:4658
translate russian junglenext_7832ee95:
    # N "We were attacked."
    N "На нас напали."

# game/script.rpy:4660
translate russian junglenext_9c3f50b8:
    # S "Attacked? By who?"
    S "Напали? Кто?"

# game/script.rpy:4663
translate russian junglenext_ab08fc7c:
    # mc "Azarkhan’s people."
    mc "Люди Азархана."

# game/script.rpy:4664
translate russian junglenext_f8e01ab0:
    # mc "No confirmation… but it fits."
    mc "Подтверждения нет... но всё сходится."

# game/script.rpy:4665
translate russian junglenext_e26382c6:
    # mc "Question is how does it tie back to this place?"
    mc "Вопрос в том, как это связано с этим местом."

# game/script.rpy:4669
translate russian junglenext_25177961:
    # S "(Whispering) So… it’s about the ship."
    S "(шёпотом) Значит... дело в корабле."

# game/script.rpy:4672
translate russian junglenext_1b04d4c9:
    # S "I could explain it."
    S "Я могу объяснить."

# game/script.rpy:4673
translate russian junglenext_135d652c:
    # S "But it won’t make sense until you see it."
    S "Но пока вы сами не увидите, смысла в этом не будет."

# game/script.rpy:4693
translate russian spaceship_b6eb03cc:
    # S "Friendly advice, Commander, whatever you’re about to see, don’t freak out."
    S "Дружеский совет, командир: что бы вы сейчас ни увидели, не паникуйте."

# game/script.rpy:4694
translate russian spaceship_b14fad8e:
    # S "It’ll help you keep your sanity a little longer."
    S "Так рассудок протянет чуть дольше."

# game/script.rpy:4696
translate russian spaceship_1b7a36d6:
    # S "Now… look over there."
    S "А теперь... посмотрите туда."

# game/script.rpy:4698
translate russian spaceship_7830fcfb:
    # S "I didn’t believe it either."
    S "Я тоже не поверила."

# game/script.rpy:4699
translate russian spaceship_e8a29d4b:
    # S "First time I saw it."
    S "Когда впервые увидела."

# game/script.rpy:4701
translate russian spaceship_eb7eec91:
    # mc "(...what the hell is that?)"
    mc "(...что это, чёрт возьми?)"

# game/script.rpy:4702
translate russian spaceship_76a5ba94:
    # S "That thing crashed here thousands of years ago."
    S "Эта штука рухнула здесь тысячи лет назад."

# game/script.rpy:4704
translate russian spaceship_43d51cbc:
    # S "It’s the source of every anomaly in this area."
    S "Она источник всех аномалий в этом районе."

# game/script.rpy:4706
translate russian spaceship_66a3bbaa:
    # h "...That’s one hell of a leap."
    h "...Вот это скачок."

# game/script.rpy:4707
translate russian spaceship_b7732fbb:
    # h "From {b}Lora went missing{/b} to {b}alien spaceship.{/b}"
    h "От {b}Лора пропала{/b} сразу к {b}инопланетному кораблю{/b}."

# game/script.rpy:4709
translate russian spaceship_f34b4020:
    # h "Or is it just me?"
    h "Или это только мне кажется?"

# game/script.rpy:4710
translate russian spaceship_6925cdda:
    # h "Am I the only one seeing how insane this sounds?"
    h "Я одна слышу, насколько это безумно звучит?"

# game/script.rpy:4712
translate russian spaceship_555e0ed5:
    # mc "Doesn’t show… but yeah. Same here."
    mc "По мне не видно... но да. У меня то же самое."

# game/script.rpy:4714
translate russian spaceship_ed421996:
    # mc "Part of me still thinks this is a joke."
    mc "Какая-то часть меня всё ещё думает, что это шутка."

# game/script.rpy:4716
translate russian spaceship_49f720d6:
    # h "How does that even make sense?"
    h "Как это вообще может иметь смысл?"

# game/script.rpy:4717
translate russian spaceship_0c85fd2d:
    # h "I thought we were alone out here."
    h "Я думала, мы здесь одни."

# game/script.rpy:4718
translate russian spaceship_00d60215:
    # h "And now what—"
    h "И что теперь-"

# game/script.rpy:4719
translate russian spaceship_4910d1c5:
    # h "we’ve got uninvited guests from space?"
    h "у нас незваные гости из космоса?"

# game/script.rpy:4720
translate russian spaceship_ee31fb04:
    # h "Great. Love that for us."
    h "Отлично. Просто прекрасно для нас."

# game/script.rpy:4722
translate russian spaceship_a2a19851:
    # mc "(So Norman and Richard weren’t lying…)"
    mc "(Значит, Норман и Ричард не врали...)"

# game/script.rpy:4724
translate russian spaceship_bf89bfc0:
    # mc "(Lora… what the hell did you get yourself into?)"
    mc "(Лора... во что же ты, чёрт возьми, ввязалась?)"

# game/script.rpy:4727
translate russian spaceship_3fbf6989:
    # mc "So how does that thing tie to Lora?"
    mc "И как эта штука связана с Лорой?"

# game/script.rpy:4730
translate russian spaceship_b3ef1df9:
    # ri "That’s exactly what we’re trying to figure out."
    ri "Именно это мы и пытаемся выяснить."

# game/script.rpy:4732
translate russian spaceship_eb35cda5:
    # ri "Three years ago, we found this place."
    ri "Три года назад мы нашли это место."

# game/script.rpy:4733
translate russian spaceship_37635e00:
    # ri "Or rather… it let us find it."
    ri "Точнее... само позволило себя найти."

# game/script.rpy:4734
translate russian spaceship_199e410d:
    # ri "At first, we thought it was a military project."
    ri "Сначала мы решили, что это военный проект."

# game/script.rpy:4735
translate russian spaceship_0859680b:
    # ri "We were wrong."
    ri "Мы ошиблись."

# game/script.rpy:4737
translate russian spaceship_2717a46a:
    # ri "Still… I’m glad you came."
    ri "И всё же... я рад, что ты пришёл."

# game/script.rpy:4739
translate russian spaceship_211a38cd:
    # mc "Let’s just say I didn’t have a reason to say no."
    mc "Скажем так, у меня не было причины отказаться."

# game/script.rpy:4740
translate russian spaceship_105b349e:
    # mc "But one thing still bugs me."
    mc "Но кое-что меня всё ещё гложет."

# game/script.rpy:4741
translate russian spaceship_5164590e:
    # mc "Why me?"
    mc "Почему я?"

# game/script.rpy:4743
translate russian spaceship_991d0569:
    # mc "You’ve got better people."
    mc "У тебя есть люди получше."

# game/script.rpy:4744
translate russian spaceship_4c17cf74:
    # mc "More experienced."
    mc "Опытнее."

# game/script.rpy:4745
translate russian spaceship_19ce78ca:
    # mc "So why me?"
    mc "Так почему я?"

# game/script.rpy:4749
translate russian spaceship_1b22fea2:
    # ri "We have people."
    ri "Люди у нас есть."

# game/script.rpy:4750
translate russian spaceship_ddc02359:
    # ri "But no one wants to go in there."
    ri "Но никто не хочет идти туда."

# game/script.rpy:4752
translate russian spaceship_993a4a49:
    # ri "I’m risking more than you are."
    ri "Я рискую большим, чем ты думаешь."

# game/script.rpy:4753
translate russian spaceship_6e9f1023:
    # ri "A tribunal would be the least of our problems if this gets out…"
    ri "Если это всплывёт, трибунал будет меньшей из наших проблем..."

# game/script.rpy:4754
translate russian spaceship_e3057d55:
    # ri "We’d all be finished."
    ri "Нам всем конец."

# game/script.rpy:4761
translate russian spaceship_404c3ccf:
    # mc "...That’s not human."
    mc "...Это не человек."

# game/script.rpy:4762
translate russian spaceship_8b909ca4:
    # h "Yeah… that checks out."
    h "Да... теперь сходится."

# game/script.rpy:4764
translate russian spaceship_5639de4b:
    # h "Nope."
    h "Нет."

# game/script.rpy:4765
translate russian spaceship_da6fe756:
    # h "No way I’m going in there."
    h "Я туда не пойду."

# game/script.rpy:4766
translate russian spaceship_f9384a89:
    # h "Not happening."
    h "Даже не обсуждается."

# game/script.rpy:4768
translate russian spaceship_ff6ae2df:
    # mc "No way around it?"
    mc "Обойти никак?"

# game/script.rpy:4770
translate russian spaceship_dce3ed76:
    # ri "Daughter, your thoughts?"
    ri "Дочь, что скажешь?"

# game/script.rpy:4772
translate russian spaceship_77d0adcc:
    # S "No. We’ve checked the entire perimeter."
    S "Нет. Мы проверили весь периметр."

# game/script.rpy:4773
translate russian spaceship_3d17a36e:
    # S "No other entrances."
    S "Других входов нет."

# game/script.rpy:4774
translate russian spaceship_f89aedcd:
    # S "We even tried making one, wasted ammo. Nothing worked."
    S "Мы даже пытались сделать вход сами. Только патроны потратили. Ничего не сработало."

# game/script.rpy:4776
translate russian spaceship_8ad0b165:
    # h "You’re seriously asking us to walk into that?"
    h "Ты серьёзно просишь нас зайти в это?"

# game/script.rpy:4777
translate russian spaceship_013d3db8:
    # h "That’s not a mission."
    h "Это не миссия."

# game/script.rpy:4778
translate russian spaceship_65a9b131:
    # h "That’s a death sentence."
    h "Это смертный приговор."

# game/script.rpy:4780
translate russian spaceship_994ce6f3:
    # mc "She’s right."
    mc "Она права."

# game/script.rpy:4781
translate russian spaceship_c1fe712a:
    # mc "Right now this sounds like suicide."
    mc "Сейчас это звучит как самоубийство."

# game/script.rpy:4785
translate russian spaceship_47b368f9:
    # h "And honestly?"
    h "И честно?"

# game/script.rpy:4786
translate russian spaceship_8332938a:
    # h "Can you blame them?"
    h "Ты можешь их винить?"

# game/script.rpy:4787
translate russian spaceship_df7e0d95:
    # h "Who the hell would sign up for that?"
    h "Кто, чёрт возьми, на такое подпишется?"

# game/script.rpy:4789
translate russian spaceship_927b0286:
    # mc "Doesn’t look like we have a choice."
    mc "Похоже, выбора у нас нет."

# game/script.rpy:4790
translate russian spaceship_9ba7d9ad:
    # mc "Getting past those sentries won’t be easy."
    mc "Пройти мимо этих часовых будет непросто."

# game/script.rpy:4801
translate russian spaceship_15024590:
    # N "It’s a long shot... but it’s something."
    N "Шанс маленький... но он есть."

# game/script.rpy:4807
translate russian spaceship_d73d52d8:
    # h "Okay."
    h "Ладно."

# game/script.rpy:4808
translate russian spaceship_7c35885a:
    # h "I hate it."
    h "Мне это не нравится."

# game/script.rpy:4809
translate russian spaceship_10c0b0cf:
    # h "But it’s better than walking through the front door."
    h "Но это лучше, чем идти через парадный вход."

# game/script.rpy:4812
translate russian spaceship_0de60052:
    # mc "We don’t have a better option."
    mc "Лучшего варианта у нас нет."

# game/script.rpy:4820
translate russian spaceship_c55d9b49:
    # N "Up close… it’s even bigger than I thought."
    N "Вблизи... он ещё больше, чем я думал."

# game/script.rpy:4821
translate russian spaceship_36546702:
    # N "So how are we getting into those turbines?"
    N "И как мы попадём в эти турбины?"

# game/script.rpy:4823
translate russian spaceship_d08d4527:
    # ri "We’ll get a ladder."
    ri "Достанем лестницу."

# game/script.rpy:4824
translate russian spaceship_907133dc:
    # ri "After that… we improvise."
    ri "А дальше... импровизируем."

# game/script.rpy:4826
translate russian spaceship_716eff36:
    # h "Gotta admit…"
    h "Надо признать..."

# game/script.rpy:4827
translate russian spaceship_ec72696f:
    # h "Kid’s got a brain."
    h "У парня есть голова."

# game/script.rpy:4829
translate russian spaceship_40ea09f1:
    # h "But you—"
    h "Но ты-"

# game/script.rpy:4830
translate russian spaceship_13e21e8d:
    # h "you did it again."
    h "ты опять за своё."

# game/script.rpy:4832
translate russian spaceship_91bacd01:
    # h "That look."
    h "Этот взгляд."

# game/script.rpy:4833
translate russian spaceship_d5b59ca0:
    # h "Means you’re already halfway lost in your own head."
    h "Значит, ты уже наполовину потерялся у себя в голове."

# game/script.rpy:4838
translate russian spaceship_16dfe01b:
    # h "Talking your head off to some random stranger…"
    h "Вывалить всё из головы какому-то случайному незнакомцу..."

# game/script.rpy:4839
translate russian spaceship_2d52ab83:
    # h "Helped back then."
    h "Тогда помогло."

# game/script.rpy:4844
translate russian spaceship_09cb1e1d:
    # mc "Something’s off."
    mc "Что-то не так."

# game/script.rpy:4845
translate russian spaceship_3681196a:
    # mc "Tell me, Olivia… you believe in fate?"
    mc "Скажи, Оливия... ты веришь в судьбу?"

# game/script.rpy:4847
translate russian spaceship_ded5af50:
    # h "After the way we met?"
    h "После того, как мы встретились?"

# game/script.rpy:4848
translate russian spaceship_72fce240:
    # h "Yeah… I’d say I do."
    h "Да... пожалуй, верю."

# game/script.rpy:4852
translate russian spaceship_96267e9d:
    # mc "What are the odds…"
    mc "Каковы шансы..."

# game/script.rpy:4853
translate russian spaceship_641b861d:
    # mc "that out of every planet, this thing crashes on Earth?"
    mc "что из всех планет эта штука падает именно на Землю?"

# game/script.rpy:4855
translate russian spaceship_56c93102:
    # mc "Out of all the missing people…"
    mc "Что из всех пропавших людей..."

# game/script.rpy:4856
translate russian spaceship_fcd1de3f:
    # mc "only Lora’s photo turns up."
    mc "всплывает только фотография Лоры."

# game/script.rpy:4858
translate russian spaceship_d068d739:
    # mc "Then Norman shows up."
    mc "Потом появляется Норман."

# game/script.rpy:4859
translate russian spaceship_30e23456:
    # mc "With a letter."
    mc "С письмом."

# game/script.rpy:4863
translate russian spaceship_27ac3d31:
    # ri "...he’s backed by powerful entities."
    ri "...за ним стоят могущественные силы."

# game/script.rpy:4864
translate russian spaceship_38af67a9:
    # ri "Possibly... extraterrestrial."
    ri "Возможно... внеземные."

# game/script.rpy:4867
translate russian spaceship_30952361:
    # N "It wasn’t my choice… I was led there."
    N "Это был не мой выбор... меня туда привели."

# game/script.rpy:4868
translate russian spaceship_4f43fca7:
    # N "A man… wearing a black mask."
    N "Мужчина... в чёрной маске."

# game/script.rpy:4871
translate russian spaceship_eb35cda5_1:
    # ri "Three years ago, we found this place."
    ri "Три года назад мы нашли это место."

# game/script.rpy:4872
translate russian spaceship_37635e00_1:
    # ri "Or rather… it let us find it."
    ri "Точнее... само позволило себя найти."

# game/script.rpy:4877
translate russian spaceship_020ebf63:
    # mc "Next day, Azarkhan’s people try to kill us."
    mc "На следующий день люди Азархана пытаются нас убить."

# game/script.rpy:4879
translate russian spaceship_33ac3d71:
    # mc "And I’m supposed to believe that’s coincidence?"
    mc "И я должен поверить, что это совпадение?"

# game/script.rpy:4880
translate russian spaceship_23cdc4b7:
    # h "Huh…"
    h "Хм..."

# game/script.rpy:4884
translate russian spaceship_4ded8083:
    # h "Never really looked at it like that…"
    h "Я как-то не смотрела на это с такой стороны..."

# game/script.rpy:4885
translate russian spaceship_98455ae8:
    # h "But yeah."
    h "Но да."

# game/script.rpy:4886
translate russian spaceship_dc1d1ea9:
    # h "That’s way too many coincidences."
    h "Слишком много совпадений."

# game/script.rpy:4888
translate russian spaceship_7ec87a23:
    # h "Feels like someone’s feeding info."
    h "Похоже, кто-то сливает информацию."

# game/script.rpy:4889
translate russian spaceship_bfbe08b0:
    # h "Or watching us real close."
    h "Или очень внимательно за нами следит."

# game/script.rpy:4891
translate russian spaceship_2b35b6fe_6:
    # mc "..."
    mc "..."

# game/script.rpy:4893
translate russian spaceship_ed237b7a:
    # mc "Stay sharp."
    mc "Будьте начеку."

# game/script.rpy:4894
translate russian spaceship_56dc04e9:
    # mc "Anything can happen."
    mc "Случиться может что угодно."

# game/script.rpy:4896
translate russian spaceship_8bfb7575:
    # h "I’ll try reaching Anya."
    h "Попробую связаться с Аней."

# game/script.rpy:4897
translate russian spaceship_52fe7e25:
    # h "There’s gotta be something here that actually works…"
    h "Должно же здесь быть хоть что-то, что работает..."

# game/script.rpy:4901
translate russian spaceship_cf36c990:
    # N "Yeah, I found something."
    N "Да, я кое-что нашёл."

# game/script.rpy:4902
translate russian spaceship_d6e94d57:
    # N "There’s a narrow passage. Tight, but we can make it, one at a time."
    N "Там узкий проход. Тесный, но пройдём. По одному."

# game/script.rpy:4904
translate russian spaceship_98ae6c0e:
    # N "Go get Dad, I’ll need him for this."
    N "Позови папу. Он мне здесь понадобится."

# game/script.rpy:4933
translate russian spaceship_into_10522407:
    # h "Seriously?"
    h "Серьёзно?"

# game/script.rpy:4934
translate russian spaceship_into_b2e3b36f:
    # h "You couldn’t be more careful?"
    h "Нельзя было осторожнее?"

# game/script.rpy:4935
translate russian spaceship_into_62e8067a:
    # mc "Drop it, Olivia."
    mc "Хватит, Оливия."

# game/script.rpy:4936
translate russian spaceship_into_2b35b6fe:
    # mc "..."
    mc "..."

# game/script.rpy:4937
translate russian spaceship_into_ed237b7a:
    # mc "Stay sharp."
    mc "Будьте начеку."

# game/script.rpy:4940
translate russian spaceship_into_89f74ab8:
    # h "You being this calm right now?"
    h "Ты сейчас настолько спокоен?"

# game/script.rpy:4941
translate russian spaceship_into_64d9851e:
    # h "Yeah… that’s not comforting."
    h "Да... это не успокаивает."

# game/script.rpy:4942
translate russian spaceship_into_49775c53:
    # mc "I’m going in first."
    mc "Я иду первым."

# game/script.rpy:4947
translate russian spaceship_into_4e6f4ed5:
    # mc "Wait…"
    mc "Стойте..."

# game/script.rpy:4951
translate russian spaceship_into_e4f7da9d:
    # mc "Doesn’t look like anyone’s here."
    mc "Похоже, здесь никого."

# game/script.rpy:4953
translate russian spaceship_into_7fc74da9:
    # h "Then I’m coming with you."
    h "Тогда я с тобой."

# game/script.rpy:4955
translate russian spaceship_into_ecf872dc:
    # mc "Wait."
    mc "Жди."

# game/script.rpy:4956
translate russian spaceship_into_f2bdc742:
    # mc "I go first."
    mc "Я первый."

# game/script.rpy:4959
translate russian spaceship_into_8c02ec34:
    # h "No."
    h "Нет."

# game/script.rpy:4960
translate russian spaceship_into_d38e769c:
    # h "Don’t do that."
    h "Не делай так."

# game/script.rpy:4962
translate russian spaceship_into_e21e8725:
    # h "I’m serious."
    h "Я серьёзно."

# game/script.rpy:4963
translate russian spaceship_into_38535c37:
    # h "Don’t go in there alone."
    h "Не заходи туда один."

# game/script.rpy:4966
translate russian spaceship_into_480890f2:
    # mc "I’ll manage."
    mc "Я справлюсь."

# game/script.rpy:4968
translate russian spaceship_into_60643364:
    # mc "If I don’t come back…"
    mc "Если я не вернусь..."

# game/script.rpy:4969
translate russian spaceship_into_f5149bc1:
    # mc "Don’t follow."
    mc "Не идите за мной."

# game/script.rpy:4970
translate russian spaceship_into_e3b834a1:
    # h "...Damn it."
    h "...Чёрт."

# game/script.rpy:4973
translate russian spaceship_into_e24e2a22:
    # mc "(Left… or right…?)"
    mc "(Налево... или направо...?)"

# game/script.rpy:4991
translate russian path_first_left_next_2_b11013ae:
    # mc "(Too quiet…)"
    mc "(Слишком тихо...)"

# game/script.rpy:4992
translate russian path_first_left_next_2_d831e8f2:
    # mc "(And that smell…)"
    mc "(И этот запах...)"

# game/script.rpy:4993
translate russian path_first_left_next_2_05c1bf7d:
    # mc "(Like something’s been rotting here for years.)"
    mc "(Будто здесь годами что-то гнило.)"

# game/script.rpy:4998
translate russian path_first_left_next_2_395b63a1:
    # mc "(…What the hell happened here?)"
    mc "(...Что здесь, чёрт возьми, произошло?)"

# game/script.rpy:4999
translate russian path_first_left_next_2_4791ec8f:
    # mc "(So that’s the smell…)"
    mc "(Так вот откуда запах...)"

# game/script.rpy:5000
translate russian path_first_left_next_2_fd8789a9:
    # mc "(Corpses.)"
    mc "(Трупы.)"

# game/script.rpy:5007
translate russian path_first_left_next_2_fca52711:
    # mc "No."
    mc "Нет."

# game/script.rpy:5008
translate russian path_first_left_next_2_3e7f1059:
    # mc "Not going in there."
    mc "Туда я не пойду."

# game/script.rpy:5021
translate russian path_first_left_back_47d8729f:
    # mc "(What was this place…?)"
    mc "(Что это было за место...?)"

# game/script.rpy:5022
translate russian path_first_left_back_f2b77e43:
    # mc "(A warship? A lab?)"
    mc "(Военный корабль? Лаборатория?)"

# game/script.rpy:5023
translate russian path_first_left_back_0036431f:
    # mc "(It’s massive…)"
    mc "(Оно огромное...)"

# game/script.rpy:5024
translate russian path_first_left_back_f3b39897:
    # mc "(Like a city buried inside a tomb.)"
    mc "(Как город, похороненный внутри гробницы.)"

# game/script.rpy:5027
translate russian path_first_left_back_fddfd5b9:
    # mc "(Every turn… more corridors.)"
    mc "(За каждым поворотом... новые коридоры.)"

# game/script.rpy:5028
translate russian path_first_left_back_fd41ebc7:
    # mc "(Like it was built to trap you.)"
    mc "(Будто всё построено, чтобы заманить тебя в ловушку.)"

# game/script.rpy:5034
translate russian path_first_left_back_72203aac:
    # mc "(Same question… every time.)"
    mc "(Один и тот же вопрос... каждый раз.)"

# game/script.rpy:5043
translate russian path_first_left_back_d5f6c8e1:
    # c "(What was this place…?)"
    c "(Что это было за место...?)"

# game/script.rpy:5044
translate russian path_first_left_back_f2b77e43_1:
    # mc "(A warship? A lab?)"
    mc "(Военный корабль? Лаборатория?)"

# game/script.rpy:5045
translate russian path_first_left_back_0036431f_1:
    # mc "(It’s massive…)"
    mc "(Оно огромное...)"

# game/script.rpy:5046
translate russian path_first_left_back_f3b39897_1:
    # mc "(Like a city buried inside a tomb.)"
    mc "(Как город, похороненный внутри гробницы.)"

# game/script.rpy:5049
translate russian path_first_left_back_fddfd5b9_1:
    # mc "(Every turn… more corridors.)"
    mc "(За каждым поворотом... новые коридоры.)"

# game/script.rpy:5050
translate russian path_first_left_back_fd41ebc7_1:
    # mc "(Like it was built to trap you.)"
    mc "(Будто всё построено, чтобы заманить тебя в ловушку.)"

# game/script.rpy:5056
translate russian path_first_left_back_dd6a5239:
    # mc "(Which way…?)"
    mc "(Куда идти...?)"

# game/script.rpy:5069
translate russian first_right_568bc166:
    # mc "(Blocked.)"
    mc "(Завалено.)"

# game/script.rpy:5070
translate russian first_right_be51f743:
    # mc "(Could climb it…)"
    mc "(Можно перелезть...)"

# game/script.rpy:5071
translate russian first_right_fe933d84:
    # mc "(Feels like a dead end.)"
    mc "(Но похоже на тупик.)"

# game/script.rpy:5086
translate russian meets11_d897712b:
    # mc "You still there?"
    mc "Вы ещё там?"

# game/script.rpy:5087
translate russian meets11_944420b6:
    # mc "Or did you all leave me already?"
    mc "Или уже все меня бросили?"

# game/script.rpy:5089
translate russian meets11_37d3cdef:
    # h "We would—"
    h "С радостью бы-"

# game/script.rpy:5090
translate russian meets11_56a90c9b:
    # h "but then who’s gonna drag your wrinkly ass out of here?"
    h "но кто тогда вытащит отсюда твою морщинистую задницу?"

# game/script.rpy:5091
translate russian meets11_ad5ba466:
    # N "We’re not leaving you behind, Dad. Not a chance."
    N "Мы тебя не бросим, пап. Даже не думай."

# game/script.rpy:5094
translate russian meets11_a13c2312:
    # mc "Bad enough I don’t wanna be here."
    mc "Достаточно плохо, чтобы мне не хотелось здесь быть."

# game/script.rpy:5095
translate russian meets11_7f5a36de:
    # mc "Not bad enough to turn back."
    mc "Но недостаточно плохо, чтобы повернуть назад."

# game/script.rpy:5097
translate russian meets11_d7f79773:
    # h "Move—!"
    h "С дороги-!"

# game/script.rpy:5102
translate russian meets11_6706a6a7:
    # h "Ow— shit…"
    h "Ай- чёрт..."

# game/script.rpy:5103
translate russian meets11_8976b556:
    # h "Yeah, I’m fine."
    h "Да, я в порядке."

# game/script.rpy:5104
translate russian meets11_9bc38ee6:
    # h "Would’ve been better if someone mentioned the damn drop!"
    h "Было бы лучше, если бы кто-то предупредил про чёртов обрыв!"

# game/script.rpy:5106
translate russian meets11_023f223d:
    # mc "That used to be nothing for you."
    mc "Раньше для тебя это было ничто."

# game/script.rpy:5107
translate russian meets11_f1d0649a:
    # mc "Getting old?"
    mc "Стареешь?"

# game/script.rpy:5110
translate russian meets11_11b7528b:
    # h "Oh, you wanna test that?"
    h "О, хочешь проверить?"

# game/script.rpy:5111
translate russian meets11_e85e184f:
    # h "Say it again."
    h "Повтори."

# game/script.rpy:5123
translate russian meets11_c9c8edea:
    # N "I’ll back him up."
    N "Я его прикрою."

# game/script.rpy:5124
translate russian meets11_71d01fb0:
    # N "Dad… watch yourself, alright?"
    N "Пап... будь осторожен, ладно?"

# game/script.rpy:5127
translate russian meets11_01ee1b35:
    # N "Sir… isn’t it a little too dark in here?"
    N "Сэр... вам не кажется, что здесь темновато?"

# game/script.rpy:5135
translate russian meets11_8911ab8a:
    # h "Hah… they clicked fast."
    h "Ха... быстро сработались."

# game/script.rpy:5136
translate russian meets11_63f9bd70:
    # h "Kid’s got a talent for bonding with weirdos, I’ll give him that."
    h "У парня талант находить общий язык со странными людьми, тут не поспоришь."

# game/script.rpy:5138
translate russian meets11_320756a6:
    # h "Alright, enough."
    h "Ладно, хватит."

# game/script.rpy:5139
translate russian meets11_2969347d:
    # h "Back to business."
    h "Вернёмся к делу."

# game/script.rpy:5141
translate russian meets11_dbac7dd1:
    # h "We moving, or you planning to stand here all day?"
    h "Мы идём или ты собираешься стоять тут весь день?"

# game/script.rpy:5148
translate russian front_1019a20f:
    # mc "Great plan."
    mc "Отличный план."

# game/script.rpy:5149
