# game/script.rpy:294
translate russian start_aaff6d35:

    # Lo "And before you ask, no, this isn't hallway gossip."
    Lo "И прежде чем спросишь: нет, это не коридорные слухи."

# game/script.rpy:295
translate russian start_9dfd27a9:

    # Lo "They moved half my clearance overnight."
    Lo "За ночь они урезали мне половину доступа."

# game/script.rpy:296
translate russian start_09ca0e7e:

    # Lo "Someone high up wants this buried and fast-"
    Lo "Кто-то наверху хочет похоронить это дело, и быстро-"

# game/script.rpy:300
translate russian start_1b4cdb69:

    # mc "(Organic... Teleportation...)"
    mc "(Органическое... Телепортация...)"

# game/script.rpy:301
translate russian start_04d07738:

    # mc "(Sounds too close to our briefing.)"
    mc "(Слишком похоже на наш брифинг.)"

# game/script.rpy:379
translate russian start_73835c8c:

    # g "Keep your heads down, locals aren’t exactly friendly."
    g "Не высовывайтесь, местные не особо дружелюбны."

# game/script.rpy:414
translate russian start_8c9903a7:

    # S "Clear. I’ve got the scanner."
    S "Принято. Сканер у меня."

# game/script.rpy:440
translate russian start_906360bb:

    # mc "(Satellite feed showed traffic here forty-eight hours ago.)"
    mc "(Спутниковая съёмка показывала здесь движение сорок восемь часов назад.)"

# game/script.rpy:441
translate russian start_3fe6b56d:

    # mc "(Now nothing.)"
    mc "(Теперь ничего.)"

# game/script.rpy:442
translate russian start_0ebd9272:

    # mc "(No bodies. No blood. No evacuation trail.)"
    mc "(Ни тел. Ни крови. Ни следов эвакуации.)"

# game/script.rpy:461
translate russian start_41b5682e:

    # h "Place was brand new… and now it looks like it aged twenty years overnight."
    h "Место было совсем новым... а теперь выглядит так, будто за ночь состарилось на двадцать лет."

# game/script.rpy:467
translate russian start_f8e03c08:

    # mc "A few days ago we got a tip. Anonymous."
    mc "Несколько дней назад мы получили наводку. Анонимную."

# game/script.rpy:470
translate russian start_bc6c7580:

    # mc "At first HQ thought it was bait."
    mc "Сначала штаб решил, что это приманка."

# game/script.rpy:471
translate russian start_aa7e09e2:

    # mc "Then the drone footage came in."
    mc "Потом пришли кадры с дронов."

# game/script.rpy:472
translate russian start_5ef14c69:

    # mc "Whole blocks emptied overnight."
    mc "Целые кварталы опустели за одну ночь."

# game/script.rpy:477
translate russian start_853e68a8:

    # mc "Only that the cargo contains an unknown substance."
    mc "Только то, что груз содержит неизвестную субстанцию."

# game/script.rpy:478
translate russian start_e4e9ca29:

    # mc "Unstable. Unknown origin."
    mc "Нестабильно. Происхождение неизвестно."

# game/script.rpy:479
translate russian start_b800ee21:

    # mc "And everyone who tried to inspect it either vanished..."
    mc "И все, кто пытался это осмотреть, либо исчезали..."

# game/script.rpy:491
translate russian start_6aab3175:

    # mc "Yeah. We’re here. If HQ's timing is right, the deal goes down in a couple of hours."
    mc "Да. Мы здесь. Если штаб правильно рассчитал время, сделка состоится через пару часов."

# game/script.rpy:526
translate russian war2_c126556f:

    # mc "(Thirty-six hours.)"
    mc "(Тридцать шесть часов.)"

# game/script.rpy:528
translate russian war2_15206aff:

    # mc "(Food left on tables, cars abandoned mid-street. Doors open.)"
    mc "(Еда осталась на столах, машины брошены посреди улиц. Двери открыты.)"

# game/script.rpy:529
translate russian war2_6f3e1322:

    # mc "(Like the whole city stood up at once...)"
    mc "(Словно весь город разом поднялся и ушёл...)"

# game/script.rpy:682
translate russian war2_21077d71:

