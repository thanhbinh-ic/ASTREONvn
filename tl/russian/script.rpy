    # N "But they let me in?"
    N "Но меня они впустили?"

# game/script.rpy:2073
translate russian homedinner_e042b707:

    # L "You're my son."
    L "Ты мой сын."

# game/script.rpy:2074
translate russian homedinner_51491343:

