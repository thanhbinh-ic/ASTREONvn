translate russian jungle_2b35b6fe:

    # mc "..."
    mc "..."

# game/script.rpy:2400
translate russian jungle_07bc4dba:

    # h "Guess it was nothing. Though I was certain someone was there... "
    h "Похоже, ничего. Хотя я была уверена, что там кто-то есть..."

# game/script.rpy:2402
translate russian jungle_f36f6071:

    # N "Finally found it! For a moment there, I thought we were never going to get out of here..."
    N "Нашёл! Я уже на секунду решил, что мы отсюда никогда не выберемся..."

