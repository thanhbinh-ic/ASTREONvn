    # L "(softly) This is the only way I can keep them both out of it..."
    L "(тихо) Только так я могу уберечь их обоих от всего этого..."

# game/script.rpy:2097
translate russian homedinner_8ad30580:

    # N "The public trail isn't the place Mom took me."
    N "Открытый маршрут - не то место, куда мама меня водила."

# game/script.rpy:2098
translate russian homedinner_8fd6fb88:

    # N "There was another way."
    N "Был другой путь."

# game/script.rpy:2099
translate russian homedinner_056e1b5f:

    # N "Past the old service road."
    N "За старой служебной дорогой."

# game/script.rpy:2100
translate russian homedinner_ca247b4c:

    # N "A place no tourist would ever find."
    N "Место, которое ни один турист никогда бы не нашёл."

# game/script.rpy:2102
translate russian homedinner_b4c5b797:

    # mc "And you never told me?"
    mc "И ты мне никогда не рассказал?"

# game/script.rpy:2104
translate russian homedinner_d67d6d9a:

    # N "...No."
    N "...Нет."

# game/script.rpy:2105
translate russian homedinner_8f5426cf:

    # N "I was scared."
    N "Я боялся."

# game/script.rpy:2106
translate russian homedinner_c7bfd441:

    # N "And after 2030..."
    N "А после 2030-го..."

# game/script.rpy:2107
translate russian homedinner_3afff267:

    # N "I convinced myself maybe it was better buried."
    N "я убедил себя, что, может, лучше всё похоронить."

# game/script.rpy:2109
translate russian homedinner_8d0f132b_1:

    # mc "Norman..."
    mc "Норман..."

# game/script.rpy:2111
translate russian homedinner_533522e2:

    # N "That's the part I kept from you."
    N "Вот эту часть я от тебя скрывал."

# game/script.rpy:2170
translate russian homedinner_3ec0c45f:

    # L "He stays with me until we're done."
    L "Он остаётся со мной, пока мы не закончим."

# game/script.rpy:2173
translate russian homedinner_99b22258:

    # R "Unusual choice."
    R "Необычный выбор."

# game/script.rpy:2174
translate russian homedinner_7afa7fb5:

    # L "Necessary one."
    L "Необходимый."

# game/script.rpy:2203
translate russian homedinner_bc76fb59:

    # s "And the board wants the sample secured before nightfall."
    s "И совет хочет, чтобы образец был защищён до наступления ночи."

# game/script.rpy:2229
translate russian homedinner_22b4a839:

    # N "A substance, I think."
    N "Субстанция, кажется."

# game/script.rpy:2240
