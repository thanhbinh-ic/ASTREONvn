translate russian homedinner_77f9c83e:

    # N "So it's dangerous?"
    N "Значит, это опасно?"

# game/script.rpy:2083
translate russian homedinner_5da94d85:

    # L "It might be."
    L "Может быть."

# game/script.rpy:2084
translate russian homedinner_a84147c7:

    # L "That's why I need you to stay close."
    L "Вот почему мне нужно, чтобы ты держался рядом."

# game/script.rpy:2085
