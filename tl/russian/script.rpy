    N "А как же {b}твоя{/b} жизнь?! Или ты туда умирать собрался?!"

# game/script.rpy:2868
translate russian norman_home_2b35b6fe_4:

    # mc "..."
    mc "..."

# game/script.rpy:2873
translate russian norman_home_9362244b:

    # mc "Tell me something, Norman... have you ever killed anyone?"
    mc "Скажи, Норман... ты когда-нибудь убивал?"

# game/script.rpy:2875
translate russian norman_home_8417c3a5:

    # N "N-no... not yet."
    N "Н-нет... пока нет."

# game/script.rpy:2878
translate russian norman_home_852d03b2:

    # mc "I have. Dozens. {b}Hundreds.{/b}"
    mc "Я убивал. Десятки. {b}Сотни{/b}."

# game/script.rpy:2880
translate russian norman_home_2b35b6fe_5:

    # mc "..."
    mc "..."

# game/script.rpy:2882
translate russian norman_home_67b57d03:

    # N "B-but... W-why are you saying this...?"
    N "Н-но... п-почему ты это говоришь...?"

# game/script.rpy:2885
translate russian norman_home_656e98b9:

    # mc "Because if something happens to a man like me — no one cries."
    mc "Потому что если с таким, как я, что-то случится, плакать будет некому."

# game/script.rpy:2886
translate russian norman_home_67b738e8:

    # mc "But you... you’re different."
    mc "Но ты... ты другой."

# game/script.rpy:2887
translate russian norman_home_d9d4a206:

    # N "DON’T SAY THAT! And besides... you don’t know that forest like I do!"
    N "НЕ ГОВОРИ ТАК! И к тому же... ты не знаешь этот лес так, как я!"

# game/script.rpy:2889
translate russian norman_home_2b35b6fe_6:

    # mc "..."
    mc "..."

# game/script.rpy:2891
translate russian norman_home_c071ad40:

    # mc "Are you sure about this?"
    mc "Ты уверен?"

# game/script.rpy:2893
translate russian norman_home_d091a57d:

    # N "One hundred percent!"
    N "На сто процентов!"

# game/script.rpy:2900
translate russian norman_home_047733d9:

    # mc "You know how to use it?"
    mc "Ты умеешь им пользоваться?"

# game/script.rpy:2902
translate russian norman_home_c730e0e8:

    # N "Dad, I..."
    N "Пап, я..."

# game/script.rpy:2904
translate russian norman_home_85bbe54d:

    # N "I’m not sure I have the strength... or courage."
    N "Я не уверен, что у меня хватит сил... или мужества."

# game/script.rpy:2906
translate russian norman_home_2b35b6fe_7:

    # mc "..."
    mc "..."

# game/script.rpy:2908
translate russian norman_home_0e914239:

    # mc "Then if you’re coming with me, you better not slow us down."
    mc "Тогда, если идёшь со мной, не тормози нас."

# game/script.rpy:2910
translate russian norman_home_2b35b6fe_8:

    # mc "..."
    mc "..."

# game/script.rpy:2912
translate russian norman_home_b097296e:

    # mc "But... you can still back out."
    mc "Но... ты ещё можешь отказаться."

# game/script.rpy:2914
translate russian norman_home_b405385e:

    # N "No!"
    N "Нет!"

# game/script.rpy:2915
translate russian norman_home_dfecf87b:

    # N "I’ll do everything I can. I promise."
    N "Я сделаю всё, что смогу. Обещаю."

# game/script.rpy:2917
translate russian norman_home_2b35b6fe_9:

    # mc "..."
    mc "..."

# game/script.rpy:2922
translate russian norman_home_03e6eb1d:

    # mc "I’m counting on you, Norman."
    mc "Я рассчитываю на тебя, Норман."

# game/script.rpy:2924
translate russian norman_home_9477f979:

    # N "Thanks, Dad."
    N "Спасибо, пап."

# game/script.rpy:2931
translate russian norman_home_a11fe3a9:

    # mc "You’ve grown up a lot."
    mc "Ты сильно вырос."

# game/script.rpy:2932
translate russian norman_home_d42c4881:

    # mc "Your mother would’ve been proud."
    mc "Твоя мама гордилась бы тобой."

# game/script.rpy:2941
translate russian norman_home_2fb9e2cd:

    # mc "(Was this the right decision...?)"
    mc "(Правильное ли это решение...?)"

# game/script.rpy:2942
translate russian norman_home_4fd2f112:

    # mc "(Maybe I should still talk him out of it...)"
    mc "(Может, ещё не поздно его отговорить...)"

# game/script.rpy:2944
translate russian norman_home_c20e1c74:

    # mc "(No, [mc]. Enough.)"
    mc "(Нет, [mc!t]. Хватит.)"

# game/script.rpy:2946
translate russian norman_home_782ce734:

    # mc "(He’s not a boy anymore. Respect that.)"
    mc "(Он больше не мальчик. Уважай это.)"

# game/script.rpy:2952
translate russian norman_home_e659b862:

    # mc "(Alright... I think I’ve got everything packed. Just a few more things and—)"
    mc "(Ладно... кажется, всё собрал. Ещё пару вещей и-)"

# game/script.rpy:2954
translate russian norman_home_2b35b6fe_10:

    # mc "..."
    mc "..."

# game/script.rpy:2957
translate russian norman_home_9f697596:

    # mc "(Or maybe… not just me after all.)"
    mc "(Или... может, не только я.)"

# game/script.rpy:2959
translate russian norman_home_b79db654:

    # mc "(Focus, [mc]. We’ve been through this before.)"
    mc "(Сосредоточься, [mc!t]. Мы уже проходили через это.)"

# game/script.rpy:2963
translate russian norman_home_d061f744:

    # h "You’re taking us with you?! Oh wow, Anya is going to be thrilled!"
    h "Вы берёте нас с собой?! Ого, Аня будет в восторге!"

# game/script.rpy:2964
translate russian norman_home_f90f61c4:

    # L "Yeah... [mc] and I figured it might be a good idea."
    L "Ага... мы с [mc!t] подумали, что это хорошая идея."

# game/script.rpy:2966
translate russian norman_home_085615f8:

    # L "Come on, both of you. Time for a memory shot."
    L "Давайте, обе сюда. Сделаем снимок на память."

# game/script.rpy:2967
translate russian norman_home_d4f97ce2:

    # mc "Smile!"
    mc "Улыбочку!"

# game/script.rpy:2969
translate russian norman_home_0563d991:

    # mc "{b}Sigh{/b}"
    mc "{i}*вздох*{/i}"

# game/script.rpy:2971
translate russian norman_home_2b35b6fe_11:

    # mc "..."
    mc "..."

# game/script.rpy:2972
translate russian norman_home_2145bb49:

    # mc "(Now or never...)"
    mc "(Сейчас или никогда...)"

# game/script.rpy:2974
translate russian norman_home_cb379e56:

    # mc "Will you marry me?"
    mc "Ты выйдешь за меня?"

# game/script.rpy:2975
translate russian norman_home_c7e10d5b:

    # L "Oh my God — YES! {w=0.2}YES! {w=0.2}YES! {w=0.2}YES!"
    L "О боже - ДА! {w=0.2}ДА! {w=0.2}ДА! {w=0.2}ДА!"

# game/script.rpy:2976
translate russian norman_home_3c15b920:

    # L "A thousand times yes!"
    L "Тысячу раз да!"

# game/script.rpy:2978
translate russian norman_home_5939ed48:

    # L "Do you believe in fate, darling?"
    L "Ты веришь в судьбу, дорогой?"

# game/script.rpy:2979
translate russian norman_home_d4358764:

    # mc "Not really, no."
    mc "Не особо, нет."

# game/script.rpy:2980
translate russian norman_home_66ad99fe:

    # L "Among millions of planets, and billions of people — we found each other on this very Earth."
    L "Среди миллионов планет и миллиардов людей - мы нашли друг друга на этой самой Земле."

# game/script.rpy:2981
translate russian norman_home_f0c6a883:

    # L "What else could you call that if not fate?"
    L "Как ещё это можно назвать, если не судьбой?"

# game/script.rpy:2983
translate russian norman_home_2b35b6fe_12:

    # mc "..."
    mc "..."

# game/script.rpy:2985
translate russian norman_home_a9867b0e:

    # mc "Let go, you're gonna strangle me..."
    mc "Отпусти, задушишь же..."

# game/script.rpy:2986
translate russian norman_home_ae316ad3:

    # L "No!"
    L "Нет!"

# game/script.rpy:2987
translate russian norman_home_16af2cdb:

    # L "You’re mine. I’m never letting go!"
    L "Ты мой. И я тебя больше не отпущу!"

# game/script.rpy:2989
translate russian norman_home_2b35b6fe_13:

    # mc "..."
    mc "..."

# game/script.rpy:2990
translate russian norman_home_9362d2fa:

    # mc "Yeah... that’s how I’ll remember you."
    mc "Да... такой я тебя и запомню."

# game/script.rpy:2991
translate russian norman_home_86992b43:

    # mc "Always smiling. Always happy..."
    mc "Всегда улыбающейся. Всегда счастливой..."

# game/script.rpy:2993
translate russian norman_home_4a205a40:

    # mc "(I’ve made my choice. Thank you...)"
    mc "(Я сделал свой выбор. Спасибо...)"

# game/script.rpy:2996
translate russian norman_home_c4148e74:

    # mc "(And goodbye.)"
    mc "(И прощай.)"

# game/script.rpy:2998
translate russian norman_home_a18ca897:

    # Lor "..."
    Lor "..."

# game/script.rpy:2999
translate russian norman_home_ad9d37eb:

    # Lor "After all these years, you’ve stopped running..."
    Lor "После всех этих лет ты наконец перестал бежать..."

# game/script.rpy:3001
translate russian norman_home_6cd9144d:

    # Lor "...and finally faced the truth, huh?"
    Lor "...и всё-таки посмотрел правде в лицо, да?"

# game/script.rpy:3003
translate russian norman_home_a18ca897_1:

    # Lor "..."
    Lor "..."

# game/script.rpy:3005
translate russian norman_home_95eeb8b7:

    # Lor "Thank you, my love. From the bottom of my heart — thank you."
    Lor "Спасибо, любовь моя. От всего сердца - спасибо."

# game/script.rpy:3007
translate russian norman_home_a18ca897_2:

    # Lor "..."
    Lor "..."

# game/script.rpy:3014
translate russian norman_home_4cfce9e7:

    # C "♪ Singing a tune ♪"
    C "{font=tl/russian/fonts/Symbola.ttf}♪{/font} Напевает мелодию {font=tl/russian/fonts/Symbola.ttf}♪{/font}"

# game/script.rpy:3016
translate russian norman_home_2586b0e6:

    # C "So... sis. What’re you gonna do with [mc]’s request?"
    C "Ну что, сестрёнка... что будешь делать с его просьбой?"

# game/script.rpy:3018
translate russian norman_home_116885e4:

    # h "I don’t really have a choice, do I?"
    h "У меня ведь нет выбора, да?"

# game/script.rpy:3021
translate russian norman_home_55574c1e:

    # h "After everything he’s done... turning away now would be disgraceful."
    h "После всего, что он сделал... отвернуться сейчас было бы позорно."

# game/script.rpy:3022
translate russian norman_home_6c6439a4:

    # h "And I’ve still got {b}some{/b} pride left."
    h "А гордость у меня ещё {b}немного{/b} осталась."

# game/script.rpy:3024
translate russian norman_home_7382db10:

    # C "And maybe not just pride..."
    C "А может, не только гордость..."

# game/script.rpy:3025
translate russian norman_home_b385a0ba:

    # C "Where are you off to dressed like that?"
    C "И куда это ты собралась в таком виде?"

# game/script.rpy:3026
translate russian norman_home_e46ce154:

    # C "Mission? Or someone’s sleepover?"
    C "На задание? Или к кому-то на ночёвку?"

# game/script.rpy:3027
translate russian norman_home_9a62e5ad:

    # h "Ha-ha. Very funny."
    h "Ха-ха. Очень смешно."

# game/script.rpy:3029
translate russian norman_home_aa63c24b:

    # h "Listen — I don’t know how long I’ll be gone. You’re in charge, got it?"
    h "Слушай. Я не знаю, насколько задержусь. Ты здесь за главную, поняла?"

# game/script.rpy:3031
translate russian norman_home_d80d7ef6:

    # h "If anything comes up, talk to Alexandro."
    h "Если что-то случится, зови Алехандро."

# game/script.rpy:3033
translate russian norman_home_0151f052:

    # h "If it’s serious — Kayla. But only if absolutely necessary."
    h "Если совсем серьёзно - Кайлу. Но только в крайнем случае."

# game/script.rpy:3035
translate russian norman_home_1833b9b0:

    # C "Relax, sis. I’m not a kid anymore — I’ve got this."
    C "Расслабься, сестрёнка. Я уже не ребёнок - справлюсь."

# game/script.rpy:3038
translate russian norman_home_a194c960:

    # C "Just... be careful, okay? I’ve heard the rumors about that place."
    C "Только... будь осторожна, ладно? Я слышала слухи об этом месте."

# game/script.rpy:3041
translate russian norman_home_a1fadfa7:

    # h "We’ve been through worse."
    h "Мы и похуже переживали."

# game/script.rpy:3043
translate russian norman_home_9874ee67:

    # C "Besides, he’s still clinging to the past. You’ll only hurt yourself this way."
    C "К тому же он всё ещё цепляется за прошлое. Так ты только себе больнее сделаешь."

# game/script.rpy:3046
translate russian norman_home_2fded262:

    # h "..."
    h "..."

# game/script.rpy:3052
translate russian norman_home_117d6fba:

    # h "That’s my problem. Take care, Anya."
    h "Это уже моя проблема. Береги себя, Аня."

# game/script.rpy:3053
translate russian norman_home_507f32d0:

    # h "And try not to burn down the bar while I’m gone."
    h "И постарайся не спалить бар, пока меня нет."

# game/script.rpy:3055
translate russian norman_home_4b9ccdab:

    # C "No promises."
    C "Не обещаю."

# game/script.rpy:3060
translate russian norman_home_26a803bc:

    # C "..."
    C "..."

# game/script.rpy:3064
translate russian norman_home_eacc5488:

    # CC "Alone again. How sweet."
    CC "Опять одна. Как мило."

# game/script.rpy:3065
translate russian norman_home_f06bab89:

    # CC "Funny how you still pretend like you’re needed."
    CC "Забавно, как ты всё ещё делаешь вид, будто кому-то нужна."

# game/script.rpy:3067
translate russian norman_home_57fbc14c:

    # CC "Want the truth, Anya? They leave you because you're exhausting."
    CC "Хочешь правду, Аня? Они уходят, потому что ты всех изматываешь."

# game/script.rpy:3068
translate russian norman_home_a23c3873:

    # CC "You're dead weight. Olivia knows it."
    CC "Ты мёртвый груз. Оливия это знает."

# game/script.rpy:3070
translate russian norman_home_d4cddc11:

    # CC "She’s cold to you for a reason, isn’t she?"
    CC "Она ведь не просто так такая холодная с тобой, правда?"

# game/script.rpy:3072
translate russian norman_home_18235fc5:

    # CC "She {b}blames{/b} you. For mom. For the ruins. For everything that went wrong."
    CC "Она {b}винит{/b} тебя. За маму. За руины. За всё, что пошло не так."

# game/script.rpy:3074
translate russian norman_home_3aee5eb9:

    # C "—No. She just... she knows I can handle myself."
    C "Нет. Она просто... знает, что я сама о себе позабочусь."

# game/script.rpy:3076
translate russian norman_home_ab5aab3d:

    # CC "No, sweetheart. That’s what {b}you{/b} think."
    CC "Нет, милая. Это {b}ты{/b} так думаешь."

# game/script.rpy:3077
translate russian norman_home_9eb28e00:

    # CC "She’s just too tired to save you again."
    CC "Она просто слишком устала снова тебя спасать."

# game/script.rpy:3079
translate russian norman_home_3b3795cc:

    # C "We’ve been through this."
    C "Мы уже это проходили."

# game/script.rpy:3081
translate russian norman_home_9f8be534:

    # CC "Repeating myself? You know why?"
    CC "Я повторяюсь? Знаешь, почему?"

# game/script.rpy:3082
translate russian norman_home_7e6dd075:

    # CC "Because you still haven’t admitted the obvious."
    CC "Потому что ты до сих пор не признала очевидное."

# game/script.rpy:3085
translate russian norman_home_62044f69:

    # CC "You’ve always been a burden."
    CC "Ты всегда была обузой."

# game/script.rpy:3086
translate russian norman_home_52a5e0a1:

    # CC "Mom died saving {b}you{/b}. She should’ve left you behind."
    CC "Мама умерла, спасая {b}тебя{/b}. Надо было оставить тебя там."

# game/script.rpy:3088
translate russian norman_home_a7e3984d:

    # CC "You think she chose you? It was a mistake. An instinct. A blind hope."
    CC "Думаешь, она выбрала тебя? Нет. Ошибка. Инстинкт. Слепая надежда."

# game/script.rpy:3090
translate russian norman_home_ac69896c:

    # CC "And now? You live with that. Pretending everything’s fine."
    CC "А теперь ты живёшь с этим. И притворяешься, что всё нормально."

# game/script.rpy:3092
translate russian norman_home_85795b45:

    # C "Stop it."
    C "Хватит."

# game/script.rpy:3094
translate russian norman_home_af0bd5e8:

    # CC "..."
    CC "..."

# game/script.rpy:3096
translate russian norman_home_fd886bad:

    # CC "Olivia had to grow up fast. Work from fifteen. Carry you through every meltdown."
    CC "Оливии пришлось быстро повзрослеть. Работать с пятнадцати. Тащить на себе все твои срывы."

# game/script.rpy:3098
translate russian norman_home_778f1f44:

    # CC "I had to carry you on my back when you couldn’t even eat without having a breakdown."
    CC "Ей приходилось носиться с тобой, когда ты даже есть без истерики не могла."

# game/script.rpy:3100
translate russian norman_home_e679d801:

    # CC "She sacrificed everything for you."
    CC "Она пожертвовала всем ради тебя."

# game/script.rpy:3102
translate russian norman_home_8b01dd70:

    # CC "If not for you — Olivia would’ve had a normal life."
    CC "Если бы не ты, у Оливии была бы нормальная жизнь."

# game/script.rpy:3103
translate russian norman_home_92be6ed7:

    # CC "With mom. A future. {b}Without you.{/b}"
    CC "С мамой. С будущим. {b}Без тебя{/b}."

# game/script.rpy:3105
translate russian norman_home_f70c563d:

    # C "I said STOP!"
    C "Я сказала, ХВАТИТ!"

# game/script.rpy:3112
translate russian norman_home_706e8e73:

    # C "You don’t get to say her name!"
    C "Не смей произносить её имя!"

# game/script.rpy:3140
translate russian exit_5180949d:

    # h "Barely made it. What the hell is with all this traffic at freaking 5 AM?!"
    h "Еле добралась. Что за чёртов трафик в пять утра?!"

# game/script.rpy:3143
translate russian exit_43444f8b:

    # h "Private Olivia reporting as ordered! Ready for duty!"
    h "Рядовая Оливия прибыла по приказу! К службе готова!"

# game/script.rpy:3145
translate russian exit_d6829f63:

    # mc "Cut the formality, you know I hate that stuff."
    mc "Хватит формальностей, ты же знаешь, я их ненавижу."

# game/script.rpy:3147
translate russian exit_3541338e:

    # h "Phew. I was waiting for you to say that."
    h "Фух. Я ждала, когда ты это скажешь."

# game/script.rpy:3148
translate russian exit_5d3d3775:

    # h "By the way, anyone else coming?"
    h "Кстати, кто-нибудь ещё придёт?"

# game/script.rpy:3150
translate russian exit_456109f6:

    # mc "There’s no one else. No one left to ask."
    mc "Никто. Больше просить некого."

# game/script.rpy:3152
translate russian exit_3ba013cf:

    # h "Oh, so just us? Well that’s..."
    h "О, значит, только мы? Ну, это..."

# game/script.rpy:3154
translate russian exit_a0f07cfb:

    # h "I mean — what a shame."
    h "То есть... какая жалость."

