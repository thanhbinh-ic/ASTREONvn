translate russian homedinner_2a3e24eb:

    # N "Then I saw him."
    N "Потом я увидел его."

# game/script.rpy:2350
translate russian homedinner_2b888d75:

    # mc "Him?"
    mc "Его?"

# game/script.rpy:2354
translate russian homedinner_4c540731:

    # N "He gave me Mom's necklace."
    N "Он дал мне мамино ожерелье."

# game/script.rpy:2355
translate russian homedinner_785e64ab:

    # N "Said you'd know what it meant."
    N "Сказал, ты поймёшь, что оно значит."

# game/script.rpy:2440
translate russian homedinner_60fafa63:

    # N "This one didn't come from him."
    N "Это пришло не от него."

# game/script.rpy:2441
translate russian homedinner_937f9e33:

    # N "My handler passed this along."
    N "Мой куратор передала это."

# game/script.rpy:2442
translate russian homedinner_a1a568aa:

    # N "She said it came from an old friend of yours."
    N "Она сказала, что это от твоего старого друга."

# game/script.rpy:2581
translate russian anna_c1a00a18:

    # Lor "Remember what I told you?"
    Lor "Помнишь, что я тебе говорила?"

# game/script.rpy:2582
translate russian anna_08c279ab:

    # Lor "When someone needs a hand..."
    Lor "Когда кому-то нужна рука помощи..."

# game/script.rpy:2583
translate russian anna_91fd7b3d:

    # mc "Don't push them away."
    mc "Не отталкивай его."

# game/script.rpy:2584
translate russian anna_c127961d:

    # Lor "Exactly."
    Lor "Именно."

# game/script.rpy:2585
translate russian anna_fc3cb421:

    # mc "Tho..."
    mc "Хотя..."

# game/script.rpy:2929
translate russian anna_b33d3241:

    # mc "You look steady."
    mc "Ты держишься."

# game/script.rpy:2931
translate russian anna_351aed3a:

    # x "Best prosthetic money can buy, hermano."
    x "Лучший протез, который можно купить за деньги, hermano."

# game/script.rpy:2932
translate russian anna_58d77330:

    # x "Still complains when it rains, though."
    x "Правда, всё ещё ноет, когда идёт дождь."

# game/script.rpy:2933
translate russian anna_e747de4d:

    # x "But hey. Could've been worse."
    x "Но, эй. Могло быть и хуже."

# game/script.rpy:2935
translate russian anna_cf1adef2_1:

    # mc "Yeah."
    mc "Да."

# game/script.rpy:2936
translate russian anna_631111f4:

    # x "Mona and Jack didn't get to complain."
    x "Мона и Джек уже не могли жаловаться."

# game/script.rpy:3182
translate russian bar_olivica_4acfd547:

    # mc "Before that..."
    mc "До этого..."

# game/script.rpy:3183
translate russian bar_olivica_0fe2b219:

    # mc "Anya ran into trouble outside."
    mc "Аня попала в беду снаружи."

# game/script.rpy:3185
translate russian bar_olivica_26681431:

    # h "What kind of trouble?"
    h "В какую беду?"

# game/script.rpy:3187
translate russian bar_olivica_7177233e:

    # mc "The kind where someone wanted her alive."
    mc "В такую, где кто-то хотел взять её живой."

# game/script.rpy:3188
translate russian bar_olivica_53296d3c:

    # mc "As leverage."
    mc "Как рычаг давления."

# game/script.rpy:3191
translate russian bar_olivica_9ad006ae:

    # h "Who?"
    h "Кто?"

# game/script.rpy:3195
translate russian bar_olivica_1d89acc9:

    # mc "Didn't get a name."
    mc "Имени я не узнал."

# game/script.rpy:3196
translate russian bar_olivica_f7faa546:

    # mc "But they knew she was your sister."
    mc "Но они знали, что она твоя сестра."

# game/script.rpy:3198
translate russian bar_olivica_1bc33fea:

    # h "Old business."
    h "Старые дела."

# game/script.rpy:3199
translate russian bar_olivica_62e48b8d:

    # h "Don't worry about it. I'll make a couple of calls later."
    h "Не переживай. Позже сделаю пару звонков."

# game/script.rpy:3251
translate russian bar_olivica_bb3d3a29:

    # h "Don't do that."
    h "Не надо так."

# game/script.rpy:3252
translate russian bar_olivica_94507c05:

    # mc "Do what?"
    mc "Что именно?"

# game/script.rpy:3253
translate russian bar_olivica_790db0bb:

    # h "Sound hopeful."
    h "Звучать с надеждой."

# game/script.rpy:3255
translate russian bar_olivica_667eaaba:

    # mc "Too late."
    mc "Поздно."

# game/script.rpy:3256
translate russian bar_olivica_455625a9:

    # "An awkward silence settles between them."
    "Между ними повисает неловкая тишина."

# game/script.rpy:3277
translate russian bar_olivica_2fded262_7:

    # h "..."
    h "..."

# game/script.rpy:3291
translate russian bar_olivica_3496291e:

    # mc "It came with coordinates."
    mc "С ними были координаты."

# game/script.rpy:3292
translate russian bar_olivica_c815f19b:

    # mc "And a photo no one should be able to take."
    mc "И фотография, которую никто не должен был суметь сделать."

# game/script.rpy:3341
translate russian bar_olivica_4499ebe1:

    # h "Yeah, the idea of bringing Lora back sounds nice."
    h "Да, мысль вернуть Лору звучит приятно."

# game/script.rpy:3342
translate russian bar_olivica_3659234f:

    # h "Too nice."
    h "Слишком приятно."

# game/script.rpy:3350
translate russian bar_olivica_583f9be8:

    # h "You finally have Norman back in the room with you."
    h "Норман наконец снова рядом с тобой."

# game/script.rpy:3351
translate russian bar_olivica_368f69a8:

    # h "You have a granddaughter who thinks you hung the moon."
    h "У тебя есть внучка, которая считает, что ты повесил луну на небо."

# game/script.rpy:3352
translate russian bar_olivica_c96d2705:

    # h "And you're about to walk into the same fire again."
    h "А ты собираешься снова войти в тот же огонь."

# game/script.rpy:3353
translate russian bar_olivica_5b178ae7:

    # h "Trust me, even that doesn't last forever."
    h "Поверь, даже это не длится вечно."

# game/script.rpy:3360
translate russian bar_olivica_05a4b8b0:

    # mc "But if there’s even a chance that photo is real..."
    mc "Но если есть хоть шанс, что эта фотография настоящая..."

# game/script.rpy:3361
translate russian bar_olivica_688285df:

    # mc "I have to know."
    mc "Я должен знать."

# game/script.rpy:3380
translate russian bar_olivica_34336037:

    # C "Those guys from earlier?"
    C "Те ребята, что были раньше?"

# game/script.rpy:3381
translate russian bar_olivica_7121afe9:

    # C "Someone paid their boss to make noise here."
    C "Кто-то заплатил их боссу, чтобы они устроили здесь шум."

# game/script.rpy:3588
translate russian norman_home_0a966fad:

    # mc "The public trail?"
    mc "Открытый маршрут?"

# game/script.rpy:3591
translate russian norman_home_5e36508b:

    # N "No."
    N "Нет."

# game/script.rpy:3592
translate russian norman_home_533a5c58:

    # N "The place Mom took me."
    N "Место, куда мама меня водила."

# game/script.rpy:3593
translate russian norman_home_056e1b5f:

    # N "Past the old service road."
    N "За старой служебной дорогой."

# game/script.rpy:3594
translate russian norman_home_61828e19:

    # N "Your coordinates won't get you through that part."
    N "Твои координаты не проведут тебя через ту часть."

# game/script.rpy:3597
translate russian norman_home_31de6330:

    # mc "You should've opened with that."
    mc "С этого и надо было начинать."

# game/script.rpy:3599
translate russian norman_home_5fb7a3fa:

    # N "I thought you'd go without me."
    N "Я думал, ты уйдёшь без меня."

# game/script.rpy:3718
translate russian norman_home_880b9715:

    # mc "(To the grave I built for you.)"
    mc "(К могиле, которую я сам для тебя построил.)"

# game/script.rpy:3728
translate russian norman_home_c2168695:

    # Lor "For finally facing it."
    Lor "За то, что наконец встретился с этим лицом к лицу."

# game/script.rpy:3750
translate russian norman_home_acb619c0:

    # mc "(The case.)"
    mc "(Кейс.)"

# game/script.rpy:3751
translate russian norman_home_42d81e4b:

    # mc "(No core. No cell.)"
    mc "(Ни ядра. Ни ячейки.)"

# game/script.rpy:3752
translate russian norman_home_ff571a1b:

    # mc "(Just that liquid.)"
    mc "(Только эта жидкость.)"

# game/script.rpy:3756
translate russian norman_home_b6fc01a3:

    # mc "(Same pattern. Different place.)"
    mc "(Та же схема. Другое место.)"

# game/script.rpy:3771
translate russian norman_home_6c1a055e:

    # mc "(Not just a lab.)"
    mc "(Не просто лаборатория.)"

# game/script.rpy:3857
translate russian norman_home_229f9586:

    # h "And if Azarkhan really is breathing again..."
    h "А если Азархан правда снова дышит..."

# game/script.rpy:3858
translate russian norman_home_cb80046a:

    # h "Waiting for him to knock would be even dumber."
    h "Ждать, пока он постучится, было бы ещё глупее."

# game/script.rpy:3869
translate russian norman_home_023b0517:

    # h "And no hero crap."
    h "И никакой геройской ерунды."

# game/script.rpy:3870
translate russian norman_home_77334a77:

    # h "If anyone asks for you by name, you call Kayla."
    h "Если кто-нибудь спросит тебя по имени, звони Кайле."

# game/script.rpy:3871
translate russian norman_home_0b021fcb:

    # C "Because of those guys?"
    C "Из-за тех ребят?"

# game/script.rpy:3872
translate russian norman_home_890e67f4:

    # h "Because I said so."
    h "Потому что я так сказала."

# game/script.rpy:4051
translate russian exit_26d191fe:

    # h "Wait… That's Norman? Don’t tell me we’ve got more company."
    h "Постой... Это Норман? Не говори, что у нас ещё компания."

# game/script.rpy:4059
translate russian exit_e9b51473:

    # h "Absolutely not."
    h "Даже не обсуждается."

# game/script.rpy:4060
translate russian exit_98b33eb1:

    # h "Tell me you're joking."
    h "Скажи, что ты шутишь."

# game/script.rpy:4061
translate russian exit_742c8716:

    # mc "I'm not."
    mc "Нет."

# game/script.rpy:4063
translate russian exit_3c58da68:

    # h "He trained?"
    h "Он тренировался?"

# game/script.rpy:4064
translate russian exit_fca52711_1:

    # mc "No."
    mc "Нет."

# game/script.rpy:4065
translate russian exit_c5785647:

    # h "Then why the hell is he coming?"
    h "Тогда какого чёрта он идёт с нами?"

# game/script.rpy:4067
translate russian exit_3457b068:

    # mc "Because he knows a way in."
    mc "Потому что он знает путь внутрь."

# game/script.rpy:4068
translate russian exit_3c1cd138:

    # mc "A part of the forest Richard's coordinates won't get us through."
    mc "Часть леса, через которую координаты Ричарда нас не проведут."

# game/script.rpy:4076
translate russian exit_56351196:

    # N "We'll be back before you get tired of missing me."
    N "Мы вернёмся раньше, чем ты устанешь скучать по мне."

# game/script.rpy:4220
translate russian exit_4f984fc7:

    # mc "Lora says I do this too often."
    mc "Лора говорит, что я слишком часто так делаю."

# game/script.rpy:4223
translate russian exit_5a78e9e9:

    # h "...Who's Lora?"
    h "...Кто такая Лора?"

# game/script.rpy:4224
translate russian exit_52e46b6e:

    # mc "Someone who'd probably bring you soup and lecture me for leaving you in the rain."
    mc "Та, кто, вероятно, принесла бы тебе суп и отчитала меня за то, что я оставил тебя под дождём."

# game/script.rpy:4293
translate russian exit_e50c7b73:

    # a "If we don’t do something, we’ll lose the target!"
    a "Если мы ничего не сделаем, потеряем цель!"

# game/script.rpy:4375
translate russian jungle_1d38f747:

    # h "They were watching us."
    h "Они следили за нами."

# game/script.rpy:4376
translate russian jungle_9c440d56:

    # h "Then one idiot panicked and turned it into a firefight."
    h "Потом один идиот запаниковал и превратил это в перестрелку."

# game/script.rpy:4377
translate russian jungle_5d56e671:

    # h "Why?"
    h "Почему?"

# game/script.rpy:4379
translate russian jungle_18173c7d:

    # mc "Because we got too close."
    mc "Потому что мы подошли слишком близко."

# game/script.rpy:4380
translate russian jungle_d0b4e1e9:

    # mc "Or because they couldn't afford to lose us."
    mc "Или потому что они не могли позволить себе потерять нас."

# game/script.rpy:4388
translate russian jungle_fda6f41e:

    # mc "But Olivia's right."
    mc "Но Оливия права."

# game/script.rpy:4389
translate russian jungle_f694ac67:

    # mc "That wasn't a clean hit."
    mc "Это не было чистым нападением."

# game/script.rpy:4390
translate russian jungle_00950657:

    # mc "That was surveillance gone bad."
    mc "Это была слежка, которая пошла не так."

# game/script.rpy:4417
translate russian jungle_deaf1f75:

    # N "My supervisor."
    N "Моя начальница."

# game/script.rpy:4418
translate russian jungle_e507a460:

    # N "Shiya Gray."
    N "Шия Грей."

# game/script.rpy:4420
translate russian jungle_69da11c5:

    # h "Wait."
    h "Стой."

# game/script.rpy:4421
translate russian jungle_5df131df:

    # h "Gray?"
    h "Грей?"

# game/script.rpy:4423
translate russian jungle_76b41278:

    # mc "Richard's daughter."
    mc "Дочь Ричарда."

# game/script.rpy:4424
translate russian jungle_41f53a52:

    # N "...You know her?"
    N "...Ты её знаешь?"

# game/script.rpy:4425
translate russian jungle_610e1ad0:

    # mc "Long story."
    mc "Долгая история."

# game/script.rpy:4553
translate russian jungle_b982c7d0:

    # mc "(Same silence as Al-Zahira.)"
    mc "(Та же тишина, что и в Аль-Захире.)"

# game/script.rpy:4585
translate russian jungle_c2e0153a:

    # mc "Because the coordinates only get us close."
    mc "Потому что координаты только подводят нас близко."

# game/script.rpy:4586
translate russian jungle_d9ed78fe:

    # mc "Norman knows the rest."
    mc "Остальное знает Норман."

# game/script.rpy:4587
translate russian jungle_6b8ffa93:

    # mc "And yes, I tried to talk him out of it."
    mc "И да, я пытался его отговорить."

# game/script.rpy:4588
translate russian jungle_d986505d:

    # mc "Didn't work."
    mc "Не вышло."

# game/script.rpy:4614
translate russian jungle_7c19ff96:

    # mc "He knows the old service route."
    mc "Он знает старый служебный маршрут."

# game/script.rpy:4615
translate russian jungle_6eea1693:

    # mc "The one Lora used."
    mc "Тот, которым пользовалась Лора."

# game/script.rpy:4770
translate russian junglenext_b7e04bb3:

    # mc "Because this time there was proof."
    mc "Потому что на этот раз было доказательство."

# game/script.rpy:4771
translate russian junglenext_d732b893:

    # mc "And because if I ignored it..."
    mc "И потому что если бы я это проигнорировал..."

# game/script.rpy:4772
translate russian junglenext_d2db5920:

    # mc "I'd spend whatever's left of my life wondering."
    mc "я бы всю оставшуюся жизнь гадал."

# game/script.rpy:4834
translate russian junglenext_061760bf:

    # mc "You were using my son."
    mc "Ты использовала моего сына."

# game/script.rpy:4835
translate russian junglenext_8ecad07b:

    # S "I was keeping him alive."
    S "Я сохраняла ему жизнь."

# game/script.rpy:4836
translate russian junglenext_12cb4e23:

    # S "And before you ask, yes, he was necessary."
    S "И прежде чем спросишь: да, он был необходим."

# game/script.rpy:4837
translate russian junglenext_1e0407bc:

    # S "The coordinates only bring people close."
    S "Координаты лишь подводят людей близко."

# game/script.rpy:4838
translate russian junglenext_9729b4aa:

    # S "Without Norman's memory of the old service route, you'd still be walking in circles."
    S "Без памяти Нормана о старом служебном маршруте вы бы до сих пор ходили кругами."

# game/script.rpy:4840
translate russian junglenext_34f46930:

    # S "Oh, right..."
    S "О, точно..."

# game/script.rpy:4880
translate russian junglenext_0c53c0e9:

    # S "(Whispering) So they finally pointed you at the ship."
    S "(Шёпотом) Значит, они наконец указали тебе на корабль."

# game/script.rpy:4929
translate russian spaceship_a518e7b3:

    # h "And now what, we’ve got uninvited guests from space?"
    h "И что теперь, у нас незваные гости из космоса?"

# game/script.rpy:4942
translate russian spaceship_0fbb6707:

    # ri "Three years ago, we found the ship itself."
    ri "Три года назад мы нашли сам корабль."

# game/script.rpy:4943
translate russian spaceship_d08ad9ef:

    # ri "Before that, all we had was the old facility above it."
    ri "До этого у нас был только старый объект над ним."

# game/script.rpy:4944
translate russian spaceship_9cfb1ad7:

    # ri "We thought the lab was the source."
    ri "Мы думали, что источник - лаборатория."

# game/script.rpy:4946
translate russian spaceship_0b7745ee:

    # ri "The lab was built around this."
    ri "Лабораторию построили вокруг этого."

# game/script.rpy:4947
translate russian spaceship_6405ec3b:

    # ri "But the part about you came later."
    ri "Но часть о тебе появилась позже."

# game/script.rpy:4948
translate russian spaceship_e6c4ffe2:

    # ri "Much later."
    ri "Гораздо позже."

# game/script.rpy:4949
translate russian spaceship_36e36bb3:

    # ri "The ship ignored us for years."
    ri "Корабль годами нас игнорировал."

# game/script.rpy:4950
translate russian spaceship_0c4acf06:

    # ri "Only recently did we connect its reaction to what got into your blood in Al-Zahira."
    ri "Лишь недавно мы связали его реакцию с тем, что попало в твою кровь в Аль-Захире."

# game/script.rpy:4962
translate russian spaceship_d75efcc0:

    # ri "Because you’re the only person still alive who might know anything about this."
    ri "Потому что ты единственный живой человек, который может хоть что-то об этом знать."

# game/script.rpy:4963
translate russian spaceship_a228c0ee:

    # mc "I'm not seeing the connection."
    mc "Я не вижу связи."

# game/script.rpy:4965
translate russian spaceship_0c65deb4:

    # ri "Al-Zahira. Twenty years ago."
    ri "Аль-Захира. Двадцать лет назад."

# game/script.rpy:4966
translate russian spaceship_af80ae99:

    # ri "The bastards who betrayed us were recently found dead in this forest."
    ri "Ублюдков, предавших нас, недавно нашли мёртвыми в этом лесу."

# game/script.rpy:4967
translate russian spaceship_5218139c:

    # ri "And on one of their bodies, we found a photograph of your missing wife."
    ri "И на одном из их тел мы нашли фотографию твоей пропавшей жены."

# game/script.rpy:4968
translate russian spaceship_e6629bd7:

    # mc "You said you'd taken care of them."
    mc "Ты говорил, что позаботился о них."

# game/script.rpy:4969
translate russian spaceship_d99935c6:

    # ri "I thought I had."
    ri "Я думал, что да."

# game/script.rpy:4970
translate russian spaceship_9f7833ba:

    # ri "Turns out I missed a few."
    ri "Оказалось, я упустил нескольких."

# game/script.rpy:4972
translate russian spaceship_94ca43e5:

    # mc "...Someone was watching us."
    mc "...Кто-то за нами наблюдал."

# game/script.rpy:4973
translate russian spaceship_d35f934f:

    # ri "Which means we’re not the only ones looking for you."
    ri "Значит, не только мы тебя ищем."

# game/script.rpy:4974
translate russian spaceship_65e4e4f5:

    # mc "You still haven't answered my question, Richard."
    mc "Ты всё ещё не ответил на мой вопрос, Ричард."

# game/script.rpy:4975
translate russian spaceship_21162a1b:

    # mc "I want the truth."
    mc "Я хочу правду."

# game/script.rpy:4977
translate russian spaceship_77f761b0:

    # ri "After the explosion in Al-Zahira, traces of that substance entered your bloodstream."
    ri "После взрыва в Аль-Захире следы этой субстанции попали в вашу кровь."

# game/script.rpy:4978
translate russian spaceship_76801270:

    # ri "And as we recently discovered..."
    ri "И как мы недавно выяснили..."

# game/script.rpy:4979
translate russian spaceship_089644be:

    # ri "The ship reacts to it."
    ri "Корабль реагирует на это."

# game/script.rpy:4981
translate russian spaceship_a58b86a6:

    # h "So you dragged them here because the alien coffin blinked at his blood?"
    h "Значит, ты притащил их сюда, потому что инопланетный гроб моргнул на его кровь?"

# game/script.rpy:4983
translate russian spaceship_53047dd2:

    # ri "Do you know anyone else it reacts to?"
    ri "Ты знаешь ещё кого-то, на кого он реагирует?"

# game/script.rpy:4984
translate russian spaceship_104dd4ba:

    # ri "Because I don’t."
    ri "Потому что я - нет."

# game/script.rpy:4985
translate russian spaceship_dc12f8b5:

    # ri "Either way..."
    ri "В любом случае..."

# game/script.rpy:5017
translate russian spaceship_171c53b7:

    # mc "If Lora went in there..."
    mc "Если Лора вошла туда..."

# game/script.rpy:5018
translate russian spaceship_07e0870d:

    # mc "We don't have a better option."
    mc "У нас нет варианта лучше."

# game/script.rpy:5041
translate russian spaceship_c17f3a7e:

    # mc "Richard? What about the others?"
    mc "Ричард? А остальные?"

# game/script.rpy:5042
translate russian spaceship_10187d56:

    # mc "Or... am I going in alone?"
    mc "Или... я иду один?"

# game/script.rpy:5043
translate russian spaceship_2c9371ea:

    # ri "Shiya and I are coming with you. If we can get inside..."
    ri "Мы с Шией пойдём с тобой. Если сможем попасть внутрь..."

# game/script.rpy:5044
translate russian spaceship_c49b1fb9:

    # mc "All right."
    mc "Хорошо."

# game/script.rpy:5086
translate russian spaceship_fe562749:

    # mc "That twenty years ago, we stumbled into a deal for something that came from this place?"
    mc "То есть двадцать лет назад мы наткнулись на сделку по чему-то, что пришло из этого места?"

# game/script.rpy:5089
translate russian spaceship_46732718:

    # mc "the only thing that turns up is Lora's photo."
    mc "единственное, что всплывает, - фотография Лоры."

# game/script.rpy:5090
translate russian spaceship_acec8220:

    # mc "On men who should've died twenty years ago."
    mc "У людей, которые должны были умереть двадцать лет назад."

# game/script.rpy:5107
translate russian spaceship_8ae0cdd0:

    # ri "Before that, we only knew about the old facility above it."
    ri "До этого мы знали только о старом объекте над ним."

# game/script.rpy:5108
translate russian spaceship_cdd72476:

    # ri "The ship itself stayed buried. Hidden under our noses."
    ri "Сам корабль оставался погребённым. Спрятанным у нас под носом."

# game/script.rpy:5138
translate russian spaceship_8c8919b0:

    # N "There’s a narrow passage."
    N "Там есть узкий проход."

# game/script.rpy:5172
translate russian spaceship_into_c7ad5c8e:

    # mc "Narrow entry."
    mc "Узкий вход."

# game/script.rpy:5173
translate russian spaceship_into_ee6afbce:

    # mc "Unknown drop."
    mc "Падение неизвестной глубины."

# game/script.rpy:5174
translate russian spaceship_into_a7845461:

    # mc "If something waits below, better it gets one target than all of us."
    mc "Если внизу что-то ждёт, лучше пусть получит одну цель, чем всех нас."

# game/script.rpy:5175
translate russian spaceship_into_fe4669f1:

    # h "I hate when your logic makes sense."
    h "Ненавижу, когда твоя логика имеет смысл."

# game/script.rpy:5221
