translate russian bar_olivica_27da4b9b:

    # mc "Just thought I’d stop by. See how you’ve been holding up all this time."
    mc "Решил заглянуть. Посмотреть, как ты всё это время держалась."

# game/script.rpy:2534
translate russian bar_olivica_3c2d2b30:

