# game/script.rpy:5528
translate russian shoot_89722d59:
    # mc "It started screaming."
    mc "Оно начало кричать."

# game/script.rpy:5530
translate russian shoot_7ac18067:
    # h "...Okay."
    h "...Ладно."

# game/script.rpy:5531
translate russian shoot_84081136:
    # h "Yeah."
    h "Да."

# game/script.rpy:5532
translate russian shoot_64c8b303:
    # h "I really don’t like this."
    h "Мне это очень не нравится."

# game/script.rpy:5536
translate russian shoot_9f642686:
    # mc "I’m not joking."
    mc "Я не шучу."

# game/script.rpy:5537
translate russian shoot_839407e9:
    # mc "I saw it."
    mc "Я это видел."

# game/script.rpy:5554
translate russian shoot_0faa46ad:
    # mc "Yeah…"
    mc "Да..."

# game/script.rpy:5555
translate russian shoot_1178a756:
    # mc "They used blood."
    mc "Они использовали кровь."

# game/script.rpy:5556
translate russian shoot_a16ab9bb:
    # mc "As fuel."
    mc "Как топливо."

# game/script.rpy:5557
translate russian shoot_6b4b2da9:
    # mc "The team…"
    mc "Команда..."

# game/script.rpy:5558
translate russian shoot_de8de8ab:
    # mc "They’re gone."
    mc "Их больше нет."

# game/script.rpy:5559
translate russian shoot_c8f54139:
    # mc "Fed into that thing…"
    mc "Их скормило этой штуке..."

# game/script.rpy:5560
translate russian shoot_0d0e67ad:
    # mc "A ring…"
    mc "Кольцу..."

# game/script.rpy:5561
translate russian shoot_ff7cf18c:
    # mc "Some kind of portal…"
    mc "Какому-то порталу..."

# game/script.rpy:5563
translate russian shoot_60ebaaf6:
    # mc "I think…"
    mc "Я думаю..."

# game/script.rpy:5564
translate russian shoot_d53dad9d:
    # mc "I don’t even know anymore."
    mc "Я уже сам не знаю."

# game/script.rpy:5569
translate russian shoot_47b4f486:
    # ri "Blood…?"
    ri "Кровь...?"

# game/script.rpy:5570
translate russian shoot_8aae21be:
    # ri "As fuel…?"
    ri "Как топливо...?"

# game/script.rpy:5595
translate russian spaceship_door_519f2ceb:
    # h "Why’d you freeze?"
    h "Чего застыл?"

# game/script.rpy:5596
translate russian spaceship_door_f882d124:
    # h "You see something?"
    h "Что-то видишь?"

# game/script.rpy:5598
translate russian spaceship_door_cf1adef2:
    # mc "Yeah."
    mc "Да."

# game/script.rpy:5599
translate russian spaceship_door_539fce37:
    # mc "Up ahead."
    mc "Впереди."

# game/script.rpy:5600
translate russian spaceship_door_a738fa7c:
    # mc "That thing…"
    mc "Та штука..."

# game/script.rpy:5601
translate russian spaceship_door_e0d3842e:
    # mc "We’re not walking into it blind."
    mc "Мы не пойдём туда вслепую."

# game/script.rpy:5602
translate russian spaceship_door_a6872da4:
    # h "Yeah, that’s reason enough to stop."
    h "Да, тут я тебя понимаю."

# game/script.rpy:5603
translate russian spaceship_door_a9491183:
    # h "So what’s the play?"
    h "И какой план?"

# game/script.rpy:5604
translate russian spaceship_door_6ffcd384:
    # mc "Thinking."
    mc "Думаю."

# game/script.rpy:5606
translate russian spaceship_door_cbb521bc:
    # mc "We need a way past."
    mc "Нам нужно пройти мимо."

# game/script.rpy:5607
translate russian spaceship_door_2467555d:
    # mc "No noise. No mess."
    mc "Без шума. Без лишней грязи."

# game/script.rpy:5609
translate russian spaceship_door_063c313a:
    # h "We could try sneaking."
    h "Можно попробовать прокрасться."

# game/script.rpy:5610
translate russian spaceship_door_56fdf956:
    # h "Risky as hell, but doable if we keep it clean."
    h "Риск адский, но если сработаем чисто - прокатит."

# game/script.rpy:5612
translate russian spaceship_door_2bb82634:
    # mc "That’s a gamble."
    mc "Это игра ва-банк."

# game/script.rpy:5613
translate russian spaceship_door_4c87d75c:
    # mc "If it’s automated — one mistake and we’re dead."
    mc "Если оно автоматическое - одна ошибка, и мы мёртвы."

# game/script.rpy:5614
translate russian spaceship_door_f44add22:
    # mc "I need better than ‘maybe’."
    mc "Мне нужно что-то надёжнее, чем «может быть»."

# game/script.rpy:5618
translate russian spaceship_door_fbba889c:
    # h "Honestly?"
    h "Честно?"

# game/script.rpy:5619
translate russian spaceship_door_3c451c25:
    # h "Best idea I’ve heard all day."
    h "Лучшая идея за весь день."

# game/script.rpy:5621
translate russian spaceship_door_9425884e:
    # mc "Unless you’ve got a warhead in your pocket, we’re outgunned."
    mc "Если у тебя в кармане нет боеголовки, мы тут без шансов."

# game/script.rpy:5626
translate russian spaceship_door_29878d4c:
    # S "C4."
    S "C4."

# game/script.rpy:5627
translate russian spaceship_door_7d320da1:
    # S "If we place it right… it’ll take it down."
    S "Если правильно заложить... оно его снесёт."

# game/script.rpy:5629
translate russian spaceship_door_eb25214c:
    # h "...Okay, that might actually work."
    h "...Ладно, это может сработать."

# game/script.rpy:5630
translate russian spaceship_door_67aec647:
    # h "But where the hell did you get that?"
    h "Но где ты, чёрт возьми, это взяла?"

# game/script.rpy:5636
translate russian spaceship_door_347625f9:
    # h "...Right."
    h "...Ладно."

# game/script.rpy:5650
translate russian spaceship_door_bc98ef97:
    # h "Yeah, I think we can safely rule out ‘not dangerous’."
    h "Да, думаю, вариант «не опасно» можно смело вычеркивать."

# game/script.rpy:5651
translate russian spaceship_door_688506de:
    # h "Richard’s out there running field tests with his face."
    h "Ричард там проводит полевые испытания своим лицом."

# game/script.rpy:5698
translate russian spaceship_door_73b8bfc3:
    # mc "You’ve lost your mind."
    mc "Ты с ума сошёл."

# game/script.rpy:5699
translate russian spaceship_door_b730793d:
    # mc "That thing’s not friendly."
    mc "Эта штука не дружелюбная."

# game/script.rpy:5706
translate russian spaceship_door_491968b0:
    # mc "I don’t like this."
    mc "Мне это не нравится."

# game/script.rpy:5707
translate russian spaceship_door_53a5d8ff:
    # mc "Not even a little."
    mc "Совсем."

# game/script.rpy:5725
translate russian spaceship_door_a43031ba:
    # r "Commander, do you read me?"
    r "Командир, вы меня слышите?"

# game/script.rpy:5728
translate russian spaceship_door_6ac04b99:
    # r "We're under attack. Armed hostiles."
    r "Мы под атакой. Вооружённые противники."

# game/script.rpy:5751
translate russian spaceship_door_44e1cac8:
    # h "So what—"
    h "И что-"

# game/script.rpy:5752
translate russian spaceship_door_cc31502c:
    # h "they ditched us, or we ditched them?"
    h "они бросили нас или мы бросили их?"

# game/script.rpy:5753
translate russian spaceship_door_e8ac66a3:
    # h "…Eh."
    h "...Эх."

# game/script.rpy:5754
translate russian spaceship_door_3c7cf872:
    # h "Same difference."
    h "Разницы никакой."

# game/script.rpy:5771
translate russian spaceship_door_9595e8d0:
    # h "...Okay, tell me I’m not seeing things."
    h "...Ладно, скажи, что мне не мерещится."

# game/script.rpy:5772
translate russian spaceship_door_ed19c04f:
    # h "That thing just followed them, right?"
    h "Эта штука сейчас пошла за ними, да?"

# game/script.rpy:5774
translate russian spaceship_door_e12a2200:
    # mc "You saw it right."
    mc "Ты всё правильно увидела."

# game/script.rpy:5775
translate russian spaceship_door_ded71177:
    # mc "And it’s with them."
    mc "И она с ними."

# game/script.rpy:5782
translate russian spaceship_door_6651ab87:
    # mc "Alright."
    mc "Ладно."

# game/script.rpy:5783
translate russian spaceship_door_e31cb2e9:
    # mc "We’re not waiting for the next disaster."
    mc "Мы не будем ждать следующей катастрофы."

# game/script.rpy:5784
translate russian spaceship_door_2562ad6f:
    # mc "Move."
    mc "Вперёд."

# game/script.rpy:5787
translate russian spaceship_door_db957387:
    # h "So what now?"
    h "И что теперь?"

# game/script.rpy:5788
translate russian spaceship_door_ca8e6f89:
    # h "We just stand here and stare at it until it opens itself?"
    h "Будем стоять и пялиться, пока она сама не откроется?"

# game/script.rpy:5790
translate russian spaceship_door_ef89ebe2:
    # mc "Tempting."
    mc "Заманчиво."

# game/script.rpy:5791
translate russian spaceship_door_bcaa161b:
    # mc "Still gotta open it."
    mc "Но открыть всё равно придётся."

# game/script.rpy:5792
translate russian spaceship_door_d0a7e435:
    # mc "No shortcuts."
    mc "Без коротких путей."

# game/script.rpy:5794
translate russian spaceship_door_30e866ec:
    # mc "Norman."
    mc "Норман."

# game/script.rpy:5795
translate russian spaceship_door_bb8e4a24:
    # mc "You’ve been quiet."
    mc "Ты притих."

# game/script.rpy:5796
translate russian spaceship_door_3ee32121:
    # mc "You good?"
    mc "Ты в порядке?"

# game/script.rpy:5798
translate russian spaceship_door_21fe90ca:
    # N "Yeah… I’m good."
    N "Да... я в порядке."

# game/script.rpy:5803
translate russian spaceship_door_e313e08c:
    # mc "Since when?"
    mc "С каких пор?"

# game/script.rpy:5809
translate russian spaceship_door_42daceb6:
    # N "I don’t know, Dad… I just, can’t place it."
    N "Не знаю, пап... я просто не могу понять, откуда это."

# game/script.rpy:5811
translate russian spaceship_door_2fd558b9:
    # h "Hey, Norman…"
    h "Эй, Норман..."

# game/script.rpy:5812
translate russian spaceship_door_b0c25c5b:
    # h "You even know how to shoot?"
    h "Ты вообще стрелять умеешь?"

# game/script.rpy:5814
translate russian spaceship_door_10ebb560:
    # h "Then stay behind me."
    h "Тогда держись за мной."

# game/script.rpy:5815
translate russian spaceship_door_48d4a94f:
    # h "If things go south— I’ve got you."
    h "Если всё пойдёт к чёрту - я тебя прикрою."

# game/script.rpy:5819
translate russian spaceship_door_be92834c:
    # h "Oh, I’m ready."
    h "О, я готова."

# game/script.rpy:5821
translate russian spaceship_door_d3e5fe51:
    # N "I’ll keep up. I won’t slow you down."
    N "Я не отстану. Не буду вас тормозить."

# game/script.rpy:5823
translate russian spaceship_door_6651ab87_1:
    # mc "Alright."
    mc "Ладно."

# game/script.rpy:5824
translate russian spaceship_door_ed237b7a:
    # mc "Stay sharp."
    mc "Будьте начеку."

# game/script.rpy:5825
translate russian spaceship_door_a6adc98a:
    # mc "Let’s move."
    mc "Двигаемся."

# game/script.rpy:5842
translate russian endoftheporolgue_2b35b6fe:
    # mc "..."
    mc "..."

# game/script.rpy:5844
translate russian endoftheporolgue_e16431b4:
    # mc "(…What the hell is that.)"
    mc "(...Что это, чёрт возьми.)"

# game/script.rpy:5845
translate russian endoftheporolgue_ad54824b:
    # mc "...That’s not natural."
    mc "...Это неестественно."

# game/script.rpy:5848
translate russian endoftheporolgue_00eeb9d3:
    # h "…Well."
    h "...Ну."

# game/script.rpy:5849
translate russian endoftheporolgue_4b9a1f51:
    # h "A floating black hole."
    h "Парящая чёрная дыра."

# game/script.rpy:5850
translate russian endoftheporolgue_aab18d43:
    # h "Yeah, that wasn’t on my list for today."
    h "Да, такого в моём списке на сегодня не было."

# game/script.rpy:5853
translate russian endoftheporolgue_dfd517f6:
    # N "No… that’s not possible."
    N "Нет... это невозможно."

# game/script.rpy:5854
translate russian endoftheporolgue_11579870:
    # N "What is that thing doing here?"
    N "Что эта штука здесь делает?"

# game/script.rpy:5856
translate russian endoftheporolgue_30e866ec:
    # mc "Norman."
    mc "Норман."

# game/script.rpy:5857
translate russian endoftheporolgue_7b8c6fbb:
    # mc "You recognize it?"
    mc "Ты её узнаёшь?"

# game/script.rpy:5859
translate russian endoftheporolgue_bba56ce0:
    # N "Dad… that’s what Mom was working on."
    N "Пап... это то, над чем работала мама."

# game/script.rpy:5861
translate russian endoftheporolgue_143e66ae:
    # N "It’s a warp drive."
    N "Это варп-двигатель."

# game/script.rpy:5866
translate russian endoftheporolgue_2865e349:
    # az "Don’t worry… you’re not leaving. Not until I say so."
    az "Не волнуйтесь... вы не уйдёте. Пока я не позволю."

# game/script.rpy:5867
translate russian endoftheporolgue_5a39664c:
    # az "My dear… {b}friends{/b}."
    az "Мои дорогие... {b}друзья{/b}."

# game/script.rpy:5868
translate russian endoftheporolgue_fcfcc7fb:
    # az "No… not friends."
    az "Нет... не друзья."

# game/script.rpy:5870
translate russian endoftheporolgue_a8d4185e:
    # az "...Or are you?"
    az "...Или всё-таки?"

# game/script.rpy:5872
translate russian endoftheporolgue_99e0e335:
    # az "Twenty years…"
    az "Двадцать лет..."

# game/script.rpy:5873
translate russian endoftheporolgue_72f8c56d:
    # az "Twenty long… stretching… years."
    az "Двадцать долгих... тянущихся... лет."

# game/script.rpy:5874
translate russian endoftheporolgue_5278223d:
    # az "And now you’re standing here. In front of me."
    az "И теперь вы стоите здесь. Передо мной."

# game/script.rpy:5875
translate russian endoftheporolgue_c086db0c:
    # az "But why…? Your faces… why can’t I see them?"
    az "Но почему...? Ваши лица... почему я их не вижу?"

# game/script.rpy:5876
translate russian endoftheporolgue_7481e565:
    # az "Only… fire."
    az "Только... огонь."

# game/script.rpy:5877
translate russian endoftheporolgue_7e47e3c3:
    # az "Fire… No—no, no, no—!"
    az "Огонь... Нет, нет, нет, нет-!"

# game/script.rpy:5878
translate russian endoftheporolgue_cc9b9cc8:
    # az "It hurts…"
    az "Больно..."

# game/script.rpy:5881
translate russian endoftheporolgue_33c4b48f:
    # h "(quietly) ...He’s not right in the head."
    h "(тихо) ...У него крыша поехала."

# game/script.rpy:5882
translate russian endoftheporolgue_aae967fd:
    # h "You were dead."
    h "Ты был мёртв."

# game/script.rpy:5883
translate russian endoftheporolgue_72181ea8:
    # h "So how the hell are you standing here?"
    h "Так какого чёрта ты стоишь здесь?"

# game/script.rpy:5887
translate russian endoftheporolgue_dfa57093:
    # az "Was I?"
    az "Правда?"

# game/script.rpy:5888
translate russian endoftheporolgue_b6016148:
    # az "I don’t remember."
    az "Я не помню."

# game/script.rpy:5891
translate russian endoftheporolgue_bf696e47:
    # az "Did they kill me…?"
    az "Они убили меня...?"

# game/script.rpy:5892
translate russian endoftheporolgue_b0b43f88:
    # az "No…?"
    az "Нет...?"

# game/script.rpy:5893
translate russian endoftheporolgue_5ebb1eb1:
    # az "Then why am I here…"
    az "Тогда почему я здесь..."

# game/script.rpy:5894
translate russian endoftheporolgue_c665c33f:
    # az "Because of them."
    az "Из-за них."

# game/script.rpy:5895
translate russian endoftheporolgue_54d55287:
    # az "Yes… THEM."
    az "Да... ИЗ-ЗА НИХ."

# game/script.rpy:5896
translate russian endoftheporolgue_4dab5791:
    # az "But why… why…"
    az "Но почему... почему..."

# game/script.rpy:5898
translate russian endoftheporolgue_02723237:
    # az "Ah—!"
    az "А-а-!"

# game/script.rpy:5899
translate russian endoftheporolgue_cc574a3a:
    # az "I remember—yes, yes— it was y—"
    az "Я помню - да, да - это был т-"

# game/script.rpy:5900
translate russian endoftheporolgue_1a615e60:
    # az "No."
    az "Нет."

# game/script.rpy:5901
translate russian endoftheporolgue_c9d4f8cf:
    # az "I remember perfectly."
    az "Я помню всё идеально."

# game/script.rpy:5902
translate russian endoftheporolgue_0f0eba51:
    # az "You pulled the trigger."
    az "Ты нажал на спуск."

# game/script.rpy:5912
translate russian endoftheporolgue_ebaf266d:
    # mc "(Is he... actually dead?)"
    mc "(Он... правда мёртв?)"

# game/script.rpy:5916
translate russian endoftheporolgue_a8f1ee0c:
    # npc "Substance capable of regenerating even human organs."
    npc "Вещество, способное регенерировать даже человеческие органы."

# game/script.rpy:5919
translate russian endoftheporolgue_e7a6cc89:
    # mc "(Может ли...)"
    mc "(Может ли...)"

# game/script.rpy:5920
translate russian endoftheporolgue_2b35b6fe_1:
    # mc "..."
    mc "..."

# game/script.rpy:5921
translate russian endoftheporolgue_cb8146d7:
    # mc "Olivia, careful. He's not dead yet."
    mc "Оливия, осторожно. Он ещё не мёртв."

# game/script.rpy:5924
translate russian endoftheporolgue_ec666712:
    # h "...Not?"
    h "...Не мёртв?"

# game/script.rpy:5925
translate russian endoftheporolgue_90b1f04f:
    # h "I just put a bullet in his head."
    h "Я только что всадила ему пулю в голову."

# game/script.rpy:5926
translate russian endoftheporolgue_46697ac3:
    # h "What do you mean ‘not’?"
    h "Что значит «не мёртв»?"

# game/script.rpy:5928
translate russian endoftheporolgue_4ce0c4a6:
    # N "Dad’s right, he’s not dead!"
    N "Папа прав, он не мёртв!"

# game/script.rpy:5930
translate russian endoftheporolgue_752f5464:
    # h "Oh come on—"
    h "Да ладно-"

# game/script.rpy:5931
translate russian endoftheporolgue_e20c3689:
    # h "You’re telling me that thing’s still alive?"
    h "Хочешь сказать, эта штука всё ещё жива?"

# game/script.rpy:5933
translate russian endoftheporolgue_58f02eaf:
    # N "The substance... He absorbed it."
    N "Вещество... Он его впитал."

# game/script.rpy:5934
translate russian endoftheporolgue_10da554a:
    # N "After that, he stopped being human."
    N "После этого он перестал быть человеком."

# game/script.rpy:5938
translate russian endoftheporolgue_52f01cf2:
    # az "A human?"
    az "Человек?"

# game/script.rpy:5939
translate russian endoftheporolgue_c4e19673:
    # az "No… no, I am human."
    az "Нет... нет, я человек."

# game/script.rpy:5940
translate russian endoftheporolgue_ae32f8c4:
    # az "Still human."
    az "Всё ещё человек."

# game/script.rpy:5943
translate russian endoftheporolgue_4fb790d9:
    # az "Just… different."
    az "Просто... другой."

# game/script.rpy:5944
translate russian endoftheporolgue_e85cec24:
    # az "A little… rearranged."
    az "Немного... перекроенный."

# game/script.rpy:5947
translate russian endoftheporolgue_02723237_1:
    # az "Ah—!"
    az "А-а-!"

# game/script.rpy:5948
translate russian endoftheporolgue_6c79e7bf:
    # az "That hurts…"
    az "Это больно..."

# game/script.rpy:5949
translate russian endoftheporolgue_625c0599:
    # az "Hurts-hurts-hurts…"
    az "Больно-больно-больно..."

# game/script.rpy:5954
translate russian endoftheporolgue_b8c4dfa3:
    # az "What?"
    az "Что?"

# game/script.rpy:5955
translate russian endoftheporolgue_62718c4d:
    # az "I told you, human!"
    az "Я же сказал: человек!"

# game/script.rpy:5956
translate russian endoftheporolgue_3cdfe01e:
    # az "Just… slightly… modified."
    az "Просто... слегка... изменённый."

# game/script.rpy:5957
translate russian endoftheporolgue_07c81b4b:
    # az "Improved, maybe."
    az "Улучшенный. Возможно."

# game/script.rpy:5960
translate russian endoftheporolgue_9c23bcfe:
    # az "I was like you once. Weak. Afraid. Small."
    az "Когда-то я был таким же, как вы. Слабым. Испуганным. Ничтожным."

# game/script.rpy:5961
translate russian endoftheporolgue_4c69f50a:
    # az "Waiting to die."
    az "Ждал смерти."

# game/script.rpy:5962
translate russian endoftheporolgue_d05c74f3:
    # az "But death…"
    az "Но смерть..."

# game/script.rpy:5963
translate russian endoftheporolgue_f7530d7a:
    # az "...death doesn’t end things."
    az "...смерть ничего не заканчивает."

# game/script.rpy:5964
translate russian endoftheporolgue_dc6b3f31:
    # az "It bends them."
    az "Она выворачивает."

# game/script.rpy:5965
translate russian endoftheporolgue_110b0344:
    # az "Breaks them."
    az "Ломает."

# game/script.rpy:5968
translate russian endoftheporolgue_6b2884d2:
    # az "My daughter…"
    az "Моя дочь..."

# game/script.rpy:5969
translate russian endoftheporolgue_e1a5d86b:
    # az "Poor thing. Loyal to the end."
    az "Бедняжка. Верная до конца."

# game/script.rpy:5970
translate russian endoftheporolgue_276d2cf1:
    # az "She made a deal."
    az "Она заключила сделку."

# game/script.rpy:5971
translate russian endoftheporolgue_38f6d22c:
    # az "With a woman… strange… wrong."
    az "С женщиной... странной... неправильной."

# game/script.rpy:5972
translate russian endoftheporolgue_2b96ddc7:
    # az "They told her: ‘We can bring him back.’"
    az "Они сказали ей: «Мы можем вернуть его»."

# game/script.rpy:5973
translate russian endoftheporolgue_a23b7389:
    # az "And she—"
    az "И она-"

# game/script.rpy:5974
translate russian endoftheporolgue_f2701477:
    # az "—she said yes."
    az "- она согласилась."

# game/script.rpy:5976
translate russian endoftheporolgue_85ab310a:
    # az "And now I’m here."
    az "И теперь я здесь."

# game/script.rpy:5977
translate russian endoftheporolgue_40b612fd:
    # az "See? Not so bad."
    az "Видите? Не так уж плохо."

# game/script.rpy:5978
translate russian endoftheporolgue_119ab016:
    # az "We could even be friends."
    az "Мы даже могли бы быть друзьями."

# game/script.rpy:5979
translate russian endoftheporolgue_112fb39f:
    # az "…Right?"
    az "...Правда?"

# game/script.rpy:5982
translate russian endoftheporolgue_437e0729:
    # az "No… no."
    az "Нет... нет."

# game/script.rpy:5983
translate russian endoftheporolgue_00803a43:
    # az "No-no—NO."
    az "Нет-нет... НЕТ."

# game/script.rpy:5985
translate russian endoftheporolgue_d6034643:
    # az "You killed me."
    az "Ты убил меня."

# game/script.rpy:5986
translate russian endoftheporolgue_b742281c:
    # az "That day."
    az "В тот день."

# game/script.rpy:5998
translate russian endoftheporolgue_20326694:
    # az "And since then—"
    az "И с тех пор-"

# game/script.rpy:6000
translate russian endoftheporolgue_d022674a:
    # az "I shut my eyes—"
    az "Я закрываю глаза-"

# game/script.rpy:6001
translate russian endoftheporolgue_86013249:
    # az "—and there you are."
    az "- и там ты."

# game/script.rpy:6003
translate russian endoftheporolgue_bf3f40a1:
    # az "You didn’t hesitate."
    az "Ты даже не дрогнул."

# game/script.rpy:6004
translate russian endoftheporolgue_60f19e0b:
    # az "That’s what I admire."
    az "Вот это я в тебе и уважаю."

# game/script.rpy:6011
translate russian endoftheporolgue_4b0cc7cf:
    # mc "(…The masked guy?)"
    mc "(...Тот парень в маске?)"

# game/script.rpy:6013
translate russian endoftheporolgue_ff64f5ca:
    # a "Stay out of this, little man. He’s mine to deal with."
    a "Не лезь, маленький человек. С ним разберусь я."

# game/script.rpy:6015
translate russian endoftheporolgue_bf0aed50:
    # az "That’s not what we agreed on."
    az "Мы договаривались не так."

# game/script.rpy:6017
translate russian endoftheporolgue_3a4d0af0:
    # a "That man’s body… must be kept alive."
    a "Тело этого человека... должно выжить."

# game/script.rpy:6020
translate russian endoftheporolgue_05496c8b:
    # a "This is the will… of the woman who created me."
    a "Такова воля... женщины, которая меня создала."

# game/script.rpy:6024
translate russian endoftheporolgue_dae2c354:
    # az "No…"
    az "Нет..."

# game/script.rpy:6025
translate russian endoftheporolgue_bca6dad4:
    # az "I want to watch."
    az "Я хочу смотреть."

# game/script.rpy:6031
translate russian endoftheporolgue_53a86359:
    # az "You’re… irritating."
    az "Ты... раздражаешь меня."

# game/script.rpy:6036
translate russian endoftheporolgue_09110022:
    # h "Out—!"
    h "Пусто-!"

# game/script.rpy:6037
translate russian endoftheporolgue_2f725a00:
    # h "Out of ammo, cover me!"
    h "Патроны кончились, прикрой меня!"

# game/script.rpy:6045
translate russian endoftheporolgue_7df2eaf1:
    # h "Don’t rush me—!"
    h "Не подгоняй-!"

# game/script.rpy:6046
translate russian endoftheporolgue_f78eab3a:
    # h "I’m on it!"
    h "Я этим занимаюсь!"

# game/script.rpy:6058
translate russian endoftheporolgue_4a6a6d7f:
    # mc "(Tough…)"
    mc "(Крепкая...)"

# game/script.rpy:6059
translate russian endoftheporolgue_6c66d910:
    # mc "(Feels like hitting steel.)"
    mc "(Будто бью по стали.)"

# game/script.rpy:6060
translate russian endoftheporolgue_8033231f:
    # mc "So you’re the one pulling the strings."
    mc "Значит, это ты дёргаешь за ниточки."

# game/script.rpy:6061
translate russian endoftheporolgue_3102bdab:
    # a "Pulling… strings?"
    a "Дёргаю... за ниточки?"

# game/script.rpy:6062
translate russian endoftheporolgue_52854cf2:
    # a "I do not understand. Explain, little man."
    a "Я не понимаю. Объясни, маленький человек."

# game/script.rpy:6073
translate russian endoftheporolgue_15ae44d8:
    # mc "(…Wrong target?)"
    mc "(...Не та цель?)"

# game/script.rpy:6084
translate russian endoftheporolgue_df0b2b78:
    # az "Two against one?"
    az "Двое против одного?"

# game/script.rpy:6085
translate russian endoftheporolgue_be371e7f:
    # az "Mm."
    az "Мм."

# game/script.rpy:6086
translate russian endoftheporolgue_40b85edd:
    # az "How… disappointing."
    az "Как... досадно."

# game/script.rpy:6114
translate russian endoftheporolgue_444bb49e:
    # a "Honestly, I didn’t expect the little man to last this long."
    a "Честно говоря, я не ожидала, что маленький человек продержится так долго."

# game/script.rpy:6117
translate russian endoftheporolgue_d8a442f2:
    # h "Hold on—!"
    h "Держись-!"

# game/script.rpy:6119
translate russian endoftheporolgue_7114bbb8:
    # az "You’re all running out of time."
    az "У вас у всех заканчивается время."

# game/script.rpy:6120
translate russian endoftheporolgue_438b8f93:
    # az "You just don’t know it yet."
    az "Вы просто ещё этого не знаете."

# game/script.rpy:6123
translate russian endoftheporolgue_7b4a75f0:
    # az "No matter."
    az "Неважно."

# game/script.rpy:6124
translate russian endoftheporolgue_d9bddc01:
    # az "Give him my regards…"
    az "Передайте ему привет..."

# game/script.rpy:6135
translate russian endoftheporolgue_a5e8f827:
    # aaa "Miriel… thirty seconds."
    aaa "Мириэль... тридцать секунд."

# game/script.rpy:6136
translate russian endoftheporolgue_de21089d:
    # aaa "Small ones are mine."
    aaa "Мелкие - мои."

# game/script.rpy:6137
translate russian endoftheporolgue_11afc3fe:
    # aaa "The big one… yours."
    aaa "Большая... твоя."

# game/script.rpy:6138
translate russian endoftheporolgue_8b5c72f0:
    # Mi "…Understood."
    Mi "...Поняла."

# game/script.rpy:6163
translate russian endoftheporolgue_491bd79b:
    # Mi "Don’t worry… you’re facing me now."
    Mi "Не волнуйся... теперь твой противник - я."

# game/script.rpy:6174
translate russian endoftheporolgue_7ce3fcd2:
    # Mi "…I don’t have time for you."
    Mi "...У меня нет на тебя времени."

# game/script.rpy:6177
translate russian endoftheporolgue_56b1b113:
    # h "[mc]…!"
    h "[mc]...!"

# game/script.rpy:6178
translate russian endoftheporolgue_2f47fd71:
    # h "Hey—!"
    h "Эй-!"

# game/script.rpy:6180
translate russian endoftheporolgue_c44180d5:
    # h "Stay with me…"
    h "Не отключайся..."

# game/script.rpy:6181
translate russian endoftheporolgue_17f13727:
    # h "Come on… stay with me."
    h "Ну же... держись."

# game/script.rpy:6183
translate russian endoftheporolgue_8c07114f:
    # aaa "Well?"
    aaa "Ну?"

# game/script.rpy:6184
translate russian endoftheporolgue_fa396ea3:
    # aaa "What do you see."
    aaa "Что ты видишь."

# game/script.rpy:6186
translate russian endoftheporolgue_9c397e3d:
    # Mi "…The lady’s words don’t add up."
    Mi "...Слова той женщины не сходятся."

# game/script.rpy:6187
translate russian endoftheporolgue_c2b87514:
    # Mi "The gate… reacted to the boy."
    Mi "Врата... отреагировали на мальчика."

# game/script.rpy:6189
translate russian endoftheporolgue_ef9f9c3a:
    # h "Help’s coming."
    h "Помощь уже идёт."

# game/script.rpy:6190
translate russian endoftheporolgue_29c67eee:
    # h "You hear me?"
    h "Ты слышишь?"

# game/script.rpy:6191
translate russian endoftheporolgue_743fa6f5:
    # h "They’re coming— they’ll fix this."
    h "Они идут - они всё исправят."

# game/script.rpy:6193
translate russian endoftheporolgue_9a052dd0:
    # h "You promised me."
    h "Ты обещал мне."

# game/script.rpy:6196
translate russian endoftheporolgue_2b28c5e6:
    # h "So don’t you dare die on me now."
    h "Так что не смей сейчас умирать у меня на руках."

# game/script.rpy:6197
translate russian endoftheporolgue_49f97e85:
    # h "Not like this…"
    h "Не так..."

# game/script.rpy:6198
translate russian endoftheporolgue_c24f3046:
    # h "Not here…"
    h "Не здесь..."

# game/script.rpy:6200
translate russian endoftheporolgue_d3063e7b:
    # aaa "Take both. The girl doesn’t see the portal."
    aaa "Забери обоих. Девушка не видит портал."

# game/script.rpy:6201
translate russian endoftheporolgue_e078c3c5:
    # aaa "Her mind… won’t survive it."
    aaa "Её разум... не выдержит."

# game/script.rpy:6203
translate russian endoftheporolgue_de226845:
    # Mi "I’ll secure them… and catch up."
    Mi "Я выведу их в безопасное место... и догоню."

# game/script.rpy:6207
translate russian endoftheporolgue_5c2905ac:
    # aaa "A gate…"
    aaa "Врата..."

# game/script.rpy:6208
translate russian endoftheporolgue_a06789a3:
    # aaa "Time displacement."
    aaa "Временное смещение."

# game/script.rpy:6210
translate russian endoftheporolgue_4bf7b0a5:
    # aaa "So this is it."
    aaa "Вот оно."

# game/script.rpy:6211
translate russian endoftheporolgue_6dad4c95:
    # aaa "The source of the chaos."
    aaa "Источник хаоса."

# game/script.rpy:6219
translate russian endoftheporolgue_a4ac5554:
    # aaa "…What—"
    aaa "...Что-"

# game/script.rpy:6221
translate russian endoftheporolgue_a90cb9d3:
    # aaa "No…"
    aaa "Нет..."

# game/script.rpy:6222
translate russian endoftheporolgue_0203571f:
    # aaa "That presence…"
    aaa "Это присутствие..."

# game/script.rpy:6224
translate russian endoftheporolgue_c6950a3d:
    # Mi "Master… what’s happening?"
    Mi "Господин... что происходит?"

# game/script.rpy:6227
translate russian endoftheporolgue_851c9b31:
    # aaa "The boy. The girl."
    aaa "Мальчик. Девочка."

# game/script.rpy:6228
translate russian endoftheporolgue_7d89ff18:
    # aaa "Take them."
    aaa "Забери их."

# game/script.rpy:6229
translate russian endoftheporolgue_fbd68180:
    # aaa "We leave. Now."
    aaa "Мы уходим. Сейчас."

# game/script.rpy:6231
translate russian endoftheporolgue_62ce2899:
    # Mi "Understood. I’ll handle it."
    Mi "Поняла. Я разберусь."

# game/script.rpy:6239
translate russian endoftheporolgue_6d7acdec:
    # Mi "…I’ll take care of it."
    Mi "...Я позабочусь об этом."

# game/script.rpy:6241
translate russian endoftheporolgue_52d8969d:
    # aaa "This will be enough."
    aaa "Этого хватит."

# game/script.rpy:6242
translate russian endoftheporolgue_e18d8335:
    # aaa "To slow them."
    aaa "Чтобы их задержать."

# game/script.rpy:6259
translate russian endoftheporolgue_aaa7ea2f:
    # aaaaa "Steal what is mine… right under my gaze?"
    aaaaa "Украсть моё... прямо у меня на глазах?"

# game/script.rpy:6260
translate russian endoftheporolgue_ce7c6006:
    # aaaaa "...Astoria."
    aaaaa "...Астория."

# game/script.rpy:6262
translate russian endoftheporolgue_afd3bff3:
    # aaaaa "Some things… never change."
    aaaaa "Некоторые вещи... никогда не меняются."

# game/script.rpy:6264
translate russian endoftheporolgue_d9e7baef:
    # aaaaa "Use their body."
    aaaaa "Используй их тело."

# game/script.rpy:6265
translate russian endoftheporolgue_05270ce5:
    # aaaaa "We’re going to pay… our old friends a visit."
    aaaaa "Мы нанесём визит... нашим старым друзьям."

translate russian strings:

    # game/script.rpy:171
    old "My name: (Default Kael)"
    new "Меня зовут: (По умолчанию - Каэль)"

    old "Veira"
    new "Вейра"

    old "Evrelia"
    new "Эврелия"

    old "Gorem"
    new "Горэм"

    old "Third"
    new "Третий"

    old "Elf"
    new "Эльфийка"

    old "Ketrin"
    new "Кэтрин"

