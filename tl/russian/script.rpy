    mc "(Пора позвать остальных.)"

# game/script.rpy:5342
translate russian meets11_8871aba2:

    # mc "Found bodies."
    mc "Нашёл тела."

# game/script.rpy:5343
translate russian meets11_021c8ea2:

    # mc "Old. And dead."
    mc "Старые. И мёртвые."

# game/script.rpy:5367
translate russian meets11_7a067387:

    # ri "There has to be a control node somewhere."
    ri "Где-то должен быть управляющий узел."

# game/script.rpy:5368
translate russian meets11_87ec980e:

    # ri "A recorder. A map. Anything that tells us what happened here."
    ri "Запись. Карта. Что угодно, что расскажет, что здесь произошло."

# game/script.rpy:5434
translate russian door_space_ship_e12fef4c:

    # mc "Richard said it reacted to me."
    mc "Ричард сказал, он реагировал на меня."

# game/script.rpy:5436
translate russian door_space_ship_9005039c:

    # h "Please tell me you're not about to touch the alien door."
    h "Пожалуйста, скажи, что ты не собираешься трогать инопланетную дверь."

# game/script.rpy:5437
translate russian door_space_ship_51e0f73b:

    # mc "I'm about to touch the alien door."
    mc "Я собираюсь тронуть инопланетную дверь."

# game/script.rpy:5438
translate russian door_space_ship_6a90b573:

    # mc "—!"
    mc "—!"

# game/script.rpy:5439
translate russian door_space_ship_2b69d468:

    # h "And nothing."
    h "И ничего."

# game/script.rpy:5440
translate russian door_space_ship_ad4814bb:

    # S "Reacted doesn't mean obeyed."
    S "Реагировать не значит подчиняться."

# game/script.rpy:5441
translate russian door_space_ship_0c6fda89:

    # S "If Dad's theory is right, you've got traces in your system."
    S "Если теория отца верна, в твоём организме есть следы."

# game/script.rpy:5442
translate russian door_space_ship_c865916a:

    # S "Enough for the ship to notice you."
    S "Достаточно, чтобы корабль тебя заметил."

# game/script.rpy:5443
translate russian door_space_ship_34cf8a13:

    # S "Not enough to open every damn lock."
    S "Недостаточно, чтобы открыть каждый чёртов замок."

# game/script.rpy:5445
translate russian door_space_ship_903b433a:

    # S "So we still need the opener. If luck’s on our side, we can get inside."
    S "Так что нам всё ещё нужен открыватель. Если удача на нашей стороне, мы сможем попасть внутрь."

# game/script.rpy:5455
translate russian door_space_ship_1f9c42b0:

    # mc "(A opener… of course.)"
    mc "(Открыватель... конечно.)"

# game/script.rpy:5475
translate russian path_front_next2_2e043a84:

    # mc "(Without a opener, I’m tied up...)"
    mc "(Без открывателя я связан по рукам...)"

# game/script.rpy:5501
translate russian path_front_next2_9957c902:

    # mc "Grab the opener and get out."
    mc "Хватай открыватель и уходи."

# game/script.rpy:5509
translate russian path_front_next2_720c3b32:

    # mc "(Don't think.)"
    mc "(Не думай.)"

# game/script.rpy:5510
translate russian path_front_next2_473c72fe:

    # mc "(Shoot.)"
    mc "(Стреляй.)"

# game/script.rpy:5528
translate russian shoot_0ef1b83d:

    # mc "(Did I imagine it, or did that corpse just... come back to life?)"
    mc "(Мне показалось, или этот труп только что... ожил?)"

# game/script.rpy:5533
translate russian shoot_cbf3059e:

    # mc "(The Opener... Did it cause this?)"
    mc "(Открыватель... Это он вызвал?)"

# game/script.rpy:5539
translate russian shoot_0f7550d4:

    # mc "(I need to warn the others.)"
    mc "(Нужно предупредить остальных.)"

# game/script.rpy:5543
translate russian shoot_26873912:

    # mc "(If I call them, they'll come. No questions asked.)"
    mc "(Если я позову их, они придут. Без лишних вопросов.)"

# game/script.rpy:5544
translate russian shoot_d58b3230:

    # mc "(But what if it's dangerous?)"
    mc "(Но что, если это опасно?)"

# game/script.rpy:5545
translate russian shoot_a1c63749:

    # mc "(Can't risk their lives... Better I go alone.)"
    mc "(Нельзя рисковать их жизнями... Лучше пойду один.)"

# game/script.rpy:5555
translate russian shoot_233a29e8:

    # mc "(That stench...)"
    mc "(Этот запах...)"

# game/script.rpy:5572
translate russian shoot_f56bc7ff:

    # mc "(Looks... human.)"
    mc "(Похоже... на человека.)"

# game/script.rpy:5573
translate russian shoot_6e9fd508:

    # mc "(So someone from the old lab made it this far.)"
    mc "(Значит, кто-то из старой лаборатории добрался так далеко.)"

# game/script.rpy:5580
translate russian shoot_d61fee2b:

    # mc "(Heavy distortion.)"
    mc "(Сильные помехи.)"

# game/script.rpy:5581
translate russian shoot_e31e1752:

    # mc "(Female voice.)"
    mc "(Женский голос.)"

# game/script.rpy:5582
translate russian shoot_7c2ba095:

    # mc "(Familiar...?)"
    mc "(Знакомый...?)"

# game/script.rpy:5591
translate russian shoot_9be8aec8:

    # a "We stabilized the substance today."
    a "Сегодня мы стабилизировали субстанцию."

# game/script.rpy:5595
translate russian shoot_2dd9befb:

    # a "The properties of this substance are…"
    a "Свойства этой субстанции..."

# game/script.rpy:5597
translate russian shoot_fe6ed374:

    # mc "(No...)"
    mc "(Нет...)"

# game/script.rpy:5598
translate russian shoot_457ef512:

    # mc "(That cadence.)"
    mc "(Эта интонация.)"

# game/script.rpy:5599
translate russian shoot_737c6cdb:

    # mc "(I know that voice.)"
    mc "(Я знаю этот голос.)"

# game/script.rpy:5689
translate russian shoot_4e6f4ed5_2:

    # mc "Wait…"
    mc "Постой..."

# game/script.rpy:5690
translate russian shoot_16411555:

    # mc "(No.)"
    mc "(Нет.)"

# game/script.rpy:5691
translate russian shoot_69c085be:

    # mc "(Lora?)"
    mc "(Лора?)"

# game/script.rpy:5762
translate russian shoot_9c3fcb80:

    # mc "It opens something."
    mc "Он что-то открывает."

# game/script.rpy:5763
translate russian shoot_0701f667:

    # mc "A passage, maybe."
    mc "Возможно, проход."

# game/script.rpy:5764
translate russian shoot_e6dc6b77:

    # mc "A portal— I don't know."
    mc "Портал... не знаю."

# game/script.rpy:5786
translate russian shoot_a7899af6:

    # mc "It was in my hand."
    mc "Он был у меня в руке."

# game/script.rpy:5787
translate russian shoot_a7835d0b:

    # mc "I know it was."
    mc "Я знаю, что был."

# game/script.rpy:5849
translate russian shoot_db2f7ead:

    # ri "That matches the readings."
    ri "Это совпадает с показаниями."

# game/script.rpy:5850
translate russian shoot_8212dc02:

    # ri "Not the method. God, not the method..."
    ri "Не метод. Господи, только не метод..."

# game/script.rpy:5927
translate russian spaceship_door_c21f9010:

    # ri "It reacts to posture."
    ri "Он реагирует на позу."

# game/script.rpy:5928
translate russian spaceship_door_d647f76f:

    # ri "Weapons up threat."
    ri "Оружие поднято - угроза."

# game/script.rpy:5929
translate russian spaceship_door_4aedfed4:

    # ri "Hands down passage."
    ri "Руки опущены - проход."

# game/script.rpy:5930
translate russian spaceship_door_be2c7a2d:

    # ri "At least, that's how it worked last time."
    ri "По крайней мере, в прошлый раз это сработало так."

# game/script.rpy:6008
translate russian spaceship_door_7e9c9b7f:

    # S "(Interference dropped.)"
    S "(Помехи снизились.)"

# game/script.rpy:6009
translate russian spaceship_door_33c48490:

    # S "(Whatever that thing opened, it cleared a channel.)"
    S "(Что бы эта штука ни открыла, она расчистила канал.)"

# game/script.rpy:6032
translate russian spaceship_door_e77d9789:

    # S "We’ll hold them off. You move ahead."
    S "Мы их задержим. Ты иди дальше."

# game/script.rpy:6033
translate russian spaceship_door_dedfb59d:

    # S "If they reach this corridor, we're trapped."
    S "Если они доберутся до этого коридора, мы окажемся в ловушке."

# game/script.rpy:6034
translate russian spaceship_door_31f5639f:

    # S "You keep moving. We'll hold the choke point."
    S "Продолжай идти. Мы удержим узкое место."

# game/script.rpy:6088
translate russian spaceship_door_8898e72d:

    # N "Not here exactly."
    N "Не совсем здесь."

# game/script.rpy:6089
translate russian spaceship_door_bb7360ff:

    # N "Just... the sound."
    N "Просто... звук."

# game/script.rpy:6090
translate russian spaceship_door_c45a1235:

    # N "The air."
    N "Воздух."

# game/script.rpy:6091
translate russian spaceship_door_ca4a4cd6:

    # N "Like the place Mom took me."
    N "Как место, куда мама меня водила."

# game/script.rpy:6153
translate russian endoftheporolgue_0ed487b7:

    # N "Mom called it..."
    N "Мама называла это..."

# game/script.rpy:6154
translate russian endoftheporolgue_de7b42f6:

    # N "A warp drive."
    N "Варп-двигатель."

# game/script.rpy:6155
translate russian endoftheporolgue_20e94d49:

    # N "But this one..."
    N "Но этот..."

# game/script.rpy:6156
translate russian endoftheporolgue_5fddfe20:

    # N "This is bigger than the prototype."
    N "Это больше прототипа."

# game/script.rpy:6214
translate russian endoftheporolgue_5361eda5:

    # mc "(Could it...?)"
    mc "(Может ли это...?)"

# game/script.rpy:6228
translate russian endoftheporolgue_99e684e1:

    # N "Mom's notes mentioned it."
    N "В маминых записях он упоминался."

# game/script.rpy:6229
translate russian endoftheporolgue_73eb4687:

    # N "The substance doesn't just heal."
    N "Субстанция не просто исцеляет."

# game/script.rpy:6230
translate russian endoftheporolgue_ee9eaad7:

    # N "It rewrites the host."
    N "Он переписывает носителя."

# game/script.rpy:6309
translate russian endoftheporolgue_457e9beb:

    # mc "How did you get in here?"
    mc "Как ты сюда попал?"

# game/script.rpy:6310
translate russian endoftheporolgue_5ca9acaa:

    # az "You opened the way."
    az "Ты открыл путь."

# game/script.rpy:6311
translate russian endoftheporolgue_62f8a118:

    # az "All we had to do... was follow."
    az "Всё, что нам оставалось... последовать за тобой."

# game/script.rpy:6322
translate russian endoftheporolgue_e7625bf6:

    # aa "Sir, why send him personally? We could've taken the target at the entrance."
    aa "Сэр, зачем отправлять его лично? Мы могли взять цель у входа."

# game/script.rpy:6487
translate russian endoftheporolgue_3c83fc06:

    # Mi "The portal… reacted to the older one."
    Mi "Портал... отреагировал на старшего."

# game/script.rpy:6507
translate russian endoftheporolgue_2089f160:

    # aaa "A portal…"
    aaa "Портал..."

# game/script.rpy:6523
translate russian endoftheporolgue_41c2cf0d:

    # aaa "Selvaria..."
    aaa "Сельвария..."

