    # L "I know."
    L "Я знаю."

# game/script.rpy:2088
translate russian homedinner_8509c81e:

    # L "I would never bring you here if I had another choice."
    L "Я бы никогда не привела тебя сюда, если бы у меня был другой выбор."

# game/script.rpy:2091
