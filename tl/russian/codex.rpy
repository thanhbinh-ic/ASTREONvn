    # game/codex.rpy:841
    old "#1 - Representative"
    new "{font=tl/russian/fonts/CCUltimatum-Bold.ttf}#1 - Представитель"

    # game/codex.rpy:843
    old "The official leader and face of the Confederation, serving as the highest authority in political and diplomatic affairs."
    new "{font=tl/russian/fonts/CCUltimatum-Bold.ttf}Официальный лидер и лицо Конфедерации, выступающий в качестве высшего органа власти в политических и дипломатических вопросах."

    # game/codex.rpy:845
    old "Duties:"
    new "{font=tl/russian/fonts/CCUltimatum-Bold.ttf}Обязанности:"

    # game/codex.rpy:847
    old "Oversees the execution of laws and policies across the Confederation."
