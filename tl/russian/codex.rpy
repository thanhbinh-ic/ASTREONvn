    old "Article: BLOOD OF THE ANCIENTS"
    new "Статья: КРОВЬ ДРЕВНИХ"

    # game/codex.rpy:2377
    old "Status: Absolutely Restricted"
    new "Статус: Доступ полностью ограничен"

