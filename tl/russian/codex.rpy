    old "temporary extreme amplification of the host’s energy potential;"
    new "временное экстремальное усиление энергетического потенциала носителя;"

    # game/codex.rpy:2410
    old "initiation of irreversible mutational processes."
    new "инициирование необратимых мутационных процессов."

    # game/codex.rpy:2412
