    # game/codex.rpy:2340
    old "the origin of multiple galactic anomalies;"
    new "источник множественных галактических аномалий;"

    # game/codex.rpy:2341
    old "a documented example of civilization-ending ambition;"
    new "задокументированный пример амбиций, приведших к гибели цивилизации;"

    # game/codex.rpy:2342
