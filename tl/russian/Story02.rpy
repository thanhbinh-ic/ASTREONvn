translate russian akt2chapter5_810b7471:

    # k "Are we gonna do something about this or...?"
    k "Мы будем с этим что-то делать или...?"

# game/Story02.rpy:2865
translate russian akt2chapter5_fcd2896a:

    # Mi "No. Let’s leave it for now. Won’t hurt her."
    Mi "Нет. Давай пока оставим это. Ей это не повредит."

