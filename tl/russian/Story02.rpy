translate russian akt2chapter5_c23a9b14:

    # Mi "...yes."
    Mi "...да."

# game/Story02.rpy:3328
translate russian akt2chapter5_99921d04:

    # Mi "…You took your time."
    Mi "...Ты не торопилась."

