    # a "..."
    a "..."

# game/Story02.rpy:2840
translate russian akt2chapter5_60d5c7a0:

    # a "Didn’t know there were still people in the galaxy who don’t know my name."
    a "Не знала, что в галактике ещё есть люди, которые не знают моего имени."

