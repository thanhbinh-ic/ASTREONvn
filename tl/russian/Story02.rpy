translate russian akt2chapter5_9d25b4d7:

    # h "Idol?"
    h "Айдол?"

# game/Story02.rpy:3351
translate russian akt2chapter5_e64b1bae:

    # Mi "…It’s a long story."
    Mi "...Это долгая история."

