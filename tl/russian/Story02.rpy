    # Mi "I agree with you."
    Mi "Здесь я с тобой согласна."

# game/Story02.rpy:968
translate russian akt2chapter2_4e4f4808:

    # Mi "But sometimes, compromise is the better option."
    Mi "Но иногда компромисс является лучшим вариантом."

