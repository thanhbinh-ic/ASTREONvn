translate russian akt2chapter5_92d5ce57:

    # aS "So confident... Hope that confidence doesn’t vanish when you see him again."
    aS "Столько уверенности... Надеюсь, она не испарится, когда ты снова его увидишь."

# game/Story02.rpy:3170
translate russian akt2chapter5_1a932e7d:

    # k "Well, well, well…"
    k "Ну-ну-ну..."

# game/Story02.rpy:3185
translate russian akt2chapter5_1de37104:

    # mc "Broken dreams…?"
    mc "Разбитые мечты...?"

# game/Story02.rpy:3195
translate russian akt2chapter5_12ad8184:

    # h "What? Just thinking out loud."
    h "Что? Я просто вслух думаю."

# game/Story02.rpy:3197
translate russian akt2chapter5_12bf8617:

    # k "Listen carefully, shorty."
    k "Слушай внимательно, коротышка."

