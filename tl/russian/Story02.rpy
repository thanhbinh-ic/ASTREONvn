translate russian akt2chapter5_cf58861a:

    # aS "So confident as always. Hope that confidence doesn’t vanish when you see him again."
    aS "Как всегда уверена в себе. Надеюсь, эта уверенность не исчезнет, когда ты снова его увидишь."

# game/Story02.rpy:2856
translate russian akt2chapter5_ea14dc1a:

    # h "Aren’t you just adorable... Where’d you come from, sweetheart?"
    h "Ты просто милашка... Откуда ты, милая?"

# game/Story02.rpy:2858
translate russian akt2chapter5_4d919f46:

    # aS "Oh my God, who the hell are you?!"
    aS "О боже, ты ещё кто такая?!"

