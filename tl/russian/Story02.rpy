translate russian akt2chapter5_e2b8921d:

    # aS "Aisha. One and only. The greatest idol in the galaxy."
    aS "Айша. Единственная и неповторимая. Лучший айдол в галактике."

# game/Story02.rpy:2844
translate russian akt2chapter5_f3e62073:

    # k "You mean {b}former{/b} idol."
    k "Ты хотела сказать {b}бывший{/b} айдол."

