translate russian akt2chapter5_1b6c688c:

    # h "Wow… look who found her voice."
    h "Ого... смотрите, у кого голос прорезался."

# game/Story02.rpy:3213
translate russian akt2chapter5_17469ecf:

    # mc "Easier? Yeah. Maybe."
    mc "Проще? Да. Возможно."

