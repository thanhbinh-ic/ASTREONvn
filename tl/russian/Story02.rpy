translate russian akt2chapter5_50a41482:

    # mc "(Wait… rain?)"
    mc "(Постой... дождь?)"

# game/Story02.rpy:3309
translate russian akt2chapter5_8c79851f:

    # mc "(We’re underground. Where’s it coming from?)"
    mc "(Мы под землей. Откуда он берется?)"

# game/Story02.rpy:3312
translate russian akt2chapter5_2b35b6fe_3:

    # mc "..."
    mc "..."

# game/Story02.rpy:3322
translate russian akt2chapter5_7199a5cc:

    # a "What a tragedy… Such a pretty face-"
    a "Какая трагедия... такое хорошенькое личико..."

