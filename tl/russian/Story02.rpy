translate russian akt2chapter5_989989fc:

    # Mi "Well, here we are. But who knew we’d need access to get in..."
    Mi "Что ж, вот мы и здесь. Но кто бы мог подумать, что нам понадобится доступ, чтобы войти..."

# game/Story02.rpy:2766
translate russian akt2chapter5_433c93f4:

    # k "That girl... {w=0.5}Instead of doing her damn job and setting things up properly..."
