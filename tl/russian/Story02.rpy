    # k "Screw you..."
    k "Пошла ты..."

# game/Story02.rpy:2784
translate russian akt2chapter5_e3f38bbc:

    # mc "(Starting to see why some people might prefer this place over the surface.)"
    mc "(Начинаю понимать, почему некоторые люди предпочитают это место поверхности.)"

