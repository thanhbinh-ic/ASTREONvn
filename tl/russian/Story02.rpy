    # mc "We’re all human."
    mc "Мы все люди."

# game/Story02.rpy:2774
translate russian akt2chapter4_d5470623:

    # k "Making excuses, old man."
    k "Оправдываешься, старик."

# game/Story02.rpy:2776
translate russian akt2chapter4_686abf87:

    # h "Morning, sunshine."
    h "Доброе утро, солнышко."

# game/Story02.rpy:2777
translate russian akt2chapter4_a6ff6069:

    # h "Finally awake? Hope you enjoyed your nap."
    h "Наконец проснулся? Надеюсь, сон был приятным."

# game/Story02.rpy:2779
translate russian akt2chapter4_4905c740:

    # mc "…You hurt?"
    mc "...Ты ранена?"

# game/Story02.rpy:2784
translate russian akt2chapter4_d02f6d7a:

    # k "Cute."
    k "Мило."

# game/Story02.rpy:2787
translate russian akt2chapter4_1f4cd412:

    # k "Try worrying about yourself first."
    k "Попробуй сперва о себе побеспокоиться."

# game/Story02.rpy:2790
translate russian akt2chapter4_84ee1dea:

    # Mi "…Having fun?"
    Mi "...Развлекаетесь?"

# game/Story02.rpy:2791
translate russian akt2chapter4_cc53e855:

    # k "Got room for one more."
    k "Место еще для одной найдется."

# game/Story02.rpy:2792
translate russian akt2chapter4_e904a7cd:

    # k "If you’re feeling brave."
    k "Если хватит смелости."

# game/Story02.rpy:2794
translate russian akt2chapter4_b4d3c579:

    # Mi "N-no thanks."
    Mi "Н-нет, спасибо."

# game/Story02.rpy:2796
translate russian akt2chapter4_44731cb1:

    # mc "Mir."
    mc "Мир."

# game/Story02.rpy:2797
translate russian akt2chapter4_5e7b220b:

    # mc "What about Ostorius?"
    mc "Что с Осториусом?"

# game/Story02.rpy:2801
translate russian akt2chapter4_41e22af2:

    # Mi "…He headed east."
    Mi "...Он ушел на восток."

# game/Story02.rpy:2802
translate russian akt2chapter4_b0517e6f:

    # Mi "Said something came up."
    Mi "Сказал, что появились срочные дела."

# game/Story02.rpy:2804
translate russian akt2chapter4_100a2bcd:

    # k "He’s got a habit of leaving people behind."
    k "У него есть привычка бросать людей позади."

# game/Story02.rpy:2805
translate russian akt2chapter4_b6870fce:

    # k "…Then again."
    k "...Хотя."

# game/Story02.rpy:2806
translate russian akt2chapter4_4b3309e4:

    # k "So do most of you."
    k "У большинства из вас она тоже есть."

# game/Story02.rpy:2809
translate russian akt2chapter4_a68398b6:

    # h "Got a problem?"
    h "Есть претензии?"

# game/Story02.rpy:2810
translate russian akt2chapter4_b678cff4:

    # k "Hm."
    k "Хм."

# game/Story02.rpy:2811
translate russian akt2chapter4_c3b40072:

    # k "Yeah."
    k "Есть."

# game/Story02.rpy:2812
translate russian akt2chapter4_0fa5903a:

    # k "And what are you going to do about it?"
    k "И что ты с этим сделаешь?"

# game/Story02.rpy:2813
translate russian akt2chapter4_b7b21034:

    # h "...Nothing."
    h "...Ничего."

# game/Story02.rpy:2817
translate russian akt2chapter4_ba201647:

    # k "Funny. {w=0.5}Your face says otherwise."
    k "Забавно. {w=0.5}Твое лицо говорит обратное."

# game/Story02.rpy:2819
translate russian akt2chapter4_b9c47a64:

    # h "I don’t like you."
    h "Ты мне не нравишься."

# game/Story02.rpy:2820
translate russian akt2chapter4_65696d9d:

    # h "But for his sake… I’ll tolerate you."
    h "Но ради него... я тебя потерплю."

# game/Story02.rpy:2822
translate russian akt2chapter4_dcd86e92:

    # k "Oh?"
    k "О?"

# game/Story02.rpy:2823
translate russian akt2chapter4_8782f7f3:

    # k "I’m honored."
    k "Какая честь."

# game/Story02.rpy:2829
translate russian akt2chapter4_6917a82e:

    # k "Alright."
    k "Ладно."

# game/Story02.rpy:2832
translate russian akt2chapter4_9e2d3eb5:

    # k "What’s the plan?"
    k "Какой план?"

# game/Story02.rpy:2834
translate russian akt2chapter4_75817c20:

    # Mi "…[mc]?"
    Mi "...[mc]?"

# game/Story02.rpy:2837
translate russian akt2chapter4_1d6ce146:

    # mc "Blue Moon. Sector 6."
    mc "Голубая луна. Сектор 6."

# game/Story02.rpy:2838
translate russian akt2chapter4_60e321f8:

    # mc "Meet Flora. Get her on our side. Figure out what the hell’s going on."
    mc "Найти Флору. Перетянуть ее на нашу сторону. Понять, что здесь вообще происходит."

# game/Story02.rpy:2840
translate russian akt2chapter4_684b7af6:

    # k "You’ve got guts, old man."
    k "Кишка у тебя не тонка, старик."

# game/Story02.rpy:2843
translate russian akt2chapter4_f5c5fae1:

    # k "(You’ll see.)"
    k "(Сам увидишь.)"

# game/Story02.rpy:2845
translate russian akt2chapter4_739af0c1:

    # k "(Call it a surprise.)"
    k "(Считай это сюрпризом.)"

# game/Story02.rpy:2848
translate russian akt2chapter4_0de1b446:

    # k "Hey, shorty."
    k "Эй, коротышка."

# game/Story02.rpy:2849
translate russian akt2chapter4_7495f152:

    # k "Temporary truce?"
    k "Временное перемирие?"

# game/Story02.rpy:2851
translate russian akt2chapter4_ebac5e46:

    # k "At least until this mess settles."
    k "Хотя бы пока вся эта дрянь не уляжется."

# game/Story02.rpy:2852
translate russian akt2chapter4_843215c2:

    # k "What do you say?"
    k "Что скажешь?"

# game/Story02.rpy:2853
translate russian akt2chapter4_91766d23:

    # h "Doesn’t mean I trust you."
    h "Это не значит, что я тебе доверяю."

# game/Story02.rpy:2858
translate russian akt2chapter4_9d5a6ddf:

    # k "Whatever you say, shorty."
    k "Как скажешь, коротышка."

# game/Story02.rpy:2861
translate russian akt2chapter4_ac579582:

    # k "I’ll leave you two alone."
    k "Оставлю вас двоих наедине."

# game/Story02.rpy:2862
translate russian akt2chapter4_8c9bec23:

    # k "Try not to die."
    k "Постарайтесь не умереть."

# game/Story02.rpy:2864
translate russian akt2chapter4_3eb6c693:

    # h "Finally… some space."
    h "Наконец-то... можно выдохнуть."

# game/Story02.rpy:2867
translate russian akt2chapter4_1314bfa4:

    # h "Hey… mind if I just…"
    h "Слушай... можно я просто..."

# game/Story02.rpy:2873
translate russian akt2chapter4_1b031bf6:

    # mc "Yeah. It’s cold, but it’s fine."
    mc "Да. Холодно, но нормально."

# game/Story02.rpy:2876
translate russian akt2chapter4_ef4c6b39:

    # h "Eh, not a big deal."
    h "Да ладно, ничего страшного."

# game/Story02.rpy:2878
translate russian akt2chapter4_73d05893:

    # mc "...You okay?"
    mc "...Ты в порядке?"

# game/Story02.rpy:2882
translate russian akt2chapter4_546bb74f:

    # h "…Not really."
    h "...Не особо."

# game/Story02.rpy:2883
translate russian akt2chapter4_8fc2b132:

    # h "We’re about to see Lora and…"
    h "Мы вот-вот увидим Лору, и..."

# game/Story02.rpy:2885
translate russian akt2chapter4_0af34ecd:

    # mc "You’re nervous."
    mc "Ты нервничаешь."

# game/Story02.rpy:2887
translate russian akt2chapter4_149a9d97:

    # h "You’re not?"
    h "А ты нет?"

# game/Story02.rpy:2889
translate russian akt2chapter4_d6baff5f:

    # mc "Remember?"
    mc "Помнишь?"

# game/Story02.rpy:2893
translate russian akt2chapter4_8aab296b:

    # mc "When we handed you the warehouse."
    mc "Когда мы передали тебе склад."

# game/Story02.rpy:2894
translate russian akt2chapter4_f0f50e58:

    # mc "What were you feeling?"
    mc "Что ты тогда чувствовала?"

# game/Story02.rpy:2896
translate russian akt2chapter4_fe9c2d4a:

    # h "I was a mess, to put it lightly."
    h "Мягко говоря, меня трясло."

# game/Story02.rpy:2898
translate russian akt2chapter4_87599aed:

    # mc "And what did Lora say back then?"
    mc "И что тогда сказала Лора?"

# game/Story02.rpy:2900
translate russian akt2chapter4_798e7765:

    # h "If I start worrying… I…"
    h "Если я начну переживать... я..."

# game/Story02.rpy:2904
translate russian akt2chapter4_85c182d8:

    # mc "Doesn’t change the outcome."
    mc "Это не изменит исход."

# game/Story02.rpy:2906
translate russian akt2chapter4_a3543490:

    # h "That’s… not exactly comforting."
    h "Это... не особо утешает."

# game/Story02.rpy:2908
translate russian akt2chapter4_ec243024:

    # mc "It’s not supposed to."
    mc "И не должно."

# game/Story02.rpy:2910
translate russian akt2chapter4_869a52e4:

    # h "…And your point is?"
    h "...И к чему ты?"

# game/Story02.rpy:2912
translate russian akt2chapter4_88f16ec9:

    # mc "...So don’t let it control you."
    mc "...К тому, что не дай этому управлять тобой."

# game/Story02.rpy:2914
translate russian akt2chapter4_cf9c9f72:

    # h "That’s not the same. Not even close."
    h "Это вообще не одно и то же. Даже близко нет."

# game/Story02.rpy:2917
translate russian akt2chapter4_a3669ba7:

    # Mi "…You done resting?"
    Mi "...Вы уже отдохнули?"

# game/Story02.rpy:2922
translate russian akt2chapter4_87f4dbdd:

    # k "Your uniform, old man."
    k "Твоя форма, старик."

# game/Story02.rpy:2924
translate russian akt2chapter4_e4c0c4b1:

    # Mi "They… don’t take kindly to it."
    Mi "Они... плохо к ней отнесутся."

# game/Story02.rpy:2926
translate russian akt2chapter4_6ec9790d:

    # k "Kindly?"
    k "Плохо?"

# game/Story02.rpy:2927
translate russian akt2chapter4_cb8f73a3:

    # k "…Please."
    k "...Да брось."

# game/Story02.rpy:2928
translate russian akt2chapter4_7b946266:

    # k "They’ll tear you apart the moment they get the chance."
    k "Они разорвут тебя на части при первой же возможности."

# game/Story02.rpy:2930
translate russian akt2chapter4_ef2f0419:

    # k "To them… we’re worse than monsters."
    k "Для них... мы хуже чудовищ."

# game/Story02.rpy:2935
translate russian akt2chapter4_f2b660ec:

    # h "Well… that’s reassuring."
    h "Ну... это успокаивает."

# game/Story02.rpy:2939
translate russian akt2chapter4_78bc329f:

    # Mi "So we should…"
    Mi "Значит, нам следует..."

# game/Story02.rpy:2942
translate russian akt2chapter4_3f2dd5ed:

    # h "Then we stay."
    h "Тогда остаемся."

# game/Story02.rpy:2946
translate russian akt2chapter4_cf1adef2:

    # mc "Yeah."
    mc "Да."

# game/Story02.rpy:2948
translate russian akt2chapter4_c30a2c76:

    # k "Can’t wait to hear the story?"
    k "Так не терпится услышать историю?"

# game/Story02.rpy:2949
translate russian akt2chapter4_5ac323e4:

    # k "About how we butchered half a city?"
    k "О том, как мы вырезали полгорода?"

# game/Story02.rpy:2952
translate russian akt2chapter4_fb43015c:

    # mc "Then say it."
    mc "Тогда скажи."

# game/Story02.rpy:2953
translate russian akt2chapter4_7c5bca36:

    # mc "You’re not walking away from this without an answer."
    mc "Без ответа ты от этого не уйдешь."

# game/Story02.rpy:2956
translate russian akt2chapter4_dbd62e0f:

    # k "And you ran-"
    k "А ты тогда сбе..."

# game/Story02.rpy:2957
translate russian akt2chapter4_675dfef5:

    # mc "Back then, yeah."
    mc "Тогда да."

# game/Story02.rpy:2958
translate russian akt2chapter4_d14b1cea:

    # mc "Now you talk."
    mc "Теперь говоришь ты."

# game/Story02.rpy:2961
translate russian akt2chapter4_6926df41:

    # k "Watch your to-"
    k "Следи за то..."

# game/Story02.rpy:2963
translate russian akt2chapter4_6b2eda57:

    # mc "Why don’t you want to go back there?"
    mc "Почему ты не хочешь туда возвращаться?"

# game/Story02.rpy:2964
translate russian akt2chapter4_faa1ac42:

    # mc "Every time it comes up, you shut down."
    mc "Каждый раз, когда речь заходит об этом месте, ты закрываешься."

# game/Story02.rpy:2968
translate russian akt2chapter4_327ee225:

    # k "Oh, look who-"
    k "О, посмотрите, кто..."

# game/Story02.rpy:2970
translate russian akt2chapter4_71a06277:

    # mc "Mir. Say it."
    mc "Мир. Скажи."

# game/Story02.rpy:2972
translate russian akt2chapter4_0700c98a:

    # Mi "She…"
    Mi "Она..."

# game/Story02.rpy:2975
translate russian akt2chapter4_6bde73a1:

    # h "Knowing them—"
    h "Зная их..."

# game/Story02.rpy:2977
translate russian akt2chapter4_331809ce_1:

    # mc "Liv."
    mc "Лив."

# game/Story02.rpy:2978
translate russian akt2chapter4_485237e2:

    # h "Do you even hear yourself right now?"
    h "Ты вообще слышишь, что сейчас говоришь?"

# game/Story02.rpy:2980
translate russian akt2chapter4_70ce71e1:

    # mc "Not now."
    mc "Не сейчас."

# game/Story02.rpy:2982
translate russian akt2chapter4_fdf4cc37:

    # mc "Talk."
    mc "Говори."

# game/Story02.rpy:2984
translate russian akt2chapter4_991f0524:

    # k "You want a story?"
    k "Хочешь историю?"

# game/Story02.rpy:2987
translate russian akt2chapter4_2a5dc2bb:

    # k "Fine."
    k "Ладно."

# game/Story02.rpy:3006
translate russian akt2chapter4_0eefda61:

    # k "(We had one order.)"
    k "(У нас был один приказ.)"

# game/Story02.rpy:3007
translate russian akt2chapter4_cf15f649:

    # k "(Clear Sectors Seven and Six.)"
    k "(Зачистить Секторы семь и шесть.)"

# game/Story02.rpy:3010
translate russian akt2chapter4_c52c3b4e:

    # k "(Everything alive.)"
    k "(Все живое.)"

# game/Story02.rpy:3011
translate russian akt2chapter4_77951032:

    # k "(No exceptions.)"
    k "(Без исключений.)"

# game/Story02.rpy:3013
translate russian akt2chapter4_814350fd:

    # a "Please… have mercy…"
    a "Пожалуйста... сжальтесь..."

# game/Story02.rpy:3014
translate russian akt2chapter4_49a9cace:

    # k "(...)"
    k "(...)"

# game/Story02.rpy:3025
translate russian akt2chapter4_05f46703:

    # k "…They remember."
    k "...Они помнят."

# game/Story02.rpy:3031
translate russian akt2chapter4_48c351d9:

    # k "…They won’t forget."
    k "...Они не забудут."

# game/Story02.rpy:3033
translate russian akt2chapter4_75f652cc:

    # mc "So be it."
    mc "Значит, так тому и быть."

# game/Story02.rpy:3039
translate russian akt2chapter4_7622ba8a:

    # k "We’re not going there."
    k "Мы туда не пойдем."

# game/Story02.rpy:3041
translate russian akt2chapter4_52271bca:

    # mc "...We are."
    mc "...Пойдем."

# game/Story02.rpy:3045
translate russian akt2chapter4_471848f1:

    # k "…You’re an idiot."
    k "...Ты идиот."

# game/Story02.rpy:3054
translate russian akt2chapter4_426b45dd:

    # Mi "(whisper) ...there."
    Mi "(шепотом) ...там."

# game/Story02.rpy:3055
translate russian akt2chapter4_ef74e6fe:

    # Mi "[mc]… we’re ready to move."
    Mi "[mc]... мы готовы двигаться."

# game/Story02.rpy:3058
translate russian akt2chapter4_2562ad6f_1:

    # mc "Move."
    mc "Идем."

# game/Story02.rpy:3064
translate russian akt2chapter4_fff3dd31:

    # h "Wait, what is this 'Lower Town' exactly?"
    h "Подожди, что вообще такое этот «Нижний город»?"

# game/Story02.rpy:3067
translate russian akt2chapter4_90616a30:

    # h "I thought that was just a figure of speech..."
    h "Я думала, это просто образное выражение..."

# game/Story02.rpy:3070
translate russian akt2chapter4_a900515a:

    # k "Up here, you’ve got the poor."
    k "Здесь, наверху, живут бедные."

# game/Story02.rpy:3071
translate russian akt2chapter4_b303fc9c:

    # k "Down there?"
    k "А внизу?"

# game/Story02.rpy:3072
translate russian akt2chapter4_6ccd3e1c:

    # k "The ones who never even had a chance."
    k "Те, у кого вообще никогда не было шанса."

# game/Story02.rpy:3074
translate russian akt2chapter4_31e333ee:

    # k "If you were born in Lower Town, you die in Lower Town."
    k "Родился в Нижнем городе, значит, там же и умрешь."

# game/Story02.rpy:3076
translate russian akt2chapter4_97808530:

    # h "And you want us to go down there?"
    h "И ты хочешь, чтобы мы туда спустились?"

# game/Story02.rpy:3078
translate russian akt2chapter4_9a9a1016:

    # k "Me? No. The old man? Yeah."
    k "Я? Нет. Старик? Да."

# game/Story02.rpy:3079
translate russian akt2chapter4_4d535be0:

    # mc "We’re not here sightseeing."
    mc "Мы не на экскурсии."

# game/Story02.rpy:3081
translate russian akt2chapter4_f9149dc9:

    # h "You know what..."
    h "Знаешь что..."

# game/Story02.rpy:3082
translate russian akt2chapter4_9955e79a:

    # h "If it’s really that bad, maybe we just don’t go."
    h "Если там правда все так плохо, может, просто не пойдем."

# game/Story02.rpy:3085
translate russian akt2chapter4_d0c168de:

    # mc "You both, enough."
    mc "Вы обе, хватит."

# game/Story02.rpy:3087
translate russian akt2chapter4_ac88ce93:

    # mc "We’re going down."
    mc "Мы спускаемся."

# game/Story02.rpy:3088
translate russian akt2chapter4_768a5031:

    # mc "Or did you forget why we’re here?"
    mc "Или вы забыли, зачем мы здесь?"

# game/Story02.rpy:3090
translate russian akt2chapter4_10f0efed:

    # Mi "…The meeting with Emberlin?"
    Mi "...Встреча с Эмберлин?"

# game/Story02.rpy:3091
translate russian akt2chapter4_716019b8:

    # mc "Right."
    mc "Верно."

# game/Story02.rpy:3094
translate russian akt2chapter4_54aa351d:

    # mc "If we stayed up top, we’d be dead already."
    mc "Останься мы наверху, нас бы уже убили."

# game/Story02.rpy:3095
translate russian akt2chapter4_0e4a133a:

    # mc "Down there… at least we’ve got a shot to talk."
    mc "Внизу... у нас хотя бы есть шанс поговорить."

# game/Story02.rpy:3099
translate russian akt2chapter4_724be5fb:

    # Mi "(whispering) …I’m not sure."
    Mi "(шепотом) ...Я не уверена."

# game/Story02.rpy:3100
translate russian akt2chapter4_7c136244:

    # mc "Because of the uniform?"
    mc "Из-за формы?"

# game/Story02.rpy:3101
translate russian akt2chapter4_f1a1b640:

    # Mi "…Yeah."
    Mi "...Да."

# game/Story02.rpy:3103
translate russian akt2chapter4_a154b9e3:

    # h "Even Mir’s not sure."
    h "Даже Мир не уверена."

# game/Story02.rpy:3104
translate russian akt2chapter4_8a319f6b:

    # h "What kind of place is this Lower Town anyway...?"
    h "Что это вообще за место такое, этот Нижний город...?"

# game/Story02.rpy:3105
translate russian akt2chapter4_96e45bc2:

    # Mi "…Home."
    Mi "...Дом."

# game/Story02.rpy:3106
translate russian akt2chapter4_e0bfd693:

    # k "You have no idea, where you’re going."
    k "Ты понятия не имеешь, куда идешь."

# game/Story02.rpy:3110
