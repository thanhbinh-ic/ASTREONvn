translate russian akt2chapter5_152e2393:

    # Mi "…If we’d been on time-"
    Mi "...Если бы мы пришли вовремя..."

# game/Story02.rpy:3296
translate russian akt2chapter5_1a45283d:

    # h "Not all of us have those shiny implan-"
    h "Не у всех тут есть эти блестящие имплан..."

# game/Story02.rpy:3378
translate russian akt2chapter5_1_b52f92b9:

    # k "Funny…"
    k "Забавно..."

# game/Story02.rpy:3380
translate russian akt2chapter5_1_b3c97ac5:

    # k "Last time I was here, it smelled like smoke, blood, and fear."
    k "В прошлый раз, когда я была здесь, в воздухе стоял запах дыма, крови и страха."

# game/Story02.rpy:3382
translate russian akt2chapter5_1_6d16d080:

    # mc "(Eight on the left. Three on the right. More below...)"
    mc "(Восемь слева. Трое справа. Внизу еще...)"

# game/Story02.rpy:3384
translate russian akt2chapter5_1_ed237b7a:

    # mc "Stay sharp."
    mc "Не расслабляйтесь."

# game/Story02.rpy:3387
translate russian akt2chapter5_1_2c845811:

    # h "(whispering) This place… gives me the creeps."
    h "(шепотом) От этого места... мурашки по коже."

