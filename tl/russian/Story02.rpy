# game/Story02.rpy:4286
translate russian akt2chapter6_06878236:

    # Fl "...So you’re in?"
    Fl "...Значит, ты с нами?"

# game/Story02.rpy:4288
translate russian akt2chapter6_d5369a4b:

    # mc "I can walk."
    mc "Я могу идти."

# game/Story02.rpy:4289
translate russian akt2chapter6_baada9ed:

    # Fl "Miriel."
    Fl "Мириэль."

# game/Story02.rpy:4290
translate russian akt2chapter6_db380331:

    # Fl "Half the people here owe her."
    Fl "Половина людей здесь ей обязана."

# game/Story02.rpy:4293
translate russian akt2chapter6_ff792570:

    # Fl "And you two are…"
    Fl "А вы двое..."

# game/Story02.rpy:4294
translate russian akt2chapter6_b758b9c7:

    # Fl "Let’s just say—"
    Fl "Скажем так..."

# game/Story02.rpy:4298
translate russian akt2chapter6_c1ba8902:

    # Fl "I need her."
    Fl "Она мне нужна."

# game/Story02.rpy:4299
translate russian akt2chapter6_bb4b0a90:

    # mc "What do I get?"
    mc "Что я получу?"

# game/Story02.rpy:4300
translate russian akt2chapter6_1d37d7a9:

    # Fl "A favor."
    Fl "Должок."

# game/Story02.rpy:4305
translate russian akt2chapter6_270439d7:

    # mc "I’ll think about it."
    mc "Я подумаю."

# game/Story02.rpy:4306
translate russian akt2chapter6_2bad3711_1:

    # Fl "Good."
    Fl "Хорошо."

# game/Story02.rpy:4308
translate russian akt2chapter6_0cc7cbb2:

    # Fl "Glad you’re on board, mister."
    Fl "Рада, что ты с нами, мистер."

# game/Story02.rpy:4312
translate russian akt2chapter6_b5c6af4a:

    # Fl "Go."
    Fl "Иди."

# game/Story02.rpy:4314
translate russian akt2chapter6_f93b00e6:

    # Fl "...and—"
    Fl "...и..."

# game/Story02.rpy:4315
translate russian akt2chapter6_db26fedd:

    # Fl "…thanks."
    Fl "...спасибо."

# game/Story02.rpy:4331
translate russian akt2chapter6_a77a65cd:

    # Fl "I mean it."
    Fl "Я серьезно."

# game/Story02.rpy:4332
translate russian akt2chapter6_2c582d17:

    # h "Yeah, I don’t like this silence."
    h "Ага, мне не нравится это молчание."

# game/Story02.rpy:4336
translate russian akt2chapter6_6328359e:

    # h "No one’s gonna comment on what just happened?"
    h "Никто не собирается обсудить, что только что произошло?"

# game/Story02.rpy:4337
translate russian akt2chapter6_8f26d3d4:

    # k "The cat’s lost her mind."
    k "Кошка спятила."

# game/Story02.rpy:4338
translate russian akt2chapter6_b06c840b:

    # k "That what you wanted to hear?"
    k "Это ты хотела услышать?"

# game/Story02.rpy:4341
translate russian akt2chapter6_79dd620e:

    # h "About the betrayal, not—"
    h "Я про предательство, а не..."

# game/Story02.rpy:4342
translate russian akt2chapter6_7c993224:

    # k "We’re not discussing this."
    k "Мы это не обсуждаем."

# game/Story02.rpy:4343
translate russian akt2chapter6_05a43b79:

    # h "Oh no, we are talking about it."
    h "О нет, мы как раз будем об этом говорить."

# game/Story02.rpy:4344
translate russian akt2chapter6_b04d1432:

    # h "Astoria’s a traitor now?"
    h "Астория теперь предательница?"

# game/Story02.rpy:4347
translate russian akt2chapter6_0162b5ed:

    # h "That’s kind of a big deal—"
    h "Это вообще-то серьезно..."

# game/Story02.rpy:4348
translate russian akt2chapter6_71ab8690:

    # k "And you believed that?"
    k "И ты в это поверила?"

# game/Story02.rpy:4351
translate russian akt2chapter6_29caa825:

    # k "End of discussion."
    k "Обсуждение окончено."

# game/Story02.rpy:4352
translate russian akt2chapter6_5877d47d:

    # mc "Doesn’t sit right with me either."
    mc "Мне это тоже не кажется правильным."

# game/Story02.rpy:4353
translate russian akt2chapter6_ca660762:

    # h "See?!"
    h "Вот видишь?!"

# game/Story02.rpy:4354
translate russian akt2chapter6_2fb58163:

    # mc "She sees the future."
    mc "Она видит будущее."

# game/Story02.rpy:4356
translate russian akt2chapter6_11543c8d:

    # mc "So how did this happen?"
    mc "Тогда как это случилось?"

# game/Story02.rpy:4357
translate russian akt2chapter6_82091822_4:

    # k "..."
    k "..."

# game/Story02.rpy:4358
translate russian akt2chapter6_d728720b:

    # mc "You see it too."
    mc "Ты тоже это видишь."

# game/Story02.rpy:4361
translate russian akt2chapter6_3631fc3e:

    # mc "You just don’t want to say it out loud."
    mc "Просто не хочешь произнести вслух."

# game/Story02.rpy:4362
translate russian akt2chapter6_cebf71ea:

    # k "That’s heresy."
    k "Это ересь."

# game/Story02.rpy:4363
translate russian akt2chapter6_3d4537c0:

    # k "Astoria didn’t betray us. And she never would."
    k "Астория нас не предавала. И никогда бы не предала."

# game/Story02.rpy:4366
translate russian akt2chapter6_5909330a:

    # mc "Blind loyalty gets you nowhere."
    mc "Слепая преданность никуда тебя не приведет."

# game/Story02.rpy:4367
translate russian akt2chapter6_263b9c90:

    # k "She took in your wife. She saved your life."
    k "Она приняла твою жену. Она спасла тебе жизнь."

# game/Story02.rpy:4370
translate russian akt2chapter6_c79c7ccf:

    # k "And this is how you repay her?"
    k "И вот так ты ей отплатишь?"

# game/Story02.rpy:4371
translate russian akt2chapter6_4d6a8acb:

    # h "Wait, no. You’ve got that wrong."
    h "Стоп, нет. Ты все поняла неправильно."

# game/Story02.rpy:4375
translate russian akt2chapter6_66331371:

    # h "She’s not the one who saved him."
    h "Спасла его не она."

# game/Story02.rpy:4376
translate russian akt2chapter6_c4509583:

    # k "Don’t delude yourselves."
    k "Не обманывайте себя."

# game/Story02.rpy:4377
translate russian akt2chapter6_c23d5698:

    # k "He wouldn’t lift a finger without the Lady’s order."
    k "Без приказа госпожи он и пальцем бы не пошевелил."

# game/Story02.rpy:4381
translate russian akt2chapter6_aeefabe6:

    # h "That’s…"
    h "Это..."

# game/Story02.rpy:4383
translate russian akt2chapter6_e400f831:

    # mc "Мириэль?"
    mc "Мириэль?"

# game/Story02.rpy:4384
translate russian akt2chapter6_da3fdbf1_4:

    # Mi "..."
    Mi "..."

# game/Story02.rpy:4388
translate russian akt2chapter6_b37827eb:

    # mc "Look at me."
    mc "Посмотри на меня."

# game/Story02.rpy:4392
translate russian akt2chapter6_64022ee8:

    # h "And where exactly do you think you’re going, sweetheart?"
    h "И куда, по-твоему, ты собрался, дорогой?"

# game/Story02.rpy:4397
translate russian akt2chapter6_3ae551d2:

    # h "At least get dressed if you’re going after her."
    h "Хотя бы оденься, раз собрался за ней."

# game/Story02.rpy:4400
translate russian akt2chapter6_0415e8f6:

    # mc "Liv, stay on comms."
    mc "Лив, оставайся на связи."

# game/Story02.rpy:4404
translate russian akt2chapter6_517a26dc:

    # k "Looks like we’ve been ditched again, shorty."
    k "Похоже, нас снова бросили, коротышка."

# game/Story02.rpy:4405
translate russian akt2chapter6_6d5bc58a:

    # h "Don’t change the subject."
    h "Не меняй тему."

# game/Story02.rpy:4407
translate russian akt2chapter6_29fdd21b:

    # h "What do you mean the Lady saved him?"
    h "Что значит, госпожа спасла его?"

# game/Story02.rpy:4427
translate russian akt2chapter6_93535690:

    # k "You’ll see soon enough. Move."
    k "Скоро увидишь. Идем."

# game/Story02.rpy:4431
translate russian akt2chapter7_31314ce4:

    # mc "You haven’t been yourself since that talk."
    mc "После того разговора ты сама не своя."

# game/Story02.rpy:4433
translate russian akt2chapter7_599fbc53:

    # mc "You didn’t tell me not to."
    mc "Ты не сказала, что нельзя."

# game/Story02.rpy:4439
translate russian akt2chapter7_9d189b99:

    # mc "...That line."
    mc "...Эта фраза."

# game/Story02.rpy:4440
translate russian akt2chapter7_3c83b55d:

    # mc "City of broken dreams."
    mc "Город разбитых мечтаний."

# game/Story02.rpy:4441
translate russian akt2chapter7_9ae1be38:

    # Mi "…Hm?"
    Mi "...М?"

# game/Story02.rpy:4442
translate russian akt2chapter7_c8579042:

    # mc "Is that what this is about?"
    mc "Дело в этом?"

# game/Story02.rpy:4447
translate russian akt2chapter7_96e45bc2:

    # Mi "…Home."
    Mi "...Дом."

# game/Story02.rpy:4448
translate russian akt2chapter7_a29233f8:

    # Mi "…This place… it’s…"
    Mi "...Это место... оно..."

# game/Story02.rpy:4450
translate russian akt2chapter7_902e0bfd:

    # Mi "Special to me."
    Mi "особенное для меня."

# game/Story02.rpy:4452
translate russian akt2chapter7_d3fb764d:

    # Mi "Here… I…"
    Mi "Здесь... я..."

# game/Story02.rpy:4453
translate russian akt2chapter7_582359ea:

    # mc "Hm?"
    mc "М?"

# game/Story02.rpy:4455
translate russian akt2chapter7_31153e4a:

    # Mi "…Tell me… have you ever wished you wouldn’t wake up?"
    Mi "...Скажи... тебе когда-нибудь хотелось не проснуться?"

# game/Story02.rpy:4457
translate russian akt2chapter7_cf1adef2:

    # mc "Yeah."
    mc "Да."

# game/Story02.rpy:4459
translate russian akt2chapter7_740bb097:

    # Mi "Why?"
    Mi "Почему?"

# game/Story02.rpy:4460
translate russian akt2chapter7_60b57106:

    # mc "Stupidity… maybe."
    mc "Глупость... наверное."

# game/Story02.rpy:4464
translate russian akt2chapter7_9d0a0734:

    # mc "Or feeling stuck."
    mc "Или чувство, что застрял."

# game/Story02.rpy:4465
translate russian akt2chapter7_73bf868d:

    # mc "(…Broken dreams.)"
    mc "(...Разбитые мечты.)"

# game/Story02.rpy:4469
translate russian akt2chapter7_21f80a99:

    # mc "You didn’t come here for a new life."
    mc "Ты пришла сюда не за новой жизнью."

# game/Story02.rpy:4470
translate russian akt2chapter7_3be11b7d:

    # Mi "I thought… I believed—"
    Mi "Я думала... я верила..."

# game/Story02.rpy:4472
translate russian akt2chapter7_5db9473a:

    # Mi "That I could find the strength…"
    Mi "Что смогу найти в себе силы..."

# game/Story02.rpy:4475
translate russian akt2chapter7_1e9e0d30:

    # Mi "To finish what I started."
    Mi "закончить начатое."

# game/Story02.rpy:4476
translate russian akt2chapter7_2ee6c1ba:

    # Mi "Just one step…"
    Mi "Всего один шаг..."

# game/Story02.rpy:4479
translate russian akt2chapter7_ec8b1974:

    # Mi "That’s all that stood between me and peace."
    Mi "Только он отделял меня от покоя."

# game/Story02.rpy:4482
translate russian akt2chapter7_d231e988:

    # Mi "One step."
    Mi "Один шаг."

# game/Story02.rpy:4484
translate russian akt2chapter7_9c9b8577:

    # mc "But you stopped."
    mc "Но ты остановилась."

# game/Story02.rpy:4487
translate russian akt2chapter7_e8919b36:

    # Mi "(whispering) …I was scared."
    Mi "(шепотом) ...Я испугалась."

# game/Story02.rpy:4489
translate russian akt2chapter7_c4cca458:

    # Mi "Another minute… and I would’ve done it, but…"
    Mi "Еще минута... и я бы сделала это, но..."

# game/Story02.rpy:4492
translate russian akt2chapter7_edd9e9ec:

    # Mi "Someone stopped me."
    Mi "Кто-то меня остановил."

# game/Story02.rpy:4496
translate russian akt2chapter7_e0f04eb5:

    # mc "And now… you’re back there."
    mc "И теперь... ты снова там."

# game/Story02.rpy:4503
translate russian akt2chapter7_f671b6ac:

    # mc "Only now you’ve got something to lose."
    mc "Только теперь тебе есть что терять."

# game/Story02.rpy:4506
translate russian akt2chapter7_2fcd0478:

    # mc "(…Maybe.)"
    mc "(...Наверное.)"

# game/Story02.rpy:4510
translate russian akt2chapter7_c0a8921c:

    # mc "I almost lost it too."
    mc "Я тоже едва это не потерял."

# game/Story02.rpy:4516
translate russian akt2chapter7_476ae4a1:

    # Mi "…Let’s go."
    Mi "...Пойдем."

# game/Story02.rpy:4520
translate russian akt2chapter7_99475aef:

    # Mi "I…"
    Mi "Я..."

# game/Story02.rpy:4521
translate russian akt2chapter7_a7677712:

    # Mi "I need someone with me."
    Mi "Мне нужно, чтобы кто-то был рядом."

# game/Story02.rpy:4533
translate russian akt2chapter7_df7ee913:

    # mc "Lead the way."
    mc "Веди."

# game/Story02.rpy:4534
translate russian akt2chapter7_82217262:

    # mc "(She picked up the pace.)"
    mc "(Она ускорилась.)"

# game/Story02.rpy:4538
translate russian akt2chapter7_64c8929d:

    # mc "(Too fast.)"
    mc "(Слишком быстро.)"

# game/Story02.rpy:4541
translate russian akt2chapter7_c7e3f32b:

    # mc "(She’s not running.)"
    mc "(Она не бежит.)"

# game/Story02.rpy:4546
translate russian akt2chapter7_8ef64a65:

    # mc "(But she’s not waiting either.)"
    mc "(Но и не ждет.)"

# game/Story02.rpy:4550
translate russian akt2chapter7_9e78535a:

    # mc "(…Where’d she go?)"
    mc "(...Куда она делась?)"

# game/Story02.rpy:4555
translate russian akt2chapter7_40c3d6b9:

    # a "Looking for someone?"
    a "Кого-то ищешь?"

# game/Story02.rpy:4557
translate russian akt2chapter7_921805a7:

    # mc "You seen a short, tanned girl?"
    mc "Не видела невысокую смуглую девушку?"

# game/Story02.rpy:4566
translate russian akt2chapter7_c61de1e8:

    # a "You’re lagging behind alread—"
    a "Ты уже отстае..."

# game/Story02.rpy:4570
translate russian akt2chapter7_b6b4da37:

    # mc "(…What the hell was that?)"
    mc "(...Что это, черт возьми, было?)"

# game/Story02.rpy:4571
translate russian akt2chapter7_3afa4f18:

    # Mi "…A hologram."
    Mi "...Голограмма."

# game/Story02.rpy:4573
translate russian akt2chapter7_ff2b0516:

    # mc "And how long have you been standing there?"
    mc "И давно ты там стоишь?"

# game/Story02.rpy:4576
translate russian akt2chapter7_0bfa5814:

    # Mi "…I never left."
    Mi "...Я никуда не уходила."

# game/Story02.rpy:4577
translate russian akt2chapter7_26b6d608:

    # mc "You disappeared."
    mc "Ты исчезла."

# game/Story02.rpy:4581
translate russian akt2chapter7_f32f8a2f:

    # mc "So… this is it?"
    mc "Значит... это здесь?"

# game/Story02.rpy:4584
translate russian akt2chapter7_fb12b2e7:

    # Mi "Yes..."
    Mi "Да..."

# game/Story02.rpy:4588
translate russian akt2chapter7_9755264c:

    # Mi "…I’m scared."
    Mi "...Мне страшно."

# game/Story02.rpy:4590
translate russian akt2chapter7_f9803e8f:

    # mc "I’m already here."
    mc "Я уже здесь."

# game/Story02.rpy:4608
translate russian mirielhome_234dc169:

    # mc "(Air feels different here.)"
    mc "(Здесь даже воздух другой.)"

# game/Story02.rpy:4611
translate russian mirielhome_674bb5ab:

    # mc "(So does everything else.)"
    mc "(И все остальное тоже.)"

# game/Story02.rpy:4613
translate russian mirielhome_9122702b:

    # Mi "…You’re the first person I’ve brought here."
    Mi "...Ты первый, кого я сюда привела."

# game/Story02.rpy:4616
translate russian mirielhome_f7bd1159:

    # mc "They’re close, aren’t they?"
    mc "Они близко, да?"

# game/Story02.rpy:4619
translate russian mirielhome_f1a1b640:

    # Mi "…Yeah."
    Mi "...Да."

# game/Story02.rpy:4622
translate russian mirielhome_813705e9:

    # Mi "Please. Stay close to me."
    Mi "Пожалуйста. Держись рядом."

# game/Story02.rpy:4625
translate russian mirielhome_6651ab87:

    # mc "Alright."
    mc "Ладно."

# game/Story02.rpy:4631
translate russian mirielhome_71e05766:

    # a "Outsiders aren’t welcome here."
    a "Чужакам здесь не рады."

# game/Story02.rpy:4632
translate russian mirielhome_81fbcc4c:

    # a "And-"
    a "И..."

# game/Story02.rpy:4634
translate russian mirielhome_ec096dcb:

    # a "We thought you’d abandoned us..."
    a "Мы думали, ты нас бросила..."

# game/Story02.rpy:4638
translate russian mirielhome_7447ec08:

    # ry "Excuses again?"
    ry "Опять оправдания?"

# game/Story02.rpy:4640
translate russian mirielhome_b0d624f3:

    # Mi "If I’m not welcome, say it."
    Mi "Если мне здесь не рады, так и скажи."

# game/Story02.rpy:4645
translate russian mirielhome_f640b8ba:

    # ry "Always taking everything too close to heart, huh?"
    ry "Вечно все принимаешь близко к сердцу, да?"

# game/Story02.rpy:4655
translate russian mirielhome_df0283dd:

    # Mi "Riya, Zoya..."
    Mi "Рия, Зоя..."

# game/Story02.rpy:4657
translate russian mirielhome_1f9bf24d:

    # Mi "…I’m home."
    Mi "...Я дома."

# game/Story02.rpy:4663
translate russian mirielhome_9de0df99:

    # ry "Why do you need him?"
    ry "Зачем он тебе?"

# game/Story02.rpy:4668
translate russian mirielhome_b9dd27c4:

    # mc "Here to help."
    mc "Я здесь, чтобы помочь."

# game/Story02.rpy:4672
translate russian mirielhome_ed33888d:

    # ry "Seriously?"
    ry "Серьезно?"

# game/Story02.rpy:4674
translate russian mirielhome_862510af:

    # Mi "He’s with me… This is [mc], he’s…"
    Mi "Он со мной... Это [mc], он..."

# game/Story02.rpy:4675
translate russian mirielhome_f95cdd05:

    # ry "Ellie."
    ry "Элли."

# game/Story02.rpy:4676
translate russian mirielhome_c6b81865:

    # ry "You know the rules, he doesn’t belong here."
    ry "Ты знаешь правила. Ему здесь не место."

# game/Story02.rpy:4678
translate russian mirielhome_98713f92:

    # ry "We know you. Him? Not so much."
    ry "Тебя мы знаем. Его? Не особо."

# game/Story02.rpy:4680
translate russian mirielhome_63bffe7f:

    # Mi "He’s my responsibility."
    Mi "Он моя ответственность."

# game/Story02.rpy:4683
translate russian mirielhome_1e6e2712:

    # ry "You lost our trust the moment you walked away."
    ry "Ты потеряла наше доверие в тот момент, когда ушла."

# game/Story02.rpy:4684
translate russian mirielhome_80fd9747:

    # Mi "I lost it… but I didn’t throw it away."
    Mi "Я потеряла его... но не выбросила."

# game/Story02.rpy:4686
translate russian mirielhome_1a0243a8:

    # Mi "…Just this once. Look the other way."
    Mi "...Только в этот раз. Сделай вид, что не видишь."

# game/Story02.rpy:4688
translate russian mirielhome_2b020732:

    # ry "We’ll see what the others have to say."
    ry "Посмотрим, что скажут остальные."

# game/Story02.rpy:4705
translate russian mirielhome_8bbc809d:

    # mc "I’m not here to cause trouble."
    mc "Я пришел не создавать проблемы."

# game/Story02.rpy:4706
translate russian mirielhome_ce7b64cf:

    # ry "While you’re here, you’re a problem."
    ry "Пока ты здесь, ты и есть проблема."

# game/Story02.rpy:4718
translate russian mirielhome_4220cd4c:

    # Mi "…How have you been holding up here?"
    Mi "...Как вы здесь держитесь?"

# game/Story02.rpy:4721
translate russian mirielhome_c21afe46:

    # ry "I could tell you… but are you gonna run once you hear it?"
    ry "Могу рассказать... но ты не сбежишь, когда услышишь?"

# game/Story02.rpy:4725
translate russian mirielhome_8f388cc9:

    # ry "And here you are again."
    ry "Вот ты снова за свое."

# game/Story02.rpy:4726
translate russian mirielhome_82206fbc:

    # ry "At least now they’re not spitting in your back anymore…"
    ry "По крайней мере, теперь тебе больше не плюют в спину..."

# game/Story02.rpy:4728
translate russian mirielhome_db9e3c6e:

    # ry "Well… thanks for that, at least."
    ry "Ну... хотя бы за это спасибо."

# game/Story02.rpy:4730
translate russian mirielhome_33199f1a:

    # mc "Careful."
    mc "Осторожнее."

# game/Story02.rpy:4731
translate russian mirielhome_490f7fc5:

    # ry "Now a stranger’s gonna lecture me?"
    ry "Теперь чужак будет меня учить?"

# game/Story02.rpy:4733
translate russian mirielhome_cf6e2065:

    # ry "Stay out of it."
    ry "Не лезь."

# game/Story02.rpy:4735
translate russian mirielhome_b6b18e7b:

    # mc "I’m not letting you talk to her like that."
    mc "Я не позволю тебе так с ней говорить."

# game/Story02.rpy:4737
translate russian mirielhome_b21bc9c9:

    # ry "Nothing’s stopping me from throwing you out right now."
    ry "Ничто не мешает мне прямо сейчас вышвырнуть тебя отсюда."

# game/Story02.rpy:4738
translate russian mirielhome_f49fff8f:

    # mc "Yeah?"
    mc "Да?"

# game/Story02.rpy:4741
translate russian mirielhome_9319dfd9:

    # mc "Try it."
    mc "Попробуй."

# game/Story02.rpy:4742
translate russian mirielhome_f82ace0b:

    # ry "Hmph…"
    ry "Хмф..."

# game/Story02.rpy:4744
translate russian mirielhome_8c8cf0eb:

    # Mi "That’s enough."
    Mi "Достаточно."

# game/Story02.rpy:4746
translate russian mirielhome_ef1dc432:

    # Mi "Both of you."
    Mi "Оба."

# game/Story02.rpy:4750
translate russian mirielhome_3bf4b8e6:

    # Mi "Now, Riya."
    Mi "А теперь, Рия."

# game/Story02.rpy:4752
translate russian mirielhome_f503a4c4:

    # Mi "Explain why Elaina’s lying on that table."
    Mi "Объясни, почему Элейна лежит на этом столе."

# game/Story02.rpy:4762
translate russian mirielhome_e0d2ec3a:

    # ry "Let’s go ask her."
    ry "Пойдем спросим у нее."

# game/Story02.rpy:4764
translate russian mirielhome_969405d0:

    # ry "Elaena... Get up!"
    ry "Элейна... Вставай!"

# game/Story02.rpy:4766
translate russian mirielhome_ea527df6:

    # el "…huh?"
    el "...м?"

# game/Story02.rpy:4768
translate russian mirielhome_75b8b3d9:

    # el "…what do you want."
    el "...чего тебе."

# game/Story02.rpy:4770
translate russian mirielhome_aae92969:

    # ry "We have visitors."
    ry "У нас гости."

# game/Story02.rpy:4772
translate russian mirielhome_4254e24f:

    # ry "And ignoring them wouldn’t be a great idea."
    ry "И игнорировать их не лучшая идея."

# game/Story02.rpy:4773
translate russian mirielhome_f323f59b:

    # ry "Especially for you."
    ry "Особенно для тебя."

# game/Story02.rpy:4775
translate russian mirielhome_69969f40:

    # el "Why should I care?"
    el "А мне какое дело?"

# game/Story02.rpy:4778
translate russian mirielhome_3bb2dda3:

    # mc "(They’re not taking me seriously.)"
    mc "(Они не воспринимают меня всерьез.)"

# game/Story02.rpy:4782
translate russian mirielhome_ff7e1820:

    # mc "(Doesn’t matter… why are we really here?)"
    mc "(Неважно... зачем мы на самом деле здесь?)"

# game/Story02.rpy:4785
translate russian mirielhome_e3b117f7:

    # Mi "Stay here for a bit, I need to-"
    Mi "Побудь здесь немного, мне нужно..."

# game/Story02.rpy:4787
translate russian mirielhome_157ed6e7:

    # mc "You didn’t bring me here for them."
    mc "Ты привела меня сюда не ради них."

# game/Story02.rpy:4788
translate russian mirielhome_7dfead77:

    # Mi "I need those pills…"
    Mi "Мне нужны те таблетки..."

# game/Story02.rpy:4792
translate russian mirielhome_3d59a3d3:

    # Mi "…For you."
    Mi "...Для тебя."

# game/Story02.rpy:4797
translate russian mirielhome_eea7d9c3:

    # el "Did you hear what’s going on up—"
    el "Ты слышала, что там наверху..."

# game/Story02.rpy:4799
translate russian mirielhome_9dba8a29:

    # Mi "…That’s how you greet us?"
    Mi "...Вот так ты нас встречаешь?"

# game/Story02.rpy:4801
translate russian mirielhome_62440a98:

    # Mi "Ela."
    Mi "Эла."

# game/Story02.rpy:4807
translate russian mirielhome_8f600424:

    # el "Ow."
    el "Ай."

# game/Story02.rpy:4809
translate russian mirielhome_e3a8b0e1:

    # el "No way… Ellie? What brings you here?"
    el "Да ладно... Элли? Какими судьбами?"

# game/Story02.rpy:4811
translate russian mirielhome_b423d419:

    # Mi "We’re here on business."
    Mi "Мы по делу."

# game/Story02.rpy:4813
translate russian mirielhome_03c02901:

    # el "Something to do with the surface?"
    el "Что-то связанное с поверхностью?"

# game/Story02.rpy:4815
translate russian mirielhome_955834b8:

    # ry "You’ve gotten too comfortable. She’s not the problem."
    ry "Ты слишком расслабилась. Проблема не в ней."

# game/Story02.rpy:4823
translate russian mirielhome_73e2b8f7:

    # ry "He is."
    ry "А в нем."

# game/Story02.rpy:4827
translate russian mirielhome_317fc068:

    # el "(whispering) Who is he?"
    el "(шепотом) Кто он?"

# game/Story02.rpy:4831
translate russian mirielhome_7f31c2b8:

    # Mi "He’s someone close to me."
    Mi "Он близкий мне человек."

# game/Story02.rpy:4835
translate russian mirielhome_5b836fb7:

    # Mi "…So show him some respect."
    Mi "...Так что прояви к нему уважение."

# game/Story02.rpy:4838
translate russian mirielhome_e6754340:

    # el "Nah."
    el "Не-а."

# game/Story02.rpy:4839
translate russian mirielhome_ce83db8d:

    # Mi "Ela!"
    Mi "Эла!"

# game/Story02.rpy:4843
translate russian mirielhome_83cb14d2:

    # el "Hm..."
    el "Хм..."

# game/Story02.rpy:4847
translate russian mirielhome_094c1f67:

    # el "Why’d you bring him here?"
    el "Зачем ты его сюда привела?"

# game/Story02.rpy:4851
translate russian mirielhome_cb1c9a3a:

    # el "Oh, what, for fun—"
    el "А, что, ради веселья..."

# game/Story02.rpy:4852
translate russian mirielhome_60df03a3:

    # Mi "…Enough jokes."
    Mi "...Хватит шуток."

# game/Story02.rpy:4854
translate russian mirielhome_3be30bff:

    # Mi "I’m serious."
    Mi "Я серьезно."

# game/Story02.rpy:4855
translate russian mirielhome_36abf706:

    # el "So… how much are you willing to pay?"
    el "Так... сколько ты готов заплатить?"

# game/Story02.rpy:4857
translate russian mirielhome_9eaa3bf9:

    # Mi "…Don’t do this, Ela."
    Mi "...Не надо так, Эла."

# game/Story02.rpy:4858
translate russian mirielhome_02dc135b:

    # el "I meant him."
    el "Я его спрашивала."

# game/Story02.rpy:4860
translate russian mirielhome_c0724da1:

    # Mi "…I’ll cover it."
    Mi "...Я заплачу."

# game/Story02.rpy:4862
translate russian mirielhome_b6304111:

    # el "Hmm..."
    el "Хмм..."

# game/Story02.rpy:4895
translate russian mirielhome_4591e1a2:

    # mc "Name your price."
    mc "Назови цену."

# game/Story02.rpy:4896
translate russian mirielhome_156bd92a:

    # el "Forget it. It’s on the house."
    el "Забудь. За счет заведения."

# game/Story02.rpy:4897
translate russian mirielhome_613b97b1:

    # mc "That’s not how this works."
    mc "Так это не работает."

# game/Story02.rpy:4899
translate russian mirielhome_50424fc8:

    # mc "I’ll pay."
    mc "Я заплачу."

# game/Story02.rpy:4901
translate russian mirielhome_7964c161:

    # el "Then… take good care of little Ellie"
    el "Тогда... позаботься о маленькой Элли."

# game/Story02.rpy:4911
translate russian mirielhome_20a7553e:

    # el "Yeah, yeah, I remember."
    el "Да-да, я помню."

# game/Story02.rpy:4914
translate russian mirielhome_664782b6:

    # el "Don’t screw it up with her."
    el "Не напортачь с ней."

# game/Story02.rpy:4924
translate russian mirielhome_e3b86064:

    # mc "She’s on me."
    mc "Она на мне."

# game/Story02.rpy:4926
translate russian mirielhome_41955aaf:

    # y "…You’re late."
    y "...Ты опоздала."

# game/Story02.rpy:4928
translate russian mirielhome_af5bd3f7:

    # Mi "Teacher."
    Mi "Наставница."

# game/Story02.rpy:4929
translate russian mirielhome_f074a578:

    # y "Why did you bring him here."
    y "Зачем ты привела его сюда."

# game/Story02.rpy:4930
translate russian mirielhome_0bfa1f16:

    # Mi "W-wait— you… you wanted to meet him—"
    Mi "П-подожди... ты... ты ведь хотела с ним встретиться..."

# game/Story02.rpy:4931
translate russian mirielhome_9f576610:

    # y "Why."
    y "Зачем."

# game/Story02.rpy:4932
translate russian mirielhome_b10f1203:

    # y "Here."
    y "Сюда."

# game/Story02.rpy:4933
translate russian mirielhome_da3fdbf1_4:

    # Mi "..."
    Mi "..."

# game/Story02.rpy:4935
translate russian mirielhome_771ed3f4:

    # mc "That was my call."
    mc "Это было мое решение."

# game/Story02.rpy:4936
translate russian mirielhome_1b4c1806:

    # Mi "He-"
    Mi "Он..."

# game/Story02.rpy:4937
translate russian mirielhome_8c19ae20:

    # y "Did you get the others’ consent."
    y "Ты получила согласие остальных."

# game/Story02.rpy:4939
translate russian mirielhome_2ea261af:

    # Mi "I..."
    Mi "Я..."

# game/Story02.rpy:4941
translate russian mirielhome_7dc3f261:

    # el "If Elie trusts him, then I don’t have a problem with him either."
    el "Если Элли ему доверяет, то и у меня с ним проблем нет."

# game/Story02.rpy:4943
translate russian mirielhome_ba93e481:

    # ry "I’m against it."
    ry "Я против."

# game/Story02.rpy:4945
translate russian mirielhome_0595c5a4:

    # ry "Zoya?"
    ry "Зоя?"

# game/Story02.rpy:4957
translate russian mirielhome_c4e8ffd3:

    # y "Two against two."
    y "Двое против двух."

# game/Story02.rpy:4958
translate russian mirielhome_f6e59efb:

    # Mi "Teacher, your voice..."
    Mi "Наставница, ваш голос..."

# game/Story02.rpy:4959
translate russian mirielhome_4b78c7f2:

    # y "I’m against it."
    y "Я против."

# game/Story02.rpy:4962
translate russian mirielhome_d4a78424:

    # Mi "What?!"
    Mi "Что?!"

# game/Story02.rpy:4964
translate russian mirielhome_0d6470bf:

    # mc "Then stop me."
    mc "Тогда останови меня."

# game/Story02.rpy:4966
translate russian mirielhome_4a6ed62d:

    # y "…You think I can’t?"
    y "...Думаешь, я не смогу?"

# game/Story02.rpy:4968
translate russian mirielhome_66fa3968:

    # mc "You won’t."
    mc "Не станешь."

# game/Story02.rpy:4970
translate russian mirielhome_4348da72:

    # y "Bold."
    y "Смело."

# game/Story02.rpy:4972
translate russian mirielhome_49d9f299:

    # mc "We’re leaving."
    mc "Мы уходим."

# game/Story02.rpy:4981
translate russian mirielhome_db37014b:

    # el "Too late."
    el "Поздно."

# game/Story02.rpy:4983
translate russian mirielhome_eaaa8772:

    # el "You’re with me."
    el "Ты со мной."

# game/Story02.rpy:4988
translate russian mirielhome_a3f2a31c:

    # y "Outsiders don’t belong here."
    y "Чужакам здесь не место."

# game/Story02.rpy:4989
translate russian mirielhome_1e8dadb7:

    # y "You know the cost…"
    y "Ты знаешь цену..."

# game/Story02.rpy:4991
translate russian mirielhome_d07daa49:

    # y "Of breaking the rules."
    y "нарушения правил."

# game/Story02.rpy:5001
translate russian mirielhome_89c1d39e:

    # el "I know."
    el "Знаю."

# game/Story02.rpy:5002
translate russian mirielhome_7d39ba31:

    # mc "What am I looking at?"
    mc "На что я смотрю?"

# game/Story02.rpy:5004
translate russian mirielhome_4fa5db14:

    # Mi "…This… isn’t possible."
    Mi "...Это... невозможно."

# game/Story02.rpy:5006
translate russian mirielhome_9206c4e8:

    # el "As you can see… it is."
    el "Как видишь... возможно."

# game/Story02.rpy:5007
translate russian mirielhome_16250d23:

    # mc "You wanted us to see this…"
    mc "Ты хотела, чтобы мы это увидели..."

# game/Story02.rpy:5008
translate russian mirielhome_4c35d754:

    # mc "So explain it."
    mc "Тогда объясни."

# game/Story02.rpy:5012
translate russian mirielhome_5fdff341:

    # Mi "…This is why the surface is in chaos."
    Mi "...Вот почему на поверхности хаос."

# game/Story02.rpy:5013
translate russian mirielhome_3f9df27f:

    # mc "...What?"
    mc "...Что?"

# game/Story02.rpy:5017
translate russian mirielhome_8f97d927:

    # mc "The tombs were the problem—"
    mc "Проблема была в Гробницах..."

# game/Story02.rpy:5020
translate russian mirielhome_33ed68f1:

    # h "...red sludge..."
    h "...красная жижа..."

# game/Story02.rpy:5021
translate russian mirielhome_eb4217af:

    # mc "(Energy…)"
    mc "(Энергия...)"

# game/Story02.rpy:5022
translate russian mirielhome_1789d995:

    # mc "It’s spreading."
    mc "Она распространяется."

# game/Story02.rpy:5023
translate russian mirielhome_80c66130:

    # el "…Yeah."
    el "...Да."

# game/Story02.rpy:5024
translate russian mirielhome_8878e82f:

    # el "And it’s getting worse."
    el "И становится хуже."

# game/Story02.rpy:5026
translate russian mirielhome_56c974f3:

    # mc "How long?"
    mc "Как давно?"

# game/Story02.rpy:5030
translate russian mirielhome_87c94cbb:

    # el "It wasn’t here the day before yesterday."
    el "Позавчера этого здесь не было."

# game/Story02.rpy:5032
translate russian mirielhome_92b38daa:

    # mc "Then how?"
    mc "Тогда как?"

# game/Story02.rpy:5033
translate russian mirielhome_83d85d72:

    # y "…Think."
    y "...Думай."

# game/Story02.rpy:5034
translate russian mirielhome_be81f218:

    # y "The answer is in front of you."
    y "Ответ перед тобой."

# game/Story02.rpy:5035
translate russian mirielhome_2b35b6fe_1:

    # mc "..."
    mc "..."

# game/Story02.rpy:5039
translate russian mirielhome_53a10500:

    # mc "(Who’s spreading it…?)"
    mc "(Кто это распространяет...?)"

# game/Story02.rpy:5042
translate russian mirielhome_661b6ed5:

    # mc "(Who...spread virus like that?)"
    mc "(Кто... распространяет такой вирус?)"

# game/Story02.rpy:5043
translate russian mirielhome_6bae8be1:

    # mc "(No…)"
    mc "(Нет...)"

# game/Story02.rpy:5047
translate russian mirielhome_a3ff60ae:

    # mc "(No one’s spreading it.)"
    mc "(Никто его не распространяет.)"

# game/Story02.rpy:5053
translate russian mirielhome_f7e33c45:

    # mc "It’s spreading itself."
    mc "Оно распространяется само."

# game/Story02.rpy:5057
translate russian mirielhome_d912100d:

    # y "Go on."
    y "Продолжай."

# game/Story02.rpy:5061
translate russian mirielhome_2b35b6fe_2:

    # mc "..."
    mc "..."

# game/Story02.rpy:5065
translate russian mirielhome_38d90612:

    # Mi "If even one gets into the city…"
    Mi "Если хотя бы один попадет в город..."

# game/Story02.rpy:5066
translate russian mirielhome_d025e255:

    # mc "The Soulless…"
    mc "Бездушные..."

# game/Story02.rpy:5067
translate russian mirielhome_40500fd8:

    # y "Killing them… makes it worse."
    y "Убивать их... значит делать только хуже."

# game/Story02.rpy:5068
translate russian mirielhome_1062ba2e:

    # y "Ignore it…"
    y "Игнорировать..."

# game/Story02.rpy:5070
translate russian mirielhome_fc62d884:

    # y "Same outcome."
    y "исход тот же."

# game/Story02.rpy:5071
translate russian mirielhome_ea55d8db:

    # mc "Then… what do we do?"
    mc "Тогда... что нам делать?"

# game/Story02.rpy:5075
translate russian mirielhome_b1d480c2:

    # y "Stop it."
    y "Остановить."

# game/Story02.rpy:5078
translate russian mirielhome_7872a6aa:

    # y "Without killing."
    y "Не убивая."

# game/Story02.rpy:5090
translate russian mirielhome_d8a23d7e:

    # mc "Cryogen?"
    mc "Криоагент?"

# game/Story02.rpy:5092
translate russian mirielhome_fefe8ca9:

    # y "They’re watching us."
    y "Они наблюдают за нами."

# game/Story02.rpy:5094
translate russian mirielhome_64fab373:

    # y "No time."
    y "Времени нет."

# game/Story02.rpy:5095
translate russian mirielhome_b114be0f:

    # y "Go to the Tower."
    y "Иди к Башне."

# game/Story02.rpy:5097
translate russian mirielhome_5164590e:

    # mc "Why me?"
    mc "Почему я?"

# game/Story02.rpy:5108
translate russian mirielhome_2595afc1:

    # y "Because you’re already inside the thread."
    y "Потому что ты уже внутри этого цикла."

# game/Story02.rpy:5110
translate russian mirielhome_815f0850:

    # mc "(What… What the hell just happened?…)"
    mc "(Что... Что, черт возьми, только что произошло?..)"

# game/Story02.rpy:5112
translate russian mirielhome_2b35b6fe_3:

    # mc "..."
    mc "..."

# game/Story02.rpy:5113
translate russian mirielhome_491968b0:

    # mc "I don’t like this."
    mc "Мне это не нравится."

# game/Story02.rpy:5115
translate russian mirielhome_b3dd99ae:

    # y "…I don’t like it either."
    y "...Мне тоже."

# game/Story02.rpy:5117
translate russian mirielhome_98d007da:

    # Mi "…That energy… it’s moving toward the tower."
    Mi "...Эта энергия... движется к Башне."

# game/Story02.rpy:5119
translate russian mirielhome_4a07ad1a:

    # Mi "If it reaches it…"
    Mi "Если она доберется..."

# game/Story02.rpy:5124
translate russian mirielhome_da3fdbf1_5:

    # Mi "..."
    Mi "..."

# game/Story02.rpy:5125
translate russian mirielhome_3b3d8924:

    # y "You won’t even realize…"
    y "Вы даже не поймете..."

# game/Story02.rpy:5127
translate russian mirielhome_d2fa4ea8:

    # y "when you die."
    y "когда умрете."

# game/Story02.rpy:5133
translate russian mirielhome_a2396fba:

    # mc "Miriel… we’re leaving."
    mc "Мириэль... мы уходим."

# game/Story02.rpy:5137
translate russian mirielhome_23b04003:

