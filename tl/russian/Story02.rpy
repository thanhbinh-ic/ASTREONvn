translate russian akt2chapter5_1_0af0daf4:

    # aS "A gorilla? Care to enlighten me?"
    aS "Горилла? Просветишь меня?"

# game/Story02.rpy:3428
translate russian akt2chapter5_1_8004fce5:

    # h "And what’s that supposed to mean?"
    h "И что это должно значить?"

# game/Story02.rpy:3429
translate russian akt2chapter5_1_25b2d084:

    # aS "Oh, of course. Naturally."
    aS "О, конечно. Само собой."

# game/Story02.rpy:3431
translate russian akt2chapter5_1_2f12a841:

    # aS "The real question is… will she even share it with you?"
    aS "Настоящий вопрос в другом... она вообще вам об этом расскажет?"

# game/Story02.rpy:3432
translate russian akt2chapter5_1_8c2c73b9:

    # k "I…"
    k "Я..."

# game/Story02.rpy:3433
translate russian akt2chapter5_1_50aa36cd:

    # k "...I’ll share."
    k "...Расскажу."

# game/Story02.rpy:3435
translate russian akt2chapter5_1_4e46cda8:

    # k "But not in front of you, rabbit number two."
    k "Но не при тебе, зайка номер два."

# game/Story02.rpy:3437
translate russian akt2chapter5_1_2b35b6fe_1:

    # mc "..."
    mc "..."

# game/Story02.rpy:3438
translate russian akt2chapter5_1_dc7383a9:

    # mc "You’ve got words."
    mc "Слов у тебя много."

# game/Story02.rpy:3439
translate russian akt2chapter5_1_9b9509b0:

    # mc "Not much meaning."
    mc "Смысла мало."

# game/Story02.rpy:3440
translate russian akt2chapter5_1_bf3e94c5:

    # mc "Get to the point."
    mc "К делу."

# game/Story02.rpy:3441
translate russian akt2chapter5_1_369a1e7f:

    # mc "Where’s Winter?"
    mc "Где Винтер?"

# game/Story02.rpy:3446
translate russian akt2chapter5_1_73f310dc:

    # Mi "(…Two souls?)"
    Mi "(...Две души?)"

# game/Story02.rpy:3451
translate russian akt2chapter5_1_cee34e4c_1:

    # aS "..."
    aS "..."

# game/Story02.rpy:3458
translate russian akt2chapter5_1_456ca6f8:

    # aS "We’ll talk downstairs."
    aS "Поговорим внизу."

# game/Story02.rpy:3462
translate russian akt2chapter5_1_da3fdbf1:

    # Mi "..."
    Mi "..."

# game/Story02.rpy:3471
translate russian akt2chapter5_1_476ae4a1:

    # Mi "…Let’s go."
    Mi "...Пойдем."

# game/Story02.rpy:3472
translate russian akt2chapter5_1_ba1550e1:

    # a "(whispering) She burned our homes…"
    a "(шепотом) Она сожгла наши дома..."

# game/Story02.rpy:3473
translate russian akt2chapter5_1_22700450:

    # aa "(whispering) She killed my mother!"
    aa "(шепотом) Она убила мою мать!"

# game/Story02.rpy:3474
translate russian akt2chapter5_1_829c5de7:

    # a "MURDERER!"
    a "УБИЙЦА!"

# game/Story02.rpy:3478
translate russian akt2chapter5_1_671c70d0:

    # a "Get out! We don’t need your kind of justice!"
    a "Убирайтесь! Нам не нужна ваша справедливость!"

# game/Story02.rpy:3479
translate russian akt2chapter5_1_c753cdb0:

    # k "They’ve got plenty to say."
    k "Сказать им есть что."

# game/Story02.rpy:3481
translate russian akt2chapter5_1_55615d34:

    # k "Just not when I’m close enough to hear it."
    k "Просто не тогда, когда я стою достаточно близко, чтобы услышать."

# game/Story02.rpy:3483
translate russian akt2chapter5_1_9d8021bb:

    # mc "(All these looks…)"
    mc "(Все эти взгляды...)"

# game/Story02.rpy:3484
translate russian akt2chapter5_1_6ec99741:

    # mc "(whispering) Liv, stay ready."
    mc "(шепотом) Лив, будь готова."

# game/Story02.rpy:3487
translate russian akt2chapter5_1_d3a00846:

    # mc "Wait for my call."
    mc "Жди моей команды."

# game/Story02.rpy:3488
translate russian akt2chapter5_1_27fbc5df:

    # w "What’s all that noise?"
    w "Что за шум?"

# game/Story02.rpy:3491
translate russian akt2chapter5_1_a9040206:

    # w "…Sounds like surface trash."
    w "...Похоже на мусор с поверхности."

# game/Story02.rpy:3492
translate russian akt2chapter5_1_a3322b32:

    # aS "Oh, come on. You already know why they’re here."
    aS "Ой, да брось. Ты же знаешь, зачем они здесь."

# game/Story02.rpy:3494
translate russian akt2chapter5_1_1d9c9340:

    # aS "Smile a little more… we have guests."
    aS "Улыбнись хоть немного... у нас гости."

# game/Story02.rpy:3496
translate russian akt2chapter5_1_f7c7ac0d:

    # w "I’m glad…"
    w "Я рад..."

# game/Story02.rpy:3498
translate russian akt2chapter5_1_7753cc84:

    # w "…and I’ll be even gladder when they’re gone."
    w "...а еще больше обрадуюсь, когда они уйдут."

# game/Story02.rpy:3499
translate russian akt2chapter5_1_3b78cefa:

    # aS "Yo Winter, do as you want."
    aS "Эй, Винтер, поступай как хочешь."

# game/Story02.rpy:3501
translate russian akt2chapter5_1_75bb0dab:

    # aS "But don’t rush with your decision."
    aS "Но с решением не спеши."

# game/Story02.rpy:3505
translate russian akt2chapter5_1_c70ecb03:

    # w "Do you even realize her life’s hanging by a thread here?"
    w "Ты хоть понимаешь, что ее жизнь здесь висит на волоске?"

# game/Story02.rpy:3507
translate russian akt2chapter5_1_f62beee1:

    # w "I’m not the kind of man who looks away from blood on someone’s hands."
    w "Я не из тех, кто отворачивается, увидев кровь на чьих-то руках."

# game/Story02.rpy:3508
translate russian akt2chapter5_1_222c871d:

    # aS "Respect won’t do you any good if you end up dead."
    aS "Принципы тебя не спасут, если ты закончишь мертвецом."

# game/Story02.rpy:3509
translate russian akt2chapter5_1_120238ca:

    # w "…Is that a threat?"
    w "...Это угроза?"

# game/Story02.rpy:3512
translate russian akt2chapter5_1_365de02b:

    # aS "I’m warning you. Or have you decided to go against Ember?"
    aS "Я тебя предупреждаю. Или ты решил пойти против Эмбер?"

# game/Story02.rpy:3514
translate russian akt2chapter5_1_b6ce435f:

    # w "Ellie…?"
    w "Элли...?"

# game/Story02.rpy:3515
translate russian akt2chapter5_1_0c2b0a31:

    # Mi "…I know you’ve heard about what’s happening on the surface."
    Mi "...Я знаю, ты слышал, что происходит на поверхности."

# game/Story02.rpy:3517
translate russian akt2chapter5_1_f80c8fbd:

    # w "Yeah… and didn’t like what I heard."
    w "Да... и услышанное мне не понравилось."

# game/Story02.rpy:3518
translate russian akt2chapter5_1_e394a7f2:

    # w "You with them because of that?"
    w "Поэтому ты с ними?"

# game/Story02.rpy:3519
translate russian akt2chapter5_1_da3fdbf1_1:

    # Mi "..."
    Mi "..."

# game/Story02.rpy:3521
translate russian akt2chapter5_1_3fb97f92:

    # Mi "I’m here to collect what you owe."
    Mi "Я здесь, чтобы забрать то, что ты должен."

# game/Story02.rpy:3529
translate russian akt2chapter5_1_c9d81fd8:

    # h "(whispering) That Winter guy… he’s not taking his eyes off you."
    h "(шепотом) Этот Винтер... глаз с тебя не сводит."

# game/Story02.rpy:3531
translate russian akt2chapter5_1_cdc20e2f:

    # k "I can feel that without you."
    k "Я и без тебя это чувствую."

# game/Story02.rpy:3533
translate russian akt2chapter5_1_39aa651e:

    # h "(whispering) If this turns into a fight, what’s the plan?"
    h "(шепотом) Если все перейдет в драку, какой план?"

# game/Story02.rpy:3534
translate russian akt2chapter5_1_48d60aec:

    # mc "Liv, you take the rear. Hold the left."
    mc "Лив, прикрываешь тыл. Держи левый фланг."

# game/Story02.rpy:3535
translate russian akt2chapter5_1_c7dda7fb:

    # mc "Kalestra… Winter’s yours."
    mc "Калестра... Винтер на тебе."

# game/Story02.rpy:3538
translate russian akt2chapter5_1_443d6f91:

    # k "Don’t get in my way."
    k "Не мешайся под ногами."

# game/Story02.rpy:3539
translate russian akt2chapter5_1_46319a6f:

    # h "And you?"
    h "А ты?"

# game/Story02.rpy:3540
translate russian akt2chapter5_1_2b35b6fe_2:

    # mc "..."
    mc "..."

# game/Story02.rpy:3545
translate russian akt2chapter5_1_643ddf19:

    # mc "I’ll handle it."
    mc "Разберусь."

# game/Story02.rpy:3547
translate russian akt2chapter5_1_0d04128e_1:

    # w "..."
    w "..."

# game/Story02.rpy:3566
translate russian akt2chapter5_1_9c477ce7:

    # w "I’ll be straight with you."
    w "Скажу прямо."

# game/Story02.rpy:3567
translate russian akt2chapter5_1_098fe0d5:

    # w "You’re not welcome here."
    w "Вам здесь не рады."

# game/Story02.rpy:3568
translate russian akt2chapter5_1_0d0fb9cd:

    # w "…But you’re staying."
    w "...Но вы останетесь."

# game/Story02.rpy:3572
translate russian akt2chapter5_1_b3171147:

    # w "For Ember."
    w "Ради Эмбер."

# game/Story02.rpy:3573
translate russian akt2chapter5_1_f66df46f:

    # mc "Goes both ways."
    mc "Взаимно."

# game/Story02.rpy:3581
translate russian akt2chapter5_1_da2b61e6:

    # mc "Now— let’s get to it."
    mc "Теперь... к делу."

# game/Story02.rpy:3582
translate russian akt2chapter5_1_a390c19b:

    # Fl "She’s buried in work right now."
    Fl "Она сейчас по уши в работе."

# game/Story02.rpy:3585
translate russian akt2chapter5_1_96c5adc2:

    # Fl "She’ll be here soon."
    Fl "Скоро будет здесь."

# game/Story02.rpy:3588
translate russian akt2chapter5_1_6f1d7cd7:

    # h "You’re awfully calm… considering what’s going on out there."
    h "Ты пугающе спокойна... учитывая, что творится снаружи."

# game/Story02.rpy:3589
translate russian akt2chapter5_1_23abc4e0:

    # Fl "And you’re still just as talkative."
    Fl "А ты все такая же разговорчивая."

# game/Story02.rpy:3590
translate russian akt2chapter5_1_7d20456b:

    # h "…Glad you’re alive."
    h "...Рада, что ты жива."

# game/Story02.rpy:3592
translate russian akt2chapter5_1_b974504b:

    # Fl "...Yeah."
    Fl "...Ага."

# game/Story02.rpy:3594
translate russian akt2chapter5_1_8e9d16ea:

    # mc "You did good."
    mc "Ты хорошо справилась."

# game/Story02.rpy:3600
translate russian akt2chapter5_1_bc0a3d20:

    # Fl "Worse than it looks."
    Fl "Все хуже, чем выглядит."

# game/Story02.rpy:3602
translate russian akt2chapter5_1_d8272412:

    # Fl "(whispering) …I’m glad you made it."
    Fl "(шепотом) ...Рада, что ты добрался."

# game/Story02.rpy:3604
translate russian akt2chapter5_1_a5d8d2e1:

    # mc "…You holding up?"
    mc "...Держишься?"

# game/Story02.rpy:3605
translate russian akt2chapter5_1_ce7728d6:

    # Fl "(whispering) I’ve been trying not to lose my mind."
    Fl "(шепотом) Я стараюсь не сойти с ума."

# game/Story02.rpy:3607
translate russian akt2chapter5_1_33342ed3:

    # Fl "(whispering) With everything happening out there…"
    Fl "(шепотом) После всего, что там происходит..."

# game/Story02.rpy:3609
translate russian akt2chapter5_1_19a02689:

    # mc "What did you find?"
    mc "Что ты нашла?"

# game/Story02.rpy:3610
translate russian akt2chapter5_1_e3d0b78d:

    # Fl "Thanks to you? Yeah."
    Fl "Благодаря тебе? Кое-что."

# game/Story02.rpy:3611
translate russian akt2chapter5_1_60865b9c:

    # Fl "But it’s incomplete."
    Fl "Но картина неполная."

# game/Story02.rpy:3613
translate russian akt2chapter5_1_8500cb9b:

    # Fl "Too many gaps."
    Fl "Слишком много пробелов."

# game/Story02.rpy:3615
translate russian akt2chapter5_1_a03ba5fa:

    # mc "(Ostorius sent you the report.)"
    mc "(Осториус прислал тебе отчет.)"

# game/Story02.rpy:3616
translate russian akt2chapter5_1_51fa70f5:

    # mc "You already know."
    mc "Ты уже знаешь."

# game/Story02.rpy:3618
translate russian akt2chapter5_1_d37f1f23:

    # mc "You just don’t want to accept it."
    mc "Просто не хочешь принять."

# game/Story02.rpy:3621
translate russian akt2chapter5_1_0e622370:

    # Fl "Accepting that means questioning Astoria."
    Fl "Принять это значит усомниться в Астории."

# game/Story02.rpy:3623
translate russian akt2chapter5_1_45785cab:

    # Fl "And I haven’t lost what’s left of my sanity just yet."
    Fl "А остатки рассудка я пока еще не растеряла."

# game/Story02.rpy:3625
translate russian akt2chapter5_1_cdb81318:

    # Fl "If a traitor was allowed to pull this off—"
    Fl "Если предателю дали провернуть такое..."

# game/Story02.rpy:3627
translate russian akt2chapter5_1_b2da4e90:

    # Fl "Then Astoria herself is on their side."
    Fl "значит, сама Астория на их стороне."

# game/Story02.rpy:3628
translate russian akt2chapter5_1_af0950b6:

    # mc "...And for what?"
    mc "...И ради чего?"

# game/Story02.rpy:3630
translate russian akt2chapter5_1_514b744a:

    # mc "She already had everything."
    mc "У нее ведь уже было все."

# game/Story02.rpy:3631
translate russian akt2chapter5_1_41da62cb_1:

    # Fl "..."
    Fl "..."

# game/Story02.rpy:3641
translate russian akt2chapter5_1_7ed81dc0:

    # Fl "And that’s the worst part."
    Fl "И вот это хуже всего."

# game/Story02.rpy:3642
translate russian akt2chapter5_1_3c073c86:

    # mc "Talk, Flora."
    mc "Говори, Флора."

# game/Story02.rpy:3647
translate russian akt2chapter5_1_484f1716:

    # Fl "(quietly) Not here."
    Fl "(тихо) Не здесь."

# game/Story02.rpy:3649
translate russian akt2chapter5_1_832b01f8:

    # Fl "First, clean yourselves up."
    Fl "Сначала приведите себя в порядок."

# game/Story02.rpy:3651
translate russian akt2chapter5_1_7b5e56b2:

    # Fl "And keep your voices down."
    Fl "И говорите тише."

# game/Story02.rpy:3653
translate russian akt2chapter5_1_d30dd6a3:

    # k "...You know… we had to get our hands dirty."
    k "...Ты же знаешь... нам пришлось запачкать руки."

# game/Story02.rpy:3654
translate russian akt2chapter5_1_c521d4dd:

    # Fl "I know."
    Fl "Знаю."

# game/Story02.rpy:3658
translate russian akt2chapter5_1_990f303f:

    # Fl "Or rather… I can smell it."
    Fl "Вернее... я это чувствую по запаху."

# game/Story02.rpy:3660
translate russian akt2chapter5_1_9678462c:

    # w "Showers down the hall to the left."
    w "Душевые по коридору налево."

# game/Story02.rpy:3684
translate russian akt2chapter5_1_691c0fb6:

    # aS "And welcome to the Blue Moon."
    aS "И добро пожаловать в Голубую луну."

# game/Story02.rpy:3911
translate russian akt2chapter6_469ca2fe:

    # k "Hey, pointy-ears"
    k "Эй, остроухая."

# game/Story02.rpy:3914
translate russian akt2chapter6_19b9d7d6:

    # k "You’re from here, aren’t you? I’m not mistaken."
    k "Ты ведь отсюда, да? Я не ошиблась."

# game/Story02.rpy:3918
translate russian akt2chapter6_d703d166:

    # Mi "…What do you want?"
    Mi "...Что тебе нужно?"

# game/Story02.rpy:3919
translate russian akt2chapter6_5b1abd2c:

    # k "Ugh..."
    k "Ух..."

# game/Story02.rpy:3922
translate russian akt2chapter6_f778342c:

    # k "Just answer the question."
    k "Просто ответь на вопрос."

# game/Story02.rpy:3923
translate russian akt2chapter6_f1a1b640:

    # Mi "…Yeah."
    Mi "...Да."

# game/Story02.rpy:3927
translate russian akt2chapter6_7dec881e:

    # k "Well, would you look at that… you want me dead too, just like the rest?"
    k "Ну надо же... ты тоже хочешь моей смерти, как и все остальные?"

# game/Story02.rpy:3929
translate russian akt2chapter6_82bc357e:

    # Mi "…I did."
    Mi "...Хотела."

# game/Story02.rpy:3932
translate russian akt2chapter6_16bea23a:

    # k "What changed?"
    k "Что изменилось?"

# game/Story02.rpy:3933
translate russian akt2chapter6_e23b08ca:

    # Mi "I saw you suffer."
    Mi "Я увидела, как ты страдаешь."

# game/Story02.rpy:3935
translate russian akt2chapter6_c83a264f:

    # Mi "…It’s better than a quick death."
    Mi "...Это лучше быстрой смерти."

# game/Story02.rpy:3937
translate russian akt2chapter6_827d88af:

    # k "Heh… cruel."
    k "Хех... жестоко."

# game/Story02.rpy:3939
translate russian akt2chapter6_1381be2c:

    # Mi "…Everything has a price."
    Mi "...У всего есть цена."

# game/Story02.rpy:3940
translate russian akt2chapter6_dda17f46:

    # Fl "Honestly…"
    Fl "Честно..."

# game/Story02.rpy:3941
translate russian akt2chapter6_bd45308a:

    # Fl "I’m surprised you haven’t torn each other apart yet."
    Fl "Я удивлена, что вы еще не разорвали друг друга."

# game/Story02.rpy:3942
translate russian akt2chapter6_0427149d:

    # Fl "Then again—"
    Fl "Хотя..."

# game/Story02.rpy:3945
translate russian akt2chapter6_05141d11:

    # Fl "you don’t really have that option, do you?"
    Fl "такого варианта у вас, по сути, нет, верно?"

# game/Story02.rpy:3946
translate russian akt2chapter6_94c96913:

    # Fl "Anyway."
    Fl "Ладно."

# game/Story02.rpy:3948
translate russian akt2chapter6_1434e83e:

    # Fl "Here’s something I’ve been wondering…"
    Fl "Вот что мне интересно..."

# game/Story02.rpy:3950
translate russian akt2chapter6_162d358f:

    # Fl "How fast does loyalty actually break?"
    Fl "Как быстро на самом деле ломается преданность?"

# game/Story02.rpy:3954
translate russian akt2chapter6_b41ff391:

    # k "...What did you just say?"
    k "...Что ты сейчас сказала?"

# game/Story02.rpy:3955
translate russian akt2chapter6_c92badcd:

    # Fl "Relax."
    Fl "Расслабься."

# game/Story02.rpy:3957
translate russian akt2chapter6_72643fc8:

    # Fl "It’s a theoretical question."
    Fl "Это теоретический вопрос."

# game/Story02.rpy:3958
translate russian akt2chapter6_f6716d23:

    # Mi "…That…"
    Mi "...Это..."

# game/Story02.rpy:3961
translate russian akt2chapter6_82091822_2:

    # k "..."
    k "..."

# game/Story02.rpy:3964
translate russian akt2chapter6_47020de8:

    # k "You’re crossing a line."
    k "Ты переходишь черту."

# game/Story02.rpy:3965
translate russian akt2chapter6_ac8c4702:

    # h "No one in their right mind would go for that."
    h "Никто в здравом уме на такое не пойдет."

# game/Story02.rpy:3967
translate russian akt2chapter6_b33f88f8:

    # h "No way. Not happening."
    h "Ни за что. Даже не обсуждается."

# game/Story02.rpy:3969
translate russian akt2chapter6_bf7380e2:

    # Fl "Didn’t realize you were that naive."
    Fl "Не думала, что ты настолько наивна."

# game/Story02.rpy:3972
translate russian akt2chapter6_fb05e2b0:

    # h "Naive? You just suggested betrayal!"
    h "Наивна? Ты только что предложила предательство!"

# game/Story02.rpy:3973
translate russian akt2chapter6_9fd59fe7:

    # Fl "I asked a question."
    Fl "Я задала вопрос."

# game/Story02.rpy:3974
translate russian akt2chapter6_8afe0d2a:

    # Fl "I didn’t make an offer."
    Fl "Никаких предложений я не делала."

# game/Story02.rpy:3976
translate russian akt2chapter6_61cb915f:

    # Fl "Or is nuance not your thing?"
    Fl "Или нюансы не твоя сильная сторона?"

# game/Story02.rpy:3977
translate russian akt2chapter6_693a3716:

    # k "Shorty’s got a point."
    k "Коротышка дело говорит."

# game/Story02.rpy:3979
translate russian akt2chapter6_013874e9:

    # k "People don’t live long after that."
    k "После такого долго не живут."

# game/Story02.rpy:3980
translate russian akt2chapter6_634e00f2:

    # Mi "…It depends on the circumstances."
    Mi "...Зависит от обстоятельств."

# game/Story02.rpy:3981
translate russian akt2chapter6_7557ec56:

    # k "...Dangerous way to think."
    k "...Опасный ход мыслей."

# game/Story02.rpy:3984
translate russian akt2chapter6_3416db44:

    # h "I might be dumb, but I can read the room."
    h "Может, я и тупая, но обстановку считывать умею."

# game/Story02.rpy:3989
translate russian akt2chapter6_e5935221:

    # h "So who exactly were you planning to betray?"
    h "Так кого именно ты собиралась предать?"

# game/Story02.rpy:3990
translate russian akt2chapter6_50917e09:

    # mc "Astoria."
    mc "Асторию."

# game/Story02.rpy:3993
translate russian akt2chapter6_0159b6f5:

    # mc "I’m right?"
    mc "Я прав?"

# game/Story02.rpy:3994
translate russian akt2chapter6_82091822_3:

    # k "..."
    k "..."

# game/Story02.rpy:3996
translate russian akt2chapter6_034054bc:

    # k "I’ll kill you."
    k "Я тебя убью."

# game/Story02.rpy:3997
translate russian akt2chapter6_c7902397:

    # mc "Before you start swinging—"
    mc "Прежде чем начнешь бросаться..."

# game/Story02.rpy:4001
translate russian akt2chapter6_c84e90ba:

    # mc "let’s hear the reason."
    mc "выслушаем причину."

# game/Story02.rpy:4003
translate russian akt2chapter6_1c371cc7:

    # aS "Wait… you’re seriously not aware?"
    aS "Стойте... вы правда не в курсе?"

# game/Story02.rpy:4005
translate russian akt2chapter6_f6cee26f:

    # aS "The whole city’s already buzzing with—"
    aS "Весь город уже гудит от..."

# game/Story02.rpy:4007
