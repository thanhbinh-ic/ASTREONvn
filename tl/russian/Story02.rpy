translate russian akt2chapter2_db8e3588:

    # h "Great. {w}But compromises go both ways, don’t they? {w}Or is that part conveniently ignored?"
    h "Отлично. {w}Но компромиссы должны быть обоюдными, не так ли?{w} Или эту часть удобно игнорировать?"

# game/Story02.rpy:973
translate russian akt2chapter2_da3fdbf1_4:

    # Mi "..."
    Mi "..."

