translate russian akt2chapter5_65ee00b7:

    # mc "(Maybe the climate isn’t great, but... there’s something about it. Something... pulling.)"
    mc "(Возможно, климат здесь не очень, но... в этом что-то есть. Что-то... притягивающее.)"

# game/Story02.rpy:2788
translate russian akt2chapter5_ae5f4275:

