translate russian akt2chapter5_1_4b356c83:

    # Mi "…They won’t kill us."
    Mi "...Они нас не убьют."

# game/Story02.rpy:3389
translate russian akt2chapter5_1_edc06ad1:

    # Mi "…Not yet."
    Mi "...Пока нет."

# game/Story02.rpy:3393
translate russian akt2chapter5_1_a4909daf:

    # h "Oh great… let’s hope it stays that way."
    h "О, отлично... будем надеяться, так и останется."

# game/Story02.rpy:3395
translate russian akt2chapter5_1_363c0ece:

    # k "For once… I agree with you."
    k "Редкий случай... но я с тобой согласна."

# game/Story02.rpy:3396
translate russian akt2chapter5_1_38edd526:

    # mc "(The way they’re looking…)"
    mc "(Как они смотрят...)"

# game/Story02.rpy:3397
translate russian akt2chapter5_1_57498869:

    # mc "They’re judging."
    mc "Они оценивают."

# game/Story02.rpy:3399
translate russian akt2chapter5_1_105c5a4e:

    # k "They’re sizing you up."
    k "Прикидывают, чего ты стоишь."

# game/Story02.rpy:3401
translate russian akt2chapter5_1_c42b05ac:

    # mc "And?"
    mc "И?"

# game/Story02.rpy:3404
translate russian akt2chapter5_1_3ac68df7:

    # k "As you can see… you’re still alive."
    k "Как видишь... ты все еще жив."

# game/Story02.rpy:3407
translate russian akt2chapter5_1_3b87ef3b:

    # mc "(She’s staring too hard.)"
    mc "(Она слишком пристально смотрит.)"

# game/Story02.rpy:3408
translate russian akt2chapter5_1_27bb7259:

    # mc "Say it."
    mc "Говори."

# game/Story02.rpy:3410
translate russian akt2chapter5_1_a8135c1c:

    # aS "You… You sound strange."
    aS "Ты... у тебя странный голос."

# game/Story02.rpy:3414
translate russian akt2chapter5_1_80b08ac3:

    # mc "First the city."
    mc "Сначала город."

# game/Story02.rpy:3415
translate russian akt2chapter5_1_cc27b883:

    # mc "Now it’s two souls."
    mc "Теперь две души."

# game/Story02.rpy:3417
translate russian akt2chapter5_1_91116777:

    # mc "You people see ghosts everywhere."
    mc "Вы тут повсюду видите призраков."

# game/Story02.rpy:3418
translate russian akt2chapter5_1_b040b3a5:

    # aS "Reminds me of…"
    aS "Напоминает мне..."

# game/Story02.rpy:3422
translate russian akt2chapter5_1_b7345a5a:

    # aS "(Whispering) Evrelia."
    aS "(шепотом) Эврелию."

