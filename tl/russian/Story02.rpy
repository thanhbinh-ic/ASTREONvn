translate russian akt2chapter5_5cf1faeb:

    # mc "And you?"
    mc "А ты?"

# game/Story02.rpy:3343
translate russian akt2chapter5_c35ed0a0:

    # aS "Aisha."
    aS "Айша."

# game/Story02.rpy:3348
translate russian akt2chapter5_7372ec8e:

    # aS "One and only. The greatest idol in the galaxy."
    aS "Единственная и неповторимая. Величайший айдол галактики."

