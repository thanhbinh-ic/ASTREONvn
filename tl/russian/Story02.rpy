    h "...Что это было?"

# game/Story02.rpy:3127
translate russian akt2chapter4_54d9e503:

    # mc "...It’s fine. Just—"
    mc "...Все нормально. Просто..."

# game/Story02.rpy:3129
translate russian akt2chapter4_3182f744:

    # h "What, getting nervous?"
    h "Что, нервничаешь?"

# game/Story02.rpy:3131
translate russian akt2chapter4_d875ef64:

    # mc "...Forget it."
    mc "...Забудь."

# game/Story02.rpy:3134
translate russian akt2chapter4_a837bc6c:

    # mc "(…Not now.)"
    mc "(...Не сейчас.)"

# game/Story02.rpy:3137
translate russian akt2chapter4_82987a0d:

    # h "...You getting nervous about this meeting?"
    h "...Ты из-за этой встречи нервничаешь?"

# game/Story02.rpy:3145
translate russian akt2chapter4_c300082f:

    # mc "...Yeah."
    mc "...Да."

# game/Story02.rpy:3148
translate russian akt2chapter4_4e1bd473:

    # mc "(…Pain’s getting worse.)"
    mc "(...Боль усиливается.)"

# game/Story02.rpy:3165
translate russian akt2chapter5_251902b0:

    # "Sector 6. Level 2. Lower Town."
    "Сектор 6. Уровень 2. Нижний город."

# game/Story02.rpy:3169
translate russian akt2chapter5_488c1bef:

    # k "All this time… and the air’s still just as unbreathable."
    k "Столько времени прошло... а воздух все такой же непригодный для дыхания."

# game/Story02.rpy:3172
translate russian akt2chapter5_21667a28:

    # k "Brings back memories."
    k "Навевает воспоминания."

# game/Story02.rpy:3174
translate russian akt2chapter5_c2e7cf9b:

    # Mi "…That’s not why we’re here."
    Mi "...Мы здесь не за этим."

# game/Story02.rpy:3176
translate russian akt2chapter5_90ba2d8d:

    # mc "Lower Town…?"
    mc "Нижний город...?"

# game/Story02.rpy:3178
translate russian akt2chapter5_515335e3:

    # k "That’s right. Looks like shit."
    k "Именно. Выглядит как дерьмо."

# game/Story02.rpy:3179
translate russian akt2chapter5_35cded66:

    # k "Is shit."
    k "Дерьмо и есть."

# game/Story02.rpy:3180
translate russian akt2chapter5_8117b3c7:

    # k "Welcome…"
    k "Добро пожаловать..."

# game/Story02.rpy:3181
translate russian akt2chapter5_9db8f26b:

    # k "To broken dreams."
    k "туда, где мечты ломаются."

# game/Story02.rpy:3183
translate russian akt2chapter5_e94dedf9:

    # Mi "…People used to come here chasing their dreams."
    Mi "...Когда-то люди приходили сюда за своими мечтами."

# game/Story02.rpy:3187
translate russian akt2chapter5_cfd217e8:

    # h "Huh. Wonder what went wrong..."
    h "Хм. Интересно, что же пошло не так..."

# game/Story02.rpy:3188
translate russian akt2chapter5_81f78057:

    # h "Care to explain, Kalestra?"
    h "Объяснишь, Калестра?"

# game/Story02.rpy:3190
translate russian akt2chapter5_4153f687:

    # k "What are you implying?"
    k "На что ты намекаешь?"

# game/Story02.rpy:3192
translate russian akt2chapter5_d0156362:

    # k "This isn’t your mess to deal with."
    k "Это не твое дерьмо, чтобы в нем копаться."

# game/Story02.rpy:3199
translate russian akt2chapter5_8b9ee863:

    # mc "Enough."
    mc "Хватит."

# game/Story02.rpy:3203
translate russian akt2chapter5_c3594bf3:

    # mc "...Liv, ease off her."
    mc "...Лив, не дави на нее."

# game/Story02.rpy:3204
translate russian akt2chapter5_5b2d93a8:

    # h "I’m not pushing—"
    h "Я не давлю..."

# game/Story02.rpy:3205
translate russian akt2chapter5_d6f44a4e:

    # mc "You are."
    mc "Давишь."

# game/Story02.rpy:3206
translate russian akt2chapter5_b5d2d689:

    # mc "Or you trying to take it out on her?"
    mc "Или ты пытаешься сорваться на ней?"

# game/Story02.rpy:3207
translate russian akt2chapter5_4fe8f3b9:

    # h "Wh-"
    h "Чт..."

# game/Story02.rpy:3209
translate russian akt2chapter5_d5d5dbab:

    # Mi "…I agree with Liv."
    Mi "...Я согласна с Лив."

# game/Story02.rpy:3210
translate russian akt2chapter5_406ca6a3:

    # Mi "…Without her, we would’ve—"
    Mi "...Без нее мы бы..."

# game/Story02.rpy:3212
translate russian akt2chapter5_bddc3da7:

    # Mi "…Why are you defending her?"
    Mi "...Почему ты ее защищаешь?"

# game/Story02.rpy:3214
translate russian akt2chapter5_8c678df2:

    # mc "She’s the one who pulled me out of the gutter."
    mc "Она вытащила меня из канавы."

# game/Story02.rpy:3215
translate russian akt2chapter5_3c99be2a:

    # Mi "…So did we."
    Mi "...Мы тоже."

# game/Story02.rpy:3216
translate russian akt2chapter5_b3ecaeb2:

    # k "Heh… look at you. Just got here, and the city’s already getting to you."
    k "Хех... вы только посмотрите на себя. Едва пришли, а город уже забирается вам под кожу."

# game/Story02.rpy:3219
translate russian akt2chapter5_461c77bc:

    # mc "(...Broken dreams, huh.)"
    mc "(...Разбитые мечты, значит.)"

# game/Story02.rpy:3220
translate russian akt2chapter5_323d6a2e:

    # mc "You’re getting in your own head, Kalestra."
    mc "Ты сама себя накручиваешь, Калестра."

# game/Story02.rpy:3222
translate russian akt2chapter5_20f40611:

    # k "That coming from someone who believes in an afterlife?"
    k "И это говорит тот, кто верит в загробную жизнь?"

# game/Story02.rpy:3223
translate russian akt2chapter5_490f41b8:

    # mc "Big words… from someone scared to die."
    mc "Громкие слова... для того, кто боится умереть."

# game/Story02.rpy:3228
translate russian akt2chapter5_fce2be70:

    # k "…You’ll see."
    k "...Сам увидишь."

# game/Story02.rpy:3237
translate russian akt2chapter5_cd7d2030:

    # k "Move."
    k "Идем."

# game/Story02.rpy:3240
translate russian akt2chapter5_c5f7cb82:

    # mc "Liv. A minute."
    mc "Лив. На минуту."

# game/Story02.rpy:3245
translate russian akt2chapter5_9292a96c:

    # h "I’m doing everything I can here, alright?"
    h "Я делаю все, что могу, ясно?"

# game/Story02.rpy:3249
translate russian akt2chapter5_734c3d21:

    # h "With her attitude? There’s no way this ends peacefully."
    h "С ее-то характером? Это никак не закончится мирно."

# game/Story02.rpy:3253
translate russian akt2chapter5_56e6de2f:

    # mc "You’ve been where she is."
    mc "Ты уже была на ее месте."

# game/Story02.rpy:3254
translate russian akt2chapter5_3132cfec:

    # mc "Or you want me to remind you?"
    mc "Или мне напомнить?"

# game/Story02.rpy:3256
translate russian akt2chapter5_0099b01d:

    # h "I wouldn’t give a damn—"
    h "Мне было бы плев..."

# game/Story02.rpy:3258
translate russian akt2chapter5_dedc06eb:

    # mc "Liv. Truth."
    mc "Лив. Честно."

# game/Story02.rpy:3260
translate russian akt2chapter5_de829e3a:

    # h "Like shit."
    h "Дерьмово."

# game/Story02.rpy:3264
translate russian akt2chapter5_cfcc2293:

    # mc "I know."
    mc "Я знаю."

# game/Story02.rpy:3268
translate russian akt2chapter5_48324d20:

    # h "…Fine."
    h "...Ладно."

# game/Story02.rpy:3269
translate russian akt2chapter5_f7fc5af8:

    # mc "Let’s go."
    mc "Пойдем."

# game/Story02.rpy:3282
translate russian akt2chapter5_c92445d2:

    # Mi "…We were told to wait."
    Mi "...Нам велели ждать."

# game/Story02.rpy:3284
translate russian akt2chapter5_37341d0d:

    # k "We don’t wait."
    k "Мы не ждем."

# game/Story02.rpy:3287
translate russian akt2chapter5_d107ea32:

    # k "Not my problem you took your sweet time getting here."
    k "Не мои проблемы, что вы тащились сюда целую вечность."

# game/Story02.rpy:3292
translate russian akt2chapter5_8f9eee42:

    # h "Oh, sorry for being just a regular human."
    h "Ой, прости, что я всего лишь обычный человек."

# game/Story02.rpy:3295
translate russian akt2chapter5_fbdf8f78:

    # h "(Easy… you said you wouldn’t.)"
    h "(Спокойно... ты сказала, что не станешь.)"

# game/Story02.rpy:3298
translate russian akt2chapter5_d680d4d6:

    # k "Wow… not gonna finish that?"
    k "Ого... не договоришь?"

# game/Story02.rpy:3301
translate russian akt2chapter5_f5381b5e:

    # h "Not for you. Trust me."
    h "Не для тебя. Уж поверь."

# game/Story02.rpy:3302
translate russian akt2chapter5_dd6ad064:

    # mc "(Quiet.)"
    mc "(Тихо.)"

# game/Story02.rpy:3304
translate russian akt2chapter5_d73d702c:

    # mc "(…I can see why people came.)"
    mc "(...Я понимаю, почему люди сюда приходили.)"

