    old "Classified Archive. Clearance Level: Δ–VI"
    new "机密档案。许可等级：Δ–VI"

    # game/codex.rpy:2030
    old "Section: Chronological and Ontological Structures"
    new "章节：时间与本体结构"

    # game/codex.rpy:2031
    old "Subsection: Ontological Deviation"
    new "小节：本体偏差"

    # game/codex.rpy:2032
    old "Status: Observable Phenomenon"
    new "状态：可观测现象"

    # game/codex.rpy:2037
    old "I. Definition"
    new "一、定义"

    # game/codex.rpy:2039
    old "Parallel Threads are autonomous branches of reality that have diverged from the Main Thread of the World."
    new "平行线程是从世界主线程分离出的自主现实分支。"

    # game/codex.rpy:2041
    old "By their nature, each thread constitutes:"
    new "就其本质而言，每个线程构成："

    # game/codex.rpy:2042
    old "an independent universe;"
    new "一个独立宇宙；"

    # game/codex.rpy:2043
    old "with its own chain of causality;"
    new "拥有自己的因果链；"

    # game/codex.rpy:2044
    old "with variations of history, outcomes, and states of matter."
    new "具有历史、结果和物质状态的变化。"

    # game/codex.rpy:2046
    old "All threads exist simultaneously and are interconnected within a single ontological system."
    new "所有线程同时存在，并在单一本体系统内相互连接。"

    # game/codex.rpy:2048
    old "II. Principle of Divergence"
    new "二、分歧原理"

    # game/codex.rpy:2050
    old "The formation of parallel threads occurs at moments of critical probability, when reality allows more than one admissible outcome."
    new "平行线程形成于临界概率时刻，即现实允许一个以上可接受结果时。"

    # game/codex.rpy:2052
    old "An analogy deemed acceptable for explanatory purposes to lower ranks:"
    new "向低级别人员解释时可接受的类比："

    # game/codex.rpy:2053
    old "the principle of multiple observational states (see: Astreon paradox)."
    new "多重观测态原理（见：阿斯特雷昂悖论）。"

    # game/codex.rpy:2055
    old "Each thread records one realized outcome, while all remaining possibilities form separate branches of existence."
    new "每个线程记录一个已实现的结果，而所有剩余可能性形成独立的存在分支。"

    # game/codex.rpy:2057
    old "III. Degree of World Similarity"
    new "三、世界相似度"

    # game/codex.rpy:2059
    old "At early stages of divergence, parallel threads may:"
    new "在分歧早期阶段，平行线程可能："

    # game/codex.rpy:2060
    old "almost entirely replicate the Main Thread;"
    new "几乎完全复制主线程；"

    # game/codex.rpy:2061
    old "differ only by minor events;"
    new "仅因微小事件而不同；"

    # game/codex.rpy:2062
    old "possess identical territories, individuals, and power structures."
    new "拥有相同的领土、个人和权力结构。"

    # game/codex.rpy:2064
    old "As temporal distance increases, differences accumulate, leading to radical divergences:"
    new "随着时间距离增加，差异累积，导致根本性分歧："

    # game/codex.rpy:2065
    old "cultural;"
    new "文化；"

    # game/codex.rpy:2066
    old "biological;"
    new "生物；"

    # game/codex.rpy:2067
    old "technological;"
    new "技术；"

    # game/codex.rpy:2068
    old "existential."
    new "存在性。"

    # game/codex.rpy:2070
    old "IV. Thread Interconnectivity"
    new "四、线程互联性"

    # game/codex.rpy:2072
    old "All threads:"
    new "所有线程："

    # game/codex.rpy:2073
    old "are not fully isolated;"
    new "并非完全孤立；"

    # game/codex.rpy:2074
    old "exist within a shared chronological framework;"
    new "存在于共享的时间框架内；"

    # game/codex.rpy:2075
    old "are subject to indirect influence upon one another."
    new "彼此之间受到间接影响。"

    # game/codex.rpy:2077
    old "Destabilization of a single thread may trigger:"
    new "单个线程的不稳定可能触发："

    # game/codex.rpy:2078
    old "resonant fluctuations;"
    new "共振波动；"

    # game/codex.rpy:2079
    old "thinning of boundaries;"
    new "边界变薄；"

    # game/codex.rpy:2080
    old "localized temporal ruptures."
    new "局部时间断裂。"

    # game/codex.rpy:2082
    old "V. THREAD WEAVERS"
    new "五、线程编织者"

    # game/codex.rpy:2084
    old "The existence of subjects capable of influencing parallel threads has been recorded."
    new "已记录能够影响平行线程的对象的存在。"

    # game/codex.rpy:2086
    old "Official designation: Weavers."
    new "官方指定：编织者。"

    # game/codex.rpy:2088
    old "VI. Capabilities"
    new "六、能力"

    # game/codex.rpy:2090
    old "Weavers are capable of:"
    new "编织者能够："

    # game/codex.rpy:2091
    old "perceiving the structure of threads;"
    new "感知线程结构；"

    # game/codex.rpy:2092
    old "shifting event probabilities;"
    new "改变事件概率；"

    # game/codex.rpy:2093
    old "strengthening or weakening individual branches;"
    new "增强或削弱个别分支；"

    # game/codex.rpy:2094
    old "in rare cases, initiating divergence."
    new "在极少数情况下，引发分歧。"

    # game/codex.rpy:2096
    old "VII. Limitations"
    new "七、局限"

    # game/codex.rpy:2098
    old "Weavers do not create threads ex nihilo."
    new "编织者不能凭空创造线程。"

    # game/codex.rpy:2099
    old "They operate exclusively within already permissible variants of reality."
    new "他们仅在已经允许的现实变体范围内运作。"

    # game/codex.rpy:2101
    old "Direct intervention:"
    new "直接干预："

    # game/codex.rpy:2102
    old "requires colossal resources;"
    new "需要巨量资源；"

    # game/codex.rpy:2103
    old "results in degradation of the bearer;"
    new "导致持有者退化；"

    # game/codex.rpy:2104
    old "significantly increases the risk of ontological collapse."
    new "显著增加本体崩溃的风险。"

    # game/codex.rpy:2106
    old "VIII. Weaver Status"
    new "八、编织者地位"

    # game/codex.rpy:2108
    old "All Weavers are classified as:"
    new "所有编织者被归类为："

    # game/codex.rpy:2109
    old "Subjects of Elevated Existential Risk."
    new "高存在风险对象。"

    # game/codex.rpy:2111
    old "Observation - mandatory."
    new "观察——强制。"

    # game/codex.rpy:2112
    old "Isolation - permissible."
    new "隔离——允许。"

    # game/codex.rpy:2113
    old "Elimination - authorized in the event of a threat to the integrity of the Main Thread."
    new "消除——在主线程完整性受到威胁时授权。"

    # game/codex.rpy:2115
    old "IX. Codex Warning"
    new "九、法典警告"

    # game/codex.rpy:2117
    old "There is no “better” thread."
    new "没有“更好”的线程。"

    # game/codex.rpy:2118
    old "There exists only the one that endured the pressure of time."
    new "只有承受了时间压力的那一个。"

    # game/codex.rpy:2120
    old "Any attempt to impose an “ideal outcome” upon reality results in the disintegration of the structure of existence."
    new "任何将“理想结果”强加于现实的尝试都会导致存在结构的解体。"

    # game/codex.rpy:2122
    old "X. Final Provision"
    new "十、最终条款"

    # game/codex.rpy:2124
    old "Parallel threads are not an error of creation. They are a consequence of probabilistic freedom."
    new "平行线程不是创造的错误。它们是概率自由的产物。"

    # game/codex.rpy:2126
    old "However, interference with them is equivalent to interference with the foundation of reality."
    new "然而，对它们的干涉等同于对现实基础的干涉。"

    # game/codex.rpy:2128
    old "The cost of error, the erasure of a world."
    new "错误的代价，是一个世界的抹除。"

    # game/codex.rpy:2161
    old "Section: Technologies of the Ancient Empire / Legacy of Hyperspatial Mechanisms"
    new "章节：古代帝国技术/超空间机制遗产"

    # game/codex.rpy:2162
    old "Subsection: Warp Drive"
    new "小节：曲速引擎"

    # game/codex.rpy:2163
    old "Status: Inquisition Oversight / Keeper Surveillance"
    new "状态：审判庭监督/守护者监视"

    # game/codex.rpy:2168
    old "I. General Description"
    new "一、概述"

    # game/codex.rpy:2170
    old "A Warp Drive is a high-technology mechanism capable of transporting objects across vast interstellar distances."
    new "曲速引擎是一种高科技机制，能够将物体运送穿越广阔星际距离。"

    # game/codex.rpy:2171
    old "Functionally, it serves as an analogue to the Gates, but on the scale of an individual spacecraft."
    new "在功能上，它类似于门，但适用于单个航天器的规模。"

    # game/codex.rpy:2172
    old "Each drive is an autonomous unit and is not integrated into the Astreon System."
    new "每个引擎是自主单元，未集成到阿斯特雷昂系统中。"

    # game/codex.rpy:2174
    old "Primary limitations include:"
    new "主要限制包括："

    # game/codex.rpy:2175
    old "restricted operational range;"
    new "受限的操作范围；"

    # game/codex.rpy:2176
    old "high resource consumption, including the Blood of the Ancients;"
    new "高资源消耗，包括古代之血；"

    # game/codex.rpy:2177
    old "a severely limited number of operational units within the galaxy."
    new "银河内运作单元数量严重受限。"

    # game/codex.rpy:2180
    old "II. History and Purpose"
    new "二、历史与目的"

    # game/codex.rpy:2182
    old "A total of approximately one hundred Warp Drives were constructed. Their production was justified by:"
    new "共建造了大约一百台曲速引擎。其生产理由是："

    # game/codex.rpy:2184
    old "the potential necessity to replace the Gate network in the event of system failure;"
    new "在系统故障时替换门网络的潜在必要性；"

    # game/codex.rpy:2185
    old "the strategic value of autonomous interstellar mobility for spacefaring units."
    new "航天单位的自主星际机动性的战略价值。"

    # game/codex.rpy:2187
    old "Each vessel requires a variable number of drives depending on its class and dimensions:"
    new "每艘飞船根据其级别和尺寸需要不同数量的引擎："

    # game/codex.rpy:2188
    old "small vessels (single-operator class), up to 3 drives;"
    new "小型飞船（单人操作级），最多3台引擎；"

    # game/codex.rpy:2189
    old "large cruisers or Citadel-class structures, up to one thousand drives per unit."
    new "大型巡洋舰或堡垒级结构，每单元最多一千台引擎。"

    # game/codex.rpy:2191
    old "Despite limited practical application, long-term viability was ensured by comparatively low operational costs relative to alternative technologies."
    new "尽管实际应用有限，但相对于替代技术较低的运营成本确保了长期可行性。"

    # game/codex.rpy:2211
    old "III. Current Strategic Relevance"
    new "三、当前战略相关性"

    # game/codex.rpy:2213
    old "In the modern galaxy, Warp Drives possess exceptional strategic value for two primary reasons:"
    new "在现代银河中，曲速引擎因两个主要原因具有特殊战略价值："

    # game/codex.rpy:2215
    old "1. Minimal energy requirements for warpspace transition;"
    new "1. 曲速空间转换的最低能量需求；"

    # game/codex.rpy:2216
    old "2. The ability to reconfigure the system for alternative energy sources while preserving warpspace jump functionality, at the cost of reduced output."
    new "2. 能够为替代能源重新配置系统，同时保持曲速空间跳跃功能，代价是输出降低。"

    # game/codex.rpy:2222
    old "Opens in the middle of the first act"
    new "在第一幕中间开放"

    # game/codex.rpy:2230
    old "IV. Limitations and Hazards"
    new "四、局限与危险"

    # game/codex.rpy:2232
    old "Operation of Warp Drives involves significant risks:"
    new "曲速引擎的操作涉及重大风险："

    # game/codex.rpy:2233
    old "navigational precision, required to prevent planetary collision;"
    new "导航精度，防止行星碰撞所需；"

    # game/codex.rpy:2234
    old "sufficient fuel reserves, depletion during transit results in total structural disintegration;"
    new "充足的燃料储备，运输过程中耗尽会导致完全结构解体；"

    # game/codex.rpy:2235
    old "probability of entering anomalous zones or Hidden Galaxies, return probability is effectively zero."
    new "进入异常区域或隐藏银河的概率，返回概率实际上为零。"

    # game/codex.rpy:2237
    old "Additional data:"
    new "附加数据："

    # game/codex.rpy:2238
    old "only 37 drives are currently confirmed operational within the galaxy;"
    new "目前银河内仅确认37台引擎可运作；"

    # game/codex.rpy:2239
    old "the remaining units are of unknown location;"
    new "其余单元位置未知；"

    # game/codex.rpy:2240
    old "each confirmed drive is under continuous surveillance by the Keepers, rendering their use for covert operations or espionage largely ineffective."
    new "每台确认的引擎都受到守护者的持续监视，使其用于秘密行动或间谍活动基本无效。"

    # game/codex.rpy:2242
    old "V. Social and Political Status"
    new "五、社会与政治地位"

    # game/codex.rpy:2244
    old "Possession of Warp Drives is regarded as a symbol of prestige and technological superiority within the Federation."
    new "拥有曲速引擎被视为联邦内声望和技术优势的象征。"

    # game/codex.rpy:2246
    old "Any unauthorized use, transfer, or modification of Warp Drives without Keeper authorization is classified as a threat to galactic security and may result in direct Inquisition sanctions."
    new "未经守护者授权对曲速引擎的任何未经授权的使用、转移或修改都被归类为对银河安全的威胁，可能导致审判庭的直接制裁。"

    # game/codex.rpy:2250
    old "Warp Drives are rare and strategically critical mechanisms, combining immense technological value with substantial inherent risk."
    new "曲速引擎是稀有且具有战略关键性的机制，将巨大的技术价值与重大固有风险结合在一起。"

    # game/codex.rpy:2252
    old "Their operation is permitted only under full oversight, with galactic security prioritized over tactical or economic advantage."
    new "其运作仅在完全监督下被允许，银河安全优先于战术或经济优势。"

    # game/codex.rpy:2309
    old "Document: Report № ANCIENT–HIST/13K"
    new "文件：报告 № ANCIENT–HIST/13K"

    # game/codex.rpy:2310
    old "Subject: The Ancient Empire"
    new "主题：古代帝国"

    # game/codex.rpy:2311
    old "Status: Classified / Extremely Restricted Access"
    new "状态：机密/极度受限访问"

    # game/codex.rpy:2316
    old "I. General Information"
    new "一、一般信息"

    # game/codex.rpy:2318
    old "The Ancient Empire was a federative entity that governed the galactic system approximately 13,000 years prior to the current chronological reference."
    new "古代帝国是一个联邦实体，在当前时间参考点约13,000年前统治着银河系统。"

    # game/codex.rpy:2320
    old "Exact dates and detailed chronology remain unknown."
    new "确切日期和详细年表仍然未知。"

    # game/codex.rpy:2322
    old "Existing data is extremely limited and subject to strict classification."
    new "现有数据极其有限，受到严格保密。"

    # game/codex.rpy:2324
    old "The Empire possessed:"
    new "帝国拥有："

    # game/codex.rpy:2325
    old "absolute power;"
    new "绝对权力；"

    # game/codex.rpy:2326
    old "technologies capable of violating the fundamental laws of the galaxy;"
    new "能够违反银河基本法则的技术；"

    # game/codex.rpy:2327
    old "ambitions extending beyond the natural constraints of life and time."
    new "超越生命和时间自然约束的野心。"

    # game/codex.rpy:2329
    old "II. Collapse and Catastrophe"
    new "二、崩溃与灾难"

    # game/codex.rpy:2331
    old "Attempts by the Ancient Empire to develop technology capable of altering or distorting space-time culminated in a catastrophic event."
    new "古代帝国开发能够改变或扭曲时空的技术的尝试最终导致了一场灾难性事件。"

    # game/codex.rpy:2333
    old "The implemented device was designated as the Astreon System (internal designation: “time machine”)."
    new "实施的设备被指定为阿斯特雷昂系统（内部指定：“时间机器”）。"

    # game/codex.rpy:2335
    old "Objective: to overcome galactic cyclicity and achieve immortality for the Empire’s population."
    new "目标：克服银河循环性，为帝国人民实现永生。"

    # game/codex.rpy:2337
    old "Consequence: a massive detonation that divided the galaxy into two distinct regions:"
    new "后果：一场大规模爆炸将银河分为两个不同区域："

    # game/codex.rpy:2339
    old "The Visible Galaxy, a relatively stable zone, accessible for exploration."
    new "可见银河，一个相对稳定的区域，可供探索。"

    # game/codex.rpy:2341
    old "The Hidden Galaxy, an anomalous region characterized by temporal distortions, accessible only via Ancient Gates or through possession of specialized knowledge and technologies."
    new "隐藏银河，一个以时间扭曲为特征的异常区域，只能通过古代之门或拥有专门知识和技术进入。"

    # game/codex.rpy:2343
    old "The anomalous region contains “fragments of time from the Terran system” coexisting simultaneously, forming unique chronological conditions."
    new "该异常区域包含“地球系统的时间碎片”同时共存，形成独特的时间条件。"

    # game/codex.rpy:2345
    old "III. Theories and Restrictions"
    new "三、理论与限制"

    # game/codex.rpy:2347
    old "A hypothesis exists suggesting that the catastrophe may have been triggered by military conflict with an external adversary."
    new "存在一种假说，认为灾难可能是由与外部对手的军事冲突引发的。"

    # game/codex.rpy:2349
    old "No verified evidence supporting this theory has been recovered."
    new "尚未找到支持该理论的经核实证据。"

    # game/codex.rpy:2350
    old "Any research, verification, or attempts to reconstruct or reactivate the system are strictly prohibited and are actively suppressed by the Keepers and the Inquisition."
    new "任何研究、验证或重建或重新激活该系统的尝试都被严格禁止，并受到守护者和审判庭的积极压制。"

    # game/codex.rpy:2352
    old "IV. Consequences for the Modern Galaxy"
    new "四、对现代银河的影响"

    # game/codex.rpy:2354
    old "The Hidden portion of the galaxy generates anomalous zones in which temporal flow differs from standard reference:"
    new "银河的隐藏部分产生异常区域，其中时间流与标准参考不同："

    # game/codex.rpy:2355
    old "Terran-origin entities and objects within the Hidden Zone exist on a decelerated temporal scale relative to the external galaxy."
    new "隐藏区域内的地球起源实体和物体相对于外部银河以减速的时间尺度存在。"

    # game/codex.rpy:2356
    old "Any expedition into anomalous regions requires advanced technologies and access to Ancient Gates."
    new "任何进入异常区域的探险都需要先进技术和古代之门的访问权限。"

    # game/codex.rpy:2358
    old "All information concerning the Ancient Empire and the Astreon System is classified under the category “Extreme Secrecy.”"
    new "所有关于古代帝国和阿斯特雷昂系统的信息都被归类为“极度机密”。"

    # game/codex.rpy:2360
    old "Unauthorized dissemination of information is punishable by data erasure and Inquisition-imposed sanctions."
    new "未经授权传播信息可处以数据抹除和审判庭实施的制裁。"

    # game/codex.rpy:2362
    old "The impact of the catastrophe persists to the present era:"
    new "灾难的影响持续到当代："

    # game/codex.rpy:2363
    old "anomalies in gravitational and temporal fields;"
    new "引力和时间场的异常；"

    # game/codex.rpy:2364
    old "residual effects of space-time experimentation;"
    new "时空实验的残余效应；"

    # game/codex.rpy:2365
    old "persistent risk of renewed activation of the Astreon System."
    new "阿斯特雷昂系统重新激活的持续风险。"

    # game/codex.rpy:2369
    old "The Ancient Empire and the Astreon System constitute:"
    new "古代帝国和阿斯特雷昂系统构成："

    # game/codex.rpy:2370
    old "the origin of multiple galactic anomalies;"
    new "多个银河异常的起源；"

    # game/codex.rpy:2371
    old "a documented example of civilization-ending ambition;"
    new "有记录的文明终结野心的例子；"

    # game/codex.rpy:2372
    old "objects of maximum secrecy and continuous surveillance by the Keepers and the Inquisition."
    new "最高机密对象，受到守护者和审判庭的持续监视。"

    # game/codex.rpy:2374
    old "Any interference with technologies or research related to the Ancient Empire or the Astreon System is strictly prohibited and classified as a direct threat to galactic stability."
    new "任何与古代帝国或阿斯特雷昂系统相关的技术或研究的干涉都被严格禁止，并被归类为对银河稳定的直接威胁。"

    # game/codex.rpy:2387
    old "Closed Archive. Clearance Level IV"
    new "封闭档案。许可等级IV"

    # game/codex.rpy:2405
    old "Section: Prohibited Substances and Existential Threats"
    new "章节：禁用物质与存在威胁"

    # game/codex.rpy:2406
    old "Article: BLOOD OF THE ANCIENTS"
    new "条目：古代之血"

    # game/codex.rpy:2407
    old "Status: Absolutely Restricted"
    new "状态：绝对限制"

    # game/codex.rpy:2414
    old "The Blood of the Ancients is a high-energy processed substance, erroneously referred to as “blood.”"
    new "古代之血是一种高能加工物质，被错误地称为“血”。"

    # game/codex.rpy:2416
    old "By its nature, it is not a biological fluid in the classical sense."
    new "就其本质而言，它不是经典意义上的生物流体。"

    # game/codex.rpy:2418
    old "The substance was created during the era of the Ancient Empire and represents a viral-type energy carrier capable of briefly releasing colossal amounts of energy."
    new "该物质创建于古代帝国时代，代表一种能够短暂释放巨量能量的病毒型能量载体。"

    # game/codex.rpy:2420
    old "Due to the complexity of extraction, instability, and severe side effects, it is classified as a top-tier strategic resource and is employed exclusively under exceptional circumstances."
    new "由于提取的复杂性、不稳定性和严重副作用，它被归类为顶级战略资源，仅在特殊情况下使用。"

    # game/codex.rpy:2422
    old "II. Storage and Active Lifespan"
    new "二、储存与活性寿命"

    # game/codex.rpy:2424
    old "The Blood of the Ancients is inherently unstable and possesses a limited active lifespan."
    new "古代之血本质上不稳定，活性寿命有限。"

    # game/codex.rpy:2426
    old "To prolong storage viability, the substance must be contained within specialized isolating capsules (see: Energy Cells of the Ancient Empire)."
    new "为延长储存可行性，该物质必须储存在专门的隔离胶囊中（见：古代帝国能量电池）。"

    # game/codex.rpy:2428
    old "Violation of storage conditions results in:"
    new "违反储存条件会导致："

    # game/codex.rpy:2429
    old "structural degradation;"
    new "结构退化；"

    # game/codex.rpy:2430
    old "spontaneous energy release;"
    new "自发能量释放；"

    # game/codex.rpy:2431
    old "contamination of the surrounding environment."
    new "周围环境污染。"

    # game/codex.rpy:2433
    old "III. Principle of Operation"
    new "三、运作原理"

    # game/codex.rpy:2435
    old "Upon application, the Blood of the Ancients integrates into a host object (living organism, mechanism, structure, or artifact — distinctions are non-critical)."
    new "应用后，古代之血融入宿主对象（活体生物、机制、结构或文物——区别不重要）。"

    # game/codex.rpy:2437
    old "In essence, the substance functions as a viral energy form, causing:"
    new "本质上，该物质作为病毒能量形式运作，导致："

    # game/codex.rpy:2438
    old "formation of internal microorganisms;"
    new "内部微生物的形成；"

    # game/codex.rpy:2439
    old "temporary extreme amplification of the host’s energy potential;"
    new "宿主能量潜力的暂时极端放大；"

    # game/codex.rpy:2440
    old "initiation of irreversible mutational processes."
    new "不可逆变变过程的启动。"

    # game/codex.rpy:2442
    old "In the short term, the effect may be perceived as enhancement."
    new "短期内，效果可能被视为增强。"

    # game/codex.rpy:2443
    old "In the long term, it results in degradation, destruction, or complete transformation of the host."
    new "长期来看，会导致宿主的退化、毁灭或完全转化。"

    # game/codex.rpy:2445
    old "IV. Miasma and Mutational Processes"
    new "四、瘴气与突变过程"

    # game/codex.rpy:2447
    old "During activation, the Blood of the Ancients generates miasma, energy-biological clouds that propagate through living organisms."
    new "激活期间，古代之血产生瘴气，即通过活体生物传播的能量生物云。"

    # game/codex.rpy:2449
    old "Miasma:"
    new "瘴气："

    # game/codex.rpy:2450
    old "consumes the life force of all biological forms (from microorganisms to sapient species);"
    new "消耗所有生物形式的生命力（从微生物到智慧物种）；"

    # game/codex.rpy:2451
    old "restructures absorbed matter according to its own framework;"
    new "根据自身框架重组吸收的物质；"

    # game/codex.rpy:2452
    old "initiates mutational transformations."
    new "引发突变转化。"

    # game/codex.rpy:2454
    old "The outcome of these processes is the emergence of mutated entities designated as Soulless (see: Soulless and Mutants)."
    new "这些过程的结果是出现被指定为无魂者的突变实体（见：无魂者与变种人）。"

    # game/codex.rpy:2456
    old "V. Military Mutations"
    new "五、军事突变"

    # game/codex.rpy:2458
    old "Controlled military mutations utilizing the Blood of the Ancients are:"
    new "利用古代之血的受控军事突变："

    # game/codex.rpy:2459
    old "extremely rare;"
    new "极其罕见；"

    # game/codex.rpy:2460
    old "characterized by a low stabilization success rate;"
    new "以低稳定成功率为特征；"

    # game/codex.rpy:2461
    old "incapable of sustaining long-term host survival."
    new "无法维持宿主的长期生存。"

    # game/codex.rpy:2463
    old "Even a “successful” mutation extends the subject’s existence only for a limited duration (typically from several hours to several days)."
    new "即使“成功”的突变也只能将对象的存在延长有限时间（通常从几小时到几天）。"

    # game/codex.rpy:2465
    old "Within galactic military practice, such mutations are employed exclusively:"
    new "在银河军事实践中，此类突变仅用于："

    # game/codex.rpy:2466
    old "as a measure of last resort;"
    new "作为最后手段；"

    # game/codex.rpy:2467
    old "primarily on convicted criminals."
    new "主要针对已定罪的罪犯。"

    # game/codex.rpy:2469
    old "Standard tactical application:"
    new "标准战术应用："

    # game/codex.rpy:2470
    old "the infected subject is deployed into enemy-controlled territory;"
    new "被感染对象被部署到敌方控制领土；"

    # game/codex.rpy:2471
    old "the subject’s direct combat role is secondary;"
    new "对象的直接战斗角色是次要的；"

    # game/codex.rpy:2472
    old "the primary effect is produced by miasma propagation following contact."
    new "主要效果由接触后的瘴气传播产生。"

    # game/codex.rpy:2474
    old "VI. Countermeasure Methods"
    new "六、对抗措施"

    # game/codex.rpy:2476
    old "Complete destruction of the Blood of the Ancients is classified as extremely difficult, though not impossible."
    new "古代之血的完全销毁被归类为极其困难，但并非不可能。"

    # game/codex.rpy:2478
    old "Effective countermeasures include:"
    new "有效对抗措施包括："

    # game/codex.rpy:2479
    old "exposure to extremely low temperatures;"
    new "暴露于极低温度；"

    # game/codex.rpy:2480
    old "cryogenic isolation;"
    new "低温隔离；"

    # game/codex.rpy:2481
    old "total elimination of viable biological environments."
    new "完全消除可存活的生物环境。"

    # game/codex.rpy:2483
    old "In the absence of life-energy sources, the substance undergoes autonomous degradation upon expiration of its active lifespan."
    new "在缺乏生命能量来源的情况下，该物质在活性寿命到期后自主降解。"

    # game/codex.rpy:2485
    old "VII. Conclusion"
    new "七、结论"

    # game/codex.rpy:2487
    old "The Blood of the Ancients is not a tool of immortality nor a source of absolute power."
    new "古代之血不是永生的工具，也不是绝对权力的来源。"

    # game/codex.rpy:2489
    old "It constitutes a self-propagating weapon of mass destruction, posing an equal threat to both the target and the party attempting to employ it."
    new "它构成一种自我传播的大规模毁灭性武器，对目标和试图使用它的一方构成同等威胁。"

    # game/codex.rpy:2491
    old "Any unauthorized use is classified as a galactic-scale threat and mandates immediate intervention (see: Keeper Protocols)."
    new "任何未经授权的使用都被归类为银河级威胁，并强制要求立即干预（见：守护者协议）。"

