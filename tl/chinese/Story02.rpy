# game/Story02.rpy:4155
translate chinese akt2chapter6_2ea3673f:

    # em "Where do you think you’re going?"
    em "你要去哪？"

# game/Story02.rpy:4156
translate chinese akt2chapter6_75a25a20:

    # em "You’re not going anywhere."
    em "你哪儿也别去。"

# game/Story02.rpy:4158
translate chinese akt2chapter6_139b9be6:

    # aS "Welp… {w=0.5}I’m so screwed."
    aS "完了……{w=0.5}我死定了。"

# game/Story02.rpy:4162
translate chinese akt2chapter6_2216749f:

    # aS "(What do I do now? I need to slip out of here quietly without anyone noticing.)"
    aS "（怎么办？我得悄悄溜走，别让人发现。）"

# game/Story02.rpy:4163
translate chinese akt2chapter6_8416ed0b:

    # aS "(But how...?)"
    aS "（可怎么溜……？）"

# game/Story02.rpy:4166
translate chinese akt2chapter6_c032f887:

    # k "Don’t move."
    k "别动。"

# game/Story02.rpy:4168
translate chinese akt2chapter6_7e891deb:

    # aS "So what, I’m supposed to sit here and listen to this boring crap?"
    aS "所以我得坐这儿听这些无聊的废话？"

# game/Story02.rpy:4170
translate chinese akt2chapter6_ee723ff8:

    # k "I’m not suggesting."
    k "我不是在建议。"

# game/Story02.rpy:4171
translate chinese akt2chapter6_583e8df0:

    # k "Shut up and listen."
    k "闭嘴，听着。"

# game/Story02.rpy:4173
translate chinese akt2chapter6_e4529999:

    # aS "Hmph."
    aS "哼。"

# game/Story02.rpy:4174
translate chinese akt2chapter6_115f0eb9:

    # aS "You’ve got a lot of nerve."
    aS "你胆子不小。"

# game/Story02.rpy:4175
translate chinese akt2chapter6_67d28708:

    # aS "You kno—"
    aS "你知——"

# game/Story02.rpy:4176
translate chinese akt2chapter6_5844f011:

    # em "Silence."
    em "安静。"

# game/Story02.rpy:4181
translate chinese akt2chapter6_3b87f588:

    # h "Hey, you do realize people are dying out there?!"
    h "嘿，你知道外面有人在死吗？！"

    # game/Story02.rpy:4182
translate chinese akt2chapter6_329908c9:

    # h "And we’re standing here doing what exactly?!"
    h "我们站在这儿到底在干嘛？！"

# game/Story02.rpy:4185
translate chinese akt2chapter6_e6c3ccea:

    # Fl "You’re welcome to join them."
    Fl "你大可以跟他们一起去。"

# game/Story02.rpy:4186
translate chinese akt2chapter6_accc00ab:

    # Fl "Out there."
    Fl "去外面。"

# game/Story02.rpy:4187
translate chinese akt2chapter6_e2dc091f:

    # Fl "I’d rather think first."
    Fl "我宁愿先想清楚。"

# game/Story02.rpy:4188
translate chinese akt2chapter6_d7f0f919:

    # Fl "Then act."
    Fl "再行动。"

# game/Story02.rpy:4190
translate chinese akt2chapter6_ac3bd9e3:

    # k "I agree with shorty."
    k "我同意矮子。"

# game/Story02.rpy:4191
translate chinese akt2chapter6_3c614764:

    # k "Every minute, we lose more people."
    k "每过一分钟，我们就多死一批人。"

# game/Story02.rpy:4192
translate chinese akt2chapter6_fecd6c8d:

    # em "I don’t."
    em "我不同意。"

# game/Story02.rpy:4193
translate chinese akt2chapter6_7d14e5cf:

    # em "I don’t risk lives without a plan."
    em "没有计划，我不拿命去冒险。"

# game/Story02.rpy:4195
translate chinese akt2chapter6_15a6997f:

    # h "(whispering) At this rate… we’re all dead."
    h "（低声）照这样下去……我们都得死。"

# game/Story02.rpy:4198
translate chinese akt2chapter6_8b9ee863:

    # mc "Enough."
    mc "够了。"

# game/Story02.rpy:4200
translate chinese akt2chapter6_74180d15:

    # em "Watch your tone."
    em "注意你的语气。"

# game/Story02.rpy:4201
translate chinese akt2chapter6_fe655e5d:

    # mc "Soon there won’t be anyone left to protect."
    mc "很快就没人可保护了。"

# game/Story02.rpy:4203
translate chinese akt2chapter6_af9e0a50_1:

    # em "..."
    em "……"

# game/Story02.rpy:4204
translate chinese akt2chapter6_10838230:

    # em "...I’m listening."
    em "……我在听。"

# game/Story02.rpy:4208
translate chinese akt2chapter6_453484c4:

    # mc "There’s too many of them."
    mc "它们太多了。"

# game/Story02.rpy:4211
translate chinese akt2chapter6_37f29dbd:

    # mc "I’ve seen it."
    mc "我亲眼见过。"

# game/Story02.rpy:4215
translate chinese akt2chapter6_3fff2c8c:

    # em "Go on."
    em "继续。"

# game/Story02.rpy:4218
translate chinese akt2chapter6_fca52711:

    # mc "No."
    mc "不。"

# game/Story02.rpy:4219
translate chinese akt2chapter6_f91047bc:

    # mc "Answer me this, how did the Soulless get into the city?"
    mc "先回答我，无魂者是怎么进城的？"

# game/Story02.rpy:4220
translate chinese akt2chapter6_af9e0a50_2:

    # em "..."
    em "……"

# game/Story02.rpy:4221
translate chinese akt2chapter6_24dc933c:

    # em "Careful."
    em "小心点。"

# game/Story02.rpy:4223
translate chinese akt2chapter6_2d4e8ab9:

    # mc "One answer for one question."
    mc "一个问题换一个答案。"

# game/Story02.rpy:4225
translate chinese akt2chapter6_9190d828:

    # em "Not bad."
    em "不错。"

# game/Story02.rpy:4226
translate chinese akt2chapter6_a29aeb91:

    # em "But you’re not in a position to bargain."
    em "但你没资格谈条件。"

# game/Story02.rpy:4227
translate chinese akt2chapter6_11afb0d7:

    # em "Your answer?"
    em "你的答案呢？"

# game/Story02.rpy:4230
translate chinese akt2chapter6_7177fa85:

    # mc "They were let in."
    mc "是有人放它们进来的。"

# game/Story02.rpy:4232
translate chinese akt2chapter6_a424b08e:

    # h "(whisper) betrayel..."
    h "（低声）背叛……"

# game/Story02.rpy:4235
translate chinese akt2chapter6_41da62cb:

    # Fl "..."
    Fl "……"

# game/Story02.rpy:4237
translate chinese akt2chapter6_34ece62e:

    # Fl "Yes."
    Fl "对。"

# game/Story02.rpy:4239
translate chinese akt2chapter6_bf832a13:

    # k "No."
    k "不。"

# game/Story02.rpy:4241
translate chinese akt2chapter6_079d662c:

    # Mi "The gate was opened from inside the city."
    Mi "传送门是从城内打开的。"

# game/Story02.rpy:4243
translate chinese akt2chapter6_026fb121:

    # Fl "And Astoria was the last person known to control it."
    Fl "而已知最后一个能控制它的人是阿斯托里亚。"

# game/Story02.rpy:4246
translate chinese akt2chapter6_092b280d:

    # k "That proves nothing."
    k "这证明不了什么。"

# game/Story02.rpy:4248
translate chinese akt2chapter6_27658e8b:

    # em "Correct. Suspicion is not proof."
    em "没错。怀疑不等于证据。"

# game/Story02.rpy:4250
translate chinese akt2chapter6_774176ef:

    # em "You have no idea what you’re playing with."
    em "你根本不知道自己招惹的是什么。"

# game/Story02.rpy:4252
translate chinese akt2chapter6_0c7c42b2:

    # Fl "And you’re no different, Embe—"
    Fl "你也一样，恩伯——"

# game/Story02.rpy:4253
translate chinese akt2chapter6_19569459:

    # em "Enough."
    em "够了。"

# game/Story02.rpy:4256
translate chinese akt2chapter6_ec1145d6:

    # mc "You’re afraid."
    mc "你怕了。"

# game/Story02.rpy:4258
translate chinese akt2chapter6_b334d3d3:

    # em "I value my life."
    em "我珍惜自己的命。"

# game/Story02.rpy:4261
translate chinese akt2chapter6_c45531d4:

    # mc "And the rest just die for it?"
    mc "其他人就得为此去死？"

# game/Story02.rpy:4264
translate chinese akt2chapter6_92b249f7:

    # em "You started this."
    em "是你们挑起的。"

# game/Story02.rpy:4266
translate chinese akt2chapter6_4b180251:

    # mc "We’re not the ones sending your people to die."
    mc "送你的手下去死的不是我们。"

# game/Story02.rpy:4267
translate chinese akt2chapter6_af9e0a50_3:

    # em "..."
    em "……"

# game/Story02.rpy:4269
translate chinese akt2chapter6_b9e19b4b:

    # aS "Ember, you’re seriously just going to let that slide?!"
    aS "恩伯，你就这么算了？！"

# game/Story02.rpy:4270
translate chinese akt2chapter6_2003d452:

    # em "Where is he wrong?"
    em "他哪里说错了？"

# game/Story02.rpy:4271
translate chinese akt2chapter6_cee34e4c:

    # aS "..."
    aS "……"

# game/Story02.rpy:4273
translate chinese akt2chapter6_8618a74a:

    # mc "Flora. Talk."
    mc "弗洛拉。说。"

# game/Story02.rpy:4276
translate chinese akt2chapter6_37bdec82:

    # Fl "We herd them into a kill zone."
    Fl "把它们赶进一个猎杀区。"

# game/Story02.rpy:4277
translate chinese akt2chapter6_01a5f7c3:

    # Fl "Then hit from all sides."
    Fl "然后四面夹击。"

# game/Story02.rpy:4279
translate chinese akt2chapter6_1bedcf6c:

    # k "And where are you getting the resources?"
    k "资源从哪来？"

# game/Story02.rpy:4280
translate chinese akt2chapter6_0826cac6:

    # k "People."
    k "人手。"

# game/Story02.rpy:4282
translate chinese akt2chapter6_6d8e7948:

    # Fl "I’ll find them."
    Fl "我来找。"

# game/Story02.rpy:4284
translate chinese akt2chapter6_a969a2e5:

    # k "You won’t."
    k "你找不到。"

# game/Story02.rpy:4285
translate chinese akt2chapter6_3812e70f:

    # aS "I’m with Gorilla on this one. That’s not a plan, that’s a joke."
    aS "这次我站大猩猩。那不是计划，是笑话。"

# game/Story02.rpy:4287
translate chinese akt2chapter6_625ce7c7:

    # Mi "…Into a ring?"
    Mi "……围成一个圈？"

# game/Story02.rpy:4288
translate chinese akt2chapter6_36b0a923:

    # Mi "How?"
    Mi "怎么弄？"

# game/Story02.rpy:4289
translate chinese akt2chapter6_41da62cb_1:

    # Fl "..."
    Fl "……"

# game/Story02.rpy:4291
translate chinese akt2chapter6_df0546f9:

    # Fl "Lower city."
    Fl "下城。"

# game/Story02.rpy:4294
translate chinese akt2chapter6_d1660923:

    # Mi "…No."
    Mi "……不行。"

# game/Story02.rpy:4295
translate chinese akt2chapter6_34ece62e_1:

    # Fl "Yes."
    Fl "行。"

# game/Story02.rpy:4296
translate chinese akt2chapter6_e4a79158:

    # Fl "We drive them in, seal the exits—"
    Fl "把它们赶进去，封死出口——"

# game/Story02.rpy:4298
translate chinese akt2chapter6_75af7aec:

    # Mi "Flora… the people."
    Mi "弗洛拉……那些人。"

# game/Story02.rpy:4299
translate chinese akt2chapter6_63d5d5e9:

    # Fl "We evacuate them first."
    Fl "先疏散他们。"

# game/Story02.rpy:4300
translate chinese akt2chapter6_b5ea496d:

    # Mi "We don’t have enough time."
    Mi "时间不够。"

# game/Story02.rpy:4302
translate chinese akt2chapter6_d5e3ce82:

    # Fl "Then we start now."
    Fl "那就现在开始。"

# game/Story02.rpy:4303
translate chinese akt2chapter6_6dc548de:

    # Fl "That’s enough."
    Fl "到此为止。"

# game/Story02.rpy:4304
translate chinese akt2chapter6_08438532:

    # Fl "Decide."
    Fl "决定吧。"

# game/Story02.rpy:4308
translate chinese akt2chapter6_da3fdbf1_2:

    # Mi "..."
    Mi "……"

# game/Story02.rpy:4310
translate chinese akt2chapter6_a6d38f41:

    # k "Girl… you’re insane."
    k "丫头……你疯了。"

# game/Story02.rpy:4312
translate chinese akt2chapter6_2bad3711:

    # Fl "Good."
    Fl "很好。"

# game/Story02.rpy:4313
translate chinese akt2chapter6_09a52f5f:

    # Fl "Because a sane person wouldn’t even consider this."
    Fl "因为正常人根本不会考虑这种事。"

# game/Story02.rpy:4318
translate chinese akt2chapter6_52c7522d:

    # aS "And the weapons?"
    aS "那武器呢？"

# game/Story02.rpy:4319
translate chinese akt2chapter6_cec25ffc:

    # aS "Have you seen how many of them are out there?"
    aS "你见过外面有多少吗？"

# game/Story02.rpy:4321
translate chinese akt2chapter6_c505c231:

    # em "I’m not turning my city into a slaughterhouse."
    em "我不会把我的城变成屠宰场。"

# game/Story02.rpy:4322
translate chinese akt2chapter6_22e5f5b8:

    # em "If you’ve got something better, say it."
    em "有更好的方案就说。"

# game/Story02.rpy:4324
translate chinese akt2chapter6_73019895:

    # Fl "Answer me this, Ember."
    Fl "回答我，恩伯。"

# game/Story02.rpy:4325
translate chinese akt2chapter6_62866e51:

    # Fl "What do we breathe?"
    Fl "我们呼吸的是什么？"

# game/Story02.rpy:4326
translate chinese akt2chapter6_af9e0a50_4:

    # em "..."
    em "……"

# game/Story02.rpy:4327
translate chinese akt2chapter6_c674bbf7:

    # em "Get to the point."
    em "说重点。"

# game/Story02.rpy:4329
translate chinese akt2chapter6_95e1efa7:

    # Fl "Ventilation shafts."
    Fl "通风井。"

# game/Story02.rpy:4330
translate chinese akt2chapter6_c04025e0:

    # Fl "That’s our entry point."
    Fl "那就是我们的切入点。"

# game/Story02.rpy:4332
translate chinese akt2chapter6_081c2044:

    # Mi "…Useless. They’ll still be able to brea—"
    Mi "……没用。它们还是能呼——"

# game/Story02.rpy:4334
translate chinese akt2chapter6_96806d05:

    # Fl "We don’t send air."
    Fl "我们不送空气。"

# game/Story02.rpy:4336
translate chinese akt2chapter6_a658eac4:

    # Fl "We send cryogen."
    Fl "送制冷剂。"

# game/Story02.rpy:4337
translate chinese akt2chapter6_c6c0f824:

    # Mi "Freeze them?"
    Mi "冻住它们？"

# game/Story02.rpy:4338
translate chinese akt2chapter6_ddf104c0:

    # Fl "Stop them."
    Fl "拦住它们。"

# game/Story02.rpy:4339
translate chinese akt2chapter6_3ed8f7f2:

    # Fl "Not burn. Not rupture. Not kill."
    Fl "不烧。不炸。不杀。"

# game/Story02.rpy:4340
translate chinese akt2chapter6_f3314ae9:

    # Fl "Lock the bodies before they spill more substance."
    Fl "在它们喷出更多物质前锁住身体。"

# game/Story02.rpy:4342
translate chinese akt2chapter6_da3fdbf1_3:

    # Mi "..."
    Mi "……"

# game/Story02.rpy:4343
translate chinese akt2chapter6_14b10460:

    # em "Do you understand what you’re suggesting?"
    em "你知道你在提议什么吗？"

# game/Story02.rpy:4344
translate chinese akt2chapter6_34ece62e_2:

    # Fl "Yes."
    Fl "知道。"

# game/Story02.rpy:4346
translate chinese akt2chapter6_f13d6579:

    # em "Begin preparations for evacuation."
    em "开始准备疏散。"

# game/Story02.rpy:4347
translate chinese akt2chapter6_adf5cddf:

    # em "Flora, map the ventilation route and prove the cryogen can reach the lower sectors."
    em "弗洛拉，画出通风路线，证明制冷剂能到达下层。"

# game/Story02.rpy:4352
translate chinese akt2chapter6_b616d4c0:

    # em "You have one hour. Then I decide."
    em "给你一小时。然后我决定。"

# game/Story02.rpy:4355
translate chinese akt2chapter6_c5a24c25:

    # aS "Bye-bye, pretty boy."
    aS "拜拜，小帅哥。"

# game/Story02.rpy:4367
translate chinese akt2chapter6_41da62cb_2:

    # Fl "..."
    Fl "……"

# game/Story02.rpy:4369
translate chinese akt2chapter6_daa34919:

    # Fl "You."
    Fl "你。"

# game/Story02.rpy:4370
translate chinese akt2chapter6_200de0ad:

    # Fl "We need to talk."
    Fl "我们得谈谈。"

# game/Story02.rpy:4372
translate chinese akt2chapter6_e7829a51:

    # mc "Ease off. Start there."
    mc "先放松点。从这儿开始。"

# game/Story02.rpy:4374
translate chinese akt2chapter6_e5a9700e:

    # Fl "We don’t have time for—"
    Fl "我们没时间——"

# game/Story02.rpy:4376
translate chinese akt2chapter6_559c612d:

    # mc "You need help."
    mc "你需要帮忙。"

# game/Story02.rpy:4377
translate chinese akt2chapter6_0db8da4e:

    # mc "Then ask for it properly."
    mc "那就好好开口。"

# game/Story02.rpy:4379
translate chinese akt2chapter6_41da62cb_3:

    # Fl "..."
    Fl "……"

# game/Story02.rpy:4381
translate chinese akt2chapter6_06878236:

    # Fl "...So you’re in?"
    Fl "……那你加入？"

# game/Story02.rpy:4383
translate chinese akt2chapter6_d5369a4b:

    # mc "I can walk."
    mc "我能走。"

# game/Story02.rpy:4385
translate chinese akt2chapter6_baada9ed:

    # Fl "Miriel."
    Fl "米莉尔。"

# game/Story02.rpy:4386
translate chinese akt2chapter6_db380331:

    # Fl "Half the people here owe her."
    Fl "这儿一半的人都欠她。"

# game/Story02.rpy:4387
translate chinese akt2chapter6_ff792570:

    # Fl "And you two are…"
    Fl "而你们俩是……"

# game/Story02.rpy:4390
translate chinese akt2chapter6_b758b9c7:

    # Fl "Let’s just say—"
    Fl "这么说吧——"

# game/Story02.rpy:4391
translate chinese akt2chapter6_c1ba8902:

    # Fl "I need her."
    Fl "我需要她。"

# game/Story02.rpy:4395
translate chinese akt2chapter6_bb4b0a90:

    # mc "What do I get?"
    mc "我能得到什么？"

# game/Story02.rpy:4396
translate chinese akt2chapter6_1d37d7a9:

    # Fl "A favor."
    Fl "一个人情。"

# game/Story02.rpy:4397
translate chinese akt2chapter6_2b35b6fe:

    # mc "..."
    mc "……"

# game/Story02.rpy:4398
translate chinese akt2chapter6_270439d7:

    # mc "I’ll think about it."
    mc "我考虑考虑。"

# game/Story02.rpy:4402
translate chinese akt2chapter6_2bad3711_1:

    # Fl "Good."
    Fl "很好。"

# game/Story02.rpy:4403
translate chinese akt2chapter6_0cc7cbb2:

    # Fl "Glad you’re on board, mister."
    Fl "很高兴你加入，先生。"

# game/Story02.rpy:4405
translate chinese akt2chapter6_62a407b1:

    # h "Is she gonna keep you there forever?"
    h "她要让你在那儿待到永远？"

# game/Story02.rpy:4406
translate chinese akt2chapter6_bd93e039:

    # h "Get over here before I drag you out myself."
    h "快过来，不然我自己去把你拖出来。"

# game/Story02.rpy:4408
translate chinese akt2chapter6_b5c6af4a:

    # Fl "Go."
    Fl "走吧。"

# game/Story02.rpy:4409
translate chinese akt2chapter6_f93b00e6:

    # Fl "...and—"
    Fl "……还有——"

# game/Story02.rpy:4411
translate chinese akt2chapter6_db26fedd:

    # Fl "…thanks."
    Fl "……谢谢。"

# game/Story02.rpy:4412
translate chinese akt2chapter6_a77a65cd:

    # Fl "I mean it."
    Fl "我说真的。"

# game/Story02.rpy:4428
translate chinese akt2chapter6_1c0dcb19:

    # h "No one’s going to say it?"
    h "没人打算说？"

# game/Story02.rpy:4429
translate chinese akt2chapter6_34b3d9e9:

    # h "The gate was opened from inside."
    h "传送门是从里面打开的。"

# game/Story02.rpy:4433
translate chinese akt2chapter6_8f26d3d4:

    # k "The cat’s lost her mind."
    k "那猫疯了。"

# game/Story02.rpy:4434
translate chinese akt2chapter6_b06c840b:

    # k "That what you wanted to hear?"
    k "这就是你想听的？"

# game/Story02.rpy:4435
translate chinese akt2chapter6_79dd620e:

    # h "About the betrayal, not—"
    h "是关于背叛，不是——"

# game/Story02.rpy:4438
translate chinese akt2chapter6_7c993224:

    # k "We’re not discussing this."
    k "这事没什么好谈的。"

# game/Story02.rpy:4439
translate chinese akt2chapter6_05a43b79:

    # h "Oh no, we are talking about it."
    h "哦不，我们就是要谈。"

# game/Story02.rpy:4440
translate chinese akt2chapter6_b04d1432:

    # h "Astoria’s a traitor now?"
    h "阿斯托里亚现在是叛徒了？"

# game/Story02.rpy:4441
translate chinese akt2chapter6_0162b5ed:

    # h "That’s kind of a big deal—"
    h "这可不是小事——"

# game/Story02.rpy:4444
translate chinese akt2chapter6_71ab8690:

    # k "And you believed that?"
    k "你信了？"

# game/Story02.rpy:4445
translate chinese akt2chapter6_29caa825:

    # k "End of discussion."
    k "讨论结束。"

# game/Story02.rpy:4448
translate chinese akt2chapter6_5877d47d:

    # mc "Doesn’t sit right with me either."
    mc "我也觉得不对劲。"

# game/Story02.rpy:4449
translate chinese akt2chapter6_ca660762:

    # h "See?!"
    h "看吧？！"

# game/Story02.rpy:4450
translate chinese akt2chapter6_2fb58163:

    # mc "She sees the future."
    mc "她能看见未来。"

# game/Story02.rpy:4451
translate chinese akt2chapter6_11543c8d:

    # mc "So how did this happen?"
    mc "那这事怎么会发生？"

# game/Story02.rpy:4452
translate chinese akt2chapter6_33d2443b:

    # k "Maybe she saw this too."
    k "也许她也看见了。"

# game/Story02.rpy:4453
translate chinese akt2chapter6_240814f1:

    # mc "And let it happen?"
    mc "然后就放任不管？"

# game/Story02.rpy:4455
translate chinese akt2chapter6_82091822_4:

    # k "..."
    k "……"

# game/Story02.rpy:4456
translate chinese akt2chapter6_d728720b:

    # mc "You see it too."
    mc "你也看出来了。"

# game/Story02.rpy:4457
translate chinese akt2chapter6_3631fc3e:

    # mc "You just don’t want to say it out loud."
    mc "只是不想说出口。"

# game/Story02.rpy:4460
translate chinese akt2chapter6_cebf71ea:

    # k "That’s heresy."
    k "这是异端之言。"

# game/Story02.rpy:4461
translate chinese akt2chapter6_3d4537c0:

    # k "Astoria didn’t betray us. And she never would."
    k "阿斯托里亚没有背叛我们。永远不会。"

# game/Story02.rpy:4462
translate chinese akt2chapter6_5909330a:

    # mc "Blind loyalty gets you nowhere."
    mc "盲目忠诚只会害了你。"

# game/Story02.rpy:4465
translate chinese akt2chapter6_f0414d04:

    # k "She saved your life."
    k "她救过你的命。"

# game/Story02.rpy:4466
translate chinese akt2chapter6_b905f751:

    # mc "Then she can explain why."
    mc "那她可以解释为什么。"

# game/Story02.rpy:4469
translate chinese akt2chapter6_4d6a8acb:

    # h "Wait, no. You’ve got that wrong."
    h "等等，不对。你搞错了。"

# game/Story02.rpy:4470
translate chinese akt2chapter6_66331371:

    # h "She’s not the one who saved him."
    h "救他的不是她。"

# game/Story02.rpy:4474
translate chinese akt2chapter6_c4509583:

    # k "Don’t delude yourselves."
    k "别自欺欺人。"

# game/Story02.rpy:4475
translate chinese akt2chapter6_c23d5698:

    # k "He wouldn’t lift a finger without the Lady’s order."
    k "没有夫人的命令，他一根手指都不会动。"

# game/Story02.rpy:4476
translate chinese akt2chapter6_aeefabe6:

    # h "That’s…"
    h "那……"

    # game/Story02.rpy:4480
translate chinese akt2chapter6_2170b42f:

    # mc "Miriel?"
    mc "米莉尔？"

# game/Story02.rpy:4486
translate chinese akt2chapter6_fc1c4aa3:

    # Mi "Sorry. I need some air."
    Mi "抱歉。我想出去透透气。"

# game/Story02.rpy:4488
translate chinese akt2chapter6_64022ee8:

    # h "And where exactly do you think you’re going, sweetheart?"
    h "你觉得你要去哪，宝贝？"

# game/Story02.rpy:4490
translate chinese akt2chapter6_cce87a31:

    # Mi "Don’t worry. {w=0.5}I’m fine."
    Mi "别担心。{w=0.5}我没事。"

# game/Story02.rpy:4491
translate chinese akt2chapter6_2b35b6fe_1:

    # mc "..."
    mc "……"

# game/Story02.rpy:4493
translate chinese akt2chapter6_3ae551d2:

    # h "At least get dressed if you’re going after her."
    h "要追她就至少先穿上衣服。"

# game/Story02.rpy:4495
translate chinese akt2chapter6_0415e8f6:

    # mc "Liv, stay on comms."
    mc "莉芙，保持通讯。"

# game/Story02.rpy:4498
translate chinese akt2chapter6_850ef128:

    # b "..."
    b "……"

# game/Story02.rpy:4500
translate chinese akt2chapter6_517a26dc:

    # k "Looks like we’ve been ditched again, shorty."
    k "看来我们又被甩了，矮子。"

# game/Story02.rpy:4502
translate chinese akt2chapter6_6d5bc58a:

    # h "Don’t change the subject."
    h "别转移话题。"

# game/Story02.rpy:4503
translate chinese akt2chapter6_29fdd21b:

    # h "What do you mean the Lady saved him?"
    h "你说夫人救了他是什么意思？"

# game/Story02.rpy:4505
translate chinese akt2chapter6_93535690:

    # k "You’ll see soon enough. Move."
    k "你很快就会知道。走。"

# game/Story02.rpy:4525
translate chinese akt2chapter7_da3fdbf1:

    # Mi "..."
    Mi "……"

# game/Story02.rpy:4527
translate chinese akt2chapter7_2b35b6fe:

    # mc "..."
    mc "……"

# game/Story02.rpy:4528
translate chinese akt2chapter7_31314ce4:

    # mc "You haven’t been yourself since that talk."
    mc "那次谈话之后你就一直不对劲。"

# game/Story02.rpy:4529
translate chinese akt2chapter7_a8fd3bd4:

    # Mi "Didn’t exactly ask you to follow me…"
    Mi "又没让你跟着我……"

# game/Story02.rpy:4530
translate chinese akt2chapter7_599fbc53:

    # mc "You didn’t tell me not to."
    mc "你也没说不让。"

# game/Story02.rpy:4531
translate chinese akt2chapter7_da3fdbf1_1:

    # Mi "..."
    Mi "……"

# game/Story02.rpy:4532
translate chinese akt2chapter7_d85ad95b:

    # Mi "Mhm…"
    Mi "嗯……"

# game/Story02.rpy:4533
translate chinese akt2chapter7_2b35b6fe_1:

    # mc "..."
    mc "……"

# game/Story02.rpy:4536
translate chinese akt2chapter7_9d189b99:

    # mc "...That line."
    mc "……那句话。"

# game/Story02.rpy:4537
translate chinese akt2chapter7_3c83b55d:

    # mc "City of broken dreams."
    mc "破碎梦想之城。"

# game/Story02.rpy:4538
translate chinese akt2chapter7_9ae1be38:

    # Mi "…Hm?"
    Mi "……嗯？"

# game/Story02.rpy:4539
translate chinese akt2chapter7_c8579042:

    # mc "Is that what this is about?"
    mc "是因为这个吗？"

# game/Story02.rpy:4540
translate chinese akt2chapter7_da3fdbf1_2:

    # Mi "..."
    Mi "……"

# game/Story02.rpy:4543
translate chinese akt2chapter7_96e45bc2:

    # Mi "…Home."
    Mi "……家。"

# game/Story02.rpy:4545
translate chinese akt2chapter7_a29233f8:

    # Mi "…This place… it’s…"
    Mi "……这地方……它……"

# game/Story02.rpy:4546
translate chinese akt2chapter7_902e0bfd:

    # Mi "Special to me."
    Mi "对我很特别。"

# game/Story02.rpy:4548
translate chinese akt2chapter7_d3fb764d:

    # Mi "Here… I…"
    Mi "在这儿……我……"

# game/Story02.rpy:4550
translate chinese akt2chapter7_582359ea:

    # mc "Hm?"
    mc "嗯？"

# game/Story02.rpy:4551
translate chinese akt2chapter7_31153e4a:

    # Mi "…Tell me… have you ever wished you wouldn’t wake up?"
    Mi "……告诉我……你有没有希望过自己不要醒来？"

# game/Story02.rpy:4553
translate chinese akt2chapter7_cf1adef2:

    # mc "Yeah."
    mc "有。"

# game/Story02.rpy:4555
translate chinese akt2chapter7_740bb097:

    # Mi "Why?"
    Mi "为什么？"

# game/Story02.rpy:4557
translate chinese akt2chapter7_60b57106:

    # mc "Stupidity… maybe."
    mc "大概是因为……蠢吧。"

# game/Story02.rpy:4558
translate chinese akt2chapter7_9d0a0734:

    # mc "Or feeling stuck."
    mc "或者觉得被困住了。"

# game/Story02.rpy:4562
translate chinese akt2chapter7_73bf868d:

    # mc "(…Broken dreams.)"
    mc "（……破碎的梦想。）"

# game/Story02.rpy:4563
translate chinese akt2chapter7_21f80a99:

    # mc "You didn’t come here for a new life."
    mc "你来这儿不是为了新生活。"

# game/Story02.rpy:4567
translate chinese akt2chapter7_3be11b7d:

    # Mi "I thought… I believed—"
    Mi "我以为……我相信——"

# game/Story02.rpy:4568
translate chinese akt2chapter7_5db9473a:

    # Mi "That I could find the strength…"
    Mi "我能找到力量……"

# game/Story02.rpy:4570
translate chinese akt2chapter7_1e9e0d30:

    # Mi "To finish what I started."
    Mi "去完成我开启的事。"

# game/Story02.rpy:4573
translate chinese akt2chapter7_2ee6c1ba:

    # Mi "Just one step…"
    Mi "只差一步……"

# game/Story02.rpy:4574
translate chinese akt2chapter7_ec8b1974:

    # Mi "That’s all that stood between me and peace."
    Mi "那是我和安宁之间唯一的距离。"

# game/Story02.rpy:4577
translate chinese akt2chapter7_d231e988:

    # Mi "One step."
    Mi "一步。"

# game/Story02.rpy:4580
translate chinese akt2chapter7_9c9b8577:

    # mc "But you stopped."
    mc "但你停下了。"

# game/Story02.rpy:4582
translate chinese akt2chapter7_e8919b36:

    # Mi "(whispering) …I was scared."
    Mi "（低声）……我害怕了。"

# game/Story02.rpy:4585
translate chinese akt2chapter7_c4cca458:

    # Mi "Another minute… and I would’ve done it, but…"
    Mi "再有一分钟……我就动手了，可是……"

# game/Story02.rpy:4587
translate chinese akt2chapter7_edd9e9ec:

    # Mi "Someone stopped me."
    Mi "有人拦住了我。"

# game/Story02.rpy:4590
translate chinese akt2chapter7_e0f04eb5:

    # mc "And now… you’re back there."
    mc "而现在……你又回到了那个地方。"

# game/Story02.rpy:4594
translate chinese akt2chapter7_f671b6ac:

    # mc "Only now you’ve got something to lose."
    mc "只不过现在，你有了可以失去的东西。"

# game/Story02.rpy:4601
translate chinese akt2chapter7_2fcd0478:

    # mc "(…Maybe.)"
    mc "（……也许。）"

# game/Story02.rpy:4604
translate chinese akt2chapter7_c0a8921c:

    # mc "I almost lost it too."
    mc "我也差点失去它。"

# game/Story02.rpy:4608
translate chinese akt2chapter7_da3fdbf1_3:

    # Mi "..."
    Mi "……"

# game/Story02.rpy:4612
translate chinese akt2chapter7_476ae4a1:

    # Mi "…Let’s go."
    Mi "……走吧。"

# game/Story02.rpy:4614
translate chinese akt2chapter7_99475aef:

    # Mi "I…"
    Mi "我……"

# game/Story02.rpy:4618
translate chinese akt2chapter7_a7677712:

    # Mi "I need someone with me."
    Mi "我需要有人陪着我。"

# game/Story02.rpy:4619
translate chinese akt2chapter7_2b35b6fe_2:

    # mc "..."
    mc "……"

# game/Story02.rpy:4620
translate chinese akt2chapter7_df7ee913:

    # mc "Lead the way."
    mc "带路吧。"

# game/Story02.rpy:4631
translate chinese akt2chapter7_82217262:

    # mc "(She picked up the pace.)"
    mc "（她加快了脚步。）"

# game/Story02.rpy:4632
translate chinese akt2chapter7_64c8929d:

    # mc "(Too fast.)"
    mc "（太快了。）"

# game/Story02.rpy:4636
translate chinese akt2chapter7_c7e3f32b:

    # mc "(She’s not running.)"
    mc "（她不是在跑。）"

# game/Story02.rpy:4639
translate chinese akt2chapter7_8ef64a65:

    # mc "(But she’s not waiting either.)"
    mc "（但也没在等。）"

# game/Story02.rpy:4644
translate chinese akt2chapter7_2b35b6fe_3:

    # mc "..."
    mc "……"

# game/Story02.rpy:4646
translate chinese akt2chapter7_9e78535a:

    # mc "(…Where’d she go?)"
    mc "（……她去哪了？）"

# game/Story02.rpy:4648
translate chinese akt2chapter7_40c3d6b9:

    # a "Looking for someone?"
    a "找人？"

# game/Story02.rpy:4653
translate chinese akt2chapter7_921805a7:

    # mc "You seen a short, tanned girl?"
    mc "见过一个矮个子、皮肤黝黑的女孩吗？"

# game/Story02.rpy:4655
translate chinese akt2chapter7_bb8e4b4e:

    # a "..."
    a "……"

# game/Story02.rpy:4657
translate chinese akt2chapter7_c61de1e8:

    # a "You’re lagging behind alread—"
    a "你已经落后了——"

# game/Story02.rpy:4664
translate chinese akt2chapter7_b6b4da37:

    # mc "(…What the hell was that?)"
    mc "（……那到底是什么？）"

# game/Story02.rpy:4668
translate chinese akt2chapter7_3afa4f18:

    # Mi "…A hologram."
    Mi "……全息影像。"

# game/Story02.rpy:4669
translate chinese akt2chapter7_ff2b0516:

    # mc "And how long have you been standing there?"
    mc "你在那儿站多久了？"

# game/Story02.rpy:4671
translate chinese akt2chapter7_da3fdbf1_4:

    # Mi "..."
    Mi "……"

# game/Story02.rpy:4672
translate chinese akt2chapter7_0bfa5814:

    # Mi "…I never left."
    Mi "……我根本没走。"

# game/Story02.rpy:4674
translate chinese akt2chapter7_26b6d608:

    # mc "You disappeared."
    mc "你消失了。"

# game/Story02.rpy:4675
translate chinese akt2chapter7_da3fdbf1_5:

    # Mi "..."
    Mi "……"

# game/Story02.rpy:4677
translate chinese akt2chapter7_f32f8a2f:

    # mc "So… this is it?"
    mc "所以……就是这儿？"

# game/Story02.rpy:4679
translate chinese akt2chapter7_fb12b2e7:

    # Mi "Yes..."
    Mi "是……"

# game/Story02.rpy:4682
translate chinese akt2chapter7_b85f2672:

    # mc "What’s wrong?"
    mc "怎么了？"

# game/Story02.rpy:4683
translate chinese akt2chapter7_da3fdbf1_6:

    # Mi "..."
    Mi "……"

# game/Story02.rpy:4684
translate chinese akt2chapter7_9755264c:

    # Mi "…I’m scared."
    Mi "……我害怕。"

# game/Story02.rpy:4686
translate chinese akt2chapter7_0d3e04cb:

    # Mi "That they’ll kill you the moment you step inside."
    Mi "怕你一踏进去他们就会杀了你。"

# game/Story02.rpy:4687
translate chinese akt2chapter7_f9803e8f:

    # mc "I’m already here."
    mc "我已经在这儿了。"

# game/Story02.rpy:4688
translate chinese akt2chapter7_da3fdbf1_7:

    # Mi "..."
    Mi "……"

# game/Story02.rpy:4689
translate chinese akt2chapter7_f9dcceec:

    # mc "Let’s hope it doesn’t come to that."
    mc "但愿不会到那一步。"

# game/Story02.rpy:4705
translate chinese mirielhome_234dc169:

    # mc "(Air feels different here.)"
    mc "（这儿的空气不一样。）"

# game/Story02.rpy:4706
translate chinese mirielhome_674bb5ab:

    # mc "(So does everything else.)"
    mc "（其他一切也是。）"

# game/Story02.rpy:4709
translate chinese mirielhome_9122702b:

    # Mi "…You’re the first person I’ve brought here."
    Mi "……你是我第一个带来这儿的人。"

# game/Story02.rpy:4711
translate chinese mirielhome_f7bd1159:

    # mc "They’re close, aren’t they?"
    mc "他们关系很近，对吧？"

# game/Story02.rpy:4714
translate chinese mirielhome_f1a1b640:

    # Mi "…Yeah."
    Mi "……嗯。"

# game/Story02.rpy:4717
translate chinese mirielhome_813705e9:

    # Mi "Please. Stay close to me."
    Mi "拜托。跟紧我。"

# game/Story02.rpy:4720
translate chinese mirielhome_6651ab87:

    # mc "Alright."
    mc "好。"

# game/Story02.rpy:4723
translate chinese mirielhome_da3fdbf1:

    # Mi "..."
    Mi "……"

# game/Story02.rpy:4725
translate chinese mirielhome_0a348999:

    # Mi "Enough hiding, come out."
    Mi "别躲了，出来。"

# game/Story02.rpy:4728
translate chinese mirielhome_71e05766:

    # a "Outsiders aren’t welcome here."
    a "外人不欢迎。"

# game/Story02.rpy:4729
translate chinese mirielhome_81fbcc4c:

    # a "And-"
    a "而且——"

# game/Story02.rpy:4730
translate chinese mirielhome_ec096dcb:

    # a "We thought you’d abandoned us..."
    a "我们以为你抛弃我们了……"

# game/Story02.rpy:4732
translate chinese mirielhome_229a3b17:

    # Mi "As if I ever had a choice. Riya."
    Mi "说得好像我有得选似的。莉娅。"

# game/Story02.rpy:4734
translate chinese mirielhome_7447ec08:

    # ry "Excuses again?"
    ry "又是借口？"

# game/Story02.rpy:4736
translate chinese mirielhome_b0d624f3:

    # Mi "If I’m not welcome, say it."
    Mi "不欢迎我就直说。"

# game/Story02.rpy:4738
translate chinese mirielhome_850ef128:

    # b "..."
    b "……"

# game/Story02.rpy:4742
translate chinese mirielhome_f640b8ba:

    # ry "Always taking everything too close to heart, huh?"
    ry "总是什么都往心里去，是吧？"

# game/Story02.rpy:4743
translate chinese mirielhome_587e8ac1:

    # ry "Welcome home, Ellie."
    ry "欢迎回家，艾莉。"

# game/Story02.rpy:4745
translate chinese mirielhome_81a7bb7f:

    # a "Mhm, mhm..."
    a "嗯，嗯……"

# game/Story02.rpy:4751
translate chinese mirielhome_df0283dd:

    # Mi "Riya, Zoya..."
    Mi "莉娅，卓娅……"

# game/Story02.rpy:4753
translate chinese mirielhome_1f9bf24d:

    # Mi "…I’m home."
    Mi "……我回来了。"

# game/Story02.rpy:4755
translate chinese mirielhome_850ef128_1:

    # b "..."
    b "……"

# game/Story02.rpy:4759
translate chinese mirielhome_9de0df99:

    # ry "Why do you need him?"
    ry "你为什么需要他？"

# game/Story02.rpy:4761
translate chinese mirielhome_c128b8f0:

    # ry "What do you want from our Ellie?"
    ry "你想从我们的艾莉这儿得到什么？"

# game/Story02.rpy:4762
translate chinese mirielhome_489d9054:

    # zo "Mhm, mhm!?"
    zo "嗯，嗯！？"

# game/Story02.rpy:4764
translate chinese mirielhome_b9dd27c4:

    # mc "Here to help."
    mc "来帮忙的。"

# game/Story02.rpy:4766
translate chinese mirielhome_a197efe0:

    # ry "..."
    ry "……"

# game/Story02.rpy:4767
translate chinese mirielhome_ed33888d:

    # ry "Seriously?"
    ry "认真的？"

# game/Story02.rpy:4770
translate chinese mirielhome_862510af:

    # Mi "He’s with me… This is [mc], he’s…"
    Mi "他跟我一起来的……这是 [mc]，他……"

# game/Story02.rpy:4772
translate chinese mirielhome_f95cdd05:

    # ry "Ellie."
    ry "艾莉。"

# game/Story02.rpy:4773
translate chinese mirielhome_c6b81865:

    # ry "You know the rules, he doesn’t belong here."
    ry "你知道规矩，他不属于这儿。"

# game/Story02.rpy:4774
translate chinese mirielhome_98713f92:

    # ry "We know you. Him? Not so much."
    ry "我们认识你。他？不太认识。"

# game/Story02.rpy:4776
translate chinese mirielhome_63bffe7f:

    # Mi "He’s my responsibility."
    Mi "他由我负责。"

# game/Story02.rpy:4778
translate chinese mirielhome_1e6e2712:

    # ry "You lost our trust the moment you walked away."
    ry "你离开的那一刻就失去了我们的信任。"

# game/Story02.rpy:4781
translate chinese mirielhome_80fd9747:

    # Mi "I lost it… but I didn’t throw it away."
    Mi "我失去了……但我没有丢弃它。"

# game/Story02.rpy:4782
translate chinese mirielhome_1a0243a8:

    # Mi "…Just this once. Look the other way."
    Mi "……就这一次。睁一只眼闭一只眼。"

# game/Story02.rpy:4784
translate chinese mirielhome_2b020732:

    # ry "We’ll see what the others have to say."
    ry "看看其他人怎么说。"

