# game/Story02.rpy:2675
translate chinese akt2chapter4_2ff61cfe:

    # h "You sure you don’t wa-"
    h "你确定你不想——"

# game/Story02.rpy:2677
translate chinese akt2chapter4_7bdfbcc7:

    # mc "...Enough."
    mc "……够了。"

# game/Story02.rpy:2691
translate chinese akt2chapter4_6751fdbd:

    # mc "(…not now.)"
    mc "（……不是现在。）"

# game/Story02.rpy:2693
translate chinese akt2chapter4_72471cb9:

    # h "I thought…"
    h "我以为……"

# game/Story02.rpy:2694
translate chinese akt2chapter4_4e8967b5:

    # h "I really thought you’d—"
    h "我真以为你会——"

# game/Story02.rpy:2696
translate chinese akt2chapter4_3ada0761:

    # h "Die."
    h "死。"

# game/Story02.rpy:2699
translate chinese akt2chapter4_850ef128_1:

    # b "..."
    b "……"

# game/Story02.rpy:2701
translate chinese akt2chapter4_ff78c76d:

    # mc "(Shit…)"
    mc "（操……）"

# game/Story02.rpy:2705
translate chinese akt2chapter4_48db313f:

    # mc "(Move. Now.)"
    mc "（走。现在。）"

# game/Story02.rpy:2716
translate chinese akt2chapter4_43bd3d63:

    # gg "COME ON, WE CAN’T LEAVE HIM HERE!"
    gg "快点，不能把他丢这儿！"

# game/Story02.rpy:2718
translate chinese akt2chapter4_705e2123:

    # o "If we stay, we go with him."
    o "留下就是跟他一起死。"

# game/Story02.rpy:2719
translate chinese akt2chapter4_b808da4f:

    # o "...He made his choice."
    o "……他做了选择。"

# game/Story02.rpy:2721
translate chinese akt2chapter4_38b489b0:

    # g "Commander! {w=0.5}There’s a way through here!"
    g "指挥官！{w=0.5}这儿有条路！"

# game/Story02.rpy:2723
translate chinese akt2chapter4_85260f14:

    # o "MOVE!"
    o "走！"

# game/Story02.rpy:2725
translate chinese akt2chapter4_0b037596:

    # o "...If you survive, we’ll find each other."
    o "……要是你活下来，我们会找到彼此。"

# game/Story02.rpy:2732
translate chinese akt2chapter4_fd1a52b2:

    # k "Why are you just standing there?"
    k "你站那儿干嘛？"

# game/Story02.rpy:2734
translate chinese akt2chapter4_7ce86528:

    # k "Get the hell out of here."
    k "快滚。"

# game/Story02.rpy:2756
translate chinese akt2chapter4_1c35810a:

    # h "...alive."
    h "……活着。"

# game/Story02.rpy:2758
translate chinese akt2chapter4_011c2858:

    # mc "I was out? For long?"
    mc "我昏过去了？多久？"

# game/Story02.rpy:2760
translate chinese akt2chapter4_a12354e7:

    # h "Long enough for me to start worrying."
    h "久到我都开始担心了。"

# game/Story02.rpy:2761
translate chinese akt2chapter4_2fded262_2:

    # h "..."
    h "……"

# game/Story02.rpy:2764
translate chinese akt2chapter4_82de038b:

    # mc "(Breathing… feels tight. Like something’s sitting on my chest.)"
    mc "（呼吸……发紧。像有东西压在胸口。）"

# game/Story02.rpy:2767
translate chinese akt2chapter4_99d65f3d:

    # h "That’s the third time she’s saved our asses."
    h "这是她第三次救我们的命了。"

# game/Story02.rpy:2769
translate chinese akt2chapter4_37b29c63:

    # h "Kinda funny, don’t you think?"
    h "挺有意思的，你不觉得吗？"

# game/Story02.rpy:2771
translate chinese akt2chapter4_57a083c8:

    # h "Delta Squad… we were sent on the worst missions out there."
    h "三角洲小队……我们总被派去最糟的任务。"

# game/Story02.rpy:2773
translate chinese akt2chapter4_9659d813:

    # h "But when I saw that building coming down on us..."
    h "可我看到那栋楼朝我们砸下来时……"

# game/Story02.rpy:2774
translate chinese akt2chapter4_72aa2aea:

    # h "I just froze."
    h "我直接僵住了。"

# game/Story02.rpy:2775
translate chinese akt2chapter4_608f8897:

    # h "Legs wouldn’t move. Voice shaking."
    h "腿动不了。声音发抖。"

# game/Story02.rpy:2776
translate chinese akt2chapter4_0be18a8b:

    # h "Just stood there like an idiot... {w=0.5}waiting to die."
    h "像个傻子一样站着……{w=0.5}等着死。"

# game/Story02.rpy:2778
translate chinese akt2chapter4_c7bf6495:

    # mc "We’re all human."
    mc "我们都是人。"

# game/Story02.rpy:2780
translate chinese akt2chapter4_d5470623:

    # k "Making excuses, old man."
    k "找借口，老头。"

# game/Story02.rpy:2782
translate chinese akt2chapter4_686abf87:

    # h "Morning, sunshine."
    h "早啊，小太阳。"

# game/Story02.rpy:2783
translate chinese akt2chapter4_a6ff6069:

    # h "Finally awake? Hope you enjoyed your nap."
    h "终于醒了？希望你睡得好。"

# game/Story02.rpy:2785
translate chinese akt2chapter4_82091822_3:

    # k "..."
    k "……"

# game/Story02.rpy:2788
translate chinese akt2chapter4_2b35b6fe_3:

    # mc "..."
    mc "……"

# game/Story02.rpy:2789
translate chinese akt2chapter4_4905c740:

    # mc "…You hurt?"
    mc "……受伤了？"

# game/Story02.rpy:2790
translate chinese akt2chapter4_82091822_4:

    # k "..."
    k "……"

# game/Story02.rpy:2792
translate chinese akt2chapter4_d02f6d7a:

    # k "Cute."
    k "挺可爱。"

# game/Story02.rpy:2793
translate chinese akt2chapter4_1f4cd412:

    # k "Try worrying about yourself first."
    k "先管好你自己吧。"

# game/Story02.rpy:2796
translate chinese akt2chapter4_84ee1dea:

    # Mi "…Having fun?"
    Mi "……玩得开心？"

# game/Story02.rpy:2797
translate chinese akt2chapter4_cc53e855:

    # k "Got room for one more."
    k "还塞得下一个。"

# game/Story02.rpy:2798
translate chinese akt2chapter4_e904a7cd:

    # k "If you’re feeling brave."
    k "如果你胆子够大。"

# game/Story02.rpy:2800
translate chinese akt2chapter4_b4d3c579:

    # Mi "N-no thanks."
    Mi "不……不用了。"

# game/Story02.rpy:2802
translate chinese akt2chapter4_44731cb1:

    # mc "Mir."
    mc "米儿。"

# game/Story02.rpy:2803
translate chinese akt2chapter4_5e7b220b:

    # mc "What about Ostorius?"
    mc "奥斯特里乌斯呢？"

# game/Story02.rpy:2807
translate chinese akt2chapter4_6498f6bd:

    # Mi "The collapse cut him off."
    Mi "塌方把他隔开了。"

# game/Story02.rpy:2808
translate chinese akt2chapter4_38f8225e:

    # Mi "Last ping came from the eastern route."
    Mi "最后的信号来自东边那条路。"

# game/Story02.rpy:2809
translate chinese akt2chapter4_d7033064:

    # Mi "He said he'd draw them away and reconnect when he could."
    Mi "他说会引开它们，能联系上时就联系。"

# game/Story02.rpy:2811
translate chinese akt2chapter4_100a2bcd:

    # k "He’s got a habit of leaving people behind."
    k "他有丢下人的习惯。"

# game/Story02.rpy:2812
translate chinese akt2chapter4_b6870fce:

    # k "…Then again."
    k "……话说回来。"

# game/Story02.rpy:2813
translate chinese akt2chapter4_4b3309e4:

    # k "So do most of you."
    k "你们大多数也一样。"

# game/Story02.rpy:2815
translate chinese akt2chapter4_a68398b6:

    # h "Got a problem?"
    h "有意见？"

# game/Story02.rpy:2817
translate chinese akt2chapter4_b678cff4:

    # k "Hm."
    k "嗯。"

# game/Story02.rpy:2818
translate chinese akt2chapter4_c3b40072:

    # k "Yeah."
    k "有。"

# game/Story02.rpy:2819
translate chinese akt2chapter4_0fa5903a:

    # k "And what are you going to do about it?"
    k "那你打算怎么办？"

# game/Story02.rpy:2820
translate chinese akt2chapter4_2fded262_3:

    # h "..."
    h "……"

# game/Story02.rpy:2822
translate chinese akt2chapter4_b7b21034:

    # h "...Nothing."
    h "……没什么。"

# game/Story02.rpy:2824
translate chinese akt2chapter4_ba201647:

    # k "Funny. {w=0.5}Your face says otherwise."
    k "有意思。{w=0.5}你脸上可不是这么写的。"

# game/Story02.rpy:2826
translate chinese akt2chapter4_b9c47a64:

    # h "I don’t like you."
    h "我不喜欢你。"

# game/Story02.rpy:2827
translate chinese akt2chapter4_65696d9d:

    # h "But for his sake… I’ll tolerate you."
    h "但看在他的份上……我忍你。"

# game/Story02.rpy:2829
translate chinese akt2chapter4_dcd86e92:

    # k "Oh?"
    k "哦？"

# game/Story02.rpy:2830
translate chinese akt2chapter4_8782f7f3:

    # k "I’m honored."
    k "荣幸之至。"

# game/Story02.rpy:2836
translate chinese akt2chapter4_82091822_5:

    # k "..."
    k "……"

# game/Story02.rpy:2838
translate chinese akt2chapter4_6917a82e:

    # k "Alright."
    k "行。"

# game/Story02.rpy:2839
translate chinese akt2chapter4_9e2d3eb5:

    # k "What’s the plan?"
    k "什么计划？"

# game/Story02.rpy:2841
translate chinese akt2chapter4_75817c20:

    # Mi "…[mc]?"
    Mi "……[mc]？"

# game/Story02.rpy:2844
translate chinese akt2chapter4_1d6ce146:

    # mc "Blue Moon. Sector 6."
    mc "蓝月。6区。"

# game/Story02.rpy:2845
translate chinese akt2chapter4_60e321f8:

    # mc "Meet Flora. Get her on our side. Figure out what the hell’s going on."
    mc "找弗洛拉。让她站我们这边。搞清到底怎么回事。"

# game/Story02.rpy:2847
translate chinese akt2chapter4_684b7af6:

    # k "You’ve got guts, old man."
    k "你有胆，老头。"

# game/Story02.rpy:2850
translate chinese akt2chapter4_6d41fafb:

    # mc "(What do you mean?)"
    mc "（什么意思？）"

# game/Story02.rpy:2851
translate chinese akt2chapter4_f5c5fae1:

    # k "(You’ll see.)"
    k "（你会知道的。）"

# game/Story02.rpy:2852
translate chinese akt2chapter4_739af0c1:

    # k "(Call it a surprise.)"
    k "（就当是个惊喜。）"

# game/Story02.rpy:2855
translate chinese akt2chapter4_0de1b446:

    # k "Hey, shorty."
    k "嘿，矮子。"

# game/Story02.rpy:2856
translate chinese akt2chapter4_7495f152:

    # k "Temporary truce?"
    k "暂时停战？"

# game/Story02.rpy:2858
translate chinese akt2chapter4_ebac5e46:

    # k "At least until this mess settles."
    k "至少等这摊烂事结束。"

# game/Story02.rpy:2859
translate chinese akt2chapter4_843215c2:

    # k "What do you say?"
    k "怎么样？"

# game/Story02.rpy:2860
translate chinese akt2chapter4_2fded262_4:

    # h "..."
    h "……"

# game/Story02.rpy:2862
translate chinese akt2chapter4_506f42dc:

    # h "Fine. I’ll play along."
    h "行。我配合。"

# game/Story02.rpy:2863
translate chinese akt2chapter4_91766d23:

    # h "Doesn’t mean I trust you."
    h "不代表我信你。"

# game/Story02.rpy:2865
translate chinese akt2chapter4_9d5a6ddf:

    # k "Whatever you say, shorty."
    k "随你怎么说，矮子。"

# game/Story02.rpy:2868
translate chinese akt2chapter4_ac579582:

    # k "I’ll leave you two alone."
    k "你们俩单独待着吧。"

# game/Story02.rpy:2869
translate chinese akt2chapter4_8c9bec23:

    # k "Try not to die."
    k "尽量别死。"

# game/Story02.rpy:2871
translate chinese akt2chapter4_3eb6c693:

    # h "Finally… some space."
    h "终于……有点空间了。"

# game/Story02.rpy:2874
translate chinese akt2chapter4_1314bfa4:

    # h "Hey… mind if I just…"
    h "嘿……介意我就……"

# game/Story02.rpy:2880
translate chinese akt2chapter4_1b031bf6:

    # mc "Yeah. It’s cold, but it’s fine."
    mc "嗯。有点冷，不过没事。"

# game/Story02.rpy:2883
translate chinese akt2chapter4_ef4c6b39:

    # h "Eh, not a big deal."
    h "呃，没什么。"

# game/Story02.rpy:2885
translate chinese akt2chapter4_2b35b6fe_4:

    # mc "..."
    mc "……"

# game/Story02.rpy:2887
translate chinese akt2chapter4_73d05893:

    # mc "...You okay?"
    mc "……你没事吧？"

# game/Story02.rpy:2889
translate chinese akt2chapter4_546bb74f:

    # h "…Not really."
    h "……不太好。"

# game/Story02.rpy:2890
translate chinese akt2chapter4_8fc2b132:

    # h "We’re about to see Lora and…"
    h "我们马上要见洛拉了，而且……"

# game/Story02.rpy:2892
translate chinese akt2chapter4_0af34ecd:

    # mc "You’re nervous."
    mc "你紧张。"

# game/Story02.rpy:2894
translate chinese akt2chapter4_149a9d97:

    # h "You’re not?"
    h "你不紧张？"

# game/Story02.rpy:2896
translate chinese akt2chapter4_2b35b6fe_5:

    # mc "..."
    mc "……"

# game/Story02.rpy:2898
translate chinese akt2chapter4_d6baff5f:

    # mc "Remember?"
    mc "记得吗？"

# game/Story02.rpy:2900
translate chinese akt2chapter4_8aab296b:

    # mc "When we handed you the warehouse."
    mc "我们把仓库交给你的时候。"

# game/Story02.rpy:2901
translate chinese akt2chapter4_f0f50e58:

    # mc "What were you feeling?"
    mc "你当时什么感觉？"

# game/Story02.rpy:2903
translate chinese akt2chapter4_fe9c2d4a:

    # h "I was a mess, to put it lightly."
    h "往轻了说，一团糟。"

# game/Story02.rpy:2905
translate chinese akt2chapter4_87599aed:

    # mc "And what did Lora say back then?"
    mc "那洛拉当时说了什么？"

# game/Story02.rpy:2907
translate chinese akt2chapter4_2fded262_5:

    # h "..."
    h "……"

# game/Story02.rpy:2909
translate chinese akt2chapter4_798e7765:

    # h "If I start worrying… I…"
    h "要是我开始担心……我……"

# game/Story02.rpy:2911
translate chinese akt2chapter4_85c182d8:

    # mc "Doesn’t change the outcome."
    mc "改变不了结果。"

# game/Story02.rpy:2913
translate chinese akt2chapter4_a3543490:

    # h "That’s… not exactly comforting."
    h "这……不太能安慰人。"

# game/Story02.rpy:2915
translate chinese akt2chapter4_ec243024:

    # mc "It’s not supposed to."
    mc "本来也不是为了安慰。"

# game/Story02.rpy:2917
translate chinese akt2chapter4_869a52e4:

    # h "…And your point is?"
    h "……那你想说什么？"

# game/Story02.rpy:2919
translate chinese akt2chapter4_88f16ec9:

    # mc "...So don’t let it control you."
    mc "……所以别让它控制你。"

# game/Story02.rpy:2921
translate chinese akt2chapter4_cf9c9f72:

    # h "That’s not the same. Not even close."
    h "这不一样。差远了。"

# game/Story02.rpy:2924
translate chinese akt2chapter4_a3669ba7:

    # Mi "…You done resting?"
    Mi "……休息好了吗？"

# game/Story02.rpy:2929
translate chinese akt2chapter4_87f4dbdd:

    # k "Your uniform, old man."
    k "你的制服，老头。"

# game/Story02.rpy:2931
translate chinese akt2chapter4_e4c0c4b1:

    # Mi "They… don’t take kindly to it."
    Mi "他们……不太待见这身。"

# game/Story02.rpy:2933
translate chinese akt2chapter4_6ec9790d:

    # k "Kindly?"
    k "待见？"

# game/Story02.rpy:2934
translate chinese akt2chapter4_cb8f73a3:

    # k "…Please."
    k "……拜托。"

# game/Story02.rpy:2935
translate chinese akt2chapter4_7b946266:

    # k "They’ll tear you apart the moment they get the chance."
    k "一有机会他们就会把你撕碎。"

# game/Story02.rpy:2937
translate chinese akt2chapter4_ef2f0419:

    # k "To them… we’re worse than monsters."
    k "对他们来说……我们比怪物还不如。"

# game/Story02.rpy:2942
translate chinese akt2chapter4_f2b660ec:

    # h "Well… that’s reassuring."
    h "嗯……真让人安心。"

# game/Story02.rpy:2946
translate chinese akt2chapter4_78bc329f:

    # Mi "So we should…"
    Mi "那我们该……"

# game/Story02.rpy:2949
translate chinese akt2chapter4_3f2dd5ed:

    # h "Then we stay."
    h "那就留下。"

# game/Story02.rpy:2953
translate chinese akt2chapter4_cf1adef2:

    # mc "Yeah."
    mc "嗯。"

# game/Story02.rpy:2955
translate chinese akt2chapter4_c30a2c76:

    # k "Can’t wait to hear the story?"
    k "等不及想听故事了？"

# game/Story02.rpy:2956
translate chinese akt2chapter4_5ac323e4:

    # k "About how we butchered half a city?"
    k "关于我们怎么屠了半座城？"

# game/Story02.rpy:2959
translate chinese akt2chapter4_fb43015c:

    # mc "Then say it."
    mc "那就说。"

# game/Story02.rpy:2960
translate chinese akt2chapter4_82091822_6:

    # k "..."
    k "……"

# game/Story02.rpy:2962
translate chinese akt2chapter4_7c5bca36:

    # mc "You’re not walking away from this without an answer."
    mc "不给个答案你别想走。"

# game/Story02.rpy:2963
translate chinese akt2chapter4_dbd62e0f:

    # k "And you ran-"
    k "而你自己逃——"

# game/Story02.rpy:2964
translate chinese akt2chapter4_675dfef5:

    # mc "Back then, yeah."
    mc "那时候，是。"

# game/Story02.rpy:2965
translate chinese akt2chapter4_d14b1cea:

    # mc "Now you talk."
    mc "现在你说。"

# game/Story02.rpy:2968
translate chinese akt2chapter4_6926df41:

    # k "Watch your to-"
    k "注意你的语——"

# game/Story02.rpy:2970
translate chinese akt2chapter4_6b2eda57:

    # mc "Why don’t you want to go back there?"
    mc "你为什么不想回那儿？"

# game/Story02.rpy:2971
translate chinese akt2chapter4_82091822_7:

    # k "..."
    k "……"

# game/Story02.rpy:2973
translate chinese akt2chapter4_faa1ac42:

    # mc "Every time it comes up, you shut down."
    mc "每次提到这事，你就闭口不谈。"

# game/Story02.rpy:2975
translate chinese akt2chapter4_327ee225:

    # k "Oh, look who-"
    k "哦，看看谁——"

# game/Story02.rpy:2977
translate chinese akt2chapter4_71a06277:

    # mc "Mir. Say it."
    mc "米儿。说。"

# game/Story02.rpy:2979
translate chinese akt2chapter4_0700c98a:

    # Mi "She…"
    Mi "她……"

# game/Story02.rpy:2982
translate chinese akt2chapter4_6bde73a1:

    # h "Knowing them—"
    h "了解他们的话——"

# game/Story02.rpy:2984
translate chinese akt2chapter4_331809ce_1:

    # mc "Liv."
    mc "莉芙。"

# game/Story02.rpy:2985
translate chinese akt2chapter4_485237e2:

    # h "Do you even hear yourself right now?"
    h "你听见自己在说什么吗？"

# game/Story02.rpy:2987
translate chinese akt2chapter4_70ce71e1:

    # mc "Not now."
    mc "现在别说。"

# game/Story02.rpy:2989
translate chinese akt2chapter4_fdf4cc37:

    # mc "Talk."
    mc "说。"

# game/Story02.rpy:2991
translate chinese akt2chapter4_9c073c24:

    # k "Alright, alright. You win."
    k "行行行。你赢了。"

# game/Story02.rpy:2992
translate chinese akt2chapter4_991f0524:

    # k "You want a story?"
    k "想听故事？"

# game/Story02.rpy:2994
translate chinese akt2chapter4_2a5dc2bb:

    # k "Fine."
    k "行。"

# game/Story02.rpy:3013
translate chinese akt2chapter4_0eefda61:

    # k "(We had one order.)"
    k "（我们只有一条命令。）"

# game/Story02.rpy:3014
translate chinese akt2chapter4_cf15f649:

    # k "(Clear Sectors Seven and Six.)"
    k "（清空7区和6区。）"

# game/Story02.rpy:3017
translate chinese akt2chapter4_c52c3b4e:

    # k "(Everything alive.)"
    k "（所有活着的。）"

# game/Story02.rpy:3018
translate chinese akt2chapter4_77951032:

    # k "(No exceptions.)"
    k "（没有例外。）"

# game/Story02.rpy:3020
translate chinese akt2chapter4_814350fd:

    # a "Please… have mercy…"
    a "求你了……发发慈悲……"

# game/Story02.rpy:3021
translate chinese akt2chapter4_49a9cace:

    # k "(...)"
    k "（……）"

# game/Story02.rpy:3032
translate chinese akt2chapter4_05f46703:

    # k "…They remember."
    k "……他们记得。"

# game/Story02.rpy:3033
translate chinese akt2chapter4_9509041a:

    # k "The ones who lived."
    k "活下来的人记得。"

# game/Story02.rpy:3034
translate chinese akt2chapter4_4f10ac3d:

    # k "The ones born after."
    k "之后出生的人也记得。"

# game/Story02.rpy:3035
translate chinese akt2chapter4_48384fc5:

    # k "Stories survive longer than bodies."
    k "故事比尸体活得久。"

# game/Story02.rpy:3041
translate chinese akt2chapter4_48c351d9:

    # k "…They won’t forget."
    k "……他们不会忘。"

# game/Story02.rpy:3043
translate chinese akt2chapter4_2b35b6fe_6:

    # mc "..."
    mc "……"

# game/Story02.rpy:3045
translate chinese akt2chapter4_75f652cc:

    # mc "So be it."
    mc "那就这样吧。"

# game/Story02.rpy:3049
translate chinese akt2chapter4_7622ba8a:

    # k "We’re not going there."
    k "我们不去那儿。"

# game/Story02.rpy:3051
translate chinese akt2chapter4_52271bca:

    # mc "...We are."
    mc "……我们去。"

# game/Story02.rpy:3055
translate chinese akt2chapter4_471848f1:

    # k "…You’re an idiot."
    k "……你是个白痴。"

# game/Story02.rpy:3064
translate chinese akt2chapter4_426b45dd:

    # Mi "(whisper) ...there."
    Mi "（低声）……那儿。"

# game/Story02.rpy:3065
translate chinese akt2chapter4_ef74e6fe:

    # Mi "[mc]… we’re ready to move."
    Mi "[mc]……可以出发了。"

# game/Story02.rpy:3068
translate chinese akt2chapter4_2562ad6f_1:

    # mc "Move."
    mc "走。"

# game/Story02.rpy:3074
translate chinese akt2chapter4_fff3dd31:

    # h "Wait, what is this 'Lower Town' exactly?"
    h "等等，这‘下城’到底是什么？"

# game/Story02.rpy:3077
translate chinese akt2chapter4_90616a30:

    # h "I thought that was just a figure of speech..."
    h "我以为那只是个比喻……"

# game/Story02.rpy:3080
translate chinese akt2chapter4_a900515a:

    # k "Up here, you’ve got the poor."
    k "在上面，你有穷人。"

# game/Story02.rpy:3081
translate chinese akt2chapter4_b303fc9c:

    # k "Down there?"
    k "在下面？"

# game/Story02.rpy:3082
translate chinese akt2chapter4_6ccd3e1c:

    # k "The ones who never even had a chance."
    k "是连机会都没有过的人。"

# game/Story02.rpy:3084
translate chinese akt2chapter4_31e333ee:

    # k "If you were born in Lower Town, you die in Lower Town."
    k "生在下城，就死在下城。"

# game/Story02.rpy:3086
translate chinese akt2chapter4_97808530:

    # h "And you want us to go down there?"
    h "你想让我们下去？"

# game/Story02.rpy:3088
translate chinese akt2chapter4_9a9a1016:

    # k "Me? No. The old man? Yeah."
    k "我？不。老头？想。"

# game/Story02.rpy:3089
translate chinese akt2chapter4_4d535be0:

    # mc "We’re not here sightseeing."
    mc "我们不是来观光的。"

# game/Story02.rpy:3091
translate chinese akt2chapter4_f9149dc9:

    # h "You know what..."
    h "你知道吗……"

# game/Story02.rpy:3092
translate chinese akt2chapter4_9955e79a:

    # h "If it’s really that bad, maybe we just don’t go."
    h "真那么糟的话，也许我们就不去了。"

# game/Story02.rpy:3095
translate chinese akt2chapter4_d0c168de:

    # mc "You both, enough."
    mc "你们俩，够了。"

# game/Story02.rpy:3097
translate chinese akt2chapter4_ac88ce93:

    # mc "We’re going down."
    mc "我们下去。"

# game/Story02.rpy:3098
translate chinese akt2chapter4_768a5031:

    # mc "Or did you forget why we’re here?"
    mc "还是你忘了我们为什么来？"

# game/Story02.rpy:3100
translate chinese akt2chapter4_10f0efed:

    # Mi "…The meeting with Emberlin?"
    Mi "……见恩伯琳？"

# game/Story02.rpy:3101
translate chinese akt2chapter4_716019b8:

    # mc "Right."
    mc "对。"

# game/Story02.rpy:3104
translate chinese akt2chapter4_54aa351d:

    # mc "If we stayed up top, we’d be dead already."
    mc "留在上面，我们早死了。"

# game/Story02.rpy:3105
translate chinese akt2chapter4_0e4a133a:

    # mc "Down there… at least we’ve got a shot to talk."
    mc "在下面……至少还有机会谈。"

# game/Story02.rpy:3109
translate chinese akt2chapter4_724be5fb:

    # Mi "(whispering) …I’m not sure."
    Mi "（低声）……我不确定。"

# game/Story02.rpy:3110
translate chinese akt2chapter4_7c136244:

    # mc "Because of the uniform?"
    mc "因为这身制服？"

# game/Story02.rpy:3111
translate chinese akt2chapter4_f1a1b640:

    # Mi "…Yeah."
    Mi "……嗯。"

# game/Story02.rpy:3113
translate chinese akt2chapter4_a154b9e3:

    # h "Even Mir’s not sure."
    h "连米儿都不确定。"

# game/Story02.rpy:3114
translate chinese akt2chapter4_8a319f6b:

    # h "What kind of place is this Lower Town anyway...?"
    h "这‘下城’到底是什么地方……？"

# game/Story02.rpy:3115
translate chinese akt2chapter4_96e45bc2:

    # Mi "…Home."
    Mi "……家。"

# game/Story02.rpy:3116
translate chinese akt2chapter4_2fded262_6:

    # h "..."
    h "……"

# game/Story02.rpy:3119
translate chinese akt2chapter4_e0bfd693:

    # k "You have no idea, where you’re going."
    k "你根本不知道你要去哪儿。"

# game/Story02.rpy:3120
translate chinese akt2chapter4_96e1cff9:

    # mc "We’re meeting them, Kalestra."
    mc "我们要见他们，卡莱斯特拉。"

# game/Story02.rpy:3121
translate chinese akt2chapter4_173c1612:

    # mc "No way around it."
    mc "绕不过去。"

# game/Story02.rpy:3133
translate chinese akt2chapter4_2fded262_7:

    # h "..."
    h "……"

# game/Story02.rpy:3135
translate chinese akt2chapter4_778b04c0:

    # h "...What was that?"
    h "……刚才那是什么？"

# game/Story02.rpy:3137
translate chinese akt2chapter4_54d9e503:

    # mc "...It’s fine. Just—"
    mc "……没事。就是——"

# game/Story02.rpy:3139
translate chinese akt2chapter4_3182f744:

    # h "What, getting nervous?"
    h "怎么，紧张了？"

# game/Story02.rpy:3141
translate chinese akt2chapter4_d875ef64:

    # mc "...Forget it."
    mc "……算了。"

# game/Story02.rpy:3144
translate chinese akt2chapter4_a837bc6c:

    # mc "(…Not now.)"
    mc "（……不是现在。）"

# game/Story02.rpy:3147
translate chinese akt2chapter4_e029d773:

    # h "...?"
    h "……？"

# game/Story02.rpy:3153
translate chinese akt2chapter4_82987a0d:

    # h "...You getting nervous about this meeting?"
    h "……你对这次会面紧张吗？"

# game/Story02.rpy:3155
translate chinese akt2chapter4_2b35b6fe_7:

    # mc "..."
    mc "……"

# game/Story02.rpy:3157
translate chinese akt2chapter4_c300082f:

    # mc "...Yeah."
    mc "……嗯。"

# game/Story02.rpy:3158
translate chinese akt2chapter4_4e1bd473:

    # mc "(…Pain’s getting worse.)"
    mc "（……疼痛加剧了。）"

# game/Story02.rpy:3177
translate chinese akt2chapter5_251902b0:

    # "Sector 6. Level 2. Lower Town."
    "6区。第二层。下城。"

# game/Story02.rpy:3181
translate chinese akt2chapter5_1a932e7d:

    # k "Well, well, well…"
    k "哎呀呀……"

# game/Story02.rpy:3182
translate chinese akt2chapter5_488c1bef:

    # k "All this time… and the air’s still just as unbreathable."
    k "这么久过去了……空气还是这么难闻。"

# game/Story02.rpy:3184
translate chinese akt2chapter5_21667a28:

    # k "Brings back memories."
    k "勾起回忆了。"

# game/Story02.rpy:3186
translate chinese akt2chapter5_c2e7cf9b:

    # Mi "…That’s not why we’re here."
    Mi "……我们不是为这个来的。"

# game/Story02.rpy:3188
translate chinese akt2chapter5_90ba2d8d:

    # mc "Lower Town…?"
    mc "下城……？"

# game/Story02.rpy:3190
translate chinese akt2chapter5_515335e3:

    # k "That’s right. Looks like shit."
    k "没错。看着像屎。"

# game/Story02.rpy:3191
translate chinese akt2chapter5_35cded66:

    # k "Is shit."
    k "就是屎。"

# game/Story02.rpy:3192
translate chinese akt2chapter5_8117b3c7:

    # k "Welcome…"
    k "欢迎……"

# game/Story02.rpy:3193
translate chinese akt2chapter5_9db8f26b:

    # k "To broken dreams."
    k "来到破碎的梦想。"

# game/Story02.rpy:3195
translate chinese akt2chapter5_1de37104:

    # mc "Broken dreams…?"
    mc "破碎的梦想……？"

# game/Story02.rpy:3197
translate chinese akt2chapter5_e94dedf9:

    # Mi "…People used to come here chasing their dreams."
    Mi "……人们曾经来这里追逐梦想。"

# game/Story02.rpy:3199
translate chinese akt2chapter5_cfd217e8:

    # h "Huh. Wonder what went wrong..."
    h "哈。不知道哪儿出了问题……"

# game/Story02.rpy:3200
translate chinese akt2chapter5_81f78057:

    # h "Care to explain, Kalestra?"
    h "解释一下，卡莱斯特拉？"

# game/Story02.rpy:3202
translate chinese akt2chapter5_4153f687:

    # k "What are you implying?"
    k "你什么意思？"

# game/Story02.rpy:3204
translate chinese akt2chapter5_12ad8184:

    # h "What? Just thinking out loud."
    h "什么？自言自语而已。"

# game/Story02.rpy:3207
translate chinese akt2chapter5_12bf8617:

    # k "Listen carefully, shorty."
    k "听好了，矮子。"

# game/Story02.rpy:3209
translate chinese akt2chapter5_d0156362:

    # k "This isn’t your mess to deal with."
    k "这不是你该管的烂摊子。"

# game/Story02.rpy:3211
translate chinese akt2chapter5_1b6c688c:

    # h "Wow… look who found her voice."
    h "哇……看看谁找回嗓子了。"

# game/Story02.rpy:3212
translate chinese akt2chapter5_8b9ee863:

    # mc "Enough."
    mc "够了。"

# game/Story02.rpy:3215
translate chinese akt2chapter5_c3594bf3:

    # mc "...Liv, ease off her."
    mc "……莉芙，别逼她。"

# game/Story02.rpy:3216
translate chinese akt2chapter5_5b2d93a8:

    # h "I’m not pushing—"
    h "我没逼——"

# game/Story02.rpy:3217
translate chinese akt2chapter5_d6f44a4e:

    # mc "You are."
    mc "你就是。"

# game/Story02.rpy:3218
translate chinese akt2chapter5_b5d2d689:

    # mc "Or you trying to take it out on her?"
    mc "还是你想把气撒在她身上？"

# game/Story02.rpy:3219
translate chinese akt2chapter5_4fe8f3b9:

    # h "Wh-"
    h "什——"

# game/Story02.rpy:3221
translate chinese akt2chapter5_d5d5dbab:

    # Mi "…I agree with Liv."
    Mi "……我同意莉芙。"

# game/Story02.rpy:3222
translate chinese akt2chapter5_406ca6a3:

    # Mi "…Without her, we would’ve—"
    Mi "……没她，我们早就——"

# game/Story02.rpy:3224
translate chinese akt2chapter5_17469ecf:

    # mc "Easier? Yeah. Maybe."
    mc "轻松？是。也许吧。"

# game/Story02.rpy:3225
translate chinese akt2chapter5_bddc3da7:

    # Mi "…Why are you defending her?"
    Mi "……你干嘛替她说话？"

# game/Story02.rpy:3226
translate chinese akt2chapter5_8c678df2:

    # mc "She’s the one who pulled me out of the gutter."
    mc "是她把我从泥坑里拉出来的。"

# game/Story02.rpy:3227
translate chinese akt2chapter5_3c99be2a:

    # Mi "…So did we."
    Mi "……我们也一样。"

# game/Story02.rpy:3228
translate chinese akt2chapter5_2b35b6fe:

    # mc "..."
    mc "……"

# game/Story02.rpy:3230
translate chinese akt2chapter5_b3ecaeb2:

    # k "Heh… look at you. Just got here, and the city’s already getting to you."
    k "嘿……看看你。刚到这儿，这城市就已经开始影响你了。"

# game/Story02.rpy:3231
translate chinese akt2chapter5_461c77bc:

    # mc "(...Broken dreams, huh.)"
    mc "（……破碎的梦想，是吧。）"

# game/Story02.rpy:3232
translate chinese akt2chapter5_323d6a2e:

    # mc "You’re getting in your own head, Kalestra."
    mc "你在跟自己较劲，卡莱斯特拉。"

# game/Story02.rpy:3234
translate chinese akt2chapter5_20f40611:

    # k "That coming from someone who believes in an afterlife?"
    k "一个相信来世的人说这话？"

# game/Story02.rpy:3235
translate chinese akt2chapter5_490f41b8:

    # mc "Big words… from someone scared to die."
    mc "大话……从一个怕死的人嘴里说出来。"

# game/Story02.rpy:3240
translate chinese akt2chapter5_82091822:

    # k "..."
    k "……"

# game/Story02.rpy:3247
translate chinese akt2chapter5_fce2be70:

    # k "…You’ll see."
    k "……你会知道的。"

# game/Story02.rpy:3249
translate chinese akt2chapter5_cd7d2030:

    # k "Move."
    k "走。"

# game/Story02.rpy:3252
translate chinese akt2chapter5_1368459c:

    # h "(whispering) If it’s such a pain, why the hell did she even come with us?"
    h "（低声）既然这么难受，她干嘛还跟我们一起来？"

# game/Story02.rpy:3255
translate chinese akt2chapter5_c5f7cb82:

    # mc "Liv. A minute."
    mc "莉芙。说句话。"

# game/Story02.rpy:3257
translate chinese akt2chapter5_2fded262:

    # h "..."
    h "……"

# game/Story02.rpy:3260
translate chinese akt2chapter5_9292a96c:

    # h "I’m doing everything I can here, alright?"
    h "我已经尽力了，行吗？"

# game/Story02.rpy:3261
translate chinese akt2chapter5_734c3d21:

    # h "With her attitude? There’s no way this ends peacefully."
    h "就她那态度？这事不可能和平收场。"

# game/Story02.rpy:3265
translate chinese akt2chapter5_56e6de2f:

    # mc "You’ve been where she is."
    mc "你也经历过她的处境。"

# game/Story02.rpy:3266
translate chinese akt2chapter5_3132cfec:

    # mc "Or you want me to remind you?"
    mc "还是你要我提醒你？"

# game/Story02.rpy:3268
translate chinese akt2chapter5_0099b01d:

    # h "I wouldn’t give a damn—"
    h "我才不在乎——"

# game/Story02.rpy:3270
translate chinese akt2chapter5_dedc06eb:

    # mc "Liv. Truth."
    mc "莉芙。说实话。"

# game/Story02.rpy:3272
translate chinese akt2chapter5_2fded262_1:

    # h "..."
    h "……"

# game/Story02.rpy:3274
translate chinese akt2chapter5_de829e3a:

    # h "Like shit."
    h "糟透了。"

# game/Story02.rpy:3276
translate chinese akt2chapter5_cfcc2293:

    # mc "I know."
    mc "我知道。"

# game/Story02.rpy:3280
translate chinese akt2chapter5_48324d20:

    # h "…Fine."
    h "……行。"

# game/Story02.rpy:3281
translate chinese akt2chapter5_2b35b6fe_1:

    # mc "..."
    mc "……"

# game/Story02.rpy:3284
translate chinese akt2chapter5_f7fc5af8:

    # mc "Let’s go."
    mc "走吧。"

# game/Story02.rpy:3294
translate chinese akt2chapter5_c92445d2:

    # Mi "…We were told to wait."
    Mi "……我们被告知等着。"

# game/Story02.rpy:3296
translate chinese akt2chapter5_37341d0d:

    # k "We don’t wait."
    k "我们不等。"

# game/Story02.rpy:3299
translate chinese akt2chapter5_152e2393:

    # Mi "…If we’d been on time-"
    Mi "……要是我们准时的话——"

# game/Story02.rpy:3302
translate chinese akt2chapter5_d107ea32:

    # k "Not my problem you took your sweet time getting here."
    k "你们磨磨蹭蹭来晚了，不关我的事。"

# game/Story02.rpy:3304
translate chinese akt2chapter5_8f9eee42:

    # h "Oh, sorry for being just a regular human."
    h "哦，抱歉，我只是个普通人。"

# game/Story02.rpy:3307
translate chinese akt2chapter5_1a45283d:

    # h "Not all of us have those shiny implan-"
    h "不是所有人都有那种亮闪闪的植入——"

# game/Story02.rpy:3308
translate chinese akt2chapter5_2fded262_2:

    # h "..."
    h "……"

# game/Story02.rpy:3309
translate chinese akt2chapter5_fbdf8f78:

    # h "(Easy… you said you wouldn’t.)"
    h "（冷静……你说过不这样的。）"

# game/Story02.rpy:3310
translate chinese akt2chapter5_d680d4d6:

    # k "Wow… not gonna finish that?"
    k "哇……不说完？"

# game/Story02.rpy:3313
translate chinese akt2chapter5_f5381b5e:

    # h "Not for you. Trust me."
    h "不是对你说。相信我。"

# game/Story02.rpy:3314
translate chinese akt2chapter5_dd6ad064:

    # mc "(Quiet.)"
    mc "（安静。）"

# game/Story02.rpy:3316
translate chinese akt2chapter5_d73d702c:

    # mc "(…I can see why people came.)"
    mc "（……我明白人们为什么来了。）"

# game/Story02.rpy:3318
translate chinese akt2chapter5_e09b53dd:

    # mc "(Maybe the climate isn’t great, but...)"
    mc "（也许环境不好，但……）"

# game/Story02.rpy:3319
translate chinese akt2chapter5_50a41482:

    # mc "(Wait… rain?)"
    mc "（等等……雨？）"

# game/Story02.rpy:3321
translate chinese akt2chapter5_8c79851f:

    # mc "(We’re underground. Where’s it coming from?)"
    mc "（我们在地下。这雨从哪来的？）"

# game/Story02.rpy:3324
translate chinese akt2chapter5_a1452617:

    # a "Hey there, handsome. Brooding all by yourself?"
    a "嘿，帅哥。一个人闷着？"

# game/Story02.rpy:3327
translate chinese akt2chapter5_2b35b6fe_2:

    # mc "..."
    mc "……"

# game/Story02.rpy:3330
translate chinese akt2chapter5_a8455155:

    # a "What’s with the silent treatment? {w=0.5}Deaf?"
    a "干嘛不理人？{w=0.5}聋了？"

# game/Story02.rpy:3332
translate chinese akt2chapter5_2b35b6fe_3:

    # mc "..."
    mc "……"

# game/Story02.rpy:3334
translate chinese akt2chapter5_7199a5cc:

    # a "What a tragedy… Such a pretty face-"
    a "真可惜……这么漂亮的脸——"

# game/Story02.rpy:3335
translate chinese akt2chapter5_0bb6c7c1:

    # Mi "…She’s here."
    Mi "……她来了。"

# game/Story02.rpy:3337
translate chinese akt2chapter5_461dcca9:

    # mc "That her?"
    mc "是她？"

# game/Story02.rpy:3338
translate chinese akt2chapter5_c23a9b14:

    # Mi "...yes."
    Mi "……是。"

# game/Story02.rpy:3340
translate chinese akt2chapter5_ffb740dc:

    # a "Oh, so you can hear..."
    a "哦，能听见啊……"

# game/Story02.rpy:3342
translate chinese akt2chapter5_99921d04:

    # Mi "…You took your time."
    Mi "……你拖得挺久。"

# game/Story02.rpy:3344
translate chinese akt2chapter5_e0a4baa4:

    # a "I was trying to figure out if you’ve completely lost your mind, bringing two Inquisitors straight to us."
    a "我在琢磨你是不是彻底疯了，直接把两个审判庭的人带到我们面前。"

# game/Story02.rpy:3346
translate chinese akt2chapter5_7738b575:

    # a "But I think I have a pretty good idea what pushed you into this little alliance."
    a "不过我大概猜到是什么逼你搞出这个小联盟了。"

# game/Story02.rpy:3348
translate chinese akt2chapter5_702be37c:

    # a "Tough times we live in, huh?"
    a "我们活在这世道真难，是吧？"

# game/Story02.rpy:3350
translate chinese akt2chapter5_03cf8540:

    # Mi "…On the surface, yeah."
    Mi "……表面上看，是。"

# game/Story02.rpy:3352
translate chinese akt2chapter5_5cf1faeb:

    # mc "And you?"
    mc "那你呢？"

# game/Story02.rpy:3355
translate chinese akt2chapter5_bb8e4b4e:

    # a "..."
    a "……"

# game/Story02.rpy:3357
translate chinese akt2chapter5_60d5c7a0:

    # a "Didn’t know there were still people in the galaxy who don’t know my name."
    a "没想到银河系里还有人不知道我的名字。"

# game/Story02.rpy:3359
translate chinese akt2chapter5_c35ed0a0:

    # aS "Aisha."
    aS "艾莎。"

# game/Story02.rpy:3360
translate chinese akt2chapter5_7372ec8e:

    # aS "One and only. The greatest idol in the galaxy."
    aS "独一无二。银河系最伟大的偶像。"

# game/Story02.rpy:3362
translate chinese akt2chapter5_9d25b4d7:

    # h "Idol?"
    h "偶像？"

# game/Story02.rpy:3363
translate chinese akt2chapter5_e64b1bae:

    # Mi "…It’s a long story."
    Mi "……说来话长。"

# game/Story02.rpy:3365
translate chinese akt2chapter5_d3ecd28d:

    # aS "Mir, I got a question..."
    aS "米儿，我有个问题……"

# game/Story02.rpy:3366
translate chinese akt2chapter5_d9f39730:

    # aS "Why did you bring that gorilla? Winter’s not gonna like this."
    aS "你干嘛把那大猩猩带来？温特不会喜欢的。"

# game/Story02.rpy:3368
translate chinese akt2chapter5_fe939550:

    # aS "I’ll be shocked if he even lets you take a single step inside."
    aS "他要是让你迈进一步我都会惊讶。"

# game/Story02.rpy:3370
translate chinese akt2chapter5_b29f6388:

    # k "He will. He doesn’t have a choice."
    k "他会的。他没得选。"

# game/Story02.rpy:3372
translate chinese akt2chapter5_92d5ce57:

    # aS "So confident... Hope that confidence doesn’t vanish when you see him again."
    aS "这么自信……希望再见到他时这自信还在。"

# game/Story02.rpy:3389
translate chinese akt2chapter5_1_b52f92b9:

    # k "Funny…"
    k "有意思……"

# game/Story02.rpy:3390
translate chinese akt2chapter5_1_b3c97ac5:

    # k "Last time I was here, it smelled like smoke, blood, and fear."
    k "我上次来这儿，闻到的只有烟、血和恐惧。"

# game/Story02.rpy:3392
translate chinese akt2chapter5_1_25c47144:

    # k "Now it’s almost civilized. {w=0.5}Almost."
    k "现在几乎算文明了。{w=0.5}几乎。"

# game/Story02.rpy:3393
translate chinese akt2chapter5_1_6d16d080:

    # mc "(Eight on the left. Three on the right. More below...)"
    mc "（左边八个。右边三个。下面还有……）"

# game/Story02.rpy:3394
translate chinese akt2chapter5_1_ed237b7a:

    # mc "Stay sharp."
    mc "保持警觉。"

# game/Story02.rpy:3396
translate chinese akt2chapter5_1_2c845811:

    # h "(whispering) This place… gives me the creeps."
    h "（低声）这地方……让我发毛。"

# game/Story02.rpy:3399
translate chinese akt2chapter5_1_4b356c83:

    # Mi "…They won’t kill us."
    Mi "……他们不会杀我们。"

# game/Story02.rpy:3400
translate chinese akt2chapter5_1_edc06ad1:

    # Mi "…Not yet."
    Mi "……暂时不会。"

# game/Story02.rpy:3401
translate chinese akt2chapter5_1_a4909daf:

    # h "Oh great… let’s hope it stays that way."
    h "哦太好了……但愿一直这样。"

# game/Story02.rpy:3405
translate chinese akt2chapter5_1_363c0ece:

    # k "For once… I agree with you."
    k "这一次……我同意你。"

# game/Story02.rpy:3407
translate chinese akt2chapter5_1_38edd526:

    # mc "(The way they’re looking…)"
    mc "（他们看我们的眼神……）"

# game/Story02.rpy:3408
translate chinese akt2chapter5_1_57498869:

    # mc "They’re judging."
    mc "他们在审视。"

# game/Story02.rpy:3409
translate chinese akt2chapter5_1_105c5a4e:

    # k "They’re sizing you up."
    k "他们在掂量你。"

# game/Story02.rpy:3411
translate chinese akt2chapter5_1_c42b05ac:

    # mc "And?"
    mc "然后呢？"

# game/Story02.rpy:3413
translate chinese akt2chapter5_1_3ac68df7:

    # k "As you can see… you’re still alive."
    k "如你所见……你还活着。"

# game/Story02.rpy:3416
translate chinese akt2chapter5_1_2b35b6fe:

    # mc "..."
    mc "……"

# game/Story02.rpy:3417
translate chinese akt2chapter5_1_3b87ef3b:

    # mc "(She’s staring too hard.)"
    mc "（她盯得太用力了。）"

# game/Story02.rpy:3419
translate chinese akt2chapter5_1_27bb7259:

    # mc "Say it."
    mc "说吧。"

# game/Story02.rpy:3420
translate chinese akt2chapter5_1_a8135c1c:

    # aS "You… You sound strange."
    aS "你……你的声音有点怪。"

    # game/Story02.rpy:3422
translate chinese akt2chapter5_1_116cae8b:

    # aS "There’s something about you. {w=0.5}Something not quite… human."
    aS "你身上有点东西。{w=0.5}不太……像人。"

# game/Story02.rpy:3423
translate chinese akt2chapter5_1_d141d6d4:

    # aS "Like two souls, sharing one body."
    aS "像两个灵魂，共用一具身体。"

# game/Story02.rpy:3425
translate chinese akt2chapter5_1_80b08ac3:

    # mc "First the city."
    mc "先是城市。"

# game/Story02.rpy:3426
translate chinese akt2chapter5_1_cc27b883:

    # mc "Now it’s two souls."
    mc "现在又是两个灵魂。"

# game/Story02.rpy:3427
translate chinese akt2chapter5_1_91116777:

    # mc "You people see ghosts everywhere."
    mc "你们这些人到哪儿都能看见鬼。"

# game/Story02.rpy:3429
translate chinese akt2chapter5_1_b040b3a5:

    # aS "Reminds me of…"
    aS "让我想起……"

# game/Story02.rpy:3430
translate chinese akt2chapter5_1_b7345a5a:

    # aS "(Whispering) Evrelia."
    aS "（低声）埃芙蕾莉娅。"

# game/Story02.rpy:3434
translate chinese akt2chapter5_1_0af0daf4:

    # aS "A gorilla? Care to enlighten me?"
    aS "一只大猩猩？给我解释一下？"

# game/Story02.rpy:3438
translate chinese akt2chapter5_1_8004fce5:

    # h "And what’s that supposed to mean?"
    h "你这话什么意思？"

# game/Story02.rpy:3440
translate chinese akt2chapter5_1_25b2d084:

    # aS "Oh, of course. Naturally."
    aS "哦，当然。自然。"

# game/Story02.rpy:3441
translate chinese akt2chapter5_1_2f12a841:

    # aS "The real question is… will she even share it with you?"
    aS "真正的问题是……她会告诉你吗？"

# game/Story02.rpy:3443
translate chinese akt2chapter5_1_8c2c73b9:

    # k "I…"
    k "我……"

# game/Story02.rpy:3444
translate chinese akt2chapter5_1_50aa36cd:

    # k "...I’ll share."
    k "……我会说。"

# game/Story02.rpy:3445
translate chinese akt2chapter5_1_4e46cda8:

    # k "But not in front of you, rabbit number two."
    k "但不是当着你面说，二号兔子。"

# game/Story02.rpy:3447
translate chinese akt2chapter5_1_2b35b6fe_1:

    # mc "..."
    mc "……"

# game/Story02.rpy:3449
translate chinese akt2chapter5_1_dc7383a9:

    # mc "You’ve got words."
    mc "你话挺多。"

# game/Story02.rpy:3450
translate chinese akt2chapter5_1_9b9509b0:

    # mc "Not much meaning."
    mc "没几句有用。"

# game/Story02.rpy:3451
translate chinese akt2chapter5_1_bf3e94c5:

    # mc "Get to the point."
    mc "说重点。"

# game/Story02.rpy:3452
translate chinese akt2chapter5_1_369a1e7f:

    # mc "Where’s Winter?"
    mc "温特在哪？"

# game/Story02.rpy:3453
translate chinese akt2chapter5_1_cee34e4c:

    # aS "..."
    aS "……"

# game/Story02.rpy:3455
translate chinese akt2chapter5_1_73f310dc:

    # Mi "(…Two souls?)"
    Mi "（……两个灵魂？）"

# game/Story02.rpy:3458
translate chinese akt2chapter5_1_cee34e4c_1:

    # aS "..."
    aS "……"

# game/Story02.rpy:3463
translate chinese akt2chapter5_1_456ca6f8:

    # aS "We’ll talk downstairs."
    aS "我们下去说。"

# game/Story02.rpy:3470
translate chinese akt2chapter5_1_e10012a2:

    # aS "I’ll go first. {w=0.5}The last thing I want is to watch him tear you all apart."
    aS "我先走。{w=0.5}我可不想看他把你们全撕了。"

# game/Story02.rpy:3473
translate chinese akt2chapter5_1_da3fdbf1:

    # Mi "..."
    Mi "……"

# game/Story02.rpy:3474
translate chinese akt2chapter5_1_476ae4a1:

    # Mi "…Let’s go."
    Mi "……走吧。"

# game/Story02.rpy:3483
translate chinese akt2chapter5_1_ba1550e1:

    # a "(whispering) She burned our homes…"
    a "（低声）她烧了我们的家……"

# game/Story02.rpy:3484
translate chinese akt2chapter5_1_22700450:

    # aa "(whispering) She killed my mother!"
    aa "（低声）她杀了我母亲！"

# game/Story02.rpy:3485
translate chinese akt2chapter5_1_829c5de7:

    # a "MURDERER!"
    a "杀人犯！"

# game/Story02.rpy:3486
translate chinese akt2chapter5_1_82091822:

    # k "..."
    k "……"

# game/Story02.rpy:3488
translate chinese akt2chapter5_1_671c70d0:

    # a "Get out! We don’t need your kind of justice!"
    a "滚出去！我们不需要你那种正义！"

# game/Story02.rpy:3490
translate chinese akt2chapter5_1_c753cdb0:

    # k "They’ve got plenty to say."
    k "他们想说的不少。"

# game/Story02.rpy:3491
translate chinese akt2chapter5_1_55615d34:

    # k "Just not when I’m close enough to hear it."
    k "只是我走近能听见的时候不说。"

# game/Story02.rpy:3493
translate chinese akt2chapter5_1_9d8021bb:

    # mc "(All these looks…)"
    mc "（这些眼神……）"

# game/Story02.rpy:3495
translate chinese akt2chapter5_1_6ec99741:

    # mc "(whispering) Liv, stay ready."
    mc "（低声）莉芙，准备好。"

# game/Story02.rpy:3496
translate chinese akt2chapter5_1_d3a00846:

    # mc "Wait for my call."
    mc "等我信号。"

# game/Story02.rpy:3499
translate chinese akt2chapter5_1_27fbc5df:

    # w "What’s all that noise?"
    w "什么动静？"

# game/Story02.rpy:3500
translate chinese akt2chapter5_1_a9040206:

    # w "…Sounds like surface trash."
    w "……听着像地面的垃圾。"

# game/Story02.rpy:3503
translate chinese akt2chapter5_1_a3322b32:

    # aS "Oh, come on. You already know why they’re here."
    aS "哦得了吧。你知道他们为什么来。"

# game/Story02.rpy:3504
translate chinese akt2chapter5_1_1d9c9340:

    # aS "Smile a little more… we have guests."
    aS "多笑一点……我们有客人。"

# game/Story02.rpy:3506
translate chinese akt2chapter5_1_f7c7ac0d:

    # w "I’m glad…"
    w "我很高兴……"

# game/Story02.rpy:3508
translate chinese akt2chapter5_1_7753cc84:

    # w "…and I’ll be even gladder when they’re gone."
    w "……他们走了我会更高兴。"

# game/Story02.rpy:3510
translate chinese akt2chapter5_1_3b78cefa:

    # aS "Yo Winter, do as you want."
    aS "喂，温特，随你便。"

# game/Story02.rpy:3511
translate chinese akt2chapter5_1_75bb0dab:

    # aS "But don’t rush with your decision."
    aS "但别急着做决定。"

# game/Story02.rpy:3513
translate chinese akt2chapter5_1_c70ecb03:

    # w "Do you even realize her life’s hanging by a thread here?"
    w "你知道她在这儿命悬一线吗？"

# game/Story02.rpy:3517
translate chinese akt2chapter5_1_f62beee1:

    # w "I’m not the kind of man who looks away from blood on someone’s hands."
    w "我不是那种会对别人手上的血视而不见的人。"

# game/Story02.rpy:3519
translate chinese akt2chapter5_1_222c871d:

    # aS "Respect won’t do you any good if you end up dead."
    aS "死了的话，尊重也没用。"

# game/Story02.rpy:3520
translate chinese akt2chapter5_1_120238ca:

    # w "…Is that a threat?"
    w "……这是威胁？"

# game/Story02.rpy:3521
translate chinese akt2chapter5_1_365de02b:

    # aS "I’m warning you. Or have you decided to go against Ember?"
    aS "我在警告你。还是你决定跟恩伯对着干？"

# game/Story02.rpy:3524
translate chinese akt2chapter5_1_b6ce435f:

    # w "Ellie…?"
    w "艾莉……？"

# game/Story02.rpy:3526
translate chinese akt2chapter5_1_0c2b0a31:

    # Mi "…I know you’ve heard about what’s happening on the surface."
    Mi "……我知道你听说了地面上的事。"

# game/Story02.rpy:3527
translate chinese akt2chapter5_1_f80c8fbd:

    # w "Yeah… and didn’t like what I heard."
    w "听说了……而且不喜欢。"

# game/Story02.rpy:3529
translate chinese akt2chapter5_1_e394a7f2:

    # w "You with them because of that?"
    w "你是因为这个才跟他们一起？"

# game/Story02.rpy:3530
translate chinese akt2chapter5_1_da3fdbf1_1:

    # Mi "..."
    Mi "……"

# game/Story02.rpy:3531
translate chinese akt2chapter5_1_3fb97f92:

    # Mi "I’m here to collect what you owe."
    Mi "我来收你欠的账。"

# game/Story02.rpy:3533
translate chinese akt2chapter5_1_0d04128e:

    # w "..."
    w "……"

# game/Story02.rpy:3539
translate chinese akt2chapter5_1_c9d81fd8:

    # h "(whispering) That Winter guy… he’s not taking his eyes off you."
    h "（低声）那个温特……一直盯着你。"

# game/Story02.rpy:3541
translate chinese akt2chapter5_1_cdc20e2f:

    # k "I can feel that without you."
    k "不用你说我也感觉得到。"

# game/Story02.rpy:3543
translate chinese akt2chapter5_1_39aa651e:

    # h "(whispering) If this turns into a fight, what’s the plan?"
    h "（低声）要是打起来，怎么办？"

# game/Story02.rpy:3545
translate chinese akt2chapter5_1_48d60aec:

    # mc "Liv, you take the rear. Hold the left."
    mc "莉芙，你守后方。堵住左边。"

# game/Story02.rpy:3546
translate chinese akt2chapter5_1_c7dda7fb:

    # mc "Kalestra… Winter’s yours."
    mc "卡莱斯特拉……温特交给你。"

# game/Story02.rpy:3547
translate chinese akt2chapter5_1_82091822_1:

    # k "..."
    k "……"

# game/Story02.rpy:3548
translate chinese akt2chapter5_1_443d6f91:

    # k "Don’t get in my way."
    k "别挡我的路。"

# game/Story02.rpy:3550
translate chinese akt2chapter5_1_46319a6f:

    # h "And you?"
    h "那你呢？"

# game/Story02.rpy:3551
translate chinese akt2chapter5_1_2b35b6fe_2:

    # mc "..."
    mc "……"

# game/Story02.rpy:3552
translate chinese akt2chapter5_1_643ddf19:

    # mc "I’ll handle it."
    mc "我来处理。"

# game/Story02.rpy:3557
translate chinese akt2chapter5_1_0d04128e_1:

    # w "..."
    w "……"

# game/Story02.rpy:3559
translate chinese akt2chapter5_1_bb8e4b4e:

    # a "..."
    a "……"

# game/Story02.rpy:3566
translate chinese akt2chapter5_1_bb8e4b4e_1:

    # a "..."
    a "……"

# game/Story02.rpy:3577
translate chinese akt2chapter5_1_9c477ce7:

    # w "I’ll be straight with you."
    w "我直说。"

# game/Story02.rpy:3578
translate chinese akt2chapter5_1_098fe0d5:

    # w "You’re not welcome here."
    w "这儿不欢迎你们。"

# game/Story02.rpy:3579
translate chinese akt2chapter5_1_0d0fb9cd:

    # w "…But you’re staying."
    w "……但你们可以留下。"

# game/Story02.rpy:3580
translate chinese akt2chapter5_1_b3171147:

    # w "For Ember."
    w "看在恩伯的份上。"

# game/Story02.rpy:3584
translate chinese akt2chapter5_1_f66df46f:

    # mc "Goes both ways."
    mc "彼此彼此。"

# game/Story02.rpy:3585
translate chinese akt2chapter5_1_da2b61e6:

    # mc "Now— let’s get to it."
    mc "现在——说正事。"

# game/Story02.rpy:3593
translate chinese akt2chapter5_1_a390c19b:

    # Fl "She’s buried in work right now."
    Fl "她现在忙得不可开交。"

# game/Story02.rpy:3594
translate chinese akt2chapter5_1_96c5adc2:

    # Fl "She’ll be here soon."
    Fl "她很快就来。"

# game/Story02.rpy:3597
translate chinese akt2chapter5_1_6f1d7cd7:

    # h "You’re awfully calm… considering what’s going on out there."
    h "你倒是挺镇定……外面都那样了。"

# game/Story02.rpy:3600
translate chinese akt2chapter5_1_23abc4e0:

    # Fl "And you’re still just as talkative."
    Fl "而你还是这么多话。"

# game/Story02.rpy:3601
translate chinese akt2chapter5_1_7d20456b:

    # h "…Glad you’re alive."
    h "……很高兴你活着。"

# game/Story02.rpy:3602
translate chinese akt2chapter5_1_b974504b:

    # Fl "...Yeah."
    Fl "……嗯。"

# game/Story02.rpy:3604
translate chinese akt2chapter5_1_8e9d16ea:

    # mc "You did good."
    mc "你做得不错。"

# game/Story02.rpy:3606
translate chinese akt2chapter5_1_bc0a3d20:

    # Fl "Worse than it looks."
    Fl "比看起来更糟。"

# game/Story02.rpy:3612
translate chinese akt2chapter5_1_d8272412:

    # Fl "(whispering) …I’m glad you made it."
    Fl "（低声）……很高兴你挺过来了。"

# game/Story02.rpy:3614
translate chinese akt2chapter5_1_a5d8d2e1:

    # mc "…You holding up?"
    mc "……你还好吗？"

# game/Story02.rpy:3616
translate chinese akt2chapter5_1_ce7728d6:

    # Fl "(whispering) I’ve been trying not to lose my mind."
    Fl "（低声）我一直努力不让自己疯掉。"

# game/Story02.rpy:3617
translate chinese akt2chapter5_1_33342ed3:

    # Fl "(whispering) With everything happening out there…"
    Fl "（低声）外面发生这么多事……"

# game/Story02.rpy:3619
translate chinese akt2chapter5_1_19a02689:

    # mc "What did you find?"
    mc "你发现了什么？"

# game/Story02.rpy:3621
translate chinese akt2chapter5_1_e3d0b78d:

    # Fl "Thanks to you? Yeah."
    Fl "多亏你？有。"

# game/Story02.rpy:3622
translate chinese akt2chapter5_1_60865b9c:

    # Fl "But it’s incomplete."
    Fl "但不完整。"

# game/Story02.rpy:3623
translate chinese akt2chapter5_1_8500cb9b:

    # Fl "Too many gaps."
    Fl "漏洞太多。"

# game/Story02.rpy:3625
translate chinese akt2chapter5_1_a03ba5fa:

    # mc "(Ostorius sent you the report.)"
    mc "（奥斯特里乌斯把报告发给你了。）"

# game/Story02.rpy:3627
translate chinese akt2chapter5_1_51fa70f5:

    # mc "You already know."
    mc "你已经知道了。"

# game/Story02.rpy:3628
translate chinese akt2chapter5_1_d37f1f23:

    # mc "You just don’t want to accept it."
    mc "只是不想接受。"

# game/Story02.rpy:3630
translate chinese akt2chapter5_1_41da62cb:

    # Fl "..."
    Fl "……"

# game/Story02.rpy:3632
translate chinese akt2chapter5_1_0e622370:

    # Fl "Accepting that means questioning Astoria."
    Fl "接受就意味着要质疑阿斯托里亚。"

# game/Story02.rpy:3633
translate chinese akt2chapter5_1_45785cab:

    # Fl "And I haven’t lost what’s left of my sanity just yet."
    Fl "而我还没彻底疯掉。"

# game/Story02.rpy:3635
translate chinese akt2chapter5_1_cdb81318:

    # Fl "If a traitor was allowed to pull this off—"
    Fl "如果叛徒能干成这种事——"

# game/Story02.rpy:3637
translate chinese akt2chapter5_1_b2da4e90:

    # Fl "Then Astoria herself is on their side."
    Fl "那阿斯托里亚本人就是他们那边的。"

# game/Story02.rpy:3639
translate chinese akt2chapter5_1_af0950b6:

    # mc "...And for what?"
    mc "……图什么？"

# game/Story02.rpy:3640
translate chinese akt2chapter5_1_514b744a:

    # mc "She already had everything."
    mc "她已经拥有一切了。"

# game/Story02.rpy:3642
translate chinese akt2chapter5_1_41da62cb_1:

    # Fl "..."
    Fl "……"

# game/Story02.rpy:3643
translate chinese akt2chapter5_1_7ed81dc0:

    # Fl "And that’s the worst part."
    Fl "这才是最糟的。"

# game/Story02.rpy:3653
translate chinese akt2chapter5_1_3c073c86:

    # mc "Talk, Flora."
    mc "说吧，弗洛拉。"

# game/Story02.rpy:3654
translate chinese akt2chapter5_1_484f1716:

    # Fl "(quietly) Not here."
    Fl "（轻声）不是这儿。"

# game/Story02.rpy:3659
translate chinese akt2chapter5_1_832b01f8:

    # Fl "First, clean yourselves up."
    Fl "先去洗洗。"

# game/Story02.rpy:3661
translate chinese akt2chapter5_1_7b5e56b2:

    # Fl "And keep your voices down."
    Fl "还有压低声音。"

# game/Story02.rpy:3663
translate chinese akt2chapter5_1_d30dd6a3:

    # k "...You know… we had to get our hands dirty."
    k "……你知道……我们手上得沾血。"

# game/Story02.rpy:3665
translate chinese akt2chapter5_1_c521d4dd:

    # Fl "I know."
    Fl "我知道。"

# game/Story02.rpy:3666
translate chinese akt2chapter5_1_990f303f:

    # Fl "Or rather… I can smell it."
    Fl "或者说……我闻得到。"

# game/Story02.rpy:3670
translate chinese akt2chapter5_1_9678462c:

    # w "Showers down the hall to the left."
    w "淋浴间在左边走廊。"

# game/Story02.rpy:3672
translate chinese akt2chapter5_1_691c0fb6:

    # aS "And welcome to the Blue Moon."
    aS "欢迎来到蓝月。"

# game/Story02.rpy:3696
translate chinese akt2chapter5_5_0857c07e:

    # k "The hell...?"
    k "什么鬼……？"

# game/Story02.rpy:3697
translate chinese akt2chapter5_5_3af8f262:

    # k "Who the fuck are you?!"
    k "你他妈谁？！"

# game/Story02.rpy:3699
translate chinese akt2chapter5_5_2bf7155e:

    # k "And what the hell are you doing in the women’s shower?! You got a death wish?!"
    k "你他妈在女澡堂干嘛？！找死吗？！"

# game/Story02.rpy:3701
translate chinese akt2chapter5_5_1bfecb8d:

    # mc "There was no sign."
    mc "没标牌。"

# game/Story02.rpy:3702
translate chinese akt2chapter5_5_459b6198:

    # mc "How was I supposed to know it was for women?"
    mc "我怎么知道是女澡堂？"

# game/Story02.rpy:3704
translate chinese akt2chapter5_5_cd241ab3:

    # k "Oh, it's you, [mc]..."
    k "哦，是你啊，[mc]……"

# game/Story02.rpy:3705
translate chinese akt2chapter5_5_2784802d:

    # k "You look like a different person. Not even disgusting to look at anymore."
    k "看着像换了个人。现在看着都不恶心了。"

# game/Story02.rpy:3707
translate chinese akt2chapter5_5_9d5e88f2:

    # mc "I’ll take that as a compliment."
    mc "就当是夸我了。"

# game/Story02.rpy:3709
translate chinese akt2chapter5_5_3d3431a4:

    # k "At least cover yourself up…"
    k "至少遮一下……"

# game/Story02.rpy:3711
translate chinese akt2chapter5_5_c661e3e4:

    # mc "Is that a problem?"
    mc "有问题？"

# game/Story02.rpy:3713
translate chinese akt2chapter5_5_06c8d1d4:

    # k "Yeah, long and big. {w} Hard to look away."
    k "有，又长又大。{w}让人挪不开眼。"

# game/Story02.rpy:3715
translate chinese akt2chapter5_5_702729d6:

    # k "No wonder women keep flocking around you."
    k "难怪女人老围着你转。"

# game/Story02.rpy:3717
translate chinese akt2chapter5_5_aecf189d:

    # k "With a beast like that..."
    k "带着那么个玩意儿……"

# game/Story02.rpy:3719
translate chinese akt2chapter5_5_10e0a476:

    # k "If you were a little younger... {w} maybe I wouldn’t think twice."
    k "你要是年轻点……{w}也许我都不带犹豫的。"

# game/Story02.rpy:3721
translate chinese akt2chapter5_5_951fa4f4:

    # mc "Is that so? Or is it Aisha’s words playing a bigger role here?"
    mc "是吗？还是艾莎的话起的作用更大？"

# game/Story02.rpy:3723
translate chinese akt2chapter5_5_82091822:

    # k "..."
    k "……"

# game/Story02.rpy:3725
translate chinese akt2chapter5_5_0749b11b:

    # k "Tread carefully, buddy. You're playing with fire. {w} And it’s real fucking hot."
    k "小心点，伙计。你在玩火。{w}而且他妈很烫。"

# game/Story02.rpy:3727
translate chinese akt2chapter5_5_2b35b6fe:

    # mc "..."
    mc "……"

# game/Story02.rpy:3729
translate chinese akt2chapter5_5_c06a1309:

    # k "What, cat got your tongue?"
    k "怎么，哑巴了？"

# game/Story02.rpy:3730
