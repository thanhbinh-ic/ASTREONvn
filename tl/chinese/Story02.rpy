    o "还撑得住吗？"

# game/Story02.rpy:2057
translate chinese akt2chapter2_1_bab4d995:

    # mc "I’ll live."
    mc "死不了。"

# game/Story02.rpy:2058
translate chinese akt2chapter2_1_24025ac3:

    # mc "Lost all my gear, though."
    mc "不过装备全丢了。"

# game/Story02.rpy:2059
translate chinese akt2chapter2_1_9df458a5:

    # o "Could’ve been worse."
    o "本来可能更糟。"

# game/Story02.rpy:2060
translate chinese akt2chapter2_1_f724f1c3:

    # o "At least you’re dressed this time."
    o "至少这次穿着衣服。"

# game/Story02.rpy:2061
translate chinese akt2chapter2_1_2b35b6fe_22:

    # mc "..."
    mc "……"

# game/Story02.rpy:2064
translate chinese akt2chapter2_1_d118e1a3:

    # o "Here. Spare set."
    o "给。备用的。"

# game/Story02.rpy:2065
translate chinese akt2chapter2_1_f6461bfc:

    # o "...Good to have you back, [mc]."
    o "……很高兴你归队，[mc]。"

# game/Story02.rpy:2070
translate chinese akt2chapter2_1_89450490:

    # o "Fits?"
    o "合身吗？"

# game/Story02.rpy:2072
translate chinese akt2chapter2_1_3cb563cc:

    # mc "A bit tight."
    mc "有点紧。"

# game/Story02.rpy:2073
translate chinese akt2chapter2_1_5fac492d:

    # mc "Weapon… still got one?"
    mc "武器……还有吗？"

# game/Story02.rpy:2075
translate chinese akt2chapter2_1_2450e220:

    # o "That… might be a problem."
    o "那个……可能有点问题。"

# game/Story02.rpy:2077
translate chinese akt2chapter2_1_75b3dae0_2:

    # k "Hey, old man."
    k "嘿，老头。"

# game/Story02.rpy:2079
translate chinese akt2chapter2_1_9b45ea87:

    # k "Catch."
    k "接着。"

# game/Story02.rpy:2087
translate chinese akt2chapter2_1_4197601b:

    # mc "Where’d you—"
    mc "你从哪儿——"

# game/Story02.rpy:2092
translate chinese akt2chapter2_1_b323ea60:

    # k "Found it."
    k "找到的。"

# game/Story02.rpy:2093
translate chinese akt2chapter2_1_6a243f77:

    # k "Right next to your body."
    k "就在你身体旁边。"

# game/Story02.rpy:2094
translate chinese akt2chapter2_1_a2fbe978:

    # k "Call it luck."
    k "算是运气。"

# game/Story02.rpy:2115
translate chinese akt2chapter3_6651ab87:

    # mc "Alright."
    mc "好。"

# game/Story02.rpy:2116
translate chinese akt2chapter3_c0820943:

    # mc "…Where are we?"
    mc "……我们在哪？"

# game/Story02.rpy:2119
translate chinese akt2chapter3_df49f4a8:

    # o "Sector 6."
    o "6区。"

# game/Story02.rpy:2120
translate chinese akt2chapter3_98720c01:

    # o "Blue Moon’s not far from here."
    o "蓝月离这儿不远。"

# game/Story02.rpy:2121
translate chinese akt2chapter3_9c328d5b:

    # mc "Wait, hold on."
    mc "等等，等一下。"

# game/Story02.rpy:2122
translate chinese akt2chapter3_eff43b9e:

    # mc "How long was I out?"
    mc "我昏迷了多久？"

# game/Story02.rpy:2124
translate chinese akt2chapter3_29188ccf:

    # o "Ninety-three cycles."
    o "九十三个周期。"

# game/Story02.rpy:2125
translate chinese akt2chapter3_a59dbce2:

    # mc "Thirty hours…?"
    mc "三十小时……？"

# game/Story02.rpy:2128
translate chinese akt2chapter3_cc7eae63:

    # o "And in all that time… no one really slept."
    o "那期间……没人真正睡过。"

# game/Story02.rpy:2129
translate chinese akt2chapter3_050d4ec0:

    # mc "Liv… you too?"
    mc "莉芙……你也是？"

# game/Story02.rpy:2130
translate chinese akt2chapter3_0ae9abde:

    # h "I tried, okay? But—"
    h "我试过了，行吗？可是——"

# game/Story02.rpy:2132
translate chinese akt2chapter3_a0c117ea:

    # h "Let’s just say… I couldn’t."
    h "只能说……睡不着。"

# game/Story02.rpy:2134
translate chinese akt2chapter3_1b60a71f:

    # o "After what happened with you… no one could."
    o "你出了那事之后……谁都睡不着。"

# game/Story02.rpy:2135
translate chinese akt2chapter3_6cf92bc9:

    # mc "(…While they kept moving…)"
    mc "（……他们一直在赶路……）"

# game/Story02.rpy:2136
translate chinese akt2chapter3_25f7f3ad:

    # mc "(…I was just dead weight.)"
    mc "（……我就是个累赘。）"

# game/Story02.rpy:2138
translate chinese akt2chapter3_eddbb866:

    # mc "You all need rest."
    mc "你们都需要休息。"

# game/Story02.rpy:2140
translate chinese akt2chapter3_6eae670b:

    # o "We managed to reach your wife."
    o "我们联系上你妻子了。"

# game/Story02.rpy:2143
translate chinese akt2chapter3_a665ef25:

    # mc "...how?"
    mc "……怎么联系上的？"

# game/Story02.rpy:2146
translate chinese akt2chapter3_f62a6d0e:

    # o "Not luck."
    o "不是运气。"

# game/Story02.rpy:2147
translate chinese akt2chapter3_9b9ea242:

    # o "That Ark marker you brought out of the tomb woke up when the tower came back online."
    o "你从陵墓里带出来的那个方舟信标，在塔恢复上线时启动了。"

# game/Story02.rpy:2148
translate chinese akt2chapter3_ba1a4244:

    # o "It sent a pulse through an old Ark signal."
    o "它通过一个旧的方舟信号发出了脉冲。"

# game/Story02.rpy:2149
translate chinese akt2chapter3_e94345a4:

    # o "Not to us. Not to HQ."
    o "不是发给我们。也不是发给总部。"

# game/Story02.rpy:2150
translate chinese akt2chapter3_a4d5f4c0:

    # mc "...To her."
    mc "……是发给她。"

# game/Story02.rpy:2151
translate chinese akt2chapter3_8f794799:

    # o "Yeah."
    o "对。"

# game/Story02.rpy:2152
translate chinese akt2chapter3_29170184:

    # o "The channel barely lasted a few seconds, but we managed to push one message through."
    o "信道只维持了几秒，但我们挤进去一条消息。"

# game/Story02.rpy:2153
translate chinese akt2chapter3_3e41caca:

    # o "Coordinates for Blue Moon."
    o "蓝月的坐标。"

# game/Story02.rpy:2154
translate chinese akt2chapter3_27041f46:

    # o "And that we'd be waiting there."
    o "还有我们会在那儿等。"

# game/Story02.rpy:2157
translate chinese akt2chapter3_5e463da6:

    # mc "H-how is she?"
    mc "她……她怎么样？"

# game/Story02.rpy:2159
translate chinese akt2chapter3_60ddbe70:

    # o "Hard to say…"
    o "不好说……"

# game/Story02.rpy:2160
translate chinese akt2chapter3_b7a77e8b:

    # o "Her voice was—"
    o "她的声音——"

# game/Story02.rpy:2170
translate chinese akt2chapter3_e5ddc81a:

    # a "AAAAAAAA!"
    a "啊啊啊啊！"

# game/Story02.rpy:2176
translate chinese akt2chapter3_7d656bfe:

    # gggg "*Heavy breathing*"
    gggg "*粗喘*"

# game/Story02.rpy:2179
translate chinese akt2chapter3_e58037fa:

    # g "You alive?"
    g "还活着吗？"

# game/Story02.rpy:2180
translate chinese akt2chapter3_b83fea0c:

    # gggg "...yeah."
    gggg "……嗯。"

# game/Story02.rpy:2183
translate chinese akt2chapter3_6ca380ab:

    # g "Syndicate?"
    g "辛迪加？"

# game/Story02.rpy:2186
translate chinese akt2chapter3_77ac3aa8:

    # gggg "Yeah. Their uniform."
    gggg "对。他们的制服。"

# game/Story02.rpy:2188
translate chinese akt2chapter3_b7777760:

    # mc "Mir… something wrong?"
    mc "米儿……怎么了？"

# game/Story02.rpy:2192
translate chinese akt2chapter3_da3fdbf1:

    # Mi "..."
    Mi "……"

# game/Story02.rpy:2195
translate chinese akt2chapter3_6ad47d5d:

    # h "Hey… what if he just mixed us up or something?"
    h "嘿……会不会是他认错人了？"

# game/Story02.rpy:2197
translate chinese akt2chapter3_cac15b7f:

    # Mi "No."
    Mi "不是。"

# game/Story02.rpy:2198
translate chinese akt2chapter3_f0b20556:

    # Mi "He knew exactly who he was going after."
    Mi "他清楚自己要找谁。"

# game/Story02.rpy:2200
translate chinese akt2chapter3_fc908942:

    # k "Dead is dead."
    k "死就是死。"

# game/Story02.rpy:2201
translate chinese akt2chapter3_ab2b2b38:

    # k "End of story."
    k "没什么好说的。"

# game/Story02.rpy:2202
translate chinese akt2chapter3_807bd070:

    # g "But-"
    g "可是——"

# game/Story02.rpy:2203
translate chinese akt2chapter3_8e2906f9:

    # k "Quiet."
    k "闭嘴。"

# game/Story02.rpy:2205
translate chinese akt2chapter3_0061b368:

    # ggg "..."
    ggg "……"

# game/Story02.rpy:2207
translate chinese akt2chapter3_1748fc49:

    # mc "…Aren’t we supposed to be allies?"
    mc "……我们不是盟友吗？"

# game/Story02.rpy:2208
translate chinese akt2chapter3_1591ba25:

    # k "Allies?"
    k "盟友？"

# game/Story02.rpy:2209
translate chinese akt2chapter3_ca63e318:

    # k "…You’ve got to be kidding."
    k "……你开玩笑吧。"

# game/Story02.rpy:2210
translate chinese akt2chapter3_288cd843:

    # mc "Kalestra."
    mc "卡莱斯特拉。"

# game/Story02.rpy:2213
translate chinese akt2chapter3_75b3dae0:

    # k "Hey, old man."
    k "嘿，老头。"

# game/Story02.rpy:2214
translate chinese akt2chapter3_e6eaae9b:

    # k "How about I kill the short one right now."
    k "不如我现在就把那个矮子杀了。"

# game/Story02.rpy:2215
translate chinese akt2chapter3_55033f30:

    # k "And then we call it an alliance?"
    k "然后我们管这叫同盟？"

# game/Story02.rpy:2217
translate chinese akt2chapter3_da3fdbf1_1:

    # Mi "..."
    Mi "……"

# game/Story02.rpy:2218
translate chinese akt2chapter3_2d40d1d9:

    # Mi "We’re not allies."
    Mi "我们不是盟友。"

# game/Story02.rpy:2219
translate chinese akt2chapter3_a005a40d:

    # Mi "We’re just… not killing each other. For now."
    Mi "我们只是……暂时不互相残杀。"

# game/Story02.rpy:2224
translate chinese akt2chapter3_a24e4589:

    # gg "Commander, what are we doing?"
    gg "指挥官，我们怎么办？"

# game/Story02.rpy:2230
translate chinese akt2chapter3_6e2c5a48:

    # o "We’ll deal with that later."
    o "那事以后再说。"

# game/Story02.rpy:2231
translate chinese akt2chapter3_78ba9dc8:

    # o "Right now, we rest."
    o "现在，休息。"

# game/Story02.rpy:2234
translate chinese akt2chapter3_f8fed973:

    # o "No objections?"
    o "有意见吗？"

# game/Story02.rpy:2236
translate chinese akt2chapter3_3a927216:

    # h "(whispering) What do you think?"
    h "（低声）你觉得呢？"

# game/Story02.rpy:2239
translate chinese akt2chapter3_8d5c9361:

    # mc "(…The sooner we move, the sooner I see Lora…)"
    mc "（……越早动身，越早见到洛拉……）"

# game/Story02.rpy:2240
translate chinese akt2chapter3_dc77dcc0:

    # mc "(…No. Not like this.)"
    mc "（……不。不能这样。）"

# game/Story02.rpy:2242
translate chinese akt2chapter3_c0aa49f5:

    # mc "Get some rest."
    mc "去休息吧。"

# game/Story02.rpy:2247
translate chinese akt2chapter3_a4a75624:

    # h "Fine."
    h "行。"

# game/Story02.rpy:2250
translate chinese akt2chapter3_4c5bf305:

    # h "(whispering) But you know…"
    h "（低声）不过你知道吗……"

# game/Story02.rpy:2251
translate chinese akt2chapter3_b7c359c7:

    # h "(whispering) What do you think about them?"
    h "（低声）你觉得他们怎么样？"

# game/Story02.rpy:2253
translate chinese akt2chapter3_09327c85:

    # mc "(Whispering) The team?"
    mc "（低声）小队？"

# game/Story02.rpy:2255
translate chinese akt2chapter3_00281da8:

    # h "Mm-hm."
    h "嗯哼。"

# game/Story02.rpy:2258
translate chinese akt2chapter3_6b81b23c:

    # mc "(Whispering) Hard to say."
    mc "（低声）不好说。"

# game/Story02.rpy:2260
translate chinese akt2chapter3_8c6a4cc9:

    # mc "(Whispering) They’ve saved my life more than once."
    mc "（低声）他们救过我不止一次。"

# game/Story02.rpy:2261
translate chinese akt2chapter3_dfa0cee6:

    # mc "(Whispering) But I still don’t trust them. Not fully."
    mc "（低声）但我还是不完全信任他们。"

# game/Story02.rpy:2263
translate chinese akt2chapter3_8a1dcf51:

    # h "After everything we’ve been through… almost dying that many times…"
    h "经历了这么多……差点死那么多次……"

# game/Story02.rpy:2265
translate chinese akt2chapter3_c602dbee:

    # h "…and you still don’t trust them?"
    h "……你还是不信他们？"

# game/Story02.rpy:2270
translate chinese akt2chapter3_2f383330:

    # h "Hey… you okay?"
    h "嘿……你没事吧？"

# game/Story02.rpy:2277
translate chinese akt2chapter3_97aeedb2:

    # mc "I trust them. Just… not like I trust you."
    mc "我信他们。只是……不像信你那样。"

# game/Story02.rpy:2280
translate chinese akt2chapter3_a144d6f2:

    # h "…Yeah… I know."
    h "……嗯……我知道。"

# game/Story02.rpy:2282
translate chinese akt2chapter3_dd748d06:

    # o "[mc]…?"
    o "[mc]……？"

# game/Story02.rpy:2283
translate chinese akt2chapter3_2b35b6fe:

    # mc "..."
    mc "……"

# game/Story02.rpy:2285
translate chinese akt2chapter3_b9e5dce2:

    # mc "I’ll take watch."
    mc "我来守夜。"

# game/Story02.rpy:2296
translate chinese akt2chapter3_278b93ef:

    # mc "(So… what do we actually have?)"
    mc "（所以……我们到底掌握了什么？）"

# game/Story02.rpy:2300
translate chinese akt2chapter3_6c219dd9:

    # mc "(Comms are back up.)"
    mc "（通讯恢复了。）"

# game/Story02.rpy:2301
translate chinese akt2chapter3_a9cd8db5:

    # mc "(There’s a rat in HQ.)"
    mc "（总部有内鬼。）"

# game/Story02.rpy:2305
translate chinese akt2chapter3_3499910c:

    # mc "(That wasn’t a tomb… it was a graveyard.)"
    mc "（那不是陵墓……是墓地。）"

# game/Story02.rpy:2308
translate chinese akt2chapter3_166ca0de:

    # mc "(And those things… led us there.)"
    mc "（而那些东西……把我们引到了那儿。）"

# game/Story02.rpy:2309
translate chinese akt2chapter3_bc9998ee:

    # mc "(Why?)"
    mc "（为什么？）"

# game/Story02.rpy:2313
translate chinese akt2chapter3_69078ff7:

    # mc "(And more importantly…)"
    mc "（更重要的是……）"

# game/Story02.rpy:2314
translate chinese akt2chapter3_5c0378ac:

    # mc "(Lora… I’m finally going to see her.)"
    mc "（洛拉……我终于要见到她了。）"

# game/Story02.rpy:2317
translate chinese akt2chapter3_651a46d7:

    # h "Mmm~ No… {w=0.5} That’s my cookie… {w=0.5} Give it back…"
    h "嗯~ 不……{w=0.5}那是我的饼干……{w=0.5}还给我……"

# game/Story02.rpy:2319
translate chinese akt2chapter3_1f6f39bd:

    # h "No… {w=0.5} My… {w=0.5} cookie…"
    h "不……{w=0.5}我的……{w=0.5}饼干……"

# game/Story02.rpy:2322
translate chinese akt2chapter3_a3419336:

    # mc "(And she said she was done with sweets. What a little liar…)"
    mc "（她还说戒甜食了。小骗子……）"

# game/Story02.rpy:2324
translate chinese akt2chapter3_013f7aee:

    # Mi "When you jumped… I barely stopped her from going after you."
    Mi "你跳下去的时候……我差点没拦住她跟着跳。"

# game/Story02.rpy:2325
translate chinese akt2chapter3_2b35b6fe_1:

    # mc "..."
    mc "……"

# game/Story02.rpy:2327
translate chinese akt2chapter3_bc8c48e2:

    # mc "Thanks, Mir."
    mc "谢了，米儿。"

# game/Story02.rpy:2329
translate chinese akt2chapter3_7f99de5b:

    # Mi "...how are you?"
    Mi "……你怎么样？"

# game/Story02.rpy:2330
translate chinese akt2chapter3_582359ea:

    # mc "Hm?"
    mc "嗯？"

# game/Story02.rpy:2331
translate chinese akt2chapter3_a0c9b25e:

    # Mi "Something’s bothering you… isn’t it?"
    Mi "有心事……对吧？"

# game/Story02.rpy:2333
translate chinese akt2chapter3_d2b44a54:

    # mc "Just... trying not to lose myself in all of it."
    mc "只是……尽量不让自己迷失在这些事里。"

# game/Story02.rpy:2335
translate chinese akt2chapter3_da3fdbf1_2:

    # Mi "..."
    Mi "……"

# game/Story02.rpy:2336
translate chinese akt2chapter3_8026e3c2:

    # Mi "...Is it working?"
    Mi "……有用吗？"

# game/Story02.rpy:2338
translate chinese akt2chapter3_e08e10bb:

    # mc "…So far."
    mc "……目前为止。"

# game/Story02.rpy:2339
translate chinese akt2chapter3_3ccb3343:

    # mc "Still holding."
    mc "还撑着。"

# game/Story02.rpy:2341
translate chinese akt2chapter3_7822c547:

    # Mi "Alright."
    Mi "好。"

# game/Story02.rpy:2342
translate chinese akt2chapter3_850ef128:

    # b "..."
    b "……"

# game/Story02.rpy:2344
translate chinese akt2chapter3_cc987364:

    # mc "Didn’t think about getting some rest?"
    mc "没想过去休息一下？"

# game/Story02.rpy:2346
translate chinese akt2chapter3_77b1a7d5:

    # Mi "I tried…"
    Mi "试过了……"

# game/Story02.rpy:2347
translate chinese akt2chapter3_f3e5af3e:

    # Mi "But my thoughts won’t settle."
    Mi "但脑子里静不下来。"

# game/Story02.rpy:2349
translate chinese akt2chapter3_7f3cae7b:

    # mc "Yeah… same boat."
    mc "是啊……一样。"

# game/Story02.rpy:2351
translate chinese akt2chapter3_28ef5624:

    # Mi "Mhm..."
    Mi "嗯……"

# game/Story02.rpy:2352
translate chinese akt2chapter3_2b35b6fe_2:

    # mc "..."
    mc "……"

# game/Story02.rpy:2354
translate chinese akt2chapter3_7ff55c60:

    # mc "Mind if I ask what you’re reading?"
    mc "介意我问你在看什么吗？"

# game/Story02.rpy:2355
translate chinese akt2chapter3_64466f2d:

    # Mi "Olivia lent it to me. Said it helps take your mind off things."
    Mi "奥利维亚借我的。说能帮你转移注意力。"

# game/Story02.rpy:2357
translate chinese akt2chapter3_354a7f7f:

    # mc "Does it help?"
    mc "有用吗？"

# game/Story02.rpy:2359
translate chinese akt2chapter3_da3fdbf1_3:

    # Mi "..."
    Mi "……"

# game/Story02.rpy:2360
translate chinese akt2chapter3_f5940c5b:

    # Mi "For a few minutes."
    Mi "能管几分钟。"

# game/Story02.rpy:2361
translate chinese akt2chapter3_c651ec7b:

    # Mi "Then it comes back."
    Mi "然后就又回来了。"

# game/Story02.rpy:2363
translate chinese akt2chapter3_a90993b1:

    # k "You knew what you signed up for."
    k "你早知道会这样。"

# game/Story02.rpy:2364
translate chinese akt2chapter3_9baa4ba9:

    # k "So don’t whine."
    k "所以别抱怨。"

# game/Story02.rpy:2366
translate chinese akt2chapter3_50e223fb:

    # mc "Mir… are you with the Inquisition?"
    mc "米儿……你是审判庭的人吗？"

# game/Story02.rpy:2367
translate chinese akt2chapter3_76fe5c88:

    # k "Her?"
    k "她？"

# game/Story02.rpy:2368
translate chinese akt2chapter3_eb2dc22c:

    # k "…Please. No."
    k "……拜托。不是。"

# game/Story02.rpy:2369
translate chinese akt2chapter3_da3fdbf1_4:

    # Mi "..."
    Mi "……"

