    # mc "Feisty..."
    mc "挺泼辣……"

# game/Story02.rpy:3733
translate chinese akt2chapter5_5_a27d7532:

    # mc "You know what's happening to me."
    mc "你知道我身上发生了什么。"

# game/Story02.rpy:3735
translate chinese akt2chapter5_5_391aaad2:

    # mc "Don't look away. You see him too."
    mc "别移开视线。你也看见他了。"

# game/Story02.rpy:3736
translate chinese akt2chapter5_5_41c806be:

    # mc "And judging by your face, you know what it means."
    mc "看你的表情，你知道这意味着什么。"

# game/Story02.rpy:3738
translate chinese akt2chapter5_5_a8999def:

    # mc "And yet, you’re silent. Why?"
    mc "可你沉默不语。为什么？"

# game/Story02.rpy:3740
translate chinese akt2chapter5_5_77735bc5:

    # k "That all you wanted to say?"
    k "你就想说这些？"

# game/Story02.rpy:3741
translate chinese akt2chapter5_5_418642b9:

    # k "If so, I’m leaving."
    k "那我走了。"

# game/Story02.rpy:3743
translate chinese akt2chapter5_5_82091822_1:

    # k "..."
    k "……"

# game/Story02.rpy:3744
translate chinese akt2chapter5_5_4472b5b3:

    # k "There are things even the strongest are afraid to say out loud."
    k "有些事，连最强的人都不敢说出口。"

# game/Story02.rpy:3746
translate chinese akt2chapter5_5_867c36b0:

    # k "If you want advice… {w} Don’t lose your mind."
    k "想要建议的话……{w}别失去理智。"

# game/Story02.rpy:3749
translate chinese akt2chapter5_5_77043b13:

    # mc "...What the hell did she mean by that?"
    mc "……她那话什么意思？"

# game/Story02.rpy:3753
translate chinese akt2chapter5_5_9be5689d:

    # mc "(But that’s for later. Right now — relaxation.)"
    mc "（不过那是以后的事了。现在——放松。）"

# game/Story02.rpy:3755
translate chinese akt2chapter5_5_49c15374:

    # mc "A jacuzzi? Huh… They sure don’t hold back on comfort here."
    mc "按摩浴缸？哈……这儿的人可真会享受。"

# game/Story02.rpy:3759
translate chinese akt2chapter5_5_2b35b6fe_1:

    # mc "..."
    mc "……"

# game/Story02.rpy:3761
translate chinese akt2chapter5_5_74efb38f:

    # mc "Damn, this feels nice…"
    mc "靠，真舒服……"

# game/Story02.rpy:3763
translate chinese akt2chapter5_5_2b35b6fe_2:

    # mc "..."
    mc "……"

# game/Story02.rpy:3765
translate chinese akt2chapter5_5_832e36b4:

    # Fl "Mind if I join?"
    Fl "介意我一起吗？"

# game/Story02.rpy:3769
translate chinese akt2chapter5_5_bb15f912:

    # mc "Flora?"
    mc "弗洛拉？"

# game/Story02.rpy:3770
translate chinese akt2chapter5_5_81b89ac1:

    # mc "Come to keep an old man company?"
    mc "来陪老头聊天？"

# game/Story02.rpy:3772
translate chinese akt2chapter5_5_273a87ae:

    # Fl "Enjoying yourself? Judging by that face, I'd say you are."
    Fl "享受呢？看你的表情，是挺享受。"

# game/Story02.rpy:3774
translate chinese akt2chapter5_5_e22b01a8:

    # mc "Figured I'd earned myself a minute to breathe after all that."
    mc "经历了那些，我总该喘口气。"

# game/Story02.rpy:3775
translate chinese akt2chapter5_5_2abef19d:

    # mc "...and speaking of the view-"
    mc "……说到风景——"

# game/Story02.rpy:3777
translate chinese akt2chapter5_5_f036636d:

    # Fl "Hmm. Thanks for the compliment."
    Fl "嗯。谢谢夸奖。"

# game/Story02.rpy:3778
translate chinese akt2chapter5_5_abb7c39d:

    # Fl "But I'm already well aware I look amazing."
    Fl "不过我早就知道自己好看。"

# game/Story02.rpy:3779
translate chinese akt2chapter5_5_1dbf79d0:

    # mc "Why are you here?"
    mc "你来干嘛？"

# game/Story02.rpy:3781
translate chinese akt2chapter5_5_7c08658a:

    # Fl "I wanted to have a... private conversation."
    Fl "我想……单独聊聊。"

# game/Story02.rpy:3783
translate chinese akt2chapter5_5_3a3269f1:

    # Fl "And I figured there wouldn't be a better time than this."
    Fl "觉得没比现在更好的时机了。"

# game/Story02.rpy:3785
translate chinese akt2chapter5_5_f63e6b66:

    # Fl "So... sorry for barging in."
    Fl "所以……抱歉贸然进来。"

# game/Story02.rpy:3787
translate chinese akt2chapter5_5_5e49e148:

    # Fl "Hope I'm not ruining your little break?"
    Fl "没打扰你休息吧？"

# game/Story02.rpy:3789
translate chinese akt2chapter5_5_6bf95422:

    # mc "Not in the slightest."
    mc "完全没有。"

# game/Story02.rpy:3790
translate chinese akt2chapter5_5_87bfdd68:

    # mc "So, what’s on your mind?"
    mc "那，你在想什么？"

# game/Story02.rpy:3792
translate chinese akt2chapter5_5_9960704b:

    # Fl "How do you think?"
    Fl "你觉得呢？"

# game/Story02.rpy:3793
translate chinese akt2chapter5_5_8df369a3:

    # Fl "Ember. The explosion..."
    Fl "恩伯。那场爆炸……"

# game/Story02.rpy:3794
translate chinese akt2chapter5_5_6745dd15:

    # Fl "You kind of saved my life."
    Fl "你算是救了我一命。"

# game/Story02.rpy:3795
translate chinese akt2chapter5_5_dfce3f33:

    # Fl "...I'm grateful for that."
    Fl "……我很感激。"

# game/Story02.rpy:3797
translate chinese akt2chapter5_5_237fee5b:

    # mc "Come on. We both know you'd have made it out without me."
    mc "得了吧。没我你也能出来。"

# game/Story02.rpy:3798
translate chinese akt2chapter5_5_f1092299:

    # mc "I just made damn sure you did."
    mc "我只是确保你出来了。"

# game/Story02.rpy:3800
translate chinese akt2chapter5_5_bb5e0b48:

    # mc "So that's it? You came here to repay me?"
    mc "就这样？你来报答我？"

# game/Story02.rpy:3801
translate chinese akt2chapter5_5_44d1bf6c:

    # Fl "You'd probably like tha—"
    Fl "你大概会喜欢——"

# game/Story02.rpy:3802
translate chinese akt2chapter5_5_0e43c0bb:

    # mc "Forget it. I'm not interested."
    mc "算了。我没兴趣。"

# game/Story02.rpy:3803
translate chinese akt2chapter5_5_6c000f55:

    # Fl "Wait, what?"
    Fl "等等，什么？"

# game/Story02.rpy:3805
translate chinese akt2chapter5_5_28970976:

    # Fl "Come again?"
    Fl "再说一遍？"

# game/Story02.rpy:3807
translate chinese akt2chapter5_5_631ed0f2:

    # mc "Trying to talk you out of doing something stupid."
    mc "想劝你别干蠢事。"

# game/Story02.rpy:3808
translate chinese akt2chapter5_5_0e9233a6:

    # mc "I'm old enough to be your father."
    mc "我年纪都能当你爸了。"

# game/Story02.rpy:3810
translate chinese akt2chapter5_5_5de69e42:

    # Fl "Whoa, hold on."
    Fl "哇，等等。"

# game/Story02.rpy:3811
translate chinese akt2chapter5_5_2861a979:

    # Fl "First of all, that's my decision to make."
    Fl "首先，那是我自己的决定。"

# game/Story02.rpy:3812
translate chinese akt2chapter5_5_37580000:

    # Fl "And second..."
    Fl "其次……"

# game/Story02.rpy:3815
translate chinese akt2chapter5_5_af7ffb2f:

    # Fl "In two days you've won Astoria's support... {w}earned the Peacemakers' respect... {w}got through to Ember..."
    Fl "两天里你赢得了阿斯托里亚的支持……{w}赢得了维和者的尊重……{w}说服了恩伯……"

# game/Story02.rpy:3816
translate chinese akt2chapter5_5_41e2eee3:

    # Fl "...and looked after my father."
    Fl "……还照顾了我父亲。"

# game/Story02.rpy:3817
translate chinese akt2chapter5_5_57ef6b3e:

    # Fl "Not exactly an average resume."
    Fl "这可不是一般人能做到的。"

# game/Story02.rpy:3819
translate chinese akt2chapter5_5_410d8f61:

    # mc "Guess I’m just lucky."
    mc "大概我只是运气好。"

# game/Story02.rpy:3821
translate chinese akt2chapter5_5_75c71e1c:

    # Fl "Luck alone doesn't get you this far."
    Fl "光靠运气走不到这一步。"

# game/Story02.rpy:3822
translate chinese akt2chapter5_5_73df1900:

    # "Watching Flora, you notice her eyes keep straying to your body."
    "你注意到弗洛拉的目光不断往你身上瞟。"

# game/Story02.rpy:3823
translate chinese akt2chapter5_5_971d7fd6:

    # Fl "You're... a lot more than just lucky."
    Fl "你……可不只是运气好。"

# game/Story02.rpy:3825
translate chinese akt2chapter5_5_4865b575:

    # mc "Sighs"
    mc "*叹气*"

# game/Story02.rpy:3826
translate chinese akt2chapter5_5_4b284e82:

    # mc "Alright, cut to the chase. What do you want?"
    mc "行，直说吧。你想要什么？"

# game/Story02.rpy:3828
translate chinese akt2chapter5_5_c5eef31d:

    # Fl "I want to help you... blow off some steam."
    Fl "我想帮你……放松一下。"

# game/Story02.rpy:3829
translate chinese akt2chapter5_5_37b8bba4:

    # Fl "And... in return..."
    Fl "作为交换……"

# game/Story02.rpy:3830
translate chinese akt2chapter5_5_51c4b1ba:

    # Fl "I'd like to ask a small favor."
    Fl "我想请你帮个小忙。"

# game/Story02.rpy:3832
translate chinese akt2chapter5_5_523588f8:

    # Fl "And if everything goes well..."
    Fl "如果一切顺利……"

# game/Story02.rpy:3833
translate chinese akt2chapter5_5_a59af33f:

    # Fl "(Maybe... I'll finally know what it feels like... to have him inside me...)"
    Fl "（也许……我终于能知道……他在我体内是什么感觉……）"

# game/Story02.rpy:3834
translate chinese akt2chapter5_5_51d75fdf:

    # Fl "(No! Focus, Flora. Don't let him see you crack. You're stronger than this.)"
    Fl "（不！集中，弗洛拉。别让他看出你撑不住。你比这强。）"

# game/Story02.rpy:3836
translate chinese akt2chapter5_5_2b35b6fe_3:

    # mc "..."
    mc "……"

# game/Story02.rpy:3838
translate chinese akt2chapter5_5_46cd4337:

    # Fl "No pressure."
    Fl "没压力。"

# game/Story02.rpy:3839
translate chinese akt2chapter5_5_2d4101ca:

    # Fl "Just relax..."
    Fl "放松……"

# game/Story02.rpy:3840
translate chinese akt2chapter5_5_11d94c2f:

    # Fl "(That's it... good. Keep your composure.)"
    Fl "（就这样……好。保持镇定。）"

# game/Story02.rpy:3841
translate chinese akt2chapter5_5_20d94be0:

    # Fl "So, what do you say?"
    Fl "怎么样？"

# game/Story02.rpy:3846
translate chinese akt2chapter5_5_8e359492:

    # mc "Fine."
    mc "行。"

# game/Story02.rpy:3847
translate chinese akt2chapter5_5_9b343246:

    # Fl "(W-wait... seriously?)"
    Fl "（等……等等……真的？）"

# game/Story02.rpy:3848
translate chinese akt2chapter5_5_c2ebd51d:

    # Fl "(Now what...?)"
    Fl "（现在怎么办……？）"

# game/Story02.rpy:3857
translate chinese akt2chapter5_5_2a5173ee:

    # Fl "(H-he's huge...)"
    Fl "（他……好大……）"

# game/Story02.rpy:3858
translate chinese akt2chapter5_5_dbb224b7:

    # Fl "(And... it's actually throbbing.)"
    Fl "（而且……还在跳。）"

# game/Story02.rpy:3860
translate chinese akt2chapter5_5_f265b89f:

    # Fl "(Am... am I doing this right?)"
    Fl "（我……我做得对吗？）"

# game/Story02.rpy:3861
translate chinese akt2chapter5_5_6a9811f6:

    # Fl "(His face... damn it, I can't tell what he's thinking!)"
    Fl "（他的表情……该死，我看不出他在想什么！）"

# game/Story02.rpy:3862
translate chinese akt2chapter5_5_0372b366:

    # mc "Never took you for the type to waste time on pointless foreplay."
    mc "没想到你是会在无聊前戏上浪费时间的人。"

# game/Story02.rpy:3863
translate chinese akt2chapter5_5_29d61f06:

    # Fl "And you're not the type to deny yourself what you want."
    Fl "你也不是会压抑自己想要什么的人。"

# game/Story02.rpy:3864
translate chinese akt2chapter5_5_ed835432:

    # mc "(Her first time? She's a little clumsy...)"
    mc "（第一次？她有点笨拙……）"

# game/Story02.rpy:3865
translate chinese akt2chapter5_5_b9fa8116:

    # Fl "Admit it. You like this."
    Fl "承认吧。你喜欢这样。"

# game/Story02.rpy:3866
translate chinese akt2chapter5_5_2b35b6fe_4:

    # mc "..."
    mc "……"

# game/Story02.rpy:3867
translate chinese akt2chapter5_5_86a64027:

    # mc "(Still, she's giving it everything she's got. Gotta give her that.)"
    mc "（不过她确实全力以赴了。这点得承认。）"

# game/Story02.rpy:3868
translate chinese akt2chapter5_5_7e63e2f9:

    # Fl "(He's still getting bigger...)"
    Fl "（他又变大了……）"

# game/Story02.rpy:3869
translate chinese akt2chapter5_5_09ecfec3:

    # Fl "(M-my whole body keeps trembling.)"
    Fl "（我……我全身都在抖。）"

# game/Story02.rpy:3870
translate chinese akt2chapter5_5_7c2d6828:

    # "Soft moans begin to slip from Flora's lips."
    "弗洛拉嘴里开始漏出轻吟。"

# game/Story02.rpy:3871
translate chinese akt2chapter5_5_35fda3b6:

    # mc "From the sound of it, you're enjoying this more than I am."
    mc "听这声音，你比我享受多了。"

# game/Story02.rpy:3872
translate chinese akt2chapter5_5_8d597020:

    # Fl "(W-what?)"
    Fl "（什……什么？）"

# game/Story02.rpy:3873
translate chinese akt2chapter5_5_8115b740:

    # "She catches her breath."
    "她喘了口气。"

# game/Story02.rpy:3874
translate chinese akt2chapter5_5_13af6477:

    # Fl "Well, look who's talking."
    Fl "哟，看看谁在说这话。"

# game/Story02.rpy:3875
translate chinese akt2chapter5_5_61fc7499:

    # Fl "Don't tell me you're already at your limit?"
    Fl "别告诉我你已经到极限了？"

# game/Story02.rpy:3876
translate chinese akt2chapter5_5_2b35b6fe_5:

    # mc "..."
    mc "……"

# game/Story02.rpy:3877
translate chinese akt2chapter5_5_7aa6c590:

    # Fl "Or are you seriously going to pretend you aren't?"
    Fl "还是你打算硬装？"

# game/Story02.rpy:3878
translate chinese akt2chapter5_5_6f1e7dde:

    # mc "Keep pushing me and find out."
    mc "再逼我试试。"

# game/Story02.rpy:3879
translate chinese akt2chapter5_5_d32de112:

    # Fl "(...His voice changed?)"
    Fl "（……他声音变了？）"

# game/Story02.rpy:3880
translate chinese akt2chapter5_5_3ea1a9cb:

    # Fl "(It's rougher now... so why is my heart...)"
    Fl "（更粗了……可我的心为什么……）"

# game/Story02.rpy:3882
translate chinese akt2chapter5_5_e536c91b:

