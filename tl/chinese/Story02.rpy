# game/Story02.rpy:408
translate chinese story03_f09e9ca7:

    # h "I’m tired, hungry, and pissed off."
    h "我又累又饿还一肚子火。"

# game/Story02.rpy:409
translate chinese story03_41c079b4:

    # h "And on top of that, this smell… like something died. No, worse."
    h "更别说这股味……像有东西死了。不，比那还糟。"

# game/Story02.rpy:412
translate chinese story03_c2c74b99:

    # mc "Liv… let it out."
    mc "莉芙……说出来吧。"

# game/Story02.rpy:415
translate chinese story03_0956bf9a:

    # h "You asked."
    h "是你问的。"

# game/Story02.rpy:417
translate chinese story03_b9ba3585:

    # h "WHAT THE FUCK IS GOING ON HERE, HUH?!"
    h "这儿他妈到底怎么回事，啊？！"

# game/Story02.rpy:418
translate chinese story03_4b34ea8e:

    # h "A tomb? Screw that, this isn’t a tomb, it’s a damn mutant factory!"
    h "陵墓？去他的，这根本不是陵墓，是他妈的变异体工厂！"

# game/Story02.rpy:421
translate chinese story03_235de949:

    # h "Like the monsters weren’t enough, now we’ve got this red sludge everywhere!"
    h "怪物还不够，现在到处又都是这种红色烂泥！"

# game/Story02.rpy:422
translate chinese story03_42678842:

    # mc "(The sludge is thicker around the bodies.)"
    mc "（尸体周围的烂泥更厚。）"

# game/Story02.rpy:423
translate chinese story03_c4b35ba6:

    # mc "(Like the floor is drinking them in.)"
    mc "（像地板在把它们吸进去。）"

# game/Story02.rpy:426
translate chinese story03_3cf0c399:

    # h "It stinks, you can barely breathe, feels like you’re gonna drop dead any second, and we STILL don’t know anything!"
    h "臭得要命，喘不上气，感觉随时会倒下，而我们还是什么都不知道！"

# game/Story02.rpy:428
translate chinese story03_2b35b6fe_6:

    # mc "..."
    mc "……"

# game/Story02.rpy:430
translate chinese story03_f891bdee:

    # mc "…You wanna see Anya again?"
    mc "……你还想再见安雅吗？"

# game/Story02.rpy:431
translate chinese story03_bf0f6fe4:

    # mc "Then we get comms back."
    mc "那就把通讯恢复。"

# game/Story02.rpy:432
translate chinese story03_f2970bfc:

    # mc "That’s how you don’t end up dead."
    mc "这样才能不死。"

# game/Story02.rpy:434
translate chinese story03_572cd1c5:

    # h "Yeah… you didn’t have to remind me."
    h "是啊……你不用提醒我。"

# game/Story02.rpy:435
translate chinese story03_336e849f:

    # h "I already know, alright?"
    h "我知道，行了吧？"

# game/Story02.rpy:440
translate chinese story03_bb203f8b:

    # mc "Ostorius."
    mc "奥斯特里乌斯。"

# game/Story02.rpy:441
translate chinese story03_4166ee90:

    # mc "Then we need a plan."
    mc "那我们需要计划。"

# game/Story02.rpy:444
translate chinese story03_be8abd4b:

    # o "We had a plan…"
    o "我们本来有计划……"

# game/Story02.rpy:445
translate chinese story03_25a8a50f:

    # o "Right up until we ran into those things."
    o "直到撞上那些东西。"

# game/Story02.rpy:449
translate chinese story03_1e115473:

    # o "Result?"
    o "结果呢？"

# game/Story02.rpy:450
translate chinese story03_38bb996a:

    # o "We almost died."
    o "我们差点死了。"

# game/Story02.rpy:452
translate chinese story03_051f53a9:

    # mc "I didn’t hear an answer."
    mc "我没听到答案。"

# game/Story02.rpy:455
translate chinese story03_657ed2e7:

    # Mi "There is no plan."
    Mi "没有计划。"

# game/Story02.rpy:456
translate chinese story03_513108a9:

    # Mi "…They decided to move in blind."
    Mi "……他们决定蒙头就闯。"

# game/Story02.rpy:457
translate chinese story03_3fb99331:

    # Mi "Figure it out on the way."
    Mi "路上再想办法。"

# game/Story02.rpy:458
translate chinese story03_16bf5c27:

    # Mi "(whispering) I don’t like it either."
    Mi "（低声）我也不喜欢这样。"

# game/Story02.rpy:465
translate chinese story03_1011507d:

    # mc "…That’s what we’re going with?"
    mc "……就按这个来？"

# game/Story02.rpy:467
translate chinese story03_b56db7c9:

    # mc "What’s the issue?"
    mc "什么问题？"

# game/Story02.rpy:468
translate chinese story03_d485b851:

    # g "It’s stuck."
    g "卡住了。"

# game/Story02.rpy:473
translate chinese story03_061c6c5d:

    # gg "So let’s blow it up."
    gg "那就炸开。"

# game/Story02.rpy:474
translate chinese story03_f679ba68:

    # gggg "You have an unhealthy obsession with explosions."
    gggg "你对爆炸的执念不太健康。"

# game/Story02.rpy:477
translate chinese story03_aab66592:

    # gg "Thank you."
    gg "谢谢。"

# game/Story02.rpy:478
translate chinese story03_e11e2fc6:

    # gggg "That wasn’t a compliment."
    gggg "那不是夸你。"

# game/Story02.rpy:479
translate chinese story03_c705beaf:

    # g "Maybe stop debating and actually help?"
    g "能不能别吵了，来帮把手？"

# game/Story02.rpy:483
translate chinese story03_801dd29e:

    # gg "Sir? Orders?"
    gg "长官？命令？"

# game/Story02.rpy:484
translate chinese story03_f5be75f6:

    # o "No other way?"
    o "没别的办法？"

# game/Story02.rpy:485
translate chinese story03_2949a6d0:

    # gg "Nope."
    gg "没有。"

# game/Story02.rpy:486
translate chinese story03_54c087bc:

    # o "Then we go with your plan."
    o "那就按你的计划来。"

# game/Story02.rpy:487
translate chinese story03_eb040965:

    # o "Whatever happens next is on me."
    o "接下来出什么事我担着。"

# game/Story02.rpy:490
translate chinese story03_561aa9ca:

    # gg "You heard that? That means boom time!"
    gg "听见没？该炸了！"

# game/Story02.rpy:491
translate chinese story03_016ee25a:

    # g "Oh, shut up and help already."
    g "哦，闭嘴来帮忙。"

# game/Story02.rpy:494
translate chinese story03_ecf8ee8e:

    # h "Blowing everything up? Yeah, that sounds like a great idea."
    h "全炸了？是啊，听着真棒。"

# game/Story02.rpy:496
translate chinese story03_6344c948:

    # Mi "...Yeah."
    Mi "……是啊。"

# game/Story02.rpy:497
translate chinese story03_2fded262:

    # h "..."
    h "……"

# game/Story02.rpy:498
translate chinese story03_4bcb85d2:

    # h "You know, Mir… I was thinking."
    h "你知道吗，米儿……我在想。"

# game/Story02.rpy:500
translate chinese story03_5c837b6d:

    # h "What if we don’t get the comms back?"
    h "要是通讯恢复不了呢？"

# game/Story02.rpy:501
translate chinese story03_c1195519:

    # h "Then what?"
    h "那怎么办？"

# game/Story02.rpy:506
translate chinese story03_f9a25720:

    # Mi "...I'd rather not consider that outcome."
    Mi "……我不太想考虑那个结果。"

# game/Story02.rpy:508
translate chinese story03_03040e04:

    # mc "(This is your plan…?)"
    mc "（这就是你的计划……？）"

# game/Story02.rpy:511
translate chinese story03_fca52711:

    # mc "No."
    mc "不行。"

# game/Story02.rpy:512
translate chinese story03_8149495e:

    # gg "What, you got a better idea?"
    gg "怎么，你有更好的主意？"

# game/Story02.rpy:516
translate chinese story03_30fc5c91:

    # mc "Step aside."
    mc "让开。"

# game/Story02.rpy:517
translate chinese story03_6a42f4cc:

    # o "Do what he says."
    o "照他说的做。"

# game/Story02.rpy:521
translate chinese story03_a4268367:

    # h "C’mon, old man! Show them what you’ve got!"
    h "来吧，老头！让他们看看你的本事！"

# game/Story02.rpy:522
translate chinese story03_011b3836:

    # h "Hey, Mir, don’t go quiet on me. Get in on this!"
    h "嘿，米儿，别不作声。来一起！"

# game/Story02.rpy:523
translate chinese story03_157f7b09:

    # Mi "Ah, y-yeah..."
    Mi "啊，好……好……"

# game/Story02.rpy:525
translate chinese story03_7c84c769:

    # Mi "...You can do this [mc]."
    Mi "……你能行的，[mc]。"

# game/Story02.rpy:526
translate chinese story03_97ad1ef0:

    # mc "(We can’t restore comms… because of a door?)"
    mc "（就因为一扇门……恢复不了通讯？）"

# game/Story02.rpy:527
translate chinese story03_74109c99:

    # mc "(Ridiculous.)"
    mc "（荒唐。）"

# game/Story02.rpy:536
translate chinese story03_87745c05:

    # gggg "No way..."
    gggg "不会吧……"

# game/Story02.rpy:537
translate chinese story03_f0495233:

    # gg "(whispering) How…? That’s… not possible…"
    gg "（低声）怎么……？那……不可能……"

# game/Story02.rpy:538
translate chinese story03_7b640878:

    # gg "That’s insane…"
    gg "太疯了……"

# game/Story02.rpy:540
translate chinese story03_44856020:

    # k "(…Interesting.)"
    k "（……有意思。）"

# game/Story02.rpy:541
translate chinese story03_963b3a87:

    # o "How’re you holding up?"
    o "你还好吗？"

# game/Story02.rpy:544
translate chinese story03_ec3e61e8:

    # mc "I’ve had worse."
    mc "更糟的都经历过。"

# game/Story02.rpy:546
translate chinese story03_085dc15c:

    # o "Once this is over…"
    o "这事完了之后……"

# game/Story02.rpy:547
translate chinese story03_f2036cf7:

    # o "You’re getting checked. No arguments."
    o "你得去检查。不许争辩。"

# game/Story02.rpy:549
translate chinese story03_d3cafacc:

    # mc "You two, scout ahead."
    mc "你们两个，去前面侦察。"

# game/Story02.rpy:550
translate chinese story03_b1f066af:

    # mc "Ostorius, you’re on the plan."
    mc "奥斯特里乌斯，你来定计划。"

# game/Story02.rpy:551
translate chinese story03_9903bb1b:

    # o "...Alright."
    o "……好。"

# game/Story02.rpy:555
translate chinese story03_395cf2e1:

    # gggg "Huh? Y-yeah."
    gggg "啊？好……好。"

# game/Story02.rpy:556
translate chinese story03_e2a009c2:

    # gggg "Let’s move."
    gggg "走。"

# game/Story02.rpy:558
translate chinese story03_82091822:

    # k "..."
    k "……"

# game/Story02.rpy:561
translate chinese story03_f88d56c5:

    # k "...So."
    k "……那么。"

# game/Story02.rpy:562
translate chinese story03_12e34b36:

    # k "Old man, huh."
    k "老头，是吧。"

# game/Story02.rpy:564
translate chinese story03_2b35b6fe_7:

    # mc "..."
    mc "……"

# game/Story02.rpy:566
translate chinese story03_bd7d9df9:

    # mc "[mc]."
    mc "[mc]。"

# game/Story02.rpy:568
translate chinese story03_7c5837be:

    # k "You’ll do."
    k "也行。"

# game/Story02.rpy:569
translate chinese story03_d50ba7e7:

    # k "Old man it is."
    k "就叫老头。"

# game/Story02.rpy:574
translate chinese story03_2fded262_1:

    # h "..."
    h "……"

# game/Story02.rpy:576
translate chinese story03_b2cf8147:

    # h "Hey. That’s mine. I’m the only one who gets to call him that."
    h "嘿。那是我的。只有我能这么叫他。"

# game/Story02.rpy:578
translate chinese story03_0b87aca6:

    # k "Oh… my apologies."
    k "哦……抱歉。"

# game/Story02.rpy:579
translate chinese story03_0504aa8d:

    # k "Next time I’ll be sure to ask your permission..."
    k "下次我一定先征求你的许可……"

# game/Story02.rpy:580
translate chinese story03_ca783493:

    # k "...if I cared."
    k "……如果我在乎的话。"

# game/Story02.rpy:582
translate chinese story03_953c5c9c:

    # Mi "...She's right."
    Mi "……她说得对。"

# game/Story02.rpy:585
translate chinese story03_eb5ba9aa:

    # Mi "Use his name."
    Mi "用他的名字。"

# game/Story02.rpy:587
translate chinese story03_2b1456e4:

    # k "Hm?"
    k "嗯？"

# game/Story02.rpy:588
translate chinese story03_75afaa62:

    # k "Or what?"
    k "不然呢？"

# game/Story02.rpy:589
translate chinese story03_da3fdbf1_4:

    # Mi "..."
    Mi "……"

# game/Story02.rpy:591
translate chinese story03_0cc48793:

    # Mi "...Don't make me—"
    Mi "……别逼我——"

# game/Story02.rpy:593
translate chinese story03_2ee86563:

    # mc "That’s enough."
    mc "够了。"

# game/Story02.rpy:595
translate chinese story03_ae883d48:

    # mc "You want me to remind you why we’re here?"
    mc "要我来提醒你，我们为什么在这儿吗？"

# game/Story02.rpy:597
translate chinese story03_82091822_1:

    # k "..."
    k "……"

# game/Story02.rpy:598
translate chinese story03_51a7c9c3:

    # k "Watch your tone."
    k "注意你的语气。"

# game/Story02.rpy:599
translate chinese story03_3afae9eb:

    # k "Old man."
    k "老头。"

# game/Story02.rpy:600
translate chinese story03_2b35b6fe_8:

    # mc "..."
    mc "……"

# game/Story02.rpy:601
translate chinese story03_d5e631ba:

    # k "…Better."
    k "……好点了。"

# game/Story02.rpy:604
translate chinese story03_a0746b0c:

    # o "What’s ahead?"
    o "前面什么情况？"

# game/Story02.rpy:605
translate chinese story03_66d9ee3f:

    # o "See anything?"
    o "看到什么了吗？"

# game/Story02.rpy:606
translate chinese story03_1da40134:

    # gg "Yeah, sir. Tunnel leads straight to our destination. Should be a clear path."
    gg "看到了，长官。隧道直通目的地。应该畅通。"

# game/Story02.rpy:609
translate chinese story03_7aef80cd:

    # o "You heard him. Time to mov-"
    o "听见了。该走了——"

# game/Story02.rpy:610
translate chinese story03_cd7d2030:

    # k "Move."
    k "走。"

# game/Story02.rpy:619
translate chinese akt2chapter2_95436558:

    # "Sector 8-S. Radio tower."
    "8-S区。广播塔。"

# game/Story02.rpy:623
translate chinese akt2chapter2_3db60405:

    # mc "Come on, move it!"
    mc "快点，动起来！"

# game/Story02.rpy:631
translate chinese akt2chapter2_873f402d:

    # Mi "...be careful."
    Mi "……小心点。"

# game/Story02.rpy:633
translate chinese akt2chapter2_42e1ebf8:

    # h "You know? There are three types of people in the world."
    h "知道吗？世界上有三种人。"

# game/Story02.rpy:635
translate chinese akt2chapter2_fb150785:

    # h "Those who can count and those who can’t."
    h "会数数的，和不会数数的。"

# game/Story02.rpy:637
translate chinese akt2chapter2_54dfa52b:

    # mc "Seriously? Now?"
    mc "认真的？现在？"

# game/Story02.rpy:639
translate chinese akt2chapter2_1caa0b7c:

    # h "I’m just trying to lighten the load, alright?"
    h "我只是想缓和下气氛，行吗？"

# game/Story02.rpy:641
translate chinese akt2chapter2_c1d6721a:

    # h "Last thing I need is you getting crushed by some rock."
    h "我最不想的就是你被什么石头压死。"

# game/Story02.rpy:643
translate chinese akt2chapter2_2b35b6fe:

    # mc "..."
    mc "……"

# game/Story02.rpy:645
translate chinese akt2chapter2_830516a3:

    # mc "Then keep moving."
    mc "那就继续走。"

# game/Story02.rpy:647
translate chinese akt2chapter2_1df23e07:

    # h "Just… Ah, whatever."
    h "就是……啊，算了。"

# game/Story02.rpy:648
translate chinese akt2chapter2_693f6654:

    # h "Be careful."
    h "小心点。"

# game/Story02.rpy:656
translate chinese akt2chapter2_cbd96b0b:

    # o "(whisper) …That’s bigger than I expected."
    o "（低声）……比我想的大。"

# game/Story02.rpy:658
translate chinese akt2chapter2_f6275c34:

    # o "Take a couple minutes."
    o "休息几分钟。"

# game/Story02.rpy:659
translate chinese akt2chapter2_413dacd9:

    # o "Then we move."
    o "然后继续走。"

# game/Story02.rpy:666
translate chinese akt2chapter2_997755eb:

    # o "Miss Kalestra…?"
    o "卡莱斯特拉女士……？"

# game/Story02.rpy:669
translate chinese akt2chapter2_b371076c:

    # o "This is it?"
    o "就这儿？"

# game/Story02.rpy:671
translate chinese akt2chapter2_07d8ab2a:

    # k "What do you want to hear?"
    k "你想听什么？"

# game/Story02.rpy:672
translate chinese akt2chapter2_7b74b512:

    # k "Yeah. That’s it."
    k "对。就这儿。"

# game/Story02.rpy:676
translate chinese akt2chapter2_c42b05ac:

    # mc "And?"
    mc "然后？"

# game/Story02.rpy:677
translate chinese akt2chapter2_575f771b:

    # mc "What’s the plan?"
    mc "计划是什么？"

# game/Story02.rpy:679
translate chinese akt2chapter2_da341be7:

    # k "I go down. Clear it. You fix the signal."
    k "我下去。清场。你修信号。"

# game/Story02.rpy:680
translate chinese akt2chapter2_bb10cc54:

    # mc "Got anything better?"
    mc "有更好的办法吗？"

# game/Story02.rpy:681
translate chinese akt2chapter2_b901207a:

    # mc "I’m not repeating the same mistakes."
    mc "我不会重蹈覆辙。"

# game/Story02.rpy:683
translate chinese akt2chapter2_47c42a12:

    # k "Oh? Lost someone because you screwed up?"
    k "哦？因为你搞砸了，所以失去了谁？"

# game/Story02.rpy:685
translate chinese akt2chapter2_798b62f7:

    # mc "My people... are on the line."
    mc "我的人……危在旦夕。"

# game/Story02.rpy:688
translate chinese akt2chapter2_3921f04b:

    # gg "Sir…"
    gg "长官……"

# game/Story02.rpy:690
translate chinese akt2chapter2_cd1ae8a3:

    # o "...Not now."
    o "……现在别说。"

# game/Story02.rpy:692
translate chinese akt2chapter2_3de5844c:

    # gg "That’s a one-way trip!"
    gg "那是有去无回！"

# game/Story02.rpy:695
translate chinese akt2chapter2_3d4842cc:

    # gg "If we go down there, we’re trapped."
    gg "下到那儿就困住了。"

# game/Story02.rpy:697
translate chinese akt2chapter2_07abc845:

    # o "..."
    o "……"

# game/Story02.rpy:698
translate chinese akt2chapter2_107d6977:

    # o "Even if it’s a trap… we still go."
    o "就算是陷阱……也得去。"

# game/Story02.rpy:699
translate chinese akt2chapter2_20902548:

    # mc "We’re not."
    mc "我们不。"

# game/Story02.rpy:700
translate chinese akt2chapter2_d22d57d3:

    # mc "Find another way."
    mc "另找一条路。"

# game/Story02.rpy:703
translate chinese akt2chapter2_1b7972b7:

    # o "And if there isn’t?"
    o "要是没有呢？"

# game/Story02.rpy:704
translate chinese akt2chapter2_31970e02:

    # mc "Then you go without us."
    mc "那就你们自己去。"

# game/Story02.rpy:705
translate chinese akt2chapter2_eaad1f88:

    # mc "I’m not gambling my people’s lives on a dead end."
    mc "我不会拿我的人的命去赌死路。"

# game/Story02.rpy:706
translate chinese akt2chapter2_9831753b:

    # o "I saved your life."
    o "我救过你的命。"

# game/Story02.rpy:707
translate chinese akt2chapter2_2b35b6fe_1:

    # mc "..."
    mc "……"

# game/Story02.rpy:708
translate chinese akt2chapter2_572e37c8:

    # o "You owe me."
    o "你欠我的。"

# game/Story02.rpy:709
translate chinese akt2chapter2_7b2f9c7e:

    # k "(Annoying.)"
    k "（烦人。）"

# game/Story02.rpy:715
translate chinese akt2chapter2_28c6764a:

    # o "You’ve got to be kidding me—!"
    o "你他妈逗我——！"

# game/Story02.rpy:716
