translate chinese street_65fab445:

    # M "Father, what are you—"
    M "爸爸，你在——"

#game/script.rpy:1475
translate chinese street_afaa86e9:

    # mc "(Never listens…)"
    mc "（从来不听……）"

#game/script.rpy:1476
translate chinese street_55d191aa:

    # mc "(Get up. Time to meet them.)"
    mc "（起来。该去见他们了。）"

#game/script.rpy:1490
translate chinese street_93dd367a:

    # M "Grandpa, Grandpa!!"
    M "爷爷，爷爷！！"

#game/script.rpy:1492
translate chinese street_3d88bf01:

    # mc "Hey there, sunshine."
    mc "嘿，小太阳。"

#game/script.rpy:1493
translate chinese street_91588638:

    # mc "Missed you."
    mc "想你了。"

#game/script.rpy:1495
translate chinese street_a2b0b3d8:

    # M "I missed you SO much! Like, {b}super{/b} much! I couldn’t wait anymore!"
    M "我超级想你！{b}超级{/b}超级想！我都等不及了！"

#game/script.rpy:1497
translate chinese street_b9f95ba3:

    # mc "Me too, sweetheart. More than you can imagine..."
    mc "我也是，宝贝。比你想象的还要想……"

