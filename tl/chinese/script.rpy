translate chinese norman_home_0ff21e2c:

    # C "You heading out on a job… or a very suspicious sleepover?"
    C "是出任务……还是非常可疑的过夜？"

#game/script.rpy:3863
translate chinese norman_home_0a3fc9df:

    # h "Very funny."
    h "真好笑。"

#game/script.rpy:3865
translate chinese norman_home_b6223ac9:

    # h "Listen. I don’t know how long I’ll be gone."
    h "听着。我不知道要走多久。"

#game/script.rpy:3866
translate chinese norman_home_1cf19a5f:

    # h "You’re in charge while I’m out. Don’t screw it up."
    h "我不在时你来管事。别搞砸了。"

#game/script.rpy:3868
translate chinese norman_home_72f868cb:

    # h "If anything comes up, go to Alexandro."
    h "出什么事就找亚历山德罗。"

#game/script.rpy:3869
translate chinese norman_home_023b0517:

    # h "And no hero crap."
    h "别逞英雄。"

#game/script.rpy:3870
translate chinese norman_home_77334a77:

    # h "If anyone asks for you by name, you call Kayla."
    h "要是有人点名找你，就打给凯拉。"

#game/script.rpy:3871
translate chinese norman_home_0b021fcb:

    # C "Because of those guys?"
    C "因为那帮人？"

#game/script.rpy:3872
translate chinese norman_home_890e67f4:

    # h "Because I said so."
    h "因为我说了算。"

#game/script.rpy:3874
translate chinese norman_home_c2805f15:

    # h "But only if it’s really bad. Don’t panic-call her over nothing."
    h "但只有真出事才行。别没事就慌慌张张打给她。"

#game/script.rpy:3876
translate chinese norman_home_886fbfb4:

    # C "Relax. I’ve got this."
    C "放心。我能搞定。"

#game/script.rpy:3877
translate chinese norman_home_f6ed6776:

    # C "I’m not a kid anymore."
    C "我不是小孩子了。"

#game/script.rpy:3880
translate chinese norman_home_18c61d40:

    # C "Just… be careful, okay?"
    C "就是……小心点，好吗？"

#game/script.rpy:3881
translate chinese norman_home_fa9181a5:

    # C "I’ve heard things about that place. None of them nice."
    C "我听说过那地方的传闻。没一个是好话。"

#game/script.rpy:3884
translate chinese norman_home_e8c800e8:

    # h "We’ve handled worse. Don’t worry about me."
    h "我们处理过更糟的。别担心我。"

#game/script.rpy:3886
translate chinese norman_home_138f8048:

    # C "Besides… he’s still stuck in the past."
    C "再说……他还困在过去里。"

#game/script.rpy:3887
translate chinese norman_home_e3e6e830:

    # C "You keep going back, you’re just gonna tear yourself apart."
    C "你一直回头，只会把自己撕碎。"

#game/script.rpy:3890
translate chinese norman_home_2fded262:

    # h "..."
    h "……"

#game/script.rpy:3896
translate chinese norman_home_e5ae64f1:

    # h "That’s my mess to deal with."
    h "这是我自己的烂摊子。"

#game/script.rpy:3897
translate chinese norman_home_66e1bbfc:

    # h "Take care, Anya."
    h "保重，安雅。"

#game/script.rpy:3898
translate chinese norman_home_8b9f197c:

    # h "And seriously, don’t burn the place down."
    h "还有，说真的，别把店烧了。"

#game/script.rpy:3900
translate chinese norman_home_fcffed5b:

    # C "Heh. No promises."
    C "嘿。不保证。"

#game/script.rpy:3905
translate chinese norman_home_26a803bc:

    # C "..."
    C "……"

#game/script.rpy:3909
translate chinese norman_home_865d11d9:

    # CC "Alone again. Cute."
    CC "又是一个人了。真可爱。"

#game/script.rpy:3910
translate chinese norman_home_d52cc140:

    # CC "Still pretending you matter… that anyone actually needs you."
    CC "还在假装自己很重要……假装有人真的需要你。"

#game/script.rpy:3912
translate chinese norman_home_a1689f7e:

    # CC "You wanna know the truth, Anya?"
    CC "想知道真相吗，安雅？"

#game/script.rpy:3913
translate chinese norman_home_4dbba7e0:

    # CC "They don’t leave because they have to."
    CC "他们离开不是迫不得已。"

#game/script.rpy:3914
translate chinese norman_home_637b35ac:

    # CC "They leave because you’re exhausting."
    CC "他们离开是因为你让人心累。"

#game/script.rpy:3915
translate chinese norman_home_04927438:

    # CC "Dead weight."
    CC "累赘。"

#game/script.rpy:3917
translate chinese norman_home_b4167937:

    # CC "You ever wonder why Olivia’s so cold with you?"
    CC "你有没有想过，奥利维亚为什么对你那么冷？"

#game/script.rpy:3918
translate chinese norman_home_5483a5b6:

    # CC "There’s a reason."
    CC "是有原因的。"

#game/script.rpy:3920
translate chinese norman_home_efd2f7e5:

    # CC "She {b}blames{/b} you."
    CC "她{b}怪{/b}你。"

#game/script.rpy:3921
translate chinese norman_home_b1d297f9:

    # CC "For mom. For everything that fell apart."
    CC "怪妈妈的事。怪一切崩塌的事。"

#game/script.rpy:3923
translate chinese norman_home_a7c8469a:

    # C "—No."
    C "——不。"

#game/script.rpy:3924
translate chinese norman_home_975bd40f:

    # C "She just… trusts me."
    C "她只是……信任我。"

#game/script.rpy:3925
translate chinese norman_home_dae8b479:

    # C "She knows I can handle myself."
    C "她知道我能照顾好自己。"

#game/script.rpy:3927
translate chinese norman_home_de9a0fa5:

    # CC "No, sweetheart."
    CC "不，宝贝。"

#game/script.rpy:3928
translate chinese norman_home_bccec193:

    # CC "That’s just what you tell yourself."
    CC "那只是你骗自己的话。"

#game/script.rpy:3929
translate chinese norman_home_bb6ead61:

    # CC "She’s just too tired to keep saving you."
    CC "她只是太累了，懒得再救你。"

#game/script.rpy:3931
translate chinese norman_home_0fc7f4e5:

    # C "We’ve been over this."
    C "这事我们说过了。"

#game/script.rpy:3933
translate chinese norman_home_0d3b4d5e:

    # CC "Yeah. And I keep repeating it for a reason."
    CC "对。我一直重复是有原因的。"

#game/script.rpy:3934
translate chinese norman_home_2779d2c2:

    # CC "Because you still won’t admit it."
    CC "因为你还是不肯承认。"

#game/script.rpy:3937
translate chinese norman_home_62044f69:

    # CC "You’ve always been a burden."
    CC "你一直都是个负担。"

#game/script.rpy:3938
translate chinese norman_home_e26caf48:

    # CC "Mom died saving {b}you{/b}."
    CC "妈妈是为了救{b}你{/b}才死的。"

#game/script.rpy:3939
translate chinese norman_home_c544f649:

    # CC "She should’ve let you go."
    CC "她当时就该放手。"

#game/script.rpy:3941
translate chinese norman_home_18ad576b:

    # CC "You think she chose you?"
    CC "你以为她选了你？"

#game/script.rpy:3942
translate chinese norman_home_8146ab4c:

    # CC "No."
    CC "不。"

#game/script.rpy:3943
translate chinese norman_home_c8dad351:

    # CC "Panic. Instinct. A mistake."
    CC "慌乱。本能。一个错误。"

#game/script.rpy:3945
translate chinese norman_home_9a2647b8:

    # CC "And now you just… live with it."
    CC "而你现在只能……带着它活下去。"

#game/script.rpy:3946
translate chinese norman_home_2fd6a33a:

    # CC "Pretending you’re not the reason everything broke."
    CC "假装一切破碎的原因不是你。"

#game/script.rpy:3948
translate chinese norman_home_1233cb3e:

    # C "Stop."
    C "住口。"

#game/script.rpy:3950
translate chinese norman_home_af0bd5e8:

    # CC "..."
    CC "……"

#game/script.rpy:3952
translate chinese norman_home_add74554:

    # CC "Olivia had to grow up overnight."
    CC "奥利维亚一夜之间就长大了。"

#game/script.rpy:3953
translate chinese norman_home_c7aed395:

    # CC "Work at fifteen. Carry you through every breakdown."
    CC "十五岁就工作。背着你度过每一次崩溃。"

#game/script.rpy:3955
translate chinese norman_home_dd9930a5:

    # CC "Remember that?"
    CC "还记得吗？"

#game/script.rpy:3956
translate chinese norman_home_d2c61d3d:

    # CC "When you couldn’t even eat without falling apart?"
    CC "你连吃饭都能崩溃的时候？"

#game/script.rpy:3958
translate chinese norman_home_df51ca74:

    # CC "She gave up everything for you."
    CC "她为你放弃了一切。"

#game/script.rpy:3960
translate chinese norman_home_aac19fa4:

    # CC "If it wasn’t for you—"
    CC "要不是因为你——"

#game/script.rpy:3961
translate chinese norman_home_6b0c6193:

    # CC "she’d have a normal life."
    CC "她本可以过正常的生活。"

#game/script.rpy:3962
translate chinese norman_home_5f24ce4e:

    # CC "A future."
    CC "有一个未来。"

#game/script.rpy:3963
translate chinese norman_home_ac745ec0:

    # CC "{b}Without you.{/b}"
    CC "{b}没有你。{/b}"

#game/script.rpy:3965
translate chinese norman_home_69cf3d7d:

    # C "I SAID STOP!"
    C "我说了住口！"

#game/script.rpy:3972
translate chinese norman_home_cb7b66d6:

    # C "You don’t get to say her name."
    C "你没资格提她的名字。"

#game/script.rpy:4000
translate chinese exit_abe34850:

    # h "Barely made it. The hell is with traffic at 5 AM?!"
    h "差点没赶上。早上五点哪来这么多车？！"

#game/script.rpy:4003
translate chinese exit_c88f9506:

    # h "Private Olivia reporting for duty! Ready to serve!"
    h "列兵奥利维亚报到！随时待命！"

#game/script.rpy:4005
translate chinese exit_2cbb8b4f:

    # mc "Cut the formality. You know I hate that."
    mc "别来这套。你知道我讨厌。"

#game/script.rpy:4007
translate chinese exit_3541338e:

    # h "Phew. I was waiting for you to say that."
    h "呼。我就等你说这句。"

#game/script.rpy:4008
translate chinese exit_258b859f:

    # h "So? Anyone else joining, or am I stuck with you?"
    h "那么？还有别人来吗，还是我就跟你凑合了？"

#game/script.rpy:4010
translate chinese exit_fedf44b2:

    # mc "No one else."
    mc "没别人了。"

#game/script.rpy:4011
translate chinese exit_99fade4b:

    # mc "No one left."
    mc "没人剩下了。"

#game/script.rpy:4013
translate chinese exit_1d0edfed:

    # h "Oh. So just us?"
    h "哦。就我们俩？"

#game/script.rpy:4014
translate chinese exit_3b66d8a1:

    # h "Well... that’s…"
    h "嗯……这……"

#game/script.rpy:4016
translate chinese exit_a0f07cfb:

    # h "I mean — what a shame."
    h "我是说——真可惜。"

#game/script.rpy:4018
translate chinese exit_3b138352:

    # h "Traveling just the two of us? Risky business."
    h "就我们俩出行？风险不小啊。"

#game/script.rpy:4020
translate chinese exit_b174c1c6:

    # h "But hey, I’m kind. I’ll tag along."
    h "不过嘛，我人好。就跟上吧。"

#game/script.rpy:4022
translate chinese exit_2b35b6fe:

    # mc "..."
    mc "……"

#game/script.rpy:4024
translate chinese exit_96330e66:

    # mc "You comfortable in th—"
    mc "你穿这个舒服吗——"

#game/script.rpy:4027
translate chinese exit_5223a094:

    # h "We’re not talking about that."
    h "我们不谈这个。"

#game/script.rpy:4030
translate chinese exit_e0715dbc:

    # mc "But-"
    mc "可是——"

#game/script.rpy:4033
translate chinese exit_1faf912c:

    # h "Drop it."
    h "别说了。"

#game/script.rpy:4035
translate chinese exit_f16c798b:

    # mc "If you say so."
    mc "随你。"

#game/script.rpy:4036
translate chinese exit_1dbf79d0:

    # mc "Why are you here?"
    mc "你为什么来？"

#game/script.rpy:4037
translate chinese exit_127cb978:

    # mc "Thought you'd prefer to stay behind."
    mc "还以为你更愿意留下。"

#game/script.rpy:4039
translate chinese exit_92632303:

    # h "Wow. Didn’t know you had such faith in me."
    h "哇。没想到你这么信任我。"

#game/script.rpy:4040
translate chinese exit_99630e69:

    # h "Want me to turn around? Say the word."
    h "想让我掉头？一句话。"

#game/script.rpy:4042
translate chinese exit_e19f9026:

    # mc "Don’t blame me, remember what you said when we first met?"
    mc "别怪我，还记得我们第一次见面你说的话吗？"

#game/script.rpy:4044
translate chinese exit_ef87395e:

    # h "Told you to get lost?"
    h "叫你滚蛋？"

#game/script.rpy:4046
translate chinese exit_2a818bb1:

    # mc "No, after tha—"
    mc "不，在那之后——"

#game/script.rpy:4047
translate chinese exit_737cd637:

    # A "Promise me something..."
    A "答应我一件事……"

#game/script.rpy:4049
translate chinese exit_99b00289:

    # A "Promise me you’ll be back soon."
    A "答应我你很快就会回来。"

#game/script.rpy:4051
translate chinese exit_26d191fe:

    # h "Wait… That's Norman? Don’t tell me we’ve got more company."
    h "等等……那是诺曼？别告诉我还有别人。"

#game/script.rpy:4053
translate chinese exit_fca52711:

    # mc "No."
    mc "没有。"

#game/script.rpy:4054
translate chinese exit_f4701e6e:

    # mc "Alexa stays."
    mc "亚历克莎留下。"

#game/script.rpy:4055
translate chinese exit_da69c8b6:

    # mc "Norman’s with us."
    mc "诺曼跟我们走。"

#game/script.rpy:4057
translate chinese exit_2fded262:

    # h "..."
    h "……"

#game/script.rpy:4059
translate chinese exit_e9b51473:

    # h "Absolutely not."
    h "绝对不行。"

#game/script.rpy:4060
translate chinese exit_98b33eb1:

    # h "Tell me you're joking."
    h "告诉我你在开玩笑。"

#game/script.rpy:4061
translate chinese exit_742c8716:

    # mc "I'm not."
    mc "我没开玩笑。"

#game/script.rpy:4063
translate chinese exit_3c58da68:

    # h "He trained?"
    h "他受过训练？"

#game/script.rpy:4064
translate chinese exit_fca52711_1:

    # mc "No."
    mc "没有。"

#game/script.rpy:4065
translate chinese exit_c5785647:

    # h "Then why the hell is he coming?"
    h "那他干嘛要来？"

#game/script.rpy:4067
translate chinese exit_3457b068:

    # mc "Because he knows a way in."
    mc "因为他知道一条进去的路。"

#game/script.rpy:4068
translate chinese exit_3c1cd138:

    # mc "A part of the forest Richard's coordinates won't get us through."
    mc "理查德的坐标进不了的那片森林。"

#game/script.rpy:4070
translate chinese exit_82d88e81:

    # mc "Time to move."
    mc "该走了。"

#game/script.rpy:4072
translate chinese exit_6e88529d:

    # A "Take care of yourself, eat properly, and call me if you find a signal, okay?"
    A "照顾好自己，好好吃饭，有信号就打给我，好吗？"

#game/script.rpy:4073
translate chinese exit_a196a148:

    # A "Come back quickly... I already miss you."
    A "快点回来……我已经想你了。"

#game/script.rpy:4075
translate chinese exit_22d54f7c:

    # N "Hey… don’t worry, alright?"
    N "嘿……别担心，好吗？"

#game/script.rpy:4076
translate chinese exit_56351196:

    # N "We'll be back before you get tired of missing me."
    N "你还没想够我，我们就回来了。"

#game/script.rpy:4077
translate chinese exit_455d440e:

    # N "I love you."
    N "我爱你。"

#game/script.rpy:4079
translate chinese exit_7ea32c82:

    # N "Take care of yourself while I’m gone, okay?"
    N "我不在的时候照顾好自己，好吗？"

#game/script.rpy:4081
translate chinese exit_04115cce:

    # mc "Norman. Time to go."
    mc "诺曼。该走了。"

#game/script.rpy:4083
translate chinese exit_1398ea10:

    # N "And when I get back… we’ll talk about that, yeah?"
    N "等我回来……我们再谈那件事，好吗？"

#game/script.rpy:4084
translate chinese exit_8559a0d1:

    # N "About… another baby."
    N "关于……再要一个孩子。"

#game/script.rpy:4085
translate chinese exit_455d440e_1:

    # N "I love you."
    N "我爱你。"

#game/script.rpy:4087
translate chinese exit_015366f7:

    # A "I’ll be waiting. I love you too."
    A "我会等你。我也爱你。"

#game/script.rpy:4089
translate chinese exit_850ef128:

    # b "..."
    b "……"

#game/script.rpy:4091
translate chinese exit_a5048c37:

    # mc "Don’t worry — I’ll make sure he comes back safe and sound."
    mc "别担心——我会确保他平安回来。"

#game/script.rpy:4093
translate chinese exit_32fbc3de:

    # A "Returning him to you... just for a while."
    A "把他还给你……就一会儿。"

#game/script.rpy:4095
translate chinese exit_8ff5d9d9:

    # mc "Alright, team — are we ready? Did we forget anything?"
    mc "好了，各位——准备好了吗？有忘带什么吗？"

#game/script.rpy:4099
translate chinese exit_1a6f80aa:

    # h "Gear’s on me."
    h "装备在我身上。"

#game/script.rpy:4101
translate chinese exit_7cf1923a:

    # mc "Norman?"
    mc "诺曼？"

#game/script.rpy:4103
translate chinese exit_4fdae79c:

    # N "Yeah. I’m good."
    N "嗯。我没事。"

#game/script.rpy:4105
translate chinese exit_4b2d2196:

    # N "So… who’s she, exactly?"
    N "那么……她到底是谁？"

#game/script.rpy:4107
translate chinese exit_695501f4:

    # mc "Wait — you two haven’t met?"
    mc "等等——你们俩没见过？"

#game/script.rpy:4109
translate chinese exit_18a047a9:

    # N "Nope. Why would I?"
    N "没有。我干嘛会见过？"

#game/script.rpy:4111
translate chinese exit_78ee1714:

    # h "Good question. I was about to ask the same."
    h "好问题。我正想问同样的事。"

#game/script.rpy:4116
translate chinese exit_64309465:

    # mc "Well then, introductions are in order."
    mc "那好，该介绍一下了。"

#game/script.rpy:4119
translate chinese exit_d23ff98f:

    # mc "Olivia, this is Norman — my son."
    mc "奥利维亚，这是诺曼——我儿子。"

#game/script.rpy:4121
translate chinese exit_2b8a1c22:

    # mc "Not by blood…"
    mc "不是亲生的……"

#game/script.rpy:4122
translate chinese exit_9ea2035f:

    # mc "But it never mattered."
    mc "但从来都不重要。"

#game/script.rpy:4124
translate chinese exit_6d9d6cf5:

    # mc "He’s as much a son to me as anyone could ever be."
    mc "他对我来说就是儿子，没有比这更亲的。"

#game/script.rpy:4126
translate chinese exit_dbc80a3e:

    # mc "Lora and I… couldn’t have kids."
    mc "洛拉和我……不能生育。"

#game/script.rpy:4127
translate chinese exit_e42277f5:

    # mc "So we adopted."
    mc "所以我们收养了他。"

#game/script.rpy:4128
translate chinese exit_ed31c777:

    # mc "Best decision we made."
    mc "我们做过的最好的决定。"

#game/script.rpy:4130
translate chinese exit_e5ed1470:

    # N "Hey, come on, I wasn’t that bad."
    N "嘿，别这样，我没那么糟。"

#game/script.rpy:4131
translate chinese exit_2bda2e3c:

    # N "Alright… maybe a little."
    N "好吧……也许有一点。"

#game/script.rpy:4132
translate chinese exit_3fae39b4:

    # mc "I didn’t say that."
    mc "我可没这么说。"

#game/script.rpy:4133
translate chinese exit_2bdcc97d:

    # N "I know."
    N "我知道。"

#game/script.rpy:4134
translate chinese exit_c30ae1f4:

    # N "I just... back then, I couldn’t believe someone actually wanted me."
    N "我只是……那时候，我不敢相信真的有人想要我。"

#game/script.rpy:4136
translate chinese exit_32b788f8:

    # h "Oh... so what, that makes you my little brother now?"
    h "哦……那怎么，你现在成我弟弟了？"

#game/script.rpy:4137
translate chinese exit_0ba467e3:

    # N "Wait, what?"
    N "等等，什么？"

#game/script.rpy:4138
translate chinese exit_e9adf264:

    # h "Your father… and Lora…"
    h "你父亲……和洛拉……"

#game/script.rpy:4139
translate chinese exit_a8ad3d4b:

    # h "They kinda became family for us."
    h "他们算是成了我们的家人。"

#game/script.rpy:4140
translate chinese exit_c396d2d3:

    # h "Long story."
    h "说来话长。"

#game/script.rpy:4142
translate chinese exit_b50c119f:

    # h "We go way back. Before the army, before all that mess…"
    h "我们认识很久了。在参军之前，在那一堆烂事之前……"

#game/script.rpy:4152
translate chinese exit_8773b0d9:

    # h "(Funny thing is… I remember that day way too well.)"
    h "（有意思的是……那天我记太清楚了。）"

#game/script.rpy:4154
translate chinese exit_931f4b9f:

    # h "(Rain was pouring like the city was trying to drown itself.)"
    h "（雨下得像整座城市想把自己淹死。）"

#game/script.rpy:4156
translate chinese exit_e8712ef4:

    # h "(I was freezing under some rusty shelter. Broke. Soaked. Hungry as hell.)"
    h "（我缩在一个生锈的棚子下冻得发抖。没钱。湿透。饿得要命。）"

#game/script.rpy:4158
translate chinese exit_dab51e44:

    # h "(All I wanted was a job. Anything.)"
    h "（我只想要份工作。什么都行。）"

#game/script.rpy:4159
translate chinese exit_ff448b46:

    # h "(Help mom… maybe get Anya out of that life.)"
    h "（帮妈妈……也许把安雅从那种生活里拉出来。）"

#game/script.rpy:4170
translate chinese exit_f265e4e3:

    # h "(Yeah… turns out life doesn’t give a damn what you want.)"
    h "（是啊……结果生活根本不在乎你想要什么。）"

#game/script.rpy:4172
translate chinese exit_c84b223e:

    # h "(I learned that early.)"
    h "（我早就明白了。）"

#game/script.rpy:4176
translate chinese exit_588c7186:

    # h "(Another “no”. Another door slammed in my face.)"
    h "（又一次“不行”。又一扇门在我面前摔上。）"

#game/script.rpy:4177
translate chinese exit_dd9fb839:

    # h "(And that was it. I just… dropped.)"
    h "（然后就那样了。我直接……垮了。）"

#game/script.rpy:4179
translate chinese exit_98e66e5c:

    # h "(Angry. Lost. Ashamed.)"
    h "（愤怒。迷茫。羞耻。）"

#game/script.rpy:4180
translate chinese exit_522c9563:

    # h "(At the world… and mostly at myself.)"
    h "（对这世界……更多是对我自己。）"

#game/script.rpy:4182
translate chinese exit_b1f7fcd8:

    # h "Well? This it, Olivia?"
    h "怎么？就这样了，奥利维亚？"

#game/script.rpy:4183
translate chinese exit_ff94df49:

    # h "This what a loser looks like?"
    h "这就是失败者的样子？"

#game/script.rpy:4187
translate chinese exit_19e993a6:

    # h "(Pathetic…)"
    h "（真可悲……）"

#game/script.rpy:4189
translate chinese exit_c60dd27a:

    # h "Can’t even get a damn waitress job without a diploma?"
    h "连个服务员工作都找不到，就因为没文凭？"

#game/script.rpy:4190
translate chinese exit_c4ad5d5c:

    # h "Seriously?!"
    h "认真的？！"

#game/script.rpy:4192
translate chinese exit_8a56a096:

    # h "What now?"
    h "现在怎么办？"

#game/script.rpy:4193
translate chinese exit_7670aa87:

    # h "How the hell am I supposed to face mom… Anya…"
    h "我他妈怎么面对妈妈……安雅……"

#game/script.rpy:4195
translate chinese exit_35b155e4:

    # h "I really thought this time was different…"
    h "我真以为这次会不一样……"

#game/script.rpy:4198
translate chinese exit_78ba0b09:

    # h "(Yeah… I was done. Completely.)"
    h "（是啊……我完了。彻底完了。）"

#game/script.rpy:4199
translate chinese exit_850d0d41:

    # h "(Like something inside just snapped.)"
    h "（像里面有什么东西断了。）"

#game/script.rpy:4201
translate chinese exit_5f5087bf:

    # h "(And then… this guy just sits next to me.)"
    h "（然后……这家伙就坐到了我旁边。）"

#game/script.rpy:4202
translate chinese exit_0c84e9bd:

    # h "(Your dad. Didn’t say a word at first.)"
    h "（你爸。一开始一个字都没说。）"

#game/script.rpy:4204
translate chinese exit_d432adfd:

    # h "Get lost."
    h "滚开。"

#game/script.rpy:4206
translate chinese exit_3dc9e83b:

    # h "Please..."
    h "求你了……"

#game/script.rpy:4208
translate chinese exit_2fded262_1:

    # h "..."
    h "……"

#game/script.rpy:4209
translate chinese exit_9fe594e0:

    # h "(Yeah, I know. Rude.)"
    h "（是啊，我知道。没礼貌。）"

#game/script.rpy:4210
translate chinese exit_ba1b9a13:

    # h "(But trust me, you’d be worse in my place.)"
    h "（但相信我，你要是我，会更糟。）"

#game/script.rpy:4212
translate chinese exit_2b35b6fe_1:

    # mc "..."
    mc "……"

#game/script.rpy:4214
translate chinese exit_6b315e5e:

    # mc "Sometimes… it’s easier to talk to a stranger."
    mc "有时候……跟陌生人说话更容易。"

#game/script.rpy:4215
translate chinese exit_140b131e:

    # mc "Might sound crazy. But for some? It’s salvation."
    mc "听着可能疯。但对某些人？那是救赎。"

#game/script.rpy:4217
translate chinese exit_2fded262_2:

    # h "..."
    h "……"

#game/script.rpy:4219
translate chinese exit_f44c513e:

    # mc "Or if not — just let me sit here with you. Until the rain stops."
    mc "或者不行的话——就让我坐这儿陪你。坐到雨停。"

#game/script.rpy:4220
translate chinese exit_4f984fc7:

    # mc "Lora says I do this too often."
    mc "洛拉说我老这样。"

#game/script.rpy:4222
translate chinese exit_2fded262_3:

    # h "..."
    h "……"

#game/script.rpy:4223
translate chinese exit_5a78e9e9:

    # h "...Who's Lora?"
    h "……洛拉是谁？"

#game/script.rpy:4224
translate chinese exit_52e46b6e:

    # mc "Someone who'd probably bring you soup and lecture me for leaving you in the rain."
    mc "一个大概会给你端汤、再骂我把你丢在雨里的人。"

#game/script.rpy:4228
translate chinese exit_2d908e97:

    # h "...Thanks."
    h "……谢谢。"

#game/script.rpy:4233
translate chinese exit_dc9ed579:

    # h "Honestly? He looked like trouble."
    h "说实话？他看着像麻烦。"

#game/script.rpy:4234
translate chinese exit_a2e5e5d8:

    # h "But back then, I didn’t care."
    h "但那时候，我不在乎。"

#game/script.rpy:4235
translate chinese exit_cb0e3c40:

    # h "Trouble beats starving."
    h "麻烦总比饿肚子强。"

#game/script.rpy:4236
translate chinese exit_e3baa940:

    # h "Funny thing is… that moment?"
    h "有意思的是……那一刻？"

#game/script.rpy:4237
translate chinese exit_8a639abe:

    # h "Yeah. That one changed everything."
    h "是啊。就是那一刻改变了一切。"

#game/script.rpy:4239
translate chinese exit_760a6d05:

    # mc "Yeah, well... couldn’t just walk past someone like that. Would’ve haunted me."
    mc "是啊，嗯……没法就那样走过一个那样的人身边。会一直缠着我。"

#game/script.rpy:4240
translate chinese exit_ee08a68c:

    # mc "That’s how it started."
    mc "事情就是这么开始的。"

#game/script.rpy:4241
translate chinese exit_61fd570d:

    # mc "Kinda messy, but... good stories usually are, right?"
    mc "有点乱，但……好故事一般不都这样吗？"

#game/script.rpy:4243
translate chinese exit_547cd89c:

    # h "Yeah. Brought back some memories."
    h "是啊。勾起点回忆。"

#game/script.rpy:4249
translate chinese exit_2fded262_4:

    # h "..."
    h "……"

#game/script.rpy:4251
translate chinese exit_2be999b2:

    # mc "(humming)"
    mc "（哼歌）"

#game/script.rpy:4253
translate chinese exit_e0f82c64:

    # mc "(low humming)"
    mc "（低声哼歌）"

#game/script.rpy:4259
translate chinese exit_6cb1ee23:

    # h "Mmm..."
    h "嗯……"

#game/script.rpy:4261
translate chinese exit_ff932e82:

    # h "What?"
    h "什么？"

#game/script.rpy:4263
translate chinese exit_025422a5:

    # mc "See that car behind us?"
    mc "看见后面那辆车了吗？"

#game/script.rpy:4265
translate chinese exit_76ec2e29:

    # h "Hmm...?"
    h "嗯……？"

#game/script.rpy:4266
translate chinese exit_7fcaca79:

    # mc "Been on us for a while."
    mc "跟了我们一阵子了。"

#game/script.rpy:4269
translate chinese exit_58ea6997:

    # h "How long have they been on us?"
    h "跟多久了？"

#game/script.rpy:4271
translate chinese exit_153c5161:

    # mc "Long enough."
    mc "够久了。"

#game/script.rpy:4272
translate chinese exit_55ce085a:

    # mc "Glove box."
    mc "手套箱。"

#game/script.rpy:4273
translate chinese exit_36dbac10:

    # mc "Take what’s inside."
    mc "把里面的东西拿出来。"

#game/script.rpy:4275
translate chinese exit_eee871f2:

    # h "You really stuffed it in there? This far back?"
    h "你真塞那儿了？这么靠后？"

#game/script.rpy:4277
translate chinese exit_2fded262_5:

    # h "..."
    h "……"

#game/script.rpy:4279
translate chinese exit_9f9f7e4d:

    # h "...Oh, you’ve gotta be kidding me."
    h "……哦，你他妈逗我呢。"

#game/script.rpy:4282
translate chinese exit_91772f02:

    # h "Why the hell is there a suppressor on this thing?"
    h "这玩意儿上怎么会有消音器？"

#game/script.rpy:4284
translate chinese exit_f7fd16c0:

    # mc "Because it looked cool. Duh."
    mc "因为帅啊。废话。"

#game/script.rpy:4285
translate chinese exit_7df1a451:

    # mc "Take it off if you want. No one’s judging."
    mc "想拆就拆。没人说你。"

#game/script.rpy:4289
translate chinese exit_173d5a9e:

    # a "They’re speeding up."
    a "他们加速了。"

#game/script.rpy:4290
translate chinese exit_f9f2efe4:

    # a "Can you slow them down?"
    a "能拖住他们吗？"

#game/script.rpy:4292
translate chinese exit_2ecb8c95:

    # aa "Orders were clear, we just watch."
    aa "命令很清楚，我们只负责盯着。"

#game/script.rpy:4293
translate chinese exit_e50c7b73:

    # a "If we don’t do something, we’ll lose the target!"
    a "再不动手就丢目标了！"

#game/script.rpy:4294
translate chinese exit_0c8edd20:

    # a "And if we lose it, Azarkhan will kill us himself!"
    a "丢了目标，阿扎尔汗会亲手宰了我们！"

#game/script.rpy:4296
translate chinese exit_4d1ddf2c:

    # aa "Can you at least drive like a nor—"
    aa "你至少能不能开得像正常人——"

#game/script.rpy:4302
translate chinese exit_eee588f4:

    # h "—Got one!"
    h "——干掉一个！"

#game/script.rpy:4303
translate chinese exit_9d3a067f:

    # mc "Hold on—"
    mc "抓稳——"

#game/script.rpy:4306
translate chinese exit_614faaec:

    # aaa "They’re escaping! Why provoke them?!"
    aaa "他们跑了！干嘛激他们？！"

#game/script.rpy:4307
translate chinese exit_77a0eca7:

    # a "Shut it. Plan B — take them out!"
    a "闭嘴。B计划——干掉他们！"

#game/script.rpy:4309
translate chinese exit_9b47a0ad:

    # N "What’s happening?!"
    N "怎么回事？！"

#game/script.rpy:4312
translate chinese exit_cd1f4e8b:

    # mc "Relax. Just a couple of guys trying to kill us."
    mc "放松。就几个想弄死我们的人。"

#game/script.rpy:4314
translate chinese exit_2f47fd71:

    # h "Hey—!"
    h "嘿——！"

#game/script.rpy:4315
translate chinese exit_f451724b:

    # h "You don’t happen to keep anything bigger back there, do you?!"
    h "你后面不会碰巧还藏着更大的家伙吧？！"

#game/script.rpy:4321
translate chinese exit_5bf96bff:

    # h "They’re closing in—!"
    h "他们逼近了——！"

#game/script.rpy:4323
translate chinese exit_8cfce26b:

    # mc "Norman, check under the left seat!"
    mc "诺曼，看看左边座位下面！"

#game/script.rpy:4328
translate chinese exit_7d1f33be:

    # N "Is this the 'toy' you meant?"
    N "你说的‘玩具’是这个？"

#game/script.rpy:4330
translate chinese exit_150faa4a:

    # h "GIVE IT GIVE IT GIVE IT!"
    h "给我给我给我！"

#game/script.rpy:4332
translate chinese exit_8dd33ab4:

    # h "...Oh now we’re talking."
    h "……哦，这才像话。"

#game/script.rpy:4333
translate chinese exit_778f766a:

    # h "Custom M4A1… TacticalGrip rail… suppressor…"
    h "定制 M4A1……战术握把导轨……消音器……"

#game/script.rpy:4334
translate chinese exit_f3a5bfd1:

    # h "Damn, you’ve been hiding the good stuff."
    h "靠，你一直藏好东西。"

#game/script.rpy:4340
translate chinese exit_13159dc0:

    # h "Come on— just drop already!"
    h "快点——给我倒啊！"

#game/script.rpy:4344
translate chinese exit_2fded262_6:

    # h "..."
    h "……"

#game/script.rpy:4346
translate chinese exit_e8474f3d:

    # h "Alright... let's wrap this up."
    h "好……收尾吧。"

#game/script.rpy:4348
translate chinese exit_0be0eb4d:

    # mc "Nicely done."
    mc "干得漂亮。"

#game/script.rpy:4369
translate chinese jungle_0ee062c1:

    # mc "Still on us?"
    mc "还跟着吗？"

#game/script.rpy:4371
translate chinese jungle_9f5c960c:

    # h "We’ve gone pretty far."
    h "我们已经走了很远。"

#game/script.rpy:4372
translate chinese jungle_29816939:

    # h "If someone was still on us, we’d know by now."
    h "要是还有人跟着，我们早该知道了。"

#game/script.rpy:4374
translate chinese jungle_a9851615:

    # h "But here’s what bugs me…"
    h "但有一点让我在意……"

#game/script.rpy:4375
translate chinese jungle_1d38f747:

    # h "They were watching us."
    h "他们一直在监视我们。"

#game/script.rpy:4376
translate chinese jungle_9c440d56:

    # h "Then one idiot panicked and turned it into a firefight."
    h "然后一个蠢货慌了，把它变成了枪战。"

#game/script.rpy:4377
translate chinese jungle_5d56e671:

    # h "Why?"
    h "为什么？"

#game/script.rpy:4379
translate chinese jungle_18173c7d:

    # mc "Because we got too close."
    mc "因为我们靠得太近了。"

#game/script.rpy:4380
translate chinese jungle_d0b4e1e9:

    # mc "Or because they couldn't afford to lose us."
    mc "或者因为他们丢不起我们。"

#game/script.rpy:4381
translate chinese jungle_027b09ef:

    # h "...Yeah. Thought so."
    h "……是啊。我也这么想。"

#game/script.rpy:4383
translate chinese jungle_431d2e38:

    # N "You know who it was, Dad?"
    N "知道是谁吗，爸？"

#game/script.rpy:4385
translate chinese jungle_ab08fc7c:

    # mc "Azarkhan’s people."
    mc "阿扎尔汗的人。"

#game/script.rpy:4386
translate chinese jungle_67176192:

    # mc "Too familiar."
    mc "太熟悉了。"

#game/script.rpy:4388
translate chinese jungle_fda6f41e:

    # mc "But Olivia's right."
    mc "但奥利维亚说得对。"

#game/script.rpy:4389
translate chinese jungle_f694ac67:

    # mc "That wasn't a clean hit."
    mc "那不是一次干净的刺杀。"

#game/script.rpy:4390
translate chinese jungle_00950657:

    # mc "That was surveillance gone bad."
    mc "那是监视出了岔子。"

#game/script.rpy:4392
translate chinese jungle_b1683f59:

    # h "Seriously though…"
    h "不过说真的……"

#game/script.rpy:4393
translate chinese jungle_4ce0af49:

    # h "What kind of world is this now?"
    h "现在这算什么世道？"

#game/script.rpy:4394
translate chinese jungle_00e0c5b2:

    # h "Dead men just… getting back up like nothing happened?"
    h "死人就这么……像没事一样爬起来了？"

#game/script.rpy:4396
translate chinese jungle_da856d69:

    # h "First Azarkhan."
    h "先是阿扎尔汗。"

#game/script.rpy:4397
translate chinese jungle_d18cc182:

    # h "Now his crew, all supposedly dead, and yet here they are."
    h "现在他的手下，据说全死了，结果都在这儿。"

#game/script.rpy:4398
translate chinese jungle_7af84186:

    # h "What’s next, huh?"
    h "接下来是什么？"

#game/script.rpy:4399
translate chinese jungle_9c684cd7:

    # h "Ghosts with guns?"
    h "带枪的鬼？"

#game/script.rpy:4401
translate chinese jungle_b555e454:

    # mc "You said you needed a break."
    mc "你说你需要休息。"

#game/script.rpy:4402
translate chinese jungle_7b530492:

    # mc "This is it."
    mc "就是这个。"

#game/script.rpy:4404
translate chinese jungle_f780d94f:

    # h "Oh yeah. Amazing."
    h "哦是啊。太棒了。"

#game/script.rpy:4405
translate chinese jungle_037a6cd5:

    # h "Exactly the kind of vacation I was dreaming about."
    h "正是我梦寐以求的假期。"

#game/script.rpy:4407
translate chinese jungle_931ec421:

    # mc "Come on, don’t be mad. After this trip, I promise I’ll make it up to you — big time."
    mc "别这样，别生气。这趟完了，我保证好好补偿你——大补偿。"

#game/script.rpy:4409
translate chinese jungle_27a86f56:

    # h "Well, no one forced you to speak up."
    h "嗯，没人逼你开口。"

#game/script.rpy:4411
translate chinese jungle_35550527:

    # mc "Norman. Map."
    mc "诺曼。地图。"

#game/script.rpy:4413
translate chinese jungle_b6286e70:

    # N "Hold on, Dad, I need to lock in our position."
    N "等等，爸，我得先定位。"

#game/script.rpy:4414
translate chinese jungle_058ec645:

    # N "…and let them know we’re almost there."
    N "……再告诉他们我们快到了。"

#game/script.rpy:4415
translate chinese jungle_1ef706f6:

    # mc "Who?"
    mc "谁？"

#game/script.rpy:4417
translate chinese jungle_deaf1f75:

    # N "My supervisor."
    N "我的上司。"

#game/script.rpy:4418
translate chinese jungle_e507a460:

    # N "Shiya Gray."
    N "诗雅·格雷。"

#game/script.rpy:4420
translate chinese jungle_69da11c5:

    # h "Wait."
    h "等等。"

#game/script.rpy:4421
translate chinese jungle_5df131df:

    # h "Gray?"
    h "格雷？"

#game/script.rpy:4423
translate chinese jungle_76b41278:

    # mc "Richard's daughter."
    mc "理查德的女儿。"

#game/script.rpy:4424
translate chinese jungle_41f53a52:

    # N "...You know her?"
    N "……你认识她？"

#game/script.rpy:4425
translate chinese jungle_610e1ad0:

    # mc "Long story."
    mc "说来话长。"

#game/script.rpy:4428
translate chinese jungle_016dd687:

    # N "Take the first left up ahead."
    N "前面第一个路口左转。"

#game/script.rpy:4430
translate chinese jungle_c3700a77:

    # N "If the map's correct, that’s our fastest route."
    N "地图没错的话，那是最快的路。"

#game/script.rpy:4432
translate chinese jungle_e74b3405:

    # N "Give it about an hour, we should be there."
    N "大概一小时，我们就到了。"

#game/script.rpy:4443
translate chinese jungle_548dedb9:

    # mc "That’s as far as we go."
    mc "车就开到这儿。"

#game/script.rpy:4444
translate chinese jungle_1861ed43:

    # mc "From here on, we walk."
    mc "接下来靠走的。"

#game/script.rpy:4445
translate chinese jungle_4981463c:

    # mc "Norman, how far to the lab?"
    mc "诺曼，到实验室还有多远？"

#game/script.rpy:4448
translate chinese jungle_7cf1923a:

    # mc "Norman?"
    mc "诺曼？"

#game/script.rpy:4450
translate chinese jungle_11f86aaa:

    # N "We’ve got a problem, Dad. GPS is dead."
    N "有问题，爸。GPS 挂了。"

#game/script.rpy:4451
translate chinese jungle_2fc725b9:

    # N "Something’s jamming the signal."
    N "有东西在干扰信号。"

#game/script.rpy:4453
translate chinese jungle_e191a532:

    # mc "How bad?"
    mc "多严重？"

#game/script.rpy:4455
translate chinese jungle_79a88624:

    # N "Not ideal… but not critical."
    N "不算理想……但不致命。"

#game/script.rpy:4456
translate chinese jungle_f5c72e1f:

    # N "We need open ground, once we’ve got that, I can navigate off the map."
    N "得有片开阔地，有了那个我就能靠地图导航。"

#game/script.rpy:4458
translate chinese jungle_d4540d79:

    # h "Wait, hold on—"
    h "等等，等一下——"

#game/script.rpy:4459
translate chinese jungle_e77ce4fa:

    # h "Are you telling me we’re lost?"
    h "你是说我们迷路了？"

#game/script.rpy:4460
translate chinese jungle_1eebc258:

    # mc "Plans changed."
    mc "计划变了。"

#game/script.rpy:4461
translate chinese jungle_cb717e89:

    # mc "Had to make sure we weren’t being followed."
    mc "得确认没人跟着我们。"

#game/script.rpy:4462
translate chinese jungle_62d40295:

    # h "Oh, great. Fantastic."
    h "哦，好极了。太棒了。"

#game/script.rpy:4463
translate chinese jungle_4a5c8a3b:

    # h "So you {b}do{/b} know where we’re going… right?"
    h "所以你{b}确实{/b}知道我们要去哪儿……对吧？"

#game/script.rpy:4464
translate chinese jungle_2b35b6fe:

    # mc "..."
    mc "……"

#game/script.rpy:4467
translate chinese jungle_f9981629:

    # N "We’re not lost. Dad logged the coordinates."
    N "我们没迷路。爸把坐标记下来了。"

#game/script.rpy:4468
translate chinese jungle_9b1924a9:

    # N "This just makes things… a bit messier."
    N "只是让事情……麻烦了点。"

#game/script.rpy:4470
translate chinese jungle_e6b416ba:

    # h "No, no... hang on."
    h "不不……等等。"

#game/script.rpy:4471
translate chinese jungle_52ae9db8:

    # h "I wasn’t asking you."
    h "我没问你。"

#game/script.rpy:4472
translate chinese jungle_c3fd9c22:

    # h "[mc]."
    h "[mc]。"

#game/script.rpy:4473
translate chinese jungle_f4fbb626:

    # h "Two things."
    h "两件事。"

#game/script.rpy:4474
translate chinese jungle_66014d67:

    # h "Target."
    h "目标。"

#game/script.rpy:4475
translate chinese jungle_3a2cbd7d:

    # h "And motive."
    h "还有动机。"

#game/script.rpy:4477
translate chinese jungle_2c037559:

    # mc "I gave you a reason back at the bar."
    mc "在酒吧我给过你理由。"

#game/script.rpy:4479
translate chinese jungle_78dfa234:

    # h "Let me paint you a picture."
    h "我给你描绘一下。"

#game/script.rpy:4480
translate chinese jungle_09a52859:

    # h "You’re in your bar."
    h "你在你的酒吧里。"

#game/script.rpy:4481
translate chinese jungle_d3c5319f:

    # h "Someone walks in."
    h "有人走进来。"

#game/script.rpy:4482
translate chinese jungle_ac722036:

    # h "Haven’t seen them in eight years."
    h "八年没见了。"

#game/script.rpy:4483
translate chinese jungle_e752061c:

    # h "And suddenly they’re asking for help."
    h "突然跑来求你帮忙。"

#game/script.rpy:4484
translate chinese jungle_d5d6b8b9:

    # h "I’m not asking for much."
    h "我要求的不多。"

#game/script.rpy:4485
translate chinese jungle_2ace915a:

    # h "Just don’t lie to me."
    h "只要别骗我。"

#game/script.rpy:4487
translate chinese jungle_19baf393:

    # mc "You really want to hear it?"
    mc "你真想听？"

#game/script.rpy:4489
translate chinese jungle_0fb922e6:

    # h "I’m already here."
    h "我都来了。"

#game/script.rpy:4490
translate chinese jungle_b92a392d:

    # h "Bit late to hesitate now."
    h "现在犹豫太晚了。"

#game/script.rpy:4496
translate chinese jungle_c9fe3339:

    # mc "Alright… simple version."
    mc "好……简单版。"

#game/script.rpy:4498
translate chinese jungle_ab995604:

    # mc "Teleportation."
    mc "传送。"

#game/script.rpy:4500
translate chinese jungle_05595850:

    # h "...You’ve gotta be kidding me."
    h "……你他妈逗我呢。"

#game/script.rpy:4501
translate chinese jungle_d7608ad8:

    # h "Or what, you finally lost your mind?"
    h "还是说，你终于疯了？"

#game/script.rpy:4502
translate chinese jungle_2b35b6fe_1:

    # mc "..."
    mc "……"

#game/script.rpy:4507
translate chinese jungle_26f9ce20:

    # mc "Even with the facts…"
    mc "就算有这些证据……"

#game/script.rpy:4508
translate chinese jungle_05bdf747:

    # mc "I’m still not sure I believe it myself."
    mc "我自己都还不太敢信。"

#game/script.rpy:4510
translate chinese jungle_d7db851c:

    # h "You know what? Fine."
    h "你知道吗？行吧。"

#game/script.rpy:4511
translate chinese jungle_e7f70801:

    # h "Don’t wanna talk? Don’t."
    h "不想说？那就别说。"

#game/script.rpy:4512
translate chinese jungle_3956c4b6:

    # h "(muttering) Figures… only known each other, what, twenty-five years…"
    h "（嘟囔）果然……认识才多久，也就二十五年吧……"

#game/script.rpy:4516
translate chinese jungle_b8f81952:

    # mc "Olivia."
    mc "奥利维亚。"

#game/script.rpy:4517
translate chinese jungle_1abb6545:

    # mc "If I’m wrong about this…"
    mc "如果我这次错了……"

#game/script.rpy:4518
translate chinese jungle_5fd2f2e9:

    # mc "You get a wish."
    mc "你可以提一个愿望。"

#game/script.rpy:4520
translate chinese jungle_9f9aa8b1:

    # h "Another one?"
    h "又来一个？"

#game/script.rpy:4521
translate chinese jungle_2fbe4877:

    # h "Wow. You’re really feeling generous today."
    h "哇。你今天可真大方。"

#game/script.rpy:4523
translate chinese jungle_7e467c9b:

    # h "Relax. I walked into this myself."
    h "放心。这是我自己跳进来的。"

#game/script.rpy:4524
translate chinese jungle_51bb8785:

    # h "And…"
    h "而且……"

#game/script.rpy:4525
translate chinese jungle_f56ff857:

    # h "Yeah, this place is kinda beautiful."
    h "是啊，这地方还挺美的。"

#game/script.rpy:4526
translate chinese jungle_7a704b80:

    # h "You look at those trees and almost forget—"
    h "看着那些树，几乎会忘了——"

#game/script.rpy:4527
translate chinese jungle_bdf6502a:

    # h "That forty minutes ago, some psychos were trying to kill us."
    h "四十分钟前还有几个疯子在追杀我们。"

#game/script.rpy:4529
translate chinese jungle_49014fd7:

    # mc "Didn’t take you for the nature type."
    mc "没想到你是喜欢自然的人。"

#game/script.rpy:4531
translate chinese jungle_730b8b8b:

    # h "Excuse me?"
    h "你说什么？"

#game/script.rpy:4532
translate chinese jungle_7e533695:

    # h "You got a problem with that?"
    h "你有意见？"

#game/script.rpy:4534
translate chinese jungle_04cd4a35:

    # mc "You’re different when you look at this stuff."
    mc "你看这些东西的时候不一样。"

#game/script.rpy:4535
translate chinese jungle_937d07f5:

    # mc "In a good way."
    mc "往好的方向。"

#game/script.rpy:4537
translate chinese jungle_2fded262:

    # h "..."
    h "……"

#game/script.rpy:4538
translate chinese jungle_d30fadbc:

    # h "Wow."
    h "哇。"

#game/script.rpy:4539
translate chinese jungle_2d59c3a3:

    # h "And what did I do to earn that, huh?"
    h "我做了什么配得上这句，嗯？"

#game/script.rpy:4540
translate chinese jungle_2d908e97:

    # h "...Thanks."
    h "……谢谢。"

#game/script.rpy:4542
translate chinese jungle_e615c6a6:

    # mc "Norman. Status."
    mc "诺曼。汇报。"

#game/script.rpy:4545
translate chinese jungle_4f997413:

    # N "No luck reaching my handler."
    N "联系不上我的联络人。"

#game/script.rpy:4547
translate chinese jungle_1408e3e4:

    # N "I’ve tried, no response."
    N "试过了，没回应。"

#game/script.rpy:4549
translate chinese jungle_fda9d8ee:

    # mc "Before she disappeared… your mother made a few calls from work."
    mc "她失踪前……你妈妈从单位打了几通电话。"

#game/script.rpy:4550
translate chinese jungle_098ae161:

    # mc "Didn’t know the details."
    mc "不知道细节。"

#game/script.rpy:4551
translate chinese jungle_3594c294:

    # mc "But the signal was the same."
    mc "但信号是一样的。"

#game/script.rpy:4552
translate chinese jungle_857e3e82:

    # mc "Dead."
    mc "死的。"

#game/script.rpy:4553
translate chinese jungle_b982c7d0:

    # mc "(Same silence as Al-Zahira.)"
    mc "（和阿尔扎希拉一样的死寂。）"

#game/script.rpy:4555
translate chinese jungle_4112597f:

    # N "Yeah… but we thought we fixed that."
    N "是啊……但我们以为已经修好了。"

#game/script.rpy:4557
translate chinese jungle_ed71b73d:

    # mc "Guess not."
    mc "看来没有。"

#game/script.rpy:4558
translate chinese jungle_7cf1923a_1:

    # mc "Norman?"
    mc "诺曼？"

#game/script.rpy:4560
translate chinese jungle_d850041b:

    # mc "Catch."
    mc "接住。"

#game/script.rpy:4563
translate chinese jungle_3d826554:

    # N "…What’s this?"
    N "……这是什么？"

#game/script.rpy:4565
translate chinese jungle_9ff43c05:

    # mc "Your protection."
    mc "你的护具。"

#game/script.rpy:4566
translate chinese jungle_c36e8603:

    # mc "And a promise I made to Alexa."
    mc "也是我对亚历克莎的承诺。"

#game/script.rpy:4567
translate chinese jungle_c17ca67b:

    # mc "Now go get changed."
    mc "去换上吧。"

#game/script.rpy:4569
translate chinese jungle_4d275639:

    # N "But the signal—"
    N "可是信号——"

#game/script.rpy:4570
translate chinese jungle_0a8aa971:

    # mc "Take a breather."
    mc "歇口气。"

#game/script.rpy:4571
translate chinese jungle_88dcfc45:

    # mc "You’re wound too tight."
    mc "你绷太紧了。"

#game/script.rpy:4572
translate chinese jungle_b5c321df:

    # N "…Alright."
    N "……好吧。"

#game/script.rpy:4577
translate chinese jungle_45189c64:

    # mc "What do you think of him?"
    mc "你觉得他怎么样？"

#game/script.rpy:4580
translate chinese jungle_67af5045:

    # h "If things go loud?"
    h "要是打起来？"

#game/script.rpy:4581
translate chinese jungle_eaab07e8:

    # h "He would be the first one to die"
    h "他第一个死。"

#game/script.rpy:4583
translate chinese jungle_236b0ca5:

    # h "Why’d you even bring him?"
    h "你干嘛带他来？"

#game/script.rpy:4585
translate chinese jungle_c2e0153a:

    # mc "Because the coordinates only get us close."
    mc "因为坐标只能带我们到附近。"

#game/script.rpy:4586
translate chinese jungle_d9ed78fe:

    # mc "Norman knows the rest."
    mc "剩下的诺曼知道。"

#game/script.rpy:4587
translate chinese jungle_6b8ffa93:

    # mc "And yes, I tried to talk him out of it."
    mc "对，我试着劝过他别去。"

#game/script.rpy:4588
translate chinese jungle_d986505d:

    # mc "Didn't work."
    mc "没用。"

#game/script.rpy:4590
translate chinese jungle_2fded262_1:

    # h "..."
    h "……"

#game/script.rpy:4592
translate chinese jungle_34a01b78:

    # h "Figures."
    h "果然。"

#game/script.rpy:4593
translate chinese jungle_e0002ad0:

    # h "Stubborn, just like you, huh?"
    h "跟你一样犟，嗯？"

#game/script.rpy:4594
translate chinese jungle_4338d359:

    # h "Still… if he stays in the back he might actually make it."
    h "不过……他要是待后面，也许真能活下来。"

#game/script.rpy:4597
translate chinese jungle_ad17a2a5:

    # N "Bit oversized… but yeah, solid."
    N "有点大……不过确实结实。"

#game/script.rpy:4598
translate chinese jungle_44dbbf19:

    # N "Feels reliable."
    N "感觉靠得住。"

#game/script.rpy:4600
translate chinese jungle_3486baab:

    # h "Hey, kid."
    h "嘿，小子。"

#game/script.rpy:4601
translate chinese jungle_787ca900:

    # h "That vest? Doesn’t make you bulletproof."
    h "那背心？不防弹。"

#game/script.rpy:4602
translate chinese jungle_3a975633:

    # h "Shots fired? You hit the ground and stay there."
    h "一开枪？你就趴地上别动。"

#game/script.rpy:4603
translate chinese jungle_a4231084:

    # h "Don’t be dead weight."
    h "别当累赘。"

#game/script.rpy:4605
translate chinese jungle_1db4077f:

    # N "…Got it."
    N "……明白。"

#game/script.rpy:4608
translate chinese jungle_4350c951:

    # mc "We’ll need him."
    mc "我们需要他。"

#game/script.rpy:4610
translate chinese jungle_2ed9073b:

    # h "Oh yeah?"
    h "哦？"

#game/script.rpy:4611
translate chinese jungle_9386b644:

    # h "And when exactly is that supposed to be?"
    h "那到底是什么时候？"

#game/script.rpy:4613
translate chinese jungle_858483b1:

    # mc "He’s the only one who can get us in."
    mc "只有他能带我们进去。"

#game/script.rpy:4614
translate chinese jungle_7c19ff96:

    # mc "He knows the old service route."
    mc "他知道那条旧维护道。"

#game/script.rpy:4615
translate chinese jungle_6eea1693:

    # mc "The one Lora used."
    mc "洛拉走过的那条。"

#game/script.rpy:4617
translate chinese jungle_6c560a32:

    # N "I’m not much of a fighter, I’ll admit that."
    N "我不是什么战士，这我承认。"

#game/script.rpy:4619
translate chinese jungle_be66ef0d:

    # N "But you’re gonna need me once we reach that lab."
    N "但到了实验室，你们就需要我。"

#game/script.rpy:4621
translate chinese jungle_d181a398:

    # h "Hold up—"
    h "等等——"

#game/script.rpy:4622
translate chinese jungle_ee5b3169:

    # h "What lab?"
    h "什么实验室？"

#game/script.rpy:4623
translate chinese jungle_ae4ebe93:

    # mc "According to Norman… there’s a lab at the center."
    mc "据诺曼说……中心有个实验室。"

#game/script.rpy:4625
translate chinese jungle_2fded262_2:

    # h "..."
    h "……"

#game/script.rpy:4628
translate chinese jungle_b0d6f560:

    # h "And what’s the plan with it?"
    h "那对它有什么计划？"

#game/script.rpy:4630
translate chinese jungle_ed933789:

    # N "…She’s got a point."
    N "……她说得有道理。"

#game/script.rpy:4632
translate chinese jungle_2b35b6fe_2:

    # mc "..."
    mc "……"

#game/script.rpy:4634
translate chinese jungle_81d52519:

    # mc "We don’t have a choice."
    mc "我们没得选。"

#game/script.rpy:4635
translate chinese jungle_5f2d8436:

    # mc "Right now… it’s just dead weight."
    mc "现在……它就是个累赘。"

#game/script.rpy:4637
translate chinese jungle_1b98a873:

    # h "Heh…"
    h "嘿……"

#game/script.rpy:4638
translate chinese jungle_61e957a5:

    # h "Same old you."
    h "还是老样子。"

#game/script.rpy:4639
translate chinese jungle_a16e8e41:

    # h "Glad nothing’s changed."
    h "还好什么都没变。"

#game/script.rpy:4642
translate chinese jungle_eab51ec6:

    # h "Hey, Norman… mind if I ask something?"
    h "嘿，诺曼……介意我问件事吗？"

#game/script.rpy:4643
translate chinese jungle_f44eba9f:

    # N "Go ahead."
    N "问吧。"

#game/script.rpy:4645
translate chinese jungle_6f919b4f:

    # h "How did you meet your wife?"
    h "你怎么认识你妻子的？"

#game/script.rpy:4646
translate chinese jungle_e8f11a91:

    # N "…That’s a long story."
    N "……说来话长。"

#game/script.rpy:4647
translate chinese jungle_94d37d67:

    # N "Feels like a different life."
    N "感觉像上辈子的事。"

#game/script.rpy:4649
translate chinese jungle_9627e2c1:

    # h "We’ve got a long walk anyway."
    h "反正路还长。"

#game/script.rpy:4651
translate chinese jungle_9f7f326d:

    # h "Hey, are you not curious about your son’s love life?"
    h "嘿，你不好奇你儿子的感情生活？"

#game/script.rpy:4653
translate chinese jungle_74f6c040:

    # mc "I’m coming."
    mc "我来了。"

#game/script.rpy:4655
translate chinese jungle_9be863b0:

    # h "Go on, Norman."
    h "说吧，诺曼。"

#game/script.rpy:4656
translate chinese jungle_962af931:

    # h "We’ve got time."
    h "我们有时间。"

#game/script.rpy:4657
translate chinese jungle_9b1bfb7e:

    # N "Back in the day, back when dinosaurs still roamed the earth, I was a broke university student."
    N "那会儿，恐龙还在地球上溜达的时候，我是个穷大学生。"

#game/script.rpy:4658
translate chinese jungle_5ebb1cd0:

    # N "Spent more time with books than people."
    N "跟书待的时间比跟人多。"

#game/script.rpy:4660
translate chinese jungle_add80bc4:

    # N "Didn’t think anyone would even notice me."
    N "没想到有人会注意到我。"

#game/script.rpy:4661
translate chinese jungle_f7b7ac27:

    # N "Least of all her."
    N "更没想到是她。"

#game/script.rpy:4667
translate chinese jungle_37fb6192:

    # a "{font=Cybertron.otf}Yes, they’re heading toward the target. I’ll continue to monitor them."
    a "{font=Cybertron.otf}是的，他们正朝目标去。我会继续监视。"

#game/script.rpy:4682
translate chinese jungle_0061b368:

    # ggg "..."
    ggg "……"

#game/script.rpy:4685
translate chinese jungle_0061b368_1:

    # ggg "..."
    ggg "……"

#game/script.rpy:4691
translate chinese jungle_0ab832c8:

    # gggg "..."
    gggg "……"

#game/script.rpy:4693
translate chinese jungle_bb32c833:

    # ggg "Oh, come on. It’s not {b}that{/b} dramatic."
    ggg "哦得了吧。没{b}那么{/b}戏剧化。"

#game/script.rpy:4695
translate chinese jungle_7e3c33e2:

    # ggg "Still, I didn’t think we’d be the ones cleaning up their mess."
    ggg "不过，没想到是我们来给他们擦屁股。"

#game/script.rpy:4697
translate chinese jungle_6ffd9d86:

    # ggg "But hey, if the roles were reversed, you know they’d do the same."
    ggg "但嘿，要是角色互换，你知道他们也会这么做。"

#game/script.rpy:4699
translate chinese jungle_0ab832c8_1:

    # gggg "..."
    gggg "……"

#game/script.rpy:4701
translate chinese jungle_9cd7cc89:

    # g "Huh, you’re still breathing? Gotta say, I didn’t expect that. No hard feelings, though."
    g "哈，你还在喘气？得说，我没料到。不过别往心里去。"

#game/script.rpy:4715
translate chinese jungle_4b4fa1d0:

    # g "Burns nicely, doesn’t it?"
    g "烧得挺旺，对吧？"

#game/script.rpy:4718
translate chinese jungle_8347309e:

    # aaaa "..."
    aaaa "……"

#game/script.rpy:4720
translate chinese jungle_9841fa25:

    # aaaa "Yes. Everything’s been taken care of. No loose ends."
    aaaa "是的。都处理好了。没有尾巴。"

#game/script.rpy:4722
translate chinese jungle_8347309e_1:

    # aaaa "..."
    aaaa "……"

#game/script.rpy:4724
translate chinese jungle_3d93e914:

    # aaaa "Understood. We’ll stay on them."
    aaaa "明白。我们会盯住他们。"

#game/script.rpy:4726
translate chinese jungle_8e9042d3:

    # s "Remember — eyes only. No contact. No interference. Out."
    s "记住——只用眼睛。不接触。不干涉。完毕。"

#game/script.rpy:4744
translate chinese jungle_ae5bcd24:

    # az "Been a while, darling. Miss me?"
    az "好久不见，亲爱的。想我了吗？"

#game/script.rpy:4746
translate chinese jungle_85018cd8:

    # s "Still better than being you..."
    s "总比变成你强……"

#game/script.rpy:4748
translate chinese jungle_f48dea8b:

    # s "Father."
    s "父亲。"

#game/script.rpy:4767
translate chinese junglenext_9b5d1dbc:

    # h "Hey… [mc]."
    h "嘿……[mc]。"

#game/script.rpy:4768
translate chinese junglenext_69621b8c:

    # h "Why now?"
    h "为什么是现在？"

#game/script.rpy:4769
translate chinese junglenext_ababa309:

    # h "After all this time… why go back?"
    h "都这么久了……干嘛还要回去？"

#game/script.rpy:4770
translate chinese junglenext_b7e04bb3:

    # mc "Because this time there was proof."
    mc "因为这次有证据。"

#game/script.rpy:4771
translate chinese junglenext_d732b893:

    # mc "And because if I ignored it..."
    mc "而且如果我不管……"

#game/script.rpy:4772
translate chinese junglenext_d2db5920:

    # mc "I'd spend whatever's left of my life wondering."
    mc "我余生都会在想这件事。"

#game/script.rpy:4774
translate chinese junglenext_40244502:

    # h "If I were you… I wouldn’t let it get to my head like that."
    h "我要是你……不会让这事这么钻脑子。"

#game/script.rpy:4775
translate chinese junglenext_44fa84c0:

    # mc "Heh."
    mc "嘿。"

#game/script.rpy:4776
translate chinese junglenext_c613da8e:

    # h "No, I mean it, [mc]. Serious."
    h "不，我是认真的，[mc]。说真的。"

#game/script.rpy:4777
translate chinese junglenext_cb89ebe5:

    # h "I get it."
    h "我明白。"

#game/script.rpy:4778
translate chinese junglenext_617784d6:

    # h "Lora meant everything to you."
    h "洛拉对你意味着一切。"

#game/script.rpy:4779
translate chinese junglenext_81343336:

    # h "But it’s been too long."
    h "但已经太久了。"

#game/script.rpy:4783
translate chinese junglenext_bf96f826:

    # h "I’m all for digging up the truth."
    h "我支持挖出真相。"

#game/script.rpy:4784
translate chinese junglenext_0ccd46e0:

    # h "But if this goes sideways…"
    h "但要是出了岔子……"

#game/script.rpy:4785
translate chinese junglenext_d5bbee43:

    # h "(quietly) I don’t wanna see you like you were before."
    h "（低声）我不想再看到你以前那个样子。"

#game/script.rpy:4787
translate chinese junglenext_66fa3968:

    # mc "You won’t."
    mc "不会的。"

#game/script.rpy:4788
translate chinese junglenext_bbed952c:

    # mc "That version of me is gone."
    mc "那个我已经没了。"

#game/script.rpy:4790
translate chinese junglenext_7889da18:

    # mc "…Norman."
    mc "……诺曼。"

#game/script.rpy:4791
translate chinese junglenext_5c4e71e8:

    # mc "How far?"
    mc "还有多远？"

#game/script.rpy:4793
translate chinese junglenext_2292ba39:

    # N "..."
    N "……"

#game/script.rpy:4794
translate chinese junglenext_10252e11:

    # N "...Dad?"
    N "……爸？"

#game/script.rpy:4795
translate chinese junglenext_7cf1923a:

    # mc "Norman?"
    mc "诺曼？"

#game/script.rpy:4796
translate chinese junglenext_b8b14b2c:

    # N "According to the coordinates… we’re there, but—"
    N "按坐标看……我们到了，可是——"

#game/script.rpy:4798
translate chinese junglenext_9cc531bc:

    # N "The lab should be just past those cliffs."
    N "实验室应该就在那些悬崖后面。"

#game/script.rpy:4799
translate chinese junglenext_e1442345:

    # N "I don’t get it…"
    N "我不明白……"

#game/script.rpy:4801
translate chinese junglenext_01539dd0:

    # N "The coordinates are precise…"
    N "坐标很精确……"

#game/script.rpy:4803
translate chinese junglenext_858267f5:

    # N "But there’s nothing here."
    N "但这里什么都没有。"

#game/script.rpy:4805
translate chinese junglenext_850ef128:

    # b "..."
    b "……"

#game/script.rpy:4809
translate chinese junglenext_ddd8ffec:

    # mc "Don’t move."
    mc "别动。"

#game/script.rpy:4811
translate chinese junglenext_12887d89:

    # S "After all this time… and {b}this{/b} is how you say hello?"
    S "都这么久了……你就{b}这么{/b}打招呼？"

#game/script.rpy:4815
translate chinese junglenext_29d95b82:

    # mc "Still hiding in bushes, huh?"
    mc "还躲在灌木丛里，嗯？"

#game/script.rpy:4816
translate chinese junglenext_4717abe5:

    # mc "Some things don’t change."
    mc "有些事永远不会变。"

#game/script.rpy:4818
translate chinese junglenext_23c81f63:

    # S "Guilty as charged. Old habits."
    S "认罪。老习惯。"

#game/script.rpy:4819
translate chinese junglenext_835eef81:

    # S "Still… it’s good to see you again."
    S "不过……再见到你真好。"

#game/script.rpy:4820
translate chinese junglenext_63d3dedb:

    # S "Now, mind lowering the guns? We’re not enemies."
    S "现在，能把枪放下吗？我们不是敌人。"

#game/script.rpy:4823
translate chinese junglenext_507d95fa:

    # mc "Hope so."
    mc "但愿吧。"

#game/script.rpy:4824
translate chinese junglenext_d9aab11f:

    # mc "Fifteen years."
    mc "十五年了。"

#game/script.rpy:4825
translate chinese junglenext_6bd3f7e4:

    # mc "A lot can change."
    mc "很多事都会变。"

#game/script.rpy:4828
translate chinese junglenext_3ec243e2:

    # N "Let me introduce you, Shiya Gray."
    N "我来介绍，诗雅·格雷。"

#game/script.rpy:4829
translate chinese junglenext_44ec6081:

    # N "Senior Sergeant. And… my handler."
    N "高级军士。还有……我的联络人。"

#game/script.rpy:4831
translate chinese junglenext_7a3c3d5b:

    # mc "...Handler?"
    mc "……联络人？"

#game/script.rpy:4833
translate chinese junglenext_6816a4da:

    # S "Yeah. That’s me."
    S "对。就是我。"

#game/script.rpy:4834
translate chinese junglenext_061760bf:

    # mc "You were using my son."
    mc "你在利用我儿子。"

#game/script.rpy:4835
translate chinese junglenext_8ecad07b:

    # S "I was keeping him alive."
    S "我是在保他的命。"

#game/script.rpy:4836
translate chinese junglenext_12cb4e23:

    # S "And before you ask, yes, he was necessary."
    S "在你问之前先说，是的，他必不可少。"

#game/script.rpy:4837
translate chinese junglenext_1e0407bc:

    # S "The coordinates only bring people close."
    S "坐标只能把人带到附近。"

#game/script.rpy:4838
translate chinese junglenext_9729b4aa:

    # S "Without Norman's memory of the old service route, you'd still be walking in circles."
    S "没有诺曼对旧维护道的记忆，你们还在原地打转。"

#game/script.rpy:4840
translate chinese junglenext_34f46930:

    # S "Oh, right..."
    S "哦，对了……"

#game/script.rpy:4841
translate chinese junglenext_5b4d15af:

    # S "Hello, Commander… or should I say {b}former{/b} Commander."
    S "你好，指挥官……还是该说{b}前{/b}指挥官。"

#game/script.rpy:4844
translate chinese junglenext_8b8c5e46:

    # h "...You really haven’t changed."
    h "……你真是一点没变。"

#game/script.rpy:4846
translate chinese junglenext_787351eb:

    # S "Olivia. It’s really good to see you again."
    S "奥利维亚。再见到你真好。"

#game/script.rpy:4848
translate chinese junglenext_1827b8c3:

    # S "Heard you took Alexandro in."
    S "听说你收留了亚历山德罗。"

#game/script.rpy:4850
translate chinese junglenext_ed3d5200:

    # h "Yeah. Someone had to."
    h "是啊。总得有人。"

#game/script.rpy:4854
translate chinese junglenext_7f55bc84:

    # mc "And Richard?"
    mc "理查德呢？"

#game/script.rpy:4855
translate chinese junglenext_2bbcebb8:

    # mc "Still messing with his inventions?"
    mc "还在鼓捣他的发明？"

#game/script.rpy:4857
translate chinese junglenext_ff37d682:

    # S "Father? Lost his mind in his old age, but the army still respects him. So they let his quirks slide."
    S "我爸？老了脑子不好使了，但军队还敬重他。所以由着他那些怪癖。"

#game/script.rpy:4859
translate chinese junglenext_28411d41:

    # h "Sounds like him."
    h "听着就是他。"

#game/script.rpy:4860
translate chinese junglenext_a8a4a433:

    # h "Good to know he’s still kicking."
    h "知道他还在蹦跶就好。"

#game/script.rpy:4862
translate chinese junglenext_66b8d6c1:

    # S "Honestly… when my father asked me to pass that letter on,"
    S "说实话……我爸让我转交那封信的时候，"

#game/script.rpy:4863
translate chinese junglenext_b9572ef8:

    # S "I didn’t think it would actually work."
    S "我没想到真能成。"

#game/script.rpy:4864
translate chinese junglenext_2968952a:

    # S "Nice to see I was wrong."
    S "很高兴我错了。"

#game/script.rpy:4866
translate chinese junglenext_ecae5ccc:

    # S "But... What took you so long?"
    S "不过……你怎么这么久才来？"

#game/script.rpy:4867
translate chinese junglenext_d47dbe7f:

    # S "I was starting to think you’d bailed."
    S "我都开始以为你放鸽子了。"

#game/script.rpy:4869
translate chinese junglenext_7832ee95:

    # N "We were attacked."
    N "我们被袭击了。"

#game/script.rpy:4871
translate chinese junglenext_9c3f50b8:

    # S "Attacked? By who?"
    S "被袭击？谁？"

#game/script.rpy:4874
translate chinese junglenext_ab08fc7c:

    # mc "Azarkhan’s people."
    mc "阿扎尔汗的人。"

#game/script.rpy:4875
translate chinese junglenext_f8e01ab0:

    # mc "No confirmation… but it fits."
    mc "没确认……但说得通。"

#game/script.rpy:4876
translate chinese junglenext_e26382c6:

    # mc "Question is how does it tie back to this place?"
    mc "问题是这和这地方有什么关系？"

#game/script.rpy:4878
translate chinese junglenext_971a98df:

    # S "..."
    S "……"

#game/script.rpy:4880
translate chinese junglenext_0c53c0e9:

    # S "(Whispering) So they finally pointed you at the ship."
    S "（低声）所以他们终于把你引到飞船这来了。"

#game/script.rpy:4882
translate chinese junglenext_350d5b9c:

    # S "Alright. Come with me. It’s time you saw it for yourselves."
    S "好。跟我来。该你们亲眼看看了。"

#game/script.rpy:4883
translate chinese junglenext_1b04d4c9:

    # S "I could explain it."
    S "我可以解释。"

#game/script.rpy:4884
translate chinese junglenext_135d652c:

    # S "But it won’t make sense until you see it."
    S "但不见到它，说了也没用。"

#game/script.rpy:4888
translate chinese junglenext_b4284dfe:

    # N "Understood, ma—"
    N "明白，长——"

#game/script.rpy:4889
translate chinese junglenext_512c9556:

    # S "Don’t call me ma’am. I’m not that old, Norman."
    S "别叫我长官。我没那么老，诺曼。"

#game/script.rpy:4891
translate chinese junglenext_850ef128_1:

    # b "..."
    b "……"

#game/script.rpy:4904
translate chinese spaceship_b6eb03cc:

    # S "Friendly advice, Commander, whatever you’re about to see, don’t freak out."
    S "友好建议，指挥官，不管你接下来看到什么，别慌。"

#game/script.rpy:4905
translate chinese spaceship_b14fad8e:

    # S "It’ll help you keep your sanity a little longer."
    S "能让你多保持一会儿清醒。"

#game/script.rpy:4907
translate chinese spaceship_1b7a36d6:

    # S "Now… look over there."
    S "现在……看那边。"

#game/script.rpy:4909
translate chinese spaceship_7830fcfb:

    # S "I didn’t believe it either."
    S "我当时也不信。"

#game/script.rpy:4910
translate chinese spaceship_e8a29d4b:

    # S "First time I saw it."
    S "第一次看到的时候。"

#game/script.rpy:4912
translate chinese spaceship_eb7eec91:

    # mc "(...what the hell is that?)"
    mc "（……那他妈是什么？）"

#game/script.rpy:4913
translate chinese spaceship_76a5ba94:

    # S "That thing crashed here thousands of years ago."
    S "那东西几千年前坠毁在这儿。"

#game/script.rpy:4915
translate chinese spaceship_43d51cbc:

    # S "It’s the source of every anomaly in this area."
    S "这一带所有异常现象的源头就是它。"

#game/script.rpy:4917
translate chinese spaceship_66a3bbaa:

    # h "...That’s one hell of a leap."
    h "……这跨度也太大了。"

#game/script.rpy:4918
translate chinese spaceship_b7732fbb:

    # h "From {b}Lora went missing{/b} to {b}alien spaceship.{/b}"
    h "从{b}洛拉失踪{/b}跳到{b}外星飞船{/b}。"

#game/script.rpy:4920
translate chinese spaceship_f34b4020:

    # h "Or is it just me?"
    h "还是只有我这么觉得？"

#game/script.rpy:4921
translate chinese spaceship_6925cdda:

    # h "Am I the only one seeing how insane this sounds?"
    h "只有我觉得这听着有多疯吗？"

#game/script.rpy:4923
translate chinese spaceship_555e0ed5:

    # mc "Doesn’t show… but yeah. Same here."
    mc "没表现出来……但没错。我也一样。"

#game/script.rpy:4925
translate chinese spaceship_ed421996:

    # mc "Part of me still thinks this is a joke."
    mc "我有一部分还觉得这是个玩笑。"

#game/script.rpy:4927
translate chinese spaceship_49f720d6:

    # h "How does that even make sense?"
    h "这怎么说得通？"

#game/script.rpy:4928
translate chinese spaceship_0c85fd2d:

    # h "I thought we were alone out here."
    h "我以为就我们在这外面。"

#game/script.rpy:4929
translate chinese spaceship_a518e7b3:

    # h "And now what, we’ve got uninvited guests from space?"
    h "现在怎么着，来了不速之客，还是从太空来的？"

#game/script.rpy:4930
translate chinese spaceship_ee31fb04:

    # h "Great. Love that for us."
    h "好极了。真替我们高兴。"

#game/script.rpy:4932
translate chinese spaceship_a2a19851:

    # mc "(So Norman and Richard weren’t lying…)"
    mc "（所以诺曼和理查德没撒谎……）"

#game/script.rpy:4934
translate chinese spaceship_bf89bfc0:

    # mc "(Lora… what the hell did you get yourself into?)"
    mc "（洛拉……你到底卷进了什么？）"

#game/script.rpy:4937
translate chinese spaceship_3fbf6989:

    # mc "So how does that thing tie to Lora?"
    mc "那这东西和洛拉有什么关系？"

#game/script.rpy:4940
translate chinese spaceship_b3ef1df9:

    # ri "That’s exactly what we’re trying to figure out."
    ri "这正是我们在查的。"

#game/script.rpy:4942
translate chinese spaceship_0fbb6707:

    # ri "Three years ago, we found the ship itself."
    ri "三年前，我们找到了飞船本体。"

#game/script.rpy:4943
translate chinese spaceship_d08ad9ef:

    # ri "Before that, all we had was the old facility above it."
    ri "在那之前，我们只有上面那个旧设施。"

#game/script.rpy:4944
translate chinese spaceship_9cfb1ad7:

    # ri "We thought the lab was the source."
    ri "我们以为实验室就是源头。"

#game/script.rpy:4945
translate chinese spaceship_0859680b:

    # ri "We were wrong."
    ri "我们错了。"

#game/script.rpy:4946
translate chinese spaceship_0b7745ee:

    # ri "The lab was built around this."
    ri "实验室是围着这东西建的。"

#game/script.rpy:4947
translate chinese spaceship_6405ec3b:

    # ri "But the part about you came later."
    ri "但关于你的部分，是后来才出现的。"

#game/script.rpy:4948
translate chinese spaceship_e6c4ffe2:

    # ri "Much later."
    ri "晚得多。"

#game/script.rpy:4949
translate chinese spaceship_36e36bb3:

    # ri "The ship ignored us for years."
    ri "飞船好几年都没理我们。"

#game/script.rpy:4950
translate chinese spaceship_0c4acf06:

    # ri "Only recently did we connect its reaction to what got into your blood in Al-Zahira."
    ri "直到最近，我们才把它有反应和你在阿尔扎希拉血液里进入的东西联系起来。"

#game/script.rpy:4952
translate chinese spaceship_2717a46a:

    # ri "Still… I’m glad you came."
    ri "不过……我很高兴你来了。"

#game/script.rpy:4954
translate chinese spaceship_211a38cd:

    # mc "Let’s just say I didn’t have a reason to say no."
    mc "就当我没有理由拒绝吧。"

#game/script.rpy:4955
translate chinese spaceship_105b349e:

    # mc "But one thing still bugs me."
    mc "但有一件事一直让我在意。"

#game/script.rpy:4956
translate chinese spaceship_5164590e:

    # mc "Why me?"
    mc "为什么是我？"

#game/script.rpy:4958
translate chinese spaceship_991d0569:

    # mc "You’ve got better people."
    mc "你有更好的人手。"

#game/script.rpy:4959
translate chinese spaceship_4c17cf74:

    # mc "More experienced."
    mc "更有经验。"

#game/script.rpy:4960
translate chinese spaceship_19ce78ca:

    # mc "So why me?"
    mc "那为什么是我？"

#game/script.rpy:4962
translate chinese spaceship_d75efcc0:

    # ri "Because you’re the only person still alive who might know anything about this."
    ri "因为你是唯一还活着、可能知道点什么的人。"

#game/script.rpy:4963
translate chinese spaceship_a228c0ee:

    # mc "I'm not seeing the connection."
    mc "我看不出关联。"

#game/script.rpy:4965
translate chinese spaceship_0c65deb4:

    # ri "Al-Zahira. Twenty years ago."
    ri "阿尔扎希拉。二十年前。"

#game/script.rpy:4966
translate chinese spaceship_af80ae99:

    # ri "The bastards who betrayed us were recently found dead in this forest."
    ri "背叛我们的那些混蛋，最近被发现死在这片森林里。"

#game/script.rpy:4967
translate chinese spaceship_5218139c:

    # ri "And on one of their bodies, we found a photograph of your missing wife."
    ri "在其中一具尸体上，我们找到了你失踪妻子的照片。"

#game/script.rpy:4968
translate chinese spaceship_e6629bd7:

    # mc "You said you'd taken care of them."
    mc "你说你处理过他们了。"

#game/script.rpy:4969
translate chinese spaceship_d99935c6:

    # ri "I thought I had."
    ri "我以为处理了。"

#game/script.rpy:4970
translate chinese spaceship_9f7833ba:

    # ri "Turns out I missed a few."
    ri "看来漏了几个。"

#game/script.rpy:4972
translate chinese spaceship_94ca43e5:

    # mc "...Someone was watching us."
    mc "……有人在监视我们。"

#game/script.rpy:4973
translate chinese spaceship_d35f934f:

    # ri "Which means we’re not the only ones looking for you."
    ri "也就是说找你的不只我们。"

#game/script.rpy:4974
translate chinese spaceship_65e4e4f5:

    # mc "You still haven't answered my question, Richard."
    mc "你还是没回答我的问题，理查德。"

#game/script.rpy:4975
translate chinese spaceship_21162a1b:

    # mc "I want the truth."
    mc "我要真相。"

#game/script.rpy:4976
translate chinese spaceship_ab6ddc47:

    # ri "..."
    ri "……"

#game/script.rpy:4977
translate chinese spaceship_77f761b0:

    # ri "After the explosion in Al-Zahira, traces of that substance entered your bloodstream."
    ri "阿尔扎希拉爆炸后，那种物质的痕迹进入了你的血液。"

#game/script.rpy:4978
translate chinese spaceship_76801270:

    # ri "And as we recently discovered..."
    ri "而我们最近发现……"

#game/script.rpy:4979
translate chinese spaceship_089644be:

    # ri "The ship reacts to it."
    ri "飞船会对它起反应。"

#game/script.rpy:4981
translate chinese spaceship_a58b86a6:

    # h "So you dragged them here because the alien coffin blinked at his blood?"
    h "所以你把他们拖来，就因为那个外星棺材对他的血眨了眨眼？"

#game/script.rpy:4983
translate chinese spaceship_53047dd2:

    # ri "Do you know anyone else it reacts to?"
    ri "你知道它还对接下来的谁有反应吗？"

#game/script.rpy:4984
translate chinese spaceship_104dd4ba:

    # ri "Because I don’t."
    ri "反正我不知道。"

#game/script.rpy:4985
translate chinese spaceship_dc12f8b5:

    # ri "Either way..."
    ri "不管怎样……"

#game/script.rpy:4986
translate chinese spaceship_60b6c60a:

    # ri "Look here. We found this... inside."
    ri "看这儿。我们在里面……发现了这个。"

#game/script.rpy:4989
translate chinese spaceship_404c3ccf:

    # mc "...That’s not human."
    mc "……那不是人类。"

#game/script.rpy:4990
translate chinese spaceship_8b909ca4:

    # h "Yeah… that checks out."
    h "是啊……说得通。"

#game/script.rpy:4992
translate chinese spaceship_5639de4b:

    # h "Nope."
    h "不行。"

#game/script.rpy:4993
translate chinese spaceship_da6fe756:

    # h "No way I’m going in there."
    h "我绝不去那里面。"

#game/script.rpy:4994
translate chinese spaceship_f9384a89:

    # h "Not happening."
    h "想都别想。"

#game/script.rpy:4996
translate chinese spaceship_ff6ae2df:

    # mc "No way around it?"
    mc "没别的路？"

#game/script.rpy:4998
translate chinese spaceship_dce3ed76:

    # ri "Daughter, your thoughts?"
    ri "女儿，你怎么看？"

#game/script.rpy:5000
translate chinese spaceship_77d0adcc:

    # S "No. We’ve checked the entire perimeter."
    S "没有。我们查过整个外围。"

#game/script.rpy:5001
translate chinese spaceship_3d17a36e:

    # S "No other entrances."
    S "没有别的入口。"

#game/script.rpy:5002
translate chinese spaceship_f89aedcd:

    # S "We even tried making one, wasted ammo. Nothing worked."
    S "我们甚至试着炸一个出来，浪费子弹。没用。"

#game/script.rpy:5004
translate chinese spaceship_8ad0b165:

    # h "You’re seriously asking us to walk into that?"
    h "你真要我们走进那里面？"

#game/script.rpy:5005
translate chinese spaceship_013d3db8:

    # h "That’s not a mission."
    h "那不是什么任务。"

#game/script.rpy:5006
translate chinese spaceship_65a9b131:

    # h "That’s a death sentence."
    h "那是死刑。"

#game/script.rpy:5008
translate chinese spaceship_994ce6f3:

    # mc "She’s right."
    mc "她说得对。"

#game/script.rpy:5009
translate chinese spaceship_c1fe712a:

    # mc "Right now this sounds like suicide."
    mc "现在听着就是自杀。"

#game/script.rpy:5011
translate chinese spaceship_4644c897:

    # S "Everyone else said the same."
    S "其他人都这么说。"

#game/script.rpy:5013
translate chinese spaceship_47b368f9:

    # h "And honestly?"
    h "说实话？"

#game/script.rpy:5014
translate chinese spaceship_8332938a:

    # h "Can you blame them?"
    h "能怪他们吗？"

#game/script.rpy:5015
translate chinese spaceship_df7e0d95:

    # h "Who the hell would sign up for that?"
    h "谁会愿意签这个？"

#game/script.rpy:5017
translate chinese spaceship_171c53b7:

    # mc "If Lora went in there..."
    mc "如果洛拉进去过……"

#game/script.rpy:5018
translate chinese spaceship_07e0870d:

    # mc "We don't have a better option."
    mc "我们没更好的选择。"

#game/script.rpy:5019
translate chinese spaceship_9ba7d9ad:

    # mc "Getting past those sentries won’t be easy."
    mc "绕过那些哨兵不容易。"

#game/script.rpy:5021
translate chinese spaceship_26c3d0ce:

    # mc "How many people are going in with us?"
    mc "有多少人跟我们一起进去？"

#game/script.rpy:5023
translate chinese spaceship_69aa7629:

    # N "Excuse me, but have you tried going through those huge turbines?"
    N "不好意思，你们试过从那些大涡轮进去吗？"

#game/script.rpy:5025
translate chinese spaceship_22fa8c37:

    # N "They look big enough for a person to fit through."
    N "看着大得能钻进去一个人。"

#game/script.rpy:5027
translate chinese spaceship_877925e0:

    # N "I know it sounds insane — but if there's no other way, maybe it’s worth a shot."
    N "我知道听着疯——但要是没别的路，也许值得一试。"

#game/script.rpy:5029
translate chinese spaceship_2292ba39:

    # N "..."
    N "……"

#game/script.rpy:5030
translate chinese spaceship_15024590:

    # N "It’s a long shot... but it’s something."
    N "希望不大……但总归是个办法。"

#game/script.rpy:5032
translate chinese spaceship_df9d860e:

    # S "Actually... maybe it's not so dumb."
    S "其实……也许没那么蠢。"

#game/script.rpy:5034
translate chinese spaceship_850ef128:

    # b "..."
    b "……"

#game/script.rpy:5036
translate chinese spaceship_d73d52d8:

    # h "Okay."
    h "行。"

#game/script.rpy:5037
translate chinese spaceship_7c35885a:

    # h "I hate it."
    h "我讨厌这主意。"

#game/script.rpy:5038
translate chinese spaceship_10c0b0cf:

    # h "But it’s better than walking through the front door."
    h "但比从正门走强。"

#game/script.rpy:5040
translate chinese spaceship_2b35b6fe:

    # mc "..."
    mc "……"

#game/script.rpy:5041
translate chinese spaceship_c17f3a7e:

    # mc "Richard? What about the others?"
    mc "理查德？其他人呢？"

#game/script.rpy:5042
translate chinese spaceship_10187d56:

    # mc "Or... am I going in alone?"
    mc "还是……我一个人进去？"

#game/script.rpy:5043
translate chinese spaceship_2c9371ea:

    # ri "Shiya and I are coming with you. If we can get inside..."
    ri "诗雅和我跟你一起。只要能进去……"

#game/script.rpy:5044
translate chinese spaceship_c49b1fb9:

    # mc "All right."
    mc "好。"

#game/script.rpy:5050
translate chinese spaceship_2b35b6fe_1:

    # mc "..."
    mc "……"

#game/script.rpy:5052
translate chinese spaceship_c55d9b49:

    # N "Up close… it’s even bigger than I thought."
    N "近距离看……比我想的还大。"

#game/script.rpy:5053
translate chinese spaceship_36546702:

    # N "So how are we getting into those turbines?"
    N "那我们怎么进那些涡轮？"

#game/script.rpy:5055
translate chinese spaceship_d08d4527:

    # ri "We’ll get a ladder."
    ri "去找个梯子。"

#game/script.rpy:5056
translate chinese spaceship_907133dc:

    # ri "After that… we improvise."
    ri "然后……见机行事。"

#game/script.rpy:5058
translate chinese spaceship_716eff36:

    # h "Gotta admit…"
    h "得承认……"

#game/script.rpy:5059
translate chinese spaceship_ec72696f:

    # h "Kid’s got a brain."
    h "这小子有脑子。"

#game/script.rpy:5061
translate chinese spaceship_40ea09f1:

    # h "But you—"
    h "但你——"

#game/script.rpy:5062
translate chinese spaceship_13e21e8d:

    # h "you did it again."
    h "你又来了。"

#game/script.rpy:5064
translate chinese spaceship_91bacd01:

    # h "That look."
    h "那个表情。"

#game/script.rpy:5065
translate chinese spaceship_d5b59ca0:

    # h "Means you’re already halfway lost in your own head."
    h "意思是你的脑子已经飞走一半了。"

#game/script.rpy:5067
translate chinese spaceship_2b35b6fe_2:

    # mc "..."
    mc "……"

#game/script.rpy:5069
translate chinese spaceship_e29caef6:

    # h "Remember?"
    h "记得吗？"

#game/script.rpy:5070
translate chinese spaceship_16dfe01b:

    # h "Talking your head off to some random stranger…"
    h "对着个陌生人絮絮叨叨……"

#game/script.rpy:5071
translate chinese spaceship_2d52ab83:

    # h "Helped back then."
    h "那时候管用。"

#game/script.rpy:5073
translate chinese spaceship_2b35b6fe_3:

    # mc "..."
    mc "……"

#game/script.rpy:5076
translate chinese spaceship_09cb1e1d:

    # mc "Something’s off."
    mc "有点不对劲。"

#game/script.rpy:5077
translate chinese spaceship_3681196a:

    # mc "Tell me, Olivia… you believe in fate?"
    mc "告诉我，奥利维亚……你信命吗？"

#game/script.rpy:5079
translate chinese spaceship_ded5af50:

    # h "After the way we met?"
    h "就我们那相遇方式？"

#game/script.rpy:5080
translate chinese spaceship_72fce240:

    # h "Yeah… I’d say I do."
    h "嗯……我信。"

#game/script.rpy:5082
translate chinese spaceship_2b35b6fe_4:

    # mc "..."
    mc "……"

#game/script.rpy:5084
translate chinese spaceship_96267e9d:

    # mc "What are the odds…"
    mc "有多少概率……"

#game/script.rpy:5085
translate chinese spaceship_641b861d:

    # mc "that out of every planet, this thing crashes on Earth?"
    mc "在所有星球里，这东西偏偏坠在地球？"

#game/script.rpy:5086
translate chinese spaceship_fe562749:

    # mc "That twenty years ago, we stumbled into a deal for something that came from this place?"
    mc "二十年前，我们撞进一笔和这地方有关的交易？"

#game/script.rpy:5088
translate chinese spaceship_56c93102:

    # mc "Out of all the missing people…"
    mc "在所有失踪的人里……"

#game/script.rpy:5089
translate chinese spaceship_46732718:

    # mc "the only thing that turns up is Lora's photo."
    mc "唯一出现的，是洛拉的照片。"

#game/script.rpy:5090
translate chinese spaceship_acec8220:

    # mc "On men who should've died twenty years ago."
    mc "还是在早就该死的那些人身上。"

#game/script.rpy:5092
translate chinese spaceship_d068d739:

    # mc "Then Norman shows up."
    mc "然后诺曼出现了。"

#game/script.rpy:5093
translate chinese spaceship_30e23456:

    # mc "With a letter."
    mc "带着一封信。"

#game/script.rpy:5097
translate chinese spaceship_27ac3d31:

    # ri "...he’s backed by powerful entities."
    ri "……他背后有强大的势力撑腰。"

#game/script.rpy:5098
translate chinese spaceship_38af67a9:

    # ri "Possibly... extraterrestrial."
    ri "可能是……外星势力。"

#game/script.rpy:5101
translate chinese spaceship_30952361:

    # N "It wasn’t my choice… I was led there."
    N "那不是我的选择……我是被引过去的。"

#game/script.rpy:5102
translate chinese spaceship_4f43fca7:

    # N "A man… wearing a black mask."
    N "一个男人……戴着黑面具。"

#game/script.rpy:5105
translate chinese spaceship_eb35cda5:

    # ri "Three years ago, we found this place."
    ri "三年前，我们找到了这个地方。"

#game/script.rpy:5106
translate chinese spaceship_37635e00:

    # ri "Or rather… it let us find it."
    ri "更准确地说……是它让我们找到的。"

#game/script.rpy:5107
translate chinese spaceship_8ae0cdd0:

    # ri "Before that, we only knew about the old facility above it."
    ri "在那之前，我们只知道上面那个旧设施。"

#game/script.rpy:5108
translate chinese spaceship_cdd72476:

    # ri "The ship itself stayed buried. Hidden under our noses."
    ri "飞船本体一直埋着。就在我们眼皮底下藏着。"

#game/script.rpy:5113
translate chinese spaceship_020ebf63:

    # mc "Next day, Azarkhan’s people try to kill us."
    mc "第二天，阿扎尔汗的人就来杀我们。"

#game/script.rpy:5115
translate chinese spaceship_33ac3d71:

    # mc "And I’m supposed to believe that’s coincidence?"
    mc "你指望我相信这是巧合？"

#game/script.rpy:5116
translate chinese spaceship_23cdc4b7:

    # h "Huh…"
    h "哈……"

#game/script.rpy:5118
translate chinese spaceship_2b35b6fe_5:

    # mc "..."
    mc "……"

#game/script.rpy:5120
translate chinese spaceship_4ded8083:

    # h "Never really looked at it like that…"
    h "我还真没这么想过……"

#game/script.rpy:5121
translate chinese spaceship_98455ae8:

    # h "But yeah."
    h "但没错。"

#game/script.rpy:5122
translate chinese spaceship_dc1d1ea9:

    # h "That’s way too many coincidences."
    h "巧合太多了。"

#game/script.rpy:5124
translate chinese spaceship_7ec87a23:

    # h "Feels like someone’s feeding info."
    h "像是有人在喂情报。"

#game/script.rpy:5125
translate chinese spaceship_bfbe08b0:

    # h "Or watching us real close."
    h "或者盯我们盯得很紧。"

#game/script.rpy:5127
translate chinese spaceship_2b35b6fe_6:

    # mc "..."
    mc "……"

#game/script.rpy:5129
translate chinese spaceship_ed237b7a:

    # mc "Stay sharp."
    mc "保持警觉。"

#game/script.rpy:5130
translate chinese spaceship_56dc04e9:

    # mc "Anything can happen."
    mc "什么都可能发生。"

#game/script.rpy:5132
translate chinese spaceship_8bfb7575:

    # h "I’ll try reaching Anya."
    h "我试着联系安雅。"

#game/script.rpy:5133
translate chinese spaceship_52fe7e25:

    # h "There’s gotta be something here that actually works…"
    h "这儿总该有样能用的东西……"

#game/script.rpy:5135
translate chinese spaceship_756c814a:

    # ri "So? Any luck?"
    ri "怎么样？有收获吗？"

#game/script.rpy:5137
translate chinese spaceship_cf36c990:

    # N "Yeah, I found something."
    N "有，我找到点东西。"

#game/script.rpy:5138
translate chinese spaceship_8c8919b0:

    # N "There’s a narrow passage."
    N "有条窄通道。"

#game/script.rpy:5140
translate chinese spaceship_98ae6c0e:

    # N "Go get Dad, I’ll need him for this."
    N "去叫爸，这事需要他。"

#game/script.rpy:5165
translate chinese spaceship_into_9de578b7:

    # N "Alright, if we unscrew these bolts, we can remove—"
    N "好，要是把这些螺栓拧下来，就能拆掉——"

#game/script.rpy:5168
translate chinese spaceship_into_7329681e:

    # E "..."
    E "……"

#game/script.rpy:5169
translate chinese spaceship_into_10522407:

    # h "Seriously?"
    h "认真的？"

#game/script.rpy:5170
translate chinese spaceship_into_b2e3b36f:

    # h "You couldn’t be more careful?"
    h "你就不能小心点？"

#game/script.rpy:5171
translate chinese spaceship_into_62e8067a:

    # mc "Drop it, Olivia."
    mc "别说了，奥利维亚。"

#game/script.rpy:5172
translate chinese spaceship_into_c7ad5c8e:

    # mc "Narrow entry."
    mc "入口窄。"

#game/script.rpy:5173
translate chinese spaceship_into_ee6afbce:

    # mc "Unknown drop."
    mc "不知道有多深。"

#game/script.rpy:5174
translate chinese spaceship_into_a7845461:

    # mc "If something waits below, better it gets one target than all of us."
    mc "要是下面有东西等着，宁可它只抓一个，也别抓我们所有人。"

#game/script.rpy:5175
translate chinese spaceship_into_fe4669f1:

    # h "I hate when your logic makes sense."
    h "我讨厌你的逻辑有道理的时候。"

#game/script.rpy:5178
translate chinese spaceship_into_89f74ab8:

    # h "You being this calm right now?"
    h "你现在这么冷静？"

#game/script.rpy:5179
translate chinese spaceship_into_64d9851e:

    # h "Yeah… that’s not comforting."
    h "是啊……这让人一点都不安心。"

#game/script.rpy:5180
translate chinese spaceship_into_49775c53:

    # mc "I’m going in first."
    mc "我先进去。"

#game/script.rpy:5185
translate chinese spaceship_into_4e6f4ed5:

    # mc "Wait…"
    mc "等等……"

#game/script.rpy:5189
translate chinese spaceship_into_e4f7da9d:

    # mc "Doesn’t look like anyone’s here."
    mc "看着不像有人。"

#game/script.rpy:5191
translate chinese spaceship_into_7fc74da9:

    # h "Then I’m coming with you."
    h "那我跟你一起。"

#game/script.rpy:5193
translate chinese spaceship_into_ecf872dc:

    # mc "Wait."
    mc "等等。"

#game/script.rpy:5194
translate chinese spaceship_into_f2bdc742:

    # mc "I go first."
    mc "我走前面。"

#game/script.rpy:5197
translate chinese spaceship_into_8c02ec34:

    # h "No."
    h "不。"

#game/script.rpy:5198
translate chinese spaceship_into_d38e769c:

    # h "Don’t do that."
    h "别这样。"

#game/script.rpy:5200
translate chinese spaceship_into_e21e8725:

    # h "I’m serious."
    h "我说真的。"

#game/script.rpy:5201
translate chinese spaceship_into_38535c37:

    # h "Don’t go in there alone."
    h "别一个人进去。"

#game/script.rpy:5204
translate chinese spaceship_into_480890f2:

    # mc "I’ll manage."
    mc "我能应付。"

#game/script.rpy:5206
translate chinese spaceship_into_60643364:

    # mc "If I don’t come back…"
    mc "要是我没回来……"

#game/script.rpy:5207
translate chinese spaceship_into_f5149bc1:

    # mc "Don’t follow."
    mc "别跟来。"

#game/script.rpy:5208
translate chinese spaceship_into_e3b834a1:

    # h "...Damn it."
    h "……该死。"

#game/script.rpy:5211
translate chinese spaceship_into_e24e2a22:

    # mc "(Left… or right…?)"
    mc "（左……还是右……？）"

#game/script.rpy:5218
translate chinese path_first_left_2b35b6fe:

    # mc "..."
    mc "……"

#game/script.rpy:5221
translate chinese path_first_left_c2519fb4:

    # mc "(Enough.)"
    mc "（够了。）"

#game/script.rpy:5222
translate chinese path_first_left_91102d0b:

    # mc "(No point wandering blind.)"
    mc "（瞎转没意义。）"

#game/script.rpy:5223
translate chinese path_first_left_d633b518:

    # mc "(Time to bring the others in.)"
    mc "（该把其他人叫进来了。）"

#game/script.rpy:5231
translate chinese path_first_left_next_2_b11013ae:

    # mc "(Too quiet…)"
    mc "（太安静了……）"

#game/script.rpy:5232
translate chinese path_first_left_next_2_d831e8f2:

    # mc "(And that smell…)"
    mc "（还有那股味……）"

#game/script.rpy:5233
translate chinese path_first_left_next_2_05c1bf7d:

    # mc "(Like something’s been rotting here for years.)"
    mc "（像有东西在这儿烂了好多年。）"

#game/script.rpy:5236
translate chinese path_first_left_next_2_2b35b6fe:

    # mc "..."
    mc "……"

#game/script.rpy:5238
translate chinese path_first_left_next_2_395b63a1:

    # mc "(…What the hell happened here?)"
    mc "（……这儿到底出过什么事？）"

#game/script.rpy:5239
translate chinese path_first_left_next_2_4791ec8f:

    # mc "(So that’s the smell…)"
    mc "（原来那股味是……）"

#game/script.rpy:5240
translate chinese path_first_left_next_2_fd8789a9:

    # mc "(Corpses.)"
    mc "（尸体。）"

#game/script.rpy:5247
translate chinese path_first_left_next_2_fca52711:

    # mc "No."
    mc "不。"

#game/script.rpy:5248
translate chinese path_first_left_next_2_3e7f1059:

    # mc "Not going in there."
    mc "不进去。"

#game/script.rpy:5251
translate chinese path_first_left_next_2_c2519fb4:

    # mc "(Enough.)"
    mc "（够了。）"

#game/script.rpy:5252
translate chinese path_first_left_next_2_91102d0b:

    # mc "(No point wandering blind.)"
