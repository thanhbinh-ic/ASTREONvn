#game/script.rpy:3573
translate chinese norman_home_06e622bb:

    # mc "I have."
    mc "我杀过。"

#game/script.rpy:3574
translate chinese norman_home_e4fbadc5:

    # mc "Dozens."
    mc "几十个。"

#game/script.rpy:3575
translate chinese norman_home_d5be2dea:

    # mc "Hundreds."
    mc "上百个。"

#game/script.rpy:3577
translate chinese norman_home_2b35b6fe_5:

    # mc "..."
    mc "……"

#game/script.rpy:3579
translate chinese norman_home_7eee3ca8:

