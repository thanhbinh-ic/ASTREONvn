    h "要是有人提一句这么高，就更好了！"

#game/script.rpy:5354
translate chinese meets11_023f223d:

    # mc "That used to be nothing for you."
    mc "这以前对你不算什么。"

#game/script.rpy:5355
translate chinese meets11_f1d0649a:

    # mc "Getting old?"
    mc "老了？"

