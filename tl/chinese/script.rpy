translate chinese street_14aa9c5f:

    # A "Mina, slow down, honey. Let Grandpa catch his breath first."
    A "米娜，慢点，宝贝。让爷爷先喘口气。"

#game/script.rpy:1501
translate chinese street_0a31f2b7:

    # M "But he doesn’t mind, right Grandpa!? RIGHT??"
    M "但他不介意，对吧爷爷！？对吧？？"

#game/script.rpy:1503
translate chinese street_2af93909:

    # mc "Heh. Course I don’t."
    mc "呵。当然不介意。"

#game/script.rpy:1505
translate chinese street_872d223c:

    # mc "Hold on…"
    mc "等等……"

#game/script.rpy:1506
translate chinese street_7f5bf2ec:

    # mc "Did you get taller, or is that just me?"
    mc "你长高了，还是我的错觉？"

