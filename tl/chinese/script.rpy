#game/script.rpy:5367
translate chinese meets11_7a067387:

    # ri "There has to be a control node somewhere."
    ri "肯定有某个控制节点。"

#game/script.rpy:5368
translate chinese meets11_87ec980e:

    # ri "A recorder. A map. Anything that tells us what happened here."
    ri "记录器。地图。任何能告诉我们这儿出过什么的东西。"

#game/script.rpy:5371
