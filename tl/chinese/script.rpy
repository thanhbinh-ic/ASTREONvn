    N "快到了，大概还有三十分钟！"

#game/script.rpy:1464
translate chinese street_8dbeba44:

    # mc "You driving?"
    mc "你在开车？"

#game/script.rpy:1466
translate chinese street_c8fa6265:

    # N "Yeah, Dad!"
    N "是啊，爸！"

#game/script.rpy:1468
translate chinese street_20b00911:

    # mc "Mina with you?"
    mc "米娜和你在一起吗？"

#game/script.rpy:1470
translate chinese street_2292ba39:

    # N "..."
    N "……"

#game/script.rpy:1471
translate chinese street_876aa200:

    # mc "Then you remember what I told you about using your phone while dri—"
    mc "那你记得我跟你说过开车时用手机——"

