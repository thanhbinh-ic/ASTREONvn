translate chinese shoot_a1c63749:

    # mc "(Can't risk their lives... Better I go alone.)"
    mc "（不能拿他们的命冒险……还是我一个人去。）"

#game/script.rpy:5552
translate chinese shoot_bd07754c:

    # mc "I knew it was big…"
