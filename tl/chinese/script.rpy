#game/script.rpy:3562
translate chinese norman_home_2b35b6fe_4:

    # mc "..."
    mc "……"

#game/script.rpy:3567
translate chinese norman_home_54bd59ed:

    # mc "Let me ask you something."
    mc "我问你一件事。"

#game/script.rpy:3568
translate chinese norman_home_d30fc7ed:

