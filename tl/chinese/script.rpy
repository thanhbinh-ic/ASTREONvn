    # mc "..."
    mc "……"

#game/script.rpy:5517
translate chinese path_front_next2_5e5bd194:

    # mc "You done screaming?"
    mc "叫完了吗？"

#game/script.rpy:5520
translate chinese path_front_next2_d2b4df8b:

    # mc "Time to go."
    mc "该走了。"

#game/script.rpy:5528
