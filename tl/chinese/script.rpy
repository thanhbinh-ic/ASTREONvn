#game/script.rpy:5572
translate chinese shoot_f56bc7ff:

    # mc "(Looks... human.)"
    mc "（看着……像人类的。）"

#game/script.rpy:5573
translate chinese shoot_6e9fd508:

    # mc "(So someone from the old lab made it this far.)"
    mc "（所以旧实验室有人到过这儿。）"

#game/script.rpy:5578
translate chinese shoot_1869e44a:

    # a "Testing... one, two..."
    a "测试……一，二……"

#game/script.rpy:5579
translate chinese shoot_19211c41:

    # a "…Okay. Recording’s on."
    a "……好。录音开了。"

#game/script.rpy:5580
translate chinese shoot_d61fee2b:

    # mc "(Heavy distortion.)"
    mc "（失真很重。）"

#game/script.rpy:5581
translate chinese shoot_e31e1752:

    # mc "(Female voice.)"
    mc "（女声。）"

#game/script.rpy:5582
translate chinese shoot_7c2ba095:

    # mc "(Familiar...?)"
    mc "（熟悉……？）"

#game/script.rpy:5584
translate chinese shoot_fa41836c:

    # a "Tomorrow’s a big day. They’ve entrusted me with something huge... I have to give it my all."
    a "明天是大日子。他们把一件大事交给了我……我必须全力以赴。"

#game/script.rpy:5586
translate chinese shoot_2851935b:

    # a "Day 1: I finally get to work on the new project."
    a "第1天：我终于能开始新项目了。"

#game/script.rpy:5587
translate chinese shoot_5e52375b:

    # a "…I’ve been waiting for this."
    a "……我等这个很久了。"

#game/script.rpy:5590
translate chinese shoot_039341e8:

    # a "Day 7: I thought I’d record more often, but there’s too much work..."
    a "第7天：本来想多录几次，但工作太多了……"

#game/script.rpy:5591
translate chinese shoot_9be8aec8:

    # a "We stabilized the substance today."
    a "我们今天把那种物质稳定下来了。"

#game/script.rpy:5592
translate chinese shoot_6bfedc99:

    # a "…It’s incredible."
    a "……太不可思议了。"

#game/script.rpy:5594
translate chinese shoot_1e816cc6:

    # a "Day 13: A breakthrough."
    a "第13天：重大突破。"

#game/script.rpy:5595
translate chinese shoot_2dd9befb:

    # a "The properties of this substance are…"
    a "这种物质的性质……"

#game/script.rpy:5596
translate chinese shoot_e108fc81:

    # a "…beyond anything I’ve seen."
    a "……超出我见过的一切。"

#game/script.rpy:5597
translate chinese shoot_fe6ed374:

    # mc "(No...)"
    mc "（不……）"

#game/script.rpy:5598
translate chinese shoot_457ef512:

    # mc "(That cadence.)"
    mc "（那个语调。）"

#game/script.rpy:5599
translate chinese shoot_737c6cdb:

    # mc "(I know that voice.)"
    mc "（我认得那个声音。）"

#game/script.rpy:5603
translate chinese shoot_45b59d65:

    # a "Day 22: For some strange reason… the liquid began turning into blood."
    a "第22天：不知为何……液体开始变成血。"

#game/script.rpy:5604
translate chinese shoot_345bbe19:

    # a "…Or something like it."
    a "……或者类似血的东西。"

#game/script.rpy:5605
translate chinese shoot_603db4e5:

    # a "I don’t like this."
    a "我不喜欢这样。"

#game/script.rpy:5608
translate chinese shoot_775b5040:

    # a "Day 37: The blood started being absorbed into the device…"
    a "第37天：血开始被装置吸收……"

#game/script.rpy:5609
translate chinese shoot_a47cf049:

    # a "…And I feel it."
    a "……我感觉得到。"

#game/script.rpy:5610
translate chinese shoot_844428ba:

    # a "Like something’s draining me."
    a "像有什么在抽干我。"

#game/script.rpy:5612
translate chinese shoot_4e6f4ed5_1:

    # mc "Wait…"
    mc "等等……"

#game/script.rpy:5616
translate chinese shoot_08998072:

    # N "It feeds… whatever’s inside."
    N "它在喂养……里面的东西。"

#game/script.rpy:5625
translate chinese shoot_9da6364c:

    # mc "(…Warp drive.)"
    mc "（……曲速引擎。）"

#game/script.rpy:5626
translate chinese shoot_5aeb54cf:

    # mc "(Norman said that before…)"
    mc "（诺曼之前说过……）"

#game/script.rpy:5629
translate chinese shoot_7158aaa8:

    # mc "(Don’t tell me this is the same thing…)"
    mc "（别告诉我这是同一个东西……）"

#game/script.rpy:5633
translate chinese shoot_3b9b4df8:

    # a "Day 49: Scientists are collapsing from exhaustion."
    a "第49天：科学家们一个个累倒了。"

#game/script.rpy:5634
translate chinese shoot_60bc8484:

    # a "The ring… doesn’t stop."
    a "那枚戒指……不停。"

#game/script.rpy:5636
translate chinese shoot_7ae16f47:

    # a "Day 53: It’s affecting us."
    a "第53天：它在影响我们。"

#game/script.rpy:5637
translate chinese shoot_74a08773:

    # a "We didn’t anticipate this."
    a "我们没料到会这样。"

#game/script.rpy:5641
translate chinese shoot_7ec233db:

    # mc "Something’s wrong…"
    mc "有点不对劲……"

#game/script.rpy:5643
translate chinese shoot_f0c90342:

    # mc "This is…"
    mc "这是……"

#game/script.rpy:5648
translate chinese shoot_16493360:

    # a "Day 61: No, no, no—!"
    a "第61天：不，不，不——！"

#game/script.rpy:5649
translate chinese shoot_96f86356:

    # a "What have we done…?!"
    a "我们都干了什么……？！"

#game/script.rpy:5650
translate chinese shoot_c54c55d7:

    # a "It’s absorbing human bodies now!"
    a "它现在开始吸收人体了！"

#game/script.rpy:5651
translate chinese shoot_8c89c468:

    # a "We have to destroy it, before it’s too late!"
    a "必须毁了它，趁还来得及！"

#game/script.rpy:5653
translate chinese shoot_b7d98b99:

    # a "Day 62: Everyone’s gone."
    a "第62天：所有人都没了。"

#game/script.rpy:5654
translate chinese shoot_f6422714:

    # a "…I’m the only one left."
    a "……只剩我一个了。"

#game/script.rpy:5655
translate chinese shoot_2b6148b3:

    # a "The exit’s sealed."
    a "出口被封死了。"

#game/script.rpy:5656
translate chinese shoot_45e3209a:

    # a "I tried contacting HQ, nothing."
    a "我试着联系总部，毫无回应。"

    #game/script.rpy:5658
translate chinese shoot_48ba61a0:

    # a "No matter what it takes…"
    a "无论付出什么代价……"

#game/script.rpy:5659
translate chinese shoot_f6a91c8a:

    # a "I have to preserve this."
    a "我都必须保住它。"

#game/script.rpy:5660
translate chinese shoot_29a38e1a:

    # a "…I promised."
    a "……我答应过的。"

#game/script.rpy:5662
translate chinese shoot_0990d699:

    # a "Day 63: I’m… still alive."
    a "第63天：我……还活着。"

    #game/script.rpy:5663
translate chinese shoot_ebcb19dc:

    # a "Somehow, everything’s back to normal."
    a "不知怎的，一切都恢复了正常。"

#game/script.rpy:5664
translate chinese shoot_4455f38d:

    # a "The ring stopped absorbing blood."
    a "那枚戒指不再吸收血液了。"

#game/script.rpy:5665
translate chinese shoot_538acc5d:

    # a "…Like it had enough."
    a "……像是已经吸够了。"

#game/script.rpy:5666
translate chinese shoot_2d47f7f1:

    # a "It runs on it."
    a "它靠血运转。"

#game/script.rpy:5667
translate chinese shoot_9eddee22:

    # a "Blood is the energy source."
    a "血液就是它的能量来源。"

    #game/script.rpy:5670
translate chinese shoot_4ec62757:

    # a "Day 64: Something came out of the ring…"
    a "戒指里出来了什么东西……"

#game/script.rpy:5671
translate chinese shoot_af357d43:

    # a "Creatures."
    a "是生物"

#game/script.rpy:5672
translate chinese shoot_1f810c09:

    # a "They look… human."
    a "它们看起来……像人。"

#game/script.rpy:5673
translate chinese shoot_55b5ee40:

    # a "But they’re not."
    a "但它们不是。"

    #game/script.rpy:5674
translate chinese shoot_1baa0837:

    # a "What the hell is going on…?"
    a "到底他妈怎么回事……？"

#game/script.rpy:5676
translate chinese shoot_21e6c640:

    # a "I’m hiding in the lab."
    a "我躲在实验室里。"

#game/script.rpy:5677
translate chinese shoot_3256bcd7:

    # a "…Please don’t see me."
    a "……求求你们，别看见我。"

#game/script.rpy:5678
translate chinese shoot_208d4073:

    # a "Note: They speak some kind of language."
    a "备注：它们会说某种语言。"

    #game/script.rpy:5680
translate chinese shoot_5a6cd50c:

    # a "Oh no…"
    a "哦不……"

#game/script.rpy:5681
translate chinese shoot_78a29771:

    # a "They saw me."
    a "它们看见我了。"

#game/script.rpy:5682
translate chinese shoot_eea29a51:

    # a "Looks like this is it…"
    a "看来就到这儿了……"

#game/script.rpy:5683
translate chinese shoot_d5b0e30f:

    # a "I couldn’t keep my promise…"
    a "我没能守住承诺……"

#game/script.rpy:5684
translate chinese shoot_c257736d:

    # a "I’m sorry."
    a "对不起。"

#game/script.rpy:5685
translate chinese shoot_eea62b18:

    # a "…I really tried."
    a "……我真的尽力了。"

#game/script.rpy:5686
