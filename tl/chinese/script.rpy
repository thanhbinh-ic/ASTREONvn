    # mc "You can still walk away."
    mc "你现在回头还来得及。"

#game/script.rpy:3626
translate chinese norman_home_b405385e:

    # N "No!"
    N "不！"

#game/script.rpy:3627
translate chinese norman_home_c430cda6:

    # N "I’ll do whatever it takes. I promise."
    N "我什么都愿意做。我保证。"

