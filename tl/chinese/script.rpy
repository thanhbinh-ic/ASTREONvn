translate chinese path_front_next2_23930bef:

    # mc "(Maybe it’s nothing…)"
    mc "（也许没什么……）"

#game/script.rpy:5487
translate chinese path_front_next2_791a86a9:

    # mc "(Just a body.)"
    mc "（就是一具尸体。）"

#game/script.rpy:5490
