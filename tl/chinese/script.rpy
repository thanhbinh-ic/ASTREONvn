    # mc "Still look good."
    mc "还是那么好看。"

#game/script.rpy:1523
translate chinese street_929ba32e:

    # A "Aw, thank you. You always know how to make an old woman smile."
    A "哎呀，谢谢。你总是知道怎么让老太太开心。"

#game/script.rpy:1524
translate chinese street_6dafcfc0:

