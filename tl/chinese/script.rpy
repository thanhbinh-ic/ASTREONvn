#game/script.rpy:3599
translate chinese norman_home_5fb7a3fa:

    # N "I thought you'd go without me."
    N "我以为你会自己走。"

#game/script.rpy:3601
translate chinese norman_home_2b35b6fe_6:

    # mc "..."
    mc "……"

#game/script.rpy:3603
translate chinese norman_home_8bf8f8f0:

    # mc "You sure about this?"
    mc "你确定？"

#game/script.rpy:3605
