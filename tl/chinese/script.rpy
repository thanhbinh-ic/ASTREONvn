    # A "We’re all really happy to see you, you know. Mina’s been counting the days."
    A "我们都很高兴见到你。米娜一直在数日子。"

#game/script.rpy:1529
translate chinese street_965debdf:

    # mc "How’ve you been?"
    mc "你过得怎么样？"

#game/script.rpy:1530
translate chinese street_1fbb6c79:

    # mc "Everything holding up?"
    mc "一切都还好吗？"

#game/script.rpy:1532
translate chinese street_aea6b9b0:

    # A "Doing great."
    A "挺好的。"

#game/script.rpy:1533
translate chinese street_402d4e0f:

    # A "Mina keeps me busy, and I’m teaching at that private school downtown."
    A "米娜让我忙得团团转，我在市中心那所私立学校教书。"

#game/script.rpy:1534
translate chinese street_d33a813c:

    # A "It’s steady, nothing to complain about."
    A "很稳定，没什么好抱怨的。"

#game/script.rpy:1536
translate chinese street_524f7d99:

    # A "And how about you? How are you doing? Anything new on your end?"
    A "你呢？你怎么样？有什么新鲜事吗？"

#game/script.rpy:1538
translate chinese street_1a38c31f:

    # mc "Same old."
    mc "老样子。"

#game/script.rpy:1539
translate chinese street_e7438c59:

    # mc "Nothing worth talking about."
    mc "没什么好说的。"

#game/script.rpy:1540
translate chinese street_29067f4e:

    # mc "Just keeping things running."
    mc "就是维持运转。"

#game/script.rpy:1542
translate chinese street_08d382c9:

    # mc "Trying not to drop dead just yet."
    mc "尽量还没倒下。"

#game/script.rpy:1544
translate chinese street_82754c37:

    # A "Oh, don’t say things like that!"
    A "哦，别这么说！"

#game/script.rpy:1545
translate chinese street_5a13c908:

    # A "You’re still in your prime, full of life and energy."
    A "你还在壮年，充满活力和能量。"

#game/script.rpy:1547
