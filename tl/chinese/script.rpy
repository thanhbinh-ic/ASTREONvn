    # Lor "I’m sorry, [mc]…"
    Lor "对不起，[mc]……"

#game/script.rpy:5689
translate chinese shoot_4e6f4ed5_2:

    # mc "Wait…"
    mc "等等……"

#game/script.rpy:5690
translate chinese shoot_16411555:

    # mc "(No.)"
    mc "（不。）"

#game/script.rpy:5691
translate chinese shoot_69c085be:

    # mc "(Lora?)"
    mc "（洛拉？）"

#game/script.rpy:5692
translate chinese shoot_fc935205:

    # mc "That was her?"
    mc "那是她？"

#game/script.rpy:5693
translate chinese shoot_ad1952c9:

    # mc "But her voice... different?"
    mc "可她的声音……不一样？"

#game/script.rpy:5701
translate chinese shoot_52dcb2fa:

    # mc "What the hell…?"
    mc "搞什么鬼……？"

#game/script.rpy:5702
translate chinese shoot_56123d66:

    # mc "What’s happening?"
    mc "发生什么了？"

#game/script.rpy:5703
translate chinese shoot_84340931:

    # aa "{font=Cybertron.otf} You shouldn't be here. Not yet."
    aa "{font=Cybertron.otf} 你不该在这里。还不是时候。"

#game/script.rpy:5706
translate chinese shoot_bb8e4b4e:

    # a "..."
    a "……"

#game/script.rpy:5714
translate chinese shoot_e44fc035:

    # mc "AAAAAAAAAAA"
    mc "啊啊啊啊啊啊啊啊啊"

#game/script.rpy:5721
translate chinese shoot_00a94815:

    # mc "No {w=0.4}no {w=0.3}no {w=0.2}no {w=0.1}no..."
    mc "不 {w=0.4}不 {w=0.3}不 {w=0.2}不 {w=0.1}不……"

#game/script.rpy:5731
translate chinese shoot_2a8934f4:

    # mc "What’s happening to me?!"
    mc "我这是怎么了？！"

#game/script.rpy:5740
translate chinese shoot_d9b1a753:

    # mc "Whose memories… were those?"
    mc "那些记忆……是谁的？"

#game/script.rpy:5750
translate chinese shoot_5ab03d0d:

    # mc "What just…"
    mc "刚刚那到底……"

#game/script.rpy:5751
translate chinese shoot_aa4858dd:

    # mc "I was…"
    mc "我明明……"

#game/script.rpy:5754
translate chinese shoot_ce47beaa:

    # mc "I need to get out. Now!"
    mc "我得出去。现在！"

#game/script.rpy:5757
translate chinese shoot_93d837b3:

    # mc "Everyone okay?"
    mc "大家没事吧？"

#game/script.rpy:5758
translate chinese shoot_56b75e49:

    # mc "We need to leave."
    mc "我们得走了。"

#game/script.rpy:5759
translate chinese shoot_81057b31:

    # mc "Now."
    mc "现在。"

#game/script.rpy:5760
translate chinese shoot_7ee61c25:

    # mc "This place…"
    mc "这地方……"

#game/script.rpy:5761
translate chinese shoot_2760bc56:

    # mc "The blood… the ring…"
    mc "那些血……那枚戒指……"

#game/script.rpy:5762
translate chinese shoot_9c3fcb80:

    # mc "It opens something."
    mc "它打开了什么东西。"

#game/script.rpy:5763
translate chinese shoot_0701f667:

    # mc "A passage, maybe."
    mc "也许是条通道。"

#game/script.rpy:5764
translate chinese shoot_e6dc6b77:

    # mc "A portal— I don't know."
    mc "一道传送门——我不知道。"

#game/script.rpy:5766
translate chinese shoot_db04a3c8:

    # h "Hey—"
    h "嘿——"

#game/script.rpy:5767
translate chinese shoot_acc02403:

    # h "Slow down."
    h "慢点。"

#game/script.rpy:5768
translate chinese shoot_5510feff:

    # h "What are you even saying?"
    h "你到底在说什么？"

#game/script.rpy:5769
translate chinese shoot_3efab157:

    # h "Talk to me."
    h "跟我说清楚。"

#game/script.rpy:5771
translate chinese shoot_292466a6:

    # mc "Answers…"
    mc "答案……"

#game/script.rpy:5772
translate chinese shoot_9af72321:

    # mc "To everything."
    mc "一切的答案。"

#game/script.rpy:5774
translate chinese shoot_5f6494c0:

    # h "...Alright."
    h "……好吧。"

#game/script.rpy:5775
translate chinese shoot_6a3be195:

    # h "Start from the beginning."
    h "从头说起。"

#game/script.rpy:5777
translate chinese shoot_d366ba25:

    # mc "The door opened…"
    mc "那扇门开了……"

#game/script.rpy:5778
translate chinese shoot_3e3e0167:

    # mc "I went in…"
    mc "我走了进去……"

#game/script.rpy:5779
translate chinese shoot_b141a900:

    # mc "Lora…"
    mc "洛拉……"

#game/script.rpy:5780
translate chinese shoot_842835e5:

    # mc "She recorded it…"
    mc "她把它录下来了……"

#game/script.rpy:5782
translate chinese shoot_ded5b71d:

    # S "You sure about this? You were gone five minutes. All that happened in five minutes?"
    S "你确定？你才走了五分钟。这些全是五分钟里发生的？"

#game/script.rpy:5784
translate chinese shoot_64685971:

    # mc "Wait — what?! No, I was in there much longer... Let me just find the recording—"
    mc "等等——什么？！不，我在里面待了久得多……让我把录像找出来——"

#game/script.rpy:5785
translate chinese shoot_c98c31f2:

    # mc "Where is it?!"
    mc "在哪儿？！"

#game/script.rpy:5786
translate chinese shoot_a7899af6:

    # mc "It was in my hand."
    mc "刚才就在我手里。"

#game/script.rpy:5787
translate chinese shoot_a7835d0b:

    # mc "I know it was."
    mc "我确定就在。"

#game/script.rpy:5788
translate chinese shoot_850ef128:

    # b "..."
    b "……"

#game/script.rpy:5790
translate chinese shoot_b367f90e:

    # h "You sure this wasn’t all in your head?"
    h "你确定这不是你脑子里的幻觉？"

#game/script.rpy:5792
translate chinese shoot_b46dc5f5:

    # mc "You think I’m lying?"
    mc "你觉得我在撒谎？"

#game/script.rpy:5794
translate chinese shoot_850ef128_1:

    # b "..."
    b "……"

#game/script.rpy:5796
translate chinese shoot_d54f06ce:

    # h "Hey— I didn’t say that."
    h "嘿——我没那么说。"

#game/script.rpy:5797
translate chinese shoot_9a3f88e4:

    # h "Just trying to figure out what the hell happened to you."
    h "我只是想弄明白你到底出了什么事。"

#game/script.rpy:5799
translate chinese shoot_1ccea8f5:

    # S "Let’s set this aside. Did you find the opener?"
    S "先放一边。你找到开启器了吗？"

#game/script.rpy:5801
translate chinese shoot_5098a1dc:

    # mc "Not sure if this is it…"
    mc "不确定是不是这个……"

#game/script.rpy:5805
translate chinese shoot_2acd32c0:

    # mc "I found it on a corpse…"
    mc "我在一具尸体上找到的……"

#game/script.rpy:5806
translate chinese shoot_89722d59:

    # mc "It started screaming."
    mc "它开始尖叫。"

#game/script.rpy:5808
translate chinese shoot_7ac18067:

    # h "...Okay."
    h "……好吧。"

#game/script.rpy:5809
translate chinese shoot_84081136:

    # h "Yeah."
    h "行。"

#game/script.rpy:5810
translate chinese shoot_64c8b303:

    # h "I really don’t like this."
    h "我真的很不喜欢这感觉。"

#game/script.rpy:5812
translate chinese shoot_cfa4ae8a:

    # S "What?"
    S "什么？"

#game/script.rpy:5814
translate chinese shoot_9f642686:

    # mc "I’m not joking."
    mc "我没开玩笑。"

#game/script.rpy:5815
translate chinese shoot_839407e9:

    # mc "I saw it."
    mc "我亲眼看见了。"

#game/script.rpy:5816
translate chinese shoot_971a98df:

    # S "..."
    S "……"

#game/script.rpy:5818
translate chinese shoot_afa2bd6c:

    # S "You and your jokes, Commander..."
    S "你和你那堆玩笑，指挥官……"

#game/script.rpy:5820
translate chinese shoot_8b93c0d3:

    # mc "I’m not joking! I saw it!"
    mc "我没开玩笑！我看见了！"

#game/script.rpy:5821
translate chinese shoot_e4838bf3:

    # S "Whatever it was, call Dad and Norman over."
    S "不管那是什么，把老爸和诺曼叫过来。"

#game/script.rpy:5822
translate chinese shoot_b6d5cd82:

    # S "I don’t want to stay here another second."
    S "我一秒都不想再待在这儿了。"

#game/script.rpy:5824
translate chinese shoot_63291757:

    # ri "No need, we heard the screaming and came to check on you."
    ri "不用叫，我们听见尖叫就过来看你们了。"

#game/script.rpy:5826
translate chinese shoot_500885c2:

    # ri "You alright?"
    ri "你们没事吧？"

#game/script.rpy:5828
translate chinese shoot_6a5cb14f:

    # mc "I honestly don’t know anymore..."
    mc "说实话，我已经不知道了……"

#game/script.rpy:5830
translate chinese shoot_7506f11e:

    # ri "Did you learn anything?"
    ri "有查到什么吗？"

#game/script.rpy:5832
translate chinese shoot_0faa46ad:

    # mc "Yeah…"
    mc "有……"

#game/script.rpy:5833
translate chinese shoot_1178a756:

    # mc "They used blood."
    mc "他们用血。"

#game/script.rpy:5834
translate chinese shoot_a16ab9bb:

    # mc "As fuel."
    mc "当燃料。"

#game/script.rpy:5835
translate chinese shoot_6b4b2da9:

    # mc "The team…"
    mc "那支小队……"

#game/script.rpy:5836
translate chinese shoot_de8de8ab:

    # mc "They’re gone."
    mc "他们没了。"

#game/script.rpy:5837
translate chinese shoot_c8f54139:

    # mc "Fed into that thing…"
    mc "被喂进了那东西……"

#game/script.rpy:5838
translate chinese shoot_0d0e67ad:

    # mc "A ring…"
    mc "一枚戒指……"

#game/script.rpy:5839
translate chinese shoot_ff7cf18c:

    # mc "Some kind of portal…"
    mc "某种传送门……"

#game/script.rpy:5841
translate chinese shoot_60ebaaf6:

    # mc "I think…"
    mc "我想……"

#game/script.rpy:5842
translate chinese shoot_d53dad9d:

    # mc "I don’t even know anymore."
    mc "我已经不知道了。"

#game/script.rpy:5844
translate chinese shoot_0e3c5a9e:

    # ri "Whatever it was, it explains a lot..."
    ri "不管那是什么，都能解释很多事……"

#game/script.rpy:5845
translate chinese shoot_0a2cbeac:

    # ri "Wait — energy?"
    ri "等等——能量？"

#game/script.rpy:5847
translate chinese shoot_47b4f486:

    # ri "Blood…?"
    ri "血液……？"

#game/script.rpy:5848
translate chinese shoot_8aae21be:

    # ri "As fuel…?"
    ri "当燃料……？"

#game/script.rpy:5849
translate chinese shoot_db2f7ead:

    # ri "That matches the readings."
    ri "这和读数吻合。"

#game/script.rpy:5850
translate chinese shoot_8212dc02:

    # ri "Not the method. God, not the method..."
    ri "不是方法。天哪，不是这种方法……"

#game/script.rpy:5852
translate chinese shoot_89e316b8:

    # S "Please, stop. The more you talk, the worse I feel being here."
    S "拜托，别说了。你们越说我越觉得待在这儿难受。"

#game/script.rpy:5854
translate chinese shoot_d3cdbd87:

    # S "Save the chatter for later. Focus on what we can deal with."
    S "闲聊留到以后。先管我们能处理的事。"

#game/script.rpy:5868
translate chinese spaceship_door_2b35b6fe:

    # mc "..."
    mc "……"

#game/script.rpy:5870
translate chinese spaceship_door_2b35b6fe_1:

    # mc "..."
    mc "……"

#game/script.rpy:5873
translate chinese spaceship_door_2b35b6fe_2:

    # mc "..."
    mc "……"

#game/script.rpy:5875
translate chinese spaceship_door_519f2ceb:

    # h "Why’d you freeze?"
    h "你怎么愣住了？"

#game/script.rpy:5876
translate chinese spaceship_door_f882d124:

    # h "You see something?"
    h "看到什么了？"

#game/script.rpy:5878
translate chinese spaceship_door_cf1adef2:

    # mc "Yeah."
    mc "嗯。"

#game/script.rpy:5879
translate chinese spaceship_door_539fce37:

    # mc "Up ahead."
    mc "前面。"

#game/script.rpy:5880
translate chinese spaceship_door_a738fa7c:

    # mc "That thing…"
    mc "那东西……"

#game/script.rpy:5881
translate chinese spaceship_door_e0d3842e:

    # mc "We’re not walking into it blind."
    mc "我们不能两眼一抹黑往里闯。"

#game/script.rpy:5882
translate chinese spaceship_door_a6872da4:

    # h "Yeah, that’s reason enough to stop."
    h "是啊，光这个理由就够我们停下了。"

#game/script.rpy:5883
translate chinese spaceship_door_a9491183:

    # h "So what’s the play?"
    h "那怎么办？"

#game/script.rpy:5884
translate chinese spaceship_door_6ffcd384:

    # mc "Thinking."
    mc "在想。"

#game/script.rpy:5886
translate chinese spaceship_door_cbb521bc:

    # mc "We need a way past."
    mc "我们得找条路过去。"

#game/script.rpy:5887
translate chinese spaceship_door_2467555d:

    # mc "No noise. No mess."
    mc "不弄出声。不留痕迹。"

#game/script.rpy:5889
translate chinese spaceship_door_063c313a:

    # h "We could try sneaking."
    h "可以试试潜行。"

#game/script.rpy:5890
translate chinese spaceship_door_56fdf956:

    # h "Risky as hell, but doable if we keep it clean."
    h "风险大得要命，但只要干净利落就能成。"

#game/script.rpy:5892
translate chinese spaceship_door_2bb82634:

    # mc "That’s a gamble."
    mc "那是在赌。"

#game/script.rpy:5893
translate chinese spaceship_door_4c87d75c:

    # mc "If it’s automated — one mistake and we’re dead."
    mc "如果是自动的——一个失误我们就完了。"

#game/script.rpy:5894
translate chinese spaceship_door_f44add22:

    # mc "I need better than ‘maybe’."
    mc "我要的不只是‘也许行’。"

#game/script.rpy:5896
translate chinese spaceship_door_b010c501:

    # S "Why not just blow the damn thing to pieces? One well-placed boom, and we’re golden."
    S "干嘛不直接把这鬼东西炸成渣？放一发准的，我们就稳了。"

#game/script.rpy:5898
translate chinese spaceship_door_fbba889c:

    # h "Honestly?"
    h "说实话？"

#game/script.rpy:5899
translate chinese spaceship_door_3c451c25:

    # h "Best idea I’ve heard all day."
    h "今天听到的最好的主意。"

#game/script.rpy:5901
translate chinese spaceship_door_9425884e:

    # mc "Unless you’ve got a warhead in your pocket, we’re outgunned."
    mc "除非你兜里揣着弹头，不然我们火力不够。"

#game/script.rpy:5903
translate chinese spaceship_door_f76bc0a4:

    # S "Relax. I’ve got a little something tucked away for emergencies like this… Hold up…"
    S "放松。这种紧急情况我藏了点小玩意……等等……"

#game/script.rpy:5906
translate chinese spaceship_door_29878d4c:

    # S "C4."
    S "C4。"

#game/script.rpy:5907
translate chinese spaceship_door_7d320da1:

    # S "If we place it right… it’ll take it down."
    S "放对位置……就能把它放倒。"

#game/script.rpy:5909
translate chinese spaceship_door_eb25214c:

    # h "...Okay, that might actually work."
    h "……行，这也许真能成。"

#game/script.rpy:5910
translate chinese spaceship_door_67aec647:

    # h "But where the hell did you get that?"
    h "可你他妈从哪儿弄来的？"

#game/script.rpy:5912
translate chinese spaceship_door_d6179a79:

    # S "That’s not your concern."
    S "不关你的事。"

#game/script.rpy:5914
translate chinese spaceship_door_2fded262:

    # h "..."
    h "……"

#game/script.rpy:5916
translate chinese spaceship_door_347625f9:

    # h "...Right."
    h "……行吧。"

#game/script.rpy:5922
translate chinese spaceship_door_fab11858:

    # ri "We don’t have much time. I’ll handle it."
    ri "我们时间不多了。我来处理。"

#game/script.rpy:5924
translate chinese spaceship_door_7e4ef3b4:

    # S "What are you doing, pa?! That thing could—"
    S "爸，你在干嘛？！那东西可能会——"

#game/script.rpy:5926
translate chinese spaceship_door_87ccd9b8:

    # ri "Don’t worry. I’ve dealt with one before, with Norman."
    ri "别担心。我和诺曼以前对付过一个。"

#game/script.rpy:5927
translate chinese spaceship_door_c21f9010:

    # ri "It reacts to posture."
    ri "它对姿态有反应。"

#game/script.rpy:5928
translate chinese spaceship_door_d647f76f:

    # ri "Weapons up threat."
    ri "武器抬起，视为威胁。"

#game/script.rpy:5929
translate chinese spaceship_door_4aedfed4:

    # ri "Hands down passage."
    ri "手放下，放行。"

#game/script.rpy:5930
translate chinese spaceship_door_be2c7a2d:

    # ri "At least, that's how it worked last time."
    ri "至少上次是这么运作的。"

#game/script.rpy:5932
translate chinese spaceship_door_5460e4d1:

    # ri "As long as we avoid the sensors, we’re good."
    ri "只要避开传感器，就没事。"

#game/script.rpy:5934
translate chinese spaceship_door_bc98ef97:

    # h "Yeah, I think we can safely rule out ‘not dangerous’."
    h "是啊，我觉得可以排除‘不危险’这个选项了。"

#game/script.rpy:5935
translate chinese spaceship_door_688506de:

    # h "Richard’s out there running field tests with his face."
    h "理查德正拿自己的脸在外面做实地测试呢。"

#game/script.rpy:5937
translate chinese spaceship_door_5e129e6a:

    # S "Guess we don’t need the C4 after all. Thanks, Dad. Really cleared things up for us."
    S "看来我们用不着 C4 了。谢了，老爸。真是帮我们理清思路了。"

#game/script.rpy:5940
translate chinese spaceship_door_ac7bccb2:

    # S "Hey, Dad? Maybe don’t push any more buttons on that murder machine. Just a thought."
    S "嘿，老爸？也许别再按那台杀人机器上的按钮了。随便提一句。"

#game/script.rpy:5943
translate chinese spaceship_door_a42ec2b9:

    # S "Last thing we need is it waking up in a bad mood."
    S "我们最不需要的就是它起床气发作。"

#game/script.rpy:5946
translate chinese spaceship_door_63f30d0c:

    # ri "You worry too much. Trust me."
    ri "你操心太多了。相信我。"

#game/script.rpy:5948
translate chinese spaceship_door_0a9756c2:

    # ri "I’m sure I’ve got it under control."
    ri "我肯定能控制住。"

#game/script.rpy:5952
translate chinese spaceship_door_23a003ec:

    # l "ACTIVATION INITIATED"
    l "启动程序已激活"

#game/script.rpy:5955
translate chinese spaceship_door_ab6ddc47:

    # ri "..."
    ri "……"

#game/script.rpy:5957
translate chinese spaceship_door_7329681e:

    # E "..."
    E "……"

#game/script.rpy:5960
translate chinese spaceship_door_7329681e_1:

    # E "..."
    E "……"

#game/script.rpy:5962
translate chinese spaceship_door_2e98bd9e:

    # mc "Richard, what the hell?!"
    mc "理查德，搞什么鬼？！"

#game/script.rpy:5965
translate chinese spaceship_door_f34e61b3:

    # ri "No sudden moves. We’re fine."
    ri "别突然动作。我们没事。"

#game/script.rpy:5968
translate chinese spaceship_door_098ca0c5:

    # ri "Totally fine. Just don’t look threatening."
    ri "完全没事。只要别显得有威胁。"

#game/script.rpy:5971
translate chinese spaceship_door_533b52f7:

    # ri "Everyone — lower your weapons."
    ri "所有人——把武器放下。"

#game/script.rpy:5972
translate chinese spaceship_door_462bfc56:

    # ri "That’s an {b}order{/b}. If we stay calm, so will it."
    ri "这是{b}命令{/b}。我们保持冷静，它也会冷静。"

#game/script.rpy:5975
translate chinese spaceship_door_72b5a7f3:

    # ri "No harm meant, no harm done. Right, metal friend? We’re just... passing through."
    ri "没有恶意，就没有伤害。对吧，金属朋友？我们只是……路过。"

#game/script.rpy:5978
translate chinese spaceship_door_95d6f3d5:

    # ri "Nice and easy."
    ri "慢慢来，别急。"

#game/script.rpy:5980
translate chinese spaceship_door_c3703ae3:

    # ri "That’s it. Lower your guns. Breathe."
    ri "就这样。把枪放下。呼吸。"

#game/script.rpy:5982
translate chinese spaceship_door_73b8bfc3:

    # mc "You’ve lost your mind."
    mc "你疯了。"

#game/script.rpy:5983
translate chinese spaceship_door_b730793d:

    # mc "That thing’s not friendly."
    mc "那东西不友好。"

#game/script.rpy:5985
translate chinese spaceship_door_451cfeb3:

    # ri "Yeah, I’ve lost it. Now lower your weapon!"
    ri "对，我疯了。现在把武器放下！"

#game/script.rpy:5986
translate chinese spaceship_door_2b35b6fe_3:

    # mc "..."
    mc "……"

#game/script.rpy:5988
translate chinese spaceship_door_aacb036a:

    # ri "...Thanks."
    ri "……谢谢。"

#game/script.rpy:5990
translate chinese spaceship_door_491968b0:

    # mc "I don’t like this."
    mc "我不喜欢这样。"

#game/script.rpy:5991
translate chinese spaceship_door_53a5d8ff:

    # mc "Not even a little."
    mc "一点都不喜欢。"

#game/script.rpy:5993
translate chinese spaceship_door_a7556636:

    # ri "I’ll listen to your complaints after this."
    ri "等这事完了再听你抱怨。"

#game/script.rpy:6002
translate chinese spaceship_door_2fb49068:

    # E "{b}sigh of relief{/b}"
    E "{b}松了一口气{/b}"

#game/script.rpy:6007
translate chinese spaceship_door_8c42975c:

    # S "We’re in contact."
    S "联系上了。"

#game/script.rpy:6008
translate chinese spaceship_door_7e9c9b7f:

    # S "(Interference dropped.)"
    S "（干扰消失了。）"

#game/script.rpy:6009
translate chinese spaceship_door_33c48490:

    # S "(Whatever that thing opened, it cleared a channel.)"
    S "（不管那东西打开了什么，它清出了一条信道。）"

#game/script.rpy:6011
translate chinese spaceship_door_a43031ba:

    # r "Commander, do you read me?"
    r "指挥官，能收到吗？"

#game/script.rpy:6014
translate chinese spaceship_door_6ac04b99:

    # r "We're under attack. Armed hostiles."
    r "我们遭到攻击。武装敌人。"

#game/script.rpy:6017
translate chinese spaceship_door_8002de03:

    # r "Don’t know who, but they're organized, and they’re pushing us back."
    r "不知道是谁，但他们有组织，正在把我们逼退。"

#game/script.rpy:6019
translate chinese spaceship_door_5348bd42:

    # r "HQ's dark. Might be jamming — signals are shot to hell. We’re blind out here."
    r "总部失联。可能是干扰——信号全废了。我们在外面完全是瞎子。"

#game/script.rpy:6022
translate chinese spaceship_door_3934cb13:

    # ri "Something wrong?"
    ri "出什么事了？"

#game/script.rpy:6026
translate chinese spaceship_door_ddb5f54a:

    # S "We under attack!"
    S "我们遭到攻击！"

#game/script.rpy:6028
translate chinese spaceship_door_239c46ee:

    # ri "Under attack? From who? What the hell’s happening?"
    ri "遭到攻击？谁？到底怎么回事？"

#game/script.rpy:6031
translate chinese spaceship_door_42a2847b:

    # S "No clue. But it’s real. And it’s bad."
    S "不知道。但这是真的。而且很糟。"

#game/script.rpy:6032
translate chinese spaceship_door_e77d9789:

    # S "We’ll hold them off. You move ahead."
    S "我们拖住他们。你们往前走。"

#game/script.rpy:6033
translate chinese spaceship_door_dedfb59d:

    # S "If they reach this corridor, we're trapped."
    S "如果他们到了这条走廊，我们就被困住了。"

#game/script.rpy:6034
translate chinese spaceship_door_31f5639f:

    # S "You keep moving. We'll hold the choke point."
    S "你们继续走。我们守住隘口。"

#game/script.rpy:6037
translate chinese spaceship_door_d532fcd8:

    # ri "You keep moving, we’ll handle things outside."
    ri "你们继续走，外面的事我们来处理。"

#game/script.rpy:6039
translate chinese spaceship_door_44e1cac8:

    # h "So what—"
    h "那——"

#game/script.rpy:6040
translate chinese spaceship_door_cc31502c:

    # h "they ditched us, or we ditched them?"
    h "是他们甩了我们，还是我们甩了他们？"

#game/script.rpy:6041
translate chinese spaceship_door_e8ac66a3:

    # h "…Eh."
    h "……唉。"

#game/script.rpy:6042
translate chinese spaceship_door_3c7cf872:

    # h "Same difference."
    h "反正都一样。"

#game/script.rpy:6059
translate chinese spaceship_door_9595e8d0:

    # h "...Okay, tell me I’m not seeing things."
    h "……好吧，告诉我我没看花眼。"

#game/script.rpy:6060
translate chinese spaceship_door_ed19c04f:

    # h "That thing just followed them, right?"
    h "那东西刚跟着他们走了，对吧？"

#game/script.rpy:6062
translate chinese spaceship_door_e12a2200:

    # mc "You saw it right."
    mc "你没看错。"

#game/script.rpy:6063
translate chinese spaceship_door_ded71177:

    # mc "And it’s with them."
    mc "而且它站在他们那边。"

#game/script.rpy:6067
translate chinese spaceship_door_850ef128:

    # b "..."
    b "……"

#game/script.rpy:6070
translate chinese spaceship_door_6651ab87:

    # mc "Alright."
    mc "好。"

#game/script.rpy:6071
translate chinese spaceship_door_e31cb2e9:

    # mc "We’re not waiting for the next disaster."
    mc "我们不能等着下一场灾难上门。"

#game/script.rpy:6072
translate chinese spaceship_door_2562ad6f:

    # mc "Move."
    mc "走。"

#game/script.rpy:6075
translate chinese spaceship_door_db957387:

    # h "So what now?"
    h "那现在怎么办？"

#game/script.rpy:6076
translate chinese spaceship_door_ca8e6f89:

    # h "We just stand here and stare at it until it opens itself?"
    h "我们就站在这儿盯着它，等它自己打开？"

#game/script.rpy:6078
translate chinese spaceship_door_ef89ebe2:

    # mc "Tempting."
    mc "挺诱人的。"

#game/script.rpy:6079
translate chinese spaceship_door_bcaa161b:

    # mc "Still gotta open it."
    mc "还是得把它打开。"

#game/script.rpy:6080
translate chinese spaceship_door_d0a7e435:

    # mc "No shortcuts."
    mc "没有捷径。"

#game/script.rpy:6082
translate chinese spaceship_door_30e866ec:

    # mc "Norman."
    mc "诺曼。"

#game/script.rpy:6083
translate chinese spaceship_door_bb8e4a24:

    # mc "You’ve been quiet."
    mc "你一直没说话。"

#game/script.rpy:6084
translate chinese spaceship_door_3ee32121:

    # mc "You good?"
    mc "你没事吧？"

#game/script.rpy:6086
translate chinese spaceship_door_21fe90ca:

    # N "Yeah… I’m good."
    N "嗯……我没事。"

#game/script.rpy:6087
translate chinese spaceship_door_04e47ac9:

    # N "Just got this weird feeling... Like I’ve been here before."
    N "就是有种奇怪的感觉……好像我以前来过这里。"

#game/script.rpy:6088
translate chinese spaceship_door_8898e72d:

    # N "Not here exactly."
    N "不完全是这里。"

#game/script.rpy:6089
translate chinese spaceship_door_bb7360ff:

    # N "Just... the sound."
    N "只是……那声音。"

#game/script.rpy:6090
translate chinese spaceship_door_c45a1235:

    # N "The air."
    N "那空气。"

#game/script.rpy:6091
translate chinese spaceship_door_ca4a4cd6:

    # N "Like the place Mom took me."
    N "像妈妈带我去过的那个地方。"

#game/script.rpy:6093
translate chinese spaceship_door_2b35b6fe_4:

    # mc "..."
    mc "……"

#game/script.rpy:6095
translate chinese spaceship_door_e313e08c:

    # mc "Since when?"
    mc "从什么时候开始的？"

#game/script.rpy:6101
translate chinese spaceship_door_42daceb6:

    # N "I don’t know, Dad… I just, can’t place it."
    N "我不知道，爸……我就是说不清。"

#game/script.rpy:6103
translate chinese spaceship_door_2fd558b9:

    # h "Hey, Norman…"
    h "嘿，诺曼……"

#game/script.rpy:6104
translate chinese spaceship_door_b0c25c5b:

    # h "You even know how to shoot?"
    h "你会开枪吗？"

#game/script.rpy:6105
translate chinese spaceship_door_ec14a935:

    # N "Nope."
    N "不会。"

#game/script.rpy:6106
translate chinese spaceship_door_10ebb560:

    # h "Then stay behind me."
    h "那就待在我后面。"

#game/script.rpy:6107
translate chinese spaceship_door_48d4a94f:

    # h "If things go south— I’ve got you."
    h "要是出了岔子——我护着你。"

#game/script.rpy:6109
translate chinese spaceship_door_52eab8a6:

    # mc "Everyone ready?"
    mc "都准备好了吗？"

#game/script.rpy:6111
translate chinese spaceship_door_be92834c:

    # h "Oh, I’m ready."
    h "哦，我准备好了。"

#game/script.rpy:6113
translate chinese spaceship_door_d3e5fe51:

    # N "I’ll keep up. I won’t slow you down."
    N "我跟得上。不会拖你们后腿。"

#game/script.rpy:6115
translate chinese spaceship_door_6651ab87_1:

    # mc "Alright."
    mc "好。"

#game/script.rpy:6116
translate chinese spaceship_door_ed237b7a:

    # mc "Stay sharp."
    mc "保持警觉。"

#game/script.rpy:6117
translate chinese spaceship_door_a6adc98a:

    # mc "Let’s move."
    mc "走吧。"

#game/script.rpy:6134
translate chinese endoftheporolgue_2b35b6fe:

    # mc "..."
    mc "……"

#game/script.rpy:6136
translate chinese endoftheporolgue_e16431b4:

    # mc "(…What the hell is that.)"
    mc "（……那他妈是什么。）"

#game/script.rpy:6137
translate chinese endoftheporolgue_ad54824b:

    # mc "...That’s not natural."
    mc "……那不正常。"

#game/script.rpy:6140
translate chinese endoftheporolgue_00eeb9d3:

    # h "…Well."
    h "……好吧。"

#game/script.rpy:6141
translate chinese endoftheporolgue_4b9a1f51:

    # h "A floating black hole."
    h "一个漂浮的黑洞。"

#game/script.rpy:6142
translate chinese endoftheporolgue_aab18d43:

    # h "Yeah, that wasn’t on my list for today."
    h "是啊，这不在我今天的计划里。"

#game/script.rpy:6145
translate chinese endoftheporolgue_dfd517f6:

    # N "No… that’s not possible."
    N "不……这不可能。"

#game/script.rpy:6146
translate chinese endoftheporolgue_11579870:

    # N "What is that thing doing here?"
    N "那东西怎么会在这儿？"

#game/script.rpy:6148
translate chinese endoftheporolgue_30e866ec:

    # mc "Norman."
    mc "诺曼。"

#game/script.rpy:6149
translate chinese endoftheporolgue_7b8c6fbb:

    # mc "You recognize it?"
    mc "你认得它？"

#game/script.rpy:6151
translate chinese endoftheporolgue_bba56ce0:

    # N "Dad… that’s what Mom was working on."
    N "爸……那是妈妈一直在研究的东西。"

#game/script.rpy:6153
translate chinese endoftheporolgue_0ed487b7:

    # N "Mom called it..."
    N "妈妈叫它……"

#game/script.rpy:6154
translate chinese endoftheporolgue_de7b42f6:

    # N "A warp drive."
    N "曲速引擎。"

#game/script.rpy:6155
translate chinese endoftheporolgue_20e94d49:

    # N "But this one..."
    N "但这个……"

#game/script.rpy:6156
translate chinese endoftheporolgue_5fddfe20:

    # N "This is bigger than the prototype."
    N "这个比原型机大。"

#game/script.rpy:6161
translate chinese endoftheporolgue_2865e349:

    # az "Don’t worry… you’re not leaving. Not until I say so."
    az "别担心……你们走不了。除非我开口。"

#game/script.rpy:6162
translate chinese endoftheporolgue_5a39664c:

    # az "My dear… {b}friends{/b}."
    az "我亲爱的……{b}朋友们{/b}。"

#game/script.rpy:6163
translate chinese endoftheporolgue_fcfcc7fb:

    # az "No… not friends."
    az "不……不是朋友。"

#game/script.rpy:6165
translate chinese endoftheporolgue_a8d4185e:

    # az "...Or are you?"
    az "……还是说，你们是？"

#game/script.rpy:6167
translate chinese endoftheporolgue_99e0e335:

    # az "Twenty years…"
    az "二十年……"

#game/script.rpy:6168
translate chinese endoftheporolgue_72f8c56d:

    # az "Twenty long… stretching… years."
    az "漫长……难熬的……二十年。"

#game/script.rpy:6169
translate chinese endoftheporolgue_5278223d:

    # az "And now you’re standing here. In front of me."
    az "现在你们就站在这儿。站在我面前。"

#game/script.rpy:6170
translate chinese endoftheporolgue_c086db0c:

    # az "But why…? Your faces… why can’t I see them?"
    az "可为什么……？你们的脸……我为什么看不见？"

#game/script.rpy:6171
translate chinese endoftheporolgue_7481e565:

    # az "Only… fire."
    az "只有……火。"

#game/script.rpy:6172
translate chinese endoftheporolgue_7e47e3c3:

    # az "Fire… No—no, no, no—!"
    az "火……不——不不不——！"

#game/script.rpy:6173
translate chinese endoftheporolgue_cc9b9cc8:

    # az "It hurts…"
    az "好痛……"

#game/script.rpy:6176
translate chinese endoftheporolgue_33c4b48f:

    # h "(quietly) ...He’s not right in the head."
    h "（低声）……他脑子不正常。"

#game/script.rpy:6177
translate chinese endoftheporolgue_aae967fd:

    # h "You were dead."
    h "你早就死了。"

#game/script.rpy:6178
translate chinese endoftheporolgue_72181ea8:

    # h "So how the hell are you standing here?"
    h "那你怎么他妈的还站在这儿？"

#game/script.rpy:6180
translate chinese endoftheporolgue_2b6baccc:

    # az "..."
    az "……"

#game/script.rpy:6182
translate chinese endoftheporolgue_dfa57093:

    # az "Was I?"
    az "我死了吗？"

#game/script.rpy:6183
translate chinese endoftheporolgue_b6016148:

    # az "I don’t remember."
    az "我不记得了。"

#game/script.rpy:6186
translate chinese endoftheporolgue_bf696e47:

    # az "Did they kill me…?"
    az "是他们杀了我吗……？"

#game/script.rpy:6187
translate chinese endoftheporolgue_b0b43f88:

    # az "No…?"
    az "不是……？"

#game/script.rpy:6188
translate chinese endoftheporolgue_5ebb1eb1:

    # az "Then why am I here…"
    az "那我为什么在这儿……"

#game/script.rpy:6189
translate chinese endoftheporolgue_c665c33f:

    # az "Because of them."
    az "因为他们。"

#game/script.rpy:6190
translate chinese endoftheporolgue_54d55287:

    # az "Yes… THEM."
    az "对……就是他们。"

#game/script.rpy:6191
translate chinese endoftheporolgue_4dab5791:

    # az "But why… why…"
    az "可为什么……为什么……"

#game/script.rpy:6193
translate chinese endoftheporolgue_02723237:

    # az "Ah—!"
    az "啊——！"

#game/script.rpy:6194
translate chinese endoftheporolgue_cc574a3a:

    # az "I remember—yes, yes— it was y—"
    az "我想起来了——对，对——是你——"

#game/script.rpy:6195
translate chinese endoftheporolgue_1a615e60:

    # az "No."
    az "不。"

#game/script.rpy:6196
translate chinese endoftheporolgue_c9d4f8cf:

    # az "I remember perfectly."
    az "我记得清清楚楚。"

#game/script.rpy:6197
translate chinese endoftheporolgue_0f0eba51:

    # az "You pulled the trigger."
    az "是你扣的扳机。"

#game/script.rpy:6205
translate chinese endoftheporolgue_ab932e06:

    # h "You should’ve stayed buried."
    h "你就该老老实实躺在土里。"

#game/script.rpy:6207
translate chinese endoftheporolgue_ebaf266d:

    # mc "(Is he... actually dead?)"
    mc "（他……真的死了吗？）"

#game/script.rpy:6211
translate chinese endoftheporolgue_a8f1ee0c:

    # npc "Substance capable of regenerating even human organs."
    npc "能再生人类器官的物质。"

#game/script.rpy:6214
translate chinese endoftheporolgue_5361eda5:

    # mc "(Could it...?)"
    mc "（难道它……？）"

#game/script.rpy:6215
translate chinese endoftheporolgue_2b35b6fe_1:

    # mc "..."
    mc "……"

#game/script.rpy:6216
translate chinese endoftheporolgue_cb8146d7:

    # mc "Olivia, careful. He's not dead yet."
    mc "奥利维亚，小心。他还没死。"

#game/script.rpy:6219
translate chinese endoftheporolgue_ec666712:

    # h "...Not?"
    h "……还没？"

#game/script.rpy:6220
translate chinese endoftheporolgue_90b1f04f:

    # h "I just put a bullet in his head."
    h "我刚往他脑袋里打了一颗子弹。"

#game/script.rpy:6221
translate chinese endoftheporolgue_46697ac3:

    # h "What do you mean ‘not’?"
    h "你说‘还没’是什么意思？"

#game/script.rpy:6223
translate chinese endoftheporolgue_4ce0c4a6:

    # N "Dad’s right, he’s not dead!"
    N "爸说得对，他没死！"

#game/script.rpy:6225
translate chinese endoftheporolgue_752f5464:

    # h "Oh come on—"
    h "哦得了吧——"

#game/script.rpy:6226
translate chinese endoftheporolgue_e20c3689:

    # h "You’re telling me that thing’s still alive?"
    h "你是说那东西还活着？"

#game/script.rpy:6228
translate chinese endoftheporolgue_99e684e1:

    # N "Mom's notes mentioned it."
    N "妈妈的笔记里提到过。"

#game/script.rpy:6229
translate chinese endoftheporolgue_73eb4687:

    # N "The substance doesn't just heal."
    N "那种物质不只是治疗。"

#game/script.rpy:6230
translate chinese endoftheporolgue_ee9eaad7:

    # N "It rewrites the host."
    N "它会重写宿主。"

#game/script.rpy:6231
translate chinese endoftheporolgue_10da554a:

    # N "After that, he stopped being human."
    N "从那之后，他就不再是人类了。"

#game/script.rpy:6235
translate chinese endoftheporolgue_52f01cf2:

    # az "A human?"
    az "人类？"

#game/script.rpy:6236
translate chinese endoftheporolgue_c4e19673:

    # az "No… no, I am human."
    az "不……不，我是人类。"

#game/script.rpy:6237
translate chinese endoftheporolgue_ae32f8c4:

    # az "Still human."
    az "还是人类。"

#game/script.rpy:6240
translate chinese endoftheporolgue_4fb790d9:

    # az "Just… different."
    az "只是……不一样了。"

#game/script.rpy:6241
translate chinese endoftheporolgue_e85cec24:

    # az "A little… rearranged."
    az "稍微……重新排列了一下。"

#game/script.rpy:6244
translate chinese endoftheporolgue_02723237_1:

    # az "Ah—!"
    az "啊——！"

#game/script.rpy:6245
translate chinese endoftheporolgue_6c79e7bf:

    # az "That hurts…"
    az "好痛……"

#game/script.rpy:6246
translate chinese endoftheporolgue_625c0599:

    # az "Hurts-hurts-hurts…"
    az "痛痛痛……"

#game/script.rpy:6249
translate chinese endoftheporolgue_57eaf32b:

    # mc "What... are you?"
    mc "你……到底是什么？"

#game/script.rpy:6251
translate chinese endoftheporolgue_b8c4dfa3:

    # az "What?"
    az "什么？"

#game/script.rpy:6252
translate chinese endoftheporolgue_62718c4d:

    # az "I told you, human!"
    az "我说过了，人类！"

#game/script.rpy:6253
translate chinese endoftheporolgue_3cdfe01e:

    # az "Just… slightly… modified."
    az "只是……稍微……改造过。"

#game/script.rpy:6254
translate chinese endoftheporolgue_07c81b4b:

    # az "Improved, maybe."
    az "也许是……强化了。"

#game/script.rpy:6257
translate chinese endoftheporolgue_9c23bcfe:

    # az "I was like you once. Weak. Afraid. Small."
    az "我曾经也像你们一样。软弱。害怕。渺小。"

#game/script.rpy:6258
translate chinese endoftheporolgue_4c69f50a:

    # az "Waiting to die."
    az "等着死去。"

#game/script.rpy:6259
translate chinese endoftheporolgue_d05c74f3:

    # az "But death…"
    az "但死亡……"

#game/script.rpy:6260
translate chinese endoftheporolgue_f7530d7a:

    # az "...death doesn’t end things."
    az "……死亡并不能终结一切。"

#game/script.rpy:6261
translate chinese endoftheporolgue_dc6b3f31:

    # az "It bends them."
    az "它只是把它们掰弯。"

#game/script.rpy:6262
translate chinese endoftheporolgue_110b0344:

    # az "Breaks them."
    az "折断它们。"

#game/script.rpy:6265
translate chinese endoftheporolgue_6b2884d2:

    # az "My daughter…"
    az "我的女儿……"

#game/script.rpy:6266
translate chinese endoftheporolgue_e1a5d86b:

    # az "Poor thing. Loyal to the end."
    az "可怜的孩子。忠诚到最后一刻。"

#game/script.rpy:6267
translate chinese endoftheporolgue_276d2cf1:

    # az "She made a deal."
    az "她做了笔交易。"

#game/script.rpy:6268
translate chinese endoftheporolgue_38f6d22c:

    # az "With a woman… strange… wrong."
    az "和一个女人……古怪……不对劲。"

#game/script.rpy:6269
translate chinese endoftheporolgue_2b96ddc7:

    # az "They told her: ‘We can bring him back.’"
    az "她们告诉她：‘我们能把他带回来。’"

#game/script.rpy:6270
translate chinese endoftheporolgue_a23b7389:

    # az "And she—"
    az "然后她——"

#game/script.rpy:6271
translate chinese endoftheporolgue_f2701477:

    # az "—she said yes."
    az "——她答应了。"

#game/script.rpy:6273
translate chinese endoftheporolgue_85ab310a:

    # az "And now I’m here."
    az "于是现在我在这儿。"

#game/script.rpy:6274
translate chinese endoftheporolgue_40b612fd:

    # az "See? Not so bad."
    az "看？也没那么糟。"

#game/script.rpy:6275
translate chinese endoftheporolgue_119ab016:

    # az "We could even be friends."
    az "我们甚至可以当朋友。"

#game/script.rpy:6276
translate chinese endoftheporolgue_112fb39f:

    # az "…Right?"
    az "……对吧？"

#game/script.rpy:6279
translate chinese endoftheporolgue_437e0729:

    # az "No… no."
    az "不……不。"

#game/script.rpy:6280
translate chinese endoftheporolgue_00803a43:

    # az "No-no—NO."
    az "不不——不。"

#game/script.rpy:6282
translate chinese endoftheporolgue_d6034643:

    # az "You killed me."
    az "你们杀了我。"

#game/script.rpy:6283
translate chinese endoftheporolgue_b742281c:

    # az "That day."
    az "那天。"

#game/script.rpy:6295
translate chinese endoftheporolgue_20326694:

    # az "And since then—"
    az "从那以后——"

#game/script.rpy:6296
translate chinese endoftheporolgue_beb76ef0:

    # az "It replays. Every night."
    az "它每晚都在重演。"

#game/script.rpy:6297
translate chinese endoftheporolgue_d022674a:

    # az "I shut my eyes—"
    az "我一闭上眼——"

#game/script.rpy:6298
translate chinese endoftheporolgue_86013249:

    # az "—and there you are."
    az "——你们就在那儿。"

#game/script.rpy:6300
translate chinese endoftheporolgue_bf3f40a1:

    # az "You didn’t hesitate."
    az "你们没有犹豫。"

#game/script.rpy:6301
translate chinese endoftheporolgue_60f19e0b:

    # az "That’s what I admire."
    az "这正是我欣赏的地方。"

#game/script.rpy:6304
translate chinese endoftheporolgue_4b40b446:

    # az "It’s driven me mad."
    az "这把我逼疯了。"

#game/script.rpy:6308
translate chinese endoftheporolgue_4b0cc7cf:

    # mc "(…The masked guy?)"
    mc "（……那个戴面具的家伙？）"

#game/script.rpy:6309
translate chinese endoftheporolgue_457e9beb:

    # mc "How did you get in here?"
    mc "你是怎么进来的？"

#game/script.rpy:6310
translate chinese endoftheporolgue_5ca9acaa:

    # az "You opened the way."
    az "是你们打开了路。"

#game/script.rpy:6311
translate chinese endoftheporolgue_62f8a118:

    # az "All we had to do... was follow."
    az "我们要做的……只是跟进来。"

#game/script.rpy:6313
translate chinese endoftheporolgue_ff64f5ca:

    # a "Stay out of this, little man. He’s mine to deal with."
    a "别插手，小个子。他归我处理。"

#game/script.rpy:6315
translate chinese endoftheporolgue_bf0aed50:

    # az "That’s not what we agreed on."
    az "我们可不是这么约定的。"

#game/script.rpy:6317
translate chinese endoftheporolgue_3a4d0af0:

    # a "That man’s body… must be kept alive."
    a "那个男人的身体……必须维持活着。"

#game/script.rpy:6320
translate chinese endoftheporolgue_05496c8b:

    # a "This is the will… of the woman who created me."
    a "这是……创造我的那个女人的意志。"

#game/script.rpy:6322
translate chinese endoftheporolgue_e7625bf6:

    # aa "Sir, why send him personally? We could've taken the target at the entrance."
    aa "长官，为什么要亲自派他去？我们本可以在入口就拿下目标。"

#game/script.rpy:6324
translate chinese endoftheporolgue_dae2c354:

    # az "No…"
    az "不……"

#game/script.rpy:6325
translate chinese endoftheporolgue_bca6dad4:

    # az "I want to watch."
    az "我想亲眼看。"

#game/script.rpy:6328
translate chinese endoftheporolgue_1cc13fd0:

    # aa "But si—"
    aa "可是长——"

#game/script.rpy:6331
translate chinese endoftheporolgue_53a86359:

    # az "You’re… irritating."
    az "你……很烦人。"

#game/script.rpy:6336
translate chinese endoftheporolgue_09110022:

    # h "Out—!"
    h "没子弹了——！"

#game/script.rpy:6337
translate chinese endoftheporolgue_2f725a00:

    # h "Out of ammo, cover me!"
    h "没子弹了，掩护我！"

#game/script.rpy:6342
translate chinese endoftheporolgue_bec01954:

    # mc "How much longer?!"
    mc "还要多久？！"

#game/script.rpy:6345
translate chinese endoftheporolgue_7df2eaf1:

    # h "Don’t rush me—!"
    h "别催我——！"

#game/script.rpy:6346
translate chinese endoftheporolgue_f78eab3a:

    # h "I’m on it!"
    h "我在弄了！"

#game/script.rpy:6349
translate chinese endoftheporolgue_1e377523:

    # a "That won’t help you, little man."
    a "那帮不了你，小个子。"

#game/script.rpy:6358
translate chinese endoftheporolgue_4a6a6d7f:

    # mc "(Tough…)"
    mc "（好硬……）"

#game/script.rpy:6359
translate chinese endoftheporolgue_6c66d910:

    # mc "(Feels like hitting steel.)"
    mc "（像打在钢板上。）"

#game/script.rpy:6360
translate chinese endoftheporolgue_8033231f:

    # mc "So you’re the one pulling the strings."
    mc "所以是你在背后操纵。"

#game/script.rpy:6361
translate chinese endoftheporolgue_3102bdab:

    # a "Pulling… strings?"
    a "背后……操纵？"

#game/script.rpy:6362
translate chinese endoftheporolgue_52854cf2:

    # a "I do not understand. Explain, little man."
    a "我不明白。解释一下，小个子。"

#game/script.rpy:6373
translate chinese endoftheporolgue_15ae44d8:

    # mc "(…Wrong target?)"
    mc "（……打错目标了？）"

#game/script.rpy:6374
translate chinese endoftheporolgue_2250e141:

    # a "Too slow."
    a "太慢了。"

#game/script.rpy:6380
translate chinese endoftheporolgue_466c1ed8:

    # a "You dodge well, little man. But how long can you keep it up?"
    a "你躲得不错，小个子。但你能撑多久？"

#game/script.rpy:6382
translate chinese endoftheporolgue_2b6baccc_1:

    # az "..."
    az "……"

#game/script.rpy:6384
translate chinese endoftheporolgue_df0b2b78:

    # az "Two against one?"
    az "二对一？"

#game/script.rpy:6385
translate chinese endoftheporolgue_be371e7f:

    # az "Mm."
    az "嗯。"

#game/script.rpy:6386
translate chinese endoftheporolgue_40b85edd:

    # az "How… disappointing."
    az "真……令人失望。"

#game/script.rpy:6390
translate chinese endoftheporolgue_e07f57eb:

    # N "What’s he planning..."
    N "他想干什么……"

#game/script.rpy:6392
translate chinese endoftheporolgue_d580f344:

    # N "Don’t—"
    N "别——"

#game/script.rpy:6402
translate chinese endoftheporolgue_4574addf:

    # mc "NORMAN!"
    mc "诺曼！"

#game/script.rpy:6405
translate chinese endoftheporolgue_8c72379a:

    # a "Got you now, little man."
    a "抓到你了，小个子。"

#game/script.rpy:6411
translate chinese endoftheporolgue_b3db295f:

    # h "[mc]!"
    h "[mc]！"

#game/script.rpy:6414
translate chinese endoftheporolgue_444bb49e:

    # a "Honestly, I didn’t expect the little man to last this long."
    a "说实话，我没想到小个子能撑这么久。"

#game/script.rpy:6417
translate chinese endoftheporolgue_d8a442f2:

    # h "Hold on—!"
    h "撑住——！"

#game/script.rpy:6419
translate chinese endoftheporolgue_7114bbb8:

    # az "You’re all running out of time."
    az "你们都快没时间了。"

#game/script.rpy:6420
translate chinese endoftheporolgue_438b8f93:

    # az "You just don’t know it yet."
    az "只是你们还不知道而已。"

#game/script.rpy:6423
translate chinese endoftheporolgue_7b4a75f0:

    # az "No matter."
    az "无所谓。"

#game/script.rpy:6424
translate chinese endoftheporolgue_d9bddc01:

    # az "Give him my regards…"
    az "替我向他问好……"

#game/script.rpy:6434
translate chinese endoftheporolgue_356d88de:

    # aaa "..."
    aaa "……"

#game/script.rpy:6435
translate chinese endoftheporolgue_a5e8f827:

    # aaa "Miriel… thirty seconds."
    aaa "米莉尔……三十秒。"

#game/script.rpy:6436
translate chinese endoftheporolgue_de21089d:

    # aaa "Small ones are mine."
    aaa "小的归我。"

#game/script.rpy:6437
translate chinese endoftheporolgue_11afc3fe:

    # aaa "The big one… yours."
    aaa "那个大的……归你。"

#game/script.rpy:6438
translate chinese endoftheporolgue_8b5c72f0:

    # Mi "…Understood."
    Mi "……明白。"

#game/script.rpy:6459
translate chinese endoftheporolgue_f98acf94:

    # a "The big man? What’s he doing here?"
    a "那个大块头？他怎么会在这儿？"

#game/script.rpy:6460
translate chinese endoftheporolgue_a05391a2:

    # a "We need to deal with this before the queen sees."
    a "我们得在女王看到之前解决这事。"

#game/script.rpy:6463
translate chinese endoftheporolgue_491bd79b:

    # Mi "Don’t worry… you’re facing me now."
    Mi "别担心……你现在面对的是我。"

#game/script.rpy:6466
translate chinese endoftheporolgue_e9d81a1e:

    # a "The Cold Reaper? Yes... you’re a worthy foe. Let’s fight!"
    a "寒霜收割者？不错……你是个值得一战的对手。开打吧！"

#game/script.rpy:6474
translate chinese endoftheporolgue_7ce3fcd2:

    # Mi "…I don’t have time for you."
    Mi "……我没空搭理你。"

#game/script.rpy:6477
translate chinese endoftheporolgue_56b1b113:

    # h "[mc]…!"
    h "[mc]……！"

#game/script.rpy:6478
translate chinese endoftheporolgue_2f47fd71:

    # h "Hey—!"
    h "嘿——！"

#game/script.rpy:6480
translate chinese endoftheporolgue_c44180d5:

    # h "Stay with me…"
    h "撑住……"

#game/script.rpy:6481
translate chinese endoftheporolgue_17f13727:

    # h "Come on… stay with me."
    h "拜托……撑住。"

#game/script.rpy:6482
translate chinese endoftheporolgue_da3fdbf1:

    # Mi "..."
    Mi "……"

#game/script.rpy:6483
translate chinese endoftheporolgue_8c07114f:

    # aaa "Well?"
    aaa "怎么样？"

#game/script.rpy:6484
translate chinese endoftheporolgue_fa396ea3:

    # aaa "What do you see."
    aaa "你看到了什么。"

#game/script.rpy:6486
translate chinese endoftheporolgue_9c397e3d:

    # Mi "…The lady’s words don’t add up."
    Mi "……那位女士的话对不上。"

#game/script.rpy:6487
translate chinese endoftheporolgue_3c83fc06:

    # Mi "The portal… reacted to the older one."
    Mi "传送门……对那个年长的人起了反应。"

#game/script.rpy:6489
translate chinese endoftheporolgue_ef9f9c3a:

    # h "Help’s coming."
    h "救援快到了。"

#game/script.rpy:6490
translate chinese endoftheporolgue_29c67eee:

    # h "You hear me?"
    h "听见了吗？"

#game/script.rpy:6491
translate chinese endoftheporolgue_743fa6f5:

    # h "They’re coming— they’ll fix this."
    h "他们来了——他们会解决这事的。"

#game/script.rpy:6493
translate chinese endoftheporolgue_9a052dd0:

    # h "You promised me."
    h "你答应过我的。"

#game/script.rpy:6496
translate chinese endoftheporolgue_2b28c5e6:

    # h "So don’t you dare die on me now."
    h "所以你现在不许死。"

#game/script.rpy:6497
translate chinese endoftheporolgue_49f97e85:

    # h "Not like this…"
    h "不能这样死……"

#game/script.rpy:6498
translate chinese endoftheporolgue_c24f3046:

    # h "Not here…"
    h "不能死在这儿……"

#game/script.rpy:6500
translate chinese endoftheporolgue_d3063e7b:

    # aaa "Take both. The girl doesn’t see the portal."
    aaa "两个都带走。那女孩看不见传送门。"

#game/script.rpy:6501
translate chinese endoftheporolgue_e078c3c5:

    # aaa "Her mind… won’t survive it."
    aaa "她的脑子……承受不住。"

#game/script.rpy:6503
translate chinese endoftheporolgue_de226845:

    # Mi "I’ll secure them… and catch up."
    Mi "我会安置好他们……然后追上去。"

#game/script.rpy:6505
translate chinese endoftheporolgue_356d88de_1:

    # aaa "..."
    aaa "……"

#game/script.rpy:6507
translate chinese endoftheporolgue_2089f160:

    # aaa "A portal…"
    aaa "一道传送门……"

#game/script.rpy:6508
translate chinese endoftheporolgue_a06789a3:

    # aaa "Time displacement."
    aaa "时间位移。"

#game/script.rpy:6510
translate chinese endoftheporolgue_4bf7b0a5:

    # aaa "So this is it."
    aaa "就是这里了。"

#game/script.rpy:6511
translate chinese endoftheporolgue_6dad4c95:

    # aaa "The source of the chaos."
    aaa "混乱的源头。"

#game/script.rpy:6519
translate chinese endoftheporolgue_a4ac5554:

    # aaa "…What—"
    aaa "……什么——"

#game/script.rpy:6521
translate chinese endoftheporolgue_a90cb9d3:

    # aaa "No…"
    aaa "不……"

#game/script.rpy:6522
translate chinese endoftheporolgue_0203571f:

    # aaa "That presence…"
    aaa "那股气息……"

#game/script.rpy:6523
translate chinese endoftheporolgue_41c2cf0d:

    # aaa "Selvaria..."
    aaa "塞尔瓦莉亚……"

#game/script.rpy:6525
translate chinese endoftheporolgue_c6950a3d:

    # Mi "Master… what’s happening?"
    Mi "主人……发生什么了？"

#game/script.rpy:6528
translate chinese endoftheporolgue_851c9b31:

    # aaa "The boy. The girl."
    aaa "那男孩。那女孩。"

#game/script.rpy:6529
translate chinese endoftheporolgue_7d89ff18:

    # aaa "Take them."
    aaa "带走他们。"

#game/script.rpy:6530
translate chinese endoftheporolgue_fbd68180:

    # aaa "We leave. Now."
    aaa "我们走。现在。"

#game/script.rpy:6532
translate chinese endoftheporolgue_62ce2899:

    # Mi "Understood. I’ll handle it."
    Mi "明白。我来处理。"

#game/script.rpy:6539
translate chinese endoftheporolgue_37eb2b29:

    # aaa "{font=Cybertron.otf}If he’s tied to Lora, we take him. Make sure he survives."
    aaa "{font=Cybertron.otf}如果他和洛拉有关联，就带走他。确保他活着。"

#game/script.rpy:6540
translate chinese endoftheporolgue_6d7acdec:

    # Mi "…I’ll take care of it."
    Mi "……我会处理好的。"

#game/script.rpy:6542
translate chinese endoftheporolgue_52d8969d:

    # aaa "This will be enough."
    aaa "这就够了。"

#game/script.rpy:6543
translate chinese endoftheporolgue_e18d8335:

    # aaa "To slow them."
    aaa "拖住他们。"

#game/script.rpy:6553
translate chinese endoftheporolgue_0d3ad738:

    # aaaa "They escaped..."
    aaaa "他们跑了……"

#game/script.rpy:6556
translate chinese endoftheporolgue_81384a0f:

    # aaaa "Told you — we should’ve moved faster."
    aaaa "我说过了——我们该动作更快的。"

#game/script.rpy:6558
translate chinese endoftheporolgue_3d40cf26:

    # aa "They aren’t our target. You’ll get your revenge later."
    aa "他们不是我们的目标。你的仇以后再报。"

#game/script.rpy:6560
translate chinese endoftheporolgue_aaa7ea2f:

    # aaaaa "Steal what is mine… right under my gaze?"
    aaaaa "当着我的面……偷走我的东西？"

#game/script.rpy:6561
translate chinese endoftheporolgue_ce7c6006:

    # aaaaa "...Astoria."
    aaaaa "……阿斯托里亚。"

#game/script.rpy:6563
translate chinese endoftheporolgue_afd3bff3:

    # aaaaa "Some things… never change."
    aaaaa "有些事……永远不会变。"

#game/script.rpy:6565
translate chinese endoftheporolgue_d9e7baef:

    # aaaaa "Use their body."
    aaaaa "用他们的身体。"

#game/script.rpy:6566
translate chinese endoftheporolgue_05270ce5:

    # aaaaa "We’re going to pay… our old friends a visit."
    aaaaa "我们要去……拜访一下老朋友。"

#game/script.rpy:6568
translate chinese endoftheporolgue_c1dcc1e6:

    # b "Yes, your highness."
    b "是，殿下。"