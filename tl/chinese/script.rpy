    N "……但我听到了。"

#game/script.rpy:2435
translate chinese homedinner_850ef128:

    # b "..."
    b "……"

#game/script.rpy:2437
translate chinese homedinner_10252e11:

    # N "...Dad?"
    N "……爸？"

#game/script.rpy:2439
translate chinese homedinner_1eefaa3c:

    # N "...There’s something else."
    N "……还有件事。"

#game/script.rpy:2440
translate chinese homedinner_60fafa63:

    # N "This one didn't come from him."
    N "这个不是他给的。"

#game/script.rpy:2441
translate chinese homedinner_937f9e33:

    # N "My handler passed this along."
    N "是我的联系人转交的。"

#game/script.rpy:2442
translate chinese homedinner_a1a568aa:

    # N "She said it came from an old friend of yours."
    N "她说这是你一位老朋友给的。"

#game/script.rpy:2443
translate chinese homedinner_64e54daf:

    # N "Said… you’d understand."
    N "说……你会明白。"

#game/script.rpy:2446
translate chinese homedinner_85d0eb7c:

    # N "All they told me was…"
    N "他们只告诉我……"

#game/script.rpy:2448
translate chinese homedinner_1998caff:

    # N "That it’s connected to your old mission in Al-Zahira."
    N "这和你当年在阿尔扎希拉的任务有关。"

#game/script.rpy:2456
translate chinese homedinner_92dcf7bf_1:

    # mc "(…No.)"
    mc "（……不。）"

#game/script.rpy:2457
translate chinese homedinner_f9cd7d14:

    # mc "(That’s not possible.)"
    mc "（不可能。）"

#game/script.rpy:2459
translate chinese homedinner_df527ed1:

    # mc "(He’s supposed to be dead…)"
    mc "（他应该死了……）"

#game/script.rpy:2462
translate chinese homedinner_e86e0376:

    # ri "P.S. We need you."
    ri "附：我们需要你。"

#game/script.rpy:2463
translate chinese homedinner_2b35b6fe_21:

    # mc "..."
    mc "……"

#game/script.rpy:2465
translate chinese homedinner_95b01614:

    # N "…What does it say?"
    N "……上面说什么？"

#game/script.rpy:2467
translate chinese homedinner_f5c2eaf2:

    # mc "If what’s written in that letter is true…"
    mc "如果那封信上写的是真的……"

#game/script.rpy:2469
translate chinese homedinner_922f59e9:

    # mc "then I need to call in people I swore I’d never involve again."
    mc "那我得召集那些我发誓再也不牵连的人。"

#game/script.rpy:2487
translate chinese anna_790bc65d:

    # mc "(I told myself I’d let you go…)"
    mc "（我告诉自己该放下你……）"

#game/script.rpy:2490
translate chinese anna_6b77a0ba:

    # mc "(Even with all of this still around me.)"
    mc "（就算这一切还在我身边。）"

#game/script.rpy:2497
translate chinese anna_87737a1c:

    # mc "(And now you’re back…)"
    mc "（现在你回来了……）"

#game/script.rpy:2498
translate chinese anna_013c150b:

    # mc "(…Just enough to make me hope again.)"
    mc "（……刚好够让我再次燃起希望。）"

#game/script.rpy:2500
translate chinese anna_fd1b878b:

    # mc "(All I remember… is how powerless I was.)"
    mc "（我只记得……我有多无力。）"

#game/script.rpy:2502
translate chinese anna_2e6209a5:

    # mc "(How cruel is that, don’t you think?)"
    mc "（这多残忍，你不觉得吗？）"

#game/script.rpy:2503
translate chinese anna_4a76f936:

    # a "Well, don’t blame me for any of this."
    a "别把这一切怪到我头上。"

#game/script.rpy:2505
translate chinese anna_f48d1f5c:

    # L "Back then… I didn’t think it would end like this."
    L "那时候……我没想到会这样收场。"

#game/script.rpy:2507
translate chinese anna_41c22eb4:

    # L "And I wasn’t planning to leave you."
    L "我也没打算离开你。"

#game/script.rpy:2508
translate chinese anna_b502ac01:

    # L "…Not like that."
    L "……不是那样。"

#game/script.rpy:2509
translate chinese anna_b9e84e9b:

    # L "You know that."
    L "你知道的。"

#game/script.rpy:2511
translate chinese anna_55d2dc14:

    # mc "You and your jokes…"
    mc "你和你那些玩笑……"

#game/script.rpy:2512
translate chinese anna_9ea35c7e:

    # mc "You’ve got no idea what those years were like."
    mc "你根本不知道那几年我是怎么过的。"

#game/script.rpy:2514
translate chinese anna_03b663b7:

    # a "Who’s he talking to?"
    a "他在跟谁说话？"

#game/script.rpy:2515
translate chinese anna_68b8d77e:

    # aa "Beats me. Let’s go — he’s giving me the creeps."
    aa "不知道。走吧——他让我发毛。"

#game/script.rpy:2517
translate chinese anna_788afdf9:

    # Lor "I know, darling."
    Lor "我知道，亲爱的。"

#game/script.rpy:2518
translate chinese anna_08c079d2:

    # Lor "You don’t have to explain it."
    Lor "你不用解释。"

#game/script.rpy:2519
translate chinese anna_11844110:

    # Lor "I know what it felt like."
    Lor "我知道那是什么感觉。"

#game/script.rpy:2521
translate chinese anna_2ddb7ded:

    # mc "How would you know?"
    mc "你怎么会知道？"

#game/script.rpy:2522
translate chinese anna_38bd3efd:

    # mc "You’re not real…"
    mc "你不是真的……"

#game/script.rpy:2523
translate chinese anna_8bd034d1:

    # mc "(…So why does it feel like you are?)"
    mc "（……那为什么感觉你是？）"

#game/script.rpy:2524
translate chinese anna_a18ca897:

    # Lor "..."
    Lor "……"

#game/script.rpy:2526
translate chinese anna_9ec5f51f:

    # Lor "Hey… don’t start that again."
    Lor "嘿……别又来了。"

#game/script.rpy:2527
translate chinese anna_24755f83:

    # Lor "We both know where that spiral goes."
    Lor "我们都知道那样下去会怎样。"

#game/script.rpy:2529
translate chinese anna_2b35b6fe:

    # mc "..."
    mc "……"

#game/script.rpy:2531
translate chinese anna_bfee04da:

    # mc "Weren’t you the reason I needed that help?"
    mc "不就是因为你我才需要那帮助的吗？"

#game/script.rpy:2533
translate chinese anna_844d014a:

    # Lor "You’re scared."
    Lor "你害怕。"

#game/script.rpy:2535
translate chinese anna_3fae39b4:

    # mc "I didn’t say that."
    mc "我没说。"

#game/script.rpy:2537
translate chinese anna_02c0fff1:

    # Lor "You didn’t need to say it."
    Lor "你不用说出来。"

#game/script.rpy:2538
translate chinese anna_a18ca897_1:

    # Lor "..."
    Lor "……"

#game/script.rpy:2540
translate chinese anna_8c0412ba:

    # Lor "...Alright."
    Lor "……好吧。"

#game/script.rpy:2541
translate chinese anna_d0d4f056:

    # Lor "Let’s not pretend you don’t know why I’m here."
    Lor "别装不知道我为什么在这儿。"

#game/script.rpy:2542
translate chinese anna_a194443c:

    # Lor "You saw the letter."
    Lor "你看到信了。"

#game/script.rpy:2543
translate chinese anna_9360410d:

    # Lor "That was enough."
    Lor "那就够了。"

#game/script.rpy:2545
translate chinese anna_cf1adef2:

    # mc "Yeah."
    mc "嗯。"

#game/script.rpy:2546
translate chinese anna_d1387c49:

    # mc "They say they found out what happened to you."
    mc "他们说查到了你的下落。"

#game/script.rpy:2547
translate chinese anna_071ff729:

    # mc "Why you disappeared."
    mc "你为什么消失。"

#game/script.rpy:2549
translate chinese anna_f5395ae9:

    # Lor "Wait…"
    Lor "等等……"

#game/script.rpy:2550
translate chinese anna_0d778420:

    # Lor "Since when is Norman tied to the military?"
    Lor "诺曼什么时候和军方扯上关系了？"

#game/script.rpy:2551
translate chinese anna_d44a1583:

    # Lor "...No, right."
    Lor "……不，也对。"

#game/script.rpy:2552
translate chinese anna_4365a34d:

    # Lor "You never told me."
    Lor "你从没告诉我。"

#game/script.rpy:2554
translate chinese anna_09f95b5c:

    # mc "He followed in my footsteps."
    mc "他追随了我的脚步。"

#game/script.rpy:2555
translate chinese anna_055408f6:

    # mc "Though unlike me… he’s stuck behind a desk."
    mc "不过不像我……他坐办公室。"

#game/script.rpy:2556
translate chinese anna_84a3f8f6:

    # mc "Doesn’t see much of the front."
    mc "不怎么上前线。"

#game/script.rpy:2557
translate chinese anna_dbcec2a5:

    # mc "Yeah… thanks for that, Richard."
    mc "是啊……谢了，理查德。"

#game/script.rpy:2559
translate chinese anna_eb286c94:

    # Lor "Oh."
    Lor "哦。"

#game/script.rpy:2562
translate chinese anna_93b42537:

    # mc "(…And just like that—)"
    mc "（……就这样——）"

#game/script.rpy:2563
translate chinese anna_124c2943:

    # a "Hah! Would you look at him. Trading his girl to pay off debts?"
    a "哈！看看他。拿自己女儿抵债？"

#game/script.rpy:2564
translate chinese anna_fdf9c8b0:

    # a "You're worse than all of us, you piece of shit."
    a "你比我们所有人都烂，你这坨屎。"

#game/script.rpy:2566
translate chinese anna_37dd98e2:

    # C "Is that true? You were going to trade me… to pay off a debt?"
    C "是真的吗？你要拿我抵债？"

#game/script.rpy:2567
translate chinese anna_60e08f65:

    # C "What the hell is wrong with you?"
    C "你到底有什么毛病？"

#game/script.rpy:2569
translate chinese anna_7d99578b:

    # Lor "…Wait."
    Lor "……等等。"

#game/script.rpy:2570
translate chinese anna_37e6a11b:

    # Lor "Is that Anya?"
    Lor "那是安雅吗？"

#game/script.rpy:2572
translate chinese anna_964e3083:

    # mc "Looks like it."
    mc "看起来是。"

#game/script.rpy:2573
translate chinese anna_253ebf86:

    # mc "Probably got herself into trouble again."
    mc "大概又惹麻烦了。"

#game/script.rpy:2575
translate chinese anna_f46e9117:

    # Lor "So?"
    Lor "那？"

#game/script.rpy:2576
translate chinese anna_d890d8a9:

    # Lor "What are you going to do?"
    Lor "你打算怎么办？"

#game/script.rpy:2580
translate chinese anna_467e0a89:

    # mc "Like I’ve got a choice."
    mc "说得好像我有得选。"

#game/script.rpy:2581
translate chinese anna_c1a00a18:

    # Lor "Remember what I told you?"
    Lor "记得我跟你说过的吗？"

#game/script.rpy:2582
translate chinese anna_08c279ab:

    # Lor "When someone needs a hand..."
    Lor "当有人需要援手……"

#game/script.rpy:2583
translate chinese anna_91fd7b3d:

    # mc "Don't push them away."
    mc "别把他们推开。"

#game/script.rpy:2584
translate chinese anna_c127961d:

    # Lor "Exactly."
    Lor "没错。"

#game/script.rpy:2585
translate chinese anna_fc3cb421:

    # mc "Tho..."
    mc "不过……"

#game/script.rpy:2586
translate chinese anna_88b09d1e:

    # mc "If Olivia hears about this… I’m dead before sunrise."
    mc "要是奥利维亚知道了……我活不过天亮。"

#game/script.rpy:2588
translate chinese anna_a18ca897_2:

    # Lor "..."
    Lor "……"

#game/script.rpy:2598
translate chinese anna_388dff9e:

    # j "Just this once, please? I’m begging you."
    j "就这一次，求你了？我求你了。"

#game/script.rpy:2600
translate chinese anna_a87b5f55:

    # j "If you don’t handle it, they won’t stop coming after me."
    j "你要是不处理，他们不会停止追我。"

#game/script.rpy:2602
translate chinese anna_c6b0b742:

    # C "No, Jacob. I’m not your solution tonight."
    C "不，雅各布。今晚我不是你的解决办法。"

#game/script.rpy:2603
translate chinese anna_fd322812:

    # C "Or ever. Get that through your skull."
    C "永远也不是。给我记住了。"

#game/script.rpy:2606
translate chinese anna_2d5565c2:

    # d "Damn, Jacob. Didn’t you say she wouldn’t fight it?"
    d "该死，雅各布。你不是说她不会反抗吗？"

#game/script.rpy:2608
translate chinese anna_ad0a157e:

    # d "She just made you look like a clown. That was brutal."
    d "她刚把你弄得像个小丑。太狠了。"

#game/script.rpy:2610
translate chinese anna_30cce330:

    # C "Find yourself some other desperate girl to dump this on. I don’t do charity."
    C "找别的走投无路的女孩去甩锅。我不做慈善。"

#game/script.rpy:2611
translate chinese anna_ef6d7244:

    # C "Especially not for idiots."
    C "尤其不为白痴。"

#game/script.rpy:2613
translate chinese anna_bb8e4b4e:

    # a "..."
    a "……"

#game/script.rpy:2614
translate chinese anna_65aa5dbb:

    # a "I’m tired. Take your lackeys and get out of my face."
    a "我累了。带着你的跟班滚出我的视线。"

#game/script.rpy:2616
translate chinese anna_71f342d9:

    # D "Bitch could’ve waited a little longer with this..."
    D "这婊子本可以再等等的……"

#game/script.rpy:2619
translate chinese anna_9022a519:

    # D "Hey, kids. Can we wrap this up?"
    D "嘿，孩子们。能快点完事吗？"

#game/script.rpy:2620
translate chinese anna_5d860d27:

    # D "I’ve got to pick up my kid from my ex."
    D "我还得去前妻那儿接孩子。"

#game/script.rpy:2624
translate chinese anna_2b35b6fe_1:

    # mc "..."
    mc "……"

#game/script.rpy:2626
translate chinese anna_36ec17e3:

    # mc "Easy…"
    mc "别动……"

#game/script.rpy:2627
translate chinese anna_ddd8ffec:

    # mc "Don’t move."
    mc "别动。"

#game/script.rpy:2628
translate chinese anna_f4e14abc:

    # mc "Who sent you?"
    mc "谁派你来的？"

#game/script.rpy:2630
translate chinese anna_4101c591:

    # D "I-I don’t know what you’re talking about, m-man."
    D "我——我不知道你在说什么，老——老兄。"

#game/script.rpy:2631
translate chinese anna_534c8489:

    # D "I-I was told to keep an eye on those k-kids."
    D "我——我被告知盯着那些小——小孩。"

#game/script.rpy:2636
translate chinese anna_adadf7ee:

    # mc "(Someone’s got a death wish… going against Olivia.)"
    mc "（有人找死……跟奥利维亚作对。）"

#game/script.rpy:2639
translate chinese anna_3f40bee3:

    # e "And what would a girl like her see in a loser like you? What, she into weaklings?"
    e "她那样的女孩能看上你这种废物？怎么，她喜欢软蛋？"

#game/script.rpy:2641
translate chinese anna_df8be869:

    # C "Oh wow… that’s your move? Beg, fail, and then stand there like furniture?"
    C "哦哇……这就是你的招数？求饶、失败，然后像个家具一样杵着？"

#game/script.rpy:2644
translate chinese anna_1221c371:

    # e "Really? That’s great, mind if we get to know each other better?"
    e "真的？太好了，介意我们深入了解一下吗？"

#game/script.rpy:2645
translate chinese anna_86c1f8b1:

    # e "I’m sure we’d have a very memorable time."
    e "我保证我们会度过一段难忘的时光。"

#game/script.rpy:2647
translate chinese anna_f98d475a:

    # e "Might even make each other... feel things."
    e "甚至可能让彼此……有感觉。"

#game/script.rpy:2649
translate chinese anna_36a673b6:

    # C "You think this is flirting? That’s cute. Really. Almost embarrassing."
    C "你觉得这是调情？真可爱。真的。几乎让人尴尬。"

#game/script.rpy:2651
translate chinese anna_28eb1bbd:

    # C "Kid, clean the milk off your lips before you start talking like you’ve seen the world."
    C "小子，先把嘴边的奶擦干净再装见多识广。"

#game/script.rpy:2652
translate chinese anna_65cf20b3:

    # C "And maybe, just maybe, learn who you’re barking at before you open your mouth again."
    C "还有，也许，只是也许，下次开口前先搞清楚你在冲谁吠。"

#game/script.rpy:2655
translate chinese anna_e741b13c:

    # d "We don’t care who you are — even if you’re Beastie’s little sister."
    d "我们不在乎你是谁——就算你是野兽的小妹妹。"

#game/script.rpy:2656
translate chinese anna_4382d94c:

    # d "We’re gonna have some real fun with you, then dump you in a ditch."
    d "我们会好好玩玩你，然后把你扔进沟里。"

#game/script.rpy:2658
translate chinese anna_4c238468:

    # d "Though, to be fair, you’re the best catch we’ve had in a while."
    d "不过说真的，你是我们这段时间抓到的最好的货。"

#game/script.rpy:2660
translate chinese anna_d1cf0328:

    # d "So thanks to this idiot for handing you over."
    d "所以谢谢这个白痴把你交出来。"

#game/script.rpy:2662
translate chinese anna_4686d521:

    # j "Sorry..."
    j "对不起……"

#game/script.rpy:2664
translate chinese anna_4fcbe6bd:

    # d "What a fucking moron."
    d "真是个他妈的白痴。"

#game/script.rpy:2666
translate chinese anna_948a063d:

    # d "Y’know what? I just had a brilliant idea."
    d "你知道吗？我刚想到个绝妙的主意。"

#game/script.rpy:2667
translate chinese anna_cb904140:

    # d "How about we entertain ourselves, with him watching?"
    d "不如我们找点乐子，让他在旁边看着？"

#game/script.rpy:2668
translate chinese anna_f5a954d4:

    # d "Bet the poor bastard loses his mind."
    d "赌这可怜虫会疯掉。"

#game/script.rpy:2670
translate chinese anna_659468de:

    # C "Touch me… and I promise you won’t need to worry about girls ever again."
    C "碰我……我保证你再也不用操心女人的事了。"

#game/script.rpy:2672
translate chinese anna_6b3157d4:

    # C "Actually, scratch that. Judging by the way you act? Might already be a lost cause."
    C "其实，收回前言。看你这德行？可能早就没救了。"

#game/script.rpy:2678
translate chinese anna_c1ee60d7:

    # d "Feisty tongue."
    d "嘴挺辣。"

#game/script.rpy:2679
translate chinese anna_62fcc2e4:

    # d "Would work great somewhere else."
    d "用在别的地方会更好。"

#game/script.rpy:2681
translate chinese anna_5f9346d3:

    # mc "I wouldn’t count on that."
    mc "我可不这么认为。"

#game/script.rpy:2683
translate chinese anna_b4ac2140:

    # d "Huh? Who’s the old guy?"
    d "嗯？这老头是谁？"

#game/script.rpy:2685
translate chinese anna_7b591006:

    # d "Do you even know who I am, old man?"
    d "你知道我是谁吗，老头？"

#game/script.rpy:2686
translate chinese anna_5e996f76:

    # d "Get lost before we send you to a nursing home."
    d "滚开，不然我们送你去养老院。"

#game/script.rpy:2693
translate chinese anna_74af3728:

    # mc "Tell me something, gentlemen."
    mc "告诉我，先生们。"

#game/script.rpy:2694
translate chinese anna_f4e14abc_1:

    # mc "Who sent you?"
    mc "谁派你们来的？"

#game/script.rpy:2695
translate chinese anna_1f432b6d:

    # mc "Choose your words carefully."
    mc "措辞小心点。"

#game/script.rpy:2696
translate chinese anna_a1e8814c:

    # mc "I’d rather not get my hands dirty again."
    mc "我不想再弄脏手。"

#game/script.rpy:2698
translate chinese anna_01abe800:

    # d "K-kh… What’re you talking about, old man? N-no one sent us!"
    d "咳——你说什么，老头？没——没人派我们来！"

#game/script.rpy:2701
translate chinese anna_3c82d6a1:

    # d "Alright, alright! L-look, we were told to bring that girl in, alive, as a hostage."
    d "行行行！看——我们被告知把那女孩活着带回去当人质。"

#game/script.rpy:2702
translate chinese anna_7de01418:

    # d "That’s all I know!"
    d "我就知道这些！"

#game/script.rpy:2703
translate chinese anna_2b35b6fe_2:

    # mc "..."
    mc "……"

#game/script.rpy:2705
translate chinese anna_7b471f6f:

    # mc "Good."
    mc "很好。"

#game/script.rpy:2706
translate chinese anna_8aa0e1b5:

    # mc "If I find out you lied…"
    mc "如果我查出你撒谎……"

#game/script.rpy:2707
translate chinese anna_dd7680ce:

    # mc "you won’t get a second chance."
    mc "你不会有机会。"

#game/script.rpy:2710
translate chinese anna_cf610ce8:

    # e "Hey, old fart! Who the hell do you think you are?!"
    e "嘿，老东西！你以为你是谁？！"

#game/script.rpy:2712
translate chinese anna_08b6abd2:

    # e "If our bosses hear about you, you’re dead meat! You hea—"
    e "要是我们老大听说了你，你就死定了！你听——"

#game/script.rpy:2723
translate chinese anna_15d75986:

    # C "That’s for putting your hands on me, you piece of shit."
    C "这是你碰我的代价，你这坨屎。"

#game/script.rpy:2725
translate chinese anna_fa8cf989:

    # mc "Who were those guys?"
    mc "那些家伙是谁？"

#game/script.rpy:2727
translate chinese anna_0874afc7:

    # C "Wish I knew… Sis is gonna flip when she hears about this."
    C "希望我知道……姐姐听说了会炸的。"

#game/script.rpy:2729
translate chinese anna_2b03cf49:

    # C "Still… thanks, [mc]. Seriously. I’ve lost count how many times you’ve bailed us out."
    C "不过……谢谢，[mc]。说真的。我都数不清你帮我们解了多少次围。"

#game/script.rpy:2731
translate chinese anna_25026f07:

    # d "You bastard! I won’t forget this!"
    d "你这混蛋！我不会忘的！"

#game/script.rpy:2739
translate chinese anna_bb113594:

    # d "You’ll pay for humiliating me!"
    d "你会为羞辱我付出代价！"

#game/script.rpy:2742
translate chinese anna_3649b05b:

    # d "DIE!"
    d "去死！"

#game/script.rpy:2744
translate chinese anna_8c633f94:

    # C "hic!"
    C "嗝！"

#game/script.rpy:2752
translate chinese anna_c39ad17c:

    # mc "(Amateurs.)"
    mc "（业余的。）"

#game/script.rpy:2753
translate chinese anna_09c879ac:

    # C "You okay? He had a knife!"
    C "你没事吧？他拿着刀！"

#game/script.rpy:2755
translate chinese anna_2b35b6fe_3:

    # mc "..."
    mc "……"

#game/script.rpy:2757
translate chinese anna_895037ab:

    # mc "I’m fine."
    mc "我没事。"

#game/script.rpy:2758
translate chinese anna_7967e82f:

    # mc "What do we do with him?"
    mc "拿他怎么办？"

#game/script.rpy:2759
translate chinese anna_194fd966:

    # C "This one? God, I’d love to finish him right here… but nah."
    C "这个？天啊，我真想就地解决他……但算了。"

#game/script.rpy:2760
translate chinese anna_b9932f98:

    # C "Get lost. While you still can."
    C "滚吧。趁你还能滚。"

#game/script.rpy:2771
translate chinese anna_9fe5a601:

    # C "And don’t show your face again, rat. Next time I won’t be this nice."
    C "别再让我看到你的脸，老鼠。下次我可没这么客气。"

#game/script.rpy:2773
translate chinese anna_f59df8cd:

    # j "You won’t see me again!"
    j "你不会再见到我了！"

#game/script.rpy:2775
translate chinese anna_dd759c35:

    # C "Creepy, right? First he drags me into this, then they try to gut him."
    C "诡异吧？先是他把我拖进来，然后他们又想捅他。"

#game/script.rpy:2777
translate chinese anna_17f42347:

    # C "What? I’m serious. Getting stabbed in the back? Feels like absolute garbage."
    C "怎么？我说真的。被背后捅刀？感觉糟透了。"

#game/script.rpy:2780
translate chinese anna_2b35b6fe_4:

    # mc "..."
    mc "……"

#game/script.rpy:2782
translate chinese anna_5f30dc14:

    # mc "How’d you even get into that mess?"
    mc "你怎么卷进这摊浑水的？"

#game/script.rpy:2792
translate chinese anna_3e05e351:

    # C "Yeah, I know, I know… sounds stupid."
    C "是，我知道，我知道……听起来很蠢。"

#game/script.rpy:2793
translate chinese anna_00879fb8:

    # C "Jack calls me, says he’s in trouble. I’m like, fine, why not."
    C "杰克打电话给我，说他遇到麻烦了。我想，行吧，为什么不去。"

#game/script.rpy:2795
translate chinese anna_46468382:

    # C "I get there, and he’s on his knees in front of some thugs."
    C "我到了那儿，他跪在一群混混面前。"

#game/script.rpy:2797
translate chinese anna_2c7774db:

    # C "So I step in, thinking they’ll get scared and scatter."
    C "所以我插手了，以为他们会害怕散开。"

#game/script.rpy:2799
translate chinese anna_81640c92:

    # C "You know how it usually goes with me."
    C "你知道我通常怎么处理的。"

#game/script.rpy:2801
translate chinese anna_1b42164e:

    # C "See someone in trouble… hype myself up… jump in headfirst."
    C "看到有人有麻烦……给自己打气……一头扎进去。"

#game/script.rpy:2803
translate chinese anna_84c23421:

    # C "Most of the time? They’re grateful. And I know exactly who I’m dealing with."
    C "大多数时候？他们感激。而且我清楚自己在对付谁。"

#game/script.rpy:2805
translate chinese anna_54aa8f8c:

    # C "If it’s some serious gang shit, I’m out."
    C "如果是严重的帮派事，我就撤。"

#game/script.rpy:2806
translate chinese anna_76b7b032:

    # C "But punks like these? Why not have a little fun."
    C "但这种小混混？何不找点乐子。"

#game/script.rpy:2808
translate chinese anna_97334a33:

    # C "You help people like that, word spreads."
    C "你帮了那种人，消息就传开了。"

#game/script.rpy:2809
translate chinese anna_3693358d:

    # C "‘Oh, they’re nice, they’ve got your back’- boom, reputation up, money up. Easy."
    C "“哦，他们人好，会罩着你”——砰，名声涨，钱涨。简单。"

#game/script.rpy:2811
translate chinese anna_2dbbfb40:

    # mc "That’s… one way to look at it."
    mc "这……也是一种看法。"

#game/script.rpy:2812
translate chinese anna_b076f446:

    # mc "But this time it went sideways."
    mc "但这次出岔子了。"

#game/script.rpy:2814
translate chinese anna_965b1579:

    # mc "What if I didn’t show up?"
    mc "要是我没出现呢？"

#game/script.rpy:2821
translate chinese anna_f0247634:

    # C "Honestly? {w}No clue."
    C "说实话？{w}不知道。"

#game/script.rpy:2822
translate chinese anna_3e06dbef:

    # C "They’d probably pass me around… or just take what they want."
    C "他们可能会把我轮着来……或者直接拿走他们想要的。"

#game/script.rpy:2823
translate chinese anna_6fbc0ad9:

    # C "Wouldn’t be the first time someone tried."
    C "又不是第一次有人这么干。"

#game/script.rpy:2825
translate chinese anna_2b35b6fe_5:

    # mc "..."
    mc "……"

#game/script.rpy:2827
translate chinese anna_9e63e9d9:

    # mc "You’ve got a strange way of looking at things."
    mc "你看事情的方式挺奇怪。"

#game/script.rpy:2829
translate chinese anna_26a803bc:

    # C "..."
    C "……"

#game/script.rpy:2831
translate chinese anna_eefed0d9:

    # mc "If I hadn’t stepped in… your sister would’ve had my head."
    mc "要是我没插手……你姐姐会要我的命。"

#game/script.rpy:2834
translate chinese anna_629d3482:

    # mc "You really know how to cause her trouble."
    mc "你真是会给她惹麻烦。"

#game/script.rpy:2837
translate chinese anna_6a393139:

    # C "Wouldn’t be me otherwise."
    C "不然就不是我了。"

#game/script.rpy:2838
translate chinese anna_a00758fe:

    # C "Had to deal with her crap growing up—now it’s her turn."
    C "小时候受她的气——现在轮到她了。"

#game/script.rpy:2841
translate chinese anna_943118d6:

    # mc "Wait… you do this on purpose?"
    mc "等等……你是故意的？"

#game/script.rpy:2843
translate chinese anna_b3705063:

    # C "Of course. What, you think I’m stupid or something?"
    C "当然。怎么，你觉得我傻？"

#game/script.rpy:2844
translate chinese anna_2b35b6fe_6:

    # mc "..."
    mc "……"

#game/script.rpy:2847
translate chinese anna_4c5115c1:

    # C "Hey! Rude!"
    C "嘿！没礼貌！"

#game/script.rpy:2848
translate chinese anna_556cdece:

    # mc "Kidding."
    mc "开玩笑。"

#game/script.rpy:2849
translate chinese anna_cb0b1323:

    # C "(sigh)…you’re unbelievable."
    C "（叹气）……你真让人无语。"

#game/script.rpy:2851
translate chinese anna_4281e0a1:

    # C "So… what’s the plan for tonight?"
    C "那么……今晚有什么安排？"

#game/script.rpy:2852
translate chinese anna_f0f87a6a:

    # mc "{b}We{/b} don’t have plans."
    mc "{b}我们{/b}没安排。"

#game/script.rpy:2855
translate chinese anna_21b6e183:

    # mc "{b}I{/b} do."
    mc "{b}我{/b}有。"

#game/script.rpy:2856
translate chinese anna_1678c1f9:

    # mc "I’m meeting your sister."
    mc "我要去见你姐姐。"

#game/script.rpy:2857
translate chinese anna_21d9959f:

    # C "Ugh, you’re {b}such{/b} a grump."
    C "呃，你{b}真{/b}是个扫兴鬼。"

#game/script.rpy:2862
translate chinese anna_bb8e4b4e_1:

    # a "..."
    a "……"

#game/script.rpy:2879
translate chinese anna_436a296c:

    # D "Ah..."
    D "啊……"

#game/script.rpy:2881
translate chinese anna_0834e132:

    # D "Ah... My head...."
    D "啊……我的头……"

#game/script.rpy:2883
translate chinese anna_cb8aec84:

    # D "..."
    D "……"

#game/script.rpy:2885
translate chinese anna_b2c5730a:

    # D "(What the hell is this?)"
    D "（这他妈是什么？）"

#game/script.rpy:2889
translate chinese anna_e199ba8a:

    # aa "{font=Cybertron.otf}What do we do with him? He didn’t try to harm our target."
    aa "{font=Cybertron.otf}拿他怎么办？他没试图伤害目标。"

#game/script.rpy:2891
translate chinese anna_e634bff9:

    # a "{font=Cybertron.otf}He saw us — that’s unacceptable."
    a "{font=Cybertron.otf}他看见我们了——这不可接受。"

#game/script.rpy:2900
translate chinese anna_47bf0074:

    # C "You know… I might not show it, but I was actually really glad I ran into you back there."
    C "你知道……我可能没表现出来，但我其实很高兴在那儿遇到你。"

#game/script.rpy:2901
translate chinese anna_e9ce1a42:

    # C "So… what are you even doing here?"
    C "那么……你到底在这儿干什么？"

#game/script.rpy:2904
translate chinese anna_b00beead:

    # mc "Honestly… I’m a bit out of place here."
    mc "说实话……我在这儿有点格格不入。"

#game/script.rpy:2907
translate chinese anna_bb930076:

    # C "You’re the only one who thinks that, you know."
    C "只有你这么想，你知道吗。"

#game/script.rpy:2908
translate chinese anna_e54921bf:

    # C "You should come by more often."
    C "你该多来。"

#game/script.rpy:2909
translate chinese anna_efc7e09f:

    # C "Sis would be way too happy about it."
    C "姐姐会高兴坏的。"

#game/script.rpy:2913
translate chinese anna_50c00c04:

    # x "No way… My eyes must be deceiving me!"
    x "不会吧……我眼睛出问题了吗！"

#game/script.rpy:2915
translate chinese anna_a62cabb3:

    # mc "I know that voice…"
    mc "我认得这声音……"

#game/script.rpy:2918
translate chinese anna_a7cbfb9e:

    # x "HERMANO! What brings you here?!"
    x "兄弟！什么风把你吹来了？！"

#game/script.rpy:2921
translate chinese anna_32b4bc1a:

    # x "Great to see you, amigo! 15 years, and you’ve only gotten stronger!"
    x "见到你太好了，朋友！十五年，你只是更强了！"

#game/script.rpy:2926
translate chinese anna_7c3045f8:

    # x "Still training, huh? You’re in great shape as always, Commander!"
    x "还在训练？你一如既往地状态好，指挥官！"

#game/script.rpy:2928
translate chinese anna_3a285f4f:

    # mc "Good to see you too."
    mc "见到你也好。"

#game/script.rpy:2929
translate chinese anna_b33d3241:

    # mc "You look steady."
    mc "你看起来稳。"

#game/script.rpy:2931
translate chinese anna_351aed3a:

    # x "Best prosthetic money can buy, hermano."
    x "能买到的最好的假肢，兄弟。"

#game/script.rpy:2932
translate chinese anna_58d77330:

    # x "Still complains when it rains, though."
    x "不过下雨时还是会抱怨。"

#game/script.rpy:2933
translate chinese anna_e747de4d:

    # x "But hey. Could've been worse."
    x "但嘿。本来可能更糟。"

#game/script.rpy:2935
translate chinese anna_cf1adef2_1:

    # mc "Yeah."
    mc "是啊。"

#game/script.rpy:2936
translate chinese anna_631111f4:

    # x "Mona and Jack didn't get to complain."
    x "莫娜和杰克可没机会抱怨。"

#game/script.rpy:2937
translate chinese anna_7156b3f9:

    # mc "But what are you doing here, Alexandro?"
    mc "但你在这儿干什么，亚历山德罗？"

#game/script.rpy:2939
translate chinese anna_64503be1:

    # x "Hahaha! A lot’s changed since we last met."
    x "哈哈哈！自从上次见面变了很多。"

#game/script.rpy:2944
translate chinese anna_7696db35:

    # x "You know better than anyone, Commander — vets have a hard time finding honest work these days."
    x "你比谁都清楚，指挥官——退伍军人现在很难找到正经工作。"

#game/script.rpy:2945
translate chinese anna_91d9516c:

    # x "Gotta feed the family, right?"
    x "得养家糊口，对吧？"

#game/script.rpy:2948
translate chinese anna_9d5e56ee:

    # x "Thanks to Miss Anya and Olivia, I can take care of my family without depriving them of anything."
    x "多亏安雅小姐和奥利维亚，我能养家而不让他们缺什么。"

#game/script.rpy:2949
translate chinese anna_349471c6:

    # x "I’m truly grateful to them."
    x "我真心感激她们。"

#game/script.rpy:2951
translate chinese anna_3ebffef6:

    # C "If anything, we should be thanking you."
    C "要说的话，我们该谢你。"

#game/script.rpy:2952
translate chinese anna_4c0b77d8:

    # C "Not every place gets a guard like you."
    C "不是每个地方都能有你这样的守卫。"

#game/script.rpy:2953
translate chinese anna_f172980f:

    # C "So yeah… works out pretty damn well for us."
    C "所以……对我们来说挺不错的。"

#game/script.rpy:2955
translate chinese anna_3745764e:

    # mc "I’m glad it worked out for you."
    mc "我很高兴你有了着落。"

#game/script.rpy:2958
translate chinese anna_a21e86ee:

    # x "..."
    x "……"

#game/script.rpy:2960
translate chinese anna_ef2434ce:

    # x "Commander… You okay? You look—"
    x "指挥官……你没事吧？你看起来——"

#game/script.rpy:2963
translate chinese anna_2b35b6fe_7:

    # mc "..."
    mc "……"

#game/script.rpy:2964
translate chinese anna_a21e86ee_1:

    # x "..."
    x "……"

#game/script.rpy:2966
translate chinese anna_e40e9c51:

    # x "Sorry, sir, I have to take this call."
    x "抱歉，长官，我得接这个电话。"

#game/script.rpy:2970
translate chinese anna_544da1bf:

    # x "Yes?"
    x "喂？"

#game/script.rpy:2972
translate chinese anna_a21e86ee_2:

    # x "..."
    x "……"

#game/script.rpy:2974
translate chinese anna_f1e96b70:

    # mc "(Is it that obvious…?)"
    mc "（有那么明显吗……？）"

#game/script.rpy:2976
translate chinese anna_6fe6fa3a:

    # mc "(Or was I just lying to myself…?)"
    mc "（还是我一直在骗自己……？）"

#game/script.rpy:2980
translate chinese anna_587302da:

    # x "WHAT?!"
    x "什么？！"

#game/script.rpy:2981
translate chinese anna_6a8a18b9:

    # x "No way… "
    x "不会吧……"

#game/script.rpy:2982
translate chinese anna_876eda85:

    # x "How could they—"
    x "他们怎么可以——"

#game/script.rpy:2983
translate chinese anna_e8f87c21:

    # x "They threw out…... {w=1}my {w=1}plush crocodiles?!"
    x "他们扔掉了……{w=1}我的{w=1}毛绒鳄鱼？！"

#game/script.rpy:2987
translate chinese anna_413aaee4:

    # x "NOOOOOOOOOOO!"
    x "不——！"

#game/script.rpy:2989
translate chinese anna_e3c0de3c:

    # x "My croc babies… They tossed them… in the trash…"
    x "我的鳄鱼宝宝……他们把它们……扔进垃圾桶了……"

#game/script.rpy:2990
translate chinese anna_850ef128:

    # b "..."
    b "……"

#game/script.rpy:2992
translate chinese anna_8fd66b4b:

    # mc "…You good?"
    mc "……你还好吗？"

#game/script.rpy:2994
translate chinese anna_41bb0b3b:

    # C "He’s like this every time someone mentions his crocodiles."
    C "每次有人提到他的鳄鱼他都这样。"

#game/script.rpy:2996
translate chinese anna_27e69cf6:

    # mc "…We didn’t see that."
    mc "……我们什么都没看见。"

#game/script.rpy:2998
translate chinese anna_36d39742:

    # C "Yeah… let’s just pretend none of that happened."
    C "嗯……就当什么都没发生。"

#game/script.rpy:3002
translate chinese anna_b894cf57:

    # mc "Good seeing you again, Alex."
    mc "很高兴再见到你，亚历克斯。"

#game/script.rpy:3013
translate chinese bar_olivica_edf5355d:

    # C "Well… welcome to our very humble little spot."
    C "那么……欢迎来到我们非常简陋的小地方。"

#game/script.rpy:3014
translate chinese bar_olivica_07890832:

    # C "Try not to judge too hard."
    C "别太挑剔。"

#game/script.rpy:3016
translate chinese bar_olivica_c096500c:

    # mc "If this is humble, I’d hate to see what you call not humble."
    mc "如果这叫简陋，我可不想看你所谓的不简陋。"

#game/script.rpy:3018
translate chinese bar_olivica_8dee34dd:

    # C "Thanks. We actually put a ton of work into this place."
    C "谢谢。我们其实在这地方花了很多功夫。"

#game/script.rpy:3019
translate chinese bar_olivica_76d92c76:

    # C "Expanded it, redid the whole interior…"
    C "扩建了，重做了整个内饰……"

#game/script.rpy:3021
translate chinese bar_olivica_82947a6f:

    # C "Now it’s more like a proper lounge instead of that sad excuse of a bar we had before."
    C "现在更像样的休息室了，而不是之前那个寒酸的破酒吧。"

#game/script.rpy:3023
translate chinese bar_olivica_832f3dc6:

    # C "Then again… calling it a bar back then is generous."
    C "不过……那时候叫它酒吧都算抬举。"

#game/script.rpy:3024
translate chinese bar_olivica_7cffe277:

    # C "It was more like a warehouse."
    C "更像仓库。"

#game/script.rpy:3025
translate chinese bar_olivica_c8d77481:

    # C "…Or something worse."
    C "……或者更糟的东西。"

#game/script.rpy:3027
translate chinese bar_olivica_2b35b6fe:

    # mc "..."
    mc "……"

#game/script.rpy:3029
translate chinese bar_olivica_0366ce67:

    # C "Anyway—"
    C "总之——"

#game/script.rpy:3030
translate chinese bar_olivica_c599426c:

    # C "What’s up with you?"
    C "你怎么样？"

#game/script.rpy:3032
translate chinese bar_olivica_b1feb6a8:

    # mc "I’ll admit… I’m impressed."
    mc "我承认……我挺惊讶。"

#game/script.rpy:3033
translate chinese bar_olivica_02a994d9:

    # mc "But how the hell did you pull this off?"
    mc "但你到底怎么做到的？"

#game/script.rpy:3035
translate chinese bar_olivica_567dc2b9:

    # C "(Deep sigh) …mmh."
    C "（深吸气）……嗯。"

#game/script.rpy:3037
translate chinese bar_olivica_ed6af8a7:

    # C "That’s a secret I’m not ready to spill just yet."
    C "这秘密我还不打算说。"

#game/script.rpy:3038
translate chinese bar_olivica_00bcc221:

    # C "Gotta keep some mystery, you know?"
    C "总得留点神秘感，对吧？"

#game/script.rpy:3040
translate chinese bar_olivica_48fc64b0:

    # mc "Yeah… figures."
    mc "是啊……果然。"

#game/script.rpy:3041
translate chinese bar_olivica_6f62820e:

    # mc "She had a hand in this, didn’t she?"
    mc "她插手了吧？"

#game/script.rpy:3043
translate chinese bar_olivica_c2160927:

    # C "I mean… it wasn’t just her."
    C "我是说……不只是她。"

#game/script.rpy:3044
translate chinese bar_olivica_6e8f3500:

    # C "But yeah, Olivia carried most of it."
    C "但没错，大部分是奥利维亚扛的。"

#game/script.rpy:3045
translate chinese bar_olivica_28d29150:

    # C "Permits, paperwork, investors… she handled all that boring hell."
    C "许可、文件、投资人……那些无聊的地狱都是她处理的。"

#game/script.rpy:3047
translate chinese bar_olivica_cd1ce94c:

    # C "Even pulled in some serious sponsors… no idea why they trusted us, but hey."
    C "还拉来了一些大赞助商……不知道他们为什么信任我们，不过嘿。"

#game/script.rpy:3048
translate chinese bar_olivica_c845ee34:

    # C "…How are you holding up?"
    C "……你还好吗？"

#game/script.rpy:3049
translate chinese bar_olivica_273687f7:

    # C "We heard what happened."
    C "我们听说了发生的事。"

#game/script.rpy:3050
translate chinese bar_olivica_97f733c6:

    # C "She really was… something else."
    C "她真的是……与众不同。"

#game/script.rpy:3052
translate chinese bar_olivica_2b35b6fe_1:

    # mc "..."
    mc "……"

#game/script.rpy:3054
translate chinese bar_olivica_0faa46ad:

    # mc "Yeah…"
    mc "是啊……"

#game/script.rpy:3055
translate chinese bar_olivica_9a9ab2a0:

    # mc "She was."
    mc "她是。"

#game/script.rpy:3057
translate chinese bar_olivica_0453b79:

    # mc "So… did you get into that university?"
    mc "那么……你进那所大学了吗？"

#game/script.rpy:3058
translate chinese bar_olivica_469e4353:

    # mc "That was your plan, right?"
    mc "那是你的计划，对吧？"

#game/script.rpy:3066
translate chinese bar_olivica_850ef128:

    # b "..."
    b "……"

#game/script.rpy:3072
translate chinese bar_olivica_824d400c:

    # mc "Someone over there looks ready to blow."
    mc "那边有人看起来快炸了。"

#game/script.rpy:3074
translate chinese bar_olivica_0c2a221e:

    # C "No clue who you’re talking about."
    C "不知道你说谁。"

#game/script.rpy:3081
translate chinese bar_olivica_4d82ff0e:

    # h "Touch me again—"
    h "再碰我一下——"

#game/script.rpy:3082
translate chinese bar_olivica_ac17b8d4:

    # h "I swear, I’ll drop you where you stand."
    h "我发誓，我让你当场倒下。"

#game/script.rpy:3084
translate chinese bar_olivica_0205bdaa:

    # h "Now."
    h "现在。"

#game/script.rpy:3086
translate chinese bar_olivica_bad1d9fe:

    # h "Run."
    h "滚。"

#game/script.rpy:3087
translate chinese bar_olivica_9ec27acc:

    # h "Before I start taking fingers."
    h "趁我还没开始收手指。"

#game/script.rpy:3089
translate chinese bar_olivica_7568d73f:

    # C "Oof… yeah. That’s rage mode."
    C "哎哟……嗯。那是暴怒模式。"

#game/script.rpy:3090
translate chinese bar_olivica_cd9047df:

    # C "She’s really pissed."
    C "她真火了。"

#game/script.rpy:3092
translate chinese bar_olivica_c8d5820a:

    # mc "Yeah… she hasn’t changed."
    mc "是啊……她没变。"

#game/script.rpy:3094
translate chinese bar_olivica_c19f4471:

    # C "She kinda has to be like that."
    C "她不得不这样。"

#game/script.rpy:3095
translate chinese bar_olivica_046b908c:

    # C "Every day it’s the same story, some cocky idiot thinks he’s special."
    C "每天都一样，某个自大的白痴觉得自己很特别。"

#game/script.rpy:3096
translate chinese bar_olivica_9dbc97fa:

    # C "Thinks he’s getting into her pants."
    C "以为能上她的床。"

#game/script.rpy:3100
translate chinese bar_olivica_2fded262:

    # h "..."
    h "……"

#game/script.rpy:3102
translate chinese bar_olivica_8a2f5596:

    # mc "All these years… and you’re still the same."
    mc "这么多年……你还是老样子。"

#game/script.rpy:3104
translate chinese bar_olivica_26be1618:

    # mc "…Hey."
    mc "……嘿。"

#game/script.rpy:3106
translate chinese bar_olivica_2fded262_1:

    # h "..."
    h "……"

#game/script.rpy:3108
translate chinese bar_olivica_15e02bff:

    # h "And what brings you here?"
    h "什么风把你吹来了？"

#game/script.rpy:3110
translate chinese bar_olivica_b12ff16f:

    # mc "Figured I’d stop by."
    mc "想过来看看。"

#game/script.rpy:3111
translate chinese bar_olivica_cfc83f43:

    # mc "See how you’re holding up."
    mc "看看你怎么样。"

#game/script.rpy:3113
translate chinese bar_olivica_e13b5a7c:

    # C "Sis, ever thought about not scaring off the customers?"
    C "姐，想过别把客人吓跑吗？"

#game/script.rpy:3115
translate chinese bar_olivica_b1831d79:

    # h "How I’ve been…?"
    h "我怎么样……？"

#game/script.rpy:3116
translate chinese bar_olivica_c1dff379:

    # h "Oh, I’m thriving."
    h "哦，我活得很好。"

#game/script.rpy:3117
translate chinese bar_olivica_0a06458c:

    # h "Can’t you tell?"
    h "看不出来吗？"

#game/script.rpy:3119
translate chinese bar_olivica_2124740c:

    # h "Signed contracts."
    h "签了合同。"

#game/script.rpy:3120
translate chinese bar_olivica_3bb1467a:

    # h "Pulled sponsors."
    h "拉了赞助。"

#game/script.rpy:3121
translate chinese bar_olivica_5f6abc6d:

    # h "Expanded the place…"
    h "扩建了店面……"

#game/script.rpy:3122
translate chinese bar_olivica_ddaf8aa4:

    # h "Even opened another bar across town."
    h "还在城那头开了另一家酒吧。"

#game/script.rpy:3124
translate chinese bar_olivica_6cf7a5bb:

    # C "Hey! Don’t ignore me!"
    C "嘿！别无视我！"

#game/script.rpy:3127
translate chinese bar_olivica_0e5676c8:

    # C "Wait… are you actually upset?"
    C "等等……你真的生气了？"

#game/script.rpy:3131
translate chinese bar_olivica_2fded262_2:

    # h "..."
    h "……"

#game/script.rpy:3133
translate chinese bar_olivica_50435b7f:

    # C "Poke."
    C "戳。"

#game/script.rpy:3135
translate chinese bar_olivica_bbff499d:

    # C "C’mon, don’t sulk."
    C "来嘛，别生闷气。"

#game/script.rpy:3136
translate chinese bar_olivica_5cc63ccb:

    # C "So I ignored your messages. Big deal."
    C "我是没回你消息。有什么大不了的。"

#game/script.rpy:3138
translate chinese bar_olivica_d9c9dcff:

    # C "Now quit that and go charm our guest."
    C "别这样了，去招呼我们的客人。"

#game/script.rpy:3139
translate chinese bar_olivica_bee2d9db:

    # C "You’ve got that scary-smile combo, use it."
    C "你有那种吓人微笑组合，用起来。"

#game/script.rpy:3141
translate chinese bar_olivica_26a803bc:

    # C "..."
    C "……"

#game/script.rpy:3143
translate chinese bar_olivica_c9670655:

    # h "It’s the same loop, {w=0.7}sleep, {w=0.5}work, {w=0.4}sleep, {w=0.3}work, {w=0.2}SLEEP, {w=0.1}WORK…"
    h "还是同样的循环，{w=0.7}睡觉，{w=0.5}工作，{w=0.4}睡觉，{w=0.3}工作，{w=0.2}睡觉，{w=0.1}工作……"

#game/script.rpy:3145
translate chinese bar_olivica_066fc800:

    # h "I’m so fed up with it, you know? {w=0.9}HA-{w=0.2}HA-{w=0.1}HA, {w=0.5}Seven years — same damn grind. {w=1.2}And what do I have?{w=0.9} No boyfriend. {w=0.5}No husband. {w=0.3}Nothing."
    h "我受够了，你知道吗？{w=0.9}哈——{w=0.2}哈——{w=0.1}哈，{w=0.5}七年——同样的苦差事。{w=1.2}我有什么？{w=0.9}没男友。{w=0.5}没丈夫。{w=0.3}什么都没有。"

#game/script.rpy:3147
translate chinese bar_olivica_86d7178e:

    # h "Meanwhile everyone else? Married. Kids. {w=0.9}CAN YOU BELIEVE IT? {w=0.7}AND THEY JUST LOVE REMINDING TO ME, {w=0.6}LAUGHING, {w=0.3}LIKE IT'S FUNNY."
    h "而其他人呢？结婚了。有孩子。{w=0.9}你能信吗？{w=0.7}他们还就爱提醒我，{w=0.6}笑着，{w=0.3}好像很好笑似的。"

#game/script.rpy:3149
translate chinese bar_olivica_5dcb2707:

    # h "But whatever, just forget it. {w=0.9}And to top it all off, {w=0.7}you know, I haven’t had a good {w=0.7}SCREW since THAT NIGHT… {w=0.7}FOR YEARS, AND YOU’RE STANDING HERE ASKING ME HOW I’M DOING???"
    h "但算了，别提了。{w=0.9}最要命的是，{w=0.7}你知道吗，自从那晚之后我就没好好{w=0.7}爽过……{w=0.7}好几年了，你还站在这儿问我过得怎么样？？？"

#game/script.rpy:3153
translate chinese bar_olivica_90734342:

    # h "I’m doing amazing."
    h "我过得好极了。"

#game/script.rpy:3154
translate chinese bar_olivica_3c27171a:

    # h "Really."
    h "真的。"

#game/script.rpy:3155
translate chinese bar_olivica_e7570b0e:

    # h "Couldn’t be better."
    h "再好不过了。"

#game/script.rpy:3158
translate chinese bar_olivica_2b35b6fe_2:

    # mc "..."
    mc "……"

#game/script.rpy:3159
translate chinese bar_olivica_d20cd7c8:

    # a "You know we’d love to spend the night with you!"
    a "你知道我们很想和你过夜！"

#game/script.rpy:3161
translate chinese bar_olivica_7fb8b532:

    # h "Yeah, yeah, get lost."
    h "行了行了，滚。"

#game/script.rpy:3163
translate chinese bar_olivica_9e8f551c:

    # mc "Sounds like it’s been a long few years."
    mc "听起来这几年挺难熬。"

#game/script.rpy:3164
translate chinese bar_olivica_ebe63ac3:

    # mc "But after all this time…"
    mc "但过了这么久……"

#game/script.rpy:3165
translate chinese bar_olivica_5756eeae:

    # mc "With the way people look at you?"
    mc "就别人看你的那种眼神？"

#game/script.rpy:3166
translate chinese bar_olivica_6de14027:

    # mc "You could’ve had anyone."
    mc "你本可以要谁都行。"

#game/script.rpy:3168
translate chinese bar_olivica_b65b23e7:

    # h "(Scoffs) That’s the thing."
    h "（嗤笑）问题就在这儿。"

#game/script.rpy:3169
translate chinese bar_olivica_8380d296:

    # h "It’s not about who {b}wants{/b} me."
    h "不是谁{b}想要{/b}我。"

#game/script.rpy:3170
translate chinese bar_olivica_9d7d2f21:

    # h "It’s about who’s {b}worth{/b} it."
    h "而是谁{b}值得{/b}。"

#game/script.rpy:3172
translate chinese bar_olivica_2fded262_3:

    # h "..."
    h "……"

#game/script.rpy:3174
translate chinese bar_olivica_2b35b6fe_3:

    # mc "..."
    mc "……"

#game/script.rpy:3176
translate chinese bar_olivica_916603e8:

    # h "And no, it’s not about Anya. If that’s where your head went."
    h "不，跟安雅无关。如果你想的是这个。"

#game/script.rpy:3182
translate chinese bar_olivica_4acfd547:

    # mc "Before that..."
    mc "在那之前……"

#game/script.rpy:3183
translate chinese bar_olivica_0fe2b219:

    # mc "Anya ran into trouble outside."
    mc "安雅在外面遇到麻烦了。"

#game/script.rpy:3185
translate chinese bar_olivica_26681431:

    # h "What kind of trouble?"
    h "什么麻烦？"

#game/script.rpy:3187
translate chinese bar_olivica_7177233e:

    # mc "The kind where someone wanted her alive."
    mc "有人想让她活着的那种。"

#game/script.rpy:3188
translate chinese bar_olivica_53296d3c:

    # mc "As leverage."
    mc "当筹码。"

#game/script.rpy:3190
translate chinese bar_olivica_2fded262_4:

    # h "..."
    h "……"

#game/script.rpy:3191
translate chinese bar_olivica_9ad006ae:

    # h "Who?"
    h "谁？"

#game/script.rpy:3195
translate chinese bar_olivica_1d89acc9:

    # mc "Didn't get a name."
    mc "没问到名字。"

#game/script.rpy:3196
translate chinese bar_olivica_f7faa546:

    # mc "But they knew she was your sister."
    mc "但他们知道她是你妹妹。"

#game/script.rpy:3198
translate chinese bar_olivica_1bc33fea:

    # h "Old business."
    h "旧账。"

#game/script.rpy:3199
translate chinese bar_olivica_62e48b8d:

    # h "Don't worry about it. I'll make a couple of calls later."
    h "别担心。我回头打几个电话。"

#game/script.rpy:3205
translate chinese bar_olivica_4489f1b5:

    # mc "…Good."
    mc "……好。"

#game/script.rpy:3206
translate chinese bar_olivica_632bbf91:

    # mc "Then I don’t need to step in."
    mc "那我不需要插手。"

#game/script.rpy:3208
translate chinese bar_olivica_e1cb9ea0:

    # h "...How are {b}you{/b} holding up?"
    h "……{b}你{/b}还好吗？"

#game/script.rpy:3209
translate chinese bar_olivica_0c00b719:

    # h "I heard what happened."
    h "我听说了。"

#game/script.rpy:3210
translate chinese bar_olivica_c9deb6e0:

    # h "I’m… sorry."
    h "我……很抱歉。"

#game/script.rpy:3212
translate chinese bar_olivica_2b35b6fe_4:

    # mc "..."
    mc "……"

#game/script.rpy:3216
translate chinese bar_olivica_725dece2:

    # mc "I need a favor."
    mc "我需要你帮个忙。"

#game/script.rpy:3217
translate chinese bar_olivica_3ac2530a:

    # mc "Take a look at this."
    mc "看看这个。"

#game/script.rpy:3219
translate chinese bar_olivica_d68677fd:

    # mc "I know we said we were done with this."
    mc "我知道我们说好不再碰这个。"

#game/script.rpy:3221
translate chinese bar_olivica_dd3ea971:

    # mc "But the past doesn’t stay buried."
    mc "但过去不会一直埋着。"

#game/script.rpy:3222
translate chinese bar_olivica_2fded262_5:

    # h "..."
    h "……"

#game/script.rpy:3230
translate chinese bar_olivica_2fded262_6:

    # h "..."
    h "……"

#game/script.rpy:3232
translate chinese bar_olivica_ffcb8198:

    # h "…Wait."
    h "……等等。"

#game/script.rpy:3233
translate chinese bar_olivica_f70f78cc:

    # h "That’s not possible…"
    h "不可能……"

#game/script.rpy:3234
translate chinese bar_olivica_fa4d5023:

    # h "He’s dead."
    h "他死了。"

#game/script.rpy:3235
translate chinese bar_olivica_ea379f13:

    # h "You put him down yourself."
    h "你亲手解决的。"

#game/script.rpy:3236
translate chinese bar_olivica_6226149d:

    # h "Al-Zahira. Twenty years ago."
    h "阿尔扎希拉。二十年前。"

#game/script.rpy:3238
translate chinese bar_olivica_08f4193e:

    # mc "Yeah… so did I."
    mc "是啊……我也这么以为。"

#game/script.rpy:3239
translate chinese bar_olivica_ddbda240:

    # mc "But this says otherwise."
    mc "但这上面不是这么说的。"

#game/script.rpy:3240
translate chinese bar_olivica_2fb5cb2b:

    # mc "He’s alive."
    mc "他活着。"

#game/script.rpy:3241
translate chinese bar_olivica_f38e52d6:

    # mc "And looks better than both of us."
    mc "而且看起来比我们俩都好。"

#game/script.rpy:3243
translate chinese bar_olivica_8583ef28:

    # mc "But that’s not why I’m here."
    mc "但我不是为这个来的。"

#game/script.rpy:3244
translate chinese bar_olivica_a501270d:

    # mc "Look at the other one."
    mc "看另一个。"

#game/script.rpy:3246
translate chinese bar_olivica_1727fc4b:

    # h "You’re serious…?"
    h "你是认真的……？"

#game/script.rpy:3248
translate chinese bar_olivica_40d067f2:

    # h "Is that—?"
    h "那是——？"

#game/script.rpy:3249
translate chinese bar_olivica_cb711f44:

    # mc "I don’t know."
    mc "我不知道。"

#game/script.rpy:3250
translate chinese bar_olivica_a8b2ca56:

    # mc "But I need to find out."
    mc "但我得查清楚。"

#game/script.rpy:3251
translate chinese bar_olivica_bb3d3a29:

    # h "Don't do that."
    h "别这样。"

#game/script.rpy:3252
translate chinese bar_olivica_94507c05:

    # mc "Do what?"
    mc "别怎样？"

#game/script.rpy:3253
translate chinese bar_olivica_790db0bb:

    # h "Sound hopeful."
    h "听起来满怀希望。"

#game/script.rpy:3255
translate chinese bar_olivica_667eaaba:

    # mc "Too late."
    mc "太迟了。"

#game/script.rpy:3256
translate chinese bar_olivica_455625a9:

    # "An awkward silence settles between them."
    "两人之间陷入尴尬的沉默。"

#game/script.rpy:3258
translate chinese bar_olivica_8a44a794:

    # h "Anya."
    h "安雅。"

#game/script.rpy:3259
translate chinese bar_olivica_88fcaa18:

    # h "We’re closing early."
    h "我们提前打烊。"

#game/script.rpy:3260
translate chinese bar_olivica_7573f237:

    # h "Give them an hour. No more."
    h "给他们一小时。不能再多。"

#game/script.rpy:3262
translate chinese bar_olivica_8fde1adf:

    # mc "Won’t that hurt your reputation?"
    mc "不会影响你的名声吗？"

#game/script.rpy:3264
translate chinese bar_olivica_bc6769ce:

    # h "I’ve got bigger problems than reputation."
    h "我有比名声更大的问题。"

#game/script.rpy:3274
translate chinese bar_olivica_2b35b6fe_5:

    # mc "..."
    mc "……"

#game/script.rpy:3277
translate chinese bar_olivica_2fded262_7:

    # h "..."
    h "……"

#game/script.rpy:3279
translate chinese bar_olivica_fdb21d1b:

    # h "Where did you get this info?"
    h "你从哪得到这情报的？"

#game/script.rpy:3281
translate chinese bar_olivica_b0eb7a86:

    # mc "Norman gave me this earlier today."
    mc "诺曼今天早些时候给我的。"

#game/script.rpy:3283
translate chinese bar_olivica_4f780426:

    # h "Norman?"
    h "诺曼？"

#game/script.rpy:3284
translate chinese bar_olivica_5774ad1e:

    # h "Your kid?"
    h "你孩子？"

#game/script.rpy:3286
translate chinese bar_olivica_af770035:

    # mc "My son…"
    mc "我儿子……"

#game/script.rpy:3287
translate chinese bar_olivica_610e1ad0:

    # mc "Long story."
    mc "说来话长。"

#game/script.rpy:3289
translate chinese bar_olivica_1bf127fa:

    # h "How reliable is it?"
    h "有多可靠？"

#game/script.rpy:3291
translate chinese bar_olivica_3496291e:

    # mc "It came with coordinates."
    mc "附带坐标。"

#game/script.rpy:3292
translate chinese bar_olivica_c815f19b:

    # mc "And a photo no one should be able to take."
    mc "还有一张不该有人能拍到的照片。"

#game/script.rpy:3294
translate chinese bar_olivica_850ef128_1:

    # b "..."
    b "……"

#game/script.rpy:3296
translate chinese bar_olivica_0f846bc5:

    # h "We lost Jake and Mona that day. Alexandro lost a leg, for life."
    h "那天我们失去了杰克和莫娜。亚历山德罗丢了一条腿，终身。"

#game/script.rpy:3297
translate chinese bar_olivica_b7f4533f:

    # h "All because some genius commander called friendly fire. Beautiful, right?"
    h "全因为某个天才指挥官喊了友军火力。真漂亮，对吧？"

#game/script.rpy:3299
translate chinese bar_olivica_d6ea48da:

    # h "And now, after all this time, they suddenly need you again?"
    h "现在过了这么久，他们突然又需要你了？"

#game/script.rpy:3300
translate chinese bar_olivica_731e85e8:

    # h "Please tell me you told them to fuck off."
    h "拜托告诉我你让他们滚了。"

#game/script.rpy:3302
translate chinese bar_olivica_2b35b6fe_6:

    # mc "..."
    mc "……"

#game/script.rpy:3304
translate chinese bar_olivica_0b7b9cf5:

    # mc "You know Richard handled it."
    mc "你知道是理查德处理的。"

#game/script.rpy:3306
translate chinese bar_olivica_177c69b9:

    # h "Yeah… figures. So you didn’t."
    h "是啊……果然。所以你没拒绝。"

#game/script.rpy:3308
translate chinese bar_olivica_54b1254f:

    # mc "Azarkhan’s people were already inside."
    mc "阿扎尔汗的人已经渗透进来了。"

#game/script.rpy:3310
translate chinese bar_olivica_f154821a:

    # h "Don’t."
    h "别。"

#game/script.rpy:3311
translate chinese bar_olivica_0506dede:

    # h "We both know that’s bullshit."
    h "我们都知道那是扯淡。"

#game/script.rpy:3312
translate chinese bar_olivica_d5be1ed4:

    # h "This whole thing? It’s about that photo of Lora."
    h "这一切？都是因为洛拉的那张照片。"

#game/script.rpy:3313
translate chinese bar_olivica_ed098414:

    # h "That’s the only reason you’re even thinking about going back."
    h "这是你唯一还想回去的理由。"

#game/script.rpy:3315
translate chinese bar_olivica_2b35b6fe_7:

    # mc "..."
    mc "……"

#game/script.rpy:3317
translate chinese bar_olivica_cb89ebe5:

    # h "I get it."
    h "我明白。"

#game/script.rpy:3318
translate chinese bar_olivica_025f9323:

    # h "You did your service. Came back. Tried to live quiet."
    h "你服完役，回来了。想安静地过日子。"

#game/script.rpy:3319
translate chinese bar_olivica_cff6e378:

    # h "Then boom, your wife’s ‘dead’, and somehow you end up blaming your own kid for it."
    h "然后砰的一声，你妻子‘死’了，不知怎么的，你最后还怪到了自己孩子头上。"

#game/script.rpy:3321
translate chinese bar_olivica_8541ef36:

    # h "And just when things start to calm down, here we go again."
    h "好不容易事情刚平静下来，又来了。"

#game/script.rpy:3325
translate chinese bar_olivica_c33e5ba0:

    # h "{b}Did you know? That global terrorist you supposedly killed is alive!{/b}"
    h "{b}你知道吗？你 supposedly 干掉的那个全球恐怖分子还活着！{/b}"

#game/script.rpy:3326
translate chinese bar_olivica_58db63cf:

    # h "Or {b}Oh, and your dead wife? Not so dead. Here, have some photos.{/b}"
    h "或者 {b}哦，还有你死去的妻子？没死。来，给你几张照片。{/b}"

#game/script.rpy:3328
translate chinese bar_olivica_2b35b6fe_8:

    # mc "..."
    mc "……"

#game/script.rpy:3330
translate chinese bar_olivica_f453b1a1:

    # mc "…What is that, a lollipop?"
    mc "……那是什么，棒棒糖？"

#game/script.rpy:3334
translate chinese bar_olivica_21ec3fe9:

    # h "I quit smoking, remember?"
    h "我戒烟了，记得吗？"

#game/script.rpy:3335
translate chinese bar_olivica_47531656:

    # h "Your dumb lollipop idea actually worked."
    h "你那蠢到家的棒棒糖主意还真管用。"

#game/script.rpy:3336
translate chinese bar_olivica_03cf958d:

    # h "So yeah… I’m sticking with it."
    h "所以是的……我就这么继续了。"

#game/script.rpy:3340
translate chinese bar_olivica_d0c95c5e:

    # h "You know… maybe it’s just not worth it."
    h "你知道吗……也许这事根本不值得。"

#game/script.rpy:3341
translate chinese bar_olivica_4499ebe1:

    # h "Yeah, the idea of bringing Lora back sounds nice."
    h "是啊，把洛拉带回来这想法听着是不错。"

#game/script.rpy:3342
translate chinese bar_olivica_3659234f:

    # h "Too nice."
    h "太美好了。"

#game/script.rpy:3344
translate chinese bar_olivica_bd7db401:

    # h "But what if that’s not even her?"
    h "可要是那根本不是她呢？"

#game/script.rpy:3348
translate chinese bar_olivica_1fb892a4:

    # h "Maybe it’s time to stop chasing ghosts."
    h "也许是时候别再追着影子跑了。"

#game/script.rpy:3349
translate chinese bar_olivica_ac895541:

    # h "Look around."
    h "看看四周。"

#game/script.rpy:3350
translate chinese bar_olivica_583f9be8:

    # h "You finally have Norman back in the room with you."
    h "诺曼终于又回到你身边了。"

#game/script.rpy:3351
translate chinese bar_olivica_368f69a8:

    # h "You have a granddaughter who thinks you hung the moon."
    h "你还有个孙女，把你当成天上摘月亮的人。"

#game/script.rpy:3352
translate chinese bar_olivica_c96d2705:

    # h "And you're about to walk into the same fire again."
    h "而你又准备再往同一团火里跳。"

#game/script.rpy:3353
translate chinese bar_olivica_5b178ae7:

    # h "Trust me, even that doesn't last forever."
    h "相信我，就算这样也不会永远持续下去。"

#game/script.rpy:3357
translate chinese bar_olivica_952433c1:

    # h "Just saying."
    h "随便说说。"

#game/script.rpy:3359
translate chinese bar_olivica_2034c056:

    # mc "Maybe."
    mc "也许吧。"

#game/script.rpy:3360
translate chinese bar_olivica_05a4b8b0:

    # mc "But if there’s even a chance that photo is real..."
    mc "但只要那张照片有一丝可能是真的……"

#game/script.rpy:3361
translate chinese bar_olivica_688285df:

    # mc "I have to know."
    mc "我必须弄清楚。"

#game/script.rpy:3365
translate chinese bar_olivica_57a458b0:

    # h "You’re still the same."
    h "你还是老样子。"

#game/script.rpy:3369
translate chinese bar_olivica_58de2916:

    # C "Sis, we’ve got trouble."
    C "姐，有麻烦了。"

#game/script.rpy:3371
translate chinese bar_olivica_68c7d64f:

    # h "What happened?"
    h "怎么了？"

#game/script.rpy:3373
translate chinese bar_olivica_26a803bc_1:

    # C "..."
    C "……"

#game/script.rpy:3375
translate chinese bar_olivica_d3b8b40e:

    # h "Why are you just standing there? Talk."
    h "你站那儿干嘛？说话。"

#game/script.rpy:3380
translate chinese bar_olivica_34336037:

    # C "Those guys from earlier?"
    C "之前那帮人？"

#game/script.rpy:3381
translate chinese bar_olivica_7121afe9:

    # C "Someone paid their boss to make noise here."
    C "有人花钱让他们老大来这儿闹事。"

#game/script.rpy:3383
translate chinese bar_olivica_bb3c1e81:

    # h "We’ve got security for a reason."
    h "我们请保安是有原因的。"

#game/script.rpy:3384
translate chinese bar_olivica_cdf7d9a3:

    # h "Why not let Alexandro throw them out?"
    h "干嘛不让亚历山德罗把他们扔出去？"

#game/script.rpy:3386
translate chinese bar_olivica_7b100b28:

    # C "This one’s some bigshot. We can’t use force."
    C "这人是个大人物。不能用强。"

#game/script.rpy:3387
translate chinese bar_olivica_f24f4fe4:

    # N "So, Dad, do you agree?"
    N "那，爸，你同意吗？"

#game/script.rpy:3389
translate chinese bar_olivica_a9449331:

    # mc "I need to go."
    mc "我得走了。"

#game/script.rpy:3390
translate chinese bar_olivica_56515523:

    # mc "If you’re in — tomorrow, 5:00 a.m."
    mc "如果你来——明天早上五点。"

#game/script.rpy:3391
translate chinese bar_olivica_e13175e5:

    # mc "Outside my place."
    mc "在我家外面。"

#game/script.rpy:3393
translate chinese bar_olivica_33ab0adc:

    # h "Maybe. No promises."
    h "也许吧。不保证。"

#game/script.rpy:3395
translate chinese bar_olivica_26a803bc_2:

    # C "..."
    C "……"

#game/script.rpy:3409
translate chinese norman_home_8ddfa823:

    # ri "My dear old friend,"
    ri "我亲爱的老朋友，"

#game/script.rpy:3411
translate chinese norman_home_b7016d79:

    # ri "I’ve been meaning to write to you for a long time."
    ri "很久以来我一直想给你写信。"

#game/script.rpy:3413
translate chinese norman_home_3b9b2de5:

    # ri "Something always stopped me — wrong time, wrong place, or maybe I just didn’t know how to begin."
    ri "可总有东西拦着我——时机不对、地点不对，又或者我只是不知道该怎么开口。"

#game/script.rpy:3415
translate chinese norman_home_f2ab4356:

    # ri "I hope this letter finds you and your loved ones in good health."
    ri "希望这封信送到时，你和你所爱之人都安好。"

#game/script.rpy:3417
translate chinese norman_home_1184b6df:

    # ri "I know how much you hate reading reports and briefings."
    ri "我知道你有多讨厌看报告和简报。"

#game/script.rpy:3419
translate chinese norman_home_ac14f50d:

    # ri "That’s why I’m writing you this letter..."
    ri "所以我才给你写这封信……"

#game/script.rpy:3421
translate chinese norman_home_307c1bee:

    # ri "Not as your Commander-in-Chief, but as your old friend."
    ri "不是以你总司令的身份，而是以你老朋友的身份。"

#game/script.rpy:3423
translate chinese norman_home_5fb3cdc9:

    # ri "The world is in unrest — granted, it always has been, but now the tension has reached a breaking point."
    ri "世界动荡不安——当然，一直都是，但现在紧张局势已经到了临界点。"

#game/script.rpy:3425
translate chinese norman_home_744d3292:

    # ri "If we don’t act, it won’t just affect you — it’ll affect everyone you care about."
    ri "如果我们不行动，受影响的不只是你——还有所有你在乎的人。"

#game/script.rpy:3427
translate chinese norman_home_58a54654:

    # ri "Azarkhan has returned from the dead. {b}How{/b} — we don’t know."
    ri "阿扎尔汗从死里回来了。{b}怎么{/b}回来的——我们不知道。"

#game/script.rpy:3429
translate chinese norman_home_eec2e5c2:

    # ri "But we’ve uncovered some information suggesting he’s backed by powerful entities."
    ri "但我们查到一些情报，显示他背后有强大的势力撑腰。"

#game/script.rpy:3431
translate chinese norman_home_38af67a9:

    # ri "Possibly... extraterrestrial."
    ri "可能是……外星势力。"

#game/script.rpy:3433
translate chinese norman_home_13a12bc6:

    # ri "I know how insane that sounds."
    ri "我知道这听着有多疯。"

#game/script.rpy:3437
translate chinese norman_home_8de8e30b:

    # ri "I wish I could share the details..."
    ri "我真希望能把细节告诉你……"

#game/script.rpy:3443
translate chinese norman_home_72ad15d9:

    # ri "but I can’t do that in a letter."
    ri "但这事没法写在信里。"

#game/script.rpy:3446
translate chinese norman_home_f29205f5:

    # ri "And yet, not mentioning the following would be a mistake."
    ri "不过，有件事不提就是个错误。"

#game/script.rpy:3448
translate chinese norman_home_a68194dd:

    # ri "What I can say is this: we found a photo, taken just before Lora disappeared."
    ri "我能说的是：我们找到了一张照片，拍于洛拉失踪前不久。"

#game/script.rpy:3450
translate chinese norman_home_3d194cce:

    # ri "We don’t know who took it, but it changed everything."
    ri "不知道是谁拍的，但它改变了一切。"

#game/script.rpy:3452
translate chinese norman_home_8b54a8bb:

    # ri "Azarkhan’s return, Lora’s vanishing, and what you saw eight years ago — they’re all connected. {w}To that forest."
    ri "阿扎尔汗的回归、洛拉的失踪，还有你八年前看到的东西——全都有关联。{w}和那片森林有关。"

#game/script.rpy:3455
translate chinese norman_home_714f1860:

    # ri "Or more precisely — to what’s {b}in{/b} it."
    ri "更准确地说——和森林{b}里面{/b}的东西有关。"

#game/script.rpy:3456
translate chinese norman_home_4d1b81bf:

    # ri "That’s why I’m asking. We need your help."
    ri "所以我才开口。我们需要你的帮助。"

#game/script.rpy:3458
translate chinese norman_home_684f72e8:

    # ri "P.S. You’ll find coordinates at the bottom. If you decide you want answers."
    ri "附：坐标在底部。如果你决定想要答案。"

#game/script.rpy:3463
translate chinese norman_home_b1ed2926:

    # mc "(Going somewhere unknown… based on a letter.)"
    mc "（凭一封信……就去一个陌生的地方。）"

#game/script.rpy:3464
translate chinese norman_home_8d139eb3:

    # mc "(Most people would call that stupid.)"
    mc "（大多数人会说这是蠢。）"

#game/script.rpy:3466
translate chinese norman_home_a9275055:

    # mc "(And maybe they’d be right.)"
    mc "（也许他们是对的。）"

#game/script.rpy:3467
translate chinese norman_home_db9cd3f8:

    # mc "(Maybe I should walk away.)"
    mc "（也许我该转身走开。）"

#game/script.rpy:3470
translate chinese norman_home_92ac0166:

    # mc "(A letter. Ghosts. Coordinates to nowhere.)"
    mc "（一封信。鬼魂。指向虚无的坐标。）"

#game/script.rpy:3471
translate chinese norman_home_3aa90f01:

    # mc "(Yeah… sounds insane.)"
    mc "（是啊……听着是疯了。）"

#game/script.rpy:3472
translate chinese norman_home_e7cafa64:

    # mc "(But I’m not turning my back on this.)"
    mc "（但我不会对此视而不见。）"

#game/script.rpy:3475
translate chinese norman_home_49dc7d32:

    # mc "(There are answers out there.)"
    mc "（外面有答案。）"

#game/script.rpy:3476
translate chinese norman_home_9c683e77:

    # mc "(Answers I was never given.)"
    mc "（从未有人给我的答案。）"

#game/script.rpy:3477
translate chinese norman_home_b698a3db:

    # mc "(A life I never got to live.)"
    mc "（我从未过上的生活。）"

#game/script.rpy:3479
translate chinese norman_home_d80e4225:

    # mc "(And somehow… it feels like hope.)"
    mc "（不知怎的……它像是希望。）"

#game/script.rpy:3484
translate chinese norman_home_ae5a2396:

    # mc "(That hope… it’s enough.)"
    mc "（那份希望……就够了。）"

#game/script.rpy:3489
translate chinese norman_home_3dc7acee:

    # mc "(Feels like I’m back there again.)"
    mc "（感觉又回到了那里。）"

#game/script.rpy:3494
translate chinese norman_home_86616cc7:

    # mc "(This time… I find it.)"
    mc "（这一次……我会找到它。）"

#game/script.rpy:3496
translate chinese norman_home_f3e81283:

    # mc "(End what started.)"
    mc "（终结已启之事。）"

#game/script.rpy:3497
translate chinese norman_home_54a6bd68:

    # mc "(Take back what I lost.)"
    mc "（夺回我失去的一切。）"

#game/script.rpy:3499
translate chinese norman_home_a49c2c10:

    # mc "Damn… sights are off again."
    mc "该死……准星又偏了。"

#game/script.rpy:3510
translate chinese norman_home_d6ed2480:

    # mc "Why aren’t you asleep?"
    mc "你怎么还没睡？"

#game/script.rpy:3511
translate chinese norman_home_2ed83991:

    # mc "Something wrong?"
    mc "出什么事了？"

#game/script.rpy:3513
translate chinese norman_home_fed672f5:

    # N "Dad… we need to talk."
    N "爸……我们得谈谈。"

#game/script.rpy:3515
translate chinese norman_home_2b35b6fe:

    # mc "..."
    mc "……"

#game/script.rpy:3518
translate chinese norman_home_986dd057:

    # mc "It’s late."
    mc "很晚了。"

#game/script.rpy:3519
translate chinese norman_home_6b280b18:

    # mc "Go get some sleep."
    mc "去睡会儿。"

#game/script.rpy:3521
translate chinese norman_home_ed77797d:

    # N "DAD!"
    N "爸！"

#game/script.rpy:3523
translate chinese norman_home_4c9d4ac2:

    # N "I’m not a kid anymore, alright?!"
    N "我不是小孩子了，行吗？！"

#game/script.rpy:3526
translate chinese norman_home_42937fd4:

    # N "I know what you’re planning."
    N "我知道你在盘算什么。"

#game/script.rpy:3527
translate chinese norman_home_7a7e5116:

    # N "You’re going after Mom…"
    N "你要去找妈妈……"

#game/script.rpy:3528
translate chinese norman_home_b0e9fca5:

    # N "But you don’t even know where to start!"
    N "可你连从哪儿开始都不知道！"

#game/script.rpy:3529
translate chinese norman_home_1216e26b:

    # mc "I’ve got coordinates."
    mc "我有坐标。"

#game/script.rpy:3530
translate chinese norman_home_e4a94a9b:

    # N "Dad—!"
    N "爸——！"

#game/script.rpy:3539
translate chinese norman_home_2b35b6fe_1:

    # mc "..."
    mc "……"

#game/script.rpy:3541
translate chinese norman_home_0b348ba0:

    # mc "…Alright."
    mc "……好吧。"

#game/script.rpy:3542
translate chinese norman_home_def0ad19:

    # mc "What is it?"
    mc "什么事？"

#game/script.rpy:3544
translate chinese norman_home_bd247360:

    # N "What time are we leaving?"
    N "我们几点出发？"

#game/script.rpy:3546
translate chinese norman_home_2b35b6fe_2:

    # mc "..."
    mc "……"

#game/script.rpy:3548
translate chinese norman_home_bb54adc5:

    # mc "We?"
    mc "我们？"

#game/script.rpy:3549
translate chinese norman_home_21882e03:

    # mc "You’re staying here."
    mc "你待在这儿。"

#game/script.rpy:3551
translate chinese norman_home_39fbcbd3:

    # N "Why?! Why can’t I come with you?!"
    N "为什么？！为什么我不能跟你去？！"

#game/script.rpy:3553
translate chinese norman_home_2b35b6fe_3:

    # mc "..."
    mc "……"

#game/script.rpy:3555
translate chinese norman_home_1e5dea99:

    # mc "Because you’ve got a life ahead of you."
    mc "因为你还有一辈子要过。"

#game/script.rpy:3556
translate chinese norman_home_2e34d625:

    # mc "I’m not letting that place take you too."
    mc "我不会让那地方把你也带走。"

#game/script.rpy:3558
translate chinese norman_home_0aac8827:

    # N "And what about your life?!"
