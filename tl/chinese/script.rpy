translate chinese street_bc76f130:

    # M "Nope! I {b}totally{/b} grew! Mom says I’m sprouting like a weed!"
    M "没有！我{b}真的{/b}长高了！妈妈说我像野草一样疯长！"

#game/script.rpy:1510
translate chinese street_b66cba15:

    # A "Which, to be fair, is not the {b}most{/b} elegant comparison..."
    A "说实话，这可不是{b}最{/b}优雅的比喻……"

#game/script.rpy:1512
translate chinese street_d1e81701:

    # mc "All in good time, my dear."
    mc "慢慢来，亲爱的。"

#game/script.rpy:1513
translate chinese street_c8531d29:

    # mc "You should’ve seen your dad at your age."
    mc "你该看看你爸像你这么大时的样子。"

#game/script.rpy:1514
translate chinese street_08962ed3:

    # mc "That was something."
    mc "那可真是……一言难尽。"

#game/script.rpy:1516
translate chinese street_75c46677:

    # M "Dad?! Being {b}small{/b}?! No way. He was born serious and boring!"
    M "爸爸？！{b}小{/b}时候？！不可能。他生下来就又严肃又无聊！"

#game/script.rpy:1518
translate chinese street_10da50b7:

    # mc "When we first took him in… he was worse than that."
    mc "我们刚收养他时……他比那还糟。"

