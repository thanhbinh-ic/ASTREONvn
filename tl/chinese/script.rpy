    # N "..."
    N "……"

#game/script.rpy:1989
translate chinese homedinner_d8654138_1:

    # A "..."
    A "……"

#game/script.rpy:1993
translate chinese homedinner_7eee03cd:

    # N "…Thanks."
    N "……谢谢。"

#game/script.rpy:1995
translate chinese homedinner_b581e53f:

    # N "Dad… can we step outside for a minute? Just you and me."
    N "爸……能出去一下吗？就你和我。"

#game/script.rpy:1997
translate chinese homedinner_2b35b6fe_13:

    # mc "..."
    mc "……"

#game/script.rpy:1999
translate chinese homedinner_159d1bfe:

    # M "But I wanted to hear more of his stories…"
    M "但我还想听他的故事……"

#game/script.rpy:2000
translate chinese homedinner_ed78c13a:

    # A "Mina, Dad and Grandpa have something important to talk about. Once they’re done, you can have all the time you want."
    A "米娜，爸爸和爷爷有重要的事要谈。等他们谈完，你想待多久都行。"

#game/script.rpy:2002
translate chinese homedinner_b1b344af:

    # mc "Won’t be long, kid."
    mc "不会太久，孩子。"

#game/script.rpy:2003
translate chinese homedinner_9feec320:

    # M "Okay, you promised!"
    M "好，你答应了的！"

#game/script.rpy:2004
translate chinese homedinner_3fac3b71:

    # A "Alright Mina, let’s go clean up your room."
    A "好了米娜，我们去收拾你的房间。"

#game/script.rpy:2005
translate chinese homedinner_2b35b6fe_14:

    # mc "..."
    mc "……"

#game/script.rpy:2007
translate chinese homedinner_803ca8da:

    # mc "I’ll be waiting for you outside."
    mc "我在外面等你。"

#game/script.rpy:2014
translate chinese homedinner_2b35b6fe_15:

    # mc "..."
    mc "……"

#game/script.rpy:2017
translate chinese homedinner_6651ab87:

    # mc "Alright."
    mc "好。"

#game/script.rpy:2018
translate chinese homedinner_f86fc45b:

    # mc "We’re alone."
    mc "就我们了。"

#game/script.rpy:2019
translate chinese homedinner_40094864:

    # mc "So… what was so important you had to pull me aside for?"
    mc "那么……什么重要的事非得把我拉出来说？"

#game/script.rpy:2021
translate chinese homedinner_f6c83ff3:

    # N "…I don’t even know where to begin."
    N "……我都不知道从哪说起。"

#game/script.rpy:2023
translate chinese homedinner_e7ee48d2:

    # mc "Then start at the beginning."
    mc "那就从头说。"

#game/script.rpy:2024
translate chinese homedinner_40273682:

    # mc "I need the truth."
    mc "我要真相。"

#game/script.rpy:2027
translate chinese homedinner_b5c321df:

    # N "…Alright."
    N "……好。"

#game/script.rpy:2028
translate chinese homedinner_ff75698f:

    # N "You remember… fifteen years ago, when you got back from the army?"
    N "你记得……十五年前，你从部队回来的时候吗？"

#game/script.rpy:2029
translate chinese homedinner_c48a511c:

    # N "Mom sent you that message."
    N "妈妈给你发了那条消息。"

#game/script.rpy:2031
translate chinese homedinner_0fd3bf2e:

    # mc "Yeah. I remember."
    mc "嗯。我记得。"

#game/script.rpy:2032
translate chinese homedinner_5d532905:

    # mc "She said you were visiting your grandmother."
    mc "她说你去看你外婆了。"

#game/script.rpy:2034
translate chinese homedinner_62f4e196:

    # N "Yeah… that’s what we told you."
    N "嗯……我们是这么跟你说的。"

#game/script.rpy:2036
translate chinese homedinner_edf25d0c:

    # mc "So that was a lie?"
    mc "所以那是谎话？"

#game/script.rpy:2038
translate chinese homedinner_4ad5badf:

    # N "It just… wasn’t the whole truth."
    N "只是……不是全部真相。"

#game/script.rpy:2040
translate chinese homedinner_a14aee3f:

    # mc "Then what was it?"
    mc "那是什么？"

#game/script.rpy:2042
translate chinese homedinner_5c97c3c4:

    # N "That day… she took me to that forest."
    N "那天……她带我去了那片森林。"

#game/script.rpy:2043
translate chinese homedinner_b33d2c8d:

    # N "The first time. Before everything that happened later."
    N "第一次。在后来一切发生之前。"

#game/script.rpy:2045
translate chinese homedinner_7a4804a3:

    # mc "Wait… you were there?"
    mc "等等……你在那儿？"

#game/script.rpy:2046
translate chinese homedinner_9958374f:

    # mc "In that forest… before everything?"
    mc "在那片森林里……在一切之前？"

#game/script.rpy:2048
translate chinese homedinner_3d6eb27c:

    # N "...yeah."
    N "……嗯。"

#game/script.rpy:2056
translate chinese homedinner_dd3b2d49:

    # "Starlit Stand 2023, 15 year before the main event."
    "星光台 2023年，主事件十五年前。"

#game/script.rpy:2058
translate chinese homedinner_1d372415:

    # N "Mom… this isn’t the way home."
    N "妈……这不是回家的路。"

#game/script.rpy:2059
translate chinese homedinner_6da27ca9:

    # N "Where are we really going?"
    N "我们到底要去哪？"

#game/script.rpy:2061
translate chinese homedinner_61e4b13f:

    # L "Hey… easy, sweetheart."
    L "嘿……别紧张，宝贝。"

#game/script.rpy:2062
translate chinese homedinner_1180311d:

    # L "You used to say you wanted to follow in my footsteps, remember?"
    L "你以前说想追随我的脚步，记得吗？"

#game/script.rpy:2063
translate chinese homedinner_3df49399:

    # L "I just thought… maybe it’s time you see more of that world."
    L "我只是想……也许该让你多看看那个世界了。"

#game/script.rpy:2065
translate chinese homedinner_ee111a61:

    # N "Then why tell Dad something else?"
    N "那为什么跟爸爸说别的？"

#game/script.rpy:2067
translate chinese homedinner_1b4b134c:

    # L "...Because if he knew, he'd come with us."
    L "……因为如果他知道，他会跟我们一起来。"

#game/script.rpy:2068
translate chinese homedinner_5f824244:

    # L "And if he came with us..."
    L "如果他跟我们一起来……"

#game/script.rpy:2069
translate chinese homedinner_072d6c67:

    # L "They'd treat him like a breach."
    L "他们会把他当成入侵者。"

#game/script.rpy:2070
translate chinese homedinner_20ff942a:

    # L "A soldier with combat clearance, walking into a black project?"
    L "一个有战斗权限的士兵，走进一个黑色项目？"

#game/script.rpy:2071
translate chinese homedinner_5ce1391f:

    # L "No one down there would let that slide."
    L "下面没人会放过这种事。"

#game/script.rpy:2072
translate chinese homedinner_f09ec349:

    # N "But they let me in?"
    N "但他们让我进去了？"

#game/script.rpy:2073
translate chinese homedinner_e042b707:

    # L "You're my son."
    L "你是我儿子。"

#game/script.rpy:2074
translate chinese homedinner_51491343:

    # L "On paper, you're a dependent under my responsibility."
    L "在文件上，你是我责任下的受抚养人。"

#game/script.rpy:2075
translate chinese homedinner_c103c6d1:

    # L "As long as you stay beside me, you're not a threat to them."
    L "只要你待在我身边，对他们就不是威胁。"

#game/script.rpy:2076
translate chinese homedinner_6ebff622:

    # L "You're leverage they don't have to take."
    L "你是他们不必拿走的筹码。"

#game/script.rpy:2077
translate chinese homedinner_63276998:

    # L "Your father would be different."
    L "你父亲就不一样了。"

#game/script.rpy:2078
translate chinese homedinner_19126210:

    # L "He'd ask questions. Push back. Reach for his gun if someone looked at us wrong."
    L "他会问问题。会反抗。有人看我们一眼不对就会去摸枪。"

#game/script.rpy:2079
translate chinese homedinner_4b7255ec:

    # L "And then I'd have to choose between saving him… and exposing everything."
    L "那我就得在救他……和暴露一切之间做选择。"

#game/script.rpy:2081
translate chinese homedinner_2292ba39_2:

    # N "..."
    N "……"

#game/script.rpy:2082
translate chinese homedinner_77f9c83e:

    # N "So it's dangerous?"
    N "所以很危险？"

#game/script.rpy:2083
translate chinese homedinner_5da94d85:

    # L "It might be."
    L "有可能。"

#game/script.rpy:2084
translate chinese homedinner_a84147c7:

    # L "That's why I need you to stay close."
    L "所以我要你紧跟在我身边。"

#game/script.rpy:2085
translate chinese homedinner_4ed3dc9c:

    # L "And listen to everything I say."
    L "听我说的每一句话。"

#game/script.rpy:2086
translate chinese homedinner_ade9687e:

    # N "Mom..."
    N "妈……"

#game/script.rpy:2087
translate chinese homedinner_4bff1c62:

    # L "I know."
    L "我知道。"

#game/script.rpy:2088
translate chinese homedinner_8509c81e:

    # L "I would never bring you here if I had another choice."
    L "如果有别的选择，我绝不会带你来这儿。"

#game/script.rpy:2090
translate chinese homedinner_92621791:

    # N "(…Then I heard her. She whispered something.)"
    N "（……然后我听到她。她低声说了什么。）"

#game/script.rpy:2091
translate chinese homedinner_85d1b1e7:

    # L "(softly) This is the only way I can keep them both out of it..."
    L "（轻声）这是我能让他们俩都不卷进来的唯一办法……"

#game/script.rpy:2092
translate chinese homedinner_e3a4cf57:

    # N "(I should’ve asked more… I should’ve known something wasn’t right.)"
    N "（我该多问的……我该知道有什么不对劲。）"

#game/script.rpy:2093
translate chinese homedinner_27cf334b:

    # N "(But she smiled… and when she did, everything just felt… safe.)"
    N "（但她笑了……她一笑，一切就感觉……安全了。）"

#game/script.rpy:2097
translate chinese homedinner_8ad30580:

    # N "The public trail isn't the place Mom took me."
    N "妈妈带我去的地方不是公共步道。"

#game/script.rpy:2098
translate chinese homedinner_8fd6fb88:

    # N "There was another way."
    N "还有另一条路。"

#game/script.rpy:2099
translate chinese homedinner_056e1b5f:

    # N "Past the old service road."
    N "过了旧维护道。"

#game/script.rpy:2100
translate chinese homedinner_ca247b4c:

    # N "A place no tourist would ever find."
    N "游客永远找不到的地方。"

#game/script.rpy:2102
translate chinese homedinner_b4c5b797:

    # mc "And you never told me?"
    mc "你从来没告诉我？"

#game/script.rpy:2104
translate chinese homedinner_d67d6d9a:

    # N "...No."
    N "……没有。"

#game/script.rpy:2105
translate chinese homedinner_8f5426cf:

    # N "I was scared."
    N "我害怕。"

#game/script.rpy:2106
translate chinese homedinner_c7bfd441:

    # N "And after 2030..."
    N "而且在2030年之后……"

#game/script.rpy:2107
translate chinese homedinner_3afff267:

    # N "I convinced myself maybe it was better buried."
    N "我说服自己也许埋起来更好。"

#game/script.rpy:2109
translate chinese homedinner_8d0f132b_1:

    # mc "Norman..."
    mc "诺曼……"

#game/script.rpy:2111
translate chinese homedinner_533522e2:

    # N "That's the part I kept from you."
    N "这就是我瞒着你的部分。"

#game/script.rpy:2113
translate chinese homedinner_106bf979:

    # N "That day… it all led to one thing."
    N "那天……一切都指向一件事。"

#game/script.rpy:2121
translate chinese homedinner_1392f97b:

    # L "We’re meeting someone."
    L "我们要见一个人。"

#game/script.rpy:2122
translate chinese homedinner_02993f78:

    # N "(A secret meeting… with a scientist named Dr. Li Wei.)"
    N "（一场秘密会面……和一个叫李伟博士的科学家。）"

#game/script.rpy:2124
translate chinese homedinner_40938fb6:

    # L "Not just anyone… so behave, alright?"
    L "不是普通人……所以乖一点，好吗？"

#game/script.rpy:2128
translate chinese homedinner_014905f7:

    # L "Hey— watch it. {w}(under breath) idiot."
    L "嘿——小心点。{w}（低声）白痴。"

#game/script.rpy:2130
translate chinese homedinner_5453f857:

    # R "In all my years, I’ve seen brilliance, imitation… and failure."
    R "这么多年，我见过天才、模仿……和失败。"

#game/script.rpy:2131
translate chinese homedinner_a3cc7176:

    # R "But this?"
    R "但这个？"

#game/script.rpy:2132
translate chinese homedinner_34399d9a:

    # R "This is something rarer."
    R "这更罕见。"

#game/script.rpy:2134
translate chinese homedinner_f48b615c:

    # a "Dr. Li, that’s the seventh time you’ve said that this month."
    a "李博士，这是你这个月第七次这么说了。"

#game/script.rpy:2136
translate chinese homedinner_ca297b66:

    # L "Sorry to keep you waiting."
    L "抱歉让你久等了。"

#game/script.rpy:2137
translate chinese homedinner_920a2839:

    # L "Road decided to complicate things."
    L "路上出了点状况。"

#game/script.rpy:2139
translate chinese homedinner_9d27f682:

    # R "Well…"
    R "那么……"

#game/script.rpy:2140
translate chinese homedinner_efa5d726:

    # R "The elusive Ms. Lora."
    R "神出鬼没的洛拉女士。"

#game/script.rpy:2141
translate chinese homedinner_6ea1e59c:

    # R "You do know how to make an entrance, even in absence."
    R "你确实懂得如何登场，哪怕人不在场。"

#game/script.rpy:2142
translate chinese homedinner_6f89075d:

    # L "(quietly) Mrs."
    L "（轻声）是夫人。"

#game/script.rpy:2144
translate chinese homedinner_aa1ac4a2:

    # N "(They sounded calm… too calm.)"
    N "（他们听起来很平静……太平静了。）"

#game/script.rpy:2145
translate chinese homedinner_71a13b80:

    # N "(And at the same time… there was something in Mom’s eyes.)"
    N "（同时……妈妈眼里有什么东西。）"

#game/script.rpy:2146
translate chinese homedinner_60882c4c:

    # N "(Something like… resentment.)"
    N "（像是……怨恨。）"

#game/script.rpy:2148
translate chinese homedinner_9246f7fe:

    # L "Dr. Li Wei."
    L "李伟博士。"

#game/script.rpy:2149
translate chinese homedinner_a5189cba:

    # L "So you’re the man behind all those… controversial ideas."
    L "所以你就是那些……争议性想法背后的人。"

#game/script.rpy:2151
translate chinese homedinner_5fc03062:

    # R "Oh, please."
    R "哦，得了吧。"

#game/script.rpy:2152
translate chinese homedinner_ca8f81fb:

    # R "I’m more impressed you’ve kept up."
    R "我更惊讶你一直跟得上。"

#game/script.rpy:2154
translate chinese homedinner_bc439206:

    # L "Of course. I grew up reading your papers."
    L "当然。我是读着你的论文长大的。"

#game/script.rpy:2155
translate chinese homedinner_69e4b6c7:

    # L "Combining shredding theory with wormhole mechanics… that’s incredible."
    L "把撕裂理论和虫洞力学结合起来……太不可思议了。"

#game/script.rpy:2156
translate chinese homedinner_47b40709:

    # L "Do you actually believe crossing between worlds is possible?"
    L "你真的相信跨世界穿越是可能的？"

#game/script.rpy:2158
translate chinese homedinner_ad126b05:

    # R "Faith… is a luxury a scientist cannot afford."
    R "信仰……是科学家负担不起的奢侈品。"

#game/script.rpy:2159
translate chinese homedinner_e22af12f:

    # R "But curiosity?"
    R "但好奇心？"

#game/script.rpy:2160
translate chinese homedinner_a6af2c3f:

    # R "That, I allow myself."
    R "这个，我允许自己拥有。"

#game/script.rpy:2161
translate chinese homedinner_60156406:

    # R "And yes—"
    R "而且是的——"

#game/script.rpy:2162
translate chinese homedinner_55d9229e:

    # R "I do intend to see it. With my own eyes."
    R "我确实打算亲眼看到它。"

#game/script.rpy:2164
translate chinese homedinner_2cc36e46:

    # N "(I didn’t understand what made him so important.)"
    N "（我不明白他为什么这么重要。）"

#game/script.rpy:2167
translate chinese homedinner_af8a82de:

    # R "And this would be...?"
    R "这位是……？"

#game/script.rpy:2169
translate chinese homedinner_2db2980d:

    # L "My son. Norman."
    L "我儿子。诺曼。"

#game/script.rpy:2170
translate chinese homedinner_3ec0c45f:

    # L "He stays with me until we're done."
    L "在我们结束之前他跟着我。"

#game/script.rpy:2173
translate chinese homedinner_99b22258:

    # R "Unusual choice."
    R "不寻常的选择。"

#game/script.rpy:2174
translate chinese homedinner_7afa7fb5:

    # L "Necessary one."
