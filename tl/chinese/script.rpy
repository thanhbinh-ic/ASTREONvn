#game/script.rpy:5555
translate chinese shoot_233a29e8:

    # mc "(That stench...)"
    mc "（那股臭味……）"

#game/script.rpy:5556
translate chinese shoot_9d32f660:

    # mc "What is this place?"
    mc "这是什么地方？"

#game/script.rpy:5560
translate chinese shoot_777b76fc:

    # mc "Who built this…?"
    mc "谁建的……？"

#game/script.rpy:5561
translate chinese shoot_b9e2c58b:

    # mc "What the hell happened here?"
    mc "这儿到底出过什么事？"

#game/script.rpy:5563
translate chinese shoot_079d3d1d:

    # mc "Too many questions…"
    mc "问题太多了……"

#game/script.rpy:5564
translate chinese shoot_cc8a26de:

    # mc "No answers."
    mc "没有答案。"

#game/script.rpy:5566
translate chinese shoot_2b35b6fe_2:

    # mc "..."
    mc "……"

#game/script.rpy:5569
translate chinese shoot_68d25c06:

    # mc "What’s this...?"
    mc "这是什么……？"

#game/script.rpy:5571
translate chinese shoot_e9426556:

    # mc "A recorder…?"
