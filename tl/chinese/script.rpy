    # h "Great. That helps."
    h "太好了。真有用。"

#game/script.rpy:475
translate chinese start_8a632012:

    # h "You got anything else?"
    h "还有别的吗？"

#game/script.rpy:477
translate chinese start_853e68a8:

    # mc "Only that the cargo contains an unknown substance."
    mc "只知道货物里有种未知物质。"

#game/script.rpy:478
translate chinese start_e4e9ca29:

    # mc "Unstable. Unknown origin."
    mc "不稳定。来源不明。"

#game/script.rpy:479
translate chinese start_b800ee21:

    # mc "And everyone who tried to inspect it either vanished..."
    mc "所有试图检查它的人都消失了……"

#game/script.rpy:481
translate chinese start_8e22e646:

    # h "Perfect."
    h "完美。"

#game/script.rpy:482
translate chinese start_6dd35193:

    # h "Dropped into god-knows-what, for god-knows-why…"
    h "被扔进天知道什么地方，为了天知道什么原因……"

#game/script.rpy:483
translate chinese start_232f1846:

    # m "Always wanted to play the hero."
    m "一直想当英雄嘛。"

#game/script.rpy:485
translate chinese start_2fa5020a:

    # h "Pretty sure heroes don’t stack bodies every day."
    h "英雄可不会天天堆尸体。"

#game/script.rpy:486
translate chinese start_17d13082:

    # m "Then maybe stop shooting back."
    m "那就别还击啊。"

#game/script.rpy:488
translate chinese start_5c6d6b83:

    # h "[mc], this is it, right?"
    h "[mc]，就是这儿了吧？"

#game/script.rpy:489
translate chinese start_76f29171:

    # h "We’re not going deeper?"
    h "我们不深入了？"

#game/script.rpy:491
translate chinese start_6aab3175:

    # mc "Yeah. We’re here. If HQ's timing is right, the deal goes down in a couple of hours."
    mc "对。我们到了。如果总部的时间没错，交易几小时后进行。"

#game/script.rpy:493
translate chinese start_a326d883:

    # mc "We prep while we’ve got time."
    mc "趁有时间先准备。"

#game/script.rpy:495
translate chinese start_8ac302ce:

    # c "I’ll check the upper floors."
    c "我去检查楼上。"

#game/script.rpy:497
translate chinese start_fe642370:

    # mc "Alexandro, go with Jack."
    mc "亚历山德罗，和杰克一起去。"

#game/script.rpy:499
translate chinese start_18dcf528:

    # c "Sir? You can’t be serious. I can’t stand that guy."
    c "长官？你不是认真的吧。我受不了那家伙。"

#game/script.rpy:500
translate chinese start_b87c5d2d:

    # x "With him? No thanks."
    x "和他一起？不了，谢谢。"

#game/script.rpy:502
translate chinese start_4521cd92:

    # mc "Last thing I want is reporting you both dead. Pair up. Got it?"
    mc "我最不想的就是报告你们俩死了。组队。明白吗？"

#game/script.rpy:503
translate chinese start_b237bc5c:

    # b "Sir, yes, sir…"
    b "是，长官……"

#game/script.rpy:505
translate chinese start_ab02d76d:

    # S "Commander? I think I found the perfect spot."
    S "指挥官？我找到了一个绝佳位置。"

#game/script.rpy:507
translate chinese start_b2b9e19d:

    # mc "What do you mean?"
    mc "什么意思？"

#game/script.rpy:509
translate chinese start_d46a2016:

    # S "Building at eleven o’clock. Overlooks the entire area. Perfect vantage point."
    S "十一点钟方向的建筑。俯瞰整个区域。完美制高点。"

#game/script.rpy:511
translate chinese start_29aa95e6:

    # mc "Hold off. You’ll go there with Jack and Alexandro after their recon."
    mc "先等等。等杰克和亚历山德罗侦察完，你和他们一起去。"

#game/script.rpy:513
translate chinese start_187aeb64:

    # S "Yes, sir..."
    S "是，长官……"

#game/script.rpy:514
translate chinese start_4107ad54:

    # mc "Mona, Liv! Grab the C4. You’re with me."
    mc "莫娜，丽芙！拿上C4。你们跟我来。"

#game/script.rpy:523
translate chinese war2_1b0668b6:

    # "A day and a half later."
    "一天半后。"

#game/script.rpy:525
translate chinese war2_8561cd85:

    # mc "(We’ve been stuck here for so long… The deal was supposed to happen hours ago, and yet, we’re still here.)"
    mc "（我们被困在这儿太久了……交易本该几小时前就发生，可我们还在这儿。）"

#game/script.rpy:526
translate chinese war2_c126556f:

    # mc "(Thirty-six hours.)"
    mc "（三十六小时。）"

#game/script.rpy:528
translate chinese war2_15206aff:

    # mc "(Food left on tables, cars abandoned mid-street. Doors open.)"
    mc "（桌上留着食物，车停在路中间。门开着。）"

#game/script.rpy:529
translate chinese war2_6f3e1322:

    # mc "(Like the whole city stood up at once...)"
    mc "（就像整座城市同时站了起来……）"

#game/script.rpy:530
translate chinese war2_2b35b6fe:

    # mc "..."
    mc "……"

#game/script.rpy:531
translate chinese war2_baa98d53:

    # mc "(Don’t spiral, [mc]. It’ll be fine.)"
    mc "（别钻牛角尖，[mc]。会没事的。）"

#game/script.rpy:533
translate chinese war2_34e3c2dd:

    # mc "(Right?)"
    mc "（对吧？）"

#game/script.rpy:542
translate chinese war2_8bf8f8f0:

    # mc "You sure about this?"
    mc "你确定？"

#game/script.rpy:545
translate chinese war2_2653b46c:

    # L "No."
    L "不确定。"

#game/script.rpy:547
translate chinese war2_8faf70ab:

    # L "But if I keep saying “just one more minute,” we’ll be here all night."
    L "但如果我继续说“再一分钟”，我们能在这儿耗一整晚。"

#game/script.rpy:549
translate chinese war2_2b35b6fe_1:

    # mc "..."
    mc "……"

#game/script.rpy:553
translate chinese war2_553f7ff2:

    # mc "Honestly?"
    mc "说实话？"

#game/script.rpy:554
translate chinese war2_d876ca77:

    # mc "I don’t mind."
    mc "我不介意。"

#game/script.rpy:555
translate chinese war2_ed353575:

    # mc "Standing here with you beats pretty much anything else."
    mc "和你站在这儿，比什么都强。"

#game/script.rpy:557
translate chinese war2_5647d356:

    # L "Stop that. You're gonna make me tear up before we even start."
    L "别这样。还没开始你就要把我弄哭了。"

#game/script.rpy:559
translate chinese war2_0b9d1257:

    # mc "That’s kind of the goal, isn’t it? "
    mc "这不就是目的吗？"

#game/script.rpy:561
translate chinese war2_d60eb2e9:

    # mc "Emotional bomb right at the intro. Win them over fast."
    mc "开场就来个情感炸弹。快速拿下他们。"

#game/script.rpy:569
translate chinese war2_c9299b6a:

    # L "Oh god. Is this a sales pitch?"
    L "天啊。这是推销吗？"

#game/script.rpy:575
translate chinese war2_0817892e:

    # mc "Always."
    mc "一直都是。"

#game/script.rpy:576
translate chinese war2_2b465d36:

    # mc "Hi, I’m [mc], and this is the love of my life. Limited-time offer. Zero regrets, all heart."
    mc "嗨，我是[mc]，这是我一生所爱。限时特惠。零遗憾，全是真心。"

#game/script.rpy:578
translate chinese war2_7996824c:

    # L "You're ridiculous."
    L "你太荒唐了。"

#game/script.rpy:579
translate chinese war2_608ee75e:

    # L "…But you’re also wearing your shirt inside out."
    L "……但你的衬衫也穿反了。"

#game/script.rpy:581
translate chinese war2_99be54dd:

    # mc "…What?"
    mc "……什么？"

#game/script.rpy:585
translate chinese war2_b05c4edd:

    # mc "…Great. Nothing says “romantic message to the parents” like looking mildly concussed."
    mc "……太好了。没什么比看起来像轻微脑震荡更适合“给父母的浪漫留言”了。"

#game/script.rpy:587
translate chinese war2_7745336b:

    # L "{b}laughs{/b}"
    L "{b}笑{/b}"

#game/script.rpy:589
translate chinese war2_921607a6:

    # L "It's perfect. "
    L "完美。"

#game/script.rpy:591
translate chinese war2_8a39e3f5:

    # L "Makes me feel a little less nervous, honestly. "
    L "说实话，这让我没那么紧张了。"

#game/script.rpy:593
translate chinese war2_1a2227f1:

    # L "You mess up, too."
    L "你也会搞砸。"

#game/script.rpy:595
translate chinese war2_63095e00:

    # mc "All the time."
    mc "一直如此。"

#game/script.rpy:596
translate chinese war2_e7968c7c:

    # mc "Especially when it comes to you."
    mc "尤其是遇到你的时候。"

#game/script.rpy:598
translate chinese war2_bf4290c3:

    # L "…You’re really sure you want to do this?"
    L "……你真的确定要做这个？"

#game/script.rpy:600
translate chinese war2_e0e2858e:

    # mc "I was sure the second I met you."
    mc "遇到你的那一刻我就确定了。"

#game/script.rpy:603
translate chinese war2_9993b94e:

    # L "..."
    L "……"

#game/script.rpy:606
translate chinese war2_2b35b6fe_2:

    # mc "..."
    mc "……"

#game/script.rpy:608
translate chinese war2_c00ef224:

    # mc "And what was that just now?"
    mc "刚才那下算什么？"

#game/script.rpy:610
translate chinese war2_03757ee3:

    # L "Just showing you how much I love you."
    L "只是让你知道我有多爱你。"

#game/script.rpy:612
translate chinese war2_365a7361:

    # mc "Okay. Camera’s rolling."
    mc "好。摄像机在录了。"

#game/script.rpy:613
translate chinese war2_0a954585:

    # mc "Deep breath?"
    mc "深呼吸？"

#game/script.rpy:615
translate chinese war2_9a747f5a:

    # L "Already took three."
    L "已经吸了三口了。"

#game/script.rpy:617
translate chinese war2_b63393db:

    # mc "Alright. Let's do it."
    mc "好。开始吧。"

#game/script.rpy:619
translate chinese war2_89d6be51:

    # mc "And done, we’re good to go. {w}I’m pressing the button now, and... {w}recording started."
    mc "好了，可以了。{w}我现在按按钮，然后……{w}开始录制。"

#game/script.rpy:625
translate chinese war2_850ef128:

    # b "..."
    b "……"

#game/script.rpy:627
translate chinese war2_0a10c9f0:

    # mc "Ahem ahem."
    mc "咳咳。"

#game/script.rpy:629
translate chinese war2_9f621cc0:

    # mc "Hi, Mom. Hi, Dad."
    mc "嗨，妈。嗨，爸。"

#game/script.rpy:638
translate chinese war2_f4282245:

    # mc "(Alright… pull yourself together.)"
    mc "（好了……振作起来。）"

#game/script.rpy:640
translate chinese war2_bf5a4508:

    # mc "If you’re watching this, then I guess… I wanted you to meet her."
    mc "如果你们在看这个，那我想……我是想让你们见见她。"

#game/script.rpy:642
translate chinese war2_f8c8f8b6:

    # mc "She’s the reason I laugh more. Sleep less. Breathe deeper. "
    mc "因为她，我笑得更多。睡得更少。呼吸得更深。"

#game/script.rpy:644
translate chinese war2_e36807a9:

    # mc "This is Lora."
    mc "这是洛拉。"

#game/script.rpy:645
translate chinese war2_db5e061e:

    # mc "And the other day, I decided to commit my life to her."
    mc "前几天，我决定把一生交给她。"

#game/script.rpy:646
translate chinese war2_5336083d:

    # mc "And she said... {w}Yes."
    mc "她说……{w}愿意。"

#game/script.rpy:648
translate chinese war2_26397a94:

    # L "Hi..."
    L "嗨……"

#game/script.rpy:649
translate chinese war2_97b5c29e:

    # L "And yes, I did. I said yes. Loudly. Twice."
    L "是的，我说了。我说愿意。大声说了两遍。"

#game/script.rpy:651
translate chinese war2_e6acf5f3:

    # mc "You also punched me in the arm."
    mc "你还捶了我胳膊一拳。"

#game/script.rpy:653
translate chinese war2_c8e11565:

    # L "That was nerves."
    L "那是紧张。"

#game/script.rpy:655
translate chinese war2_3a4b5d4f:

    # mc "That was love."
    mc "那是爱。"

#game/script.rpy:657
translate chinese war2_ef3844ff:

    # L "We wanted to keep this moment. Just for us."
    L "我们想留住这一刻。只为我们自己。"

#game/script.rpy:658
translate chinese war2_08515202:

    # L "But then we thought, maybe you’d want to see it too."
    L "但后来我们想，也许你们也想看看。"

#game/script.rpy:659
translate chinese war2_69d8e20d:

    # L "What this feels like. Right now."
    L "现在的感觉。"

#game/script.rpy:663
translate chinese war2_f22f4571:

    # b "Just… us."
    b "只有……我们。"

#game/script.rpy:665
translate chinese war2_86a11f8b:

    # mc "(Hope her meeting went well...)"
    mc "（希望她的会议顺利……）"

#game/script.rpy:666
translate chinese war2_c440e6f5:

    # mc "(Last thing I need is her upset when I get back.)"
    mc "（我最不想的就是回去时她在生气。）"

#game/script.rpy:669
translate chinese war2_61fc0e58:

    # c "What are you staring at, Commander?"
    c "你在看什么，指挥官？"

#game/script.rpy:670
translate chinese war2_2c3a5489:

    # c "Oh… your darling wife, as always."
    c "哦……你亲爱的妻子，一如既往。"

#game/script.rpy:671
translate chinese war2_1b114a32:

    # c "That explains the smile."
    c "难怪你在笑。"

#game/script.rpy:673
translate chinese war2_2b73289f:

    # mc "Still dead air?"
    mc "还是死寂一片？"

#game/script.rpy:678
translate chinese war2_94068cb6:

    # c "Dead as the grave, sir."
    c "死得跟坟墓一样，长官。"

#game/script.rpy:679
translate chinese war2_6d356b8c:

    # c "Not a single ping since yesterday… and it’s looking worse by the hour."
    c "从昨天起一个信号都没有……而且每小时都在恶化。"

#game/script.rpy:680
translate chinese war2_66155fcd:

    # c "Still… maybe we should wait a little longer."
    c "不过……也许我们该再等等。"

#game/script.rpy:682
translate chinese war2_21077d71:

    # x "Two days in this furnace and we’re still just sitting here?"
    x "在这火炉里待了两天，我们还坐在这儿？"

#game/script.rpy:683
translate chinese war2_e969bcc5:

    # x "How much longer are we supposed to wait? Where the hell are they?"
    x "还要等多久？他们到底在哪？"

#game/script.rpy:684
translate chinese war2_8942a8d1:

    # x "¡Que me besen el culo si creen que voy a quedarme aquí más tiempo!"
    x "要是他们以为我还会待在这儿，那就去亲我屁股吧！"

#game/script.rpy:686
translate chinese war2_ee3115e4:

    # c "Speak English, or at least something we can understand!"
    c "说英语，或者至少说点我们能听懂的！"

#game/script.rpy:689
translate chinese war2_397bc7d1:

    # x "What’s your problem, huh?"
    x "你有什么毛病？"

#game/script.rpy:692
translate chinese war2_ba8de7b6:

    # x "What other language should I be speaking?"
    x "我该说什么语言？"

#game/script.rpy:695
translate chinese war2_f4659827:

    # x "I risk my life like the rest of you."
    x "我和你们一样拿命在拼。"

#game/script.rpy:696
translate chinese war2_8bdcc714:

    # x "I’ve earned the right to speak however the hell I want."
    x "我有权想怎么说就怎么说。"

#game/script.rpy:698
translate chinese war2_e22fcdd4:

    # c "Sure, but none of us know what you’re saying when you go off like that."
    c "当然，但你那样发作时没人知道你在说什么。"

#game/script.rpy:699
translate chinese war2_951ea1c4:

    # c "It’s just noise, man. Noise and attitude."
    c "只是噪音，兄弟。噪音加脾气。"

#game/script.rpy:702
translate chinese war2_060e5e47:

    # x "Eso no es problema mío si tu cerebro diminuto no pudo molestarse en aprender algo más que tu inglés de mierda."
    x "你那小脑袋瓜除了你那破英语不肯学别的，那可不是我的问题。"

#game/script.rpy:704
translate chinese war2_850ef128_1:

    # b "..."
    b "……"

#game/script.rpy:706
translate chinese war2_8822797f:

    # c "Here we go again..."
    c "又来了……"

#game/script.rpy:708
translate chinese war2_8faaa1f5:

    # mc "Dial it down. Both of you."
    mc "都给我消停点。你们两个。"

#game/script.rpy:709
translate chinese war2_ce318af0:

    # mc "I’m not having you kill each other before we even start."
    mc "还没开始我不准你们自相残杀。"

#game/script.rpy:711
translate chinese war2_ab5f9d63:

    # c "Alright, alright. Fair."
    c "行行行。有道理。"

#game/script.rpy:712
translate chinese war2_e54e1cfa:

    # c "Guess I forget that sometimes… I’ll try."
    c "有时候我忘了……我尽量。"

#game/script.rpy:714
translate chinese war2_6b500c19:

    # c "Hey, big guy. I’m sorry."
    c "嘿，大个子。对不起。"

#game/script.rpy:716
translate chinese war2_ad79e119:

    # x "Go screw yourself."
    x "去你的。"

#game/script.rpy:718
translate chinese war2_e40b0c0c:

    # c "Closest thing to peace we’ll get."
    c "这就是我们能得到的最接近和平的东西了。"

#game/script.rpy:720
translate chinese war2_27663a26:

    # m "Commander? {w=0.6}Mind if I ask something?"
    m "指挥官？{w=0.6}能问个问题吗？"

#game/script.rpy:722
translate chinese war2_a9d6818a:

    # mc "Shoot."
    mc "问吧。"

#game/script.rpy:724
translate chinese war2_61aca683:

    # m "You said you got married not long ago, right?"
    m "你说你不久前结婚了，对吧？"

#game/script.rpy:726
translate chinese war2_ca27a4db:

    # mc "Yeah. Recently."
    mc "对。最近。"

#game/script.rpy:728
translate chinese war2_563a53e8:

    # m "So… what’s she like? Your wife."
    m "那……她什么样？你妻子。"

#game/script.rpy:730
translate chinese war2_7a64d269:

    # c "The most amazing woman in the world!"
    c "世界上最了不起的女人！"

#game/script.rpy:731
translate chinese war2_35d67447:

    # c "Which is why my daughter’s so beautiful and perfect."
    c "所以我女儿才那么漂亮完美。"

#game/script.rpy:733
translate chinese war2_ad4a0122:

    # m "Sorry? I wasn’t asking you..."
    m "抱歉？我没问你……"

#game/script.rpy:735
translate chinese war2_127df502:

    # c "Just wanted to share."
    c "只是想分享一下。"

#game/script.rpy:737
translate chinese war2_5f680056:

    # mc "How old is your daughter now?"
    mc "你女儿多大了？"

#game/script.rpy:739
translate chinese war2_97cba95f:

    # c "Turned three last week."
    c "上周满三岁。"

#game/script.rpy:741
translate chinese war2_d6a80e97:

    # c "Crazy how fast they grow when you’re always gone."
    c "你总不在家的时候，孩子长得快得离谱。"

#game/script.rpy:743
translate chinese war2_a1f55207:

    # m "At least someone’s growing up during all this..."
    m "至少有人在这一切中长大了……"

#game/script.rpy:745
translate chinese war2_ba2567f6:

    # h "Still… [mc], what’s the objective?"
    h "不过……[mc]，目标是什么？"

#game/script.rpy:746
translate chinese war2_39b45695:

    # h "‘Cause I’ll be honest, that previous briefing?"
    h "说实话，之前那个简报？"

#game/script.rpy:747
translate chinese war2_fa37436d:

    # h "Didn’t get shit."
    h "啥也没听懂。"

#game/script.rpy:749
translate chinese war2_53f11f9e:

    # m "You’re not the only one."
    m "不只你一个。"

#game/script.rpy:750
translate chinese war2_b91d49aa:

    # m "Even I found it strange."
    m "连我都觉得奇怪。"

#game/script.rpy:751
translate chinese war2_50d5aac1:

    # m "{b}‘Reach the designated location and await further orders’{/b} — seriously?"
    m "{b}“抵达指定地点等待进一步命令”{/b}——认真的？"

#game/script.rpy:753
translate chinese war2_a0297673:

    # h "See? Not just me."
    h "看吧？不只我这么想。"

#game/script.rpy:754
translate chinese war2_b30e4b5f:

    # h "So quit holding out."
    h "所以别藏着掖着了。"

#game/script.rpy:755
translate chinese war2_d4dc0bb1:

    # h "What did HQ actually tell you?"
    h "总部到底跟你说了什么？"

#game/script.rpy:757
translate chinese war2_465a6971:

    # mc "Intel says we’ve got contacts tied to Azarkhan Temirov."
    mc "情报显示我们有联系人与阿扎尔汗·捷米罗夫有关。"

#game/script.rpy:760
translate chinese war2_a0d6ca00:

    # m "And who is that supposed to be?"
    m "那是谁？"

#game/script.rpy:761
translate chinese war2_e8b25aba:

    # mc "Runs a neural implant lab..."
    mc "经营一家神经植入实验室……"

#game/script.rpy:762
translate chinese war2_a6bd16d2:

    # mc "...and he’s the one pulling the strings behind Masquerade."
    mc "……也是“假面舞会”背后的操纵者。"

#game/script.rpy:764
translate chinese war2_258b502c:

    # S "And that makes him our target?"
    S "所以他就是我们的目标？"

#game/script.rpy:765
translate chinese war2_fca52711:

    # mc "No."
    mc "不是。"

#game/script.rpy:766
translate chinese war2_a420244e:

    # mc "But it’s enough to put him on our list."
    mc "但足够把他列入名单。"

#game/script.rpy:768
translate chinese war2_c318897f:

    # mc "Job’s simple. We stop the deal."
    mc "任务很简单。我们阻止交易。"

#game/script.rpy:770
translate chinese war2_2f875c13:

    # x "The deal we’ve been sitting on for TWO DAMN DAYS!"
    x "我们他妈的坐等了两天的交易！"

#game/script.rpy:771
translate chinese war2_2b35b6fe_3:

    # mc "..."
    mc "……"

#game/script.rpy:773
translate chinese war2_08c77b4d:

    # h "Maybe he’s stuck in traffic or something…"
    h "也许他堵车了之类的……"

#game/script.rpy:774
translate chinese war2_267bb635:

    # mc "We stay until it happens."
    mc "我们待到交易发生。"

#game/script.rpy:775
translate chinese war2_ecd3e288:

    # m "But why?"
    m "但为什么？"

#game/script.rpy:777
translate chinese war2_57ee1b29:

    # mc "Because of what they’re trading."
    mc "因为他们交易的东西。"

#game/script.rpy:779
translate chinese war2_5457b2fe:

    # mc "HQ calls it a substance sample."
    mc "总部称之为物质样本。"

#game/script.rpy:780
translate chinese war2_6d413b07:

    # m "Calls it?"
    m "称之为？"

#game/script.rpy:781
translate chinese war2_647fc96b:

    # mc "That's the problem. They don't know what it is."
    mc "问题就在这儿。他们不知道那是什么。"

#game/script.rpy:782
translate chinese war2_3942fc67:

    # mc "The city goes dark. Then the cargo appears."
    mc "城市陷入黑暗。然后货物出现。"

#game/script.rpy:783
translate chinese war2_44743ce1:

    # x "A substance sample. Big deal. What’s all the fuss about?"
    x "一个物质样本。有什么大不了的？至于这么大惊小怪吗？"

#game/script.rpy:785
translate chinese war2_692c7f96:

    # mc "Scans detected its effect, not what it is."
    mc "扫描检测到的是它的效果，不是它本身。"

#game/script.rpy:786
translate chinese war2_35bf6e1c:

    # mc "Not the source."
    mc "不是来源。"

#game/script.rpy:788
translate chinese war2_fca68246:

    # mc "Command is treating each unit like a weapon of mass destruction."
    mc "指挥部把每一单位都当作大规模杀伤性武器处理。"

#game/script.rpy:789
translate chinese war2_4652c182:

    # x "Each one?"
    x "每一单位？"

#game/script.rpy:790
translate chinese war2_cf1adef2:

    # mc "Yeah."
    mc "对。"

#game/script.rpy:791
translate chinese war2_b12706eb:

    # mc "And we don't know how many there are."
    mc "而且我们不知道有多少。"

#game/script.rpy:793
translate chinese war2_635b87ba:

    # mc "We scout first."
    mc "我们先侦察。"

#game/script.rpy:794
translate chinese war2_19453ed6:

    # mc "Assess."
    mc "评估。"

#game/script.rpy:795
translate chinese war2_4081d355:

    # mc "Then we move."
    mc "然后行动。"

#game/script.rpy:796
translate chinese war2_c4a373fc:

    # E "Understood."
    E "明白。"

#game/script.rpy:798
translate chinese war2_d00b13fc:

    # mc "Questions?"
    mc "有问题吗？"

#game/script.rpy:799
translate chinese war2_3cfb0cb5:

    # h "Why would Azarkhan show up himself?"
    h "阿扎尔汗为什么会亲自现身？"

#game/script.rpy:800
translate chinese war2_6cd0d4ee:

    # h "Doesn’t seem like his style."
    h "不像是他的风格。"

#game/script.rpy:801
translate chinese war2_47f00c67:

    # mc "Last guy who worked with him is dead. He doesn’t have a choice."
    mc "上一个和他合作的人死了。他没得选。"

#game/script.rpy:802
translate chinese war2_e43ef6d5:

    # mc "And that cargo? Too important to delegate. He’ll show."
    mc "那批货？太重要了，不能委托别人。他会出现的。"

#game/script.rpy:803
translate chinese war2_2f9028a8:

    # mc "Anything else?"
    mc "还有别的吗？"

#game/script.rpy:804
translate chinese war2_607d788c:

    # h "None."
    h "没了。"

#game/script.rpy:805
translate chinese war2_f456a99d:

    # mc "Then we wait."
    mc "那就等。"

#game/script.rpy:808
translate chinese war2_c43c8cc4:

    # r "6-Bravo, this is Eagle-2. Do you copy?"
    r "6-Bravo，这里是鹰眼2号。收到吗？"

#game/script.rpy:809
translate chinese war2_71b6dc1b:

    # r "A convoy has been spotted approaching you from the east at high speed."
    r "发现一支车队从东面高速接近你们。"

#game/script.rpy:810
translate chinese war2_d66cb7ff:

    # r "Confirm you’ve received this information."
    r "确认收到此信息。"

#game/script.rpy:813
translate chinese war2_1f37d416:

    # mc "Eagle-2, this is 6-Bravo. Copy. ETA?"
    mc "鹰眼2号，这里是6-Bravo。收到。预计到达时间？"

#game/script.rpy:816
translate chinese war2_22cc99c9:

    # r "6-Bravo, ETA is 20 minutes."
    r "6-Bravo，预计二十分钟。"

#game/script.rpy:817
translate chinese war2_300063c9:

    # r "They’re moving fast — two vehicles in total."
    r "他们速度很快——总共两辆车。"

#game/script.rpy:818
translate chinese war2_1c6255a1:

    # r "Do not engage first. {w}Await further instructions. {w}Out."
    r "不要先开火。{w}等待进一步指示。{w}完毕。"

#game/script.rpy:824
translate chinese war2_9132fb47:

    # mc "Positions. Twenty minutes."
    mc "就位。二十分钟。"

#game/script.rpy:825
translate chinese war2_fdaabc93:

    # mc "Move. Now."
    mc "行动。现在。"

#game/script.rpy:837
translate chinese war2_f5d3cca6:

    # x "Finally, some action... {w=0.7}Can’t wait to shred these bastards to pieces. {w=0.7}Just show yourselves."
    x "终于有点动静了……{w=0.7}等不及把这些混蛋撕成碎片了。{w=0.7}快现身吧。"

#game/script.rpy:841
translate chinese war2_f4fdb62e:

    # mc "Shiya. You in position?"
    mc "诗雅。就位了吗？"

#game/script.rpy:843
translate chinese war2_20993109:

    # S "Affirmative."
    S "确认。"

#game/script.rpy:845
translate chinese war2_485b296e:

    # mc "Report."
    mc "报告。"

#game/script.rpy:847
translate chinese war2_1d981af3:

    # S "Movement spotted to the east, two vehicles."
    S "东面发现移动目标，两辆车。"

#game/script.rpy:848
translate chinese war2_f41d8ad7:

    # S "One vehicle to the north. {w=0.7}Nothing else."
    S "北面一辆车。{w=0.7}其他没了。"

#game/script.rpy:850
translate chinese war2_4c8be30e:

    # mc "Hold. No engagement without my order."
    mc "待命。没有我的命令不准开火。"

#game/script.rpy:851
translate chinese war2_1edefd14:

    # x "Come on, Commander!"
    x "拜托，指挥官！"

#game/script.rpy:852
translate chinese war2_423d5a46:

    # x "We can take them, just a handful of guys. Two volleys, and they’re done."
    x "我们能搞定，就几个人。两轮齐射，他们就完了。"

#game/script.rpy:854
translate chinese war2_5f8c7056:

    # S "And what if this is only part of the group?"
    S "如果这只是他们一部分人呢？"

#game/script.rpy:855
translate chinese war2_cbe7890b:

    # S "Or did your dumb brain skip that thought and jump straight to action?"
    S "还是你那蠢脑子跳过这个念头直接想动手了？"

#game/script.rpy:856
translate chinese war2_0b5aade4:

    # x "What did you just say? Stupid brain?! {w=0.7}Oh, you little perra!"
    x "你刚才说什么？蠢脑子？！{w=0.7}哦，你这个小婊子！"

#game/script.rpy:857
translate chinese war2_0245f736:

    # S "Oh, fuck off."
    S "哦，滚开。"

#game/script.rpy:859
translate chinese war2_8b9ee863:

    # mc "Enough."
    mc "够了。"

#game/script.rpy:860
translate chinese war2_e11008ed:

    # mc "Alexandro — position. Now."
    mc "亚历山德罗——就位。现在。"

#game/script.rpy:861
translate chinese war2_e3f54460:

    # mc "Shiya — continue observation."
    mc "诗雅——继续观察。"

#game/script.rpy:862
translate chinese war2_f591cea5:

    # S "(whispering) Always complaining like a kid... {w=0.7}(louder)Understood."
    S "（低声）总像个孩子一样抱怨……{w=0.7}（大声）明白。"

#game/script.rpy:863
translate chinese war2_b02ece1d:

    # S "Aside from this group, no enemies in sight."
    S "除了这群人，视野内无敌人。"

#game/script.rpy:865
translate chinese war2_d3bd09e3:

    # mc "Target?"
    mc "目标？"

#game/script.rpy:866
translate chinese war2_48d39a64:

    # S "Negative. The target isn’t visible. {w=0.7}There’s a chance this is a decoy. {w=0.7}What are your orders, sir?"
    S "未发现。目标不在视野内。{w=0.7}有可能是诱饵。{w=0.7}请指示，长官。"

#game/script.rpy:867
translate chinese war2_92e44935:

    # mc "We wait."
    mc "我们等。"

#game/script.rpy:868
translate chinese war2_81837a17:

    # S "No outer perimeter either."
    S "也没有外围警戒。"

#game/script.rpy:869
translate chinese war2_ac6eb6a6:

    # S "No scouts. No overwatch."
    S "没有侦察兵。没有高点监视。"

#game/script.rpy:870
translate chinese war2_daea382f:

    # S "For cargo this hot... that's wrong."
    S "这么烫手的货……不对劲。"

#game/script.rpy:872
translate chinese war2_f975f778:

    # mc "(Either they're idiots...)"
    mc "（要么他们是白痴……）"

#game/script.rpy:873
translate chinese war2_be4902e0:

    # mc "(Or they know we're here.)"
    mc "（要么他们知道我们在这儿。）"

#game/script.rpy:881
translate chinese war2_670f4b9f:

    # a "Well, well... it’s been a long time."
    a "哎呀哎呀……好久不见。"

#game/script.rpy:882
translate chinese war2_06929f2d:

    # a "Glad to see you after all these years, my old friend."
    a "这么多年后见到你很高兴，老朋友。"

#game/script.rpy:883
translate chinese war2_058d97c8:

    # a "How’s the wife? {w=0.7}Daughter? {w=0.7}Everything great, I assume?"
    a "妻子怎么样？{w=0.7}女儿呢？{w=0.7}一切都好吧，我猜？"

#game/script.rpy:885
translate chinese war2_5f325df2:

    # az "I don’t have time for this. Let’s get to the point."
    az "我没时间废话。说正事。"

#game/script.rpy:886
translate chinese war2_069325ca:

    # az "Do you have the goods?"
    az "货带来了吗？"

#game/script.rpy:887
translate chinese war2_eefb2a5f:

    # a "You’re still the same grumpy old man. {w=0.7}But yes, I have the goods."
    a "你还是那个坏脾气的老头。{w=0.7}不过是的，货在我这儿。"

#game/script.rpy:888
translate chinese war2_15a7ddfe:

    # a "You have no idea what it cost me to get them."
    a "你根本不知道我为了弄到它们付出了什么。"

#game/script.rpy:889
translate chinese war2_7a0a13f5:

    # a "Although I wasn’t able to kill all the witnesses — one scientist managed to escape."
    a "不过我没能杀掉所有目击者——有个科学家逃掉了。"

#game/script.rpy:891
translate chinese war2_43227143:

    # mc "(A scientist...)"
    mc "（一个科学家……）"

#game/script.rpy:892
translate chinese war2_3c30c8cd:

    # "For a split second, every muscle in [mc]'s body tenses."
    "有那么一瞬间，[mc]全身的肌肉都绷紧了。"

#game/script.rpy:893
translate chinese war2_1cf0007c:

    # mc "(That was...)"
    mc "（那是……）"

#game/script.rpy:895
translate chinese war2_56cf5de7:

    # mc "(Lora's meeting. The substance. A vanished city.)"
    mc "（洛拉的会议。那种物质。一座消失的城市。）"

#game/script.rpy:896
translate chinese war2_21ee93b7:

    # "Slowly, he forces himself to relax."
    "他慢慢强迫自己放松下来。"

#game/script.rpy:897
translate chinese war2_8b044b4a:

    # mc "(Don't jump. Confirm first.)"
    mc "（别急着下结论。先确认。）"

#game/script.rpy:899
translate chinese war2_f8a947b0:

    # az "Doesn’t matter. {w=0.7}The important thing is that you secured the goods."
    az "无所谓。{w=0.7}重要的是你拿到了货。"

#game/script.rpy:900
translate chinese war2_c84930f7:

    # az "So, where are they?"
    az "那么，货在哪？"

#game/script.rpy:902
translate chinese war2_aa713e77:

    # a "Hey, rookies! Bring it out."
    a "嘿，菜鸟们！拿出来。"

#game/script.rpy:905
translate chinese war2_be3ea1a8:

    # a "Our boss wants to take a look."
    a "我们老板想看看。"

#game/script.rpy:912
translate chinese war2_97afc65a:

    # S "I see movement at the back. {w=0.7}It might be the target. {w=0.7}What are your orders?"
    S "我看到后方有动静。{w=0.7}可能是目标。{w=0.7}请指示。"

#game/script.rpy:913
translate chinese war2_57f1101d:

    # mc "Wait. {w=0.7}Don’t rush — we need to confirm it’s the real deal."
    mc "等等。{w=0.7}别急——我们需要确认真货。"

#game/script.rpy:914
translate chinese war2_5bc30440:

    # S "Understood."
    S "明白。"

#game/script.rpy:918
translate chinese war2_2a20414c:

    # a "You know, I usually don’t stick my nose into other people’s business."
    a "你知道，我通常不爱管别人的闲事。"

#game/script.rpy:919
translate chinese war2_47190cf3:

    # a "But I’ll make an exception this time. {w=0.7}Mind telling me what this thing really is?"
    a "但这次我破例。{w=0.7}介意告诉我这东西到底是什么吗？"

#game/script.rpy:921
translate chinese war2_0540067f:

    # a "No one I’ve asked seems to know its origin — like it just fell from the sky."
    a "我问过的人都不知道它的来源——就像从天上掉下来的。"

#game/script.rpy:922
translate chinese war2_73dc1208:

    # a "And I don’t like secrets."
    a "我不喜欢秘密。"

#game/script.rpy:924
translate chinese war2_ac30220f:

    # az "It doesn’t concern you."
    az "与你无关。"

#game/script.rpy:926
translate chinese war2_ffe8753b:

    # az "And I don’t repeat myself."
    az "我不重复第二遍。"

#game/script.rpy:927
translate chinese war2_82b66bea:

    # az "You give me the goods, I give you the promised amount. {w=0.7}No more, no less. Got it?"
    az "你给我货，我给你说好的数。{w=0.7}不多不少。明白吗？"

#game/script.rpy:929
translate chinese war2_b5ffdd14:

    # a "Alright, alright."
    a "行行行。"

#game/script.rpy:930
translate chinese war2_3586621a:

    # a "Don’t want to cross the line — might end up like the others."
    a "不想越界——不然可能落得跟其他人一样的下场。"

#game/script.rpy:932
translate chinese war2_4b67e53d:

    # az "My patience isn’t limitless."
    az "我的耐心不是无限的。"

#game/script.rpy:934
translate chinese war2_bb8e4b4e:

    # a "..."
    a "……"

#game/script.rpy:938
translate chinese war2_b5f29ed6:

    # a "Your wish is my command."
    a "如你所愿。"

#game/script.rpy:941
translate chinese war2_8178b944:

    # a "Handle it carefully. {w=0.7}This container is worth several hundred of your lives."
    a "小心点拿。{w=0.7}这个容器值你们几百条命。"

#game/script.rpy:945
translate chinese war2_01164b3d:

    # a "Now, allow me to present the crown jewel of my collection: dragon eggs!"
    a "现在，请允许我呈上我收藏的皇冠明珠：龙蛋！"

#game/script.rpy:947
translate chinese war2_2b6baccc:

    # az "..."
    az "……"

#game/script.rpy:949
translate chinese war2_720287bb:

    # az "Dragon eggs? {w=0.7}Are you serious?"
    az "龙蛋？{w=0.7}你认真的？"

#game/script.rpy:950
translate chinese war2_1eb6aaec:

    # az "You’ve got to be joking..."
    az "你肯定在开玩笑……"

#game/script.rpy:952
translate chinese war2_1cccc07c:

    # a "Just a little. {w=0.7}Open it."
    a "开个小玩笑。{w=0.7}打开它。"

#game/script.rpy:954
translate chinese war2_7b83e7c4:

    # a "I hope it’s what you’ve been looking for."
    a "希望这就是你一直在找的。"

#game/script.rpy:956
translate chinese war2_1556e3c2:

    # S "Commander..."
    S "指挥官……"

#game/script.rpy:957
translate chinese war2_a32b88cf:

    # S "I'm getting a spike from the case."
    S "箱子有反应。"

#game/script.rpy:958
translate chinese war2_c158f764:

    # S "Radiation?"
    S "辐射？"

#game/script.rpy:959
translate chinese war2_a8224bdc:

    # S "No. Not exactly."
    S "不。不完全是。"

#game/script.rpy:960
translate chinese war2_700825e4:

    # S "Whatever it is, it's bending the readings."
    S "不管是什么，读数都被扭曲了。"

#game/script.rpy:962
translate chinese war2_286ea44e:

    # a "Plenty of my colleagues died for this, so the price has gone up."
    a "我很多同事为这个死了，所以价格涨了。"

#game/script.rpy:963
translate chinese war2_32d8e242:

    # az "How much?"
    az "多少？"

#game/script.rpy:964
translate chinese war2_54fa6bf6:

    # a "Twice as much."
    a "两倍。"

#game/script.rpy:965
translate chinese war2_2b6baccc_1:

    # az "..."
    az "……"

#game/script.rpy:967
translate chinese war2_78ec22f6:

    # az "Fine."
    az "行。"

#game/script.rpy:969
translate chinese war2_7fe6aee3:

    # mc "Shiya, status. {w}Can you see what’s in the container?"
    mc "诗雅，情况如何。{w}能看到容器里是什么吗？"

#game/script.rpy:970
translate chinese war2_12b39bb2:

    # S "Negative. {w=0.6}Too much distortion."
    S "不行。{w=0.6}干扰太强。"

#game/script.rpy:971
