#game/script.rpy:3591
translate chinese norman_home_5e36508b:

    # N "No."
    N "不。"

#game/script.rpy:3592
translate chinese norman_home_533a5c58:

    # N "The place Mom took me."
    N "妈妈带我去过的地方。"

#game/script.rpy:3593
translate chinese norman_home_056e1b5f:

    # N "Past the old service road."
    N "过了那条旧维护道。"

#game/script.rpy:3594
