#game/script.rpy:3618
translate chinese norman_home_2b35b6fe_7:

    # mc "..."
    mc "……"

#game/script.rpy:3620
translate chinese norman_home_9485ef37:

    # mc "Then if you’re coming with me… you don’t slow me down."
    mc "那你要是跟我去……就别拖我后腿。"

