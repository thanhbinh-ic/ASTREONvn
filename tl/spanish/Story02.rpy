translate spanish akt2chapter4_705e2123:

    # o "If we stay, we go with him."
    o "Si nos quedamos, iremos con él."

# game/Story02.rpy:2722

translate spanish akt2chapter4_b808da4f:

    # o "...He made his choice."
    o "... tomó su decisión."

# game/Story02.rpy:2724

translate spanish akt2chapter4_85260f14:

    # o "MOVE!"
    o "¡Muévete!"

