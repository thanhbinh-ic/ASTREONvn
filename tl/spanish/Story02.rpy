    # mc "It’s never too late to make new memories with new people, you know?"
    mc "Nunca es demasiado tarde para hacer nuevos recuerdos con gente nueva, ¿sabes?"

# game/Story02.rpy:4015

translate spanish akt2chapter7_dacd2a66:

    # mc "All it takes is the will..."
    mc "Todo lo que se necesita es la voluntad..."

# game/Story02.rpy:4019

