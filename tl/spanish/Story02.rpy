    # o "Slap my ass and call me a horse, you actually pulled it off… {w}How’re you feeling? {w}That was a hell of a strain on your body."
    o "Me golpeas el culo y me llamas un caballo, de hecho lo sacaste... {w}¿Cómo te sientes? {w}Eso fue una gran tensión en tu cuerpo."

# game/Story02.rpy:548

translate spanish story03_f39edf21:

    # mc "Don’t overreact. {w}It was just a rusty old door — nothing supernatural about it."
    mc "No exageres. {w}Era solo una vieja puerta oxidada — nada sobrenatural sobre ella."

# game/Story02.rpy:550

translate spanish story03_17720e65:

    # gggg "If that were true, we wouldn’t have been stuck here for so damn long."
    gggg "Si eso fuera cierto, no habríamos estado atrapados aquí por tanto tiempo."

# game/Story02.rpy:551

translate spanish story03_d3f59c71:

    # gg "Might not look like much, but that thing weighs a few hundred shards."
    gg "No parece mucho, pero esa cosa pesa unos pocos cientos de fragmentos."

# game/Story02.rpy:554

translate spanish story03_f1dbd9c2:

    # mc "Shards? What is that?"
    mc "¿Qué es eso?"

# game/Story02.rpy:557

translate spanish story03_89f2f62f:

    # o "Unit of weight… {w}Not important. If you say you’re fine, then good."
    o "Unidad de peso... {w}No es importante. Si usted dice que está bien, entonces bien."

# game/Story02.rpy:560

translate spanish story03_91118a8b:

    # o "But once this is over… {w}You’re getting checked out. No arguments."
    o "Pero una vez que esto termine... {w}Te están echando de menos."

# game/Story02.rpy:564

translate spanish story03_5c00aa91:

    # gggg "Stay put. We’ll scout ahead."
    gggg "Mantente quieto. Vamos a explorar adelante."

# game/Story02.rpy:566

translate spanish story03_d41c6ca0:

    # k "Well… {w}you {b}are{/b} full of surprises."
    k "Bueno... {w}Tú {b}son{/b} lleno de sorpresas."

# game/Story02.rpy:567

translate spanish story03_a5993cbb:

    # k "Let’s see if you can keep it up."
    k "Veamos si puedes mantenerlo."

# game/Story02.rpy:570

translate spanish story03_12f35037:

    # k "Remind me, what’s your name again? {w}Don’t think we’ve properly introduced."
    k "Recuérdame, ¿cuál es tu nombre de nuevo? {w}No creas que hemos introducido correctamente."

# game/Story02.rpy:572

translate spanish story03_2b35b6fe_1:

    # mc "..."
    mc "..."

# game/Story02.rpy:574

translate spanish story03_bd7d9df9:

    # mc "[mc]."
    mc "[mc]."

# game/Story02.rpy:575

translate spanish story03_c9474a26:

    # mc "Just [mc]."
    mc "Solo [mc]."

# game/Story02.rpy:577

translate spanish story03_12cd1342:

    # k "Kalestra. {w}Pleasure."
    k "Kalestra. {w}Un placer."

# game/Story02.rpy:582

translate spanish story03_2fded262_1:

    # h "..."
    h "..."

# game/Story02.rpy:584

translate spanish story03_38ed920e:

    # h "Olivia. {w}Not that it matters. {w}Doubt you’ll remember, so don’t bother trying."
    h "Olivia. {w}No es que importe. {w}Duda que recuerdes, así que no te molestes en intentarlo."

# game/Story02.rpy:586

translate spanish story03_e866be85:

    # k "You know, great idea. {w}I’d totally do that…"
    k "Ya sabes, gran idea. {w}Yo haría eso totalmente..."

# game/Story02.rpy:587

translate spanish story03_e442c2ea:

    # k "...if I actually liked being told what to do."
    k "...si me gustaba que me dijeran qué hacer."

# game/Story02.rpy:589

translate spanish story03_bb9f8ca3:

    # Mi "There were a lot of rumors about you back at the academy. {w}One of them said…"
    Mi "Había muchos rumores sobre ti en la academia. {w}Uno de ellos dijo..."

# game/Story02.rpy:590

translate spanish story03_09715aa4:

    # Mi "…you can’t stand people giving you orders."
    Mi "... no puedes soportar que la gente te dé órdenes."

# game/Story02.rpy:593

translate spanish story03_39b5c58a:

    # Mi "So how did you end up as a War Maiden? {w}Aren’t they all about following commands without question?"
    Mi "¿Cómo acabaste como una dama de guerra? {w}¿No son todos los que siguen órdenes sin duda?"

# game/Story02.rpy:595

translate spanish story03_246f1f5b:

    # k "Since when were you this nosy?"
    k "¿Desde cuándo eras tan ruidosa?"

# game/Story02.rpy:596

translate spanish story03_4378a4a7:

    # k "Don’t you have your own life to worry about?"
    k "¿No tienes tu propia vida de la que preocuparte?"

# game/Story02.rpy:597

translate spanish story03_da3fdbf1_8:

    # Mi "..."
    Mi "..."

# game/Story02.rpy:599

translate spanish story03_14737f41:

    # Mi "Sometimes, someone else’s life tells you a lot more."
    Mi "A veces, la vida de alguien más te dice mucho más."

# game/Story02.rpy:601

translate spanish story03_86087dee:

    # h "Hold up… You two know each other? {w}I thought this was your first time meeting. Did I miss something?"
    h "Espera... ¿Se conocen? {w}Pensé que era tu primera reunión. ¿Me perdí algo?"

# game/Story02.rpy:603

translate spanish story03_6d9cf2c5:

    # k "First time {b}IN PERSON{/b}, sure. {w}But the world’s small. Gossip? Even smaller."
    k "Primera vez {b}EN PERSONA{/b}- Claro. {w}Pero el mundo es pequeño. ¿Gosip? Incluso más pequeño."

# game/Story02.rpy:604

translate spanish story03_82c3a9bd:

    # k "I’ve heard plenty about the Cold Reaper. {w}Though, not sure that’s a good thing for an assassin."
    k "He oído mucho sobre el Reaper Frío. {w}Aunque, no estoy seguro de que sea algo bueno para un asesino."

# game/Story02.rpy:606

translate spanish story03_86d2b60c:

    # Mi "You work with what you’ve got. {w}And in our line of work, information is everything."
    Mi "Trabajas con lo que tienes. {w}Y en nuestra línea de trabajo, la información es todo."

# game/Story02.rpy:607

translate spanish story03_4f207d0f:

    # Mi "Sixty percent of the job, at least."
    Mi "El 60% del trabajo, al menos."

# game/Story02.rpy:609

translate spanish story03_2a9c65ea:

    # k "Only sixty? So what’s the rest? My winning smile?"
    k "¿Solo sesenta? ¿Cuál es el resto? Mi sonrisa ganadora?"

# game/Story02.rpy:611

translate spanish story03_6549d721:

    # Mi "Your ability to keep secrets."
    Mi "Tu habilidad para guardar secretos."

# game/Story02.rpy:612

translate spanish story03_a1b7e73e:

    # k "Hah. {w}Smartass."
    k "Hah. {w}Smartass."

# game/Story02.rpy:614

translate spanish story03_315fa02b:

    # o "What’s ahead? See anything?"
    o "¿Qué hay por delante? ¿Ves algo?"

# game/Story02.rpy:615

translate spanish story03_1da40134:

    # gg "Yeah, sir. Tunnel leads straight to our destination. Should be a clear path."
    gg "Sí, señor, el túnel conduce directamente a nuestro destino."

# game/Story02.rpy:616

translate spanish story03_292389f5:

    # o "You heard him. Time to move."
    o "Ya lo has oído, es hora de moverse."

# game/Story02.rpy:618

translate spanish story03_e888a9c5:

    # o "Stay sharp, though. No telling what we might run into on the way."
    o "No digas en qué nos encontramos en el camino."

# game/Story02.rpy:619

translate spanish story03_02f99ab5:

    # o "Last thing we need is more trouble on top of what we already have."
    o "Lo último que necesitamos es más problemas por encima de lo que ya tenemos."

# game/Story02.rpy:626

translate spanish akt2chapter2_c690044d:

    # "One not-so-fun trip later…"
    "Un viaje no tan divertido más tarde..."

# game/Story02.rpy:630

translate spanish akt2chapter2_52a2d364:

    # mc "Come on... faster... {w}This thing is heavy..."
    mc "Vamos... más rápido... {w}Esta cosa es pesada..."

# game/Story02.rpy:633

translate spanish akt2chapter2_20ac4c43:

    # g "Damn, man, you’re a beast! No idea what we’d do without you."
    g "¡Maldita sea, hombre, eres una bestia! No hay idea de lo que haríamos sin ti."

# game/Story02.rpy:636

translate spanish akt2chapter2_68966098:

    # gg "Oh, I know. Blow the whole damn thing up."
    gg "Lo sé, arrápalo todo."

# game/Story02.rpy:637

translate spanish akt2chapter2_bca664fb:

    # g "Oh, shut up already."
    g "Oh, cállate ya."

# game/Story02.rpy:639

translate spanish akt2chapter2_0ff8c54f:

    # mc "(Weird bunch… but at least they’re not boring.)"
    mc "(Muchos raros... pero al menos no son aburridos.)"

# game/Story02.rpy:641

translate spanish akt2chapter2_f7703c8d:

    # Mi "Lost in thought?"
    Mi "¿Perdido en el pensamiento?"

# game/Story02.rpy:643

translate spanish akt2chapter2_373831de:

    # mc "Just contemplating world peace. {w}Also… now’s really not the best time for chit-chat."
    mc "Solo contemplaba la paz mundial. {w}Además... ahora no es el mejor momento para charlar."

# game/Story02.rpy:645

translate spanish akt2chapter2_deeaa40b:

    # mc "Sorry if that came off rude, but can we please move faster?"
    mc "Siento que haya sido grosero, pero ¿podemos movernos más rápido?"

# game/Story02.rpy:648

translate spanish akt2chapter2_47e17c62:

    # Mi "Yeah, you’re right. My bad."
    Mi "Sí, tienes razón."

# game/Story02.rpy:650

translate spanish akt2chapter2_42e1ebf8:

    # h "You know? There are three types of people in the world."
    h "Hay tres tipos de personas en el mundo."

# game/Story02.rpy:652

translate spanish akt2chapter2_fb150785:

    # h "Those who can count and those who can’t."
    h "Aquellos que pueden contar y aquellos que no pueden."

# game/Story02.rpy:654

translate spanish akt2chapter2_d82ebdc5:

    # mc "What are you even talking about? {w}And why aren’t you moving with the others?"
    mc "¿De qué estás hablando? {w}¿Y por qué no te mueves con los otros?"

# game/Story02.rpy:656

translate spanish akt2chapter2_0e4f86e2:

    # h "Me? {w}Oh, I’m just holding up this giant rock so that if it falls, it crushes both of us."
    h "¿Yo? {w}Oh, solo estoy sosteniendo esta roca gigante para que si cae, nos aplasta a ambos."

# game/Story02.rpy:658

translate spanish akt2chapter2_efca6e56:

    # h "Romantic, don’t you think?"
    h "Romántico, ¿no crees?"

# game/Story02.rpy:660

translate spanish akt2chapter2_2b35b6fe:

    # mc "..."
    mc "..."

# game/Story02.rpy:662

translate spanish akt2chapter2_a55eeba6:

    # mc "Moments like these make me wonder… {w}Are you joking, or are you actually serious?"
    mc "Momentos como estos me hacen preguntarme... {w}¿Estás bromeando o en serio?"

# game/Story02.rpy:664

translate spanish akt2chapter2_c1201a10:

    # h "Who knows? {w}Maybe both."
    h "¿Quién sabe? {w}Tal vez ambos."

# game/Story02.rpy:666

translate spanish akt2chapter2_eabae38e:

    # h "Either way, everyone’s through now, so let’s get the hell outta here. {w}Just… be careful, alright?"
    h "De cualquier manera, todos han terminado ahora, así que salgamos de aquí. {w}Solo... ten cuidado, ¿de acuerdo?"

# game/Story02.rpy:669

translate spanish akt2chapter2_ad5c5627:

    # Mi "We’re almost there. Just a little more, and we’ll be out of this place."
    Mi "Estamos casi allí. Un poco más, y estaremos fuera de este lugar."

# game/Story02.rpy:672

translate spanish akt2chapter2_67fd69e5:

    # h "Really hope everything goes smoothly. {w}And honestly? I could use some rest after all this crap."
    h "Realmente espero que todo vaya bien. {w}Y honestamente, podría usar un descanso después de toda esta mierda."

# game/Story02.rpy:673

translate spanish akt2chapter2_ffdc1cee:

    # h "A hot bath and silence… {w}Sounds like a damn fantasy."
    h "Un baño caliente y silencio... {w}Suena como una maldita fantasía."

# game/Story02.rpy:675

translate spanish akt2chapter2_a6f80301:

    # h "These past couple of weeks have been more eventful than the last five years of my life."
    h "Estas últimas semanas han sido más sucesivas que los últimos cinco años de mi vida."

# game/Story02.rpy:677

translate spanish akt2chapter2_f9c9a2d6:

    # mc "A couple of weeks for you. {w}Some of us just woke up yesterday."
    mc "Un par de semanas para ti. {w}Algunos de nosotros acabamos de despertar ayer."

# game/Story02.rpy:679

translate spanish akt2chapter2_d5b4a359:

    # o "…Well, would you look at that."
    o "...Bueno, ¿podrías mirar eso?"

# game/Story02.rpy:680

translate spanish akt2chapter2_db8b7a4a:

    # o "So this is the power station? {w}Hell of a size."
    o "¿Así que esta es la central eléctrica? {w}De un tamaño muy grande."

# game/Story02.rpy:684

translate spanish akt2chapter2_529d9568:

    # o "But why is this facility directly connected to the plant?"
    o "¿Pero por qué esta instalación está directamente conectada a la planta?"

# game/Story02.rpy:685

translate spanish akt2chapter2_a1cce71f:

    # o "And why did no one know about it…?"
    o "¿Y por qué nadie sabía de ello?"

# game/Story02.rpy:687

translate spanish akt2chapter2_35a3305f:

    # gggg "Sir… is it just me, or does this place look abandoned?"
    gggg "Señor... ¿solo soy yo, o este lugar parece abandonado?"

# game/Story02.rpy:688

translate spanish akt2chapter2_28633f8a:

    # o "What makes you say that?"
    o "¿Qué te hace decir eso?"

# game/Story02.rpy:689

translate spanish akt2chapter2_ce749d87:

    # gggg "The vending machine. Everything in it is expired."
    gggg "Todo está caducado."

# game/Story02.rpy:691

translate spanish akt2chapter2_0fd69bd3:

    # g "You serious right now? {w}It’s like you’ve never seen expired food before."
    g "¿Hablas en serio ahora? {w}Es como si nunca hubieras visto comida vencida antes."

# game/Story02.rpy:692

translate spanish akt2chapter2_7caa502e:

    # gggg "Twelve years past the date? {w}Yeah, actually, first time."
    gggg "¿Doce años después de la fecha? {w}Sí, en realidad, primera vez."

# game/Story02.rpy:696

translate spanish akt2chapter2_ce6f7dfe:

    # k "There’s even older stuff in there. {w}Look closely, you’ll see a gap. {w}You could probably reach in and pull something out."
    k "Hay cosas más viejas ahí. {w}Mira de cerca, verás una brecha. {w}Probablemente podrías entrar y sacar algo."

# game/Story02.rpy:697

translate spanish akt2chapter2_b40772c5:

    # k "Not that I’d recommend it."
    k "No es que lo recomendara."

# game/Story02.rpy:700

translate spanish akt2chapter2_afedb139:

    # o "Miss Kalestra… Don’t tell me you’re familiar with this place?"
    o "Srta. Kalestra... ¿No me digas que estás familiarizado con este lugar?"

# game/Story02.rpy:703

translate spanish akt2chapter2_722d032d:

    # k "I used to be. {w}But we’re not here for storytime."
    k "Solía serlo. {w}Pero no estamos aquí para la historia."

# game/Story02.rpy:705

translate spanish akt2chapter2_7ab09ac4:

    # k "See that platform?"
    k "¿Ves esa plataforma?"

# game/Story02.rpy:707

translate spanish akt2chapter2_691b030b:

    # k "There. Used to be a relay. Now? Just a jammer. Huge pain in the ass."
    k "Era un relé, un martillo, un gran dolor en el culo."

# game/Story02.rpy:709

translate spanish akt2chapter2_f20a09f1:

    # mc "Fix it, restore comms. {w}Sounds simple… if not for one little problem, right?"
    mc "Arréglalo, restaura las comunicaciones. {w}Suena sencillo... si no por un pequeño problema, ¿verdad?"

# game/Story02.rpy:711

translate spanish akt2chapter2_a673a786:

    # k "Exactly. {w}The real issue? Those guys over there."
    k "Exactamente. {w}Esos tipos de ahí."

# game/Story02.rpy:712

translate spanish akt2chapter2_bdfb1de9:

    # k "Annoying, but not much of a threat. {w}As long as we deal with them fast."
    k "Animando, pero no es una amenaza. {w}Mientras tratemos con ellos rápido."

# game/Story02.rpy:713

translate spanish akt2chapter2_ba7dba7a:

    # o "Then why haven’t you done it already?"
    o "¿Entonces por qué no lo has hecho ya?"

# game/Story02.rpy:715

translate spanish akt2chapter2_b70d84d5:

    # k "Because I’m the walking definition of ‘All brawn, no brains.’"
    k "Porque soy la definición de caminar de ‘Todo el alboroto, sin cerebros.’"

# game/Story02.rpy:716

translate spanish akt2chapter2_3aa2da4c:

    # o "You just couldn’t recalibrate the antenna."
    o "No podías recalibrar la antena."

# game/Story02.rpy:717

translate spanish akt2chapter2_d8969875:

    # k "Neither could you, old man."
    k "Tú tampoco, viejo."

# game/Story02.rpy:718

translate spanish akt2chapter2_5a83f42d:

    # o "Alright, here’s the plan."
    o "Bien, aquí está el plan."

# game/Story02.rpy:719

translate spanish akt2chapter2_dd7ff9e0:

    # o "We go down, clear the area, disable the jammer, fix the antenna, and get out."
    o "Bajamos, despejamos el área, desactivamos el martillo, arreglamos la antena y salimos."

# game/Story02.rpy:722

translate spanish akt2chapter2_87c57aef:

    # gg "Sir… {w}What’s the plan after we go down there?"
    gg "Señor... {w}¿Cuál es el plan después de que vayamos allí?"

# game/Story02.rpy:723

translate spanish akt2chapter2_347b5064:

    # gg "Because that’s a one-way trip."
    gg "Porque es un viaje de un solo sentido."

# game/Story02.rpy:725

translate spanish akt2chapter2_7f4b1673:

    # o "And how exactly do you know that?"
    o "¿Y cómo sabes eso exactamente?"

# game/Story02.rpy:726

translate spanish akt2chapter2_5b6595d3:

    # gg "Analysis, sir."
    gg "Análisis, señor."

# game/Story02.rpy:728

translate spanish akt2chapter2_0bda8cde:

    # gg "Only exit we found is a massive staircase. {w}But it’s cut off halfway."
    gg "Solo la salida que encontramos es una escalera masiva. {w}Pero está cortada a mitad de camino."

# game/Story02.rpy:731

translate spanish akt2chapter2_29c51f08:

    # gg "The other end’s completely caved in. {w}If we go down there, we’re trapped."
    gg "El otro extremo está completamente cagado. {w}Si bajamos ahí, estamos atrapados."

# game/Story02.rpy:732

translate spanish akt2chapter2_7506c245:

    # gg "And this time, even explosives won’t help."
    gg "Y esta vez, ni siquiera los explosivos ayudarán."

# game/Story02.rpy:734

translate spanish akt2chapter2_012332f2:

    # o "You’ve got a point… {w}Everything about this place is screaming ‘Come on down…’"
    o "Tienes razón... {w}Todo sobre este lugar grita: ‘Ven abajo...’"

# game/Story02.rpy:735

translate spanish akt2chapter2_dc0815c2:

    # o "And that never leads to anything good."
    o "Y eso nunca conduce a nada bueno."

# game/Story02.rpy:738

translate spanish akt2chapter2_6d46897e:

    # o "We don’t know how many of them are down there. {w}Sure, they’re not exactly smart enough to set up an ambush…"
    o "No sabemos cuántos de ellos están ahí abajo. {w}Claro, no son exactamente lo suficientemente inteligentes para establecer una emboscada..."

# game/Story02.rpy:739

translate spanish akt2chapter2_58d52806:

    # o "But underestimating your enemy is how you lose."
    o "Pero subestimar a tu enemigo es cómo pierdes."

# game/Story02.rpy:742

translate spanish akt2chapter2_c02beba6:

    # o "So maybe, before we—"
    o "Así que tal vez antes de..."

# game/Story02.rpy:745

translate spanish akt2chapter2_e3805599:

    # k "Too many words."
    k "Demasiados términos."

# game/Story02.rpy:748

translate spanish akt2chapter2_d653e96c:

    # o "You’ve gotta be kidding me… {w}WHAT ABOUT THE PLAN?!"
    o "Tienes que estar bromeando... {w}¿Y el plan?"

# game/Story02.rpy:749

translate spanish akt2chapter2_47fae973:

    # k "TO HELL WITH IT!"
    k "¡Para contar con eso!"

# game/Story02.rpy:750

translate spanish akt2chapter2_b11ef479:

    # h "Oh my god. She’s actually doing it."
    h "Oh Dios mío. Ella lo está haciendo."

# game/Story02.rpy:751

translate spanish akt2chapter2_2bb3f650:

    # Mi "…This is why we don’t make plans."
    Mi "... Por eso no hacemos planes."

# game/Story02.rpy:753

translate spanish akt2chapter2_1c1345b9:

    # mc "(She really reminds me of someone…)"
    mc "(Ella realmente me recuerda a alguien...)"

# game/Story02.rpy:755

translate spanish akt2chapter2_20fab54b:

    # h "There’s a special type of people who are always in a hurry."
    h "Hay un tipo especial de personas que siempre tienen prisa."

# game/Story02.rpy:756

translate spanish akt2chapter2_053d7983:

    # h "The Rushians."
    h "Los Rushians."

# game/Story02.rpy:758

translate spanish akt2chapter2_8eedf0bd:

    # h "But seriously… Maybe now’s a good time to move in after her?"
    h "Pero en serio... ¿Tal vez ahora es un buen momento para mudarse después de ella?"

# game/Story02.rpy:759

translate spanish akt2chapter2_5e29d151:

    # h "Or are we just gonna stand here and watch her cut through them all?"
    h "¿O vamos a quedarnos aquí y verla pasar por todos ellos?"

# game/Story02.rpy:761

translate spanish akt2chapter2_af2aa9df:

    # o "Lead the way. Show us the passage you found."
    o "Enséñanos el pasaje que encontraste."

# game/Story02.rpy:773

translate spanish akt2chapter2_a4fc6948:

    # k "You are filth that dared to go against our Empress."
    k "Eres una suciedad que se atrevió a ir contra nuestra Emperatriz."

# game/Story02.rpy:774

translate spanish akt2chapter2_cde6c03e:

    # k "You'll meet your end by my hand!"
    k "¡Te encontrarás con la muerte por mi mano!"

# game/Story02.rpy:776

translate spanish akt2chapter2_ecc4f090:

    # k "It's time to play, my darlings."
    k "Es hora de jugar, queridas."

# game/Story02.rpy:778

translate spanish akt2chapter2_a3551934:

    # k "COME TO MOMMY! I'LL CARVE YOU ALL UP!"
    k "Ven con mamá, ¡te estoy abofeteando a todos!"

# game/Story02.rpy:781

translate spanish akt2chapter2_69a46284:

    # Mi "She's really going all out."
    Mi "No bromea."

# game/Story02.rpy:784

translate spanish akt2chapter2_f168d966:

    # Mi "Do we really need to help her?"
    Mi "¿De verdad necesitamos ayudarla?"

# game/Story02.rpy:786

translate spanish akt2chapter2_de11ec24:

    # Mi "Looks like she can handle this just fine on her own."
    Mi "Parece que puede manejar esto solo."

# game/Story02.rpy:790

translate spanish akt2chapter2_a0326d31:

    # mc "Maybe. But leaving a lady in trouble just isn’t my style."
    mc "Tal vez. Pero dejar a una dama en problemas no es mi estilo."

# game/Story02.rpy:799

translate spanish akt2chapter2_8f48cdf2:

    # mc "(These implants feel... strange. My body feels so light, like I’m back in my prime.)"
    mc "(Estos implantes se sienten... extraños. Mi cuerpo se siente tan ligero, como si estuviera de vuelta en mi primer momento.)"

# game/Story02.rpy:803

translate spanish akt2chapter2_c3f9d0b0:

    # mc "(But there’s too many of them.)"
    mc "(Pero hay demasiados de ellos.)"

# game/Story02.rpy:804

translate spanish akt2chapter2_6a1840fd:

    # mc "(If they were just a bit smarter, they’d be real trouble. But lucky for us, they’re not.)"
    mc "(Si fueran un poco más inteligentes, serían problemas reales. Pero suerte para nosotros, no lo son)."

# game/Story02.rpy:807

translate spanish akt2chapter2_31777a57:

    # mc "(Right now, they’re just cannon fodder.)"
    mc "(Ahora mismo, son solo la forraje de cañón.)"

# game/Story02.rpy:808

translate spanish akt2chapter2_52550c82:

    # mc "(Mindless monsters. {w}No fear. No reason.)"
    mc "(Monstruos inigualables. {w}Sin miedo."

# game/Story02.rpy:810

translate spanish akt2chapter2_a68c7cb2:

    # mc "(But... even so — doesn’t matter. {w}Whoever stands in my way...)"
    mc "(Pero... incluso así – no importa. {w}Quien se interponga en mi camino...)"

# game/Story02.rpy:811

translate spanish akt2chapter2_59f779ac:

    # mc "(I’ll take them all down.)"
    mc "(Los llevaré a todos abajo.)"

# game/Story02.rpy:816

translate spanish akt2chapter2_6a4edd20:

    # mc "Lora, I’m coming for you..."
    mc "Lora, voy a venir por ti..."

# game/Story02.rpy:821

translate spanish akt2chapter2_82091822:

    # k "..."
    k "..."

# game/Story02.rpy:823

translate spanish akt2chapter2_2a799842:

    # mc "You’re really enjoying this, aren’t you?"
    mc "Realmente estás disfrutando de esto, ¿no?"

# game/Story02.rpy:826

translate spanish akt2chapter2_d8f54d89:

    # k "You say that like it’s a bad thing."
    k "Dices que es algo malo."

# game/Story02.rpy:827

translate spanish akt2chapter2_445663a1:

    # k "In war, all methods are fair game. {w}Ever heard of that?"
    k "En la guerra, todos los métodos son un juego justo. {w}¿Has oído hablar de eso?"

# game/Story02.rpy:828

translate spanish akt2chapter2_7e63343b:

    # k "Getting your hands a little dirty — no big deal."
    k "Poner tus manos un poco sucias, no es gran cosa."

# game/Story02.rpy:830

translate spanish akt2chapter2_def4f097:

    # mc "You’ve got a rather... peculiar sense of humor."
    mc "Tienes un sentido del humor bastante... peculiar."

# game/Story02.rpy:832

translate spanish akt2chapter2_1aa5ec22:

    # k "The same could be said about your jokes."
    k "Lo mismo se puede decir de tus chistes."

# game/Story02.rpy:833

translate spanish akt2chapter2_ddb43d90:

    # k "So I’d say we’re even."
    k "Así que diría que estamos a mano."

# game/Story02.rpy:836

translate spanish akt2chapter2_90b9c43a:

    # k "Anyway, while we wait for our dear team, I’ll check those tents. {w}Might find something useful."
    k "De todas formas, mientras esperamos a nuestro querido equipo, revisaré esas tiendas. {w}Podría encontrar algo útil."

# game/Story02.rpy:838

translate spanish akt2chapter2_ad80cb03:

    # k "They better not take their sweet time."
    k "Será mejor que no se tomen su tiempo dulce."

# game/Story02.rpy:841

translate spanish akt2chapter2_da3fdbf1:

    # Mi "..."
    Mi "..."

# game/Story02.rpy:842

translate spanish akt2chapter2_05303eab:

    # Mi "I don’t get it... {w}Why does she even need us? {w}What’s she trying to pull?"
    Mi "No lo entiendo... {w}¿Por qué nos necesita? {w}¿Qué intenta hacer?"

# game/Story02.rpy:844

translate spanish akt2chapter2_ed930ea4:

    # mc "No idea. {w}Maybe you should ask her?"
    mc "Ni idea. {w}¿Quizá deberías preguntarle?"

# game/Story02.rpy:845

translate spanish akt2chapter2_51b1405c:

    # mc "Dwelling on it won’t change anything."
    mc "Morir en ella no cambiará nada."

# game/Story02.rpy:846

translate spanish akt2chapter2_50ea7bca:

    # mc "We can’t just up and get rid of her."
    mc "No podemos simplemente levantarnos y deshacernos de ella."

# game/Story02.rpy:847

translate spanish akt2chapter2_6937b7e6:

    # mc "And right now — she’s a valuable ally."
    mc "Y ahora mismo — es una valiosa aliada."

# game/Story02.rpy:849

translate spanish akt2chapter2_da3fdbf1_1:

    # Mi "..."
    Mi "..."

# game/Story02.rpy:851

translate spanish akt2chapter2_dd856ee2:

    # mc "But if it bothers you that much… {w}Maybe just let things play out?"
    mc "Pero si te molesta tanto... {w}¿Quizás dejar que las cosas se despierten?"

# game/Story02.rpy:852

translate spanish akt2chapter2_c6cccf06:

    # mc "Life has a way of sorting things out. {w}Sometimes, it’s the only way to see who’s who."
    mc "La vida tiene una manera de arreglar las cosas. {w}A veces, es la única manera de ver quién es quién."

# game/Story02.rpy:855

translate spanish akt2chapter2_1e7c67ef:

    # h "For those with nothing to lose — maybe. {w}But if you’ve got something important... it’s best not to take that risk."
    h "Para aquellos que no tienen nada que perder, tal vez. {w}Pero si tienes algo importante... es mejor no correr ese riesgo."

# game/Story02.rpy:856

translate spanish akt2chapter2_ca58477b:

    # h "So, friendly advice: don’t take this old man’s words at face value."
    h "Por lo tanto, consejo amistoso: no tome las palabras de este viejo hombre a valor facial."

# game/Story02.rpy:858

translate spanish akt2chapter2_417697b5:

    # h "Damn, you guys... {w}We were only gone for a few minutes, and you already wiped them all out?"
    h "Maldita sea, chicos... {w}Solo nos fuimos unos minutos, ¿y ya los limpiaste a todos?"

# game/Story02.rpy:860

translate spanish akt2chapter2_bd0351f7:

    # h "Pretty damn impressive. {w}Borderline terrifying."
    h "Bastante impresionante. {w}Línea fronteriza aterradora."

# game/Story02.rpy:861

translate spanish akt2chapter2_a9b84641:

    # h "But really, couldn’t you have left at least someone for us? {w}I wanted to get some action too."
    h "Pero realmente, ¿no podrías haber dejado al menos a alguien para nosotros? {w}Yo también quería hacer algo de acción."

# game/Story02.rpy:863

translate spanish akt2chapter2_fb0a7125:

    # mc "Didn’t have time to sort out who gets what."
    mc "No tenía tiempo para resolver quién consigue qué."

# game/Story02.rpy:864

translate spanish akt2chapter2_5026df1b:

    # Mi "It was either us or them."
    Mi "Eramos nosotros o ellos."

# game/Story02.rpy:865

translate spanish akt2chapter2_b07d15b8:

    # mc "Where’s the rest of the team?"
    mc "¿Dónde está el resto del equipo?"

# game/Story02.rpy:868

translate spanish akt2chapter2_57484f15:

    # o "It took a little longer than expected."
    o "Se llevó un poco más de lo esperado."

# game/Story02.rpy:869

translate spanish akt2chapter2_56a3bbba:

    # o "The descent was steeper than it looked. Had to go old-school with a rope."
    o "El descenso era más pronunciado de lo que parecía."

# game/Story02.rpy:875

translate spanish akt2chapter2_32311fe7:

    # h "Yeah, and in the process, we completely blocked our own exit. {w}Brilliant."
    h "Sí, y en el proceso, bloqueamos completamente nuestra propia salida. {w}Genial."

# game/Story02.rpy:878

translate spanish akt2chapter2_b2b9e19d:

    # mc "What do you mean?"
    mc "¿Qué quieres decir?"

# game/Story02.rpy:880

translate spanish akt2chapter2_9e007e9f:

    # o "We didn’t have time to calculate everything."
    o "No teníamos tiempo para calcular todo."

# game/Story02.rpy:881

translate spanish akt2chapter2_b316010d:

    # o "Tied the rope to what seemed solid."
    o "Tied la cuerda a lo que parecía sólido."

# game/Story02.rpy:882

translate spanish akt2chapter2_1f74e2bb:

    # o "Turns out it wasn’t. The anchor gave out, and now our way up is gone."
    o "Resulta que no lo fue. El ancla se dio, y ahora nuestro camino hacia arriba se ha ido."

# game/Story02.rpy:884

translate spanish akt2chapter2_3d7f3fe3:

    # h "Speaking of which..."
    h "Hablando de eso..."

# game/Story02.rpy:885

translate spanish akt2chapter2_1e475be0:

    # h "Mir, can’t you just do your {b}WHOOSH{/b} thing and teleport up to fix the rope?"
    h "Mir, no puedes hacer tu {b}OMSOSH{/b} ¿Algo y teletransporte para arreglar la cuerda?"

# game/Story02.rpy:887

translate spanish akt2chapter2_da3fdbf1_2:

    # Mi "..."
    Mi "..."

# game/Story02.rpy:888

translate spanish akt2chapter2_6d0e671b:

    # Mi "I can."
    Mi "Puedo."

# game/Story02.rpy:891

translate spanish akt2chapter2_be7238d0:

    # Mi "But that would be a waste of energy."
    Mi "Pero eso sería una pérdida de energía."

# game/Story02.rpy:892

translate spanish akt2chapter2_b74a9fb8:

    # Mi "Besides, we can’t go back the way we came."
    Mi "Además, no podemos volver a la forma en que vinimos."

# game/Story02.rpy:894

translate spanish akt2chapter2_9b54f3ba:

    # Mi "right?"
    Mi "¿Verdad?"

# game/Story02.rpy:895

translate spanish akt2chapter2_27bf9e5c:

    # o "Much as I hate to admit it — yeah. {w}Mutants cut off our path, ammo’s running low."
    o "Por mucho que odio admitirlo — sí. {w}Los mutantes cortan nuestro camino, la munición se está quedando baja."

# game/Story02.rpy:896

translate spanish akt2chapter2_9f073a66:

    # o "Going back would be suicide. {w}We work with what we have. {w}And right now, we don’t have much."
    o "Volver sería suicidio. {w}Trabajamos con lo que tenemos. {w}Y ahora mismo, no tenemos mucho."

# game/Story02.rpy:897

translate spanish akt2chapter2_f00d2496:

    # o "Maybe we can call for evac from HQ. {w}But we need comms for that. {w}Speaking of, how’s calibration coming along?"
    o "Tal vez podamos pedir evacuación al cuartel general. {w}Pero necesitamos comunicaciones para eso. {w}Hablando de eso, ¿cómo va la calibración?"

# game/Story02.rpy:900

translate spanish akt2chapter2_395d6d84:

    # g "We’re working on it. {w}But... something’s off."
    g "Estamos en ello. {w}Pero... algo no cuadra."

# game/Story02.rpy:901

translate spanish akt2chapter2_4c08e5e4:

    # o "What do you mean, {b}off?{/b}"
    o "¿Qué quieres decir? {b}¿Que no?{/b}"

# game/Story02.rpy:905

translate spanish akt2chapter2_fd0a9976:

    # g "Somehow, they bypassed the firewall."
    g "De alguna manera, pasaron el cortafuegos."

# game/Story02.rpy:906

translate spanish akt2chapter2_4120548d:

    # g "They hacked the antenna system, reconfigured it to jam communications."
    g "Han hackeado el sistema de antena, lo reconfiguraron para interponer comunicaciones."

# game/Story02.rpy:907

translate spanish akt2chapter2_1eec0199:

    # g "But how?... {w}That’s impossible to do from the outside."
    g "¿Pero cómo? {w}Eso es imposible de hacer desde fuera."

# game/Story02.rpy:909

translate spanish akt2chapter2_48a73938:

    # gg "Yeah? Cool. {w}Now explain it in normal words."
    gg "Genial. {w}Ahora explíquelo en palabras normales."

# game/Story02.rpy:912

translate spanish akt2chapter2_bac1e74a:

    # g "This place is directly linked to HQ servers. Their security is top-notch."
    g "Este lugar está directamente vinculado a los servidores HQ. Su seguridad es de primera categoría."

# game/Story02.rpy:913

translate spanish akt2chapter2_e4d079e1:

    # g "There’s no way to break in from the outside."
    g "No hay manera de entrar desde el exterior."

# game/Story02.rpy:914

translate spanish akt2chapter2_6086c3a0:

    # g "Whoever did this had to have direct access to both the main server and this antenna."
    g "Quien haya hecho esto tuvo que tener acceso directo al servidor principal y a esta antena."

# game/Story02.rpy:915

translate spanish akt2chapter2_185af940:

    # g "The antenna? {w}Maybe. That could’ve been easy."
    g "¿La antena? {w}Tal vez. Eso podría haber sido fácil."

# game/Story02.rpy:916

translate spanish akt2chapter2_83cd4ea1:

    # g "But the server? {w}That’s a whole other story."
    g "¿Pero el servidor? {w}Es una historia completamente diferente."

# game/Story02.rpy:917

translate spanish akt2chapter2_a3fd7d30:

    # gg "Still don’t get it."
    gg "Aún no lo entiendo."

# game/Story02.rpy:920

translate spanish akt2chapter2_07dc4efc:

    # g "Here’s the simple version…"
    g "Aquí está la versión simple..."

# game/Story02.rpy:923

translate spanish akt2chapter2_dcdf0813:

    # g "We’ve got a rat in HQ."
    g "Tenemos una rata en el cuartel general."

# game/Story02.rpy:929

translate spanish akt2chapter2_7bc11f35:

    # g "Commander, comms are up. {w}Jamming’s disabled. Should be working any minute now."
    g "Comandante, las comunicaciones están subidas. {w}Jamming está deshabilitado. Debe estar trabajando en cualquier momento."

# game/Story02.rpy:931

translate spanish akt2chapter2_d0e1e692:

    # o "Good. Erwin, Matt, try to contact HQ."
    o "Erwin, Matt, intenta contactar con el cuartel general."

# game/Story02.rpy:932

translate spanish akt2chapter2_d4ab24e5:

    # o "We need to warn them about what we found."
    o "Necesitamos advertirles de lo que encontramos."

# game/Story02.rpy:934

translate spanish akt2chapter2_8e210106:

    # o "Raylan, check out that crashed ship. {w}See if there’s a way around it."
    o "Raylan, mira ese barco estrellado. {w}Mira si hay una manera de hacerlo."

# game/Story02.rpy:935

translate spanish akt2chapter2_2690f2ef:

    # ggg "Yes, sir!"
    ggg "¡Sí, señor!"

# game/Story02.rpy:937

translate spanish akt2chapter2_02c0aac1:

    # Mi "So... {w}You just gonna stay silent, or are you finally gonna say something?"
    Mi "Así que... {w}¿Vas a callarte o vas a decir algo?"

# game/Story02.rpy:941

translate spanish akt2chapter2_f48ed049:

    # k "I see I’m not exactly your favorite person."
    k "Veo que no soy exactamente tu persona favorita."

# game/Story02.rpy:942

translate spanish akt2chapter2_a279063c:

    # k "Well, whatever."
    k "Bueno, lo que sea."

# game/Story02.rpy:944

translate spanish akt2chapter2_a3760149:

    # k "What do you wanna hear? {w}You guys seem to be doing just fine without me."
    k "¿Qué quieres oír? {w}Parece que están bien sin mí."

# game/Story02.rpy:945

translate spanish akt2chapter2_05bdd8f7:

    # k "Or maybe you just missed my voice?"
    k "¿O tal vez te perdiste mi voz?"

# game/Story02.rpy:947

translate spanish akt2chapter2_797835cb:

    # k "But since you’re so curious…"
    k "Pero ya que eres tan curioso..."

# game/Story02.rpy:948

translate spanish akt2chapter2_450c4ef1:

    # k "I found a couple of interesting things. {w}While you were busy chatting."
    k "Encontré un par de cosas interesantes. {w}Mientras estabas ocupada charlando."

# game/Story02.rpy:950

translate spanish akt2chapter2_cf6c7c55:

    # k "Here, take a look. {w}Might come in handy later."
    k "Mira. {w}Podría ser útil más tarde."

# game/Story02.rpy:955

translate spanish akt2chapter2_da3fdbf1_3:

    # Mi "..."
    Mi "..."

# game/Story02.rpy:956

translate spanish akt2chapter2_876f809a:

    # Mi "And what is it?"
    Mi "¿Y qué es?"

# game/Story02.rpy:959

translate spanish akt2chapter2_740daae7:

    # h "Looks like some kind of flash drive."
    h "Parece una especie de unidad flash."

# game/Story02.rpy:961

translate spanish akt2chapter2_6d39d489:

    # k "Well, thank you, Captain Obvious."
    k "Bueno, gracias, Capitán Obvio."

# game/Story02.rpy:962

translate spanish akt2chapter2_0b3e7ae1:

    # k "Wanna also tell me it contains data? {w}Or that you can plug it into a computer?"
    k "¿Quieres decirme que contiene datos? {w}¿O que puedes conectarlo a un ordenador?"

# game/Story02.rpy:964

translate spanish akt2chapter2_06d325ad:

    # h "You know… I have a {b}VERY{/b} strong urge to kick someone’s ass right now."
    h "Sabes... tengo un {b}Muy bien.{/b} fuerte impulso para patear el culo de alguien ahora mismo."

# game/Story02.rpy:965

translate spanish akt2chapter2_fcc07198:

    # h "And it’s only growing stronger by the second."
    h "Y solo se está fortaleciendo por segundo."

# game/Story02.rpy:967

translate spanish akt2chapter2_29097e0a:

    # Mi "I agree with you."
    Mi "Estoy de acuerdo contigo."

# game/Story02.rpy:968

translate spanish akt2chapter2_4e4f4808:

    # Mi "But sometimes, compromise is the better option."
    Mi "Pero a veces, el compromiso es la mejor opción."

# game/Story02.rpy:969

translate spanish akt2chapter2_e5939d88:

    # Mi "That’s what Lady taught me."
    Mi "Eso es lo que me enseñó Lady."

# game/Story02.rpy:971

translate spanish akt2chapter2_db8e3588:

    # h "Great. {w}But compromises go both ways, don’t they? {w}Or is that part conveniently ignored?"
    h "Genial. {w}Pero los compromisos van por ambos lados, ¿no? {w}¿O eso es convenientemente ignorado?"

# game/Story02.rpy:973

translate spanish akt2chapter2_da3fdbf1_4:

    # Mi "..."
    Mi "..."

# game/Story02.rpy:976

translate spanish akt2chapter2_563b3135:

    # Mi "We have an access key now. {w}All we need is someone who can decrypt it."
    Mi "Tenemos una llave de acceso ahora. {w}Todo lo que necesitamos es alguien que pueda descifrarlo."

# game/Story02.rpy:978

translate spanish akt2chapter2_73ed41a9:

    # h "Don’t we already have someone like that?"
    h "¿No tenemos ya a alguien así?"

# game/Story02.rpy:981

translate spanish akt2chapter2_475376a8:

    # g "Without the right equipment, I won’t be able to decrypt this thing. {w}It’s beyond my skill set."
    g "Sin el equipo adecuado, no podré descifrar esta cosa. {w}Está más allá de mi juego de habilidades."

# game/Story02.rpy:982

translate spanish akt2chapter2_0bd0dbfc:

    # mc "So, we just need to find a specialist… simple enough."
    mc "Así que, solo necesitamos encontrar un especialista... lo suficientemente simple."

# game/Story02.rpy:984

translate spanish akt2chapter2_cb88d4d6:

    # mc "By the way, something’s been bugging me. Why can’t I see any stars up there?"
    mc "Por cierto, algo me ha estado molestando. ¿Por qué no puedo ver ninguna estrella allí arriba?"

# game/Story02.rpy:985

translate spanish akt2chapter2_b1811c71:

    # mc "No stars, no clouds — nothing. Just pitch-black darkness. {w}And I don’t hear any fighting. Did things actually calm down?"
    mc "No estrellas, ni nubes, nada. {w}Y no escucho ninguna pelea. ¿Las cosas se calmaron?"

# game/Story02.rpy:987

translate spanish akt2chapter2_fbf73253:

    # o "You won’t see or hear anything… {w}Because we’re still underground."
    o "No verás ni oirás nada... {w}Porque seguimos bajo tierra."

# game/Story02.rpy:989

translate spanish akt2chapter2_474aaded:

    # mc "...No. That doesn’t make any sense. A place this big… underground? That’s insane."
    mc "...No. Eso no tiene sentido. ¿Un lugar tan grande... bajo tierra? Eso es una locura."

# game/Story02.rpy:990

translate spanish akt2chapter2_6a8004f4:

    # mc "And the city didn’t know about it? Bullshit. {w}Are we in some kind of sci-fi—"
    mc "¿Y la ciudad no sabía nada de eso? Mentira. {w}¿Estamos en algún tipo de ciencia ficción..."

# game/Story02.rpy:992

translate spanish akt2chapter2_2b35b6fe_1:

    # mc "..."
    mc "..."

# game/Story02.rpy:994

translate spanish akt2chapter2_5e6a46e4:

    # mc "Oh. Right."
    mc "Cierto."

# game/Story02.rpy:996

translate spanish akt2chapter2_830cd5cb:

    # o "To be fair, even I’d like to know how this place came to be."
    o "Para ser justo, incluso me gustaría saber cómo este lugar vino a ser."

# game/Story02.rpy:998

translate spanish akt2chapter2_1fe82b0b:

    # mc "So it’s not normal for you guys either?"
    mc "¿Así que tampoco es normal para ustedes?"

# game/Story02.rpy:1000

translate spanish akt2chapter2_25b9eb4a:

    # o "Even for me, someone who’s seen a lot in this world… {w}This place is a mystery."
    o "Incluso para mí, alguien que ha visto mucho en este mundo... {w}Este lugar es un misterio."

# game/Story02.rpy:1001

translate spanish akt2chapter2_a36f1d3c:

    # o "The history of this station is shrouded in secrecy."
    o "La historia de esta estación está envuelta en secreto."

# game/Story02.rpy:1002

translate spanish akt2chapter2_f9e36a04:

    # o "Officially, it’s supposed to provide power for an entire city. {w}But that’s just on paper."
    o "Oficialmente, se supone que debe proporcionar poder para toda una ciudad. {w}Pero eso es solo en papel."

# game/Story02.rpy:1003

translate spanish akt2chapter2_94b9d487:

    # o "In reality, as we can see, it’s been abandoned for a long time… {w}And the fact that information about it is so carefully hidden—"
    o "En realidad, como podemos ver, ha sido abandonado por mucho tiempo... {w}Y el hecho de que la información sobre ella es tan cuidadosamente ocultada..."

# game/Story02.rpy:1005

translate spanish akt2chapter2_8c7e32c2:

    # mc "Yeah, that sounds seriously messed up, if you ask me. {w}And if we’re underground, then what the hell is a crashed flying ship doing here?"
    mc "Sí, suena muy mal, si me lo preguntas. {w}Y si estamos bajo tierra, ¿qué demonios hace aquí un barco volador estrellado?"

# game/Story02.rpy:1006

translate spanish akt2chapter2_745a9db0:

    # mc "It couldn’t have just appeared out of nowhere…"
    mc "No podría haber aparecido de la nada..."

# game/Story02.rpy:1008

translate spanish akt2chapter2_6d908d48:

    # o "I wouldn’t be so quick to dismiss that possibility. It’s more likely than you think."
    o "No sería tan rápido desestimar esa posibilidad. Es más probable de lo que piensas."

# game/Story02.rpy:1010

translate spanish akt2chapter2_dc81f9ff:

    # mc "What? Alright... {w}I don’t even wanna start unpacking that. But back to my first question—"
    mc "¿Qué? {w}Ni siquiera quiero empezar a desempacar eso, pero de vuelta a mi primera pregunta..."

# game/Story02.rpy:1014

translate spanish akt2chapter2_eea9af21:

    # Fl "[mc]... Can you hear me?!"
    Fl "[mc]... ¿Me oyes?"

# game/Story02.rpy:1018

translate spanish akt2chapter2_76d8a61f:

    # mc "FLORA!"
    mc "¡Flairea!"

# game/Story02.rpy:1019

translate spanish akt2chapter2_805bd442:

    # mc "You have no idea how glad I am to hear your voice!"
    mc "¡No tienes idea de lo feliz que estoy para escuchar tu voz!"

# game/Story02.rpy:1021

translate spanish akt2chapter2_a63999e6:

    # o "Flora?! {w}Is she alright? {w}Ask her if she’s safe—"
    o "¡Flora! {w}¿Está bien? {w}Pregúntale si está a salvo..."

# game/Story02.rpy:1023

translate spanish akt2chapter2_a40a9705:

    # mc "Do you hear me? How are things up there? What’s going on on the surface?"
    mc "¿Me oyes? ¿Cómo están las cosas allá arriba? ¿Qué está pasando en la superficie?"

# game/Story02.rpy:1026

translate spanish akt2chapter2_3abc7eb2:

    # Fl "Shit’s going down!"
    Fl "¡La mierda está bajando!"

# game/Story02.rpy:1027

translate spanish akt2chapter2_5ba086a2:

    # Fl "Where the hell have you all been?! {w}I was starting to think you were dead… {w}Glad that’s not the case."
    Fl "¿Dónde diablos han estado?! {w}Empezaba a pensar que estabas muerto... {w}Me alegra que no sea el caso."

# game/Story02.rpy:1030

translate spanish akt2chapter2_548be5da:

    # mc "But what’s happening over there? {w}Are you guys losing ground?"
    mc "¿Pero qué está pasando ahí? {w}¿Están perdiendo terreno?"

# game/Story02.rpy:1033

translate spanish akt2chapter2_ceef073d:

    # Fl "LOSING GROUND?!"
    Fl "¿Perdiendo el sonido?"

# game/Story02.rpy:1034

translate spanish akt2chapter2_42517470:

    # Fl "WE’RE GETTING SLAUGHTERED!"
    Fl "¡Nos estamos volviendo locos!"

# game/Story02.rpy:1035

translate spanish akt2chapter2_d02390f5:

    # Fl "The first line of defense — GONE. {w}The Soulless are in the city."
    Fl "La primera línea de defensa ha caído. {w}Los Desalmados están en la ciudad."

# game/Story02.rpy:1038

translate spanish akt2chapter2_0ec0e7cc:

    # Fl "And now Astral Dominion just declared war on us. {w}We’re drowning in shit!"
    Fl "Y ahora Astral Dominion acaba de declararnos la guerra. {w}¡Nos ahogamos en la mierda!"

# game/Story02.rpy:1040

translate spanish akt2chapter2_05e9f2ce:

    # Fl "The plan was for the punitive force to arrive in time, but… {w}They got redirected to the front to hold back the enemy."
    Fl "El plan era que la fuerza punitiva llegara a tiempo, pero... {w}Se redireccionaron al frente para detener al enemigo."

# game/Story02.rpy:1043

translate spanish akt2chapter2_4c88c97b:

    # mc "What about reinforcements?"
    mc "¿Qué hay de refuerzos?"

# game/Story02.rpy:1046

translate spanish akt2chapter2_84990ffb:

    # Fl "REINFORCEMENTS?! {w}From who?! {w}No, there won’t be any. {w}But thanks for checking in—"
    Fl "¿ReINFORCEMENTOS? {w}¿De quién? {w}No, no habrá ninguno. {w}Pero gracias por comprobarlo..."

# game/Story02.rpy:1047

translate spanish akt2chapter2_c6a0dba3:

    # a "Flora, take control of the Titan, we need support on the north front!"
    a "Flora, toma el control del Titan, ¡necesitamos apoyo en el frente norte!"

# game/Story02.rpy:1048

translate spanish akt2chapter2_9eac2410:

    # Fl "Gimme a second! {w}I gotta go, I sent you all the details…"
    Fl "¡Dame un segundo! {w}Tengo que irme, te envié todos los detalles..."

# game/Story02.rpy:1049

translate spanish akt2chapter2_07c1026d:

    # Fl "Oh, and [mc]... {w}Please, hurry up…"
    Fl "Oh, y [mc]... {w}Por favor, date prisa..."

# game/Story02.rpy:1051

translate spanish akt2chapter2_2b35b6fe_2:

    # mc "..."
    mc "..."

# game/Story02.rpy:1053

translate spanish akt2chapter2_5280ca14:

    # o "So…"
    o "Así que..."

# game/Story02.rpy:1055

translate spanish akt2chapter2_89cb4fdb:

    # o "Are they safe? {w}Will reinforcements arrive? {w}What the hell is happening up there?"
    o "¿Están a salvo? {w}¿Llegarán refuerzos? {w}¿Qué demonios está pasando ahí arriba?"

# game/Story02.rpy:1057

translate spanish akt2chapter2_467a51b7:

    # mc "I don’t fully understand it either, but from what I just heard… nothing good."
    mc "Tampoco lo entiendo completamente, pero por lo que acabo de escuchar... nada bueno."

# game/Story02.rpy:1058

translate spanish akt2chapter2_c3755232:

    # mc "I think we’re truly stuck in a deadlock right now."
    mc "Creo que estamos realmente atrapados en un punto muerto ahora mismo."

# game/Story02.rpy:1061

translate spanish akt2chapter2_acc3ac13:

    # mc "And the fact that we’re trapped down here isn’t exactly giving me much hope."
    mc "Y el hecho de que estamos atrapados aquí no es exactamente darme mucha esperanza."

# game/Story02.rpy:1063

translate spanish akt2chapter2_3a9a4276:

    # k "Well, I do have one idea that might get us out of here."
    k "Bueno, tengo una idea que podría sacarnos de aquí."

# game/Story02.rpy:1065

translate spanish akt2chapter2_e527b7ad:

    # mc "And what exactly are you suggesting?"
    mc "¿Y qué sugieres exactamente?"

# game/Story02.rpy:1067

translate spanish akt2chapter2_267e7f70:

    # k "A rather insane idea…"
    k "Una idea bastante loca..."

# game/Story02.rpy:1076

translate spanish akt2chapter2_ffc8d2c6:

    # mc "Hey, don't tell me you're planning to cut through the rubble with your sword."
    mc "Oye, no me digas que vas a volar los escombros con una espada."

# game/Story02.rpy:1078

translate spanish akt2chapter2_c742d9c0:

    # Mi "That's pretty much the plan."
    Mi "Probablemente sea el caso."

# game/Story02.rpy:1080

translate spanish akt2chapter2_cfdc0390:

    # mc "Yeah... brute force over brains, huh?"
    mc "Sí... fuerza bruta sobre cerebros, ¿eh?"

# game/Story02.rpy:1082

translate spanish akt2chapter2_c2288e49:

    # k "Frozen in place?"
    k "¿Frozen en su lugar?"

# game/Story02.rpy:1083

translate spanish akt2chapter2_af69102e:

    # k "Or do you need a formal invitation?"
    k "¿O necesitas una invitación formal?"

# game/Story02.rpy:1103

translate spanish akt2chapter3_4b340443:

    # g "..."
    g "..."

# game/Story02.rpy:1104

translate spanish akt2chapter3_6b38a999:

    # gggg "Why are you just standing there like a statue? {w} See something? {w} If not, get moving already."
    gggg "¿Por qué estás ahí de pie como una estatua? {w} ¿Ves algo? {w} Si no, muévete ya."

# game/Story02.rpy:1106

translate spanish akt2chapter3_67633650:

    # g "Nah, not going in first."
    g "No, no va primero."

# game/Story02.rpy:1107

translate spanish akt2chapter3_588fd102:

    # g "It's dark, it's creepy... {w=0.5} And I got a wife waiting for me at home."
    g "Es oscuro y aterrador... {w=0.5}Y mi esposa está esperando en mi casa."

# game/Story02.rpy:1108

translate spanish akt2chapter3_43668391:

    # gggg "Yeah? Well, she ain't gonna see you at all if you just stand here forever."
    gggg "No te verá si sigues aquí."

# game/Story02.rpy:1110

translate spanish akt2chapter3_4b340443_1:

    # g "..."
    g "..."

# game/Story02.rpy:1121

translate spanish akt2chapter3_a5baa2b8:

    # gggg "The deeper we go, the more this place freaks me out..."
    gggg "Cuanto más profundo vayamos, más me asusta este lugar..."

# game/Story02.rpy:1122

translate spanish akt2chapter3_5c1d0965:

    # gggg "Who the hell thought it was a good idea to build an access tunnel to a power plant {b}THROUGH{/b} a goddamn metro?"
    gggg "¿Quién demonios pensó que era una buena idea construir un túnel de acceso a una planta de energía {b}THROUGH{/b} ¿Un maldito metro?"

# game/Story02.rpy:1125

translate spanish akt2chapter3_cc763df7:

    # gg "Well, I guess someone wanted to combine business with pleasure. A metro for people, a tunnel for rats."
    gg "Bueno, supongo que alguien quería combinar negocios con placer, un metro para la gente, un túnel para ratas."

# game/Story02.rpy:1127

translate spanish akt2chapter3_751663b5:

    # h "Eh, it's not THAT bad."
    h "No es tan malo."

# game/Story02.rpy:1128

translate spanish akt2chapter3_63dd86b0:

    # h "Yeah, it smells like... absolute shit, but compared to the last place..."
    h "Sí, huele a mierda absoluta, pero comparado con el último lugar..."

# game/Story02.rpy:1131

translate spanish akt2chapter3_6ba69572:

    # h "At least there's free drinks. {w=0.5} And, surprise, they're not even expired! {w=0.5} A goddamn miracle."
    h "Al menos hay bebidas gratis. {w=0.5}Y, sorprendentemente, ni siquiera están atrasados! {w=0.5}Es un milagro."

# game/Story02.rpy:1134

translate spanish akt2chapter3_36e7cb39:

    # Mi "Happy to be out of there?"
    Mi "¿Feliz de salir de ahí?"

# game/Story02.rpy:1136

translate spanish akt2chapter3_676b6a24:

    # h "Hell yeah. At least here, I don’t feel like something’s about to gut me any second."
    h "Al menos aquí, no siento que algo esté a punto de destriparme en cualquier momento."

# game/Story02.rpy:1138

translate spanish akt2chapter3_1cf4581e:

    # k "And that's exactly why it’s boring. {w=0.5} But maybe that suits you lot better..."
    k "Eso es lo que te aburriste aquí. {w=0.5}Pero quizá este es el lugar adecuado para ti..."

# game/Story02.rpy:1140

translate spanish akt2chapter3_b159537e:

    # h "Would you look at her... {w=0.5} Has anyone ever told you you're a complete masochist?"
    h "Mírala, ya sabes. {w=0.5}¿Alguien te ha dicho que eres un masoquista completo?"

# game/Story02.rpy:1141

translate spanish akt2chapter3_cb6187eb:

    # h "No? {w=0.5} Well, let me fix that oversight."
    h "¿No? {w=0.5} Bueno, déjame arreglar ese control."

# game/Story02.rpy:1143

translate spanish akt2chapter3_6cc8ea5a:

    # h "You're a goddamn masochist. {w=0.5} Through and through."
    h "Eres un masoquista completo. {w=0.5}Al hueso."

# game/Story02.rpy:1146

translate spanish akt2chapter3_1de47d7a:

    # h "Seriously, throwing yourself at enemies with no plan, relying on brute force alone?"
    h "En serio, arrojarse a enemigos sin plan, ¿contando con fuerza bruta sola?"

# game/Story02.rpy:1147

translate spanish akt2chapter3_8d3ad842:

    # h "Sweetheart, you're crazier than me."
    h "Cariño, eres más loco que yo."

# game/Story02.rpy:1149

translate spanish akt2chapter3_19f97f96:

    # mc "You used to have a different opinion."
    mc "Solías tener una opinión diferente."

# game/Story02.rpy:1150

translate spanish akt2chapter3_d8de2767:

    # mc "Changed priorities with age?"
    mc "¿Cambió las prioridades con la edad?"

# game/Story02.rpy:1152

translate spanish akt2chapter3_bf0935e3:

    # h "Oh, listen to you talk about priorities... Wasn't it you who said you were done with all this adventuring?"
    h "¿Quién habla de prioridades... no dijiste que has terminado con todas estas aventuras?"

# game/Story02.rpy:1153

translate spanish akt2chapter3_80a5595b:

    # h "So what the hell are we doing here?"
    h "¿Qué demonios estamos haciendo aquí?"

# game/Story02.rpy:1157

translate spanish akt2chapter3_41abe430:

    # mc "Olivia... please."
    mc "Olivia... por favor."

# game/Story02.rpy:1159

translate spanish akt2chapter3_6c1ce1e4:

    # h "Alright, alright..."
    h "Muy bien, muy bien..."

# game/Story02.rpy:1163

translate spanish akt2chapter3_9aaf8cdb:

    # mc "Don't start, you know damn well why we're here."
    mc "Sabes por qué estamos aquí."

# game/Story02.rpy:1165

translate spanish akt2chapter3_6b619a58:

    # h "Oh, I know. And I also know damn well why {b}I'm{/b} here."
    h "Lo sé, y también sé por qué. {b}I{/b} Aquí."

# game/Story02.rpy:1169

translate spanish akt2chapter3_2b35b6fe:

    # mc "..."
    mc "..."

# game/Story02.rpy:1173

translate spanish akt2chapter3_5bf6967b:

    # o "Sorry to interrupt your cute little argument, but we need to talk."
    o "Siento interrumpir tu pequeño argumento, pero tenemos que hablar."

# game/Story02.rpy:1174

translate spanish akt2chapter3_eaa8ee47:

    # mc "About what?"
    mc "¿Sobre qué?"

# game/Story02.rpy:1176

translate spanish akt2chapter3_abecf887:

    # o "You might not notice, but most of the squad could really use a break."
    o "No se nota, pero la mayoría de la brigada podría usar un descanso."

# game/Story02.rpy:1177

translate spanish akt2chapter3_1a103b51:

    # o "I get that we need to keep moving. {w=0.5} But not like this."
    o "Entiendo que tenemos que seguir moviéndonos. {w=0.5} Pero no así."

# game/Story02.rpy:1180

translate spanish akt2chapter3_462e76b7:

    # gg "Perfect match. If I were your wife, I’d have thrown myself at you in front of everyone already."
    gg "Un partido perfecto. Si yo fuera tu esposa, me habría tirado a ti delante de todos ya."

# game/Story02.rpy:1182

translate spanish akt2chapter3_fb9c6ca8:

    # g "Right? {w=0.5} Then take a photo of me as a keepsake — I’ll show it off later."
    g "¿Verdad? {w=0.5} Entonces toma una foto de mí como un recuerdo — lo mostraré más tarde."

# game/Story02.rpy:1184

translate spanish akt2chapter3_7329681e:

    # E "..."
    E "..."

# game/Story02.rpy:1185

translate spanish akt2chapter3_2040c8ba:

    # o "See? {w=0.5} That’s exactly what I’m talking about."
    o "¿Ves? {w=0.5} De eso es exactamente de lo que estoy hablando."

# game/Story02.rpy:1186

translate spanish akt2chapter3_02f370c5:

    # o "They’re exhausted. They need rest."
    o "Están exhaustos. Necesitan descanso."

# game/Story02.rpy:1188

translate spanish akt2chapter3_111cc452:

    # mc "What the hell are they even doing right now? Some kind of impression?"
    mc "¿Qué diablos están haciendo ahora?"

# game/Story02.rpy:1191

translate spanish akt2chapter3_a700d4a9:

    # o "To put it mildly, they’ve convinced themselves they’re the stars of some obscure squad."
    o "Para decirlo con lentitud, se han convencido de que son las estrellas de un equipo oscuro."

# game/Story02.rpy:1195

translate spanish akt2chapter3_4edc6c49:

    # o "And, well... {w=0.5} let's just say that belief got a little out of control."
    o "Y, bueno, {w=0.5}Digamos que la creencia se ha quedado fuera de control."

# game/Story02.rpy:1197

translate spanish akt2chapter3_20a3f04c:

    # o "It’s common for soldiers, really..."
    o "Es común para los soldados, en realidad..."

# game/Story02.rpy:1198

translate spanish akt2chapter3_65d2001c:

    # o "Implants drain energy. {w=0.5} If the body’s exhausted…"
    o "Las plantas desagüen energía. {w=0.5} Si el cuerpo está agotado..."

# game/Story02.rpy:1201

translate spanish akt2chapter3_0a10d60a:

    # mc "Wait... Aren’t implants supposed to boost endurance?"
    mc "Espera... ¿No se supone que los implantes aumenten la resistencia?"

# game/Story02.rpy:1202

translate spanish akt2chapter3_2a7cf722:

    # mc "I've been running on fumes for god knows how long, and I'm fine."
    mc "Estoy huyendo en mi último aliento por Dios sabe cuánto tiempo y estoy bien."

# game/Story02.rpy:1204

translate spanish akt2chapter3_8a41cfee:

    # o "You’re different. Your body adapted, your implants work in sync. {w=0.5} No rejection, no exhaustion."
    o "Tu cuerpo está adaptado, tus implantes funcionan en sincronización. {w=0.5} Sin rechazo, sin agotamiento."

# game/Story02.rpy:1214

translate spanish akt2chapter3_4eb9ea79:

    # a "Surface scum, DIE!"
    a "¡Escoria superficial, DIE!"

# game/Story02.rpy:1220

translate spanish akt2chapter3_9054e01a:

    # gggg "What the hell?! Who is this lunatic?!"
    gggg "¿Quién es este lunático?"

# game/Story02.rpy:1221

translate spanish akt2chapter3_baee8121:

    # gggg "I thought this place was abandoned..."
    gggg "Pensé que este lugar estaba abandonado..."

# game/Story02.rpy:1222

translate spanish akt2chapter3_b20fc9da:

    # g "You alright?"
    g "¿Estás bien?"

# game/Story02.rpy:1225

translate spanish akt2chapter3_2f451e6f:

    # gggg "Yeah, thanks for the assist. I could’ve handled it myself, but still."
    gggg "Sí, gracias por la ayuda. Podría haberlo manejado yo mismo, pero aún así."

# game/Story02.rpy:1228

translate spanish akt2chapter3_a1c7efe7:

    # g "Yeah, I saw you handling it. {w=0.5} Not too successfully."
    g "Sí, te vi manejarlo. {w=0.5} No demasiado exitosa."

# game/Story02.rpy:1229

translate spanish akt2chapter3_1cb3a967:

    # g "Looked more like you were about to get finished off."
    g "Parecía más como si estuvieras a punto de terminar."

# game/Story02.rpy:1230

translate spanish akt2chapter3_c42f074a:

    # gggg "He caught me off guard!"
    gggg "¡Me ha pillado de guardia!"

# game/Story02.rpy:1231

translate spanish akt2chapter3_3f5d55ec:

    # gggg "But I still had things under control!"
    gggg "¡Pero aún tenía cosas bajo control!"

# game/Story02.rpy:1234

translate spanish akt2chapter3_58fa7ec9:

    # gggg "What the hell is he even doing here? {w=0.5} I thought they left this area ages ago."
    gggg "¿Qué demonios hace aquí? {w=0.5} Pensé que habían dejado esta zona hace siglos."

# game/Story02.rpy:1235

translate spanish akt2chapter3_6b885708:

    # Mi "Not quite. {w=0.5} They just went underground."
    Mi "No del todo. {w=0.5} Acaban de pasar por debajo."

# game/Story02.rpy:1236

translate spanish akt2chapter3_23f1b7ed:

    # Mi "And this guy? Proof of that."
    Mi "Y este tipo, prueba de eso."

# game/Story02.rpy:1238

translate spanish akt2chapter3_b9811109:

    # mc "Great. {w} Now, can someone tell me who the hell we're dealing with? {w=0.8} And where this bastard crawled out from?"
    mc "Perfecto. {w}¿Alguien puede decirme con quién diablos estamos tratando? {w=0.8}¿De dónde vino ese bastardo?"

# game/Story02.rpy:1242

translate spanish akt2chapter3_0abef159:

    # Mi "Syndicate rats."
    Mi "Ratas sindicadas."

# game/Story02.rpy:1245

translate spanish akt2chapter3_099a62a7:

    # Mi "They used to roam the surface."
    Mi "Solían andar por la superficie."

# game/Story02.rpy:1246

translate spanish akt2chapter3_998d26ff:

    # Mi "But when the power struggle began, things changed."
    Mi "Pero cuando comenzó la lucha de poder, las cosas cambiaron."

# game/Story02.rpy:1249

translate spanish akt2chapter3_2008a26a:

    # h "Wait, hold on... So they went underground? I thought the Inquisition wiped them out..."
    h "Espera, espera... ¿Entonces se fueron bajo tierra?"

# game/Story02.rpy:1251

translate spanish akt2chapter3_dc301738:

    # k "I'm surprised. Not many left alive even know about those times."
    k "Me sorprende que algunas personas vivas conozcan los acontecimientos de ese tiempo."

# game/Story02.rpy:1253

translate spanish akt2chapter3_2187e051:

    # mc "Those times?"
    mc "¿Esos tiempos?"

# game/Story02.rpy:1254

translate spanish akt2chapter3_b5657eaf:

    # k "The time when we were finally allowed to unleash our full force... {w=0.5} in civilian areas."
    k "El momento en que finalmente nos permitieron desatar nuestra fuerza... {w=0.5} en zonas civiles."

# game/Story02.rpy:1255

translate spanish akt2chapter3_5c67b51c:

    # k "I have no right to question orders from above. {w=0.5} But back then…"
    k "No tengo derecho a cuestionar órdenes desde arriba. {w=0.5} Pero en ese entonces..."

# game/Story02.rpy:1257

translate spanish akt2chapter3_e9012ea9:

    # k "The living envied the dead."
    k "Los vivos envidiaban a los muertos."

# game/Story02.rpy:1258

translate spanish akt2chapter3_555f5ad9:

    # k "In just two days... {w=0.5} A massive city turned to scorched ash."
    k "En solo dos días... {w=0.5} Una ciudad masiva se volvió a la ceniza acorralada."

# game/Story02.rpy:1259

translate spanish akt2chapter3_6218b2bb:

    # k "Nothing remained."
    k "No quedó nada."

# game/Story02.rpy:1260

translate spanish akt2chapter3_55f8814a:

    # k "Women, elders, children... We wiped out everyone even remotely tied to the Syndicate."
    k "Mujeres, ancianos, niños... limpiamos a todos incluso atados remotamente al sindicato."

# game/Story02.rpy:1262

translate spanish akt2chapter3_0ca5b046:

    # k "Even by my standards, those were dark times. {w=0.5} And people rarely speak of them now..."
    k "Incluso por mis estándares, esos eran tiempos oscuros. {w=0.5} Y la gente rara vez habla de ellos ahora..."

# game/Story02.rpy:1263

translate spanish akt2chapter3_eb53e7f8:

    # Mi "More like, they’re {b}forbidden{/b} from speaking of them."
    Mi "Más bien, son {b}prohibido{/b} de hablar de ellos."

# game/Story02.rpy:1264

