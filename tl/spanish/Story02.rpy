# game/Story02.rpy:4197

translate spanish akt2chapter6_625ce7c7:

    # Mi "…Into a ring?"
    Mi "...en un anillo?"

# game/Story02.rpy:4198

translate spanish akt2chapter6_36b0a923:

    # Mi "How?"
    Mi "¿Cómo?"

# game/Story02.rpy:4200

translate spanish akt2chapter6_41da62cb_1:

    # Fl "..."
    Fl "..."

# game/Story02.rpy:4203

translate spanish akt2chapter6_df0546f9:

    # Fl "Lower city."
    Fl "Ciudad baja."

# game/Story02.rpy:4204

translate spanish akt2chapter6_d1660923:

    # Mi "…No."
    Mi "...no."

# game/Story02.rpy:4205

translate spanish akt2chapter6_34ece62e_1:

    # Fl "Yes."
    Fl "Sí."

# game/Story02.rpy:4207

translate spanish akt2chapter6_e4a79158:

    # Fl "We drive them in, seal the exits—"
    Fl "Los llevamos, sellamos las salidas..."

# game/Story02.rpy:4208

translate spanish akt2chapter6_75af7aec:

    # Mi "Flora… the people."
    Mi "Flora... la gente."

# game/Story02.rpy:4209

translate spanish akt2chapter6_63d5d5e9:

    # Fl "We evacuate them first."
    Fl "Los evacuamos primero."

# game/Story02.rpy:4211

translate spanish akt2chapter6_b5ea496d:

    # Mi "We don’t have enough time."
    Mi "No tenemos tiempo suficiente."

# game/Story02.rpy:4212

translate spanish akt2chapter6_d5e3ce82:

    # Fl "Then we start now."
    Fl "Entonces empezamos ahora."

# game/Story02.rpy:4213

translate spanish akt2chapter6_6dc548de:

    # Fl "That’s enough."
    Fl "Es suficiente."

# game/Story02.rpy:4217

translate spanish akt2chapter6_08438532:

    # Fl "Decide."
    Fl "Decidir."

# game/Story02.rpy:4221

translate spanish akt2chapter6_a6d38f41:

    # k "Girl… you’re insane."
    k "Chica... estás loca."

# game/Story02.rpy:4222

translate spanish akt2chapter6_2bad3711:

    # Fl "Good."
    Fl "Bien."

# game/Story02.rpy:4227

translate spanish akt2chapter6_09a52f5f:

    # Fl "Because a sane person wouldn’t even consider this."
    Fl "Porque una persona sana ni siquiera consideraría esto."

# game/Story02.rpy:4228

translate spanish akt2chapter6_52c7522d:

    # aS "And the weapons?"
    aS "¿Y las armas?"

# game/Story02.rpy:4230

translate spanish akt2chapter6_cec25ffc:

    # aS "Have you seen how many of them are out there?"
    aS "¿Has visto cuántos de ellos están ahí fuera?"

# game/Story02.rpy:4231

translate spanish akt2chapter6_c505c231:

    # em "I’m not turning my city into a slaughterhouse."
    em "No voy a convertir mi ciudad en un matadero."

# game/Story02.rpy:4233

translate spanish akt2chapter6_22e5f5b8:

    # em "If you’ve got something better, say it."
    em "Si tienes algo mejor, dilo."

# game/Story02.rpy:4234

translate spanish akt2chapter6_73019895:

    # Fl "Answer me this, Ember."
    Fl "Respóndeme esto, Ember."

# game/Story02.rpy:4235

translate spanish akt2chapter6_62866e51:

    # Fl "What do we breathe?"
    Fl "¿Qué respiramos?"

# game/Story02.rpy:4236

translate spanish akt2chapter6_af9e0a50_4:

    # em "..."
    em "..."

# game/Story02.rpy:4238

translate spanish akt2chapter6_c674bbf7:

    # em "Get to the point."
    em "Llega al punto."

# game/Story02.rpy:4239

translate spanish akt2chapter6_95e1efa7:

    # Fl "Ventilation shafts."
    Fl "Los ejes de ventilación."

# game/Story02.rpy:4241

translate spanish akt2chapter6_c04025e0:

    # Fl "That’s our entry point."
    Fl "Ese es nuestro punto de entrada."

# game/Story02.rpy:4243

translate spanish akt2chapter6_081c2044:

    # Mi "…Useless. They’ll still be able to brea—"
    Mi "...Inútil. Ellos todavía serán capaces de brea -"

# game/Story02.rpy:4245

translate spanish akt2chapter6_96806d05:

    # Fl "We don’t send air."
    Fl "No mandamos aire."

# game/Story02.rpy:4247

translate spanish akt2chapter6_a658eac4:

    # Fl "We send cryogen."
    Fl "Enviamos criogen."

# game/Story02.rpy:4249

translate spanish akt2chapter6_14b10460:

    # em "Do you understand what you’re suggesting?"
    em "¿Entiendes lo que sugieres?"

# game/Story02.rpy:4251

translate spanish akt2chapter6_34ece62e_2:

    # Fl "Yes."
    Fl "Sí."

# game/Story02.rpy:4255

translate spanish akt2chapter6_ab7e8f26:

    # em "I need to think."
    em "Necesito pensar."

# game/Story02.rpy:4258

translate spanish akt2chapter6_d8adc197:

    # em "You’ll have my answer later."
    em "Tendrás mi respuesta más tarde."

# game/Story02.rpy:4270

translate spanish akt2chapter6_c5a24c25:

    # aS "Bye-bye, pretty boy."
    aS "Adiós, chico bonito."

# game/Story02.rpy:4272

translate spanish akt2chapter6_41da62cb_2:

    # Fl "..."
    Fl "..."

# game/Story02.rpy:4273

translate spanish akt2chapter6_daa34919:

    # Fl "You."
    Fl "Tú."

# game/Story02.rpy:4275

translate spanish akt2chapter6_200de0ad:

    # Fl "We need to talk."
    Fl "Tenemos que hablar."

# game/Story02.rpy:4277

translate spanish akt2chapter6_e7829a51:

    # mc "Ease off. Start there."
    mc "Tranquilo, empieza ahí."

# game/Story02.rpy:4279

translate spanish akt2chapter6_e5a9700e:

    # Fl "We don’t have time for—"
    Fl "No tenemos tiempo para..."

# game/Story02.rpy:4280

translate spanish akt2chapter6_559c612d:

    # mc "You need help."
    mc "Necesitas ayuda."

# game/Story02.rpy:4282

translate spanish akt2chapter6_0db8da4e:

    # mc "Then ask for it properly."
    mc "Entonces pídelo correctamente."

# game/Story02.rpy:4284

translate spanish akt2chapter6_41da62cb_3:

    # Fl "..."
    Fl "..."

# game/Story02.rpy:4286

translate spanish akt2chapter6_06878236:

    # Fl "...So you’re in?"
    Fl "...¿Entonces estás dentro?"

# game/Story02.rpy:4288

translate spanish akt2chapter6_d5369a4b:

    # mc "I can walk."
    mc "Puedo caminar."

# game/Story02.rpy:4289

translate spanish akt2chapter6_baada9ed:

    # Fl "Miriel."
    Fl "Miriel."

# game/Story02.rpy:4290

translate spanish akt2chapter6_db380331:

    # Fl "Half the people here owe her."
    Fl "La mitad de la gente aquí le debe."

# game/Story02.rpy:4293

translate spanish akt2chapter6_ff792570:

    # Fl "And you two are…"
    Fl "Y ustedes dos son..."

# game/Story02.rpy:4294

translate spanish akt2chapter6_b758b9c7:

    # Fl "Let’s just say—"
    Fl "Digamos:"

# game/Story02.rpy:4298

translate spanish akt2chapter6_c1ba8902:

    # Fl "I need her."
    Fl "La necesito."

# game/Story02.rpy:4299

translate spanish akt2chapter6_bb4b0a90:

    # mc "What do I get?"
    mc "¿Qué tengo?"

# game/Story02.rpy:4300

translate spanish akt2chapter6_1d37d7a9:

    # Fl "A favor."
    Fl "Un favor."

# game/Story02.rpy:4305

translate spanish akt2chapter6_270439d7:

    # mc "I’ll think about it."
    mc "Lo pensaré."

# game/Story02.rpy:4306

translate spanish akt2chapter6_2bad3711_1:

    # Fl "Good."
    Fl "Bien."

# game/Story02.rpy:4308

translate spanish akt2chapter6_0cc7cbb2:

    # Fl "Glad you’re on board, mister."
    Fl "Me alegro de que esté a bordo, señor."

# game/Story02.rpy:4312

translate spanish akt2chapter6_b5c6af4a:

    # Fl "Go."
    Fl "Ve."

# game/Story02.rpy:4314

translate spanish akt2chapter6_f93b00e6:

    # Fl "...and—"
    Fl "...y..."

# game/Story02.rpy:4315

translate spanish akt2chapter6_db26fedd:

    # Fl "…thanks."
    Fl "...gracias."

# game/Story02.rpy:4331

translate spanish akt2chapter6_a77a65cd:

    # Fl "I mean it."
    Fl "Lo digo en serio."

# game/Story02.rpy:4332

translate spanish akt2chapter6_2c582d17:

    # h "Yeah, I don’t like this silence."
    h "Sí, no me gusta este silencio."

# game/Story02.rpy:4336

translate spanish akt2chapter6_6328359e:

    # h "No one’s gonna comment on what just happened?"
    h "¿Nadie va a comentar lo que acaba de pasar?"

# game/Story02.rpy:4337

translate spanish akt2chapter6_8f26d3d4:

    # k "The cat’s lost her mind."
    k "El gato ha perdido la cabeza."

# game/Story02.rpy:4338

translate spanish akt2chapter6_b06c840b:

    # k "That what you wanted to hear?"
    k "¿Eso es lo que querías oír?"

# game/Story02.rpy:4341

translate spanish akt2chapter6_79dd620e:

    # h "About the betrayal, not—"
    h "Sobre la traición, no..."

# game/Story02.rpy:4342

translate spanish akt2chapter6_7c993224:

    # k "We’re not discussing this."
    k "No estamos discutiendo esto."

# game/Story02.rpy:4343

translate spanish akt2chapter6_05a43b79:

    # h "Oh no, we are talking about it."
    h "Oh no, estamos hablando de eso."

# game/Story02.rpy:4344

translate spanish akt2chapter6_b04d1432:

    # h "Astoria’s a traitor now?"
    h "¿Astoria es un traidor ahora?"

# game/Story02.rpy:4347

translate spanish akt2chapter6_0162b5ed:

    # h "That’s kind of a big deal—"
    h "Eso es algo importante..."

# game/Story02.rpy:4348

translate spanish akt2chapter6_71ab8690:

    # k "And you believed that?"
    k "¿Y tú creíste eso?"

# game/Story02.rpy:4351

translate spanish akt2chapter6_29caa825:

    # k "End of discussion."
    k "Fin de la discusión."

# game/Story02.rpy:4352

translate spanish akt2chapter6_5877d47d:

    # mc "Doesn’t sit right with me either."
    mc "Tampoco se sienta bien conmigo."

# game/Story02.rpy:4353

translate spanish akt2chapter6_ca660762:

    # h "See?!"
    h "¿Ves?"

# game/Story02.rpy:4354

translate spanish akt2chapter6_2fb58163:

    # mc "She sees the future."
    mc "Ella ve el futuro."

# game/Story02.rpy:4356

translate spanish akt2chapter6_11543c8d:

    # mc "So how did this happen?"
    mc "¿Cómo sucedió esto?"

# game/Story02.rpy:4357

translate spanish akt2chapter6_82091822_4:

    # k "..."
    k "..."

# game/Story02.rpy:4358

translate spanish akt2chapter6_d728720b:

    # mc "You see it too."
    mc "Tú también lo ves."

# game/Story02.rpy:4361

translate spanish akt2chapter6_3631fc3e:

    # mc "You just don’t want to say it out loud."
    mc "No quieres decirlo en voz alta."

# game/Story02.rpy:4362

translate spanish akt2chapter6_cebf71ea:

    # k "That’s heresy."
    k "Eso es herejía."

# game/Story02.rpy:4363

translate spanish akt2chapter6_3d4537c0:

    # k "Astoria didn’t betray us. And she never would."
    k "Astoria no nos traicionó, y nunca lo haría."

# game/Story02.rpy:4366

translate spanish akt2chapter6_5909330a:

    # mc "Blind loyalty gets you nowhere."
    mc "La lealtad ciega no te lleva a ninguna parte."

# game/Story02.rpy:4367

translate spanish akt2chapter6_263b9c90:

    # k "She took in your wife. She saved your life."
    k "Ella se llevó a tu esposa, ella te salvó la vida."

# game/Story02.rpy:4370

translate spanish akt2chapter6_c79c7ccf:

    # k "And this is how you repay her?"
    k "¿Y así es como la pagas?"

# game/Story02.rpy:4371

translate spanish akt2chapter6_4d6a8acb:

    # h "Wait, no. You’ve got that wrong."
    h "Espera, no. Te equivocas."

# game/Story02.rpy:4375

translate spanish akt2chapter6_66331371:

    # h "She’s not the one who saved him."
    h "Ella no es la que lo salvó."

# game/Story02.rpy:4376

translate spanish akt2chapter6_c4509583:

    # k "Don’t delude yourselves."
    k "No os engañeis."

# game/Story02.rpy:4377

translate spanish akt2chapter6_c23d5698:

    # k "He wouldn’t lift a finger without the Lady’s order."
    k "No levantaría un dedo sin la orden de la Señora."

# game/Story02.rpy:4381

translate spanish akt2chapter6_aeefabe6:

    # h "That’s…"
    h "Eso es..."

# game/Story02.rpy:4383

translate spanish akt2chapter6_e400f831:

    # mc "Мириэль?"
    mc "¿Miriel?"

# game/Story02.rpy:4384

translate spanish akt2chapter6_da3fdbf1_4:

    # Mi "..."
    Mi "..."

# game/Story02.rpy:4388

translate spanish akt2chapter6_b37827eb:

    # mc "Look at me."
    mc "Mírame."

# game/Story02.rpy:4392

translate spanish akt2chapter6_64022ee8:

    # h "And where exactly do you think you’re going, sweetheart?"
    h "¿Y adónde crees que vas, cariño?"

# game/Story02.rpy:4397

translate spanish akt2chapter6_3ae551d2:

    # h "At least get dressed if you’re going after her."
    h "Al menos vístete si vas tras ella."

# game/Story02.rpy:4400

translate spanish akt2chapter6_0415e8f6:

    # mc "Liv, stay on comms."
    mc "Liv, quédate en coma."

# game/Story02.rpy:4404

translate spanish akt2chapter6_517a26dc:

    # k "Looks like we’ve been ditched again, shorty."
    k "Parece que nos han abandonado otra vez, corto."

# game/Story02.rpy:4405

translate spanish akt2chapter6_6d5bc58a:

    # h "Don’t change the subject."
    h "No cambies el tema."

# game/Story02.rpy:4407

translate spanish akt2chapter6_29fdd21b:

    # h "What do you mean the Lady saved him?"
    h "¿Qué quieres decir con que la Señora lo salvó?"

# game/Story02.rpy:4427

translate spanish akt2chapter6_93535690:

    # k "You’ll see soon enough. Move."
    k "Ya verás lo suficientemente pronto."

# game/Story02.rpy:4431

translate spanish akt2chapter7_31314ce4:

    # mc "You haven’t been yourself since that talk."
    mc "No has sido tú mismo desde esa charla."

# game/Story02.rpy:4433

translate spanish akt2chapter7_599fbc53:

    # mc "You didn’t tell me not to."
    mc "No me dijiste que no lo hiciera."

# game/Story02.rpy:4439

translate spanish akt2chapter7_9d189b99:

    # mc "...That line."
    mc "... Esa línea."

# game/Story02.rpy:4440

translate spanish akt2chapter7_3c83b55d:

    # mc "City of broken dreams."
    mc "Ciudad de sueños rotos."

# game/Story02.rpy:4441

translate spanish akt2chapter7_9ae1be38:

    # Mi "…Hm?"
    Mi "...¿Hm?"

# game/Story02.rpy:4442

translate spanish akt2chapter7_c8579042:

    # mc "Is that what this is about?"
    mc "¿De eso se trata?"

# game/Story02.rpy:4447

translate spanish akt2chapter7_96e45bc2:

    # Mi "…Home."
    Mi "...de casa."

# game/Story02.rpy:4448

translate spanish akt2chapter7_a29233f8:

    # Mi "…This place… it’s…"
    Mi "... Este lugar... es..."

# game/Story02.rpy:4450

translate spanish akt2chapter7_902e0bfd:

    # Mi "Special to me."
    Mi "Especial para mí."

# game/Story02.rpy:4452

translate spanish akt2chapter7_d3fb764d:

    # Mi "Here… I…"
    Mi "Aquí... yo..."

# game/Story02.rpy:4453

translate spanish akt2chapter7_582359ea:

    # mc "Hm?"
    mc "¿Hm?"

# game/Story02.rpy:4455

translate spanish akt2chapter7_31153e4a:

    # Mi "…Tell me… have you ever wished you wouldn’t wake up?"
    Mi "...Dime... ¿alguna vez has deseado que no te despertaras?"

# game/Story02.rpy:4457

translate spanish akt2chapter7_cf1adef2:

    # mc "Yeah."
    mc "Sí."

# game/Story02.rpy:4459

translate spanish akt2chapter7_740bb097:

    # Mi "Why?"
    Mi "¿Por qué?"

# game/Story02.rpy:4460

translate spanish akt2chapter7_60b57106:

    # mc "Stupidity… maybe."
    mc "Estúpido... tal vez."

# game/Story02.rpy:4464

translate spanish akt2chapter7_9d0a0734:

    # mc "Or feeling stuck."
    mc "O sentirse atascado."

# game/Story02.rpy:4465

translate spanish akt2chapter7_73bf868d:

    # mc "(…Broken dreams.)"
    mc "(...sueños rotos.)"

# game/Story02.rpy:4469

translate spanish akt2chapter7_21f80a99:

    # mc "You didn’t come here for a new life."
    mc "No viniste aquí para una nueva vida."

# game/Story02.rpy:4470

translate spanish akt2chapter7_3be11b7d:

    # Mi "I thought… I believed—"
    Mi "Pensé... creía..."

# game/Story02.rpy:4472

translate spanish akt2chapter7_5db9473a:

    # Mi "That I could find the strength…"
    Mi "Que yo pudiera encontrar la fuerza..."

# game/Story02.rpy:4475

translate spanish akt2chapter7_1e9e0d30:

    # Mi "To finish what I started."
    Mi "Para terminar lo que empecé."

# game/Story02.rpy:4476

translate spanish akt2chapter7_2ee6c1ba:

    # Mi "Just one step…"
    Mi "Solo un paso..."

# game/Story02.rpy:4479

translate spanish akt2chapter7_ec8b1974:

    # Mi "That’s all that stood between me and peace."
    Mi "Eso es todo lo que estaba entre mí y la paz."

# game/Story02.rpy:4482

translate spanish akt2chapter7_d231e988:

    # Mi "One step."
    Mi "Un paso."

# game/Story02.rpy:4484

translate spanish akt2chapter7_9c9b8577:

    # mc "But you stopped."
    mc "Pero te detuviste."

# game/Story02.rpy:4487

translate spanish akt2chapter7_e8919b36:

    # Mi "(whispering) …I was scared."
    Mi "Estaba asustado."

# game/Story02.rpy:4489

translate spanish akt2chapter7_c4cca458:

    # Mi "Another minute… and I would’ve done it, but…"
    Mi "Otro minuto... y lo habría hecho, pero..."

# game/Story02.rpy:4492

translate spanish akt2chapter7_edd9e9ec:

    # Mi "Someone stopped me."
    Mi "Alguien me detuvo."

# game/Story02.rpy:4496

translate spanish akt2chapter7_e0f04eb5:

    # mc "And now… you’re back there."
    mc "Y ahora... estás ahí atrás."

# game/Story02.rpy:4503

translate spanish akt2chapter7_f671b6ac:

    # mc "Only now you’ve got something to lose."
    mc "Solo ahora tienes algo que perder."

# game/Story02.rpy:4506

translate spanish akt2chapter7_2fcd0478:

    # mc "(…Maybe.)"
    mc "(...tal vez.)"

# game/Story02.rpy:4510

translate spanish akt2chapter7_c0a8921c:

    # mc "I almost lost it too."
    mc "Casi lo perdí."

# game/Story02.rpy:4516

translate spanish akt2chapter7_476ae4a1:

    # Mi "…Let’s go."
    Mi "...Vamos."

# game/Story02.rpy:4520

translate spanish akt2chapter7_99475aef:

    # Mi "I…"
    Mi "Yo..."

# game/Story02.rpy:4521

translate spanish akt2chapter7_a7677712:

    # Mi "I need someone with me."
    Mi "Necesito a alguien conmigo."

# game/Story02.rpy:4533

translate spanish akt2chapter7_df7ee913:

    # mc "Lead the way."
    mc "Dirigir el camino."

# game/Story02.rpy:4534

translate spanish akt2chapter7_82217262:

    # mc "(She picked up the pace.)"
    mc "(Ella tomó el ritmo.)"

# game/Story02.rpy:4538

translate spanish akt2chapter7_64c8929d:

    # mc "(Too fast.)"
    mc "(Demasiado rápido.)"

# game/Story02.rpy:4541

translate spanish akt2chapter7_c7e3f32b:

    # mc "(She’s not running.)"
    mc "(Ella no está corriendo.)"

# game/Story02.rpy:4546

translate spanish akt2chapter7_8ef64a65:

    # mc "(But she’s not waiting either.)"
    mc "(Pero ella tampoco está esperando)."

# game/Story02.rpy:4550

translate spanish akt2chapter7_9e78535a:

    # mc "(…Where’d she go?)"
    mc "(...¿Dónde se fue?)"

# game/Story02.rpy:4555

translate spanish akt2chapter7_40c3d6b9:

    # a "Looking for someone?"
    a "¿Buscas a alguien?"

# game/Story02.rpy:4557

translate spanish akt2chapter7_921805a7:

    # mc "You seen a short, tanned girl?"
    mc "¿Has visto a una chica corta y bronceada?"

# game/Story02.rpy:4566

translate spanish akt2chapter7_c61de1e8:

    # a "You’re lagging behind alread—"
    a "Estás rezagado detrás de la ley..."

# game/Story02.rpy:4570

translate spanish akt2chapter7_b6b4da37:

    # mc "(…What the hell was that?)"
    mc "(...¿Qué demonios fue eso?)"

# game/Story02.rpy:4571

translate spanish akt2chapter7_3afa4f18:

    # Mi "…A hologram."
    Mi "...un holograma."

# game/Story02.rpy:4573

translate spanish akt2chapter7_ff2b0516:

    # mc "And how long have you been standing there?"
    mc "¿Y cuánto tiempo llevas ahí parado?"

# game/Story02.rpy:4576

translate spanish akt2chapter7_0bfa5814:

    # Mi "…I never left."
    Mi "... nunca me fui."

# game/Story02.rpy:4577

translate spanish akt2chapter7_26b6d608:

    # mc "You disappeared."
    mc "Desapareciste."

# game/Story02.rpy:4581

translate spanish akt2chapter7_f32f8a2f:

    # mc "So… this is it?"
    mc "Entonces... ¿eso es todo?"

# game/Story02.rpy:4584

translate spanish akt2chapter7_fb12b2e7:

    # Mi "Yes..."
    Mi "Sí..."

# game/Story02.rpy:4588

translate spanish akt2chapter7_9755264c:

    # Mi "…I’m scared."
    Mi "...Estoy asustado."

# game/Story02.rpy:4590

translate spanish akt2chapter7_f9803e8f:

    # mc "I’m already here."
    mc "Ya estoy aquí."

# game/Story02.rpy:4608

translate spanish mirielhome_234dc169:

    # mc "(Air feels different here.)"
