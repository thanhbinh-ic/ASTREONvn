translate spanish akt2chapter7_8b6e09f1:

    # Mi "And just when you’ve started healing, {w=0.5}it throws another trial at you."
    Mi "Y justo cuando has empezado a curarte, {w=0.5}te lanza otro juicio."

# game/Story02.rpy:3987

