translate spanish akt2chapter4_e5e52d20:

    # g "Someone I know."
    g "Alguien que conozco."

# game/Story02.rpy:2653

translate spanish akt2chapter4_89ecc59b:

    # g "Or rather, what's left of him."
    g "O mejor dicho, lo que queda de él."

