    # Mi "Let’s not waste time."
    Mi "No perdamos el tiempo."

# game/Story02.rpy:2954

translate spanish akt2chapter5_479f6d74:

    # a "That’s her, isn’t it?"
    a "Es ella, ¿no?"

# game/Story02.rpy:2955

translate spanish akt2chapter5_93fa19e6:

    # a "The one who burned our homes… {w=0.5}Destroyed everything we loved…"
    a "El que quemó nuestras casas... {w=0.5}Destruyó todo lo que amamos..."

# game/Story02.rpy:2956

translate spanish akt2chapter5_784f4e8e:

    # aa "Yeah… {w=0.5}That’s her. One of the Nine. {w}She took my brothers from me…"
    aa "Sí... {w=0.5}Esa es ella. Una de las Nueve. {w}Ella me quitó a mis hermanos..."

# game/Story02.rpy:2958

translate spanish akt2chapter5_b04cfb53:

    # a "Why the hell did that monster come back? {w=0.5}Maybe it’s time we finally do what we couldn’t back then."
    a "¿Por qué demonios regresó ese monstruo? {w=0.5}Tal vez es hora de que finalmente hagamos lo que no pudimos entonces."

# game/Story02.rpy:2959

translate spanish akt2chapter5_01d92000:

    # a "There’s more of us now. {w=0.5}Or are you still afraid of her?"
    a "Ahora somos más. {w=0.5}¿O sigues teniendo miedo de ella?"

# game/Story02.rpy:2961

translate spanish akt2chapter5_72e4b840:

    # mc "They're talking about you, huh?"
    mc "Están hablando de ti, ¿no?"

# game/Story02.rpy:2963

translate spanish akt2chapter5_2c847714:

    # k "You ask like you don’t already know."
    k "Usted pregunta como si usted no lo sabe ya."

