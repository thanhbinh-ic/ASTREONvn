translate spanish akt2chapter5_15b7bb19:

    # k "Of course they are. {w=0.5}Who else would it be?"
    k "Por supuesto que lo son. {w=0.5}¿Quién más sería?"

# game/Story02.rpy:2965

translate spanish akt2chapter5_23a4fa2a:

    # k "What’s funny, though… {w=0.5}Not one of them has the guts to say it to my face."
    k "Lo que es gracioso, sin embargo... {w=0.5}Ninguno de ellos tiene las agallas para decirlo a mi cara."

# game/Story02.rpy:2967

translate spanish akt2chapter5_82091822:

    # k "..."
    k "..."

# game/Story02.rpy:2969

translate spanish akt2chapter5_27bf697b:

    # mc "Can’t blame them. {w=0.5}Risking your life isn’t exactly the best way to prove your bravery."
    mc "No puedo culparlos. {w=0.5}Arriesgar tu vida no es exactamente la mejor manera de demostrar tu valentía."

# game/Story02.rpy:2972

translate spanish akt2chapter5_3adc31ec:

    # w "What’s all the noise about?"
    w "¿Qué es todo el ruido?"

# game/Story02.rpy:2973

translate spanish akt2chapter5_10d53247:

    # w "I hear… {w=0.5}surface trash."
    w "Oigo... {w=0.5}basura de superficie."

# game/Story02.rpy:2976

translate spanish akt2chapter5_d1d0a1d1:

    # aS "Winter, I hope Flora already warned you. These people are our guests."
    aS "Invierno, espero que Flora ya te lo advierta."

# game/Story02.rpy:2978

translate spanish akt2chapter5_eaabbf54:

    # w "Oh, is that so…"
    w "Oh, es eso tan..."

# game/Story02.rpy:2979

translate spanish akt2chapter5_b8566e00:

    # w "Of course… {w=0.5}I was wondering why it suddenly got so quiet."
    w "Por supuesto... {w=0.5}Me preguntaba por qué de repente se puso tan callado."

# game/Story02.rpy:2981

translate spanish akt2chapter5_bab619cd:

    # w "The beast crawled back into our den. {w=0.5}And you expect me to just lower my weapon?"
    w "La bestia se arrastró de nuevo a nuestra cueva. {w=0.5}¿Y esperas que baje mi arma?"

# game/Story02.rpy:2983

translate spanish akt2chapter5_2bd8a14d:

    # aS "Make your own conclusions. {w=0.5}But don’t rush them."
    aS "Haz tus propias conclusiones. {w=0.5}Pero no los apresures."

# game/Story02.rpy:2985

translate spanish akt2chapter5_5d93cf68:

    # w "Do you even understand that her life is hanging by a thread here?"
    w "¿Entiendes que su vida está colgando de un hilo aquí?"

# game/Story02.rpy:2989

translate spanish akt2chapter5_cfe2dabc:

    # aS "If you were gonna kill her, you would've done it already."
    aS "Si la mataras, ya lo habrías hecho."

# game/Story02.rpy:2991

translate spanish akt2chapter5_d03815cf:

    # w "If I turn a blind eye to her crimes… {w=0.5}How the hell do I look my people in the eye after that?"
    w "Si me pongo ciego a sus crímenes... {w=0.5}¿Cómo diablos miro a mi gente a los ojos después de eso?"

# game/Story02.rpy:2993

translate spanish akt2chapter5_44bf420c:

    # aS "Mhm… {w=0.5}If there are even any left to look at you."
    aS "Mhm... {w=0.5}Si hay algo que te mire."

# game/Story02.rpy:2996

translate spanish akt2chapter5_4630b682:

    # Mi "We’re not here to argue about the past. {w=0.5}We have bigger threats now."
    Mi "No estamos aquí para discutir sobre el pasado. {w=0.5}Tenemos amenazas más grandes ahora."

# game/Story02.rpy:2998

translate spanish akt2chapter5_4ac86fb4:

    # w "Haven't seen you around in a while… {w=0.5}How’s your teacher?"
    w "Hace mucho que no te veo aquí. {w=0.5}¿Cómo está tu profesor?"

# game/Story02.rpy:3000

translate spanish akt2chapter5_74f65b31:

    # Mi "No news from him."
    Mi "No hay noticias de él."

# game/Story02.rpy:3002

translate spanish akt2chapter5_be587318:

    # w "Ha… {w=0.5}Same old, then."
    w "Ha... {w=0.5}Lo mismo de siempre."

# game/Story02.rpy:3003

translate spanish akt2chapter5_08145bdc:

    # w "So tell me, Ellie… what brings you here?"
    w "Dime, Ellie... ¿qué te trae aquí?"

# game/Story02.rpy:3009

translate spanish akt2chapter5_ae57ce26:

    # Mi "We came… to ask for help."
    Mi "Vinimos... a pedir ayuda."

# game/Story02.rpy:3011

translate spanish akt2chapter5_0a862bf1:

    # Mi "I’m sure you’ve heard what’s happening on the surface. Without you, we won’t stand a chance."
    Mi "Estoy seguro de que has oído lo que está sucediendo en la superficie. Sin ti, no tendremos ninguna oportunidad."

# game/Story02.rpy:3014

translate spanish akt2chapter5_f53c306a:

    # w "Yeah… {w=0.5}Word reached me."
    w "Sí... {w=0.5}Me llegó la palabra."

# game/Story02.rpy:3015

translate spanish akt2chapter5_817a3b4a:

    # w "Didn’t like what I heard."
    w "No me gustó lo que escuché."

# game/Story02.rpy:3016

