translate spanish akt2chapter4_084afcd0:

    # h "(whispering) please..."
    h "Por favor..."

# game/Story02.rpy:2623

translate spanish akt2chapter4_7f2db866:

    # mc "I can’t."
    mc "No puedo."

# game/Story02.rpy:2631

translate spanish akt2chapter4_4d915e18:

    # h "You’re not even trying!"
    h "¡Ni siquiera lo intentas!"

# game/Story02.rpy:2633

translate spanish akt2chapter4_140a81a2:

    # h "Back then, now… nothing’s changed!"
    h "En ese entonces, ahora... ¡nada ha cambiado!"

