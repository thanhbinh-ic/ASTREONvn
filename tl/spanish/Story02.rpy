    # Mi "…He headed east."
    Mi "...Se dirigió al este."

# game/Story02.rpy:2802

translate spanish akt2chapter4_b0517e6f:

    # Mi "Said something came up."
    Mi "Dijo que algo surgió."

# game/Story02.rpy:2804

translate spanish akt2chapter4_100a2bcd:

