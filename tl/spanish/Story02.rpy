# game/Story02.rpy:3958
translate spanish akt2chapter5_5_90efd84a:

    # mc "(She's clumsy... but that tongue of hers wraps around me like she's trying to drain every last drop.)"
    mc "(Es torpe... pero esa lengua suya me rodea como si intentara arrancarme hasta la última gota.)"

# game/Story02.rpy:3959
translate spanish akt2chapter5_5_93deaf69:

    # mc "Ah..."
    mc "Ah..."

# game/Story02.rpy:3960
translate spanish akt2chapter5_5_319ba28e:

    # "At the sound, Flora's eyes light up with sudden excitement."
    "Al oírlo, los ojos de Flora se iluminan con una emoción repentina."

# game/Story02.rpy:3961
translate spanish akt2chapter5_5_c1a092d7:

