    mc "(Se está poniendo más intensa... ¿Toqué un nervio?)"

# game/Story02.rpy:3947
translate spanish akt2chapter5_5_8fdc697c:

    # mc "Easy watch the teeth, Flora."
    mc "Con cuidado. Ojo con los dientes, Flora."

# game/Story02.rpy:3948
translate spanish akt2chapter5_5_34596f4b:

    # Fl "(R-right...)"
    Fl "(C-claro...)"

# game/Story02.rpy:3949
translate spanish akt2chapter5_5_9ea08bca:

    # Fl "(That'll teach you to keep your head in the clouds.)"
    Fl "(Eso te enseñará a tener la cabeza en las nubes.)"

# game/Story02.rpy:3950
translate spanish akt2chapter5_5_612d47a4:

    # mc "You know... you're a beautiful woman, Flora."
    mc "Sabes... eres una mujer hermosa, Flora."

# game/Story02.rpy:3951
translate spanish akt2chapter5_5_10814333:

    # "For a brief moment, Flora seems to freeze, then she resumes with even greater intensity."
