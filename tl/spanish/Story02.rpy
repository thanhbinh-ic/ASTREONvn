    k "Tiene la costumbre de dejar a la gente atrás."

# game/Story02.rpy:2805

translate spanish akt2chapter4_b6870fce:

    # k "…Then again."
    k "...entonces otra vez."

# game/Story02.rpy:2806

translate spanish akt2chapter4_4b3309e4:

    # k "So do most of you."
    k "Así que la mayoría de ustedes."

# game/Story02.rpy:2809

translate spanish akt2chapter4_a68398b6:

    # h "Got a problem?"
    h "¿Tienes algún problema?"

# game/Story02.rpy:2810

translate spanish akt2chapter4_b678cff4:

    # k "Hm."
    k "Hm."

# game/Story02.rpy:2811

translate spanish akt2chapter4_c3b40072:

    # k "Yeah."
    k "Sí."

# game/Story02.rpy:2812

translate spanish akt2chapter4_0fa5903a:

    # k "And what are you going to do about it?"
    k "¿Y qué vas a hacer al respecto?"

# game/Story02.rpy:2813

translate spanish akt2chapter4_b7b21034:

    # h "...Nothing."
    h "Nada."

# game/Story02.rpy:2817

translate spanish akt2chapter4_ba201647:

    # k "Funny. {w=0.5}Your face says otherwise."
    k "Qué gracioso. {w=0.5}Tu cara dice lo contrario."

# game/Story02.rpy:2819

translate spanish akt2chapter4_b9c47a64:

    # h "I don’t like you."
    h "No me gustas."

# game/Story02.rpy:2820

translate spanish akt2chapter4_65696d9d:

    # h "But for his sake… I’ll tolerate you."
    h "Pero por su bien... te toleraré."

# game/Story02.rpy:2822

translate spanish akt2chapter4_dcd86e92:

    # k "Oh?"
    k "¿Oh?"

# game/Story02.rpy:2823

translate spanish akt2chapter4_8782f7f3:

    # k "I’m honored."
    k "Soy honrado."

# game/Story02.rpy:2829

translate spanish akt2chapter4_6917a82e:

    # k "Alright."
    k "Muy bien."

# game/Story02.rpy:2832

translate spanish akt2chapter4_9e2d3eb5:

    # k "What’s the plan?"
    k "¿Cuál es el plan?"

# game/Story02.rpy:2834

translate spanish akt2chapter4_75817c20:

    # Mi "…[mc]?"
    Mi "…[mc]?"

# game/Story02.rpy:2837

translate spanish akt2chapter4_1d6ce146:

    # mc "Blue Moon. Sector 6."
    mc "Blue Moon. Sector 6."

# game/Story02.rpy:2838

translate spanish akt2chapter4_60e321f8:

    # mc "Meet Flora. Get her on our side. Figure out what the hell’s going on."
    mc "Conoce a Flora. Ponla de nuestro lado. Averigua qué demonios está pasando."

# game/Story02.rpy:2840

translate spanish akt2chapter4_684b7af6:

    # k "You’ve got guts, old man."
    k "Tienes agallas, viejo."

# game/Story02.rpy:2843

translate spanish akt2chapter4_f5c5fae1:

    # k "(You’ll see.)"
    k "(Lo verás.)"

# game/Story02.rpy:2845

translate spanish akt2chapter4_739af0c1:

    # k "(Call it a surprise.)"
    k "(Llámalo una sorpresa.)"

# game/Story02.rpy:2848

translate spanish akt2chapter4_0de1b446:

    # k "Hey, shorty."
    k "Oye, cariño."

# game/Story02.rpy:2849

translate spanish akt2chapter4_7495f152:

    # k "Temporary truce?"
    k "¿Tregua temporal?"

# game/Story02.rpy:2851

translate spanish akt2chapter4_ebac5e46:

    # k "At least until this mess settles."
    k "Al menos hasta que este desastre se calme."

# game/Story02.rpy:2852

translate spanish akt2chapter4_843215c2:

    # k "What do you say?"
    k "¿Qué dices?"

# game/Story02.rpy:2853

translate spanish akt2chapter4_91766d23:

    # h "Doesn’t mean I trust you."
    h "No significa que confíe en ti."

# game/Story02.rpy:2858

translate spanish akt2chapter4_9d5a6ddf:

    # k "Whatever you say, shorty."
    k "Lo que digas, cariño."

# game/Story02.rpy:2861

translate spanish akt2chapter4_ac579582:

    # k "I’ll leave you two alone."
    k "Los dejaré solos."

# game/Story02.rpy:2862

translate spanish akt2chapter4_8c9bec23:

    # k "Try not to die."
    k "Intenta no morir."

# game/Story02.rpy:2864

translate spanish akt2chapter4_3eb6c693:

    # h "Finally… some space."
    h "Finalmente... algo de espacio."

# game/Story02.rpy:2867

translate spanish akt2chapter4_1314bfa4:

    # h "Hey… mind if I just…"
    h "Oye... ¿te importa si solo..."

# game/Story02.rpy:2873

translate spanish akt2chapter4_1b031bf6:

    # mc "Yeah. It’s cold, but it’s fine."
    mc "Sí. Hace frío, pero está bien."

# game/Story02.rpy:2876

translate spanish akt2chapter4_ef4c6b39:

    # h "Eh, not a big deal."
    h "No es gran cosa."

# game/Story02.rpy:2878

translate spanish akt2chapter4_73d05893:

    # mc "...You okay?"
    mc "¿Estás bien?"

# game/Story02.rpy:2882

translate spanish akt2chapter4_546bb74f:

    # h "…Not really."
    h "No realmente."

# game/Story02.rpy:2883

translate spanish akt2chapter4_8fc2b132:

    # h "We’re about to see Lora and…"
    h "Estamos a punto de ver a Lora y..."

# game/Story02.rpy:2885

translate spanish akt2chapter4_0af34ecd:

    # mc "You’re nervous."
    mc "Estás nervioso."

# game/Story02.rpy:2887

translate spanish akt2chapter4_149a9d97:

    # h "You’re not?"
    h "¿No lo estás?"

# game/Story02.rpy:2889

translate spanish akt2chapter4_d6baff5f:

    # mc "Remember?"
    mc "¿Recuerdas?"

# game/Story02.rpy:2893

translate spanish akt2chapter4_8aab296b:

    # mc "When we handed you the warehouse."
    mc "Cuando te entregamos el almacén."

# game/Story02.rpy:2894

translate spanish akt2chapter4_f0f50e58:

    # mc "What were you feeling?"
    mc "¿Qué estabas sintiendo?"

# game/Story02.rpy:2896

translate spanish akt2chapter4_fe9c2d4a:

    # h "I was a mess, to put it lightly."
    h "Era un desastre, para decirlo con ligereza."

# game/Story02.rpy:2898

translate spanish akt2chapter4_87599aed:

    # mc "And what did Lora say back then?"
    mc "¿Y qué dijo Lora entonces?"

# game/Story02.rpy:2900

translate spanish akt2chapter4_798e7765:

    # h "If I start worrying… I…"
    h "Si empiezo a preocuparme..."

# game/Story02.rpy:2904

translate spanish akt2chapter4_85c182d8:

    # mc "Doesn’t change the outcome."
    mc "No cambia el resultado."

# game/Story02.rpy:2906

translate spanish akt2chapter4_a3543490:

    # h "That’s… not exactly comforting."
    h "Eso no es exactamente reconfortante."

# game/Story02.rpy:2908

translate spanish akt2chapter4_ec243024:

    # mc "It’s not supposed to."
    mc "No se supone que lo haga."

# game/Story02.rpy:2910

translate spanish akt2chapter4_869a52e4:

    # h "…And your point is?"
    h "¿Y tu punto es?"

# game/Story02.rpy:2912

translate spanish akt2chapter4_88f16ec9:

    # mc "...So don’t let it control you."
    mc "... Así que no dejes que te controle."

# game/Story02.rpy:2914

translate spanish akt2chapter4_cf9c9f72:

    # h "That’s not the same. Not even close."
    h "Eso no es lo mismo. Ni siquiera cerca."

# game/Story02.rpy:2917

translate spanish akt2chapter4_a3669ba7:

    # Mi "…You done resting?"
    Mi "¿Has descansado?"

# game/Story02.rpy:2922

translate spanish akt2chapter4_87f4dbdd:

    # k "Your uniform, old man."
    k "Tu uniforme, viejo."

# game/Story02.rpy:2924

translate spanish akt2chapter4_e4c0c4b1:

    # Mi "They… don’t take kindly to it."
    Mi "Ellos... no se lo toman amablemente."

# game/Story02.rpy:2926

translate spanish akt2chapter4_6ec9790d:

    # k "Kindly?"
    k "¿Qué?"

# game/Story02.rpy:2927

translate spanish akt2chapter4_cb8f73a3:

    # k "…Please."
    k "...por favor."

# game/Story02.rpy:2928

translate spanish akt2chapter4_7b946266:

    # k "They’ll tear you apart the moment they get the chance."
    k "Te destrozarán en el momento en que tengan la oportunidad."

# game/Story02.rpy:2930

translate spanish akt2chapter4_ef2f0419:

    # k "To them… we’re worse than monsters."
    k "Para ellos... somos peores que los monstruos."

# game/Story02.rpy:2935

translate spanish akt2chapter4_f2b660ec:

    # h "Well… that’s reassuring."
    h "Bueno... eso es tranquilizador."

# game/Story02.rpy:2939

translate spanish akt2chapter4_78bc329f:

    # Mi "So we should…"
    Mi "Así que deberíamos..."

# game/Story02.rpy:2942

translate spanish akt2chapter4_3f2dd5ed:

    # h "Then we stay."
    h "Entonces nos quedamos."

# game/Story02.rpy:2946

translate spanish akt2chapter4_cf1adef2:

    # mc "Yeah."
    mc "Sí."

# game/Story02.rpy:2948

translate spanish akt2chapter4_c30a2c76:

    # k "Can’t wait to hear the story?"
    k "¿No puedes esperar a escuchar la historia?"

# game/Story02.rpy:2949

translate spanish akt2chapter4_5ac323e4:

    # k "About how we butchered half a city?"
    k "¿Sobre cómo hemos carnicero a media ciudad?"

# game/Story02.rpy:2952

translate spanish akt2chapter4_fb43015c:

    # mc "Then say it."
    mc "Entonces dilo."

# game/Story02.rpy:2953

translate spanish akt2chapter4_7c5bca36:

    # mc "You’re not walking away from this without an answer."
    mc "No te vas a alejar de esto sin respuesta."

# game/Story02.rpy:2956

translate spanish akt2chapter4_dbd62e0f:

    # k "And you ran-"
    k "Y corriste..."

# game/Story02.rpy:2957

translate spanish akt2chapter4_675dfef5:

    # mc "Back then, yeah."
    mc "En ese entonces, sí."

# game/Story02.rpy:2958

translate spanish akt2chapter4_d14b1cea:

    # mc "Now you talk."
    mc "Ahora hablas."

# game/Story02.rpy:2961

translate spanish akt2chapter4_6926df41:

    # k "Watch your to-"
    k "Cuidado con..."

# game/Story02.rpy:2963

translate spanish akt2chapter4_6b2eda57:

    # mc "Why don’t you want to go back there?"
    mc "¿Por qué no quieres volver allí?"

# game/Story02.rpy:2964

translate spanish akt2chapter4_faa1ac42:

    # mc "Every time it comes up, you shut down."
    mc "Cada vez que sale, te callas."

# game/Story02.rpy:2968

translate spanish akt2chapter4_327ee225:

    # k "Oh, look who-"
    k "Mira quién..."

# game/Story02.rpy:2970

translate spanish akt2chapter4_71a06277:

    # mc "Mir. Say it."
    mc "Señor, dígalo."

# game/Story02.rpy:2972

translate spanish akt2chapter4_0700c98a:

    # Mi "She…"
    Mi "Ella..."

# game/Story02.rpy:2975

translate spanish akt2chapter4_6bde73a1:

    # h "Knowing them—"
    h "Conociendolos..."

# game/Story02.rpy:2977

translate spanish akt2chapter4_331809ce_1:

    # mc "Liv."
    mc "Liv."

# game/Story02.rpy:2978

translate spanish akt2chapter4_485237e2:

    # h "Do you even hear yourself right now?"
    h "¿Te has oído ahora mismo?"

# game/Story02.rpy:2980

translate spanish akt2chapter4_70ce71e1:

    # mc "Not now."
    mc "Ahora no."

# game/Story02.rpy:2982

translate spanish akt2chapter4_fdf4cc37:

    # mc "Talk."
    mc "Habla."

# game/Story02.rpy:2984

translate spanish akt2chapter4_991f0524:

    # k "You want a story?"
    k "¿Quieres una historia?"

# game/Story02.rpy:2987

translate spanish akt2chapter4_2a5dc2bb:

    # k "Fine."
    k "Bien."

# game/Story02.rpy:3006

translate spanish akt2chapter4_0eefda61:

    # k "(We had one order.)"
    k "(Teníamos una orden.)"

# game/Story02.rpy:3007

translate spanish akt2chapter4_cf15f649:

    # k "(Clear Sectors Seven and Six.)"
    k "(Los Sectores del Nivel Siete y Seis)"

# game/Story02.rpy:3010

translate spanish akt2chapter4_c52c3b4e:

    # k "(Everything alive.)"
    k "(Todo vivo.)"

# game/Story02.rpy:3011

translate spanish akt2chapter4_77951032:

    # k "(No exceptions.)"
    k "(No hay excepciones.)"

# game/Story02.rpy:3013

translate spanish akt2chapter4_814350fd:

    # a "Please… have mercy…"
    a "Por favor... ten piedad..."

# game/Story02.rpy:3014

translate spanish akt2chapter4_49a9cace:

    # k "(...)"
    k "(...)"

# game/Story02.rpy:3025

translate spanish akt2chapter4_05f46703:

    # k "…They remember."
    k "...se acuerdan."

# game/Story02.rpy:3031

translate spanish akt2chapter4_48c351d9:

    # k "…They won’t forget."
    k "...No olvidarán."

# game/Story02.rpy:3033

translate spanish akt2chapter4_75f652cc:

    # mc "So be it."
    mc "Así que sea."

# game/Story02.rpy:3039

translate spanish akt2chapter4_7622ba8a:

    # k "We’re not going there."
    k "No vamos a ir allí."

# game/Story02.rpy:3041

translate spanish akt2chapter4_52271bca:

    # mc "...We are."
    mc "... lo somos."

# game/Story02.rpy:3045

translate spanish akt2chapter4_471848f1:

    # k "…You’re an idiot."
    k "...Eres un idiota."

# game/Story02.rpy:3054

translate spanish akt2chapter4_426b45dd:

    # Mi "(whisper) ...there."
    Mi "Ahí."

# game/Story02.rpy:3055

translate spanish akt2chapter4_ef74e6fe:

    # Mi "[mc]… we’re ready to move."
    Mi "[mc]... estamos listos para moverse."

# game/Story02.rpy:3058

translate spanish akt2chapter4_2562ad6f_1:

    # mc "Move."
    mc "Muévete."

# game/Story02.rpy:3064

translate spanish akt2chapter4_fff3dd31:

    # h "Wait, what is this 'Lower Town' exactly?"
    h "Espera, ¿qué es esta \"ciudad más baja\"?"

# game/Story02.rpy:3067

translate spanish akt2chapter4_90616a30:

    # h "I thought that was just a figure of speech..."
    h "Pensé que era solo una figura de discurso..."

# game/Story02.rpy:3070

translate spanish akt2chapter4_a900515a:

    # k "Up here, you’ve got the poor."
    k "Aquí arriba, tienes a los pobres."

# game/Story02.rpy:3071

translate spanish akt2chapter4_b303fc9c:

    # k "Down there?"
    k "¿Abajo?"

# game/Story02.rpy:3072

translate spanish akt2chapter4_6ccd3e1c:

    # k "The ones who never even had a chance."
    k "Los que nunca tuvieron oportunidad."

# game/Story02.rpy:3074

translate spanish akt2chapter4_31e333ee:

    # k "If you were born in Lower Town, you die in Lower Town."
    k "Si naciste en el Pueblo Inferior, mueres en el Pueblo Inferior."

# game/Story02.rpy:3076

translate spanish akt2chapter4_97808530:

    # h "And you want us to go down there?"
    h "¿Y quieres que vayamos allí?"

# game/Story02.rpy:3078

translate spanish akt2chapter4_9a9a1016:

    # k "Me? No. The old man? Yeah."
    k "¿Yo?"

# game/Story02.rpy:3079

translate spanish akt2chapter4_4d535be0:

    # mc "We’re not here sightseeing."
    mc "No estamos aquí viendo el paisaje."

# game/Story02.rpy:3081

translate spanish akt2chapter4_f9149dc9:

    # h "You know what..."
    h "Sabes qué..."

# game/Story02.rpy:3082

translate spanish akt2chapter4_9955e79a:

    # h "If it’s really that bad, maybe we just don’t go."
    h "Si es realmente tan malo, tal vez no vayamos."

# game/Story02.rpy:3085

translate spanish akt2chapter4_d0c168de:

    # mc "You both, enough."
    mc "Ustedes dos, suficiente."

# game/Story02.rpy:3087

translate spanish akt2chapter4_ac88ce93:

    # mc "We’re going down."
    mc "Vamos a bajar."

# game/Story02.rpy:3088

translate spanish akt2chapter4_768a5031:

    # mc "Or did you forget why we’re here?"
    mc "¿O olvidaste por qué estamos aquí?"

# game/Story02.rpy:3090

translate spanish akt2chapter4_10f0efed:

    # Mi "…The meeting with Emberlin?"
    Mi "¿La reunión con Emberlin?"

# game/Story02.rpy:3091

translate spanish akt2chapter4_716019b8:

    # mc "Right."
    mc "Cierto."

# game/Story02.rpy:3094

translate spanish akt2chapter4_54aa351d:

    # mc "If we stayed up top, we’d be dead already."
    mc "Si nos quedamos arriba, ya estaríamos muertos."

# game/Story02.rpy:3095

translate spanish akt2chapter4_0e4a133a:

    # mc "Down there… at least we’ve got a shot to talk."
    mc "Allá abajo... al menos tenemos una oportunidad para hablar."

# game/Story02.rpy:3099

translate spanish akt2chapter4_724be5fb:

    # Mi "(whispering) …I’m not sure."
    Mi "(susurando) ... No estoy seguro."

# game/Story02.rpy:3100

translate spanish akt2chapter4_7c136244:

    # mc "Because of the uniform?"
    mc "¿Por el uniforme?"

# game/Story02.rpy:3101

translate spanish akt2chapter4_f1a1b640:

    # Mi "…Yeah."
    Mi "...Sí."

# game/Story02.rpy:3103

translate spanish akt2chapter4_a154b9e3:

    # h "Even Mir’s not sure."
    h "Incluso Mir no está seguro."

# game/Story02.rpy:3104

translate spanish akt2chapter4_8a319f6b:

    # h "What kind of place is this Lower Town anyway...?"
    h "¿Qué clase de lugar es este Pueblo Inferior?"

# game/Story02.rpy:3105

translate spanish akt2chapter4_96e45bc2:

    # Mi "…Home."
    Mi "...de casa."

# game/Story02.rpy:3106

translate spanish akt2chapter4_e0bfd693:

    # k "You have no idea, where you’re going."
    k "No tienes idea, adónde vas."

# game/Story02.rpy:3110

translate spanish akt2chapter4_96e1cff9:

    # mc "We’re meeting them, Kalestra."
    mc "Nos reuniremos con ellos, Kalestra."

# game/Story02.rpy:3111

translate spanish akt2chapter4_173c1612:

    # mc "No way around it."
    mc "No hay manera de rodearlo."

# game/Story02.rpy:3123

translate spanish akt2chapter4_778b04c0:

    # h "...What was that?"
    h "¿Qué fue eso?"

# game/Story02.rpy:3127

translate spanish akt2chapter4_54d9e503:

    # mc "...It’s fine. Just—"
    mc "... Está bien."

# game/Story02.rpy:3129

translate spanish akt2chapter4_3182f744:

    # h "What, getting nervous?"
    h "¿Qué, poniéndose nervioso?"

# game/Story02.rpy:3131

translate spanish akt2chapter4_d875ef64:

    # mc "...Forget it."
    mc "...olvídalo."

# game/Story02.rpy:3134

translate spanish akt2chapter4_a837bc6c:

    # mc "(…Not now.)"
    mc "(...no ahora)."

# game/Story02.rpy:3137

translate spanish akt2chapter4_82987a0d:

    # h "...You getting nervous about this meeting?"
    h "¿Te estás poniendo nervioso por esta reunión?"

# game/Story02.rpy:3145

translate spanish akt2chapter4_c300082f:

    # mc "...Yeah."
    mc "...Sí."

# game/Story02.rpy:3148

translate spanish akt2chapter4_4e1bd473:

    # mc "(…Pain’s getting worse.)"
    mc "(... el dolor está empeorando.)"

# game/Story02.rpy:3165

translate spanish akt2chapter5_251902b0:

    # "Sector 6. Level 2. Lower Town."
    "Sector 6. Nivel 2. Ciudad Baja."

# game/Story02.rpy:3169

translate spanish akt2chapter5_488c1bef:

    # k "All this time… and the air’s still just as unbreathable."
    k "Todo este tiempo... y el aire sigue siendo tan intransigente."

# game/Story02.rpy:3172

translate spanish akt2chapter5_21667a28:

    # k "Brings back memories."
    k "Trae recuerdos."

# game/Story02.rpy:3174

translate spanish akt2chapter5_c2e7cf9b:

    # Mi "…That’s not why we’re here."
    Mi "...No es por eso que estamos aquí."

# game/Story02.rpy:3176

translate spanish akt2chapter5_90ba2d8d:

    # mc "Lower Town…?"
    mc "¿El Pueblo Inferior?"

# game/Story02.rpy:3178

translate spanish akt2chapter5_515335e3:

    # k "That’s right. Looks like shit."
    k "Eso es correcto. Parece una mierda."

# game/Story02.rpy:3179

translate spanish akt2chapter5_35cded66:

    # k "Is shit."
    k "Es una mierda."

# game/Story02.rpy:3180

translate spanish akt2chapter5_8117b3c7:

    # k "Welcome…"
    k "Bienvenido..."

# game/Story02.rpy:3181

translate spanish akt2chapter5_9db8f26b:

    # k "To broken dreams."
    k "Para sueños rotos."

# game/Story02.rpy:3183

translate spanish akt2chapter5_e94dedf9:

    # Mi "…People used to come here chasing their dreams."
    Mi "La gente solía venir aquí persiguiendo sus sueños."

# game/Story02.rpy:3187

translate spanish akt2chapter5_cfd217e8:

    # h "Huh. Wonder what went wrong..."
    h "Me pregunto qué salió mal..."

# game/Story02.rpy:3188

translate spanish akt2chapter5_81f78057:

    # h "Care to explain, Kalestra?"
    h "¿Te importa explicar, Kalestra?"

# game/Story02.rpy:3190

translate spanish akt2chapter5_4153f687:

    # k "What are you implying?"
    k "¿Qué estás insinuando?"

# game/Story02.rpy:3192

translate spanish akt2chapter5_d0156362:

    # k "This isn’t your mess to deal with."
    k "Esto no es tu problema con el que lidiar."

# game/Story02.rpy:3199

translate spanish akt2chapter5_8b9ee863:

    # mc "Enough."
    mc "Suficiente."

# game/Story02.rpy:3203

translate spanish akt2chapter5_c3594bf3:

    # mc "...Liv, ease off her."
    mc "...Liv, aliviadla."

# game/Story02.rpy:3204

translate spanish akt2chapter5_5b2d93a8:

    # h "I’m not pushing—"
    h "No estoy empujando..."

# game/Story02.rpy:3205

translate spanish akt2chapter5_d6f44a4e:

    # mc "You are."
    mc "Lo eres."

# game/Story02.rpy:3206

translate spanish akt2chapter5_b5d2d689:

    # mc "Or you trying to take it out on her?"
    mc "¿O intentas sacarla?"

# game/Story02.rpy:3207

translate spanish akt2chapter5_4fe8f3b9:

    # h "Wh-"
    h "Wh..."

# game/Story02.rpy:3209

translate spanish akt2chapter5_d5d5dbab:

    # Mi "…I agree with Liv."
    Mi "...Estoy de acuerdo con Liv."

# game/Story02.rpy:3210

translate spanish akt2chapter5_406ca6a3:

    # Mi "…Without her, we would’ve—"
    Mi "...sin ella, lo habríamos..."

# game/Story02.rpy:3212

translate spanish akt2chapter5_bddc3da7:

    # Mi "…Why are you defending her?"
    Mi "¿Por qué la defiendes?"

# game/Story02.rpy:3214

translate spanish akt2chapter5_8c678df2:

    # mc "She’s the one who pulled me out of the gutter."
    mc "Ella es la que me sacó de la gorra."

# game/Story02.rpy:3215

translate spanish akt2chapter5_3c99be2a:

    # Mi "…So did we."
    Mi "... nosotros también."

# game/Story02.rpy:3216

translate spanish akt2chapter5_b3ecaeb2:

    # k "Heh… look at you. Just got here, and the city’s already getting to you."
    k "Mírate. acaba de llegar, y la ciudad ya te está llegando."

# game/Story02.rpy:3219

translate spanish akt2chapter5_461c77bc:

    # mc "(...Broken dreams, huh.)"
    mc "(...sueños rotos, eh.)"

# game/Story02.rpy:3220

translate spanish akt2chapter5_323d6a2e:

    # mc "You’re getting in your own head, Kalestra."
    mc "Te estás metiendo en tu propia cabeza, Kalestra."

# game/Story02.rpy:3222

translate spanish akt2chapter5_20f40611:

    # k "That coming from someone who believes in an afterlife?"
    k "¿Eso viene de alguien que cree en una vida después de la muerte?"

# game/Story02.rpy:3223

translate spanish akt2chapter5_490f41b8:

    # mc "Big words… from someone scared to die."
    mc "Palabras grandes... de alguien asustado a morir."

# game/Story02.rpy:3228

translate spanish akt2chapter5_fce2be70:

    # k "…You’ll see."
    k "... Ya verás."

# game/Story02.rpy:3237

translate spanish akt2chapter5_cd7d2030:

    # k "Move."
    k "Muévete."

# game/Story02.rpy:3240

translate spanish akt2chapter5_c5f7cb82:

    # mc "Liv. A minute."
    mc "Liv. Un minuto."

# game/Story02.rpy:3245

translate spanish akt2chapter5_9292a96c:

    # h "I’m doing everything I can here, alright?"
    h "Estoy haciendo todo lo que puedo aquí, ¿de acuerdo?"

# game/Story02.rpy:3249

translate spanish akt2chapter5_734c3d21:

    # h "With her attitude? There’s no way this ends peacefully."
    h "¿Con su actitud? No hay manera de que esto termine pacíficamente."

# game/Story02.rpy:3253

translate spanish akt2chapter5_56e6de2f:

    # mc "You’ve been where she is."
    mc "Has estado donde está."

# game/Story02.rpy:3254

translate spanish akt2chapter5_3132cfec:

    # mc "Or you want me to remind you?"
    mc "¿O quieres que te lo recuerde?"

# game/Story02.rpy:3256

translate spanish akt2chapter5_0099b01d:

    # h "I wouldn’t give a damn—"
    h "No me importaría un bledo..."

# game/Story02.rpy:3258

translate spanish akt2chapter5_dedc06eb:

    # mc "Liv. Truth."
    mc "Liv. Verdad."

# game/Story02.rpy:3260

translate spanish akt2chapter5_de829e3a:

    # h "Like shit."
    h "Como mierda."

# game/Story02.rpy:3264

translate spanish akt2chapter5_cfcc2293:

    # mc "I know."
    mc "Lo sé."

# game/Story02.rpy:3268

translate spanish akt2chapter5_48324d20:

    # h "…Fine."
    h "...Bien."

# game/Story02.rpy:3269

translate spanish akt2chapter5_f7fc5af8:

    # mc "Let’s go."
    mc "Vamos."

# game/Story02.rpy:3282

translate spanish akt2chapter5_c92445d2:

    # Mi "…We were told to wait."
    Mi "Nos dijeron que esperaran."

# game/Story02.rpy:3284

translate spanish akt2chapter5_37341d0d:

    # k "We don’t wait."
    k "No esperamos."

# game/Story02.rpy:3287

translate spanish akt2chapter5_d107ea32:

    # k "Not my problem you took your sweet time getting here."
    k "No es mi problema que te tomaste tu tiempo para llegar aquí."

# game/Story02.rpy:3292

translate spanish akt2chapter5_8f9eee42:

    # h "Oh, sorry for being just a regular human."
    h "Siento ser un humano normal."

# game/Story02.rpy:3295

translate spanish akt2chapter5_fbdf8f78:

    # h "(Easy… you said you wouldn’t.)"
    h "(Easy... dijiste que no lo harías.)"

# game/Story02.rpy:3298

translate spanish akt2chapter5_d680d4d6:

    # k "Wow… not gonna finish that?"
    k "Wow... ¿no vas a terminar eso?"

# game/Story02.rpy:3301

translate spanish akt2chapter5_f5381b5e:

    # h "Not for you. Trust me."
    h "No para ti, créeme."

# game/Story02.rpy:3302

translate spanish akt2chapter5_dd6ad064:

    # mc "(Quiet.)"
    mc "(Quieto.)"

# game/Story02.rpy:3304

translate spanish akt2chapter5_d73d702c:

    # mc "(…I can see why people came.)"
    mc "(... puedo ver por qué vino la gente.)"

# game/Story02.rpy:3306

translate spanish akt2chapter5_e09b53dd:

    # mc "(Maybe the climate isn’t great, but...)"
    mc "(Quizá el clima no sea grande, pero...)"

# game/Story02.rpy:3307

translate spanish akt2chapter5_50a41482:

    # mc "(Wait… rain?)"
    mc "(Espera... ¿Llueve?)"

# game/Story02.rpy:3309

translate spanish akt2chapter5_8c79851f:

    # mc "(We’re underground. Where’s it coming from?)"
    mc "(Estamos bajo tierra. ¿De dónde viene?)"

# game/Story02.rpy:3312

translate spanish akt2chapter5_2b35b6fe_3:

    # mc "..."
    mc "..."

# game/Story02.rpy:3322

translate spanish akt2chapter5_7199a5cc:

    # a "What a tragedy… Such a pretty face-"
    a "Qué tragedia... tan bonita cara..."

# game/Story02.rpy:3323

translate spanish akt2chapter5_0bb6c7c1:

    # Mi "…She’s here."
    Mi "...ella está aquí."

# game/Story02.rpy:3325

translate spanish akt2chapter5_461dcca9:

    # mc "That her?"
    mc "¿Es ella?"

# game/Story02.rpy:3326

translate spanish akt2chapter5_c23a9b14:

    # Mi "...yes."
    Mi "...sí."

# game/Story02.rpy:3328

translate spanish akt2chapter5_99921d04:

    # Mi "…You took your time."
    Mi "...te tomaste tu tiempo."

# game/Story02.rpy:3332

translate spanish akt2chapter5_e0a4baa4:

    # a "I was trying to figure out if you’ve completely lost your mind, bringing two Inquisitors straight to us."
    a "Estaba tratando de averiguar si has perdido completamente tu mente, trayendo dos Inquisidores directamente a nosotros."

# game/Story02.rpy:3334

translate spanish akt2chapter5_03cf8540:

    # Mi "…On the surface, yeah."
    Mi "...en la superficie, sí."

# game/Story02.rpy:3340

translate spanish akt2chapter5_5cf1faeb:

    # mc "And you?"
    mc "¿Y tú?"

# game/Story02.rpy:3343

translate spanish akt2chapter5_c35ed0a0:

    # aS "Aisha."
    aS "Aisha."

# game/Story02.rpy:3348

translate spanish akt2chapter5_7372ec8e:

    # aS "One and only. The greatest idol in the galaxy."
    aS "Uno y único, el ídolo más grande de la galaxia."

# game/Story02.rpy:3350

translate spanish akt2chapter5_9d25b4d7:

    # h "Idol?"
    h "¿Idol?"

# game/Story02.rpy:3351

translate spanish akt2chapter5_e64b1bae:

    # Mi "…It’s a long story."
    Mi "...Es una larga historia."

# game/Story02.rpy:3353

translate spanish akt2chapter5_d3ecd28d:

    # aS "Mir, I got a question..."
    aS "Mir, tengo una pregunta..."

# game/Story02.rpy:3354

translate spanish akt2chapter5_92d5ce57:

    # aS "So confident... Hope that confidence doesn’t vanish when you see him again."
    aS "Tan confiado... Espero que la confianza no se desvaneca cuando lo veas de nuevo."

# game/Story02.rpy:3170

translate spanish akt2chapter5_1a932e7d:

    # k "Well, well, well…"
    k "Bueno, bueno, bueno..."

# game/Story02.rpy:3185

translate spanish akt2chapter5_1de37104:

    # mc "Broken dreams…?"
    mc "¿Sueños rotos?"

# game/Story02.rpy:3195

translate spanish akt2chapter5_12ad8184:

    # h "What? Just thinking out loud."
    h "Solo pensaba en voz alta."

# game/Story02.rpy:3197

translate spanish akt2chapter5_12bf8617:

    # k "Listen carefully, shorty."
    k "Escucha con cuidado, corto."

# game/Story02.rpy:3200

translate spanish akt2chapter5_1b6c688c:

    # h "Wow… look who found her voice."
    h "Vaya... mira quién encontró su voz."

# game/Story02.rpy:3213

translate spanish akt2chapter5_17469ecf:

    # mc "Easier? Yeah. Maybe."
    mc "¿Más fácil?"

# game/Story02.rpy:3243

translate spanish akt2chapter5_1368459c:

    # h "(whispering) If it’s such a pain, why the hell did she even come with us?"
    h "Si es un dolor, ¿por qué demonios vino con nosotros?"

# game/Story02.rpy:3290

translate spanish akt2chapter5_152e2393:

    # Mi "…If we’d been on time-"
    Mi "...si hubiéramos estado a tiempo..."

# game/Story02.rpy:3296

translate spanish akt2chapter5_1a45283d:

    # h "Not all of us have those shiny implan-"
    h "No todos tenemos esos implanes brillantes..."

# game/Story02.rpy:3378

translate spanish akt2chapter5_1_b52f92b9:

    # k "Funny…"
    k "Divertido..."

# game/Story02.rpy:3380

translate spanish akt2chapter5_1_b3c97ac5:

    # k "Last time I was here, it smelled like smoke, blood, and fear."
    k "La última vez que estuve aquí, olía a humo, sangre y miedo."

# game/Story02.rpy:3382

translate spanish akt2chapter5_1_6d16d080:

    # mc "(Eight on the left. Three on the right. More below...)"
    mc "(Al lado izquierdo, tres a la derecha, más abajo...)"

# game/Story02.rpy:3384

translate spanish akt2chapter5_1_ed237b7a:

    # mc "Stay sharp."
    mc "Mantente firme."

# game/Story02.rpy:3387

translate spanish akt2chapter5_1_2c845811:

    # h "(whispering) This place… gives me the creeps."
    h "Este lugar... me da los crepes."

# game/Story02.rpy:3388

translate spanish akt2chapter5_1_4b356c83:

    # Mi "…They won’t kill us."
    Mi "...No nos matarán."

# game/Story02.rpy:3389

translate spanish akt2chapter5_1_edc06ad1:

    # Mi "…Not yet."
    Mi "... todavía no."

# game/Story02.rpy:3393

translate spanish akt2chapter5_1_a4909daf:

    # h "Oh great… let’s hope it stays that way."
    h "Oh, genial... esperemos que siga así."

# game/Story02.rpy:3395

translate spanish akt2chapter5_1_363c0ece:

    # k "For once… I agree with you."
    k "Por una vez... estoy de acuerdo contigo."

# game/Story02.rpy:3396

translate spanish akt2chapter5_1_38edd526:

    # mc "(The way they’re looking…)"
    mc "(La forma en que están mirando...)"

# game/Story02.rpy:3397

translate spanish akt2chapter5_1_57498869:

    # mc "They’re judging."
    mc "Están juzgando."

# game/Story02.rpy:3399

translate spanish akt2chapter5_1_105c5a4e:

    # k "They’re sizing you up."
    k "Te están apretando."

# game/Story02.rpy:3401

translate spanish akt2chapter5_1_c42b05ac:

    # mc "And?"
    mc "¿Y?"

# game/Story02.rpy:3404

translate spanish akt2chapter5_1_3ac68df7:

    # k "As you can see… you’re still alive."
    k "Como puedes ver... sigues vivo."

# game/Story02.rpy:3407

translate spanish akt2chapter5_1_3b87ef3b:

    # mc "(She’s staring too hard.)"
    mc "(Ella está mirando demasiado fuerte.)"

# game/Story02.rpy:3408

translate spanish akt2chapter5_1_27bb7259:

    # mc "Say it."
    mc "Dilo."

# game/Story02.rpy:3410

translate spanish akt2chapter5_1_a8135c1c:

    # aS "You… You sound strange."
    aS "Suenas extraño."

# game/Story02.rpy:3414

translate spanish akt2chapter5_1_80b08ac3:

    # mc "First the city."
    mc "Primero la ciudad."

# game/Story02.rpy:3415

translate spanish akt2chapter5_1_cc27b883:

    # mc "Now it’s two souls."
    mc "Ahora son dos almas."

# game/Story02.rpy:3417

translate spanish akt2chapter5_1_91116777:

    # mc "You people see ghosts everywhere."
    mc "Ustedes ven fantasmas por todas partes."

# game/Story02.rpy:3418

translate spanish akt2chapter5_1_b040b3a5:

    # aS "Reminds me of…"
    aS "Me recuerda..."

# game/Story02.rpy:3422

translate spanish akt2chapter5_1_b7345a5a:

    # aS "(Whispering) Evrelia."
    aS "Evrelia."

# game/Story02.rpy:3426

translate spanish akt2chapter5_1_0af0daf4:

    # aS "A gorilla? Care to enlighten me?"
    aS "¿Un gorila?"

# game/Story02.rpy:3428

translate spanish akt2chapter5_1_8004fce5:

    # h "And what’s that supposed to mean?"
    h "¿Y qué significa eso?"

# game/Story02.rpy:3429

translate spanish akt2chapter5_1_25b2d084:

    # aS "Oh, of course. Naturally."
    aS "Por supuesto."

# game/Story02.rpy:3431

translate spanish akt2chapter5_1_2f12a841:

    # aS "The real question is… will she even share it with you?"
    aS "La verdadera pregunta es... ¿incluso lo compartirá contigo?"

# game/Story02.rpy:3432

translate spanish akt2chapter5_1_8c2c73b9:

    # k "I…"
    k "Yo..."

# game/Story02.rpy:3433

translate spanish akt2chapter5_1_50aa36cd:

    # k "...I’ll share."
    k "... compartiré."

# game/Story02.rpy:3435

translate spanish akt2chapter5_1_4e46cda8:

    # k "But not in front of you, rabbit number two."
    k "Pero no delante de ti, conejo número dos."

# game/Story02.rpy:3437

translate spanish akt2chapter5_1_2b35b6fe_1:

    # mc "..."
    mc "..."

# game/Story02.rpy:3438

translate spanish akt2chapter5_1_dc7383a9:

    # mc "You’ve got words."
    mc "Tienes palabras."

# game/Story02.rpy:3439

translate spanish akt2chapter5_1_9b9509b0:

    # mc "Not much meaning."
    mc "No tiene mucho sentido."

# game/Story02.rpy:3440

translate spanish akt2chapter5_1_bf3e94c5:

    # mc "Get to the point."
    mc "Llega al punto."

# game/Story02.rpy:3441

translate spanish akt2chapter5_1_369a1e7f:

    # mc "Where’s Winter?"
    mc "¿Dónde está Winter?"

# game/Story02.rpy:3446

translate spanish akt2chapter5_1_73f310dc:

    # Mi "(…Two souls?)"
    Mi "(...¿Dos almas?)"

# game/Story02.rpy:3451

translate spanish akt2chapter5_1_cee34e4c_1:

    # aS "..."
    aS "..."

# game/Story02.rpy:3458

translate spanish akt2chapter5_1_456ca6f8:

    # aS "We’ll talk downstairs."
    aS "Hablaremos abajo."

# game/Story02.rpy:3462

translate spanish akt2chapter5_1_da3fdbf1:

    # Mi "..."
    Mi "..."

# game/Story02.rpy:3471

translate spanish akt2chapter5_1_476ae4a1:

    # Mi "…Let’s go."
    Mi "...Vamos."

# game/Story02.rpy:3472

translate spanish akt2chapter5_1_ba1550e1:

    # a "(whispering) She burned our homes…"
    a "Quemó nuestras casas..."

# game/Story02.rpy:3473

translate spanish akt2chapter5_1_22700450:

    # aa "(whispering) She killed my mother!"
    aa "¡Mató a mi madre!"

# game/Story02.rpy:3474

translate spanish akt2chapter5_1_829c5de7:

    # a "MURDERER!"
    a "¡MURDERER!"

# game/Story02.rpy:3478

translate spanish akt2chapter5_1_671c70d0:

    # a "Get out! We don’t need your kind of justice!"
    a "¡No necesitamos su tipo de justicia!"

# game/Story02.rpy:3479

translate spanish akt2chapter5_1_c753cdb0:

    # k "They’ve got plenty to say."
    k "Tienen mucho que decir."

# game/Story02.rpy:3481

translate spanish akt2chapter5_1_55615d34:

    # k "Just not when I’m close enough to hear it."
    k "No cuando estoy lo suficientemente cerca para escucharlo."

# game/Story02.rpy:3483

translate spanish akt2chapter5_1_9d8021bb:

    # mc "(All these looks…)"
    mc "(Todas estas miradas...)"

# game/Story02.rpy:3484

translate spanish akt2chapter5_1_6ec99741:

    # mc "(whispering) Liv, stay ready."
    mc "Liv, quédate listo."

# game/Story02.rpy:3487

translate spanish akt2chapter5_1_d3a00846:

    # mc "Wait for my call."
    mc "Espera mi llamada."

# game/Story02.rpy:3488

translate spanish akt2chapter5_1_27fbc5df:

    # w "What’s all that noise?"
    w "¿Qué es todo ese ruido?"

# game/Story02.rpy:3491

translate spanish akt2chapter5_1_a9040206:

    # w "…Sounds like surface trash."
    w "Suena como basura superficial."

# game/Story02.rpy:3492

translate spanish akt2chapter5_1_a3322b32:

    # aS "Oh, come on. You already know why they’re here."
    aS "Ya sabes por qué están aquí."

# game/Story02.rpy:3494

translate spanish akt2chapter5_1_1d9c9340:

    # aS "Smile a little more… we have guests."
    aS "Sonríe un poco más... tenemos invitados."

# game/Story02.rpy:3496

translate spanish akt2chapter5_1_f7c7ac0d:

    # w "I’m glad…"
    w "Me alegro..."

# game/Story02.rpy:3498

translate spanish akt2chapter5_1_7753cc84:

    # w "…and I’ll be even gladder when they’re gone."
    w "...y estaré aún más contento cuando se hayan ido."

# game/Story02.rpy:3499

translate spanish akt2chapter5_1_3b78cefa:

    # aS "Yo Winter, do as you want."
    aS "Yo Winter, haz lo que quieras."

# game/Story02.rpy:3501

translate spanish akt2chapter5_1_75bb0dab:

    # aS "But don’t rush with your decision."
    aS "Pero no te apresures con tu decisión."

# game/Story02.rpy:3505

translate spanish akt2chapter5_1_c70ecb03:

    # w "Do you even realize her life’s hanging by a thread here?"
    w "¿Te das cuenta de que su vida está colgada por un hilo aquí?"

# game/Story02.rpy:3507

translate spanish akt2chapter5_1_f62beee1:

    # w "I’m not the kind of man who looks away from blood on someone’s hands."
    w "No soy el tipo de hombre que mira lejos de la sangre en las manos de alguien."

# game/Story02.rpy:3508

translate spanish akt2chapter5_1_222c871d:

    # aS "Respect won’t do you any good if you end up dead."
    aS "El respeto no te hará ningún bien si terminas muerto."

# game/Story02.rpy:3509

translate spanish akt2chapter5_1_120238ca:

    # w "…Is that a threat?"
    w "¿Es una amenaza?"

# game/Story02.rpy:3512

translate spanish akt2chapter5_1_365de02b:

    # aS "I’m warning you. Or have you decided to go against Ember?"
    aS "Te lo advierto. ¿O has decidido ir contra Ember?"

# game/Story02.rpy:3514

translate spanish akt2chapter5_1_b6ce435f:

    # w "Ellie…?"
    w "¿Ellie?"

# game/Story02.rpy:3515

translate spanish akt2chapter5_1_0c2b0a31:

    # Mi "…I know you’ve heard about what’s happening on the surface."
    Mi "...Sé que has oído lo que está sucediendo en la superficie."

# game/Story02.rpy:3517

translate spanish akt2chapter5_1_f80c8fbd:

    # w "Yeah… and didn’t like what I heard."
    w "Sí... y no me gustó lo que escuché."

# game/Story02.rpy:3518

translate spanish akt2chapter5_1_e394a7f2:

    # w "You with them because of that?"
    w "¿Estás con ellos por eso?"

# game/Story02.rpy:3519

translate spanish akt2chapter5_1_da3fdbf1_1:

    # Mi "..."
    Mi "..."

# game/Story02.rpy:3521

translate spanish akt2chapter5_1_3fb97f92:

    # Mi "I’m here to collect what you owe."
    Mi "Estoy aquí para recoger lo que debes."

# game/Story02.rpy:3529

translate spanish akt2chapter5_1_c9d81fd8:

    # h "(whispering) That Winter guy… he’s not taking his eyes off you."
    h "Ese tipo de invierno... no te está quitando los ojos."

# game/Story02.rpy:3531

translate spanish akt2chapter5_1_cdc20e2f:

    # k "I can feel that without you."
    k "Puedo sentir eso sin ti."

# game/Story02.rpy:3533

translate spanish akt2chapter5_1_39aa651e:

    # h "(whispering) If this turns into a fight, what’s the plan?"
    h "Si esto se convierte en una pelea, ¿cuál es el plan?"

# game/Story02.rpy:3534

translate spanish akt2chapter5_1_48d60aec:

    # mc "Liv, you take the rear. Hold the left."
    mc "Liv, toma la parte trasera."

# game/Story02.rpy:3535

translate spanish akt2chapter5_1_c7dda7fb:

    # mc "Kalestra… Winter’s yours."
    mc "Kalestra... el invierno es tuyo."

# game/Story02.rpy:3538

translate spanish akt2chapter5_1_443d6f91:

    # k "Don’t get in my way."
    k "No te interpongas en mi camino."

# game/Story02.rpy:3539

translate spanish akt2chapter5_1_46319a6f:

    # h "And you?"
    h "¿Y tú?"

# game/Story02.rpy:3540

translate spanish akt2chapter5_1_2b35b6fe_2:

    # mc "..."
    mc "..."

# game/Story02.rpy:3545

translate spanish akt2chapter5_1_643ddf19:

    # mc "I’ll handle it."
    mc "Yo me encargaré."

# game/Story02.rpy:3547

translate spanish akt2chapter5_1_0d04128e_1:

    # w "..."
    w "..."

# game/Story02.rpy:3566

translate spanish akt2chapter5_1_9c477ce7:

    # w "I’ll be straight with you."
    w "Seré sincero contigo."

# game/Story02.rpy:3567

translate spanish akt2chapter5_1_098fe0d5:

    # w "You’re not welcome here."
    w "No eres bienvenido aquí."

# game/Story02.rpy:3568

translate spanish akt2chapter5_1_0d0fb9cd:

    # w "…But you’re staying."
    w "...Pero te quedas."

# game/Story02.rpy:3572

translate spanish akt2chapter5_1_b3171147:

    # w "For Ember."
    w "Para Ember."

# game/Story02.rpy:3573

translate spanish akt2chapter5_1_f66df46f:

    # mc "Goes both ways."
    mc "Va por ambos lados."

# game/Story02.rpy:3581

translate spanish akt2chapter5_1_da2b61e6:

    # mc "Now— let’s get to it."
    mc "Ahora, vamos a llegar a ella."

# game/Story02.rpy:3582

translate spanish akt2chapter5_1_a390c19b:

    # Fl "She’s buried in work right now."
    Fl "Está enterrada en el trabajo ahora mismo."

# game/Story02.rpy:3585

translate spanish akt2chapter5_1_96c5adc2:

    # Fl "She’ll be here soon."
    Fl "Pronto llegará."

# game/Story02.rpy:3588

translate spanish akt2chapter5_1_6f1d7cd7:

    # h "You’re awfully calm… considering what’s going on out there."
    h "Estás muy tranquilo... considerando lo que está pasando ahí fuera."

# game/Story02.rpy:3589

translate spanish akt2chapter5_1_23abc4e0:

    # Fl "And you’re still just as talkative."
    Fl "Y aún eres tan hablador."

# game/Story02.rpy:3590

translate spanish akt2chapter5_1_7d20456b:

    # h "…Glad you’re alive."
    h "...Dime que estás vivo."

# game/Story02.rpy:3592

translate spanish akt2chapter5_1_b974504b:

    # Fl "...Yeah."
    Fl "...Sí."

# game/Story02.rpy:3594

translate spanish akt2chapter5_1_8e9d16ea:

    # mc "You did good."
    mc "Lo hiciste bien."

# game/Story02.rpy:3600

translate spanish akt2chapter5_1_bc0a3d20:

    # Fl "Worse than it looks."
    Fl "Peor de lo que parece."

# game/Story02.rpy:3602

translate spanish akt2chapter5_1_d8272412:

    # Fl "(whispering) …I’m glad you made it."
    Fl "(susurando) ... Me alegro de que lo hayas hecho."

# game/Story02.rpy:3604

translate spanish akt2chapter5_1_a5d8d2e1:

    # mc "…You holding up?"
    mc "¿Te estás aferrando?"

# game/Story02.rpy:3605

translate spanish akt2chapter5_1_ce7728d6:

    # Fl "(whispering) I’ve been trying not to lose my mind."
    Fl "He estado intentando no perder mi mente."

# game/Story02.rpy:3607

translate spanish akt2chapter5_1_33342ed3:

    # Fl "(whispering) With everything happening out there…"
    Fl "Con todo lo que pasa ahí fuera..."

# game/Story02.rpy:3609

translate spanish akt2chapter5_1_19a02689:

    # mc "What did you find?"
    mc "¿Qué encontraste?"

# game/Story02.rpy:3610

translate spanish akt2chapter5_1_e3d0b78d:

    # Fl "Thanks to you? Yeah."
    Fl "- ¿Gracias a ti?"

# game/Story02.rpy:3611

translate spanish akt2chapter5_1_60865b9c:

    # Fl "But it’s incomplete."
    Fl "Pero es incompleta."

# game/Story02.rpy:3613

translate spanish akt2chapter5_1_8500cb9b:

    # Fl "Too many gaps."
    Fl "Demasiados vacíos."

# game/Story02.rpy:3615

translate spanish akt2chapter5_1_a03ba5fa:

    # mc "(Ostorius sent you the report.)"
    mc "(Ostorius te envió el informe.)"

# game/Story02.rpy:3616

translate spanish akt2chapter5_1_51fa70f5:

    # mc "You already know."
    mc "Ya lo sabes."

# game/Story02.rpy:3618

translate spanish akt2chapter5_1_d37f1f23:

    # mc "You just don’t want to accept it."
    mc "Simplemente no quieres aceptarlo."

# game/Story02.rpy:3621

translate spanish akt2chapter5_1_0e622370:

    # Fl "Accepting that means questioning Astoria."
    Fl "Aceptar eso significa cuestionar a Astoria."

# game/Story02.rpy:3623

translate spanish akt2chapter5_1_45785cab:

    # Fl "And I haven’t lost what’s left of my sanity just yet."
    Fl "Y no he perdido lo que queda de mi cordura todavía."

# game/Story02.rpy:3625

translate spanish akt2chapter5_1_cdb81318:

    # Fl "If a traitor was allowed to pull this off—"
    Fl "Si un traidor se le permitió sacar esto de aquí..."

# game/Story02.rpy:3627

translate spanish akt2chapter5_1_b2da4e90:

    # Fl "Then Astoria herself is on their side."
    Fl "Entonces la misma Astoria está de su lado."

# game/Story02.rpy:3628

translate spanish akt2chapter5_1_af0950b6:

    # mc "...And for what?"
    mc "¿Y para qué?"

# game/Story02.rpy:3630

translate spanish akt2chapter5_1_514b744a:

    # mc "She already had everything."
    mc "Ya lo tenía todo."

# game/Story02.rpy:3631

translate spanish akt2chapter5_1_41da62cb_1:

    # Fl "..."
    Fl "..."

# game/Story02.rpy:3641

translate spanish akt2chapter5_1_7ed81dc0:

    # Fl "And that’s the worst part."
    Fl "Y esa es la peor parte."

# game/Story02.rpy:3642

translate spanish akt2chapter5_1_3c073c86:

    # mc "Talk, Flora."
    mc "Habla, Flora."

# game/Story02.rpy:3647

translate spanish akt2chapter5_1_484f1716:

    # Fl "(quietly) Not here."
    Fl "No aquí."

# game/Story02.rpy:3649

translate spanish akt2chapter5_1_832b01f8:

    # Fl "First, clean yourselves up."
    Fl "Primero, limpiáos."

# game/Story02.rpy:3651

translate spanish akt2chapter5_1_7b5e56b2:

    # Fl "And keep your voices down."
    Fl "Y mantén tus voces abajo."

# game/Story02.rpy:3653

translate spanish akt2chapter5_1_d30dd6a3:

    # k "...You know… we had to get our hands dirty."
