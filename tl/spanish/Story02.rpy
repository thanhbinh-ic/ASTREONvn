translate spanish akt2chapter4_37b29c63:

    # h "Kinda funny, don’t you think?"
    h "Es gracioso, ¿no crees?"

# game/Story02.rpy:2765

translate spanish akt2chapter4_57a083c8:

    # h "Delta Squad… we were sent on the worst missions out there."
    h "Delta Squad... nos enviaron a las peores misiones de ahí."

