translate spanish story03_38bd6d84:

    # mc "The only thing this stuff makes me feel is pure disgust. {w}Especially the smell."
    mc "Lo único que me hace sentir es un puro asco. {w}Especialmente el olor."

# game/Story02.rpy:376

translate spanish story03_a3233ce3:

    # mc "Like a dead skunk taking one final dump."
    mc "Como un borracho muerto que toma un basurero final."

# game/Story02.rpy:378

translate spanish story03_6cfedf48:

    # h "And how exactly do you know what a dead skunk taking a dump smells like... {w}No, wait. {w}Don’t answer that."
    h "¿Y cómo sabes exactamente lo que un borracho muerto tomando un basurero huele a... {w}No, espera. {w}No respondas eso."

# game/Story02.rpy:381

