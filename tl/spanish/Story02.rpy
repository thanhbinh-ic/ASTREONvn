    # Mi "N-no thanks."
    Mi "No gracias."

# game/Story02.rpy:2796

translate spanish akt2chapter4_44731cb1:

    # mc "Mir."
    mc "Mir."

# game/Story02.rpy:2797

translate spanish akt2chapter4_5e7b220b:

    # mc "What about Ostorius?"
    mc "¿Qué hay de Ostorius?"

