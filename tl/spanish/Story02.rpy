    # Mi "And yet… {w=0.5}I can’t leave them."
    Mi "Y aún así... {w=0.5}No puedo dejarlos."

# game/Story02.rpy:3999

translate spanish akt2chapter7_891e9c7c:

    # Mi "I can’t let it all fall apart."
    Mi "No puedo dejar que todo se desmorone."

# game/Story02.rpy:4001

translate spanish akt2chapter7_22a34e90:

    # Mi "Maybe Flora’s right…"
    Mi "Tal vez Flora tiene razón..."

# game/Story02.rpy:4002

