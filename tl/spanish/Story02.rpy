# game/Story02.rpy:2492

translate spanish akt2chapter4_9c1c517f_1:

    # k "Not really. You just gotta know the right approach."
    k "No, solo tienes que saber el enfoque correcto."

# game/Story02.rpy:2496

translate spanish akt2chapter4_7a3fa296:

    # mc "Guess we have that in common. Two ugly bastards."
    mc "Supongo que tenemos eso en común, dos bastardos feos."

# game/Story02.rpy:2498

translate spanish akt2chapter4_da7cb859:

    # k "Can’t argue with that. Us ugly folk should stick together. Two negatives make a positive, right?"
    k "No se puede discutir con eso. Nosotros gente fea debe mantenerse unidos. Dos negativos hacen un positivo, ¿verdad?"

# game/Story02.rpy:2507

translate spanish akt2chapter4_80a0eb7e:

    # mc "(With every question, they just keep getting better and better...)"
    mc "(Con cada pregunta, ellos siguen mejorando y mejorando...)"

# game/Story02.rpy:2509

translate spanish akt2chapter4_f34ef8ca:

    # k "Well? So, what's your answer?"
    k "¿Cuál es la respuesta?"

# game/Story02.rpy:2513

translate spanish akt2chapter4_34245b2f:

    # mc "Maybe I just like smart people?"
    mc "¿Tal vez me gustan los inteligentes?"

# game/Story02.rpy:2515

translate spanish akt2chapter4_617ccc18:

    # k "Oh, so you're one of those, huh? The type who values 'depth of the soul'?"
    k "Oh, eres uno de esos, ¿quién aprecia la profundidad del alma?"

# game/Story02.rpy:2517

translate spanish akt2chapter4_d40788eb:

    # mc "More like the type who appreciates people who know when to keep their mouth shut."
    mc "Más bien el tipo que aprecia a las personas que saben cuándo mantener la boca cerrada."

# game/Story02.rpy:2519

translate spanish akt2chapter4_cbf20780:

    # k "Hmm. I’m starting to like you."
    k "Estoy empezando a gustarme."

# game/Story02.rpy:2523

translate spanish akt2chapter4_99ced230:

    # mc "Are you always this persistent?"
    mc "¿Siempre eres tan persistente?"

# game/Story02.rpy:2525

translate spanish akt2chapter4_8c13dfc6:

    # k "Are you always this much of a buzzkill?"
    k "¿Siempre eres tan hábil?"

# game/Story02.rpy:2527

translate spanish akt2chapter4_5a1a31f4:

    # mc "Only when I have a headache."
    mc "Solo cuando tengo dolor de cabeza."

# game/Story02.rpy:2529

translate spanish akt2chapter4_cf2c6189:

    # k "Well, that explains a lot."
    k "Bueno, eso explica mucho."

# game/Story02.rpy:2534

translate spanish akt2chapter4_e1864ddd:

    # mc "I like carrots."
    mc "Me gustan las zanahorias."

# game/Story02.rpy:2536

translate spanish akt2chapter4_7f90fe5c:

    # k "...You're scaring me."
    k "Me estás asustando."

# game/Story02.rpy:2538

translate spanish akt2chapter4_0e63549a:

    # mc "Perfect. That was my goal."
    mc "Perfecto, ese era mi objetivo."

# game/Story02.rpy:2545

translate spanish akt2chapter4_a7cc4b21:

    # Mi "Everyone ready?"
    Mi "¿Todos listos?"

# game/Story02.rpy:2546

translate spanish akt2chapter4_7dff7b64:

    # Mi "Time to pay our friends in Lower Town a visit."
    Mi "Hora de visitar a nuestros amigos en la Ciudad Baja."

# game/Story02.rpy:2549

translate spanish akt2chapter4_affbf6e2:

    # Mi "So do me a favor... stay low, stay quiet."
    Mi "Hazme un favor... mantente quieto, mantente callado."

# game/Story02.rpy:2550

translate spanish akt2chapter4_b8ec7e7b:

    # Mi "Especially you."
    Mi "Especialmente tú."

# game/Story02.rpy:2553

translate spanish akt2chapter4_c2ed2136:

    # k "Oh wow, {w=0.5}I’m like the definition of subtlety."
    k "Oh wow, {w=0.5}Soy como la definición de sutileza."

# game/Story02.rpy:2557

translate spanish akt2chapter4_c6512d0a:

    # Mi "I sure hope so."
    Mi "Eso espero."

# game/Story02.rpy:2560

translate spanish akt2chapter4_bb2f1dc2:

    # h "Wait, what is this 'Lower Town' exactly? I thought it was just a figure of speech..."
    h "Espera, ¿qué es \"Ciudad del Sol\"? Pensé que era solo una expresión figurativa."

# game/Story02.rpy:2563

translate spanish akt2chapter4_eebd7b1a:

    # h "Like, you know, when rich and poor people are divided into different 'levels' of society."
    h "Por ejemplo, cuando ricos y pobres se dividen en diferentes segmentos de la población."

# game/Story02.rpy:2566

translate spanish akt2chapter4_b1da38c9:

    # k "Nah. Up here? You got the poor. Down below? You got the ones who weren’t even lucky enough to make it that far."
    k "¿Tienes a los pobres? Tienes a los que no tenían la suerte de llegar tan lejos."

# game/Story02.rpy:2568

translate spanish akt2chapter4_237bcb02:

    # k "Word is, if you {b}were born in Lower Town, you die in Lower Town.{/b}"
    k "La palabra es, si tú {b}nacieron en el Pueblo Inferior, mueres en el Pueblo Inferior.{/b}"

# game/Story02.rpy:2570

translate spanish akt2chapter4_b47b7072:

    # h "A state within a state? Hah... {w=0.5}Yeah, that sounds super promising."
    h "¿Un estado dentro de un estado? {w=0.5}Sí, eso suena super prometedor."

# game/Story02.rpy:2572

translate spanish akt2chapter4_774512eb:

    # h "And remind me again why we’re heading there?"
    h "Y me recuerdas otra vez por qué nos dirigimos allí?"

# game/Story02.rpy:2575

translate spanish akt2chapter4_b36aa69c:

    # mc "To meet Flora. {w=0.5}And to get the locals on our side."
    mc "Para conocer a Flora. {w=0.5}Y para que los locales estén de nuestro lado."

# game/Story02.rpy:2577

translate spanish akt2chapter4_0f7693db:

    # Mi "That second part... {w=0.5}Might be a problem."
    Mi "Esa segunda parte... {w=0.5}Podría ser un problema."

# game/Story02.rpy:2578

translate spanish akt2chapter4_041785de:

    # mc "Care to elaborate?"
    mc "¿Le importaría elaborar?"

# game/Story02.rpy:2582

translate spanish akt2chapter4_c4798cdf:

    # Mi "We're an eyesore to them. They’d rather slit each other’s throats than help us."
    Mi "Preferirían cortarse la garganta de los demás que ayudarnos."

# game/Story02.rpy:2588

translate spanish akt2chapter4_49e27c51:

    # Mi "And honestly? I can’t even blame them."
    Mi "¿Y honestamente? Ni siquiera puedo culparlos."

# game/Story02.rpy:2590

translate spanish akt2chapter4_f06d7fc0:

    # h "I’m liking this plan less and less..."
    h "Me gusta este plan menos y menos..."

# game/Story02.rpy:2593

translate spanish akt2chapter4_b6cfd2da:

    # k "At first, we could’ve managed without them. {w=0.5}But things have changed."
    k "Al principio, podríamos haber logrado sin ellos. {w=0.5}Pero las cosas han cambiado."

# game/Story02.rpy:2594

translate spanish akt2chapter4_4f76a765:

    # k "This isn’t just some territorial dispute anymore."
    k "Esto ya no es solo una disputa territorial."

# game/Story02.rpy:2595

translate spanish akt2chapter4_2945f05d:

    # k "This is a war for the {b}right to exist.{/b}"
    k "Esta es una guerra para {b}derecho a existir.{/b}"

# game/Story02.rpy:2607

translate spanish akt2chapter4_2fded262_7:

    # h "..."
    h "..."

# game/Story02.rpy:2609

translate spanish akt2chapter4_e8ab8e75:

    # h "And when exactly did it start?"
    h "¿Y cuándo empezó exactamente?"

# game/Story02.rpy:2611

translate spanish akt2chapter4_706fa18c:

    # mc "Not long ago. Fourth time in my lifetime."
    mc "No hace mucho tiempo, cuarta vez en mi vida."

# game/Story02.rpy:2613

translate spanish akt2chapter4_ddf09f5b:

    # h "That’s not what I meant. {w=0.5}Was it after that incident?"
    h "No es lo que quise decir. {w=0.5}¿Fue después de ese incidente?"

# game/Story02.rpy:2614

translate spanish akt2chapter4_eccdb5cb:

    # h "And don’t even try to dodge it. You know damn well that won’t end well."
    h "Y ni siquiera trates de esquivarlo. Ya sabes muy bien que no terminará bien."

# game/Story02.rpy:2616

translate spanish akt2chapter4_b824695b:

    # mc "Yeah... {w=0.5}After the metro."
    mc "Sí... {w=0.5}Después del metro."

# game/Story02.rpy:2618

translate spanish akt2chapter4_6b0d6d5f:

    # mc "But so far, it hasn’t affected me..."
    mc "Pero hasta ahora, no me ha afectado..."

# game/Story02.rpy:2621

translate spanish akt2chapter4_e029d773:

    # h "...?"
    h "...?"

# game/Story02.rpy:2627

translate spanish akt2chapter4_356d0dbc:

    # h "We’re not waiting around to see if it does. You need to see a doc. ASAP."
    h "No estamos esperando por ahí para ver si lo hace. Necesitas ver un doc. ASAP."

# game/Story02.rpy:2629

translate spanish akt2chapter4_0e8aa704:

    # h "Last thing I need is you pointing a gun at me without even realizing it."
    h "Lo último que necesito es que me apuntes un arma sin siquiera darse cuenta."

# game/Story02.rpy:2630

translate spanish akt2chapter4_2b35b6fe_8:

    # mc "..."
    mc "..."

# game/Story02.rpy:2632

translate spanish akt2chapter4_897f4109:

    # mc "Fine. Deal."
    mc "Bien, trato hecho."

# game/Story02.rpy:2646

translate spanish akt2chapter5_a8c4dc60:

    # k "Well, well, well... All this time has passed, and it still stinks like hell in here."
    k "Bueno, bueno, bueno... todo este tiempo ha pasado, y todavía apesta como el infierno aquí."

# game/Story02.rpy:2648

translate spanish akt2chapter5_d804c5a1:

    # k "This city hasn’t changed a bit… {w=0.5}And just like always, we’re not welcome."
    k "Esta ciudad no ha cambiado un poco... {w=0.5}Y como siempre, no somos bienvenidos."

# game/Story02.rpy:2650

translate spanish akt2chapter5_778a699a:

    # Mi "It’s too early to jump to conclusions. We just got here."
    Mi "Es demasiado pronto para llegar a conclusiones."

# game/Story02.rpy:2652

translate spanish akt2chapter5_eb00d652:

    # k "Conclusions? You form those in the first few seconds."
    k "Las formas en los primeros segundos."

# game/Story02.rpy:2653

translate spanish akt2chapter5_b3028679:

    # k "And that time’s long gone."
    k "Y ese tiempo se ha ido."

# game/Story02.rpy:2655

translate spanish akt2chapter5_081df4dc:

    # mc "Do you judge people the same way? Or are they an exception?"
    mc "¿Juzga a la gente de la misma manera?"

# game/Story02.rpy:2657

translate spanish akt2chapter5_d5a077a2:

    # k "What’s the difference? Am I not allowed to do that now too? {w=0.5}Ha, yeah, right."
    k "¿Cuál es la diferencia? ¿No me permiten hacer eso ahora también? {w=0.5}Sí, claro."

# game/Story02.rpy:2659

translate spanish akt2chapter5_4dae5b41:

    # Mi "Watch your mouth. {w=0.5}Every word here gets remembered."
    Mi "Cuidado con la boca. {w=0.5}Cada palabra aquí se recuerda."

# game/Story02.rpy:2660

translate spanish akt2chapter5_919b23aa:

    # Mi "Say the wrong thing to the wrong person, and you’re on a one-way trip."
    Mi "Diga lo incorrecto a la persona equivocada, y usted está en un viaje de un solo sentido."

# game/Story02.rpy:2662

translate spanish akt2chapter5_2731d67b:

    # k "You’re talking like this is my first time here. Chill, girl, I got this."
    k "Hablas como si fuera mi primera vez aquí. Chill, chica, yo me encargo."

# game/Story02.rpy:2664

translate spanish akt2chapter5_8a9adb7c:

    # mc "What, are they telepaths? Or do they share a hive mind?"
    mc "¿Qué, son telépatas o comparten una mente de colmena?"

# game/Story02.rpy:2666

translate spanish akt2chapter5_a7253cd6:

    # h "Honestly, at this point, I don’t even know if it’s just a figure of speech or if they mean it literally."
    h "Sinceramente, en este punto, ni siquiera sé si es solo una figura de discurso o si lo quieren decir literalmente."

# game/Story02.rpy:2668

translate spanish akt2chapter5_ae5685c3:

    # k "Nah, they’re regular people. The only difference is their unity… and their worldview."
    k "No, son gente regular. La única diferencia es su unidad... y su visión del mundo."

# game/Story02.rpy:2670

translate spanish akt2chapter5_34c4c263:

    # h "Unity? What does that have to do with anything?"
    h "¿Qué tiene que ver eso con algo?"

# game/Story02.rpy:2672

translate spanish akt2chapter5_919e9ca2:

    # k "Not everyone here is part of the Syndicate. {w=0.5}But anyone can be."
    k "No todos aquí son parte del Sindicato. {w=0.5}Pero cualquiera puede ser."

# game/Story02.rpy:2673

translate spanish akt2chapter5_8f3b76ef:

    # k "Their eyes and ears are everywhere. {w=0.5}They know everything."
    k "Sus ojos y oídos están por todas partes. {w=0.5}Lo saben todo."

# game/Story02.rpy:2676

translate spanish akt2chapter5_6625f533:

    # k "Since childhood, they’re taught two things. First—information is the greatest resource."
    k "Desde la infancia, se les enseña dos cosas. Primero, la información es el recurso más grande."

# game/Story02.rpy:2678

translate spanish akt2chapter5_58fcadc0:

    # k "Second—Brotherhood above all. {w=0.5}No family, no individuals. There’s only us."
    k "Segunda—Brotherhood sobre todo. {w=0.5}No hay familia, no hay individuos. Solo somos nosotros."

# game/Story02.rpy:2680

translate spanish akt2chapter5_f02d5e5b:

    # h "So, what, punch one guy, and you’re at war with the whole faction?"
    h "¿Y qué, golpear a un tipo, y estás en guerra con toda la facción?"

# game/Story02.rpy:2683

translate spanish akt2chapter5_bc0c7136:

    # k "Bingo. Now imagine what happens when you take out half their people... {w=0.5}And then show up asking for help."
    k "Ahora imagina lo que pasa cuando sacas a la mitad de su gente... {w=0.5}Y luego aparece pidiendo ayuda."

# game/Story02.rpy:2685

translate spanish akt2chapter5_21454db8:

    # Mi "Which is exactly why I will be the one talking."
    Mi "Por eso soy yo quien habla."

# game/Story02.rpy:2687

translate spanish akt2chapter5_f238e53d:

    # Mi "Your job is to {b}shut up{/b}."
    Mi "Tu trabajo es {b}Cállate.{/b}."

# game/Story02.rpy:2689

translate spanish akt2chapter5_229b1d39:

    # k "I’ll do my best."
    k "Haré lo mejor que pueda."

# game/Story02.rpy:2691

translate spanish akt2chapter5_d820ff5f:

    # h "Wait… {w=0.5}You’re the one who killed their people?"
    h "Espera... {w=0.5}¿Eres tú quien mató a su gente?"

# game/Story02.rpy:2692

translate spanish akt2chapter5_1cc9cb68:

    # h "Wouldn’t it be easier to just leave you behind?"
    h "¿No sería más fácil dejarte atrás?"

# game/Story02.rpy:2695

translate spanish akt2chapter5_c7a45608:

    # k "Hmph..."
    k "Hmph..."

# game/Story02.rpy:2697

translate spanish akt2chapter5_3d299b0d:

    # k "You’ll need me when things go to shit. {w=0.5}And you’ll need a way out."
    k "Me necesitarás cuando las cosas vayan a la mierda. {w=0.5}Y necesitarás una salida."

# game/Story02.rpy:2704

translate spanish akt2chapter5_e8a2f66d:

    # k "Trying to act tough again? I already told you—this isn’t the place for that."
    k "¿Intentando actuar duro de nuevo? Ya te lo dije, este no es el lugar para eso."

# game/Story02.rpy:2705

translate spanish akt2chapter5_2fded262:

    # h "..."
    h "..."

# game/Story02.rpy:2707

translate spanish akt2chapter5_c5c52973:

    # k "So what now? You gonna keep sulking, or are you finally gonna say something?"
    k "¿Vas a seguir enfurrando o vas a decir algo?"

# game/Story02.rpy:2709

translate spanish akt2chapter5_2fded262_1:

    # h "..."
    h "..."

# game/Story02.rpy:2712

translate spanish akt2chapter5_618f9093:

    # h "Ta-da! And here comes Olivia, making her grand entrance!"
    h "¡Y aquí viene Olivia, haciendo su gran entrada!"

# game/Story02.rpy:2714

translate spanish akt2chapter5_b2363f80:

    # h "Or at least, that’s what I’d say... {w=0.5}If I gave a damn."
    h "O al menos, eso es lo que yo diría... {w=0.5}Si me importa un bledo."

# game/Story02.rpy:2715

translate spanish akt2chapter5_3cf44d88:

    # h "You’re acting way too twitchy. {w=0.5}Nervous someone might find out about your achievements?"
    h "Estás actuando demasiado nervioso. {w=0.5}¿Alguien puede saber sobre tus logros?"

# game/Story02.rpy:2717

translate spanish akt2chapter5_99040f96:

    # h "Oh, or maybe it’s because you’re afra—"
    h "Oh, o tal vez es porque eres afra..."

# game/Story02.rpy:2719

translate spanish akt2chapter5_2fded262_2:

    # h "..."
    h "..."

# game/Story02.rpy:2720

translate spanish akt2chapter5_43379744:

    # mc "(No, you promised...)"
    mc "(No, prometiste...)"

# game/Story02.rpy:2721

translate spanish akt2chapter5_c958e27b:

    # h "(Fine, fine.)"
    h "(Bien, bien.)"

# game/Story02.rpy:2724

translate spanish akt2chapter5_298fe6e2:

    # k "Wow, you shut up real fast, Princess. But alright, have it your way."
    k "Cállate muy rápido, Princesa, pero bueno, tenlo a tu manera."

# game/Story02.rpy:2726

translate spanish akt2chapter5_198359f4:

    # k "And no, in case you were wondering — I’m not scared at all."
    k "Y no, por si te preguntaste, no tengo miedo."

# game/Story02.rpy:2729

translate spanish akt2chapter5_39384d51:

    # h "Once this is over, I’m kicking her ass."
    h "Una vez que esto termine, le estoy pateando el culo."

# game/Story02.rpy:2732

translate spanish akt2chapter5_fa45f281:

    # mc "Thanks..."
    mc "Gracias..."

# game/Story02.rpy:2734

translate spanish akt2chapter5_69346121:

    # mc "For not pushing it further."
    mc "Por no empujarlo más lejos."

# game/Story02.rpy:2736

translate spanish akt2chapter5_2fded262_3:

    # h "..."
    h "..."

# game/Story02.rpy:2739

translate spanish akt2chapter5_0d876ef3:

    # h "Oh, come on. {w=0.5}I just figured... maybe now isn’t the best time."
    h "Vamos. {w=0.5}Pensé... que quizás ahora no es el mejor momento."

# game/Story02.rpy:2740

translate spanish akt2chapter5_9b28f0cf:

    # h "Topic’s closed."
    h "La tema está cerrado."

# game/Story02.rpy:2744

translate spanish akt2chapter5_5e42086c:

    # mc "Alright, dear. {w=0.5}Whatever you say."
    mc "Muy bien, querida. {w=0.5}Lo que tú digas."

# game/Story02.rpy:2746

translate spanish akt2chapter5_eb5a0b7b:

    # mc "Just wanted to thank you — I know how hard that must’ve been for you."
    mc "Solo quería agradecerte — sé lo difícil que debe haber sido por ti."

# game/Story02.rpy:2750

translate spanish akt2chapter5_18e31cde:

    # h "Didn’t we agree you’d stop treating me like that?"
    h "¿No estamos de acuerdo en que dejarías de tratarme así?"

# game/Story02.rpy:2751

translate spanish akt2chapter5_c01ee753:

    # h "Or did Grandpa [mc] already forget?"
    h "O lo hizo el abuelo. [mc] ¿Ya lo olvidaste?"

# game/Story02.rpy:2753

translate spanish akt2chapter5_9c5add42:

    # mc "Doing my best."
    mc "Haciendo lo mejor que puedo."

# game/Story02.rpy:2755

translate spanish akt2chapter5_60466f27:

    # k "Are you two done? We’re on a schedule here."
    k "¿Terminaron? Estamos en un horario aquí."

# game/Story02.rpy:2764

translate spanish akt2chapter5_989989fc:

    # Mi "Well, here we are. But who knew we’d need access to get in..."
    Mi "Bueno, aquí estamos, pero quién sabía que necesitaríamos acceso para entrar..."

# game/Story02.rpy:2766

translate spanish akt2chapter5_433c93f4:

    # k "That girl... {w=0.5}Instead of doing her damn job and setting things up properly..."
    k "Esa chica... {w=0.5}En vez de hacer su maldito trabajo y arreglar las cosas correctamente..."

# game/Story02.rpy:2767

translate spanish akt2chapter5_58a70f37:

    # k "She’s probably sitting somewhere in the dark, laughing at us."
    k "Probablemente esté sentada en algún lugar de la oscuridad, riéndose de nosotros."

# game/Story02.rpy:2770

translate spanish akt2chapter5_04b0b455:

    # Mi "If we’d arrived on time, this wouldn’t have happened..."
    Mi "Si hubiéramos llegado a tiempo, esto no habría pasado..."

# game/Story02.rpy:2773

translate spanish akt2chapter5_a6bbc7b2:

    # k "Oh, sure, my fault some guy decided to interrogate us about some damn ‘entity’..."
    k "Claro, mi culpa, un tipo decidió interrogarnos sobre alguna maldita ‘entidad’..."

# game/Story02.rpy:2775

translate spanish akt2chapter5_ba103042:

    # h "Maybe if you hadn’t gotten into an argument. And waved your sword around like a lunatic to prove a point."
    h "Quizás si no hubieras tenido un argumento, y te agitaste la espada como un lunático para demostrar un punto."

# game/Story02.rpy:2778

translate spanish akt2chapter5_dded1b5f:

    # k "Oh yeah? And just let him spread rumors about us? Like our reputation wasn’t already in the gutter..."
    k "¿Y dejarle que divulgara rumores sobre nosotros? Como nuestra reputación no estaba ya en el canal..."

# game/Story02.rpy:2779

translate spanish akt2chapter5_924a0065:

    # k "Now we can add ‘crazy conspiracy bullshit’ to the list."
    k "Ahora podemos añadir \"maldición de conspiración loca\" a la lista."

# game/Story02.rpy:2780

translate spanish akt2chapter5_2303219f:

    # h "Bad press is still press, right?"
    h "La mala prensa sigue siendo prensa, ¿verdad?"

# game/Story02.rpy:2781

translate spanish akt2chapter5_1874b6bd:

    # k "Screw you..."
    k "Que te den..."

# game/Story02.rpy:2784

translate spanish akt2chapter5_e3f38bbc:

    # mc "(Starting to see why some people might prefer this place over the surface.)"
    mc "(Iniciando para ver por qué algunas personas podrían preferir este lugar sobre la superficie.)"

# game/Story02.rpy:2786

translate spanish akt2chapter5_65ee00b7:

    # mc "(Maybe the climate isn’t great, but... there’s something about it. Something... pulling.)"
    mc "(Quizá el clima no sea grande, pero... hay algo en ello. Algo... jalando.)"

# game/Story02.rpy:2788

translate spanish akt2chapter5_ae5f4275:

