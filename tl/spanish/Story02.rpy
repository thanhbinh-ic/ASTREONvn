    mc "¿Te duele?"

# game/Story02.rpy:2784

translate spanish akt2chapter4_d02f6d7a:

    # k "Cute."
    k "Qué lindo."

# game/Story02.rpy:2787

translate spanish akt2chapter4_1f4cd412:

    # k "Try worrying about yourself first."
    k "Trata de preocuparte por ti mismo primero."

# game/Story02.rpy:2790

translate spanish akt2chapter4_84ee1dea:

    # Mi "…Having fun?"
    Mi "...¿Te diviertes?"

