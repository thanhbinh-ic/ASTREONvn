translate spanish akt2chapter7_72187952:

    # mc "No matter how strong you are…"
    mc "No importa lo fuerte que seas..."

# game/Story02.rpy:4006

translate spanish akt2chapter7_04686350:

    # mc "One day, that weight’s gonna be {b}too much.{/b}"
    mc "Un día, ese peso va a ser {b}Demasiado.{/b}"

# game/Story02.rpy:4008

translate spanish akt2chapter7_084f7423:

    # mc "Without support… {w=0.5}people break."
    mc "Sin apoyo... {w=0.5}La gente se rompe."

# game/Story02.rpy:4009

translate spanish akt2chapter7_c9975670:

    # mc "I know that. {w=0.5}Too damn well."
    mc "Lo sé. {w=0.5}Demasiado bien."

