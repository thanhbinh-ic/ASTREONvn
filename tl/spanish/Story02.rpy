    # k "Hey, old man."
    k "Hola, viejo."

# game/Story02.rpy:2572

translate spanish akt2chapter4_f0d09db3:

    # k "Get over here."
    k "Ven aquí."

# game/Story02.rpy:2574

translate spanish akt2chapter4_632cd21a:

