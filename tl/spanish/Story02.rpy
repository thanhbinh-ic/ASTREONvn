    # mc "I need to get to Lora."
    mc "Necesito llegar a Lora."

# game/Story02.rpy:2525

translate spanish akt2chapter3_c2987c28:

    # mc "As fast as possible."
    mc "Tan rápido como sea posible."

# game/Story02.rpy:2527

