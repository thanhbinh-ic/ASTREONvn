translate spanish akt2chapter4_4e8967b5:

    # h "I really thought you’d—"
    h "Realmente pensé que lo harías..."

# game/Story02.rpy:2699

translate spanish akt2chapter4_3ada0761:

    # h "Die."
    h "Muere."

