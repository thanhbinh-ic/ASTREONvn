# game/Story02.rpy:3952
translate spanish akt2chapter5_5_20b4bb04:

    # Fl "(T-this idiot...)"
    Fl "(E-este idiota...)"

# game/Story02.rpy:3953
translate spanish akt2chapter5_5_159f8ad6:

    # Fl "(I almost came just from hearing that.)"
    Fl "(Casi me corro solo por oír eso.)"

# game/Story02.rpy:3954
translate spanish akt2chapter5_5_155cddfe:

    # Fl "(B-but...)"
    Fl "(P-pero...)"

# game/Story02.rpy:3955
translate spanish akt2chapter5_5_0f36b786:

