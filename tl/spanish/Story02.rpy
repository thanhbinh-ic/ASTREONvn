    mc "(Tranquilo... se siente apretado. Como si algo estuviera sentado en mi pecho.)"

# game/Story02.rpy:2761

translate spanish akt2chapter4_99d65f3d:

    # h "That’s the third time she’s saved our asses."
    h "Esa es la tercera vez que nos ha salvado el culo."

