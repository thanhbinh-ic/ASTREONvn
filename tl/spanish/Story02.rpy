translate spanish akt2chapter4_6fb1465c:

    # mc "Noted."
    mc "Anotado."

# game/Story02.rpy:2662

translate spanish akt2chapter4_bf1d3cc8:

    # Mi "Huh?!"
    Mi "¿Eh?"

