translate spanish akt2chapter4_cdc09862:

    # h "Please!"
    h "¡Por favor!"

# game/Story02.rpy:2638

translate spanish akt2chapter4_ff753c43:

    # mc "…I don’t stop."
    mc "...No paro."

# game/Story02.rpy:2643

translate spanish akt2chapter4_ca9f7917:

    # gggg "They didn’t mess around…"
    gggg "No se metieron en líos..."

# game/Story02.rpy:2646

translate spanish akt2chapter4_8de2d842:

    # gg "Just decided to level half the zone, huh…?"
    gg "Decidí nivelar la mitad de la zona, ¿eh?"

