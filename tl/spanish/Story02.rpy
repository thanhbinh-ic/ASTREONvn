translate spanish akt2chapter4_0be18a8b:

    # h "Just stood there like an idiot... {w=0.5}waiting to die."
    h "Solo estaba ahí como un idiota... {w=0.5}esperando a morir."

# game/Story02.rpy:2772

translate spanish akt2chapter4_c7bf6495:

    # mc "We’re all human."
    mc "Todos somos humanos."

# game/Story02.rpy:2774

translate spanish akt2chapter4_d5470623:

    # k "Making excuses, old man."
    k "Haciendo excusas, viejo."

# game/Story02.rpy:2776

translate spanish akt2chapter4_686abf87:

    # h "Morning, sunshine."
    h "Buenos días, sol."

# game/Story02.rpy:2777

translate spanish akt2chapter4_a6ff6069:

