    # Mi "…What did the teacher say?"
    Mi "¿Qué dijo el profesor?"

# game/Story02.rpy:2608

translate spanish akt2chapter4_112863a6:

    # k "Same thing you heard."
    k "Lo mismo que has oído."

# game/Story02.rpy:2609

translate spanish akt2chapter4_fbe3baa3:

    # k "I was told not to let him die."
    k "Me dijeron que no lo dejara morir."

# game/Story02.rpy:2612

