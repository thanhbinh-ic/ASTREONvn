translate spanish akt2chapter4_cc53e855:

    # k "Got room for one more."
    k "Tengo espacio para uno más."

# game/Story02.rpy:2792

translate spanish akt2chapter4_e904a7cd:

    # k "If you’re feeling brave."
    k "Si te sientes valiente."

# game/Story02.rpy:2794

