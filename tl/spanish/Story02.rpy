translate spanish akt2chapter4_e4f0a5c5:

    # mc "Liv—"
    mc "Liv..."

# game/Story02.rpy:2618

translate spanish akt2chapter4_ab7aef21:

    # h "That’s bullshit!"
    h "¡Eso es una mierda!"

