    # el "Yeah, yeah, I remember. Good girl, good girl."
    el "Sí, sí, lo recuerdo."

# game/Story02.rpy:4559

translate spanish mirielhome_a95b82e6:

    # mc "That girl… She’s not, by any chance…?"
    mc "Esa chica... ¿no es, por casualidad?"

# game/Story02.rpy:4561

translate spanish mirielhome_8760c2af:

    # Mi "Yes, she’s mute..."
    Mi "Sí, es muda..."

# game/Story02.rpy:4562

translate spanish mirielhome_fd6d01b6:

    # Mi "She’s had a rough life, but you know… {w}she shines brighter than anyone else here."
    Mi "Ha tenido una vida difícil, pero ya sabes... {w}brilla más que nadie aquí."

# game/Story02.rpy:4564

translate spanish mirielhome_ba980779:

    # el "Yeah, just those pills for now. No need for anything else."
    el "Sí, solo esas pastillas por ahora, sin necesidad de nada más."

# game/Story02.rpy:4565

translate spanish mirielhome_31e10d71:

    # mc "(For the first time, I see something peaceful in this place. {w}A quiet island in the middle of chaos…)"
    mc "(Por primera vez, veo algo pacífico en este lugar. {w}Una isla tranquila en medio del caos...)"

# game/Story02.rpy:4567

translate spanish mirielhome_3ed22bef:

    # mc "You know, Mi… {w}I can’t quite put it into words, but there’s something important about this place."
    mc "Sabes, Mi... {w}No puedo ponerlo en palabras, pero hay algo importante en este lugar."

# game/Story02.rpy:4570

translate spanish mirielhome_72ec4629:

    # mc "Something worth fighting for."
    mc "Algo que vale la pena luchar por eso."

# game/Story02.rpy:4580

translate spanish mirielhome_8adb613e:

    # a "So, you really brought him here after all."
    a "Así que, de verdad lo trajiste aquí después de todo."

# game/Story02.rpy:4582

translate spanish mirielhome_5b87c915:

    # Mi "He’s not like the others. {w}I’ve seen it myself."
    Mi "No es como los otros. {w}Lo he visto yo mismo."

# game/Story02.rpy:4583

translate spanish mirielhome_c316bcfc:

    # Mi "And I decided he needed to see this place… {w}Teacher."
    Mi "Y decidí que necesitaba ver este lugar... {w}Maestro."

# game/Story02.rpy:4585

translate spanish mirielhome_4f54860e:

    # y "I trust your judgment, Miriel. {w}But still, the opinion of others matters too."
    y "Confío en tu juicio, Miriel. {w}Pero aún así, la opinión de otros también importa."

# game/Story02.rpy:4586

translate spanish mirielhome_43371f5f:

    # y "What does the majority say?"
    y "¿Qué dice la mayoría?"

# game/Story02.rpy:4588

translate spanish mirielhome_41701403:

    # el "If Mi trusts him, then I don’t have a problem with him either."
    el "Si Mi confía en él, entonces yo tampoco tengo un problema con él."

# game/Story02.rpy:4590

translate spanish mirielhome_b9ccbf72:

    # ry "I don’t like seeing outsiders here, but..."
    ry "No me gusta ver a los extraños aquí, pero..."

# game/Story02.rpy:4592

translate spanish mirielhome_3dd75e1a:

    # ry "As long as he doesn’t cause trouble — he can stay."
    ry "Mientras no cause problemas, puede quedarse."

# game/Story02.rpy:4594

translate spanish mirielhome_0372604a_2:

    # zo "..."
    zo "..."

# game/Story02.rpy:4605

translate spanish mirielhome_98038160:

    # y "Then if that’s the decision of the majority… welcome."
    y "Entonces si esa es la decisión de la mayoría... bienvenido."

# game/Story02.rpy:4607

translate spanish mirielhome_7ee0fff6:

    # mc "Thanks? I guess."
    mc "Supongo."

# game/Story02.rpy:4608

translate spanish mirielhome_65ae80a0:

    # mc "So that means you… you’re real?"
    mc "¿Así que eso significa que eres real?"

# game/Story02.rpy:4610

translate spanish mirielhome_7aa114f8:

    # y "Would you prefer otherwise?"
    y "¿Preferirías otra cosa?"

# game/Story02.rpy:4612

translate spanish mirielhome_dab214d6:

    # mc "It’s just… people think you’re dead. Even I started doubting if any of this was real."
    mc "Es solo que... la gente piensa que estás muerto. Incluso empecé a dudar si algo de esto era real."

# game/Story02.rpy:4614

translate spanish mirielhome_46795030:

    # y "It’s much easier to work when people think you’re dead."
    y "Es mucho más fácil trabajar cuando la gente piensa que estás muerto."

# game/Story02.rpy:4615

translate spanish mirielhome_12b33ffc:

    # el "Since you’re here..."
    el "Ya que estás aquí..."

# game/Story02.rpy:4620

translate spanish mirielhome_c98558bd:

    # el "Alright, we’ll talk about this later. {w}You didn’t come all this way to hear philosophy, did you, Mi?"
    el "Muy bien, hablaremos de esto más tarde. {w}No viniste hasta aquí para escuchar filosofía, ¿verdad, Mi?"

# game/Story02.rpy:4624

translate spanish mirielhome_6fc44d7d:

    # el "And you, Ellie’s friend — you’re coming with us. You’ll want to see this."
    el "Y tú, el amigo de Ellie, vienes con nosotros. Quieres ver esto."

# game/Story02.rpy:4626

translate spanish mirielhome_14f38c94:

    # el "Trust me, you’re gonna lose your mind when you do."
    el "Confía en mí, vas a perder la cabeza cuando lo hagas."

# game/Story02.rpy:4628

translate spanish mirielhome_b5c746af:

    # el "You don’t have a problem with that, right?"
    el "No tienes ningún problema con eso, ¿verdad?"

# game/Story02.rpy:4630

translate spanish mirielhome_42eb5d73:

    # y "I do."
    y "Sí."

# game/Story02.rpy:4632

translate spanish mirielhome_122e963c:

    # y "Don’t drag outsiders into our affairs."
    y "No arrastres a los forasteros en nuestros asuntos."

# game/Story02.rpy:4634

translate spanish mirielhome_c79b5a11:

    # el "And what if this ‘outsider’ can help?"
    el "¿Y si este ‘extraño’ puede ayudar?"

# game/Story02.rpy:4635

translate spanish mirielhome_db2cdcb1:

    # el "You’re not planning to take on all those {b}monsters{/b} alone, are you?"
    el "No estás planeando tomar todos esos {b}monstruos{/b} ¿Estás solo?"

# game/Story02.rpy:4645

translate spanish mirielhome_97bea5c3:

    # Mi "...Is this what I think it is?"
    Mi "¿Es esto lo que creo que es?"

# game/Story02.rpy:4647

translate spanish mirielhome_10c10847:

    # el "Yeah. {w}Spreading through this planet’s veins."
    el "Sí. {w}Esparciendo por las venas de este planeta."

# game/Story02.rpy:4648

translate spanish mirielhome_7e0b5e1b:

    # el "How? {w}I wish I knew."
    el "¿Cómo? {w}Ojalá lo supiera."

# game/Story02.rpy:4650

translate spanish mirielhome_bb1d78b9:

    # el "And with every creature’s death, it only gets stronger."
    el "Y con la muerte de cada criatura, solo se fortalece."

# game/Story02.rpy:4652

translate spanish mirielhome_cb7d700e:

    # el "Looks like their bodies are... fertilizer for this {b}horror{/b}."
    el "Parece que sus cuerpos son... fertilizantes para esto {b}horror{/b}."

# game/Story02.rpy:4653

translate spanish mirielhome_2589242b:

    # el "Every time we kill them, the earth absorbs the miasma."
    el "Cada vez que los matamos, la tierra absorbe el miasma."

# game/Story02.rpy:4655

translate spanish mirielhome_57b56b3e:

    # el "And it’s slowly tearing our planet apart."
    el "Y está destrozando lentamente nuestro planeta."

# game/Story02.rpy:4659

translate spanish mirielhome_71a86863:

    # y "..."
    y "..."

# game/Story02.rpy:4661

translate spanish mirielhome_1f32cf0f:

    # mc "So we can’t kill them… But if we leave them alone, they’ll kill us."
    mc "Así que no podemos matarlos... pero si los dejamos solos, nos matarán."

# game/Story02.rpy:4662

translate spanish mirielhome_e91a719f:

    # mc "What kind of choice is that?"
    mc "¿Qué clase de elección es esa?"

# game/Story02.rpy:4664

translate spanish mirielhome_641d44a4:

    # mc "And where the hell did Astoria go? Did she really just abandon everyone?"
    mc "¿Y adónde diablos fue Astoria? ¿De verdad abandonó a todos?"

# game/Story02.rpy:4666

translate spanish mirielhome_71a86863_1:

    # y "..."
    y "..."

# game/Story02.rpy:4670

translate spanish mirielhome_8f2d57c4:

    # y "There’s always a way out. {w}But this time... {w}our hands are tied."
    y "Siempre hay una salida. {w}Pero esta vez... {w}nuestras manos están atadas."

# game/Story02.rpy:4674

translate spanish mirielhome_4b83c6cd:

    # y "The enemy is already among us."
    y "El enemigo ya está entre nosotros."

# game/Story02.rpy:4675

translate spanish mirielhome_1848d5e5:

    # y "An old friend could turn traitor."
    y "Un viejo amigo podría convertirse en traidor."

# game/Story02.rpy:4676

translate spanish mirielhome_cbeecc55:

    # y "One wrong step… and you’ll find a knife in your back."
    y "Un paso equivocado... y encontrarás un cuchillo en la espalda."

# game/Story02.rpy:4679

translate spanish mirielhome_65f2183c:

    # y "We thought we were in control. {w}Turns out we were just pawns."
    y "Pensamos que estábamos en control. {w}Resulta que éramos peones."

# game/Story02.rpy:4681

translate spanish mirielhome_8c136921:

    # mc "(Why is he talking like some kind of philosopher… {w}Is he hiding something?)"
    mc "(Por qué habla como un filósofo... {w}¿Está ocultando algo?)"

# game/Story02.rpy:4684

translate spanish mirielhome_6850f6ed:

    # y "They have a device capable of wiping this planet off the face of the galaxy."
    y "Tienen un dispositivo capaz de limpiar este planeta de la cara de la galaxia."

# game/Story02.rpy:4687

translate spanish mirielhome_2d5fcc54:

    # y "It’s hidden in the heart of the Tower. {w}As long as it remains active, we are powerless."
    y "Está escondido en el corazón de la Torre. {w}Mientras siga activo, somos impotentes."

# game/Story02.rpy:4688

translate spanish mirielhome_71a86863_2:

    # y "..."
    y "..."

# game/Story02.rpy:4699

translate spanish mirielhome_937d4118:

    # y "We don’t have much time. {w}They’re watching us."
    y "No tenemos mucho tiempo. {w}Nos están observando."

# game/Story02.rpy:4701

translate spanish mirielhome_24e3f301:

    # y "I’ve shifted us into a parallel stream. {w}No one can hear us here."
    y "He cambiado de corriente en paralelo. {w}Nadie puede oírnos aquí."

# game/Story02.rpy:4702

translate spanish mirielhome_0d038b82:

    # y "Right now, we’re outside of time, but not for long."
    y "Ahora mismo, estamos fuera de tiempo, pero no por mucho tiempo."

# game/Story02.rpy:4704

translate spanish mirielhome_74be248b:

    # y "No matter what it takes, you must go to the Tower. {w}Only you can disable the device."
    y "No importa lo que sea necesario, debes ir a la Torre. {w}Solo que puede deshabilitar el dispositivo."

# game/Story02.rpy:4706

translate spanish mirielhome_b20c612a:

    # y "I know how it sounds. {w}But we have no other choice."
    y "Sé cómo suena. {w}Pero no tenemos otra opción."

# game/Story02.rpy:4708

translate spanish mirielhome_4f46df0a:

    # y "And remember: {b}Origins are buried beneath lies… {w}But beyond the lies lies the truth.{/b}"
    y "Y recuerde: {b}Los orígenes están enterrados bajo mentiras... {w}Pero más allá de las mentiras está la verdad.{/b}"

# game/Story02.rpy:4717

translate spanish mirielhome_57cc50ce:

    # mc "(What… {w}What the hell just happened?…)"
    mc "(¿Qué? {w}¿Qué demonios acaba de pasar?...)"

# game/Story02.rpy:4718

translate spanish mirielhome_c6377470:

    # Mi "Forgive me, Teacher, but what exactly is this device?"
    Mi "Perdóneme, Maestro, pero ¿qué es exactamente este dispositivo?"

# game/Story02.rpy:4720

translate spanish mirielhome_6a8a4990:

    # y "Have you ever wondered why all the galactic councils are held here?"
    y "¿Alguna vez se ha preguntado por qué todos los consejos galácticos están aquí?"

# game/Story02.rpy:4721

translate spanish mirielhome_b4c06296:

    # Mi "Well… {w}Because it’s convenient? {w}We’re in the center of the galaxy, right?"
    Mi "Bueno... {w}¿Porque es conveniente? {w}Estamos en el centro de la galaxia, ¿verdad?"

# game/Story02.rpy:4722

translate spanish mirielhome_cb236948:

    # mc "(And… {w}They’re watching? {w}Could this be why Astoria disappeared?)"
    mc "(Y... {w}¿Están viendo? {w}¿Podría ser por eso que Astoria desapareció?)"

# game/Story02.rpy:4724

translate spanish mirielhome_b1b12943:

    # y "That’s just what they want us to believe."
    y "Eso es justo lo que quieren que creamos."

# game/Story02.rpy:4725

translate spanish mirielhome_5411cea4:

    # y "This planet is more than just a dot on the map."
    y "Este planeta es más que un punto en el mapa."

# game/Story02.rpy:4726

translate spanish mirielhome_8c449eb2:

    # y "It was built for a single purpose."
    y "Fue construido para un solo propósito."

# game/Story02.rpy:4727

translate spanish mirielhome_aee98b5f:

    # mc "(Ember said something similar… {w}If I remember correctly…)"
    mc "(Ember dijo algo similar... {w}Si recuerdo correctamente...)"

# game/Story02.rpy:4729

translate spanish mirielhome_d4556212:

    # mc "Is this connected to the tombs?"
    mc "¿Está conectado a las tumbas?"

# game/Story02.rpy:4731

translate spanish mirielhome_fff2d6da:

    # y "Yes."
    y "Sí."

# game/Story02.rpy:4732

translate spanish mirielhome_7c974c27:

    # mc "(The damn tombs again…)"
    mc "(Las malditas tumbas otra vez...)"

# game/Story02.rpy:4734

translate spanish mirielhome_aaf0ad68:

    # Mi "Teacher… That’s just a myth."
    Mi "Maestro... eso es solo un mito."

# game/Story02.rpy:4736

translate spanish mirielhome_ef5375d0:

    # Mi "There’s no credible information on the tombs! How can you be so sure?"
    Mi "No hay información creíble sobre las tumbas! ¿Cómo puedes estar tan seguro?"

# game/Story02.rpy:4738

translate spanish mirielhome_deda2f22:

    # y "Because we were the ones who hid the truth."
    y "Porque nosotros éramos los que ocultaban la verdad."

# game/Story02.rpy:4739

translate spanish mirielhome_d12df4db:

    # y "This entire planet is one massive tomb."
    y "Todo este planeta es una tumba masiva."

# game/Story02.rpy:4740

translate spanish mirielhome_9d9abe3f:

    # y "And the device in the Tower… is its key."
    y "Y el dispositivo en la Torre... es su llave."

# game/Story02.rpy:4741

translate spanish mirielhome_afa6a7d1:

    # mc "(By {b}the Tower{/b}, does he mean… {w}the main headquarters?)"
    mc "(By {b}la Torre{/b}¿Quiere decir... {w}¿el cuartel general principal?)"

# game/Story02.rpy:4743

translate spanish mirielhome_5f8e1e53:

    # Mi "Teacher… {w}Are you saying this planet… {w}is artificial?"
    Mi "Maestro... {w}¿Estás diciendo que este planeta... {w}¿Es artificial?"

# game/Story02.rpy:4745

translate spanish mirielhome_82e075be:

    # y "I’m saying that if the device is activated… {w}it will become our grave."
    y "Estoy diciendo que si el dispositivo está activado... {w}se convertirá en nuestra tumba."

# game/Story02.rpy:4746

translate spanish mirielhome_4a04642f:

    # mc "(A mole in headquarters… {w}A device capable of erasing all life… {w}And a tomb…)"
    mc "(Un topo en el cuartel general... {w}Un dispositivo capaz de borrar toda la vida... {w}Y una tumba...)"

# game/Story02.rpy:4748

translate spanish mirielhome_e73320dc:

    # mc "Miriel… {w}We’re leaving. {w}Now."
    mc "Miriel... {w}Nos vamos. {w}Ahora."

# game/Story02.rpy:4754

translate spanish mirielhome_71a86863_3:

    # y "..."
    y "..."

# game/Story02.rpy:4755

translate spanish mirielhome_6e65b115:

    # aa "The bait is set. {w}Now, we just wait."
    aa "El cebo está listo. {w}Ahora, solo esperamos."

# game/Story02.rpy:4757

translate spanish mirielhome_1db65d25:

    # aa "So this is the young man your mistress had such high hopes for?"
    aa "¿Así que este es el joven que su amante tenía esperanzas tan altas?"

# game/Story02.rpy:4758

translate spanish mirielhome_8bcfd91f:

    # aa "Looks like she’s not as sharp as she used to be."
    aa "Parece que no está tan afilada como solía ser."

# game/Story02.rpy:4760

translate spanish mirielhome_c8ad6d18:

    # y "Don’t you dare speak her name with that filthy mouth of yours."
    y "No te atrevas a hablar su nombre con esa sucia boca tuya."

# game/Story02.rpy:4761

translate spanish mirielhome_4b624790:

    # aa "..."
    aa "..."

# game/Story02.rpy:4763

translate spanish mirielhome_2b7ff1db:

    # aa "We decide who lives and who disappears without a trace."
    aa "Decidimos quién vive y quién desaparece sin rastro."

# game/Story02.rpy:4764

translate spanish mirielhome_294aa7c4:

    # aa "So don’t do anything stupid. {w}You understand me?"
    aa "Así que no hagas nada estúpido. {w}¿Me entiendes?"

# game/Story02.rpy:4766

translate spanish mirielhome_71a86863_4:

    # y "..."
    y "..."

# game/Story02.rpy:4776

translate spanish mirielhome_309ce776:

    # el "Not the best first impression, huh? {w}Sorry about that."
    el "No es la mejor primera impresión, ¿eh? {w}Lo siento."

# game/Story02.rpy:4777

translate spanish mirielhome_c37feceb:

    # el "If you had come a few days earlier, we would’ve thrown you a real party."
    el "Si hubieras venido unos días antes, te habríamos lanzado una fiesta real."

# game/Story02.rpy:4780

translate spanish mirielhome_4d480cf8:

    # el "But it is what it is. {w}By the way, Mi, you should drop by more often."
    el "Pero es lo que es. {w}Por cierto, Mi, deberías pasar más seguido."

# game/Story02.rpy:4781

translate spanish mirielhome_106eb5db:

    # el "I get it — work, responsibilities… {w}But family matters too, doesn’t it?"
    el "Lo entiendo, trabajo, responsabilidades... {w}Pero la familia también importa, ¿no?"

# game/Story02.rpy:4784

translate spanish mirielhome_ea6bdbf3:

    # el "You have no idea how important it is to just escape the routine sometimes. {w}To forget everything and throw a party."
    el "No tienes idea de lo importante que es escapar de la rutina a veces. {w}Olvidar todo y hacer una fiesta."

# game/Story02.rpy:4787

translate spanish mirielhome_fc01e5f3:

    # el "So no matter what happens, make sure you both come ba—"
    el "Así que no importa lo que pase, asegúrate de que ambos vengan ba..."

# game/Story02.rpy:4791

translate spanish mirielhome_fff62963:

    # Mi "Don’t worry. {w}We’ll definitely be back."
    Mi "No te preocupes. {w}Definitivamente volveremos."

# game/Story02.rpy:4792

translate spanish mirielhome_6b0af959:

    # Mi "Keep an eye on everyone, okay? {w}And we... {w}we’ll handle this."
    Mi "Vigila a todos, ¿de acuerdo? {w}Y nosotros... {w}nos encargaremos de esto."

# game/Story02.rpy:4795

translate spanish mirielhome_167a02d3:

    # Mi "And Ela… {w}Stop drinking."
    Mi "Y Ela... {w}Deja de beber."

# game/Story02.rpy:4796

translate spanish mirielhome_97f81242:

    # Mi "You know how it affects you."
    Mi "Sabes cómo te afecta."

# game/Story02.rpy:4798

translate spanish mirielhome_a959dbab:

    # Mi "Take care of each other."
    Mi "Cuídate."

# game/Story02.rpy:4802

translate spanish mirielhome_e7dba502:

    # mc "Thank you for the hospitality."
    mc "Gracias por la hospitalidad."

# game/Story02.rpy:4806

translate spanish mirielhome_a68e5727:

    # el "Oh, come on, [mc]. {w}We always welcome new faces, especially if Mi brings them."
    el "Vamos, [mc]. {w}Siempre damos la bienvenida a nuevas caras, especialmente si Mi las trae."

# game/Story02.rpy:4807

translate spanish mirielhome_3d7dfaee:

    # el "And, you know… {w}Thanks for looking after her."
    el "Y, ya sabes... {w}Gracias por cuidarla."

# game/Story02.rpy:4809

translate spanish mirielhome_6a1d8191:

    # mc "Honestly, it’s more like she’s the one looking after me."
    mc "Sinceramente, es más como si ella fuera la que me cuida."

# game/Story02.rpy:4813

translate spanish mirielhome_63ab5f8a:

    # el "Maybe so… {w}But still…"
    el "Tal vez así... {w}Pero aún así..."

# game/Story02.rpy:4817

translate spanish mirielhome_c77d8e62:

    # el "She brought you here. {w}And Mi doesn’t do that without a reason."
    el "Ella te trajo aquí. {w}Y Mi no hace eso sin una razón."

# game/Story02.rpy:4821

translate spanish mirielhome_cb4526e2:

    # el "I hope we meet again, [mc]..."
    el "Espero que nos encontremos de nuevo, [mc]..."

# game/Story02.rpy:4833

translate spanish akt2chapter8_cf718975:

    # mc "(Things just keep getting more and more complicated… And how the hell am I supposed to explain that...)"
    mc "(Las cosas siguen siendo cada vez más complicadas... y cómo diablos se supone que debo explicar eso...)"

# game/Story02.rpy:4836

translate spanish akt2chapter8_5d70fe87:

    # h "[mc]! YOU HEAR ME?!"
    h "[mc]¡Me oyes!"

# game/Story02.rpy:4839

translate spanish akt2chapter8_7191c391:

    # mc "Olivia? That was unexpected. Did something happen?"
    mc "Olivia, eso fue inesperado. ¿Ha pasado algo?"

# game/Story02.rpy:4842

translate spanish akt2chapter8_71cb6ada:

    # h "YES, SHE’S…"
    h "Sí, ella es..."

# game/Story02.rpy:4843

translate spanish akt2chapter8_5b8c0ff0:

    # h "SHE’S…"
    h "Ella es..."

# game/Story02.rpy:4844

translate spanish akt2chapter8_d2bc3964:

    # h "ALIVE!"
    h "¡Viva!"

# game/Story02.rpy:4847

translate spanish akt2chapter8_e6d35091:

    # mc "Wait, are you crying?"
    mc "Espera, ¿estás llorando?"

# game/Story02.rpy:4848

translate spanish akt2chapter8_40c91265:

    # mc "Hold on, hold on, who are you even talking about? I don’t understand…"
    mc "Espera, espera, ¿de quién estás hablando? No entiendo..."

# game/Story02.rpy:4851

translate spanish akt2chapter8_3350e30a:

    # h "I…"
    h "Yo..."

# game/Story02.rpy:4852

translate spanish akt2chapter8_c4748376:

    # k "Give me that, I’ll explain it properly."
    k "Dame eso, te lo explicaré correctamente."

# game/Story02.rpy:4855

translate spanish akt2chapter8_65c06f52:

    # mc "Kalestra? What’s going on over there?"
    mc "¿Qué está pasando ahí?"

# game/Story02.rpy:4858

translate spanish akt2chapter8_e8f8a30f:

    # k "Oh, nothing much, just your wife showing up in the flesh."
    k "Nada, solo tu esposa apareciendo en la carne."

# game/Story02.rpy:4860

translate spanish akt2chapter8_47ed3728:

    # k "Caused quite a scene, but hey, why didn’t you—"
    k "Se encontró una escena, pero oye, ¿por qué no lo hiciste?"

# game/Story02.rpy:4863

translate spanish akt2chapter8_1704a47b:

    # mc "(This…)"
    mc "(Este...)"

# game/Story02.rpy:4874

translate spanish akt2chapter8_c1fe3d7f:

    # mc "LORA!"
    mc "¡LoRA!"

# game/Story02.rpy:4881

translate spanish akt2chapter8_9993b94e:

    # L "..."
    L "..."

# game/Story02.rpy:4883

translate spanish akt2chapter8_228dbdac:

    # L "It’s been a long time, darling…"
    L "Ha pasado mucho tiempo, querida..."

translate spanish akt2chapter7_69765efa:

    # mc "No. Sorry, but... I can't. At least, not right now."
    mc "No, lo siento, pero... no puedo, al menos ahora no."
