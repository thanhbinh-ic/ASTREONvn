translate spanish akt2chapter4_72aa2aea:

    # h "I just froze."
    h "Solo me he congelado."

# game/Story02.rpy:2769

translate spanish akt2chapter4_608f8897:

    # h "Legs wouldn’t move. Voice shaking."
    h "Las piernas no se moverían. Temblor de voz."

