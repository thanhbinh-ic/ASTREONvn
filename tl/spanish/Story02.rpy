translate spanish akt2chapter4_7bdfbcc7:

    # mc "...Enough."
    mc "...Basta."

# game/Story02.rpy:2694

translate spanish akt2chapter4_6751fdbd:

    # mc "(…not now.)"
    mc "(...no ahora)."

