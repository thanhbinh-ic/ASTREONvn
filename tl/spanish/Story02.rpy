translate spanish akt2chapter5_b81c212c:

    # Mi "Where’s Winter?"
    Mi "¿Dónde está Winter?"

# game/Story02.rpy:2928

translate spanish akt2chapter5_cee34e4c:

    # aS "..."
    aS "..."

