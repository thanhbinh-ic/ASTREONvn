    # h "You can barely sit up…"
    h "Apenas puedes sentarte..."

# game/Story02.rpy:2528

translate spanish akt2chapter3_485237e2:

    # h "Do you even hear yourself right now?"
    h "¿Te has oído ahora mismo?"

# game/Story02.rpy:2530

translate spanish akt2chapter3_afa69745:

    # mc "You got a better option?"
    mc "¿Tienes una mejor opción?"

# game/Story02.rpy:2532

translate spanish akt2chapter3_480890f2:

    # mc "I’ll manage."
    mc "Yo me las arreglaré."

# game/Story02.rpy:2540

translate spanish akt2chapter3_a4a75624_1:

    # h "Fine."
    h "Bien."

# game/Story02.rpy:2544

translate spanish akt2chapter3_f8d4f541:

    # mc "Then let’s—"
    mc "Entonces vamos a..."

# game/Story02.rpy:2546

