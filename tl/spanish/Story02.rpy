    o "Nos quedamos."

# game/Story02.rpy:2513

translate spanish akt2chapter3_f26accc3:

    # o "As long as it takes."
    o "Mientras sea necesario."

# game/Story02.rpy:2514

translate spanish akt2chapter3_997ebcb2:

    # o "We do not leave our own behind."
    o "No dejamos atrás a los nuestros."

# game/Story02.rpy:2517

translate spanish akt2chapter3_f7c48bd8:

    # g "Commander… We need to choose."
    g "Comandante... tenemos que elegir."

# game/Story02.rpy:2518

translate spanish akt2chapter3_da5fc2e4:

    # g "Either we stay here and risk it… Or we move forward."
    g "O nos quedamos aquí y arriesgamos... o avanzamos."

# game/Story02.rpy:2520

translate spanish akt2chapter3_4408dea2:

    # mc "*heavy breathing*"
    mc "*Respiración pesada*"

# game/Story02.rpy:2521

translate spanish akt2chapter3_1ff7ce3a:

    # mc "…I’m going."
    mc "...yo voy."

# game/Story02.rpy:2522

translate spanish akt2chapter3_98e11b17:

    # mc "We can move out…"
    mc "Podemos salir..."

