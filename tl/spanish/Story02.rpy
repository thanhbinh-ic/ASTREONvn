translate spanish akt2chapter4_a5015c42:

    # k "We’re already inside."
    k "Ya estamos dentro."

# game/Story02.rpy:2586

translate spanish akt2chapter4_c65e8fb1:

    # h "Yeah, no thanks."
    h "Sí, no gracias."

# game/Story02.rpy:2589

