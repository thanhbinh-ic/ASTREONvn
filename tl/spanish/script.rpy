    h "Vamos, ¡solo ya baja!"

# game/script.rpy:4184

translate spanish jungle_0ee062c1:
    # mc "Still on us?"
    mc "¿Todavía estamos con nosotros?"

# game/script.rpy:4186

translate spanish jungle_9f5c960c:
    # h "We’ve gone pretty far."
    h "Hemos ido bastante lejos."

# game/script.rpy:4187

translate spanish jungle_29816939:
    # h "If someone was still on us, we’d know by now."
    h "Si alguien todavía estuviera en nosotros, lo sabríamos ahora."

# game/script.rpy:4189

translate spanish jungle_a9851615:
    # h "But here’s what bugs me…"
    h "Pero esto es lo que me molesta..."

# game/script.rpy:4190

translate spanish jungle_05882eef:
    # h "Why us?"
    h "¿Por qué nosotros?"

# game/script.rpy:4191

translate spanish jungle_61ee3dc3:
    # h "Who the hell wants us dead this badly?"
    h "¿Quién demonios quiere que estemos muertos?"

# game/script.rpy:4194

translate spanish jungle_027b09ef:
    # h "...Yeah. Thought so."
    h "- Sí, eso pensé."

# game/script.rpy:4196

translate spanish jungle_431d2e38:
    # N "You know who it was, Dad?"
    N "¿Sabes quién era, papá?"

# game/script.rpy:4198

translate spanish jungle_ab08fc7c:
    # mc "Azarkhan’s people."
    mc "La gente de Azarkhan."

# game/script.rpy:4199

translate spanish jungle_67176192:
    # mc "Too familiar."
    mc "Demasiado familiar."

# game/script.rpy:4201

translate spanish jungle_df83823e:
    # mc "If it’s them…"
    mc "Si son ellos..."

# game/script.rpy:4202

translate spanish jungle_bc26c965:
    # mc "We’re on the right track."
    mc "Estamos en la pista correcta."

# game/script.rpy:4204

translate spanish jungle_b1683f59:
    # h "Seriously though…"
    h "En serio, sin embargo..."

# game/script.rpy:4205

translate spanish jungle_4ce0af49:
    # h "What kind of world is this now?"
    h "¿Qué clase de mundo es este ahora?"

# game/script.rpy:4206

translate spanish jungle_00e0c5b2:
    # h "Dead men just… getting back up like nothing happened?"
    h "Hombres muertos... ¿volviendo a levantarse como si nada pasara?"

# game/script.rpy:4208

translate spanish jungle_da856d69:
    # h "First Azarkhan."
    h "Primero Azarkhan."

# game/script.rpy:4209

translate spanish jungle_d18cc182:
    # h "Now his crew, all supposedly dead, and yet here they are."
    h "Ahora su tripulación, supuestamente muerta, y sin embargo aquí están."

# game/script.rpy:4210

translate spanish jungle_7af84186:
    # h "What’s next, huh?"
    h "¿Qué sigue, eh?"

# game/script.rpy:4211

translate spanish jungle_9c684cd7:
    # h "Ghosts with guns?"
    h "¿Fantasmas con armas?"

# game/script.rpy:4213

translate spanish jungle_b555e454:
    # mc "You said you needed a break."
    mc "Dijiste que necesitabas un descanso."

# game/script.rpy:4214

translate spanish jungle_7b530492:
    # mc "This is it."
    mc "Esto es todo."

# game/script.rpy:4216

translate spanish jungle_f780d94f:
    # h "Oh yeah. Amazing."
    h "Oh, sí, increíble."

# game/script.rpy:4217

translate spanish jungle_037a6cd5:
    # h "Exactly the kind of vacation I was dreaming about."
    h "Exactamente el tipo de vacaciones que soñaba con."

# game/script.rpy:4223

translate spanish jungle_35550527:
    # mc "Norman. Map."
    mc "Norman, mapa."

# game/script.rpy:4225

translate spanish jungle_b6286e70:
    # N "Hold on, Dad, I need to lock in our position."
    N "Espera, papá, necesito cerrar nuestra posición."

# game/script.rpy:4226

translate spanish jungle_058ec645:
    # N "…and let them know we’re almost there."
    N "...y hacerles saber que casi estamos allí."

# game/script.rpy:4227

translate spanish jungle_1ef706f6:
    # mc "Who?"
    mc "¿Quién?"

# game/script.rpy:4228

translate spanish jungle_6bc189c3:
    # N "My supervisor. She’s… good people."
    N "Mi supervisora. Ella es... buena gente."

# game/script.rpy:4231

translate spanish jungle_016dd687:
    # N "Take the first left up ahead."
    N "Tome la primera izquierda por delante."

# game/script.rpy:4233

translate spanish jungle_c3700a77:
    # N "If the map's correct, that’s our fastest route."
    N "Si el mapa es correcto, es la manera más rápida."

# game/script.rpy:4235

translate spanish jungle_e74b3405:
    # N "Give it about an hour, we should be there."
    N "Dale una hora, deberíamos estar allí."

# game/script.rpy:4246

translate spanish jungle_548dedb9:
    # mc "That’s as far as we go."
    mc "Eso es lo que vamos."

# game/script.rpy:4247

translate spanish jungle_1861ed43:
    # mc "From here on, we walk."
    mc "Desde aquí en adelante, caminamos."

# game/script.rpy:4248

translate spanish jungle_4981463c:
    # mc "Norman, how far to the lab?"
    mc "Norman, ¿qué tan lejos hasta el laboratorio?"

# game/script.rpy:4251

translate spanish jungle_7cf1923a:
    # mc "Norman?"
    mc "¿Norman?"

# game/script.rpy:4253

translate spanish jungle_11f86aaa:
    # N "We’ve got a problem, Dad. GPS is dead."
    N "Tenemos un problema, papá. El GPS está muerto."

# game/script.rpy:4254

translate spanish jungle_2fc725b9:
    # N "Something’s jamming the signal."
    N "Algo está atascando la señal."

# game/script.rpy:4256

translate spanish jungle_e191a532:
    # mc "How bad?"
    mc "¿Qué tan malo?"

# game/script.rpy:4258

translate spanish jungle_79a88624:
    # N "Not ideal… but not critical."
    N "No es ideal... pero no crítico."

# game/script.rpy:4259

translate spanish jungle_f5c72e1f:
    # N "We need open ground, once we’ve got that, I can navigate off the map."
    N "Necesitamos un terreno abierto, una vez que lo tengamos, puedo navegar por el mapa."

# game/script.rpy:4261

translate spanish jungle_d4540d79:
    # h "Wait, hold on—"
    h "Espera, espera..."

# game/script.rpy:4262

translate spanish jungle_e77ce4fa:
    # h "Are you telling me we’re lost?"
    h "¿Me estás diciendo que estamos perdidos?"

# game/script.rpy:4263

translate spanish jungle_1eebc258:
    # mc "Plans changed."
    mc "Los planes cambiaron."

# game/script.rpy:4264

translate spanish jungle_cb717e89:
    # mc "Had to make sure we weren’t being followed."
    mc "Tenía que asegurarse de que no nos seguían."

# game/script.rpy:4265

translate spanish jungle_62d40295:
    # h "Oh, great. Fantastic."
    h "Genial, fantástico."

# game/script.rpy:4266

translate spanish jungle_4a5c8a3b:
    # h "So you {b}do{/b} know where we’re going… right?"
    h "Así que tú {b}do{/b} Sabes a dónde vamos... ¿verdad?"

# game/script.rpy:4270

translate spanish jungle_f9981629:
    # N "We’re not lost. Dad logged the coordinates."
    N "No estamos perdidos. Papá ha registrado las coordenadas."

# game/script.rpy:4271

translate spanish jungle_9b1924a9:
    # N "This just makes things… a bit messier."
    N "Esto hace que las cosas... sean un poco más desordenadas."

# game/script.rpy:4273

translate spanish jungle_e6b416ba:
    # h "No, no... hang on."
    h "No, no... espera."

# game/script.rpy:4274

translate spanish jungle_52ae9db8:
    # h "I wasn’t asking you."
    h "No te estaba preguntando."

# game/script.rpy:4275

translate spanish jungle_c3fd9c22:
    # h "[mc]."
    h "[mc]."

# game/script.rpy:4276

translate spanish jungle_f4fbb626:
    # h "Two things."
    h "Dos cosas."

# game/script.rpy:4277

translate spanish jungle_66014d67:
    # h "Target."
    h "Meta."

# game/script.rpy:4278

translate spanish jungle_3a2cbd7d:
    # h "And motive."
    h "Y el motivo."

# game/script.rpy:4280

translate spanish jungle_2c037559:
    # mc "I gave you a reason back at the bar."
    mc "Te di una razón en el bar."

# game/script.rpy:4282

translate spanish jungle_78dfa234:
    # h "Let me paint you a picture."
    h "Déjame pintarte la escena."

# game/script.rpy:4283

translate spanish jungle_09a52859:
    # h "You’re in your bar."
    h "Estás en tu bar."

# game/script.rpy:4284

translate spanish jungle_d3c5319f:
    # h "Someone walks in."
    h "Alguien entra."

# game/script.rpy:4285

translate spanish jungle_ac722036:
    # h "Haven’t seen them in eight years."
    h "No los he visto en ocho años."

# game/script.rpy:4286

translate spanish jungle_e752061c:
    # h "And suddenly they’re asking for help."
    h "Y de repente están pidiendo ayuda."

# game/script.rpy:4287

translate spanish jungle_d5d6b8b9:
    # h "I’m not asking for much."
    h "No estoy pidiendo mucho."

# game/script.rpy:4288

translate spanish jungle_2ace915a:
    # h "Just don’t lie to me."
    h "No me mientas."

# game/script.rpy:4290

translate spanish jungle_19baf393:
    # mc "You really want to hear it?"
    mc "¿De verdad quieres oírlo?"

# game/script.rpy:4292

translate spanish jungle_0fb922e6:
    # h "I’m already here."
    h "Ya estoy aquí."

# game/script.rpy:4293

translate spanish jungle_b92a392d:
    # h "Bit late to hesitate now."
    h "Un poco tarde para dudar ahora."

# game/script.rpy:4299

translate spanish jungle_c9fe3339:
    # mc "Alright… simple version."
    mc "Bien... versión simple."

# game/script.rpy:4301

translate spanish jungle_ab995604:
    # mc "Teleportation."
    mc "Teleportación."

# game/script.rpy:4303

translate spanish jungle_05595850:
    # h "...You’ve gotta be kidding me."
    h "...Tienes que estar bromeando."

# game/script.rpy:4304

translate spanish jungle_d7608ad8:
    # h "Or what, you finally lost your mind?"
    h "¿O qué, finalmente perdiste la mente?"

# game/script.rpy:4305

translate spanish jungle_2b35b6fe_1:
    # mc "..."
    mc "..."

# game/script.rpy:4310

translate spanish jungle_26f9ce20:
    # mc "Even with the facts…"
    mc "Incluso con los hechos..."

# game/script.rpy:4311

translate spanish jungle_05bdf747:
    # mc "I’m still not sure I believe it myself."
    mc "Todavía no estoy seguro de que lo crea yo mismo."

# game/script.rpy:4313

translate spanish jungle_d7db851c:
    # h "You know what? Fine."
    h "¿Sabes qué?"

# game/script.rpy:4314

translate spanish jungle_e7f70801:
    # h "Don’t wanna talk? Don’t."
    h "¿No quieres hablar?"

# game/script.rpy:4315

translate spanish jungle_3956c4b6:
    # h "(muttering) Figures… only known each other, what, twenty-five years…"
    h "Figuras... solo se conocían, qué, veinticinco años..."

# game/script.rpy:4319

translate spanish jungle_b8f81952:
    # mc "Olivia."
    mc "Olivia."

# game/script.rpy:4320

translate spanish jungle_1abb6545:
    # mc "If I’m wrong about this…"
    mc "Si me equivoco con esto..."

# game/script.rpy:4321

translate spanish jungle_5fd2f2e9:
    # mc "You get a wish."
    mc "Tienes un deseo."

# game/script.rpy:4323

translate spanish jungle_9f9aa8b1:
    # h "Another one?"
    h "¿Otro?"

# game/script.rpy:4324

translate spanish jungle_2fbe4877:
    # h "Wow. You’re really feeling generous today."
    h "Vaya. Te sientes muy generoso hoy."

# game/script.rpy:4326

translate spanish jungle_7e467c9b:
    # h "Relax. I walked into this myself."
    h "Relájate, me metí en esto yo mismo."

# game/script.rpy:4327

translate spanish jungle_51bb8785:
    # h "And…"
    h "Y..."

# game/script.rpy:4328

translate spanish jungle_f56ff857:
    # h "Yeah, this place is kinda beautiful."
    h "Sí, este lugar es un poco hermoso."

# game/script.rpy:4329

translate spanish jungle_7a704b80:
    # h "You look at those trees and almost forget—"
    h "Mira esos árboles y casi olvida..."

# game/script.rpy:4330

translate spanish jungle_bdf6502a:
    # h "That forty minutes ago, some psychos were trying to kill us."
    h "Que hace cuarenta minutos, algunos psicópatas intentaban matarnos."

# game/script.rpy:4332

translate spanish jungle_49014fd7:
    # mc "Didn’t take you for the nature type."
    mc "No te tomó por el tipo de naturaleza."

# game/script.rpy:4334

translate spanish jungle_730b8b8b:
    # h "Excuse me?"
    h "¿Disculpe?"

# game/script.rpy:4335

translate spanish jungle_7e533695:
    # h "You got a problem with that?"
    h "¿Tienes algún problema con eso?"

# game/script.rpy:4337

translate spanish jungle_04cd4a35:
    # mc "You’re different when you look at this stuff."
    mc "Eres diferente cuando miras estas cosas."

# game/script.rpy:4338

translate spanish jungle_937d07f5:
    # mc "In a good way."
    mc "De una manera buena."

# game/script.rpy:4341

translate spanish jungle_d30fadbc:
    # h "Wow."
    h "Vaya."

# game/script.rpy:4342

translate spanish jungle_2d59c3a3:
    # h "And what did I do to earn that, huh?"
    h "¿Y qué hice para ganar eso?"

# game/script.rpy:4343

translate spanish jungle_2d908e97:
    # h "...Thanks."
    h "Gracias."

# game/script.rpy:4345

translate spanish jungle_e615c6a6:
    # mc "Norman. Status."
    mc "Norman. Informe."

# game/script.rpy:4348

translate spanish jungle_4f997413:
    # N "No luck reaching my handler."
    N "No consigo comunicarme con mi enlace operativo."

# game/script.rpy:4350

translate spanish jungle_1408e3e4:
    # N "I’ve tried, no response."
    N "Lo intenté. No hay respuesta."

# game/script.rpy:4352

translate spanish jungle_fda9d8ee:
    # mc "Before she disappeared… your mother made a few calls from work."
    mc "Antes de desaparecer... tu madre hizo algunas llamadas desde el trabajo."

# game/script.rpy:4353

translate spanish jungle_098ae161:
    # mc "Didn’t know the details."
    mc "No conocía los detalles."

# game/script.rpy:4354

translate spanish jungle_3594c294:
    # mc "But the signal was the same."
    mc "Pero la señal era la misma."

# game/script.rpy:4355

translate spanish jungle_857e3e82:
    # mc "Dead."
    mc "Muerta."

# game/script.rpy:4357

translate spanish jungle_4112597f:
    # N "Yeah… but we thought we fixed that."
    N "Sí... pero creíamos que lo habíamos arreglado."

# game/script.rpy:4359

translate spanish jungle_ed71b73d:
    # mc "Guess not."
    mc "Parece que no."

# game/script.rpy:4360

translate spanish jungle_7cf1923a_1:
    # mc "Norman?"
    mc "¿Norman?"

# game/script.rpy:4365

translate spanish jungle_3d826554:
    # N "…What’s this?"
    N "...¿Qué es esto?"

# game/script.rpy:4367

translate spanish jungle_9ff43c05:
    # mc "Your protection."
    mc "Tu protección."

# game/script.rpy:4368

translate spanish jungle_c36e8603:
    # mc "And a promise I made to Alexa."
    mc "Y una promesa que le hice a Alexa."

# game/script.rpy:4369

translate spanish jungle_c17ca67b:
    # mc "Now go get changed."
    mc "Ahora ve a cambiarte."

# game/script.rpy:4371

translate spanish jungle_4d275639:
    # N "But the signal—"
    N "Pero la señal..."

# game/script.rpy:4372

translate spanish jungle_0a8aa971:
    # mc "Take a breather."
    mc "Respira."

# game/script.rpy:4373

translate spanish jungle_88dcfc45:
    # mc "You’re wound too tight."
    mc "Estás muy apretado."

# game/script.rpy:4374

translate spanish jungle_b5c321df:
    # N "…Alright."
    N "...de acuerdo."

# game/script.rpy:4379

translate spanish jungle_45189c64:
    # mc "What do you think of him?"
    mc "¿Qué piensas de él?"

# game/script.rpy:4382

translate spanish jungle_67af5045:
    # h "If things go loud?"
    h "¿Si las cosas se ponen fuerte?"

# game/script.rpy:4383

translate spanish jungle_eaab07e8:
    # h "He would be the first one to die"
    h "Él sería el primero en morir"

# game/script.rpy:4385

translate spanish jungle_236b0ca5:
    # h "Why’d you even bring him?"
    h "¿Por qué lo trajiste?"

# game/script.rpy:4387

translate spanish jungle_4415f200:
    # mc "Tried to talk him out of it."
    mc "Traté de hablar con él."

# game/script.rpy:4388

translate spanish jungle_23683aec:
    # mc "Didn’t work."
    mc "No funcionó."

# game/script.rpy:4392

translate spanish jungle_34a01b78:
    # h "Figures."
    h "Figuras."

# game/script.rpy:4393

translate spanish jungle_e0002ad0:
    # h "Stubborn, just like you, huh?"
    h "Stubborn, igual que tú, ¿eh?"

# game/script.rpy:4394

translate spanish jungle_4338d359:
    # h "Still… if he stays in the back he might actually make it."
    h "Si se queda atrás, podría hacerlo."

# game/script.rpy:4397

translate spanish jungle_ad17a2a5:
    # N "Bit oversized… but yeah, solid."
    N "Un poco de sobredimensionado... pero sí, sólido."

# game/script.rpy:4398

translate spanish jungle_44dbbf19:
    # N "Feels reliable."
    N "Se siente confiable."

# game/script.rpy:4400

translate spanish jungle_3486baab:
    # h "Hey, kid."
    h "Hola, chico."

# game/script.rpy:4401

translate spanish jungle_787ca900:
    # h "That vest? Doesn’t make you bulletproof."
    h "¿Ese chaleco? No te hace a prueba de balas."

# game/script.rpy:4402

translate spanish jungle_3a975633:
    # h "Shots fired? You hit the ground and stay there."
    h "¿Los disparos?"

# game/script.rpy:4403

translate spanish jungle_a4231084:
    # h "Don’t be dead weight."
    h "No tengas peso muerto."

# game/script.rpy:4405

translate spanish jungle_1db4077f:
    # N "…Got it."
    N "...Lo tengo."

# game/script.rpy:4408

translate spanish jungle_4350c951:
    # mc "We’ll need him."
    mc "Lo necesitaremos."

# game/script.rpy:4410

translate spanish jungle_2ed9073b:
    # h "Oh yeah?"
    h "¿Sí?"

# game/script.rpy:4411

translate spanish jungle_9386b644:
    # h "And when exactly is that supposed to be?"
    h "¿Y cuándo se supone que es exactamente eso?"

# game/script.rpy:4413

translate spanish jungle_858483b1:
    # mc "He’s the only one who can get us in."
    mc "Es el único que puede meternos."

# game/script.rpy:4415

translate spanish jungle_6c560a32:
    # N "I’m not much of a fighter, I’ll admit that."
    N "No soy un luchador, lo admito."

# game/script.rpy:4417

translate spanish jungle_be66ef0d:
    # N "But you’re gonna need me once we reach that lab."
    N "Pero me necesitarás una vez que lleguemos a ese laboratorio."

# game/script.rpy:4419

translate spanish jungle_d181a398:
    # h "Hold up—"
    h "Espera..."

# game/script.rpy:4420

translate spanish jungle_ee5b3169:
    # h "What lab?"
    h "¿Qué laboratorio?"

# game/script.rpy:4421

translate spanish jungle_ae4ebe93:
    # mc "According to Norman… there’s a lab at the center."
    mc "Según Norman... hay un laboratorio en el centro."

# game/script.rpy:4423

translate spanish jungle_2fded262_2:
    # h "..."
    h "..."

# game/script.rpy:4426

translate spanish jungle_b0d6f560:
    # h "And what’s the plan with it?"
    h "¿Y cuál es el plan con él?"

# game/script.rpy:4428

translate spanish jungle_ed933789:
    # N "…She’s got a point."
    N "...Ella tiene un punto."

# game/script.rpy:4430

translate spanish jungle_2b35b6fe_2:
    # mc "..."
    mc "..."

# game/script.rpy:4432

translate spanish jungle_81d52519:
    # mc "We don’t have a choice."
    mc "No tenemos elección."

# game/script.rpy:4433

translate spanish jungle_5f2d8436:
    # mc "Right now… it’s just dead weight."
    mc "Ahora mismo... es solo peso muerto."

# game/script.rpy:4435

translate spanish jungle_1b98a873:
    # h "Heh…"
    h "Heh..."

# game/script.rpy:4436

translate spanish jungle_61e957a5:
    # h "Same old you."
    h "Igual que tú."

# game/script.rpy:4437

translate spanish jungle_a16e8e41:
    # h "Glad nothing’s changed."
    h "Me alegro de que nada haya cambiado."

# game/script.rpy:4440

translate spanish jungle_eab51ec6:
    # h "Hey, Norman… mind if I ask something?"
    h "Oye, Norman... ¿te importa si pregunto algo?"

# game/script.rpy:4441

translate spanish jungle_f44eba9f:
    # N "Go ahead."
    N "Adelante."

# game/script.rpy:4444

translate spanish jungle_e8f11a91:
    # N "…That’s a long story."
    N "...Esa es una larga historia."

# game/script.rpy:4445

translate spanish jungle_94d37d67:
    # N "Feels like a different life."
    N "Se siente como una vida diferente."

# game/script.rpy:4447

translate spanish jungle_9627e2c1:
    # h "We’ve got a long walk anyway."
    h "Tenemos un largo paseo de todos modos."

# game/script.rpy:4449

translate spanish jungle_9f7f326d:
    # h "Hey, are you not curious about your son’s love life?"
    h "¿No tienes curiosidad por la vida amorosa de tu hijo?"

# game/script.rpy:4451

translate spanish jungle_74f6c040:
    # mc "I’m coming."
    mc "Ya voy."

# game/script.rpy:4453

translate spanish jungle_9be863b0:
    # h "Go on, Norman."
    h "Vamos, Norman."

# game/script.rpy:4454

translate spanish jungle_962af931:
    # h "We’ve got time."
    h "Tenemos tiempo."

# game/script.rpy:4455

translate spanish jungle_9b1bfb7e:
    # N "Back in the day, back when dinosaurs still roamed the earth, I was a broke university student."
    N "En el día, cuando los dinosaurios seguían vagando por la tierra, era un estudiante universitario en quiebra."

# game/script.rpy:4456

translate spanish jungle_5ebb1cd0:
    # N "Spent more time with books than people."
    N "Pasó más tiempo con libros que personas."

# game/script.rpy:4458

translate spanish jungle_add80bc4:
    # N "Didn’t think anyone would even notice me."
    N "No pensé que nadie me notara."

# game/script.rpy:4459

translate spanish jungle_f7b7ac27:
    # N "Least of all her."
    N "Al menos ella."

# game/script.rpy:4565

translate spanish junglenext_9b5d1dbc:
    # h "Hey… [mc]."
    h "Oye... [mc]."

# game/script.rpy:4566

translate spanish junglenext_69621b8c:
    # h "Why now?"
    h "¿Por qué ahora?"

# game/script.rpy:4567

translate spanish junglenext_ababa309:
    # h "After all this time… why go back?"
    h "Después de todo este tiempo... ¿por qué regresar?"

# game/script.rpy:4568

translate spanish junglenext_982ff762:
    # mc "If I waited any longer… I wouldn’t have made it."
    mc "Si hubiera esperado más... no lo habría hecho."

# game/script.rpy:4570

translate spanish junglenext_40244502:
    # h "If I were you… I wouldn’t let it get to my head like that."
    h "Si yo fuera tú... no dejaría que llegara a mi cabeza así."

# game/script.rpy:4571

translate spanish junglenext_44fa84c0:
    # mc "Heh."
    mc "Heh."

# game/script.rpy:4572

translate spanish junglenext_c613da8e:
    # h "No, I mean it, [mc]. Serious."
    h "No, en serio, [mc]Serio."

# game/script.rpy:4573

translate spanish junglenext_cb89ebe5:
    # h "I get it."
    h "Lo entiendo."

# game/script.rpy:4574

translate spanish junglenext_617784d6:
    # h "Lora meant everything to you."
    h "Lora significaba todo para ti."

# game/script.rpy:4575

translate spanish junglenext_81343336:
    # h "But it’s been too long."
    h "Pero ha sido demasiado tiempo."

# game/script.rpy:4579

translate spanish junglenext_bf96f826:
    # h "I’m all for digging up the truth."
    h "Estoy a favor de investigar la verdad."

# game/script.rpy:4580

translate spanish junglenext_0ccd46e0:
    # h "But if this goes sideways…"
    h "Pero si esto va de lado..."

# game/script.rpy:4581

translate spanish junglenext_d5bbee43:
    # h "(quietly) I don’t wanna see you like you were before."
    h "(quietly) No quiero verte como antes."

# game/script.rpy:4583

translate spanish junglenext_66fa3968:
    # mc "You won’t."
    mc "No lo harás."

# game/script.rpy:4584

translate spanish junglenext_bbed952c:
    # mc "That version of me is gone."
    mc "Esa versión de mí se ha ido."

# game/script.rpy:4586

translate spanish junglenext_7889da18:
    # mc "…Norman."
    mc "...Norman."

# game/script.rpy:4587

translate spanish junglenext_5c4e71e8:
    # mc "How far?"
    mc "¿Hasta dónde?"

# game/script.rpy:4590

translate spanish junglenext_10252e11:
    # N "...Dad?"
    N "... ¿Papá?"

# game/script.rpy:4591

translate spanish junglenext_7cf1923a:
    # mc "Norman?"
    mc "¿Norman?"

# game/script.rpy:4592

translate spanish junglenext_b8b14b2c:
    # N "According to the coordinates… we’re there, but—"
    N "Según las coordenadas... estamos ahí, pero..."

# game/script.rpy:4594

translate spanish junglenext_9cc531bc:
    # N "The lab should be just past those cliffs."
    N "El laboratorio debería estar justo más allá de esos acantilados."

# game/script.rpy:4595

translate spanish junglenext_e1442345:
    # N "I don’t get it…"
    N "No lo entiendo..."

# game/script.rpy:4597

translate spanish junglenext_01539dd0:
    # N "The coordinates are precise…"
    N "Las coordenadas son precisas..."

# game/script.rpy:4599

translate spanish junglenext_858267f5:
    # N "But there’s nothing here."
    N "Pero no hay nada aquí."

# game/script.rpy:4611

translate spanish junglenext_29d95b82:
    # mc "Still hiding in bushes, huh?"
    mc "¿Sigues escondido en arbustos?"

# game/script.rpy:4612

translate spanish junglenext_4717abe5:
    # mc "Some things don’t change."
    mc "Algunas cosas no cambian."

# game/script.rpy:4614

translate spanish junglenext_23c81f63:
    # S "Guilty as charged. Old habits."
    S "Culpable de lo que se le cobra, viejos hábitos."

# game/script.rpy:4615

translate spanish junglenext_835eef81:
    # S "Still… it’s good to see you again."
    S "Aún así... es bueno verte de nuevo."

# game/script.rpy:4616

translate spanish junglenext_63d3dedb:
    # S "Now, mind lowering the guns? We’re not enemies."
    S "Ahora, ¿la mente baja las armas? No somos enemigos."

# game/script.rpy:4619

translate spanish junglenext_507d95fa:
    # mc "Hope so."
    mc "Eso espero."

# game/script.rpy:4620

translate spanish junglenext_d9aab11f:
    # mc "Fifteen years."
    mc "Quince años."

# game/script.rpy:4621

translate spanish junglenext_6bd3f7e4:
    # mc "A lot can change."
    mc "Mucho puede cambiar."

# game/script.rpy:4624

translate spanish junglenext_3ec243e2:
    # N "Let me introduce you, Shiya Gray."
    N "Te presento a Shiya Gray."

# game/script.rpy:4625

translate spanish junglenext_44ec6081:
    # N "Senior Sergeant. And… my handler."
    N "Sargento mayor. Y... mi enlace operativo."

# game/script.rpy:4627

translate spanish junglenext_7a3c3d5b:
    # mc "...Handler?"
    mc "¿Enlace operativo?"

# game/script.rpy:4629

translate spanish junglenext_6816a4da:
    # S "Yeah. That’s me."
    S "Sí, soy yo."

# game/script.rpy:4630

translate spanish junglenext_5b4d15af:
    # S "Hello, Commander… or should I say {b}former{/b} Commander."
    S "Hola, comandante... o debería decir {b}ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex ex{/b} Comandante."

# game/script.rpy:4633

translate spanish junglenext_8b8c5e46:
    # h "...You really haven’t changed."
    h "...Realmente no has cambiado."

# game/script.rpy:4637

translate spanish junglenext_1827b8c3:
    # S "Heard you took Alexandro in."
    S "Oí que te llevaste a Alexandro."

# game/script.rpy:4639

translate spanish junglenext_ed3d5200:
    # h "Yeah. Someone had to."
    h "Alguien tenía que hacerlo."

# game/script.rpy:4643

translate spanish junglenext_7f55bc84:
    # mc "And Richard?"
    mc "¿Y Richard?"

# game/script.rpy:4644

translate spanish junglenext_2bbcebb8:
    # mc "Still messing with his inventions?"
    mc "¿Sigues jugando con sus inventos?"

# game/script.rpy:4646

translate spanish junglenext_ff37d682:
    # S "Father? Lost his mind in his old age, but the army still respects him. So they let his quirks slide."
    S "Padre, perdió la cabeza en su vejez, pero el ejército todavía lo respeta, así que dejaron que sus quirks se deslizaran."

# game/script.rpy:4648

translate spanish junglenext_28411d41:
    # h "Sounds like him."
    h "Suena como él."

# game/script.rpy:4649

translate spanish junglenext_a8a4a433:
    # h "Good to know he’s still kicking."
    h "Me alegro de saber que sigue pateando."

# game/script.rpy:4651

translate spanish junglenext_66b8d6c1:
    # S "Honestly… when my father asked me to pass that letter on,"
    S "Sinceramente... cuando mi padre me pidió que le pasara esa carta,"

# game/script.rpy:4652

translate spanish junglenext_b9572ef8:
    # S "I didn’t think it would actually work."
    S "No pensé que funcionaría."

# game/script.rpy:4653

translate spanish junglenext_2968952a:
    # S "Nice to see I was wrong."
    S "Me alegro de ver que estaba equivocado."

# game/script.rpy:4658

translate spanish junglenext_7832ee95:
    # N "We were attacked."
    N "Nos atacaron."

# game/script.rpy:4660

translate spanish junglenext_9c3f50b8:
    # S "Attacked? By who?"
    S "¿Atacado por quién?"

# game/script.rpy:4663

translate spanish junglenext_ab08fc7c:
    # mc "Azarkhan’s people."
    mc "La gente de Azarkhan."

# game/script.rpy:4664

translate spanish junglenext_f8e01ab0:
    # mc "No confirmation… but it fits."
    mc "No hay confirmación... pero encaja."

# game/script.rpy:4665

translate spanish junglenext_e26382c6:
    # mc "Question is how does it tie back to this place?"
    mc "Pregunta ¿cómo se relaciona con este lugar?"

# game/script.rpy:4669

translate spanish junglenext_25177961:
    # S "(Whispering) So… it’s about the ship."
    S "Así que... se trata de la nave."

# game/script.rpy:4672

translate spanish junglenext_1b04d4c9:
    # S "I could explain it."
    S "Podría explicarlo."

# game/script.rpy:4673

translate spanish junglenext_135d652c:
    # S "But it won’t make sense until you see it."
    S "Pero no tendrá sentido hasta que lo vea."

# game/script.rpy:4693

translate spanish spaceship_b6eb03cc:
    # S "Friendly advice, Commander, whatever you’re about to see, don’t freak out."
    S "Un consejo amistoso, Comandante, lo que sea que esté a punto de ver, no se asuste."

# game/script.rpy:4694

translate spanish spaceship_b14fad8e:
    # S "It’ll help you keep your sanity a little longer."
    S "Te ayudará a mantener tu cordura un poco más."

# game/script.rpy:4696

translate spanish spaceship_1b7a36d6:
    # S "Now… look over there."
    S "Ahora... mira por ahí."

# game/script.rpy:4698

translate spanish spaceship_7830fcfb:
    # S "I didn’t believe it either."
    S "Yo tampoco lo creía."

# game/script.rpy:4699

translate spanish spaceship_e8a29d4b:
    # S "First time I saw it."
    S "La primera vez que lo vi."

# game/script.rpy:4701

translate spanish spaceship_eb7eec91:
    # mc "(...what the hell is that?)"
    mc "(...¿qué demonios es eso?)"

# game/script.rpy:4702

translate spanish spaceship_76a5ba94:
    # S "That thing crashed here thousands of years ago."
    S "Esa cosa se estrelló hace miles de años."

# game/script.rpy:4704

translate spanish spaceship_43d51cbc:
    # S "It’s the source of every anomaly in this area."
    S "Es la fuente de cada anomalía en esta área."

# game/script.rpy:4706

translate spanish spaceship_66a3bbaa:
    # h "...That’s one hell of a leap."
    h "...eso es un gran salto."

# game/script.rpy:4707

translate spanish spaceship_b7732fbb:
    # h "From {b}Lora went missing{/b} to {b}alien spaceship.{/b}"
    h "De {b}Lora desapareció.{/b} a {b}nave espacial alienígena.{/b}"

# game/script.rpy:4709

translate spanish spaceship_f34b4020:
    # h "Or is it just me?"
    h "¿O soy yo?"

# game/script.rpy:4710

translate spanish spaceship_6925cdda:
    # h "Am I the only one seeing how insane this sounds?"
    h "¿Soy el único que ve lo loco que suena esto?"

# game/script.rpy:4712

translate spanish spaceship_555e0ed5:
    # mc "Doesn’t show… but yeah. Same here."
    mc "No se nota... pero sí. Lo mismo digo."

# game/script.rpy:4714

translate spanish spaceship_ed421996:
    # mc "Part of me still thinks this is a joke."
    mc "Parte de mí todavía piensa que esto es una broma."

# game/script.rpy:4716

translate spanish spaceship_49f720d6:
    # h "How does that even make sense?"
    h "¿Cómo tiene sentido?"

# game/script.rpy:4717

translate spanish spaceship_0c85fd2d:
    # h "I thought we were alone out here."
    h "Pensé que estábamos solos aquí."

# game/script.rpy:4718

translate spanish spaceship_00d60215:
    # h "And now what—"
    h "Y ahora qué..."

# game/script.rpy:4719

translate spanish spaceship_4910d1c5:
    # h "we’ve got uninvited guests from space?"
    h "¿Tenemos invitados sin invitación del espacio?"

# game/script.rpy:4720

translate spanish spaceship_ee31fb04:
    # h "Great. Love that for us."
    h "Genial, me encanta eso para nosotros."

# game/script.rpy:4722

translate spanish spaceship_a2a19851:
    # mc "(So Norman and Richard weren’t lying…)"
    mc "(Así que Norman y Richard no estaban mintiendo...)"

# game/script.rpy:4724

translate spanish spaceship_bf89bfc0:
    # mc "(Lora… what the hell did you get yourself into?)"
    mc "(Lora... ¿En qué diablos te metiste?)"

# game/script.rpy:4727

translate spanish spaceship_3fbf6989:
    # mc "So how does that thing tie to Lora?"
    mc "¿Y cómo le va esa cosa a Lora?"

# game/script.rpy:4730

translate spanish spaceship_b3ef1df9:
    # ri "That’s exactly what we’re trying to figure out."
    ri "Eso es exactamente lo que estamos tratando de averiguar."

# game/script.rpy:4732

translate spanish spaceship_eb35cda5:
    # ri "Three years ago, we found this place."
    ri "Hace tres años, encontramos este lugar."

# game/script.rpy:4733

translate spanish spaceship_37635e00:
    # ri "Or rather… it let us find it."
    ri "O más bien... nos dejó encontrarlo."

# game/script.rpy:4734

translate spanish spaceship_199e410d:
    # ri "At first, we thought it was a military project."
    ri "Al principio, pensamos que era un proyecto militar."

# game/script.rpy:4735

translate spanish spaceship_0859680b:
    # ri "We were wrong."
    ri "Nos equivocamos."

# game/script.rpy:4737

translate spanish spaceship_2717a46a:
    # ri "Still… I’m glad you came."
    ri "Aún así... me alegro de que hayas venido."

# game/script.rpy:4739

translate spanish spaceship_211a38cd:
    # mc "Let’s just say I didn’t have a reason to say no."
    mc "Digamos que no tenía una razón para decir que no."

# game/script.rpy:4740

translate spanish spaceship_105b349e:
    # mc "But one thing still bugs me."
    mc "Pero una cosa todavía me molesta."

# game/script.rpy:4741

translate spanish spaceship_5164590e:
    # mc "Why me?"
    mc "¿Por qué yo?"

# game/script.rpy:4743

translate spanish spaceship_991d0569:
    # mc "You’ve got better people."
    mc "Tienes mejores personas."

# game/script.rpy:4744

translate spanish spaceship_4c17cf74:
    # mc "More experienced."
    mc "Más experimentado."

# game/script.rpy:4745

translate spanish spaceship_19ce78ca:
    # mc "So why me?"
    mc "¿Y por qué yo?"

# game/script.rpy:4749

translate spanish spaceship_1b22fea2:
    # ri "We have people."
    ri "Tenemos gente."

# game/script.rpy:4750

translate spanish spaceship_ddc02359:
    # ri "But no one wants to go in there."
    ri "Pero nadie quiere entrar ahí."

# game/script.rpy:4752

translate spanish spaceship_993a4a49:
    # ri "I’m risking more than you are."
    ri "Estoy arriesgando más de lo que eres."

# game/script.rpy:4753

translate spanish spaceship_6e9f1023:
    # ri "A tribunal would be the least of our problems if this gets out…"
    ri "Un tribunal sería el menor de nuestros problemas si esto sale..."

# game/script.rpy:4754

translate spanish spaceship_e3057d55:
    # ri "We’d all be finished."
    ri "Todos estaríamos acabados."

# game/script.rpy:4761

translate spanish spaceship_404c3ccf:
    # mc "...That’s not human."
    mc "...Eso no es humano."

# game/script.rpy:4762

translate spanish spaceship_8b909ca4:
    # h "Yeah… that checks out."
    h "Sí... eso se ve."

# game/script.rpy:4764

translate spanish spaceship_5639de4b:
    # h "Nope."
    h "No."

# game/script.rpy:4765

translate spanish spaceship_da6fe756:
    # h "No way I’m going in there."
    h "No me voy a entrar."

# game/script.rpy:4766

translate spanish spaceship_f9384a89:
    # h "Not happening."
    h "No está pasando."

# game/script.rpy:4768

translate spanish spaceship_ff6ae2df:
    # mc "No way around it?"
    mc "¿No hay manera de rodearlo?"

# game/script.rpy:4770

translate spanish spaceship_dce3ed76:
    # ri "Daughter, your thoughts?"
    ri "Hija, ¿tu pensamientos?"

# game/script.rpy:4772

translate spanish spaceship_77d0adcc:
    # S "No. We’ve checked the entire perimeter."
    S "No. Hemos comprobado todo el perímetro."

# game/script.rpy:4773

translate spanish spaceship_3d17a36e:
    # S "No other entrances."
    S "No hay otras entradas."

# game/script.rpy:4774

translate spanish spaceship_f89aedcd:
    # S "We even tried making one, wasted ammo. Nothing worked."
    S "Incluso intentamos hacer una munición desperdiciada."

# game/script.rpy:4776

translate spanish spaceship_8ad0b165:
    # h "You’re seriously asking us to walk into that?"
    h "¿De verdad nos estás pidiendo que nos metamos en eso?"

# game/script.rpy:4777

translate spanish spaceship_013d3db8:
    # h "That’s not a mission."
    h "Eso no es una misión."

# game/script.rpy:4778

translate spanish spaceship_65a9b131:
    # h "That’s a death sentence."
    h "Es una sentencia de muerte."

# game/script.rpy:4780

translate spanish spaceship_994ce6f3:
    # mc "She’s right."
    mc "Tiene razón."

# game/script.rpy:4781

translate spanish spaceship_c1fe712a:
    # mc "Right now this sounds like suicide."
    mc "Ahora mismo esto suena como suicidio."

# game/script.rpy:4785

translate spanish spaceship_47b368f9:
    # h "And honestly?"
    h "¿Y honestamente?"

# game/script.rpy:4786

translate spanish spaceship_8332938a:
    # h "Can you blame them?"
    h "¿Puedes culparlos?"

# game/script.rpy:4787

translate spanish spaceship_df7e0d95:
    # h "Who the hell would sign up for that?"
    h "¿Quién demonios se inscribiría para eso?"

# game/script.rpy:4789

translate spanish spaceship_927b0286:
    # mc "Doesn’t look like we have a choice."
    mc "No parece que tengamos una opción."

# game/script.rpy:4790

translate spanish spaceship_9ba7d9ad:
    # mc "Getting past those sentries won’t be easy."
    mc "Pasar por esos centinelas no será fácil."

# game/script.rpy:4801

translate spanish spaceship_15024590:
    # N "It’s a long shot... but it’s something."
    N "Es un tiro largo... pero es algo."

# game/script.rpy:4807

translate spanish spaceship_d73d52d8:
    # h "Okay."
    h "Vale."

# game/script.rpy:4808

translate spanish spaceship_7c35885a:
    # h "I hate it."
    h "Lo odio."

# game/script.rpy:4809

translate spanish spaceship_10c0b0cf:
    # h "But it’s better than walking through the front door."
    h "Pero es mejor que caminar por la puerta principal."

# game/script.rpy:4812

translate spanish spaceship_0de60052:
    # mc "We don’t have a better option."
    mc "No tenemos una mejor opción."

# game/script.rpy:4820

translate spanish spaceship_c55d9b49:
    # N "Up close… it’s even bigger than I thought."
    N "Cerca... es aún más grande de lo que pensaba."

# game/script.rpy:4821

translate spanish spaceship_36546702:
    # N "So how are we getting into those turbines?"
    N "¿Cómo nos metemos en esas turbinas?"

# game/script.rpy:4823

translate spanish spaceship_d08d4527:
    # ri "We’ll get a ladder."
    ri "Vamos a conseguir una escalera."

# game/script.rpy:4824

translate spanish spaceship_907133dc:
    # ri "After that… we improvise."
    ri "Después de eso... improvisamos."

# game/script.rpy:4826

translate spanish spaceship_716eff36:
    # h "Gotta admit…"
    h "Tengo que admitir..."

# game/script.rpy:4827

translate spanish spaceship_ec72696f:
    # h "Kid’s got a brain."
    h "El chico tiene cerebro."

# game/script.rpy:4829

translate spanish spaceship_40ea09f1:
    # h "But you—"
    h "Pero tú..."

# game/script.rpy:4830

translate spanish spaceship_13e21e8d:
    # h "you did it again."
    h "Lo hiciste otra vez."

# game/script.rpy:4832

translate spanish spaceship_91bacd01:
    # h "That look."
    h "Esa mirada."

# game/script.rpy:4833

translate spanish spaceship_d5b59ca0:
    # h "Means you’re already halfway lost in your own head."
    h "Significa que ya estás medio perdido en tu propia cabeza."

# game/script.rpy:4838

translate spanish spaceship_16dfe01b:
    # h "Talking your head off to some random stranger…"
    h "Hablando con un extraño aleatorio..."

# game/script.rpy:4839

translate spanish spaceship_2d52ab83:
    # h "Helped back then."
    h "Ayudó entonces."

# game/script.rpy:4844

translate spanish spaceship_09cb1e1d:
    # mc "Something’s off."
    mc "Algo está apagado."

# game/script.rpy:4845

translate spanish spaceship_3681196a:
    # mc "Tell me, Olivia… you believe in fate?"
    mc "Dime, Olivia... ¿crees en el destino?"

# game/script.rpy:4847

translate spanish spaceship_ded5af50:
    # h "After the way we met?"
    h "¿Después de la forma en que nos conocimos?"

# game/script.rpy:4848

translate spanish spaceship_72fce240:
    # h "Yeah… I’d say I do."
    h "Sí... diría que sí."

# game/script.rpy:4852

translate spanish spaceship_96267e9d:
    # mc "What are the odds…"
    mc "¿Qué probabilidades hay?"

# game/script.rpy:4853

translate spanish spaceship_641b861d:
    # mc "that out of every planet, this thing crashes on Earth?"
    mc "que de cada planeta, ¿esta cosa se estrella en la Tierra?"

# game/script.rpy:4855

translate spanish spaceship_56c93102:
    # mc "Out of all the missing people…"
    mc "De todas las personas desaparecidas..."

# game/script.rpy:4856

translate spanish spaceship_fcd1de3f:
    # mc "only Lora’s photo turns up."
    mc "solo aparece la foto de Lora."

# game/script.rpy:4858

translate spanish spaceship_d068d739:
    # mc "Then Norman shows up."
    mc "Entonces Norman aparece."

# game/script.rpy:4859

translate spanish spaceship_30e23456:
    # mc "With a letter."
    mc "Con una carta."

# game/script.rpy:4863

translate spanish spaceship_27ac3d31:
    # ri "...he’s backed by powerful entities."
    ri "...está respaldado por entidades poderosas."

# game/script.rpy:4864

translate spanish spaceship_38af67a9:
    # ri "Possibly... extraterrestrial."
    ri "Posiblemente... extraterrestre."

# game/script.rpy:4867

translate spanish spaceship_30952361:
    # N "It wasn’t my choice… I was led there."
    N "No fue mi elección... fui llevado allí."

# game/script.rpy:4868

translate spanish spaceship_4f43fca7:
    # N "A man… wearing a black mask."
    N "Un hombre... usando una máscara negra."

# game/script.rpy:4871

translate spanish spaceship_eb35cda5_1:
    # ri "Three years ago, we found this place."
    ri "Hace tres años, encontramos este lugar."

# game/script.rpy:4872

translate spanish spaceship_37635e00_1:
    # ri "Or rather… it let us find it."
    ri "O más bien... nos dejó encontrarlo."

# game/script.rpy:4877

translate spanish spaceship_020ebf63:
    # mc "Next day, Azarkhan’s people try to kill us."
    mc "Al día siguiente, la gente de Azarkhan trata de matarnos."

# game/script.rpy:4879

translate spanish spaceship_33ac3d71:
    # mc "And I’m supposed to believe that’s coincidence?"
    mc "¿Y se supone que debo creer que es una coincidencia?"

# game/script.rpy:4880

translate spanish spaceship_23cdc4b7:
    # h "Huh…"
    h "Eh..."

# game/script.rpy:4884

translate spanish spaceship_4ded8083:
    # h "Never really looked at it like that…"
    h "Nunca lo miré así..."

# game/script.rpy:4885

translate spanish spaceship_98455ae8:
    # h "But yeah."
    h "Pero sí."

# game/script.rpy:4886

translate spanish spaceship_dc1d1ea9:
    # h "That’s way too many coincidences."
    h "Eso es demasiadas coincidencias."

# game/script.rpy:4888

translate spanish spaceship_7ec87a23:
    # h "Feels like someone’s feeding info."
    h "Se siente como la información de alimentación de alguien."

# game/script.rpy:4889

translate spanish spaceship_bfbe08b0:
    # h "Or watching us real close."
    h "O nos observamos muy cerca."

# game/script.rpy:4891

translate spanish spaceship_2b35b6fe_6:
    # mc "..."
    mc "..."

# game/script.rpy:4893

translate spanish spaceship_ed237b7a:
    # mc "Stay sharp."
    mc "Mantente firme."

# game/script.rpy:4894

translate spanish spaceship_56dc04e9:
    # mc "Anything can happen."
    mc "Cualquier cosa puede pasar."

# game/script.rpy:4896

translate spanish spaceship_8bfb7575:
    # h "I’ll try reaching Anya."
    h "Intentaré llegar a Anya."

# game/script.rpy:4897

translate spanish spaceship_52fe7e25:
    # h "There’s gotta be something here that actually works…"
    h "Tiene que haber algo aquí que realmente funcione..."

# game/script.rpy:4901

translate spanish spaceship_cf36c990:
    # N "Yeah, I found something."
    N "Sí, encontré algo."

# game/script.rpy:4902

translate spanish spaceship_d6e94d57:
    # N "There’s a narrow passage. Tight, but we can make it, one at a time."
    N "Hay un pasaje estrecho. Pesadilla, pero podemos hacerlo, uno a uno."

# game/script.rpy:4904

translate spanish spaceship_98ae6c0e:
    # N "Go get Dad, I’ll need him for this."
    N "Ve a buscar a papá, lo necesito para esto."

# game/script.rpy:4933

translate spanish spaceship_into_10522407:
    # h "Seriously?"
    h "¿En serio?"

# game/script.rpy:4934

translate spanish spaceship_into_b2e3b36f:
    # h "You couldn’t be more careful?"
    h "¿No podrías tener más cuidado?"

# game/script.rpy:4935

translate spanish spaceship_into_62e8067a:
    # mc "Drop it, Olivia."
    mc "Suéltala, Olivia."

# game/script.rpy:4936

translate spanish spaceship_into_2b35b6fe:
    # mc "..."
    mc "..."

# game/script.rpy:4937

translate spanish spaceship_into_ed237b7a:
    # mc "Stay sharp."
    mc "Mantente firme."

# game/script.rpy:4940

translate spanish spaceship_into_89f74ab8:
    # h "You being this calm right now?"
    h "¿Estás siendo tan calmado ahora?"

# game/script.rpy:4941

translate spanish spaceship_into_64d9851e:
    # h "Yeah… that’s not comforting."
    h "Sí... eso no es reconfortante."

# game/script.rpy:4942

translate spanish spaceship_into_49775c53:
    # mc "I’m going in first."
    mc "Voy a ir primero."

# game/script.rpy:4947

translate spanish spaceship_into_4e6f4ed5:
    # mc "Wait…"
    mc "Espera..."

# game/script.rpy:4951

translate spanish spaceship_into_e4f7da9d:
    # mc "Doesn’t look like anyone’s here."
    mc "No parece que haya alguien aquí."

# game/script.rpy:4953

translate spanish spaceship_into_7fc74da9:
    # h "Then I’m coming with you."
    h "Entonces voy contigo."

# game/script.rpy:4955

translate spanish spaceship_into_ecf872dc:
    # mc "Wait."
    mc "Espera."

# game/script.rpy:4956

translate spanish spaceship_into_f2bdc742:
    # mc "I go first."
    mc "Yo voy primero."

# game/script.rpy:4959

translate spanish spaceship_into_8c02ec34:
    # h "No."
    h "No."

# game/script.rpy:4960

translate spanish spaceship_into_d38e769c:
    # h "Don’t do that."
    h "No hagas eso."

# game/script.rpy:4962

translate spanish spaceship_into_e21e8725:
    # h "I’m serious."
    h "Hablo en serio."

# game/script.rpy:4963

translate spanish spaceship_into_38535c37:
    # h "Don’t go in there alone."
    h "No entres ahí solo."

# game/script.rpy:4966

translate spanish spaceship_into_480890f2:
    # mc "I’ll manage."
    mc "Yo me las arreglaré."

# game/script.rpy:4968

translate spanish spaceship_into_60643364:
    # mc "If I don’t come back…"
    mc "Si no vuelvo..."

# game/script.rpy:4969

translate spanish spaceship_into_f5149bc1:
    # mc "Don’t follow."
    mc "No sigas."

# game/script.rpy:4970

translate spanish spaceship_into_e3b834a1:
    # h "...Damn it."
    h "...Maldita sea."

# game/script.rpy:4973

translate spanish spaceship_into_e24e2a22:
    # mc "(Left… or right…?)"
    mc "(Left... o derecho...?)"

# game/script.rpy:4991

translate spanish path_first_left_next_2_b11013ae:
    # mc "(Too quiet…)"
    mc "(Demasiado tranquilo...)"

# game/script.rpy:4992

translate spanish path_first_left_next_2_d831e8f2:
    # mc "(And that smell…)"
    mc "(Y ese olor...)"

# game/script.rpy:4993

translate spanish path_first_left_next_2_05c1bf7d:
    # mc "(Like something’s been rotting here for years.)"
    mc "(Como algo ha estado pudiendo aquí durante años.)"

# game/script.rpy:4998

translate spanish path_first_left_next_2_395b63a1:
    # mc "(…What the hell happened here?)"
    mc "(...¿Qué demonios ha pasado aquí?)"

# game/script.rpy:4999

translate spanish path_first_left_next_2_4791ec8f:
    # mc "(So that’s the smell…)"
    mc "(Así que ese es el olor...)"

# game/script.rpy:5000

translate spanish path_first_left_next_2_fd8789a9:
    # mc "(Corpses.)"
    mc "(Corpses.)"

# game/script.rpy:5007

translate spanish path_first_left_next_2_fca52711:
    # mc "No."
    mc "No."

# game/script.rpy:5008

translate spanish path_first_left_next_2_3e7f1059:
    # mc "Not going in there."
    mc "No entrar ahí."

# game/script.rpy:5021

translate spanish path_first_left_back_47d8729f:
    # mc "(What was this place…?)"
    mc "¿Qué fue este lugar...?"

# game/script.rpy:5022

translate spanish path_first_left_back_f2b77e43:
    # mc "(A warship? A lab?)"
    mc "¿Un laboratorio?"

# game/script.rpy:5023

translate spanish path_first_left_back_0036431f:
    # mc "(It’s massive…)"
    mc "(Es masivo...)"

# game/script.rpy:5024

translate spanish path_first_left_back_f3b39897:
    # mc "(Like a city buried inside a tomb.)"
    mc "(Como una ciudad enterrada dentro de una tumba.)"

# game/script.rpy:5027

translate spanish path_first_left_back_fddfd5b9:
    # mc "(Every turn… more corridors.)"
    mc "(Cada vuelta... más pasillos.)"

# game/script.rpy:5028

translate spanish path_first_left_back_fd41ebc7:
    # mc "(Like it was built to trap you.)"
    mc "(Como si fuera construido para atraparte.)"

# game/script.rpy:5034

translate spanish path_first_left_back_72203aac:
    # mc "(Same question… every time.)"
    mc "(Esa misma pregunta... cada vez.)"

# game/script.rpy:5043

translate spanish path_first_left_back_d5f6c8e1:
    # c "(What was this place…?)"
    c "¿Qué fue este lugar...?"

# game/script.rpy:5044

translate spanish path_first_left_back_f2b77e43_1:
    # mc "(A warship? A lab?)"
    mc "¿Un laboratorio?"

# game/script.rpy:5045

translate spanish path_first_left_back_0036431f_1:
    # mc "(It’s massive…)"
    mc "(Es masivo...)"

# game/script.rpy:5046

translate spanish path_first_left_back_f3b39897_1:
    # mc "(Like a city buried inside a tomb.)"
    mc "(Como una ciudad enterrada dentro de una tumba.)"

# game/script.rpy:5049

translate spanish path_first_left_back_fddfd5b9_1:
    # mc "(Every turn… more corridors.)"
    mc "(Cada vuelta... más pasillos.)"

# game/script.rpy:5050

translate spanish path_first_left_back_fd41ebc7_1:
    # mc "(Like it was built to trap you.)"
    mc "(Como si fuera construido para atraparte.)"

# game/script.rpy:5056

translate spanish path_first_left_back_dd6a5239:
    # mc "(Which way…?)"
    mc "¿Qué camino...?"

# game/script.rpy:5069

translate spanish first_right_568bc166:
    # mc "(Blocked.)"
    mc "(Bloqueado.)"

# game/script.rpy:5070

translate spanish first_right_be51f743:
    # mc "(Could climb it…)"
    mc "(Podría subirlo...)"

# game/script.rpy:5071

translate spanish first_right_fe933d84:
    # mc "(Feels like a dead end.)"
    mc "(Acarreo como un callejón sin salida.)"

# game/script.rpy:5086

translate spanish meets11_d897712b:
    # mc "You still there?"
    mc "¿Sigues ahí?"

# game/script.rpy:5087

translate spanish meets11_944420b6:
    # mc "Or did you all leave me already?"
    mc "¿O ya me dejas?"

# game/script.rpy:5089

translate spanish meets11_37d3cdef:
    # h "We would—"
    h "Nosotros..."

# game/script.rpy:5090

translate spanish meets11_56a90c9b:
    # h "but then who’s gonna drag your wrinkly ass out of here?"
    h "¿Pero quién va a arrastrar tu culo arrugado de aquí?"

# game/script.rpy:5091

translate spanish meets11_ad5ba466:
    # N "We’re not leaving you behind, Dad. Not a chance."
    N "No te dejaremos atrás, papá."

# game/script.rpy:5094

translate spanish meets11_a13c2312:
    # mc "Bad enough I don’t wanna be here."
    mc "Lo suficientemente malo no quiero estar aquí."

# game/script.rpy:5095

translate spanish meets11_7f5a36de:
    # mc "Not bad enough to turn back."
    mc "No es lo suficientemente malo para volver."

# game/script.rpy:5097

translate spanish meets11_d7f79773:
    # h "Move—!"
    h "¡Muévanse!"

# game/script.rpy:5102

translate spanish meets11_6706a6a7:
    # h "Ow— shit…"
    h "Mierda..."

# game/script.rpy:5103

translate spanish meets11_8976b556:
    # h "Yeah, I’m fine."
    h "Sí, estoy bien."

# game/script.rpy:5104

translate spanish meets11_9bc38ee6:
    # h "Would’ve been better if someone mentioned the damn drop!"
    h "¡Habría estado mejor si alguien hubiera mencionado la maldita caída!"

# game/script.rpy:5106

translate spanish meets11_023f223d:
    # mc "That used to be nothing for you."
    mc "Eso solía ser nada para ti."

# game/script.rpy:5107

translate spanish meets11_f1d0649a:
    # mc "Getting old?"
    mc "¿Envejecer?"

# game/script.rpy:5110

translate spanish meets11_11b7528b:
    # h "Oh, you wanna test that?"
    h "¿Quieres probar eso?"

# game/script.rpy:5111

translate spanish meets11_e85e184f:
    # h "Say it again."
    h "Dilo otra vez."

# game/script.rpy:5123

translate spanish meets11_c9c8edea:
    # N "I’ll back him up."
    N "Lo apoyaré."

# game/script.rpy:5124

translate spanish meets11_71d01fb0:
    # N "Dad… watch yourself, alright?"
    N "Papá... cuídate, ¿de acuerdo?"

# game/script.rpy:5127

translate spanish meets11_01ee1b35:
    # N "Sir… isn’t it a little too dark in here?"
    N "Señor... ¿no es un poco demasiado oscuro aquí?"

# game/script.rpy:5135

translate spanish meets11_8911ab8a:
    # h "Hah… they clicked fast."
    h "Hah... hicieron clic rápido."

# game/script.rpy:5136

translate spanish meets11_63f9bd70:
    # h "Kid’s got a talent for bonding with weirdos, I’ll give him that."
    h "Kid tiene un talento para unirme con los raros, yo le daré eso."

# game/script.rpy:5138

translate spanish meets11_320756a6:
    # h "Alright, enough."
    h "Muy bien, suficiente."

# game/script.rpy:5139

translate spanish meets11_2969347d:
    # h "Back to business."
    h "Volver al negocio."

# game/script.rpy:5141

translate spanish meets11_dbac7dd1:
    # h "We moving, or you planning to stand here all day?"
    h "¿Nos movemos o planeas quedarte aquí todo el día?"

# game/script.rpy:5148

translate spanish front_1019a20f:
    # mc "Great plan."
    mc "Gran plan."

# game/script.rpy:5149

translate spanish front_e1768e65:
    # mc "I’ll just play meat shield, right?"
    mc "Me toca hacer de escudo de carne, ¿no?"

# game/script.rpy:5150

translate spanish front_e8c10c89:
    # h "[mc]…"
    h "[mc]…"

# game/script.rpy:5151

translate spanish front_0330ab46:
    # h "You seriously gonna let a fragile, innocent girl walk in front of you?"
    h "¿De verdad vas a dejar que una chica frágil e inocente te pase delante?"

# game/script.rpy:5154

translate spanish front_c2eb53da:
    # mc "Of course not."
    mc "Por supuesto que no."

# game/script.rpy:5155

translate spanish front_84373e58:
    # mc "Shame I don’t see any."
    mc "Qué vergüenza que no veo."

# game/script.rpy:5156

translate spanish front_2d1744ee:
    # h "Careful there, cowboy."
    h "Cuidado, vaquero."

# game/script.rpy:5157

translate spanish front_91608899:
    # h "Might wanna check your ammo first—"
    h "Podría querer comprobar tu munición primero..."

# game/script.rpy:5158

translate spanish front_827f7904:
    # h "before someone knocks your head clean off."
    h "antes de que alguien te vuele la cabeza."

# game/script.rpy:5168

translate spanish door_space_ship_ac5de5fc:
    # mc "Save it for later."
    mc "Guárdalo para más tarde."

# game/script.rpy:5169

translate spanish door_space_ship_a87286f7:
    # mc "Door. Three o’clock."
    mc "Puerta. Tres en punto."

# game/script.rpy:5171

translate spanish door_space_ship_bfc3dc83:
    # h "I’ve got a good memory."
    h "Tengo un buen recuerdo."

# game/script.rpy:5172

translate spanish door_space_ship_f67f79cd:
    # h "Shiya— check it."
    h "Shiya, compruébalo."

# game/script.rpy:5173

translate spanish door_space_ship_1b57bc55:
    # h "See if we can get through."
    h "A ver si podemos pasar."

# game/script.rpy:5179

translate spanish door_space_ship_e07c57c2:
    # h "Let’s hope this doesn’t take forever."
    h "Esperemos que esto no tome para siempre."

# game/script.rpy:5189

translate spanish door_space_ship_3556b391:
    # mc "And where exactly do I find that?"
    mc "¿Y dónde exactamente lo encuentro?"

# game/script.rpy:5193

translate spanish door_space_ship_467e0a89:
    # mc "Like I’ve got a choice."
    mc "Como si tuviera elección."

# game/script.rpy:5194

translate spanish door_space_ship_f9421c4d:
    # mc "Let’s hope luck’s on our side."
    mc "Esperemos que la suerte esté de nuestro lado."

# game/script.rpy:5197

translate spanish door_space_ship_73838027:
    # mc "(A keycard… of course.)"
    mc "(Una tarjeta... por supuesto.)"

# game/script.rpy:5198

translate spanish door_space_ship_651ffb0f:
    # mc "(Because this place wasn’t annoying enough.)"
