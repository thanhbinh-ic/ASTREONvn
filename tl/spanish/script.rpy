# game/script.rpy:767

translate spanish war2_267bb635:

    # mc "We stay until it happens."
    mc "Nos quedamos hasta que suceda."

# game/script.rpy:769

translate spanish war2_ecd3e288:

    # m "But why?"
    m "¿Pero por qué?"

# game/script.rpy:771

translate spanish war2_57ee1b29:

