translate spanish war2_15a7ddfe:

    # a "You have no idea what it cost me to get them."
    a "No tienes idea de lo que me costó conseguirlos."

# game/script.rpy:870

translate spanish war2_f8a947b0:

    # az "Doesn’t matter. {w=0.7}The important thing is that you secured the goods."
    az "No importa. {w=0.7}Lo importante es que usted ha asegurado las mercancías."

