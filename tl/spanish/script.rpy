    # S "Enough for the ship to notice you."
    S "Lo suficiente para que la nave te note."

# game/script.rpy:5443
translate spanish door_space_ship_34cf8a13:

    # S "Not enough to open every damn lock."
    S "No lo suficiente para abrir cada maldita cerradura."

