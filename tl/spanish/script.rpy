translate spanish exit_2ad14adb:

    # h "Hey, guys? You wouldn’t happen to have something a little... stronger?"
    h "¿No tendrán algo un poco más fuerte?"

# game/script.rpy:3413

translate spanish exit_e55b9061:

    # h "They’re catching up—"
    h "Están al día..."

# game/script.rpy:3420

translate spanish exit_7d1f33be:

