translate spanish spaceship_door_57daa329:

    # h "Honestly? That’s probably the best idea I’ve heard all day."
    h "¿Honestamente? Esa es probablemente la mejor idea que he oído todo el día."

# game/script.rpy:4550

translate spanish spaceship_door_a1d96a87:

    # mc "Unless you’re hiding a warhead in your backpack, we’re outgunned. That thing looks like it eats grenades for breakfast."
    mc "A menos que estés escondiendo una ojiva en tu mochila, estamos encintados. Esa cosa parece que come granadas para el desayuno."

# game/script.rpy:4552

translate spanish spaceship_door_f76bc0a4:

    # S "Relax. I’ve got a little something tucked away for emergencies like this… Hold up…"
    S "Relájate. Tengo algo que me ha pasado para emergencias como esta..."

# game/script.rpy:4555

translate spanish spaceship_door_7c6a7a74:

    # S "Bingo. C4. Reliable. Elegant. Makes a statement. Set, walk, boom. Simple."
    S "Bingo. C4. Fiable. Elegante. Hace una declaración. Juego, caminar, boom. Simple."

# game/script.rpy:4556

translate spanish spaceship_door_d404d56e:

    # S "Blows through anything from vault doors to reinforced walls."
    S "Atravesa cualquier cosa desde puertas de bóveda hasta paredes reforzadas."

# game/script.rpy:4558

translate spanish spaceship_door_dcf84edf:

    # h "...That might actually work. But where did you get it?"
    h "...que podría funcionar, pero ¿dónde lo conseguiste?"

# game/script.rpy:4560

translate spanish spaceship_door_d6179a79:

    # S "That’s not your concern."
    S "Eso no es asunto tuyo."

# game/script.rpy:4562

translate spanish spaceship_door_2fded262:

    # h "..."
    h "..."

# game/script.rpy:4564

translate spanish spaceship_door_73ff04b5:

    # h "If you say so..."
    h "Si lo dices..."

# game/script.rpy:4570

translate spanish spaceship_door_fab11858:

    # ri "We don’t have much time. I’ll handle it."
    ri "No tenemos mucho tiempo. Yo me encargaré de ello."

# game/script.rpy:4572

translate spanish spaceship_door_7e4ef3b4:

    # S "What are you doing, pa?! That thing could—"
    S "¿Qué estás haciendo, papá? Esa cosa podría..."

# game/script.rpy:4574

translate spanish spaceship_door_87ccd9b8:

    # ri "Don’t worry. I’ve dealt with one before, with Norman."
    ri "No te preocupes. He tratado con uno antes, con Norman."

# game/script.rpy:4576

translate spanish spaceship_door_5460e4d1:

    # ri "As long as we avoid the sensors, we’re good."
    ri "Mientras evitemos los sensores, estamos bien."

# game/script.rpy:4578

translate spanish spaceship_door_d2d68e4f:

    # h "Yeah. I think we can rule out 'not dangerous.' Richard’s running field tests {b}with his face.{/b}"
    h "Así que vamos a cruzar la opción \"seguro\". {b}cara a cara{/b}."

# game/script.rpy:4580

translate spanish spaceship_door_5e129e6a:

    # S "Guess we don’t need the C4 after all. Thanks, Dad. Really cleared things up for us."
    S "Supongo que al final no necesitamos el C4. Gracias, papá. Nos aclaraste mucho las cosas."

# game/script.rpy:4583

translate spanish spaceship_door_ac7bccb2:

    # S "Hey, Dad? Maybe don’t push any more buttons on that murder machine. Just a thought."
    S "¿Papá? Quizá no deberías pulsar más botones en esa máquina asesina. Solo una idea."

# game/script.rpy:4586

translate spanish spaceship_door_a42ec2b9:

    # S "Last thing we need is it waking up in a bad mood."
    S "Lo último que necesitamos es despertarse de mal humor."

# game/script.rpy:4589

translate spanish spaceship_door_63f30d0c:

    # ri "You worry too much. Trust me."
    ri "Te preocupas demasiado."

# game/script.rpy:4591

translate spanish spaceship_door_0a9756c2:

    # ri "I’m sure I’ve got it under control."
    ri "Estoy seguro de que lo tengo bajo control."

# game/script.rpy:4598

translate spanish spaceship_door_ab6ddc47:

    # ri "..."
    ri "..."

# game/script.rpy:4605

translate spanish spaceship_door_2e98bd9e:

    # mc "Richard, what the hell?!"
    mc "Richard, ¿qué demonios?"

# game/script.rpy:4608

translate spanish spaceship_door_f34e61b3:

    # ri "No sudden moves. We’re fine."
    ri "No hay movimientos repentinos. Estamos bien."

# game/script.rpy:4611

translate spanish spaceship_door_098ca0c5:

    # ri "Totally fine. Just don’t look threatening."
    ri "Totalmente bien. Simplemente no parece amenazante."

# game/script.rpy:4614

translate spanish spaceship_door_533b52f7:

    # ri "Everyone — lower your weapons."
    ri "Todos — bajen sus armas."

# game/script.rpy:4615

translate spanish spaceship_door_462bfc56:

    # ri "That’s an {b}order{/b}. If we stay calm, so will it."
    ri "Eso es un {b}orden{/b}Si nos mantenemos calmados, así será."

# game/script.rpy:4618

translate spanish spaceship_door_72b5a7f3:

    # ri "No harm meant, no harm done. Right, metal friend? We’re just... passing through."
    ri "Sin mala intención, sin daño hecho. ¿Verdad, amigo metálico? Solo estamos... de paso."

# game/script.rpy:4621

translate spanish spaceship_door_95d6f3d5:

    # ri "Nice and easy."
    ri "Lindo y fácil."

# game/script.rpy:4623

translate spanish spaceship_door_c3703ae3:

    # ri "That’s it. Lower your guns. Breathe."
    ri "Eso es. Baja tus armas. Respira."

# game/script.rpy:4625

translate spanish spaceship_door_20882fe6:

    # mc "You’ve lost your mind! That’s an alien robot!"
    mc "¡Has perdido la cabeza! ¡Es un robot alienígena!"

# game/script.rpy:4627

translate spanish spaceship_door_451cfeb3:

    # ri "Yeah, I’ve lost it. Now lower your weapon!"
    ri "Sí, lo he perdido. ¡Ahora baja tu arma!"

# game/script.rpy:4630

translate spanish spaceship_door_aacb036a:

    # ri "...Thanks."
    ri "Gracias."

# game/script.rpy:4632

translate spanish spaceship_door_560eb47f:

    # mc "I don’t like this one bit, Richard. Not one bit."
    mc "No me gusta esto, Richard."

# game/script.rpy:4634

translate spanish spaceship_door_a7556636:

    # ri "I’ll listen to your complaints after this."
    ri "Voy a escuchar sus quejas después de esto."

# game/script.rpy:4643

translate spanish spaceship_door_2fb49068:

    # E "{b}sigh of relief{/b}"
    E "{b}suspiro de alivio{/b}"

# game/script.rpy:4648

translate spanish spaceship_door_8c42975c:

    # S "We’re in contact."
    S "Estamos en contacto."

# game/script.rpy:4651

translate spanish spaceship_door_b10c2146:

    # r "Crackle Commander, do you read me? We're under attack. Armed hostiles."
    r "Comandante Crackle, entre, estamos bajo ataque, adversarios armados."

# game/script.rpy:4654

translate spanish spaceship_door_8002de03:

    # r "Don’t know who, but they're organized, and they’re pushing us back."
    r "No sé quiénes son, pero están trabajando juntos y empujandonos."

# game/script.rpy:4656

translate spanish spaceship_door_5348bd42:

    # r "HQ's dark. Might be jamming — signals are shot to hell. We’re blind out here."
    r "El cuartel general no responde. Posible interferencia; las señales están destrozadas. Estamos ciegos aquí fuera."

# game/script.rpy:4659

translate spanish spaceship_door_3934cb13:

    # ri "Something wrong?"
    ri "¿Pasa algo?"

# game/script.rpy:4663

translate spanish spaceship_door_ddb5f54a:

    # S "We under attack!"
    S "¡Estamos bajo ataque!"

# game/script.rpy:4665

translate spanish spaceship_door_239c46ee:

    # ri "Under attack? From who? What the hell’s happening?"
    ri "¿De quién? ¿Qué demonios está pasando?"

# game/script.rpy:4668

translate spanish spaceship_door_42a2847b:

    # S "No clue. But it’s real. And it’s bad."
    S "Sin idea. Pero es real. Y es malo."

# game/script.rpy:4669

translate spanish spaceship_door_3e657ffa:

    # S "We’ll hold them off. You move ahead. We’ll catch up when the smoke clears."
    S "Los mantendremos. Se mueve hacia adelante. Nos pondremos al día cuando el humo se despeja."

# game/script.rpy:4672

translate spanish spaceship_door_d532fcd8:

    # ri "You keep moving, we’ll handle things outside."
    ri "Sigue avanzando; nosotros nos encargamos de lo de fuera."

# game/script.rpy:4674

translate spanish spaceship_door_4bb16fc6:

    # h "So in the end, they ditched us — or we ditched them? Whatever, same result."
    h "Así que al final, nos dejaron, o los dejamos? Cualquier cosa, el mismo resultado."

# game/script.rpy:4691

translate spanish spaceship_door_ff09fd21:

    # h "Was it just me, or did that robot actually {b}follow{/b} them?"
    h "¿Era solo yo, o ese robot en realidad {b}seguir{/b} ¿Ellos?"

# game/script.rpy:4693

translate spanish spaceship_door_1d229b02:

    # mc "Nope. We both saw it. And it’s going with them."
    mc "No, ambos lo vimos, y va con ellos."

# game/script.rpy:4700

translate spanish spaceship_door_e09f155a:

    # mc "Alright. Let’s not stand here waiting for the next disaster. We move."
    mc "Bien. No nos quedemos aquí esperando el próximo desastre."

# game/script.rpy:4703

translate spanish spaceship_door_4c1225b5:

    # h "So what now? We just stare at this thing and hope it opens itself?"
    h "¿Y ahora qué? ¿Solo miramos esta cosa y esperamos que se abra?"

# game/script.rpy:4705

translate spanish spaceship_door_7052ef1c:

    # mc "Tempting. But we’ve got to actually {b}open{/b} it. No shortcuts."
    mc "Tentación, pero tenemos que hacerlo {b}abierto{/b} No hay atajos."

# game/script.rpy:4707

translate spanish spaceship_door_c2b651c0:

    # mc "By the way, Norman — you’ve been quiet. Everything alright?"
    mc "Por cierto, Norman, has estado callado. ¿Todo bien?"

# game/script.rpy:4709

translate spanish spaceship_door_db93544c:

    # N "Yeah, perfectly fine."
    N "Sí, perfectamente bien."

# game/script.rpy:4710

translate spanish spaceship_door_04e47ac9:

    # N "Just got this weird feeling... Like I’ve been here before."
    N "Tengo esta sensación rara... como si hubiera estado aquí antes."

# game/script.rpy:4712

translate spanish spaceship_door_2b35b6fe_4:

    # mc "..."
    mc "..."

# game/script.rpy:4714

translate spanish spaceship_door_16a40ea6:

    # mc "When did you start feeling that?"
    mc "¿Cuándo empezaste a sentir eso?"

# game/script.rpy:4720

translate spanish spaceship_door_1f224426:

    # N "Can’t really say, Dad."
    N "No puedo decir, papá."

# game/script.rpy:4722

translate spanish spaceship_door_a717a5ae:

    # h "Say, Norman... Do you even know how to shoot?"
    h "Norman... ¿Sabes disparar?"

# game/script.rpy:4723

translate spanish spaceship_door_ec14a935:

    # N "Nope."
    N "No."

# game/script.rpy:4724

translate spanish spaceship_door_029b96ea:

    # h "Then stay behind me. I’ll cover you if things go south."
    h "Entonces quédate detrás de mí. Te cubriré si las cosas van al sur."

# game/script.rpy:4726

translate spanish spaceship_door_52eab8a6:

    # mc "Everyone ready?"
    mc "¿Todos listos?"

# game/script.rpy:4728

translate spanish spaceship_door_81c9e1a1:

    # h "Of course. I can’t wait to blast someone’s ass with lead."
    h "Por supuesto. No puedo esperar a que alguien se despierte con el culo."

# game/script.rpy:4730

translate spanish spaceship_door_6d2c12dc:

    # N "I’ll do everything I can not to slow you down, Father."
    N "Haré todo lo que pueda para no retrasarte, Padre."

# game/script.rpy:4732

translate spanish spaceship_door_920d1d37:

    # mc "Alright. Let’s see what happens next."
    mc "Muy bien. Veamos qué sucede después."

# game/script.rpy:4737

translate spanish spaceship_door_2b35b6fe_5:

    # mc "..."
    mc "..."

# game/script.rpy:4747

translate spanish endoftheporolgue_b76dfd8f:

    # mc "What the hell is this thing…?"
    mc "¿Qué demonios es esta cosa?"

# game/script.rpy:4750

translate spanish endoftheporolgue_08472d57:

    # h "Of all things, a flying black hole was not what I expected to see today."
    h "De todas las cosas, un agujero negro volador no era lo que esperaba ver hoy."

# game/script.rpy:4753

translate spanish endoftheporolgue_f2f9908f:

    # N "No... That can't be. What is it doing here?"
    N "No, no puede ser. ¿Qué está haciendo aquí?"

# game/script.rpy:4755

translate spanish endoftheporolgue_b43e7000:

    # mc "Norman, do you know what this is?"
    mc "Norman, ¿sabes qué es esto?"

# game/script.rpy:4757

translate spanish endoftheporolgue_a29c2139:

    # N "Father, it’s what mom was working on... It’s a warp drive."
    N "Padre, es en lo que mamá estaba trabajando... es una unidad warp."

# game/script.rpy:4762

translate spanish endoftheporolgue_db6df0d5:

    # az "Still breathing? I’m impressed."
    az "¿Todavía respira? Estoy impresionado."

# game/script.rpy:4764

translate spanish endoftheporolgue_df99e898:

    # az "GREETINGS, my dear friends! Long time no see, wouldn’t you say?"
    az "¡Saludos, mis queridos amigos! Cuánto tiempo sin vernos, ¿no les parece?"

# game/script.rpy:4766

translate spanish endoftheporolgue_c7b77d8d:

    # az "Eight years. Long, grueling eight years."
    az "Ocho años, ocho años."

# game/script.rpy:4767

translate spanish endoftheporolgue_375f3498:

    # az "Yet it feels like yesterday, doesn’t it? {w=0.5}The screaming. {w=0.5}The fire. {w=0.5}The fall."
    az "Sin embargo, se siente como ayer, ¿no? {w=0.5}El grito. {w=0.5}El fuego. {w=0.5}La caída."

# game/script.rpy:4770

translate spanish endoftheporolgue_9b4af1b8:

    # h "You son of a bitch! It was you!"
    h "¡Eres un hijo de puta!"

# game/script.rpy:4771

translate spanish endoftheporolgue_0ca52ae5:

    # h "[mc] personally shot you, than how?!"
    h "[mc] personalmente te disparó, ¿que cómo?"

# game/script.rpy:4775

translate spanish endoftheporolgue_21baf1c9:

    # az "Oh, Olivia. Always so dramatic."
    az "Olivia, siempre tan dramática."

# game/script.rpy:4776

translate spanish endoftheporolgue_c6365205:

    # az "Yes, he killed me. Thoroughly, I might add."
    az "Sí, me mató, quizá agregue."

# game/script.rpy:4777

translate spanish endoftheporolgue_67f34dc5:

    # az "But death... it’s not as permanent as it used to be."
    az "Pero la muerte... no es tan permanente como solía ser."

# game/script.rpy:4780

translate spanish endoftheporolgue_b5df453a:

    # az "But I was wrong about one thing..."
    az "Pero estaba equivocado en una cosa..."

# game/script.rpy:4782

translate spanish endoftheporolgue_edcacd7b:

    # az "I thought you’d be happier to see me ret—"
    az "Pensé que serías más feliz al verme ret..."

# game/script.rpy:4790

translate spanish endoftheporolgue_ab932e06:

    # h "You should’ve stayed buried."
    h "Deberías haberte quedado enterrado."

# game/script.rpy:4792

translate spanish endoftheporolgue_92f1ae7e:

    # mc "Olivia — sweep the perimeter. I’ll check his body."
    mc "Olivia — barre el perímetro. Voy a revisar su cuerpo."

# game/script.rpy:4793

translate spanish endoftheporolgue_e216df8e:

    # mc "There might be something he didn’t mean to bring with him."
    mc "Puede que haya algo que no quiso traer con él."

# game/script.rpy:4796

translate spanish endoftheporolgue_14700663:

    # h "Alright, no problem. Just be careful. Knowing him, he wouldn’t go down that easily."
    h "Muy bien, no hay problema. Ten cuidado. Conociendolo, él no bajaría tan fácilmente."

# game/script.rpy:4798

translate spanish endoftheporolgue_874caa80:

    # N "Father, no! {w}He’s not dead!"
    N "¡Padre, no! {w}¡No está muerto!"

# game/script.rpy:4800

translate spanish endoftheporolgue_af607ee6:

    # mc "What are you talking about, Norman?"
    mc "¿De qué estás hablando, Norman?"

# game/script.rpy:4802

translate spanish endoftheporolgue_f4d6eb19:

    # N "The blood... He absorbed it. After that, he stopped being human."
    N "La sangre... la absorbió, después de eso dejó de ser humano."

# game/script.rpy:4806

translate spanish endoftheporolgue_ec74ac23:

    # az "You think this is over? That I didn’t see this coming?"
    az "¿Crees que esto ha terminado? ¿Que no vi venir esto?"

# game/script.rpy:4809

translate spanish endoftheporolgue_1f1e9af7:

    # az "Sweet naïveté. It’s what I missed most."
    az "Dulce ingenuidad. Es lo que más me perdí."

# game/script.rpy:4812

translate spanish endoftheporolgue_90a66b3e:

    # az "Ouch, that`s hurts..."
    az "Oh, eso duele..."

# game/script.rpy:4813

translate spanish endoftheporolgue_cd09e7a7:

    # az "But this took you long enough."
    az "Pero esto te llevó bastante tiempo."

# game/script.rpy:4816

translate spanish endoftheporolgue_57eaf32b:

    # mc "What... are you?"
    mc "¿Qué... eres?"

# game/script.rpy:4818

translate spanish endoftheporolgue_5290d57d:

    # az "A question I ask myself every night."
    az "Una pregunta que me hago cada noche."

# game/script.rpy:4819

translate spanish endoftheporolgue_9a3cc383:

    # az "But since you’re not leaving here alive, I suppose I can indulge you."
    az "Pero como no te vas con vida, supongo que puedo complacerte."

# game/script.rpy:4822

translate spanish endoftheporolgue_239ca491:

    # az "Once… I was a man. Just like you."
    az "Una vez... era un hombre, igual que tú."

# game/script.rpy:4823

translate spanish endoftheporolgue_5698c6c4:

    # az "But death... death shifts things. Breaks them."
    az "Pero la muerte cambia las cosas, las rompe."

# game/script.rpy:4826

translate spanish endoftheporolgue_8085b49c:

    # az "And my daughter — poor, faithful girl — made a deal."
    az "Y mi hija —la pobre y fiel— hizo un trato."

# game/script.rpy:4827

translate spanish endoftheporolgue_90a3c2f1:

    # az "I never saw the face. Could’ve been a god. Or a child. Or just a man who stopped blinking."
    az "Nunca vi la cara. Podría haber sido un dios o un niño. O un hombre que dejó de parpadear."

# game/script.rpy:4828

translate spanish endoftheporolgue_18002c07:

    # az "They told her, ‘We can bring him back.’. But since she had nothing to lose, she agreed."
    az "Le dijeron: \"Podemos traerlo de vuelta\". Pero como ella no tenía nada que perder, ella aceptó."

# game/script.rpy:4830

translate spanish endoftheporolgue_0caf93dd:

    # az "As a result, a few months later, I came back to life or rather, someone resembling me did."
    az "Como resultado, unos meses después, volví a la vida o más bien, alguien que me parecía lo hizo."

# game/script.rpy:4831

translate spanish endoftheporolgue_d7ea5733:

    # az "I’m not even sure if I’m the same person as before. I remember almost nothing."
    az "No estoy seguro si soy la misma persona que antes. Recuerdo casi nada."

# game/script.rpy:4832

translate spanish endoftheporolgue_797cf4df:

    # az "Except the fact that you killed me...."
    az "Excepto el hecho de que me mataste..."

# game/script.rpy:4834

translate spanish endoftheporolgue_beb76ef0:

    # az "It replays. Every night."
    az "Repeticiones, todas las noches."

# game/script.rpy:4835

translate spanish endoftheporolgue_a49e0133:

    # az "I shut my eyes and there it is — your hands, the fire, the end."
    az "Cerré los ojos y ahí está: tus manos, el fuego, el final."

# game/script.rpy:4837

translate spanish endoftheporolgue_4b40b446:

    # az "It’s driven me mad."
    az "Me ha vuelto loco."

# game/script.rpy:4838

translate spanish endoftheporolgue_04b7d2de:

    # az "But madness makes for excellent company."
    az "Pero la locura hace que la compañía sea excelente."

# game/script.rpy:4841

translate spanish endoftheporolgue_2c304750:

    # a "Back to your old stories again, little man?"
    a "¿Volver a tus viejas historias, hombrecito?"

# game/script.rpy:4843

translate spanish endoftheporolgue_2b893e0a:

    # a "And these people, they’re the ones we need to take care of?"
    a "¿Y estas personas son las que necesitamos cuidar?"

# game/script.rpy:4845

translate spanish endoftheporolgue_953626b0:

    # az "I asked you not to call me that. But yes, they are."
    az "Te pedí que no me llamaras así, pero sí, lo son."

# game/script.rpy:4847

translate spanish endoftheporolgue_9466e64c:

    # a "Don’t be upset, little man. We’ll keep our promise."
    a "No te enojes, hombrecito. Mantendremos nuestra promesa."

# game/script.rpy:4850

translate spanish endoftheporolgue_0185a244:

    # a "Time to see what he’s really made of."
    a "Hora de ver de qué está hecho."

# game/script.rpy:4852

translate spanish endoftheporolgue_06400ee5:

    # aa "Sir, why send him personally? You could’ve just had them shot."
    aa "Señor, ¿por qué lo envían personalmente? Podrías haberles disparado."

# game/script.rpy:4854

translate spanish endoftheporolgue_da0e97ea:

    # az "I’m curious to see what he’s capable of."
    az "Tengo curiosidad por ver de qué es capaz."

# game/script.rpy:4857

translate spanish endoftheporolgue_1cc13fd0:

    # aa "But si—"
    aa "Pero si..."

# game/script.rpy:4860

translate spanish endoftheporolgue_d8080f03:

    # az "I hate stupid questions."
    az "Odio las preguntas estúpidas."

# game/script.rpy:4863

translate spanish endoftheporolgue_b0d367ff:

    # h "What the hell is he made of?!"
    h "¿De qué diablos está hecho?!"

# game/script.rpy:4864

translate spanish endoftheporolgue_4e05ea7d:

    # mc "Aim for the weak spots. He’s got to have at least one vulnerability."
    mc "Objetivo para los puntos débiles. Tiene que tener al menos una vulnerabilidad."

# game/script.rpy:4866

translate spanish endoftheporolgue_d8c8bfc2:

    # h "I’m trying!"
    h "¡Lo estoy intentando!"

# game/script.rpy:4867

translate spanish endoftheporolgue_5445789a:

    # h "Out of ammo — cover me!"
