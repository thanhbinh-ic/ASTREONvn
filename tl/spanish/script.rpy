translate spanish exit_eee871f2:

    # h "You really stuffed it in there? This far back?"
    h "¿De verdad lo has metido ahí dentro?"

# game/script.rpy:3374

translate spanish exit_fe92b974:

    # h "...Wait."
    h "...espera."

# game/script.rpy:3377

translate spanish exit_e20fe815:

    # h "Why the hell is there a silencer on this?"
    h "¿Por qué demonios hay un silenciador en esto?"

# game/script.rpy:3379

translate spanish exit_f7fd16c0:

    # mc "Because it looked cool. Duh."
    mc "Porque parecía genial."

# game/script.rpy:3380

translate spanish exit_7df1a451:

    # mc "Take it off if you want. No one’s judging."
    mc "Quítatelo si quieres. Nadie está juzgando."

# game/script.rpy:3384

translate spanish exit_b089258f:

    # a "They’re speeding up. Can you slow them down?"
    a "Están acelerando. ¿Puedes retrasarlos?"

