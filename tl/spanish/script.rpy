# game/script.rpy:300
translate spanish start_1b4cdb69:

    # mc "(Organic... Teleportation...)"
    mc "(Orgánico... Teletransportación...)"

# game/script.rpy:301
translate spanish start_04d07738:

    # mc "(Sounds too close to our briefing.)"
    mc "(Suena demasiado parecido a nuestro informe.)"

# game/script.rpy:379
translate spanish start_73835c8c:

    # g "Keep your heads down, locals aren’t exactly friendly."
    g "Mantengan la cabeza baja, los locales no son precisamente amistosos."

# game/script.rpy:414
translate spanish start_8c9903a7:

    # S "Clear. I’ve got the scanner."
    S "Despejado. Tengo el escáner."

# game/script.rpy:440
translate spanish start_906360bb:

    # mc "(Satellite feed showed traffic here forty-eight hours ago.)"
    mc "(La señal satelital mostraba tráfico aquí hace cuarenta y ocho horas.)"

# game/script.rpy:441
translate spanish start_3fe6b56d:

    # mc "(Now nothing.)"
    mc "(Ahora nada.)"

# game/script.rpy:442
translate spanish start_0ebd9272:

    # mc "(No bodies. No blood. No evacuation trail.)"
    mc "(Sin cuerpos. Sin sangre. Sin rastro de evacuación.)"

# game/script.rpy:461
translate spanish start_41b5682e:

    # h "Place was brand new… and now it looks like it aged twenty years overnight."
    h "El lugar era nuevo... y ahora parece haber envejecido veinte años de la noche a la mañana."

# game/script.rpy:467
translate spanish start_f8e03c08:

    # mc "A few days ago we got a tip. Anonymous."
    mc "Hace unos días recibimos un aviso. Anónimo."

# game/script.rpy:470
translate spanish start_bc6c7580:

    # mc "At first HQ thought it was bait."
    mc "Al principio el cuartel general pensó que era una trampa."

# game/script.rpy:471
translate spanish start_aa7e09e2:

    # mc "Then the drone footage came in."
    mc "Luego llegaron las imágenes del dron."

# game/script.rpy:472
translate spanish start_5ef14c69:

    # mc "Whole blocks emptied overnight."
    mc "Manzanas enteras quedaron vacías de la noche a la mañana."

# game/script.rpy:477
translate spanish start_853e68a8:

    # mc "Only that the cargo contains an unknown substance."
    mc "Solo que la carga contiene una sustancia desconocida."

# game/script.rpy:478
translate spanish start_e4e9ca29:

    # mc "Unstable. Unknown origin."
    mc "Inestable. De origen desconocido."

# game/script.rpy:479
translate spanish start_b800ee21:

    # mc "And everyone who tried to inspect it either vanished..."
    mc "Y todos los que intentaron inspeccionarla desaparecieron..."

# game/script.rpy:491
translate spanish start_6aab3175:

    # mc "Yeah. We’re here. If HQ's timing is right, the deal goes down in a couple of hours."
    mc "Sí. Estamos aquí. Si el horario del cuartel general es correcto, el trato se hará en un par de horas."

# game/script.rpy:526
translate spanish war2_c126556f:

    # mc "(Thirty-six hours.)"
    mc "(Treinta y seis horas.)"

# game/script.rpy:528
translate spanish war2_15206aff:

    # mc "(Food left on tables, cars abandoned mid-street. Doors open.)"
    mc "(Comida abandonada en las mesas, coches dejados en mitad de la calle. Puertas abiertas.)"

# game/script.rpy:529
translate spanish war2_6f3e1322:

    # mc "(Like the whole city stood up at once...)"
    mc "(Como si toda la ciudad se hubiera levantado a la vez...)"

# game/script.rpy:682
translate spanish war2_21077d71:

    # x "Two days in this furnace and we’re still just sitting here?"
    x "¿Dos días en este horno y seguimos sentados aquí?"

# game/script.rpy:686
translate spanish war2_ee3115e4:

    # c "Speak English, or at least something we can understand!"
    c "¡Habla inglés, o al menos algo que podamos entender!"

# game/script.rpy:779
translate spanish war2_5457b2fe:

    # mc "HQ calls it a substance sample."
    mc "El cuartel general lo llama una muestra de sustancia."

# game/script.rpy:780
translate spanish war2_6d413b07:

    # m "Calls it?"
    m "¿Lo llama?"

# game/script.rpy:781
translate spanish war2_647fc96b:

    # mc "That's the problem. They don't know what it is."
    mc "Ese es el problema. No saben qué es."

# game/script.rpy:782
translate spanish war2_3942fc67:

    # mc "The city goes dark. Then the cargo appears."
    mc "La ciudad queda a oscuras. Luego aparece la carga."

# game/script.rpy:783
translate spanish war2_44743ce1:

    # x "A substance sample. Big deal. What’s all the fuss about?"
    x "Una muestra de sustancia. Gran cosa. ¿A qué viene tanto escándalo?"

# game/script.rpy:785
translate spanish war2_692c7f96:

    # mc "Scans detected its effect, not what it is."
    mc "Los escaneos detectaron su efecto, no lo que es."

# game/script.rpy:786
translate spanish war2_35bf6e1c:

    # mc "Not the source."
    mc "No la fuente."

# game/script.rpy:788
translate spanish war2_fca68246:

    # mc "Command is treating each unit like a weapon of mass destruction."
    mc "El mando está tratando cada unidad como un arma de destrucción masiva."

# game/script.rpy:789
translate spanish war2_4652c182:

    # x "Each one?"
    x "¿Cada una?"

# game/script.rpy:790
translate spanish war2_cf1adef2:

    # mc "Yeah."
    mc "Sí."

# game/script.rpy:791
translate spanish war2_b12706eb:

    # mc "And we don't know how many there are."
    mc "Y no sabemos cuántas hay."

# game/script.rpy:847
translate spanish war2_1d981af3:

    # S "Movement spotted to the east, two vehicles."
    S "Movimiento detectado al este, dos vehículos."

# game/script.rpy:852
translate spanish war2_423d5a46:

    # x "We can take them, just a handful of guys. Two volleys, and they’re done."
    x "Podemos con ellos, son solo un puñado. Dos descargas y se acabó."

# game/script.rpy:868
translate spanish war2_81837a17:

    # S "No outer perimeter either."
    S "Tampoco hay perímetro exterior."

# game/script.rpy:869
translate spanish war2_ac6eb6a6:

    # S "No scouts. No overwatch."
    S "Sin exploradores. Sin vigilancia elevada."

# game/script.rpy:870
translate spanish war2_daea382f:

    # S "For cargo this hot... that's wrong."
    S "Para una carga tan delicada... eso está mal."

# game/script.rpy:872
translate spanish war2_f975f778:

    # mc "(Either they're idiots...)"
    mc "(O son idiotas...)"

# game/script.rpy:873
translate spanish war2_be4902e0:

    # mc "(Or they know we're here.)"
    mc "(O saben que estamos aquí.)"

# game/script.rpy:891
translate spanish war2_43227143:

    # mc "(A scientist...)"
    mc "(Una científica...)"

# game/script.rpy:892
translate spanish war2_3c30c8cd:

    # "For a split second, every muscle in [mc]'s body tenses."
    "Durante una fracción de segundo, cada músculo del cuerpo de [mc] se tensa."

# game/script.rpy:893
translate spanish war2_1cf0007c:

    # mc "(That was...)"
    mc "(Eso fue...)"

# game/script.rpy:895
translate spanish war2_56cf5de7:

    # mc "(Lora's meeting. The substance. A vanished city.)"
    mc "(La reunión de Lora. La sustancia. Una ciudad desaparecida.)"

# game/script.rpy:896
translate spanish war2_21ee93b7:

    # "Slowly, he forces himself to relax."
    "Lentamente, se obliga a relajarse."

# game/script.rpy:897
translate spanish war2_8b044b4a:

    # mc "(Don't jump. Confirm first.)"
    mc "(No te precipites. Confirma primero.)"

# game/script.rpy:956
translate spanish war2_1556e3c2:

    # S "Commander..."
    S "Comandante..."

# game/script.rpy:957
translate spanish war2_a32b88cf:

    # S "I'm getting a spike from the case."
    S "Estoy recibiendo un pico desde el maletín."

# game/script.rpy:958
translate spanish war2_c158f764:

    # S "Radiation?"
    S "¿Radiación?"

# game/script.rpy:959
translate spanish war2_a8224bdc:

    # S "No. Not exactly."
    S "No. No exactamente."

# game/script.rpy:960
translate spanish war2_700825e4:

    # S "Whatever it is, it's bending the readings."
    S "Sea lo que sea, está deformando las lecturas."

# game/script.rpy:970
translate spanish war2_12b39bb2:

    # S "Negative. {w=0.6}Too much distortion."
    S "Negativo. {w=0.6}Demasiada distorsión."

# game/script.rpy:971
translate spanish war2_9d6f5ffe:

    # S "I don't have visual confirmation."
    S "No tengo confirmación visual."

# game/script.rpy:972
translate spanish war2_878dd5cc:

    # S "But the readings are real."
    S "Pero las lecturas son reales."

# game/script.rpy:973
translate spanish war2_93587b8a:

    # S "If that's bait, it's expensive bait."
    S "Si eso es un cebo, es un cebo caro."

# game/script.rpy:981
translate spanish war2_0c5aa402:

    # x "If that thing really is like a mass-destruction threat…"
    x "Si esa cosa realmente es una amenaza de destrucción masiva..."

# game/script.rpy:1008
translate spanish war2_5e708a66:

    # mc "(No visual.)"
    mc "(Sin visual.)"

# game/script.rpy:1009
translate spanish war2_766071a0:

    # mc "(No clean confirmation.)"
    mc "(Sin confirmación clara.)"

# game/script.rpy:1011
translate spanish war2_64bfde1c:

    # mc "(But if that signal is real and we let it leave...)"
    mc "(Pero si esa señal es real y dejamos que se vaya...)"

# game/script.rpy:1012
translate spanish war2_8012bc33:

    # mc "(Millions die.)"
    mc "(Morirán millones.)"

# game/script.rpy:1015
translate spanish war2_3dc3f4dc:

    # mc "(Orders were clear.)"
    mc "(Las órdenes fueron claras.)"

# game/script.rpy:1016
translate spanish war2_c7865ad2:

    # mc "(Once the transfer starts, containment overrides confirmation.)"
    mc "(Una vez que empiece la transferencia, la contención tendrá prioridad sobre la confirmación.)"

# game/script.rpy:1098
translate spanish war2_0a1c8663:

    # m "I'm not sure this is what we were looking for."
    m "No estoy segura de que esto sea lo que buscábamos."

# game/script.rpy:1102
translate spanish war2_f1398962:

    # m "There's no core. No cell."
    m "No hay núcleo. No hay celda."

# game/script.rpy:1103
translate spanish war2_102367c9:

    # m "Just a sealed vial inside the case."
    m "Solo un vial sellado dentro del maletín."

# game/script.rpy:1104
translate spanish war2_b7f1fda9:

    # m "Some kind of liquid."
    m "Algún tipo de líquido."

# game/script.rpy:1106
translate spanish war2_fce1dfb9:

    # mc "Liquid?"
    mc "¿Líquido?"

# game/script.rpy:1151
translate spanish street_4480512e:

    # mc "(Twenty years...)"
    mc "(Veinte años...)"

# game/script.rpy:1152
translate spanish street_032594f9:

    # mc "(Empty streets. Dead signal. The case.)"
    mc "(Calles vacías. Señal muerta. El maletín.)"

# game/script.rpy:1153
translate spanish street_769d957e:

    # mc "(Mona's voice—)"
    mc "(La voz de Mona—)"

# game/script.rpy:1154
translate spanish street_95ffbff4:

    # mc "(Some kind of liquid.)"
    mc "(Algún tipo de líquido.)"

# game/script.rpy:1155
translate spanish street_5c2f4836:

    # mc "(Then fire.)"
    mc "(Luego fuego.)"

# game/script.rpy:1173
translate spanish street_9d800594:

    # mc "(He'll be here soon.)"
    mc "(Pronto estará aquí.)"

# game/script.rpy:1215
translate spanish street_07fa89c6:

    # mc "(Substance.)"
    mc "(Sustancia.)"

# game/script.rpy:1216
translate spanish street_6f391176:

    # mc "(Twenty years ago it was a vial in a case.)"
    mc "(Hace veinte años era un vial dentro de un maletín.)"

# game/script.rpy:1217
translate spanish street_3184f826:

    # mc "(Now it's a miracle on live TV.)"
    mc "(Ahora es un milagro en televisión en directo.)"

# game/script.rpy:1400
translate spanish street_4fddf709:

    # mc "(Teleportation. Regeneration.)"
    mc "(Teletransportación. Regeneración.)"

# game/script.rpy:1401
translate spanish street_0fbfd415:

    # mc "(Same project. New packaging.)"
    mc "(El mismo proyecto. Nuevo envoltorio.)"

# game/script.rpy:1422
translate spanish street_ad2f4ab6:

    # mc "(Eight years since you vanished.)"
    mc "(Ocho años desde que desapareciste.)"

# game/script.rpy:1427
translate spanish street_a441ebb4:

    # mc "(Twenty years since Al-Zahira.)"
    mc "(Veinte años desde Al-Zahira.)"

# game/script.rpy:1428
translate spanish street_290d791d:

    # mc "(Different years. Same damn pattern.)"
    mc "(Años distintos. El mismo maldito patrón.)"

# game/script.rpy:1558
translate spanish street_1756220f:

    # A "Every time I ask, he says it's classified."
    A "Cada vez que pregunto, dice que es clasificado."

# game/script.rpy:1559
translate spanish street_91d9b536:

    # A "Which would sound cooler if it didn't keep stealing him from us."
    A "Lo cual sonaría más genial si no siguiera robándonoslo."

# game/script.rpy:1562
translate spanish street_41e3070d:

    # mc "(Classified...)"
    mc "(Clasificado...)"

# game/script.rpy:1563
translate spanish street_47b6c65f:

    # mc "(Of course.)"
    mc "(Por supuesto.)"

# game/script.rpy:1781
translate spanish homedinner_607859b4:

    # A "Mina..."
    A "Mina..."

# game/script.rpy:1782
translate spanish homedinner_ec175217:

    # A "Not at dinner, sweetheart."
    A "No durante la cena, cariño."

# game/script.rpy:1808
translate spanish homedinner_8ec09c22:

    # gg "Everyone we’ve found so far is dead."
    gg "Todos los que hemos encontrado hasta ahora están muertos."

# game/script.rpy:1915
translate spanish homedinner_5fdd4e69:

    # N "We didn't go deep."
    N "No nos adentramos mucho."

# game/script.rpy:1916
translate spanish homedinner_9eafeb7c:

    # N "I swear."
    N "Lo juro."

# game/script.rpy:1917
translate spanish homedinner_0d53a0ca:

    # N "Just the public trail."
    N "Solo el sendero público."

# game/script.rpy:1918
translate spanish homedinner_6775768b:

    # N "The memorial side."
    N "La zona del memorial."

# game/script.rpy:1919
translate spanish homedinner_5ee15487:

    # N "People go there now, Dad."
    N "La gente va allí ahora, papá."

# game/script.rpy:1921
translate spanish homedinner_cd96de69:

    # N "I thought if I could stand there without breaking..."
    N "Pensé que si yo podía estar allí sin derrumbarme..."

# game/script.rpy:1922
translate spanish homedinner_87666cc9:

    # N "maybe you could, too."
    N "quizá tú también podrías."

# game/script.rpy:1927
translate spanish homedinner_d9764f18:

    # M "Dad said maybe there was still something there..."
    M "Papá dijo que quizá todavía había algo allí..."

# game/script.rpy:1928
translate spanish homedinner_708ddb5b:

    # M "Not in the scary part!"
    M "¡No en la parte aterradora!"

# game/script.rpy:1929
translate spanish homedinner_f116f32d:

    # M "Just... near the old sign."
    M "Solo... cerca del viejo letrero."

# game/script.rpy:2067
translate spanish homedinner_1b4b134c:

    # L "...Because if he knew, he'd come with us."
    L "...Porque si lo supiera, vendría con nosotros."

# game/script.rpy:2068
translate spanish homedinner_5f824244:

    # L "And if he came with us..."
    L "Y si viniera con nosotros..."

# game/script.rpy:2069
translate spanish homedinner_072d6c67:

    # L "They'd treat him like a breach."
    L "Lo tratarían como una brecha."

# game/script.rpy:2070
translate spanish homedinner_20ff942a:

    # L "A soldier with combat clearance, walking into a black project?"
    L "¿Un soldado con autorización de combate entrando en un proyecto negro?"

# game/script.rpy:2071
translate spanish homedinner_5ce1391f:

    # L "No one down there would let that slide."
    L "Nadie allí abajo dejaría pasar eso."

# game/script.rpy:2072
translate spanish homedinner_f09ec349:

    # N "But they let me in?"
    N "¿Pero a mí me dejarían entrar?"

# game/script.rpy:2073
translate spanish homedinner_e042b707:

    # L "You're my son."
    L "Eres mi hijo."

# game/script.rpy:2074
translate spanish homedinner_51491343:

    # L "On paper, you're a dependent under my responsibility."
    L "Sobre el papel, eres un dependiente bajo mi responsabilidad."

# game/script.rpy:2075
translate spanish homedinner_c103c6d1:

    # L "As long as you stay beside me, you're not a threat to them."
    L "Mientras permanezcas a mi lado, no eres una amenaza para ellos."

# game/script.rpy:2076
translate spanish homedinner_6ebff622:

    # L "You're leverage they don't have to take."
    L "Eres una forma de presión que no tienen que buscar."

# game/script.rpy:2077
translate spanish homedinner_63276998:

    # L "Your father would be different."
    L "Tu padre sería distinto."

# game/script.rpy:2078
translate spanish homedinner_19126210:

    # L "He'd ask questions. Push back. Reach for his gun if someone looked at us wrong."
    L "Haría preguntas. Se resistiría. Iría por su arma si alguien nos mirara mal."

# game/script.rpy:2079
translate spanish homedinner_4b7255ec:

    # L "And then I'd have to choose between saving him… and exposing everything."
    L "Y entonces tendría que elegir entre salvarlo... y exponerlo todo."

# game/script.rpy:2082
translate spanish homedinner_77f9c83e:

    # N "So it's dangerous?"
    N "¿Entonces es peligroso?"

# game/script.rpy:2083
translate spanish homedinner_5da94d85:

    # L "It might be."
    L "Podría serlo."

# game/script.rpy:2084
translate spanish homedinner_a84147c7:

    # L "That's why I need you to stay close."
    L "Por eso necesito que te quedes cerca."

# game/script.rpy:2085
translate spanish homedinner_4ed3dc9c:

    # L "And listen to everything I say."
    L "Y que escuches todo lo que digo."

# game/script.rpy:2086
translate spanish homedinner_ade9687e:

    # N "Mom..."
    N "Mamá..."

# game/script.rpy:2087
translate spanish homedinner_4bff1c62:

    # L "I know."
    L "Lo sé."

# game/script.rpy:2088
translate spanish homedinner_8509c81e:

    # L "I would never bring you here if I had another choice."
    L "Nunca te habría traído aquí si tuviera otra opción."

# game/script.rpy:2091
translate spanish homedinner_85d1b1e7:

    # L "(softly) This is the only way I can keep them both out of it..."
    L "(en voz baja) Esta es la única forma de mantenerlos a los dos fuera de esto..."

# game/script.rpy:2097
translate spanish homedinner_8ad30580:

    # N "The public trail isn't the place Mom took me."
    N "El sendero público no es el lugar al que mamá me llevó."

# game/script.rpy:2098
translate spanish homedinner_8fd6fb88:

    # N "There was another way."
    N "Había otro camino."

# game/script.rpy:2099
translate spanish homedinner_056e1b5f:

    # N "Past the old service road."
    N "Más allá de la vieja carretera de servicio."

# game/script.rpy:2100
translate spanish homedinner_ca247b4c:

    # N "A place no tourist would ever find."
    N "Un lugar que ningún turista encontraría jamás."

# game/script.rpy:2102
translate spanish homedinner_b4c5b797:

    # mc "And you never told me?"
    mc "¿Y nunca me lo dijiste?"

# game/script.rpy:2104
translate spanish homedinner_d67d6d9a:

    # N "...No."
    N "...No."

# game/script.rpy:2105
translate spanish homedinner_8f5426cf:

    # N "I was scared."
    N "Tenía miedo."

# game/script.rpy:2106
translate spanish homedinner_c7bfd441:

    # N "And after 2030..."
    N "Y después de 2030..."

# game/script.rpy:2107
translate spanish homedinner_3afff267:

    # N "I convinced myself maybe it was better buried."
    N "Me convencí de que quizá era mejor dejarlo enterrado."

# game/script.rpy:2109
translate spanish homedinner_8d0f132b_1:

    # mc "Norman..."
    mc "Norman..."

# game/script.rpy:2111
translate spanish homedinner_533522e2:

    # N "That's the part I kept from you."
    N "Esa es la parte que te oculté."

# game/script.rpy:2170
translate spanish homedinner_3ec0c45f:

    # L "He stays with me until we're done."
    L "Se queda conmigo hasta que terminemos."

# game/script.rpy:2173
translate spanish homedinner_99b22258:

    # R "Unusual choice."
    R "Una elección inusual."

# game/script.rpy:2174
translate spanish homedinner_7afa7fb5:

    # L "Necessary one."
    L "Una necesaria."

# game/script.rpy:2203
translate spanish homedinner_bc76fb59:

    # s "And the board wants the sample secured before nightfall."
    s "Y la junta quiere la muestra asegurada antes del anochecer."

# game/script.rpy:2229
translate spanish homedinner_22b4a839:

    # N "A substance, I think."
    N "Una sustancia, creo."

# game/script.rpy:2240
translate spanish homedinner_3363fcce:

    # N "I didn't understand it back then."
    N "En aquel entonces no lo entendía."

# game/script.rpy:2241
translate spanish homedinner_c5294ef2:

    # N "Only that the sample wasn't the project."
    N "Solo que la muestra no era el proyecto."

# game/script.rpy:2242
translate spanish homedinner_645c0947:

    # N "It was feeding the project."
    N "Estaba alimentando el proyecto."

# game/script.rpy:2263
translate spanish homedinner_0e631e38:

    # L "I’m trying to understand why it works."
    L "Estoy intentando entender por qué funciona."

# game/script.rpy:2265
translate spanish homedinner_53747ce9:

    # L "Because if we don't..."
    L "Porque si no lo hacemos..."

# game/script.rpy:2269
translate spanish homedinner_e5dc7970:

    # L "Someone else will use it anyway."
    L "Alguien más la usará de todos modos."

# game/script.rpy:2272
translate spanish homedinner_d1ba8ebf:

    # R "That's not science, Mrs. Lora."
    R "Eso no es ciencia, señora Lora."

# game/script.rpy:2273
translate spanish homedinner_efb0214b:

    # R "That's fear."
    R "Eso es miedo."

# game/script.rpy:2274
translate spanish homedinner_5d10b4bc:

    # L "Maybe."
    L "Quizá."

# game/script.rpy:2346
translate spanish homedinner_9da6cc06:

    # N "It wasn't my choice… not really."
    N "No fue mi elección... no realmente."

# game/script.rpy:2347
translate spanish homedinner_b7c4f254:

    # N "At first it was just messages."
    N "Al principio solo eran mensajes."

# game/script.rpy:2348
translate spanish homedinner_1097012b:

    # N "Coordinates. Old photos. Things about Mom no stranger should know."
    N "Coordenadas. Fotos antiguas. Cosas sobre mamá que ningún desconocido debería saber."

# game/script.rpy:2349
translate spanish homedinner_2a3e24eb:

    # N "Then I saw him."
    N "Luego lo vi."

# game/script.rpy:2350
translate spanish homedinner_2b888d75:

    # mc "Him?"
    mc "¿A él?"

# game/script.rpy:2354
translate spanish homedinner_4c540731:

    # N "He gave me Mom's necklace."
    N "Me dio el collar de mamá."

# game/script.rpy:2355
translate spanish homedinner_785e64ab:

    # N "Said you'd know what it meant."
    N "Dijo que tú sabrías qué significaba."

# game/script.rpy:2440
translate spanish homedinner_60fafa63:

    # N "This one didn't come from him."
    N "Este no vino de él."

# game/script.rpy:2441
translate spanish homedinner_937f9e33:

    # N "My handler passed this along."
    N "Mi contacto me lo hizo llegar."

# game/script.rpy:2442
translate spanish homedinner_a1a568aa:

    # N "She said it came from an old friend of yours."
    N "Dijo que venía de una vieja amiga tuya."

# game/script.rpy:2581
translate spanish anna_c1a00a18:

    # Lor "Remember what I told you?"
    Lor "¿Recuerdas lo que te dije?"

# game/script.rpy:2582
translate spanish anna_08c279ab:

    # Lor "When someone needs a hand..."
    Lor "Cuando alguien necesita ayuda..."

# game/script.rpy:2583
translate spanish anna_91fd7b3d:

    # mc "Don't push them away."
    mc "No lo apartes."

# game/script.rpy:2584
translate spanish anna_c127961d:

    # Lor "Exactly."
    Lor "Exacto."

# game/script.rpy:2585
translate spanish anna_fc3cb421:

    # mc "Tho..."
    mc "Aunque..."

# game/script.rpy:2929
translate spanish anna_b33d3241:

    # mc "You look steady."
    mc "Te ves estable."

# game/script.rpy:2931
translate spanish anna_351aed3a:

    # x "Best prosthetic money can buy, hermano."
    x "La mejor prótesis que el dinero puede comprar, hermano."

# game/script.rpy:2932
translate spanish anna_58d77330:

    # x "Still complains when it rains, though."
    x "Aunque todavía se queja cuando llueve."

# game/script.rpy:2933
translate spanish anna_e747de4d:

    # x "But hey. Could've been worse."
    x "Pero bueno. Pudo haber sido peor."

# game/script.rpy:2935
translate spanish anna_cf1adef2_1:

    # mc "Yeah."
    mc "Sí."

# game/script.rpy:2936
translate spanish anna_631111f4:

    # x "Mona and Jack didn't get to complain."
    x "Mona y Jack no tuvieron oportunidad de quejarse."

# game/script.rpy:3182
translate spanish bar_olivica_4acfd547:

    # mc "Before that..."
    mc "Antes de eso..."

# game/script.rpy:3183
translate spanish bar_olivica_0fe2b219:

    # mc "Anya ran into trouble outside."
    mc "Anya tuvo problemas afuera."

# game/script.rpy:3185
translate spanish bar_olivica_26681431:

    # h "What kind of trouble?"
    h "¿Qué clase de problemas?"

# game/script.rpy:3187
translate spanish bar_olivica_7177233e:

    # mc "The kind where someone wanted her alive."
    mc "De los que implican que alguien la quería viva."

# game/script.rpy:3188
translate spanish bar_olivica_53296d3c:

    # mc "As leverage."
    mc "Como presión."

# game/script.rpy:3191
translate spanish bar_olivica_9ad006ae:

    # h "Who?"
    h "¿Quién?"

# game/script.rpy:3195
translate spanish bar_olivica_1d89acc9:

    # mc "Didn't get a name."
    mc "No conseguí un nombre."

# game/script.rpy:3196
translate spanish bar_olivica_f7faa546:

    # mc "But they knew she was your sister."
    mc "Pero sabían que era tu hermana."

# game/script.rpy:3198
translate spanish bar_olivica_1bc33fea:

    # h "Old business."
    h "Asuntos viejos."

# game/script.rpy:3199
translate spanish bar_olivica_62e48b8d:

    # h "Don't worry about it. I'll make a couple of calls later."
    h "No te preocupes por eso. Haré un par de llamadas más tarde."

# game/script.rpy:3251
translate spanish bar_olivica_bb3d3a29:

    # h "Don't do that."
    h "No hagas eso."

# game/script.rpy:3252
translate spanish bar_olivica_94507c05:

    # mc "Do what?"
    mc "¿Hacer qué?"

# game/script.rpy:3253
translate spanish bar_olivica_790db0bb:

    # h "Sound hopeful."
    h "Sonar esperanzado."

# game/script.rpy:3255
translate spanish bar_olivica_667eaaba:

    # mc "Too late."
    mc "Demasiado tarde."

# game/script.rpy:3256
translate spanish bar_olivica_455625a9:

    # "An awkward silence settles between them."
    "Un silencio incómodo se instala entre ellos."

# game/script.rpy:3277
translate spanish bar_olivica_2fded262_7:

    # h "..."
    h "..."

# game/script.rpy:3291
translate spanish bar_olivica_3496291e:

    # mc "It came with coordinates."
    mc "Venía con coordenadas."

# game/script.rpy:3292
translate spanish bar_olivica_c815f19b:

    # mc "And a photo no one should be able to take."
    mc "Y una foto que nadie debería poder tomar."

# game/script.rpy:3341
translate spanish bar_olivica_4499ebe1:

    # h "Yeah, the idea of bringing Lora back sounds nice."
    h "Sí, la idea de traer de vuelta a Lora suena bien."

# game/script.rpy:3342
translate spanish bar_olivica_3659234f:

    # h "Too nice."
    h "Demasiado bien."

# game/script.rpy:3350
translate spanish bar_olivica_583f9be8:

    # h "You finally have Norman back in the room with you."
    h "Por fin tienes a Norman de vuelta en la misma habitación contigo."

# game/script.rpy:3351
translate spanish bar_olivica_368f69a8:

    # h "You have a granddaughter who thinks you hung the moon."
    h "Tienes una nieta que cree que colgaste la luna."

# game/script.rpy:3352
translate spanish bar_olivica_c96d2705:

    # h "And you're about to walk into the same fire again."
    h "Y estás a punto de entrar otra vez en el mismo fuego."

# game/script.rpy:3353
translate spanish bar_olivica_5b178ae7:

    # h "Trust me, even that doesn't last forever."
    h "Créeme, ni siquiera eso dura para siempre."

# game/script.rpy:3360
translate spanish bar_olivica_05a4b8b0:

    # mc "But if there’s even a chance that photo is real..."
    mc "Pero si existe siquiera una posibilidad de que esa foto sea real..."

# game/script.rpy:3361
translate spanish bar_olivica_688285df:

    # mc "I have to know."
    mc "Tengo que saberlo."

# game/script.rpy:3380
translate spanish bar_olivica_34336037:

    # C "Those guys from earlier?"
    C "¿Los tipos de antes?"

# game/script.rpy:3381
translate spanish bar_olivica_7121afe9:

    # C "Someone paid their boss to make noise here."
    C "Alguien le pagó a su jefe para armar ruido aquí."

# game/script.rpy:3588
translate spanish norman_home_0a966fad:

    # mc "The public trail?"
    mc "¿El sendero público?"

# game/script.rpy:3591
translate spanish norman_home_5e36508b:

    # N "No."
    N "No."

# game/script.rpy:3592
translate spanish norman_home_533a5c58:

    # N "The place Mom took me."
    N "El lugar al que mamá me llevó."

# game/script.rpy:3593
translate spanish norman_home_056e1b5f:

    # N "Past the old service road."
    N "Más allá de la vieja carretera de servicio."

# game/script.rpy:3594
translate spanish norman_home_61828e19:

    # N "Your coordinates won't get you through that part."
    N "Tus coordenadas no te harán pasar por esa parte."

# game/script.rpy:3597
translate spanish norman_home_31de6330:

    # mc "You should've opened with that."
    mc "Deberías haber empezado por eso."

# game/script.rpy:3599
translate spanish norman_home_5fb7a3fa:

    # N "I thought you'd go without me."
    N "Pensé que irías sin mí."

# game/script.rpy:3718
translate spanish norman_home_880b9715:

    # mc "(To the grave I built for you.)"
    mc "(A la tumba que construí para ti.)"

# game/script.rpy:3728
translate spanish norman_home_c2168695:

    # Lor "For finally facing it."
    Lor "Por enfrentarlo al fin."

# game/script.rpy:3750
translate spanish norman_home_acb619c0:

    # mc "(The case.)"
    mc "(El maletín.)"

# game/script.rpy:3751
translate spanish norman_home_42d81e4b:

    # mc "(No core. No cell.)"
    mc "(Sin núcleo. Sin celda.)"

# game/script.rpy:3752
translate spanish norman_home_ff571a1b:

    # mc "(Just that liquid.)"
    mc "(Solo ese líquido.)"

# game/script.rpy:3756
translate spanish norman_home_b6fc01a3:

    # mc "(Same pattern. Different place.)"
    mc "(El mismo patrón. Otro lugar.)"

# game/script.rpy:3771
translate spanish norman_home_6c1a055e:

    # mc "(Not just a lab.)"
    mc "(No solo un laboratorio.)"

# game/script.rpy:3857
translate spanish norman_home_229f9586:

    # h "And if Azarkhan really is breathing again..."
    h "Y si Azarkhan realmente vuelve a respirar..."

# game/script.rpy:3858
translate spanish norman_home_cb80046a:

    # h "Waiting for him to knock would be even dumber."
    h "Esperar a que llame a la puerta sería aún más estúpido."

# game/script.rpy:3869
translate spanish norman_home_023b0517:

    # h "And no hero crap."
    h "Y nada de tonterías heroicas."

# game/script.rpy:3870
translate spanish norman_home_77334a77:

    # h "If anyone asks for you by name, you call Kayla."
    h "Si alguien pregunta por ti por tu nombre, llamas a Kayla."

# game/script.rpy:3871
translate spanish norman_home_0b021fcb:

    # C "Because of those guys?"
    C "¿Por esos tipos?"

# game/script.rpy:3872
translate spanish norman_home_890e67f4:

    # h "Because I said so."
    h "Porque lo digo yo."

# game/script.rpy:4051
translate spanish exit_26d191fe:

    # h "Wait… That's Norman? Don’t tell me we’ve got more company."
    h "Espera... ¿Ese es Norman? No me digas que tenemos más compañía."

# game/script.rpy:4059
translate spanish exit_e9b51473:

    # h "Absolutely not."
    h "De ninguna manera."

# game/script.rpy:4060
translate spanish exit_98b33eb1:

    # h "Tell me you're joking."
    h "Dime que estás bromeando."

# game/script.rpy:4061
translate spanish exit_742c8716:

    # mc "I'm not."
    mc "No."

# game/script.rpy:4063
translate spanish exit_3c58da68:

    # h "He trained?"
    h "¿Está entrenado?"

# game/script.rpy:4064
translate spanish exit_fca52711_1:

    # mc "No."
    mc "No."

# game/script.rpy:4065
translate spanish exit_c5785647:

    # h "Then why the hell is he coming?"
    h "Entonces, ¿por qué demonios viene?"

# game/script.rpy:4067
translate spanish exit_3457b068:

    # mc "Because he knows a way in."
    mc "Porque conoce una forma de entrar."

# game/script.rpy:4068
translate spanish exit_3c1cd138:

    # mc "A part of the forest Richard's coordinates won't get us through."
    mc "Una parte del bosque por la que las coordenadas de Richard no nos harán pasar."

# game/script.rpy:4076
translate spanish exit_56351196:

    # N "We'll be back before you get tired of missing me."
    N "Volveremos antes de que te canses de echarme de menos."

# game/script.rpy:4220
translate spanish exit_4f984fc7:

    # mc "Lora says I do this too often."
    mc "Lora dice que hago esto demasiado a menudo."

# game/script.rpy:4223
translate spanish exit_5a78e9e9:

    # h "...Who's Lora?"
    h "...¿Quién es Lora?"

# game/script.rpy:4224
translate spanish exit_52e46b6e:

    # mc "Someone who'd probably bring you soup and lecture me for leaving you in the rain."
    mc "Alguien que probablemente te traería sopa y me daría un sermón por dejarte bajo la lluvia."

# game/script.rpy:4293
translate spanish exit_e50c7b73:

    # a "If we don’t do something, we’ll lose the target!"
    a "¡Si no hacemos algo, perderemos el objetivo!"

# game/script.rpy:4375
translate spanish jungle_1d38f747:

    # h "They were watching us."
    h "Nos estaban vigilando."

# game/script.rpy:4376
translate spanish jungle_9c440d56:

    # h "Then one idiot panicked and turned it into a firefight."
    h "Luego un idiota entró en pánico y lo convirtió en un tiroteo."

# game/script.rpy:4377
translate spanish jungle_5d56e671:

    # h "Why?"
    h "¿Por qué?"

# game/script.rpy:4379
translate spanish jungle_18173c7d:

    # mc "Because we got too close."
    mc "Porque nos acercamos demasiado."

# game/script.rpy:4380
translate spanish jungle_d0b4e1e9:

    # mc "Or because they couldn't afford to lose us."
    mc "O porque no podían permitirse perdernos."

# game/script.rpy:4388
translate spanish jungle_fda6f41e:

    # mc "But Olivia's right."
    mc "Pero Olivia tiene razón."

# game/script.rpy:4389
translate spanish jungle_f694ac67:

    # mc "That wasn't a clean hit."
    mc "Eso no fue un golpe limpio."

# game/script.rpy:4390
translate spanish jungle_00950657:

    # mc "That was surveillance gone bad."
    mc "Fue una vigilancia que salió mal."

# game/script.rpy:4417
translate spanish jungle_deaf1f75:

    # N "My supervisor."
    N "Mi supervisora."

# game/script.rpy:4418
translate spanish jungle_e507a460:

    # N "Shiya Gray."
    N "Shiya Gray."

# game/script.rpy:4420
translate spanish jungle_69da11c5:

    # h "Wait."
    h "Espera."

# game/script.rpy:4421
translate spanish jungle_5df131df:

    # h "Gray?"
    h "¿Gray?"

# game/script.rpy:4423
translate spanish jungle_76b41278:

    # mc "Richard's daughter."
    mc "La hija de Richard."

# game/script.rpy:4424
translate spanish jungle_41f53a52:

    # N "...You know her?"
    N "...¿La conoces?"

# game/script.rpy:4425
translate spanish jungle_610e1ad0:

    # mc "Long story."
    mc "Larga historia."

# game/script.rpy:4553
translate spanish jungle_b982c7d0:

    # mc "(Same silence as Al-Zahira.)"
    mc "(El mismo silencio que en Al-Zahira.)"

# game/script.rpy:4585
translate spanish jungle_c2e0153a:

    # mc "Because the coordinates only get us close."
    mc "Porque las coordenadas solo nos acercan."

# game/script.rpy:4586
translate spanish jungle_d9ed78fe:

    # mc "Norman knows the rest."
    mc "Norman conoce el resto."

# game/script.rpy:4587
translate spanish jungle_6b8ffa93:

    # mc "And yes, I tried to talk him out of it."
    mc "Y sí, intenté convencerlo de que no viniera."

# game/script.rpy:4588
translate spanish jungle_d986505d:

    # mc "Didn't work."
    mc "No funcionó."

# game/script.rpy:4614
translate spanish jungle_7c19ff96:

    # mc "He knows the old service route."
    mc "Conoce la vieja ruta de servicio."

# game/script.rpy:4615
translate spanish jungle_6eea1693:

    # mc "The one Lora used."
    mc "La que usó Lora."

# game/script.rpy:4770
translate spanish junglenext_b7e04bb3:

    # mc "Because this time there was proof."
    mc "Porque esta vez había pruebas."

# game/script.rpy:4771
translate spanish junglenext_d732b893:

    # mc "And because if I ignored it..."
    mc "Y porque si lo ignoraba..."

# game/script.rpy:4772
translate spanish junglenext_d2db5920:

    # mc "I'd spend whatever's left of my life wondering."
    mc "Pasaría lo que me quedara de vida preguntándomelo."

# game/script.rpy:4834
translate spanish junglenext_061760bf:

    # mc "You were using my son."
    mc "Estabas usando a mi hijo."

# game/script.rpy:4835
translate spanish junglenext_8ecad07b:

    # S "I was keeping him alive."
    S "Lo mantenía con vida."

# game/script.rpy:4836
translate spanish junglenext_12cb4e23:

    # S "And before you ask, yes, he was necessary."
    S "Y antes de que preguntes, sí, era necesario."

# game/script.rpy:4837
translate spanish junglenext_1e0407bc:

    # S "The coordinates only bring people close."
    S "Las coordenadas solo acercan a la gente."

# game/script.rpy:4838
translate spanish junglenext_9729b4aa:

    # S "Without Norman's memory of the old service route, you'd still be walking in circles."
    S "Sin el recuerdo de Norman de la vieja ruta de servicio, seguirían caminando en círculos."

# game/script.rpy:4840
translate spanish junglenext_34f46930:

    # S "Oh, right..."
    S "Ah, cierto..."

# game/script.rpy:4880
translate spanish junglenext_0c53c0e9:

    # S "(Whispering) So they finally pointed you at the ship."
    S "(Susurrando) Así que por fin te señalaron la nave."

# game/script.rpy:4929
translate spanish spaceship_a518e7b3:

    # h "And now what, we’ve got uninvited guests from space?"
    h "¿Y ahora qué, tenemos invitados no deseados del espacio?"

# game/script.rpy:4942
translate spanish spaceship_0fbb6707:

    # ri "Three years ago, we found the ship itself."
    ri "Hace tres años encontramos la nave en sí."

# game/script.rpy:4943
translate spanish spaceship_d08ad9ef:

    # ri "Before that, all we had was the old facility above it."
    ri "Antes de eso, todo lo que teníamos era la vieja instalación encima de ella."

# game/script.rpy:4944
translate spanish spaceship_9cfb1ad7:

    # ri "We thought the lab was the source."
    ri "Pensábamos que el laboratorio era la fuente."

# game/script.rpy:4946
translate spanish spaceship_0b7745ee:

    # ri "The lab was built around this."
    ri "El laboratorio fue construido alrededor de esto."

# game/script.rpy:4947
translate spanish spaceship_6405ec3b:

    # ri "But the part about you came later."
    ri "Pero la parte sobre ti vino después."

# game/script.rpy:4948
translate spanish spaceship_e6c4ffe2:

    # ri "Much later."
    ri "Mucho después."

# game/script.rpy:4949
translate spanish spaceship_36e36bb3:

    # ri "The ship ignored us for years."
    ri "La nave nos ignoró durante años."

# game/script.rpy:4950
translate spanish spaceship_0c4acf06:

    # ri "Only recently did we connect its reaction to what got into your blood in Al-Zahira."
    ri "Solo hace poco relacionamos su reacción con lo que entró en tu sangre en Al-Zahira."

# game/script.rpy:4962
translate spanish spaceship_d75efcc0:

    # ri "Because you’re the only person still alive who might know anything about this."
    ri "Porque eres la única persona con vida que podría saber algo de esto."

# game/script.rpy:4963
translate spanish spaceship_a228c0ee:

    # mc "I'm not seeing the connection."
    mc "No veo la conexión."

# game/script.rpy:4965
translate spanish spaceship_0c65deb4:

    # ri "Al-Zahira. Twenty years ago."
    ri "Al-Zahira. Hace veinte años."

# game/script.rpy:4966
translate spanish spaceship_af80ae99:

    # ri "The bastards who betrayed us were recently found dead in this forest."
    ri "Los bastardos que nos traicionaron fueron encontrados muertos hace poco en este bosque."

# game/script.rpy:4967
translate spanish spaceship_5218139c:

    # ri "And on one of their bodies, we found a photograph of your missing wife."
    ri "Y en uno de sus cuerpos encontramos una fotografía de tu esposa desaparecida."

# game/script.rpy:4968
translate spanish spaceship_e6629bd7:

    # mc "You said you'd taken care of them."
    mc "Dijiste que te habías ocupado de ellos."

# game/script.rpy:4969
translate spanish spaceship_d99935c6:

    # ri "I thought I had."
    ri "Eso creía."

# game/script.rpy:4970
translate spanish spaceship_9f7833ba:

    # ri "Turns out I missed a few."
    ri "Resulta que se me escaparon algunos."

# game/script.rpy:4972
translate spanish spaceship_94ca43e5:

    # mc "...Someone was watching us."
    mc "...Alguien nos estaba vigilando."

# game/script.rpy:4973
translate spanish spaceship_d35f934f:

    # ri "Which means we’re not the only ones looking for you."
    ri "Lo que significa que no somos los únicos que te buscan."

# game/script.rpy:4974
translate spanish spaceship_65e4e4f5:

    # mc "You still haven't answered my question, Richard."
    mc "Todavía no respondiste mi pregunta, Richard."

# game/script.rpy:4975
translate spanish spaceship_21162a1b:

    # mc "I want the truth."
    mc "Quiero la verdad."

# game/script.rpy:4977
translate spanish spaceship_77f761b0:

    # ri "After the explosion in Al-Zahira, traces of that substance entered your bloodstream."
    ri "Después de la explosión en Al-Zahira, rastros de esa sustancia entraron en tu torrente sanguíneo."

# game/script.rpy:4978
translate spanish spaceship_76801270:

    # ri "And as we recently discovered..."
    ri "Y como descubrimos hace poco..."

# game/script.rpy:4979
translate spanish spaceship_089644be:

    # ri "The ship reacts to it."
    ri "La nave reacciona a ella."

# game/script.rpy:4981
translate spanish spaceship_a58b86a6:

    # h "So you dragged them here because the alien coffin blinked at his blood?"
    h "¿Así que los arrastraste hasta aquí porque el ataúd alienígena parpadeó ante su sangre?"

# game/script.rpy:4983
translate spanish spaceship_53047dd2:

    # ri "Do you know anyone else it reacts to?"
    ri "¿Conoces a alguien más ante quien reaccione?"

# game/script.rpy:4984
translate spanish spaceship_104dd4ba:

    # ri "Because I don’t."
    ri "Porque yo no."

# game/script.rpy:4985
translate spanish spaceship_dc12f8b5:

    # ri "Either way..."
    ri "De cualquier modo..."

# game/script.rpy:5017
translate spanish spaceship_171c53b7:

    # mc "If Lora went in there..."
    mc "Si Lora entró ahí..."

# game/script.rpy:5018
translate spanish spaceship_07e0870d:

    # mc "We don't have a better option."
    mc "No tenemos una opción mejor."

# game/script.rpy:5041
translate spanish spaceship_c17f3a7e:

    # mc "Richard? What about the others?"
    mc "¿Richard? ¿Y los demás?"

# game/script.rpy:5042
translate spanish spaceship_10187d56:

    # mc "Or... am I going in alone?"
    mc "O... ¿voy a entrar solo?"

# game/script.rpy:5043
translate spanish spaceship_2c9371ea:

    # ri "Shiya and I are coming with you. If we can get inside..."
    ri "Shiya y yo iremos contigo. Si logramos entrar..."

# game/script.rpy:5044
translate spanish spaceship_c49b1fb9:

    # mc "All right."
    mc "De acuerdo."

# game/script.rpy:5086
translate spanish spaceship_fe562749:

    # mc "That twenty years ago, we stumbled into a deal for something that came from this place?"
    mc "¿Que hace veinte años nos topamos con un trato por algo que venía de este lugar?"

# game/script.rpy:5089
translate spanish spaceship_46732718:

    # mc "the only thing that turns up is Lora's photo."
    mc "lo único que aparece es la foto de Lora."

# game/script.rpy:5090
translate spanish spaceship_acec8220:

    # mc "On men who should've died twenty years ago."
    mc "En hombres que deberían haber muerto hace veinte años."

# game/script.rpy:5107
translate spanish spaceship_8ae0cdd0:

    # ri "Before that, we only knew about the old facility above it."
    ri "Antes de eso, solo sabíamos de la vieja instalación sobre ella."

# game/script.rpy:5108
translate spanish spaceship_cdd72476:

    # ri "The ship itself stayed buried. Hidden under our noses."
    ri "La nave en sí permaneció enterrada. Oculta bajo nuestras narices."

# game/script.rpy:5138
translate spanish spaceship_8c8919b0:

    # N "There’s a narrow passage."
    N "Hay un pasadizo estrecho."

# game/script.rpy:5172
translate spanish spaceship_into_c7ad5c8e:

    # mc "Narrow entry."
    mc "Entrada estrecha."

# game/script.rpy:5173
translate spanish spaceship_into_ee6afbce:

    # mc "Unknown drop."
    mc "Caída desconocida."

# game/script.rpy:5174
translate spanish spaceship_into_a7845461:

    # mc "If something waits below, better it gets one target than all of us."
    mc "Si algo espera abajo, mejor que tenga un solo objetivo y no a todos nosotros."

# game/script.rpy:5175
translate spanish spaceship_into_fe4669f1:

    # h "I hate when your logic makes sense."
    h "Odio cuando tu lógica tiene sentido."

# game/script.rpy:5221
translate spanish path_first_left_c2519fb4:

    # mc "(Enough.)"
    mc "(Basta.)"

# game/script.rpy:5222
translate spanish path_first_left_91102d0b:

    # mc "(No point wandering blind.)"
    mc "(No tiene sentido vagar a ciegas.)"

# game/script.rpy:5223
translate spanish path_first_left_d633b518:

    # mc "(Time to bring the others in.)"
    mc "(Hora de traer a los demás.)"

# game/script.rpy:5251
translate spanish path_first_left_next_2_c2519fb4:

    # mc "(Enough.)"
    mc "(Basta.)"

# game/script.rpy:5252
translate spanish path_first_left_next_2_91102d0b:

    # mc "(No point wandering blind.)"
    mc "(No tiene sentido vagar a ciegas.)"

# game/script.rpy:5253
translate spanish path_first_left_next_2_d633b518:

    # mc "(Time to bring the others in.)"
    mc "(Hora de traer a los demás.)"

# game/script.rpy:5302
translate spanish path_first_left_back_c2519fb4:

    # mc "(Enough.)"
    mc "(Basta.)"

# game/script.rpy:5303
translate spanish path_first_left_back_91102d0b:

    # mc "(No point wandering blind.)"
    mc "(No tiene sentido vagar a ciegas.)"

# game/script.rpy:5304
translate spanish path_first_left_back_d633b518:

    # mc "(Time to bring the others in.)"
    mc "(Hora de traer a los demás.)"

# game/script.rpy:5324
translate spanish first_right_c2519fb4:

    # mc "(Enough.)"
    mc "(Basta.)"

# game/script.rpy:5325
translate spanish first_right_91102d0b:

    # mc "(No point wandering blind.)"
    mc "(No tiene sentido vagar a ciegas.)"

# game/script.rpy:5326
translate spanish first_right_d633b518:

    # mc "(Time to bring the others in.)"
