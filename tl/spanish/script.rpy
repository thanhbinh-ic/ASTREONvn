    mc "¿Preguntas?"

# game/script.rpy:785

translate spanish war2_3cfb0cb5:

    # h "Why would Azarkhan show up himself?"
    h "¿Por qué Azarkhan se presenta?"

# game/script.rpy:786

translate spanish war2_6cd0d4ee:

    # h "Doesn’t seem like his style."
    h "No parece su estilo."

# game/script.rpy:787

translate spanish war2_47f00c67:

    # mc "Last guy who worked with him is dead. He doesn’t have a choice."
    mc "El último tipo que trabajó con él está muerto. Él no tiene elección."

# game/script.rpy:788

translate spanish war2_e43ef6d5:

    # mc "And that cargo? Too important to delegate. He’ll show."
    mc "¿Y ese cargamento? Demasiado importante para delegar."

