translate spanish door_space_ship_903b433a:

    # S "So we still need the opener. If luck’s on our side, we can get inside."
    S "Así que todavía necesitamos el dispositivo de apertura. Si la suerte está de nuestro lado, podremos entrar."

# game/script.rpy:5455
translate spanish door_space_ship_1f9c42b0:

