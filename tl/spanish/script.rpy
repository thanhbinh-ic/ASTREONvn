translate spanish exit_4d1ddf2c:

    # aa "Can you at least drive like a nor—"
    aa "¿Puedes al menos conducir como un no..."

# game/script.rpy:3396

translate spanish exit_9d3a067f:

    # mc "Hold on—"
    mc "Espera..."

# game/script.rpy:3399

translate spanish exit_614faaec:

    # aaa "They’re escaping! Why provoke them?!"
    aaa "¡Están escapando! ¿Por qué provocarlos?!"

