translate spanish exit_364f8206:

    # aa "Orders were clear — just observe."
    aa "Las órdenes eran claras, solo observa."

# game/script.rpy:3387

translate spanish exit_166783a4:

    # a "If we don’t act, they’ll lose us! Fire!"
    a "Si no actuamos, nos perderán! Fuego!"

