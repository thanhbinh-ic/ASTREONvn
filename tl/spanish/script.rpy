    N "Bueno, tal vez un poco. No podía creer que alguien realmente me quisiera entonces..."

# game/script.rpy:3253

translate spanish exit_6e840262:

    # N "Anyway, enough about me — I’m dying to hear how you two met."
    N "De todas formas, lo suficiente sobre mí — me muero por escuchar cómo se conocieron."

# game/script.rpy:3255

translate spanish exit_7220be1a:

    # h "We actually met long before the military..."
    h "Nos conocimos mucho antes de que el ejército..."

# game/script.rpy:3265

