translate spanish start_64e651f3:

    # mc "House at ten o’clock. Move fast."
    mc "Casa a las diez de la mañana."

# game/script.rpy:546

translate spanish start_61b7dca7:

    # m "Commander, don’t you think this place looks… unstable?"
    m "Comandante, ¿no cree que este lugar parece inestable?"

# game/script.rpy:547

translate spanish start_e6c87438:

    # m "It’s held together by duct tape and good intentions."
    m "Está retenido por cinta adhesiva y buenas intenciones."

# game/script.rpy:549

translate spanish start_72aa28bc:

    # mc "Didn’t have much choice. Most of the buildings here are in the same crappy state."
    mc "No tenía mucha elección. La mayoría de los edificios aquí están en el mismo estado de mierda."

# game/script.rpy:551

translate spanish start_5486704e:

    # h "But how? This was supposed to be a new city… Yet the people are gone. Buildings are collapsing. It’s strange."
    h "Pero ¿cómo? Se suponía que era una ciudad nueva... Sin embargo, la gente se ha ido. Edificios están colapsando. Es extraño."

# game/script.rpy:553

translate spanish start_dc1c045a:

    # m "Feels like we’re in a zombie horror flick."
    m "Parece que estamos en una película de terror zombi."

# game/script.rpy:555

translate spanish start_fec9a4cc:

    # h "I hate horror…"
    h "Odio el horror..."

# game/script.rpy:557

translate spanish start_9ac7ee39:

    # mc "All of this is connected to our objective."
    mc "Todo esto está conectado a nuestro objetivo."

# game/script.rpy:559

translate spanish start_ec2e5f3f:

    # h "Thanks for the encouragement. Care to elaborate now?"
    h "Gracias por el aliento. ¿Quieres explicarte ahora?"

# game/script.rpy:561

translate spanish start_25dde2be:

    # mc "It’s tied to a new technology — no details, just rumors. Some say it can empty entire cities."
    mc "Está ligada a una nueva tecnología, sin detalles, solo rumores. Algunos dicen que puede vaciar ciudades enteras."

# game/script.rpy:563

translate spanish start_2fee786f:

    # h "Perfect. Sent off into god-knows-what for god-knows-why… Just to find out—"
    h "Perfecto, enviado a Dios-sabe-qué por Dios-sabe-por qué... solo para descubrir..."

# game/script.rpy:564

translate spanish start_e262beb4:

    # h "That millions of lives depend on what we do? Sounds like a royal pain in the ass."
    h "¿Que millones de vidas dependen de lo que hacemos? Suena como un dolor real en el culo."

# game/script.rpy:565

translate spanish start_232f1846:

    # m "Always wanted to play the hero."
    m "Siempre quise jugar al héroe."

# game/script.rpy:567

translate spanish start_bc357c9b:

    # h "Or maybe the villain? Pretty sure heroes don’t mow down people daily."
    h "¿O quizás el villano? Los héroes bastante seguros no se mueden a la gente diariamente."

# game/script.rpy:568

translate spanish start_17d13082:

    # m "Then maybe stop shooting back."
    m "Entonces tal vez deje de disparar."

# game/script.rpy:570

translate spanish start_daa015f2:

    # h "[mc], this is the place, right? We’re not going any further?"
    h "[mc]¿Este es el lugar, no?"

# game/script.rpy:572

translate spanish start_84ed6668:

    # mc "Yeah. We’ve arrived. The deal’s supposed to go down in a couple of hours."
    mc "Sí. Hemos llegado. El acuerdo se supone que baja en un par de horas."

# game/script.rpy:574

translate spanish start_cd82b7d4:

    # mc "We should prep while we’ve got the time."
    mc "Deberíamos prepararnos mientras tengamos tiempo."

# game/script.rpy:576

translate spanish start_8c1688db:

    # c "I’ll check the upper floors. Last thing I need is another rat surprise."
    c "Voy a revisar los pisos superiores. Lo último que necesito es otra sorpresa de rata."

# game/script.rpy:578

translate spanish start_5416ebeb:

    # h "Say “rat” again and I’ll kill you."
    h "Di \"rat\" otra vez y te mataré."

# game/script.rpy:580

translate spanish start_d19f855d:

    # c "..."
    c "..."

# game/script.rpy:581

translate spanish start_6c657a3b:

    # c "Sorry. Didn’t think."
    c "Lo siento. No lo pensé."

# game/script.rpy:582

translate spanish start_83e555f0:

    # mc "Alexandro, go with Jake."
    mc "Alexandro, ve con Jake."

# game/script.rpy:584

translate spanish start_5ea20ebd:

    # c "Sir? You can’t be serious. I can’t stand that guy!"
    c "Señor, no puede ser serio. ¡No puedo soportar a ese tipo!"

# game/script.rpy:585

translate spanish start_866cf2b5:

    # x "With him? That jerk? No thanks."
    x "¿Con él?"

# game/script.rpy:587

translate spanish start_ebb75516:

    # mc "Last thing I want is to report you both dead. Pair up. Got it?"
    mc "Lo último que quiero es informarles de que ambos están muertos."

# game/script.rpy:588

translate spanish start_b237bc5c:

    # b "Sir, yes, sir…"
    b "Señor, sí, señor..."

# game/script.rpy:590

translate spanish start_07c20827:

    # S "Commander? I think I found a perfect spot."
    S "Creo que encontré un lugar perfecto."

# game/script.rpy:592

translate spanish start_aa191548:

    # mc "What’re you talking about?"
    mc "¿De qué estás hablando?"

# game/script.rpy:594

translate spanish start_00cfac4b:

    # S "Building at eleven o’clock. Overlooks the whole area. Real vantage point."
    S "Edificio a las once en punto. Se ve toda la zona. Punto de vista real."

# game/script.rpy:596

translate spanish start_28f39d60:

    # mc "Hold off. You’ll head there with Jake and Alexandro after their recon."
    mc "Espera. Irás allí con Jake y Alexandro después de su reconocimiento."

# game/script.rpy:598

translate spanish start_187aeb64:

    # S "Yes, sir..."
    S "Sí, señor..."

# game/script.rpy:607

translate spanish war2_1b0668b6:

    # "A day and a half later."
    "Un día y medio más tarde."

# game/script.rpy:609

translate spanish war2_fd3e6bd7:

    # mc "(We’ve been stuck here for so long… The deal was supposed to happen hours ago, and yet—we’re still here.)"
    mc "(Hemos estado atrapados aquí por tanto tiempo... Se suponía que el acuerdo iba a suceder hace horas, y sin embargo, seguimos aquí.)"

# game/script.rpy:611

translate spanish war2_baa98d53:

    # mc "(Don’t spiral, [mc]. It’ll be fine.)"
    mc "(No en espiral, [mc]. Estará bien.)"

# game/script.rpy:613

translate spanish war2_34e3c2dd:

    # mc "(Right?)"
    mc "(¿Verdad?)"

# game/script.rpy:622

translate spanish war2_8bf8f8f0:

    # mc "You sure about this?"
    mc "¿Estás seguro de esto?"

# game/script.rpy:625

translate spanish war2_2653b46c:

    # L "No."
    L "No."

# game/script.rpy:627

translate spanish war2_8faf70ab:

    # L "But if I keep saying “just one more minute,” we’ll be here all night."
    L "Pero sigo diciendo \"un minuto más\", estaremos aquí toda la noche."

# game/script.rpy:629

translate spanish war2_2b35b6fe_1:

    # mc "..."
    mc "..."

# game/script.rpy:633

translate spanish war2_553f7ff2:

    # mc "Honestly?"
    mc "¿Honestamente?"

# game/script.rpy:634

translate spanish war2_d876ca77:

    # mc "I don’t mind."
    mc "No me importa."

# game/script.rpy:635

translate spanish war2_ed353575:

    # mc "Standing here with you beats pretty much anything else."
    mc "Estar aquí contigo gana casi cualquier cosa más."

# game/script.rpy:637

translate spanish war2_5647d356:

    # L "Stop that. You're gonna make me tear up before we even start."
    L "Lloraré antes de empezar."

# game/script.rpy:639

translate spanish war2_0b9d1257:

    # mc "That’s kind of the goal, isn’t it? "
    mc "Eso es algo así, ¿no? "

# game/script.rpy:641

translate spanish war2_d60eb2e9:

    # mc "Emotional bomb right at the intro. Win them over fast."
    mc "Bomba emocional en la intro, cógelas rápido."

# game/script.rpy:649

translate spanish war2_c9299b6a:

    # L "Oh god. Is this a sales pitch?"
    L "Oh Dios. ¿Es un lanzamiento de ventas?"

# game/script.rpy:655

translate spanish war2_0817892e:

    # mc "Always."
    mc "Siempre."

# game/script.rpy:656

translate spanish war2_2b465d36:

    # mc "Hi, I’m [mc], and this is the love of my life. Limited-time offer. Zero regrets, all heart."
    mc "Hola, soy [mc], y este es el amor de mi vida. Oferta de tiempo limitado. Cero lamenta, todo corazón."

# game/script.rpy:658

translate spanish war2_7996824c:

    # L "You're ridiculous."
    L "Eres imposible."

# game/script.rpy:659

translate spanish war2_608ee75e:

    # L "…But you’re also wearing your shirt inside out."
    L "...Pero también llevas tu camisa dentro de fuera."

# game/script.rpy:661

translate spanish war2_99be54dd:

    # mc "…What?"
    mc "¿Qué?"

# game/script.rpy:665

translate spanish war2_b05c4edd:

    # mc "…Great. Nothing says “romantic message to the parents” like looking mildly concussed."
    mc "...Genial. Nada dice “mensaje romántico a los padres” como lucir ligeramente concusado."

# game/script.rpy:667

translate spanish war2_7745336b:

    # L "{b}laughs{/b}"
    L "{b}risas{/b}"

# game/script.rpy:669

translate spanish war2_921607a6:

    # L "It's perfect. "
    L "Perfecto."

# game/script.rpy:671

translate spanish war2_8a39e3f5:

    # L "Makes me feel a little less nervous, honestly. "
    L "Me hace sentir un poco menos nervioso, honestamente. "

# game/script.rpy:673

translate spanish war2_1a2227f1:

    # L "You mess up, too."
    L "Tú también lo arruinas."

# game/script.rpy:675

translate spanish war2_63095e00:

    # mc "All the time."
    mc "Todo el tiempo."

# game/script.rpy:676

translate spanish war2_e7968c7c:

    # mc "Especially when it comes to you."
    mc "Especialmente cuando se trata de ti."

# game/script.rpy:678

translate spanish war2_bf4290c3:

    # L "…You’re really sure you want to do this?"
    L "...¿Estás seguro de que quieres hacer esto?"

# game/script.rpy:680

translate spanish war2_e0e2858e:

    # mc "I was sure the second I met you."
    mc "Estaba seguro de que el segundo que te conocí."

# game/script.rpy:683

translate spanish war2_9993b94e:

    # L "..."
    L "..."

# game/script.rpy:686

translate spanish war2_2b35b6fe_2:

    # mc "..."
    mc "..."

# game/script.rpy:688

translate spanish war2_c00ef224:

    # mc "And what was that just now?"
    mc "¿Y qué fue eso ahora?"

# game/script.rpy:690

translate spanish war2_03757ee3:

    # L "Just showing you how much I love you."
    L "Solo te mostraré cuánto te amo."

# game/script.rpy:692

translate spanish war2_365a7361:

    # mc "Okay. Camera’s rolling."
    mc "Está bien. La cámara está rodando."

# game/script.rpy:693

translate spanish war2_0a954585:

    # mc "Deep breath?"
    mc "¿Respiración profunda?"

# game/script.rpy:695

translate spanish war2_9a747f5a:

    # L "Already took three."
    L "Ya se han llevado tres."

# game/script.rpy:697

translate spanish war2_b63393db:

    # mc "Alright. Let's do it."
    mc "Muy bien, vamos."

# game/script.rpy:699

translate spanish war2_89d6be51:

    # mc "And done, we’re good to go. {w}I’m pressing the button now, and... {w}recording started."
    mc "Y hecho, estamos bien para ir. {w}Estoy presionando el botón ahora, y... {w}La grabación comenzó."

# game/script.rpy:707

translate spanish war2_0a10c9f0:

    # mc "Ahem ahem."
    mc "Ejem."

# game/script.rpy:709

translate spanish war2_9f621cc0:

    # mc "Hi, Mom. Hi, Dad."
    mc "Hola, mamá."

# game/script.rpy:718

translate spanish war2_50b747eb:

    # mc "(Right [mc], get it together!)"
    mc "(Bien, [mc], contrólate.)"

# game/script.rpy:720

translate spanish war2_bf5a4508:

    # mc "If you’re watching this, then I guess… I wanted you to meet her."
    mc "Si estás viendo esto, entonces supongo... quería que la conocieses."

# game/script.rpy:722

translate spanish war2_f8c8f8b6:

    # mc "She’s the reason I laugh more. Sleep less. Breathe deeper. "
    mc "Ella es la razón por la que me rio más. Duerme menos. Respira más profundo. "

# game/script.rpy:724

translate spanish war2_e36807a9:

    # mc "This is Lora."
    mc "Soy Lora."

# game/script.rpy:725

translate spanish war2_db5e061e:

    # mc "And the other day, I decided to commit my life to her."
    mc "Y el otro día, decidí comprometer mi vida con ella."

# game/script.rpy:726

translate spanish war2_5336083d:

    # mc "And she said... {w}Yes."
    mc "Y ella dijo... {w}Sí."

# game/script.rpy:728

translate spanish war2_26397a94:

    # L "Hi..."
    L "Hola..."

# game/script.rpy:729

translate spanish war2_97b5c29e:

    # L "And yes, I did. I said yes. Loudly. Twice."
    L "Y sí, dije que sí, muy amable."

# game/script.rpy:731

translate spanish war2_e6acf5f3:

    # mc "You also punched me in the arm."
    mc "También me golpeaste en el brazo."

# game/script.rpy:733

translate spanish war2_c8e11565:

    # L "That was nerves."
    L "Eso fue nervios."

# game/script.rpy:735

translate spanish war2_3a4b5d4f:

    # mc "That was love."
    mc "Eso fue amor."

# game/script.rpy:737

translate spanish war2_ef3844ff:

    # L "We wanted to keep this moment. Just for us."
    L "Queríamos mantener este momento, solo para nosotros."

# game/script.rpy:738

translate spanish war2_fe4fff80:

    # L "But then we thought — maybe you’d want to see it too."
    L "Pero entonces pensamos — tal vez usted quisiera verlo también."

# game/script.rpy:739

translate spanish war2_69d8e20d:

    # L "What this feels like. Right now."
    L "Lo que se siente ahora mismo."

# game/script.rpy:743

translate spanish war2_f22f4571:

    # b "Just… us."
    b "Solo... nosotros."

# game/script.rpy:745

translate spanish war2_2f36d614:

    # mc "(I hope her meeting went well...)"
    mc "(Espero que su reunión fuera bien...)"

# game/script.rpy:746

translate spanish war2_ee117e1f:

    # mc "(Last thing I want is to see her sad when I get back.)"
    mc "(Lo último que quiero es verla triste cuando vuelva)."

# game/script.rpy:750

translate spanish war2_b194169c:

    # c "Oh, as always, your darling wife."
    c "Como siempre, tu querida esposa."

# game/script.rpy:751

translate spanish war2_afbd5e44:

    # c "That explains the smile on your face."
    c "Eso explica la sonrisa en tu cara."

# game/script.rpy:753

translate spanish war2_c2eea2ef:

    # mc "Any news? {w}Still radio silence?"
    mc "¿Alguna noticia? {w}¿Todavía silencio radio?"

# game/script.rpy:758

translate spanish war2_f2f20c73:

    # c "Like the grave, sir."
    c "Como la tumba, señor."

# game/script.rpy:759

translate spanish war2_582b2177:

    # c "Not a single ping since yestarday... and it’s looking more final by the hour."
    c "No es un solo ping desde el día de ayer... y se ve más final por hora."

# game/script.rpy:760

translate spanish war2_9cf59cf4:

    # c "Still — maybe should wait a little longer."
    c "Aún así, quizás debería esperar un poco más."

# game/script.rpy:762

translate spanish war2_d9419520:

    # x "Oh, that’s rich. {w}Two days in this furnace and we’re still just sitting here?"
    x "Oh, eso es rico. {w}¿Dos días en este horno y todavía estamos sentados aquí?"

# game/script.rpy:763

translate spanish war2_e969bcc5:

    # x "How much longer are we supposed to wait? Where the hell are they?"
    x "¿Cuánto tiempo se supone que debemos esperar?"

# game/script.rpy:764

translate spanish war2_8942a8d1:

    # x "¡Que me besen el culo si creen que voy a quedarme aquí más tiempo!"
    x "¡Que me besen el culo si creen que voy a celebrar aquí más tiempo!"

# game/script.rpy:766

translate spanish war2_cfc5aa48:

    # c "There it is again. {w}Speak English, or at least something we can understand!"
    c "Ahí está otra vez. {w}¡Habla inglés, o al menos algo que podamos entender!"

# game/script.rpy:769

translate spanish war2_397bc7d1:

    # x "What’s your problem, huh?"
    x "¿Cuál es tu problema?"

# game/script.rpy:770

translate spanish war2_039660f3:

    # x "What do you want me to speak, huh? The Queen’s English?"
    x "¿Qué quieres que hable, eh? ¿El inglés de la Reina?"

# game/script.rpy:776

translate spanish war2_e51f6f9b:

    # x "I risk my life like the rest of you. I’ve earned the right to speak however the hell I want."
    x "Arriesgo mi vida como todos ustedes. Me gané el derecho a hablar como me dé la gana."

# game/script.rpy:778

translate spanish war2_b729f0ed:

    # c "Sure, but none of us know what you’re saying when you go on those tangents."
    c "Claro, pero ninguno de nosotros entiende lo que dices cuando te vas por las ramas."

# game/script.rpy:779

translate spanish war2_951ea1c4:

    # c "It’s just noise, man. Noise and attitude."
    c "Es solo ruido, hombre. ruido y actitud."

# game/script.rpy:782

translate spanish war2_060e5e47:

    # x "Eso no es problema mío si tu cerebro diminuto no pudo molestarse en aprender algo más que tu inglés de mierda."
    x "Eso no es problema mío si tu cerebro diminuto no pudo molestarse en aprender algo más que tu inglés de mierda."

# game/script.rpy:784

translate spanish war2_850ef128_1:

    # b "..."
    b "..."

# game/script.rpy:788

translate spanish war2_c2bfe620:

    # mc "You know how much that annoys him — especially in situations like this."
    mc "Sabes lo mucho que le molesta, especialmente en situaciones como esta."

# game/script.rpy:789

translate spanish war2_c0e80dd5:

    # mc "Ease off the trigger for once, and maybe you two won’t try to kill each other before the mission starts."
    mc "Apaga el gatillo por una vez, y tal vez ustedes dos no intentarán matarse antes de que comience la misión."

# game/script.rpy:791

translate spanish war2_304008af:

    # c "Alright, alright. Fair. {w}Guess I forget that sometimes... {w}I’ll try."
    c "Bien, bien, justo. {w}Supongo que olvido que a veces... {w}Lo intentaré."

# game/script.rpy:795

translate spanish war2_ad79e119:

    # x "Go screw yourself."
    x "Vete a la mierda."

# game/script.rpy:797

translate spanish war2_a0b6f0c8:

    # c "Fair enough. {w}That’s as close to peace as we’re getting."
    c "Es justo. {w}Eso es tan cerca de la paz como estamos recibiendo."

# game/script.rpy:799

translate spanish war2_55216497:

    # m "Commander? {w}Mind if I ask something?"
    m "¿Comandante? {w}¿Te importa si pregunto algo?"

# game/script.rpy:801

translate spanish war2_af353eb6:

    # mc "Go ahead."
    mc "Adelante."

# game/script.rpy:803

translate spanish war2_c25d2a06:

    # m "You said you two got married not long ago, right?"
    m "Dijiste que os casasteis hace poco, ¿verdad?"

# game/script.rpy:805

translate spanish war2_6b023091:

    # mc "Yeah, we did."
    mc "Sí, lo hicimos."

# game/script.rpy:807

translate spanish war2_41ddec16:

    # m "So how is she, your wife?"
    m "¿Cómo está, tu esposa?"

# game/script.rpy:809

translate spanish war2_7888c492:

    # c "She’s the most amazing woman in the world!"
    c "¡Es la mujer más increíble del mundo!"

# game/script.rpy:810

translate spanish war2_9c41ac00:

    # c "Which is why our daughter’s so beautiful and perfect."
    c "Por eso nuestra hija es tan hermosa y perfecta."

# game/script.rpy:812

translate spanish war2_e5bb4c98:

    # m "Sorry? I wasn't asking you..."
    m "Lo siento, no te estaba preguntando."

# game/script.rpy:814

translate spanish war2_bca82523:

    # c "Just sharing the fact."
    c "Solo compartía el hecho."

# game/script.rpy:816

translate spanish war2_8c59d19c:

    # mc "How old is she now? Your daughter."
    mc "¿Qué edad tiene ahora?"

# game/script.rpy:818

translate spanish war2_97cba95f:

    # c "Turned three last week."
    c "Volvió tres la semana pasada."

# game/script.rpy:820

translate spanish war2_d6a80e97:

    # c "Crazy how fast they grow when you’re always gone."
    c "Loco que tan rápido crecen cuando siempre te has ido."

# game/script.rpy:822

translate spanish war2_a1f55207:

    # m "At least someone’s growing up during all this..."
    m "Al menos alguien está creciendo durante todo esto..."

# game/script.rpy:827

translate spanish war2_d02c90e1:

    # m "You’re not the only one. {w}For once, I found it strange myself."
    m "No eres el único. {w}Por una vez, me pareció extraño."

# game/script.rpy:828

translate spanish war2_3e472fc4:

    # m "{b}‘Reach the designated location and wait for further orders’, seriously?{/b} You’ve got to be kidding me."
    m "{b}“¿Llevar el lugar designado y esperar a nuevas órdenes”, en serio?{/b} Tienes que estar bromeando."

# game/script.rpy:830

translate spanish war2_671f1a05:

    # h "See? I’m not the only one!"
    h "¿Ves? ¡No soy el único!"

# game/script.rpy:831

translate spanish war2_d38dcc94:

    # h "So stop keeping everything to yourself — spill it, what’s HQ told you?"
    h "Así que deja de mantener todo para ti mismo — derrame, ¿qué te ha dicho HQ?"

# game/script.rpy:836

translate spanish war2_5eaa1ce6:

    # mc "He’s the head of a research lab on neural implants. {w}And at the same time, the mastermind behind the terrorist group Masquerade."
    mc "Es el jefe de un laboratorio de investigación sobre implantes neuronales. {w}Y al mismo tiempo, la mente maestra detrás del grupo terrorista Masquerade."

# game/script.rpy:838

translate spanish war2_a3a2a072:

    # mc "Our objective is to prevent a deal set to take place within the next day."
    mc "Nuestro objetivo es evitar que se celebre un acuerdo dentro del día siguiente."

# game/script.rpy:839

translate spanish war2_5ade88fd:

    # mc "Eliminate Azarkhan {w}if possible, {w}and secure the goods."
    mc "Eliminar a Azarkhan {w}si es posible, {w}y asegurar las mercancías."

# game/script.rpy:841

translate spanish war2_c561d7f5:

    # mc "As for the goods themselves... {w}All we know is that it’s some kind of energy storage device."
    mc "En cuanto a los bienes mismos... {w}Todo lo que sabemos es que es algún tipo de dispositivo de almacenamiento de energía."

# game/script.rpy:842

translate spanish war2_19075a73:

    # mc "Capable of catastrophic destruction on a massive scale."
    mc "Capaz de destrucción catastrófica a gran escala."

# game/script.rpy:844

translate spanish war2_8b6cd3de:

    # mc "What we've seen in these couple of days. Could be a consequence of his use."
    mc "Lo que hemos visto en los últimos dos días puede ser una consecuencia de su uso."

# game/script.rpy:847

translate spanish war2_fac0a420:

    # mc "The biggest issue is our lack of intel on enemy numbers."
    mc "El problema más importante es nuestra falta de información sobre los números enemigos."

# game/script.rpy:848

translate spanish war2_dca8529e:

    # mc "So our first task will be reconnaissance and assessing the situation. {w}I hope that’s clear."
    mc "Así que nuestra primera tarea será el reconocimiento y evaluación de la situación. {w}Espero que sea claro."

# game/script.rpy:852

translate spanish war2_b7e0053b:

    # h "Why would Azarhan show up here personally? He’s not the type."
    h "¿Por qué Azarhan aparece aquí personalmente? Él no es el tipo."

# game/script.rpy:853

translate spanish war2_122a5935:

    # mc "The last guy who dealt with him is dead. He has no choice."
    mc "El último que se ocupó de él está muerto, no tiene elección."

# game/script.rpy:854

translate spanish war2_f43f89f1:

    # mc "And the cargo — extremely important. He’ll come in person. I’m sure of it."
    mc "Y el cargamento — extremadamente importante. Él vendrá en persona. Estoy seguro de ello."

# game/script.rpy:855

translate spanish war2_7ef5b68d:

    # mc "More questions?"
    mc "¿Más preguntas?"

# game/script.rpy:860

translate spanish war2_c43c8cc4:

    # r "6-Bravo, this is Eagle-2. Do you copy?"
    r "6-Bravo, este es Eagle-2. ¿Me recibes?"

# game/script.rpy:861

translate spanish war2_71b6dc1b:

    # r "A convoy has been spotted approaching you from the east at high speed."
    r "Un convoy ha sido visto acercándote desde el este a alta velocidad."

# game/script.rpy:862

translate spanish war2_d66cb7ff:

    # r "Confirm you’ve received this information."
    r "Confirme que ha recibido esta información."

# game/script.rpy:865

translate spanish war2_152d8c66:

    # mc "Eagle-2, this is 6-Bravo. {w}Message received. How long until they reach us?"
    mc "Águila-2, aquí 6-Bravo. {w}Mensaje recibido. ¿Cuánto tiempo hasta que nos alcancen?"

# game/script.rpy:868

translate spanish war2_cb5baf70:

    # r "Bravo-6, ETA is 20 minutes."
    r "Bravo-6, ETA es de 20 minutos."

# game/script.rpy:869

translate spanish war2_300063c9:

    # r "They’re moving fast — two vehicles in total."
    r "Se mueven rápido — dos vehículos en total."

# game/script.rpy:870

translate spanish war2_1c6255a1:

    # r "Do not engage first. {w}Await further instructions. {w}Out."
    r "No te atrevas primero. {w}Esperen instrucciones adicionales. {w}Fuera."

# game/script.rpy:876

translate spanish war2_5da2eae3:

    # mc "Everyone heard that?"
    mc "¿Todos lo oyeron?"

# game/script.rpy:877

translate spanish war2_011ef94c:

    # mc "Take your positions. We’ve got 20 minutes. {w}Let’s move, move!"
    mc "Tomen posiciones. Tenemos veinte minutos. {w}¡Muévanse, muévanse!"

# game/script.rpy:889

translate spanish war2_8639cfb4:

    # x "Finally, some action... {w}Can’t wait to shred these bastards to pieces. {w}Just show yourselves."
    x "Por último, algo de acción... {w}No puedo esperar a que estos bastardos se desmenuzaran. {w}Solo muéstrase."

# game/script.rpy:893

translate spanish war2_701b936d:

    # mc "Shiya, have you taken up your designated position?"
    mc "Shiya, ¿has asumido tu posición designada?"

# game/script.rpy:899

translate spanish war2_029bcb4f:

    # S "Movement spotted east, two vehicles."
    S "Movimiento localizado al este, dos vehículos."

# game/script.rpy:900

translate spanish war2_65c0c89a:

    # S "One vehicle north. {w}Nothing else."
    S "Un vehículo al norte. {w}Nada más."

# game/script.rpy:903

translate spanish war2_1edefd14:

    # x "Come on, Commander!"
    x "¡Vamos, comandante!"

# game/script.rpy:904

translate spanish war2_d1033455:

    # x "We can take them — just a handful of guys. Two volleys, and they’re done."
    x "Podemos tomarlos, solo un puñado de chicos. Dos voleies, y están acabados."

# game/script.rpy:906

translate spanish war2_acef7510:

    # S "And what if this is just part of the group?"
    S "¿Y si esto es solo parte del grupo?"

# game/script.rpy:907

translate spanish war2_838b9dbf:

    # S "Or did your dumb brain conveniently skip that thought and jump straight to action?"
    S "¿O tu tonto cerebro saltó convenientemente ese pensamiento y saltó directamente a la acción?"

# game/script.rpy:908

translate spanish war2_fff08371:

    # x "What did you just say? Stupid brain?! {w}Oh, you little perra!"
    x "¿Qué acabas de decir? {w}¡Oh, pequeña perra!"

# game/script.rpy:912

translate spanish war2_0e940116:

    # mc "Quiet down, Alexandro, get ready for what’s coming. {w}Shiya, status."
    mc "Silencio, Alexandro, prepárate para lo que viene. {w}Shiya, estatus."

# game/script.rpy:913

translate spanish war2_f884f351:

    # S "(whispering) Always complaining like a kid. {w}(Louder) Understood."
    S "(susurrando) Siempre quejándose como un niño. {w}(En voz alta) Entendido."

# game/script.rpy:914

translate spanish war2_b02ece1d:

    # S "Aside from this group, no enemies in sight."
    S "Aparte de este grupo, no hay enemigos a la vista."

# game/script.rpy:917

translate spanish war2_6b99ccdd:

    # S "Negative, the target isn’t visible. {w}There’s a chance this is a decoy. {w}What are your orders, sir?"
    S "Negativo, el objetivo no es visible. {w}Hay una posibilidad de que esto sea un decoy. {w}¿Cuáles son sus órdenes, señor?"

# game/script.rpy:926

translate spanish war2_bc51767b:

    # a "Well, well, it’s been a long time."
    a "Bueno, bueno, ha sido mucho tiempo."

# game/script.rpy:927

translate spanish war2_06929f2d:

    # a "Glad to see you after all these years, my old friend."
    a "Me alegro de verte después de todos estos años, mi viejo amigo."

# game/script.rpy:928

translate spanish war2_0234498c:

    # a "How’s the wife?{w} The kids?{w} Everything great, I assume?"
    a "¿Cómo está la esposa?{w} ¿Los niños?{w} ¿Todo bien, supongo?"

# game/script.rpy:930

translate spanish war2_5f325df2:

    # az "I don’t have time for this. Let’s get to the point."
    az "No tengo tiempo para esto. Vamos a llegar al punto."

# game/script.rpy:931

translate spanish war2_069325ca:

    # az "Do you have the goods?"
    az "¿Tienes los bienes?"

# game/script.rpy:932

translate spanish war2_c6eb3d61:

    # a "You’re still the same grumpy old man.{w} But yes, I have the goods. You have no idea what it cost me to get them."
    a "Eres el mismo viejo gruñón.{w} Pero sí, tengo las mercancías, no tienes idea de lo que me costó conseguirlas."

# game/script.rpy:933

translate spanish war2_7a0a13f5:

    # a "Although I wasn’t able to kill all the witnesses — one scientist managed to escape."
    a "Aunque no pude matar a todos los testigos, un científico logró escapar."

# game/script.rpy:934

translate spanish war2_b01f28c6:

    # az "Doesn’t matter. {w}The important thing is that you secured the goods. {w}So, where are they?"
    az "No importa. {w}Lo importante es que usted ha asegurado las mercancías. {w}¿Dónde están?"

# game/script.rpy:946

translate spanish war2_f4bd6ea7:

    # S "I see movement at the back. {w}It looks like it might be the target. {w}What are your orders?"
    S "Veo movimiento en la parte trasera. {w}Parece que podría ser el objetivo. {w}¿Cuáles son sus órdenes?"

# game/script.rpy:947

translate spanish war2_6d7e1ee0:

    # mc "Wait. {w}Let’s not rush — we need to confirm it’s the real deal."
    mc "Espera. {w}No nos apresuremos — necesitamos confirmar que es el verdadero trato."

# game/script.rpy:952

translate spanish war2_2a20414c:

    # a "You know, I usually don’t stick my nose into other people’s business."
    a "Sabes, normalmente no meto la nariz en el negocio de otras personas."

# game/script.rpy:953

translate spanish war2_9e938de3:

    # a "But I’ll make an exception this time. {w}Mind telling me what this thing really is?"
    a "Pero esta vez haré una excepción. {w}¿Me importa decirme qué es esta cosa?"

# game/script.rpy:955

translate spanish war2_84dcb0eb:

    # a "I mean, no one I’ve asked seems to know its origin, like it just fell from the sky."
    a "Quiero decir, nadie que he pedido parece conocer su origen, como si simplemente cayera del cielo."

# game/script.rpy:956

translate spanish war2_73dc1208:

    # a "And I don’t like secrets."
    a "Y no me gustan los secretos."

# game/script.rpy:958

translate spanish war2_ac30220f:

    # az "It doesn’t concern you."
    az "No te preocupa."

# game/script.rpy:959

translate spanish war2_97524848:

    # az "You give me the goods, I give you the promised amount. {w}No more, no less. {w}Got it?"
    az "Me das las mercancías, te doy la cantidad prometida. {w}No más, no menos. {w}¿Entendido?"

# game/script.rpy:961

translate spanish war2_18a180f4:

    # a "Blah, blah, fine. {w}Don’t want to cross the line, or I might end up like others."
    a "Bla, bla, bien. {w}No quiero cruzar la línea, o podría terminar como otros."

# game/script.rpy:972

translate spanish war2_8b4b808b:

    # a "Handle it carefully. {w}This container is worth several hundred of your lives."
    a "Manéjelo con cuidado. {w}Este contenedor vale varios cientos de sus vidas."

# game/script.rpy:980

translate spanish war2_6893a1cc:

    # az "Dragon eggs? {w}Are you serious?"
    az "¿Huevos de dragón? {w}¿Hablas en serio?"

# game/script.rpy:981

translate spanish war2_1eb6aaec:

    # az "You’ve got to be joking..."
    az "Tienes que estar bromeando..."

# game/script.rpy:983

translate spanish war2_82084c9c:

    # a "Just a little. {w}Open it, please."
    a "Solo un poco. {w}Ábrelo, por favor."

# game/script.rpy:991

translate spanish war2_325ac1c2:

    # a "Alright, alright, I’m kidding... {w}Wait, seriously?"
    a "Está bien, está bien, estoy bromeando... {w}Espera, ¿en serio?"

# game/script.rpy:992

translate spanish war2_08bf15e4:

    # a "Just like that? {w}(whispering) I should’ve asked for more..."
    a "¿Así? {w}Debí haber pedido más..."

# game/script.rpy:994

translate spanish war2_7fe6aee3:

    # mc "Shiya, status. {w}Can you see what’s in the container?"
    mc "Shiya, estatus. {w}¿Puedes ver lo que hay en el contenedor?"

# game/script.rpy:995

translate spanish war2_071cbbfa:

    # S "Negative. {w}I can’t see what’s inside, but judging by their reactions, I’d say it’s the real deal."
    S "Negativo. {w}No puedo ver lo que hay dentro, pero a juzgar por sus reacciones, diría que es el verdadero trato."

# game/script.rpy:996

translate spanish war2_8f95ccc9:

    # mc "What about other enemies? {w}Any more contacts?"
    mc "¿Qué hay de otros enemigos? {w}¿Hay más contactos?"

# game/script.rpy:1002

translate spanish war2_49ed8580:

    # x "What are you guys talking about over there? {w}Did I miss something?"
    x "¿De qué están hablando? {w}¿Me perdí algo?"

# game/script.rpy:1003

translate spanish war2_1718006d:

    # x "How’s everyone holding up? Is everyone okay?"
    x "¿Cómo están todos colgando? ¿Están todos bien?"

# game/script.rpy:1004

translate spanish war2_bb6af251:

    # x "I’m doing fine too, by the way, not that anyone bothered to ask. {w}Thanks for your concern."
    x "Estoy bien también, por cierto, no que nadie se molestó en preguntar. {w}Gracias por su preocupación."

# game/script.rpy:1006

translate spanish war2_6ac56017:

    # mc "Get back to your designated position, Alexandro. {w}Now!"
    mc "Vuelve a tu posición designada, Alexandro. {w}¡Ahora!"

# game/script.rpy:1045

translate spanish war2_aa31424a:

    # mc "Shiya, report. {w}What’s the situation?"
    mc "Shiya, informe. {w}¿Cuál es la situación?"

# game/script.rpy:1047

translate spanish war2_2037a003:

    # S "Clear. {w}No more enemies in sight."
    S "Despejado. {w}No más enemigos a la vista."

# game/script.rpy:1048

translate spanish war2_83fc9749:

    # S "The area’s secured."
    S "El área está asegurada."

# game/script.rpy:1056

translate spanish war2_201ebcc9:

    # m "Commander, don’t you think... That went a little too smoothly?"
    m "Comandante, ¿no cree que eso fue demasiado suave?"

# game/script.rpy:1059

translate spanish war2_a8158726:

    # mc "I agree. Too many details don’t add up. {w}Could they have known about the ambush?"
    mc "Estoy de acuerdo. Hay demasiados detalles que no encajan. {w}¿Podrían haber sabido lo de la emboscada?"

# game/script.rpy:1060

translate spanish war2_4cd4da91:

    # mc "But If they did, why come here at all?{w} Unless..."
    mc "Pero si lo hicieron, ¿por qué vienen aquí en absoluto?{w} A menos que..."

# game/script.rpy:1063

translate spanish war2_9b6850c2:

    # h "Nah, I think they genuinely didn’t know about the ambush."
    h "No, creo que realmente no sabían de la emboscada."

# game/script.rpy:1064

translate spanish war2_8adec696:

    # h "Other than a few cases of cash, there’s nothing else here."
    h "Aparte de algunos casos de dinero en efectivo, no hay nada más aquí."

# game/script.rpy:1065

translate spanish war2_1775a059:

    # h "And that second vehicle? {w}It’s burning brighter than a Christmas tree."
    h "¿Y ese segundo vehículo? {w}Está quemando más brillante que un árbol de Navidad."

# game/script.rpy:1072

translate spanish war2_eb6e1361:

    # mc "But something still bothers me. {w}Why did it take us so long to eliminate him?"
    mc "Pero algo todavía me molesta. {w}¿Por qué nos tomó tanto tiempo eliminarlo?"

# game/script.rpy:1079

translate spanish war2_6b38cbf0:

    # h "Was that really necessary?"
    h "¿Era realmente necesario?"

# game/script.rpy:1080

translate spanish war2_739b9f88:

    # h "You know, he was already dead."
    h "Ya estaba muerto."

# game/script.rpy:1088

translate spanish war2_2b35b6fe_3:

    # mc "..."
    mc "..."

# game/script.rpy:1092

translate spanish war2_1300a522:

    # m "Commander, may I have a word with you? {w}We’ve got a problem..."
    m "Comandante, ¿puedo hablar con usted? {w}Tenemos un problema..."

# game/script.rpy:1096

translate spanish war2_c9caf65e:

    # m "It’s worse than that."
    m "Es peor que eso."

# game/script.rpy:1097

translate spanish war2_cf022c60:

    # m "If the containers were supposed to be filled with something... {w}I’m afraid"
    m "Si se suponía que los contenedores se llenaban de algo... {w}Tengo miedo."

# game/script.rpy:1098

translate spanish war2_426d5154:

    # m "We’ve got a massive issue... They’re empty, commander."
    m "Tenemos un problema masivo... están vacíos, comandante."

# game/script.rpy:1099

translate spanish war2_6f397aaa:

    # m "There’s nothing inside. {w}Absolutely nothing."
    m "No hay nada dentro. {w}Absolutamente nada."

# game/script.rpy:1101

translate spanish war2_537250fd:

    # mc "What? What do you mean, ‘nothing inside’? {w}How is that even possible?"
    mc "¿Qué? ¿Qué quieres decir con \"nada dentro\"? {w}¿Cómo es posible?"

# game/script.rpy:1175

translate spanish street_93dd367a:

    # M "Grandpa, Grandpa!!"
    M "¡Abuelo, abuelo!"

# game/script.rpy:1177

translate spanish street_0fe2a612:

    # mc "Hello, my little sunshine. It’s good to see you."
    mc "Hola, mi solcito. Es bueno verte."

# game/script.rpy:1179

translate spanish street_a2b0b3d8:

    # M "I missed you SO much! Like, {b}super{/b} much! I couldn’t wait anymore!"
    M "Te extrañé tanto. {b}super{/b} ¡Mucho! ¡No podía esperar más!"

# game/script.rpy:1183

translate spanish street_14aa9c5f:

    # A "Mina, slow down, honey. Let Grandpa catch his breath first."
    A "Mina, despacio, cariño, deja que el abuelo tome su aliento primero."

# game/script.rpy:1185

translate spanish street_0a31f2b7:

    # M "But he doesn’t mind, right Grandpa!? RIGHT??"
    M "Pero no le importa, ¿verdad abuelo?"

# game/script.rpy:1189

translate spanish street_99d2abc3:

    # mc "Wait a second... {w}has our little sunshine gotten taller? Or are my old eyes playing tricks on me?"
    mc "Espera un segundo... {w}¿O mis viejos ojos me están engañando?"

# game/script.rpy:1191

translate spanish street_bc76f130:

    # M "Nope! I {b}totally{/b} grew! Mom says I’m sprouting like a weed!"
    M "¡No! {b}Totalmente{/b} ¡Mamá dice que estoy brotando como una hierba!"

# game/script.rpy:1193

translate spanish street_b66cba15:

    # A "Which, to be fair, is not the {b}most{/b} elegant comparison..."
    A "Que, para ser justos, no es el {b}más{/b} elegante comparación..."

# game/script.rpy:1195

translate spanish street_d1e81701:

    # mc "All in good time, my dear."
    mc "Todo a su tiempo, querida."

# game/script.rpy:1196

translate spanish street_36ceb0e4:

    # mc "You should’ve seen your dad, Norman, back when he was your age."
    mc "Deberías haber visto a tu padre, Norman, cuando tenía tu edad."

# game/script.rpy:1197

translate spanish street_11d803f7:

    # mc "Now {b}that{/b} was something."
    mc "Eso {b}sí{/b} que fue algo."

# game/script.rpy:1199

translate spanish street_75c46677:

    # M "Dad?! Being {b}small{/b}?! No way. He was born serious and boring!"
    M "¿Papá? {b}pequeño{/b}No puede ser. ¡Nació serio y aburrido!"

# game/script.rpy:1201

translate spanish street_f42cfb28:

    # mc "Oh, trust me — when we first took him in, he was ten times worse than anything you’re imagining."
    mc "Oh, créeme, cuando lo tomamos primero, él era diez veces peor que cualquier cosa que estás imaginando."

# game/script.rpy:1203

translate spanish street_2979fc1e:

    # mc "And Alexa... you’re just as beautiful as ever, if not more."
    mc "Y Alexa... eres tan hermosa como siempre, si no más."

# game/script.rpy:1205

translate spanish street_929ba32e:

    # A "Aw, thank you. You always know how to make an old woman smile."
    A "Siempre sabes cómo hacer sonreír a una anciana."

# game/script.rpy:1206

translate spanish street_e728b41b:

    # mc "Old? Don’t make me laugh. You’re still young enough to cause trouble."
    mc "¿Viejo? No me hagas reír. Todavía eres lo suficientemente joven para causar problemas."

# game/script.rpy:1208

translate spanish street_ecc89e40:

    # A "We’re all really happy to see you, you know. Mina’s been counting the days."
    A "Estamos muy contentos de verte, sabes. Mina ha estado contando los días."

# game/script.rpy:1210

translate spanish street_2e345fdd:

    # mc "How’ve you been, dear? Everything alright on your end?"
    mc "¿Cómo has estado, querida? ¿Todo bien a tu fin?"

# game/script.rpy:1212

translate spanish street_aea6b9b0:

    # A "Doing great."
    A "Haciendo bien."

# game/script.rpy:1213

translate spanish street_402d4e0f:

    # A "Mina keeps me busy, and I’m teaching at that private school downtown."
    A "Mina me mantiene ocupado, y estoy enseñando en esa escuela privada en el centro."

# game/script.rpy:1214

translate spanish street_d33a813c:

    # A "It’s steady, nothing to complain about."
    A "Es estable, nada de lo que quejarse."

# game/script.rpy:1218

translate spanish street_2cbe51d5:

    # mc "Ah, same as always, nothing new."
    mc "Como siempre, nada nuevo."

# game/script.rpy:1219

translate spanish street_d1890b41:

    # mc "Just keeping an eye on things around here, making sure everything’s in order..."
    mc "Solo vigilando las cosas por aquí, asegurando que todo esté en orden..."

# game/script.rpy:1223

translate spanish street_82754c37:

    # A "Oh, don’t say things like that!"
    A "¡No digas cosas así!"

# game/script.rpy:1224

translate spanish street_5a13c908:

    # A "You’re still in your prime, full of life and energy."
    A "Todavía estás en tu primer momento, lleno de vida y energía."

# game/script.rpy:1226

translate spanish street_6bf168d0:

    # mc "You flatter me, dear. But I appreciate the sentiment."
    mc "Me halaga, querida, pero agradezco el sentimiento."

# game/script.rpy:1228

translate spanish street_aa9d3871:

    # mc "How’s Norman doing? {w}He’s not giving you too much trouble, is he?"
    mc "¿Cómo está Norman? {w}No te está dando demasiados problemas, ¿verdad?"

# game/script.rpy:1230

translate spanish street_d338edbe:

    # A "No, not at all. He’s wonderful — maybe too wonderful, if you ask me..."
    A "No, no en absoluto. Es maravilloso, quizás demasiado maravilloso, si me preguntas..."

# game/script.rpy:1234

translate spanish street_9f6c040d:

    # A "He is always buried in his work, and I’m not sure what it is exactly, but... "
    A "Siempre está enterrado en su trabajo, y no estoy seguro de lo que es exactamente, pero... "

# game/script.rpy:1235

translate spanish street_a56c3955:

