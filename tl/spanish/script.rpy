translate spanish exit_77a0eca7:

    # a "Shut it. Plan B — take them out!"
    a "¡Cierra la boca!"

# game/script.rpy:3402

translate spanish exit_9b47a0ad:

    # N "What’s happening?!"
    N "¿Qué está pasando?!"

# game/script.rpy:3405

translate spanish exit_cd1f4e8b:

    # mc "Relax. Just a couple of guys trying to kill us."
    mc "Relájate, solo un par de tipos que intentan matarnos."

