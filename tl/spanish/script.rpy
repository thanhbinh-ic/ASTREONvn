# game/script.rpy:2169

translate spanish anna_72a4b7d8:

    # C "I’d like to know myself… Sister’s gonna lose it when she finds out."
    C "Me gustaría conocerme... La hermana va a perderla cuando se entere."

# game/script.rpy:2171

translate spanish anna_0d6de5a7:

    # C "Still, thanks [mc]. I’ve lost count of how many times you’ve saved us."
    C "Aún así, gracias. [mc]. He perdido la cuenta de cuántas veces nos has salvado."

# game/script.rpy:2173

translate spanish anna_77ba19bd:

    # d "You bastard, I won’t forget this!"
    d "¡Bastardo, no olvidaré esto!"

# game/script.rpy:2181

translate spanish anna_bb113594:

    # d "You’ll pay for humiliating me!"
    d "¡Pagarás por humillarme!"

# game/script.rpy:2184

translate spanish anna_3649b05b:

    # d "DIE!"
    d "¡DIE!"

# game/script.rpy:2186

translate spanish anna_8c633f94:

    # C "hic!"
    C "¡Hola!"

# game/script.rpy:2194

translate spanish anna_c39ad17c:

    # mc "(Amateurs.)"
    mc "(Amateurs.)"

# game/script.rpy:2195

translate spanish anna_09c879ac:

    # C "You okay? He had a knife!"
    C "¡Tuvo un cuchillo!"

# game/script.rpy:2199

translate spanish anna_20ca752a:

    # mc "Yeah, I’m fine. What do we do with this one?"
    mc "Sí, estoy bien. ¿Qué hacemos con este?"

# game/script.rpy:2200

translate spanish anna_a81c9a72:

    # C "This one? I’d love to end him right here, but…"
    C "¿Este? Me encantaría terminar con él aquí, pero..."

# game/script.rpy:2201

translate spanish anna_abec0f45:

    # C "Get lost!"
    C "¡Piérdete!"

# game/script.rpy:2212

translate spanish anna_93aee1d8:

    # C "And don’t ever show your face again, rat."
    C "Y no vuelvas a mostrarte la cara, rata."

# game/script.rpy:2214

translate spanish anna_f59df8cd:

    # j "You won’t see me again!"
    j "¡No me volverás a ver!"

# game/script.rpy:2216

translate spanish anna_6691e0bb:

    # C "Creepy. First you help them, then they stab you in the back."
    C "Primero los ayudas, luego te apuñalan en la espalda."

# game/script.rpy:2218

translate spanish anna_efec4c63:

    # C "What? I’m serious. Being betrayed feels like crap."
    C "¿Qué? Hablo en serio. Ser traicionado se siente como una mierda."

# game/script.rpy:2223

translate spanish anna_9676dc45:

    # mc "How’d you even end up in that situation?"
    mc "¿Cómo acabaste en esa situación?"

# game/script.rpy:2233

translate spanish anna_c6326a80:

    # C "Yeah, really. What happened?"
    C "Sí, en serio. ¿Qué pasó?"

# game/script.rpy:2234

translate spanish anna_295fcf6b:

    # C "Well, it’s weird, but… Jake called me, said he needed help. I thought, “Why not?”"
    C "Bueno, es raro, pero... Jake me llamó, dijo que necesitaba ayuda. Pensé, ¿Por qué no?"

# game/script.rpy:2236

translate spanish anna_afeda3e7:

    # C "I show up, and he’s kneeling in front of some thugs."
    C "Me presento, y está arrodillado delante de unos matones."

# game/script.rpy:2238

translate spanish anna_a6c1e4f8:

    # C "I figured if I stepped in, they’d get scared and run."
    C "Pensé que si me metí, se asustarían y corrían."

# game/script.rpy:2240

translate spanish anna_f43474b5:

    # C "You know how that usually plays out."
    C "Sabes cómo suele ser."

# game/script.rpy:2242

translate spanish anna_e08d1dde:

    # C "I find someone in trouble, build up my courage, and step in."
    C "Encuentro a alguien en problemas, acumulo mi coraje y me paso."

# game/script.rpy:2244

translate spanish anna_808e2898:

    # C "Usually, they’re grateful. And I know who I’m helping — and who I’m going up against."
    C "Por lo general, están agradecidos. Y sé a quién estoy ayudando y a quién voy a enfrentar."

# game/script.rpy:2246

translate spanish anna_d7921b7a:

    # C "If it’s a rival gang, I pass. But if it’s just punks — why not?"
    C "Si es una pandilla rival, paso. Pero si es solo punks — ¿por qué no?"

# game/script.rpy:2248

translate spanish anna_c8103c9f:

    # C "You help guys like that, they spread the word about how kind we are."
    C "Ayudas a tipos como ese, ellos difunden la palabra sobre lo amables que somos."

# game/script.rpy:2249

translate spanish anna_fae2ac2f:

    # C "Boosts your rep, spreads rumors, profit goes up — win-win."
    C "Acelera tu reputación, propaga rumores, aumenta el beneficio — gana-ganar."

# game/script.rpy:2251

translate spanish anna_27b325ad:

    # mc "You’ve got an interesting way of thinking, but…"
    mc "Tienes una forma interesante de pensar, pero..."

# game/script.rpy:2252

translate spanish anna_c584d96d:

    # mc "This time, something went wrong."
    mc "Esta vez, algo salió mal."

# game/script.rpy:2254

translate spanish anna_06021762:

    # mc "What would’ve happened if I hadn’t shown up?"
    mc "¿Qué habría pasado si no hubiera aparecido?"

# game/script.rpy:2261

translate spanish anna_83cfaf93:

    # C "Honestly? {w}I have no idea."
    C "¿Honestamente? {w}No tengo ni idea."

# game/script.rpy:2262

translate spanish anna_116a474c:

    # C "They probably would’ve passed me around like a toy or just raped me outright."
    C "Probablemente me hubieran pasado como un juguete o me violaron de forma directa."

# game/script.rpy:2273

translate spanish anna_290accc8:

    # mc "You sure know how to cause her trouble."
    mc "Sabes cómo causarle problemas."

# game/script.rpy:2276

translate spanish anna_39b4b2c0:

    # C "Wouldn’t be me otherwise. I had to put up with her antics when we were kids — now it’s her turn."
    C "No sería yo de otra manera. Tuve que aguantar sus tics cuando éramos niños, ahora es su turno."

# game/script.rpy:2279

translate spanish anna_d16c39cc:

    # mc "Wait, you’re doing this on purpose?"
    mc "Espera, ¿estás haciendo esto a propósito?"

# game/script.rpy:2281

translate spanish anna_d11f6fd4:

    # C "Of course. What, you think I’m some kind of idiot?"
    C "Por supuesto. ¿Crees que soy una especie de idiota?"

# game/script.rpy:2285

translate spanish anna_f1ae52f2:

    # C "Hey! That was rude!"
    C "¡Eso fue grosero!"

# game/script.rpy:2286

translate spanish anna_dd98b39c:

    # mc "Just kidding. Sorry."
    mc "Solo bromeaba."

# game/script.rpy:2287

translate spanish anna_28b1f199:

    # C "{b}sigh{/b}"
    C "{b}Suspirante{/b}"

# game/script.rpy:2289

translate spanish anna_1c6dbaca:

    # C "So... what’s the plan for tonight?"
    C "Entonces... ¿cuál es el plan para esta noche?"

# game/script.rpy:2290

translate spanish anna_e67f89dc:

    # mc "Our plans? None."
    mc "¿Nuestros planes?"

# game/script.rpy:2293

translate spanish anna_684fbe4a:

    # mc "My plans? Meeting your sister."
    mc "Conoce a tu hermana."

# game/script.rpy:2294

translate spanish anna_21d9959f:

    # C "Ugh, you’re {b}such{/b} a grump."
    C "Ugh, eres {b}tales como tales{/b} un gruñón."

# game/script.rpy:2316

translate spanish anna_436a296c:

    # D "Ah..."
    D "Ah..."

# game/script.rpy:2318

translate spanish anna_0834e132:

    # D "Ah... My head...."
    D "Mi cabeza..."

# game/script.rpy:2322

translate spanish anna_177e0fb9:

    # D "What the hell is this?"
    D "¿Qué demonios es esto?"

# game/script.rpy:2324

translate spanish anna_80a77f48:

    # D "I didn’t sign up for this... What? Why’d you freeze up like that?"
    D "No me inscribí para esto... ¿Por qué te congelaste así?"

# game/script.rpy:2326

translate spanish anna_e199ba8a:

    # aa "{font=Cybertron.otf}What do we do with him? He didn’t try to harm our target."
    aa "{font=Cybertron.otf}¿Qué hacemos con él? Él no trató de dañar nuestro objetivo."

# game/script.rpy:2328

translate spanish anna_e634bff9:

    # a "{font=Cybertron.otf}He saw us — that’s unacceptable."
    a "{font=Cybertron.otf}Nos vio —eso es inaceptable."

# game/script.rpy:2337

translate spanish anna_dc3e98e5:

    # C "You know… I may not look it, but I was really glad to run into you in that alley."
    C "Sabes... no lo veo, pero me alegré mucho de encontrarme contigo en ese callejón."

# game/script.rpy:2338

translate spanish anna_477a3c79:

    # C "But really — what brings you here?"
    C "Pero realmente — ¿qué te trae aquí?"

# game/script.rpy:2341

translate spanish anna_ed76b433:

    # mc "Seriously, a guy my age doesn’t belong in places like this."
    mc "En serio, un tipo de mi edad no pertenece a lugares como este."

# game/script.rpy:2344

translate spanish anna_24a6239b:

    # C "Nobody else thinks that but you. You should drop by more often. It’d make sis happy."
    C "Nadie más piensa eso, pero tú. Deberías venir más a menudo. Haría que sis feliz."

# game/script.rpy:2348

translate spanish anna_50c00c04:

    # x "No way… My eyes must be deceiving me!"
    x "De ninguna manera... ¡Mis ojos deben engañarme!"

# game/script.rpy:2350

translate spanish anna_a62cabb3:

    # mc "I know that voice…"
    mc "Conozco esa voz..."

# game/script.rpy:2353

translate spanish anna_a7cbfb9e:

    # x "HERMANO! What brings you here?!"
    x "¿Qué te trae aquí?"

# game/script.rpy:2356

translate spanish anna_53a34fd3:

    # x "Great to see you, amigo! Seven years, and you’ve only gotten stronger!"
    x "¡Es genial verte, amigo! Siete años, y solo te has hecho más fuerte!"

# game/script.rpy:2361

translate spanish anna_7c3045f8:

    # x "Still training, huh? You’re in great shape as always, Commander!"
    x "Aún entrenando, ¿eh? ¡Estás en gran forma como siempre, Comandante!"

# game/script.rpy:2363

translate spanish anna_5969be05:

    # mc "The feeling’s mutual. But what are you doing here, Alexandro?"
    mc "El sentimiento es mutuo. ¿Pero qué haces aquí, Alexandro?"

# game/script.rpy:2365

translate spanish anna_64503be1:

    # x "Hahaha! A lot’s changed since we last met."
    x "Hahaha! Mucho ha cambiado desde que nos conocimos."

# game/script.rpy:2370

translate spanish anna_7696db35:

    # x "You know better than anyone, Commander — vets have a hard time finding honest work these days."
    x "Usted sabe mejor que nadie, Comandante — los veterinarios tienen un difícil momento de encontrar trabajo honesto estos días."

# game/script.rpy:2371

translate spanish anna_91d9516c:

    # x "Gotta feed the family, right?"
    x "Tengo que alimentar a la familia, ¿verdad?"

# game/script.rpy:2374

translate spanish anna_9d5e56ee:

    # x "Thanks to Miss Anya and Olivia, I can take care of my family without depriving them of anything."
    x "Gracias a la Srta. Anya y Olivia, puedo cuidar de mi familia sin privarles de nada."

# game/script.rpy:2375

translate spanish anna_349471c6:

    # x "I’m truly grateful to them."
    x "Estoy realmente agradecido con ellos."

# game/script.rpy:2377

translate spanish anna_a3d2e4f8:

    # C "We should be thanking you. Not every club can afford a security guard with your experience."
    C "No todos los clubes pueden permitirse un guardia de seguridad con su experiencia."

# game/script.rpy:2378

translate spanish anna_3f4c7c30:

    # C "It’s been a win-win for us."
    C "Ha sido un ganador para nosotros."

# game/script.rpy:2380

translate spanish anna_108d4dd5:

    # mc "I’m happy for you, Alexandro. I really am."
    mc "Estoy feliz por ti, Alexandro. Realmente lo soy."

# game/script.rpy:2383

translate spanish anna_a21e86ee:

    # x "..."
    x "..."

# game/script.rpy:2385

translate spanish anna_ef2434ce:

    # x "Commander… You okay? You look—"
    x "Comandante... ¿se encuentra bien?"

# game/script.rpy:2388

translate spanish anna_2b35b6fe_8:

    # mc "..."
    mc "..."

# game/script.rpy:2389

translate spanish anna_a21e86ee_1:

    # x "..."
    x "..."

# game/script.rpy:2391

translate spanish anna_e40e9c51:

    # x "Sorry, sir, I have to take this call."
    x "Lo siento, señor, tengo que tomar esta llamada."

# game/script.rpy:2395

translate spanish anna_544da1bf:

    # x "Yes?"
    x "¿Sí?"

# game/script.rpy:2397

translate spanish anna_a21e86ee_2:

    # x "..."
    x "..."

# game/script.rpy:2399

translate spanish anna_6aa970fe:

    # mc "(Is it really that obvious? I thought I’d left her in the past…)"
    mc "(¿Es realmente tan obvio? Pensé que la había dejado en el pasado...)"

# game/script.rpy:2401

translate spanish anna_aa968471:

    # mc "(Or was I just fooling myself…)"
    mc "(O estaba engañando a mí mismo...)"

# game/script.rpy:2405

translate spanish anna_587302da:

    # x "WHAT?!"
    x "¿Qué?"

# game/script.rpy:2406

translate spanish anna_6a8a18b9:

    # x "No way… "
    x "De ninguna manera... "

# game/script.rpy:2407

translate spanish anna_876eda85:

    # x "How could they—"
    x "¿Cómo pudieron...?"

# game/script.rpy:2408

translate spanish anna_e8f87c21:

    # x "They threw out…... {w=1}my {w=1}plush crocodiles?!"
    x "Ellos echaron... {w=1}mi {w=1}¿Cocodrilos de felpa?"

# game/script.rpy:2412

translate spanish anna_413aaee4:

    # x "NOOOOOOOOOOO!"
    x "¡No!"

# game/script.rpy:2414

translate spanish anna_e3c0de3c:

    # x "My croc babies… They tossed them… in the trash…"
    x "Mis bebés de cría... los tiraron en la basura..."

# game/script.rpy:2417

translate spanish anna_bb7ed97d:

    # mc "Hey Alexandro, you good?"
    mc "Oye, Alexandro, ¿estás bien?"

# game/script.rpy:2419

translate spanish anna_0b2baf56:

    # C "He gets like this whenever someone brings up crocodiles."
    C "Se pone así cuando alguien trae cocodrilos."

# game/script.rpy:2421

translate spanish anna_9ec1cff3:

    # mc "Let’s pretend we didn’t see that."
    mc "Finjamos que no lo vimos."

# game/script.rpy:2423

translate spanish anna_d68faa52:

    # C "Yeah, good idea."
    C "Sí, buena idea."

# game/script.rpy:2427

translate spanish anna_1226d8ca:

    # mc "Good seeing you again, Alexandro."
    mc "Me alegro de verte de nuevo, Alexandro."

# game/script.rpy:2435

translate spanish anna_00a857d1:

    # C "Well, welcome to our humble little spot."
    C "Bien, bienvenido a nuestro pequeño lugar humilde."

# game/script.rpy:2437

translate spanish anna_225c6a70:

    # mc "If you call this place modest, I’m afraid to ask what you’d call {b}not modest{/b}."
    mc "Si usted llama a este lugar modesto, me temo preguntar lo que usted llamaría {b}no modesto{/b}."

# game/script.rpy:2439

translate spanish anna_3143bb5f:

    # C "Thanks, we’ve done quite a bit of work — expanded the place, revamped the interior."
    C "Gracias, hemos hecho un poco de trabajo — expandido el lugar, renovado el interior."

# game/script.rpy:2441

translate spanish anna_082fee30:

    # C "Now it feels more like a trendy lounge than the rundown bar it used to be."
    C "Ahora se siente más como un salón de moda que el bar de remate que solía ser."

# game/script.rpy:2443

translate spanish anna_49ee2c27:

    # C "Then again… bad comparison. Back then it wasn’t even a bar — more like a warehouse."
    C "Entonces, de nuevo... mala comparación. En aquel entonces ni siquiera era un bar, más como un almacén."

# game/script.rpy:2444

translate spanish anna_01786b28:

    # C "Or was it?"
    C "¿O era?"

# game/script.rpy:2446

translate spanish anna_2b35b6fe_9:

    # mc "..."
    mc "..."

# game/script.rpy:2448

translate spanish anna_95b63402:

    # C "Anyway, what’s on your mind?"
    C "De todas formas, ¿qué te pasa?"

# game/script.rpy:2450

translate spanish anna_c96d75cd:

    # mc "I have to admit, I’m impressed."
    mc "Tengo que admitirlo, estoy impresionado."

# game/script.rpy:2451

translate spanish anna_9bae714f:

    # mc "But... how the hell did you pull this off?"
    mc "Pero... ¿cómo demonios lo lograste?"

# game/script.rpy:2453

translate spanish anna_4f38bc25:

    # C "Deep sigh"
    C "Suspirante profundo"

# game/script.rpy:2455

translate spanish anna_e4eec204:

    # C "Mmh... that’s a secret I’m not quite ready to share."
    C "Mmh... eso es un secreto que no estoy listo para compartir."

# game/script.rpy:2457

translate spanish anna_296d16fe:

    # mc "Just as I thought. {b}She{/b} had a hand in it, didn’t she?"
    mc "Como pensaba. {b}Ella{/b} Tenía una mano en ella, ¿no?"

# game/script.rpy:2459

translate spanish anna_938bd42d:

    # C "Well... it wasn’t {b}just{/b} her. But yeah, Olivia did the heavy lifting."
    C "Bueno... no fue {b}Solo{/b} Pero sí, Olivia hizo el pesado levantamiento."

# game/script.rpy:2460

translate spanish anna_0bf51414:

    # C "Permits, paperwork, investors — she handled it all."
    C "Permisos, papeleo, inversores — ella lo maneja todo."

# game/script.rpy:2462

translate spanish anna_13179d9f:

    # C "Even managed to attract some serious sponsors who somehow believed in this place. {w}But..."
    C "Incluso logró atraer a algunos patrocinadores serios que de alguna manera creían en este lugar. {w}Pero..."

# game/script.rpy:2463

translate spanish anna_970bede4:

    # C "How are you holding up? We heard what happened. I’m sorry — she… was an amazing woman."
    C "¿Cómo estás sosteniendo? Oímos lo que pasó. Lo siento — ella... era una mujer increíble."

# game/script.rpy:2465

translate spanish anna_2b35b6fe_10:

    # mc "..."
    mc "..."

# game/script.rpy:2467

translate spanish anna_547b2e22:

    # mc "Yeah. She was... "
    mc "Sí, ella era... "

# game/script.rpy:2469

translate spanish anna_783afe67:

    # mc "So, did you finally get into that university? It was your dream, right?"
    mc "¿Por fin entraste en esa universidad?"

# game/script.rpy:2483

translate spanish anna_18788dee:

    # mc "Someone over there looks like she’s about to explode..."
    mc "Alguien de ahí parece que está a punto de explotar..."

# game/script.rpy:2485

translate spanish anna_e049bb20:

    # C "No idea who you mean..."
    C "No sé a quién te refieres..."

# game/script.rpy:2492

translate spanish anna_8fa64c8a:

    # h "Touch me one more time and I {b}swear{/b} — I’ll kill you where you stand."
    h "Tócame una vez más y yo {b}Juro{/b} - Te mataré donde estés."

# game/script.rpy:2494

translate spanish anna_07f18299:

    # h "Get your lazy ass up — and get out."
    h "Levanta tu culo perezoso y lárgate."

# game/script.rpy:2496

translate spanish anna_e723ef53:

    # h "Run, you sleazy maggot, before I cut your fingers off!"
    h "¡Corre, gusano desgarrador, antes de que te corte los dedos!"

# game/script.rpy:2498

translate spanish anna_3bf70d01:

    # C "Oof. Yep. That’s full-on rage mode."
    C "Sí. Eso es el modo de rabia completo."

# game/script.rpy:2499

translate spanish anna_57fb2979:

    # C "She’s absolutely {b}fuming{/b}."
    C "Ella es absolutamente {b}¡Me cago en la mierda!{/b}."

# game/script.rpy:2501

translate spanish anna_422fb43f:

    # mc "She hasn’t changed at all."
    mc "No ha cambiado nada."

# game/script.rpy:2503

translate spanish anna_2aee391d:

    # C "She has to act like that. Every day she gets droves of cocky little boys thinking they can get into her pants."
    C "Cada día se le dan las vueltas a los niños pequeños creyendo que pueden meterse en sus pantalones."

# game/script.rpy:2509

translate spanish anna_c69f85a8:

    # mc "All these years, and you haven’t changed a bit."
    mc "Todos estos años, y no has cambiado un poco."

# game/script.rpy:2511

translate spanish anna_7affac1e:

    # mc "Sup."
    mc "Suficiente."

# game/script.rpy:2517

translate spanish anna_27da4b9b:

    # mc "Just thought I’d stop by. See how you’ve been holding up all this time."
    mc "Pensé que pasaría por aquí. Vea cómo ha estado reteniendo todo este tiempo."

# game/script.rpy:2519

translate spanish anna_3c2d2b30:

    # C "Sis, ever think about not throwing knives at customers?"
    C "Sis, ¿alguna vez piensas en no lanzar cuchillos a los clientes?"

# game/script.rpy:2521

translate spanish anna_b1831d79:

    # h "How I’ve been…?"
    h "¿Cómo he estado...?"

# game/script.rpy:2522

translate spanish anna_b80f5761:

    # h "Oh, I’m {b}thriving{/b}, can’t you tell?"
    h "Oh, yo soy {b}prosperando{/b}¿No puedes decirlo?"

# game/script.rpy:2524

translate spanish anna_5e8ed25f:

    # h "Signed a few fat contracts, found sponsors, expanded this place..."
    h "Firmó unos contratos de grasa, encontró patrocinadores, expandió este lugar..."

# game/script.rpy:2525

translate spanish anna_9bc96545:

    # h "Even opened another bar on the far end of town."
    h "Incluso abrió otro bar en el extremo de la ciudad."

# game/script.rpy:2527

translate spanish anna_5f33f7a8:

    # C "Don’t ignore me!"
    C "¡No me ignores!"

# game/script.rpy:2530

translate spanish anna_0e5676c8:

    # C "Wait… are you actually upset?"
    C "Espera... ¿estás realmente molesto?"

# game/script.rpy:2536

translate spanish anna_50435b7f:

    # C "Poke."
    C "Poke."

# game/script.rpy:2538

translate spanish anna_ec5bbfff:

    # C "C’mon, don’t pout. So I didn’t answer your messages — big deal."
    C "Vamos, no te des cuenta. Así que no respondí a tus mensajes — gran cosa."

# game/script.rpy:2540

translate spanish anna_b82880b1:

    # C "Enough of that. Go bless our guest with one of your dazzling smiles."
    C "Ve a bendecir a nuestro invitado con una de tus sonrisas deslumbrantes."

# game/script.rpy:2544

translate spanish anna_2bc315e6:

    # h "It’s the same routine over and over — {w=0.7}sleep, {w=0.5}work, {w=0.4}sleep, {w=0.3}work, {w=0.2}SLEEP, {w=0.1}WORK…"
    h "Es la misma rutina una y otra vez: {w=0.7}dormir, {w=0.5}trabajar, {w=0.4}dormir, {w=0.3}trabajar, {w=0.2}DORMIR, {w=0.1}TRABAJAR..."

# game/script.rpy:2546

translate spanish anna_46bdd0ea:

    # h "I’m so fed up with it, you know? {w=0.9}HA-{w=0.2}HA-{w=0.1}HA, {w=0.5}the same damn thing for the past seven years, {w=1.2}and in all this time, I haven’t managed to find myself a boyfriend, {w=0.9}let alone a husband..."
    h "Estoy harta, ¿sabes? {w=0.9}JA-{w=0.2}JA-{w=0.1}JA, {w=0.5}siete años con la misma maldita rutina, {w=1.2}y en todo este tiempo ni siquiera conseguí novio, {w=0.9}mucho menos marido..."

# game/script.rpy:2548

translate spanish anna_d2361ceb:

    # h "While all my friends are married with KIDS, {w=0.9}CAN YOU BELIEVE IT? {w=0.7}AND THEY KEEP COMING TO ME, {w=0.6}MOCKING ME, {w=0.3}LAUGHING THAT I HAVEN’T FOUND ANYONE IN ALL THESE YEARS."
    h "Mientras tanto, todas mis amigas están casadas y con HIJOS, {w=0.9}¿PUEDES CREERLO? {w=0.7}Y encima vienen a mí, {w=0.6}se burlan, {w=0.3}se ríen de que no haya encontrado a nadie en todos estos años."

# game/script.rpy:2550

translate spanish anna_5dcb2707:

    # h "But whatever, just forget it. {w=0.9}And to top it all off, {w=0.7}you know, I haven’t had a good {w=0.7}SCREW since THAT NIGHT… {w=0.7}FOR YEARS, AND YOU’RE STANDING HERE ASKING ME HOW I’M DOING???"
    h "Pero da igual, olvídalo. {w=0.9}Y para colmo, {w=0.7}¿sabes qué? No he tenido una buena {w=0.7}noche desde AQUELLA NOCHE... {w=0.7}DURANTE AÑOS, ¿Y VIENES A PREGUNTARME CÓMO ESTOY?"

# game/script.rpy:2557

translate spanish anna_2b35b6fe_11:

    # mc "..."
    mc "..."

# game/script.rpy:2558

translate spanish anna_d20cd7c8:

    # a "You know we’d love to spend the night with you!"
    a "¡Sabes que nos encantaría pasar la noche contigo!"

# game/script.rpy:2560

translate spanish anna_e330db04:

    # h "Yeah, yeah — screw you!"
    h "¡Sí, sí, jodete!"

# game/script.rpy:2563

translate spanish anna_5d4788a0:

    # mc "But after all this time… with the way people look at you — the attention, the admirers — you could’ve had anyone."
    mc "Pero después de todo este tiempo... con la forma en que la gente te mira — la atención, los admiradores— podrías haber tenido a alguien."

# game/script.rpy:2565

translate spanish anna_c1ee6081:

    # h "{b}Scoffs{/b} That’s the thing. It’s not about who {b}wants{/b} me. It’s about who’s {b}worth{/b} letting in."
    h "{b}Scoffs{/b} Esa es la cosa. No se trata de quién {b}quiere{/b} yo. Es sobre quién es {b}valía la pena{/b} Deja entrar."

# game/script.rpy:2569

translate spanish anna_2b35b6fe_12:

    # mc "..."
    mc "..."

# game/script.rpy:2571

translate spanish anna_964fd174:

    # h "And no — it’s not about Anya. If that’s what you’re thinking."
    h "Y no — no es sobre Anya. Si eso es lo que estás pensando."

# game/script.rpy:2577

translate spanish anna_71c85015:

    # mc "In that case, I guess I don’t need to worry so much."
    mc "En ese caso, supongo que no necesito preocuparme tanto."

# game/script.rpy:2579

translate spanish anna_e1cb9ea0:

    # h "...How are {b}you{/b} holding up?"
    h "...¿Y {b}tú{/b} cómo lo llevas?"

# game/script.rpy:2580

translate spanish anna_061c5313:

    # h "I heard about what happened. I’m… sorry. Truly."
    h "He oído lo que ha pasado. Lo siento."

# game/script.rpy:2582

translate spanish anna_2b35b6fe_13:

    # mc "..."
    mc "..."

# game/script.rpy:2586

translate spanish anna_d646432a:

    # mc "I’ve got a favor to ask. Can you take a look at this?"
    mc "Tengo un favor que pedir. ¿Puedes echar un vistazo a esto?"

# game/script.rpy:2588

translate spanish anna_5c1aa3a3:

    # mc "I know after what happened eight years ago, we said we were done with this, but…"
    mc "Sé después de lo que pasó hace ocho años, dijimos que habíamos terminado con esto, pero..."

# game/script.rpy:2590

translate spanish anna_2b3c233e:

    # mc "The past won’t stop following us."
    mc "El pasado no parará de seguirnos."

# game/script.rpy:2601

translate spanish anna_2880ec12:

    # h "But… he’s dead..."
    h "Pero... está muerto..."

# game/script.rpy:2602

translate spanish anna_5832e1c5:

    # h "You personally shot him back in Al-Zahira 8 years ago…"
    h "Lo devolviste a disparar en Al-Zahira hace 8 años..."

# game/script.rpy:2604

translate spanish anna_1f88b0fc:

    # mc "So I thought. But this photo says otherwise."
    mc "Así que pensé, pero esta foto dice lo contrario."

# game/script.rpy:2605

translate spanish anna_16bb9583:

    # mc "He’s alive. And looking healthier than either of us, by the way."
    mc "Está vivo. Y mirando más sano que cualquiera de nosotros, por cierto."

# game/script.rpy:2607

translate spanish anna_81a847b5:

    # mc "But that’s not even the main reason I came."
    mc "Pero esa no es la razón principal por la que vine."

# game/script.rpy:2608

translate spanish anna_ae75decf:

    # mc "Take a look at the other one."
    mc "Echa un vistazo a la otra."

# game/script.rpy:2610

translate spanish anna_f48b6b55:

    # h "You can't be serious..."
    h "No hablas en serio."

# game/script.rpy:2612

translate spanish anna_40d067f2:

    # h "Is that—?"
    h "¿Eso es...?"

# game/script.rpy:2613

translate spanish anna_f25320ab:

    # mc "I’m not sure. But I need to find out for myself."
    mc "No estoy seguro, pero necesito averiguarlo por mí mismo."

# game/script.rpy:2615

translate spanish anna_66935cd6:

    # h "Anya, we’re closing for tonight. Let the customers know they have one hour to leave."
    h "Anya, estamos cerrando para esta noche. Que los clientes sepan que tienen una hora para salir."

# game/script.rpy:2617

translate spanish anna_8fde1adf:

    # mc "Won’t that hurt your reputation?"
    mc "¿No te dolerá esa reputación?"

# game/script.rpy:2619

translate spanish anna_13cb9d66:

    # h "There’s more at stake than my bar’s reputation."
    h "Hay más en juego que la reputación de mi bar."

# game/script.rpy:2629

translate spanish anna_2b35b6fe_14:

    # mc "..."
    mc "..."

# game/script.rpy:2634

translate spanish anna_fdb21d1b:

    # h "Where did you get this info?"
    h "¿Dónde conseguiste esta información?"

# game/script.rpy:2636

translate spanish anna_b0eb7a86:

    # mc "Norman gave me this earlier today."
    mc "Norman me dio esto antes hoy."

# game/script.rpy:2642

translate spanish anna_1bf127fa:

    # h "How reliable is it?"
    h "¿Qué confiable es?"

# game/script.rpy:2644

translate spanish anna_38c137ac:

    # mc "One hundred percent."
    mc "Cien por ciento."

# game/script.rpy:2648

translate spanish anna_cbeb5dad:

    # h "We lost Jacob and Mona that day. Alexandro lost a leg — became disabled."
    h "Perdimos a Jacob y Mona ese día. Alexandro perdió una pierna — se desactiva."

# game/script.rpy:2649

translate spanish anna_d694365e:

    # h "All because one idiot commander ordered friendly fire. Brilliant."
    h "Todo porque un comandante idiota ordenó fuego amistoso."

# game/script.rpy:2651

translate spanish anna_f0a7c2ef:

    # h "And now, after all this time — they come to you and ask you to come back?"
    h "Y ahora, después de todo este tiempo, ¿vienen a ti y te piden que vuelvas?"

# game/script.rpy:2652

translate spanish anna_731e85e8:

    # h "Please tell me you told them to fuck off."
    h "Por favor, dime que les dijiste que se jodieran."

# game/script.rpy:2654

translate spanish anna_2b35b6fe_15:

    # mc "..."
    mc "..."

# game/script.rpy:2656

translate spanish anna_d9345b7c:

    # mc "You know Richard smoothed things over."
    mc "Sabes que Richard suavizó las cosas."

# game/script.rpy:2658

translate spanish anna_d1564739:

    # h "Of course… So you didn’t."
    h "Por supuesto... así que no lo hiciste."

# game/script.rpy:2660

translate spanish anna_3157df0a:

    # mc "Azarkhan’s people infiltrated too deep — it’s not Richard’s fault."
    mc "La gente de Azarkhan se infiltró demasiado profundamente — no es culpa de Richard."

# game/script.rpy:2662

translate spanish anna_6e49a605:

    # h "We both know that’s bullshit. This is all because of that photo of Lora."
    h "Ambos sabemos que es una mierda. Todo esto es por esa foto de Lora."

# game/script.rpy:2663

translate spanish anna_bfc16689:

    # h "That’s the only reason you’re thinking of going back."
    h "Esa es la única razón por la que estás pensando en volver."

# game/script.rpy:2665

translate spanish anna_2b35b6fe_16:

    # mc "..."
    mc "..."

# game/script.rpy:2667

translate spanish anna_fd455c4b:

    # h "I get it. You served your country, came back to live a peaceful life."
    h "Lo entiendo, has servido a tu país, has vuelto a vivir una vida pacífica."

# game/script.rpy:2668

translate spanish anna_77be7aee:

    # h "Then boom — your wife is declared dead, your son goes off the rails."
    h "Entonces boom — su esposa es declarada muerta, su hijo se va de los carriles."

# game/script.rpy:2670

translate spanish anna_01a38230:

    # h "And just when things start to settle — bam, new info."
    h "Y justo cuando las cosas comienzan a establecerse — bam, nueva información."

# game/script.rpy:2674

translate spanish anna_c33e5ba0:

    # h "{b}Did you know? That global terrorist you supposedly killed is alive!{/b}"
    h "{b}¡El terrorista global que supuestamente mataste está vivo!{/b}"

# game/script.rpy:2675

translate spanish anna_0f279898:

    # h "Or {b}We thought your wife was dead — turns out, nope! Here are some photos!{/b}"
    h "O {b}Pensamos que su esposa estaba muerta — resulta que no, no! Aquí están algunas fotos!{/b}"

# game/script.rpy:2677

translate spanish anna_2b35b6fe_17:

    # mc "..."
    mc "..."

# game/script.rpy:2679

translate spanish anna_e806831e:

    # mc "What is this, a lollipop?"
    mc "¿Qué es esto, un piruleta?"

# game/script.rpy:2683

translate spanish anna_21ec3fe9:

    # h "I quit smoking, remember?"
    h "Dejé de fumar, ¿recuerdas?"

# game/script.rpy:2684

translate spanish anna_e141f637:

    # h "And this is a great replacement. So win-win."
    h "Y esto es un gran reemplazo, así que ganar-ganar."

# game/script.rpy:2688

translate spanish anna_0bc0872f:

    # h "You know, [mc]… maybe it’s not worth it."
    h "Sabes, [mc]... tal vez no vale la pena."

# game/script.rpy:2689

translate spanish anna_1acc80a4:

    # h "I get it — bringing Lora back sounds great. But what if it’s not her?"
    h "Lo entiendo, traer a Lora suena genial. Pero, ¿qué pasa si no es ella?"

# game/script.rpy:2693

translate spanish anna_847bb052:

    # h "Maybe it’s time to stop. Look around."
    h "Quizá sea hora de parar. Mira a tu alrededor."

# game/script.rpy:2694

translate spanish anna_6d3351f6:

    # h "Be content with what you have — because even that won’t last forever."
    h "Contrólate con lo que tienes, porque incluso eso no durará para siempre."

# game/script.rpy:2698

translate spanish anna_49ed78bb:

    # h "Just some friendly advice."
    h "Solo un consejo amistoso."

# game/script.rpy:2700

translate spanish anna_1bb7aaaf:

    # mc "Maybe you’re right…"
    mc "Tal vez tengas razón..."

# game/script.rpy:2701

translate spanish anna_394487b2:

    # mc "But if there’s even the slightest chance I can bring her back — I’m taking it."
    mc "Pero si hay incluso la menor oportunidad de traerla de vuelta — lo estoy tomando."

# game/script.rpy:2705

translate spanish anna_b6cade35:

    # h "You’re so…"
    h "Eres tan..."

# game/script.rpy:2709

translate spanish anna_58de2916:

    # C "Sis, we’ve got trouble."
    C "Sis, tenemos problemas."

# game/script.rpy:2711

translate spanish anna_70b99be3:

    # h "What’s going on?"
    h "¿Qué está pasando?"

# game/script.rpy:2715

translate spanish anna_42984d20:

    # h "Why the silence? We don’t have much time."
    h "¿Por qué el silencio? No tenemos mucho tiempo."

# game/script.rpy:2720

translate spanish anna_8dd01578:

    # C "Some guests are getting very aggressive."
    C "Algunos invitados se están volviendo muy agresivos."

# game/script.rpy:2722

translate spanish anna_33c05afa:

    # h "We’ve got plenty of security — couldn’t you just ask Alexandro to kick them out?"
    h "Tenemos mucha seguridad, ¿no podrías pedirle a Alexandro que los echara?"

# game/script.rpy:2724

translate spanish anna_7b100b28:

    # C "This one’s some bigshot. We can’t use force."
    C "Este es un poco grande. No podemos usar la fuerza."

# game/script.rpy:2726

translate spanish anna_c79204d0:

    # mc "I’ve gotta go."
    mc "Tengo que irme."

# game/script.rpy:2727

translate spanish anna_18360e7b:

    # mc "If you change your mind — tomorrow, 5:00 a.m. Outside my place."
    mc "Si cambias de opinión, mañana a las 5:00 a.m. fuera de mi lugar."

# game/script.rpy:2729

translate spanish anna_33ab0adc:

    # h "Maybe. No promises."
    h "Quizá. No prometo nada."

# game/script.rpy:2731

translate spanish anna_26a803bc_3:

    # C "..."
    C "..."

# game/script.rpy:2743

translate spanish norman_home_8ddfa823:

    # ri "My dear old friend,"
    ri "Mi querido viejo amigo,"

# game/script.rpy:2745

translate spanish norman_home_b7016d79:

    # ri "I’ve been meaning to write to you for a long time."
    ri "He querido escribirte por mucho tiempo."

# game/script.rpy:2747

translate spanish norman_home_3b9b2de5:

    # ri "Something always stopped me — wrong time, wrong place, or maybe I just didn’t know how to begin."
    ri "Algo siempre me detuvo — tiempo equivocado, lugar equivocado, o tal vez no sabía cómo empezar."

# game/script.rpy:2749

translate spanish norman_home_f2ab4356:

    # ri "I hope this letter finds you and your loved ones in good health."
    ri "Espero que esta carta te encuentre a ti y a tus seres queridos en buena salud."

# game/script.rpy:2751

translate spanish norman_home_1184b6df:

    # ri "I know how much you hate reading reports and briefings."
    ri "Sé cuánto odia leer informes y reuniones informativas."

# game/script.rpy:2753

translate spanish norman_home_ac14f50d:

    # ri "That’s why I’m writing you this letter..."
    ri "Por eso te escribo esta carta..."

# game/script.rpy:2755

translate spanish norman_home_307c1bee:

    # ri "Not as your Commander-in-Chief, but as your old friend."
    ri "No como su Comandante en Jefe, sino como su viejo amigo."

# game/script.rpy:2757

translate spanish norman_home_5fb3cdc9:

    # ri "The world is in unrest — granted, it always has been, but now the tension has reached a breaking point."
    ri "El mundo está en malestar —concedido, siempre lo ha sido, pero ahora la tensión ha llegado a un punto de ruptura."

# game/script.rpy:2759

translate spanish norman_home_744d3292:

    # ri "If we don’t act, it won’t just affect you — it’ll affect everyone you care about."
    ri "Si no actuamos, no solo te afectará a ti, sino que afectará a todos los que te importan."

# game/script.rpy:2761

translate spanish norman_home_58a54654:

    # ri "Azarkhan has returned from the dead. {b}How{/b} — we don’t know."
    ri "Azarkhan ha vuelto de los muertos. {b}¿Cómo?{/b} - no lo sabemos."

# game/script.rpy:2763

translate spanish norman_home_b7812c65:

    # ri "But we’ve uncovered some information suggesting he’s backed by powerful entities. Possibly... {w}extraterrestrial."
    ri "Pero hemos descubierto alguna información que sugiere que está respaldado por entidades poderosas. Posiblemente... {w}extraterrestre."

# game/script.rpy:2765

translate spanish norman_home_13a12bc6:

    # ri "I know how insane that sounds."
    ri "Sé lo loco que suena."

# game/script.rpy:2767

translate spanish norman_home_845f8bbd:

    # ri "I wish I could share the details, but I can’t do that in a letter."
    ri "Desearía poder compartir los detalles, pero no puedo hacerlo en una carta."

# game/script.rpy:2770

translate spanish norman_home_f29205f5:

    # ri "And yet, not mentioning the following would be a mistake."
    ri "Y sin embargo, sin mencionar lo siguiente sería un error."

# game/script.rpy:2772

translate spanish norman_home_a68194dd:

    # ri "What I can say is this: we found a photo, taken just before Lora disappeared."
    ri "Lo que puedo decir es esto: encontramos una foto, tomada justo antes de que Lora desapareciera."

# game/script.rpy:2774

translate spanish norman_home_3d194cce:

    # ri "We don’t know who took it, but it changed everything."
    ri "No sabemos quién lo tomó, pero cambió todo."

# game/script.rpy:2776

translate spanish norman_home_8b54a8bb:

    # ri "Azarkhan’s return, Lora’s vanishing, and what you saw eight years ago — they’re all connected. {w}To that forest."
    ri "El regreso de Azarkhan, el desaparecimiento de Lora, y lo que viste hace ocho años, están todos conectados. {w}A ese bosque."

# game/script.rpy:2779

translate spanish norman_home_714f1860:

    # ri "Or more precisely — to what’s {b}in{/b} it."
    ri "O más precisamente, a lo que {b}in in ingles{/b} Es."

# game/script.rpy:2780

translate spanish norman_home_4d1b81bf:

    # ri "That’s why I’m asking. We need your help."
    ri "Por eso estoy preguntando. Necesitamos tu ayuda."

# game/script.rpy:2782

translate spanish norman_home_684f72e8:

    # ri "P.S. You’ll find coordinates at the bottom. If you decide you want answers."
    ri "P.S. Encontrarás coordenadas en la parte inferior. Si decides que quieres respuestas."

# game/script.rpy:2787

translate spanish norman_home_001c33a2:

    # mc "(Going to an unknown place, based on a letter... {w}most would call that foolish.)"
    mc "(Ir a un lugar desconocido, basado en una carta... {w}la mayoría llamaría a ese tonto.)"

# game/script.rpy:2789

translate spanish norman_home_82011bfd:

    # mc "(And maybe they’d be right. {w}Maybe I should just forget this whole thing.)"
    mc "(Y quizá tengan razón. {w}Quizá debería olvidarme de todo esto.)"

# game/script.rpy:2792

translate spanish norman_home_009eeb5a:

    # mc "(I know how stupid this looks. A letter, ghosts of the past, coordinates to nowhere. But... I can’t just turn my back on it.)"
    mc "(Sé lo estúpido que parece esto. Una carta, fantasmas del pasado, se coordina a ninguna parte. Pero... no puedo simplemente darle la espalda.)"

# game/script.rpy:2795

translate spanish norman_home_9adcca9e:

    # mc "(There are answers buried there. Answers I’ve been denied. A life I never got to live.)"
    mc "(Hay respuestas sepultadas allí. Respuestas Me han negado. Una vida que nunca tuve que vivir.)"

# game/script.rpy:2797

translate spanish norman_home_12f1731a:

    # mc "(All of it gives me a strange kind of hope.)"
    mc "(Todo esto me da una extraña esperanza.)"

# game/script.rpy:2802

translate spanish norman_home_08bf5c2b:

    # mc "(That hope… it became my new reason to keep moving forward.)"
    mc "(Esa esperanza... se convirtió en mi nueva razón para seguir adelante.)"

# game/script.rpy:2807

translate spanish norman_home_ec0580a4:

    # mc "(Like I’ve gone back in time — to when I was young.)"
    mc "(Como he vuelto en el tiempo — a cuando era joven.)"

# game/script.rpy:2812

translate spanish norman_home_5f84aabc:

    # mc "(This time, I’ll find what I’ve been searching for.)"
    mc "(Esta vez, encontraré lo que he estado buscando.)"

# game/script.rpy:2814

translate spanish norman_home_fe0cc4b8:

    # mc "(End what began. Reclaim what was lost.)"
    mc "Reclamen lo que se perdió."

# game/script.rpy:2816

translate spanish norman_home_c8c0f479:

    # mc "Damn sights are off again..."
    mc "Maldita sea, la mira vuelve a estar desviada..."

# game/script.rpy:2827

translate spanish norman_home_9dffe9fb:

    # mc "Why aren’t you asleep? Something happen?"
    mc "¿Por qué no estás dormido?"

# game/script.rpy:2829

translate spanish norman_home_94140786:

    # N "—Dad, can I talk to you for a moment?"
    N "-Papá, ¿puedo hablar contigo un momento?"

# game/script.rpy:2831

translate spanish norman_home_2b35b6fe:

    # mc "..."
    mc "..."

# game/script.rpy:2834

translate spanish norman_home_99ce0db8:

    # mc "It’s late. You should get some sleep."
    mc "Es tarde. Deberías dormir un poco."

# game/script.rpy:2836

translate spanish norman_home_ed77797d:

    # N "DAD!"
    N "¡DAD!"

