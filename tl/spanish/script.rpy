    mc "Pero es tanto hijo para mí como cualquiera podría ser."

# game/script.rpy:3249

translate spanish exit_4743540b:

    # mc "Lora and I had... a hard time with children. So we turned to adoption."
    mc "Lora y yo tuvimos un mal momento con los niños, así que nos volvemos a la adopción."

# game/script.rpy:3251

translate spanish exit_f7277b62:

    # N "Hey! I wasn’t {b}that{/b} bad."
    N "¡Eh! No fui {b}tan{/b} malo."

# game/script.rpy:3252

translate spanish exit_770f971e:

