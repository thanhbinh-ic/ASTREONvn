# game/script.rpy:810

translate spanish war2_9132fb47:

    # mc "Positions. Twenty minutes."
    mc "Posiciones. Veinte minutos."

# game/script.rpy:822

translate spanish war2_fdaabc93:

    # mc "Move. Now."
    mc "Muévete."

# game/script.rpy:826

translate spanish war2_f5d3cca6:

    # x "Finally, some action... {w=0.7}Can’t wait to shred these bastards to pieces. {w=0.7}Just show yourselves."
    x "Por último, algo de acción... {w=0.7}No puedo esperar a que estos bastardos se desmenuzaran. {w=0.7}Solo muéstrase."

# game/script.rpy:828

translate spanish war2_f4fdb62e:

    # mc "Shiya. You in position?"
    mc "Shiya. ¿Estás en posición?"

# game/script.rpy:830

translate spanish war2_20993109:

    # S "Affirmative."
    S "Afirmativo."

# game/script.rpy:832

translate spanish war2_485b296e:

    # mc "Report."
    mc "Informe."

# game/script.rpy:833

translate spanish war2_849f1d73:

    # S "Movement spotted to the east — two vehicles."
    S "Movimiento localizado al este - dos vehículos."

# game/script.rpy:835

translate spanish war2_f41d8ad7:

    # S "One vehicle to the north. {w=0.7}Nothing else."
    S "Un vehículo al norte. {w=0.7}Nada más."

# game/script.rpy:836

translate spanish war2_4c8be30e:

    # mc "Hold. No engagement without my order."
    mc "No hay compromiso sin mi orden."

# game/script.rpy:840

translate spanish war2_5f8c7056:

    # S "And what if this is only part of the group?"
    S "¿Y si esto es solo parte del grupo?"

# game/script.rpy:841

translate spanish war2_cbe7890b:

    # S "Or did your dumb brain skip that thought and jump straight to action?"
    S "¿O tu tonto cerebro saltó ese pensamiento y saltó directo a la acción?"

# game/script.rpy:842

translate spanish war2_0b5aade4:

    # x "What did you just say? Stupid brain?! {w=0.7}Oh, you little perra!"
    x "¿Qué acabas de decir? {w=0.7}¡Oh, pequeña perra!"

# game/script.rpy:845

translate spanish war2_8b9ee863:

    # mc "Enough."
    mc "Suficiente."

# game/script.rpy:846

translate spanish war2_e11008ed:

    # mc "Alexandro — position. Now."
    mc "Alexandro, posición."

# game/script.rpy:847

translate spanish war2_e3f54460:

    # mc "Shiya — continue observation."
    mc "Shiya — continuar observación."

# game/script.rpy:848

translate spanish war2_f591cea5:

    # S "(whispering) Always complaining like a kid... {w=0.7}(louder)Understood."
    S "(susurrando) Siempre quejándose como un niño... {w=0.7}(En voz alta) Entendido."

# game/script.rpy:851

translate spanish war2_d3bd09e3:

    # mc "Target?"
    mc "¿Objetivo?"

# game/script.rpy:852

translate spanish war2_48d39a64:

    # S "Negative. The target isn’t visible. {w=0.7}There’s a chance this is a decoy. {w=0.7}What are your orders, sir?"
    S "Negativo. El objetivo no es visible. {w=0.7}Hay una posibilidad de que esto sea un decoy. {w=0.7}¿Cuáles son sus órdenes, señor?"

# game/script.rpy:861

translate spanish war2_670f4b9f:

    # a "Well, well... it’s been a long time."
    a "Bueno, bueno... ha pasado mucho tiempo."

# game/script.rpy:864

translate spanish war2_058d97c8:

    # a "How’s the wife? {w=0.7}Daughter? {w=0.7}Everything great, I assume?"
