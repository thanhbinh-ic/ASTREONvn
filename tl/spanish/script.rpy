    # mc "You’re not real…"
    mc "No eres real..."

# game/script.rpy:2414

translate spanish anna_8bd034d1:
    # mc "(…So why does it feel like you are?)"
    mc "(...¿Entonces por qué se siente como si fueras tú?)"

# game/script.rpy:2417

translate spanish anna_9ec5f51f:
    # Lor "Hey… don’t start that again."
    Lor "Oye... no empieces de nuevo."

# game/script.rpy:2418

translate spanish anna_24755f83:
    # Lor "We both know where that spiral goes."
    Lor "Ambos sabemos adónde va esa espiral."

# game/script.rpy:2424

translate spanish anna_844d014a:
    # Lor "You’re scared."
    Lor "Estás asustado."

# game/script.rpy:2426

translate spanish anna_3fae39b4:
    # mc "I didn’t say that."
    mc "No dije eso."

# game/script.rpy:2428

translate spanish anna_02c0fff1:
    # Lor "You didn’t need to say it."
    Lor "No tenías que decirlo."

# game/script.rpy:2431

translate spanish anna_8c0412ba:
    # Lor "...Alright."
    Lor "...de acuerdo."

# game/script.rpy:2432

translate spanish anna_d0d4f056:
    # Lor "Let’s not pretend you don’t know why I’m here."
    Lor "No finjamos que no sabes por qué estoy aquí."

# game/script.rpy:2433

translate spanish anna_a194443c:
    # Lor "You saw the letter."
    Lor "Viste la carta."

# game/script.rpy:2434

translate spanish anna_9360410d:
    # Lor "That was enough."
    Lor "Eso fue suficiente."

# game/script.rpy:2436

translate spanish anna_cf1adef2:
    # mc "Yeah."
    mc "Sí."

# game/script.rpy:2437

translate spanish anna_d1387c49:
    # mc "They say they found out what happened to you."
    mc "Dicen que se enteraron de lo que te pasó."

# game/script.rpy:2438

translate spanish anna_071ff729:
    # mc "Why you disappeared."
    mc "Por qué desapareciste."

# game/script.rpy:2440

translate spanish anna_f5395ae9:
    # Lor "Wait…"
    Lor "Espera..."

# game/script.rpy:2441

translate spanish anna_0d778420:
    # Lor "Since when is Norman tied to the military?"
    Lor "¿Desde cuándo está atado Norman a los militares?"

# game/script.rpy:2442

translate spanish anna_d44a1583:
    # Lor "...No, right."
    Lor "No, claro."

# game/script.rpy:2443

translate spanish anna_4365a34d:
    # Lor "You never told me."
    Lor "Nunca me lo dijiste."

# game/script.rpy:2445

translate spanish anna_09f95b5c:
    # mc "He followed in my footsteps."
    mc "Seguía mis pasos."

# game/script.rpy:2446

translate spanish anna_055408f6:
    # mc "Though unlike me… he’s stuck behind a desk."
    mc "Aunque a diferencia de mí... está atrapado detrás de un escritorio."

# game/script.rpy:2447

translate spanish anna_84a3f8f6:
    # mc "Doesn’t see much of the front."
    mc "No ve mucho de la parte delantera."

# game/script.rpy:2448

translate spanish anna_dbcec2a5:
    # mc "Yeah… thanks for that, Richard."
    mc "Sí... gracias por eso, Richard."

# game/script.rpy:2450

translate spanish anna_eb286c94:
    # Lor "Oh."
    Lor "Oh."

# game/script.rpy:2451

translate spanish anna_e5e66875:
    # Lor "That’s why Alexa looked at him like that."
    Lor "Por eso Alexa lo miró así."

# game/script.rpy:2454

translate spanish anna_93b42537:
    # mc "(…And just like that—)"
    mc "(...y así...)"

# game/script.rpy:2461

translate spanish anna_7d99578b:
    # Lor "…Wait."
    Lor "...espera."

# game/script.rpy:2462

translate spanish anna_37e6a11b:
    # Lor "Is that Anya?"
    Lor "¿Es Anya?"

# game/script.rpy:2464

translate spanish anna_964e3083:
    # mc "Looks like it."
    mc "Parece que sí."

# game/script.rpy:2465

translate spanish anna_253ebf86:
    # mc "Probably got herself into trouble again."
    mc "Probablemente se metió en problemas otra vez."

# game/script.rpy:2467

translate spanish anna_f46e9117:
    # Lor "So?"
    Lor "¿Y?"

# game/script.rpy:2468

translate spanish anna_d890d8a9:
    # Lor "What are you going to do?"
    Lor "¿Qué vas a hacer?"

# game/script.rpy:2472

translate spanish anna_467e0a89:
    # mc "Like I’ve got a choice."
    mc "Como si tuviera elección."

# game/script.rpy:2473

translate spanish anna_88b09d1e:
    # mc "If Olivia hears about this… I’m dead before sunrise."
    mc "Si Olivia oye esto... estoy muerto antes del amanecer."

# game/script.rpy:2489

translate spanish anna_c6b0b742:
    # C "No, Jacob. I’m not your solution tonight."
    C "No, Jacob. No soy tu solución esta noche."

# game/script.rpy:2490

translate spanish anna_fd322812:
    # C "Or ever. Get that through your skull."
    C "O nunca, atravesa eso de tu cráneo."

# game/script.rpy:2493

translate spanish anna_2d5565c2:
    # d "Damn, Jacob. Didn’t you say she wouldn’t fight it?"
    d "Maldición, Jacob. ¿No dijiste que no lucharía?"

# game/script.rpy:2497

translate spanish anna_30cce330:
    # C "Find yourself some other desperate girl to dump this on. I don’t do charity."
    C "Encuentra a otra chica desesperada para dejar esto. No hago caridad."

# game/script.rpy:2498

translate spanish anna_ef6d7244:
    # C "Especially not for idiots."
    C "Especialmente no para idiotas."

# game/script.rpy:2507

translate spanish anna_5d860d27:
    # D "I’ve got to pick up my kid from my ex."
    D "Tengo que recoger a mi hijo de mi ex."

# game/script.rpy:2513

translate spanish anna_36ec17e3:
    # mc "Easy…"
    mc "Tranquilo..."

# game/script.rpy:2514

translate spanish anna_ddd8ffec:
    # mc "Don’t move."
    mc "No te muevas."

# game/script.rpy:2523

translate spanish anna_adadf7ee:
    # mc "(Someone’s got a death wish… going against Olivia.)"
    mc "(Alguien tiene un deseo de muerte... ir contra Olivia.)"

# game/script.rpy:2526

translate spanish anna_3f40bee3:
    # e "And what would a girl like her see in a loser like you? What, she into weaklings?"
    e "¿Y qué vería una chica como ella en un perdedor como tú?"

# game/script.rpy:2528

translate spanish anna_df8be869:
    # C "Oh wow… that’s your move? Beg, fail, and then stand there like furniture?"
    C "Oh wow... ¿eso es tu movimiento? ¿Pedir, fallar, y luego estar allí como muebles?"

# game/script.rpy:2531

translate spanish anna_1221c371:
    # e "Really? That’s great, mind if we get to know each other better?"
    e "¿En serio? Eso es genial, ¿te importa si nos conocemos mejor?"

# game/script.rpy:2532

translate spanish anna_86c1f8b1:
    # e "I’m sure we’d have a very memorable time."
    e "Estoy seguro de que tendríamos un momento muy memorable."

# game/script.rpy:2534

translate spanish anna_f98d475a:
    # e "Might even make each other... feel things."
    e "Podría incluso hacernos sentir cosas."

# game/script.rpy:2536

translate spanish anna_36a673b6:
    # C "You think this is flirting? That’s cute. Really. Almost embarrassing."
    C "¿Crees que esto es coquetear? Eso es lindo. Realmente. Casi vergonzoso."

# game/script.rpy:2538

translate spanish anna_28eb1bbd:
    # C "Kid, clean the milk off your lips before you start talking like you’ve seen the world."
    C "Niño, limpia la leche de tus labios antes de empezar a hablar como si hubieras visto el mundo."

# game/script.rpy:2539

translate spanish anna_65cf20b3:
    # C "And maybe, just maybe, learn who you’re barking at before you open your mouth again."
    C "Y tal vez, solo tal vez, aprendan a quién están ladrando antes de que abras la boca de nuevo."

# game/script.rpy:2543

translate spanish anna_4382d94c:
    # d "We’re gonna have some real fun with you, then dump you in a ditch."
    d "Vamos a divertirnos mucho contigo, y luego te tiraremos en una zanja."

# game/script.rpy:2545

translate spanish anna_4c238468:
    # d "Though, to be fair, you’re the best catch we’ve had in a while."
    d "Aunque, para ser justos, eres la mejor captura que hemos tenido en un tiempo."

# game/script.rpy:2547

translate spanish anna_d1cf0328:
    # d "So thanks to this idiot for handing you over."
    d "Así que gracias a este idiota por entregarte."

# game/script.rpy:2554

translate spanish anna_cb904140:
    # d "How about we entertain ourselves, with him watching?"
    d "¿Qué tal si nos entretenemos a nosotros mismos, con él mirando?"

# game/script.rpy:2555

translate spanish anna_f5a954d4:
    # d "Bet the poor bastard loses his mind."
    d "Apuesto al pobre bastardo a perder la cabeza."

# game/script.rpy:2557

translate spanish anna_659468de:
    # C "Touch me… and I promise you won’t need to worry about girls ever again."
    C "Tócame... y te prometo que no necesitarás preocuparte por las chicas nunca más."

# game/script.rpy:2559

translate spanish anna_6b3157d4:
    # C "Actually, scratch that. Judging by the way you act? Might already be a lost cause."
    C "En realidad, araña eso, a juzgar por la forma en que actúas, podría ser una causa perdida."

# game/script.rpy:2566

translate spanish anna_62fcc2e4:
    # d "Would work great somewhere else."
    d "Trabajaría bien en otro lugar."

# game/script.rpy:2568

translate spanish anna_5f9346d3:
    # mc "I wouldn’t count on that."
    mc "No contaría con eso."

# game/script.rpy:2572

translate spanish anna_7b591006:
    # d "Do you even know who I am, old man?"
    d "¿Sabes quién soy, viejo?"

# game/script.rpy:2573

translate spanish anna_5e996f76:
    # d "Get lost before we send you to a nursing home."
    d "Piérdete antes de que te enviemos a un asilo de ancianos."

# game/script.rpy:2580

translate spanish anna_74af3728:
    # mc "Tell me something, gentlemen."
    mc "Dígame algo, caballeros."

# game/script.rpy:2581

translate spanish anna_f4e14abc_1:
    # mc "Who sent you?"
    mc "¿Quién te envió?"

# game/script.rpy:2582

translate spanish anna_1f432b6d:
    # mc "Choose your words carefully."
    mc "Elige tus palabras con cuidado."

# game/script.rpy:2583

translate spanish anna_a1e8814c:
    # mc "I’d rather not get my hands dirty again."
    mc "Prefiero no ensuciar mis manos de nuevo."

# game/script.rpy:2588

translate spanish anna_3c82d6a1:
    # d "Alright, alright! L-look, we were told to bring that girl in, alive, as a hostage."
    d "Bien, bien, nos dijeron que llevara a esa chica, viva, como rehén."

# game/script.rpy:2592

translate spanish anna_7b471f6f:
    # mc "Good."
    mc "Bien."

# game/script.rpy:2593

translate spanish anna_8aa0e1b5:
    # mc "If I find out you lied…"
    mc "Si me entero de que mentiste..."

# game/script.rpy:2594

translate spanish anna_dd7680ce:
    # mc "you won’t get a second chance."
    mc "no tendrás una segunda oportunidad."

# game/script.rpy:2610

translate spanish anna_15d75986:
    # C "That’s for putting your hands on me, you piece of shit."
    C "Eso es por ponerme las manos encima, pedazo de mierda."

# game/script.rpy:2612

translate spanish anna_fa8cf989:
    # mc "Who were those guys?"
    mc "¿Quiénes eran esos tipos?"

# game/script.rpy:2614

translate spanish anna_0874afc7:
    # C "Wish I knew… Sis is gonna flip when she hears about this."
    C "Ojalá supiera... que Sis va a cambiar cuando se entere de esto."

# game/script.rpy:2616

translate spanish anna_2b03cf49:
    # C "Still… thanks, [mc]. Seriously. I’ve lost count how many times you’ve bailed us out."
    C "Aún... gracias. [mc]En serio. He perdido la cuenta de cuántas veces nos has abandonado."

# game/script.rpy:2618

translate spanish anna_25026f07:
    # d "You bastard! I won’t forget this!"
    d "¡Bastardo! ¡No olvidaré esto!"

# game/script.rpy:2644

translate spanish anna_895037ab:
    # mc "I’m fine."
    mc "Estoy bien."

# game/script.rpy:2645

translate spanish anna_7967e82f:
    # mc "What do we do with him?"
    mc "¿Qué hacemos con él?"

# game/script.rpy:2646

translate spanish anna_194fd966:
    # C "This one? God, I’d love to finish him right here… but nah."
    C "Dios, me encantaría terminarlo aquí mismo... pero no."

# game/script.rpy:2647

translate spanish anna_b9932f98:
    # C "Get lost. While you still can."
    C "Piérdete mientras puedas."

# game/script.rpy:2658

translate spanish anna_9fe5a601:
    # C "And don’t show your face again, rat. Next time I won’t be this nice."
    C "Y no vuelvas a mostrar tu cara, rata. La próxima vez no seré tan agradable."

# game/script.rpy:2662

translate spanish anna_dd759c35:
    # C "Creepy, right? First he drags me into this, then they try to gut him."
    C "Primero me arrastra a esto, luego intentan destriparlo."

# game/script.rpy:2664

translate spanish anna_17f42347:
    # C "What? I’m serious. Getting stabbed in the back? Feels like absolute garbage."
    C "¿Qué? Hablo en serio. ¿Me apuñalas en la espalda? Se siente como basura absoluta."

# game/script.rpy:2669

translate spanish anna_5f30dc14:
    # mc "How’d you even get into that mess?"
    mc "¿Cómo te metiste en ese lío?"

# game/script.rpy:2679

translate spanish anna_3e05e351:
    # C "Yeah, I know, I know… sounds stupid."
    C "Sí, lo sé, lo sé... suena estúpido."

# game/script.rpy:2680

translate spanish anna_00879fb8:
    # C "Jack calls me, says he’s in trouble. I’m like, fine, why not."
    C "Jack me llama, dice que está en problemas. Estoy como, bien, por qué no."

# game/script.rpy:2682

translate spanish anna_46468382:
    # C "I get there, and he’s on his knees in front of some thugs."
    C "Yo llego allí, y él está de rodillas delante de unos matones."

# game/script.rpy:2684

translate spanish anna_2c7774db:
    # C "So I step in, thinking they’ll get scared and scatter."
    C "Así que me paso, pensando que se asustarán y se dispersarán."

# game/script.rpy:2686

translate spanish anna_81640c92:
    # C "You know how it usually goes with me."
    C "Sabes cómo suele pasar conmigo."

# game/script.rpy:2688

translate spanish anna_1b42164e:
    # C "See someone in trouble… hype myself up… jump in headfirst."
    C "Ve a alguien en problemas... hipócritame... salta primero."

# game/script.rpy:2690

translate spanish anna_84c23421:
    # C "Most of the time? They’re grateful. And I know exactly who I’m dealing with."
    C "¿La mayoría de las veces? Están agradecidos. Y sé exactamente con quién estoy tratando."

# game/script.rpy:2692

translate spanish anna_54aa8f8c:
    # C "If it’s some serious gang shit, I’m out."
    C "Si es una mierda de pandillas serias, estoy fuera."

# game/script.rpy:2693

translate spanish anna_76b7b032:
    # C "But punks like these? Why not have a little fun."
    C "Pero los punks como estos, ¿por qué no te diviertes un poco?"

# game/script.rpy:2695

translate spanish anna_97334a33:
    # C "You help people like that, word spreads."
    C "Ayudas a gente así, se difunde la palabra."

# game/script.rpy:2696

translate spanish anna_3693358d:
    # C "‘Oh, they’re nice, they’ve got your back’- boom, reputation up, money up. Easy."
    C "‘Oh, son agradables, tienen tu espalda’- boom, reputación, dinero arriba. Fácil."

# game/script.rpy:2698

translate spanish anna_2dbbfb40:
    # mc "That’s… one way to look at it."
    mc "Es... una manera de verlo."

# game/script.rpy:2699

translate spanish anna_b076f446:
    # mc "But this time it went sideways."
    mc "Pero esta vez se fue de lado."

# game/script.rpy:2701

translate spanish anna_965b1579:
    # mc "What if I didn’t show up?"
    mc "¿Y si no apareciera?"

# game/script.rpy:2708

translate spanish anna_f0247634:
    # C "Honestly? {w}No clue."
    C "¿Honestamente? {w}Ni idea."

# game/script.rpy:2709

translate spanish anna_3e06dbef:
    # C "They’d probably pass me around… or just take what they want."
    C "Probablemente me pasarían por aquí... o simplemente tomar lo que quieren."

# game/script.rpy:2710

translate spanish anna_6fbc0ad9:
    # C "Wouldn’t be the first time someone tried."
    C "No sería la primera vez que alguien lo intentó."

# game/script.rpy:2714

translate spanish anna_9e63e9d9:
    # mc "You’ve got a strange way of looking at things."
    mc "Tienes una forma extraña de ver las cosas."

# game/script.rpy:2718

translate spanish anna_eefed0d9:
    # mc "If I hadn’t stepped in… your sister would’ve had my head."
    mc "Si no hubiera pisado... tu hermana hubiera tenido mi cabeza."

# game/script.rpy:2721

translate spanish anna_629d3482:
    # mc "You really know how to cause her trouble."
    mc "Realmente sabes cómo causarle problemas."

# game/script.rpy:2724

translate spanish anna_6a393139:
    # C "Wouldn’t be me otherwise."
    C "No sería yo de otra manera."

# game/script.rpy:2725

translate spanish anna_a00758fe:
    # C "Had to deal with her crap growing up—now it’s her turn."
    C "Tenía que lidiar con su mierda creciendo, ahora es su turno."

# game/script.rpy:2728

translate spanish anna_943118d6:
    # mc "Wait… you do this on purpose?"
    mc "Espera... ¿haces esto a propósito?"

# game/script.rpy:2730

translate spanish anna_b3705063:
    # C "Of course. What, you think I’m stupid or something?"
    C "Por supuesto. ¿Qué, crees que soy estúpido o algo así?"

# game/script.rpy:2734

translate spanish anna_4c5115c1:
    # C "Hey! Rude!"
    C "¡Eh! ¡Qué grosero!"

# game/script.rpy:2735

translate spanish anna_556cdece:
    # mc "Kidding."
    mc "Bromeando."

# game/script.rpy:2736

translate spanish anna_cb0b1323:
    # C "(sigh)…you’re unbelievable."
    C "(Suspira)... eres increíble."

# game/script.rpy:2738

translate spanish anna_4281e0a1:
    # C "So… what’s the plan for tonight?"
    C "Entonces... ¿cuál es el plan para esta noche?"

# game/script.rpy:2739

translate spanish anna_f0f87a6a:
    # mc "{b}We{/b} don’t have plans."
    mc "{b}Nosotros{/b} no tienen planes."

# game/script.rpy:2742

translate spanish anna_21b6e183:
    # mc "{b}I{/b} do."
    mc "{b}I{/b} Sí."

# game/script.rpy:2743

translate spanish anna_1678c1f9:
    # mc "I’m meeting your sister."
    mc "Voy a conocer a tu hermana."

# game/script.rpy:2772

translate spanish anna_b2c5730a:
    # D "(What the hell is this?)"
    D "(¿Qué demonios es esto?)"

# game/script.rpy:2787

translate spanish anna_47bf0074:
    # C "You know… I might not show it, but I was actually really glad I ran into you back there."
    C "Sabes... podría no mostrarlo, pero estaba muy contenta de haberte encontrado allí."

# game/script.rpy:2788

translate spanish anna_e9ce1a42:
    # C "So… what are you even doing here?"
    C "Entonces... ¿qué estás haciendo aquí?"

# game/script.rpy:2791

translate spanish anna_b00beead:
    # mc "Honestly… I’m a bit out of place here."
    mc "Sinceramente... estoy un poco fuera de lugar aquí."

# game/script.rpy:2794

translate spanish anna_bb930076:
    # C "You’re the only one who thinks that, you know."
    C "Eres el único que piensa eso, sabes."

# game/script.rpy:2795

translate spanish anna_e54921bf:
    # C "You should come by more often."
    C "Deberías venir más a menudo."

# game/script.rpy:2796

translate spanish anna_efc7e09f:
    # C "Sis would be way too happy about it."
    C "Sis estaría muy feliz con eso."

# game/script.rpy:2808

translate spanish anna_32b4bc1a:
    # x "Great to see you, amigo! 15 years, and you’ve only gotten stronger!"
    x "¡Es bueno verte, amigo! 15 años, y solo te has hecho más fuerte!"

# game/script.rpy:2815

translate spanish anna_3a285f4f:
    # mc "Good to see you too."
    mc "Me alegro de verte también."

# game/script.rpy:2816

translate spanish anna_7156b3f9:
    # mc "But what are you doing here, Alexandro?"
    mc "¿Pero qué haces aquí, Alexandro?"

# game/script.rpy:2830

translate spanish anna_3ebffef6:
    # C "If anything, we should be thanking you."
    C "Si algo, deberíamos estar agradeciéndote."

# game/script.rpy:2831

translate spanish anna_4c0b77d8:
    # C "Not every place gets a guard like you."
    C "No todos los lugares tienen un guardia como tú."

# game/script.rpy:2832

translate spanish anna_f172980f:
    # C "So yeah… works out pretty damn well for us."
    C "Así que sí... funciona muy bien para nosotros."

# game/script.rpy:2834

translate spanish anna_3745764e:
    # mc "I’m glad it worked out for you."
    mc "Me alegro de que haya funcionado para ti."

# game/script.rpy:2853

translate spanish anna_f1e96b70:
    # mc "(Is it that obvious…?)"
    mc "¿Es tan obvio?"

# game/script.rpy:2855

translate spanish anna_6fe6fa3a:
    # mc "(Or was I just lying to myself…?)"
    mc "¿O estaba mintiendo a mí mismo?"

# game/script.rpy:2871

translate spanish anna_8fd66b4b:
    # mc "…You good?"
    mc "¿Estás bien?"

# game/script.rpy:2873

translate spanish anna_41bb0b3b:
    # C "He’s like this every time someone mentions his crocodiles."
    C "Es así cada vez que alguien menciona sus cocodrilos."

# game/script.rpy:2875

translate spanish anna_27e69cf6:
    # mc "…We didn’t see that."
    mc "...No vimos eso."

# game/script.rpy:2877

translate spanish anna_36d39742:
    # C "Yeah… let’s just pretend none of that happened."
    C "Sí... finjamos que nada de eso pasó."

# game/script.rpy:2881

translate spanish anna_b894cf57:
    # mc "Good seeing you again, Alex."
    mc "Me alegro de verte de nuevo, Alex."

# game/script.rpy:2892

translate spanish bar_olivica_edf5355d:
    # C "Well… welcome to our very humble little spot."
    C "Bien... bienvenido a nuestro pequeño lugar muy humilde."

# game/script.rpy:2893

translate spanish bar_olivica_07890832:
    # C "Try not to judge too hard."
    C "Intenta no juzgar demasiado."

# game/script.rpy:2895

translate spanish bar_olivica_c096500c:
    # mc "If this is humble, I’d hate to see what you call not humble."
    mc "Si esto es humilde, odiaría ver lo que no llaman humilde."

# game/script.rpy:2897

translate spanish bar_olivica_8dee34dd:
    # C "Thanks. We actually put a ton of work into this place."
    C "Gracias, en realidad hemos puesto una tonelada de trabajo en este lugar."

# game/script.rpy:2898

translate spanish bar_olivica_76d92c76:
    # C "Expanded it, redid the whole interior…"
    C "Ampliado, redireccionado todo el interior..."

# game/script.rpy:2900

translate spanish bar_olivica_82947a6f:
    # C "Now it’s more like a proper lounge instead of that sad excuse of a bar we had before."
    C "Ahora es más como un salón adecuado en lugar de esa triste excusa de un bar que teníamos antes."

# game/script.rpy:2902

translate spanish bar_olivica_832f3dc6:
    # C "Then again… calling it a bar back then is generous."
    C "Entonces, de nuevo... llamarlo bar es generoso."

# game/script.rpy:2903

translate spanish bar_olivica_7cffe277:
    # C "It was more like a warehouse."
    C "Era más como un almacén."

# game/script.rpy:2904

translate spanish bar_olivica_c8d77481:
    # C "…Or something worse."
    C "...o algo peor."

# game/script.rpy:2908

translate spanish bar_olivica_0366ce67:
    # C "Anyway—"
    C "De todos modos..."

# game/script.rpy:2909

translate spanish bar_olivica_c599426c:
    # C "What’s up with you?"
    C "¿Qué pasa contigo?"

# game/script.rpy:2911

translate spanish bar_olivica_b1feb6a8:
    # mc "I’ll admit… I’m impressed."
    mc "Admito que estoy impresionado."

# game/script.rpy:2912

translate spanish bar_olivica_02a994d9:
    # mc "But how the hell did you pull this off?"
    mc "¿Pero cómo demonios lo lograste?"

# game/script.rpy:2914

translate spanish bar_olivica_567dc2b9:
    # C "(Deep sigh) …mmh."
    C "(Suspiro profundo) ...mmh."

# game/script.rpy:2916

translate spanish bar_olivica_ed6af8a7:
    # C "That’s a secret I’m not ready to spill just yet."
    C "Ese es un secreto que no estoy listo para derrapar todavía."

# game/script.rpy:2917

translate spanish bar_olivica_00bcc221:
    # C "Gotta keep some mystery, you know?"
    C "Tengo que guardar un misterio, ¿sabes?"

# game/script.rpy:2919

translate spanish bar_olivica_48fc64b0:
    # mc "Yeah… figures."
    mc "Sí... tiene sentido."

# game/script.rpy:2920

translate spanish bar_olivica_6f62820e:
    # mc "She had a hand in this, didn’t she?"
    mc "Tenía una mano en esto, ¿no?"

# game/script.rpy:2922

translate spanish bar_olivica_c2160927:
    # C "I mean… it wasn’t just her."
    C "Quiero decir... no era solo ella."

# game/script.rpy:2923

translate spanish bar_olivica_6e8f3500:
    # C "But yeah, Olivia carried most of it."
    C "Pero sí, Olivia llevó la mayor parte."

# game/script.rpy:2924

translate spanish bar_olivica_28d29150:
    # C "Permits, paperwork, investors… she handled all that boring hell."
    C "Permisos, papeleo, inversores... ella se encargó de todo ese infierno aburrido."

# game/script.rpy:2926

translate spanish bar_olivica_cd1ce94c:
    # C "Even pulled in some serious sponsors… no idea why they trusted us, but hey."
    C "Incluso se despidió en algunos patrocinadores serios... sin idea de por qué confiaban en nosotros, pero oye."

# game/script.rpy:2927

translate spanish bar_olivica_c845ee34:
    # C "…How are you holding up?"
    C "¿Cómo estás?"

# game/script.rpy:2928

translate spanish bar_olivica_273687f7:
    # C "We heard what happened."
    C "Oímos lo que pasó."

# game/script.rpy:2929

translate spanish bar_olivica_97f733c6:
    # C "She really was… something else."
    C "Ella realmente era... algo más."

# game/script.rpy:2933

translate spanish bar_olivica_0faa46ad:
    # mc "Yeah…"
    mc "Sí..."

# game/script.rpy:2934

translate spanish bar_olivica_9a9ab2a0:
    # mc "She was."
    mc "Lo era."

# game/script.rpy:2936

translate spanish bar_olivica_c0453b79:
    # mc "So… did you get into that university?"
    mc "Entonces... ¿te metiste en esa universidad?"

# game/script.rpy:2937

translate spanish bar_olivica_469e4353:
    # mc "That was your plan, right?"
    mc "Ese era tu plan, ¿verdad?"

# game/script.rpy:2951

translate spanish bar_olivica_824d400c:
    # mc "Someone over there looks ready to blow."
    mc "Alguien de ahí parece listo para volar."

# game/script.rpy:2953

translate spanish bar_olivica_0c2a221e:
    # C "No clue who you’re talking about."
    C "No hay idea de quién estás hablando."

# game/script.rpy:2960

translate spanish bar_olivica_4d82ff0e:
    # h "Touch me again—"
    h "Tócame otra vez..."

# game/script.rpy:2961

translate spanish bar_olivica_ac17b8d4:
    # h "I swear, I’ll drop you where you stand."
    h "Te juro que te dejaré donde estás."

# game/script.rpy:2963

translate spanish bar_olivica_0205bdaa:
    # h "Now."
    h "Ahora."

# game/script.rpy:2965

translate spanish bar_olivica_bad1d9fe:
    # h "Run."
    h "Corre."

# game/script.rpy:2966

translate spanish bar_olivica_9ec27acc:
    # h "Before I start taking fingers."
    h "Antes de empezar a tomar dedos."

# game/script.rpy:2968

translate spanish bar_olivica_7568d73f:
    # C "Oof… yeah. That’s rage mode."
    C "Oof... sí. Eso es modo de rabia."

# game/script.rpy:2969

translate spanish bar_olivica_cd9047df:
    # C "She’s really pissed."
    C "Está muy cabreada."

# game/script.rpy:2971

translate spanish bar_olivica_c8d5820a:
    # mc "Yeah… she hasn’t changed."
    mc "Sí... no ha cambiado."

# game/script.rpy:2973

translate spanish bar_olivica_c19f4471:
    # C "She kinda has to be like that."
    C "Tiene que ser así."

# game/script.rpy:2974

translate spanish bar_olivica_046b908c:
    # C "Every day it’s the same story, some cocky idiot thinks he’s special."
    C "Cada día es la misma historia, un idiota arrogante piensa que es especial."

# game/script.rpy:2975

translate spanish bar_olivica_9dbc97fa:
    # C "Thinks he’s getting into her pants."
    C "Piensa que se está metiendo en sus pantalones."

# game/script.rpy:2981

translate spanish bar_olivica_8a2f5596:
    # mc "All these years… and you’re still the same."
    mc "Todos estos años... y sigues siendo el mismo."

# game/script.rpy:2983

translate spanish bar_olivica_26be1618:
    # mc "…Hey."
    mc "...Oye."

# game/script.rpy:2989

translate spanish bar_olivica_b12ff16f:
    # mc "Figured I’d stop by."
    mc "Pensé que pasaría."

# game/script.rpy:2990

translate spanish bar_olivica_cfc83f43:
    # mc "See how you’re holding up."
    mc "Mira cómo estás retenido."

# game/script.rpy:2992

translate spanish bar_olivica_e13b5a7c:
    # C "Sis, ever thought about not scaring off the customers?"
    C "¿Alguna vez pensó en no asustar a los clientes?"

# game/script.rpy:2995

translate spanish bar_olivica_c1dff379:
    # h "Oh, I’m thriving."
    h "Estoy prosperando."

# game/script.rpy:2996

translate spanish bar_olivica_0a06458c:
    # h "Can’t you tell?"
    h "¿No puedes decirlo?"

# game/script.rpy:2998

translate spanish bar_olivica_2124740c:
    # h "Signed contracts."
    h "Contratos firmados."

# game/script.rpy:2999

translate spanish bar_olivica_3bb1467a:
    # h "Pulled sponsors."
    h "Patrocinadores."

# game/script.rpy:3000

translate spanish bar_olivica_5f6abc6d:
    # h "Expanded the place…"
    h "Ampliado el lugar..."

# game/script.rpy:3001

translate spanish bar_olivica_ddaf8aa4:
    # h "Even opened another bar across town."
    h "Incluso abrió otro bar por la ciudad."

# game/script.rpy:3003

translate spanish bar_olivica_6cf7a5bb:
    # C "Hey! Don’t ignore me!"
    C "¡No me ignores!"

# game/script.rpy:3014

translate spanish bar_olivica_bbff499d:
    # C "C’mon, don’t sulk."
    C "Vamos, no se seque."

# game/script.rpy:3015

translate spanish bar_olivica_5cc63ccb:
    # C "So I ignored your messages. Big deal."
    C "Así que ignoré tus mensajes."

# game/script.rpy:3017

translate spanish bar_olivica_d9c9dcff:
    # C "Now quit that and go charm our guest."
    C "Ahora deja eso y ve a encantar a nuestro invitado."

# game/script.rpy:3018

translate spanish bar_olivica_bee2d9db:
    # C "You’ve got that scary-smile combo, use it."
    C "Tienes ese combo de sonrisas espeluznantes, úsalo."

# game/script.rpy:3022

translate spanish bar_olivica_c9670655:
    # h "It’s the same loop, {w=0.7}sleep, {w=0.5}work, {w=0.4}sleep, {w=0.3}work, {w=0.2}SLEEP, {w=0.1}WORK…"
    h "Es el mismo ciclo: {w=0.7}dormir, {w=0.5}trabajar, {w=0.4}dormir, {w=0.3}trabajar, {w=0.2}DORMIR, {w=0.1}TRABAJAR..."

# game/script.rpy:3024

translate spanish bar_olivica_066fc800:
    # h "I’m so fed up with it, you know? {w=0.9}HA-{w=0.2}HA-{w=0.1}HA, {w=0.5}Seven years — same damn grind. {w=1.2}And what do I have?{w=0.9} No boyfriend. {w=0.5}No husband. {w=0.3}Nothing."
    h "Estoy harta, ¿sabes? {w=0.9}JA-{w=0.2}JA-{w=0.1}JA, {w=0.5}siete años con la misma maldita rutina. {w=1.2}¿Y qué tengo?{w=0.9} Sin novio. {w=0.5}Sin marido. {w=0.3}Nada."

# game/script.rpy:3026

translate spanish bar_olivica_86d7178e:
    # h "Meanwhile everyone else? Married. Kids. {w=0.9}CAN YOU BELIEVE IT? {w=0.7}AND THEY JUST LOVE REMINDING TO ME, {w=0.6}LAUGHING, {w=0.3}LIKE IT'S FUNNY."
    h "¿Y los demás? Casados. Con hijos. {w=0.9}¿PUEDES CREERLO? {w=0.7}Y les encanta recordármelo, {w=0.6}riéndose, {w=0.3}como si fuera gracioso."

# game/script.rpy:3032

translate spanish bar_olivica_90734342:
    # h "I’m doing amazing."
    h "Me va de maravilla."

# game/script.rpy:3033

translate spanish bar_olivica_3c27171a:
    # h "Really."
    h "En serio."

# game/script.rpy:3034

translate spanish bar_olivica_e7570b0e:
    # h "Couldn’t be better."
    h "No podría ser mejor."

# game/script.rpy:3040

translate spanish bar_olivica_7fb8b532:
    # h "Yeah, yeah, get lost."
    h "Sí, sí, pídete."

# game/script.rpy:3042

translate spanish bar_olivica_9e8f551c:
    # mc "Sounds like it’s been a long few years."
    mc "Suena como que ha sido unos años."

# game/script.rpy:3043

translate spanish bar_olivica_ebe63ac3:
    # mc "But after all this time…"
    mc "Pero después de todo este tiempo..."

# game/script.rpy:3044

translate spanish bar_olivica_5756eeae:
    # mc "With the way people look at you?"
    mc "¿Con la forma en que la gente te mira?"

# game/script.rpy:3045

translate spanish bar_olivica_6de14027:
    # mc "You could’ve had anyone."
    mc "Podrías haber tenido a alguien."

# game/script.rpy:3047

translate spanish bar_olivica_b65b23e7:
    # h "(Scoffs) That’s the thing."
    h "Esa es la cosa."

# game/script.rpy:3048

translate spanish bar_olivica_8380d296:
    # h "It’s not about who {b}wants{/b} me."
    h "No se trata de quién {b}quiere{/b} Yo."

# game/script.rpy:3049

translate spanish bar_olivica_9d7d2f21:
    # h "It’s about who’s {b}worth{/b} it."
    h "Es sobre quién es {b}valía la pena{/b} Es."

# game/script.rpy:3055

translate spanish bar_olivica_916603e8:
    # h "And no, it’s not about Anya. If that’s where your head went."
    h "Y no, no es sobre Anya. Si es ahí donde fue tu cabeza."

# game/script.rpy:3061

translate spanish bar_olivica_4489f1b5:
    # mc "…Good."
    mc "Bien."

# game/script.rpy:3062

translate spanish bar_olivica_632bbf91:
    # mc "Then I don’t need to step in."
    mc "Entonces no necesito entrar."

# game/script.rpy:3065

translate spanish bar_olivica_0c00b719:
    # h "I heard what happened."
    h "Oí lo que pasó."

# game/script.rpy:3066

translate spanish bar_olivica_c9deb6e0:
    # h "I’m… sorry."
    h "Lo siento."

# game/script.rpy:3072

translate spanish bar_olivica_725dece2:
    # mc "I need a favor."
    mc "Necesito un favor."

# game/script.rpy:3073

translate spanish bar_olivica_3ac2530a:
    # mc "Take a look at this."
    mc "Echa un vistazo a esto."

# game/script.rpy:3075

translate spanish bar_olivica_d68677fd:
    # mc "I know we said we were done with this."
    mc "Sé que dijimos que habíamos terminado con esto."

# game/script.rpy:3077

translate spanish bar_olivica_dd3ea971:
    # mc "But the past doesn’t stay buried."
    mc "Pero el pasado no permanece enterrado."

# game/script.rpy:3088

translate spanish bar_olivica_ffcb8198:
    # h "…Wait."
    h "...espera."

# game/script.rpy:3089

translate spanish bar_olivica_f70f78cc:
    # h "That’s not possible…"
    h "Eso no es posible..."

# game/script.rpy:3090

translate spanish bar_olivica_fa4d5023:
    # h "He’s dead."
    h "Está muerto."

# game/script.rpy:3091

translate spanish bar_olivica_ea379f13:
    # h "You put him down yourself."
    h "Tú mismo lo pusiste."

# game/script.rpy:3092

translate spanish bar_olivica_6226149d:
    # h "Al-Zahira. Twenty years ago."
    h "Al-Zahira. Hace veinte años."

# game/script.rpy:3094

translate spanish bar_olivica_08f4193e:
    # mc "Yeah… so did I."
    mc "Sí... yo también."

# game/script.rpy:3095

translate spanish bar_olivica_ddbda240:
    # mc "But this says otherwise."
    mc "Pero esto dice lo contrario."

# game/script.rpy:3096

translate spanish bar_olivica_2fb5cb2b:
    # mc "He’s alive."
    mc "Está vivo."

# game/script.rpy:3097

translate spanish bar_olivica_f38e52d6:
    # mc "And looks better than both of us."
    mc "Y se ve mejor que los dos."

# game/script.rpy:3099

translate spanish bar_olivica_8583ef28:
    # mc "But that’s not why I’m here."
    mc "Pero no es por eso que estoy aquí."

# game/script.rpy:3100

translate spanish bar_olivica_a501270d:
    # mc "Look at the other one."
    mc "Mira el otro."

# game/script.rpy:3102

translate spanish bar_olivica_1727fc4b:
    # h "You’re serious…?"
    h "¿Hablas en serio?"

# game/script.rpy:3105

translate spanish bar_olivica_cb711f44:
    # mc "I don’t know."
    mc "No lo sé."

# game/script.rpy:3106

translate spanish bar_olivica_a8b2ca56:
    # mc "But I need to find out."
    mc "Pero necesito averiguarlo."

# game/script.rpy:3108

translate spanish bar_olivica_8a44a794:
    # h "Anya."
    h "Anya."

# game/script.rpy:3109

translate spanish bar_olivica_88fcaa18:
    # h "We’re closing early."
    h "Nos estamos cerrando temprano."

# game/script.rpy:3110

translate spanish bar_olivica_7573f237:
    # h "Give them an hour. No more."
    h "Dales una hora, no más."

# game/script.rpy:3114

translate spanish bar_olivica_bc6769ce:
    # h "I’ve got bigger problems than reputation."
    h "Tengo problemas más grandes que la reputación."

# game/script.rpy:3134

translate spanish bar_olivica_5774ad1e:
    # h "Your kid?"
    h "¿Tu hijo?"

# game/script.rpy:3136

translate spanish bar_olivica_af770035:
    # mc "My son…"
    mc "Mi hijo..."

# game/script.rpy:3137

translate spanish bar_olivica_610e1ad0:
    # mc "Long story."
    mc "Larga historia."

# game/script.rpy:3141

translate spanish bar_olivica_6c4b4bc0:
    # mc "Enough to matter."
    mc "Bastante para importar."

# game/script.rpy:3145

translate spanish bar_olivica_0f846bc5:
    # h "We lost Jake and Mona that day. Alexandro lost a leg, for life."
    h "Perdimos a Jake y a Mona ese día."

# game/script.rpy:3146

translate spanish bar_olivica_b7f4533f:
    # h "All because some genius commander called friendly fire. Beautiful, right?"
    h "Todo porque un comandante genio llamó fuego amistoso."

# game/script.rpy:3148

translate spanish bar_olivica_d6ea48da:
    # h "And now, after all this time, they suddenly need you again?"
    h "¿Y ahora, después de todo este tiempo, de repente te necesitan de nuevo?"

# game/script.rpy:3153

translate spanish bar_olivica_0b7b9cf5:
    # mc "You know Richard handled it."
    mc "Sabes que Richard lo manejaba."

# game/script.rpy:3155

translate spanish bar_olivica_177c69b9:
    # h "Yeah… figures. So you didn’t."
    h "Sí... figuras, así que no lo hiciste."

# game/script.rpy:3157

translate spanish bar_olivica_54b1254f:
    # mc "Azarkhan’s people were already inside."
    mc "La gente de Azarkhan ya estaba dentro."

# game/script.rpy:3159

translate spanish bar_olivica_f154821a:
    # h "Don’t."
    h "No."

# game/script.rpy:3160

translate spanish bar_olivica_0506dede:
    # h "We both know that’s bullshit."
    h "Ambos sabemos que es una mierda."

# game/script.rpy:3161

translate spanish bar_olivica_d5be1ed4:
    # h "This whole thing? It’s about that photo of Lora."
    h "¿Todo esto? Se trata de la foto de Lora."

# game/script.rpy:3162

translate spanish bar_olivica_ed098414:
    # h "That’s the only reason you’re even thinking about going back."
    h "Esa es la única razón por la que estás pensando en volver."

# game/script.rpy:3166

translate spanish bar_olivica_cb89ebe5:
    # h "I get it."
    h "Lo entiendo."

# game/script.rpy:3167

translate spanish bar_olivica_025f9323:
    # h "You did your service. Came back. Tried to live quiet."
    h "Has hecho tu servicio, regresaste, intentaste vivir tranquilo."

# game/script.rpy:3168

translate spanish bar_olivica_cff6e378:
    # h "Then boom, your wife’s ‘dead’, and somehow you end up blaming your own kid for it."
    h "Entonces boom, la ‘muerte’ de tu esposa, y de alguna manera terminas culpando a tu propio hijo por ello."

# game/script.rpy:3170

translate spanish bar_olivica_8541ef36:
    # h "And just when things start to calm down, here we go again."
    h "Y cuando las cosas empiecen a calmarse, aquí vamos otra vez."

# game/script.rpy:3175

translate spanish bar_olivica_58db63cf:
    # h "Or {b}Oh, and your dead wife? Not so dead. Here, have some photos.{/b}"
    h "O {b}No tan muerto, aquí tienes fotos.{/b}"

# game/script.rpy:3179

translate spanish bar_olivica_f453b1a1:
    # mc "…What is that, a lollipop?"
    mc "¿Qué es eso, un piruleta?"

# game/script.rpy:3184

translate spanish bar_olivica_47531656:
    # h "Your dumb lollipop idea actually worked."
    h "Tu idea de lollipop tonta funcionó."

# game/script.rpy:3185

translate spanish bar_olivica_03cf958d:
    # h "So yeah… I’m sticking with it."
    h "Así que sí... me estoy quedando con él."

# game/script.rpy:3189

translate spanish bar_olivica_d0c95c5e:
    # h "You know… maybe it’s just not worth it."
    h "Sabes... tal vez no valga la pena."

# game/script.rpy:3190

translate spanish bar_olivica_40110290:
    # h "Yeah, bringing Lora back sounds nice."
    h "Sí, traer a Lora suena bien."

# game/script.rpy:3191

translate spanish bar_olivica_bd7db401:
    # h "But what if that’s not even her?"
    h "¿Pero qué pasa si eso no es ella?"

# game/script.rpy:3195

translate spanish bar_olivica_1fb892a4:
    # h "Maybe it’s time to stop chasing ghosts."
    h "Quizá sea hora de dejar de perseguir fantasmas."

# game/script.rpy:3196

translate spanish bar_olivica_ac895541:
    # h "Look around."
    h "Mira alrededor."

# game/script.rpy:3197

translate spanish bar_olivica_f9719142:
    # h "You’ve got something now."
    h "Ahora tienes algo."

# game/script.rpy:3198

translate spanish bar_olivica_bbb5080b:
    # h "And trust me, even that doesn’t last forever."
    h "Y créeme, incluso eso no dura para siempre."

# game/script.rpy:3202

translate spanish bar_olivica_952433c1:
    # h "Just saying."
    h "Solo digo."

# game/script.rpy:3204

translate spanish bar_olivica_2034c056:
    # mc "Maybe."
    mc "Tal vez."

# game/script.rpy:3205

translate spanish bar_olivica_92e5ec4f:
    # mc "But if there’s even a chance I can bring her back…"
    mc "Pero si hay una oportunidad de que pueda traerla de vuelta..."

# game/script.rpy:3206

translate spanish bar_olivica_7a175569:
    # mc "I’m taking it."
    mc "Lo estoy tomando."

# game/script.rpy:3210

translate spanish bar_olivica_57a458b0:
    # h "You’re still the same."
    h "Todavía eres igual."

# game/script.rpy:3216

translate spanish bar_olivica_68c7d64f:
    # h "What happened?"
    h "¿Qué pasó?"

# game/script.rpy:3220

translate spanish bar_olivica_d3b8b40e:
    # h "Why are you just standing there? Talk."
    h "¿Por qué estás ahí parado?"

# game/script.rpy:3227

translate spanish bar_olivica_bb3c1e81:
    # h "We’ve got security for a reason."
    h "Tenemos seguridad por una razón."

# game/script.rpy:3228

translate spanish bar_olivica_cdf7d9a3:
    # h "Why not let Alexandro throw them out?"
    h "¿Por qué no dejar que Alexandro los eche fuera?"

# game/script.rpy:3231

translate spanish bar_olivica_f24f4fe4:
    # N "So, Dad, do you agree?"
    N "Entonces, papá, ¿estás de acuerdo?"

# game/script.rpy:3233

translate spanish bar_olivica_a9449331:
    # mc "I need to go."
    mc "Tengo que irme."

# game/script.rpy:3234

translate spanish bar_olivica_56515523:
    # mc "If you’re in — tomorrow, 5:00 a.m."
    mc "Si estás en — mañana, a las 5:00 a.m."

# game/script.rpy:3235

translate spanish bar_olivica_e13175e5:
    # mc "Outside my place."
    mc "Fuera de mi casa."

# game/script.rpy:3273

translate spanish norman_home_eec2e5c2:
    # ri "But we’ve uncovered some information suggesting he’s backed by powerful entities."
    ri "Pero hemos descubierto alguna información que sugiere que está respaldado por entidades poderosas."

# game/script.rpy:3275

translate spanish norman_home_38af67a9:
    # ri "Possibly... extraterrestrial."
    ri "Posiblemente... extraterrestre."

# game/script.rpy:3281

translate spanish norman_home_8de8e30b:
    # ri "I wish I could share the details..."
    ri "Ojalá pudiera compartir los detalles..."

# game/script.rpy:3287

translate spanish norman_home_72ad15d9:
    # ri "but I can’t do that in a letter."
    ri "pero no puedo hacerlo en una carta."

# game/script.rpy:3307

translate spanish norman_home_b1ed2926:
    # mc "(Going somewhere unknown… based on a letter.)"
    mc "(Ir a algún lugar desconocido... basado en una carta.)"

# game/script.rpy:3308

translate spanish norman_home_8d139eb3:
    # mc "(Most people would call that stupid.)"
    mc "(La mayoría de la gente llamaría a ese estúpido.)"

# game/script.rpy:3310

translate spanish norman_home_a9275055:
    # mc "(And maybe they’d be right.)"
    mc "(Y quizá tengan razón.)"

# game/script.rpy:3311

translate spanish norman_home_db9cd3f8:
    # mc "(Maybe I should walk away.)"
    mc "(Quizá debería irme.)"

# game/script.rpy:3314

translate spanish norman_home_92ac0166:
    # mc "(A letter. Ghosts. Coordinates to nowhere.)"
    mc "(Una carta. Fantasmas. Coordina a ninguna parte.)"

# game/script.rpy:3315

translate spanish norman_home_3aa90f01:
    # mc "(Yeah… sounds insane.)"
    mc "(Sí... suena loco.)"

# game/script.rpy:3316

translate spanish norman_home_e7cafa64:
    # mc "(But I’m not turning my back on this.)"
    mc "(Pero no estoy dando la espalda a esto.)"

# game/script.rpy:3319

translate spanish norman_home_49dc7d32:
    # mc "(There are answers out there.)"
    mc "(Hay respuestas por ahí.)"

# game/script.rpy:3320

translate spanish norman_home_9c683e77:
    # mc "(Answers I was never given.)"
    mc "(Respuestas que nunca me dieron.)"

# game/script.rpy:3321

translate spanish norman_home_b698a3db:
    # mc "(A life I never got to live.)"
    mc "(Una vida que nunca tuve que vivir.)"

# game/script.rpy:3323

translate spanish norman_home_d80e4225:
    # mc "(And somehow… it feels like hope.)"
    mc "(Y de alguna manera... se siente como esperanza.)"

# game/script.rpy:3328

translate spanish norman_home_ae5a2396:
    # mc "(That hope… it’s enough.)"
    mc "(Esa esperanza... es suficiente.)"

# game/script.rpy:3333

translate spanish norman_home_3dc7acee:
    # mc "(Feels like I’m back there again.)"
    mc "(Se siente como si estuviera de vuelta allí otra vez.)"

# game/script.rpy:3338

translate spanish norman_home_86616cc7:
    # mc "(This time… I find it.)"
    mc "(Esta vez... lo encuentro.)"

# game/script.rpy:3340

translate spanish norman_home_f3e81283:
    # mc "(End what started.)"
    mc "(End lo que comenzó.)"

# game/script.rpy:3341

translate spanish norman_home_54a6bd68:
    # mc "(Take back what I lost.)"
    mc "(Retrocedan lo que perdí.)"

# game/script.rpy:3343

translate spanish norman_home_a49c2c10:
    # mc "Damn… sights are off again."
    mc "Maldita sea... la mira vuelve a estar desviada."

# game/script.rpy:3354

translate spanish norman_home_d6ed2480:
    # mc "Why aren’t you asleep?"
    mc "¿Por qué no estás dormido?"

# game/script.rpy:3355

translate spanish norman_home_2ed83991:
    # mc "Something wrong?"
    mc "¿Pasa algo?"

# game/script.rpy:3357

translate spanish norman_home_fed672f5:
    # N "Dad… we need to talk."
    N "Papá... tenemos que hablar."

# game/script.rpy:3362

translate spanish norman_home_986dd057:
    # mc "It’s late."
    mc "Es tarde."

# game/script.rpy:3363

translate spanish norman_home_6b280b18:
    # mc "Go get some sleep."
    mc "Ve a dormir un poco."

# game/script.rpy:3367

translate spanish norman_home_4c9d4ac2:
    # N "I’m not a kid anymore, alright?!"
    N "Ya no soy un niño, ¿de acuerdo?"

# game/script.rpy:3370

translate spanish norman_home_42937fd4:
    # N "I know what you’re planning."
    N "Sé lo que estás planeando."

# game/script.rpy:3371

translate spanish norman_home_7a7e5116:
    # N "You’re going after Mom…"
    N "Vas tras mamá..."

# game/script.rpy:3372

translate spanish norman_home_b0e9fca5:
    # N "But you don’t even know where to start!"
    N "¡Pero ni siquiera sabes por dónde empezar!"

# game/script.rpy:3373

translate spanish norman_home_1216e26b:
    # mc "I’ve got coordinates."
    mc "Tengo coordenadas."

# game/script.rpy:3374

translate spanish norman_home_e4a94a9b:
    # N "Dad—!"
    N "¡Papá!"

# game/script.rpy:3385

translate spanish norman_home_0b348ba0:
    # mc "…Alright."
    mc "...de acuerdo."

# game/script.rpy:3386

translate spanish norman_home_def0ad19:
    # mc "What is it?"
    mc "¿Qué es?"

# game/script.rpy:3392

translate spanish norman_home_bb54adc5:
    # mc "We?"
    mc "¿Nosotros?"

# game/script.rpy:3393

translate spanish norman_home_21882e03:
    # mc "You’re staying here."
    mc "Te quedas aquí."

# game/script.rpy:3395

translate spanish norman_home_39fbcbd3:
    # N "Why?! Why can’t I come with you?!"
    N "¿Por qué?! ¿Por qué no puedo venir contigo?"

# game/script.rpy:3399

translate spanish norman_home_1e5dea99:
    # mc "Because you’ve got a life ahead of you."
    mc "Porque tienes una vida por delante de ti."

# game/script.rpy:3400

translate spanish norman_home_2e34d625:
    # mc "I’m not letting that place take you too."
    mc "No dejaré que ese lugar te lleve también."

# game/script.rpy:3402

translate spanish norman_home_0aac8827:
    # N "And what about your life?!"
    N "¿Y qué hay de tu vida?"

# game/script.rpy:3403

translate spanish norman_home_5437eb68:
    # N "What did you read in that letter?"
    N "¿Qué leíste en esa carta?"

# game/script.rpy:3404

translate spanish norman_home_75140651:
    # N "And why the hell can’t I come with you?!"
    N "¿Y por qué demonios no puedo venir contigo?"

# game/script.rpy:3411

translate spanish norman_home_54bd59ed:
    # mc "Let me ask you something."
    mc "Déjame preguntarte algo."

# game/script.rpy:3412

translate spanish norman_home_d30fc7ed:
    # mc "You ever killed anyone?"
    mc "¿Alguna vez mataste a alguien?"

# game/script.rpy:3417

translate spanish norman_home_06e622bb:
    # mc "I have."
    mc "Lo he hecho."

# game/script.rpy:3418

translate spanish norman_home_e4fbadc5:
    # mc "Dozens."
    mc "Docenas."

# game/script.rpy:3419

translate spanish norman_home_d5be2dea:
    # mc "Hundreds."
    mc "Cientos."

# game/script.rpy:3423

translate spanish norman_home_7eee3ca8:
    # N "W-why are you telling me this…?"
    N "¿Por qué me estás diciendo esto?"

# game/script.rpy:3426

translate spanish norman_home_3c85550c:
    # mc "Because if I don’t make it… no one’s surprised."
    mc "Porque si no lo hago... nadie se sorprende."

# game/script.rpy:3427

translate spanish norman_home_053fcea5:
    # mc "But you?"
    mc "¿Pero tú?"

# game/script.rpy:3428

translate spanish norman_home_c5adb243:
    # mc "That’s different."
    mc "Eso es diferente."

# game/script.rpy:3429

translate spanish norman_home_745fa8fe:
    # N "Don’t say that!"
    N "¡No digas eso!"

# game/script.rpy:3430

translate spanish norman_home_0867043c:
    # N "And besides… you don’t know that forest like I do!"
    N "Y además... ¡no sabes ese bosque como yo!"

# game/script.rpy:3434

translate spanish norman_home_8bf8f8f0:
    # mc "You sure about this?"
    mc "¿Estás seguro de esto?"

# game/script.rpy:3436

translate spanish norman_home_7a6a507b:
    # N "Yeah. I am."
    N "Sí, lo soy."

# game/script.rpy:3443

translate spanish norman_home_b632c3b2:
    # mc "You know how to use that?"
    mc "¿Sabes cómo usar eso?"

# game/script.rpy:3447

translate spanish norman_home_2e197ec0:
    # N "I don’t know if I’ve got the strength… or the guts."
    N "No sé si tengo la fuerza... o las tripas."

# game/script.rpy:3451

translate spanish norman_home_9485ef37:
    # mc "Then if you’re coming with me… you don’t slow me down."
    mc "Entonces si vienes conmigo... no me desaceleras."

# game/script.rpy:3455

translate spanish norman_home_fc2feabf:
    # mc "You can still walk away."
    mc "Aún puedes irte."

# game/script.rpy:3458

translate spanish norman_home_c430cda6:
    # N "I’ll do whatever it takes. I promise."
    N "Haré lo que sea necesario."

# game/script.rpy:3467

translate spanish norman_home_2e7ce8c9:
    # N "…Thanks, Dad."
    N "Gracias, papá."

# game/script.rpy:3474

translate spanish norman_home_f3ab6b64:
    # mc "You’ve grown."
    mc "Has crecido."

# game/script.rpy:3484

translate spanish norman_home_faf50b2f:
    # mc "(Was this the right call…?)"
    mc "¿Fue esta la llamada correcta?"

# game/script.rpy:3485

translate spanish norman_home_a4717cc0:
    # mc "(Maybe I should talk him out of it…)"
    mc "(Quizá debería convencerlo de que no vaya...)"

# game/script.rpy:3487

translate spanish norman_home_1fd9c707:
    # mc "(No. Enough.)"
    mc "(No. Suficiente.)"

# game/script.rpy:3489

translate spanish norman_home_3fec7c16:
    # mc "(He’s not a kid anymore.)"
    mc "(Ya no es un niño.)"

# game/script.rpy:3490

translate spanish norman_home_4c4143cb:
    # mc "(Respect that.)"
    mc "(Respeto eso.)"

# game/script.rpy:3496

translate spanish norman_home_9b1d0ca0:
    # mc "(Alright… I’ve got everything.)"
    mc "(Derecha... tengo todo.)"

# game/script.rpy:3497

translate spanish norman_home_f3ce1c03:
    # mc "(Just a few things left and—)"
    mc "(Solo quedan algunas cosas y...)"

# game/script.rpy:3504

translate spanish norman_home_0814eb95:
    # mc "(Focus.)"
    mc "(Focus.)"

# game/script.rpy:3505

translate spanish norman_home_cc5a311f:
    # mc "(We’ve done this before.)"
    mc "(Hemos hecho esto antes)."

# game/script.rpy:3510

translate spanish norman_home_8f50b8d5:
    # L "Yeah… we thought it might be a good idea."
    L "Sí... pensamos que podría ser una buena idea."

# game/script.rpy:3512

translate spanish norman_home_0a7141c6:
    # L "Come on, you two."
    L "Vamos, ustedes dos."

# game/script.rpy:3513

translate spanish norman_home_a4431043:
    # L "One picture. For the memory."
    L "Una foto, para la memoria."

# game/script.rpy:3527

translate spanish norman_home_8e7b5abf:
    # L "Out of billions of people… and all the worlds out there—"
    L "De miles de millones de personas... y de todos los mundos ahí fuera..."

# game/script.rpy:3528

translate spanish norman_home_36e59273:
    # L "we found each other here."
    L "Nos encontramos aquí."

# game/script.rpy:3529

translate spanish norman_home_c6cc1ad6:
    # L "If that’s not fate… what is?"
    L "Si eso no es el destino... ¿qué es?"

# game/script.rpy:3535

translate spanish norman_home_1ea17fc9:
    # L "You’re mine."
    L "Eres mía."

# game/script.rpy:3536

translate spanish norman_home_9cdc58ac:
    # L "I’m never letting go."
    L "Nunca voy a dejar ir."

# game/script.rpy:3539

translate spanish norman_home_0faa46ad:
    # mc "Yeah…"
    mc "Sí..."

# game/script.rpy:3540

translate spanish norman_home_13d5535c:
    # mc "That’s how I’ll remember you."
    mc "Así es como te recordaré."

# game/script.rpy:3541

translate spanish norman_home_71a7e855:
    # mc "Always smiling."
    mc "Siempre sonriendo."

# game/script.rpy:3542

translate spanish norman_home_6c0d9e72:
    # mc "Always… alive."
    mc "Siempre... vivo."

# game/script.rpy:3544

translate spanish norman_home_b64ae0f6:
    # mc "(I’ve made my choice.)"
    mc "(He tomado mi decisión.)"

# game/script.rpy:3545

translate spanish norman_home_b635eead:
    # mc "(Thank you.)"
    mc "(Gracias.)"

# game/script.rpy:3548

translate spanish norman_home_32d52bdf:
    # mc "(…Goodbye.)"
    mc "(...Adiós.)"

# game/script.rpy:3551

translate spanish norman_home_4e9dcf14:
    # Lor "...So you finally stopped running."
    Lor "...así que finalmente dejaste de correr."

# game/script.rpy:3553

translate spanish norman_home_b75f347e:
    # Lor "...and chose to face it."
    Lor "...y eligió enfrentarlo."

# game/script.rpy:3557

translate spanish norman_home_e4ac4fa7:
    # Lor "Thank you… my love."
    Lor "Gracias... mi amor."

# game/script.rpy:3558

translate spanish norman_home_061b5774:
    # Lor "For finally letting me go."
    Lor "Por fin me deja ir."

# game/script.rpy:3578

translate spanish norman_home_8522a148:
    # mc "(Operation Drake. Al-Zahira, 2018.)"
    mc "(Operación Drake. Al-Zahira, 2018.)"

# game/script.rpy:3579

translate spanish norman_home_c59fb27c:
    # mc "(People vanished. No trace.)"
    mc "(La gente desapareció."

# game/script.rpy:3581

translate spanish norman_home_94ae8583:
    # mc "(Forest. Starlit Stand.)"
    mc "(Forest. Starlit Stand.)"

# game/script.rpy:3582

translate spanish norman_home_dadf74ea:
    # mc "(2030 incident.)"
    mc "(2030 incidentes.)"

# game/script.rpy:3583

translate spanish norman_home_9336b99b:
    # mc "(Same pattern. Larger scale.)"
    mc "(Same patrón. Escala más grande.)"

# game/script.rpy:3584

translate spanish norman_home_9b988aee:
    # mc "(Flash reported.)"
    mc "(Reportado por el choque)."

# game/script.rpy:3588

translate spanish norman_home_83f097e3:
    # mc "(Different places… same result.)"
    mc "(Diferentes lugares... el mismo resultado.)"

# game/script.rpy:3590

translate spanish norman_home_057664ee:
    # mc "(…And I was there. Both times.)"
    mc "(...y yo estaba allí."

# game/script.rpy:3594

translate spanish norman_home_476a4e7d:
    # mc "(Norman mentioned a lab… in the forest.)"
    mc "(Norman mencionó un laboratorio... en el bosque.)"

# game/script.rpy:3595

translate spanish norman_home_6772e516:
    # mc "(So Al-Zahira… had one too.)"
    mc "(Así que Al-Zahira... también tenía uno)."

# game/script.rpy:3597

translate spanish norman_home_6bae8be1:
    # mc "(No…)"
    mc "(No...)"

# game/script.rpy:3598

translate spanish norman_home_587febbf:
    # mc "(Not a lab.)"
    mc "(No un laboratorio.)"

# game/script.rpy:3599

translate spanish norman_home_87dc07b0:
    # mc "(Something inside it.)"
    mc "(Algo dentro de ella.)"

# game/script.rpy:3606

translate spanish norman_home_0ddb25b9:
    # Lo "The topic’s kind of unsettling, It’s something related to teleportation…"
    Lo "El tema es un poco inquietante, Es algo relacionado con la teletransportación..."

# game/script.rpy:3607

translate spanish norman_home_35afdfd3:
    # Lo "I heard it requires energy. Living energy."
    Lo "He oído que requiere energía."

# game/script.rpy:3611

translate spanish norman_home_eb4217af:
    # mc "(Energy…)"
    mc "(Energía...)"

# game/script.rpy:3616

translate spanish norman_home_4c92d36d:
    # N "Something that was supposed to extend life."
    N "Algo que se suponía que debía extender la vida."

# game/script.rpy:3617

translate spanish norman_home_e7904ce6:
    # N "But it turned out to be something else."
    N "Pero resultó ser otra cosa."

# game/script.rpy:3620

translate spanish norman_home_08998072:
    # N "It feeds… whatever’s inside."
    N "Se alimenta... lo que hay dentro."

# game/script.rpy:3626

translate spanish norman_home_9da6364c:
    # mc "(…Warp drive.)"
    mc "(...conducir de la cuerda.)"

# game/script.rpy:3627

translate spanish norman_home_5aeb54cf:
    # mc "(Norman said that before…)"
    mc "(Norman dijo eso antes...)"

# game/script.rpy:3630

translate spanish norman_home_16e0d69f:
    # mc "A warp drive?"
    mc "¿Un viaje de warp?"

# game/script.rpy:3631

translate spanish norman_home_314befaf:
    # mc "You serious right now?"
    mc "¿Hablas en serio ahora?"

# game/script.rpy:3634

translate spanish norman_home_c7ee0e67:
    # N "Dad, this is, this is real. I’m not making this up!"
    N "Papá, esto es, esto es real. ¡No estoy inventando esto!"

# game/script.rpy:3636

translate spanish norman_home_ce5d5458:
    # mc "(And I laughed at him…)"
    mc "(Y me reí de él...)"

# game/script.rpy:3637

translate spanish norman_home_2b35b6fe_14:
    # mc "..."
    mc "..."

# game/script.rpy:3639

translate spanish norman_home_d001d77a:
    # mc "(But the man in the mask…)"
    mc "(Pero el hombre en la máscara...)"

# game/script.rpy:3646

translate spanish norman_home_27ac3d31:
    # ri "...he’s backed by powerful entities."
    ri "...está respaldado por entidades poderosas."

# game/script.rpy:3647

translate spanish norman_home_38af67a9_1:
    # ri "Possibly... extraterrestrial."
    ri "Posiblemente... extraterrestre."

# game/script.rpy:3654

translate spanish norman_home_30952361:
    # N "It wasn’t my choice… I was led there."
    N "No fue mi elección... fui llevado allí."

# game/script.rpy:3655

translate spanish norman_home_4f43fca7:
    # N "A man… wearing a black mask."
    N "Un hombre... usando una máscara negra."

# game/script.rpy:3661

translate spanish norman_home_843c0015:
    # mc "(That man…)"
    mc "(Ese hombre...)"

# game/script.rpy:3662

translate spanish norman_home_f0b24200:
    # mc "(The one behind all this…)"
    mc "(El que está detrás de todo esto...)"

# game/script.rpy:3663

translate spanish norman_home_4f04a60b:
    # mc "(It has to be him.)"
    mc "(Tiene que ser él.)"

# game/script.rpy:3665

translate spanish norman_home_3552c344:
    # mc "(He wasn’t random.)"
    mc "(No era aleatorio.)"

# game/script.rpy:3666

translate spanish norman_home_dc3cc150:
    # mc "(He was leading people there.)"
    mc "(Él estaba dirigiendo a la gente allí.)"

# game/script.rpy:3669

translate spanish norman_home_ef6d4e8e:
    # mc "(…Or is it?)"
    mc "(...¿O es?)"

# game/script.rpy:3674

translate spanish norman_home_69aac207:
    # C "(Singing a tune)"
    C "(Cantando una canción)"

# game/script.rpy:3676

translate spanish norman_home_689e80c5:
    # C "Sooo… sis."
    C "Sooo... sis."

# game/script.rpy:3677

