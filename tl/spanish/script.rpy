    # h "(And honestly, I still remember that day clearer than I’d like to.)"
    h "(Y honestamente, aún recuerdo ese día más claro de lo que me gustaría)."

# game/script.rpy:3267

translate spanish exit_63988c4c:

    # h "(It was pouring. That kind of rain that makes the whole city feel heavier.)"
    h "(Fue derramando. Esa clase de lluvia que hace que toda la ciudad se sienta más pesada.)"

# game/script.rpy:3269

translate spanish exit_cd664f61:

    # h "(I was freezing under some rusted-out shelter, broke, soaked, hungry...)"
    h "(Estaba congelándome bajo un refugio oxidado, roto, empapado, hambriento...)"

# game/script.rpy:3271

translate spanish exit_ec7d09bc:

    # h "(Back then, I was just looking for a job. Something to help mom. Maybe even put Anya through school.)"
    h "(En ese entonces solo buscaba trabajo. Algo para ayudar a mamá. Quizá incluso pagarle los estudios a Anya.)"

# game/script.rpy:3282

translate spanish exit_75f77f2f:

    # h "(But as life tends to go, it’s never that simple.)"
    h "(Pero como la vida tiende a ir, nunca es tan simple.)"

# game/script.rpy:3284

translate spanish exit_888b28fe:

    # h "(I had to learn that lesson early.)"
    h "(Tuve que aprender esa lección temprano.)"

# game/script.rpy:3288

translate spanish exit_964362b1:

    # h "(After yet another rejection — no hope, no strength — I collapsed.)"
    h "(Después de otro rechazo —sin esperanza, sin fuerza— me derrumbé.)"

# game/script.rpy:3290

translate spanish exit_6150cfaa:

    # h "(Angry. Confused. Ashamed of the world, and most of all — myself.)"
    h "(Fuente. Confuso. Ashamed of the world, and most of all — yo mismo.)"

# game/script.rpy:3292

translate spanish exit_cdc649f3:

    # h "So, Olivia... this is what failure looks like?"
    h "Olivia... ¿eso es el fracaso?"

# game/script.rpy:3296

translate spanish exit_eca6fcf4:

    # h "(For being so useless…)"
    h "(Por ser tan inútil...)"

# game/script.rpy:3298

translate spanish exit_749e38bd:

    # h "Even to work as an ordinary waitress you need a diploma? That’s just ridiculous..."
    h "¿Incluso para trabajar como camarera ordinaria necesitas un diploma? Eso es ridículo..."

# game/script.rpy:3299

translate spanish exit_0c7b89aa:

    # h "What now? How do I face mom and Anya?"
    h "¿Cómo me enfrenta a mamá y Anya?"

# game/script.rpy:3301

translate spanish exit_2955f58a:

    # h "I was so sure this time..."
    h "Esta vez estaba tan segura..."

# game/script.rpy:3304

translate spanish exit_aebe9ebb:

    # h "(I was broken. Truly. My last chance — shattered to pieces.)"
    h "(Me rompieron. Verdaderamente. Mi última oportunidad — destrozado en pedazos.)"

# game/script.rpy:3305

translate spanish exit_f3bb15ad:

    # h "(But suddenly...)"
    h "(Pero de repente...)"

