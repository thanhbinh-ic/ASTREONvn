    a "Nadie que he pedido parece conocer su origen, como si se hubiera caído del cielo."

# game/script.rpy:897

translate spanish war2_ffe8753b:

    # az "And I don’t repeat myself."
    az "Y no me repito."

# game/script.rpy:899

translate spanish war2_82b66bea:

    # az "You give me the goods, I give you the promised amount. {w=0.7}No more, no less. Got it?"
