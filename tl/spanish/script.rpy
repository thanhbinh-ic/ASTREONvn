    F "¿Qué hacemos ahora? Aquí apenas se ve nada."

# game/script.rpy:2753

translate spanish spaceship_into_52ab9321:

    # S "First, we need to figure out where we’re going."
    S "Primero, tenemos que averiguar a dónde vamos."

# game/script.rpy:2755

translate spanish spaceship_into_f91f5a43:

    # S "[mc], switch on your flashlight."
    S "[mc], enciende la linterna."

# game/script.rpy:2757

translate spanish spaceship_into_b6cecccf:

