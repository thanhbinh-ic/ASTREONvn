translate spanish war2_97afc65a:

    # S "I see movement at the back. {w=0.7}It might be the target. {w=0.7}What are your orders?"
    S "Veo movimiento en la parte trasera. {w=0.7}Podría ser el objetivo. {w=0.7}¿Cuáles son sus órdenes?"

# game/script.rpy:884

translate spanish war2_57f1101d:

    # mc "Wait. {w=0.7}Don’t rush — we need to confirm it’s the real deal."
    mc "Espera. {w=0.7}No te apresures — necesitamos confirmar que es el verdadero trato."

# game/script.rpy:891

translate spanish war2_47190cf3:

    # a "But I’ll make an exception this time. {w=0.7}Mind telling me what this thing really is?"
    a "Pero esta vez haré una excepción. {w=0.7}¿Me importa decirme qué es esta cosa?"

