# game/script.rpy:900

translate spanish war2_b5ffdd14:

    # a "Alright, alright."
    a "Muy bien, muy bien."

# game/script.rpy:902

translate spanish war2_3586621a:

    # a "Don’t want to cross the line — might end up like the others."
    a "No quiero cruzar la línea — puede terminar como los otros."

