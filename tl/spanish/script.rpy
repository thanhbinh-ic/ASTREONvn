    mc "...y él es quien mueve los hilos detrás de Masquerade."

# game/script.rpy:757

translate spanish war2_258b502c:

    # S "And that makes him our target?"
    S "¿Y eso le hace nuestro objetivo?"

# game/script.rpy:758

translate spanish war2_fca52711:

    # mc "No."
    mc "No."

# game/script.rpy:760

translate spanish war2_a420244e:

    # mc "But it’s enough to put him on our list."
    mc "Pero es suficiente ponerlo en nuestra lista."

# game/script.rpy:762

translate spanish war2_c318897f:

    # mc "Job’s simple. We stop the deal."
    mc "Job es simple. Detenemos el trato."

# game/script.rpy:763

translate spanish war2_2f875c13:

