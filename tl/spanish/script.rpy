translate spanish exit_f07138cb:

    # h "(Okay, I was a bit rude — but come on, anyone would be in my shoes.)"
    h "(Vale, fui un poco grosera, pero vamos, cualquiera habría reaccionado igual en mi lugar.)"

# game/script.rpy:3319

translate spanish exit_5589e928:

    # mc "You know... sometimes, pouring your heart out to a stranger helps."
    mc "Sabes... a veces, derramar tu corazón a un extraño ayuda."

# game/script.rpy:3320

translate spanish exit_140b131e:

    # mc "Might sound crazy. But for some? It’s salvation."
    mc "Puede sonar loco. Pero para algunos? Es la salvación."

# game/script.rpy:3324

translate spanish exit_f44c513e:

    # mc "Or if not — just let me sit here with you. Until the rain stops."
    mc "O si no, déjame sentarme aquí contigo hasta que la lluvia se detenga."

