    mc "El problema es que no tenemos idea de con cuántos estamos tratando."

# game/script.rpy:779

translate spanish war2_635b87ba:

    # mc "We scout first."
    mc "Primero nos vigilamos."

# game/script.rpy:780

translate spanish war2_19453ed6:

    # mc "Assess."
    mc "Evaluar."

# game/script.rpy:781

translate spanish war2_4081d355:

    # mc "Then we move."
