    # c "Oh, as always, your darling wife. That explains the smile on your face."
    c "Como siempre, tu querida esposa, eso explica la sonrisa en tu cara."

# game/script.rpy:491

translate spanish war2_ce9d46d7:

    # mc "Any news? Or is there still no word?"
    mc "¿Alguna noticia o todavía no hay ninguna palabra?"

