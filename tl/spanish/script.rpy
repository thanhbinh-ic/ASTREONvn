    mc "(Un dispositivo de apertura... por supuesto.)"

# game/script.rpy:5475
translate spanish path_front_next2_2e043a84:

    # mc "(Without a opener, I’m tied up...)"
    mc "(Sin un dispositivo de apertura, estoy atrapado...)"

# game/script.rpy:5501
translate spanish path_front_next2_9957c902:

    # mc "Grab the opener and get out."
    mc "Toma el dispositivo de apertura y sal."

