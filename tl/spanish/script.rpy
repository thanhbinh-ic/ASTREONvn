translate spanish war2_cd687685:

    # c "Silence, sir."
    c "Silencio, señor."

# game/script.rpy:497

translate spanish war2_1a2895f8:

    # c "We haven’t heard from them since that day, and it doesn’t look like we ever will."
    c "No hemos oído de ellos desde ese día, y no parece que lo hayamos hecho."

# game/script.rpy:498

translate spanish war2_5c2f8892:

    # c "Still, we should wait a little longer."
    c "Aún así, deberíamos esperar un poco más."

# game/script.rpy:500

translate spanish war2_9b7bb520:

    # x "Yeah, sure, just great. We’ve been stuck here for four days already! How much longer? Where the hell are they?!"
    x "Sí, claro, simplemente genial. ¡Ya hemos estado atrapados aquí durante cuatro días! ¿Cuánto tiempo más? ¿Dónde diablos están?!"

# game/script.rpy:501

translate spanish war2_d572898d:

    # x "Que me besen el culo si creen que voy a quedarme aquí más tiempo."
    x "Que me besen el culo si creen que voy a compartir aquí más tiempo."

# game/script.rpy:503

translate spanish war2_cf2a2d51:

    # c "Oh, not this again. Speak properly so we can at least understand you!"
    c "No, no, habla bien para que podamos entenderte."

# game/script.rpy:506

translate spanish war2_784e79f5:

    # x "What’s the problem? I’m just speaking in my native language here. What’s wrong with that?"
    x "¿Cuál es el problema? Estoy hablando en mi idioma nativo aquí. ¿Qué tiene de malo?"

# game/script.rpy:509

translate spanish war2_ba8de7b6:

    # x "What other language should I be speaking?"
    x "¿Qué otro idioma debería estar hablando?"

# game/script.rpy:512

translate spanish war2_53319ef4:

    # x "Are you seriously telling me I’m not allowed to speak in my own language when I’m out here risking my life out here?"
    x "¿Me estás diciendo seriamente que no me permiten hablar en mi propio idioma cuando estoy aquí arriesgando mi vida aquí?"

# game/script.rpy:514

translate spanish war2_7f304ec0:

    # c "Seriously, we don’t understand a single word you’re saying when you go off like that, you little bastard."
    c "En serio, no entendemos una sola palabra de lo que dices cuando te pones así, pequeño bastardo."

# game/script.rpy:517

translate spanish war2_ebcbbc91:

    # x "Eso no es problema mío si tu cerebro diminuto no pudo molestarse en aprender algo más que tu inglés."
    x "Eso no es problema mío si tu cerebro diminuto no pudo molestarse en aprender algo más que tu inglés."

# game/script.rpy:519

translate spanish war2_850ef128:

    # b "..."
    b "..."

# game/script.rpy:521

translate spanish war2_8822797f:

    # c "Here we go again..."
    c "Aquí vamos otra vez..."

# game/script.rpy:523

translate spanish war2_093a1320:

    # mc "You know it’s a sore spot for him. Try to be a little more tactful, and maybe you two can get along."
    mc "Sabes que es un lugar doloroso para él. Trate de ser un poco más tacto, y tal vez ustedes dos pueden llevarse bien."

# game/script.rpy:525

translate spanish war2_204c974d:

    # c "Fair point. I always forget that... I’ll do my best."
    c "Punto justo. Siempre olvido que... haré lo mejor que pueda."

# game/script.rpy:527

translate spanish war2_811da632:

    # c "Hey, big guy, I’m sorry."
    c "Oye, grandullón, lo siento."

# game/script.rpy:529

translate spanish war2_4b2d4203:

    # x "Screw you!"
    x "¡Que te jodan!"

# game/script.rpy:531

translate spanish war2_42123925:

    # c "Haha, fair enough. At least I tried..."
    c "Haha, lo suficientemente justo."

# game/script.rpy:533

translate spanish war2_1e1d8413:

    # m "Commander? May I ask you something?"
    m "¿Puedo preguntarte algo?"

# game/script.rpy:535

translate spanish war2_b9710c73:

    # mc "Sure thing."
    mc "Claro."

# game/script.rpy:537

translate spanish war2_3a040f9e:

    # m "After this operation, when we finally get home, what are you planning to do?"
    m "Después de esta operación, cuando finalmente lleguemos a casa, ¿qué planeas hacer?"

# game/script.rpy:539

translate spanish war2_ab793870:

    # c "First thing, I’m stopping by the store and buying all the sweets I can for my daughter!"
    c "Lo primero, voy a pasar por la tienda y comprar todos los dulces que puedo por mi hija!"

# game/script.rpy:541

translate spanish war2_44e62846:

    # m "That question wasn’t for you..."
    m "Esa pregunta no era para ti..."

# game/script.rpy:543

translate spanish war2_dd903453:

    # c "Oh, come on! Just sharing my plans here..."
    c "Solo compartiendo mis planes aquí..."

# game/script.rpy:545

translate spanish war2_5f680056:

    # mc "How old is your daughter now?"
    mc "¿Cuántos años tiene tu hija ahora?"

# game/script.rpy:547

translate spanish war2_bee0a4b3:

    # c "She just turned three years old the other day. I can’t believe how fast she’s growing up."
    c "Ella acaba de cumplir tres años el otro día. No puedo creer lo rápido que está creciendo."

# game/script.rpy:549

translate spanish war2_853da63c:

    # m "Well, at least someone’s grown during all this, haven’t they?"
    m "Bueno, al menos alguien ha crecido durante todo esto, ¿no?"

# game/script.rpy:551

translate spanish war2_3edc4de0:

    # h "Still, [mc], what’s our objective?"
    h "Aún así, [mc], ¿cuál es nuestro objetivo?"

# game/script.rpy:552

translate spanish war2_fabcc08a:

    # h "I don’t know about the others, but I didn’t understand a damn thing during that pre-mission briefing."
    h "No sé de los otros, pero no entendí nada durante esa sesión informativa previa a la misión."

# game/script.rpy:554

translate spanish war2_fe7a1f54:

    # m "You’re not the only one. For once, I found it strange myself."
    m "No eres el único. Por una vez, me pareció extraño."

# game/script.rpy:555

translate spanish war2_cba33b94:

    # m "Seriously, {b}‘Reach the designated location and wait for further orders’?{/b} You’ve got to be kidding me."
    m "En serio, {b}“¿Llevar el lugar designado y esperar a nuevas órdenes?{/b} Tienes que estar bromeando."

# game/script.rpy:557

translate spanish war2_a9a2cfe6:

    # mc "According to intel, we managed to contact individuals who possess information about Azarkhan Temirov."
    mc "Según la información, logramos contactar a personas que poseen información sobre Azarkhan Temirov."

# game/script.rpy:560

translate spanish war2_517743a3:

    # mc "He’s the head of a research lab studying neural implants and, at the same time, the mastermind behind the Maskarad group."
    mc "Es el jefe de un laboratorio de investigación que estudia implantes neuronales y, al mismo tiempo, el maestro de la obra detrás del grupo Maskarad."

# game/script.rpy:562

translate spanish war2_d1a51207:

    # mc "Our objective is to prevent a deal set to take place within the next day, eliminate Azarkhan if possible, and secure the goods."
    mc "Nuestro objetivo es evitar que un acuerdo que se establezca tenga lugar al día siguiente, eliminar Azarkhan si es posible, y asegurar los bienes."

# game/script.rpy:564

translate spanish war2_1ffb3c54:

    # mc "As for the goods themselves, all we know is that it’s some kind of energy storage device capable of catastrophic destruction on a massive scale."
    mc "En cuanto a los bienes mismos, todo lo que sabemos es que es algún tipo de dispositivo de almacenamiento de energía capaz de destruir catastróficamente a una escala masiva."

# game/script.rpy:566

translate spanish war2_f0a83888:

    # mc "I’m sure I don’t need to explain why we must keep such a thing out of Azarkhan’s hands..."
    mc "Estoy seguro de que no necesito explicar por qué debemos mantener esa cosa fuera de las manos de Azarkhan..."

# game/script.rpy:568

translate spanish war2_93d334de:

    # mc "The biggest issue is our lack of intel on enemy numbers. So our first task will be reconnaissance and assessing the situation. I hope that’s clear."
    mc "El problema más importante es nuestra falta de información sobre los números enemigos. Así que nuestra primera tarea será el reconocimiento y evaluación de la situación. Espero que sea clara."

# game/script.rpy:569

translate spanish war2_c4a373fc:

    # E "Understood."
    E "Entendido."

# game/script.rpy:571

translate spanish war2_ee800ba0:

    # mc "Any questions?"
    mc "¿Alguna pregunta?"

# game/script.rpy:572

translate spanish war2_607d788c:

    # h "None."
    h "Ninguno."

# game/script.rpy:573

translate spanish war2_22d96cab:

    # mc "Then all we can do now is wait."
    mc "Entonces todo lo que podemos hacer ahora es esperar."

# game/script.rpy:576

translate spanish war2_8030febc:

    # r "6-Bravo, this is Eagle-2. Do you copy? A convoy has been spotted approaching you from the east at high speed. Confirm you’ve received this information."
    r "6-Bravo, este es Eagle-2. ¿Me recibes? Un convoy ha sido visto acercarte desde el este a alta velocidad. Confirma que has recibido esta información."

# game/script.rpy:579

translate spanish war2_9b150592:

    # mc "Eagle-2, this is 6-Bravo. Message received. How long until they reach us?"
    mc "Águila-2, aquí 6-Bravo. Mensaje recibido. ¿Cuánto tiempo hasta que nos llegan?"

# game/script.rpy:582

translate spanish war2_86573335:

    # r "Bravo-6, ETA is 20 minutes. They’re moving fast—two vehicles in total. Do not engage first. Await further instructions. Over."
    r "Bravo-6, ETA es de 20 minutos. Se mueven rápido - dos vehículos en total. No se enganche primero. Espere instrucciones adicionales. Cambio."

# game/script.rpy:585

translate spanish war2_d38cfb6c:

    # mc "Over."
    mc "Cambio."

# game/script.rpy:590

translate spanish war2_f1e65667:

    # mc "Everyone heard that? Take your positions. We’ve got 20 minutes. Let’s move, move!"
    mc "¿Todos lo oyeron? Tomen posiciones. Tenemos veinte minutos. ¡Muévanse, muévanse!"

# game/script.rpy:602

translate spanish war2_a21c29c7:

    # x "Finally, some action... Can’t wait to shred these bastards to pieces. Just show yourselves."
    x "Finalmente, alguna acción... No puedo esperar a que estos bastardos se desmenuzaran."

# game/script.rpy:606

translate spanish war2_e2aceb84:

    # mc "Shiya, where exactly are you right now? Have you taken up your designated position?"
    mc "Shiya, ¿dónde estás exactamente ahora? ¿Has tomado tu posición designada?"

# game/script.rpy:608

translate spanish war2_b4dd6065:

    # S "Affirmative, I’m in position and ready."
    S "Afirmativo, estoy en posición y listo."

# game/script.rpy:610

translate spanish war2_ff29765a:

    # mc "Any movement?"
    mc "¿Algún movimiento?"

# game/script.rpy:612

translate spanish war2_81dbd309:

    # S "Movement spotted east, two vehicles. One vehicle north. Nothing else."
    S "Movimiento localizado al este, dos vehículos, un vehículo al norte, nada más."

# game/script.rpy:614

translate spanish war2_32921dbd:

    # mc "Hold for my signal — do not engage."
    mc "Sostén mi señal, no te atrevas."

# game/script.rpy:615

translate spanish war2_22c8d246:

    # x "Come on, Commander! We can take them — just a handful of guys. Two volleys, and they’re done."
    x "¡Vamos, comandante! Podemos tomarlos, solo un puñado de chicos. Dos voleies, y están acabados."

# game/script.rpy:617

translate spanish war2_4b50ab34:

    # S "And what if this is just part of the group? Or did your dumb brain conveniently skip that thought and jump straight to action?"
    S "¿Y si esto es solo parte del grupo? ¿O tu tonto cerebro saltó convenientemente ese pensamiento y saltó directamente a la acción?"

# game/script.rpy:618

translate spanish war2_620dc4b0:

    # x "What did you just say? Stupid brain?! Oh, you little perra!"
    x "¿Qué acabas de decir? ¡Cere estúpido!"

# game/script.rpy:619

translate spanish war2_0245f736:

    # S "Oh, fuck off."
    S "Oh, vete a la mierda."

# game/script.rpy:621

translate spanish war2_ff978696:

    # x "[mc], could you please say something to her?"
    x "[mc]¿Podrías por favor decirle algo?"

# game/script.rpy:622

translate spanish war2_4c22ddff:

    # mc "Quiet down, Alexandro, get ready for what’s coming. Shiya, status."
    mc "Silencio, Alexandro, prepárate para lo que viene. Shiya, estado."

# game/script.rpy:623

translate spanish war2_38fad0df:

    # S "(whispering) Always complaining like a kid. (Louder) Understood. Aside from this group, no enemies in sight."
    S "(susurrando) Siempre quejándose como un niño. (En voz alta) Entendido. Aparte de este grupo, no hay enemigos a la vista."

# game/script.rpy:625

translate spanish war2_3ac62202:

    # mc "What about the target?"
    mc "¿Qué hay del objetivo?"

# game/script.rpy:626

translate spanish war2_8a3f2311:

    # S "Negative, the target isn’t visible. There’s a chance this is a decoy. What are your orders, sir?"
    S "Negativo, el objetivo no es visible. Hay una posibilidad de que esto sea un decoy. ¿Cuáles son sus órdenes, señor?"

# game/script.rpy:627

translate spanish war2_92e44935:

    # mc "We wait."
    mc "Esperamos."

# game/script.rpy:635

translate spanish war2_ea0e79a9:

    # a "Well, well, it’s been a long time. Glad to see you after all these years, my old friend. How’s the wife? The kids? Everything great, I assume?"
    a "Bueno, bueno, ha sido mucho tiempo. Me alegro de verte después de todos estos años, mi viejo amigo. ¿Cómo está la esposa? ¿Los niños?"

# game/script.rpy:637

translate spanish war2_4a85132a:

    # az "I don’t have time for this. Let’s get to the point. Do you have the goods?"
    az "No tengo tiempo para esto. Vamos a llegar al punto. ¿Tiene usted las mercancías?"

# game/script.rpy:638

translate spanish war2_6f38be34:

    # a "You’re still the same grumpy old man. But yes, I have the goods. You have no idea what it cost me to get them."
    a "Eres el mismo viejo gruñón, pero sí, tengo las mercancías. No tienes idea de lo que me costó conseguirlas."

# game/script.rpy:639

translate spanish war2_c2c9e918:

    # a "Although I wasn’t able to kill all the witnesses—one scientist managed to escape."
    a "Aunque no pude matar a todos los testigos, un científico logró escapar."

# game/script.rpy:640

translate spanish war2_9fa4285c:

    # az "Doesn’t matter. The important thing is that you secured the goods. So, where are they?"
    az "No importa. Lo importante es que usted ha asegurado las mercancías. Entonces, ¿dónde están?"

# game/script.rpy:642

translate spanish war2_aa713e77:

    # a "Hey, rookies! Bring it out."
    a "¡Eh, novatos!"

# game/script.rpy:645

translate spanish war2_ce46fe00:

    # a "Our boss wants to take a look at it."
    a "Nuestro jefe quiere echarle un vistazo."

# game/script.rpy:652

translate spanish war2_ee298997:

    # S "I see movement at the back. It looks like it might be the target. What are your orders?"
    S "Veo movimiento en la parte posterior, parece que podría ser el objetivo. ¿Cuáles son tus órdenes?"

# game/script.rpy:653

translate spanish war2_a527ff12:

    # mc "Wait. Let’s not rush — we need to confirm it’s the real deal."
    mc "Espera. No nos apresuremos — necesitamos confirmar que es el verdadero trato."

# game/script.rpy:654

translate spanish war2_5bc30440:

    # S "Understood."
    S "Entendido."

# game/script.rpy:658

translate spanish war2_8a676770:

    # a "You know, I usually don’t stick my nose into other people’s business, but I’ll make an exception this time. Mind telling me what this thing really is?"
    a "Sabes, normalmente no meto la nariz en el negocio de otras personas, pero haré una excepción esta vez. ¿Me importa decirme qué es esta cosa realmente?"

# game/script.rpy:660

translate spanish war2_63836237:

    # a "I mean, no one I’ve asked seems to know its origin, like it just fell from the sky. And I don’t like secrets."
    a "Quiero decir, nadie que he pedido parece conocer su origen, como si simplemente cayera del cielo. Y no me gustan los secretos."

# game/script.rpy:662

translate spanish war2_448ef46b:

    # az "It doesn’t concern you. You give me the goods, I give you the promised amount. No more, no less. Got it?"
    az "No te preocupa. Me das las mercancías, te doy la cantidad prometida. No más, no menos. ¿Lo tienes?"

# game/script.rpy:664

translate spanish war2_933ccb1d:

    # a "Blah, blah, fine. Don’t want to cross the line, or I might end up like others."
