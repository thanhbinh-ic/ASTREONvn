    # mc "Intel says we’ve got contacts tied to Azarkhan Temirov."
    mc "Intel dice que tenemos contactos atados a Azarkhan Temirov."

# game/script.rpy:753

translate spanish war2_a0d6ca00:

    # m "And who is that supposed to be?"
    m "¿Y quién se supone que es?"

# game/script.rpy:754

translate spanish war2_e8b25aba:

    # mc "Runs a neural implant lab..."
    mc "Ejecute un laboratorio de implantes neuronales..."

# game/script.rpy:756

translate spanish war2_a6bd16d2:

