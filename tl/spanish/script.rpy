translate spanish war2_2f341c57:

    # S "Negative. {w=0.6}I can’t see inside, but judging by their reactions, I’d say it’s the real deal."
    S "Negativo. {w=0.6}No puedo ver dentro, pero a juzgar por sus reacciones, diría que es el verdadero trato."

