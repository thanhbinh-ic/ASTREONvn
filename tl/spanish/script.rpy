    # h "Best idea I’ve heard all day."
    h "La mejor idea que he oído todo el día."

# game/script.rpy:5621

translate spanish spaceship_door_9425884e:
    # mc "Unless you’ve got a warhead in your pocket, we’re outgunned."
    mc "A menos que tengas una ojiva en tu bolsillo, estamos en el bolsillo."

# game/script.rpy:5626

translate spanish spaceship_door_29878d4c:
    # S "C4."
    S "C4."

# game/script.rpy:5627

translate spanish spaceship_door_7d320da1:
    # S "If we place it right… it’ll take it down."
    S "Si lo ponemos bien... lo derribará."

# game/script.rpy:5629

translate spanish spaceship_door_eb25214c:
    # h "...Okay, that might actually work."
    h "...Vale, eso podría funcionar."

# game/script.rpy:5630

translate spanish spaceship_door_67aec647:
    # h "But where the hell did you get that?"
    h "¿Pero dónde diablos conseguiste eso?"

# game/script.rpy:5636

translate spanish spaceship_door_347625f9:
    # h "...Right."
    h "...Claro."

# game/script.rpy:5650

translate spanish spaceship_door_bc98ef97:
    # h "Yeah, I think we can safely rule out ‘not dangerous’."
    h "Sí, creo que podemos descartar con seguridad que no sea peligroso."

# game/script.rpy:5651

translate spanish spaceship_door_688506de:
    # h "Richard’s out there running field tests with his face."
    h "Richard está ahí fuera haciendo pruebas de campo con su cara."

# game/script.rpy:5698

translate spanish spaceship_door_73b8bfc3:
    # mc "You’ve lost your mind."
    mc "Has perdido la cabeza."

# game/script.rpy:5699

translate spanish spaceship_door_b730793d:
    # mc "That thing’s not friendly."
    mc "Esa cosa no es amistosa."

# game/script.rpy:5706

translate spanish spaceship_door_491968b0:
    # mc "I don’t like this."
    mc "No me gusta esto."

# game/script.rpy:5707

translate spanish spaceship_door_53a5d8ff:
    # mc "Not even a little."
    mc "Ni siquiera un poco."

# game/script.rpy:5725

translate spanish spaceship_door_a43031ba:
    # r "Commander, do you read me?"
    r "Comandante, ¿me lee?"

# game/script.rpy:5728

translate spanish spaceship_door_6ac04b99:
    # r "We're under attack. Armed hostiles."
    r "Estamos bajo ataque, adversarios armados."

# game/script.rpy:5751

translate spanish spaceship_door_44e1cac8:
    # h "So what—"
    h "Entonces, ¿qué?"

# game/script.rpy:5752

translate spanish spaceship_door_cc31502c:
    # h "they ditched us, or we ditched them?"
    h "¿Nos dejaron o los dejamos?"

# game/script.rpy:5753

translate spanish spaceship_door_e8ac66a3:
    # h "…Eh."
    h "...Eh."

# game/script.rpy:5754

translate spanish spaceship_door_3c7cf872:
    # h "Same difference."
    h "La misma diferencia."

# game/script.rpy:5771

translate spanish spaceship_door_9595e8d0:
    # h "...Okay, tell me I’m not seeing things."
    h "...Vale. Dime que no estoy imaginando cosas."

# game/script.rpy:5772

translate spanish spaceship_door_ed19c04f:
    # h "That thing just followed them, right?"
    h "Esa cosa los siguió, ¿verdad?"

# game/script.rpy:5774

translate spanish spaceship_door_e12a2200:
    # mc "You saw it right."
    mc "Lo viste bien."

# game/script.rpy:5775

translate spanish spaceship_door_ded71177:
    # mc "And it’s with them."
    mc "Y está con ellos."

# game/script.rpy:5782

translate spanish spaceship_door_6651ab87:
    # mc "Alright."
    mc "Muy bien."

# game/script.rpy:5783

translate spanish spaceship_door_e31cb2e9:
    # mc "We’re not waiting for the next disaster."
    mc "No estamos esperando el próximo desastre."

# game/script.rpy:5784

translate spanish spaceship_door_2562ad6f:
    # mc "Move."
    mc "Muévete."

# game/script.rpy:5787

translate spanish spaceship_door_db957387:
    # h "So what now?"
    h "¿Y ahora qué?"

# game/script.rpy:5788

translate spanish spaceship_door_ca8e6f89:
    # h "We just stand here and stare at it until it opens itself?"
    h "¿Nos quedamos aquí y lo miramos hasta que se abra?"

# game/script.rpy:5790

translate spanish spaceship_door_ef89ebe2:
    # mc "Tempting."
    mc "Tempting."

# game/script.rpy:5791

translate spanish spaceship_door_bcaa161b:
    # mc "Still gotta open it."
    mc "Aún tiene que abrirlo."

# game/script.rpy:5792

translate spanish spaceship_door_d0a7e435:
    # mc "No shortcuts."
    mc "No hay atajos."

# game/script.rpy:5794

translate spanish spaceship_door_30e866ec:
    # mc "Norman."
    mc "Norman."

# game/script.rpy:5795

translate spanish spaceship_door_bb8e4a24:
    # mc "You’ve been quiet."
    mc "Has estado callado."

# game/script.rpy:5796

translate spanish spaceship_door_3ee32121:
    # mc "You good?"
    mc "¿Estás bien?"

# game/script.rpy:5798

translate spanish spaceship_door_21fe90ca:
    # N "Yeah… I’m good."
    N "Sí... estoy bien."

# game/script.rpy:5803

translate spanish spaceship_door_e313e08c:
    # mc "Since when?"
    mc "¿Desde cuándo?"

# game/script.rpy:5809

translate spanish spaceship_door_42daceb6:
    # N "I don’t know, Dad… I just, can’t place it."
    N "No lo sé, papá... yo solo, no puedo colocarlo."

# game/script.rpy:5811

translate spanish spaceship_door_2fd558b9:
    # h "Hey, Norman…"
    h "Oye, Norman..."

# game/script.rpy:5812

translate spanish spaceship_door_b0c25c5b:
    # h "You even know how to shoot?"
    h "¿Sabes disparar?"

# game/script.rpy:5814

translate spanish spaceship_door_10ebb560:
    # h "Then stay behind me."
    h "Entonces quédate detrás de mí."

# game/script.rpy:5815

translate spanish spaceship_door_48d4a94f:
    # h "If things go south— I’ve got you."
    h "Si las cosas van al sur, te tengo."

# game/script.rpy:5819

translate spanish spaceship_door_be92834c:
    # h "Oh, I’m ready."
    h "Estoy listo."

# game/script.rpy:5821

translate spanish spaceship_door_d3e5fe51:
    # N "I’ll keep up. I won’t slow you down."
    N "Yo me quedo. No te ralentizaré."

# game/script.rpy:5823

translate spanish spaceship_door_6651ab87_1:
    # mc "Alright."
    mc "Muy bien."

# game/script.rpy:5824

translate spanish spaceship_door_ed237b7a:
    # mc "Stay sharp."
    mc "Mantente firme."

# game/script.rpy:5825

translate spanish spaceship_door_a6adc98a:
    # mc "Let’s move."
    mc "Vamos."

# game/script.rpy:5842

translate spanish endoftheporolgue_2b35b6fe:
    # mc "..."
    mc "..."

# game/script.rpy:5844

translate spanish endoftheporolgue_e16431b4:
    # mc "(…What the hell is that.)"
    mc "(...Qué demonios es eso.)"

# game/script.rpy:5845

translate spanish endoftheporolgue_ad54824b:
    # mc "...That’s not natural."
    mc "...Eso no es natural."

# game/script.rpy:5848

translate spanish endoftheporolgue_00eeb9d3:
    # h "…Well."
    h "Bueno."

# game/script.rpy:5849

translate spanish endoftheporolgue_4b9a1f51:
    # h "A floating black hole."
    h "Un agujero negro flotante."

# game/script.rpy:5850

translate spanish endoftheporolgue_aab18d43:
    # h "Yeah, that wasn’t on my list for today."
    h "Sí, eso no estaba en mi lista para hoy."

# game/script.rpy:5853

translate spanish endoftheporolgue_dfd517f6:
    # N "No… that’s not possible."
    N "No... eso no es posible."

# game/script.rpy:5854

translate spanish endoftheporolgue_11579870:
    # N "What is that thing doing here?"
    N "¿Qué hace esa cosa aquí?"

# game/script.rpy:5856

translate spanish endoftheporolgue_30e866ec:
    # mc "Norman."
    mc "Norman."

# game/script.rpy:5857

translate spanish endoftheporolgue_7b8c6fbb:
    # mc "You recognize it?"
    mc "¿Lo reconoces?"

# game/script.rpy:5859

translate spanish endoftheporolgue_bba56ce0:
    # N "Dad… that’s what Mom was working on."
    N "Papá... en eso estaba trabajando mamá."

# game/script.rpy:5861

translate spanish endoftheporolgue_143e66ae:
    # N "It’s a warp drive."
    N "Es una unidad warp."

# game/script.rpy:5866

translate spanish endoftheporolgue_2865e349:
    # az "Don’t worry… you’re not leaving. Not until I say so."
    az "No te preocupes... no vas a irte. No hasta que yo lo diga."

# game/script.rpy:5867

translate spanish endoftheporolgue_5a39664c:
    # az "My dear… {b}friends{/b}."
    az "Mi querida... {b}amigos{/b}."

# game/script.rpy:5868

translate spanish endoftheporolgue_fcfcc7fb:
    # az "No… not friends."
    az "No... no amigos."

# game/script.rpy:5870

translate spanish endoftheporolgue_a8d4185e:
    # az "...Or are you?"
    az "¿O eres tú?"

# game/script.rpy:5872

translate spanish endoftheporolgue_99e0e335:
    # az "Twenty years…"
    az "Veinte años..."

# game/script.rpy:5873

translate spanish endoftheporolgue_72f8c56d:
    # az "Twenty long… stretching… years."
    az "Veinte años... estirando... años."

# game/script.rpy:5874

translate spanish endoftheporolgue_5278223d:
    # az "And now you’re standing here. In front of me."
    az "Y ahora estás parado aquí."

# game/script.rpy:5875

translate spanish endoftheporolgue_c086db0c:
    # az "But why…? Your faces… why can’t I see them?"
    az "Pero, ¿por qué...? ¿por qué no puedo verlos?"

# game/script.rpy:5876

translate spanish endoftheporolgue_7481e565:
    # az "Only… fire."
    az "Solo... fuego."

# game/script.rpy:5877

translate spanish endoftheporolgue_7e47e3c3:
    # az "Fire… No—no, no, no—!"
    az "Fuego... ¡No, no, no, no!"

# game/script.rpy:5878

translate spanish endoftheporolgue_cc9b9cc8:
    # az "It hurts…"
    az "Duele..."

# game/script.rpy:5881

translate spanish endoftheporolgue_33c4b48f:
    # h "(quietly) ...He’s not right in the head."
    h "(quietly) ... Él no está en la cabeza."

# game/script.rpy:5882

translate spanish endoftheporolgue_aae967fd:
    # h "You were dead."
    h "Estabas muerto."

# game/script.rpy:5883

translate spanish endoftheporolgue_72181ea8:
    # h "So how the hell are you standing here?"
    h "¿Cómo diablos estás aquí?"

# game/script.rpy:5887

translate spanish endoftheporolgue_dfa57093:
    # az "Was I?"
    az "¿Lo era?"

# game/script.rpy:5888

translate spanish endoftheporolgue_b6016148:
    # az "I don’t remember."
    az "No recuerdo."

# game/script.rpy:5891

translate spanish endoftheporolgue_bf696e47:
    # az "Did they kill me…?"
    az "¿Me mataron?"

# game/script.rpy:5892

translate spanish endoftheporolgue_b0b43f88:
    # az "No…?"
    az "¿No?"

# game/script.rpy:5893

translate spanish endoftheporolgue_5ebb1eb1:
    # az "Then why am I here…"
    az "Entonces, ¿por qué estoy aquí?"

# game/script.rpy:5894

translate spanish endoftheporolgue_c665c33f:
    # az "Because of them."
    az "Por ellos."

# game/script.rpy:5895

translate spanish endoftheporolgue_54d55287:
    # az "Yes… THEM."
    az "Sí... ellos."

# game/script.rpy:5896

translate spanish endoftheporolgue_4dab5791:
    # az "But why… why…"
    az "Pero por qué... ¿por qué...?"

# game/script.rpy:5898

translate spanish endoftheporolgue_02723237:
    # az "Ah—!"
    az "¡Ah!"

# game/script.rpy:5899

translate spanish endoftheporolgue_cc574a3a:
    # az "I remember—yes, yes— it was y—"
    az "Recuerdo —sí, sí— fue y—"

# game/script.rpy:5900

translate spanish endoftheporolgue_1a615e60:
    # az "No."
    az "No."

# game/script.rpy:5901

translate spanish endoftheporolgue_c9d4f8cf:
    # az "I remember perfectly."
    az "Recuerdo perfectamente."

# game/script.rpy:5902

translate spanish endoftheporolgue_0f0eba51:
    # az "You pulled the trigger."
    az "Has apretado el gatillo."

# game/script.rpy:5912

translate spanish endoftheporolgue_ebaf266d:
    # mc "(Is he... actually dead?)"
    mc "(¿Está... realmente muerto?)"

# game/script.rpy:5916

translate spanish endoftheporolgue_a8f1ee0c:
    # npc "Substance capable of regenerating even human organs."
    npc "Sustancia capaz de regenerar incluso los órganos humanos."

# game/script.rpy:5919

translate spanish endoftheporolgue_e7a6cc89:
    # mc "(Может ли...)"
    mc "(¿Podría...?)"

# game/script.rpy:5920

translate spanish endoftheporolgue_2b35b6fe_1:
    # mc "..."
    mc "..."

# game/script.rpy:5921

translate spanish endoftheporolgue_cb8146d7:
    # mc "Olivia, careful. He's not dead yet."
    mc "Olivia, ten cuidado, no está muerto todavía."

# game/script.rpy:5924

translate spanish endoftheporolgue_ec666712:
    # h "...Not?"
    h "...¿No?"

# game/script.rpy:5925

translate spanish endoftheporolgue_90b1f04f:
    # h "I just put a bullet in his head."
    h "Le puse una bala en la cabeza."

# game/script.rpy:5926

translate spanish endoftheporolgue_46697ac3:
    # h "What do you mean ‘not’?"
    h "¿Qué quieres decir con \"no\"?"

# game/script.rpy:5928

translate spanish endoftheporolgue_4ce0c4a6:
    # N "Dad’s right, he’s not dead!"
    N "¡Papá tiene razón, no está muerto!"

# game/script.rpy:5930

translate spanish endoftheporolgue_752f5464:
    # h "Oh come on—"
    h "Oh, vamos..."

# game/script.rpy:5931

translate spanish endoftheporolgue_e20c3689:
    # h "You’re telling me that thing’s still alive?"
    h "¿Me estás diciendo que la cosa sigue viva?"

# game/script.rpy:5933

translate spanish endoftheporolgue_58f02eaf:
    # N "The substance... He absorbed it."
    N "La sustancia... la absorbió."

# game/script.rpy:5934

translate spanish endoftheporolgue_10da554a:
    # N "After that, he stopped being human."
    N "Después de eso, dejó de ser humano."

# game/script.rpy:5938

translate spanish endoftheporolgue_52f01cf2:
    # az "A human?"
    az "¿Un humano?"

# game/script.rpy:5939

translate spanish endoftheporolgue_c4e19673:
    # az "No… no, I am human."
    az "No, no, soy humano."

# game/script.rpy:5940

translate spanish endoftheporolgue_ae32f8c4:
    # az "Still human."
    az "Sigo siendo humano."

# game/script.rpy:5943

translate spanish endoftheporolgue_4fb790d9:
    # az "Just… different."
    az "Solo... diferente."

# game/script.rpy:5944

translate spanish endoftheporolgue_e85cec24:
    # az "A little… rearranged."
    az "Un poco... reorganizado."

# game/script.rpy:5947

translate spanish endoftheporolgue_02723237_1:
    # az "Ah—!"
    az "¡Ah!"

# game/script.rpy:5948

translate spanish endoftheporolgue_6c79e7bf:
    # az "That hurts…"
    az "Eso duele..."

# game/script.rpy:5949

translate spanish endoftheporolgue_625c0599:
    # az "Hurts-hurts-hurts…"
    az "Duele, duele, duele..."

# game/script.rpy:5954

translate spanish endoftheporolgue_b8c4dfa3:
    # az "What?"
    az "¿Qué?"

# game/script.rpy:5955

translate spanish endoftheporolgue_62718c4d:
    # az "I told you, human!"
    az "¡Te lo dije, humano!"

# game/script.rpy:5956

translate spanish endoftheporolgue_3cdfe01e:
    # az "Just… slightly… modified."
    az "Solo... ligeramente... modificado."

# game/script.rpy:5957

translate spanish endoftheporolgue_07c81b4b:
    # az "Improved, maybe."
    az "Mejor, tal vez."

# game/script.rpy:5960

translate spanish endoftheporolgue_9c23bcfe:
    # az "I was like you once. Weak. Afraid. Small."
    az "Una vez fui como tú. Débil. Asustado. Insignificante."

# game/script.rpy:5961

translate spanish endoftheporolgue_4c69f50a:
    # az "Waiting to die."
    az "Esperando a morir."

# game/script.rpy:5962

translate spanish endoftheporolgue_d05c74f3:
    # az "But death…"
    az "Pero la muerte..."

# game/script.rpy:5963

translate spanish endoftheporolgue_f7530d7a:
    # az "...death doesn’t end things."
    az "...la muerte no acaba con las cosas."

# game/script.rpy:5964

translate spanish endoftheporolgue_dc6b3f31:
    # az "It bends them."
    az "Las retuerce."

# game/script.rpy:5965

translate spanish endoftheporolgue_110b0344:
    # az "Breaks them."
    az "Las rompe."

# game/script.rpy:5968

translate spanish endoftheporolgue_6b2884d2:
    # az "My daughter…"
    az "Mi hija..."

# game/script.rpy:5969

translate spanish endoftheporolgue_e1a5d86b:
    # az "Poor thing. Loyal to the end."
    az "Pobrecita. Leal hasta el final."

# game/script.rpy:5970

translate spanish endoftheporolgue_276d2cf1:
    # az "She made a deal."
    az "Ella hizo un trato."

# game/script.rpy:5971

translate spanish endoftheporolgue_38f6d22c:
    # az "With a woman… strange… wrong."
    az "Con una mujer... extraña... equivocada."

# game/script.rpy:5972

translate spanish endoftheporolgue_2b96ddc7:
    # az "They told her: ‘We can bring him back.’"
    az "Le dijeron: \"Podemos traerlo de vuelta\"."

# game/script.rpy:5973

translate spanish endoftheporolgue_a23b7389:
    # az "And she—"
    az "Y ella..."

# game/script.rpy:5974

translate spanish endoftheporolgue_f2701477:
    # az "—she said yes."
    az "...dijo que sí."

# game/script.rpy:5976

translate spanish endoftheporolgue_85ab310a:
    # az "And now I’m here."
    az "Y ahora estoy aquí."

# game/script.rpy:5977

translate spanish endoftheporolgue_40b612fd:
    # az "See? Not so bad."
    az "¿Ves? No estuvo tan mal."

# game/script.rpy:5978

translate spanish endoftheporolgue_119ab016:
    # az "We could even be friends."
    az "Podríamos ser amigos."

# game/script.rpy:5979

translate spanish endoftheporolgue_112fb39f:
    # az "…Right?"
    az "¿Verdad?"

# game/script.rpy:5982

translate spanish endoftheporolgue_437e0729:
    # az "No… no."
    az "No... no."

# game/script.rpy:5983

translate spanish endoftheporolgue_00803a43:
    # az "No-no—NO."
    az "No, no... ¡NO!"

# game/script.rpy:5985

translate spanish endoftheporolgue_d6034643:
    # az "You killed me."
    az "Me mataste."

# game/script.rpy:5986

translate spanish endoftheporolgue_b742281c:
    # az "That day."
    az "Ese día."

# game/script.rpy:5998

translate spanish endoftheporolgue_20326694:
    # az "And since then—"
    az "Y desde entonces..."

# game/script.rpy:6000

translate spanish endoftheporolgue_d022674a:
    # az "I shut my eyes—"
    az "Cierro los ojos..."

# game/script.rpy:6001

translate spanish endoftheporolgue_86013249:
    # az "—and there you are."
    az "...y ahí estás."

# game/script.rpy:6003

translate spanish endoftheporolgue_bf3f40a1:
    # az "You didn’t hesitate."
    az "No dudaste."

# game/script.rpy:6004

translate spanish endoftheporolgue_60f19e0b:
    # az "That’s what I admire."
    az "Eso es lo que admiro."

# game/script.rpy:6011

translate spanish endoftheporolgue_4b0cc7cf:
    # mc "(…The masked guy?)"
    mc "(...¿El tipo enmascarado?)"

# game/script.rpy:6013

translate spanish endoftheporolgue_ff64f5ca:
    # a "Stay out of this, little man. He’s mine to deal with."
    a "No te metas en esto, hombrecito. Él es asunto mío."

# game/script.rpy:6015

translate spanish endoftheporolgue_bf0aed50:
    # az "That’s not what we agreed on."
    az "Eso no fue lo que acordamos."

# game/script.rpy:6017

translate spanish endoftheporolgue_3a4d0af0:
    # a "That man’s body… must be kept alive."
    a "El cuerpo de ese hombre... debe mantenerse vivo."

# game/script.rpy:6020

translate spanish endoftheporolgue_05496c8b:
    # a "This is the will… of the woman who created me."
    a "Esta es la voluntad de la mujer que me creó."

# game/script.rpy:6024

translate spanish endoftheporolgue_dae2c354:
    # az "No…"
    az "No..."

# game/script.rpy:6025

translate spanish endoftheporolgue_bca6dad4:
    # az "I want to watch."
    az "Quiero ver."

# game/script.rpy:6031

translate spanish endoftheporolgue_53a86359:
    # az "You’re… irritating."
    az "Eres... irritante."

# game/script.rpy:6036

translate spanish endoftheporolgue_09110022:
    # h "Out—!"
    h "¡Fuera!"

# game/script.rpy:6037

translate spanish endoftheporolgue_2f725a00:
    # h "Out of ammo, cover me!"
    h "¡Sin munición, cúbreme!"

# game/script.rpy:6045

translate spanish endoftheporolgue_7df2eaf1:
    # h "Don’t rush me—!"
    h "¡No me apresures!"

# game/script.rpy:6046

translate spanish endoftheporolgue_f78eab3a:
    # h "I’m on it!"
    h "¡Estoy en ello!"

# game/script.rpy:6058

translate spanish endoftheporolgue_4a6a6d7f:
    # mc "(Tough…)"
    mc "(Duro...)"

# game/script.rpy:6059

translate spanish endoftheporolgue_6c66d910:
    # mc "(Feels like hitting steel.)"
    mc "(Es como golpear acero.)"

# game/script.rpy:6060

translate spanish endoftheporolgue_8033231f:
    # mc "So you’re the one pulling the strings."
    mc "Así que tú eres quien mueve los hilos."

# game/script.rpy:6061

translate spanish endoftheporolgue_3102bdab:
    # a "Pulling… strings?"
    a "¿Mueve... hilos?"

# game/script.rpy:6062

translate spanish endoftheporolgue_52854cf2:
    # a "I do not understand. Explain, little man."
    a "No lo entiendo. Explícate, hombrecito."

# game/script.rpy:6073

translate spanish endoftheporolgue_15ae44d8:
    # mc "(…Wrong target?)"
    mc "(...¿El objetivo equivocado?)"

# game/script.rpy:6084

translate spanish endoftheporolgue_df0b2b78:
    # az "Two against one?"
    az "¿Dos contra uno?"

# game/script.rpy:6085

translate spanish endoftheporolgue_be371e7f:
    # az "Mm."
    az "Mm."

# game/script.rpy:6086

translate spanish endoftheporolgue_40b85edd:
    # az "How… disappointing."
    az "Qué... decepcionante."

# game/script.rpy:6114

translate spanish endoftheporolgue_444bb49e:
    # a "Honestly, I didn’t expect the little man to last this long."
    a "Sinceramente, no esperaba que el hombrecito durara tanto."

# game/script.rpy:6117

translate spanish endoftheporolgue_d8a442f2:
    # h "Hold on—!"
    h "¡Espera!"

# game/script.rpy:6119

translate spanish endoftheporolgue_7114bbb8:
    # az "You’re all running out of time."
    az "Se están quedando sin tiempo."

# game/script.rpy:6120

translate spanish endoftheporolgue_438b8f93:
    # az "You just don’t know it yet."
    az "Solo que aún no lo saben."

# game/script.rpy:6123

translate spanish endoftheporolgue_7b4a75f0:
    # az "No matter."
    az "No importa."

# game/script.rpy:6124

translate spanish endoftheporolgue_d9bddc01:
    # az "Give him my regards…"
    az "Dale mis saludos..."

# game/script.rpy:6135

translate spanish endoftheporolgue_a5e8f827:
    # aaa "Miriel… thirty seconds."
    aaa "Miriel... treinta segundos."

# game/script.rpy:6136

translate spanish endoftheporolgue_de21089d:
    # aaa "Small ones are mine."
    aaa "Los pequeños son míos."

# game/script.rpy:6137

translate spanish endoftheporolgue_11afc3fe:
    # aaa "The big one… yours."
    aaa "El grande... el tuyo."

# game/script.rpy:6138

translate spanish endoftheporolgue_8b5c72f0:
    # Mi "…Understood."
    Mi "...Entendido."

# game/script.rpy:6163

translate spanish endoftheporolgue_491bd79b:
    # Mi "Don’t worry… you’re facing me now."
    Mi "No te preocupes... ahora te enfrentas a mí."

# game/script.rpy:6174

translate spanish endoftheporolgue_7ce3fcd2:
    # Mi "…I don’t have time for you."
    Mi "...No tengo tiempo para ti."

# game/script.rpy:6177

translate spanish endoftheporolgue_56b1b113:
    # h "[mc]…!"
    h "[mc]…!"

# game/script.rpy:6178

translate spanish endoftheporolgue_2f47fd71:
    # h "Hey—!"
    h "¡Oye!"

# game/script.rpy:6180

translate spanish endoftheporolgue_c44180d5:
    # h "Stay with me…"
    h "Quédate conmigo..."

# game/script.rpy:6181

translate spanish endoftheporolgue_17f13727:
    # h "Come on… stay with me."
    h "Vamos... quédate conmigo."

# game/script.rpy:6183

translate spanish endoftheporolgue_8c07114f:
    # aaa "Well?"
    aaa "¿Y bien?"

# game/script.rpy:6184

translate spanish endoftheporolgue_fa396ea3:
    # aaa "What do you see."
    aaa "¿Qué ves?"

# game/script.rpy:6186

translate spanish endoftheporolgue_9c397e3d:
    # Mi "…The lady’s words don’t add up."
    Mi "...Las palabras de la señora no encajan."

# game/script.rpy:6187

translate spanish endoftheporolgue_c2b87514:
    # Mi "The gate… reacted to the boy."
    Mi "La puerta... reaccionó al chico."

# game/script.rpy:6189

translate spanish endoftheporolgue_ef9f9c3a:
    # h "Help’s coming."
    h "La ayuda está llegando."

# game/script.rpy:6190

translate spanish endoftheporolgue_29c67eee:
    # h "You hear me?"
    h "¿Me oyes?"

# game/script.rpy:6191

translate spanish endoftheporolgue_743fa6f5:
    # h "They’re coming— they’ll fix this."
    h "Vienen... van a arreglar esto."

# game/script.rpy:6193

translate spanish endoftheporolgue_9a052dd0:
    # h "You promised me."
    h "Me lo prometiste."

# game/script.rpy:6196

translate spanish endoftheporolgue_2b28c5e6:
    # h "So don’t you dare die on me now."
    h "Así que ni se te ocurra morirte ahora."

# game/script.rpy:6197

translate spanish endoftheporolgue_49f97e85:
    # h "Not like this…"
    h "No así..."

# game/script.rpy:6198

translate spanish endoftheporolgue_c24f3046:
    # h "Not here…"
    h "Aquí no..."

# game/script.rpy:6200

translate spanish endoftheporolgue_d3063e7b:
    # aaa "Take both. The girl doesn’t see the portal."
    aaa "Llévate a los dos. La chica no ve el portal."

# game/script.rpy:6201

translate spanish endoftheporolgue_e078c3c5:
    # aaa "Her mind… won’t survive it."
    aaa "Su mente... no sobrevivirá."

# game/script.rpy:6203

translate spanish endoftheporolgue_de226845:
    # Mi "I’ll secure them… and catch up."
    Mi "Los aseguraré... y los alcanzaré."

# game/script.rpy:6207

translate spanish endoftheporolgue_5c2905ac:
    # aaa "A gate…"
    aaa "Una puerta..."

# game/script.rpy:6208

translate spanish endoftheporolgue_a06789a3:
    # aaa "Time displacement."
    aaa "Desplazamiento temporal."

# game/script.rpy:6210

translate spanish endoftheporolgue_4bf7b0a5:
    # aaa "So this is it."
    aaa "Así que esto es todo."

# game/script.rpy:6211

translate spanish endoftheporolgue_6dad4c95:
    # aaa "The source of the chaos."
    aaa "La fuente del caos."

# game/script.rpy:6219

translate spanish endoftheporolgue_a4ac5554:
    # aaa "…What—"
    aaa "¿Qué?"

# game/script.rpy:6221

translate spanish endoftheporolgue_a90cb9d3:
    # aaa "No…"
    aaa "No..."

# game/script.rpy:6222

translate spanish endoftheporolgue_0203571f:
    # aaa "That presence…"
    aaa "Esa presencia..."

# game/script.rpy:6224

translate spanish endoftheporolgue_c6950a3d:
    # Mi "Master… what’s happening?"
    Mi "Maestro... ¿qué está pasando?"

# game/script.rpy:6227

translate spanish endoftheporolgue_851c9b31:
    # aaa "The boy. The girl."
    aaa "El chico, la chica."

# game/script.rpy:6228

translate spanish endoftheporolgue_7d89ff18:
    # aaa "Take them."
    aaa "Llévenselos."

# game/script.rpy:6229

translate spanish endoftheporolgue_fbd68180:
    # aaa "We leave. Now."
    aaa "Nos vamos. Ahora."

# game/script.rpy:6231

translate spanish endoftheporolgue_62ce2899:
    # Mi "Understood. I’ll handle it."
    Mi "Entendido. Yo me encargo."

# game/script.rpy:6239

translate spanish endoftheporolgue_6d7acdec:
    # Mi "…I’ll take care of it."
    Mi "...Yo me encargo."

# game/script.rpy:6241

translate spanish endoftheporolgue_52d8969d:
    # aaa "This will be enough."
    aaa "Esto será suficiente."

# game/script.rpy:6242

translate spanish endoftheporolgue_e18d8335:
    # aaa "To slow them."
    aaa "Para frenarlos."

# game/script.rpy:6259

translate spanish endoftheporolgue_aaa7ea2f:
    # aaaaa "Steal what is mine… right under my gaze?"
    aaaaa "¿Robar lo que es mío... justo bajo mi mirada?"

# game/script.rpy:6260

translate spanish endoftheporolgue_ce7c6006:
    # aaaaa "...Astoria."
    aaaaa "...Astoria."

# game/script.rpy:6262

translate spanish endoftheporolgue_afd3bff3:
    # aaaaa "Some things… never change."
    aaaaa "Algunas cosas... nunca cambian."

# game/script.rpy:6264

translate spanish endoftheporolgue_d9e7baef:
    # aaaaa "Use their body."
    aaaaa "Usa su cuerpo."

# game/script.rpy:6265

translate spanish endoftheporolgue_05270ce5:
    # aaaaa "We’re going to pay… our old friends a visit."
    aaaaa "Vamos a hacerles una visita... a nuestros viejos amigos."

