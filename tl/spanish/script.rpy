translate spanish war2_2f9028a8:

    # mc "Anything else?"
    mc "¿Algo más?"

# game/script.rpy:793

translate spanish war2_f456a99d:

    # mc "Then we wait."
    mc "Entonces esperamos."

# game/script.rpy:801

translate spanish war2_1f37d416:

    # mc "Eagle-2, this is 6-Bravo. Copy. ETA?"
