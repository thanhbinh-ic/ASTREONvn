translate spanish story05_2_a50b5d91:

    # mc "Alright then. I’ve got a couple questions, and I’d really like some answe-"
    mc "Bien entonces. Tengo un par de preguntas, y me gustaría mucho un poco de answe-"

# game/Story04.rpy:697

translate spanish story05_2_f8f343ef:

    # k "Have you ever died? Physically."
    k "¿Has muerto alguna vez?"

# game/Story04.rpy:698

translate spanish story05_2_2b35b6fe:

    # mc "..."
    mc "..."

# game/Story04.rpy:699

translate spanish story05_2_64b8553a:

    # mc "(That… was unexpected. Where did that even come from?)"
    mc "(Eso... fue inesperado. ¿De dónde vino eso?)"

# game/Story04.rpy:701

translate spanish story05_2_f800bed0:

    # mc "Yes."
    mc "Sí."

# game/Story04.rpy:703

translate spanish story05_2_4bc576b8:

    # k "And how did it feel?"
    k "¿Y cómo se sintió?"

# game/Story04.rpy:705

translate spanish story05_2_1a12f068:

    # mc "Lame. If I can put it like that."
    mc "Si puedo decirlo así."

# game/Story04.rpy:706

translate spanish story05_2_74ccebdc:

    # mc "But… I don’t get the point."
    mc "Pero... no entiendo el punto."

# game/Story04.rpy:707

translate spanish story05_2_1d7a7b22:

    # k "(I don’t even know why I asked that...)"
    k "(Ni siquiera sé por qué le pregunté...)"

# game/Story04.rpy:711

translate spanish story05_2_315f3772:

    # mc "(What the-?!)"
    mc "(¿Qué...?)"

# game/Story04.rpy:715

translate spanish story05_2_5e747d73:

    # k "Good reflexes. Not good enough, though."
    k "No es suficiente."

# game/Story04.rpy:718

translate spanish story05_2_aadd7216:

    # mc "You’re crazy. Why?!"
    mc "Estás loco. ¿Por qué?"

# game/Story04.rpy:721

translate spanish story05_2_b9ee2a94:

    # k "I just wanted to see what you’re capable of."
    k "Solo quería ver de qué eres capaz."

# game/Story04.rpy:722

translate spanish story05_2_bd99d004:

    # mc "We’ve spent enough time together, isn’t that enough?"
    mc "Hemos pasado bastante tiempo juntos, ¿no es suficiente?"

# game/Story04.rpy:723

translate spanish story05_2_c845f493:

    # k "Where we’re going… that place is different."
    k "Donde vamos... ese lugar es diferente."

# game/Story04.rpy:724

translate spanish story05_2_2bdfdd62:

    # k "And honestly... you’re a pretty good toy. I’d rather not lose you."
    k "Y honestamente... eres un juguete bastante bueno. Prefiero no perderte."

# game/Story04.rpy:726

translate spanish story05_2_0c3dad4c:

    # mc "(There’s truth in her words. Besides, a good spar wouldn’t hurt.)"
    mc "(Hay verdad en sus palabras. Además, una buena espátula no dolería.)"

# game/Story04.rpy:727

translate spanish story05_2_9858c291:

    # mc "Don’t regret it later. I’ll be fighting for real."
    mc "No te arrepientas más tarde. Lucharé por lo real."

# game/Story04.rpy:729

translate spanish story05_2_c7a45608:

    # k "Hmph..."
    k "Hmph..."

# game/Story04.rpy:741

translate spanish story05_2_50eeb23f:

    # k "Caught you."
    k "Te he traído."

# game/Story04.rpy:744

translate spanish story05_2_9308e71d:

    # mc "Arkgh..."
    mc "Arkgh..."

# game/Story04.rpy:746

translate spanish story05_2_d77b8b10:

    # k "Is that it? That’s all you’ve got? I expected more."
    k "¿Es eso? Eso es todo lo que tienes? Esperaba más."

# game/Story04.rpy:747

translate spanish story05_2_3ce3fbe1:

    # mc "This definitely isn’t my best performance..."
    mc "Definitivamente no es mi mejor actuación..."

# game/Story04.rpy:748

translate spanish story05_2_38c3917b:

    # k "Old man, you should’ve retired long ago instead of storming towers in this condition."
    k "Viejo, deberías haberte retirado hace mucho tiempo en lugar de tormentas torres en esta condición."

# game/Story04.rpy:750

translate spanish story05_2_7f2db866:

    # mc "I can’t."
    mc "No puedo."

# game/Story04.rpy:751

translate spanish story05_2_816f3626:

    # k "Oh? And why’s that?”"
    k "¿Y por qué es eso?"

# game/Story04.rpy:753

translate spanish story05_2_f2416177:

    # mc "(I’ve gone too far. Too many sacrifices... There’s no way back.)"
    mc "(He ido demasiado lejos. Demasiados sacrificios... No hay manera de volver.)"

# game/Story04.rpy:754

translate spanish story05_2_560ac6e8:

    # mc "(Now.)"
    mc "(Ahora.)"

# game/Story04.rpy:760

translate spanish story05_2_27236b13:

    # k "(Huh? ...Am I looking at the ceiling?)"
    k "¿Estoy mirando el techo?"

# game/Story04.rpy:763

translate spanish story05_2_75c26826:

    # k "(And now I’m on the floor...)"
    k "(Y ahora estoy en el suelo...)"

# game/Story04.rpy:768

translate spanish story05_2_5cc5e72d:

    # mc "Because I made a promise."
    mc "Porque hice una promesa."

# game/Story04.rpy:771

translate spanish story05_2_c14daa04:

    # mc "A promise that I’d do everything in my power to stop this apocalypse."
    mc "Una promesa de que haría todo lo que estuviera en mi poder para detener este apocalipsis."

# game/Story04.rpy:773

translate spanish story05_2_e8259e98:

    # mc "Yeah, compared to you and everyone else, I’ve got no strength. Just a dumb old man who wagered everything and lost."
    mc "Sí, comparado con ustedes y con todos los demás, no tengo fuerza. Solo un viejo tonto que lo apostó todo y perdió."

# game/Story04.rpy:775

translate spanish story05_2_5730f9cd:

    # mc "And still, as long as I’m breathing, I’ll keep trying."
    mc "Y aún así, mientras yo esté respirando, seguiré intentándolo."

# game/Story04.rpy:777

translate spanish story05_2_f5c90f21:

    # k "(The toy’s really going wild. Then again... isn’t that why he’s always fun?)"
    k "(El juguete está realmente enloqueciendo. Entonces otra vez... ¿no es por eso que siempre es divertido?)"

# game/Story04.rpy:778

translate spanish story05_2_282fefb9:

    # k "(Fun...)"
    k "(Fun...)"

# game/Story04.rpy:781

translate spanish story05_2_0bf6473f:

    # k "When I first met you, that’s exactly what you looked like. Unremarkable. Weak. A stupid old man."
    k "Cuando te conocí por primera vez, eso es exactamente lo que parecías. Inremarcable. Debil. Un viejo estúpido."

# game/Story04.rpy:782

translate spanish story05_2_f02e9718:

    # k "I could’ve killed you at any moment."
    k "Podría haberte matado en cualquier momento."

# game/Story04.rpy:784

translate spanish story05_2_e35c7818:

    # mc "But you didn’t kill me. Why? Because of Astoria?"
    mc "Pero no me mataste. ¿Por qué? ¿Por Astoria?"

# game/Story04.rpy:789

translate spanish story05_2_85349341:

    # k "Because of myself."
    k "Por mi misma."

# game/Story04.rpy:790

translate spanish story05_2_f76f7330:

    # k "In you, I saw a part of myself. One I thought I’d lost a long time ago."
    k "En ti, vi una parte de mí mismo. Una pensé que había perdido hace mucho tiempo."

# game/Story04.rpy:793

translate spanish story05_2_9e609435:

    # k "(That’s when I got curious... what kind of feeling crawled back into my chest.)"
    k "(Es ahí cuando me curiosa... qué tipo de sentimiento me arrastraba de nuevo en el pecho.)"

# game/Story04.rpy:795

translate spanish story05_2_7fd3923e:

    # k "(Painfully familiar. Disgusting.)"
    k "(Painamente familiar. Es repugnante.)"

# game/Story04.rpy:796

translate spanish story05_2_58d1e296:

    # k "(Attachment.)"
    k "(Asociación)"

# game/Story04.rpy:799

translate spanish story05_2_806ba2f9:

    # k "Looks like someone got a little too excited. Your little friend’s practically poking at me."
    k "Parece que alguien se puso demasiado emocionado. Tu amiguito prácticamente me está acosando."

# game/Story04.rpy:801

translate spanish story05_2_bf781fed:

    # mc "What are yo-"
    mc "¿Qué es...?"

# game/Story04.rpy:805

translate spanish story05_2_7dba3ccb:

    # mc "(Dirty move...)"
    mc "(Movimiento sucio...)"

# game/Story04.rpy:806

translate spanish story05_2_d9d6d038:

    # mc "Cheap."
    mc "Barato."

# game/Story04.rpy:807

translate spanish story05_2_7e90da36:

    # k "Oops. Did I hurt your ego?"
    k "¿Te he hecho daño a tu ego?"

# game/Story04.rpy:810

translate spanish story05_2_5c54a2b3:

    # mc "(She’s insane, that’s a fact. Crazier than anyone I’ve ever met… but even she-)"
    mc "(Es una locura, eso es un hecho. Más loco que nadie que haya conocido... pero incluso ella-)"

# game/Story04.rpy:811

translate spanish story05_2_4ac932fd:

    # mc "Attachment, huh."
    mc "Atajo, eh."

# game/Story04.rpy:813

translate spanish story05_2_064c04f4:

    # k "You heard that? Thought I’d disabled that implant."
    k "¿Escuchaste eso? Pensé que había desactivado ese implante."

# game/Story04.rpy:814

translate spanish story05_2_dc0ff26a:

    # mc "Sorry."
    mc "Lo siento."

# game/Story04.rpy:816

translate spanish story05_2_b7987f4c:

    # mc "How did you end up in the Inquisition?"
    mc "¿Cómo terminaste en la Inquisición?"

# game/Story04.rpy:818

translate spanish story05_2_a1bef0c8:

    # k "I don’t see the point in answering. And besides… it’s a boring story."
    k "No veo el punto en responder. Y además... es una historia aburrida."

# game/Story04.rpy:819

translate spanish story05_2_49f62458:

    # mc "Boring? And how many people have you told it to?”"
    mc "¿Y a cuánta gente se lo has dicho?"

# game/Story04.rpy:820

translate spanish story05_2_ae84fca0:

    # mc "You just never found someone who’d appreciate it."
    mc "Nunca encontraste a alguien que lo apreciaría."

# game/Story04.rpy:823

translate spanish story05_2_cc68a856:

    # k "Eow... Did I seriously damage something when I hit you?"
    k "¿Hice daño en serio cuando te golpeé?"

# game/Story04.rpy:825

translate spanish story05_2_db2bf8a2:

    # mc "Oh, go to he-"
    mc "Oh, ve a él..."

# game/Story04.rpy:828

translate spanish story05_2_2ea0f582:

    # k "Get up, old man."
    k "Levántate, viejo."

# game/Story04.rpy:832

translate spanish story05_2_e83c20ce:

    # k "So you do want to hear how I ended up in the Inquisition, huh?"
    k "Así que quieres saber cómo terminé en la Inquisición, ¿eh?"

# game/Story04.rpy:834

translate spanish story05_2_bf8d7b32:

    # mc "It would be useful. You’re the one I know the least here."
    mc "Sería útil. Tú eres el que conozco lo menos aquí."

# game/Story04.rpy:835

translate spanish story05_2_ee110046:

    # mc "Paired with that loudmouth you call a sister."
    mc "En pareja con esa boca alta que llamas hermana."

# game/Story04.rpy:838

translate spanish story05_2_58c21a17:

    # k "And why exactly are you so interested in my past?"
    k "¿Y por qué estás tan interesado en mi pasado?"

# game/Story04.rpy:840

translate spanish story05_2_0b15ac36:

    # mc "Tradition in our squad. You share your story, we repay you with a couple jokes and saving your ass."
    mc "La tradición en nuestro equipo, compartes tu historia, te recompensamos con un par de chistes y te salvamos el culo."

# game/Story04.rpy:842

translate spanish story05_2_343f1cd0:

    # k "Does that mean I’ll have to sit through your tear-soaked life story too?"
    k "¿Eso significa que tendré que sentarme a través de tu historia de vida empapada también?"

# game/Story04.rpy:844

translate spanish story05_2_09dfd8d2:

    # mc "Unfortunately, yes."
    mc "Por desgracia, sí."

# game/Story04.rpy:854

translate spanish story05_2_957ded91:

    # k "Boring… But fine."
    k "Aburrido... pero bien."

# game/Story04.rpy:858

translate spanish story05_2_0adf8cfa:

    # k "So. Where do I start?"
    k "Entonces. ¿Dónde empiezo?"

# game/Story04.rpy:864

translate spanish story05_2_216b38d0:

    # k "(You know, the place where I grew up... some would’ve called it hell.)"
    k "(Sabes, el lugar donde crecí... algunos lo habrían llamado infierno.)"

# game/Story04.rpy:865

translate spanish story05_2_d9889fba:

    # k "(An orphanage where the strong did whatever they wanted, and the weak only learned how to obey."
    k "(Un orfanato donde los fuertes hicieron lo que querían, y los débiles solo aprendieron a obedecer."

# game/Story04.rpy:866

translate spanish story05_2_0c2389ae:

    # k "(We weren’t an exception.)"
    k "(No éramos una excepción.)"

# game/Story04.rpy:867

translate spanish story05_2_59c48c55:

    # k "(Me, and the one who now walks right behind your dear wife, Veyra.)"
    k "(Yo, y el que ahora camina detrás de tu querida esposa, Veyra.)"

# game/Story04.rpy:870

translate spanish story05_2_d6b5b9f5:

    # v "You never stop surprising me. I honestly thought you’d go beat up those idiots from the next class again today."
    v "Nunca dejas de sorprenderme. Sinceramente pensé que irías a golpear a esos idiotas de la próxima clase hoy de nuevo."

# game/Story04.rpy:871

translate spanish story05_2_f3417768:

    # v "Though I have to admit, your ridiculous reputation finally started working in your favor."
    v "Aunque tengo que admitir, tu ridícula reputación finalmente comenzó a trabajar a tu favor."

# game/Story04.rpy:874

translate spanish story05_2_1d19208d:

    # k "Yeah, yeah, about those big-headed idiots. Did they start bothering you again?"
    k "Sí, sí, sobre esos idiotas de cabeza grande. ¿Te molestaron de nuevo?"

# game/Story04.rpy:875

translate spanish story05_2_7fdfc7e0:

    # v "They wanted a rematch. You really did a number on their fragile egos."
    v "Querían una revancha, realmente hiciste un número en sus frágiles egos."

# game/Story04.rpy:876

translate spanish story05_2_8bec4f52:

    # k "They got off easy with me."
    k "Se fueron de forma fácil conmigo."

# game/Story04.rpy:879

translate spanish story05_2_53204b78:

    # v "I already told them that. Can’t say it stopped them."
    v "Ya les dije eso. No puedo decir que los detuvo."

# game/Story04.rpy:882

translate spanish story05_2_7c08dcc3:

    # k "Should’ve broken more fingers..."
    k "Debería haber roto más dedos..."

# game/Story04.rpy:883

translate spanish story05_2_955e8a04:

    # k "(But in practice, most people were too scared to touch us. And the ones who tried… ended very, very badly.)"
    k "(Pero en la práctica, la mayoría de la gente estaba demasiado asustada para tocarnos. Y los que intentaron... terminaron muy, muy mal.)"

# game/Story04.rpy:884

translate spanish story05_2_2b35b6fe_1:

    # mc "..."
    mc "..."

# game/Story04.rpy:887

translate spanish story05_2_86c7fac2:

    # k "Usually this is where people start squirming. You’re taking it surprisingly calm."
    k "Normalmente aquí es donde la gente comienza a rebuscar. Lo estás tomando sorprendentemente calma."

# game/Story04.rpy:889

translate spanish story05_2_62435bf6:

    # mc "I’ve seen worse sights."
    mc "He visto peores vistas."

# game/Story04.rpy:894

translate spanish story05_2_61bb1d32:

    # v "You’re seriously unhinged, you know that?"
    v "Estás muy desahogado, ¿lo sabes?"

# game/Story04.rpy:895

translate spanish story05_2_8a9da599:

    # k "I knew you’d like it."
    k "Sabía que te gustaría."

# game/Story04.rpy:896

translate spanish story05_2_12c11497:

    # k "(Cruel? Don’t care. What mattered was that it worked. And most of the time, no one touched us.)"
    k "(Cruel? No importa. Lo que importaba era que funcionaba. Y la mayor parte del tiempo, nadie nos tocó.)"

# game/Story04.rpy:898

translate spanish story05_2_ad544c72:

    # a "Silence."
    a "Silencio."

# game/Story04.rpy:899

translate spanish story05_2_2826ca76:

    # k "(From a very young age, we were taught a few simple things. Strength and dominance over your enemy, lead to victory.)"
    k "(De una edad muy joven, nos enseñaron algunas cosas simples. Fuerza y dominio sobre su enemigo, conducen a la victoria.)"

# game/Story04.rpy:900

translate spanish story05_2_9024f98d:

    # k "(And the second one.)"
    k "(Y el segundo)."

# game/Story04.rpy:902

translate spanish story05_2_8b6ed410:

    # a "An order is absolute. And our purpose is to see it carried out."
    a "Un orden es absoluto, y nuestro propósito es verlo realizado."

# game/Story04.rpy:903

translate spanish story05_2_401f3fd5:

    # k "(Every lecture started with that phrase. They drilled it into our heads our whole lives.)"
    k "(Cada conferencia comenzó con esa frase. Ellos la perforaron en nuestras cabezas toda nuestra vida.)"

# game/Story04.rpy:904

translate spanish story05_2_52f5e71b:

    # k "(Soulless. No creativity. No freedom.)"
    k "(Insólito. Sin creatividad. Sin libertad.)"

# game/Story04.rpy:906

translate spanish story05_2_fcf7e6fc:

    # k "(Just like the rest of the training. We were being prepared as cannon fodder.)"
    k "(Al igual que el resto del entrenamiento, estábamos siendo preparados como forraje de cañón)."

# game/Story04.rpy:907

translate spanish story05_2_25f14d50:

    # k "(Oh right, “peacekeepers.” I always forget that part.)"
    k "(Oh, cierto, “pacíficos”. Siempre olvido esa parte.)"

# game/Story04.rpy:909

translate spanish story05_2_0458f6e3:

    # k "(And among all the others… I was-)"
    k "(Y entre todos los demás... yo estaba...)"

# game/Story04.rpy:918

translate spanish story05_2_f6894116:

    # k "(I was the worst of the worst. Aside from minor scuffles, I was only good at two things.)"
    k "(Yo era lo peor de lo peor. Aparte de pequeñas peleas, solo era buena en dos cosas.)"

# game/Story04.rpy:919

translate spanish story05_2_57782e05:

    # k "(Talking. And shattering expectations.)"
    k "Y destrozar las expectativas."

# game/Story04.rpy:920

translate spanish story05_2_2185c95b:

    # v "You’re getting worse every time."
    v "Cada vez estás empeorando."

# game/Story04.rpy:921

translate spanish story05_2_80ad726f:

    # k "Love you too, sis."
    k "También te quiero, hermana."

# game/Story04.rpy:922

translate spanish story05_2_22b60b5e:

    # k "Still, my heart was always set on something else."
    k "Pero mi corazón siempre estaba puesto en otra cosa."

# game/Story04.rpy:924

translate spanish story05_2_a78a429d:

    # k "(Becoming an actress. Ironic, isn’t it?)"
    k "(Se convierte en actriz. Irónico, ¿no?)"

# game/Story04.rpy:925

translate spanish story05_2_18041114:

    # k "(Born for creation. Sentenced to violence.)"
    k "(Born for creation. Sentenced to violence.)"

# game/Story04.rpy:926

translate spanish story05_2_cb6120e7:

    # k "(I spent almost all my free time rehearsing in one of the art bars near the campus.)"
    k "(Pasé casi todo mi tiempo libre ensayando en una de las barras de arte cerca del campus)."

# game/Story04.rpy:928

translate spanish story05_2_0295c82a:

    # k "(It helped during stress. Or when I was bored. That’s when I actually felt alive.)"
    k "(Ayudé durante el estrés. O cuando estaba aburrido. Eso es cuando me sentí vivo.)"

# game/Story04.rpy:929

translate spanish story05_2_07893017:

    # k "(That happiness didn’t last long.)"
    k "(Esa felicidad no duró mucho tiempo.)"

# game/Story04.rpy:932

translate spanish story05_2_6e17058b:

    # a "It doesn’t matter who you are, or what you hoped to become. In the face of a threat, everyone is equal. Life is short. Death is inevitable. That’s a fact."
    a "No importa quién eres, o qué esperabas convertirte. Frente a una amenaza, todo el mundo es igual. La vida es corta. La muerte es inevitable. Eso es un hecho."

# game/Story04.rpy:933

translate spanish story05_2_2a58135a:

    # a "But there is one thing we {b}can{/b} control - the meaning of our actions."
    a "Pero hay una cosa que nosotros {b}puede{/b} control - el significado de nuestras acciones."

# game/Story04.rpy:934

translate spanish story05_2_21ff4cef:

    # a "The lives of our fallen were not wasted. We give their deaths meaning."
    a "Las vidas de nuestros caídos no fueron desperdiciadas, sino que les damos sentido a sus muertes."

# game/Story04.rpy:936

translate spanish story05_2_e03e88bc:

    # a "And we will do the same for ourselves."
    a "Y haremos lo mismo por nosotros mismos."

# game/Story04.rpy:937

translate spanish story05_2_dc1d646e:

    # a "Will we die? Maybe."
    a "¿Vamos a morir?"

# game/Story04.rpy:939

translate spanish story05_2_7fae70dc:

    # a "But if we fall, we will leave a mark, one future generations will turn into a lesson, and into strength."
    a "Pero si caemos, dejaremos una marca, una generación futura se convertirá en una lección y en fuerza."

# game/Story04.rpy:940

translate spanish story05_2_1508fde6:

    # a "So stop hesitating. Move. Fight with resolve."
    a "Así que deja de dudar, muévete, lucha con determinación."

# game/Story04.rpy:942

translate spanish story05_2_8b22e3b7:

    # a "Show the enemy we do not bow to fear. Fight so the world knows this: we are here, and we prevail."
    a "Muestre al enemigo que no nos inclinamos al miedo. Luchar para que el mundo sepa esto: estamos aquí, y prevalecemos."

# game/Story04.rpy:944

translate spanish story05_2_90058651:

    # k "(Our commander knew how to speak. For us, she became something like a mother, one we never asked for, but desperately needed.)"
    k "(Nuestro comandante sabía cómo hablar. Para nosotros, se convirtió en algo como una madre, una que nunca pedimos, pero desesperadamente necesitado.)"

# game/Story04.rpy:945

translate spanish story05_2_14d77ecb:

    # k "(That day, though... was when I first met what others called war.)"
    k "(Ese día, sin embargo... fue cuando conocí por primera vez lo que otros llamaron guerra.)"

# game/Story04.rpy:952

translate spanish story05_2_5037d4aa:

    # k "(Total shock. Bang!)"
    k "(Total shock. Bang!)"

# game/Story04.rpy:954

translate spanish story05_2_74937961:

    # k "(I just stood there, terrified, watching someone I’d studied with for half my life fall to the ground with a hole in their head.)"
    k "(Me quedé allí, aterrorizado, viendo a alguien con quien había estudiado durante la mitad de mi vida caer al suelo con un agujero en su cabeza.)"

# game/Story04.rpy:958

translate spanish story05_2_5cd08c6f:

    # k "(I would’ve been next, if not for the commander.)"
    k "(Yo habría sido el siguiente, si no para el comandante.)"

# game/Story04.rpy:959

translate spanish story05_2_24ee3a88:

    # a "What the hell are you doing?! Get a grip!"
    a "¡Agarren!"

# game/Story04.rpy:962

translate spanish story05_2_488dcddc:

    # k "(I didn’t even hear her back then. My head was full of something else.)"
    k "(Ni siquiera la oí en aquel entonces. Mi cabeza estaba llena de algo más.)"

# game/Story04.rpy:963

translate spanish story05_2_68f6d51e:

    # k "(That was the first time I truly felt fear.)"
    k "(Esa fue la primera vez que sentí miedo.)"

# game/Story04.rpy:965

translate spanish story05_2_d1c610d3:

    # k "(And the funniest part? When I saw his corpse, I just pissed myself. Hilarious, right?)"
    k "Cuando vi su cadáver, me enojé."

# game/Story04.rpy:966

translate spanish story05_2_75da4cd1:

    # k "(Like that was all I was good for.)"
    k "(Como si fuera todo lo que era bueno para.)"

# game/Story04.rpy:970

translate spanish story05_2_43a1d18a:

    # k "You could at least flinch, for appearances’ sake. Most people are already running out of the room at this point."
    k "Al menos podrías hacer flinch, por el bien de las apariencias. La mayoría de la gente ya está saliendo de la habitación en este punto."

# game/Story04.rpy:972

translate spanish story05_2_909e0dbd:

    # mc "All I’m seeing right now is a broken kid. Nothing more."
    mc "Todo lo que estoy viendo ahora es un chico roto. Nada más."

# game/Story04.rpy:974

translate spanish story05_2_82091822:

    # k "..."
    k "..."

# game/Story04.rpy:976

translate spanish story05_2_7eb3bbd5:

    # k "Yeah. Sure. Whatever you say."
    k "Sí, claro, lo que tú digas."

# game/Story04.rpy:977

translate spanish story05_2_8e44ea45:

    # k "Keep your concern to yourself, I’m doing just fine without it."
    k "Mantenga su preocupación para usted mismo, estoy haciendo bien sin ella."

# game/Story04.rpy:980

translate spanish story05_2_1c4c0849:

    # k "(Truth is, after that moment I couldn’t eat properly for a whole week.)"
    k "(La verdad es que, después de ese momento no podía comer correctamente durante toda una semana.)"

# game/Story04.rpy:981

translate spanish story05_2_be5c86c9:

    # k "(Every time a steak hit the table, I saw guts.)"
    k "(Cada vez que un filete golpeó la mesa, vi las tripas.)"

# game/Story04.rpy:983

translate spanish story05_2_7f9f6449:

    # k "(And that’s really not what you want on your mind while eating.)"
    k "(Y eso no es realmente lo que quieres en tu mente mientras comes.)"

# game/Story04.rpy:989

translate spanish story05_2_89e53b71:

    # v "Kali?! Again?!"
    v "¿Kali?"

# game/Story04.rpy:990

translate spanish story05_2_7d9fc4ec:

    # k "(In one week, I even managed to drop two kilos. Impressive, right?)"
    k "(En una semana, incluso logré caer dos kilos. Impresionante, ¿verdad?)"

# game/Story04.rpy:992

translate spanish story05_2_e72f83e6:

    # k "Sorry, sis. Not the prettiest thing to watch."
    k "Lo siento, hermana, no es lo más bonito que hay que ver."

# game/Story04.rpy:994

translate spanish story05_2_ef6d034e:

    # v "Yeah. True."
    v "Sí, cierto."

# game/Story04.rpy:998

translate spanish story05_2_57bd49dd:

    # v "Hey… you okay?"
    v "Oye... ¿estás bien?"

# game/Story04.rpy:1000

translate spanish story05_2_63bf224a:

    # k "I’m perfectly fi-!"
    k "¡Soy perfectamente fi-!"

# game/Story04.rpy:1003

translate spanish story05_2_884cf08b:

    # k "Bleeegh-"
    k "Bleeegh..."

# game/Story04.rpy:1004

translate spanish story05_2_6a6eb034:

    # k "(Yeah… I’ve been better.)"
    k "(Sí... he estado mejor.)"

# game/Story04.rpy:1015

translate spanish story05_2_f5fac18c:

    # v "You know shooting really isn’t your thing. Maybe you should try something else?"
    v "Sabes que disparar no es lo tuyo. ¿Quizá deberías probar otra cosa?"

# game/Story04.rpy:1017

translate spanish story05_2_dc2a618c:

    # k "Easy for you to say. Best shot in the academy and all…"
    k "Es fácil decirlo, mejor tiro en la academia y todo..."

# game/Story04.rpy:1019

translate spanish story05_2_97744a28:

    # v "Well, unlike someone, my hands actually grow from the right place."
    v "Bueno, a diferencia de alguien, mis manos crecen en realidad desde el lugar correcto."

# game/Story04.rpy:1023

translate spanish story05_2_e59a85bd:

    # k "Next time someone comes to ‘settle things’ with you, don’t drag me to the shooting range."
    k "La próxima vez que alguien venga a \"arreglar las cosas\" contigo, no me arrastres al campo de tiro."

# game/Story04.rpy:1024

translate spanish story05_2_5327e76c:

    # v "Hey, hey, that’s against the rules."
    v "Oye, oye, eso es contra las reglas."

# game/Story04.rpy:1027

translate spanish story05_2_eb8a11ef:

    # k "And who said I’d play by them?"
    k "¿Y quién dijo que jugaría con ellos?"

# game/Story04.rpy:1029

translate spanish story05_2_611b21a7:

    # v "Oh, you just wait. I’m definitely getting back at you for that."
    v "Oh, solo espera. Definitivamente estoy volviendo a ti para eso."

# game/Story04.rpy:1031

translate spanish story05_2_994c13e6:

    # v "Another duel?"
    v "¿Otro duelo?"

# game/Story04.rpy:1034

translate spanish story05_2_c81bb574:

    # k "(We were inseparable back then. Had each other’s backs however we could. Honestly, not much has changed.)"
    k "(En aquel entonces éramos inseparables. Teníamos la espalda de los demás, sin embargo podríamos. Honestamente, no mucho ha cambiado.)"

# game/Story04.rpy:1035

translate spanish story05_2_b4e55bab:

    # k "(Except she used to be a lot more talkative.)"
    k "(Excepto que solía ser mucho más habladora.)"

# game/Story04.rpy:1040

translate spanish story05_2_347dabe8:

    # a "Kalestra Elverin Ord’Laria. A word."
    a "Calestra Elverine Ord'Laria, una palabra."

# game/Story04.rpy:1042

translate spanish story05_2_83c51b56:

    # k "(whispering) By my full name? Yeah… this won’t end well. I can feel it."
    k "Sí... esto no terminará bien. Puedo sentirlo."

# game/Story04.rpy:1043

translate spanish story05_2_4b2e00d5:

    # v "(whispering) What did you do this time?"
    v "¿Qué hiciste esta vez?"

# game/Story04.rpy:1044

translate spanish story05_2_bf7be01b:

    # k "(whispering) I didn’t do anything… at least, not this time."
    k "(susurando) No hice nada... al menos, no esta vez."

# game/Story04.rpy:1046

translate spanish story05_2_6e83b043:

    # a "This is about your future training."
    a "Esto es sobre tu entrenamiento futuro."

# game/Story04.rpy:1049

translate spanish story05_2_850ef128:

    # b "..."
    "{color=#ff8899}Ambos{/color}" "..."

# game/Story04.rpy:1052

translate spanish story05_2_a71bf4d4:

    # k "(That moment probably became the one that turned my whole life upside down.)"
    k "(Ese momento probablemente se convirtió en el que cambió toda mi vida al revés.)"

# game/Story04.rpy:1055

translate spanish story05_2_6c80b5ec:

    # k "So why exactly did you drag me out here in this shit, this gray weather?"
    k "¿Por qué me arrastraste aquí con esta mierda, con este clima gris?"

# game/Story04.rpy:1059

translate spanish story05_2_022642b5:

    # a "Answer me this. What is a warrior’s most important trait?"
    a "Respóndeme esto. ¿Cuál es el rasgo más importante de un guerrero?"

# game/Story04.rpy:1062

translate spanish story05_2_8a6e09dd:

    # k "Sorry? A warrior’s quality? Is this some kind of philosophical question or what?"
    k "¿Lo sentimos? ¿La calidad de un guerrero? ¿Es una cuestión filosófica o qué?"

# game/Story04.rpy:1064

translate spanish story05_2_da246c1b:

    # a "Just answer."
    a "Solo responde."

# game/Story04.rpy:1066

translate spanish story05_2_7c971390:

    # k "Devotion to the cause. That’s what you taught us, isn’t it?"
    k "Devoción a la causa. Eso es lo que nos enseñaste, ¿no?"

# game/Story04.rpy:1068

translate spanish story05_2_bb8e4b4e:

    # a "..."
    a "..."

# game/Story04.rpy:1069

translate spanish story05_2_ce30ec0a:

    # k "(Honestly, I have no idea what she was thinking back then, but her look said enough.)"
    k "(Honestamente, no tengo idea de lo que estaba pensando entonces, pero su aspecto dijo lo suficiente.)"

# game/Story04.rpy:1072

translate spanish story05_2_748920eb:

    # a "Let me give you some advice."
    a "Déjame darte un consejo."

# game/Story04.rpy:1075

translate spanish story05_2_b4334c52:

    # a "Leave the Peacekeepers."
    a "Dejen a los Pacificadores."

# game/Story04.rpy:1076

translate spanish story05_2_a2fadd0c:

    # k "(At the time, I actually thought she was joking.)"
    k "(En ese momento, de hecho pensé que estaba bromeando.)"

# game/Story04.rpy:1079

translate spanish story05_2_587a8f4d:

    # k "I-I... This is a joke, right? You’re joking?"
    k "Es una broma, ¿verdad?"

# game/Story04.rpy:1080

translate spanish story05_2_2d223903:

    # k "I’ve spent my whole life on th-"
    k "He pasado toda mi vida en..."

# game/Story04.rpy:1083

translate spanish story05_2_b489fc5f:

    # a "You’re the worst of them all. You cause problems, you’re lazy, incompetent, and you put everyone else at risk."
    a "Usted es el peor de todos ellos. Usted causa problemas, usted es perezoso, incompetente, y usted pone a todos los demás en riesgo."

# game/Story04.rpy:1084

translate spanish story05_2_0de4faee:

    # a "There is nothing in you that belongs in a real warrior."
    a "No hay nada en ti que pertenezca a un verdadero guerrero."

# game/Story04.rpy:1086

translate spanish story05_2_82091822_1:

    # k "..."
    k "..."

# game/Story04.rpy:1087

translate spanish story05_2_4859eade:

    # k "(Her words... That was when I learned words can cut deeper than steel.)"
    k "(Sus palabras... eso fue cuando aprendí que las palabras pueden cortar más profundo que el acero.)"

# game/Story04.rpy:1088

translate spanish story05_2_f7ee7f68:

    # a "This isn’t for you."
    a "Esto no es para ti."

# game/Story04.rpy:1092

translate spanish story05_2_b271498a:

    # a "Do what you’re actually good at. Good luck."
    a "Haz lo que eres realmente bueno. Buena suerte."

# game/Story04.rpy:1093

translate spanish story05_2_acd250aa:

    # k "(I was shattered. Completely.)"
    k "(Me destrozaron. Completamente.)"

# game/Story04.rpy:1095

translate spanish story05_2_be515b4c:

    # k "(Funny, isn’t it? I was against the idea of becoming one of them, but something inside me just... clicked.)"
    k "(Funny, ¿no es así? Estaba en contra de la idea de convertirme en uno de ellos, pero algo dentro de mí simplemente... hizo clic.)"

# game/Story04.rpy:1097

translate spanish story05_2_03a0f89e:

    # k "(I kept thinking: how dare they? I can’t stand it when someone decides my fate for me.)"
    k "(Seguí pensando: ¿cómo se atreven? No puedo soportarlo cuando alguien decide mi destino por mí.)"

# game/Story04.rpy:1099

translate spanish story05_2_ba1d9209:

    # k "(That’s when I decided to go all in. To put everything I had on the line.)"
    k "(Es ahí cuando decidí entrar a todos. Para poner todo lo que tenía en la línea.)"

# game/Story04.rpy:1103

translate spanish story05_2_ff5e4bf6:

    # k "Please... Give me one last chance!"
    k "Por favor... ¡Dame una última oportunidad!"

# game/Story04.rpy:1104

translate spanish story05_2_c56f65e7:

    # k "(I dropped to my knees and screamed it across the whole street. God, the shame... I wouldn’t wish that on anyone.)"
    k "(Me caí de rodillas y lo grité por toda la calle. Dios, la vergüenza... no desearía eso en nadie.)"

# game/Story04.rpy:1106

translate spanish story05_2_0f16d65f:

    # k "(But the need to prove I was worth something outweighed my pride.)"
    k "(Pero la necesidad de probar que valía algo superó mi orgullo.)"

# game/Story04.rpy:1107

translate spanish story05_2_a87160d2:

    # k "(Still, most of that was on the commander. One word from her, and my future was decided.)"
    k "(Sin embargo, la mayoría de eso estaba en el comandante. Una palabra de ella, y mi futuro fue decidido.)"

# game/Story04.rpy:1110

translate spanish story05_2_32f79864:

    # k "(And now the important part, how the hell I ended up in the Inquisition. The selection process was... weird, honestly.)"
    k "(Y ahora la parte importante, cómo diablos terminé en la Inquisición. El proceso de selección fue... raro, honestamente.)"

# game/Story04.rpy:1111

translate spanish story05_2_c74b6353:

    # k "(First, you go into the peacekeepers. And after that, that’s it. Do whatever you want. Go wherever. Nobody gives a damn.)"
    k "(Primero, entras en los guardianes de la paz. Y después de eso, eso es todo. Haz lo que quieras. Ve donde sea. Nadie da un bledo.)"

# game/Story04.rpy:1112

translate spanish story05_2_3a95e1b4:

    # mc "So then, how did you end up there?"
    mc "Entonces, ¿cómo terminaste ahí arriba?"

# game/Story04.rpy:1115

translate spanish story05_2_51235383:

    # k "(Honestly? No idea. They said there was a selection, but how or by what criteria, nobody ever really knew.)"
    k "(Honestamente? No hay idea. Dijeron que había una selección, pero cómo o por qué criterios, nadie realmente sabía.)"

# game/Story04.rpy:1116

translate spanish story05_2_ca576ef1:

    # k "(But that’s for later. Right now, I was just patching up my reputation.)"
    k "(Pero eso es para más tarde. En este momento, estaba repasando mi reputación.)"

# game/Story04.rpy:1117

translate spanish story05_2_0c3ada23:

    # k "(Got my shit together back then. More or less. Some results showed up.)"
    k "(Atrapa mi mierda juntos en ese entonces. Más o menos. Algunos resultados aparecieron.)"

# game/Story04.rpy:1118

translate spanish story05_2_33eaa0db:

    # k "(Except shooting. At that, I still sucked.)"
    k "(Disparos de excepto. En eso, todavía succioné.)"

# game/Story04.rpy:1120

translate spanish story05_2_5dc100a9:

    # k "(So our commander decided to teach me something else.)"
    k "(Entonces nuestro comandante decidió enseñarme algo más.)"

# game/Story04.rpy:1122

translate spanish story05_2_b848c535:

    # k "So. Why are we here?"
    k "Entonces. ¿Por qué estamos aquí?"

# game/Story04.rpy:1123

translate spanish story05_2_453c35c6:

    # a "I’ve been ordered to train you in close combat."
    a "Me han ordenado entrenar en combate cercano."

# game/Story04.rpy:1127

translate spanish story05_2_4e207aa8:

    # k "Close combat? Right. So, death then. Well… doesn’t sound too bad."
    k "¿Un combate cercano? Así que, la muerte entonces. Bueno... no suena muy mal."

# game/Story04.rpy:1128

translate spanish story05_2_1a11e8f5:

    # a "Catch."
    a "Atrapado."

# game/Story04.rpy:1131

translate spanish story05_2_dc651647:

    # k "(Funny thing, that “small blade” she handed me felt like it weighed forty sbards.)"
    k "(Lo más soleado, esa \"pequeña espada\" me entregó sentía como si pesara cuarenta barras.)"

# game/Story04.rpy:1132

translate spanish story05_2_7470d495:

    # k "(I remember thinking: how the hell am I supposed to fight with this club if I can’t even lift it?)"
    k "(Recuerdo pensar: ¿cómo diablos se supone que debo luchar con este club si ni siquiera puedo levantarlo?)"

# game/Story04.rpy:1135

translate spanish story05_2_eb1abd5e:

    # k "(Didn’t have a choice though. I had to lift it somehow. Pain, tears, sheer stubborn will, and somehow, I did.)"
    k "(No tenía elección, sin embargo. Tuve que levantarlo de alguna manera. Dolor, lágrimas, testarudo testarudo, y de alguna manera, lo hice)."

# game/Story04.rpy:1136

translate spanish story05_2_6b760e3d:

    # k "(And then training. Lots of training. Way too much.)"
    k "(Y luego entrenando. Mucho entrenamiento."

# game/Story04.rpy:1138

translate spanish story05_2_dfa208af:

    # k "(Oh, and trust me, I regretted every damn minute of that decision. But my glorious ego...)"
    k "(Oh, y créeme, me arrepentí cada maldito minuto de esa decisión, pero mi glorioso ego...)"

# game/Story04.rpy:1140

translate spanish story05_2_454d6fef:

    # k "(The idea that the commander herself was training me, that alone gave me fuel. And barely, just barely…)"
    k "(La idea de que el comandante mismo me entrenaba, que solo me daba combustible."

# game/Story04.rpy:1143

translate spanish story05_2_789c32ef:

    # k "(I failed.)"
    k "(Fructué.)"

# game/Story04.rpy:1144

translate spanish story05_2_74f98914:

    # k "(I had no talent. None at all. Well... okay. Some tiny bit. But nowhere near enough.)"
    k "No tenía talento, nada, bueno, está bien, un poco pequeño, pero no lo suficiente."

# game/Story04.rpy:1145

translate spanish story05_2_a3002d0a:

    # k "(Nowhere near enough to be the best of the best.)"
    k "(No hay lugar lo suficientemente cerca como para ser el mejor de los mejores.)"

# game/Story04.rpy:1146

translate spanish story05_2_f4ca2b57:

    # mc "And yet somehow, you still managed to pull it off."
    mc "Y de alguna manera, todavía lograste sacarlo."

# game/Story04.rpy:1149

translate spanish story05_2_188734e3:

    # k "Yeah. But not alone. If I’m being honest, I’d have quit a long time ago by myself."
    k "Sí. Pero no solo. Si yo fuera honesto, habría renunciado hace mucho tiempo por mí mismo."

# game/Story04.rpy:1150

translate spanish story05_2_48705489:

    # k "(But with her faith in me, that was a different story.)"
    k "(Pero con su fe en mí, esa era una historia diferente.)"

# game/Story04.rpy:1152

translate spanish story05_2_28e71a29:

    # v "Wow. Look at you, absolutely glowing."
    v "Mírate, absolutamente brillante."

# game/Story04.rpy:1153

translate spanish story05_2_9bbce492:

    # k "Bruises and bumps? Yeah… call it bruised and battered, I’m shining like a damn Christmas tree."
    k "¿Bruises y baches? Sí... llámalo contuberado y maltratado, estoy brillando como un maldito árbol de Navidad."

# game/Story04.rpy:1154

translate spanish story05_2_c957b56d:

    # v "Dreams always come with a price. But in your case… The whole squad’s rooting for you."
    v "Los sueños siempre vienen con un precio. Pero en su caso... Todo el equipo está arraigado para usted."

# game/Story04.rpy:1156

translate spanish story05_2_8743b74a:

    # k "(Honestly, I didn’t really need anyone else’s support... but gotta admit, it felt damn good to hear it.)"
    k "(En serio, no necesitaba el apoyo de nadie más... pero debo admitirlo, se sintió muy bien escucharlo)."

# game/Story04.rpy:1157

translate spanish story05_2_e583dedf:

    # a "On your feet. Break’s over."
    a "Se acabó el descanso."

# game/Story04.rpy:1160

translate spanish story05_2_0f1b7a03:

    # a "We’re not leaving until you land a hit."
    a "No nos vamos hasta que aterrices un éxito."

# game/Story04.rpy:1162

translate spanish story05_2_59c3acaa:

    # k "(And like that, a few months just… vanished.)"
    k "(Y así, unos meses... se desvanecieron.)"

# game/Story04.rpy:1173

translate spanish story05_2_4d689079:

    # k "(Until my sister and I were sent on a new assignment.)"
    k "(Hasta que mi hermana y yo fuimos enviados a una nueva asignación.)"

# game/Story04.rpy:1174

translate spanish story05_2_5080f87c:

    # k "(Eliminate someone. Or something like that. Honestly, I don’t even remember anymore.)"
    k "(Elimine a alguien. O algo así. Honestamente, ni siquiera recuerdo más.)"

# game/Story04.rpy:1176

translate spanish story05_2_720e1ce5:

    # k "You know, sis… I’m happy you made it far enough to look down on everyone else."
    k "Sabes, hermana... estoy feliz de que hayas llegado lo suficientemente lejos para mirar a todos los demás."

# game/Story04.rpy:1177

translate spanish story05_2_24ef8837:

    # k "Just… not from the bottom of my heart."
    k "No desde el fondo de mi corazón."

# game/Story04.rpy:1179

translate spanish story05_2_00f64c70:

    # v "If anything, you’re the one who’s been stuck at the bottom for way too long."
    v "Si algo, eres el que ha estado atrapado en el fondo por mucho tiempo."

# game/Story04.rpy:1180

translate spanish story05_2_18e8a173:

    # v "What about the target?"
    v "¿Qué hay del objetivo?"

# game/Story04.rpy:1183

translate spanish story05_2_0d1eded5:

    # k "I don’t see anyone. Are you sure we’re even in the right place?"
    k "No veo a nadie. ¿Estás seguro de que estamos en el lugar correcto?"

# game/Story04.rpy:1184

translate spanish story05_2_8b2f1489:

    # v "Patience. That guy handles blood shipments for the elves."
    v "Paciencia, ese tipo maneja cargamentos de sangre para los elfos."

# game/Story04.rpy:1185

translate spanish story05_2_4721673b:

    # k "Oh. So an important asshole, huh? Got it."
    k "Qué idiota tan importante, ¿no?"

# game/Story04.rpy:1188

translate spanish story05_2_731dd8ce:

    # k "Yeah. Arachnid Eyes listening."
    k "Ojos de arcnid escuchando."

# game/Story04.rpy:1189

translate spanish story05_2_82091822_2:

    # k "..."
    k "..."

# game/Story04.rpy:1190

translate spanish story05_2_2c66f0ca:

    # mc "(You okay?)"
    mc "(¿Estás bien?)"

# game/Story04.rpy:1191

translate spanish story05_2_a5839e3b:

    # k "(Uh… yeah. Yeah. Just a bad memory.)"
    k "Sí, un mal recuerdo."

# game/Story04.rpy:1193

translate spanish story05_2_7f7f16dc:

    # a "Get out of there, now! You’ve been spotted!"
    a "¡Sal de ahí, ahora! ¡Te han visto!"

# game/Story04.rpy:1194

translate spanish story05_2_d551fa11:

    # k "(Back then, we either overestimated ourselves, or seriously underestimated the enemy.)"
    k "(Entonces, o nos sobreestimamos o subestimamos seriamente al enemigo)."

# game/Story04.rpy:1199

translate spanish story05_2_a0ecd35c:

    # k "(The result…)"
    k "(El resultado...)"

# game/Story04.rpy:1202

translate spanish story05_2_d0d074c3:

    # k "(And that’s the moment I thought I’d finally become stronger, when my sister got her head blown off.)"
    k "(Y ese es el momento en que pensé que finalmente me volvería más fuerte, cuando mi hermana se le voló la cabeza)."

# game/Story04.rpy:1203

translate spanish story05_2_70c30325:

    # k "(Bang, and all those old injuries, from the first time, came rushing back.)"
    k "(Bang, y todas esas viejas lesiones, desde la primera vez, regresaron corriendo)."

# game/Story04.rpy:1207

translate spanish story05_2_d0287d62:

    # k "(This time it was worse than ever. No commander to save my ass.)"
    k "(Esta vez fue peor que nunca."

# game/Story04.rpy:1208

translate spanish story05_2_c2577c02:

    # k "(My sister, instead of that kid backdays. Yeah. That was… worse. I was left alone.)"
    k "(Mi hermana, en lugar de ese niño de los días de la noche."

# game/Story04.rpy:1211

translate spanish story05_2_a09ac3f5:

    # k "(Seeing that hole in her head, my insides clenched. Not from fear. From rage. From bitterness.)"
    k "(Ver ese agujero en su cabeza, mis entrañas se aferraban, no por miedo, por rabia, por amargura.)"

# game/Story04.rpy:1214

translate spanish story05_2_6a512ea6:

    # k "(Losing the one you called family...)"
    k "(Perdiendo a la que llamaste familia...)"

# game/Story04.rpy:1216

translate spanish story05_2_14e4c948:

    # k "(What was going on in my head back then? Heh…)"
    k "¿Qué estaba pasando en mi cabeza en ese entonces?"

# game/Story04.rpy:1218

translate spanish story05_2_e7f1eeb7:

    # k "No… This is a dream. Anyone but her…"
    k "No, es un sueño, cualquiera que no sea ella..."

# game/Story04.rpy:1220

translate spanish story05_2_0c765a15:

    # v "You know shooting really isn’t your thing. Maybe you should try something else."
    v "Sabes que disparar no es lo tuyo. Tal vez deberías probar otra cosa."

# game/Story04.rpy:1222

translate spanish story05_2_c241fa9f:

    # a "You’re the worst of them all. You cause problems, you’re lazy, incompetent, and you put everyone else in danger."
    a "Eres el peor de todos. Causas problemas, eres perezoso, incompetente, y pones a todos en peligro."

# game/Story04.rpy:1226

translate spanish story05_2_58456168:

    # k "I just wanted to…"
    k "Solo quería..."

# game/Story04.rpy:1229

translate spanish story05_2_0de4faee_1:

    # a "There is nothing in you that belongs in a real warrior."
    a "No hay nada en ti que pertenezca a un verdadero guerrero."

# game/Story04.rpy:1233

translate spanish story05_2_2185c95b_1:

    # v "You’re getting worse every time."
    v "Cada vez estás empeorando."

# game/Story04.rpy:1235

translate spanish story05_2_2b166874:

    # k "I wanted to prove it…"
    k "Quería probarlo..."

# game/Story04.rpy:1237

translate spanish story05_2_b7dd357d:

    # v "Dreams come at a cost. But in your case..."
    v "Los sueños tienen un costo, pero en tu caso..."

# game/Story04.rpy:1239

translate spanish story05_2_a68cad38:

    # a "Do what you’re actually good at. Take care."
    a "Haz lo que eres realmente bueno en. Cuídate."

# game/Story04.rpy:1241

translate spanish story05_2_82091822_3:

    # k "..."
    k "..."

# game/Story04.rpy:1243

translate spanish story05_2_9e15a3b8:

    # k "(Funny, right? All it took was one person dying to break me. Hilarious.)"
    k "Todo lo que se necesitaba fue morir por romperme."

# game/Story04.rpy:1245

translate spanish story05_2_7a0239a3:

    # k "(And yet… my whole body filled with energy. I swore to myself I’d endure. I’d get out of that place.)"
    k "(Y sin embargo... todo mi cuerpo lleno de energía. Me juré a mí mismo que yo soportaría. Yo saldría de ese lugar.)"

# game/Story04.rpy:1246

translate spanish story05_2_d0a90b76:

    # k "(And the funniest part…)"
    k "(Y la parte más divertida...)"

# game/Story04.rpy:1248

translate spanish story05_2_f026fe66:

    # k "(I decided to get out with her.)"
    k "(Decidí salir con ella.)"

# game/Story04.rpy:1249

translate spanish story05_2_a79b1d89:

    # k "(Most people would call it stupid. Insane. I didn’t give a damn.)"
    k "(La mayoría de la gente lo llamaría estúpido. Insane. No me importaba un bledo.)"

# game/Story04.rpy:1250

translate spanish story05_2_3529473c:

    # k "(I wasn’t leaving my sister behind. Not even her corpse.)"
    k "(No estaba dejando atrás a mi hermana, ni siquiera a su cadáver.)"

# game/Story04.rpy:1252

translate spanish story05_2_9b93fcc3:

    # k "(That’s when the real fun began. Me. Alone. With my sister’s body. Against a whole crowd.)"
    k "(Es ahí cuando comenzó la verdadera diversión. Yo. Solo. Con el cuerpo de mi hermana. Contra toda una multitud.)"

# game/Story04.rpy:1254

translate spanish story05_2_4e236112:

    # k "(But I had nothing left to lose. So I acted. Pushed all feelings aside. Everything I knew, shoved to the back.)"
    k "(Pero no tenía nada que perder, así que actué. Empujaba todos los sentimientos a un lado. Todo lo que sabía, me empujaba a la espalda.)"

# game/Story04.rpy:1255

translate spanish story05_2_5f8908dc:

    # k "(And when I saw my first target…)"
    k "(Y cuando vi mi primer objetivo...)"

# game/Story04.rpy:1258

translate spanish story05_2_1b59e9d8:

    # k "(I didn’t hesitate. I lunged at him with every ounce of rage I had.)"
    k "(No lo dudé. Le arrojé con cada onza de rabia que tenía.)"

# game/Story04.rpy:1259

translate spanish story05_2_98097e30:

    # k "(They’d call it animalistic. Even by my standards, yeah. It was too much.)"
    k "(Lo llamarían animalista, incluso por mis estándares, sí. Era demasiado.)"

# game/Story04.rpy:1262

translate spanish story05_2_d607489c:

    # k "(My first kill…)"
    k "(Mi primer asesinato...)"

# game/Story04.rpy:1263

translate spanish story05_2_030fe8b6:

    # k "(And there was nothing great about it. Ugly. Animal. Absurd.)"
    k "(Y no había nada genial en eso."

# game/Story04.rpy:1267

translate spanish story05_2_a704886b:

    # k "(That’s when I carved it into my skull: Either me, or them. How? Didn’t matter.)"
    k "(Es ahí cuando lo he tallado en mi cráneo: O yo, o ellos. ¿Cómo? No importaba.)"

# game/Story04.rpy:1268

translate spanish story05_2_49a9cace:

    # k "(...)"
    k "(...)"

# game/Story04.rpy:1272

translate spanish story05_2_61b24aec:

    # k "(By some miracle, I made it out alive. How? No idea. But facts are facts.)"
    k "(Por un milagro, lo hice vivo. ¿Cómo? No tengo idea. Pero los hechos son hechos.)"

# game/Story04.rpy:1273

translate spanish story05_2_3479ed1d:

    # k "(I took my sister with me.)"
    k "(Me llevo a mi hermana conmigo.)"

# game/Story04.rpy:1275

translate spanish story05_2_743c22ff:

    # k "(Later, thankfully, I found out she was alive. The bullet went straight through, missed the brain.)"
    k "(Más tarde, afortunadamente, descubrí que estaba viva, la bala pasó directamente, perdió el cerebro.)"

# game/Story04.rpy:1276

translate spanish story05_2_3921df4b:

    # k "(I remember thinking how lucky she was… And at the same time, how glad I was I didn’t leave her.)"
    k "(Recuerdo pensar lo afortunado que era... y al mismo tiempo, lo feliz que estaba yo no la dejé.)"

# game/Story04.rpy:1285

translate spanish story05_2_be304793:

    # k "(And just like that, my whole life flipped upside down. All those old dreams, becoming an actress, gone. Just like that.)"
    k "(Y así, toda mi vida se volvió loca, todos esos viejos sueños, convirtiéndose en actriz, se fueron. Así como así.)"

# game/Story04.rpy:1286

translate spanish story05_2_3999e248:

    # k "(Do I regret it? Yeah. I do. But at the same time... I’m glad for what I have now.)"
    k "(¿Me arrepiento? Sí. Lo hago. Pero al mismo tiempo... me alegro por lo que tengo ahora.)"

# game/Story04.rpy:1288

translate spanish story05_2_18f4ac20:

    # a "What you did was absurd… and at the same time, noble."
    a "Lo que hiciste fue absurdo... y al mismo tiempo, noble."

# game/Story04.rpy:1289

translate spanish story05_2_055c9b8e:

    # k "I didn’t really have a choice."
    k "No tenía elección."

# game/Story04.rpy:1290

translate spanish story05_2_f692bdb7:

    # a "I know."
    a "Lo sé."

# game/Story04.rpy:1292

translate spanish story05_2_be237585:

    # a "The young lady asked to see you."
    a "La jovencita pidió verte."

# game/Story04.rpy:1293

translate spanish story05_2_30fd9647:

    # k "What? Why?!"
    k "¿Por qué?"

# game/Story04.rpy:1294

translate spanish story05_2_bb8e4b4e_1:

    # a "..."
    a "..."

# game/Story04.rpy:1295

translate spanish story05_2_3be8089a:

    # a "I’m glad you survived."
    a "Me alegra que sobrevivieras."

# game/Story04.rpy:1300

translate spanish story05_2_cc265445:

    # k "(And by sheer coincidence, I met her. Evrelia. The head of the Inquisition herself.)"
    k "(Y por pura coincidencia, la conocí. Evrelia. La cabeza de la Inquisición misma.)"

# game/Story04.rpy:1301

translate spanish story05_2_fbaeea6b:

    # mc "(Astoria’s younger sister?)"
    mc "(¿La hermana menor de Astoria?)"

# game/Story04.rpy:1302

translate spanish story05_2_3759ed3b:

    # k "(That’s her.)"
    k "(Esa es ella.)"

# game/Story04.rpy:1303

translate spanish story05_2_5487592e:

    # k "You wanted to see me?"
    k "¿Querías verme?"

# game/Story04.rpy:1306

translate spanish story05_2_a7438ac2:

    # k "(Her posture, her eyes, her presence... Absolute. Like the weight of the whole world suddenly crashing down on you.)"
    k "(Su postura, sus ojos, su presencia... absoluta. Como el peso de todo el mundo de repente se estrella sobre ti.)"

# game/Story04.rpy:1307

translate spanish story05_2_9354e9b2:

    # k "(I could feel her power with my entire body.)"
    k "(Podría sentir su poder con todo mi cuerpo.)"

# game/Story04.rpy:1309

translate spanish story05_2_4a212a08:

    # k "(There was one catch, though. How she looked, and how she acted. That part threw me off.)"
    k "(Pero había una captura. Cómo se veía, y cómo actuó. Esa parte me echó.)"

# game/Story04.rpy:1312

translate spanish story05_2_b47fe7ce:

    # Evrel "Cute face."
    Evrel "Linda cara."

# game/Story04.rpy:1314

translate spanish story05_2_070a82a9:

    # k "(And the funniest thing? I expected a lot, but that level of absurdity? From her? Yeah, no. I froze, had no clue how to even respond.)"
    k "¿Y lo más divertido? Esperaba mucho, pero ese nivel de absurdidad? ¿De ella? Sí, no. Me congelé, no tenía ni idea de cómo responder.)"

# game/Story04.rpy:1315

translate spanish story05_2_15a72cee:

    # Evrel "Your report was… interesting."
    Evrel "Tu informe fue... interesante."

# game/Story04.rpy:1316

translate spanish story05_2_84c6d1c4:

    # Evrel "Interesting enough that even my sister took notice."
    Evrel "Lo suficientemente interesante que incluso mi hermana se dio cuenta."

# game/Story04.rpy:1318

translate spanish story05_2_6119d1c1:

    # Evrel "Tell me something."
    Evrel "Dime algo."

# game/Story04.rpy:1319

translate spanish story05_2_a6019a71:

    # Evrel "How do you feel about deciding other people’s fates?"
    Evrel "¿Cómo te sientes con decidir los destinos de otras personas?"

# game/Story04.rpy:1322

translate spanish story05_2_44362d8b:

    # k "(Didn’t take me long to answer, honestly. And just like that, I signed up for the next couple of years as a trainee.)"
    k "(No me tomó mucho tiempo para responder, honestamente. Y así, me inscribí para los próximos dos años como aprendiz.)"

# game/Story04.rpy:1325

translate spanish story05_2_f1c2d373:

    # k "So what’s the result? My body turned into a weapon. Scars, burns, everything you can see. One ugly mess, really."
    k "Entonces, ¿cuál es el resultado? Mi cuerpo se convirtió en un arma. Escartas, quemaduras, todo lo que puedes ver. Un desastre feo, en realidad."

# game/Story04.rpy:1327

translate spanish story05_2_8d43342e:

    # k "Then again… isn’t that what they say? Scars make a warrior, right?"
    k "Entonces otra vez... ¿no es eso lo que dicen?"

# game/Story04.rpy:1329

translate spanish story05_2_08470cbc:

    # mc "Scars are experience. Bitter, unpleasant, but necessary. I don’t see anything wrong with them."
    mc "Las cicatrices son experiencia. Ladrar, desagradable, pero necesario. No veo nada malo con ellos."

# game/Story04.rpy:1330

translate spanish story05_2_23722540:

    # k "You’ve got a smooth tongue, I’ll give you that."
    k "Tienes una lengua lisa, te lo daré."

# game/Story04.rpy:1331

translate spanish story05_2_d622e7db:

    # k "Alright. Enough."
    k "De acuerdo, basta."

# game/Story04.rpy:1339

translate spanish story05_2_82091822_4:

    # k "..."
    k "..."

# game/Story04.rpy:1341

translate spanish story05_2_d89b8cb1:

    # k "You know, I just remembered something."
    k "Acabo de recordar algo."

# game/Story04.rpy:1342

translate spanish story05_2_645f92f3:

    # k "Your implants, still giving you trouble?"
    k "¿Tus implantes, aún te dan problemas?"

# game/Story04.rpy:1344

translate spanish story05_2_db369493:

    # mc "What’s with the sudden interest? Thought it was my turn to tell a story."
    mc "¿Qué hay con el interés repentino? Pensé que era mi turno para contar una historia."

# game/Story04.rpy:1346

translate spanish story05_2_8d15596a:

    # k "Oh, trust me, I’d love to hear your story and all that, but not right now."
    k "Oh, créeme, me encantaría escuchar tu historia y todo eso, pero no ahora mismo."

# game/Story04.rpy:1347

translate spanish story05_2_69654e49:

    # k "A little bird whispered in my ear that I should take a look at your implants. Call it curiosity."
    k "Un pajarito susurró en mi oído que debería echar un vistazo a sus implantes."

# game/Story04.rpy:1349

translate spanish story05_2_4bc3c2ba:

    # mc "If I remember correctly, you couldn’t care less before. What changed?"
    mc "Si recuerdo correctamente, no te importaría menos antes. ¿Qué cambió?"

# game/Story04.rpy:1351

translate spanish story05_2_d422f34c:

    # k "Let’s go."
    k "Vamos."

# game/Story04.rpy:1366

translate spanish story05_2_1_74deaa9f:

    # mc "(Life didn’t go easy on her, that’s for sure. But it doesn’t fully explain her mental state. Still…)"
    mc "(La vida no fue fácil en ella, eso es seguro. Pero no explica completamente su estado mental. Todavía...)"

# game/Story04.rpy:1368

translate spanish story05_2_1_4bc62d14:

    # mc "You’re a tough one."
    mc "Eres un duro."

# game/Story04.rpy:1369

translate spanish story05_2_1_a7d5693c:

    # k "Oh, I know that without you. And watch your head, by the way."
    k "Lo sé sin ti y mira tu cabeza, por cierto."

# game/Story04.rpy:1372

translate spanish story05_2_1_e5013fa2:

    # mc "Arkh…"
    mc "Arkh..."

# game/Story04.rpy:1373

translate spanish story05_2_1_aa148588:

    # k "Told you."
    k "Te lo dije."

# game/Story04.rpy:1374

translate spanish story05_2_1_2c56c3a0:

    # k "And about what you said earlier, truth is, that’s not really my achievement."
    k "Y sobre lo que dijiste antes, la verdad es que no es realmente mi logro."

# game/Story04.rpy:1377

translate spanish story05_2_1_d8a61277:

    # k "Just like you, I’m packed to the brim with implants. They’re the ones responsible for everything my body does."
    k "Como tú, estoy empaquetado al borde con implantes. Son los responsables de todo lo que mi cuerpo hace."

# game/Story04.rpy:1378

translate spanish story05_2_1_d11f2732:

    # mc "Not that different, are we?"
    mc "No es diferente, ¿verdad?"

# game/Story04.rpy:1379

translate spanish story05_2_1_db915de8:

    # mc "(Whispering) My head…"
    mc "Mi cabeza..."

# game/Story04.rpy:1380

translate spanish story05_2_1_6e609aaf:

    # k "Heh..."
    k "Heh..."

# game/Story04.rpy:1382

translate spanish story05_2_1_77823fd0:

    # k "Different? I don’t even know if this is really me, or someone else. Either way, I don’t lose sleep over it."
    k "¿Diferente? Ni siquiera sé si este es realmente yo, o alguien más. De cualquier manera, no pierdo sueño sobre él."

# game/Story04.rpy:1384

translate spanish story05_2_1_ac733c95:

    # mc "(Ostorius mentioned something like this…)"
    mc "(Ostorius mencionó algo como esto...)"

# game/Story04.rpy:1385

translate spanish story05_2_1_d97228a1:

    # mc "Side effects?"
    mc "¿Efectos secundarios?"

# game/Story04.rpy:1387

translate spanish story05_2_1_80484cde:

    # k "Bingo."
    k "Bingo."

# game/Story04.rpy:1388

translate spanish story05_2_1_9e888770:

    # k "Nasty stuff. Don’t keep an eye on them, and in the middle of a fight your head might just-click-shut down."
    k "Cosas raras. No los mires, y en medio de una pelea tu cabeza podría simplemente hacer clic en el botón de abajo."

# game/Story04.rpy:1389

translate spanish story05_2_1_0340e3ca:

    # k "And ding-ding. You’re dead."
    k "Y ding-ding. Estás muerto."

# game/Story04.rpy:1391

translate spanish story05_2_1_c863cb52:

    # mc "With honor and glory, huh?"
    mc "Con honor y gloria, ¿eh?"

# game/Story04.rpy:1394

translate spanish story05_2_1_0aea7593:

    # k "Yeah. Face down in dirt and shit. Nothing noble about it."
    k "Sí, cara abajo en tierra y mierda, nada noble."

# game/Story04.rpy:1395

translate spanish story05_2_1_13457756:

    # mc "Depends on how you look at it, but overall, I agree."
    mc "Depende de cómo lo mires, pero en general, estoy de acuerdo."

# game/Story04.rpy:1401

translate spanish story05_2_1_ac223aba:

    # k "Yeah, yeah. Strip. Time to see what you’ve got under the hood."
    k "Sí, sí. Strip. Time to see what you've got under the hood."

# game/Story04.rpy:1402

translate spanish story05_2_1_6eee0bd4:

    # k "Pants stay on. One time was more than enough, I’m good."
    k "Los pantalones se quedan. Una vez fue más que suficiente, estoy bien."

# game/Story04.rpy:1403

translate spanish story05_2_1_3c25c078:

    # mc "Don’t remember agreeing to this. But I doubt I can talk you out of it."
    mc "No recuerden estar de acuerdo con esto, pero dudo que pueda hablarle de ello."

# game/Story04.rpy:1406

translate spanish story05_2_1_e2968a08:

    # mc "What I don’t get is, why do you need to undress?"
    mc "Lo que no entiendo es, ¿por qué necesitas desnudarte?"

# game/Story04.rpy:1407

translate spanish story05_2_1_a3d66542:

    # k "Hm..."
    k "Hm..."

# game/Story04.rpy:1408

translate spanish story05_2_1_0028e907:

    # k "I don’t like talking about this, but answer me one thing."
    k "No me gusta hablar de esto, pero contestame una cosa."

# game/Story04.rpy:1410

translate spanish story05_2_1_791569fe:

    # k "Would you rather lose all your memories… or never be able to make new ones?"
    k "¿Preferirías perder todos tus recuerdos o nunca ser capaz de hacer nuevos?"

# game/Story04.rpy:1413

translate spanish story05_2_1_f0c90342:

    # mc "This is…"
    mc "Esto es..."

# game/Story04.rpy:1414

translate spanish story05_2_1_a008ab70:

    # mc "(Is she talking about herself? Or in general?)"
    mc "¿Está hablando de sí misma o en general?"

# game/Story04.rpy:1415

translate spanish story05_2_1_355a2486:

    # mc "Personal experience, or you want my opinion?"
    mc "¿Experiencia personal o quieres mi opinión?"

# game/Story04.rpy:1418

translate spanish story05_2_1_04482542:

    # k "Let’s call it personal curiosity."
    k "Vamos a llamarlo curiosidad personal."

# game/Story04.rpy:1419

translate spanish story05_2_1_d71db43e:

    # k "How did you put it? “You tell me your story, I trade you a couple of gags and saving your ass.”"
    k "¿Cómo lo pusiste? “Me cuentas tu historia, te cambio un par de gags y te salvó el culo.”"

# game/Story04.rpy:1420

translate spanish story05_2_1_f082497e:

    # k "Your story won’t tell me much. Your views, though? That’s a different matter."
    k "Tu historia no me contará mucho. Tus opiniones, sin embargo? Eso es un asunto diferente."

# game/Story04.rpy:1422

translate spanish story05_2_1_b0d80c19:

    # mc "(Views, huh… Giving up the past for the sake of the future, or living in the past with no future at all?)"
    mc "(Vista, ¿eh... entregando el pasado por el bien del futuro, o viviendo en el pasado sin futuro en absoluto?)"

# game/Story04.rpy:1423

translate spanish story05_2_1_103f0f2e:

    # mc "(The past or the future? On one hand, how could I forget the deaths of my comrades, my own son, the betrayals and-)"
    mc "(El pasado o el futuro? Por un lado, ¿cómo podría olvidar las muertes de mis camaradas, mi propio hijo, las traiciones y-)"

# game/Story04.rpy:1425

translate spanish story05_2_1_019ca93c:

    # mc "(On the other… what would be the point of everything else then? By that logic, I could’ve stayed back on Earth.)"
    mc "(Por el otro... ¿Cuál sería el punto de todo lo demás entonces? Por esa lógica, podría haber permanecido de nuevo en la Tierra.)"

# game/Story04.rpy:1426

translate spanish story05_2_1_6b0ecf96:

    # mc "(But honestly, why am I doing all this? Did the others really want the same thing I did?)"
