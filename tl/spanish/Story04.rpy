translate spanish story05_5_1_a33b63f8:

    # L "(Focus. Stop drifting. Mission first.)"
    L "(Focus. Deja de derivar. Misión primero.)"

# game/Story04.rpy:5618

translate spanish story05_5_1_9cdc11a6:

    # L "She’s a Higher Being."
    L "Es un Ser Superior."

# game/Story04.rpy:5619

translate spanish story05_5_1_8ce32ee8:

    # L "We can’t kill her. No matter what we try."
    L "No podemos matarla. No importa lo que intentemos."

# game/Story04.rpy:5620

translate spanish story05_5_1_2876efd9:

    # mc "Why?"
    mc "¿Por qué?"

