translate spanish story05_5_3_c0878d3f:

    # mc "Mm… come on…"
    mc "Vamos..."

# game/Story04.rpy:6792

translate spanish story05_5_3_8138fe90:

    # mc "(Done.)"
    mc "(Done.)"

# game/Story04.rpy:6801

translate spanish story05_5_3_f1497f9f:

    # mc "Still second-guessing your decision?"
    mc "¿Todavía sigues preguntando tu decisión?"

