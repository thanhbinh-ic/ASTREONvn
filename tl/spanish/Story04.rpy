translate spanish story05_5_1_b04484d7:

    # k "Especially you, one-eye."
    k "Especialmente tú, un solo ojo."

# game/Story04.rpy:5609

translate spanish story05_5_1_7080503e:

    # k "What’s the plan with the elf queen?"
    k "¿Cuál es el plan con la reina del elfo?"

