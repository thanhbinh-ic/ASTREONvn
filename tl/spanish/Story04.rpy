translate spanish story05_5_2_245fec54:

    # mc "Done. What now?"
    mc "Hecho. ¿Ahora qué?"

# game/Story04.rpy:6694

translate spanish story05_5_2_bb8e4b4e_3:

    # a "..."
    a "..."

