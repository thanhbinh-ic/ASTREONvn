translate spanish story05_5_1_57928051:

    # mc "What about all those resets of yours?"
    mc "¿Y todos esos restablecimientos tuyos?"

# game/Story04.rpy:5647

translate spanish story05_5_1_37a92146:

    # L "In none of them did we kill her. Not once."
    L "En ninguno de ellos la matamos, ni una sola vez."

