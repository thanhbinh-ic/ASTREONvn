    # mc "Don`t. We’re past that."
    mc "No. Ya hemos pasado."

# game/Story04.rpy:6804

translate spanish story05_5_3_812ed592:

    # a "After analyzing the situation…"
    a "Después de analizar la situación..."

# game/Story04.rpy:6805

translate spanish story05_5_3_7066c740:

    # a "For the first time, I don’t know what to tell you."
    a "Por primera vez, no sé qué decirte."

