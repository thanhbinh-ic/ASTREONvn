translate spanish story05_4_421992e2:

    # Mi "Seems like it is."
    Mi "Parece que lo es."

# game/Story04.rpy:3219

translate spanish story05_4_8bef1ca6:

    # h "Then what the hell was all this circus for?! Why drag us into this, WHY KILL SO MANY PEOPLE?!"
    h "¿Para qué demonios fue todo este circo?! ¿Por qué nos arrastramos a esto, por qué tanta gente?"

# game/Story04.rpy:3220

translate spanish story05_4_c03bc1df:

    # h "For a sister?! That’s just-"
    h "¿Para una hermana?"

# game/Story04.rpy:3223

translate spanish story05_4_0fb1417e:

    # h "(But if I were in her place… would I really do it any differently?)"
    h "(Pero si estuviera en su lugar... ¿realmente lo haría de manera diferente?)"

# game/Story04.rpy:3224

translate spanish story05_4_906d3461:

    # h "Argh… this is heavy."
    h "Argh... esto es pesado."

# game/Story04.rpy:3226

translate spanish story05_4_20145cf7:

    # mc "We have no reason to blame her. Yes, the situation is fucked. That’s a fact."
    mc "No tenemos ninguna razón para culparla. Sí, la situación está jodida. Eso es un hecho."

# game/Story04.rpy:3227

translate spanish story05_4_f6e64583:

    # mc "But we move forward with what we have. First priority, survive."
    mc "Pero avanzamos con lo que tenemos. Primera prioridad, sobrevivir."

# game/Story04.rpy:3229

translate spanish story05_4_1a276065:

    # mc "Then we go home."
    mc "Entonces nos vamos a casa."

# game/Story04.rpy:3230

translate spanish story05_4_53f4e79d:

    # mc "Everyone on board?"
    mc "¿Todos a bordo?"

# game/Story04.rpy:3232

translate spanish story05_4_483f0116:

    # E "The squad nodded in unison."
    E "El equipo asintió al unísono."

# game/Story04.rpy:3233

translate spanish story05_4_406eab4a:

    # a "I hate to interrupt, but we’ll arrive in twenty minutes."
    a "Odio interrumpir, pero llegaremos en veinte minutos."

# game/Story04.rpy:3237

translate spanish story05_4_ab2a64e6:

    # mc "Good. Then it’s time to put the puzzle together."
    mc "Bien. Entonces es hora de armar el rompecabezas."

# game/Story04.rpy:3263

translate spanish story05_5_66a513ad:

    # mc "Our objective is what’s inside the tower."
    mc "Nuestro objetivo es lo que hay dentro de la torre."

# game/Story04.rpy:3265

translate spanish story05_5_9935ea36:

    # mc "A portal to Earth."
    mc "Un portal a la Tierra."

# game/Story04.rpy:3266

translate spanish story05_5_a36da26b:

    # mc "We stop the summoning of Evrelia-"
    mc "Detenemos la citación de Evrelia-"

# game/Story04.rpy:3267

translate spanish story05_5_5fa08d3f:

    # L "We’ll make it out alive."
    L "Lo lograremos vivo."

# game/Story04.rpy:3269

translate spanish story05_5_f544d7e6:

    # mc "In twenty minutes, this ship at full speed crashes into the tower."
    mc "En veinte minutos, esta nave a toda velocidad choca contra la torre."

# game/Story04.rpy:3270

translate spanish story05_5_4e3fc1b0:

    # mc "That gives us the window we need to punch through the defenses and get inside."
    mc "Eso nos da la ventana que necesitamos para golpear las defensas y entrar."

# game/Story04.rpy:3272

translate spanish story05_5_450cd29b:

    # mc "We don’t know the exact situation inside the tower."
    mc "No sabemos la situación exacta dentro de la torre."

# game/Story04.rpy:3273

translate spanish story05_5_8d6b2a0d:

    # mc "First priority, find out what the hell is going on."
    mc "Primera prioridad, averigua qué demonios está pasando."

# game/Story04.rpy:3274

translate spanish story05_5_0e66f65f:

    # k "Breaking in by force?"
    k "¿Romper por la fuerza?"

# game/Story04.rpy:3275

translate spanish story05_5_3f2cfb7e:

    # k "Yeah, no. Might as well shoot myself in the head, better odds of surviving."
    k "Sí, no, podría dispararme en la cabeza, mejores probabilidades de sobrevivir."

# game/Story04.rpy:3276

translate spanish story05_5_b475b492:

    # mc "We’re all going to die someday."
    mc "Todos vamos a morir algún día."

# game/Story04.rpy:3277

translate spanish story05_5_ad665f6a:

    # mc "Just not today."
    mc "No hoy."

# game/Story04.rpy:3281

translate spanish story05_5_ea853a0a:

    # L "I can get you through, I know enough holes in your security."
    L "Puedo hacerte pasar, conozco suficientes agujeros en tu seguridad."

# game/Story04.rpy:3283

translate spanish story05_5_82091822:

    # k "..."
    k "..."

# game/Story04.rpy:3285

translate spanish story05_5_b3ba6c43:

    # mc "From there on, enemy or ally, we won’t know."
    mc "Desde allí, enemigo o aliado, no lo sabremos."

# game/Story04.rpy:3286

translate spanish story05_5_55d1a068:

    # mc "Killing everyone isn’t rational."
    mc "Matar a todos no es racional."

# game/Story04.rpy:3287

translate spanish story05_5_a4c4660c:

    # mc "Avoid casualties whenever possible."
    mc "Evite las bajas cuando sea posible."

# game/Story04.rpy:3288

translate spanish story05_5_5937212f:

    # h "And if avoiding it isn’t an option?"
    h "¿Y si evitarlo no es una opción?"

# game/Story04.rpy:3291

translate spanish story05_5_60b26f43:

    # mc "Neutralize them."
    mc "Neutralizarlos."

# game/Story04.rpy:3292

translate spanish story05_5_a6005984:

    # mc "Your life comes first."
    mc "Tu vida viene primero."

# game/Story04.rpy:3293

translate spanish story05_5_3acb8eed:

    # h "Can’t say I’m thrilled."
    h "No puedo decir que estoy emocionado."

# game/Story04.rpy:3299

translate spanish story05_5_ecd39557:

    # mc "If hiding in a corner were an option, I’d already be there."
    mc "Si esconderme en una esquina era una opción, ya estaría allí."

# game/Story04.rpy:3300

translate spanish story05_5_cb276708:

    # Mi "What about communications?"
    Mi "¿Qué hay de las comunicaciones?"

# game/Story04.rpy:3303

translate spanish story05_5_735a09d8:

    # mc "That’s our main problem. We can’t move as a large group, too visible."
    mc "Ese es nuestro problema principal. No podemos movernos como un grupo grande, demasiado visible."

# game/Story04.rpy:3304

translate spanish story05_5_097a4775:

    # mc "But splitting up is even worse without communication."
    mc "Pero dividirse es aún peor sin comunicación."

# game/Story04.rpy:3307

translate spanish story05_5_5eac5c4f:

    # Mi "So… we move together?"
    Mi "Entonces... ¿nos movemos juntos?"

# game/Story04.rpy:3309

translate spanish story05_5_81d52519:

    # mc "We don’t have a choice."
    mc "No tenemos elección."

# game/Story04.rpy:3310

translate spanish story05_5_7822c547:

    # Mi "Alright."
    Mi "Muy bien."

# game/Story04.rpy:3311

translate spanish story05_5_eec4a31f:

    # mc "Lora. The portal, what do we know?"
    mc "Lora. ¿El portal, qué sabemos?"

# game/Story04.rpy:3313

translate spanish story05_5_ac18072d:

    # L "The tower’s core. Sublevel thirty-two."
    L "El núcleo de la torre. Subnivel treinta y dos."

# game/Story04.rpy:3314

translate spanish story05_5_0db36c14:

    # L "Once it activates, everything on this planet turns into energy."
    L "Una vez que se activa, todo en este planeta se convierte en energía."

# game/Story04.rpy:3315

translate spanish story05_5_a457ceba:

    # mc "How do we get there?"
    mc "¿Cómo llegamos allí?"

# game/Story04.rpy:3316

translate spanish story05_5_d0fcd718:

    # L "The portal needs cooling, we’ll swim along the coolant line."
    L "El portal necesita enfriamiento, nadaremos a lo largo de la línea de refrigeración."

# game/Story04.rpy:3319

translate spanish story05_5_49b97a77:

    # h "Swim through it?!"
    h "¿Atravesarla?"

# game/Story04.rpy:3320

translate spanish story05_5_927c410b:

    # L "Yes. A water reservoir, big enough to swim through, and the fastest way."
    L "Sí, un depósito de agua, lo suficientemente grande para nadar y la manera más rápida."

# game/Story04.rpy:3323

translate spanish story05_5_9290713c:

    # mc "Time is against us."
    mc "El tiempo está en contra de nosotros."

# game/Story04.rpy:3324

translate spanish story05_5_73109912:

    # mc "Every minute is death."
    mc "Cada minuto es la muerte."

# game/Story04.rpy:3325

translate spanish story05_5_11c3ee67:

    # mc "Every death brings the end closer."
    mc "Cada muerte acerca el fin."

# game/Story04.rpy:3326

translate spanish story05_5_1e634c3a:

    # L "According to my calculations, we have enough time. If nothing changes, everything goes smoothly."
    L "Según mis cálculos, tenemos tiempo suficiente. Si nada cambia, todo va sin problemas."

# game/Story04.rpy:3327

translate spanish story05_5_a18463b8:

    # Mi "In numbers?"
    Mi "¿En números?"

# game/Story04.rpy:3330

translate spanish story05_5_f66cf251:

    # L "Two days."
    L "Dos días."

# game/Story04.rpy:3332

translate spanish story05_5_df368373:

    # h "Not exactly a lot of time."
    h "No es exactamente mucho tiempo."

# game/Story04.rpy:3333

translate spanish story05_5_410fba32:

    # mc "Right now, Flora should be engaging the enemy’s main forces."
    mc "En este momento, Flora debería estar involucrando a las fuerzas principales del enemigo."

# game/Story04.rpy:3335

translate spanish story05_5_3a19f149:

    # h "But what if the portal’s already active?"
    h "¿Pero qué pasa si el portal ya está activo?"

# game/Story04.rpy:3336

translate spanish story05_5_2b35b6fe:

    # mc "..."
    mc "..."

# game/Story04.rpy:3337

translate spanish story05_5_911d744a:

    # L "Then we’d already be gone."
    L "Entonces ya nos habríamos ido."

# game/Story04.rpy:3339

translate spanish story05_5_d117c6d1:

    # L "We follow my plan. Exactly."
    L "Nosotros seguimos mi plan."

# game/Story04.rpy:3340

translate spanish story05_5_2876efd9:

    # mc "Why?"
    mc "¿Por qué?"

# game/Story04.rpy:3342

translate spanish story05_5_f9dfb18d:

    # L "Better odds… of getting a new ending."
    L "Mejores probabilidades... de conseguir un nuevo final."

# game/Story04.rpy:3343

translate spanish story05_5_01eac64a:

    # k "I don’t like it when my life gets called an ‘ending.’"
    k "No me gusta cuando mi vida se llama un \"final\"."

# game/Story04.rpy:3345

translate spanish story05_5_56d10797:

    # mc "You said you didn’t know where this path would lead."
    mc "Dijiste que no sabías dónde llevaría este camino."

# game/Story04.rpy:3346

translate spanish story05_5_c9819295:

    # L "No, but I know how the other paths end."
    L "No, pero sé cómo terminan los otros caminos."

# game/Story04.rpy:3348

translate spanish story05_5_1f97629b:

    # mc "With all due respect, darling- I can’t agree to that."
    mc "Con todo respeto, querida... no puedo aceptar eso."

# game/Story04.rpy:3349

translate spanish story05_5_9993b94e:

    # L "..."
    L "..."

# game/Story04.rpy:3350

translate spanish story05_5_055829a8:

    # h "That might actually be useful."
    h "Eso podría ser útil."

# game/Story04.rpy:3351

translate spanish story05_5_c6ae0460:

    # a "3 minutes."
    a "3 minutos."

# game/Story04.rpy:3353

translate spanish story05_5_6be066f6:

    # mc "(Sigh) Fine."
    mc "Bien."

# game/Story04.rpy:3354

translate spanish story05_5_bc9dedc6:

    # mc "All paths. All outcomes."
    mc "Todos los caminos."

# game/Story04.rpy:3356

translate spanish story05_5_a92e0be0:

    # mc "I want everything."
    mc "Quiero todo."

# game/Story04.rpy:3357

translate spanish story05_5_e89385ad:

    # L "Alright, darling."
    L "Muy bien, cariño."

# game/Story04.rpy:3358

translate spanish story05_5_a87a115e:

    # mc "We don’t get a second chance."
    mc "No tenemos una segunda oportunidad."

# game/Story04.rpy:3364

translate spanish story05_5_195cfbb1:

    # "Cryo-Cooling Reservoir."
    "Reservoir de Cryo-Cooling."

# game/Story04.rpy:3370

translate spanish story05_5_a2284625:

    # k "Nice and warm… Hey, shorty, this what you were dreaming about?"
    k "Qué bonito y cálido... ¿Qué soñaste con esto?"

# game/Story04.rpy:3372

translate spanish story05_5_6211b675:

    # h "I was dreaming of a proper bath. You know, clean water. Not… whatever this is."
    h "Estaba soñando con un baño adecuado, ya sabes, agua limpia, no... lo que sea esto."

# game/Story04.rpy:3373

translate spanish story05_5_e6fbb307:

    # k "Should’ve been more careful with your wishes."
    k "Debería haber sido más cuidadoso con sus deseos."

# game/Story04.rpy:3376

translate spanish story05_5_7d6fec9d:

    # h "Screw you..."
    h "Que te den..."

# game/Story04.rpy:3377

translate spanish story05_5_70b28f76:

    # mc "Hold on."
    mc "Espera."

# game/Story04.rpy:3380

translate spanish story05_5_63ee07d0:

    # h "Hey, Lora? I really don’t like this whole ‘predicting my death’ thing, but still-"
    h "¿Lora? Realmente no me gusta todo esto de \"predecir mi muerte\", pero aún así..."

# game/Story04.rpy:3381

translate spanish story05_5_38992e38:

    # h "Was there even one successful outcome? Out of all our attempts?"
    h "¿Hubo un resultado exitoso?"

# game/Story04.rpy:3384

translate spanish story05_5_2e1e176b:

    # L "It’s..."
    L "Es..."

# game/Story04.rpy:3386

translate spanish story05_5_8bf3fbf2:

    # h "Mm-hmm. Yeah, figured. Couldn’t be worse."
    h "Sí, supuse que no podría ser peor."

# game/Story04.rpy:3387

translate spanish story05_5_794254ff:

    # L "I haven’t said anything yet."
    L "Aún no he dicho nada."

# game/Story04.rpy:3389

translate spanish story05_5_80aaeedf:

    # Mi "A delay… did its job."
    Mi "Un retraso... hizo su trabajo."

# game/Story04.rpy:3390

translate spanish story05_5_84163720:

    # h "So what, one hundred percent chance we’re walking straight to our deaths? Real suicide squad, huh."
    h "¿Qué, cien por ciento de posibilidades estamos caminando directo a nuestras muertes?"

# game/Story04.rpy:3391

translate spanish story05_5_58bb35d5:

    # mc "Where did {b}I shape my own fate{/b} go?"
    mc "¿Dónde? {b}Yo doy forma a mi propio destino.{/b} ¿Ir?"

# game/Story04.rpy:3392

translate spanish story05_5_1f35a5bd:

    # mc "Or {b}I don’t believe in prophecies{/b}?"
    mc "O {b}No creo en las profecías{/b}?"

# game/Story04.rpy:3394

translate spanish story05_5_a6a581ef:

    # h "Look, I don’t plan on dying. But this stuff? It really kills morale."
    h "Mira, no planeo morir, pero esto es lo que realmente mata la moral."

# game/Story04.rpy:3395

translate spanish story05_5_e5c0a60a:

    # mc "I can give a speech, if you want."
    mc "Puedo dar un discurso, si quieres."

# game/Story04.rpy:3396

translate spanish story05_5_c10ed752:

    # h "Nah, I’ve had enough speeches for now. Thanks."
    h "No, he tenido suficientes discursos por ahora."

# game/Story04.rpy:3399

translate spanish story05_5_82091822_1:

    # k "..."
    k "..."

# game/Story04.rpy:3400

translate spanish story05_5_06771e67:

    # k "So… what are you doing?"
    k "Entonces... ¿qué estás haciendo?"

# game/Story04.rpy:3403

translate spanish story05_5_7be7dfae:

    # mc "Trying to help."
    mc "Intentando ayudar."

# game/Story04.rpy:3404

translate spanish story05_5_7fc1b9c6:

    # mc "Unless you want to do it yourself?"
    mc "¿A menos que quieras hacerlo tú mismo?"

# game/Story04.rpy:3405

translate spanish story05_5_25e62972:

    # k "Oh, how sweet...."
    k "Qué dulce..."

# game/Story04.rpy:3406

translate spanish story05_5_b1971237:

    # k "Really makes me wonder, what did I do to deserve that kind of treatment?"
    k "Realmente me hace preguntarme, ¿qué hice para merecer ese tipo de tratamiento?"

# game/Story04.rpy:3414

translate spanish story05_5_68d3a288:

    # k "Wouldn’t happen to be because of that little talk we had, huh, [mc]?"
    k "No sería por esa pequeña charla que teníamos, eh, [mc]?"

# game/Story04.rpy:3415

translate spanish story05_5_2b35b6fe_1:

    # mc "..."
    mc "..."

# game/Story04.rpy:3416

translate spanish story05_5_d55874c1:

    # h "What are you talking about?"
    h "¿De qué estás hablando?"

# game/Story04.rpy:3419

translate spanish story05_5_dfe8cb2b:

    # k "Oh, nothing."
    k "Nada."

# game/Story04.rpy:3420

translate spanish story05_5_4e4426ad:

    # k "Just enjoyed each other’s company."
    k "Solo disfrutaban de la compañía del otro."

# game/Story04.rpy:3421

translate spanish story05_5_d4411c42:

    # k "What do you call it? Blowing off some steam?"
    k "¿Cómo lo llamas?"

# game/Story04.rpy:3422

translate spanish story05_5_deb48ff1:

    # mc "(whispering) Why are you provoking them?"
    mc "¿Por qué los provocas?"

# game/Story04.rpy:3423

translate spanish story05_5_9e1a83b7:

    # k "(whispering) Let me think… because it’s fun. And I kinda like watching them get jealous."
    k "Déjame pensar... porque es divertido. Y me gusta ver cómo se ponen celosos."

# game/Story04.rpy:3425

translate spanish story05_5_ceb0ab41:

    # mc "Everyone here? Let’s move."
    mc "¿Todos aquí? Vamos a movernos."

# game/Story04.rpy:3427

translate spanish story05_5_487e474b:

    # h "[mc]? Can I steal you for a minute…"
    h "[mc]¿Puedo robarte un minuto?"

# game/Story04.rpy:3428

translate spanish story05_5_e3c4889f:

    # mc "Did something happen?"
    mc "¿Pasó algo?"

# game/Story04.rpy:3429

translate spanish story05_5_ffb1c1a5:

    # h "About everything Lora said. My brain’s finally starting to catch up with it all."
    h "Sobre todo lo que dijo Lora. Mi cerebro finalmente está empezando a ponerse al día con todo."

# game/Story04.rpy:3430

translate spanish story05_5_2f7b900d:

    # h "I get that we’re supposed to stay positive and believe we’ll pull through, but…"
    h "Entiendo que se supone que debemos mantenernos positivos y creer que vamos a pasar, pero..."

# game/Story04.rpy:3431

translate spanish story05_5_094a1f7e:

    # h "What if we don’t come back?"
    h "¿Y si no regresamos?"

# game/Story04.rpy:3432

translate spanish story05_5_2b35b6fe_2:

    # mc "..."
    mc "..."

# game/Story04.rpy:3434

translate spanish story05_5_c6a8c3da:

    # h "The longer I think about it, the clearer it gets… I’m scared, [mc]."
    h "Cuanto más tiempo lo pienso, más claro se pone... tengo miedo, [mc]."

# game/Story04.rpy:3435

translate spanish story05_5_2548d507:

    # h "And yeah, my head knows I’m supposed to be brave. Strong. All that crap."
    h "Y sí, mi cabeza sabe que se supone que soy valiente."

# game/Story04.rpy:3436

translate spanish story05_5_2da41225:

    # h "But…"
    h "Pero..."

# game/Story04.rpy:3437

translate spanish story05_5_cdaf174b:

    # h "I’ve already caught myself regretting coming with you. More than once."
    h "Ya me he pillado lamentando venir contigo. Más de una vez."

# game/Story04.rpy:3438

translate spanish story05_5_2b35b6fe_3:

    # mc "..."
    mc "..."

# game/Story04.rpy:3440

translate spanish story05_5_76e1c216:

    # h "(What did I just…?)"
    h "(¿Qué acabo de...?)"

# game/Story04.rpy:3442

translate spanish story05_5_88d58078:

    # h "No! That’s not what I meant— I mean—"
    h "No, no es lo que quise decir, quiero decir..."

# game/Story04.rpy:3446

translate spanish story05_5_3ce22fc0:

    # mc "We all fear death. I’m no exception."
    mc "Todos tememos la muerte. No soy una excepción."

# game/Story04.rpy:3447

translate spanish story05_5_60071f93:

    # mc "In this short time… I wanted to run. More times than I can count."
    mc "En este corto tiempo... quería correr, más veces de lo que puedo contar."

# game/Story04.rpy:3449

translate spanish story05_5_608a457c:

    # h "Why didn’t you?"
    h "¿Por qué no lo hiciste?"

# game/Story04.rpy:3451

translate spanish story05_5_4765806d:

    # mc "Because of all of you."
    mc "Por todos ustedes."

# game/Story04.rpy:3452

translate spanish story05_5_97a70e53:

    # mc "Life’s a funny thing. When you’ve got nothing, you can walk straight into death without a second thought."
    mc "La vida es algo gracioso. Cuando no tienes nada, puedes caminar directamente a la muerte sin pensarlo un segundo."

# game/Story04.rpy:3453

translate spanish story05_5_e2293bba:

    # mc "But once someone appears in it…"
