    "Pocos minutos después."

# game/Story04.rpy:7866

translate spanish story05_5_4_b97d5541:

    # mc "How do you feel?"
    mc "¿Cómo te sientes?"

# game/Story04.rpy:7868

translate spanish story05_5_4_d5dcf025:

    # k "Well, I can joke."
    k "Bueno, puedo bromear."

# game/Story04.rpy:7869

translate spanish story05_5_4_46db7444:

    # k "Brain’s a little scrambled though."
    k "El cerebro está un poco revuelto."

# game/Story04.rpy:7870

translate spanish story05_5_4_96007ccf:

    # k "If it wasn’t for the hole in my chest, I’d say I’m fantastic."
    k "Si no fuera por el agujero en mi pecho, diría que soy fantástico."

# game/Story04.rpy:7875

translate spanish story05_5_4_148ed410:

    # k "On the bright side…"
    k "En el lado brillante..."

# game/Story04.rpy:7876

translate spanish story05_5_4_49b2ab41:

    # k "I’ve got one extra hole now."
    k "Tengo un agujero extra ahora."

# game/Story04.rpy:7878

translate spanish story05_5_4_0054e596:

    # mc "You’re serious?"
    mc "¿Hablas en serio?"

# game/Story04.rpy:7884

translate spanish story05_5_4_701f9418:

    # k "Knew you’d love that one."
    k "Sabía que te encantaría."

# game/Story04.rpy:7888

translate spanish story05_5_4_c28b4c97:

    # mc "(whispering) You never change…"
    mc "Nunca cambias..."

# game/Story04.rpy:7890

translate spanish story05_5_4_e6f4db0e:

    # k "Oh, look at that face."
    k "Mira esa cara."

# game/Story04.rpy:7891

translate spanish story05_5_4_65856b10:

    # k "All broody and tragic."
    k "Todo burdeos y trágicos."

# game/Story04.rpy:7892

translate spanish story05_5_4_079ff3b5:

    # k "Is that supposed to be charming?"
    k "¿Se supone que es encantador?"

# game/Story04.rpy:7894

translate spanish story05_5_4_3fae39b4:

    # mc "I didn’t say that."
    mc "No dije eso."

# game/Story04.rpy:7897

translate spanish story05_5_4_ee2f0821:

    # k "(mocking his voice) Don’t die. I won’t let you die."
    k "No mueras. No te dejaré morir."

# game/Story04.rpy:7898

translate spanish story05_5_4_77d8f3e9:

    # k "God, you should’ve seen your face."
    k "Dios, deberías haber visto tu cara."

# game/Story04.rpy:7901

translate spanish story05_5_4_2a3ae760:

    # k "What was that expression?"
    k "¿Qué expresión tenía?"

# game/Story04.rpy:7902

translate spanish story05_5_4_f2bcf34e:

    # k "You looked like the world was ending."
    k "Parecías que el mundo estaba terminando."

# game/Story04.rpy:7906

translate spanish story05_5_4_fbf854f4:

    # mc "Time was measured in seconds."
    mc "El tiempo se midió en segundos."

# game/Story04.rpy:7908

translate spanish story05_5_4_d3412f0b:

    # mc "Managing my emotions on top of that…"
    mc "Gestionar mis emociones encima de eso..."

# game/Story04.rpy:7909

translate spanish story05_5_4_4a4a9b87:

    # mc "Wasn’t exactly feasible."
    mc "No era exactamente factible."

# game/Story04.rpy:7911

translate spanish story05_5_4_2b35b6fe_3:

    # mc "..."
    mc "..."

# game/Story04.rpy:7921

translate spanish story05_5_4_bbfa73d3:

    # k "Hey… [mc]?"
    k "Oye... [mc]?"

# game/Story04.rpy:7923

translate spanish story05_5_4_582359ea:

    # mc "Hm?"
    mc "¿Hm?"

# game/Story04.rpy:7925

translate spanish story05_5_4_2b922a7d:

    # k "Thanks."
    k "Gracias."

# game/Story04.rpy:7931

translate spanish story05_5_4_ccc941be:

    # mc "You’re welcome."
    mc "De nada."

# game/Story04.rpy:7934

translate spanish story05_5_4_4458056b:

    # k "Congratulations."
    k "Felicitaciones."

# game/Story04.rpy:7935

translate spanish story05_5_4_ae2a9e36:

    # k "You’ve secured third place."
    k "Has asegurado el tercer lugar."

# game/Story04.rpy:7936

translate spanish story05_5_4_7f67156e:

    # k "In the ranking of the most important people in my life."
    k "En el ranking de las personas más importantes de mi vida."

# game/Story04.rpy:7938

translate spanish story05_5_4_5161cd10:

    # mc "I’m honored."
    mc "Soy honrado."

# game/Story04.rpy:7939

translate spanish story05_5_4_efb5bf40:

    # mc "What’s the prize?"
    mc "¿Cuál es el premio?"

# game/Story04.rpy:7946

translate spanish story05_5_4_406ca583:

    # k "Haven’t decided yet."
    k "Aún no lo he decidido."

# game/Story04.rpy:7950

translate spanish story05_5_4_c64803ba:

    # mc "Sorry I…"
    mc "Lo siento..."

# game/Story04.rpy:7951

translate spanish story05_5_4_ed70c4c2:

    # mc "Disfigured you—"
    mc "Te desfiguraste..."

# game/Story04.rpy:7953

translate spanish story05_5_4_78df62db:

    # k "I like it."
    k "Me gusta."

# game/Story04.rpy:7954

translate spanish story05_5_4_280915bd:

    # k "Makes me feel like I matter to someone."
    k "Me hace sentir que le importa a alguien."

# game/Story04.rpy:7955

translate spanish story05_5_4_43c1f242:

    # k "Like someone was actually afraid to lose me."
    k "Como si alguien tuviera miedo de perderme."

# game/Story04.rpy:7960

translate spanish story05_5_4_278af78f:

    # k "(whispering) Where are we?"
    k "¿Dónde estamos?"

# game/Story04.rpy:7962

translate spanish story05_5_4_0ffe9dab:

    # mc "Still working on that."
    mc "Sigue trabajando en eso."

# game/Story04.rpy:7963

translate spanish story05_5_4_d645cf27:

    # mc "There’s a strong chance we were thrown backward."
    mc "Hay una fuerte posibilidad de que nos despidieran."

# game/Story04.rpy:7964

translate spanish story05_5_4_1fecf7ef:

    # mc "In time."
    mc "A tiempo."

# game/Story04.rpy:7966

translate spanish story05_5_4_26ee2b70:

    # k "(whispering) Wasn’t it a little early to trust them?"
    k "¿No era un poco temprano para confiar en ellos?"

# game/Story04.rpy:7968

translate spanish story05_5_4_08b08bf4:

    # mc "I wasn’t given much of a choice."
    mc "No me dieron mucha elección."

# game/Story04.rpy:7969

translate spanish story05_5_4_7477892d:

    # mc "But they haven’t shown aggression."
    mc "Pero no han mostrado agresión."

# game/Story04.rpy:7971

translate spanish story05_5_4_61651870:

    # k "Which somehow makes it worse."
    k "Lo cual de alguna manera lo empeora."

# game/Story04.rpy:7973

translate spanish story05_5_4_caf9ce28:

    # mc "They saved you."
    mc "Te salvaron."

# game/Story04.rpy:7974

translate spanish story05_5_4_4ad6cc31:

    # mc "That earns them… a fraction of trust."
    mc "Eso los gana... una fracción de confianza."

# game/Story04.rpy:7978

translate spanish story05_5_4_f8ba76d7:

    # k "Alright. If you say so."
    k "Si tú lo dices."

# game/Story04.rpy:7979

translate spanish story05_5_4_66658c40:

    # k "Just… don’t lose your head over them."
    k "No pierdas la cabeza sobre ellos."

# game/Story04.rpy:7985

translate spanish story05_5_4_8e6cd7ac:

    # mc "Want to look around?"
    mc "¿Quieres mirar por ahí?"

# game/Story04.rpy:7987

translate spanish story05_5_4_b621322b:

    # k "Sure."
    k "Claro."

# game/Story04.rpy:7988

translate spanish story05_5_4_1d6691e5:

    # k "But first, I need new clothes."
    k "Pero primero, necesito ropa nueva."

# game/Story04.rpy:7990

translate spanish story05_5_4_2f85716f:

    # k "And a bath."
    k "Y un baño."

# game/Story04.rpy:7992

translate spanish story05_5_4_4484b017:

    # k "Want to check if I smell?"
    k "¿Quieres comprobar si huelo?"

# game/Story04.rpy:7994

translate spanish story05_5_4_4f22aa68:

    # mc "I’ll pass."
    mc "Pasaré."

# game/Story04.rpy:8003

translate spanish story05_5_4_6fd55b0d:

    # keep3 "These lands once shone brighter than stars."
    keep3 "Estas tierras una vez brillaron más que estrellas."

# game/Story04.rpy:8004

translate spanish story05_5_4_7fe9aa84:

    # keep3 "Now it’s rubble and ghosts."
    keep3 "Ahora son escombros y fantasmas."

# game/Story04.rpy:8005

translate spanish story05_5_4_2538b566:

    # keep3 "Looking at it… you start wondering."
    keep3 "Míralo... empiezas a preguntarte."

# game/Story04.rpy:8006

translate spanish story05_5_4_2cc908df:

    # keep3 "What exactly are we living for?"
    keep3 "¿Para qué estamos viviendo?"

# game/Story04.rpy:8007

translate spanish story05_5_4_b851516e:

    # mc "Philosophy? I thought you preferred numbers and probability curves."
    mc "Pensé que preferías números y curvas de probabilidad."

# game/Story04.rpy:8009

translate spanish story05_5_4_a77f82fb:

    # keep3 "Science answers ‘how.’ Philosophy asks why ‘how’ is possible at all."
    keep3 "La ciencia responde ‘cómo’. La filosofía pregunta por qué ‘cómo’ es posible en absoluto."

# game/Story04.rpy:8010

translate spanish story05_5_4_b14ddca7:

    # mc "Mm."
    mc "Mm."

# game/Story04.rpy:8012

translate spanish story05_5_4_e59fb131:

    # mc "And we’re still short on answers."
    mc "Y aún estamos cortos de respuestas."

# game/Story04.rpy:8014

translate spanish story05_5_4_0085e033_1:

    # keep3 "..."
    keep3 "..."

# game/Story04.rpy:8015

translate spanish story05_5_4_8b0267d8:

    # keep3 "Knowing what you know now."
    keep3 "Sabiendo lo que sabes ahora."

# game/Story04.rpy:8016

translate spanish story05_5_4_f781bf88:

    # keep3 "Would you have chosen differently?"
    keep3 "¿Habrías elegido de otra manera?"

# game/Story04.rpy:8018

translate spanish story05_5_4_c9437d53:

    # mc "So it didn’t just get under Gorem’s skin."
    mc "Así que no se puso bajo la piel de Gorem."

# game/Story04.rpy:8019

translate spanish story05_5_4_85ba66cd:

    # mc "It got under yours too."
    mc "También se puso bajo la tuya."

# game/Story04.rpy:8021

translate spanish story05_5_4_4cfbc93b:

    # keep3 "I require data."
    keep3 "Requiero datos."

# game/Story04.rpy:8022

translate spanish story05_5_4_c3036850:

    # keep3 "For protocol."
    keep3 "Para protocolo."

# game/Story04.rpy:8024

translate spanish story05_5_4_f2d8d622:

    # mc "Would I chase after Lora again?"
    mc "¿Me perseguiría por Lora otra vez?"

# game/Story04.rpy:8025

translate spanish story05_5_4_823ad40a:

    # mc "Without hesitation."
    mc "Sin dudarlo."

# game/Story04.rpy:8026

translate spanish story05_5_4_2dce3ab0:

    # mc "But…"
    mc "Pero..."

# game/Story04.rpy:8027

translate spanish story05_5_4_4fbd0e85:

    # mc "I would’ve left Olivia and Norman at home."
    mc "Habría dejado a Olivia y a Norman en casa."

# game/Story04.rpy:8028

translate spanish story05_5_4_b77e56b1:

    # mc "Dragging them into this…"
    mc "Arrastrandolos en esto..."

# game/Story04.rpy:8029

translate spanish story05_5_4_fe6b3505:

    # mc "That was my mistake."
    mc "Fue mi error."

# game/Story04.rpy:8031

translate spanish story05_5_4_07570835:

    # keep3 "You would jeopardize the overall success rate."
    keep3 "Usted arriesgaría la tasa de éxito global."

# game/Story04.rpy:8032

translate spanish story05_5_4_ddd27e90:

    # keep3 "For two lives."
    keep3 "Por dos vidas."

# game/Story04.rpy:8034

translate spanish story05_5_4_cbd56881:

    # keep3 "You truly are irrational."
    keep3 "Realmente eres irracional."

# game/Story04.rpy:8036

translate spanish story05_5_4_ca24eca6:

    # mc "Human."
    mc "Humano."

# game/Story04.rpy:8037

translate spanish story05_5_4_17077d47:

    # mc "We’re built that way."
    mc "Estamos construidos de esa manera."

# game/Story04.rpy:8040

translate spanish story05_5_4_a0ecb67e:

    # k "Talking to that shady voice in your head again?"
    k "¿Hablando con esa voz de sombra en tu cabeza otra vez?"

# game/Story04.rpy:8041

translate spanish story05_5_4_0d2aa6a5:

    # mc "Helps me stay sane."
    mc "Me ayuda a permanecer sano."

# game/Story04.rpy:8044

translate spanish story05_5_4_aa60ab2c:

    # mc "Where did you get the clothes?"
    mc "¿Dónde conseguiste la ropa?"

# game/Story04.rpy:8045

translate spanish story05_5_4_5cde6623:

    # k "The pointy-eared hospitality committee left me a few options."
    k "El comité de hospitalidad de punta me dejó algunas opciones."

# game/Story04.rpy:8046

translate spanish story05_5_4_e7431764:

    # k "But enough about that."
    k "Pero suficiente con eso."

# game/Story04.rpy:8047

translate spanish story05_5_4_ba745ebe:

    # k "Well?"
    k "¿Y bien?"

# game/Story04.rpy:8050

translate spanish story05_5_4_a8749ff3:

    # mc "It suits you."
    mc "Te queda bien."

# game/Story04.rpy:8055

translate spanish story05_5_4_cf3000e2:

    # k "I’ll take that."
    k "Yo me encargaré de eso."

# game/Story04.rpy:8056

translate spanish story05_5_4_b970f6ec:

    # k "Now."
    k "Ahora."

# game/Story04.rpy:8057

translate spanish story05_5_4_d858f62d:

    # k "Let’s figure out how to get out of here."
    k "Vamos a averiguar cómo salir de aquí."

# game/Story04.rpy:8059

translate spanish story05_5_4_8809c596:

    # mc "Eager for another hole in your chest?"
    mc "¿Eager para otro agujero en el pecho?"

# game/Story04.rpy:8062

translate spanish story05_5_4_f110a669:

    # k "Oh, screw you."
    k "Oh, a la mierda."

# game/Story04.rpy:8067

translate spanish story05_5_4_4b6206da:

    # k "(half-singing)"
    k "(half-singinging)"

# game/Story04.rpy:8068

translate spanish story05_5_4_075df0d9:

    # k "You know… I was thinking."
    k "Sabes... estaba pensando."

# game/Story04.rpy:8069

translate spanish story05_5_4_9ca77993:

    # k "What about our little runaways?"
    k "¿Qué hay de nuestros pequeños fugitivos?"

# game/Story04.rpy:8070

translate spanish story05_5_4_deb9a320:

    # mc "No idea."
    mc "Ni idea."

# game/Story04.rpy:8071

translate spanish story05_5_4_ec487437:

    # mc "But I’d like to believe they’re still breathing."
    mc "Pero me gustaría creer que todavía están respirando."

# game/Story04.rpy:8072

translate spanish story05_5_4_6f413137:

    # k "That’s the spirit."
    k "Ese es el espíritu."

# game/Story04.rpy:8074

translate spanish story05_5_4_4d1cdddc:

    # k "But one thing’s bothering me."
    k "Pero una cosa me está molestando."

# game/Story04.rpy:8075

translate spanish story05_5_4_6687f943:

    # k "Why didn’t Selvaria finish you?"
    k "¿Por qué no te terminó Selvaria?"

# game/Story04.rpy:8076

translate spanish story05_5_4_d440cdaf:

    # k "You’re not exactly a legendary hero."
    k "No eres exactamente un héroe legendario."

# game/Story04.rpy:8077

translate spanish story05_5_4_daa7a4c8:

    # mc "Astoria intervened."
    mc "Astoria intervino."

# game/Story04.rpy:8079

translate spanish story05_5_4_c59b958e:

    # k "The young Lady, I understood."
    k "La joven dama, lo entendí."

# game/Story04.rpy:8080

translate spanish story05_5_4_38df819a:

    # k "We were… aligned."
    k "Estábamos... alineados."

# game/Story04.rpy:8082

translate spanish story05_5_4_482fec83:

    # k "But the Lady?"
    k "¿Pero la Señora?"

# game/Story04.rpy:8083

translate spanish story05_5_4_f60ead9c:

    # k "Her motives were always a riddle to me."
    k "Sus motivos siempre eran un enigma para mí."

# game/Story04.rpy:8086

translate spanish story05_5_4_1b95d582:

    # k "I still don’t get why she didn’t deal with that blonde."
    k "Todavía no entiendo por qué no se ocupó de esa rubia."

# game/Story04.rpy:8087

translate spanish story05_5_4_4b9a4c0d:

    # mc "Since when does a member of the Inquisition question her superiors?"
    mc "¿Desde cuándo un miembro de la Inquisición cuestiona a sus superiores?"

# game/Story04.rpy:8089

translate spanish story05_5_4_31e9f8f4:

    # k "Ah."
    k "Ah."

# game/Story04.rpy:8090

translate spanish story05_5_4_e56591ad:

    # k "I’ve been suspended from the Inquisition."
    k "He sido suspendida de la Inquisición."

# game/Story04.rpy:8093

translate spanish story05_5_4_9855b7e4:

    # mc "Wait. What?"
    mc "Espera. ¿Qué?"

# game/Story04.rpy:8094

translate spanish story05_5_4_d9426b9f:

    # k "Oh. I didn’t mean—"
    k "No quise decir..."

# game/Story04.rpy:8097

translate spanish story05_5_4_82091822_1:

    # k "..."
    k "..."

# game/Story04.rpy:8101

translate spanish story05_5_4_3dc0a602:

    # k "That was Miriel."
    k "Era Miriel."

# game/Story04.rpy:8102

translate spanish story05_5_4_8a5e85c5:

    # k "Wasn’t it?"
    k "¿No fue así?"

# game/Story04.rpy:8104

translate spanish story05_5_4_3876fc4c:

    # mc "No doubt."
    mc "Sin duda."

# game/Story04.rpy:8108

translate spanish story05_5_4_52fa8a48:

    # mc "After her."
    mc "Después de ella."

# game/Story04.rpy:8122

translate spanish story05_5_4_af5eede9:

    # mc "What did you mean… by distancing?"
    mc "¿Qué querías decir con... con el distanciamiento?"

# game/Story04.rpy:8123

