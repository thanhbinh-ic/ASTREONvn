translate spanish story05_5_1_ca4dcf31:

    # k "(God, she’s irritating.)"
    k "(Dios, ella es irritante.)"

# game/Story04.rpy:5664

translate spanish story05_5_1_82091822:

    # k "..."
    k "..."

