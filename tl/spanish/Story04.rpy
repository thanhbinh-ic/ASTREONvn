    # mc "Boring? And how many people have you told it to?"
    mc "¿Y a cuánta gente se lo has dicho?"

# game/Story04.rpy:865

translate spanish story05_2_065dffa4:

    # k "(An orphanage where the strong did whatever they wanted, and the weak only learned how to obey.)"
    k "(Un orfanato donde los fuertes hicieron lo que querían, y los débiles solo aprendieron a obedecer.)"

# game/Story04.rpy:922

translate spanish story05_2_a774496d:

    # k "(Still, my heart was always set on something else.)"
    k "(Hasta luego, mi corazón siempre estaba puesto en otra cosa.)"

# game/Story04.rpy:1112

translate spanish story05_2_c73d6ed4:

    # mc "(So then, how did you end up there?)"
    mc "(Entonces, ¿cómo terminaste ahí arriba?)"

# game/Story04.rpy:1146

translate spanish story05_2_723d6d90:

    # mc "(And yet somehow, you still managed to pull it off.)"
    mc "(Y de alguna manera, todavía lograste sacarlo de encima)."

# game/Story04.rpy:1149

translate spanish story05_2_77d73e48:

    # k "(Yeah. But not alone. If I’m being honest, I’d have quit a long time ago by myself.)"
    k "(Sí. Pero no solo. Si soy honesto, habría renunciado hace mucho tiempo por mí mismo.)"

# game/Story04.rpy:1996

translate spanish story05_3_cc4b9c1c:

    # sel "Exactly."
    sel "Exactamente."

# game/Story04.rpy:2027

translate spanish story05_3_7c6714c8:

    # am "I acted for the Federation’s sake."
    am "Actué por el bien de la Federación."

# game/Story04.rpy:2316

translate spanish story05_3_c2b4ba9a:

    # Evrel "In that sense… I guess I won the lottery at birth."
    Evrel "En ese sentido... supongo que gané la lotería al nacer."

# game/Story04.rpy:2645

translate spanish story05_4_4bbde761:

    # mc "(sigh) Let’s just continue, alright?"
    mc "(Suspira) Vamos a continuar, ¿de acuerdo?"

# game/Story04.rpy:2825

translate spanish story05_4_5d975f40:

    # L "(It didn’t happen right away.)"
    L "(No sucedió de inmediato.)"

# game/Story04.rpy:2826

translate spanish story05_4_79c26add:

    # L "(On the fourth attempt, I noticed something in the distance. What exactly it was, I still don’t know.)"
    L "(En el cuarto intento, noté algo en la distancia. Lo que exactamente era, todavía no lo sé.)"

# game/Story04.rpy:3725

translate spanish story05_6_a2eea7d6:

    # k "Oh, listen to that tone. I’ve heard plenty about your kind from Evrelia. Hypocritical bastards, the lot of you."
    k "Escucha ese tono. He oído mucho sobre tu tipo de Evrelia. Hijos de puta hipócrita, el montón de ustedes."

# game/Story04.rpy:3806

translate spanish story05_6_82109004:

    # k "But don’t get it twisted, those pills aren’t a miracle."
    k "Pero no lo torcen, esas pastillas no son un milagro."

# game/Story04.rpy:3886

translate spanish story05_6_a67878c8:

    # h "(Yeah, yeah, I know how that probably sounds… but still.)"
    h "(Sí, sí, sé cómo suena eso... pero aún así.)"

# game/Story04.rpy:4376

translate spanish story05_7_8e4d4ddf:

    # k "All this drama with the Abyss, Evrelia… nonsense."
    k "Todo este drama con el Abyss, Evrelia... tonterías."

# game/Story04.rpy:4593

translate spanish story05_8_dd171ae6:

    # k "Feels like we do. There’s a Keeper’s corpse lying around. And not just one."
    k "Se siente como si lo hiciéramos. Hay un cuerpo de Guardián que está acostado alrededor. Y no solo uno."

translate spanish story05_2_1_7406d106:

    # mc "...Let go."
    mc "...Suéltame."

# game/Story04.rpy:1750

translate spanish story05_2_1_6daa0f7f:

    # k "Huh?"
    k "¿Eh?"

# game/Story04.rpy:1753

translate spanish story05_2_1_773978a9:

    # mc "Fight’s over."
    mc "La pelea terminó."

# game/Story04.rpy:1756

translate spanish story05_2_1_1670fffa:

    # k "Oh come on."
    k "Vamos."

# game/Story04.rpy:1757

translate spanish story05_2_1_9a1a618e:

    # k "Don’t tell me you went soft all of a sudden."
    k "No me digas que te has vuelto blando de repente."

# game/Story04.rpy:1759

translate spanish story05_2_1_052b9d98:

    # mc "You’re not asking for sex."
    mc "No estás pidiendo sexo."

# game/Story04.rpy:1760

translate spanish story05_2_1_dcd86e92:

    # k "Oh?"
    k "¿Oh?"

# game/Story04.rpy:1763

translate spanish story05_2_1_aaea87a4:

    # mc "You’re trying to drown something."
    mc "Estás tratando de ahogar algo."

# game/Story04.rpy:1764

translate spanish story05_2_1_599517b2:

    # mc "Rage. Pain. Whatever the hell is eating you."
    mc "Dolor, lo que sea que te esté comiendo."

# game/Story04.rpy:1766

translate spanish story05_2_1_812bfe69:

    # k "Heh…"
    k "Heh..."

# game/Story04.rpy:1767

translate spanish story05_2_1_f22af00f:

    # k "Listen to him."
    k "Escúchalo."

# game/Story04.rpy:1770

translate spanish story05_2_1_d22d57d3:

    # mc "Find another way."
    mc "Encuentra otra manera."

# game/Story04.rpy:1772

translate spanish story05_2_1_11d1e271:

    # k "You think I haven’t tried?"
    k "¿Crees que no lo he intentado?"

# game/Story04.rpy:1774

translate spanish story05_2_1_4263c7a6:

    # mc "Then try harder."
    mc "Entonces intenta más duro."

# game/Story04.rpy:1776

translate spanish story05_2_1_25e9ecea:

    # k "...You’re serious."
    k "...Hablas en serio."

# game/Story04.rpy:1779

translate spanish story05_2_1_30b16ff9:

    # mc "Dead serious."
    mc "Muerto en serio."

# game/Story04.rpy:1780

translate spanish story05_2_1_f97c5a43:

    # k "Wow."
    k "Vaya."

# game/Story04.rpy:1781

translate spanish story05_2_1_9c2a3dfd:

    # k "Your wife must be one hell of a woman."
