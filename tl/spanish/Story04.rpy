translate spanish story05_5_1_f22e501d:

    # L "And you…"
    L "Y tú..."

# game/Story04.rpy:5599

translate spanish story05_5_1_d3c13a03:

    # L "Losing you tore me apart."
    L "Perderme me destrozaste."

# game/Story04.rpy:5601

translate spanish story05_5_1_df52e483:

    # mc "(whispering) Selfish bastard, huh."
    mc "Hijo de puta egoísta, ¿eh?"

