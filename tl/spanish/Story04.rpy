translate spanish story05_5_3_6465145d:

    # "A few minutes later."
    "Unos minutos más tarde."

# game/Story04.rpy:6868

translate spanish story05_5_3_b0bd7532:

    # keep3 "That was reckless."
    keep3 "Eso fue imprudente."

# game/Story04.rpy:6870

translate spanish story05_5_3_379fcd6e:

    # mc "You think?"
    mc "¿Tú crees?"

# game/Story04.rpy:6872

translate spanish story05_5_3_f0495824:

    # keep3 "Ripping it out of your head wasn’t rational."
    keep3 "Sacarlo de tu cabeza no era racional."

# game/Story04.rpy:6874

translate spanish story05_5_3_28d51d64:

    # mc "Her life was on the line."
    mc "Su vida estaba en juego."

# game/Story04.rpy:6876

translate spanish story05_5_3_0085e033:

    # keep3 "..."
    keep3 "..."

# game/Story04.rpy:6878

translate spanish story05_5_3_05f296f2:

    # keep3 "Next time, think it through."
    keep3 "La próxima vez, piensa en ello."

