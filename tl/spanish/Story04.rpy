    # a "Looks like an old elven colony. According to my estimates, it’s still operational."
    a "Parece una antigua colonia de elvenidos. Según mis estimaciones, todavía está en funcionamiento."

# game/Story04.rpy:6813

translate spanish story05_5_3_f3c80748:

    # mc "…Damn."
    mc "...Damn."

# game/Story04.rpy:6815

translate spanish story05_5_3_d6f139da:

    # mc "You’re sure?"
    mc "¿Estás seguro?"

# game/Story04.rpy:6817

translate spanish story05_5_3_3caacb87:

    # mc "Another fight would be a terrible idea."
    mc "Otra pelea sería una idea terrible."

# game/Story04.rpy:6818

translate spanish story05_5_3_ec04b38a:

    # mc "Especially with Kali in this state."
    mc "Especialmente con Kali en este estado."

# game/Story04.rpy:6821

translate spanish story05_5_3_fd4a9a24:

    # a "Elves are a peaceful people. They won’t strike first."
    a "Los elfos son una gente pacífica. No atacarán primero."

# game/Story04.rpy:6823

translate spanish story05_5_3_c6240259:

    # mc "Did you forget? We fought the elven Empress just hours ago."
    mc "Nos peleamos con la Emperatriz Elven hace horas."

# game/Story04.rpy:6824

translate spanish story05_5_3_c27fc1d9:

    # mc "And we were the ones defending ourselves."
    mc "Y nosotros éramos los que nos defendíamos."

# game/Story04.rpy:6827

translate spanish story05_5_3_ebb0a465:

    # a "Her methods… were an exception."
    a "Sus métodos eran una excepción."

# game/Story04.rpy:6828

translate spanish story05_5_3_2b35b6fe:

    # mc "..."
    mc "..."

# game/Story04.rpy:6832

translate spanish story05_5_3_15d70db1:

    # mc "(I need to scout the area.)"
    mc "(Necesito explorar la zona.)"

# game/Story04.rpy:6833

translate spanish story05_5_3_97f37e66:

    # mc "(If possible, find food… and somewhere better.)"
    mc "(Si es posible, encuentra comida... y en algún lugar mejor.)"

# game/Story04.rpy:6835

translate spanish story05_5_3_e7546dee:

    # mc "(And at the same time, leaving her alone…)"
    mc "(Y al mismo tiempo, dejándola sola...)"

# game/Story04.rpy:6840

translate spanish story05_5_3_0205cfee:

    # mc "She’s burning up."
    mc "Está ardiendo."

# game/Story04.rpy:6842

translate spanish story05_5_3_ff3701fd:

    # a "Her body is fighting the miasma."
    a "Su cuerpo está luchando contra el miasma."

# game/Story04.rpy:6843

translate spanish story05_5_3_d274206f:

    # a "That’s a good sign."
    a "Es una buena señal."

# game/Story04.rpy:6844

translate spanish story05_5_3_5e2b3f7d:

    # mc "I hope so."
    mc "Eso espero."

# game/Story04.rpy:6847

translate spanish story05_5_3_4ed11fbb:

    # k "…no… I don’t want to…"
    k "...no... no quiero..."

# game/Story04.rpy:6848

translate spanish story05_5_3_eb224a77:

    # k "die…"
    k "morir..."

# game/Story04.rpy:6851

translate spanish story05_5_3_23e8e176:

    # mc "Easy. Easy."
    mc "Tranquilo."

# game/Story04.rpy:6852

translate spanish story05_5_3_96544da9:

    # mc "It’s alright. You’re doing fine."
    mc "Está bien. Lo estás haciendo bien."

# game/Story04.rpy:6854

translate spanish story05_5_3_6c49bb40:

    # mc "You will."
    mc "Lo harás."

# game/Story04.rpy:6855

translate spanish story05_5_3_0a4dbc8d:

    # mc "I promise."
    mc "Lo prometo."

# game/Story04.rpy:6859

translate spanish story05_5_3_448bd79c:

    # mc "An elven colony, then…"
    mc "Una colonia de elvenes, entonces..."

# game/Story04.rpy:6860

translate spanish story05_5_3_efdbf2a4:

    # mc "Tell me, could they help us?"
    mc "Dime, ¿podrían ayudarnos?"

# game/Story04.rpy:6862

translate spanish story05_5_3_91d8b70a:

    # a "The probability is extremely low."
    a "La probabilidad es extremadamente baja."

# game/Story04.rpy:6863

translate spanish story05_5_3_4f5dac8c:

    # a "But not zero, if we play this right."
    a "Pero no cero, si jugamos bien."

