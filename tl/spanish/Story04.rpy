# game/Story04.rpy:8779

translate spanish story05_5_5_8b6929ae:

    # k "(whispering) Since when?"
    k "¿Desde cuándo?"

# game/Story04.rpy:8781

translate spanish story05_5_5_2722f776:

    # mc "(whispering) Don’t know."
    mc "No lo sé."

# game/Story04.rpy:8782

translate spanish story05_5_5_3aaa359c:

    # mc "(whispering) But if I had to guess? Since the very beginning."
    mc "Pero si tuviera que adivinar desde el principio."

# game/Story04.rpy:8785

translate spanish story05_5_5_5afb78b0:

    # k "(whispering) And him?"
    k "¿Y él?"

# game/Story04.rpy:8787

translate spanish story05_5_5_5829017a:

    # mc "(whispering) He’s under the same pressure."
    mc "Está bajo la misma presión."

# game/Story04.rpy:8788

translate spanish story05_5_5_a82e90ba:

    # mc "(whispering) Careful with every word."
    mc "Cuidado con cada palabra."

# game/Story04.rpy:8790

translate spanish story05_5_5_7349cb49:

    # k "(whispering) I hate this political chess nonsense."
    k "Odio esta tontería política de ajedrez."

# game/Story04.rpy:8791

translate spanish story05_5_5_2108e5a2:

    # k "(whispering) Everyone smiling. No one saying what they mean."
    k "Todos sonriendo, nadie que diga lo que quieren decir."

# game/Story04.rpy:8794

translate spanish story05_5_5_b4388f8f:

    # y "Inside."
    y "Dentro."

# game/Story04.rpy:8805

translate spanish story05_5_5_8b890323:

    # y "Make yourselves at home."
    y "Hazte como en casa."

# game/Story04.rpy:8806

translate spanish story05_5_5_6304a6e2:

    # y "No one should be listening here."
    y "Nadie debería estar escuchando aquí."

# game/Story04.rpy:8808

translate spanish story05_5_5_3157fd0e:

    # k "(whispering) Gods… smells like a rat bloated and burst in here."
    k "Dioses... huele a rata hinchada y estallada aquí."

# game/Story04.rpy:8816

translate spanish story05_5_5_86edd8ea:

    # y "And?"
    y "¿Y?"

# game/Story04.rpy:8817

translate spanish story05_5_5_08691a54:

    # y "What happened?"
    y "¿Qué pasó?"

# game/Story04.rpy:8820

translate spanish story05_5_5_ec5b37b1:

    # mc "So you don’t know?"
    mc "¿Así que no lo sabes?"

# game/Story04.rpy:8821

translate spanish story05_5_5_d2560fbd:

    # y "Only fragments."
    y "Solo fragmentos."

# game/Story04.rpy:8822

translate spanish story05_5_5_4347ee5c:

    # y "Echoes from past lives."
    y "Ecos de vidas pasadas."

# game/Story04.rpy:8823

translate spanish story05_5_5_e0b1af56:

    # mc "Then…"
    mc "Entonces..."

# game/Story04.rpy:8829

translate spanish story05_5_5_ce5f8560:

    # mc "And that’s how we ended up here."
    mc "Y así es como terminamos aquí."

# game/Story04.rpy:8834

translate spanish story05_5_5_6b0e8b9e:

    # y "(whispering) Why didn’t it work…"
    y "¿Por qué no funcionó?"

# game/Story04.rpy:8838

translate spanish story05_5_5_be9161c2:

    # mc "Can I ask you something?"
    mc "¿Puedo preguntarte algo?"

# game/Story04.rpy:8840

translate spanish story05_5_5_d912100d:

    # y "Go on."
    y "Vamos."

# game/Story04.rpy:8842

translate spanish story05_5_5_7aa6836c:

    # mc "What’s the point?"
    mc "¿Cuál es el punto?"

# game/Story04.rpy:8846

translate spanish story05_5_5_f41269fd:

    # y "Look to your left."
    y "Mira a tu izquierda."

# game/Story04.rpy:8847

translate spanish story05_5_5_929fd42b:

    # y "What do you see?"
    y "¿Qué ves?"

# game/Story04.rpy:8851

translate spanish story05_5_5_7aad403a:

    # mc "What’s the trick?"
    mc "¿Cuál es el truco?"

# game/Story04.rpy:8860

translate spanish story05_5_5_3efa6665:

    # y "How is she different from us?"
    y "¿Cómo es diferente de nosotros?"

# game/Story04.rpy:8862

translate spanish story05_5_5_3e2bc1d1:

    # y "She, and so many others, never had the chance to change their future."
    y "Ella, y muchos otros, nunca tuvo la oportunidad de cambiar su futuro."

# game/Story04.rpy:8866

translate spanish story05_5_5_453e2cb0:

    # y "It all began the moment Eldrindor activated the Gate."
    y "Todo comenzó el momento en que Eldrindor activó la Puerta."

# game/Story04.rpy:8868

translate spanish story05_5_5_fd08e30b:

    # mc "Eldrindor?"
    mc "¿Eldrindor?"

# game/Story04.rpy:8870

translate spanish story05_5_5_66390db7:

    # y "The scientist every elf curses."
    y "El científico de todas las maldiciones del elfo."

# game/Story04.rpy:8872

translate spanish story05_5_5_84d67ffc:

    # mc "Gorem’s grandfather."
    mc "El abuelo de Gorem."

# game/Story04.rpy:8874

translate spanish story05_5_5_fff2d6da:

    # y "Yes."
    y "Sí."

# game/Story04.rpy:8875

translate spanish story05_5_5_408ad506:

    # y "He was the one who launched the Gate system."
    y "Fue el que lanzó el sistema Gate."

# game/Story04.rpy:8877

translate spanish story05_5_5_5177038e:

    # mc "And half the galaxy vanished."
    mc "Y la mitad de la galaxia desapareció."

# game/Story04.rpy:8878

translate spanish story05_5_5_31a38550:

    # mc "Gorem mentioned that."
    mc "Gorem lo mencionó."

# game/Story04.rpy:8889

translate spanish story05_5_5_9f47a418:

    # y "Good."
    y "Bien."

# game/Story04.rpy:8890

translate spanish story05_5_5_86933dea:

    # y "Then answer me this."
    y "Entonces responda esto."

# game/Story04.rpy:8891

translate spanish story05_5_5_9da23bc0:

    # y "What did the system actually do?"
    y "¿Qué hizo el sistema?"

# game/Story04.rpy:8893

translate spanish story05_5_5_edc77061:

    # mc "They teleport."
    mc "Les teletransportan."

# game/Story04.rpy:8895

translate spanish story05_5_5_3fefb349:

    # y "Those are the Gates. I’m asking about the system that links them."
    y "Esas son las Puertas. Estoy preguntando por el sistema que los vincula."

# game/Story04.rpy:8897

translate spanish story05_5_5_4bbf92b2:

    # mc "It stopped time."
    mc "Detuvo el tiempo."

# game/Story04.rpy:8898

translate spanish story05_5_5_b6d2441b:

    # mc "For a few seconds."
    mc "Por unos segundos."

# game/Story04.rpy:8900

translate spanish story05_5_5_090b7094:

    # y "Half a second."
    y "Medio segundo."

# game/Story04.rpy:8901

translate spanish story05_5_5_aa3cf533:

    # y "At the cost of half a galaxy?"
    y "¿A costa de media galaxia?"

# game/Story04.rpy:8903

translate spanish story05_5_5_16c59d4c:

    # y "An absurd price…"
    y "Un precio absurdo..."

# game/Story04.rpy:8904

translate spanish story05_5_5_0f8bbbbb:

    # y "for half a second."
    y "por medio segundo."

# game/Story04.rpy:8906

translate spanish story05_5_5_d4f78dbd:

    # mc "Paying in lives is absurd to begin with."
    mc "Pagar en vidas es absurdo comenzar con."

# game/Story04.rpy:8911

translate spanish story05_5_5_92539b77:

    # y "Perhaps."
    y "Tal vez."

# game/Story04.rpy:8912

translate spanish story05_5_5_949cb4ce:

    # y "But the time freeze was only the visible consequence."
    y "Pero la congelación de tiempo era solo la consecuencia visible."

# game/Story04.rpy:8913

translate spanish story05_5_5_9766d763:

    # y "The real function was something else."
    y "La función real era otra cosa."

# game/Story04.rpy:8915

translate spanish story05_5_5_79ba89cc:

    # y "It created a cycle."
    y "Creó un ciclo."

# game/Story04.rpy:8916

translate spanish story05_5_5_849e6cf4:

    # y "The Gate established a fixed point in the universe, a boundary we cannot cross."
    y "La Puerta estableció un punto fijo en el universo, un límite que no podemos cruzar."

# game/Story04.rpy:8918

translate spanish story05_5_5_b6b1024b:

    # y "It stripped everyone of choice."
    y "Despojó a todos los que lo escogieron."

# game/Story04.rpy:8919

translate spanish story05_5_5_ec943f5e:

    # y "Future. Past. Doesn’t matter."
    y "Futuro. Pasado. No importa."

# game/Story04.rpy:8920

translate spanish story05_5_5_4a0b047d:

    # y "Everything begins at one point…"
    y "Todo comienza en un punto..."

# game/Story04.rpy:8921

translate spanish story05_5_5_65e73399:

    # y "and ends the same way."
    y "y termina de la misma manera."

# game/Story04.rpy:8923

translate spanish story05_5_5_ecf872dc:

    # mc "Wait."
    mc "Espera."

# game/Story04.rpy:8924

translate spanish story05_5_5_1b41c7d4:

    # mc "You’re saying us being here… was planned?"
    mc "¿Estás diciendo que estamos aquí... estaba planeado?"

# game/Story04.rpy:8926

translate spanish story05_5_5_c17f6616:

    # y "That’s the difference."
    y "Esa es la diferencia."

# game/Story04.rpy:8927

translate spanish story05_5_5_ea53f9a1:

    # y "We can’t break the principle."
    y "No podemos romper el principio."

# game/Story04.rpy:8928

translate spanish story05_5_5_3b68130b:

    # y "But you can."
    y "Pero puedes."

# game/Story04.rpy:8930

translate spanish story05_5_5_51c5f03b:

    # mc "Can I?"
    mc "¿Puedo?"

# game/Story04.rpy:8931

translate spanish story05_5_5_89fc4ac9:

    # mc "And what makes you so certain?"
    mc "¿Y qué te hace tan seguro?"

# game/Story04.rpy:8933

translate spanish story05_5_5_f8dfc242:

    # y "Because you’re here."
    y "Porque estás aquí."

# game/Story04.rpy:8935

translate spanish story05_5_5_243907d7:

    # mc "What are you—"
    mc "¿Qué estás...?"

# game/Story04.rpy:8937

translate spanish story05_5_5_1652721c:

    # y "Astoria relives the loss of her sister."
    y "Astoria revivió la pérdida de su hermana."

# game/Story04.rpy:8938

translate spanish story05_5_5_8a928548:

    # y "Evreliya walks into the same tomb again and again."
    y "Evreliya entra en la misma tumba una y otra vez."

# game/Story04.rpy:8939

translate spanish story05_5_5_a7f460fd:

    # y "Selvaria keeps killing her father."
    y "Selvaria sigue matando a su padre."

# game/Story04.rpy:8940

translate spanish story05_5_5_2c016249:

    # y "And Lora…"
    y "Y Lora..."

# game/Story04.rpy:8941

translate spanish story05_5_5_0ab28a11:

    # y "She keeps trying to keep you alive."
    y "Ella sigue tratando de mantenerte vivo."

# game/Story04.rpy:8943

translate spanish story05_5_5_fb4d0fde:

    # mc "(So all my wife’s suffering was… for nothing?)"
    mc "(¿Así que todo el sufrimiento de mi esposa fue... por nada?)"

# game/Story04.rpy:8945

translate spanish story05_5_5_91905ede:

    # mc "How?"
    mc "¿Cómo?"

# game/Story04.rpy:8947

translate spanish story05_5_5_1c881d34:

    # y "Motives change."
    y "Los movimientos cambian."

# game/Story04.rpy:8948

translate spanish story05_5_5_6d385f12:

    # y "The outcome doesn’t."
    y "El resultado no lo hace."

# game/Story04.rpy:8949

translate spanish story05_5_5_14fdb0b8:

    # y "What’s needed is power from outside the thread of time."
    y "Lo que se necesita es poder desde fuera del hilo del tiempo."

# game/Story04.rpy:8951

translate spanish story05_5_5_55b580a5:

    # mc "So when you said ‘the key’…"
    mc "Así que cuando dijiste \"la llave\"..."

# game/Story04.rpy:8952

translate spanish story05_5_5_36a7a5e5:

    # mc "you meant me."
    mc "Te refieres a mí."

# game/Story04.rpy:8954

translate spanish story05_5_5_df7b27e3:

    # y "There were 378 attempts before you."
    y "Había 378 intentos antes que usted."

# game/Story04.rpy:8955

translate spanish story05_5_5_8ed4a16c:

    # y "But somehow you’ve made it further than any of them."
    y "Pero de alguna manera lo has hecho más lejos que cualquiera de ellos."

# game/Story04.rpy:8957

translate spanish story05_5_5_659ad628:

    # mc "Three hundred seventy-eight…"
    mc "Trescientos setenta y ocho..."

# game/Story04.rpy:8959

translate spanish story05_5_5_66e59d65:

    # "A strained, humorless laugh."
    "Una risa tensa e insensata."

# game/Story04.rpy:8960

translate spanish story05_5_5_eb31b531:

    # mc "That’s cruel."
    mc "Eso es cruel."

# game/Story04.rpy:8961

translate spanish story05_5_5_8348beeb:

    # mc "And how many of those were mine?"
    mc "¿Y cuántos de ellos eran míos?"

# game/Story04.rpy:8962

translate spanish story05_5_5_71a86863:

    # y "..."
    y "..."

# game/Story04.rpy:8963

translate spanish story05_5_5_a12237f7:

    # y "All of them."
    y "Todos."

# game/Story04.rpy:8967

translate spanish story05_5_5_cf8b5120:

    # mc "…again?"
    mc "...¿de nuevo?"

# game/Story04.rpy:8969

translate spanish story05_5_5_3c0df8ab:

    # y "They were yours."
    y "Eran tuyos."

# game/Story04.rpy:8970

translate spanish story05_5_5_2c66875a:

    # y "Every single one."
    y "Cada uno."

# game/Story04.rpy:8972

translate spanish story05_5_5_50e67c79:

    # mc "Cruel."
    mc "Cruel."

# game/Story04.rpy:8973

translate spanish story05_5_5_b8c84b6d:

    # y "You think so?"
    y "¿Tú crees?"

# game/Story04.rpy:8974

translate spanish story05_5_5_92de21c0:

    # y "Many of us would give anything for a fate like yours."
    y "Muchos de nosotros daríamos algo por un destino como el tuyo."

# game/Story04.rpy:8975

translate spanish story05_5_5_c6b8f5e9:

    # y "To forget what we were."
    y "Olvidar lo que éramos."

# game/Story04.rpy:8977

translate spanish story05_5_5_8c943fbf:

    # mc "And Lora?"
    mc "¿Y Lora?"

# game/Story04.rpy:8978

translate spanish story05_5_5_69774c55:

    # mc "She’s like me."
    mc "Es como yo."

# game/Story04.rpy:8979

translate spanish story05_5_5_728c8fd2:

    # mc "So why didn’t she—"
    mc "Entonces, ¿por qué no lo hizo?"

# game/Story04.rpy:8981

translate spanish story05_5_5_c423975e:

    # y "Because of Evrelia."
    y "Por Evrelia."

# game/Story04.rpy:8982

translate spanish story05_5_5_6f40e6d5:

    # y "And her power."
    y "Y su poder."

# game/Story04.rpy:8983

translate spanish story05_5_5_51c99226:

    # mc "(whispering) I don’t understand…"
    mc "No entiendo..."

# game/Story04.rpy:8985

translate spanish story05_5_5_16cd2d0a:

    # y "The Abyss is a consequence of the Gate."
    y "El Abismo es una consecuencia de la Puerta."

# game/Story04.rpy:8986

translate spanish story05_5_5_a75d85de:

    # y "Gain immortality there…"
    y "Gana la inmortalidad allí..."

# game/Story04.rpy:8987

translate spanish story05_5_5_7487b0bd:

    # y "and you lose the ability to leave the cycle."
    y "y pierdes la habilidad de dejar el ciclo."

# game/Story04.rpy:8988

translate spanish story05_5_5_0d5d6af6:

    # y "She’s no different from the rest of us."
    y "No es diferente del resto de nosotros."

# game/Story04.rpy:8990

translate spanish story05_5_5_5a22e5cf:

    # mc "Then I’ll ask two question."
    mc "Entonces haré dos preguntas."

# game/Story04.rpy:8991

translate spanish story05_5_5_0d57af2d:

    # mc "First, what you wanted from me?"
    mc "Primero, ¿qué querías de mí?"

# game/Story04.rpy:8992

translate spanish story05_5_5_6c9fbd01:

    # y "Break the cycle."
    y "Rompe el ciclo."

# game/Story04.rpy:8993

translate spanish story05_5_5_e0bbf01e:

    # mc "Second, what guarantees do I have?"
    mc "Segundo, ¿qué garantías tengo?"

# game/Story04.rpy:9004

translate spanish story05_5_5_d5371a83:

    # y "None."
    y "Ninguno."

# game/Story04.rpy:9007

translate spanish story05_5_5_afb70b29:

    # mc "(So all her suffering…)"
    mc "(Así que todo su sufrimiento...)"

# game/Story04.rpy:9008

translate spanish story05_5_5_fbf53025:

    # mc "(Every attempt to save me. To save Norman.)"
    mc "(Todo intento de salvarme, salvar a Norman.)"

# game/Story04.rpy:9009

translate spanish story05_5_5_fb8ff1c3:

    # mc "(Pointless?)"
    mc "(Indefinido?)"

# game/Story04.rpy:9010

translate spanish story05_5_5_1a68efbd:

    # mc "(And Astoria’s attempts…)"
    mc "(Y los intentos de Astoria...)"

# game/Story04.rpy:9012

translate spanish story05_5_5_71101df6:

    # mc "(whispering) Immortality?"
    mc "¿Inmortalidad?"

# game/Story04.rpy:9013

translate spanish story05_5_5_ae631686:

    # mc "(whispering) Sounds more like eternal imprisonment."
    mc "Suena más como una prisión eterna."

# game/Story04.rpy:9015

translate spanish story05_5_5_e7d887c0:

    # mc "How long has this been going on?"
    mc "¿Cuánto tiempo lleva pasando esto?"

# game/Story04.rpy:9023

translate spanish story05_5_5_71a86863_1:

    # y "..."
    y "..."

# game/Story04.rpy:9025

translate spanish story05_5_5_054c5ee0_1:

    # mc "I see."
    mc "Ya veo."

# game/Story04.rpy:9026

translate spanish story05_5_5_65dfe4e1:

    # mc "Then I refuse."
    mc "Entonces me niego."

# game/Story04.rpy:9034

translate spanish story05_5_5_7d541978:

    # y "Are you certain?"
    y "¿Estás seguro?"

# game/Story04.rpy:9035

translate spanish story05_5_5_17503904:

    # y "You don’t have a choice."
    y "No tienes elección."

# game/Story04.rpy:9037

translate spanish story05_5_5_abe52859:

    # mc "If I’m destined to die either way, what’s the point?"
    mc "Si estoy destinado a morir de cualquier manera, ¿cuál es el punto?"

# game/Story04.rpy:9038

translate spanish story05_5_5_7844e0fd:

    # mc "You made me a hero."
    mc "Me hiciste un héroe."

# game/Story04.rpy:9042

translate spanish story05_5_5_63df4058:

    # mc "Put a banner in my hands and told me to save the world."
    mc "Pon una bandera en mis manos y me dijo que salvara el mundo."

# game/Story04.rpy:9045

translate spanish story05_5_5_c8793936:

    # mc "Never once asking if I wanted the role."
    mc "Nunca me preguntó si quería el papel."

# game/Story04.rpy:9046

translate spanish story05_5_5_2440758b:

    # mc "That’s before we even talk about how you treated me."
    mc "Eso es antes de que hablemos de cómo me trataste."

# game/Story04.rpy:9049

translate spanish story05_5_5_71a86863_2:

    # y "..."
    y "..."

# game/Story04.rpy:9051

translate spanish story05_5_5_99833fd8:

    # y "You’re a man of principles."
    y "Eres un hombre de principios."

# game/Story04.rpy:9052

translate spanish story05_5_5_36c5a29f:

    # y "Am I right?"
    y "¿Tengo razón?"

# game/Story04.rpy:9054

translate spanish story05_5_5_3d8c1d5f:

    # mc "I like to think so."
    mc "Me gusta pensarlo."

# game/Story04.rpy:9056

translate spanish story05_5_5_42d309e7:

    # y "I saved your life."
    y "Te salvé la vida."

# game/Story04.rpy:9057

translate spanish story05_5_5_874027a5:

    # y "Now it’s your turn to save mine."
    y "Ahora es tu turno de salvar la mía."

# game/Story04.rpy:9059

translate spanish story05_5_5_2b35b6fe_4:

    # mc "..."
    mc "..."

# game/Story04.rpy:9061

translate spanish story05_5_5_3b3938e0:

    # mc "(I don’t like this idea, but refusing won’t change anything.)"
    mc "(No me gusta esta idea, pero negar no cambiará nada.)"

# game/Story04.rpy:9062

translate spanish story05_5_5_bec30771:

    # mc "(And he’s right… I’m alive because of him.)"
    mc "(Y tiene razón... estoy vivo por él.)"

# game/Story04.rpy:9064

translate spanish story05_5_5_fcf9c325:

    # mc "Then I want your full support."
    mc "Entonces quiero tu apoyo completo."

# game/Story04.rpy:9066

translate spanish story05_5_5_84ea3656:

    # mc "No games."
    mc "No hay juegos."

# game/Story04.rpy:9067

translate spanish story05_5_5_896b381b:

    # mc "No schemes."
    mc "No hay planes."

# game/Story04.rpy:9068

translate spanish story05_5_5_c06c46d8:

    # mc "A clear plan."
    mc "Un plan claro."

# game/Story04.rpy:9069

translate spanish story05_5_5_74647356:

    # mc "Everything on the table."
    mc "Todo sobre la mesa."

# game/Story04.rpy:9071

translate spanish story05_5_5_31ed3599:

    # y "Agreed."
    y "De acuerdo."

# game/Story04.rpy:9074

translate spanish story05_5_5_72a4a768:

    # mc "Kali."
    mc "Kali."

# game/Story04.rpy:9075

translate spanish story05_5_5_52e8c385:

    # mc "Your thoughts?"
    mc "¿Tus pensamientos?"

# game/Story04.rpy:9076

translate spanish story05_5_5_d18fd985:

    # mc "I know you’re not asleep. Stop pretending."
    mc "Sé que no estás dormido."

# game/Story04.rpy:9083

translate spanish story05_5_5_82091822_2:

    # k "..."
    k "..."

# game/Story04.rpy:9088

translate spanish story05_5_5_7f6c8544:

    # k "How long have you known?"
    k "¿Cuánto tiempo has sabido?"

# game/Story04.rpy:9090

translate spanish story05_5_5_c6675718:

    # mc "You snore."
    mc "- ¡No!"

# game/Story04.rpy:9091

translate spanish story05_5_5_1608fe92:

    # mc "Did you know?"
    mc "¿Lo sabías?"

# game/Story04.rpy:9093

translate spanish story05_5_5_191fa3b8:

    # k "I’ll keep that in mind."
    k "Lo tendré en cuenta."

# game/Story04.rpy:9095

translate spanish story05_5_5_ad676bab:

    # k "You’re starting to freak me out."
    k "Estás empezando a asustarme."

# game/Story04.rpy:9096

translate spanish story05_5_5_559f7676:

    # k "First Federation leaders call you friend."
    k "Los líderes de la primera Federación te llaman amigo."

# game/Story04.rpy:9097

translate spanish story05_5_5_0da1d8b8:

    # k "Now a Chaplain."
    k "Ahora un capellán."

# game/Story04.rpy:9098

translate spanish story05_5_5_d8838b2b:

    # k "You’ve got a real talent for getting powerful people on your side."
    k "Tienes un verdadero talento para conseguir gente poderosa de tu lado."

# game/Story04.rpy:9100

translate spanish story05_5_5_8ec8d28b:

    # y "There’s a celebration in the camp tonight."
    y "Esta noche hay una celebración en el campamento."

# game/Story04.rpy:9101

translate spanish story05_5_5_7991fa21:

    # y "Care to join us?"
    y "¿Quieres unirte a nosotros?"

# game/Story04.rpy:9106

translate spanish story05_5_5_a04fef34:

    # mc "We’ll be there."
    mc "Estaremos allí."

# game/Story04.rpy:9107

translate spanish story05_5_5_ccf7abda:

    # mc "But first..."
    mc "Pero primero..."

# game/Story04.rpy:9108

translate spanish story05_5_5_51d67168:

    # mc "We make sure we’re not followed."
    mc "Nos aseguramos de que no se nos siga."

# game/Story04.rpy:9120

translate spanish story05_5_6_3b60565e:

    # "The road to the camp was quiet."
    "El camino al campamento estaba tranquilo."

# game/Story04.rpy:9123

translate spanish story05_5_6_a8d9ff5a:

    # "For a while they walked in silence."
    "Durante un tiempo caminaron en silencio."

# game/Story04.rpy:9125

translate spanish story05_5_6_d7700ab5:

    # mc "Kali? About those threads… do you know anything?"
    mc "¿Kali? ¿Sobre esos hilos... sabes algo?"

# game/Story04.rpy:9127

translate spanish story05_5_6_0e7d480f:

    # k "Knowledge?"
    k "¿El conocimiento?"

# game/Story04.rpy:9130

translate spanish story05_5_6_c64c795c:

    # k "I prefer meat and spectacle to libraries."
    k "Prefiero carne y espectáculo a las bibliotecas."

# game/Story04.rpy:9135

translate spanish story05_5_6_05d18d2a:

    # k "But even I, have heard the stories"
    k "Pero incluso yo, he oído las historias"

# game/Story04.rpy:9139

translate spanish story05_5_6_8b5f3d06:

    # mc "I'd appreciate it."
    mc "那就劳烦了。"

# game/Story04.rpy:9141

translate spanish story05_5_6_cff1b0d2:

    # k "Ew… don't do that, old man."
    k "呕……别这样，老男人。"

# game/Story04.rpy:9142

translate spanish story05_5_6_1d57d86d:

    # k "Politeness looks strange on you."
    k "La politeness te parece extraño."

# game/Story04.rpy:9144

translate spanish story05_5_6_80eca246:

    # k "But fine."
    k "Pero bien."

# game/Story04.rpy:9145

translate spanish story05_5_6_3177139c:

    # k "People say Reality is cloth-like."
    k "La gente dice que la realidad es como un paño."

# game/Story04.rpy:9148

translate spanish story05_5_6_02bc1da9:

    # k "Woven from countless threads."
    k "Tejido de innumerables hilos."

# game/Story04.rpy:9149

translate spanish story05_5_6_693db6b9:

    # k "Each thread is a different world."
    k "Cada hilo es un mundo diferente."

# game/Story04.rpy:9151

translate spanish story05_5_6_2ca31cdd:

    # mc "Parallel worlds."
    mc "Mundos paralelos."

# game/Story04.rpy:9154

translate spanish story05_5_6_f5f5aa01:

    # k "If you like big words."
    k "Si te gustan las palabras grandes."

# game/Story04.rpy:9155

translate spanish story05_5_6_1deb855b:

    # k "Different choices."
    k "Diferentes opciones."

# game/Story04.rpy:9156

translate spanish story05_5_6_03d1c371:

    # k "Different wars."
    k "Guerras diferentes."

# game/Story04.rpy:9157

translate spanish story05_5_6_870df9a7:

    # k "Different endings."
    k "Finales diferentes."

# game/Story04.rpy:9160

translate spanish story05_5_6_8f297869:

    # k "That’s everything I know."
    k "Eso es todo lo que sé."

# game/Story04.rpy:9161

translate spanish story05_5_6_1cb5176c:

    # mc "Not much to go on."
    mc "No hay mucho que seguir."

# game/Story04.rpy:9163

translate spanish story05_5_6_44ecae25:

    # k "It’s what there is."
    k "Es lo que hay."

# game/Story04.rpy:9168

translate spanish story05_5_6_3c2b972a:

    # keep3 "Most beings live their entire lives without ever realizing the truth."
    keep3 "La mayoría de los seres viven toda su vida sin darse cuenta de la verdad."

# game/Story04.rpy:9169

translate spanish story05_5_6_52cdb220:

    # keep3 "To them, their thread is the only world that exists."
    keep3 "Para ellos, su hilo es el único mundo que existe."

# game/Story04.rpy:9172

translate spanish story05_5_6_1907dfc3:

    # mc "(No chance to change it…)"
    mc "(No hay oportunidad de cambiarlo...)"

# game/Story04.rpy:9173

translate spanish story05_5_6_e0e55ef6:

    # keep3 "They don’t need one."
    keep3 "No necesitan uno."

# game/Story04.rpy:9175

translate spanish story05_5_6_342ac109:

    # mc "(Why—)"
    mc "(Por qué)"

# game/Story04.rpy:9180

translate spanish story05_5_6_92de21c0:

    # y "Many of us would give anything for a fate like yours."
    y "Muchos de nosotros daríamos algo por un destino como el tuyo."

# game/Story04.rpy:9181

translate spanish story05_5_6_c6b8f5e9:

    # y "To forget what we were."
    y "Olvidar lo que éramos."

# game/Story04.rpy:9185

translate spanish story05_5_6_6d8e1d7d:

    # mc "(…Because of the memories.)"
    mc "(...por los recuerdos.)"

# game/Story04.rpy:9187

translate spanish story05_5_6_dc5a4b17:

    # keep3 "Correct."
    keep3 "Correcto."

# game/Story04.rpy:9188

translate spanish story05_5_6_f61b7abb:

    # keep3 "When you live the same life over and over without knowing it’s repeating…"
    keep3 "Cuando usted vive la misma vida una y otra vez sin saber que está repitiendo..."

# game/Story04.rpy:9189

translate spanish story05_5_6_1b4da978:

    # keep3 "you’re perfectly satisfied."
    keep3 "estás perfectamente satisfecho."

# game/Story04.rpy:9191

translate spanish story05_5_6_45ff424e:

    # mc "(That’s… disturbing.)"
    mc "(Eso es... perturbador.)"

# game/Story04.rpy:9192

translate spanish story05_5_6_7e849547:

    # keep3 "Only if you know about it."
    keep3 "Solo si lo sabes."

# game/Story04.rpy:9193

translate spanish story05_5_6_dddbdbce:

    # keep3 "Otherwise it’s just… life."
    keep3 "De lo contrario es solo... la vida."

# game/Story04.rpy:9196

translate spanish story05_5_6_b9d5eac0:

    # mc "(But how did they even appear? Where did they—)"
    mc "(Pero cómo aparecieron? Donde ellos -)"

# game/Story04.rpy:9197

translate spanish story05_5_6_89c381df:

    # keep3 "From the moment time itself began."
    keep3 "Desde el momento en que comenzó."

# game/Story04.rpy:9198

translate spanish story05_5_6_d8341b8f:

    # keep3 "Time is a fabric. Threads are the fibers it’s woven from."
    keep3 "El tiempo es un tejido. Los hilos son las fibras de las que se teje."

# game/Story04.rpy:9200

translate spanish story05_5_6_7db72d0a:

    # mc "(Haven’t felt this stupid trying to understand something in a long time…)"
    mc "(No se ha sentido tan estúpido tratando de entender algo en mucho tiempo...)"

# game/Story04.rpy:9203

translate spanish story05_5_6_0085e033:

    # keep3 "..."
    keep3 "..."

# game/Story04.rpy:9204

translate spanish story05_5_6_764b51d9:

    # keep3 "Do you?"
    keep3 "¿Lo haces?"

# game/Story04.rpy:9207

translate spanish story05_5_6_25b41502:

    # keep3 "Think back on your life."
    keep3 "Piensa en tu vida."

# game/Story04.rpy:9211

translate spanish story05_5_6_4d3264b3:

    # keep3 "The first major shift in your thread happened when you decided to go after Lora."
    keep3 "El primer gran cambio en tu hilo ocurrió cuando decidió ir tras Lora."

# game/Story04.rpy:9215

translate spanish story05_5_6_2c64a254:

    # keep3 "The second came when you ended up on the Ark."
    keep3 "El segundo vino cuando terminaste en el Arca."

# game/Story04.rpy:9216

translate spanish story05_5_6_b9db337f:

    # keep3 "Those two shifts created a new thread."
    keep3 "Esos dos turnos crearon un nuevo hilo."

# game/Story04.rpy:9220

translate spanish story05_5_6_61485517:

    # mc "(Major shifts… So the small ones don’t matter?)"
    mc "(Los turnos de mayor... ¿Entonces los pequeños no importan?)"

# game/Story04.rpy:9222

translate spanish story05_5_6_dc1ea402:

    # keep3 "Every change affects the thread."
    keep3 "Cada cambio afecta el hilo."

# game/Story04.rpy:9223

translate spanish story05_5_6_828f980e:

    # keep3 "Some simply carry more weight."
    keep3 "Algunos simplemente llevan más peso."

# game/Story04.rpy:9226

translate spanish story05_5_6_34d1cb75:

    # keep3 "But every shift has consequences."
    keep3 "Pero cada turno tiene consecuencias."

# game/Story04.rpy:9227

translate spanish story05_5_6_94698fa3:

    # keep3 "Every outcome leads to a different moment."
    keep3 "Cada resultado conduce a un momento diferente."

# game/Story04.rpy:9229

translate spanish story05_5_6_8f27242e:

    # mc "(So these are… literally all possible versions of my life?)"
    mc "(¿Así que estas son... literalmente todas las versiones posibles de mi vida?)"

# game/Story04.rpy:9230

translate spanish story05_5_6_414fa8de:

    # keep3 "Yes."
    keep3 "Sí."

# game/Story04.rpy:9233

translate spanish story05_5_6_db12567f:

    # k "You good?"
    k "¿Estás bien?"

# game/Story04.rpy:9237

translate spanish story05_5_6_d2944626:

    # mc "Yeah. I’m fine. Don’t worry."
    mc "Sí. Estoy bien. No te preocupes."

# game/Story04.rpy:9239

translate spanish story05_5_6_df4be6a1:

    # k "Talking to that keeper again, huh…"
    k "Hablando con ese guardián otra vez, eh..."

# game/Story04.rpy:9240

translate spanish story05_5_6_b5c7abcf:

    # k "Well. Whatever."
    k "Bueno, lo que sea."

# game/Story04.rpy:9241

translate spanish story05_5_6_c65c039f:

    # k "Not my place to tell you what to do."
    k "No es mi lugar para decirte qué hacer."

# game/Story04.rpy:9242

translate spanish story05_5_6_732f61d5:

    # k "Anyway, how much farther?"
    k "De todos modos, ¿cuánto más lejos?"

# game/Story04.rpy:9244

translate spanish story05_5_6_deb9a320:

    # mc "No idea."
    mc "Ni idea."

# game/Story04.rpy:9245

translate spanish story05_5_6_50c84c8c:

    # mc "Yong’s supposed to meet us somewhere up ahead."
    mc "Yong se supone que nos encontraremos en algún lugar por delante."

# game/Story04.rpy:9246

translate spanish story05_5_6_565abddc:

    # mc "After that, he’ll take us to the camp."
    mc "Después de eso, nos llevará al campamento."

# game/Story04.rpy:9251

translate spanish story05_5_6_b5c31fa9:

    # k "Got it."
    k "Lo tengo."

# game/Story04.rpy:9258

translate spanish story05_5_6_1882d3dc:

    # "The Outcasts’ Camp."
    "El campamento de los marginados."

# game/Story04.rpy:9260

translate spanish story05_5_6_dbfcf1f1:

    # y "Here we are."
    y "Aquí estamos."

# game/Story04.rpy:9262

translate spanish story05_5_6_27eaadbc:

    # y "Two rules."
    y "Dos reglas."

# game/Story04.rpy:9263

translate spanish story05_5_6_d72a44d5:

    # y "No mention of slavery."
    y "Sin mencionar la esclavitud."

# game/Story04.rpy:9264

translate spanish story05_5_6_a9198e50:

    # y "And nothing about implants."
    y "Y nada sobre implantes."

# game/Story04.rpy:9267

translate spanish story05_5_6_9d1f09df:

    # mc "What about Gorem?"
    mc "¿Qué hay de Gorem?"

# game/Story04.rpy:9270

translate spanish story05_5_6_8598b237:

    # y "Make that three."
    y "Que sean tres."

# game/Story04.rpy:9271

translate spanish story05_5_6_95ccb1cb:

    # y "Don’t mention His Highness."
    y "No menciones a Su Alteza."

# game/Story04.rpy:9280

translate spanish story05_5_6_e673a5a1:

    # y "And… a word."
    y "Y... una palabra."

# game/Story04.rpy:9282

translate spanish story05_5_6_9cb23c31:

    # k "(whispering) Something’s off about him."
    k "Algo está mal sobre él."

# game/Story04.rpy:9284

translate spanish story05_5_6_379fcd6e:

    # mc "You think?"
    mc "¿Tú crees?"

# game/Story04.rpy:9285

translate spanish story05_5_6_e14da1c5:

    # mc "To me, he feels more open now."
    mc "Para mí, ahora se siente más abierto."

# game/Story04.rpy:9286

translate spanish story05_5_6_dcb7f710:

    # mc "In his own way, sure… but still."
    mc "A su manera, claro... pero aún así."

# game/Story04.rpy:9288

translate spanish story05_5_6_4faba61d:

    # k "It’s all crap, old man. My gut says something’s wrong here."
    k "Es una mierda, viejo. Mi instinto dice que algo está mal aquí."

# game/Story04.rpy:9290

translate spanish story05_5_6_20815cf5:

    # mc "Wait here."
    mc "Espera aquí."

# game/Story04.rpy:9291

translate spanish story05_5_6_75011522:

    # mc "I’ll see what he wants."
    mc "Veré lo que quiere."

# game/Story04.rpy:9293

translate spanish story05_5_6_c3b40072:

    # k "Yeah."
    k "Sí."

# game/Story04.rpy:9298

translate spanish story05_5_6_f3c2cd1f:

    # y "(whispering) I know you’re desperate to go back."
    y "Sé que estás desesperado por regresar."

# game/Story04.rpy:9299

translate spanish story05_5_6_abb70f60:

    # y "(whispering) To make sure they’re alright."
    y "Para asegurarse de que están bien."

# game/Story04.rpy:9300

translate spanish story05_5_6_774fff4d:

    # y "(whispering) I have a way… but—"
    y "Tengo una manera... pero..."

# game/Story04.rpy:9304

translate spanish story05_5_6_80f35329:

    # y "It’ll take time."
    y "Tardará tiempo."

# game/Story04.rpy:9305

translate spanish story05_5_6_297bc275:

    # y "And permission."
    y "Y permiso."

# game/Story04.rpy:9307

translate spanish story05_5_6_9bea3830:

    # mc "Is this about the anomaly rifts?"
    mc "¿Esto es por los robos de anomalía?"

# game/Story04.rpy:9311

translate spanish story05_5_6_fff2d6da:

    # y "Yes."
    y "Sí."

# game/Story04.rpy:9312

translate spanish story05_5_6_7d0a362a:

    # y "Miriel will explain how they work."
    y "Miriel explicará cómo funcionan."

# game/Story04.rpy:9316

translate spanish story05_5_6_4179fbbb:

    # mc "So… you’re in charge here?"
    mc "Entonces... ¿estás a cargo aquí?"

# game/Story04.rpy:9321

translate spanish story05_5_6_2abdd938:

    # y "More like I watch over them."
    y "Más como si los viera."

# game/Story04.rpy:9322

translate spanish story05_5_6_356a4f9c:

    # y "Make sure they don’t hurt themselves… or anyone else."
    y "Asegúrate de que no se hagan daño... ni a nadie más."

# game/Story04.rpy:9323

translate spanish story05_5_6_a52c660d:

    # mc "Then how did you convince them to let us in?"
    mc "¿Entonces cómo los convenciste para que nos dejaran entrar?"

# game/Story04.rpy:9326

translate spanish story05_5_6_1b27d8ff:

    # y "It wasn’t my doing."
    y "No fue mi trabajo."

# game/Story04.rpy:9327

translate spanish story05_5_6_9a0e5936:

    # y "Miriel made the first move."
    y "Miriel hizo el primer movimiento."

# game/Story04.rpy:9328

translate spanish story05_5_6_6dc0bb31:

    # y "Smoke?"
    y "¿Fuma?"

# game/Story04.rpy:9330

translate spanish story05_5_6_4f22aa68:

    # mc "I’ll pass."
    mc "Pasaré."

# game/Story04.rpy:9331

translate spanish story05_5_6_c5b7a818:

    # mc "Not the right place."
    mc "No es el lugar adecuado."

# game/Story04.rpy:9336

translate spanish story05_5_6_8a86d85f:

    # mc "So… Miriel."
    mc "Así que... Miriel."

# game/Story04.rpy:9337

translate spanish story05_5_6_2876efd9:

    # mc "Why?"
    mc "¿Por qué?"

# game/Story04.rpy:9339

translate spanish story05_5_6_db27a9ce:

    # y "Somehow…"
    y "De alguna manera..."

# game/Story04.rpy:9340

translate spanish story05_5_6_88a07eb4:

    # y "she remembered another life."
    y "se acordó de otra vida."

# game/Story04.rpy:9341

translate spanish story05_5_6_95fdceb9:

    # y "Not all of it."
    y "No todo."

# game/Story04.rpy:9342

translate spanish story05_5_6_58a4a77a:

    # y "Just the one where you existed."
    y "Justo el que existías."

# game/Story04.rpy:9345

translate spanish story05_5_6_91905ede:

    # mc "How?"
    mc "¿Cómo?"

# game/Story04.rpy:9350

translate spanish story05_5_6_049333a8:

    # y "[mc]?"
    y "[mc]?"

# game/Story04.rpy:9352

translate spanish story05_5_6_2b35b6fe:

    # mc "..."
    mc "..."

# game/Story04.rpy:9354

translate spanish story05_5_6_00ed353e:

    # y "No. It’s nothing."
    y "No, no es nada."

# game/Story04.rpy:9355

translate spanish story05_5_6_d2036000:

    # y "Get some rest."
    y "Descansa un poco."

# game/Story04.rpy:9357

translate spanish story05_5_6_ecf872dc:

    # mc "Wait."
    mc "Espera."

# game/Story04.rpy:9358

translate spanish story05_5_6_18804ef2:

    # mc "Say what you were going to say."
    mc "Di lo que ibas a decir."

# game/Story04.rpy:9363

translate spanish story05_5_6_cfe40dcf:

    # y "One question."
    y "Una pregunta."

# game/Story04.rpy:9364

translate spanish story05_5_6_44139f77:

    # y "What is hope?"
    y "¿Qué es la esperanza?"

# game/Story04.rpy:9366

translate spanish story05_5_6_3997c9e2:

    # mc "Why the sudden philosophy?"
    mc "¿Por qué la filosofía súbita?"

# game/Story04.rpy:9369

translate spanish story05_5_6_205a9216:

    # y "Why do you keep moving forward?"
    y "¿Por qué sigues avanzando?"

# game/Story04.rpy:9370

translate spanish story05_5_6_5c8880e4:

    # y "What… drives you?"
    y "¿Qué... te conduce?"

# game/Story04.rpy:9374

translate spanish story05_5_6_34196b86:

    # mc "Protect what’s mine."
    mc "Protege lo que es mío."

# game/Story04.rpy:9375

translate spanish story05_5_6_db960325:

    # mc "And to survive."
    mc "Y para sobrevivir."

# game/Story04.rpy:9381

translate spanish story05_5_6_11455b53:

    # mc "What?"
    mc "¿Qué?"

# game/Story04.rpy:9382

translate spanish story05_5_6_0151f9f5:

    # mc "You expecting something profound?"
    mc "¿Esperas algo profundo?"

# game/Story04.rpy:9384

translate spanish story05_5_6_d2237f60:

    # y "That’s your entire motivation?"
    y "¿Esa es tu motivación?"

# game/Story04.rpy:9386

translate spanish story05_5_6_ee45b483:

    # mc "Isn’t that enough?"
    mc "¿No es suficiente?"

# game/Story04.rpy:9388

translate spanish story05_5_6_2e500179:

    # mc "When a lion grows weak, the pride casts him out."
    mc "Cuando un león se debilita, el orgullo lo echa fuera."

# game/Story04.rpy:9389

translate spanish story05_5_6_4a786404:

    # mc "He’s left alone."
    mc "Se ha quedado solo."

# game/Story04.rpy:9390

translate spanish story05_5_6_8f5a3603:

    # mc "No allies. No shelter."
    mc "Sin aliados, sin refugio."

# game/Story04.rpy:9391

translate spanish story05_5_6_457c9e67:

    # mc "And still…"
    mc "Y aún así..."

# game/Story04.rpy:9392

translate spanish story05_5_6_338e7b9d:

    # mc "They don’t die of old age."
    mc "No mueren de edad."

# game/Story04.rpy:9393

translate spanish story05_5_6_2c80f101:

    # mc "They die fighting."
    mc "Morirán luchando."

# game/Story04.rpy:9395

translate spanish story05_5_6_ea9137a4:

    # mc "Struggle is life."
    mc "La lucha es vida."

# game/Story04.rpy:9396

translate spanish story05_5_6_4a177878:

    # mc "Stop fighting and you’re already dead."
    mc "Deja de luchar y ya estás muerto."

# game/Story04.rpy:9397

translate spanish story05_5_6_8eeda518:

    # mc "That’s all there is to it."
    mc "Eso es todo lo que hay."

# game/Story04.rpy:9401

translate spanish story05_5_6_9884eeed:

    # y "What’s a lion?"
    y "¿Qué es un león?"

# game/Story04.rpy:9404

translate spanish story05_5_6_95573fa3:

    # mc "What—"
    mc "¿Qué?"

# game/Story04.rpy:9406

translate spanish story05_5_6_556aef90:

    # mc "You know what? Forget it."
    mc "Olvídalo."

# game/Story04.rpy:9410

translate spanish story05_5_6_d2036000_1:

    # y "Get some rest."
    y "Descansa un poco."

# game/Story04.rpy:9415

translate spanish story05_5_6_d4a13ab5:

    # mc "(Rest…)"
    mc "(Rest...)"

# game/Story04.rpy:9416

translate spanish story05_5_6_a6dbc81b:

    # mc "(Like that’s something I can afford.)"
    mc "(Como si eso fuera algo que puedo permitir.)"

# game/Story04.rpy:9422

translate spanish story05_5_6_91d8a70c:

    # mc "You okay?"
    mc "¿Estás bien?"

# game/Story04.rpy:9424

translate spanish story05_5_6_61a75ab0:

    # k "Hm? Oh, it’s you, old man."
    k "Oh, eres tú, viejo."

# game/Story04.rpy:9425

translate spanish story05_5_6_edf61239:

    # k "Yeah, I’m fine."
    k "Sí, estoy bien."

# game/Story04.rpy:9427

translate spanish story05_5_6_347a4121:

    # mc "Enjoying it?"
    mc "¿Disfrutándolo?"

# game/Story04.rpy:9429

translate spanish story05_5_6_d63f0d2d:

    # k "Nah. I’m more interested in watching him."
    k "No. Estoy más interesado en verlo."

# game/Story04.rpy:9433

translate spanish story05_5_6_2e9afd27:

    # k "So… what were you whispering about?"
    k "Entonces... ¿qué estabas susurrando?"

# game/Story04.rpy:9435

translate spanish story05_5_6_bd886342:

    # mc "That obvious?"
    mc "¿Eso es obvio?"

# game/Story04.rpy:9438

translate spanish story05_5_6_6229046d:

    # k "Two old men whispering behind everyone’s backs?"
    k "¿Dos viejos susurrando detrás de la espalda de todos?"

# game/Story04.rpy:9439

translate spanish story05_5_6_de29071f:

    # k "The whole camp noticed."
    k "Todo el campamento lo notó."

# game/Story04.rpy:9443

translate spanish story05_5_6_917a12cb:

    # mc "How’s your wound?"
    mc "¿Cómo está tu herida?"

# game/Story04.rpy:9446

translate spanish story05_5_6_dcc678cf:

    # k "Honestly?"
    k "¿Honestamente?"

# game/Story04.rpy:9447

translate spanish story05_5_6_ff8ee4e6:

    # k "Like shit. I’ll live, but it hurts like hell."
    k "Como mierda. Viviré, pero duele como el infierno."

# game/Story04.rpy:9451

translate spanish story05_5_6_51d48dc6:

    # mc "Take it off. I need to check how it—"
    mc "Quítatelo, necesito comprobar cómo..."

# game/Story04.rpy:9454

translate spanish story05_5_6_bf832a13:

    # k "No."
    k "No."

# game/Story04.rpy:9456

translate spanish story05_5_6_9b60042c:

    # mc "I’ve already seen it, so—"
    mc "Ya lo he visto, así que..."

# game/Story04.rpy:9458

translate spanish story05_5_6_1ffaf74c:

    # mc "(She’s red. Is she… embarrassed? No, wait, what am I doing?)"
    mc "(Ella es roja. ¿Está... avergonzada? No, espera, ¿qué estoy haciendo?)"

# game/Story04.rpy:9460

translate spanish story05_5_6_91f1affe:

    # k "Others are watching."
    k "Otros están mirando."

# game/Story04.rpy:9464

translate spanish story05_5_6_0f0f8f78:

    # mc "(Not even trying to hide it.)"
    mc "(Ni siquiera tratando de ocultarlo.)"

# game/Story04.rpy:9467

translate spanish story05_5_6_9d0dd685:

    # mc "But… that never bothered you before. What changed?"
    mc "Pero... eso nunca te molestó antes. ¿Qué cambió?"

# game/Story04.rpy:9469

translate spanish story05_5_6_c6edbff3:

    # k "No means no."
    k "No significa que no."

# game/Story04.rpy:9472

translate spanish story05_5_6_96de68f4:

    # keep3 "It’s the miasma."
    keep3 "Es el miasma."

# game/Story04.rpy:9474

translate spanish story05_5_6_97dade16:

    # mc "(Care to elaborate?)"
    mc "(¿Care to elaborate?)"

# game/Story04.rpy:9475

translate spanish story05_5_6_4b70651f:

    # keep3 "The implants used to dull emotions completely."
    keep3 "Los implantes solían doblar las emociones completamente."

# game/Story04.rpy:9477

translate spanish story05_5_6_790c4588:

    # keep3 "But once you damaged them, that effect stopped working."
    keep3 "Pero una vez que los dañaste, ese efecto dejó de funcionar."

# game/Story04.rpy:9478

translate spanish story05_5_6_27e6ae11:

    # keep3 "What you see now is the result."
    keep3 "Lo que ves ahora es el resultado."

# game/Story04.rpy:9479

translate spanish story05_5_6_2ce665f2:

    # mc "(Maybe. Or maybe there’s more to it.)"
    mc "(Quizá. O tal vez hay más en él.)"

# game/Story04.rpy:9482

translate spanish story05_5_6_a8be934d:

    # mc "Listen. I’m responsible for you."
    mc "Escucha. Soy responsable de ti."

# game/Story04.rpy:9483

translate spanish story05_5_6_8dd1ac38:

    # mc "And I need to know if you’re alright."
    mc "Y necesito saber si estás bien."

# game/Story04.rpy:9486

translate spanish story05_5_6_6651ab87:

    # mc "Alright."
    mc "Muy bien."

# game/Story04.rpy:9487

translate spanish story05_5_6_4f94a11d:

    # mc "We’ll find somewhere more private."
    mc "Encontraremos un lugar más privado."

# game/Story04.rpy:9488

translate spanish story05_5_6_82091822:

    # k "..."
    k "..."

# game/Story04.rpy:9491

translate spanish story05_5_6_996f037d:

    # k "Thanks, old man."
    k "Gracias, viejo."

# game/Story04.rpy:9494

translate spanish story05_5_6_bdc003c0:

    # Mi "I… overheard that you were having some trouble."
    Mi "Oí que estabas teniendo problemas."

# game/Story04.rpy:9496

translate spanish story05_5_6_352ab7f2:

    # Mi "And… I could show you a place."
    Mi "Y... podría enseñarte un lugar."

# game/Story04.rpy:9502

translate spanish story05_5_6_9e0efdff:

    # Mi "(whispering) If you’d like."
    Mi "Si quieres."

# game/Story04.rpy:9504

translate spanish story05_5_6_0b348ba0:

    # mc "…Alright."
    mc "...de acuerdo."

# game/Story04.rpy:9506

translate spanish story05_5_6_71f825dc:

    # Mi "Then… follow me."
    Mi "Entonces... sígueme."

# game/Story04.rpy:9510

translate spanish story05_5_6_38c2c890:

    # mc "So… what’s the occasion?"
    mc "Entonces... ¿cuál es la ocasión?"

# game/Story04.rpy:9512

translate spanish story05_5_6_b0442d1a:

    # Mi "It is… our annual day of remembrance. We honor those who perished in the tragedy."
    Mi "Es... nuestro día anual de recuerdo, honramos a los que perecieron en la tragedia."

# game/Story04.rpy:9513

translate spanish story05_5_6_5414458b:

    # mc "You mean El— …your Highness’s grandfather?"
    mc "¿Te refieres a El... el abuelo de Su Alteza?"

# game/Story04.rpy:9515

translate spanish story05_5_6_bddc88bb:

    # Mi "Yes."
    Mi "Sí."

# game/Story04.rpy:9516

translate spanish story05_5_6_ac242372:

    # Mi "The deeds of our progenitor, Eldrindor."
    Mi "Las obras de nuestro progenitor, Eldrindor."

# game/Story04.rpy:9518

translate spanish story05_5_6_1c260c86:

    # k "Funny. I don’t see much mourning."
    k "Divertido. No veo mucho luto."

# game/Story04.rpy:9519

translate spanish story05_5_6_afe4b16c:

    # k "More like celebration."
    k "Más bien la celebración."

# game/Story04.rpy:9520

translate spanish story05_5_6_11ed92ca:

    # k "Looks strange."
    k "Parece extraño."

# game/Story04.rpy:9522

translate spanish story05_5_6_d07a9da0:

    # Mi "Tears won’t bring the dead back."
    Mi "Los lágrimas no traerán a los muertos."

# game/Story04.rpy:9523

translate spanish story05_5_6_1cb6a1b7:

    # Mi "And I don’t think they’d want to see their loved ones weep."
    Mi "Y no creo que quieran ver llorar a sus seres queridos."

# game/Story04.rpy:9524

translate spanish story05_5_6_f54ce31b:

    # Mi "So we celebrate."
    Mi "Así que celebramos."

# game/Story04.rpy:9525

translate spanish story05_5_6_53368c23:

    # Mi "We remember with life, not sorrow."
    Mi "Nos acordamos de la vida, no de la pena."

# game/Story04.rpy:9527

translate spanish story05_5_6_984bb045:

    # k "I’ve heard of that. Still feels odd."
    k "He oído hablar de eso. Todavía se siente extraño."

# game/Story04.rpy:9529

translate spanish story05_5_6_fcfbdca9:

    # Mi "If you prefer tears, that’s your choice."
    Mi "Si prefieres lágrimas, es tu elección."

# game/Story04.rpy:9530

translate spanish story05_5_6_ce7ee942:

    # Mi "We chose a different path."
    Mi "Elegimos un camino diferente."

# game/Story04.rpy:9533

translate spanish story05_5_6_885df22b:

    # elf "YEE-HEE-HEY!"
    elf "¡YEE-HEE-HEY!"

# game/Story04.rpy:9539

translate spanish story05_5_6_055e3625:

    # Mi "Reyka, Leila, you alright?"
    Mi "Reyka, Leila, ¿estás bien?"

# game/Story04.rpy:9542

translate spanish story05_5_6_316253ac:

    # elf "All good!"
    elf "¡Todo bien!"

# game/Story04.rpy:9546

translate spanish story05_5_6_a21b180a:

    # mc "Sorry… if her words hit a nerve."
    mc "Lo siento... si sus palabras se ponen nerviosas."

# game/Story04.rpy:9548

translate spanish story05_5_6_f9d3c56f:

    # Mi "N-no, it’s alright. For us… it’s an old wound."
    Mi "N-no, está bien. Para nosotros... es una vieja herida."

# game/Story04.rpy:9549

translate spanish story05_5_6_95fca8bb:

    # Mi "But… about that promise—"
    Mi "Pero... sobre esa promesa..."

# game/Story04.rpy:9551

translate spanish story05_5_6_dbd06f47:

    # mc "That was just an off—"
    mc "Eso fue solo un apagado..."

# game/Story04.rpy:9552

translate spanish story05_5_6_9e00b9f4:

    # mc "(Wait… she refused back then… and now…?)"
    mc "(Espera... ella se negó entonces... y ahora...?)"

# game/Story04.rpy:9554

translate spanish story05_5_6_4075d740:

    # mc "So… you agreed?"
    mc "Entonces... ¿estas de acuerdo?"

# game/Story04.rpy:9557

translate spanish story05_5_6_12b9d1aa:

    # Mi "After what you said about your bond with my teacher…"
    Mi "Después de lo que dijiste sobre tu vínculo con mi profesor..."

# game/Story04.rpy:9558

translate spanish story05_5_6_60bd3f51:

    # Mi "I went to see him."
    Mi "Fui a verlo."

# game/Story04.rpy:9559

translate spanish story05_5_6_fe04e153:

    # Mi "He… explained the bigger picture."
    Mi "Él... explicó la imagen más grande."

# game/Story04.rpy:9560

translate spanish story05_5_6_615488fb:

    # Mi "I agreed."
    Mi "Acepté."

# game/Story04.rpy:9561

translate spanish story05_5_6_054c5ee0:

    # mc "I see."
    mc "Ya veo."

# game/Story04.rpy:9562

translate spanish story05_5_6_c15f640f:

    # Mi "But how exactly do you plan to improve our situation?"
    Mi "¿Pero cómo planeas mejorar nuestra situación?"

# game/Story04.rpy:9565

translate spanish story05_5_6_086b12f2:

    # mc "(…And what am I supposed to say to that?)"
    mc "(...¿Y qué se supone que debo decir a eso?)"

# game/Story04.rpy:9566

translate spanish story05_5_6_1584b368:

    # mc "I’ll be honest with you. I was acting on the fly."
    mc "Seré honesto contigo. Yo estaba actuando en la mosca."

# game/Story04.rpy:9568

translate spanish story05_5_6_48a39d86:

    # mc "I didn’t really have a plan, but before facing Gorem, I wanted allies."
    mc "No tenía un plan, pero antes de enfrentarme a Gorem, quería aliados."

# game/Story04.rpy:9569

translate spanish story05_5_6_e9348c35:

    # mc "Then… together, we could figure something out."
    mc "Entonces... juntos, podríamos averiguar algo."

# game/Story04.rpy:9571

translate spanish story05_5_6_2a9f1c2f:

    # mc "That was the idea."
    mc "Esa fue la idea."

# game/Story04.rpy:9573

translate spanish story05_5_6_d91b06da:

    # Mi "Just as I thought…"
    Mi "Como pensé..."

# game/Story04.rpy:9578

translate spanish story05_5_6_0567404e:

    # Mi "You really aren’t that different from how my teacher described you."
    Mi "Realmente no eres tan diferente de cómo mi maestro te describió."

# game/Story04.rpy:9581

translate spanish story05_5_6_fee5441d:

    # mc "(She’s… laughing?)"
    mc "(Ella está... riendo?)"

# game/Story04.rpy:9582

translate spanish story05_5_6_167f5f66:

    # k "(whispering) You seeing this too?"
    k "¿También ves esto?"

# game/Story04.rpy:9584

translate spanish story05_5_6_eb8d2487:

    # mc "(whispering) Yeah… like spotting a unicorn."
    mc "Sí... como manchar un unicornio."

# game/Story04.rpy:9585

translate spanish story05_5_6_09cb7fac:

    # k "(whispering) A what?"
    k "¿Un qué?"

# game/Story04.rpy:9588

translate spanish story05_5_6_785c3f5f:

    # mc "(whispering) Horse with a horn."
    mc "Caballo con cuerno."

# game/Story04.rpy:9590

translate spanish story05_5_6_f5689c1f:

    # k "(whispering) A hors—"
    k "Un hors..."

# game/Story04.rpy:9593

translate spanish story05_5_6_a7f612db:

    # mc "(whispering) Forget it."
    mc "Olvídalo."

# game/Story04.rpy:9595

translate spanish story05_5_6_7d84c1a2:

    # Mi "Why are you both staring?"
    Mi "¿Por qué están mirando ambos?"

# game/Story04.rpy:9597

translate spanish story05_5_6_5df7d9fc:

    # mc "You have a beautiful smile."
    mc "Tienes una hermosa sonrisa."

# game/Story04.rpy:9599

translate spanish story05_5_6_da3fdbf1:

    # Mi "..."
    Mi "..."

# game/Story04.rpy:9602

translate spanish story05_5_6_e54869ef:

    # Mi "Wha— I— No! That’s… embarrassing."
    Mi "Qué... ¡No! Eso es... embarazoso."

# game/Story04.rpy:9607

translate spanish story05_5_6_be9161c2:

    # mc "Can I ask you something?"
    mc "¿Puedo preguntarte algo?"

# game/Story04.rpy:9609

translate spanish story05_5_6_b18f716a:

    # mc "How… did you remember us?"
    mc "¿Cómo... nos recuerdas?"

# game/Story04.rpy:9612

translate spanish story05_5_6_da3fdbf1_1:

    # Mi "..."
    Mi "..."

# game/Story04.rpy:9614

translate spanish story05_5_6_3e57af02:

    # Mi "When you began following me… something felt strange."
    Mi "Cuando empezaste a seguirme... algo se sintió extraño."

# game/Story04.rpy:9615

translate spanish story05_5_6_5d07cbe2:

    # Mi "Like we had met before."
    Mi "Como nos habíamos conocido antes."

# game/Story04.rpy:9619

translate spanish story05_5_6_c80d323e:

    # Mi "Even though I was seeing you for the first time…"
    Mi "Aunque te estaba viendo por primera vez..."

# game/Story04.rpy:9620

translate spanish story05_5_6_507bf0dd:

    # Mi "It felt wrong."
    Mi "Se sintió mal."

# game/Story04.rpy:9621

translate spanish story05_5_6_501fdd76:

    # Mi "I knew bringing you to the camp was reckless… but the feeling wouldn’t leave me."
    Mi "Sabía que traerte al campamento era imprudente... pero el sentimiento no me dejaba."

# game/Story04.rpy:9625

translate spanish story05_5_6_2aa612f2:

    # Mi "And then…"
    Mi "Y luego..."

# game/Story04.rpy:9626

translate spanish story05_5_6_637c8de7:

    # Mi "When you said my name…"
    Mi "Cuando dijiste mi nombre..."

# game/Story04.rpy:9627

translate spanish story05_5_6_0c36fd62:

    # Mi "Everything just… went foggy."
    Mi "Todo fue... raro."

# game/Story04.rpy:9628

translate spanish story05_5_6_a3c2c28a:

    # Mi "…and fragments of memory began to surface."
    Mi "...y los fragmentos de memoria comenzaron a aparecer."

# game/Story04.rpy:9632

translate spanish story05_5_6_eb994151:

    # mc "And you believed right away?"
    mc "¿Y creías de inmediato?"

# game/Story04.rpy:9634

translate spanish story05_5_6_43322abd:

    # Mi "Not completely."
    Mi "No completamente."

# game/Story04.rpy:9635

translate spanish story05_5_6_d9584bc7:

    # Mi "I thought maybe it was just my imagination…"
    Mi "Pensé que tal vez era solo mi imaginación..."

# game/Story04.rpy:9636

translate spanish story05_5_6_4ad2a403:

    # Mi "But after speaking with my teacher…"
    Mi "Pero después de hablar con mi profesor..."

# game/Story04.rpy:9637

translate spanish story05_5_6_5f6ce5c9:

    # Mi "(whispering) …yes."
    Mi "Sí."

# game/Story04.rpy:9639

translate spanish story05_5_6_051ee3b4:

    # Mi "I-in any case, we’re here."
    Mi "En cualquier caso, estamos aquí."

# game/Story04.rpy:9641

translate spanish story05_5_6_777b3d8c:

    # Mi "Straight ahead, then left. You’ll find the infirmary there."
    Mi "Justo a la izquierda. Encontrarás la enfermería allí."

# game/Story04.rpy:9642

translate spanish story05_5_6_40d87a72:

    # Mi "I… should go warn the others."
    Mi "Debería advertir a los demás."

# game/Story04.rpy:9643

translate spanish story05_5_6_fd734325:

    # Mi "And see if I can find something for you."
    Mi "Y mira si puedo encontrar algo para ti."

# game/Story04.rpy:9644

translate spanish story05_5_6_bc8c48e2:

    # mc "Thanks, Mir."
    mc "Gracias, Mir."

# game/Story04.rpy:9645

translate spanish story05_5_6_1b43e661:

    # Mi "Don’t mention it."
    Mi "No lo menciones."

# game/Story04.rpy:9649

translate spanish story05_5_6_2587af90:

    # "A moment later, inside the camp’s infirmary."
    "Un momento después, dentro de la enfermería del campamento."

# game/Story04.rpy:9652

translate spanish story05_5_6_0efe8f9c:

    # k "So… how is it?"
    k "Entonces... ¿cómo es?"

# game/Story04.rpy:9654

translate spanish story05_5_6_f2384581:

    # mc "Hard to say."
    mc "Difícil de decir."

# game/Story04.rpy:9655

translate spanish story05_5_6_5de908a8:

    # mc "Looks better than before."
    mc "Parece mejor que antes."

# game/Story04.rpy:9657

translate spanish story05_5_6_487c4ee4:

    # k "You know, old man… I’ve been thinking."
    k "Sabes, viejo... he estado pensando."

# game/Story04.rpy:9659

translate spanish story05_5_6_35ef0978:

    # mc "Oh? About what?"
    mc "¿Sobre qué?"

# game/Story04.rpy:9662

translate spanish story05_5_6_c341be47:

    # k "How fragile we really are."
    k "Qué frágiles somos."

# game/Story04.rpy:9663

translate spanish story05_5_6_7be13e1c:

    # k "Just one blow, and I was gone."
    k "Solo un golpe, y me había ido."

# game/Story04.rpy:9664

translate spanish story05_5_6_1b6b80dd:

    # k "Funny, isn’t it?"
    k "Qué gracioso, ¿no?"

# game/Story04.rpy:9665

translate spanish story05_5_6_0009550b:

    # k "Years of training… and it all means nothing."
    k "Años de entrenamiento... y todo significa nada."

# game/Story04.rpy:9666

translate spanish story05_5_6_3b9aa239:

    # mc "Sometimes there are limits you simply can’t push past."
    mc "A veces hay límites que simplemente no puede empujar más allá."

# game/Story04.rpy:9669

translate spanish story05_5_6_8fcbeecb:

    # k "Hey, hey."
    k "Oye, oye."

# game/Story04.rpy:9670

translate spanish story05_5_6_708b61e2:

    # k "Aren’t you supposed to be encouraging me?"
    k "¿No se supone que me estás animando?"

# game/Story04.rpy:9672

translate spanish story05_5_6_c6e878ec:

    # mc "I could."
    mc "Podría."

# game/Story04.rpy:9673

translate spanish story05_5_6_6e06bc32:

    # mc "But I doubt that’s what you need."
    mc "Pero dudo que eso es lo que necesitas."

# game/Story04.rpy:9674

translate spanish story05_5_6_82091822_1:

    # k "..."
    k "..."

# game/Story04.rpy:9675

translate spanish story05_5_6_dd4dd131:

    # mc "You’re scared."
    mc "Estás asustado."

# game/Story04.rpy:9677

translate spanish story05_5_6_e2950a83:

    # k "And if I am?"
    k "¿Y si lo soy?"

# game/Story04.rpy:9678

translate spanish story05_5_6_7a76895c:

    # k "So what?"
    k "¿Y qué?"

# game/Story04.rpy:9680

translate spanish story05_5_6_7f8634a5:

    # mc "People treat fear of death like it’s a flaw."
    mc "La gente trata el miedo a la muerte como si fuera un defecto."

# game/Story04.rpy:9681

translate spanish story05_5_6_2e1ea064:

    # mc "“You’re a coward,” they say."
    mc "“Eres un cobarde”, dicen."

# game/Story04.rpy:9682

translate spanish story05_5_6_7973272c:

    # mc "But there’s nothing wrong with valuing your life."
    mc "Pero no hay nada malo en valorar tu vida."

# game/Story04.rpy:9684

translate spanish story05_5_6_02c4c5b6:

    # k "Easy for you to sa—"
    k "Fácil para ti..."

# game/Story04.rpy:9687

translate spanish story05_5_6_01028063:

    # k "Ah~~"
    k "Ah..."

# game/Story04.rpy:9688

translate spanish story05_5_6_b0b29fce:

    # "A soft breath escapes her."
    "Un soplo suave la escapa."

# game/Story04.rpy:9690

translate spanish story05_5_6_6389feea:

    # mc "What I see… is a frightened girl."
    mc "Lo que veo es una chica asustada."

# game/Story04.rpy:9691

translate spanish story05_5_6_3a313078:

    # mc "Someone who’s afraid to open up to others."
    mc "Alguien que tiene miedo de abrirse a los demás."

# game/Story04.rpy:9695

translate spanish story05_5_6_f110a669:

    # k "Oh, screw you."
    k "Oh, a la mierda."

# game/Story04.rpy:9698

translate spanish story05_5_6_2b35b6fe_1:

    # mc "..."
    mc "..."

# game/Story04.rpy:9699

translate spanish story05_5_6_df2200c3:

    # k "Why’d you go quiet?"
    k "¿Por qué te callaste?"

# game/Story04.rpy:9700

translate spanish story05_5_6_0ef06fc7:

    # mc "You have a lot of scars."
    mc "Tienes muchas cicatrices."

# game/Story04.rpy:9701

translate spanish story05_5_6_ec170f8c:

    # k "Oh, I know."
    k "Lo sé."

# game/Story04.rpy:9702

translate spanish story05_5_6_15a1bf39:

    # k "Ugly, right?"
    k "Feo, ¿verdad?"

# game/Story04.rpy:9705

translate spanish story05_5_6_94a74d26:

    # mc "I’ve told you what I think of them."
    mc "Te he dicho lo que pienso de ellos."

# game/Story04.rpy:9706

translate spanish story05_5_6_7bf1b6f8:

    # k "You’re a damn weirdo if you find them attractive, old man."
    k "Eres un maldito raro si los encuentras atractivo, viejo."

# game/Story04.rpy:9708

translate spanish story05_5_6_2034c056:

    # mc "Maybe."
    mc "Tal vez."

# game/Story04.rpy:9709

translate spanish story05_5_6_2c1cf9d4:

    # mc "But every scar is a memory."
    mc "Pero cada cicatriz es un recuerdo."

# game/Story04.rpy:9710

translate spanish story05_5_6_c09e0610:

    # mc "A story."
    mc "Una historia."

# game/Story04.rpy:9711

translate spanish story05_5_6_35a2c34c:

    # mc "Experience."
    mc "Experiencia."

# game/Story04.rpy:9712

translate spanish story05_5_6_88444da5:

    # mc "Nothing to be ashamed of."
    mc "No hay nada de qué avergonzarse."

# game/Story04.rpy:9714

translate spanish story05_5_6_698186b1:

    # k "(Afraid? What nonsense. I’m an Inquisitor. I don’t feel fear!)"
    k "(¿Miedo? ¿Qué tonterías. Soy un Inquisidor. No siento miedo!)"

# game/Story04.rpy:9716

translate spanish story05_5_6_fa158edb:

    # k "(And yet… I’m sitting here naked in front of him.)"
    k "(Y sin embargo... estoy sentado aquí desnudo delante de él.)"

# game/Story04.rpy:9717

translate spanish story05_5_6_0d648640:

    # k "(And he’s not even looking at me like a woman.)"
    k "(Y él ni siquiera me mira como una mujer.)"

# game/Story04.rpy:9719

translate spanish story05_5_6_81c7cb8e:

    # k "(What’s the catch? What does he get out of this?)"
    k "(¿Cuál es la captura? ¿Qué saca de esto?)"

# game/Story04.rpy:9720

translate spanish story05_5_6_74ff01f4:

    # k "(No… I don’t want him looking at me like that.)"
    k "(No... no quiero que me mire así.)"

# game/Story04.rpy:9723

translate spanish story05_5_6_df1310b3:

    # k "(It’s… uncomfortable.)"
    k "(Es... incómodo.)"

# game/Story04.rpy:9725

translate spanish story05_5_6_2ed83991:

    # mc "Something wrong?"
    mc "¿Pasa algo?"

# game/Story04.rpy:9727

translate spanish story05_5_6_e8ef540f:

    # k "Just… thought you’d jump me."
    k "Solo... pensé que me saltarías."

# game/Story04.rpy:9728

translate spanish story05_5_6_1e1ebeb5:

    # k "Not… this."
    k "No... esto."

# game/Story04.rpy:9730

translate spanish story05_5_6_a66b2e65:

    # mc "Sometimes simple care can do more than anything else."
    mc "A veces, la atención simple puede hacer más que cualquier otra cosa."

# game/Story04.rpy:9732

translate spanish story05_5_6_aeef74c6:

    # k "Hmph…"
    k "Hmph..."

# game/Story04.rpy:9733

translate spanish story05_5_6_9680a338:

    # mc "(Her worldview’s not that different from Olivia’s. Both expect a trap in even the simplest kindness…)"
    mc "(Su visión del mundo no es tan diferente de la de Olivia. Ambos esperan una trampa en la más simple bondad...)"

# game/Story04.rpy:9735

translate spanish story05_5_6_58942dfd:

    # mc "(Because opening up is terrifying.)"
    mc "(Porque abrir es aterrador.)"

# game/Story04.rpy:9739

translate spanish story05_5_6_4ee8e6f7:

    # mc "You need rest."
    mc "Necesitas descansar."

# game/Story04.rpy:9740

translate spanish story05_5_6_7d63d63c:

    # mc "So relax at the festival tonight."
    mc "Relájate en el festival esta noche."

# game/Story04.rpy:9743

translate spanish story05_5_6_b31dd769:

    # mc "I’ll handle the rest."
    mc "Yo me encargaré del resto."

# game/Story04.rpy:9748

translate spanish story05_5_6_9790cac2:

    # mc "Alright?"
    mc "¿De acuerdo?"

# game/Story04.rpy:9751

translate spanish story05_5_6_5dd070ef:

    # k "Mhm..."
    k "Mhm..."

# game/Story04.rpy:9754

translate spanish story05_5_6_7881f9e6:

    # Mi "How is she?"
    Mi "¿Cómo está?"

# game/Story04.rpy:9755

translate spanish story05_5_6_014d4242:

    # mc "Better."
    mc "Mejor."

# game/Story04.rpy:9757

translate spanish story05_5_6_55ac4c18:

    # Mi "I’m glad to hear that."
    Mi "Me alegra oír eso."

# game/Story04.rpy:9759

translate spanish story05_5_6_9969bdbf:

    # mc "So… how are things here?"
    mc "Entonces... ¿cómo están las cosas aquí?"

# game/Story04.rpy:9761

translate spanish story05_5_6_3dff179e:

    # Mi "The camp has mostly accepted your presence."
    Mi "El campamento ha aceptado su presencia."

# game/Story04.rpy:9762

translate spanish story05_5_6_0e927f2b:

    # Mi "There were a few objections, but I handled them."
    Mi "Hubo algunas objeciones, pero las manejé."

# game/Story04.rpy:9764

translate spanish story05_5_6_bc8c48e2_1:

    # mc "Thanks, Mir."
    mc "Gracias, Mir."

# game/Story04.rpy:9765

translate spanish story05_5_6_da3fdbf1_2:

    # Mi "..."
    Mi "..."

# game/Story04.rpy:9767

translate spanish story05_5_6_09752471:

    # mc "Something bothering you?"
    mc "¿Te molesta algo?"

# game/Story04.rpy:9769

translate spanish story05_5_6_63450149:

    # Mi "How did you—"
    Mi "¿Cómo..."

# game/Story04.rpy:9771

translate spanish story05_5_6_30c3fa28:

    # k "Your face gives you away."
    k "Tu cara te da."

# game/Story04.rpy:9772

translate spanish story05_5_6_da3fdbf1_3:

    # Mi "..."
    Mi "..."

# game/Story04.rpy:9774

translate spanish story05_5_6_16765f0d:

    # Mi "I… would like to know more about you."
    Mi "Me gustaría saber más sobre ti."

# game/Story04.rpy:9775

translate spanish story05_5_6_31bd81a8:

    # Mi "But I also understand this may not be the right moment."
    Mi "Pero también entiendo que este puede no ser el momento adecuado."

# game/Story04.rpy:9777

translate spanish story05_5_6_ea6752a0:

    # k "Why not?"
    k "¿Por qué no?"

# game/Story04.rpy:9778

translate spanish story05_5_6_0b47e122:

    # k "We’ve got plenty of time."
    k "Tenemos mucho tiempo."

# game/Story04.rpy:9780

translate spanish story05_5_6_d799eefe:

    # Mi "Because of the ceremonial dance."
    Mi "Por el baile ceremonial."

# game/Story04.rpy:9781

translate spanish story05_5_6_9818d7d1:

    # Mi "Speaking of which… would you like to join?"
    Mi "Hablando de eso... ¿te gustaría unirte?"

# game/Story04.rpy:9783

translate spanish story05_5_6_732420f7:

    # k "I don’t really care either way. If the old man’s in, so am I."
    k "No me importa de ninguna manera. Si el viejo está dentro, yo también."

# game/Story04.rpy:9784

translate spanish story05_5_6_843215c2:

    # k "What do you say?"
    k "¿Qué dices?"

# game/Story04.rpy:9786

translate spanish story05_5_6_56c3991c:

    # mc "Why not?"
    mc "¿Por qué no?"

# game/Story04.rpy:9788

translate spanish story05_5_6_8b18a527:

    # Mi "But… you’ll need to change your clothes."
    Mi "Pero... tendrás que cambiarte la ropa."

# game/Story04.rpy:9789

translate spanish story05_5_6_d1598945:

    # Mi "I understand you came here with good intentions, but to the others, you’re still outsiders."
    Mi "Entiendo que viniste aquí con buenas intenciones, pero para los otros, aún estás fuera de lugar."

# game/Story04.rpy:9791

translate spanish story05_5_6_77777dba:

    # mc "Just clothes?"
    mc "¿Solo ropa?"

# game/Story04.rpy:9792

translate spanish story05_5_6_0dff760d:

    # mc "Or anything else?"
    mc "¿O algo más?"

# game/Story04.rpy:9794

translate spanish story05_5_6_866f6a16:

    # Mi "Under no circumstances are you to draw your weapon."
    Mi "Bajo ninguna circunstancia vas a dibujar tu arma."

# game/Story04.rpy:9795

translate spanish story05_5_6_ce373602:

    # Mi "No matter what happens… please don’t."
    Mi "No importa lo que pase... por favor no lo hagas."

# game/Story04.rpy:9796

translate spanish story05_5_6_2df38b83:

    # Mi "That’s my promise to the camp."
    Mi "Esa es mi promesa al campamento."

# game/Story04.rpy:9798

translate spanish story05_5_6_2b35b6fe_2:

    # mc "..."
    mc "..."

# game/Story04.rpy:9799

translate spanish story05_5_6_cfe22840:

    # mc "Even if my life’s at risk?"
    mc "¿Aunque mi vida esté en riesgo?"

# game/Story04.rpy:9801

translate spanish story05_5_6_e48d80fb:

    # Mi "I’ll handle it."
    Mi "Yo me encargaré."

# game/Story04.rpy:9803

translate spanish story05_5_6_6651ab87_1:

    # mc "Alright."
    mc "Muy bien."

# game/Story04.rpy:9805

translate spanish story05_5_6_b8de4dad:

    # "([mc] steps away to change.)"
    "([mc] pasos para cambiar.)"

# game/Story04.rpy:9808

translate spanish story05_5_6_07e30edc:

    # k "Tell me, pointy-ears… what is really going on?"
    k "Dime, puntiagudos... ¿qué está pasando realmente?"

# game/Story04.rpy:9810

translate spanish story05_5_6_1df40c71:

    # Mi "I don’t see what you mean."
    Mi "No veo lo que quieres decir."

# game/Story04.rpy:9812

translate spanish story05_5_6_199a57cc:

    # k "You could’ve taken his weapon."
    k "Podrías haber tomado su arma."

# game/Story04.rpy:9813

translate spanish story05_5_6_039ac7fe:

    # k "Why didn’t you?"
    k "¿Por qué no lo hiciste?"

# game/Story04.rpy:9814

translate spanish story05_5_6_da3fdbf1_4:

    # Mi "..."
    Mi "..."

# game/Story04.rpy:9816

translate spanish story05_5_6_2835b587:

    # k "Got me thinking."
    k "Me tengo pensando."

# game/Story04.rpy:9817

translate spanish story05_5_6_48ef58b4:

    # k "You sure you can protect us?"
    k "¿Seguro que puedes protegernos?"

# game/Story04.rpy:9819

translate spanish story05_5_6_61458f41:

    # mc "We’re not children."
    mc "No somos niños."

# game/Story04.rpy:9820

translate spanish story05_5_6_16392823:

    # mc "We can handle ourselves."
    mc "Podemos manejarnos."

# game/Story04.rpy:9824

translate spanish story05_5_6_850ef128:

    # b "..."
    b "..."

# game/Story04.rpy:9826

translate spanish story05_5_6_11455b53_1:

    # mc "What?"
    mc "¿Qué?"

# game/Story04.rpy:9828

translate spanish story05_5_6_d1474e3e:

    # k "Pointy-ears… I’ll give you this, you’ve got great taste."
    k "Apuntes... Te daré esto, tienes un gran gusto."

# game/Story04.rpy:9829

translate spanish story05_5_6_047e35a3:

    # Mi "Yes. Thank you."
    Mi "Sí, gracias."

# game/Story04.rpy:9833

translate spanish story05_5_6_cadbfc1a:

    # "A moment later, they stepped out of the infirmary, making their way toward the center of the camp.."
    "Un momento después, salieron de la enfermería, haciendo su camino hacia el centro del campamento.."

# game/Story04.rpy:9837

translate spanish story05_5_6_c1278d33:

    # k "Why the long face? We’re at a festival, at least pretend to smile."
    k "¿Por qué la cara larga? Estamos en un festival, al menos finge sonreír."

# game/Story04.rpy:9839

translate spanish story05_5_6_e29810e6:

    # mc "I am happy."
    mc "Soy feliz."

# game/Story04.rpy:9841

translate spanish story05_5_6_6c3c49b9:

    # k "My ass you are."
    k "Mi trasero eres."

# game/Story04.rpy:9842

translate spanish story05_5_6_1af8690e:

    # k "Talk. What’s wrong? You were fine a minute ago."
    k "Hablar. ¿Qué pasa?"

# game/Story04.rpy:9843

translate spanish story05_5_6_2b35b6fe_3:

    # mc "..."
    mc "..."

# game/Story04.rpy:9845

translate spanish story05_5_6_91e98007:

    # mc "The thought that I ran off and left them there…"
    mc "La idea de que salí corriendo y los dejé allí..."

# game/Story04.rpy:9846

translate spanish story05_5_6_7d8489e9:

    # mc "It won’t leave me alone."
    mc "No me dejará solo."

# game/Story04.rpy:9847

translate spanish story05_5_6_bb7453a6:

    # mc "Feels… wrong."
    mc "Se siente... mal."

# game/Story04.rpy:9849

translate spanish story05_5_6_80e357f5:

    # k "We’re all in the same boat."
    k "Estamos todos en el mismo barco."

# game/Story04.rpy:9850

translate spanish story05_5_6_cbd1e4e9:

    # k "Only difference, you don’t have a hole in your chest."
    k "Solo la diferencia, no tienes un agujero en el pecho."

# game/Story04.rpy:9853

translate spanish story05_5_6_b535bada:

    # k "You know… you should try it sometime. It really changes how you see things."
    k "Deberías intentarlo alguna vez, cambia cómo ves las cosas."

# game/Story04.rpy:9855

translate spanish story05_5_6_7a83341a:

    # mc "Funny, coming from you."
    mc "Qué gracioso, viniendo de ti."

# game/Story04.rpy:9857

translate spanish story05_5_6_cecfedf4:

    # k "I admit, you’re a bad influence."
    k "Admito que eres una mala influencia."

# game/Story04.rpy:9858

translate spanish story05_5_6_0d8dd6d4:

    # k "Before, I’d charge straight into the slaughter without thinking."
    k "Antes, yo cargaría directamente en la masacre sin pensar."

# game/Story04.rpy:9859

translate spanish story05_5_6_4333a3ed:

    # k "Now…"
    k "Ahora..."

# game/Story04.rpy:9860

translate spanish story05_5_6_70f6980c:

    # k "I still do, just with a thought."
    k "Todavía lo hago, solo con una idea."

# game/Story04.rpy:9862

translate spanish story05_5_6_ae106357:

    # mc "Progress—"
    mc "Progresos"

# game/Story04.rpy:9864

translate spanish story05_5_6_2f11cca2:

    # k "You okay?"
    k "¿Estás bien?"

# game/Story04.rpy:9871

translate spanish story05_5_6_6556f98b:

    # k "…Damn. She’s practically naked."
    k "...Damn. Ella está prácticamente desnuda."

# game/Story04.rpy:9876

translate spanish story05_5_6_50e9ed7a:

    # mc "Didn’t think that would surprise you."
    mc "No pensé que eso te sorprendería."

# game/Story04.rpy:9877

translate spanish story05_5_6_dde4a57c:

    # k "Old man, anyone would be surprised."
    k "Viejo, alguien se sorprendería."

# game/Story04.rpy:9878

translate spanish story05_5_6_731d2643:

    # k "You’ve seen how modest pointy-ears usually dresses."
    k "Has visto cómo modestos vestidos puntiagudos suelen ser."

# game/Story04.rpy:9879

translate spanish story05_5_6_3475db9b:

    # k "Now compare that to {b}this."
    k "Ahora compara eso con {b}esto."

# game/Story04.rpy:9882

translate spanish story05_5_6_7008eaa4:

    # mc "Don’t forget, we’re still in the past."
    mc "No lo olvides, estamos todavía en el pasado."

# game/Story04.rpy:9883

translate spanish story05_5_6_e72ecbea:

    # k "Which makes it even more interesting."
    k "Lo que lo hace aún más interesante."

# game/Story04.rpy:9884

translate spanish story05_5_6_3cf640dc:

    # k "People don’t just flip their worldview like that."
    k "La gente no solo gira su visión del mundo así."

# game/Story04.rpy:9887

translate spanish story05_5_6_6bef1101:

    # mc "Didn’t expect to see you like this…"
    mc "No esperaba verte así..."

# game/Story04.rpy:9889

translate spanish story05_5_6_b19aaea8:

    # Mi "Is something wrong?"
    Mi "¿Pasa algo?"

# game/Story04.rpy:9891

translate spanish story05_5_6_fc842b4e:

    # mc "You’re always so reserved… but right now there’s none of that left."
    mc "Siempre estás tan reservada... pero ahora no queda nada de eso."

# game/Story04.rpy:9893

translate spanish story05_5_6_7f2d3858:

    # Mi "I don’t understand."
    Mi "No entiendo."

# game/Story04.rpy:9895

translate spanish story05_5_6_c2e63e73:

    # k "Your outfit, pointy-ears. It barely covers anything."
    k "Tu traje, puntiagudos, apenas cubre nada."

# game/Story04.rpy:9896

translate spanish story05_5_6_f456be65:

    # Mi "Does it?"
    Mi "¿Lo es?"

# game/Story04.rpy:9897

translate spanish story05_5_6_babe1c96:

    # Mi "Everything essential is concealed."
    Mi "Todo lo esencial está escondido."

# game/Story04.rpy:9899

translate spanish story05_5_6_43b4df7b:

    # mc "If you’re comfortable, who are we to judge?"
    mc "Si estás cómodo, ¿quiénes somos nosotros para juzgar?"

# game/Story04.rpy:9900

translate spanish story05_5_6_a53fe81e:

    # mc "But… what is this?"
    mc "Pero... ¿qué es esto?"

# game/Story04.rpy:9901

translate spanish story05_5_6_f1af92db:

    # Mi "We only wear it on special occasions."
    Mi "Solo lo usamos en ocasiones especiales."

# game/Story04.rpy:9902

translate spanish story05_5_6_0fc246e8:

    # Mi "It’s a tradition passed down from ancient times."
    Mi "Es una tradición pasada de los tiempos antiguos."

# game/Story04.rpy:9908

translate spanish story05_5_6_4aa34161:

    # k "Sounds like your ancestors were just perverts."
    k "Parece que tus antepasados eran pervertidos."

# game/Story04.rpy:9910

translate spanish story05_5_6_732c19c3:

    # Mi "People see what troubles their own hearts."
    Mi "La gente ve lo que les molesta a sus propios corazones."

# game/Story04.rpy:9911

translate spanish story05_5_6_293d740e:

    # Mi "They were pure of spirit."
    Mi "Eran puros de espíritu."

# game/Story04.rpy:9912

translate spanish story05_5_6_6fe4a46f:

    # Mi "Unlike you, pervert."
    Mi "A diferencia de ti, pervertido."

# game/Story04.rpy:9915

translate spanish story05_5_6_cf7897a9:

