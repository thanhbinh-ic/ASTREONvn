    # mc "(whispering) Don’t take it to heart. I know you’re smart, stubborn too."
    mc "(susurando) No lo tomes a corazón. Sé que eres inteligente, obstinado también."

# game/Story04.rpy:3006

translate spanish story05_4_86f0a6bd:

    # h "(This…)"
    h "(Este...)"

# game/Story04.rpy:3008

translate spanish story05_4_bbd727be:

    # h "(He- he called me smart! No, stop. Get a grip, you’re smiling like an idiot…)"
    h "(Él- me llamó inteligente! No, para. Obtener un agarre, usted está sonriendo como un idiota ...)"

# game/Story04.rpy:3009

translate spanish story05_4_f862223a:

    # h "(But damn… that’s the first compliment from him in ages. Hell yeah.)"
    h "(Pero maldita... ese es el primer cumplido de él en años."

# game/Story04.rpy:3013

translate spanish story05_4_b1f5f7db:

    # mc "So, forgive the little spectacle."
    mc "Así que, perdona el pequeño espectáculo."

# game/Story04.rpy:3014

translate spanish story05_4_1863dee0:

    # mc "Now… tell me. Why are they hunting Lora?"
    mc "Ahora... dime. ¿Por qué están cazando a Lora?"

# game/Story04.rpy:3016

translate spanish story05_4_e0925be1:

    # Mi "With that knowledge, she can tune the portal to the Aby-"
    Mi "Con ese conocimiento, puede sintonizar el portal al Aby-"

# game/Story04.rpy:3017

translate spanish story05_4_d39c2a68:

    # Mi "to Earth. To the range where the second part is hidden."
    Mi "a la Tierra. A la gama donde la segunda parte está oculta."

# game/Story04.rpy:3018

translate spanish story05_4_47c41413:

    # Mi "That alone makes her the primary target for everyone."
    Mi "Solo eso la convierte en el objetivo principal para todos."

# game/Story04.rpy:3020

translate spanish story05_4_d5a2e521:

    # h "Nothing new. Looks like information is valuable everywhere."
    h "Nada nuevo, parece que la información es valiosa en todas partes."

# game/Story04.rpy:3023

translate spanish story05_4_de017464:

    # h "(But after all these revelations… I feel like crap. Like, genuinely awful.)"
    h "(Pero después de todas estas revelaciones... me siento como una mierda."

# game/Story04.rpy:3024

translate spanish story05_4_3cda5883:

    # h "(Especially since I have no idea how I’m even supposed to react to this.)"
    h "(Especialmente ya que no tengo idea de cómo se supone que debo reaccionar a esto)."

# game/Story04.rpy:3026

translate spanish story05_4_026bfd4c:

    # h "(Do I joke it off? Keep a straight face? Or just let it sink me?)"
    h "¿Mantengo una cara recta o simplemente deja que me hunda?"

# game/Story04.rpy:3027

translate spanish story05_4_5384582a:

    # h "(Judging by everyone else, and the vibe in the room, I’m afraid the confessions aren’t over yet.)"
    h "(Juzgando por todos los demás, y el vibo en la habitación, me temo que las confesiones no han terminado todavía.)"

# game/Story04.rpy:3028

translate spanish story05_4_f0449bb2:

    # mc "And the second reason?"
    mc "¿Y la segunda razón?"

# game/Story04.rpy:3030

translate spanish story05_4_b88ae97e:

    # Mi "She-"
    Mi "Ella..."

# game/Story04.rpy:3033

translate spanish story05_4_f4ba6945:

    # L "(Should I…? This moment, it could make him hate me.)"
    L "(¿Debería...? Este momento, podría hacer que me odie.)"

# game/Story04.rpy:3034

translate spanish story05_4_81b13fce:

    # L "(And yet…)"
    L "(Y aún así...)"

# game/Story04.rpy:3036

translate spanish story05_4_395f3fff:

    # L "Miriel, I…"
    L "Miriel, yo..."

# game/Story04.rpy:3037

translate spanish story05_4_c46c084c:

    # L "(And still, this is the first time I truly don’t know what will happen next.)"
    L "(Y aún así, esta es la primera vez que realmente no sé qué sucederá después)."

# game/Story04.rpy:3039

translate spanish story05_4_e785ea8d:

    # L "In a sense… I can control time. By changing the future."
    L "En cierto sentido, puedo controlar el tiempo, cambiando el futuro."

# game/Story04.rpy:3044

translate spanish story05_4_7829b1d1:

    # mc "What… does that mean, Lora?"
    mc "¿Qué significa eso, Lora?"

# game/Story04.rpy:3045

translate spanish story05_4_63cac2fd:

    # mc "(This a joke? Lora, please… tell me you’re joking. Tell me Norman’s death, my fate-)"
    mc "(Esto es una broma? Lora, por favor... dime que estás bromeando. Dime la muerte de Norman, mi destino...)"

# game/Story04.rpy:3048

translate spanish story05_4_5e283b25:

    # mc "So you knew everything that was going to happen to us?!"
    mc "¿Así que sabías todo lo que iba a pasarnos?"

# game/Story04.rpy:3050

translate spanish story05_4_2ab1ad6f:

    # mc "Then why did you still go there? Why did you-"
    mc "¿Por qué sigues ahí?"

# game/Story04.rpy:3052

translate spanish story05_4_b4300a04:

    # L "In the Abyss, I gained what others would call immortality. In reality, it’s a resurrection point."
    L "En el Abismo, gané lo que otros llamarían inmortalidad. En realidad, es un punto de resurrección."

# game/Story04.rpy:3053

translate spanish story05_4_56a4b38c:

    # L "I can’t choose the moment."
    L "No puedo elegir el momento."

# game/Story04.rpy:3054

translate spanish story05_4_23d6187e:

    # L "I can’t truly change anything."
    L "No puedo cambiar nada de verdad."

# game/Story04.rpy:3055

translate spanish story05_4_ae8fd361:

    # L "I tried to end it in a way where both of you survived."
    L "Intenté terminarlo de una manera en la que ambos sobrevivieron."

# game/Story04.rpy:3056

translate spanish story05_4_dac21ac1:

    # L "Where you both lived long, happy lives."
    L "Donde ambos vivieron largas y felices vidas."

# game/Story04.rpy:3058

translate spanish story05_4_968f0681:

    # L "And unfortunately… in that version of your lives-"
    L "Y por desgracia... en esa versión de tu vida..."

# game/Story04.rpy:3059

translate spanish story05_4_7720ad17:

    # L "I wasn’t there."
    L "No estaba allí."

# game/Story04.rpy:3060

translate spanish story05_4_cfcae04e:

    # mc "(I… nothing. Completely empty. I don’t even know what I’m supposed to feel.)"
    mc "(Yo... nada. Completamente vacío. Ni siquiera sé lo que se supone que debo sentir.)"

# game/Story04.rpy:3061

translate spanish story05_4_eb31b531:

    # mc "That’s cruel."
    mc "Eso es cruel."

# game/Story04.rpy:3063

translate spanish story05_4_62b6d5a1:

    # mc "Tell me, Lora-"
    mc "Dime, Lora..."

# game/Story04.rpy:3064

translate spanish story05_4_deb27756:

    # mc "Who gave you the right to decide what my life should be?"
    mc "¿Quién te dio el derecho de decidir cuál debería ser mi vida?"

# game/Story04.rpy:3066

translate spanish story05_4_69f9e5d1:

    # mc "(And here you are shouting… but deep down, you’re not angry at her-)"
    mc "(Y aquí estás gritando... pero en el fondo, no estás enojado con ella...)"

# game/Story04.rpy:3067

translate spanish story05_4_3380a2bd:

    # mc "Better short and happy than long and… pathetic."
    mc "Mejor corto y feliz que largo y patético."

# game/Story04.rpy:3069

translate spanish story05_4_4270af80:

    # mc "(You’re angry at yourself, at your own helplessness.)"
    mc "(Estás enfadado contigo mismo, por tu propia impotencia.)"

# game/Story04.rpy:3072

translate spanish story05_4_7c93177a:

    # L "In another timeline, you and I already talked about this."
    L "En otro cronograma, tú y yo ya hemos hablado de esto."

# game/Story04.rpy:3073

translate spanish story05_4_3d06a61b:

    # L "And… yes. You’re right."
    L "Y... sí. Tienes razón."

# game/Story04.rpy:3076

translate spanish story05_4_00f56f0c:

    # L "But if our fates were reversed-"
    L "Pero si nuestros destinos se revirtieron..."

# game/Story04.rpy:3077

translate spanish story05_4_2ad09a73:

    # L "Tell me… would you have done it differently?"
    L "Dime... ¿lo habrías hecho de otra manera?"

# game/Story04.rpy:3078

translate spanish story05_4_02ea37af:

    # mc "(You know exactly why she did it. Because you would’ve done the same damn thing.)"
    mc "(Sabes exactamente por qué lo hizo. Porque habrías hecho lo mismo maldita cosa.)"

# game/Story04.rpy:3080

translate spanish story05_4_d7afdc3b:

    # mc "I-"
    mc "Yo..."

# game/Story04.rpy:3081

translate spanish story05_4_898319c0:

    # mc "No. I wouldn’t have been able to."
    mc "No. No habría podido."

# game/Story04.rpy:3083

translate spanish story05_4_82091822_2:

    # k "..."
    k "..."

# game/Story04.rpy:3084

translate spanish story05_4_0ec0ed91:

    # k "(That… didn’t sit right with me.)"
    k "(Eso... no se sentó bien conmigo.)"

# game/Story04.rpy:3086

translate spanish story05_4_b1891b23:

    # k "(The hell? What kind of nonsense is that? Why would I even care?)"
    k "¿Qué clase de tonterías es esa? ¿Por qué me importaría?"

# game/Story04.rpy:3087

translate spanish story05_4_b99b7f97:

    # k "Hmpf..."
    k "Hmpf..."

# game/Story04.rpy:3089

translate spanish story05_4_85e1772a:

    # mc "(And that’s why it hurts, because she lived what should’ve been yours.)"
    mc "(Y por eso duele, porque ella vivió lo que debía haber sido tuyo)."

# game/Story04.rpy:3092

translate spanish story05_4_c487bd12:

    # L "That’s exactly why…"
    L "Es exactamente por eso..."

# game/Story04.rpy:3093

translate spanish story05_4_c93115dd:

    # L "I’m asking you to forgive me for it."
    L "Te pido que me perdones por ello."

# game/Story04.rpy:3095

translate spanish story05_4_bff0737e:

    # mc "(So what am I supposed to do now…?)"
    mc "¿Qué se supone que debo hacer ahora?"

# game/Story04.rpy:3100

translate spanish story05_4_fabefd5b:

    # mc "(Looking at yourself from the outside… yeah. You’re disgusting.)"
    mc "(Mirándote desde afuera... sí. Eres repugnante.)"

# game/Story04.rpy:3101

translate spanish story05_4_bd80f36b:

    # mc "(Sitting here, crying like a little girl, debating forgiveness-)"
    mc "(Sentado aquí, llorando como una niña, debatiendo el perdón)"

# game/Story04.rpy:3102

translate spanish story05_4_4c89217e:

    # mc "(while doing absolutely nothing yourself.)"
    mc "(mientras no haces absolutamente nada a ti mismo.)"

# game/Story04.rpy:3110

translate spanish story05_4_c0a317d1:

    # mc "(Forgive her? But can I…? Too much time has passed.)"
    mc "¿Puedo...? Ha pasado mucho tiempo."

# game/Story04.rpy:3111

translate spanish story05_4_26262e2e:

    # mc "(And even if I did, could we really live like before? I doubt it.)"
    mc "(Y aunque lo hiciera, ¿podemos vivir como antes? Lo dudo.)"

# game/Story04.rpy:3113

translate spanish story05_4_f3052438:

    # mc "Part of me wants to forgive you, Lora. But the other part-"
    mc "Parte de mí quiere perdonarte, Lora, pero la otra parte..."

# game/Story04.rpy:3114

translate spanish story05_4_c9b35284:

    # mc "I’m trying. I really am. But… I can’t."
    mc "Lo estoy intentando. Lo estoy. Pero... no puedo."

# game/Story04.rpy:3120

translate spanish story05_4_2e9d06b8:

    # h "You know… it actually hurts to watch this. And the thought that my whole life’s already been decided? That makes it even worse."
    h "Sabes... realmente duele ver esto. ¿Y el pensamiento de que toda mi vida ya ha sido decidida? Eso lo hace aún peor."

# game/Story04.rpy:3123

translate spanish story05_4_1ae22209:

    # h "But why tell us all this now? Why not sooner?"
    h "¿Por qué no nos cuentas todo esto ahora?"

# game/Story04.rpy:3126

translate spanish story05_4_105178e2:

    # h "I seriously doubt it’s because of that gorilla’s sister."
    h "Dudo que sea por la hermana de ese gorila."

# game/Story04.rpy:3128

translate spanish story05_4_0d903063:

    # k "I can hear you, shorty."
    k "Puedo oírte, cariño."

# game/Story04.rpy:3129

translate spanish story05_4_2fded262_1:

    # h "..."
    h "..."

# game/Story04.rpy:3133

translate spanish story05_4_19546ddb:

    # mc "(She had her reasons. And… in the end, I understand why she did it.)"
    mc "(Ella tenía sus razones y... al final, entiendo por qué lo hizo.)"

# game/Story04.rpy:3134

translate spanish story05_4_eb118c42:

    # mc "(Yes, she abandoned everything, but was it truly her choice?)"
    mc "(Sí, ella lo abandonó todo, pero ¿era realmente su elección?)"

# game/Story04.rpy:3137

translate spanish story05_4_4a0bc9ad:

    # L "What are you-"
    L "¿Qué estás...?"

# game/Story04.rpy:3140

translate spanish story05_4_8cfaeec7:

    # mc "(Blaming her for that? Ridiculous.)"
    mc "¿La golpeó por eso?"

# game/Story04.rpy:3141

translate spanish story05_4_7a69b945:

    # mc "(Some would call this foolish. Naive.)"
    mc "(Algunos llamarían a este tonto."

# game/Story04.rpy:3142

translate spanish story05_4_32962abc:

    # mc "(But she’s the reason I set out on this journey in the first place.)"
    mc "(Pero ella es la razón por la que partí en este viaje en primer lugar.)"

# game/Story04.rpy:3144

translate spanish story05_4_020555ec:

    # mc "(All of us had our ups and downs. Watching everyone along the way, everyone grew.)"
    mc "(Todos nosotros teníamos nuestros altibajos. Al mirar a todos a lo largo del camino, todos crecieron.)"

# game/Story04.rpy:3145

translate spanish story05_4_25c560cb:

    # mc "(Everyone… except me.)"
    mc "(Todos... excepto yo.)"

# game/Story04.rpy:3146

translate spanish story05_4_0085853b:

    # mc "(How many times were decisions made for me? How often did I just stand there, powerless?)"
    mc "(¿Cuántas veces se tomaron decisiones para mí? ¿Con qué frecuencia me quedé ahí, sin poder?)"

# game/Story04.rpy:3149

translate spanish story05_4_92f874f1:

    # mc "(But I’m not powerless. I have a choice.)"
    mc "(Pero no soy impotente. Tengo una opción.)"

# game/Story04.rpy:3150

translate spanish story05_4_147d4d11:

    # mc "(And this, this is my chance.)"
    mc "(Y esto, esta es mi oportunidad.)"

# game/Story04.rpy:3151

translate spanish story05_4_98a440bd:

    # mc "(I can’t change the past.)"
    mc "(No puedo cambiar el pasado.)"

# game/Story04.rpy:3152

translate spanish story05_4_8d40f515:

    # mc "(But I can shape the future.)"
    mc "(Pero puedo dar forma al futuro.)"

# game/Story04.rpy:3154

translate spanish story05_4_bab0c0e8:

    # k "What kind of cheap melodrama are they putting on now..."
    k "¿Qué tipo de melodrama barato están poniendo ahora ..."

# game/Story04.rpy:3155

translate spanish story05_4_29cdf8bc:

    # k "Makes me sick just watching."
    k "Me enferma solo mirándome."

# game/Story04.rpy:3157

translate spanish story05_4_ab72e872:

    # Mi "I’m glad to see them like this."
    Mi "Me alegra verlos así."

# game/Story04.rpy:3158

translate spanish story05_4_b093676e:

    # Mi "They value each other more than anything. It reminds me of home…"
    Mi "Se valoran más que nada, me recuerda a casa..."

# game/Story04.rpy:3160

translate spanish story05_4_4a062be5:

    # k "Yeah, sure. A relationship built on lies."
    k "Una relación basada en mentiras."

# game/Story04.rpy:3161

translate spanish story05_4_90a449e7:

    # k "That’s hilarious."
    k "Eso es gracioso."

# game/Story04.rpy:3163

translate spanish story05_4_85159be2:

    # Mi "You’re just jealous of them."
    Mi "Solo estás celoso de ellos."

# game/Story04.rpy:3164

translate spanish story05_4_82091822_3:

    # k "..."
    k "..."

# game/Story04.rpy:3166

translate spanish story05_4_36b747dc:

    # mc "Why are you two just standing there?"
    mc "¿Por qué están ahí parados?"

# game/Story04.rpy:3167

translate spanish story05_4_460cb1c5:

    # h "We’re a team, aren’t we?"
    h "Somos un equipo, ¿no?"

# game/Story04.rpy:3168

translate spanish story05_4_ccdd4004:

    # h "(whispering) Even that gorilla..."
    h "Incluso ese gorila..."

# game/Story04.rpy:3170

translate spanish story05_4_850ef128:

    # b "..."
    "{color=#ff8899}Ambos{/color}" "..."

# game/Story04.rpy:3173

translate spanish story05_4_3aa4057f:

    # mc "(I didn’t want to return to that old life. I really didn’t.)"
    mc "(No quería volver a esa vieja vida. Realmente no lo hice.)"

# game/Story04.rpy:3174

translate spanish story05_4_8c184579:

    # mc "(But their lives depend on my decisions.)"
    mc "(Pero sus vidas dependen de mis decisiones.)"

# game/Story04.rpy:3175

translate spanish story05_4_9168f769:

    # mc "(I won’t let them down.)"
    mc "(No los decepcionaré.)"

# game/Story04.rpy:3181

translate spanish story05_4_3770ae6a:

    # mc "(That doesn’t mean I’ll let her mistakes destroy us.)"
    mc "(Eso no significa que deje que sus errores nos destruyan.)"

# game/Story04.rpy:3182

translate spanish story05_4_70c2b435:

    # mc "(The team comes first. I won’t let them suffer because of my choice.)"
    mc "(El equipo viene primero. No dejaré que sufran debido a mi elección.)"

# game/Story04.rpy:3184

translate spanish story05_4_3148890a:

    # mc "(I can’t just forget the pain and pretend everything’s fine.)"
    mc "(No puedo olvidar el dolor y fingir que todo está bien.)"

# game/Story04.rpy:3185

translate spanish story05_4_31f742db:

    # mc "(No… it’s better to leave everything between us in the past.)"
    mc "(No... es mejor dejar todo entre nosotros en el pasado.)"

# game/Story04.rpy:3187

translate spanish story05_4_87c7398c:

    # mc "I tried. I really did."
    mc "Lo intenté, de verdad."

# game/Story04.rpy:3188

translate spanish story05_4_3fb3bb5b:

    # mc "But I can’t forgive you."
    mc "Pero no puedo perdonarte."

# game/Story04.rpy:3189

translate spanish story05_4_7298bc80:

    # mc "And in the end… I’m no better."
    mc "Y al final... no soy mejor."

# game/Story04.rpy:3191

translate spanish story05_4_2717735e:

    # L "(So that’s it? It’s over… between us?)"
    L "(¿Así que eso es todo? Se acabó... entre nosotros?)"

# game/Story04.rpy:3192

translate spanish story05_4_b08cb254:

    # L "(No, Lora. Breathe. You knew it could end like this.)"
    L "(No, Lora. Respira, sabías que podría terminar así.)"

# game/Story04.rpy:3194

translate spanish story05_4_388ea11a:

    # L "Alright, love. If that’s your choice… I’ll accept it."
    L "De acuerdo, amor. Si es tu elección... lo aceptaré."

# game/Story04.rpy:3196

translate spanish story05_4_bd9b69aa:

    # mc "(Please, don’t look at me like that. Don’t turn me into the villain.)"
    mc "(Por favor, no me mires así. No me conviertas en el villano.)"

# game/Story04.rpy:3197

translate spanish story05_4_e3b73606:

    # mc "Let’s move. We’ve got things to discuss."
    mc "Vamos a movernos. Tenemos cosas que discutir."

# game/Story04.rpy:3199

translate spanish story05_4_e122b4bf:

    # L "Yes, and…"
    L "Sí, y..."

# game/Story04.rpy:3200

translate spanish story05_4_4f00bda4:

    # L "I’m sorry."
    L "Lo siento."

# game/Story04.rpy:3205

translate spanish story05_4_1354722b:

    # "Minutes later, in pairs."
    "Minutos más tarde, en pares."

# game/Story04.rpy:3206

translate spanish story05_4_8b62f193:

    # "Silence swallowed the room, thick and heavy, pressing down on everyone like it had weight you could feel."
    "El silencio tragó la habitación, gruesa y pesada, presionando a todos como si tuviera peso que pudieras sentir."

# game/Story04.rpy:3209

translate spanish story05_4_f235b29c:

    # mc "(That was a hard performance. But it was necessary.)"
    mc "(Eso fue un desempeño difícil, pero fue necesario.)"

# game/Story04.rpy:3211

translate spanish story05_4_01bfd98e:

    # mc "(The situation is clearer now than it was before. That’s a plus.)"
    mc "(La situación es más clara ahora que antes. Eso es un plus.)"

# game/Story04.rpy:3213

translate spanish story05_4_838871fc:

    # mc "(The weight of it, though, that’s the real cost.)"
    mc "(El peso de ella, sin embargo, es el costo real.)"

# game/Story04.rpy:3214

translate spanish story05_4_8551c05a:

    # mc "(We’re carrying problems on a galactic scale.)"
    mc "(Estamos llevando problemas a escala galáctica)."

# game/Story04.rpy:3216

translate spanish story05_4_476624b8:

    # h "So… Astoria isn’t acting because she wants her sister back?"
    h "Así que... ¿Astoria no actúa porque quiere a su hermana de vuelta?"

