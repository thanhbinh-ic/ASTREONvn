    # a "Or save her."
    a "O salvarla."

# game/Story04.rpy:6672

translate spanish story05_5_2_2b35b6fe_6:

    # mc "..."
    mc "..."

# game/Story04.rpy:6675

translate spanish story05_5_2_86ebc2ca:

    # a "They’ll either save her…"
    a "O la salvarán..."

# game/Story04.rpy:6676

translate spanish story05_5_2_42ac0a14:

    # a "Or turn her into one of those Soulless you’ve been killing."
    a "O convertirla en uno de esos Desalmados que has estado matando."

# game/Story04.rpy:6678

translate spanish story05_5_2_16810d06:

    # mc "(If that’s what it takes for her to live…)"
    mc "(Si eso es lo que se necesita para que viva...)"

# game/Story04.rpy:6679

translate spanish story05_5_2_1f96c707:

    # mc "(And if it fails, I’ll have to be the one to kill her.)"
    mc "(Y si falla, tendré que ser el que la mate.)"

