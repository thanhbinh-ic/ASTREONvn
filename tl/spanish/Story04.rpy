    # h "It wasn’t me!"
    h "¡No fui yo!"

# game/Story04.rpy:4648

translate spanish story05_8_2fecf3d4:

    # h "I think?"
    h "¿Creo?"

# game/Story04.rpy:4650

translate spanish story05_8_10096254:

    # h "I mean, who would’ve thought one little poke would knock him out cold?"
    h "Quiero decir, ¿quién habría pensado que una pequeña poke lo desbarataría?"

# game/Story04.rpy:4651

