translate spanish story05_5_1_f73b9618:

    # mc "We came here to stop the Gates from opening."
    mc "Vinimos aquí para detener a las puertas de la apertura."

# game/Story04.rpy:5705

translate spanish story05_5_1_c27888fd:

    # mc "We don’t need to kill her."
    mc "No necesitamos matarla."

# game/Story04.rpy:5706

translate spanish story05_5_1_1d0c4c6b:

    # mc "Selvaria’s just the symptom. The Gates are the disease."
    mc "La Selvaria es el síntoma. Las puertas son la enfermedad."

# game/Story04.rpy:5709

translate spanish story05_5_1_b999e60d:

    # mc "Everyone remembers what happens if they stay open."
    mc "Todo el mundo recuerda lo que pasa si se mantienen abiertos."

# game/Story04.rpy:5710

translate spanish story05_5_1_f22c426d:

    # mc "Everything alive dies."
    mc "Todo vivo muere."

# game/Story04.rpy:5711

translate spanish story05_5_1_043186df:

    # mc "(I didn’t come here for anyone’s ideals. I came to survive.)"
    mc "(No vine aquí por los ideales de nadie. Vine a sobrevivir.)"

# game/Story04.rpy:5712

translate spanish story05_5_1_dea6267c:

    # mc "(And protect what matters to me.)"
    mc "(Y proteger lo que me importa.)"

# game/Story04.rpy:5713

translate spanish story05_5_1_3626803b:

    # h "(That look of his… Damn. It actually gives hope.)"
    h "(Ese aspecto de su... maldición."

# game/Story04.rpy:5716

translate spanish story05_5_1_b8cdaa4a:

    # h "…There’s something to that."
    h "... Hay algo en eso."

# game/Story04.rpy:5718

translate spanish story05_5_1_bcae72f7:

    # Mi "We’re talking about an ancient mechanism here."
    Mi "Estamos hablando de un mecanismo antiguo aquí."

# game/Story04.rpy:5719

translate spanish story05_5_1_42fef246:

    # Mi "How exactly do you plan to shut all that down?"
    Mi "¿Cómo planeas cerrar todo eso?"

# game/Story04.rpy:5721

translate spanish story05_5_1_c5c637cc:

    # mc "You got a better idea?"
    mc "¿Tienes una idea mejor?"

# game/Story04.rpy:5724

translate spanish story05_5_1_934b0853:

    # Mi "…no."
    Mi "...no."

# game/Story04.rpy:5726

translate spanish story05_5_1_2a24def7:

    # mc "We won’t stop Selvaria by killing her. We’ll just die trying."
    mc "No pararemos a Selvaria matándola. Moriremos intentando."

# game/Story04.rpy:5727

translate spanish story05_5_1_3ccfbc5f:

    # k "So what’s your genius plan?"
    k "¿Cuál es tu plan de genios?"

# game/Story04.rpy:5729

translate spanish story05_5_1_f2d8a4eb:

    # L "May I?"
    L "¿Puedo?"

# game/Story04.rpy:5730

translate spanish story05_5_1_cf1adef2:

    # mc "Yeah."
    mc "Sí."

# game/Story04.rpy:5733

translate spanish story05_5_1_58de5b05:

    # L "The Gates use a cooling system."
    L "Las puertas usan un sistema de refrigeración."

# game/Story04.rpy:5734

translate spanish story05_5_1_a1ab3531:

    # L "If we block it… in theory, it should force a shutdown."
    L "Si lo bloqueamos... en teoría, debería forzar una clausura."

# game/Story04.rpy:5736

translate spanish story05_5_1_47b11890:

    # Mi "“In theory”?"
    Mi "¿En teoría?"

# game/Story04.rpy:5737

translate spanish story05_5_1_4979b433:

    # Mi "So, no guarantees?"
    Mi "¿No hay garantías?"

# game/Story04.rpy:5738

translate spanish story05_5_1_9993b94e:

    # L "..."
    L "..."

# game/Story04.rpy:5739

translate spanish story05_5_1_b86c4f82:

    # mc "(Hands shaking. Breathing uneven.)"
    mc "(Las manitas temblan, respirando desparejos.)"

# game/Story04.rpy:5740

translate spanish story05_5_1_be19d10c:

    # mc "(Yeah… now I see why she considered siding with Selvaria.)"
    mc "(Sí... ahora veo por qué ella consideraba estar con Selvaria.)"

# game/Story04.rpy:5743

translate spanish story05_5_1_9e8bef14:

    # k "(That damn understanding look.)"
    k "(Ese maldito look comprensivo.)"

# game/Story04.rpy:5744

translate spanish story05_5_1_82ee465c:

    # k "(After all her mistakes… why does he still look at her like that?)"
    k "(Después de todos sus errores... ¿por qué todavía la mira así?)"

# game/Story04.rpy:5747

translate spanish story05_5_1_e26443a8:

    # k "You know, she’s really starting to piss me off."
    k "Sabes, ella está empezando a enojarme."

# game/Story04.rpy:5748

translate spanish story05_5_1_78486174:

    # h "Huh?"
    h "¿Eh?"

# game/Story04.rpy:5749

translate spanish story05_5_1_ccfeb021:

    # k "You’re the scientist. And you don’t know squat?"
    k "Eres el científico. ¿Y no sabes nada?"

# game/Story04.rpy:5750

translate spanish story05_5_1_5e71a4bb:

    # k "Funny."
    k "Qué gracioso."

# game/Story04.rpy:5751

translate spanish story05_5_1_cd5814d5:

    # k "Feels like you’re holding something back."
    k "Se siente como si estuvieras reteniendo algo."

# game/Story04.rpy:5753

translate spanish story05_5_1_0297642d:

    # mc "Lora?"
    mc "¿Lora?"

# game/Story04.rpy:5754

translate spanish story05_5_1_37019371:

    # L "I really don’t know… Yes, I worked with the Gates. That’s true."
    L "Realmente no lo sé... Sí, trabajé con las Puertas. Eso es verdad."

# game/Story04.rpy:5755

translate spanish story05_5_1_a07d9ad7:

    # L "But I only opened them. Closing them? All I have are theories dug out of tombs."
    L "Pero solo los abrí, cerrándolos, solo tengo teorías que se desenterran de tumbas."

# game/Story04.rpy:5758

translate spanish story05_5_1_5e6f3792:

    # h "So we’re screwed. Correct?"
    h "Así que estamos jodidos. ¿Correcto?"

# game/Story04.rpy:5760

translate spanish story05_5_1_1d0ffab1:

    # mc "(Chase a slim chance… or walk straight into the beast’s den and try to talk?)"
    mc "(¿Cambiar una oportunidad delgada... o caminar directamente en la cueva de la bestia y tratar de hablar?)"

