    # h "Yo! How’s it looking? We coming down?"
    h "¿Cómo está? ¿Bajamos?"

# game/Story04.rpy:5176

translate spanish story05_5_1_64a8ca27:

    # k "Don’t overthink it. Might be a lousy option, but hey-"
    k "No lo pienses demasiado. Podría ser una opción mala, pero..."

# game/Story04.rpy:5177

translate spanish story05_5_1_393d210a:

    # k "sharing the fate of the guys upstairs isn’t on my to-do list."
    k "compartir el destino de los chicos de arriba no está en mi lista de tareas."

# game/Story04.rpy:5180

translate spanish story05_5_1_551b8412:

    # mc "Same here."
    mc "Igual aquí."

# game/Story04.rpy:5183

translate spanish story05_5_1_acd6e0e6:

    # mc "Come down!"
    mc "¡Baja!"

# game/Story04.rpy:5190

translate spanish story05_5_1_2fded262:

    # h "..."
    h "..."

# game/Story04.rpy:5192

translate spanish story05_5_1_5f6f84be:

    # h "Put me down."
    h "Bájame."

# game/Story04.rpy:5194

translate spanish story05_5_1_5d6f637b:

    # mc "On the bright side, you finally got some height."
    mc "En el lado brillante, finalmente tienes algo de altura."

# game/Story04.rpy:5196

translate spanish story05_5_1_1343054b:

    # h "On the dark side, I might die of embarrassment."
    h "En el lado oscuro, podría morir de vergüenza."

# game/Story04.rpy:5198

translate spanish story05_5_1_e8fbef1e:

    # mc "Pick your poison."
    mc "Escoge tu veneno."

# game/Story04.rpy:5201

translate spanish story05_5_1_56c76061:

    # h "Oh, shut up."
    h "Cállate."

# game/Story04.rpy:5205

translate spanish story05_5_1_b63bac94:

    # h "(whispering) Look… I do value what we’ve got. Really."
    h "Mira... valoro lo que tenemos."

# game/Story04.rpy:5206

translate spanish story05_5_1_eeeb75ba:

    # h "(whispering) But maybe don’t do that while the gorilla’s watching, yeah?"
    h "Pero tal vez no hagas eso mientras el gorila está mirando, ¿sí?"

# game/Story04.rpy:5208

translate spanish story05_5_1_6fb1465c:

    # mc "Noted."
    mc "Anotado."

# game/Story04.rpy:5211

translate spanish story05_5_1_682e89fa:

    # mc "Next!"
    mc "¡Siguiente!"

# game/Story04.rpy:5214

translate spanish story05_5_1_833f4414:

    # Mi "Thank you… but I can manage."
    Mi "Gracias... pero puedo manejarlo."

# game/Story04.rpy:5216

translate spanish story05_5_1_30f41abf:

    # h "Oh! That reminds me-"
    h "Eso me recuerda..."

# game/Story04.rpy:5217

translate spanish story05_5_1_12e82dff:

    # h "The Soulless… they’re basically humans in mutant bodies, right?"
    h "Los Desalmados... básicamente son humanos en cuerpos mutantes, ¿verdad?"

# game/Story04.rpy:5219

translate spanish story05_5_1_694a4fa2:

    # k "Where are you going with this?"
    k "¿Adónde vas con esto?"

# game/Story04.rpy:5220

translate spanish story05_5_1_92a52439:

    # h "How… do they spread?"
    h "¿Cómo... se propagan?"

# game/Story04.rpy:5224

translate spanish story05_5_1_1ba69910:

    # mc "That’s—"
    mc "Eso es..."

# game/Story04.rpy:5226

translate spanish story05_5_1_80ef4c61:

    # L "Through the air."
    L "Por el aire."

# game/Story04.rpy:5227

translate spanish story05_5_1_5b98c85d:

    # L "(whispering) Thank you, dear."
    L "Gracias, querida."

# game/Story04.rpy:5229

translate spanish story05_5_1_53dda515:

    # h "Wait wait, what do you mean {b}through the air{/b}?!"
    h "Espera, espera, ¿qué quieres decir? {b}a través del aire{/b}?!"

# game/Story04.rpy:5230

translate spanish story05_5_1_f79bb8fc:

    # h "There are mutants everywhere outside, how are we still alive?!"
    h "Hay mutantes por todas partes afuera, ¿cómo estamos vivos?!"

# game/Story04.rpy:5232

translate spanish story05_5_1_de9595e8:

    # k "Hey. Old man."
    k "Viejo."

# game/Story04.rpy:5233

translate spanish story05_5_1_ab635f33:

    # k "You planning on putting her down anytime soon?"
    k "¿Planeas bajarla pronto?"

# game/Story04.rpy:5235

translate spanish story05_5_1_1cb78db2:

    # h "Funny."
    h "Qué gracioso."

# game/Story04.rpy:5236

translate spanish story05_5_1_27d7f257:

    # h "Didn’t look like you had a problem getting close earlier."
    h "No parecía que tuvieras un problema para acercarte antes."

# game/Story04.rpy:5238

translate spanish story05_5_1_afd941c6:

    # k "That was necessary."
    k "Eso fue necesario."

# game/Story04.rpy:5239

translate spanish story05_5_1_f7d953ec:

    # k "You want him stable, or sentimental?"
    k "¿Lo quieres estable o sentimental?"

# game/Story04.rpy:5241

translate spanish story05_5_1_b043f8ef:

    # mc "Enough. Not here."
    mc "Basta, no aquí."

# game/Story04.rpy:5242

translate spanish story05_5_1_9cf63763:

    # mc "We’re talking about the air."
    mc "Estamos hablando del aire."

# game/Story04.rpy:5244

translate spanish story05_5_1_09d19a7d:

    # L "Airborne, yes."
    L "Airborne, sí."

# game/Story04.rpy:5245

translate spanish story05_5_1_3fcae73d:

    # L "But it depends on the concentration."
    L "Pero depende de la concentración."

# game/Story04.rpy:5251

translate spanish story05_5_1_1ba69910_1:

    # mc "That’s—"
    mc "Eso es..."

# game/Story04.rpy:5254

translate spanish story05_5_1_80ef4c61_1:

    # L "Through the air."
    L "Por el aire."

# game/Story04.rpy:5256

translate spanish story05_5_1_53dda515_1:

    # h "Wait wait, what do you mean {b}through the air{/b}?!"
    h "Espera, espera, ¿qué quieres decir? {b}a través del aire{/b}?!"

# game/Story04.rpy:5257

translate spanish story05_5_1_f79bb8fc_1:

    # h "There are mutants everywhere outside, how are we still alive?!"
    h "Hay mutantes por todas partes afuera, ¿cómo estamos vivos?!"

# game/Story04.rpy:5259

translate spanish story05_5_1_09d19a7d_1:

    # L "Airborne, yes."
    L "Airborne, sí."

# game/Story04.rpy:5260

translate spanish story05_5_1_3fcae73d_1:

    # L "But it depends on the concentration."
    L "Pero depende de la concentración."

# game/Story04.rpy:5270

translate spanish story05_5_1_d14216c9:

    # h "Oh."
    h "Oh."

# game/Story04.rpy:5271

translate spanish story05_5_1_b197b574:

    # h "So the miasma’s already down here."
    h "Así que el miasma ya está aquí abajo."

# game/Story04.rpy:5272

translate spanish story05_5_1_1452f338:

    # L "Miasma isn’t a cloud."
    L "Miasma no es una nube."

# game/Story04.rpy:5273

translate spanish story05_5_1_3d6ee869:

    # L "It’s an environment."
    L "Es un ambiente."

# game/Story04.rpy:5276

translate spanish story05_5_1_26457832:

    # mc "Why the sudden question?"
    mc "¿Por qué la pregunta repentina?"

# game/Story04.rpy:5280

translate spanish story05_5_1_da4058bd:

    # h "Lower City run."
    h "Corre por la ciudad baja."

# game/Story04.rpy:5281

translate spanish story05_5_1_a0096862:

    # h "Same smell there as here."
    h "El mismo olor que aquí."

# game/Story04.rpy:5283

translate spanish story05_5_1_ac096bbf:

    # h "And those massive ventilation shafts… like someone was deliberately spreading it—"
    h "Y esos enormes pozos de ventilación... como si alguien lo estuviera propagando deliberadamente..."

# game/Story04.rpy:5285

translate spanish story05_5_1_9da91900:

    # h "(coughs)"
    h "(risas)"

# game/Story04.rpy:5288

translate spanish story05_5_1_1f0f2838:

    # L "Breathe…"
    L "Respira..."

# game/Story04.rpy:5289

translate spanish story05_5_1_ff79c8ca:

    # L "I thought it was strange too, but—"
    L "Pensé que era extraño también, pero..."

# game/Story04.rpy:5291

translate spanish story05_5_1_95042f17:

    # mc "Lora. A word."
    mc "Lora, una palabra."

# game/Story04.rpy:5292

translate spanish story05_5_1_da5a1401:

    # L "Of course, dear."
    L "Por supuesto, querida."

# game/Story04.rpy:5293

translate spanish story05_5_1_e6050af1:

    # L "You feeling better?"
    L "¿Te sientes mejor?"

# game/Story04.rpy:5295

translate spanish story05_5_1_fc809da6:

    # h "Y-yeah… thanks."
    h "Sí... gracias."

# game/Story04.rpy:5298

translate spanish story05_5_1_a2f4c5ce:

    # mc "That device."
    mc "Ese dispositivo."

# game/Story04.rpy:5299

translate spanish story05_5_1_49791b99:

    # mc "Why did you give it to me?"
    mc "¿Por qué me lo diste?"

# game/Story04.rpy:5302

translate spanish story05_5_1_a7a878b9:

    # L "The Blood of the Ancients…"
    L "La Sangre de los Antiguos..."

# game/Story04.rpy:5303

translate spanish story05_5_1_c0613909:

    # L "Please, don’t be angry. I’ll explain."
    L "Por favor, no te enojes. Te lo explicaré."

# game/Story04.rpy:5306

translate spanish story05_5_1_2b35b6fe:

    # mc "..."
    mc "..."

# game/Story04.rpy:5309

translate spanish story05_5_1_60e4a9a2:

    # L "(whispering) I want to believe we’ll make it through this…"
    L "Quiero creer que lo lograremos a través de esto..."

# game/Story04.rpy:5310

translate spanish story05_5_1_ec948dc4:

    # L "(whispering) But if something happens to you…"
    L "Pero si algo te pasa..."

# game/Story04.rpy:5313

translate spanish story05_5_1_6a0a0348:

    # L "Please… use it."
    L "Por favor... úsalo."

# game/Story04.rpy:5315

translate spanish story05_5_1_b30c84bc:

    # mc "It kills."
    mc "Mata."

# game/Story04.rpy:5317

translate spanish story05_5_1_de3c5539:

    # L "Everything is poison. Everything is medicine."
    L "Todo es veneno, todo es medicina."

# game/Story04.rpy:5318

translate spanish story05_5_1_8097260f:

    # L "It’s all in the dose."
    L "Está todo en la dosis."

# game/Story04.rpy:5319

translate spanish story05_5_1_bde3b303:

    # L "A rapid release will cause an explosion."
    L "Una liberación rápida causará una explosión."

# game/Story04.rpy:5321

translate spanish story05_5_1_5d8324e4:

    # L "A slow one…"
    L "Una lenta..."

# game/Story04.rpy:5322

translate spanish story05_5_1_5de31203:

    # L "…can heal even a fatal wound."
    L "...puede curar incluso una herida fatal."

# game/Story04.rpy:5324

translate spanish story05_5_1_2b35b6fe_1:

    # mc "..."
    mc "..."

# game/Story04.rpy:5326

translate spanish story05_5_1_2a60b690:

    # mc "I don’t agree with this, Lora."
    mc "No estoy de acuerdo con esto, Lora."

# game/Story04.rpy:5328

translate spanish story05_5_1_4a70f78d:

    # L "I know, dear, but—"
    L "Lo sé, querida, pero..."

# game/Story04.rpy:5329

translate spanish story05_5_1_2b35b6fe_2:

    # mc "..."
    mc "..."

# game/Story04.rpy:5330

translate spanish story05_5_1_8a6eece3:

    # mc "(This thing carries other people’s lives… and you want me to spend them?)"
    mc "(Esta cosa lleva la vida de otras personas... ¿y quieres que los gaste?)"

# game/Story04.rpy:5331

translate spanish story05_5_1_430be8f1:

    # mc "(How am I supposed to justify that…)"
    mc "(Cómo se supone que debo justificar eso...)"

# game/Story04.rpy:5333

translate spanish story05_5_1_69fb4ecf:

    # mc "Let’s hope it never comes to that."
    mc "Esperemos que nunca llegue a eso."

# game/Story04.rpy:5342

translate spanish story05_5_1_54fe35bc:

    # "Once again, ventilation shafts."
    "Una vez más, los ejes de ventilación."

# game/Story04.rpy:5344

translate spanish story05_5_1_bf377989:

    # mc "Let's move."
    mc "走吧。"

# game/Story04.rpy:5347

translate spanish story05_5_1_06c08d43:

    # mc "(The closer we get to the center… the worse it feels.)"
    mc "(Lo más cerca que llegamos al centro... lo peor que se siente.)"

# game/Story04.rpy:5348

translate spanish story05_5_1_dd2652d3:

    # mc "(Every instinct I have is screaming, run. Run as fast as you can.)"
    mc "(Todo instinto que tengo es gritar, correr. Correr tan rápido como puedas.)"

# game/Story04.rpy:5351

translate spanish story05_5_1_b0ba7e15:

    # mc "(But my legs keep walking.)"
    mc "(Pero mis piernas siguen caminando)."

# game/Story04.rpy:5353

translate spanish story05_5_1_d3bdf312:

    # mc "(I’ve never been the kind of person who’d give his life for someone else.)"
    mc "(Nunca he sido el tipo de persona que daría su vida por otra persona.)"

# game/Story04.rpy:5354

translate spanish story05_5_1_960f62c0:

    # mc "(If anything… the opposite.)"
    mc "(Si algo... lo contrario.)"

# game/Story04.rpy:5355

translate spanish story05_5_1_45860ad5:

    # mc "(And yet… when I look at them…)"
    mc "(Y aún... cuando los miro...)"

# game/Story04.rpy:5357

translate spanish story05_5_1_fd05093f:

    # Mi "...Are you okay?"
    Mi "...¿estás bien?"

# game/Story04.rpy:5359

translate spanish story05_5_1_2f61aa8f:

    # mc "Yeah. Why?"
    mc "Sí. ¿Por qué?"

# game/Story04.rpy:5360

translate spanish story05_5_1_6952480b:

    # Mi "(Something’s weighing on him.)"
    Mi "(Algo pesa sobre él.)"

# game/Story04.rpy:5361

translate spanish story05_5_1_e20615d8:

    # Mi "(He looks steady on the outside, but…)"
    Mi "(Se ve estable en el exterior, pero...)"

# game/Story04.rpy:5364

translate spanish story05_5_1_98261078:

    # Mi "(whispering) Deep down… you’re afraid…"
    Mi "En el fondo... tienes miedo..."

# game/Story04.rpy:5365

translate spanish story05_5_1_2b35b6fe_3:

    # mc "..."
    mc "..."

# game/Story04.rpy:5368

translate spanish story05_5_1_69b9be19:

    # Mi "We’re… more sensitive to our surroundings."
    Mi "Somos... más sensibles a nuestro entorno."

# game/Story04.rpy:5370

translate spanish story05_5_1_1a711067:

    # Mi "And…"
    Mi "Y..."

# game/Story04.rpy:5375

translate spanish story05_5_1_fc46fa94:

    # mc "(whispering) Thanks, Miriel."
    mc "Gracias, Miriel."

# game/Story04.rpy:5376

translate spanish story05_5_1_fcd9ed2e:

    # mc "But don’t worry."
    mc "Pero no te preocupes."

# game/Story04.rpy:5382

translate spanish story05_5_1_325c2332:

    # "Threat level: Moderate. Four o`clock."
    "Nivel de amenaza: moderado."

# game/Story04.rpy:5388

translate spanish story05_5_1_2d621a7c:

    # mc "(whispering) Enemy."
    mc "Enemigo."

# game/Story04.rpy:5389

translate spanish story05_5_1_944337fe:

    # k "Oh? More pretty faces. Finally, something fun."
    k "Más caras bonitas, por fin algo divertido."

# game/Story04.rpy:5392

translate spanish story05_5_1_83f3ad21:

    # mc "(whispering) No. We let them pass."
    mc "No, les dejamos pasar."

# game/Story04.rpy:5393

translate spanish story05_5_1_dcaa303d:

    # k "…Yeah, I don’t think so."
    k "...Sí, no lo creo."

# game/Story04.rpy:5396

translate spanish story05_5_1_bc80c6fb:

    # mc "(whispering) If we can avoid casualties, we do."
    mc "Si podemos evitar bajas, lo haremos."

# game/Story04.rpy:5398

translate spanish story05_5_1_b3e60d91:

    # k "Wow. How noble of you."
    k "Qué noble eres."

# game/Story04.rpy:5399

translate spanish story05_5_1_2ccd8a3e:

    # k "Not that I care about their lives. But I’m not just going to ignore what they’ve done."
    k "No es que me importen sus vidas, pero no voy a ignorar lo que han hecho."

# game/Story04.rpy:5401

translate spanish story05_5_1_f5479241:

    # mc "You’ll only make it worse. Every body we drop plays into the enemy’s hands."
    mc "Solo lo empeorarás. Cada cuerpo que dejamos juega en las manos del enemigo."

# game/Story04.rpy:5402

translate spanish story05_5_1_221a081e:

    # k "…"
    k "…"

# game/Story04.rpy:5404

translate spanish story05_5_1_df809fd0:

    # k "You and your logic. Always ruining the fun."
    k "Tú y tu lógica, siempre arruinando la diversión."

# game/Story04.rpy:5409

translate spanish story05_5_1_2a5dc2bb:

    # k "Fine."
    k "Bien."

# game/Story04.rpy:5412

translate spanish story05_5_1_2e87d002:

    # h "Oh wow."
    h "Oh wow."

# game/Story04.rpy:5413

translate spanish story05_5_1_4401822b:

    # h "What happened to “screw the plan, we charge in”?"
    h "¿Qué pasó con “deshacer el plan, cobramos”?"

# game/Story04.rpy:5415

translate spanish story05_5_1_6c10287d:

    # k "Crazy thing called ‘reputation.’ You should try getting one."
    k "Lo loco llamado “reputación”. Deberías intentar conseguir uno."

# game/Story04.rpy:5418

translate spanish story05_5_1_1213f926:

    # k "Oh, and one more thing."
    k "Y una cosa más."

# game/Story04.rpy:5421

translate spanish story05_5_1_e7955371:

    # k "That implant? Not a miracle cure. Don’t rely on it too much."
    k "¿Ese implante? No es una cura milagrosa. No se confíe en él demasiado."

# game/Story04.rpy:5422

translate spanish story05_5_1_8f97d66f:

    # k "We’ve already got one lunatic on the team."
    k "Ya tenemos un lunático en el equipo."

# game/Story04.rpy:5424

translate spanish story05_5_1_830d6e01:

    # mc "(Reputation… huh.)"
    mc "(Reputación... eh.)"

# game/Story04.rpy:5425

translate spanish story05_5_1_7c66f096:

    # mc "Kali? Thanks."
    mc "Gracias."

# game/Story04.rpy:5430

translate spanish story05_5_1_3d97c635:

    # k "Yeah, yeah."
    k "Sí, sí."

# game/Story04.rpy:5432

translate spanish story05_5_1_67a2035a:

    # mc "(Small win.)"
    mc "(Pequeña victoria.)"

# game/Story04.rpy:5433

translate spanish story05_5_1_a6adc98a:

    # mc "Let’s move."
    mc "Vamos."

# game/Story04.rpy:5443

translate spanish story05_5_1_225d4e2c:

    # "Entrance to the compressor zone."
    "Entrada a la zona del compresor."

# game/Story04.rpy:5445

translate spanish story05_5_1_928fc6da:

    # Mi "...why."
    Mi "...por qué."

# game/Story04.rpy:5452

translate spanish story05_5_1_83ea7f4e:

    # Mi "Why didn’t you kill them?"
    Mi "¿Por qué no los mataste?"

# game/Story04.rpy:5453

translate spanish story05_5_1_b98cba5e:

    # mc "(Why did that look give me chills?)"
    mc "(¿Por qué esa mirada me dio escalofríos?)"

# game/Story04.rpy:5456

translate spanish story05_5_1_36a65aec:

    # mc "I don’t kill for pleasure. If a fight can be avoided, I avoid it."
    mc "No mato por placer. Si una pelea puede ser evitada, lo evito."

# game/Story04.rpy:5459

translate spanish story05_5_1_e4094083:

    # Mi "They’ve murdered innocent civilians."
    Mi "Han asesinado a civiles inocentes."

# game/Story04.rpy:5461

translate spanish story05_5_1_d1144f2a:

    # mc "So have we."
    mc "Nosotros también."

# game/Story04.rpy:5464

translate spanish story05_5_1_e1408c4a:

    # Mi "…"
    Mi "…"

# game/Story04.rpy:5465

translate spanish story05_5_1_23f00e73:

    # mc "None of us are clean."
    mc "Ninguno de nosotros está limpio."

# game/Story04.rpy:5466

translate spanish story05_5_1_f8f0f586:

    # mc "(whispering) …but if I can shave off even the smallest fraction of the world’s cruelty-"
    mc "(susurando) ... pero si puedo afeitar incluso la fracción más pequeña de la crueldad del mundo-"

# game/Story04.rpy:5469

translate spanish story05_5_1_cc596d60:

    # mc "—I sleep better at night."
    mc "- Duermo mejor de noche."

# game/Story04.rpy:5470

translate spanish story05_5_1_691a4020:

    # mc "(Hypocritical? Absolutely.)"
    mc "¿Hypocritical?"

# game/Story04.rpy:5472

translate spanish story05_5_1_23235671:

    # mc "Now move."
    mc "Ahora muévete."

# game/Story04.rpy:5477

translate spanish story05_5_1_0de1b446:

    # k "Hey, shorty."
    k "Oye, cariño."

# game/Story04.rpy:5481

translate spanish story05_5_1_40463722:

    # h "What do you want?"
    h "¿Qué quieres?"

# game/Story04.rpy:5484

