translate spanish story05_642df0c2:

    # Mi "I’ll take you back home."
    Mi "Te llevaré de vuelta a casa."

# game/Story04.rpy:393

translate spanish story05_277629bc:

    # mc "(Home… but what about Lora… No. Don’t go there.)"
    mc "(Home... pero ¿qué hay de Lora... No. No vayas allí.)"

# game/Story04.rpy:394

translate spanish story05_656c9ebe:

    # mc "(Lora seems like she belongs here now anyway.)"
    mc "(Lora parece que ahora pertenece aquí.)"

# game/Story04.rpy:395

translate spanish story05_3244e6ee:

    # mc "(And yet… I can’t just leave her like this… Or can I?)"
    mc "(Y aún así... no puedo dejarla así... ¿O puedo?)"

# game/Story04.rpy:397

translate spanish story05_afd74152:

    # mc "What do you think?"
    mc "¿Qué opinas?"

# game/Story04.rpy:398

translate spanish story05_7ea22281:

    # h "I’m in. This place is… fine, I guess, but I don’t wanna have anything to do with it anymore. No offense, Mir."
    h "Estoy en este lugar está... bien, supongo, pero no quiero tener nada que ver con eso."

# game/Story04.rpy:400

translate spanish story05_f0ddcf5c:

    # Mi "I understand."
    Mi "Entiendo."

# game/Story04.rpy:401

translate spanish story05_49a3aa6b:

    # Mi "(whispering) If it were my choice… I would’ve left this place long ago."
    Mi "Si fuera mi elección... habría dejado este lugar hace mucho tiempo."

# game/Story04.rpy:403

translate spanish story05_2b35b6fe:

    # mc "..."
    mc "..."

# game/Story04.rpy:405

translate spanish story05_ccce457f:

    # mc "Then come with us."
    mc "Entonces ven con nosotros."

# game/Story04.rpy:406

translate spanish story05_99475aef:

    # Mi "I…"
    Mi "Yo..."

# game/Story04.rpy:408

translate spanish story05_61ec77c1:

    # mc "I’m not forcing you. But I’m serious, think about it."
    mc "No te estoy forzando, pero en serio, piensa en ello."

# game/Story04.rpy:410

translate spanish story05_bbd9e8af:

    # h "Totally agree."
    h "Totalmente de acuerdo."

# game/Story04.rpy:412

translate spanish story05_db1500bd:

    # Mi "I’ll think about it."
    Mi "Lo pensaré."

# game/Story04.rpy:416

translate spanish story05_da3fdbf1_1:

    # Mi "..."
    Mi "..."

# game/Story04.rpy:417

translate spanish story05_e1f098e0:

    # mc "(They’re nervous. Both of them.)"
    mc "(Están nerviosos."

# game/Story04.rpy:418

translate spanish story05_1497d60c:

    # mc "(And I’m no exception… We need a break.)"
    mc "(Y no soy una excepción... necesitamos un descanso.)"

# game/Story04.rpy:421

translate spanish story05_c2565da4_1:

    # mc "Olivia?"
    mc "¿Olivia?"

# game/Story04.rpy:422

translate spanish story05_a82ed3b0:

    # h "Yeah?"
    h "¿Sí?"

# game/Story04.rpy:423

translate spanish story05_57e5ccbf:

    # mc "Remember when you used to run around the city, dragging people into that bar? Acting like it was the end of the world."
    mc "¿Recuerdas cuando solías correr por la ciudad, arrastrando a la gente a ese bar? Actuando como si fuera el fin del mundo."

# game/Story04.rpy:425

translate spanish story05_4c2d36cf:

    # h "That bar had a name! But yeah, I remember. And honestly…"
    h "Ese bar tenía un nombre, pero sí, lo recuerdo y honestamente..."

# game/Story04.rpy:426

translate spanish story05_b1debd95:

    # h "I'd still think that way! That time was pure hell!"
    h "¡Haría eso ahora, eso era un infierno en ese momento!"

# game/Story04.rpy:429

translate spanish story05_cbc9ba48:

    # mc "Yeah? I thought you hated this little “adventure” of ours more than anything else."
    mc "Pensé que odiabas esta pequeña \"aventura\" nuestra más que nada más."

# game/Story04.rpy:433

translate spanish story05_c641ef77:

    # h "Let’s just say this little trip has its perks."
    h "Digamos que este pequeño viaje tiene sus ventajas."

# game/Story04.rpy:435

translate spanish story05_3a005232:

    # h "(Running around the city sure as hell didn’t.)"
    h "(Running alrededor de la ciudad seguro que no lo hizo el infierno.)"

# game/Story04.rpy:436

translate spanish story05_67bbde61:

    # h "Help!"
    h "¡Ayuda!"

# game/Story04.rpy:438

translate spanish story05_335a0d7b:

    # h "I just wanna relax, [mc]… run a hot bath… and stay in it for an hour. Or two."
    h "Solo quiero relajarme, [mc]...para tomar un baño caliente... y quedarse en él por una hora."

# game/Story04.rpy:439

translate spanish story05_31a51070:

    # h "Maybe even with someone who owes me…"
    h "Tal vez incluso con alguien que me debe..."

# game/Story04.rpy:441

translate spanish story05_a0a35daa:

    # mc "Hm… I thought I cleared all my debts."
    mc "Pensé que había liquidado todas mis deudas."

# game/Story04.rpy:443

translate spanish story05_d5246c18:

    # h "And what makes you think it’s gonna be YOU? You’ve got Lora, remember?"
    h "¿Y qué te hace pensar que será USTED? Tienes a Lora, ¿recuerdas?"

# game/Story04.rpy:444

translate spanish story05_2b35b6fe_1:

    # mc "..."
    mc "..."

# game/Story04.rpy:447

translate spanish story05_2545a0d0:

    # h "Mm-hm. Honestly, I don’t mind either way. But do me a favor and sort things out between you two."
    h "Sinceramente, no me importa de ninguna manera, pero hazme un favor y arregla las cosas entre vosotros dos."

# game/Story04.rpy:448

translate spanish story05_0b49bdd9:

    # h "We’re adults, right? So why act like a couple of kids?"
    h "Somos adultos, ¿verdad? ¿Por qué actuar como un par de niños?"

# game/Story04.rpy:450

translate spanish story05_16685a49:

    # Mi "I agree."
    Mi "Estoy de acuerdo."

# game/Story04.rpy:452

translate spanish story05_53a8fef4:

    # h "Right?! For a second I thought it was just me."
    h "Por un segundo pensé que era solo yo."

# game/Story04.rpy:454

translate spanish story05_cc5eda65:

    # Mi "One of you is trying to protect what once was. The other is desperate to bring it back."
    Mi "Uno de ustedes está tratando de proteger lo que una vez fue, el otro está desesperado por traerlo de vuelta."

# game/Story04.rpy:455

translate spanish story05_fbf6a775:

    # Mi "But neither of you wants to look the truth in the eye."
    Mi "Pero ninguno de ustedes quiere mirar la verdad a los ojos."

# game/Story04.rpy:456

translate spanish story05_055610b0:

    # Mi "You’re living in the present, not the past."
    Mi "Estás viviendo en el presente, no en el pasado."

# game/Story04.rpy:457

translate spanish story05_2e060fdd:

    # Mi "So maybe you should think about your future… instead of clinging to nostalgia."
    Mi "Así que tal vez deberías pensar en tu futuro... en vez de aferrarte a la nostalgia."

# game/Story04.rpy:459

translate spanish story05_713dcdf2:

    # h "That’s how it is."
    h "Así es."

# game/Story04.rpy:461

translate spanish story05_32278279:

    # mc "Present… {w}Miriel? Tell me, why are you helping us?"
    mc "Presente... {w}¿Por qué nos ayudas?"

