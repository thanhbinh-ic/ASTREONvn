translate spanish story05_4a89ad3c:

    # Mi "After that, you passed out. Do you remember?"
    Mi "Después de eso, te desmayaste. ¿Te acuerdas?"

# game/Story04.rpy:330

translate spanish story05_ff3b3682:

    # mc "(Too sudden. Why is she bringing up the Ark now?)"
    mc "(De repente. ¿Por qué está trayendo el Arca ahora?)"

# game/Story04.rpy:332

translate spanish story05_3c7bee43:

    # mc "(Sphere?)"
    mc "(Esférica?)"

# game/Story04.rpy:333

translate spanish story05_3f72f13f:

    # mc "Yeah. I remember. Not everything, but enough."
    mc "Sí, lo recuerdo, no todo, pero suficiente."

# game/Story04.rpy:334

translate spanish story05_e69e1e7c:

    # Mi "When you left the team to look for the keycard, you wandered into the technical sector."
    Mi "Cuando dejaste el equipo para buscar la tarjeta de clave, te metiste en el sector técnico."

# game/Story04.rpy:336

translate spanish story05_d2c45d6f:

    # mc "How do you… Yeah. I remember something like that."
    mc "¿Cómo... sí, recuerdo algo así?"

# game/Story04.rpy:337

translate spanish story05_2aa723f4:

    # mc "(The feelings I had back then… those memories…)"
    mc "(Los sentimientos que tuve entonces... esos recuerdos...)"

# game/Story04.rpy:339

translate spanish story05_f9f9f109:

    # mc "(Memories?)"
    mc "(¿Memorias?)"

# game/Story04.rpy:340

translate spanish story05_757a8ac4:

    # mc "(Wait… Could it be… the implants are back to normal?)"
    mc "(Espera... ¿Podría ser... que los implantes vuelvan a la normalidad?)"

# game/Story04.rpy:342

translate spanish story05_09f7e512:

    # h "Hold on, hold on, what are you two talking about? I was there too-"
    h "Espera, espera, ¿de qué están hablando?"

# game/Story04.rpy:344

translate spanish story05_b73e2d86:

    # Mi "No. Not that place. Another one. Where the experiments were actually conducted."
    Mi "No, no ese lugar, otro donde los experimentos se realizaron."

# game/Story04.rpy:346

translate spanish story05_11c1ae42:

    # mc "Experiments again? Because of this “immortality” crap?"
    mc "¿Experimentos de nuevo? ¿Por esta mierda de “inmortalidad”?"

# game/Story04.rpy:348

translate spanish story05_bddc88bb:

    # Mi "Yes."
    Mi "Sí."

# game/Story04.rpy:349

translate spanish story05_ac76c981:

    # Mi "What they were experimenting on there… is the reason you suddenly became so important to everyone."
    Mi "Lo que estaban experimentando allí... es la razón por la que de repente te hiciste tan importante para todos."

# game/Story04.rpy:351

translate spanish story05_06c2722a:

    # mc "(That masked guy… he said something like this. Said I was a “key”? No way this is just about that sphere…)"
    mc "(Ese tipo enmascarado... dijo algo así. ¿Dijo que yo era una \"llave\"? No puede ser que todo esto sea solo por esa esfera...)"

# game/Story04.rpy:352

translate spanish story05_4267080e:

    # mc "(The Abyss… Astoria’s younger “sister”… some other force with its own agenda…)"
    mc "(El Abismo... el más joven de Astoria... alguna otra fuerza con su propia agenda...)"

# game/Story04.rpy:353

translate spanish story05_9781bb7c:

    # mc "(And somehow I’m stuck in the middle of this mess.)"
    mc "(Y de alguna manera estoy atrapado en el medio de este desastre.)"

