    # h "Nope. Not happening. I’m not crawling in there. No way in hell."
    h "No. No estoy pasando. No estoy arrastrando por ahí."

# game/Story04.rpy:4706

translate spanish story05_9_8510cdca:

    # a "Move it, you worthless trash."
    a "Muévete, basura sin valor."

# game/Story04.rpy:4708

translate spanish story05_9_ce129342:

    # R "H-how dare you talk to me li—"
    R "¿Cómo te atreves a hablar conmigo?"

# game/Story04.rpy:4709

translate spanish story05_9_f03a6b69:

    # a "You humans deserve nothing better."
    a "Los humanos no merecen nada mejor."

# game/Story04.rpy:4711

translate spanish story05_9_29347032:

    # R "(So this is how you repay my work? Hypocrites!)"
    R "¡Hipocritas!"

# game/Story04.rpy:4713

translate spanish story05_9_32199085:

    # am "You really couldn’t find someone… even remotely competent?"
    am "¿Realmente no pudiste encontrar a alguien... incluso remotamente competente?"

# game/Story04.rpy:4715

translate spanish story05_9_5ea99ac7:

    # sel "You do realize the Keepers have started hunting anyone tied to the tombs."
    sel "Te das cuenta de que los Guardianes han empezado a cazar a cualquiera atado a las tumbas."

# game/Story04.rpy:4716

translate spanish story05_9_d75bd3e3:

    # sel "Finding someone who won’t embarrass themselves is already an accomplishment."
    sel "Encontrar a alguien que no se avergüence es ya un logro."

# game/Story04.rpy:4718

translate spanish story05_9_fd3c1758:

    # am "Could have brought your own scientists, you know."
    am "Podría haber traído a tus propios científicos, ¿sabes?"

# game/Story04.rpy:4720

translate spanish story05_9_1ad5ec06:

    # sel "Unlike you, we consider our scientists a strategic resource."
    sel "A diferencia de usted, consideramos a nuestros científicos un recurso estratégico."

# game/Story04.rpy:4721

translate spanish story05_9_58156ee7:

    # sel "And even if I agreed to this little ‘Abyss’ venture, I’m not throwing my own people into it."
    sel "Y aunque accedí a esta pequeña empresa de ‘Abyss’, no voy a lanzar a mi propia gente en ella."

# game/Story04.rpy:4724

translate spanish story05_9_13de5f3f:

    # a "My Queen, we’ve got a problem."
    a "Mi Reina, tenemos un problema."

# game/Story04.rpy:4725

translate spanish story05_9_0a9e6245:

    # sel "What is it?"
    sel "¿Qué es?"

# game/Story04.rpy:4728

translate spanish story05_9_33dda69c:

    # R "Then kill me already!"
    R "¡Entonces mátame ya!"

# game/Story04.rpy:4729

translate spanish story05_9_1825690b:

    # aa "Stand down."
    aa "¡Abajo!"

# game/Story04.rpy:4730

translate spanish story05_9_c1a9c666:

    # aa "What about the portal?"
    aa "¿Qué hay del portal?"

# game/Story04.rpy:4732

translate spanish story05_9_9478adc3:

    # R "There’s a problem, I can’t activate it."
    R "Hay un problema, no puedo activarlo."

# game/Story04.rpy:4733

translate spanish story05_9_842d3b3b:

    # sel "The reason? Not enough sacrifices?"
    sel "¿No hay suficientes sacrificios?"

# game/Story04.rpy:4734

translate spanish story05_9_7434b249:

    # R "No, something’s jamming them… from the other side."
    R "No, algo los está atascando... del otro lado."

# game/Story04.rpy:4736

translate spanish story05_9_14de9c4b:

    # sel "You didn’t invent that excuse… simply because you don’t know how to activate them, did you?"
    sel "No inventaste esa excusa... simplemente porque no sabes cómo activarlas, ¿verdad?"

# game/Story04.rpy:4738

translate spanish story05_9_a36b9fc6:

    # R "How dare you question my intellect!"
    R "¡Cómo te atreves a cuestionar mi intelecto!"

# game/Story04.rpy:4739

translate spanish story05_9_2d83607a:

    # aa "Watch your tongue, boy."
    aa "Cuidado con la lengua, muchacho."

# game/Story04.rpy:4741

translate spanish story05_9_4a6cd9cb:

    # sel "You have exactly one hour to fix this."
    sel "Tienes exactamente una hora para arreglar esto."

# game/Story04.rpy:4742

translate spanish story05_9_aad3197d:

    # sel "If he fails, kill him."
    sel "Si falla, mátalo."

# game/Story04.rpy:4744

translate spanish story05_9_05418593:

    # R "How da—"
    R "¿Cómo...?"

# game/Story04.rpy:4745

translate spanish story05_9_562c2793:

    # a "Yes, Your Majesty."
    a "Sí, Su Majestad."

# game/Story04.rpy:4748

translate spanish story05_9_84c330cd:

    # sel "Tell me, Astoria… what’s worth more: a star you can lose for the sake of the world,"
    sel "Dime, Astoria... lo que vale más: una estrella que puedes perder por el bien del mundo,"

# game/Story04.rpy:4749

translate spanish story05_9_f0786ce7:

    # sel "or a world where one star shines brighter than all the rest?"
    sel "¿O un mundo donde una estrella brilla más que todo el resto?"

# game/Story04.rpy:4751

translate spanish story05_9_281e6bb9:

    # am "The star. Even a single one can set the darkness on fire."
    am "Incluso una sola puede encender la oscuridad."

# game/Story04.rpy:4752

translate spanish story05_9_a0dda036:

    # am "A world without light is nothing but emptiness."
    am "Un mundo sin luz no es más que vacío."

# game/Story04.rpy:4753

translate spanish story05_9_45b2fa62:

    # am "Truth is born from sacrifice. Value comes from the one you’d give everything up for."
    am "La verdad nace del sacrificio. El valor viene de la que usted daría todo por encima."

# game/Story04.rpy:4755

translate spanish story05_9_532236ca:

    # sel "Or perhaps… the world matters more."
    sel "O quizás... el mundo importa más."

# game/Story04.rpy:4756

translate spanish story05_9_a5e62fdd:

    # sel "If the star goes out, life changes, but the universe continues."
    sel "Si la estrella sale, la vida cambia, pero el universo continúa."

# game/Story04.rpy:4757

translate spanish story05_9_a0085e19:

    # sel "Value is measured by what preserves the system, not by a single life."
    sel "El valor se mide por lo que preserva el sistema, no por una sola vida."

# game/Story04.rpy:4759

translate spanish story05_9_6cf15b8e:

    # am "And what if the world itself is ready to abandon its star?"
    am "¿Y si el mundo mismo está listo para abandonar su estrella?"

# game/Story04.rpy:4760

translate spanish story05_9_7b1af516:

    # am "Worth isn’t measured by what survives, it’s measured by who is willing to give themselves so something else can."
    am "La riqueza no se mide por lo que sobrevive, se mide por quién está dispuesto a darse a sí mismos para que algo más pueda."

# game/Story04.rpy:4762

translate spanish story05_9_87afc3ba:

    # sel "Then who is more important, the one others die for, or the one who can choose to sacrifice?"
    sel "Entonces, ¿quién es más importante, el otro muere por, o el que puede elegir sacrificarse?"

# game/Story04.rpy:4763

translate spanish story05_9_7731dd70:

    # sel "Truth lives in the choice: what you decide to protect… and what you’re willing to let go."
    sel "La verdad vive en la elección: lo que usted decide proteger... y lo que usted está dispuesto a dejar ir."

# game/Story04.rpy:4765

translate spanish story05_9_e50cd946:

    # am "The one people are willing to give everything for, that’s what matters."
    am "El único pueblo está dispuesto a dar todo por, eso es lo que importa."

# game/Story04.rpy:4766

translate spanish story05_9_c8f42703:

    # am "Without them, sacrifice is nothing but strategy."
    am "Sin ellos, el sacrificio no es más que estrategia."

# game/Story04.rpy:4767

translate spanish story05_9_c20a51da:

    # am "Greatness is the person you’re willing to break your rules for… even if it destroys you."
    am "La grandeza es la persona que estás dispuesto a romper tus reglas... incluso si te destruye."

# game/Story04.rpy:4769

translate spanish story05_9_1f75bb8c:

    # sel "And sometimes, the one who seems precious only tests who is truly willing to sacrifice."
    sel "Y a veces, el que parece precioso solo prueba quién está verdaderamente dispuesto a sacrificar."

# game/Story04.rpy:4770

translate spanish story05_9_6c9add1d:

    # sel "Worth exists in the eyes of the one who judges."
    sel "La pena existe en los ojos de aquel que juzga."

# game/Story04.rpy:4771

translate spanish story05_9_47cd6163:

    # sel "The truth of sacrifice is seeing the pain, and walking forward anyway."
    sel "La verdad del sacrificio es ver el dolor, y caminar hacia adelante de todos modos."

# game/Story04.rpy:4775

translate spanish story05_9_b97d5dfe:

    # am "The truth is simple: the one who makes the decision is stronger than the one who merely seems important."
    am "La verdad es simple: el que toma la decisión es más fuerte que el que simplemente parece importante."

# game/Story04.rpy:4776

translate spanish story05_9_281fdb12:

    # am "And sometimes sacrifice isn’t loss at all, it’s a test of whether you can live with what follows."
    am "Y a veces el sacrificio no es pérdida en absoluto, es una prueba de si usted puede vivir con lo que sigue."

# game/Story04.rpy:4778

translate spanish story05_9_2e2902de:

    # am "(But the real power lies in the one who can do the impossible… for the person they cannot afford to lose.)"
    am "(Pero el verdadero poder reside en aquel que puede hacer lo imposible... para la persona que no pueden permitirse perder.)"

# game/Story04.rpy:4782

translate spanish story05_9_a31353a7:

    # am "(Sometimes the ‘rational’ choice is just a mask… hiding what has already begun inside.)"
    am "(A veces la opción ‘racional’ es solo una máscara... ocultando lo que ya ha comenzado dentro.)"

# game/Story04.rpy:4786

translate spanish story05_9_2707a773:

    # am "(I’ve already stepped onto this path.)"
    am "(Ya he caminado por este camino.)"

# game/Story04.rpy:4790

translate spanish story05_9_b43326bb:

    # am "(No one will notice… not until it ends.)"
    am "(Nadie se dará cuenta... no hasta que termine)."

# game/Story04.rpy:4794

translate spanish story05_9_6a8c1ca9:

    # am "(If my principles brought me to this ending…)"
    am "(Si mis principios me trajeron a este final...)"

# game/Story04.rpy:4800

translate spanish story05_9_7e719909:

    # am "(What were they ever worth?)"
    am "(¿Qué valían?)"

# game/Story04.rpy:4805

translate spanish story05_9_05779cd7:

    # am "(If a flower is meant to begin a new life…)"
    am "(Si una flor está destinada a comenzar una nueva vida...)"

# game/Story04.rpy:4811

translate spanish story05_9_770176d2:

    # am "(Then I will become the soil for it.)"
    am "(Entonces me convertiré en el suelo para él.)"

# game/Story04.rpy:4830

translate spanish story05_9_96972950:

    # C "(A customer? At this hour?)"
    C "¿A esta hora?"

# game/Story04.rpy:4832

translate spanish story05_9_4987d20d:

    # CC "*whistles* Now that’s a big fish."
    CC "*whistles* Ahora es un pez grande."

# game/Story04.rpy:4833

translate spanish story05_9_9ec2ae39:

    # CC "(whispering) What’s a lady like that doing in a bar this dead?"
    CC "¿Qué hace una dama así en un bar muerto?"

# game/Story04.rpy:4835

translate spanish story05_9_1deed48e:

    # CC "What can I do for you?"
    CC "¿Qué puedo hacer por ti?"

# game/Story04.rpy:4837

translate spanish story05_9_4e260567:

    # Evrel "..."
    Evrel "..."

# game/Story04.rpy:4838

translate spanish story05_9_88f47ad4:

    # Evrel "I’m looking for a girl..."
    Evrel "Estoy buscando a una chica..."

# game/Story04.rpy:4839

translate spanish story05_9_915e367e:

    # Evrel "Named Lora."
    Evrel "Se llama Lora."

# game/Story04.rpy:4844

translate spanish story05_9_640a4126:

    # n "And... that’s it. End of Part One, version 0.4."
    n "Y... eso es todo. Fin de la Primera Parte, versión 0.4."

# game/Story04.rpy:4845

translate spanish story05_9_673c8235:

    # n "If you haven’t yet, you can try the other route, or check out my other game, Clown Squad."
    n "Si aún no lo has hecho, puedes probar la otra ruta, o ver mi otro juego, Escuadrón de Payasos."

# game/Story04.rpy:4846

translate spanish story05_9_9f825090:

    # n "See you soon."
    n "Hasta pronto."

