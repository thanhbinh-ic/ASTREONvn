    # h "For once, I agree with the gorilla. And I have zero desire to check what’s down there."
    h "Por una vez, estoy de acuerdo con el gorila. Y no tengo ningún deseo de comprobar lo que hay allí abajo."

# game/Story04.rpy:4673

translate spanish story05_8_cd099211:

    # mc "Olivia? Remember the promise?"
    mc "¿Olivia?"

# game/Story04.rpy:4675

translate spanish story05_8_992969d0:

    # h "{b}Giggle"
    h "{b}Giggle"

# game/Story04.rpy:4677

