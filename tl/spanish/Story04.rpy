translate spanish story05_11621c32:

    # h "Hey! Don’t change the subject!"
    h "¡No cambies el tema!"

# game/Story04.rpy:464

translate spanish story05_76dd631a:

    # mc "(You care about the elves… yet you follow us instead of protecting them.)"
    mc "(Te importan los elfos... pero nos sigues en vez de protegerlos)."

