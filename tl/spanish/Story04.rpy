translate spanish story05_16b6005f:

    # mc "(That masked guy… he said something like this. Said I was connected to this? No way this is just about that sphere…)"
    mc "(Ese tipo enmascarado... dijo algo parecido. ¿Dijo que yo estaba conectado con esto? No puede ser solo por aquella esfera...)"

# game/Story04.rpy:359
translate spanish story05_51b80692:

    # Mi "That sphere was connected to the Gate."
    Mi "Esa esfera estaba conectada al portal."

# game/Story04.rpy:360
translate spanish story05_73430d91:

    # Mi "And after you touched it, the Gate started reacting to you."
    Mi "Y después de que la tocaste, el portal empezó a reaccionar a ti."

# game/Story04.rpy:363
translate spanish story05_cb611e72:

    # mc "(Think, [mc]. Think. I'm connected, but to what?)"
    mc "(Piensa, [mc]. Piensa. Estoy conectado, pero ¿a qué?)"

# game/Story04.rpy:364
translate spanish story05_2e189f9a:

    # mc "(Ember… back then, in her room… she said they made it back to Earth through a gate. Is it inside the tower?)"
    mc "(Ember... entonces, en su habitación... dijo que lograron volver a la Tierra a través de un portal. ¿Está dentro de la Torre?)"

# game/Story04.rpy:368
translate spanish story05_9ea75e1b:

    # mc "(I’m connected to the Gate?)"
    mc "(¿Estoy conectado al portal?)"

# game/Story04.rpy:370
translate spanish story05_5b59d25b:

    # mc "(The words of the white mask… the Abyss… a gate to the Abyss?)"
    mc "(Las palabras de la máscara blanca... el Abismo... ¿un portal al Abismo?)"

# game/Story04.rpy:389
translate spanish story05_64ebe67d:

    # Mi "We’ll prevent the gate from opening. We’ll save the planet."
    Mi "Impediremos que el portal se abra. Salvaremos el planeta."

# game/Story04.rpy:2619
translate spanish story05_4_b266dd22:

    # R "And as unpleasant as it may sound, this expedition needs you."
    R "Y por desagradable que suene, esta expedición te necesita."

# game/Story04.rpy:2655
translate spanish story05_4_abc0bea1:

    # L "(One important clarification: a breach and a gate are not the same thing.)"
    L "(Una aclaración importante: una brecha y un portal no son lo mismo.)"

# game/Story04.rpy:2656
translate spanish story05_4_6fb78722:

    # L "(A breach is a natural phenomenon. A gate is a machine built to control one.)"
    L "(Una brecha es un fenómeno natural. Un portal es una máquina construida para controlar una.)"

# game/Story04.rpy:2663
translate spanish story05_4_f839bfee:

    # R "How it ended up here, we don’t know."
    R "No sabemos cómo terminó aquí."

# game/Story04.rpy:2664
translate spanish story05_4_c364ad41:

    # R "But that’s where the gate research started. Or so I was told."
    R "Pero ahí fue donde empezó la investigación sobre los portales. O eso me dijeron."

# game/Story04.rpy:2749
translate spanish story05_4_7345317e:

    # h "So what’s this mysterious energy source everyone’s freaking out about?"
    h "Entonces, ¿cuál es esa misteriosa fuente de energía por la que todos están tan alterados?"

# game/Story04.rpy:3107
translate spanish story05_4_0564626e:

    # Mi "With that knowledge, she can tune the gate to the Aby-"
    Mi "Con ese conocimiento, puede ajustar el portal al Abi-"

# game/Story04.rpy:3355
translate spanish story05_5_4843cf9c:

    # mc "A gate to Earth."
    mc "Un portal a la Tierra."

# game/Story04.rpy:3401
translate spanish story05_5_593493a0:

    # mc "Lora. The gate, what do we know?"
    mc "Lora. El portal, ¿qué sabemos?"

# game/Story04.rpy:3406
translate spanish story05_5_5f52a5a1:

    # L "The gate needs cooling, we’ll swim along the coolant line."
    L "El portal necesita refrigeración; nadaremos por la línea de refrigerante."

# game/Story04.rpy:3425
translate spanish story05_5_65090c4e:

    # h "But what if the Gate is already active?"
    h "¿Pero y si el portal ya está activo?"

# game/Story04.rpy:3773
translate spanish story05_6_acf8930e:

    # a "To warn you. You won’t be able to stop the gate. It’s already too late."
    a "Para advertirte. No podrás detener el portal. Ya es demasiado tarde."

# game/Story04.rpy:4722
translate spanish story05_7_ba6d04ac:

    # L "The fewer people knew, the more likely we were to fool the pattern."
    L "Cuanta menos gente lo supiera, más posibilidades teníamos de engañar al patrón."

# game/Story04.rpy:4723
translate spanish story05_7_459a48f1:

    # mc "The pattern?"
    mc "¿El patrón?"

# game/Story04.rpy:4725
translate spanish story05_7_dd2b1277:

    # L "Every choice leads to another outcome."
    L "Cada elección conduce a otro resultado."

# game/Story04.rpy:4726
translate spanish story05_7_2e5a91be:

    # L "Astoria and I were trying to find the one where everyone survives."
    L "Astoria y yo intentábamos encontrar aquel en el que todos sobreviven."

# game/Story04.rpy:4751
translate spanish story05_7_965f2353:

    # L "In the tower, Astoria’s opening the gate."
    L "En la Torre, Astoria está abriendo el portal."

# game/Story04.rpy:5015
translate spanish story05_9_6a7c5523:

    # aa "What about the gate?"
    aa "¿Y el portal?"

# game/Story04.rpy:5274
translate spanish story05_5_1_052ba4ff:

    # L "It’s what leaks from unstable Gates."
    L "Es lo que se filtra de los portales inestables."

# game/Story04.rpy:5275
translate spanish story05_5_1_a687bc06:

    # L "It poisons places first. Then bodies."
    L "Primero envenena los lugares. Luego los cuerpos."

# game/Story04.rpy:5305
translate spanish story05_5_1_52fb14ca:

    # L "That’s what they call the charge inside the device."
    L "Así llaman a la carga que hay dentro del dispositivo."

# game/Story04.rpy:6370
translate spanish story05_5_2_a8a99f13:

    # mc "-ah..."
    mc "-ah..."

# game/Story04.rpy:6760
translate spanish story05_5_2_4ea09cbb:

    # k "AAAAAAAAAAAAAAA..."
    k "AAAAAAAAAAAAAAA..."

# game/Story04.rpy:6989
translate spanish story05_5_3_6080a8a9:

    # mc "(Which means the Gate experiment failed?)"
    mc "(¿Eso significa que el experimento del portal fracasó?)"

# game/Story04.rpy:8753
translate spanish story05_5_5_8e0ce643:

    # keep3 "He carries something from outside the cycle."
    keep3 "Lleva algo que viene de fuera del ciclo."

# game/Story04.rpy:8877
translate spanish story05_5_5_3ae83abd:

    # y "He was the one who launched the Gate System."
    y "Él fue quien puso en marcha el Sistema de Portales."

# game/Story04.rpy:8893
translate spanish story05_5_5_7cef1169:

    # y "What did the System actually do?"
    y "¿Qué hizo realmente el Sistema?"

# game/Story04.rpy:8951
translate spanish story05_5_5_19a5e91a:

    # y "What’s needed is power from outside the cycle."
    y "Lo que hace falta es energía de fuera del ciclo."

# game/Story04.rpy:8953
translate spanish story05_5_5_1f864a9b:

    # mc "So that’s why I matter."
    mc "Así que por eso importo."

# game/Story04.rpy:8954
translate spanish story05_5_5_d15d8c37:

    # mc "I can break the cycle."
    mc "Puedo romper el ciclo."

# game/Story04.rpy:9127
translate spanish story05_5_6_e5d8fbe9:

    # mc "Kali? About those other worlds… do you know anything?"
    mc "¿Kali? Sobre esos otros mundos... ¿sabes algo?"

# game/Story04.rpy:9147
translate spanish story05_5_6_452e8d53:

    # k "People say reality doesn't move in one straight line."
    k "La gente dice que la realidad no avanza en una sola línea recta."

# game/Story04.rpy:9150
translate spanish story05_5_6_75e76b82:

    # k "Every major choice leaves another world behind."
    k "Cada gran elección deja atrás otro mundo."

# game/Story04.rpy:9170
translate spanish story05_5_6_b67c66c3:

    # keep3 "To them, their world is the only one that exists."
    keep3 "Para ellos, su mundo es el único que existe."

# game/Story04.rpy:9212
translate spanish story05_5_6_bfd4a055:

    # keep3 "The first major break in the cycle happened when you decided to go after Lora."
    keep3 "La primera gran ruptura del ciclo ocurrió cuando decidiste ir tras Lora."

# game/Story04.rpy:9217
translate spanish story05_5_6_b9317d23:

    # keep3 "Together, they forced the cycle to branch."
    keep3 "Juntos, obligaron al ciclo a ramificarse."

# game/Story04.rpy:9223
translate spanish story05_5_6_070123e8:

    # keep3 "Every change affects the outcome."
    keep3 "Cada cambio afecta el resultado."

