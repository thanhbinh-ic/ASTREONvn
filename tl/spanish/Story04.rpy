translate spanish story05_5_1_9fcaabaf:

    # k "How long are you gonna keep excusing her crap?!"
    k "¿Cuánto tiempo vas a seguir excusando su mierda?!"

# game/Story04.rpy:5683

translate spanish story05_5_1_c4bfcbc9:

    # mc "Any outcome where we’re still alive… is a good one."
    mc "Cualquier resultado donde aún estamos vivos... es bueno."

# game/Story04.rpy:5688

translate spanish story05_5_1_a43fd612:

    # mc "(If she couldn’t do it… what makes me think I can?)"
    mc "(Si no podía hacerlo... ¿qué me hace pensar que puedo?)"

# game/Story04.rpy:5689

translate spanish story05_5_1_d3e1467d:

    # mc "Yeah. It’s stupid."
    mc "Sí, es estúpido."

# game/Story04.rpy:5691

translate spanish story05_5_1_703bfd85:

    # mc "But I get why she tried."
    mc "Pero entiendo por qué lo intentó."

# game/Story04.rpy:5692

translate spanish story05_5_1_4cb25773:

    # mc "(We don’t owe these people anything. And still… here we are.)"
    mc "(No debemos nada a esta gente, y aún así aquí estamos.)"

# game/Story04.rpy:5695

translate spanish story05_5_1_9507136c:

    # k "I’m not siding with that pointy-eared freak."
    k "No estoy acostado con ese monstruo puntiagudo."

# game/Story04.rpy:5697

translate spanish story05_5_1_0de9c241:

    # mc "You won’t have to."
    mc "No tendrás que hacerlo."

# game/Story04.rpy:5701

translate spanish story05_5_1_c014f7c0:

    # h "That grin... You’ve got something, don’t you?"
    h "Esa sonrisa... tienes algo, ¿no?"

