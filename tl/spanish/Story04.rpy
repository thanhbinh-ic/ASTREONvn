translate spanish story05_5_3_30b7e44b:

    # keep3 "(whispering) Let that be your lesson."
    keep3 "Deja que sea tu lección."

# game/Story04.rpy:7432

translate spanish story05_5_4_08b8db12:

    # mc "(That feeling again.)"
    mc "(Ese sentimiento de nuevo.)"

# game/Story04.rpy:7433

translate spanish story05_5_4_21511ef2:

    # mc "(Tight chest. Measured air.)"
    mc "(Peso torácico. Aire medido.)"

# game/Story04.rpy:7434

translate spanish story05_5_4_0448a427:

    # mc "(Like I’m back in Astoria’s office, being dissected without a blade.)"
    mc "(Como si estuviera de vuelta en la oficina de Astoria, siendo disecado sin una hoja.)"

# game/Story04.rpy:7437

translate spanish story05_5_4_d5ed36e7:

    # Go "So."
    Go "Así que."

# game/Story04.rpy:7438

translate spanish story05_5_4_b4188e6b:

    # Go "Why did Astoria send her hounds to me?"
    Go "¿Por qué Astoria me envió sus sabuesos?"

# game/Story04.rpy:7440

translate spanish story05_5_4_8756dfa3:

    # mc "How long have you known?"
    mc "¿Cuánto tiempo has sabido?"

# game/Story04.rpy:7446

translate spanish story05_5_4_71c6da09:

    # Go "Allow me to introduce myself properly."
    Go "Permítanme presentarme correctamente."

# game/Story04.rpy:7447

translate spanish story05_5_4_5b4d5097:

    # Go "Goremilion Aeliren Taer-Sylv."
    Go "Goremilion Aeliren Taer-Sylv."

# game/Story04.rpy:7453

translate spanish story05_5_4_b1008d83:

    # mc "The Elven Emperor himself. I assume."
    mc "El Emperador Elven, supongo."

# game/Story04.rpy:7457

translate spanish story05_5_4_23ac7b1d:

    # Go "..."
    Go "..."

# game/Story04.rpy:7459

translate spanish story05_5_4_8ec059f7:

    # Go "Emperor…"
    Go "Emperador..."

# game/Story04.rpy:7460

translate spanish story05_5_4_cad9d0a9:

    # Go "Interesting choice of words."
    Go "Interesante elección de palabras."

# game/Story04.rpy:7461

translate spanish story05_5_4_c75c2efd:

    # Go "You are the first to call me that."
    Go "Eres el primero en llamarme así."

# game/Story04.rpy:7463

translate spanish story05_5_4_5ddaab18:

    # mc "(What?)"
    mc "(¿Qué?)"

# game/Story04.rpy:7464

translate spanish story05_5_4_48fa5e63:

    # mc "(But Selvaria was called Empress. So either—)"
    mc "(Pero Selvaria se llamaba Emperatriz. Así que, o bien)"

# game/Story04.rpy:7467

translate spanish story05_5_4_64ab9065:

    # keep3 "(whispering) Bad news."
    keep3 "Malas noticias."

# game/Story04.rpy:7468

translate spanish story05_5_4_485e169d:

    # keep3 "(whispering) We’ve been thrown back 97 years."
    keep3 "Nos han tirado 97 años atrás."

# game/Story04.rpy:7469

translate spanish story05_5_4_2b35b6fe:

    # mc "..."
    mc "..."

# game/Story04.rpy:7471

translate spanish story05_5_4_8df9b125:

    # Go "You are no ordinary young man."
    Go "No eres un joven común."

# game/Story04.rpy:7477

translate spanish story05_5_4_a9e3f1f8:

    # Go "Especially your companion."
    Go "Especialmente tu compañero."

# game/Story04.rpy:7478

translate spanish story05_5_4_29e4fb56:

    # Go "The Third Keeper. Am I correct?"
    Go "El tercer guardián. ¿Estoy en lo correcto?"

# game/Story04.rpy:7480

translate spanish story05_5_4_61abcb5d:

    # keep3 "I underestimated him."
    keep3 "Lo subestimé."

# game/Story04.rpy:7484

translate spanish story05_5_4_c163fab1:

    # mc "What exactly do you know about us?"
    mc "¿Qué sabes exactamente de nosotros?"

# game/Story04.rpy:7486

translate spanish story05_5_4_2673f802:

    # Go "Enough to let you live."
    Go "Suficiente para dejarte vivir."

# game/Story04.rpy:7492

translate spanish story05_5_4_e4147bf7:

    # Go "In trying to save this girl… you attempted to go to the gate"
    Go "Al tratar de salvar a esta chica... intentaste ir a la puerta."

# game/Story04.rpy:7494

translate spanish story05_5_4_c2650d06:

    # Go "And failed."
    Go "Y falló."

# game/Story04.rpy:7495

translate spanish story05_5_4_d2cb3ce4:

    # Go "Why?"
    Go "¿Por qué?"

# game/Story04.rpy:7499

translate spanish story05_5_4_421d6327:

    # Go "Did something interfere."
    Go "Hice algo interferir."

# game/Story04.rpy:7501

translate spanish story05_5_4_1d65c210:

    # Go "Or perhaps...someone."
    Go "O quizás... alguien."

# game/Story04.rpy:7507

translate spanish story05_5_4_f390ac3d:

    # mc "Astoria asked us to meet you."
    mc "Astoria nos pidió que nos encontráramos contigo."

# game/Story04.rpy:7508

translate spanish story05_5_4_9b7059bb:

    # mc "She said you could help."
    mc "Dijo que podías ayudar."

# game/Story04.rpy:7514

translate spanish story05_5_4_7178350e:

    # Go "I’m pleased we understand one another."
    Go "Me complace que nos entendamos."

# game/Story04.rpy:7516

translate spanish story05_5_4_0932bce3:

    # mc "Tell me."
    mc "Dime."

# game/Story04.rpy:7517

translate spanish story05_5_4_5c7d12e0:

    # mc "Have you ever closed an activated Gate?"
    mc "¿Alguna vez has cerrado una puerta activada?"

# game/Story04.rpy:7519

translate spanish story05_5_4_e3ab25b2:

    # Go "What’s the catch?"
    Go "¿Cuál es la captura?"

# game/Story04.rpy:7521

translate spanish story05_5_4_5fee6da8:

    # mc "Hypothetical."
    mc "Hipótesis."

# game/Story04.rpy:7526

translate spanish story05_5_4_447e1a11:

    # Go "Yes."
    Go "Sí."

# game/Story04.rpy:7531

translate spanish story05_5_4_21924f07:

    # Go "I will ensure she survives."
    Go "Me aseguraré de que sobreviva."

# game/Story04.rpy:7532

translate spanish story05_5_4_c559ab05:

    # Go "Nothing more."
    Go "Nada más."

# game/Story04.rpy:7533

translate spanish story05_5_4_42374e0e:

    # Go "Whether she remains the same hum—"
    Go "Si ella sigue siendo la misma joroba..."

# game/Story04.rpy:7535

translate spanish story05_5_4_2ee86563:

    # mc "That’s enough."
    mc "Es suficiente."

# game/Story04.rpy:7539

translate spanish story05_5_4_59ccbc6b:

    # Go "Would you care for a walk?"
    Go "¿Le gustaría dar un paseo?"

# game/Story04.rpy:7551

translate spanish story05_5_4_a706495c:

    # Go "By nature, we elves are… inquisitive."
    Go "Por naturaleza, los elfos son... inquisitivos."

# game/Story04.rpy:7552

translate spanish story05_5_4_f27a259a:

    # Go "We have always sought to understand how this world is constructed."
    Go "Siempre hemos tratado de entender cómo se construye este mundo."

# game/Story04.rpy:7554

translate spanish story05_5_4_4840e6c1:

    # Go "And at times… that curiosity strayed beyond what was permitted."
    Go "Y a veces esa curiosidad se alejaba más allá de lo permitido."

# game/Story04.rpy:7558

translate spanish story05_5_4_36928135:

    # Mi "Proof that lines were crossed, mistakes made, and debts paid. Paid in blood."
    Mi "Prueba de que las líneas se cruzaron, se cometieron errores y se pagaron deudas. Pagado en sangre."

# game/Story04.rpy:7562

translate spanish story05_5_4_5c062fba:

    # Mi "The former leader of our faction, who..."
    Mi "El ex líder de nuestra facción, que..."

# game/Story04.rpy:7566

translate spanish story05_5_4_cef1b352:

    # mc "That scientist."
    mc "Ese científico."

# game/Story04.rpy:7567

translate spanish story05_5_4_ac2acad2:

    # Go "Yes, my grandfather."
    Go "Sí, mi abuelo."

# game/Story04.rpy:7570

translate spanish story05_5_4_6e50502e:

    # mc "What did he do… exactly?"
    mc "¿Qué hizo... exactamente?"

# game/Story04.rpy:7575

translate spanish story05_5_4_7c8b819d:

    # Go "He attempted to access the Astreon System."
    Go "Intentó acceder al sistema Astreon."

# game/Story04.rpy:7578

translate spanish story05_5_4_59885c7a:

    # mc "(whispering) And… what is that?"
    mc "¿Y qué es eso?"

# game/Story04.rpy:7582

translate spanish story05_5_4_a05fa700:

    # Go "A tragedy."
    Go "Una tragedia."

# game/Story04.rpy:7585

translate spanish story05_5_4_530faaff:

    # Go "For our entire people."
    Go "Para todo nuestro pueblo."

# game/Story04.rpy:7586

translate spanish story05_5_4_853d9845:

    # Go "From that moment on… we became enemies of the galaxy."
    Go "Desde ese momento... nos convertimos en enemigos de la galaxia."

# game/Story04.rpy:7592

translate spanish story05_5_4_2876efd9:

    # mc "Why?"
    mc "¿Por qué?"

# game/Story04.rpy:7596

translate spanish story05_5_4_b6441a88:

    # keep3 "There are rules in this galaxy."
    keep3 "Hay reglas en esta galaxia."

# game/Story04.rpy:7597

translate spanish story05_5_4_d64a83a5:

    # keep3 "Lines that are not to be crossed"
    keep3 "Líneas que no deben ser cruzadas"

# game/Story04.rpy:7599

translate spanish story05_5_4_fd929e92:

    # keep3 "One of them states: What has happened… must be paid for."
    keep3 "Uno de ellos dice: Lo que ha pasado... debe ser pagado."

# game/Story04.rpy:7601

translate spanish story05_5_4_0c8674d6:

    # keep3 "They broke that rule."
    keep3 "Ellos rompieron esa regla."

# game/Story04.rpy:7603

translate spanish story05_5_4_78d9297f:

    # keep3 "They went against time itself."
    keep3 "Se fueron contra el tiempo en sí mismo."

# game/Story04.rpy:7604

translate spanish story05_5_4_5470cd4a:

    # keep3 "And in return… all of us paid for their mistake."
    keep3 "Y a cambio... todos pagamos por su error."

# game/Story04.rpy:7608

translate spanish story05_5_4_15b3e468:

    # mc "None of us are without sin."
    mc "Ninguno de nosotros está sin pecado."

# game/Story04.rpy:7609

translate spanish story05_5_4_0085e033:

    # keep3 "..."
    keep3 "..."

# game/Story04.rpy:7615

translate spanish story05_5_4_474762be:

    # Go "What do you see?"
    Go "¿Qué ves?"

# game/Story04.rpy:7618

translate spanish story05_5_4_9d61da8a:

    # mc "A Gate."
    mc "Una puerta."

# game/Story04.rpy:7619

translate spanish story05_5_4_0ed99863:

    # Go "Days. Weeks. Years. Decades… Time kept moving."
    Go "Días, Semanas, Años, Décadas, Tiempos seguidos."

# game/Story04.rpy:7621

translate spanish story05_5_4_4d3c49ef:

    # Go "And with it… our curiosity grew."
    Go "Y con ello... nuestra curiosidad creció."

# game/Story04.rpy:7628

translate spanish story05_5_4_479720ab:

    # Go "Long lives are a blessing. {w=0.7}And a curse."
    Go "Larga vida es una bendición. {w=0.7}Y una maldición."

# game/Story04.rpy:7629

translate spanish story05_5_4_671fb598:

    # Go "When you live long enough… meaning begins to rot."
    Go "Cuando vives lo suficiente... el significado comienza a pudrirte."

# game/Story04.rpy:7635

translate spanish story05_5_4_63f9db68:

    # Go "So many of us cling to research."
    Go "Muchos de nosotros nos aferramos a la investigación."

# game/Story04.rpy:7636

translate spanish story05_5_4_51968a67:

    # Go "To discovery."
    Go "Para descubrir."

# game/Story04.rpy:7637

translate spanish story05_5_4_bb25eb4a:

    # Go "To prying open doors that should remain closed."
    Go "Para abrir puertas que deben permanecer cerradas."

# game/Story04.rpy:7639

translate spanish story05_5_4_d56306e3:

    # Go "My grandfather was no exception."
    Go "Mi abuelo no era una excepción."

# game/Story04.rpy:7640

translate spanish story05_5_4_7993dfb4:

    # Go "He believed that uncovering the truth of the Gates would let us step beyond the limits of the possible."
    Go "Él creía que descubrir la verdad de las Puertas nos permitiría ir más allá de los límites de lo posible."

# game/Story04.rpy:7642

translate spanish story05_5_4_23ac7b1d_1:

    # Go "..."
    Go "..."

# game/Story04.rpy:7644

translate spanish story05_5_4_0903fc81:

    # Go "What he didn’t know…"
    Go "Lo que no sabía..."

# game/Story04.rpy:7645

translate spanish story05_5_4_c96eee8a:

    # Go "Was about the price."
    Go "Era por el precio."

# game/Story04.rpy:7647

translate spanish story05_5_4_c21e0a9c:

    # Go "None of us did."
    Go "Ninguno de nosotros lo hizo."

# game/Story04.rpy:7648

translate spanish story05_5_4_a4fc24fd:

    # Go "So he activated the Gate."
    Go "Así que él activó la Puerta."

# game/Story04.rpy:7651

translate spanish story05_5_4_2ef8f991:

    # Go "And time stopped."
    Go "Y el tiempo se detuvo."

# game/Story04.rpy:7655

translate spanish story05_5_4_e81e8b98:

    # Go "Not metaphorically."
    Go "No metafóricamente."

# game/Story04.rpy:7656

translate spanish story05_5_4_104aa39f:

    # Go "Literally."
    Go "Literalmente."

# game/Story04.rpy:7658

translate spanish story05_5_4_cd2dd2fb:

    # Go "The world… froze."
    Go "El mundo... se congeló."

# game/Story04.rpy:7661

translate spanish story05_5_4_32f411d5:

    # Go "Like someone pressed pause."
    Go "Como si alguien presionara la pausa."

# game/Story04.rpy:7666

translate spanish story05_5_4_41128b08:

    # Go "...and then."
    Go "...y entonces."

# game/Story04.rpy:7670

translate spanish story05_5_4_26e832f7:

    # Go "In the next second…"
    Go "En el segundo..."

# game/Story04.rpy:7672

translate spanish story05_5_4_4a6b467f:

    # Go "My father. My mother. My friends."
    Go "Mi padre, mi madre, mis amigos."

# game/Story04.rpy:7674

translate spanish story05_5_4_af8847a3:

    # Go "Gone."
    Go "Se fue."

# game/Story04.rpy:7676

translate spanish story05_5_4_1284fe28:

    # Go "(whispering) Vanished…"
    Go "Desaparecido..."

# game/Story04.rpy:7677

translate spanish story05_5_4_cbdf1bb6:

    # Go "(whispering) Half of our race."
    Go "La mitad de nuestra carrera."

# game/Story04.rpy:7678

translate spanish story05_5_4_822d419a:

    # Go "(whispering) Half of galaxy."
    Go "La mitad de la galaxia."

# game/Story04.rpy:7679

translate spanish story05_5_4_cb7eb722:

    # Go "(whispering) In a single heartbeat."
    Go "En un solo latido."

# game/Story04.rpy:7681

translate spanish story05_5_4_1890a173:

    # mc "How…?"
    mc "¿Cómo...?"

# game/Story04.rpy:7682

translate spanish story05_5_4_756bb34d:

    # keep3 "Payment."
    keep3 "Pago."

# game/Story04.rpy:7683

translate spanish story05_5_4_42b74561:

    # keep3 "For power."
    keep3 "Por el poder."

# game/Story04.rpy:7687

translate spanish story05_5_4_b57a10de:

    # keep3 "We didn’t realize…"
    keep3 "No nos dimos cuenta..."

# game/Story04.rpy:7692

translate spanish story05_5_4_9eac7e46:

    # keep3 "The Gates were still tethered to the System."
    keep3 "Las puertas seguían atascadas al Sistema."

# game/Story04.rpy:7693

translate spanish story05_5_4_76588c2f:

    # keep3 "(That was our mistake.)"
    keep3 "(Ese fue nuestro error.)"

# game/Story04.rpy:7698

translate spanish story05_5_4_0094ddb6:

    # Go "Answer me this."
    Go "Respóndeme esto."

# game/Story04.rpy:7699

translate spanish story05_5_4_87042096:

    # Go "Why is the blood of the Ancients required to activate a Gate?"
    Go "¿Por qué la sangre de los Antiguos es necesaria para activar una Puerta?"

# game/Story04.rpy:7701

translate spanish story05_5_4_81297b39:

    # mc "It’s the only viable energy source."
    mc "Es la única fuente de energía viable."

# game/Story04.rpy:7704

translate spanish story05_5_4_4388f0b9:

    # Go "Correct."
    Go "Correcto."

# game/Story04.rpy:7705

translate spanish story05_5_4_0fdd036f:

    # Go "But why?"
    Go "¿Pero por qué?"

# game/Story04.rpy:7707

translate spanish story05_5_4_d94b413c:

    # Go "Because it consumes life."
    Go "Porque consume vida."

# game/Story04.rpy:7708

translate spanish story05_5_4_5bebf0d5:

    # Go "To spare your own."
    Go "Para ahorrarte la tuya."

# game/Story04.rpy:7710

translate spanish story05_5_4_2b35b6fe_1:

    # mc "..."
    mc "..."

# game/Story04.rpy:7712

translate spanish story05_5_4_d8ed302e:

    # mc "Then answer me something."
    mc "Entonces, contestame algo."

# game/Story04.rpy:7713

translate spanish story05_5_4_38d7f3b3:

    # mc "If you had stood in his place…"
    mc "Si hubieras estado en su lugar..."

# game/Story04.rpy:7714

translate spanish story05_5_4_a2b68c64:

    # mc "Would you have chosen differently?"
    mc "¿Habrías elegido de otra manera?"

# game/Story04.rpy:7716

translate spanish story05_5_4_059e31ef:

    # Go "Knowing the whole truth?"
    Go "¿Conocer toda la verdad?"

# game/Story04.rpy:7719

translate spanish story05_5_4_447e1a11_1:

    # Go "Yes."
    Go "Sí."

# game/Story04.rpy:7720

translate spanish story05_5_4_e789ac9c:

    # Go "…Or at least, I would like to believe so."
    Go "...o al menos, me gustaría creerlo."

# game/Story04.rpy:7722

translate spanish story05_5_4_2b35b6fe_2:

    # mc "..."
    mc "..."

# game/Story04.rpy:7723

translate spanish story05_5_4_295112db:

    # mc "Even if the lives of those you love depended on it?"
    mc "¿Aunque la vida de aquellos que amas dependiera de ello?"

# game/Story04.rpy:7724

translate spanish story05_5_4_95e5a45b:

    # Go "There are rules."
    Go "Hay reglas."

# game/Story04.rpy:7728

translate spanish story05_5_4_07b93860:

    # mc "Rules are easy when you’re not the one losing someone."
    mc "Las reglas son fáciles cuando no eres el que pierde a alguien."

# game/Story04.rpy:7736

translate spanish story05_5_4_c80a81cf:

    # Go "So that is what this is about…"
    Go "Así que eso es lo que se trata..."

# game/Story04.rpy:7738

translate spanish story05_5_4_c2930ae5:

    # mc "She wants her sister back."
    mc "Quiere que su hermana vuelva."

# game/Story04.rpy:7740

translate spanish story05_5_4_479f068d:

    # Go "She knows the risks."
    Go "Sabe los riesgos."

# game/Story04.rpy:7744

translate spanish story05_5_4_0c89a7cd:

    # am "Go. Find Gorem."
    am "Ve, busca a Gorem."

# game/Story04.rpy:7745

translate spanish story05_5_4_fe5b2af0:

    # am "I’ll handle the rest."
    am "Yo me encargaré del resto."

# game/Story04.rpy:7749

translate spanish story05_5_4_3b753126:

    # mc "I don’t think she understands them."
    mc "No creo que ella los entienda."

# game/Story04.rpy:7750

translate spanish story05_5_4_7f08e5f1:

    # mc "Not really."
    mc "No realmente."

# game/Story04.rpy:7752

translate spanish story05_5_4_971fd8c0:

    # Go "Did she grow afraid of her own choices?"
    Go "¿Le temía sus propias opciones?"

# game/Story04.rpy:7754

translate spanish story05_5_4_2034c056:

    # mc "Maybe."
    mc "Tal vez."

# game/Story04.rpy:7755

translate spanish story05_5_4_086f7e4e:

    # mc "Or maybe…"
    mc "O tal vez..."

# game/Story04.rpy:7760

translate spanish story05_5_4_99d399b1:

    # L "Astoria and I are trying to choose the one..."
    L "Astoria y yo estamos tratando de elegir el..."

# game/Story04.rpy:7761

translate spanish story05_5_4_221faad5:

    # L "Where everyone keeps what matters to them."
    L "Donde todo el mundo guarda lo que les importa."

# game/Story04.rpy:7765

translate spanish story05_5_4_8114117d:

    # mc "There’s still something human left in her."
    mc "Todavía queda algo humano en ella."

# game/Story04.rpy:7766

translate spanish story05_5_4_b887b7f4:

    # mc "(whispering) I hope so."
    mc "Eso espero."

# game/Story04.rpy:7773

translate spanish story05_5_4_491f58a8:

    # elf "Aran nín, thang veleg dâf! \n(Your Highness, we have a problem!)"
    elf "Aran nín, queg veleg dâf! (Su Alteza, tenemos un problema!)"

# game/Story04.rpy:7774

translate spanish story05_5_4_7fe3f58c:

    # Go "Man danna? \n(What happened?)"
    Go "¿Qué pasó?"

# game/Story04.rpy:7775

translate spanish story05_5_4_22d705df:

    # elf "I sell, hi— \n(The girl, she—)"
    elf "Vendo, hola... (La chica, ella--)"

# game/Story04.rpy:7793

translate spanish story05_5_4_efb9a313:

    # ketr "Ánin… ú-aníron baded… \n(Please… I don’t want to die…)"
    ketr "Ánin... ú-aníron se encargó... (Por favor... no quiero morir...)"

# game/Story04.rpy:7794

