translate spanish story05_5_2_ea77fedf:

    # mc "...Damn it."
    mc "...Dámelo."

# game/Story04.rpy:6682

translate spanish story05_5_2_1608f321:

    # mc "(I hope it doesn’t come to that.)"
    mc "(Espero que no llegue a eso.)"

# game/Story04.rpy:6683

translate spanish story05_5_2_ef5c4567:

    # mc "Please… live."
    mc "Por favor... viva."

# game/Story04.rpy:6691

translate spanish story05_5_2_13be4b8e:

    # a "(What am I doing? Using miasma like this breaks the Codex.)"
    a "Usar el miasma como este rompe el Codex."

