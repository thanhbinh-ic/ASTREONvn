translate spanish story05_5_3_33bef520:

    # mc "(It’s… calming. But is she better? Worse? I can’t stop overthinking it.)"
    mc "(Es... calmante. ¿Pero es mejor? ¿Peor? No puedo dejar de pensarlo demasiado.)"

# game/Story04.rpy:6776

translate spanish story05_5_3_f7bed42a:

    # mc "(All I can do is wait. Let her rest.)"
    mc "(Lo único que puedo hacer es esperar. Déjala descansar.)"

# game/Story04.rpy:6778

translate spanish story05_5_3_46404cce:

    # mc "(And then what?)"
    mc "(¿Y luego qué?)"

# game/Story04.rpy:6781

translate spanish story05_5_3_e5013fa2:

    # mc "Arkh…"
    mc "Arkh..."

# game/Story04.rpy:6782

translate spanish story05_5_3_4159b962:

    # mc "(You threw yourself into that abyss without thinking.)"
    mc "(Te metiste en ese abismo sin pensar.)"

# game/Story04.rpy:6783

translate spanish story05_5_3_9c799d35:

    # mc "(Yeah. We’re alive.)"
    mc "(Sí. Estamos vivos.)"

# game/Story04.rpy:6784

translate spanish story05_5_3_e9a44c7c:

    # mc "(For now.)"
    mc "(Por ahora.)"

