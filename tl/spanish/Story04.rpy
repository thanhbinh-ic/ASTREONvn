translate spanish story05_5_2_24eec0dd:

    # mc "Now?"
    mc "¿Ahora?"

# game/Story04.rpy:6741

translate spanish story05_5_2_0b0ed3c0:

    # a "Cauterize the wound."
    a "Cauterize la herida."

