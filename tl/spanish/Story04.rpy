translate spanish story05_3ee17288:

    # h "(And he’s spacing out again… whatever. Let him. We’ll give him a few minutes.)"
    h "(Y él está espaciando otra vez... lo que sea. Déjelo. Le daremos unos minutos.)"

# game/Story04.rpy:366

translate spanish story05_89de2763:

    # mc "(I’m the key to the portal?)"
    mc "(¿Soy la clave del portal?)"

# game/Story04.rpy:367

translate spanish story05_31c6064e:

    # mc "(whispering) No. That’s not it. Doesn’t add up."
    mc "No. Eso no es todo. No se suma."

