    # k "But if you want, I can give you a hundred and one reasons why higher beings are a pain in the ass."
    k "Pero si quieres, puedo darte cien por una razón por la cual los seres superiores son un dolor en el culo."

# game/Story04.rpy:5635

translate spanish story05_5_1_0c802973:

    # mc "(Flora mentioned something like this before… but somehow they managed to kill one of those Higher Beings.)"
    mc "(Flora mencionó algo como esto antes... pero de alguna manera lograron matar a uno de esos Seres Superiores.)"

# game/Story04.rpy:5636

translate spanish story05_5_1_89744d57:

    # mc "(How?)"
    mc "(¿Cómo?)"

# game/Story04.rpy:5638

translate spanish story05_5_1_f25e511b:

    # mc "Options?"
    mc "¿Opciones?"

