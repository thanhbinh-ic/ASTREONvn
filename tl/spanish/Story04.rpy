    # mc "(No food. Barely any water. If we stay here, we’re dead.)"
    mc "(No hay comida. Apenas agua. Si nos quedamos aquí, estamos muertos.)"

# game/Story04.rpy:6788

translate spanish story05_5_3_69fe3566:

    # mc "(But we can’t leave either. And even if we could, where to?)"
    mc "(Pero no podemos dejar ninguno. Y aunque podamos, ¿dónde?)"

