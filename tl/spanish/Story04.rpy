translate spanish story05_5_2_e07f6645:

    # mc "Why isn’t the miasma working?!"
    mc "¿Por qué el miasma no funciona?!"

# game/Story04.rpy:6725

translate spanish story05_5_2_bb8e4b4e_4:

    # a "..."
    a "..."

# game/Story04.rpy:6726

translate spanish story05_5_2_66ad4f2a:

    # a "It is."
    a "Lo es."

# game/Story04.rpy:6727

translate spanish story05_5_2_8e207271:

    # mc "But her condi—"
    mc "Pero su condi..."

