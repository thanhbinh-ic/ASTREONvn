translate spanish story05_bfc13893:

    # h "Okay, nope. I don’t like where this is going."
    h "Vale, no. No me gusta a dónde va esto."

# game/Story04.rpy:357

translate spanish story05_8dc8f948:

    # h "What’s so damn special about this… sphere, or whatever it is, that everyone suddenly wants it?"
    h "¿Qué es tan especial de esta esfera, o lo que sea, que todos de repente lo quieren?"

# game/Story04.rpy:358

translate spanish story05_e74be59f:

    # Mi "This sphere is a thread of reality."
    Mi "Esta esfera es un hilo de realidad."

# game/Story04.rpy:359

translate spanish story05_38a44d67:

    # h "What? That one?"
    h "¿Ese?"

# game/Story04.rpy:361

translate spanish story05_307e255d:

    # mc "(Think, [mc]. Think. You’re the key, but to what?)"
    mc "(Piensa, [mc]. Piensa. Soy la llave, ¿pero de qué?)"

