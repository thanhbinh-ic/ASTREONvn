    # Evrel "WHAT?! ARE YOU OUT OF YOUR MIND?! This will destroy you, and the entire Federation!"
    Evrel "¿Qué? ¿Estás loco? Esto te destruirá, y toda la Federación!"

# game/Story04.rpy:2115

translate spanish story05_3_a74574fe:

    # Evrel "Asti, please, tell me you’re joking-"
    Evrel "Asti, por favor, dime que estás bromeando."

# game/Story04.rpy:2116

translate spanish story05_3_d2188890:

    # am "I won’t allow them to harm you."
    am "No permitiré que te hagan daño."

# game/Story04.rpy:2117

translate spanish story05_3_6ad649f5:

    # Evrel "Then I’ll kill them myself!"
    Evrel "¡Entonces los mataré yo mismo!"

# game/Story04.rpy:2118

translate spanish story05_3_1c8acf17_3:

    # am "..."
    am "..."

# game/Story04.rpy:2119

translate spanish story05_3_b4d854a3:

    # am "If you kill them, the galaxy will collapse into chaos."
    am "Si los matas, la galaxia colapsará en el caos."

# game/Story04.rpy:2121

translate spanish story05_3_47da6034:

    # Evrel "The idea of you sacrificing yourself doesn’t exactly make me smile!"
    Evrel "La idea de que te sacrificas no me hace sonreír."

# game/Story04.rpy:2123

translate spanish story05_3_e1504de9:

    # em "Let this be a damn lesson-"
    em "Que sea una maldita lección..."

# game/Story04.rpy:2124

translate spanish story05_3_7e54a4b1:

    # Evrel "Don’t interfere."
    Evrel "No interfiera."

# game/Story04.rpy:2125

translate spanish story05_3_1f60867d:

    # am "Evrelia, listen to me..."
    am "Evrelia, escúchame..."

# game/Story04.rpy:2127

translate spanish story05_3_239b034c:

    # Evrel "If this is your way out, then I hate it. The thought that I stay alive at the cost of your life is the worst thing imaginable!"
    Evrel "Si esta es tu salida, entonces lo odio. ¡El pensamiento de que me quedo vivo al costo de tu vida es lo peor que se puede imaginar!"

# game/Story04.rpy:2128

translate spanish story05_3_fc983a8f:

    # Evrel "And I decide what I do with my damn life!"
    Evrel "¡Y yo decido lo que hago con mi maldita vida!"

# game/Story04.rpy:2130

translate spanish story05_3_08b07af0:

    # am "Don’t do anything foolish. This is the only way."
    am "No hagas nada tonto. Esta es la única manera."

# game/Story04.rpy:2134

translate spanish story05_3_495d0387:

    # em "She’s gone."
    em "Se ha ido."

# game/Story04.rpy:2135

translate spanish story05_3_75a50f00:

    # em "Damn, that girl’s got a nasty temper, really nasty."
    em "Maldita sea, esa chica tiene un temperamento desagradable, muy desagradable."

# game/Story04.rpy:2138

translate spanish story05_3_dabc8a6d:

    # em "Wait, were you actually ready to trade everything you own for her?"
    em "Espera, ¿estabas listo para cambiar todo lo que tienes para ella?"

# game/Story04.rpy:2139

translate spanish story05_3_d6e9cfbd:

    # em "Should’ve handed her to me instead, I would’ve-"
    em "Debería haberla entregado a mí en cambio, yo habría..."

# game/Story04.rpy:2143

translate spanish story05_3_68c3546f:

    # em "Alright, alright, don’t glare at me."
    em "De acuerdo, de acuerdo, no me mires."

# game/Story04.rpy:2144

translate spanish story05_3_bf9b5df0:

    # em "I’ll see what I can do, but don’t get your hopes up."
    em "Veré lo que puedo hacer, pero no te despertes."

# game/Story04.rpy:2147

translate spanish story05_3_7f3251b8:

    # am "Thank you, Em."
    am "Gracias, Em."

# game/Story04.rpy:2148

translate spanish story05_3_178dae24:

    # em "I’m not doing it for free."
    em "No lo haré gratis."

# game/Story04.rpy:2149

translate spanish story05_3_bb30b747:

    # em "I’ll take my cut, and it’ll be big."
    em "Tomaré mi corte, y será grande."

# game/Story04.rpy:2156

translate spanish story05_3_8ea6b1b9:

    # am "(A world in exchange for one life… or one life in exchange for a world?)"
    am "(¿Un mundo a cambio de una vida... o una vida a cambio de un mundo?)"

# game/Story04.rpy:2158

translate spanish story05_3_05cf51cb:

    # am "(Sometimes we must make choices so heavy that everything hangs on their outcome.)"
    am "(A veces debemos tomar decisiones tan pesadas que todo cuelga en su resultado.)"

# game/Story04.rpy:2160

translate spanish story05_3_b53b388a:

    # am "(And a path that appears righteous… may lead to anything but salvation.)"
    am "(Y un camino que parece justo... puede conducir a cualquier cosa excepto la salvación.)"

# game/Story04.rpy:2161

translate spanish story05_3_39b2f587:

    # am "(At times, we must compromise with fate itself.)"
    am "(A veces, debemos comprometernos con el destino mismo.)"

# game/Story04.rpy:2163

translate spanish story05_3_31007c2b:

    # Evrel "{b}Sings"
    Evrel "{b}Canciones"

# game/Story04.rpy:2164

translate spanish story05_3_dc4d5b43:

    # am "(All our lives we stood side by side, our triumphs, our failures, our joy and our suffering were always shared between the two of us.)"
    am "(Todas nuestras vidas nos mantuvimos de lado, nuestros triunfos, nuestros fracasos, nuestra alegría y nuestro sufrimiento siempre fueron compartidos entre nosotros dos.)"

# game/Story04.rpy:2166

translate spanish story05_3_21850939:

    # am "(Without her, I would not exist. And without me, neither would she.)"
    am "(Sin ella, no existiría, y sin mí, tampoco lo haría ella.)"

# game/Story04.rpy:2167

translate spanish story05_3_abe730c0:

    # am "(Yet one day the world decided it wished to take her from me.)"
    am "(Un día el mundo decidió que deseara quitarla de mí.)"

# game/Story04.rpy:2169

translate spanish story05_3_94e5eb58:

    # Evrel "You know… sometimes I wonder what it would be like if we all turned into flowers."
    Evrel "Sabes... a veces me pregunto cómo sería si todos nos convertimos en flores."

# game/Story04.rpy:2171

translate spanish story05_3_73f0b076:

    # am "A flower?"
    am "¿Una flor?"

# game/Story04.rpy:2173

translate spanish story05_3_564d27c0:

    # Evrel "To live your entire life in one quiet place. On a beautiful meadow, wrapped in nature’s calm."
    Evrel "Vivir toda tu vida en un lugar tranquilo. En un hermoso prado, envuelto en la calma de la naturaleza."

# game/Story04.rpy:2174

translate spanish story05_3_e33d515e:

    # Evrel "If that isn’t paradise… then what is?"
    Evrel "Si eso no es el paraíso... ¿qué es?"

# game/Story04.rpy:2176

translate spanish story05_3_7a5a326c:

    # am "It does sound… not entirely unpleasant."
    am "Suena... no muy desagradable."

# game/Story04.rpy:2179

translate spanish story05_3_87f08231:

    # Evrel "So? Did you come here to change my mind?"
    Evrel "¿Has venido a cambiar de opinión?"

# game/Story04.rpy:2182

translate spanish story05_3_c42afbd5:

    # am "Will it work?"
    am "¿Funcionará?"

# game/Story04.rpy:2183

translate spanish story05_3_d93c1303:

    # am "You’ve already chosen your path."
    am "Ya has elegido tu camino."

# game/Story04.rpy:2185

translate spanish story05_3_b74c036e:

    # Evrel "When flowers die, they shed their petals…"
    Evrel "Cuando mueren las flores, derraman sus pétalos..."

# game/Story04.rpy:2186

translate spanish story05_3_127611d4:

    # Evrel "…so something new can grow."
    Evrel "...para que algo nuevo pueda crecer."

# game/Story04.rpy:2187

translate spanish story05_3_64a8777b:

    # Evrel "And then, they begin a new life."
    Evrel "Y luego, comienzan una nueva vida."

# game/Story04.rpy:2190

translate spanish story05_3_1bd05abb:

    # am "You don’t regret leaving this world like this?"
    am "¿No te arrepientes de dejar este mundo así?"

# game/Story04.rpy:2192

translate spanish story05_3_2c13a87a:

    # Evrel "We’ve both lived a long life. By everyone else’s standards, far too long."
    Evrel "Ambos hemos vivido una larga vida. Por los estándares de todos, demasiado tiempo."

# game/Story04.rpy:2194

translate spanish story05_3_d0e91a8f:

    # Evrel "And for better or worse, everything has an end. I just chose to hurry the inevitable."
    Evrel "Y para bien o para mal, todo tiene un fin. Yo solo elegí apresurar lo inevitable."

# game/Story04.rpy:2195

translate spanish story05_3_06d3173d:

    # Evrel "Do I regret it?"
    Evrel "¿Me arrepiento?"

# game/Story04.rpy:2196

translate spanish story05_3_ae1515b6:

    # Evrel "Not even a little."
    Evrel "Ni siquiera un poco."

# game/Story04.rpy:2198

translate spanish story05_3_bca6ab1f:

    # Evrel "But you… you’re a different matter."
    Evrel "Pero tú... eres un asunto diferente."

# game/Story04.rpy:2199

translate spanish story05_3_8481c1a4:

    # Evrel "I’m sorry, Asti, but you’ll have to keep living without me."
    Evrel "Lo siento, Asti, pero tendrás que seguir viviendo sin mí."

# game/Story04.rpy:2200

translate spanish story05_3_c6c89e61:

    # Evrel "And take care of this whole Federation… and everything that comes with it."
    Evrel "Y cuida de toda esta Federación... y todo lo que viene con ella."

# game/Story04.rpy:2203

translate spanish story05_3_7ea072d2:

    # am "Cruel."
    am "Cruel."

# game/Story04.rpy:2205

translate spanish story05_3_d5e3dd86:

    # Evrel "I’m sorry."
    Evrel "Lo siento."

# game/Story04.rpy:2209

translate spanish story05_3_4c749945:

    # am "Do you remember how we spent time here as children?"
    am "¿Recuerdas cómo pasamos el tiempo aquí como niños?"

# game/Story04.rpy:2210

translate spanish story05_3_22b4d1e0:

    # Evrel "Huh? Oh, don’t remind me, I still get chills remembering how angry Mother got when she saw the bruises."
    Evrel "No me recuerdes, todavía me dan escalofríos recordando lo enojada que se puso mamá cuando vio los moretones."

# game/Story04.rpy:2212

translate spanish story05_3_bf1d7dca:

    # am "Can you blame her? You were a real little shit back then."
    am "¿Puedes culparla?"

# game/Story04.rpy:2213

translate spanish story05_3_e76b22f5:

    # Evrel "Whoa, since when do you use words like that?"
    Evrel "¿Desde cuándo usas palabras así?"

# game/Story04.rpy:2215

translate spanish story05_3_7c7cd8fa:

    # am "Back off."
    am "Retrocede."

# game/Story04.rpy:2219

translate spanish story05_3_80ca0814:

    # Evrel "(I’d almost forgotten what it feels like… to just sit and talk with family.)"
    Evrel "(Casi me había olvidado de lo que se siente... sentarse y hablar con la familia.)"

# game/Story04.rpy:2220

translate spanish story05_3_8087fe24:

    # Evrel "(Funny how, right before death, you start thinking about things like that.)"
    Evrel "(Contento cómo, justo antes de la muerte, empiezas a pensar en cosas como esas.)"

# game/Story04.rpy:2222

translate spanish story05_3_7515cb18:

    # Evrel "Sis?"
    Evrel "¿Sés?"

# game/Story04.rpy:2224

translate spanish story05_3_61497916:

    # am "Yes?"
    am "¿Sí?"

# game/Story04.rpy:2226

translate spanish story05_3_a73407b6:

    # Evrel "Thank you."
    Evrel "Gracias."

# game/Story04.rpy:2227

translate spanish story05_3_1c8acf17_4:

    # am "..."
    am "..."

# game/Story04.rpy:2229

translate spanish story05_3_3ff2d0c2:

    # am "(Every minute stretches into eternity… and eternity passes in a single minute.)"
    am "(Cada minuto se extiende hacia la eternidad... y la eternidad pasa en un minuto.)"

# game/Story04.rpy:2230

translate spanish story05_3_ce32ae26:

    # am "(It’s hard. It hurts. It feels hopeless… and worst of all, nothing can change it.)"
    am "(Es difícil. Duele. Se siente inesperada... y lo peor de todo, nada puede cambiarlo.)"

# game/Story04.rpy:2232

translate spanish story05_3_c70d0986:

    # Evrel "Beautiful."
    Evrel "Hermoso."

# game/Story04.rpy:2234

translate spanish story05_3_be008720:

    # am "Why didn’t you go to the past and try to fix this?"
    am "¿Por qué no fuiste al pasado y trataste de arreglar esto?"

# game/Story04.rpy:2236

translate spanish story05_3_802d4ae6:

    # Evrel "I tried."
    Evrel "Lo intenté."

# game/Story04.rpy:2237

translate spanish story05_3_4a1bd9d5:

    # Evrel "But I couldn’t."
    Evrel "Pero no pude."

# game/Story04.rpy:2241

translate spanish story05_3_f653f572:

    # am "What? How?"
    am "¿Cómo?"

# game/Story04.rpy:2243

translate spanish story05_3_8e9a8177:

    # Evrel "No matter how much power you have, messing with time never ends well."
    Evrel "No importa cuánto poder tengas, meterte con el tiempo nunca termina bien."

# game/Story04.rpy:2244

translate spanish story05_3_0d344611:

    # Evrel "In the end, Asti… we’re not all-powerful."
    Evrel "Al final, Asti... no somos todopoderosos."

# game/Story04.rpy:2246

translate spanish story05_3_49b992bc:

    # Evrel "Well… I guess it’s time. They’ve arrived."
    Evrel "Bueno... supongo que es el momento."

# game/Story04.rpy:2248

translate spanish story05_3_f875a9d0:

    # "The air shuddered ever so slightly, and three figures in white cloaks appeared in the garden."
    "El aire se estremeció tan ligeramente, y tres figuras en mantos blancos aparecieron en el jardín."

# game/Story04.rpy:2250

translate spanish story05_3_3d4a3581:

    # a "And I am pleased to see you as well, Lady Astoria… young lady."
    a "Y me alegra verte también, Lady Astoria... jovencita."

# game/Story04.rpy:2252

translate spanish story05_3_facf703f:

    # Evrel "Disgusting as ever."
    Evrel "Es repugnante como siempre."

# game/Story04.rpy:2254

translate spanish story05_3_38aaea10:

    # am "What does a Keeper want in my home?"
    am "¿Qué quiere un Guardián en mi casa?"

# game/Story04.rpy:2256

translate spanish story05_3_a7e44f3f:

    # a "By Order Seventy-Two, Lady Evrelia is to be brought before the court and punished for her crimes."
    a "Por orden Setenta y Dos, Lady Evrelia será llevada ante la corte y castigada por sus crímenes."

# game/Story04.rpy:2257

translate spanish story05_3_9d33d4df:

    # am "Who issued this order?"
    am "¿Quién emitió esta orden?"

# game/Story04.rpy:2258

translate spanish story05_3_d147a714:

    # a "Unanimously. The Council of Keepers."
    a "Por unanimidad, el Consejo de Guardianes."

# game/Story04.rpy:2259

translate spanish story05_3_a317bc40:

    # a "Any resistance will result in your entire race being wiped from the face of the galaxy."
    a "Cualquier resistencia resultará en que toda su raza sea borrada de la cara de la galaxia."

# game/Story04.rpy:2260

translate spanish story05_3_a3fa6188:

    # a "But I suspect you already know that."
    a "Pero sospecho que ya lo sabes."

# game/Story04.rpy:2262

translate spanish story05_3_43625aa3:

    # am "May I ask a single question, why her?"
    am "¿Puedo hacer una pregunta, por qué ella?"

# game/Story04.rpy:2264

translate spanish story05_3_0a933921:

    # a "I fail to see what you mean."
    a "No veo a qué te refieres."

# game/Story04.rpy:2266

translate spanish story05_3_9bd8586e:

    # am "Very well, I’ll answer it myself: you fear that one day she will surpass you."
    am "Muy bien, yo mismo lo responderé: temes que un día te supere."

# game/Story04.rpy:2267

translate spanish story05_3_c4d82c07:

    # am "You fear what you cannot control, and so you chose to erase her."
    am "Temes lo que no puedes controlar, y así elegiste borrarla."

# game/Story04.rpy:2269

translate spanish story05_3_0f6fb0c5:

    # a "I understand your emotions, but you are crossing the bounds of what is permit-"
    a "Entiendo tus emociones, pero estás cruzando los límites de lo que es permiso..."

# game/Story04.rpy:2271

translate spanish story05_3_f0b96a7c:

    # am "Many have committed far worse crimes than she, yourself included. Yet you select her as the sacrificial lamb?"
    am "Muchos han cometido crímenes mucho peores que ella, usted mismo incluido. ¿Sin embargo la selecciona como el cordero sacrificado?"

# game/Story04.rpy:2273

translate spanish story05_3_5cc44e8a:

    # am "Then hear this: if you intend to destroy her, you will have to destroy all of us."
    am "Entonces escucha esto: si tienes la intención de destruirla, tendrás que destruirnos a todos nosotros."

# game/Story04.rpy:2275

translate spanish story05_3_dc394fca:

    # am "Every last one."
    am "Cada uno."

# game/Story04.rpy:2276

translate spanish story05_3_bb8e4b4e:

    # a "..."
    a "..."

# game/Story04.rpy:2278

translate spanish story05_3_1a72da87:

    # aa "What are your orders, Keeper? If she joins the fight, we won’t stand a chance."
    aa "¿Cuáles son sus órdenes, Guardián? Si se une a la lucha, no tendremos oportunidad."

# game/Story04.rpy:2280

translate spanish story05_3_4575439e:

    # a "If I were you, I would think very carefully about your next move."
    a "Si fuera tú, pensaría muy cuidadosamente en tu próximo movimiento."

# game/Story04.rpy:2282

translate spanish story05_3_520399ab:

    # y "I wouldn’t advise it."
    y "No lo aconsejaría."

# game/Story04.rpy:2283

translate spanish story05_3_f8793759:

    # aa "How dare you speak to a Keeper that way, servant?!"
    aa "¿Cómo se atreve a hablar con un guardián de esa manera, sirviente?"

# game/Story04.rpy:2284

translate spanish story05_3_71a86863:

    # y "..."
    y "..."

# game/Story04.rpy:2287

translate spanish story05_3_ca56f8ed:

    # am "(whisper) If a flower is meant to begin a new life today… then I will become the soil for it."
    am "Si una flor quiere comenzar una nueva vida hoy... entonces me convertiré en el suelo para ella."

# game/Story04.rpy:2288

translate spanish story05_3_1562ec1b:

    # am "(whisper) I’ll hold them off. Run. Run with everything you have."
    am "(susurrador) Yo los sostendré. Corre. Corre con todo lo que tienes."

# game/Story04.rpy:2290

translate spanish story05_3_a3f9c1ec:

    # Evrel "(Her voice shakes… yet I can feel the anger and hurt behind her mask of strength and independence. Damn, Asti… you’re amazing.)"
    Evrel "(Su voz tembla... sin embargo puedo sentir la ira y herir detrás de su máscara de fuerza e independencia. Maldita sea, Asti... eres increíble.)"

# game/Story04.rpy:2292

translate spanish story05_3_e3164e91:

    # Evrel "(But none of this will change anything.)"
    Evrel "(Pero nada de esto cambiará nada.)"

# game/Story04.rpy:2294

translate spanish story05_3_8118763b:

    # Evrel "(whisper) A choice without a choice… right?"
    Evrel "Una opción sin elección... ¿verdad?"

# game/Story04.rpy:2296

translate spanish story05_3_2afab3c0:

    # Evrel "You were incredible. I always felt safe behind your back."
    Evrel "Siempre me sentí segura detrás de tu espalda."

# game/Story04.rpy:2297

translate spanish story05_3_a9fca864:

    # Evrel "I was really, really lucky to have a big sister like you."
    Evrel "Tuve mucha suerte de tener una hermana grande como tú."

# game/Story04.rpy:2298

translate spanish story05_3_a810f3ca:

    # Evrel "In that sense… I guess I won the lottery at birth"
    Evrel "En ese sentido... supongo que gané la lotería al nacer."

# game/Story04.rpy:2301

translate spanish story05_3_15890d67:

    # Evrel "Still… it’s time to say goodbye."
    Evrel "Aún así... es hora de despedirse."

# game/Story04.rpy:2302

translate spanish story05_3_4aafbd81:

    # "Tears begin to well up in Astoria’s eyes."
    "Las lágrimas comienzan a acomodarse en los ojos de Astoria."

# game/Story04.rpy:2304

translate spanish story05_3_0e61cccb:

    # am "It’s cruel..."
    am "Es cruel..."

# game/Story04.rpy:2306

translate spanish story05_3_132e405d:

    # am "So cruel... unbearably cruel..."
    am "Tan cruel... insoportablemente cruel..."

# game/Story04.rpy:2308

translate spanish story05_3_d7a7cc38:

    # Evrel "(A compromise with fate, sis. A compromise with fate...)"
    Evrel "(Un compromiso con el destino, hermana. Un compromiso con el destino...)"

# game/Story04.rpy:2311

translate spanish story05_3_ca8dde94:

    # Evrel "One last smile, sis. I don’t want the last thing I see to be your sad face."
    Evrel "Una última sonrisa, hermana. No quiero la última cosa que veo para ser tu cara triste."

# game/Story04.rpy:2312

translate spanish story05_3_33f7d098:

    # Evrel "That’s better."
    Evrel "Eso es mejor."

# game/Story04.rpy:2313

translate spanish story05_3_58e40f2d:

    # Evrel "Take care of yourself."
    Evrel "Cuídate."

# game/Story04.rpy:2315

translate spanish story05_3_edbc6848:

    # a "Please, come with us, Lady Evrelia."
    a "Por favor, venga con nosotros, Lady Evrelia."

# game/Story04.rpy:2318

translate spanish story05_3_58afc374:

    # y "I don’t know much… but I heard they plan to cast her into the Abyss."
    y "No sé mucho... pero escuché que planean echarla al Abismo."

# game/Story04.rpy:2320

translate spanish story05_3_6f6017cc:

    # y "I’m not sure how different that is from death… but still."
    y "No estoy seguro de lo diferente que es de la muerte... pero aún así."

# game/Story04.rpy:2322

translate spanish story05_3_6adcab04:

    # y "How are you holding up?"
    y "¿Cómo estás?"

# game/Story04.rpy:2324

translate spanish story05_3_9f8a7455:

    # am "I… could you leave me alone?"
    am "¿Podrías dejarme en paz?"

# game/Story04.rpy:2326

translate spanish story05_3_71a86863_1:

    # y "..."
    y "..."

# game/Story04.rpy:2328

translate spanish story05_3_76844891:

    # am "Please."
    am "Por favor."

# game/Story04.rpy:2332

translate spanish story05_3_74d05bfd:

    # y "I’ll go keep an eye on the young lady."
    y "Voy a vigilar a la jovencita."

# game/Story04.rpy:2333

translate spanish story05_3_4ad97173:

    # am "Thank you."
    am "Gracias."

# game/Story04.rpy:2335

translate spanish story05_3_26e1620f:

    # am "(Sometimes we must make choices... and their consequences reshape our entire lives.)"
    am "(A veces debemos tomar decisiones... y sus consecuencias reforman toda nuestra vida.)"

# game/Story04.rpy:2336

translate spanish story05_3_cbec281a:

    # am "(A world for one life… so that’s what it truly means…)"
    am "(Un mundo para una vida... así que eso es lo que realmente significa...)"

# game/Story04.rpy:2338

translate spanish story05_3_8d8e48c5:

    # am "AAAAAAAAAAAAAAAAAAAAaaah...!"
    am "AAAAAAAAAAAAAAAAaah...!"

# game/Story04.rpy:2339

translate spanish story05_3_6fbb48f5:

    # "Regret and sorrow fused into one. A voice that had always remained restrained finally broke, torn apart by raw, unbearable pain."
    "El arrepentimiento y el dolor se fusionaron en uno. Una voz que siempre había permanecido restringida finalmente se rompió, desgarrada por el dolor crudo e insoportable."

# game/Story04.rpy:2365

translate spanish story05_4_3c109c55:

    # L "(What an idiot I am… Why, why can’t I just go to him and say it all as it is?)"
    L "(Qué idiota soy... ¿Por qué, por qué no puedo ir a él y decir todo como es?)"

# game/Story04.rpy:2367

translate spanish story05_4_7b1caaa5:

    # L "(No lies. No pretending. Just tell him everything. What happened. What I did.)"
    L "No mientas, no finjas, solo dile todo lo que pasó."

# game/Story04.rpy:2368

translate spanish story05_4_8d4ef61d:

    # L "(Just...)"
    L "(Solo...)"

# game/Story04.rpy:2370

translate spanish story05_4_77f212f0:

    # L "(whispering) God… I really am a fool..."
    L "Dios... realmente soy un tonto..."

# game/Story04.rpy:2371

translate spanish story05_4_65cabcbf:

    # v "..."
    v "..."

# game/Story04.rpy:2374

translate spanish story05_4_d9d98dab:

    # L "(When did everything go wrong? When I started the research? Or when I got involved with Li?)"
    L "(¿Cuándo salió todo mal? ¿Cuándo empecé la investigación? ¿O cuando me involucré con Li?)"

# game/Story04.rpy:2375

translate spanish story05_4_e445f39e:

    # L "(And was there ever a way out of this? I don’t know...)"
    L "(¿Y alguna vez había una salida de esto? No sé...)"

# game/Story04.rpy:2377

translate spanish story05_4_89a262fd:

    # L "Tell me... what would you do if one day you found out that the person you love..."
    L "Dime... ¿qué harías si un día descubrieras que la persona que amas..."

# game/Story04.rpy:2378

translate spanish story05_4_168522fd:

    # L "Someone you thought you knew your whole life..."
    L "Alguien que creías que conocías toda tu vida..."

# game/Story04.rpy:2379

translate spanish story05_4_5bbfbb7d:

    # L "Had been lying to you?"
    L "¿Te había estado mintiendo?"

# game/Story04.rpy:2381

translate spanish story05_4_3dcff64c:

    # v "Are you talking about yourself?"
    v "¿Estás hablando de ti mismo?"

# game/Story04.rpy:2383

translate spanish story05_4_cb923f3c:

    # L "Just answer the question."
    L "Solo responde a la pregunta."

# game/Story04.rpy:2385

translate spanish story05_4_fc9e3154:

    # v "That depends on the circumstances."
    v "Eso depende de las circunstancias."

# game/Story04.rpy:2386

translate spanish story05_4_22d518e9:

    # v "If the intentions were good - acceptable."
    v "Si las intenciones eran buenas, aceptables."

# game/Story04.rpy:2387

translate spanish story05_4_dbae0734:

    # v "If not… that’s a different matter."
    v "Si no... eso es un asunto diferente."

# game/Story04.rpy:2389

translate spanish story05_4_809f3b35:

    # L "Everything is poison, everything is medicine. It’s all about the dose… isn’t it."
    L "Todo es veneno, todo es medicina. Todo es sobre la dosis... no es así."

# game/Story04.rpy:2392

translate spanish story05_4_25306d27:

    # v "Something like that."
    v "Algo así."

# game/Story04.rpy:2395

translate spanish story05_4_ae36c3c2:

    # L "Then… can I tell him the truth? He’s suffered enough already. At least he deserves to know why-"
    L "Entonces... ¿puedo decirle la verdad? Ya ha sufrido bastante. Al menos se merece saber por qué..."

# game/Story04.rpy:2399

translate spanish story05_4_3bb6a523:

    # v "Out of the question. The less he knows, the better it is, for all of us."
    v "Cuanto menos sepa, mejor será para todos."

# game/Story04.rpy:2401

translate spanish story05_4_74b42149:

    # L "(“Better”? You’re just afraid that if he learns the truth, you’ll have to kill him. And you can’t do that.)"
    L "(“Mejor”? Solo tienes miedo de que si él aprende la verdad, tendrás que matarlo. Y no puedes hacer eso.)"

# game/Story04.rpy:2402

translate spanish story05_4_dd6b474d:

    # L "(Though it’s almost funny… He went to the edge of the galaxy for me.)"
    L "(Aunque es casi gracioso... Él fue al borde de la galaxia para mí.)"

# game/Story04.rpy:2405

translate spanish story05_4_42535635:

    # L "(And in return… what do I give him? Lies? Pain? Ignorance… and a broken heart?)"
    L "(Y a cambio... ¿qué le doy? ¿Mentiras? Dolorancia... y un corazón roto?)"

# game/Story04.rpy:2406

translate spanish story05_4_64ab554d:

    # L "(What a reward. Well done. Wife of the year... no, of the decade…)"
    L "(Qué recompensa. Bien hecho. Esposa del año... no, de la década...)"

# game/Story04.rpy:2409

translate spanish story05_4_9993b94e:

    # L "..."
    L "..."

# game/Story04.rpy:2410

translate spanish story05_4_59b6df58:

    # L "(So, Lora, what are you going to do? Keep running away… or finally tell him what really happened?)"
    L "(Lora, ¿qué vas a hacer? ¿Sigue huyendo o finalmente le dices lo que realmente pasó?)"

# game/Story04.rpy:2411

translate spanish story05_4_9993b94e_1:

    # L "..."
    L "..."

# game/Story04.rpy:2413

translate spanish story05_4_48825996:

    # L "You have the helm. I… need to step away for a moment."
    L "Tienes el timón, necesito alejarme un momento."

# game/Story04.rpy:2415

translate spanish story05_4_563f2bc4:

    # v "The Lady won’t approve."
    v "La Señora no aprobará."

# game/Story04.rpy:2417

translate spanish story05_4_a0bbb727:

    # L "I’ll deal with her later."
    L "Me encargaré de ella más tarde."

# game/Story04.rpy:2418

translate spanish story05_4_dd37c320:

    # v "(You will regret this.)"
    v "(Te arrepentirás de esto.)"

# game/Story04.rpy:2425

translate spanish story05_4_de932652:

    # L "(whisper) I’m sorry, my love… I did all this to protect you."
    L "Lo siento, mi amor... hice todo esto para protegerte."

# game/Story04.rpy:2428

translate spanish story05_4_51666017:

    # L "(Will he believe me? I’ve lied for so long… and he, he saw it, but chose to accept it.)"
    L "(¿Me creerá? He mentido durante tanto tiempo... y él, lo vio, pero decidió aceptarlo.)"

# game/Story04.rpy:2429

translate spanish story05_4_0f1356f1:

    # L "(But what if the truth changes everything? What if he doesn’t believe me at all?)"
    L "(Pero ¿y si la verdad cambia todo? ¿Y si no me cree en absoluto?)"

# game/Story04.rpy:2432

translate spanish story05_4_3faf3b14:

    # L "(What if, after I tell him everything, he thinks it’s just another lie?)"
    L "(¿Y si, después de contarle todo, él piensa que es solo otra mentira?)"

# game/Story04.rpy:2433

translate spanish story05_4_416fbd70:

    # L "(Then it’s over. After all this… trust would be almost impossible to restore.)"
    L "(Entonces se acabó. Después de todo esto... la confianza sería casi imposible de restaurar.)"

# game/Story04.rpy:2436

translate spanish story05_4_01fd664b:

    # L "(Maybe… maybe it’s not too late to leave everything as it is?)"
    L "(Quizás... ¿quizás no es demasiado tarde para dejar todo como es?)"

# game/Story04.rpy:2438

translate spanish story05_4_9993b94e_2:

    # L "..."
    L "..."

# game/Story04.rpy:2441

translate spanish story05_4_6a5f03d8:

    # L "(Sighs) May I come in?"
    L "¿Puedo entrar?"

# game/Story04.rpy:2445

translate spanish story05_4_831ed014:

    # h "Lora? What are you doing here?"
    h "¿Qué haces aquí?"

# game/Story04.rpy:2446

translate spanish story05_4_2b35b6fe:

    # mc "..."
    mc "..."

# game/Story04.rpy:2447

translate spanish story05_4_e6024885:

    # mc "(So the main heroine finally shows up… Guess it’s time to settle everything here and now.)"
    mc "(Así que la heroína principal finalmente aparece... Supongo que es hora de arreglar todo aquí y ahora.)"

# game/Story04.rpy:2448

translate spanish story05_4_bbc0a062:

    # L "I-"
    L "Yo..."

# game/Story04.rpy:2450

translate spanish story05_4_0bf2c0fb:

    # mc "Lora? We need to talk."
    mc "Tenemos que hablar."

# game/Story04.rpy:2452

translate spanish story05_4_d2eeed15:

    # L "(That look… He’s serious. There’s no point in running, is there? Right…)"
    L "(Ese look... Él es serio. No hay punto en correr, ¿verdad?"

# game/Story04.rpy:2454

translate spanish story05_4_9ccf733b:

    # L "Alright. But before that… I need to ask you for one thing."
    L "Pero antes de eso... necesito pedirte una cosa."

# game/Story04.rpy:2455

translate spanish story05_4_8cc5451c:

    # L "No matter what happens after this, promise me you’ll do exactly what I say. Okay?"
    L "No importa lo que pase después de esto, prométeme que harás exactamente lo que te diga. ¿De acuerdo?"

# game/Story04.rpy:2457

translate spanish story05_4_b86e1dee:

    # mc "I have to hear-"
    mc "Tengo que escuchar..."

# game/Story04.rpy:2458

translate spanish story05_4_ed2a5aac:

    # L "[mc]! Please… Just this. I’m begging you…"
    L "[mc]Por favor... solo esto. Te lo ruego..."

# game/Story04.rpy:2461

translate spanish story05_4_022037a2:

    # mc "(And what do I do? Agree? Like I even have a choice…)"
    mc "(¿Y qué hago? ¿De acuerdo? Como si tuviera una opción...)"

# game/Story04.rpy:2462

translate spanish story05_4_c89045fb:

    # mc "(On the other hand, what do I lose? She’s your wife, after all… or trying to be.)"
    mc "(Por otro lado, ¿qué pierdo? Ella es tu esposa, después de todo... o tratando de ser.)"

# game/Story04.rpy:2464

translate spanish story05_4_e8b52a56:

    # mc "I’ve already given you enough chances."
    mc "Ya te he dado suficientes oportunidades."

# game/Story04.rpy:2465

translate spanish story05_4_f9ec880e:

    # mc "Sorry. I really am trying… but I can’t."
    mc "Lo siento. Realmente lo intento... pero no puedo."

# game/Story04.rpy:2467

translate spanish story05_4_bbc0a062_1:

    # L "I-"
    L "Yo..."

# game/Story04.rpy:2468

translate spanish story05_4_0a3b7915:

    # L "(It hurts… my chest feels tight, like it’s being crushed. But I should have expected this.)"
    L "(Me duele... mi pecho se siente apretado, como si estuviera siendo aplastado. Pero debería haber esperado esto.)"

# game/Story04.rpy:2470

translate spanish story05_4_9d9f0392:

    # L "Yes. I understand."
    L "Sí, lo entiendo."

# game/Story04.rpy:2472

translate spanish story05_4_2dd7ac95:

    # L "(Sighs) Alright then. I’ll tell you everything exactly as it is."
    L "(Suspira) Muy bien entonces. Te diré todo exactamente como es."

# game/Story04.rpy:2473

translate spanish story05_4_609aefeb:

    # L "No secrets. No lies. The truth. And only the truth."
    L "Sin secretos, sin mentiras, la verdad y solo la verdad."

# game/Story04.rpy:2475

translate spanish story05_4_2b35b6fe_1:

    # mc "..."
    mc "..."

# game/Story04.rpy:2476

translate spanish story05_4_130151fb:

    # L "No one knows if we’ll survive. If we’ll even be able to complete this mission…"
    L "Nadie sabe si sobreviviremos. Si vamos a ser capaces de completar esta misión..."

# game/Story04.rpy:2477

translate spanish story05_4_f03658c6:

    # L "I thought about it for a long time. Weighed every possible outcome."
    L "Lo pensé durante mucho tiempo, y cuestioné todos los resultados posibles."

# game/Story04.rpy:2478

translate spanish story05_4_bf6869f0:

    # mc "(She’s scared, voice shaking, eyes darting everywhere. Part of me wants to pull her close… but the other part-)"
    mc "(Ella tiene miedo, timbre de voz, ojos atrevidos por todas partes. Parte de mí quiere acercarse... pero la otra parte-)"

# game/Story04.rpy:2480

translate spanish story05_4_d548d924:

    # h "Yeah, alright, I’ll just-"
    h "Sí, está bien, yo solo..."

# game/Story04.rpy:2482

translate spanish story05_4_57c44f0f:

    # L "No. You all need to hear this. Every single one of you."
    L "No, todos tienen que escuchar esto, cada uno de ustedes."

# game/Story04.rpy:2484

translate spanish story05_4_f5b849b2:

    # mc "Even Miriel and Kalestra?"
    mc "¿Incluso Miriel y Kalestra?"

# game/Story04.rpy:2485

translate spanish story05_4_9993b94e_3:

    # L "..."
    L "..."

# game/Story04.rpy:2486

translate spanish story05_4_61a9dceb:

    # L "They will be the guarantee of your survival."
    L "Serán la garantía de su supervivencia."

# game/Story04.rpy:2488

translate spanish story05_4_6c807545:

    # mc "A guarantee for survival? Fine."
    mc "¿Una garantía para la supervivencia?"

# game/Story04.rpy:2490

translate spanish story05_4_d61fd2df:

    # L "(Sighs) Well… it’s time."
    L "Bueno... es el momento."

# game/Story04.rpy:2494

translate spanish story05_4_15d25cf8:

    # "13 years before the key events. Or 4 years by Earth standards."
    "13 años antes de los acontecimientos clave. O 4 años por los estándares de la Tierra."

# game/Story04.rpy:2499

translate spanish story05_4_423a89f1:

    # L "{b}humming softly{/b}"
    L "{b}tonificando suavemente{/b}"

# game/Story04.rpy:2500

translate spanish story05_4_e7e7ec51:

    # L "(What should I make for dinner today? Curry? No, [mc] hates it. Maybe baked chicken?)"
    L "¿Qué debo hacer para cenar hoy? [mc] ¿Quizás el pollo al horno?)"

# game/Story04.rpy:2501

translate spanish story05_4_2de2e6b6:

    # L "(No, that won’t work. Norman won’t eat that… Hmm. Cutlets? Yes! That’s perfect!)"
    L "(No, eso no funcionará. Norman no comerá eso... Hmm. ¿Cortlets? ¡Sí! Eso es perfecto!)"

# game/Story04.rpy:2503

translate spanish story05_4_e5a64b31:

    # L "(whispering) The best cutlets in the whole world… yay…"
    L "Los mejores cubos del mundo entero..."

# game/Story04.rpy:2505

translate spanish story05_4_472d7514:

    # a "Dr. Lora? You seem to be in a great mood today. Something nice happen?"
    a "Parece que hoy estás de buen humor. ¿Sucede algo agradable?"

# game/Story04.rpy:2507

translate spanish story05_4_9f764cb9:

    # L "We’re having a family dinner today!"
    L "¡Hoy vamos a cenar en familia!"

# game/Story04.rpy:2509

translate spanish story05_4_50bbaf8d:

    # L "Well, just like yesterday… but today is even more special than yesterday!"
    L "Bueno, como ayer... ¡pero hoy es más especial que ayer!"

# game/Story04.rpy:2511

translate spanish story05_4_511ea4ec:

    # a "Really? Glad to hear that. Please, go ahead, and have a lovely family dinner, Dr. Lora."
    a "Por favor, adelante, y cena con una familia encantadora, Dr. Lora."

# game/Story04.rpy:2513

translate spanish story05_4_38667339:

    # L "Oh, yes, yes. And tell your wife thank you for the recipe, it was absolutely wonderful."
    L "Y dile a tu esposa que te agradezca por la receta, fue maravilloso."

# game/Story04.rpy:2514

translate spanish story05_4_c5cf4c42:

    # a "I will."
    a "Lo haré."

# game/Story04.rpy:2515

translate spanish story05_4_b3cff24d:

    # a "And give my regards to your son. He’s always welcome here."
    a "Y saluda a tu hijo. Siempre es bienvenido aquí."

# game/Story04.rpy:2516

translate spanish story05_4_17fe3ba6:

    # L "Take care Jason."
    L "Cuídate a Jason."

# game/Story04.rpy:2520

translate spanish story05_4_1c4b9f55:

    # L "(That day felt just as ordinary as any other. At first, nothing hinted at what was coming.)"
    L "(Ese día se sentía tan ordinario como cualquier otro. Al principio, nada insinuó en lo que venía.)"

# game/Story04.rpy:2521

translate spanish story05_4_99e1ec03:

    # L "(But that was the day we were assigned to a new site, code-named “Ark.”)"
    L "(Pero ese fue el día que nos asignaron a un nuevo sitio, llamado código \"Ark\".)"

# game/Story04.rpy:2522

translate spanish story05_4_a538e2f7:

    # L "(The place where the warp-drive was taken from.)"
    L "(El lugar donde se tomó el carril de warp.)"

# game/Story04.rpy:2525

translate spanish story05_4_4a83555d:

    # L "(For the record, I’m talking about this thing right here.)"
    L "(Para que conste, estoy hablando de esta cosa aquí.)"

# game/Story04.rpy:2526

translate spanish story05_4_8b27c14f:

    # L "(I knew his origin wasn’t entirely… earthly. I just never imagined it was this far from it.)"
    L "(Sabía que su origen no era completamente... terrenal. Yo nunca imaginé que estaba tan lejos de él.)"

# game/Story04.rpy:2528

translate spanish story05_4_9d178b6b:

    # L "With all due respect, Doctor Li, I can’t. I have a family dinner tonight. I need to be there."
    L "Con todo respeto, Doctor Li, no puedo. Tengo una cena familiar esta noche. Necesito estar allí."

# game/Story04.rpy:2530

translate spanish story05_4_6501bdac:

    # R "Dr. Lora, without you this entire expedition is going to fall apart."
    R "Dr. Lora, sin usted toda esta expedición se va a desmoronar."

# game/Story04.rpy:2531

translate spanish story05_4_db9c2ba3:

    # R "And as unpleasant as it may sound, you’re the key figure here."
    R "Y tan desagradable como puede sonar, usted es la figura clave aquí."

# game/Story04.rpy:2533

translate spanish story05_4_241d0b6d:

    # L "Oh, really? Well, thank you for the compliment. It’s nice to know I’m valued so highly, but still… I can’t."
    L "¿En serio? Bueno, gracias por el cumplido. Es bueno saber que soy valorado tan alto, pero aún así... no puedo."

# game/Story04.rpy:2534

translate spanish story05_4_d8779c81:

    # L "My husband and I talked about this side of my work. We both decided to spend more time together."
    L "Mi esposo y yo hablamos de este lado de mi trabajo, ambos decidimos pasar más tiempo juntos."

# game/Story04.rpy:2536

translate spanish story05_4_44eae256:

    # R "You don’t need to worry. It won’t take much of your time."
    R "No necesitas preocuparte. No te tomará mucho tiempo."

# game/Story04.rpy:2537

translate spanish story05_4_61e09e07:

    # R "After that, we’ll take you straight home. Deal?"
    R "Después de eso, te llevaremos a casa. ¿Trato?"

# game/Story04.rpy:2539

translate spanish story05_4_cc012f42:

    # L "I… I need to make a call."
    L "Necesito hacer una llamada."

# game/Story04.rpy:2542

translate spanish story05_4_81dd9707:

    # mc "And how long is this going to take?"
    mc "¿Y cuánto tiempo va a tardar?"

# game/Story04.rpy:2544

translate spanish story05_4_44ac9c84:

    # L "I don’t know. They say I should be home by evening."
    L "Dicen que debería estar en casa por la noche."

# game/Story04.rpy:2546

translate spanish story05_4_d534f3d0:

    # mc "Lora, we’ve been through this before."
    mc "Lora, hemos pasado por esto antes."

# game/Story04.rpy:2547

translate spanish story05_4_291db75f:

    # L "I know, love. I know. That’s why I’m asking you… What do you think?"
    L "Lo sé, amor. Lo sé. Por eso te pregunto... ¿Qué piensas?"

# game/Story04.rpy:2549

translate spanish story05_4_126af4cd:

    # mc "(sigh) Just this once, alright? If you’re late, Norman and I will eat everything and leave you nothing."
    mc "(Suspira) Solo esta vez, ¿de acuerdo? Si llegas tarde, Norman y yo comeremos todo y no te dejo nada."

# game/Story04.rpy:2551

translate spanish story05_4_2388cfa4:

    # L "Hey! That’s not what we agreed on!"
    L "¡Eh! ¡Eso no fue lo que acordamos!"

# game/Story04.rpy:2553

translate spanish story05_4_36f1e18c:

    # mc "Yeah, yeah, I’ll listen to all your complaints later… Take care."
    mc "Sí, sí, escucharé todas tus quejas más tarde... cuídate."

# game/Story04.rpy:2555

translate spanish story05_4_91422991:

    # L "I love you. Kisses for both of you!"
    L "Te amo. ¡Besos para los dos!"

# game/Story04.rpy:2560

translate spanish story05_4_f5ba6f48:

    # R "Ready?"
    R "¿Listo?"

# game/Story04.rpy:2561

translate spanish story05_4_109280b3:

    # L "Yes."
    L "Sí."

# game/Story04.rpy:2562

translate spanish story05_4_78430511:

    # L "(The moment that turned our entire lives upside down.)"
    L "(El momento en que volteó nuestras vidas enteras hacia abajo.)"

# game/Story04.rpy:2566

translate spanish story05_4_91e1caf8:

    # L "(The Ark. An alien vessel designed to transport a relocation mechanism. In simple terms, a gate.)"
    L "(El Arca. Un buque alienígena diseñado para transportar un mecanismo de reubicación. En términos simples, una puerta.)"

# game/Story04.rpy:2567

translate spanish story05_4_e3c02a50:

    # L "(One important clarification: a portal and a gate are not the same thing.)"
    L "(Una aclaración importante: un portal y una puerta no son lo mismo.)"

# game/Story04.rpy:2568

translate spanish story05_4_c8be6e46:

    # L "(Same principle, different origin. A portal is a natural phenomenon. A gate is artificial.)"
    L "(Principio de Sismo, origen diferente. Un portal es un fenómeno natural. Una puerta es artificial.)"

# game/Story04.rpy:2569

translate spanish story05_4_cf29779d:

    # L "(The truth is… we learned that much, much later.)"
    L "(La verdad es que... aprendimos mucho, mucho más tarde.)"

# game/Story04.rpy:2572

translate spanish story05_4_85594dc2:

    # L "What… what is this?"
    L "¿Qué... qué es esto?"

# game/Story04.rpy:2574

translate spanish story05_4_51e0888d:

    # R "A spacecraft."
    R "Una nave espacial."

# game/Story04.rpy:2575

translate spanish story05_4_1926fb06:

    # R "How it ended up here,we don’t know."
    R "Cómo terminó aquí, no lo sabemos."

# game/Story04.rpy:2576

translate spanish story05_4_25c61355:

    # R "But that’s where the samples for the portal came from. Or so I was told."
    R "Pero ahí es donde vinieron las muestras del portal. O así me dijeron."

# game/Story04.rpy:2578

translate spanish story05_4_bbdf7a11:

    # L "That’s it?! I thought… I thought it was just a marketing name or something…"
    L "¡Eso es todo?! Pensé... pensé que era solo un nombre de marketing o algo así..."

# game/Story04.rpy:2579

translate spanish story05_4_19e14b97:

    # L "(whispering) An actual alien ship… Someone pinch me."
    L "Un barco alienígena... alguien me pellizca."

# game/Story04.rpy:2580

translate spanish story05_4_61b65785:

    # L "Wait, and you expect us to go inside? Don’t you think that’s a little… reckless?"
    L "Espera, ¿y esperas que entremos? ¿No crees que sea un poco... imprudente?"

# game/Story04.rpy:2582

translate spanish story05_4_322f2620:

    # R "I agree. Completely."
    R "Estoy de acuerdo, completamente."

# game/Story04.rpy:2583

translate spanish story05_4_dafd43c1:

    # R "To be honest, I know no more than you do."
    R "Para ser honesto, no sé más que tú."

# game/Story04.rpy:2584

translate spanish story05_4_a4728b03:

    # L "Wait, what? Then how-"
    L "Espera, ¿qué?"

# game/Story04.rpy:2586

translate spanish story05_4_f2928398:

    # aa "There’s no need to worry. We’ll explain everything, on one condition."
    aa "No hay necesidad de preocuparse. Explicaremos todo, con una condición."

# game/Story04.rpy:2587

translate spanish story05_4_1b69d2cd:

    # aa "You cooperate."
    aa "Coopera."

# game/Story04.rpy:2588

translate spanish story05_4_d807b914:

    # R "And what happens if we refuse?"
    R "¿Y qué pasa si nos negamos?"

# game/Story04.rpy:2589

translate spanish story05_4_24dc6d40:

    # aa "We’d really hate for something… unfortunate to happen to you."
    aa "Realmente odiaríamos por algo... desafortunado de pasarte."

# game/Story04.rpy:2591

translate spanish story05_4_2742c993:

    # L "(Everything we knew was kept under strict confidentiality. We were forced to sign stacks of non-disclosure agreements.)"
    L "(Todo lo que conocíamos se mantuvo bajo estricta confidencialidad. Nos vimos obligados a firmar montones de acuerdos de no divulgación.)"

# game/Story04.rpy:2593

translate spanish story05_4_ac3d6b6e:

    # L "(Though, to be fair, those papers weren’t exactly the real guarantee.)"
    L "(Aunque, para ser justos, esos papeles no eran exactamente la garantía real.)"

# game/Story04.rpy:2594

translate spanish story05_4_d8b0a4e1:

    # L "(The real guarantee were the guns pressed against our heads.)"
    L "(La garantía real fueron las armas presionadas contra nuestras cabezas.)"

# game/Story04.rpy:2596

translate spanish story05_4_cede01e6:

    # mc "So that’s when you started calling only from your phone..."
    mc "Así que es cuando empezó a llamar solo desde su teléfono..."

# game/Story04.rpy:2598

translate spanish story05_4_a684dd3f:

    # L "I remember how angry that made you. But I didn’t have a choice. Honestly, convincing them to even allow phone calls was already a small victory."
    L "Recuerdo lo enojada que te hizo. Pero no tuve elección. Honestamente, convencerlos para que incluso permitir llamadas telefónicas ya era una pequeña victoria."

# game/Story04.rpy:2600

translate spanish story05_4_58a981cb:

    # mc "If you’d refused, none of this might’ve happened."
    mc "Si te hubieras negado, nada de esto podría haber pasado."

# game/Story04.rpy:2602

translate spanish story05_4_ab1f8b4d:

    # L "I- yes. You’re right. Maybe I should’ve refused. Maybe I should have walked away..."
    L "Yo- sí. Tienes razón. Tal vez debería haber rechazado. Tal vez debería haberme marchado..."

# game/Story04.rpy:2603

translate spanish story05_4_cf422a1e:

    # L "But I couldn’t."
    L "Pero no pude."

# game/Story04.rpy:2605

translate spanish story05_4_afb74cd0:

    # h "Don’t push her. You know how much all that science crap means to her. She didn’t even realize it would turn out like this."
    h "No la empujes. Sabes lo mucho que significa toda esa basura de ciencia para ella. Ella ni siquiera se dio cuenta de que resultaría así."

# game/Story04.rpy:2608

translate spanish story05_4_ee163efc:

    # mc "Oh, so now you’re on her side?"
    mc "¿Así que ahora estás de su lado?"

# game/Story04.rpy:2611

translate spanish story05_4_c0faa04d:

    # h "You’re both just as important to me. And watching you tear into each other? Not exactly my idea of a good time."
    h "Ustedes son tan importantes para mí. ¿Y viendo cómo se desgarran? No es exactamente mi idea de un buen momento."

# game/Story04.rpy:2612

translate spanish story05_4_515ac98c:

    # h "And come on. Don’t forget, we’ve been in her shoes before. If anyone should get how she feels, it’s you."
    h "Y vamos. No olvides que hemos estado en sus zapatos antes. Si alguien debería conseguir lo que siente, eres tú."

# game/Story04.rpy:2614

translate spanish story05_4_84476e8b:

    # mc "(If she had told us all this from the start, I wouldn’t have said a word. But now? Now it’s a different story entirely.)"
    mc "(Si ella nos hubiera contado todo esto desde el principio, no habría dicho una palabra. Pero ahora? Ahora es una historia diferente por completo.)"

# game/Story04.rpy:2615

translate spanish story05_4_e9c75761:

    # h "(Oh, great. So now he’s playing the victim? Wow, impressive-)"
    h "(Oh, genial. ¿Así que ahora está jugando a la víctima?"

# game/Story04.rpy:2616

translate spanish story05_4_b8f81952:

    # mc "Olivia."
    mc "Olivia."

# game/Story04.rpy:2617

translate spanish story05_4_10bec45e:

    # mc "(Stop drilling holes in me with your eyes.)"
    mc "(Deja de perforar agujeros en mí con tus ojos.)"

# game/Story04.rpy:2619

translate spanish story05_4_6e5a6696:

    # h "What, [mc]?"
    h "¿Qué? [mc]?"

# game/Story04.rpy:2621

translate spanish story05_4_623538d7:

    # mc "(No. Get a grip.)"
    mc "(No. Consigue un agarre.)"

# game/Story04.rpy:2623

translate spanish story05_4_b92c7d68:

    # mc "(sign) Let’s just continue, alright?"
    mc "(sign) Vamos a continuar, ¿de acuerdo?"

# game/Story04.rpy:2627

translate spanish story05_4_e1f684b7:

    # L "(We spent some time aboard that ship. A month? Maybe a little less.)"
    L "(Pasamos un tiempo a bordo de esa nave. ¿Un mes? Tal vez un poco menos.)"

# game/Story04.rpy:2628

translate spanish story05_4_b6485116:

    # L "(At some point, I started keeping a journal, just to keep myself sane.)"
    L "(En algún momento, empecé a tener un diario, solo para mantenerme sano.)"

# game/Story04.rpy:2630

translate spanish story05_4_b083419e:

    # L "(At first, everything seemed… manageable. We were assigned to study the gates. To understand their purpose. To figure out how to activate them.)"
    L "(Al principio, todo parecía manejable, nos asignaron a estudiar las puertas, a comprender su propósito, a saber cómo activarlas.)"

# game/Story04.rpy:2634

translate spanish story05_4_489d405d:

    # L "(Hour after hour. Day after day. Everything only got worse.)"
    L "(Cuatro después de hora. Día tras día. Todo solo empeoró.)"

# game/Story04.rpy:2635

translate spanish story05_4_5a4d5a8f:

    # L "(We didn’t know how to open them. And we weren’t even sure they really were gates at all.)"
    L "(No sabíamos cómo abrirlos. Y ni siquiera estábamos seguros de que eran puertas en absoluto.)"

# game/Story04.rpy:2637

translate spanish story05_4_cccea87e:

    # L "(Those who broke faster… they were simply taken away.)"
    L "(Los que se rompieron más rápido... simplemente fueron llevados.)"

# game/Story04.rpy:2638

translate spanish story05_4_ff7af11b:

    # L "(Where to - no one ever told us.)"
    L "(A dónde - nadie nos lo dijo nunca.)"

# game/Story04.rpy:2640

translate spanish story05_4_a0b40540:

    # mc "(Those zombies… they’ve got to be connected to this somehow.)"
    mc "(Esos zombies... tienen que estar conectados a esto de alguna manera.)"

# game/Story04.rpy:2646

translate spanish story05_4_2e29b790:

    # h "So… how did you end up here?"
    h "Entonces... ¿cómo terminaste aquí?"

# game/Story04.rpy:2648

translate spanish story05_4_0d5bf6b3:

    # mc "(So that recorder really was hers…)"
    mc "(Así que esa grabadora era realmente suya...)"

# game/Story04.rpy:2649

translate spanish story05_4_8e1b5ad4:

    # mc "They found the source. The filthiest one imaginable, but they found it."
    mc "Encontraron la fuente, la más infiel imaginable, pero la encontraron."

# game/Story04.rpy:2650

translate spanish story05_4_95bf3694:

    # h "(His voice… is he shaking?)"
    h "(Su voz... ¿Se está sacudiendo?)"

# game/Story04.rpy:2652

translate spanish story05_4_88594c53:

    # h "That bad?"
    h "¿Tan malo?"

# game/Story04.rpy:2653

translate spanish story05_4_1d4a85ce:

    # h "(Alright, this is getting way too tense. Time to crack a joke.)"
    h "(De acuerdo, esto está siendo demasiado tenso."

# game/Story04.rpy:2655

translate spanish story05_4_919d52ea:

    # h "Why do the Ninja Turtles always attack in a group of four?"
    h "¿Por qué los Tortugas Ninja siempre atacan en un grupo de cuatro?"

# game/Story04.rpy:2656

translate spanish story05_4_dcbc61fb:

    # h "Because their teacher is a rat!"
    h "¡Porque su maestro es una rata!"

# game/Story04.rpy:2658

translate spanish story05_4_198a862c:

    # k "Heh. Not bad."
    k "No está mal."

# game/Story04.rpy:2659

translate spanish story05_4_93145fff:

    # h "(Yeah… not the reaction I was hoping for.)"
    h "(Sí... no la reacción que esperaba.)"

# game/Story04.rpy:2661

translate spanish story05_4_44249e80:

    # h "So what’s this mysterious ‘source’ everyone’s freaking out about?"
    h "¿Qué es este misterioso “fuente” de lo que todos están flipando?"

# game/Story04.rpy:2663

translate spanish story05_4_e049529d:

    # Mi "About something no living being can survive without. Blood."
    Mi "Sobre algo que no puede sobrevivir sin ser vivo."

# game/Story04.rpy:2664

translate spanish story05_4_2fded262:

    # h "..."
    h "..."

# game/Story04.rpy:2666

translate spanish story05_4_ff932e82:

    # h "What?"
    h "¿Qué?"

# game/Story04.rpy:2667

translate spanish story05_4_1ca70b3e:

    # mc "(It still disgusts me. Why? How? Who even had the genius idea to use blood as an energy source?)"
    mc "(Aún me disgusta. ¿Por qué? ¿Quién tenía la idea genial de usar la sangre como fuente de energía?)"

# game/Story04.rpy:2669

translate spanish story05_4_58ae8c8a:

    # mc "Disgusting, isn’t it?"
    mc "Es repugnante, ¿no?"

# game/Story04.rpy:2671

translate spanish story05_4_1ae0de7c:

    # h "That’s… yeah. Wow."
    h "Eso es... sí."

# game/Story04.rpy:2672

translate spanish story05_4_1589c336:

    # h "Wait. Is that why there’s a bloodbath in the streets right now?"
    h "Espera. ¿Por eso hay un baño de sangre en las calles ahora mismo?"

# game/Story04.rpy:2673

translate spanish story05_4_5972a5f7:

    # mc "Yes. They need the energy."
    mc "Sí, necesitan energía."

# game/Story04.rpy:2674

translate spanish story05_4_294be3a9:

    # h "For what?"
    h "¿Para qué?"

# game/Story04.rpy:2676

translate spanish story05_4_0c446907:

    # mc "I don’t know… But that’s not the point right now."
    mc "No lo sé... pero ese no es el punto en este momento."

# game/Story04.rpy:2677

translate spanish story05_4_0a5f750a:

    # mc "So what happened next? I get how you ended up here, more or less."
    mc "¿Qué pasó después?"

# game/Story04.rpy:2679

translate spanish story05_4_2360bb55:

    # mc "Astoria and Ember opened the gate and led the survivors in."
    mc "Astoria y Ember abrieron la puerta y llevaron a los sobrevivientes."

# game/Story04.rpy:2680

translate spanish story05_4_d37dd2ff:

    # mc "What interests me is the reason. How?"
    mc "Lo que me interesa es la razón. ¿Cómo?"

# game/Story04.rpy:2685

translate spanish story05_4_f17f3fcf:

    # L "(The reason? Should I really say it as it was, or-)"
    L "¿Debo decirlo como era o...?"

# game/Story04.rpy:2686

translate spanish story05_4_15ac6682:

    # L "It wasn’t exactly like that. The gates… didn’t open the way they were supposed to."
    L "No era exactamente así. Las puertas... no abrieron la forma en que se suponía que debían."

# game/Story04.rpy:2688

translate spanish story05_4_2db4ea4f:

    # L "(No, Lora. Say it. All of it. They need to know. He needs to know.)"
    L "(No, Lora. Dilo. Todo. Necesitan saberlo. Él necesita saberlo.)"

# game/Story04.rpy:2689

translate spanish story05_4_023aac97:

    # L "They pulled me somewhere else entirely."
    L "Me sacaron de otro lugar por completo."

# game/Story04.rpy:2692

translate spanish story05_4_a5c6c2d9:

    # L "The Abyss."
    L "El Abyss."

# game/Story04.rpy:2696

translate spanish story05_4_1c9d1f32:

    # mc "(Wait, what?)"
    mc "(Espera, ¿qué?)"

# game/Story04.rpy:2697

translate spanish story05_4_e162e18e:

    # mc "So you were in the Abyss? But how?"
    mc "¿Entonces estabas en el Abyss?"

# game/Story04.rpy:2699

translate spanish story05_4_ef6f51c6:

    # Mi "It’s…"
    Mi "Es..."

# game/Story04.rpy:2700

translate spanish story05_4_dc563231:

    # k "(whistling) Well damn… now that’s a revelation."
    k "Bien, maldita sea... ahora eso es una revelación."

# game/Story04.rpy:2703

translate spanish story05_4_fb12c97d:

    # h "Hey, hey, hold on. Can someone explain to me where that reaction even came from?"
    h "Oye, espera. ¿Puede alguien explicarme de dónde vino esa reacción?"

# game/Story04.rpy:2705

translate spanish story05_4_6d45d90f:

    # k "You ruined the whole mood. Absolutely butchered the scene."
    k "Arruinaste todo el estado de ánimo, y por supuesto acariciaste la escena."

# game/Story04.rpy:2707

translate spanish story05_4_d468f118:

    # h "Then maybe enlighten me, what kind of abyss is this supposed to be? So I’m not completely out of the loop."
    h "Entonces, quizás ilumíneme, ¿qué clase de abismo se supone que es esto? Así que no estoy completamente fuera del bucle."

# game/Story04.rpy:2709

translate spanish story05_4_be919a93:

    # k "No light, no darkness. Just the Abyss, lurking in the shadows. No time to run. No sound to scream."
    k "No hay luz, ni oscuridad, solo el abismo, acechando en las sombras, ni tiempo de correr, ni sonido para gritar."

# game/Story04.rpy:2710

translate spanish story05_4_dc9c60a5:

    # k "That little rhyme’s been floating around for ages."
    k "Esa rima ha estado flotando por siglos."

# game/Story04.rpy:2711

translate spanish story05_4_f0343c0e:

    # k "Or, even simpler, picture a black screen in front of you. And here we are, welcome to the Abyss."
    k "O, incluso más simple, imagina una pantalla negra delante de ti. Y aquí estamos, bienvenidos al Abyss."

# game/Story04.rpy:2713

translate spanish story05_4_efdcfd20:

    # Mi "That’s an oversimplification… but in plain terms, yes. That’s it."
    Mi "Eso es una simplificación excesiva... pero en términos claros, sí. Eso es todo."

# game/Story04.rpy:2714

translate spanish story05_4_67e4b248:

    # h "Mm-hm. Interesting. If there’s nothing there… then how the hell do you get out?"
    h "Interesante. ¿Si no hay nada ahí... entonces cómo diablos te vas?"

# game/Story04.rpy:2717

translate spanish story05_4_827bc971:

    # k "Ding-ding, we’ve got a winner. You don’t."
    k "Ding-ding, tenemos un ganador."

# game/Story04.rpy:2718

translate spanish story05_4_9a19759e:

    # k "That’s exactly why her story’s so damn intriguing."
    k "Es exactamente por eso que su historia es tan intrigante."

# game/Story04.rpy:2720

translate spanish story05_4_336391a8:

    # mc "(And still, that place, the one the younger sister of Astoria stood in, I remember every detail I saw there.)"
    mc "(Y aun así, ese lugar, el que la hermana menor de Astoria se puso de pie, recuerdo cada detalle que vi allí.)"

# game/Story04.rpy:2722

translate spanish story05_4_338986f6:

    # mc "If no one’s ever been in the Abyss, then where did the rumor even come from?"
    mc "Si nadie ha estado en el Abismo, ¿de dónde vino el rumor?"

# game/Story04.rpy:2725

translate spanish story05_4_469b25f0:

    # k "That’s… actually a good question. Where did it come from?"
    k "Esa es... en realidad una buena pregunta. ¿De dónde vino?"

# game/Story04.rpy:2726

translate spanish story05_4_13204d8b:

    # k "Huh. Never really thought about it."
    k "Nunca lo había pensado."

# game/Story04.rpy:2728

translate spanish story05_4_a0202169:

    # Mi "People like to gossip about things they don’t understand."
    Mi "A la gente le gusta chismear cosas que no entienden."

# game/Story04.rpy:2729

translate spanish story05_4_ba2169b4:

    # Mi "For most of them, the Abyss is nothing more than a myth."
    Mi "Para la mayoría de ellos, el abismo no es más que un mito."

# game/Story04.rpy:2731

translate spanish story05_4_76496ffa:

    # k "Yeah. Pretty much."
    k "Sí, bastante."

# game/Story04.rpy:2732

translate spanish story05_4_74cece54:

    # h "A myth? You hear that, [mc]? So what now… we’re mythbusters? Ha!"
    h "¿Un mito? [mc]¿Y ahora qué... somos mitbusters?"

# game/Story04.rpy:2736

translate spanish story05_4_ff7addc1:

    # mc "(Chuckle) Guess so."
    mc "Supongo que sí."

# game/Story04.rpy:2737

translate spanish story05_4_cd4d2b1b:

    # mc "Time to find out what that myth is hiding. Lora?"
    mc "Es hora de averiguar qué esconde ese mito. ¿Lora?"

# game/Story04.rpy:2742

translate spanish story05_4_794e845e:

    # L "(Endless scorched plains. No animals. No plants. Nothing. Just dust.)"
    L "(Láminas infalibles, sin animales, sin plantas, nada, solo polvo.)"

# game/Story04.rpy:2744

translate spanish story05_4_cb3ddc70:

    # L "(I never saw a sun. No star. No source of light. Yet something, or someone, was lighting my path.)"
    L "(Nunca vi un sol. Ninguna estrella. No fuente de luz. Sin embargo, algo, o alguien, estaba iluminando mi camino.)"

# game/Story04.rpy:2746

translate spanish story05_4_bcafb1fb:

    # L "(I wandered that place for hours. Maybe longer. Searching for an exit. No success. At some point, I caught myself thinking-)"
    L "(Yo vagué ese lugar durante horas. Tal vez más. Buscando una salida. Sin éxito. En algún momento, me pillé pensando-)"

# game/Story04.rpy:2747

translate spanish story05_4_61b32fcc:

    # L "(If I don’t find a way out… how am I supposed to survive here? That’s when the panic started.)"
    L "(Si no encuentro una salida... ¿cómo se supone que sobrevivo aquí? Eso es cuando el pánico comenzó.)"

# game/Story04.rpy:2748

translate spanish story05_4_4ba68b51:

    # L "(I tried to fight it. Talk myself out of it. Convince myself it wasn’t real.)"
    L "(Intenté luchar contra ello. Háblame de ella. Convénzame de mí mismo no era real.)"

# game/Story04.rpy:2751

translate spanish story05_4_913bab13:

    # L "(Didn’t help much. Cold. Hunger. Panic. Exhaustion. That was my constant state.)"
    L "(No ayudó mucho. frío. hambre. pánico. agotamiento. Ese era mi estado constante.)"

# game/Story04.rpy:2753

translate spanish story05_4_35d42be2:

    # L "(It kept pressing down on me. Slowly. At first, all I wanted was to go home. Later… I just wanted it to end.)"
    L "(Seguiba apremiando sobre mí. Despacio. Al principio, todo lo que quería era ir a casa. Después... solo quería que terminara.)"

# game/Story04.rpy:2755

translate spanish story05_4_edfd6413:

    # L "(But you… and Norman. You gave me strength. Enough to keep moving.)"
    L "(Pero tú... y Norman, me diste fuerza suficiente para seguir moviéndose.)"

# game/Story04.rpy:2757

translate spanish story05_4_0e659f5f:

    # L "(Funny thing is - hunger barely affected my body. I felt it, sure. It was unpleasant. But that was all.)"
    L "(Lo más soleado es que el hambre apenas afectó mi cuerpo. Lo sentí, claro. Fue desagradable. Pero eso fue todo.)"

# game/Story04.rpy:2758

translate spanish story05_4_2de0436c:

    # L "(Honestly, I don’t know how long I stayed there. But to me… it felt like an eternity.)"
    L "(En serio, no sé cuánto tiempo me quedé allí. Pero para mí... se sentía como una eternidad.)"

# game/Story04.rpy:2760

translate spanish story05_4_9ba0cc5a:

    # L "(Thirst. Labored breathing. Complete exhaustion.)"
    L "(Tercera. Respiración laborada. Extireción completa.)"

# game/Story04.rpy:2761

translate spanish story05_4_cd206755:

    # L "(And then my body just gave up.)"
    L "(Y entonces mi cuerpo acaba de renunciar.)"

# game/Story04.rpy:2762

translate spanish story05_4_76c61d77:

    # L "(No strength to move. No will. Nothing.)"
    L "(No hay fuerza para moverse."

# game/Story04.rpy:2766

translate spanish story05_4_98419ced:

    # L "(The end.)"
    L "(El final.)"

# game/Story04.rpy:2772

translate spanish story05_4_d4ce6c95:

    # L "(Or so I thought.)"
    L "(O así pensé.)"

# game/Story04.rpy:2773

translate spanish story05_4_45d9771b:

    # L "(When I opened my eyes again… I was back where it all began.)"
    L "(Cuando abrí los ojos otra vez... estaba de vuelta donde todo comenzó.)"

# game/Story04.rpy:2775

translate spanish story05_4_9993b94e_4:

    # L "..."
    L "..."

# game/Story04.rpy:2778

translate spanish story05_4_1704a47b:

    # mc "(This…)"
    mc "(Este...)"

# game/Story04.rpy:2782

translate spanish story05_4_c31334f4:

    # h "INSANITY! Get over here, you, you massive asshole! Why, tell me WHY you didn’t say this from the start?!"
    h "¡INSANIDAD! Ven aquí, idiota enorme! ¿Por qué, dime por qué no dijiste esto desde el principio?!"

# game/Story04.rpy:2783

translate spanish story05_4_6684edda:

    # h "Why did you keep all of this to yourself?!"
    h "¿Por qué te guardaste todo esto?!"

# game/Story04.rpy:2785

translate spanish story05_4_c8702bd9:

    # L "Compared to what came after… that was nothing."
    L "Comparado con lo que vino después... eso no fue nada."

# game/Story04.rpy:2787

translate spanish story05_4_9f1e792d:

    # mc "(I… I don’t even know what to feel anymore. What to think…)"
    mc "(Yo... ni siquiera sé qué sentir más. ¿Qué pensar...)"

# game/Story04.rpy:2789

translate spanish story05_4_3cac5d5e:

    # mc "(While I was worrying about her, raging at her, blaming her… she was surviving. Literally surviving.)"
    mc "(Mientras me preocupaba por ella, arruinándola, culpando a ella... ella estaba sobreviviendo."

# game/Story04.rpy:2790

translate spanish story05_4_8e5079f3:

    # mc "(And still, a part of me wants to tear myself apart, why didn’t she tell me from the start?)"
    mc "(Y aun así, una parte de mí quiere desgarrarme, ¿por qué no me dijo desde el principio?)"

# game/Story04.rpy:2792

translate spanish story05_4_d226d40f:

    # mc "Why didn’t you tell me the truth? From the very beginning, why?"
    mc "¿Por qué no me dijiste la verdad? Desde el principio, ¿por qué?"

# game/Story04.rpy:2793

translate spanish story05_4_16581fc2:

    # mc "You think I would’ve treated you differently because of this? You think I would’ve-"
    mc "¿Crees que te habría tratado de manera diferente por esto?"

# game/Story04.rpy:2795

translate spanish story05_4_fa3bc6f5:

    # L "No. That wasn’t the reason."
    L "No, esa no era la razón."

# game/Story04.rpy:2797

translate spanish story05_4_15753e98:

    # Mi "Tell me… how did you find the place? When there was nothing around you at all?"
    Mi "Dime... ¿cómo encontraste el lugar?"

# game/Story04.rpy:2801

translate spanish story05_4_9993b94e_5:

    # L "..."
    L "..."

# game/Story04.rpy:2803

translate spanish story05_4_9de6c663:

    # L "It didn’t happen right away."
    L "No sucedió de inmediato."

# game/Story04.rpy:2804

translate spanish story05_4_2ab2da97:

    # L "On the fourth attempt, I noticed something in the distance. What exactly it was, I still don’t know."
    L "En el cuarto intento, noté algo en la distancia. Lo que exactamente era, todavía no lo sé."

# game/Story04.rpy:2806

translate spanish story05_4_10c2be14:

    # L "(Not then. Not now. But it became my reference point.)"
    L "(No entonces. No ahora, pero se convirtió en mi punto de referencia.)"

# game/Story04.rpy:2809

translate spanish story05_4_af99da52:

    # L "(I started moving toward it, thinking it was the way out.)"
    L "(Empecé a avanzar hacia ella, pensando que era la salida)."

# game/Story04.rpy:2810

translate spanish story05_4_a9a000e2:

    # L "(But every time I blacked out, reset. Back to the beginning.)"
    L "(Pero cada vez que me desmayé, me reajusté. Volver al principio.)"

# game/Story04.rpy:2812

translate spanish story05_4_ba3e7a2d:

    # L "(I tried. I fought. I searched for a way to break that limit.)"
    L "He intentado, he luchado, he buscado una manera de romper ese límite."

# game/Story04.rpy:2814

translate spanish story05_4_3bfa0664:

    # L "(I stayed awake as long as I could.)"
    L "(Me quedé despierto todo el tiempo que pude.)"

# game/Story04.rpy:2815

translate spanish story05_4_7014e4d3:

    # L "(Tried different paths.)"
    L "(Viotra diferentes caminos.)"

# game/Story04.rpy:2816

translate spanish story05_4_3d81278f:

    # L "(Tried doing nothing at all.)"
    L "(Intenté no hacer nada en absoluto.)"

# game/Story04.rpy:2817

translate spanish story05_4_071f8464:

    # L "(Tried… anything.)"
    L "(Tried... cualquier cosa.)"

# game/Story04.rpy:2819

translate spanish story05_4_bb515b59:

    # L "(Anything at all.)"
    L "(Nada en absoluto.)"

# game/Story04.rpy:2820

translate spanish story05_4_5e6ebd87:

    # L "(Until I heard a voice. Her voice.)"
    L "(Hasta que escuche una voz, su voz.)"

# game/Story04.rpy:2823

translate spanish story05_4_83782ccd:

    # L "(Suddenly, she was standing in front of me.)"
    L "(De repente, estaba de pie delante de mí.)"

# game/Story04.rpy:2824

translate spanish story05_4_f6b436ba:

    # L "(Red eyes. White, silky hair. A dress. And a gentle smile.)"
    L "(Ojos rojos, pelo blanco, sedoso, vestido, y una sonrisa suave.)"

# game/Story04.rpy:2826

translate spanish story05_4_be2979b3:

    # L "(Astoria’s younger sister. Evrelia.)"
    L "(La hermana menor de Astoria. Evrelia.)"

# game/Story04.rpy:2827

translate spanish story05_4_42851c7f:

    # L "(She didn’t say a word. Just stood there. Watching me.)"
    L "(No dijo una palabra. Solo estaba allí."

# game/Story04.rpy:2829

translate spanish story05_4_fc7852d1:

    # L "(I tried to talk to her. Asked who she was. Where we were.)"
    L "(Intenté hablar con ella."

# game/Story04.rpy:2830

translate spanish story05_4_cadb3a2f:

    # L "(Silence.)"
    L "(Silencio.)"

# game/Story04.rpy:2831

translate spanish story05_4_593740a8:

    # L "(And yet… in her gaze, in that smile, I felt something strange.)"
    L "(Y sin embargo... en su mirada, en esa sonrisa, sentí algo extraño.)"

# game/Story04.rpy:2832

translate spanish story05_4_06e83ca5:

    # L "(Warmth.)"
    L "(Warmth.)"

# game/Story04.rpy:2833

translate spanish story05_4_a04ebaef:

    # L "(For the first time… I felt something.)"
    L "(Por primera vez... sentí algo.)"

# game/Story04.rpy:2836

translate spanish story05_4_eb2760fe:

    # L "(Something that made me stop wanting to scream from pain and regret.)"
    L "(Algo que me hizo dejar de querer gritar de dolor y arrepentimiento.)"

# game/Story04.rpy:2838

translate spanish story05_4_9c424347:

    # L "(And so… together with her, I walked toward that reference point.)"
    L "(Y así... junto con ella, caminé hacia ese punto de referencia.)"

# game/Story04.rpy:2843

translate spanish story05_4_b98e6b50:

    # k "Hm… Evrelia? You’re sure it was really her?"
    k "¿Estás seguro de que era ella?"

# game/Story04.rpy:2845

translate spanish story05_4_57f2ac9f:

    # mc "What’s with that tone? Something wrong?"
    mc "¿Qué pasa con ese tono?"

# game/Story04.rpy:2847

translate spanish story05_4_4cd787af:

    # k "Yeah. Your description matches her scarily well. Except for one thing, a gentle smile?"
    k "Sí, tu descripción coincide con ella con su aterradora bien. ¿Excepto por una cosa, una sonrisa suave?"

# game/Story04.rpy:2848

translate spanish story05_4_b84ad481:

    # k "You were in your right mind back then, right?"
    k "Estabas en tu mente derecha en ese entonces, ¿verdad?"

# game/Story04.rpy:2849

translate spanish story05_4_679d9c1f:

    # h "Rude. You know that, right?"
    h "Rude. ¿Lo sabes, verdad?"

# game/Story04.rpy:2851

translate spanish story05_4_9d7a397d:

    # Mi "But she’s not wrong."
    Mi "Pero no está equivocada."

# game/Story04.rpy:2852

translate spanish story05_4_f06341ef:

    # Mi "Most people know the Lady’s younger sister as a tyrant… with a cold heart."
    Mi "La mayoría de la gente conoce a la hermana menor de la Señora como tirano... con un corazón frío."

# game/Story04.rpy:2853

translate spanish story05_4_6762ff02:

    # Mi "A gentle smile was never something people associated with her name."
    Mi "Una sonrisa suave nunca fue algo que la gente se asocia con su nombre."

# game/Story04.rpy:2855

translate spanish story05_4_8119db56:

    # mc "You said the same thing about the Abyss, and look how that turned out."
    mc "Dijiste lo mismo del Abyss, y mira cómo resultó."

# game/Story04.rpy:2858

translate spanish story05_4_cfed6a8b:

    # k "Don’t butt in, sweetheart. We’re still not sure whether that was the Abyss…"
    k "No te metas, cariño. Aún no estamos seguros de si ese era el Abyss..."

# game/Story04.rpy:2859

translate spanish story05_4_9b5b34c0:

    # k "or just your little wife having a vivid hallucination."
    k "o solo tu pequeña esposa teniendo una alucinación vívida."

# game/Story04.rpy:2861

translate spanish story05_4_e3ee1bd6:

    # mc "You’re saying she’s lying?"
    mc "¿Estás diciendo que está mintiendo?"

# game/Story04.rpy:2863

translate spanish story05_4_7ddd46f9:

    # k "Could be."
    k "Podría ser."

# game/Story04.rpy:2864

translate spanish story05_4_f0d03cd1:

    # k "Still, there’s a grain of truth in what she said."
    k "Sin embargo, hay un grano de verdad en lo que dijo."

# game/Story04.rpy:2866

translate spanish story05_4_4bb6d487:

    # mc "Can you confirm that claim?"
    mc "¿Puede confirmar esa afirmación?"

# game/Story04.rpy:2868

translate spanish story05_4_0d4d630a:

    # k "Nope."
    k "No."

# game/Story04.rpy:2870

translate spanish story05_4_f6b34ecb:

    # mc "(Honestly, that last bit about this… Evrélia? Hard to swallow.)"
    mc "(Honestamente, eso último poco sobre esto... Evrélia?"

# game/Story04.rpy:2871

translate spanish story05_4_295d2d3f:

    # mc "(But judging by her description, and what I saw in that dream, everything lines up so far.)"
    mc "(Pero a juzgar por su descripción, y lo que vi en ese sueño, todo se alinea hasta ahora.)"

# game/Story04.rpy:2872

translate spanish story05_4_9e20caac:

    # mc "You’re surprisingly calm and quiet, are you okay?"
    mc "Estás sorprendentemente calmado y tranquilo, ¿estás bien?"

# game/Story04.rpy:2874

translate spanish story05_4_a49ef982:

    # L "I’m telling it exactly as it is. Whether they believe me or not is their choice."
    L "Lo estoy diciendo exactamente como es. Si ellos me creen o no es su elección."

# game/Story04.rpy:2875

translate spanish story05_4_cd68761f:

    # L "I can’t, and won’t, try to convince them."
    L "No puedo, y no lo haré, tratar de convencerlos."

# game/Story04.rpy:2876

translate spanish story05_4_77f30bb0:

    # L "(whispering) In the end… I can understand them."
    L "Al final... puedo entenderlos."

# game/Story04.rpy:2880

translate spanish story05_4_570e9671:

    # L "(We walked together, day after day.)"
    L "(Caminamos juntos, día tras día.)"

# game/Story04.rpy:2881

translate spanish story05_4_93d992f4:

    # L "(Maybe because of everything I’d been through, my senses dulled, I barely felt hunger or cold.)"
    L "(Quizás por todo lo que había pasado, mis sentidos se quedaron sin sentido, apenas sentía hambre o frío.)"

# game/Story04.rpy:2882

translate spanish story05_4_407e29dd:

    # L "(Or maybe… she had something to do with it.)"
    L "(O tal vez... ella tenía algo que ver con ello.)"

# game/Story04.rpy:2883

translate spanish story05_4_3d40d03f:

    # L "(Either way, I didn’t dig into it.)"
    L "(Ni siquiera, no me entrometí en ello.)"

# game/Story04.rpy:2885

translate spanish story05_4_2f3c7e7a:

    # L "(The picture started to come together.)"
    L "(La imagen empezó a reunirse.)"

# game/Story04.rpy:2886

translate spanish story05_4_d62a417c:

    # L "(I began to see outlines, towers, mechanisms, structures.)"
    L "(Empecé a ver contornos, torres, mecanismos, estructuras.)"

# game/Story04.rpy:2887

translate spanish story05_4_cd0aab64:

    # L "(Asking myself what it all was, I foolishly decided to ask her instead.)"
    L "(Prefieriéndome lo que era todo, decidí preguntarla en lugar de eso)."

# game/Story04.rpy:2888

translate spanish story05_4_59a5a2ab:

    # L "(I had nothing to lose.)"
    L "(No tenía nada que perder.)"

# game/Story04.rpy:2889

translate spanish story05_4_0dd2c7fb:

    # L "(And then-)"
    L "(Y luego-)"

# game/Story04.rpy:2891

translate spanish story05_4_7fb69399:

    # Evrel "Tell me… why are you here?"
    Evrel "Dime... ¿por qué estás aquí?"

# game/Story04.rpy:2893

translate spanish story05_4_475f9bbb:

    # L "(Her voice sounded like a melody. Every word, like a note.)"
    L "(Su voz sonaba como una melodía. Cada palabra, como una nota.)"

# game/Story04.rpy:2895

translate spanish story05_4_3e2b0e44:

    # L "I… don’t know the true reason myself."
    L "Yo... no sé la verdadera razón."

# game/Story04.rpy:2896

translate spanish story05_4_ab5b9724:

    # L "I was simply pulled into this place."
    L "Simplemente me metieron en este lugar."

# game/Story04.rpy:2897

translate spanish story05_4_425d5902:

    # L "(She only smiled in response.)"
    L "(Solo sonrió en respuesta.)"

# game/Story04.rpy:2899

translate spanish story05_4_cad51054:

    # Evrel "From the moment you appeared here, I’ve been watching you. Seeing you. Feeling you."
    Evrel "Desde el momento en que apareciste aquí, te he estado observando. Te veo. Sentiéndote."

# game/Story04.rpy:2900

translate spanish story05_4_9123662a:

    # Evrel "You have a pure heart."
    Evrel "Tienes un corazón puro."

# game/Story04.rpy:2902

translate spanish story05_4_5d05afe2:

    # L "Uh- thank you? Sorry, this might be awkward, but… what should I call you?"
    L "Lo siento, esto podría ser incómodo, pero... ¿cómo debería llamarte?"

# game/Story04.rpy:2904

translate spanish story05_4_96b7afc9:

    # Evrel "Evrelia."
    Evrel "Evrelia."

# game/Story04.rpy:2906

translate spanish story05_4_d793b07d:

    # L "My name is Lora. It’s nice to meet you."
    L "Me llamo Lora. Es un placer conocerte."

# game/Story04.rpy:2907

translate spanish story05_4_8d2e2129:

    # L "But may I ask, what is this place?"
    L "Pero, ¿qué es este lugar?"

# game/Story04.rpy:2909

translate spanish story05_4_15f57fce:

    # Evrel "This place? It has many names."
    Evrel "Tiene muchos nombres."

# game/Story04.rpy:2910

translate spanish story05_4_1b5b7e9d:

    # Evrel "Some call it the Abyss. Others, a tomb."
    Evrel "Algunos lo llaman el Abismo, otros, una tumba."

# game/Story04.rpy:2911

translate spanish story05_4_e239fba9:

    # Evrel "Some, the ruins of an empire."
    Evrel "Algunos, las ruinas de un imperio."

# game/Story04.rpy:2912

translate spanish story05_4_2bac8dc7:

    # Evrel "But to me… this is home."
    Evrel "Pero para mí... esto es casa."

# game/Story04.rpy:2914

translate spanish story05_4_76651acc:

    # L "But… what are you doing here?"
    L "Pero... ¿qué estás haciendo aquí?"

# game/Story04.rpy:2918

translate spanish story05_4_20329604:

    # Evrel "Before you came, I thought. I dreamed. After that… I watched."
    Evrel "Antes de que vinieras, pensé que soñé, después de eso... lo vi."

# game/Story04.rpy:2919

translate spanish story05_4_11967701:

    # Evrel "Tell me, do you like this place?"
    Evrel "Dime, ¿te gusta este lugar?"

# game/Story04.rpy:2921

translate spanish story05_4_da2ee350:

    # L "I’m sorry, but it’s dark here."
    L "Lo siento, pero está oscuro aquí."

# game/Story04.rpy:2922

translate spanish story05_4_595ad8b3:

    # L "Dry. Cold. Gray."
    L "Dry, Cold. Gray."

# game/Story04.rpy:2923

translate spanish story05_4_51ab616e:

    # L "I understand this is your home, but still…"
    L "Entiendo que este es tu hogar, pero aún así..."

# game/Story04.rpy:2925

translate spanish story05_4_c7366c8f:

    # Evrel "It really is…"
    Evrel "Realmente es..."

# game/Story04.rpy:2931

translate spanish story05_4_27eaa938:

    # L "(After that, a snap of her fingers, and I froze.)"
    L "(Después de eso, un poco de sus dedos, y me he congelado.)"

# game/Story04.rpy:2932

translate spanish story05_4_d2e452ba:

    # L "(The world that once felt dead and hollow turned into a living garden.)"
    L "(El mundo que una vez se sentía muerto y hueco se convirtió en un jardín viviente.)"

# game/Story04.rpy:2933

translate spanish story05_4_ccb17783:

    # L "(Ruins became towering buildings.)"
    L "(Ruinas se convirtieron en edificios torrentes.)"

# game/Story04.rpy:2934

translate spanish story05_4_bc7522d9:

    # L "(Dust became people.)"
    L "(El Dust se convirtió en gente.)"

# game/Story04.rpy:2935

translate spanish story05_4_b019367c:

    # L "(All of it, with a single snap.)"
    L "(Todo, con un solo snap.)"

# game/Story04.rpy:2936

translate spanish story05_4_a5c8e70b:

    # L "(But the most disturbing part…)"
    L "(Pero la parte más inquietante...)"

# game/Story04.rpy:2938

translate spanish story05_4_6f66c26b:

    # Evrel "Does it feel familiar?"
    Evrel "¿Se siente familiar?"

# game/Story04.rpy:2939

translate spanish story05_4_fc2fb28a:

    # L "(In that moment, I realized-)"
    L "(En ese momento, me di cuenta-)"

# game/Story04.rpy:2940

translate spanish story05_4_040618eb:

    # L "(All this time… I had been on Earth.)"
    L "(Todo este tiempo... yo había estado en la Tierra.)"

# game/Story04.rpy:2948

translate spanish story05_4_195a6167:

    # b "WHAT?!"
    b "¿Qué?"

# game/Story04.rpy:2950

translate spanish story05_4_82091822:

    # k "..."
    k "..."

# game/Story04.rpy:2952

translate spanish story05_4_14634ff8:

    # h "Okay… yeah. This is definitely not what I was expecting."
    h "Esto no es lo que esperaba."

# game/Story04.rpy:2954

translate spanish story05_4_24016079:

    # mc "But I don’t get it. What was the point of all this? Why the whole damn show?"
    mc "Pero no lo entiendo. ¿Cuál era el punto de todo esto? ¿Por qué todo el maldito show?"

# game/Story04.rpy:2956

translate spanish story05_4_ae438b19:

    # Mi "So the ancient empire was on Earth…?"
    Mi "¿Entonces el imperio antiguo estaba en la Tierra?"

# game/Story04.rpy:2957

translate spanish story05_4_5a7a01da:

    # Mi "Unthinkable…"
    Mi "Inimaginable..."

# game/Story04.rpy:2959

translate spanish story05_4_ecd070c9:

    # mc "And you’re surprised? Shouldn’t you already know this?"
    mc "¿Y estás sorprendido? ¿No deberías saber esto ya?"

# game/Story04.rpy:2961

translate spanish story05_4_b6fb513b:

    # L "This is something no one knows. Except Astoria… and me."
    L "Esto es algo que nadie sabe, excepto Astoria... y yo."

# game/Story04.rpy:2963

translate spanish story05_4_819f8355:

    # k "So that’s why she treats you so special. Interesting."
    k "Por eso te trata tan especial. Interesante."

# game/Story04.rpy:2964

translate spanish story05_4_04ed0afd:

    # k "And what about the sister?"
    k "¿Y qué hay de la hermana?"

# game/Story04.rpy:2965

translate spanish story05_4_665b1de7:

    # L "She doesn’t know."
    L "Ella no lo sabe."

# game/Story04.rpy:2967

translate spanish story05_4_f68cb59e:

    # h "Alright, we cleared that up, but you still didn’t say why they’re hunting you. What’s the point of all this?"
    h "Muy bien, lo aclaramos, pero todavía no dijiste por qué te están cazando. ¿Cuál es el punto de todo esto?"

# game/Story04.rpy:2969

translate spanish story05_4_1223f5ba:

    # k "Seriously? I thought I was the dumbest one here. Turns out, I was wrong."
    k "Pensé que era el más tonto de aquí."

# game/Story04.rpy:2971

translate spanish story05_4_b07ac3e1:

    # h "You looking for trouble?"
    h "¿Buscas problemas?"

# game/Story04.rpy:2973

translate spanish story05_4_6d702955:

    # k "Oh, me? Picking a fight? Trust me, if I were, you’d already be on the floor."
    k "¿Yo? ¿Eligiendo una pelea? Confía en mí, si yo fuera, ya estarías en el suelo."

# game/Story04.rpy:2974

translate spanish story05_4_c832adff:

    # k "This? Just friendly banter."
    k "Es un cántico amistoso."

# game/Story04.rpy:2975

translate spanish story05_4_770aa998:

    # h "Then do us all a favor and explain what’s actually going on. See, not everyone here is a genius who spent their whole life swimming in this shit."
    h "Entonces haznos un favor y explícanos lo que está pasando realmente. Mira, no todos aquí es un genio que pasó toda su vida nadando en esta mierda."

# game/Story04.rpy:2976

translate spanish story05_4_920bc321:

    # h "Sometimes people need things spelled out. You know. Slowly. Okay? Now shut-"
    h "A veces la gente necesita cosas deletreadas."

# game/Story04.rpy:2977

translate spanish story05_4_bcc2ebba:

    # k "Pfft… poor thing. Aww, did I hurt your feelings?"
    k "Pobrecito. ¿Te he hecho daño?"

# game/Story04.rpy:2980

translate spanish story05_4_23e0480a:

    # mc "You two, enough."
    mc "Ustedes dos, suficiente."

# game/Story04.rpy:2981

translate spanish story05_4_80bb3b2f:

    # mc "Right now, we’re a team. Tearing each other’s throats out isn’t exactly helping."
    mc "Ahora mismo, somos un equipo. Tear las gargantas de los demás no es exactamente ayudar."

# game/Story04.rpy:2983

translate spanish story05_4_09191d6f:

    # mc "Afterward, do whatever the hell you want, but for now, try to get along."
    mc "Después, haz lo que quieras, pero por ahora, intenta llevarte bien."

# game/Story04.rpy:2985

translate spanish story05_4_4164b948:

    # mc "Are we clear?"
    mc "¿Estamos claros?"

# game/Story04.rpy:2987

translate spanish story05_4_84081136:

