translate spanish story05_5_2_92b38daa:

    # mc "Then how?"
    mc "¿Entonces cómo?"

# game/Story04.rpy:6736

translate spanish story05_5_2_8b614c8d:

    # a "The lighter."
    a "El encendedor."

