    # o "It’s as if this place is playing tricks on us Everything feels... off. "
    o "Es como si este lugar jugara con nosotros. Todo se siente... mal."

# game/Story01.rpy:7815

translate spanish final2_c832e0fc:

    # h "Am I the only one who finds all of this incredibly strange? How could they hide something this massive, right under everyone’s noses?"
    h "¿Soy el único al que todo esto le parece increíblemente extraño? ¿Cómo pudieron ocultar algo tan enorme justo bajo las narices de todos?"

# game/Story01.rpy:7816

translate spanish final2_3d68a720:

    # h "It’s almost impossible to believe — like something out of a sci-fi nightmare."
    h "Es casi imposible de creer, como salido de una pesadilla de ciencia ficción."

# game/Story01.rpy:7818

translate spanish final2_e1849b18:

    # mc "You’ve got a point. And what’s the purpose of this facility?"
    mc "Tienes razón. ¿Y cuál es el propósito de esta instalación?"

# game/Story01.rpy:7819

translate spanish final2_5567ba78:

    # mc "Is it... for creating mutants? But why? There has to be a reason..."
    mc "¿Es... para crear mutantes? Pero ¿por qué? Tiene que haber una razón..."

# game/Story01.rpy:7823

translate spanish final2_816d738c:

    # h "Not this again. Another one of your crazy theories?"
    h "¿Otra de tus teorías locas?"

# game/Story01.rpy:7824

translate spanish final2_b29b1533:

    # h "This isn’t the time—"
    h "Este no es el momento..."

# game/Story01.rpy:7826

