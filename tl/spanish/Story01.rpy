    # mc "..."
    mc "..."

# game/Story01.rpy:4308

translate spanish path_first_right_3_5398ce28:

    # Fl "Hang on… I’ve got movement on the sensors—up the street. Could be a glitch, but don’t bank on it. Stay sharp."
    Fl "Espera... Tengo movimiento en los sensores, en la calle. Podría ser un fallo, pero no lo hagas. Mantente afilado."

# game/Story01.rpy:4309

translate spanish path_first_right_3_dc16ebcd:

    # mc "Got it."
    mc "Lo tengo."

# game/Story01.rpy:4314

translate spanish path_first_right_3_2b35b6fe:

    # mc "..."
    mc "..."

# game/Story01.rpy:4324

translate spanish path_first_right_4_4da83f25:

    # mc "Just around this corner?"
    mc "¿A la vuelta de esta esquina?"

# game/Story01.rpy:4325

translate spanish path_first_right_4_0b50f1d2:

    # Fl "Yup. The indicators show multiple lifeforms in the area. Play it smart."
    Fl "Sí. Los indicadores muestran múltiples formas de vida en el área. Juega inteligente."

# game/Story01.rpy:4327

translate spanish path_first_right_4_b1766d24:

    # Fl "Do not engage unless you absolutely have to. If you see anything, call it in. No lone-wolf stunts, got it?"
    Fl "No te atrevas a menos que tengas que hacerlo. ¿Si ves algo, llama a esto, sin tartamudas de lobo solitario, lo entiendes?"

# game/Story01.rpy:4333

translate spanish path_first_right_4_ab2026ad:

    # Fl "Updates? The system says it should be right in your line of sight."
    Fl "El sistema dice que debe estar justo en su línea de visión."

# game/Story01.rpy:4335

translate spanish path_first_right_4_61b5d61e:

    # mc "I see something... a massive creature, at least two metres tall, devouring… someone. Or what’s left of them."
    mc "Veo algo... una criatura masiva, al menos dos metros de alto, devorando... a alguien o lo que queda de ellos."

# game/Story01.rpy:4337

translate spanish path_first_right_4_c4e7b4a1:

    # mc "Judging by the remains, it seems this person was human. Once."
    mc "A juzgar por los restos, parece que esta persona era humana."

# game/Story01.rpy:4339

translate spanish path_first_right_4_da2344bf:

    # Fl "Wait a second. Linking up to your feed. Let me see what we’re dealing with here…"
    Fl "Espera un segundo. Viniendo a tu alimento. Déjame ver con qué estamos tratando aquí..."

# game/Story01.rpy:4341

translate spanish path_first_right_4_9aeb94f8:

    # Fl "What in the actual hell is that? Right, aim for the lower chest. Now. Don’t hesitate, or we’ll both regret it."
    Fl "¿Qué es eso en el infierno real? Cierto, apuntar hacia el pecho inferior. Ahora. No lo dudes, o ambos lo lamentaremos."

# game/Story01.rpy:4351

translate spanish path_first_right_4_2b35b6fe:

    # mc "..."
    mc "..."

# game/Story01.rpy:4362

translate spanish shoot2_4f9b101f:

    # Fl "I TOLD YOU TO AIM FOR THE CHEST! NOT THE HEAD!"
    Fl "¡Te lo dije por la prueba!"

# game/Story01.rpy:4364

translate spanish shoot2_2b35b6fe:

    # mc "..."
    mc "..."

# game/Story01.rpy:4366

translate spanish shoot2_bbc23223:

    # Fl "Was it really that hard to understand? His reflexes are too sharp, that’s why you needed to aim for the chest—he wouldn’t have been able to dodge it."
    Fl "¿Fue realmente tan difícil de entender? Sus reflejos son demasiado agudos, por eso necesitabas apuntar al pecho, no habría podido esquivarlo."

# game/Story01.rpy:4368

translate spanish shoot2_bcf210d6:

    # mc "Sorry, I thought a headshot would’ve been the better choice."
    mc "Lo siento, pensé que una captura de cabeza habría sido la mejor opción."

# game/Story01.rpy:4370

translate spanish shoot2_536d7ce8:

    # Fl "Sigh. Fine, forget it. But next time, listen to my advice, okay?"
    Fl "Bien, olvídalo, pero la próxima vez, escucha mi consejo, ¿de acuerdo?"

# game/Story01.rpy:4372

translate spanish shoot2_f7aa5352:

    # mc "I’ll do my best."
    mc "Haré lo mejor que pueda."

# game/Story01.rpy:4380

translate spanish shoot3_adfd608a:

    # Fl "And now he’s gone... Next time, make your decision faster, got it?"
    Fl "Y ahora se ha ido... La próxima vez, toma tu decisión más rápido, ¿entendido?"

# game/Story01.rpy:4382

translate spanish shoot3_5c62910e:

    # mc "It didn’t even take half a second! How was I supposed to..."
    mc "¡Ni siquiera tomó medio segundo! ¿Cómo se supone que debía..."

# game/Story01.rpy:4384

translate spanish shoot3_90cb4d7b:

    # Fl "You’re not an ordinary person, remember? For someone like you, that’s more than enough time to analyze and act."
    Fl "No eres una persona común, ¿recuerdas? Para alguien como tú, es más que suficiente tiempo para analizar y actuar."

# game/Story01.rpy:4386

translate spanish shoot3_88144c4f:

    # mc "Sigh. Understood. Sorry."
    mc "Entendido, lo siento."

# game/Story01.rpy:4394

translate spanish shoot4_3e07717d:

    # Fl "Nice shot. Now finish it—but don’t get cocky. That thing’s not as dead as it looks."
    Fl "Buen tiro. Ahora termina esto, pero no te pongas arrogante. Esa cosa no está tan muerta como parece."

# game/Story01.rpy:4396

translate spanish shoot4_2051d66a:

    # mc "Understood."
    mc "Entendido."

# game/Story01.rpy:4398

translate spanish shoot4_36801551:

    # Fl "Stay back. Don’t step into its attack radius unless you have a death wish."
    Fl "No entres en su radio de ataque a menos que tengas un deseo de muerte."

# game/Story01.rpy:4406

translate spanish shoot4_3f319791:

    # mc "Target neutralised. But what in the world was that thing?"
    mc "El objetivo neutralizado. ¿Pero qué era esa cosa?"

# game/Story01.rpy:4408

translate spanish shoot4_82dd049e:

    # Fl "hat creature gave us no end of headaches on the front lines. It had this nasty trick..."
    Fl "La criatura del sombrero no nos dio fin a los dolores de cabeza en las líneas delanteras."

# game/Story01.rpy:4409

translate spanish shoot4_0a419b90:

    # mc "A trick?"
    mc "¿Un truco?"

# game/Story01.rpy:4411

translate spanish shoot4_4b542268:

    # Fl "Blend right into the surroundings like a damn chameleon. Sneaky little monster."
    Fl "Se camufla con el entorno como un maldito camaleón. Monstruo escurridizo."

# game/Story01.rpy:4413

translate spanish shoot4_17ec7990:

    # mc "An invisible foe? Sounds like a right menace."
    mc "¿Un enemigo invisible? Suena a una amenaza de las buenas."

# game/Story01.rpy:4414

translate spanish shoot4_b0f39fe9:

    # Fl "Good thing we took it out when we did. Trust me, you don’t want to see what it’s capable of at full strength."
    Fl "Menos mal que lo eliminamos cuando pudimos. Créeme, no quieres ver de qué es capaz a plena potencia."

# game/Story01.rpy:4416

translate spanish shoot4_88f9980c:

    # mc "Quite right."
    mc "Cierto."

# game/Story01.rpy:4425

translate spanish path_first_left_1_a3c2df43:

    # Fl "Wait. There’s a distress signal nearby. Can you check it out? Might be nothing, but let’s not take chances."
    Fl "Espera. Hay una señal de socorro cerca. ¿Puedes comprobarla? Puede que no sea nada, pero mejor no arriesgarnos."

# game/Story01.rpy:4427

translate spanish path_first_left_1_d542a397:

    # mc "Judging by the looks of things, there’s nothing we can do for him now. He’s dead."
    mc "Por cómo se ve, ya no hay nada que podamos hacer por él. Está muerto."

# game/Story01.rpy:4428

translate spanish path_first_left_1_9ba6f236:

    # Fl "And if it is nothing, well, guess we’ve done our good deed for the day."
    Fl "Y si no es nada, bueno, habremos hecho nuestra buena obra del día."

