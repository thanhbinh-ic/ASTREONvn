translate spanish flashback_6619e696:

    # Mi "It’s more than just a team."
    Mi "Es más que un equipo."

# game/Story01.rpy:4415

translate spanish flashback_53a7e195:

    # h "Well, look at that…"
    h "Bueno, mira eso..."

# game/Story01.rpy:4416

translate spanish flashback_48013837:

    # h "Mir, you’re getting curious."
    h "Mir, te estás poniendo curioso."

# game/Story01.rpy:4420

translate spanish flashback_a735d2b7:

    # h "You know… it’s a long story."
    h "Sabes... es una larga historia."

# game/Story01.rpy:4422

translate spanish flashback_dde3b983:

    # Mi "…I understand."
    Mi "...lo entiendo."

# game/Story01.rpy:4426

translate spanish flashback_505436df:

    # h "Before I start… tell me something."
    h "Antes de empezar... dime algo."

# game/Story01.rpy:4429

translate spanish flashback_3bf5d57d:

    # h "What are we to you?"
    h "¿Qué te pasa?"

# game/Story01.rpy:4431

translate spanish flashback_5b9b857f:

    # Mi "…A team, I suppose."
    Mi "...un equipo, supongo."

# game/Story01.rpy:4437

translate spanish flashback_6d0baa06:

    # h "Huh… funny. You used to be against that."
    h "Qué gracioso, solías estar en contra de eso."

# game/Story01.rpy:4439

translate spanish flashback_6c6b411e:

    # h "So what changed?"
    h "¿Qué cambió?"

# game/Story01.rpy:4441

translate spanish flashback_49d9bad7:

    # Mi "You showed me…"
    Mi "Me mostraste..."

# game/Story01.rpy:4443

translate spanish flashback_cad2aaeb:

    # Mi "Through your actions."
    Mi "A través de sus acciones."

# game/Story01.rpy:4445

translate spanish flashback_a6197252:

    # h "Well… yeah. The story."
    h "Bueno... sí, la historia."

# game/Story01.rpy:4447

translate spanish flashback_9c7ee7a0:

    # h "Long story short… I owe him."
    h "Larga historia corta... le debo."

# game/Story01.rpy:4449

translate spanish flashback_e156b1f4:

    # h "But if I’m being honest…"
    h "Pero si estoy siendo honesto..."

# game/Story01.rpy:4453

translate spanish flashback_fe3e11f5:

    # h "It started long before we ever met."
    h "Empezó mucho antes de que nos conociéramos."

# game/Story01.rpy:4457

translate spanish flashback_183aa567:

    # h "We were poor."
    h "Éramos pobres."

# game/Story01.rpy:4458

translate spanish flashback_b3e147ad:

    # h "The kind that sticks to your bones and doesn’t let go."
    h "El tipo que se pega a tus huesos y no se deja ir."

# game/Story01.rpy:4459

translate spanish flashback_749dcec9:

    # h "I don’t remember my father."
    h "No recuerdo a mi padre."

# game/Story01.rpy:4460

translate spanish flashback_3a2e496c:

    # h "And honestly? Good."
    h "¿Y honestamente?"

# game/Story01.rpy:4462

translate spanish flashback_2a27b5dd:

    # h "He was a bastard."
    h "Era un bastardo."

# game/Story01.rpy:4463

translate spanish flashback_18f0f211:

    # h "Only decent thing he ever did was pay off our debts… then disappear."
    h "Lo único decente que hizo fue pagar nuestras deudas... y luego desaparecer."

# game/Story01.rpy:4465

translate spanish flashback_797975e7:

    # h "Mom handled the rest."
    h "Mamá se encargó del resto."

# game/Story01.rpy:4466

translate spanish flashback_d23e5513:

    # h "Took whatever work she could get."
    h "Aceptó cualquier trabajo que pudiera conseguir."

# game/Story01.rpy:4467

translate spanish flashback_6c3f685d:

    # h "Cleaning. Lifting. Bleeding hands and sleepless nights."
    h "Limpiar. Cargar peso. Manos sangrando y noches sin dormir."

# game/Story01.rpy:4468

translate spanish flashback_997484cc:

    # h "Still smiled through it."
    h "Aun así, sonreía."

# game/Story01.rpy:4469

translate spanish flashback_3021dd45:

    # h "Kept saying we had to live. Laugh."
    h "No dejaba de decir que teníamos que vivir. Reír."

# game/Story01.rpy:4470

translate spanish flashback_7ed46fcc:

    # h "But mom didn’t last long."
    h "Pero mamá no duró mucho."

# game/Story01.rpy:4471

translate spanish flashback_7afa7f7c:

    # h "Work took everything out of her."
    h "El trabajo la dejó vacía."

# game/Story01.rpy:4474

translate spanish flashback_f4661d75:

    # h "School?"
    h "¿Escuela?"

# game/Story01.rpy:4478

translate spanish flashback_faf2dd05:

    # h "Hell."
    h "Un infierno."

# game/Story01.rpy:4478

translate spanish flashback_2ecaca54:

    # h "Bullies. Looks. Whispers."
    h "Abusones. Miradas. Susurros."

# game/Story01.rpy:4480

translate spanish flashback_c140262a:

    # h "Changed schools more times than I can count."
    h "Me cambié de escuela más veces de las que puedo contar."

# game/Story01.rpy:4482

translate spanish flashback_d2cd358a:

    # h "Truth is… I didn’t transfer."
    h "La verdad es que no me cambié."

# game/Story01.rpy:4483

translate spanish flashback_e8253b49:

    # h "I got kicked out."
    h "Me echaron."

# game/Story01.rpy:4487

translate spanish flashback_f0d9dee1:

    # h "That anger?"
    h "¿Ese enojo?"

# game/Story01.rpy:4495

translate spanish flashback_3eb0888f:

    # h "Wasn’t about me."
    h "No era por mí."

# game/Story01.rpy:4496

translate spanish flashback_fa3178b0:

    # h "It was about her."
    h "Era por ella."

# game/Story01.rpy:4497

translate spanish flashback_3f511f84:

    # h "My sister."
    h "Mi hermana."

# game/Story01.rpy:4499

translate spanish flashback_4fc33752:

    # h "Nobody touches her."
    h "Nadie la toca."

# game/Story01.rpy:4500

translate spanish flashback_f5a0223f:

    # h "Ever."
    h "Jamás."

# game/Story01.rpy:4503

translate spanish flashback_51859c3f:

    # h "I'm home."
    h "Ya llegué."

# game/Story01.rpy:4505

translate spanish flashback_a8c25438:

    # C "Something happen?"
    C "¿Pasa algo?"

# game/Story01.rpy:4508

translate spanish flashback_ab2a12dd:

    # h "Nah, nothing serious."
    h "Bah, nada serio."

# game/Story01.rpy:4509

translate spanish flashback_14dcacdd:

    # h "Just had to deal with a couple of idiots."
    h "Solo tuve que encargarme de un par de idiotas."

# game/Story01.rpy:4510

translate spanish flashback_a871fd87:

    # h "Don’t worry."
    h "No te preocupes."

# game/Story01.rpy:4511

translate spanish flashback_6659bfc9:

    # h "Handled it."
    h "Me encargué."

# game/Story01.rpy:4513

translate spanish flashback_ac164e2c:

    # C "Well… if you say it’s nothing, I’ll pretend I believe you."
    C "Bueno... si dices que no es nada, fingiré que te creo."

# game/Story01.rpy:4514

translate spanish flashback_c2399158:

    # C "Just hope your ‘nothing’ didn’t end with someone in a hospital."
    C "Solo espero que tu 'nada' no haya terminado con alguien en el hospital."

# game/Story01.rpy:4516

translate spanish flashback_451bd87e:

    # C "Because if they decide to press charges..."
    C "Porque si deciden presentar cargos..."

# game/Story01.rpy:4517

translate spanish flashback_2d0d25ba:

    # C "We’re screwed. You know that, right?"
    C "Estamos jodidas. Lo sabes, ¿verdad?"

# game/Story01.rpy:4519

translate spanish flashback_1dc438d9:

    # h "Oh?"
    h "¿Ah?"

# game/Story01.rpy:4520

translate spanish flashback_5eeeab74:

    # h "Is that concern I’m hearing?"
    h "¿Eso que oigo es preocupación?"

# game/Story01.rpy:4521

translate spanish flashback_26ba2297:

    # h "Wow… my little sister’s going soft on me."
    h "Vaya... mi hermanita se me está ablandando."

# game/Story01.rpy:4522

translate spanish flashback_63b26657:

    # h "Cute."
    h "Qué adorable."

# game/Story01.rpy:4524

translate spanish flashback_550b5436:

    # h "(She always felt older than me.)"
    h "(Siempre parecía mayor que yo.)"

# game/Story01.rpy:4525

translate spanish flashback_d22cbc48:

    # h "(Smarter.)"
    h "(Más lista.)"

# game/Story01.rpy:4526

translate spanish flashback_c1065107:

    # h "(Sharper.)"
    h "(Más lúcida.)"

# game/Story01.rpy:4527

translate spanish flashback_fcb03d7d:

    # h "(Saw things I didn’t.)"
    h "(Veía cosas que yo no.)"

# game/Story01.rpy:4529

translate spanish flashback_06419996:

    # h "…I got lucky, you know that?"
    h "...Tuve suerte, ¿sabes?"

# game/Story01.rpy:4531

translate spanish flashback_03b52ab0:

    # h "Without you… I’d be screwed."
    h "Sin ti... estaría acabada."

# game/Story01.rpy:4533

translate spanish flashback_15539f3a:

    # h "Probably dead."
    h "Probablemente muerta."

# game/Story01.rpy:4534

translate spanish flashback_180df5f2:

    # h "Or worse."
    h "O peor."

# game/Story01.rpy:4538

translate spanish flashback_86de1bdf:

    # h "…Hey."
    h "...Oye."

# game/Story01.rpy:4539

translate spanish flashback_54549f74:

    # h "What’s up?"
    h "¿Qué pasa?"

# game/Story01.rpy:4541

translate spanish flashback_08887c5e:

    # C "That smell, your sleeves! That’s blood again, isn’t it?!"
    C "¡Ese olor... tus mangas! ¡Es sangre otra vez, ¿verdad?!"

# game/Story01.rpy:4544

translate spanish flashback_29c064ed:

    # C "You got into another fight? Seriously?!"
    C "¿Te metiste en otra pelea? ¡¿En serio?!"

# game/Story01.rpy:4545

translate spanish flashback_0b9603af:

    # C "How many times are we doing this?!"
    C "¡¿Cuántas veces vamos a pasar por esto?!"

# game/Story01.rpy:4546

translate spanish flashback_15313ac9:

    # C "Sit. Down."
    C "Siéntate."

# game/Story01.rpy:4547

translate spanish flashback_401113b1:

    # C "Don’t argue, I’m getting the med kit."
    C "No discutas, voy por el botiquín."

# game/Story01.rpy:4548

translate spanish flashback_a3b0a5c5:

    # C "Last thing we need is you rotting from an infection."
    C "Lo último que necesitamos es que te pudras por una infección."

# game/Story01.rpy:4550

translate spanish flashback_8e4658e4:

    # h "After that…"
    h "Después de eso..."

# game/Story01.rpy:4554

translate spanish flashback_a50f3c48:

    # h "She was all I had."
    h "Ella era todo lo que tenía."

# game/Story01.rpy:4556

translate spanish flashback_97fc62d6:

    # C "Was there really no other way?"
    C "¿De verdad no había otra forma?"

# game/Story01.rpy:4558

translate spanish flashback_fdf08afd:

    # C "Or do your fists just solve everything now?"
    C "¿O ahora tus puños lo resuelven todo?"

# game/Story01.rpy:4560

translate spanish flashback_40ee8f43:

    # C "Hey, look at me when I’m talking to you!"
    C "¡Mírame cuando te hablo!"

# game/Story01.rpy:4564

translate spanish flashback_406ac9eb:

    # h "(I had a plan. A stupid one.)"
    h "(Tenía un plan. Uno estúpido.)"

# game/Story01.rpy:4565

translate spanish flashback_c460c903:

    # h "(Drop out. Get a job.)"
    h "(Dejar la escuela. Buscar trabajo.)"

# game/Story01.rpy:4566

translate spanish flashback_4c7178f3:

    # h "(Help us survive.)"
    h "(Ayudarnos a sobrevivir.)"

# game/Story01.rpy:4567

translate spanish flashback_478582b3:

    # h "(Pay for Anya’s future.)"
    h "(Pagar el futuro de Anya.)"

# game/Story01.rpy:4569

translate spanish flashback_6e3a2a53:

    # C "What?"
    C "¿Qué?"

# game/Story01.rpy:4573

translate spanish flashback_108b57fa:

    # h "What if I just quit school and got a job?"
    h "¿Y si simplemente dejo la escuela y consigo un trabajo?"

# game/Story01.rpy:4574

translate spanish flashback_c6d3564b:

    # h "Help Mom out a bit… take some weight off her."
    h "Ayudaría un poco a mamá... le quitaría peso de encima."

# game/Story01.rpy:4575

translate spanish flashback_b42633c4:

    # h "We could save up."
    h "Podríamos ahorrar."

# game/Story01.rpy:4576

translate spanish flashback_90beecad:

    # h "For your college."
    h "Para tu universidad."

# game/Story01.rpy:4577

translate spanish flashback_04fd245c:

    # h "You’ve always wanted that, right?"
    h "Siempre has querido eso, ¿verdad?"

# game/Story01.rpy:4579

translate spanish flashback_bcae5980:

    # C "Stop moving."
    C "Deja de moverte."

# game/Story01.rpy:4582

translate spanish flashback_2ee62f5f:

    # C "And no, you’re not dropping out."
    C "Y no, no vas a dejar la escuela."

# game/Story01.rpy:4583

translate spanish flashback_114377a9:

    # C "Don’t make dumb decisions because you think you’re helping."
    C "No tomes decisiones idiotas solo porque crees que estás ayudando."

# game/Story01.rpy:4585

translate spanish flashback_3c2c221a:

    # C "Because knowing you, you’d end up in some disgusting strip club."
    C "Porque conociendote, acabarías en un club de striptease asqueroso."

# game/Story01.rpy:4586

translate spanish flashback_44f322fb:

    # C "Or worse."
    C "O peor."

# game/Story01.rpy:4588

translate spanish flashback_37236d31:

    # h "She never sugarcoated anything."
    h "Nunca endulzaba nada."

# game/Story01.rpy:4589

translate spanish flashback_bb9aeb1b:

    # h "Brutally honest. Always."
    h "Brutalmente honesta. Siempre."

# game/Story01.rpy:4590

translate spanish flashback_1abf649c:

    # h "Still is."
    h "Todavía lo es."

# game/Story01.rpy:4592

translate spanish flashback_d59e39d7:

    # h "By the time I met [mc]… I was desperate."
    h "Para cuando conocí a [mc]... estaba desesperada."

# game/Story01.rpy:4593

translate spanish flashback_b6921fb0:

    # h "Tried everywhere."
    h "Lo intenté por todas partes."

# game/Story01.rpy:4595

translate spanish flashback_7ba70fa7:

    # h "Didn’t matter."
    h "No importaba."

# game/Story01.rpy:4596

translate spanish flashback_290d4dbf:

    # h "Every place wanted the same thing—"
    h "Todos los lugares pedían lo mismo..."

# game/Story01.rpy:4597

translate spanish flashback_d5ddaaa9:

    # h "a stupid piece of paper."
    h "un estúpido pedazo de papel."

# game/Story01.rpy:4598

translate spanish flashback_2d4d1c6a:

    # h "Even for a basic job."
    h "Incluso para un trabajo básico."

# game/Story01.rpy:4600

translate spanish flashback_775aa07a:

    # h "Then one night…"
    h "Entonces una noche..."

# game/Story01.rpy:4603

translate spanish flashback_ae2d9967:

    # h "Rain pouring like hell…"
    h "Llovía a mares..."

# game/Story01.rpy:4604

translate spanish flashback_a74f4b12:

    # h "I met him."
    h "Lo conocí."

# game/Story01.rpy:4608

translate spanish flashback_380ee27a:

    # h "(Back then I thought, what a weirdo.)"
    h "(En ese entonces pensé: vaya tipo raro.)"

# game/Story01.rpy:4614

translate spanish flashback_5f9dc4b5:

    # mc "My wife’s a crazy scientist… and I’m just a bar owner."
    mc "Mi esposa es una científica loca... y yo solo soy dueño de un bar."

# game/Story01.rpy:4618

translate spanish flashback_04a20166:

    # mc "Can’t even find someone to hire — funny, right?"
    mc "Ni siquiera encuentro a quién contratar. Gracioso, ¿no?"

# game/Story01.rpy:4619

translate spanish flashback_24fc11c3:

    # mc "Does that make me strange? Yeah."
    mc "¿Eso me hace raro? Sí."

# game/Story01.rpy:4620

translate spanish flashback_73e2a891:

    # mc "Do I care? Not really."
    mc "¿Me importa? No mucho."

# game/Story01.rpy:4622

translate spanish flashback_7927066a:

    # h "I couldn’t help it."
    h "No pude evitarlo."

# game/Story01.rpy:4628

translate spanish flashback_cc7141d6:

    # h "And I just…"
    h "Y yo solo..."

# game/Story01.rpy:4630

translate spanish flashback_e0dcd193:

    # h "laughed."
    h "me reí."

# game/Story01.rpy:4631

translate spanish flashback_5c6a93b5:

    # h "Because it made sense."
    h "Porque tenía sentido."

# game/Story01.rpy:4633

translate spanish flashback_2f93b5aa:

    # h "...He gave me a place."
    h "...me dio un lugar."

# game/Story01.rpy:4636

translate spanish flashback_a5ddb957:

    # h "A job."
    h "Un trabajo."

# game/Story01.rpy:4637

translate spanish flashback_8819c1fc:

    # h "Food that wasn’t stolen or expired."
    h "Comida que no estaba robada ni vencida."

# game/Story01.rpy:4638

translate spanish flashback_ec5a18b5:

    # h "And silence."
    h "Y silencio."

# game/Story01.rpy:4639

translate spanish flashback_d970b980:

    # h "No questions."
    h "Nada de preguntas."

# game/Story01.rpy:4640

translate spanish flashback_260b071a:

    # h "No judgment."
    h "Nada de juicios."

# game/Story01.rpy:4641

translate spanish flashback_a4a0c4c3:

    # h "Just… space."
    h "Solo... espacio."

# game/Story01.rpy:4643

translate spanish flashback_a117ba2b:

    # h "And sometimes…"
    h "Y a veces..."

# game/Story01.rpy:4646

translate spanish flashback_b7945ac3:

    # h "that’s all you need."
    h "eso es todo lo que necesitas."

# game/Story01.rpy:4647

translate spanish flashback_ada197cb:

    # h "To start again."
    h "Para empezar de nuevo."

# game/Story01.rpy:4659

translate spanish street3_55eaf2c1:

    # "Sector 5-S. Down in the Lower Level. The slums."
    "Sector 5-S. Nivel Inferior. Los barrios bajos."

# game/Story01.rpy:4662

translate spanish street3_43e90da0:

    # Fl "Oh please. It’s just a taxi."
    Fl "Ay, por favor. Es solo un taxi."

# game/Story01.rpy:4665

translate spanish street3_7850921f:

    # mc "We were diving straight down, headfirst."
    mc "Nos lanzamos en picada, de cabeza."

# game/Story01.rpy:4668

translate spanish street3_7e7db372:

    # Fl "Oh, relax. It wasn’t that bad."
    Fl "Relájate. No fue tan malo."

# game/Story01.rpy:4669

translate spanish street3_597243fd:

    # Fl "Well… for me, anyway."
    Fl "Bueno... para mí, de todos modos."

# game/Story01.rpy:4671

translate spanish street3_54d27906:

    # mc "Right… just casually mentioning we almost slammed into a couple of buildings."
    mc "Claro... solo menciono casualmente que casi nos estampamos contra un par de edificios."

# game/Story01.rpy:4672

translate spanish street3_aea38bf5:

    # Fl "So? Still shaking, or did your stomach finally find its assigned quadrant again?"
    Fl "¿Sigues temblando, o tu estómago ya volvió a su cuadrante designado?"

# game/Story01.rpy:4680

translate spanish street3_d896acfb:

    # mc "Mostly stable… though there’s still a bit left—"
    mc "Más o menos estable... aunque todavía queda un poco..."

# game/Story01.rpy:4684

translate spanish street3_87508c09:

    # Fl "Oh, that’s adorable."
    Fl "Ah, qué adorable."

# game/Story01.rpy:4687

translate spanish street3_a5883995:

    # Fl "Nothing like a near-death experience to really bring people together."
    Fl "Nada como una experiencia cercana a la muerte para unir a la gente."

# game/Story01.rpy:4689

translate spanish street3_bccb5115:

    # Fl "Take your time."
    Fl "Tómate tu tiempo."

# game/Story01.rpy:4690

translate spanish street3_f062043b:

    # Fl "This alley’s not going anywhere."
    Fl "Este callejón no va a ninguna parte."

# game/Story01.rpy:4692

translate spanish street3_81100454:

    # Fl "Smells like death, rust, and poor life choices."
    Fl "Huele a muerte, óxido y malas decisiones."

# game/Story01.rpy:4693

translate spanish street3_9a11bcbc:

    # Fl "You’ll fit right in."
    Fl "Encajarás enseguida."

# game/Story01.rpy:4696

translate spanish street3_a3c382ee:

    # Fl "Or are you developing a taste for dumpsters and industrial decay?"
    Fl "¿O estás desarrollando gusto por los contenedores y la decadencia industrial?"

# game/Story01.rpy:4708

translate spanish street3_ae80f9e0:

    # mc "Ha-ha."
    mc "Ja, ja."

# game/Story01.rpy:4709

translate spanish street3_eae824d4:

    # mc "Mocking the wounded. Very noble of you."
    mc "Burlarte del herido. Muy noble de tu parte."

# game/Story01.rpy:4710

translate spanish street3_92855003:

    # Fl "That?"
    Fl "¿Eso?"

# game/Story01.rpy:4715

translate spanish street3_2fd92dd4:

    # Fl "That’s our friendly neighborhood sky warden."
    Fl "Ese es nuestro amable guardián aéreo del vecindario."

# game/Story01.rpy:4717

translate spanish street3_7eadd775:

    # Fl "It scans everything."
    Fl "Lo escanea todo."

# game/Story01.rpy:4722

translate spanish street3_14ff8652:

    # Fl "Docs, DNA… probably your worst decisions too."
    Fl "Documentos, ADN... probablemente tus peores decisiones también."

# game/Story01.rpy:4724

translate spanish street3_07a7eea9:

    # Fl "And if something doesn’t line up?"
    Fl "¿Y si algo no cuadra?"

# game/Story01.rpy:4725

translate spanish street3_4c460073:

    # Fl "It calls in backup."
    Fl "Pide refuerzos."

# game/Story01.rpy:4727

translate spanish street3_c03a34fd:

    # Fl "Unless it glitches."
    Fl "A menos que falle."

# game/Story01.rpy:4728

translate spanish street3_2b914252:

    # Fl "Which it does."
    Fl "Y falla."

# game/Story01.rpy:4730

translate spanish street3_4f97edde:

    # Fl "More often than they’ll ever admit."
    Fl "Más a menudo de lo que admitirán."

# game/Story01.rpy:4732

translate spanish street3_23ac2ec0:

