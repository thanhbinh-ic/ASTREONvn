    Fl "No te hagas el tonto."

# game/Story01.rpy:4764

translate spanish street3_e77f6c37:

    # Fl "I mean the Ark."
    Fl "Me refiero al Arca."

# game/Story01.rpy:4767

translate spanish street3_c82693a7:

    # mc "The Ark?"
    mc "¿El Arca?"

# game/Story01.rpy:4768

translate spanish street3_088a7b28:

    # mc "Looks like a ship, I guess?"
    mc "Parece una nave, supongo."

