translate spanish bar_cyber_a37c6ffd:

    # re "Miss Ivy, good evening. This gentleman doesn’t have a pass, and as you know, I can’t let him in without proper authorization."
    re "Señorita Ivy, buenas noches. Este caballero no tiene pase y, como sabe, no puedo dejarlo entrar sin la autorización adecuada."

