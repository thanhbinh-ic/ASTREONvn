translate spanish final2_d6fce480:

    # o "She disappeared."
    o "Desapareció."

# game/Story01.rpy:7803

translate spanish final2_ef8eaf26:

    # o "Just vanished without a trace. We had to figure things out as we went — blind, with no real sense of what we were walking into."
    o "Simplemente desapareció sin dejar rastro. Tuvimos que improvisar sobre la marcha: a ciegas, sin saber realmente en qué nos estábamos metiendo."

# game/Story01.rpy:7812

translate spanish final2_631b7025:

    # o "Same story — nothing."
    o "Lo mismo: nada."

# game/Story01.rpy:7813

