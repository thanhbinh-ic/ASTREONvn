translate spanish final2_75db3a77:

    # Mi "I followed the tracks. They led to a narrow passage, half-buried. Someone’s using it."
    Mi "Seguí las huellas. Llevaban a un pasaje estrecho, medio enterrado. Alguien lo está usando."

# game/Story01.rpy:7538

translate spanish final2_3235b5e6:

    # h "Could it be the rest of our team? Maybe they left their things and moved on?"
    h "¿Podría ser el resto de nuestro equipo? Quizá dejaron sus cosas y siguieron adelante."

# game/Story01.rpy:7540

translate spanish final2_324f9ddf:

    # Mi "Doubtful. Our group went the opposite way. And this site — it’s not abandoned. It’s lived in."
    Mi "Lo dudo. Nuestro grupo fue en la dirección contraria. Y este lugar no está abandonado. Está habitado."

# game/Story01.rpy:7542

translate spanish final2_5180fa3d:

    # mc "Then maybe someone from the surface found a way down. Or they know a path we don’t."
    mc "Entonces quizá alguien de la superficie encontró una forma de bajar. O conocen un camino que nosotros no."

# game/Story01.rpy:7544

translate spanish final2_870caf61:

    # Mi "That’s one possibility. But we won’t know until we see for ourselves."
    Mi "Es una posibilidad. Pero no lo sabremos hasta verlo con nuestros propios ojos."

# game/Story01.rpy:7545

translate spanish final2_5e35a3fd:

    # Mi "Let’s move."
    Mi "En marcha."

# game/Story01.rpy:7553

translate spanish final2_d6259409:

    # h "...I don’t like this. We’re really going in there?"
    h "...No me gusta esto. ¿De verdad vamos a entrar ahí?"

# game/Story01.rpy:7556

translate spanish final2_080c491c:

    # Mi "We don’t have a choice."
    Mi "No tenemos elección."

# game/Story01.rpy:7558

translate spanish final2_0da11e4c:

    # Mi "I'll go ahead and see what's happening. You stay here."
    Mi "Iré delante a ver qué ocurre. Ustedes quédense aquí."

# game/Story01.rpy:7559

translate spanish final2_5aad9394:

    # Mi "If I'm not back in a few minutes, leave without me."
    Mi "Si no vuelvo en unos minutos, váyanse sin mí."

# game/Story01.rpy:7561

translate spanish final2_b68536cc:

    # mc "If we split now, we risk more than just getting lost. We stay together."
    mc "Si nos separamos ahora, arriesgamos algo peor que perdernos. Seguimos juntos."

# game/Story01.rpy:7562

translate spanish final2_7475c7f3:

    # Mi "...Alright."
    Mi "...De acuerdo."

# game/Story01.rpy:7589

translate spanish final2_5f92552c:

    # Fl "Connect. Just connect already, damn you!"
    Fl "Conéctate. ¡Conéctate ya, maldita sea!"

# game/Story01.rpy:7592

translate spanish final2_b7b5e100:

    # Fl "I entered everything right! Why won’t you work!?"
    Fl "¡Lo ingresé todo bien! ¿Por qué no funcionas?"

# game/Story01.rpy:7593

translate spanish final2_af3b171e:

    # Fl "This interface is garbage. Who designed this crap—"
    Fl "Esta interfaz es una basura. ¿Quién diseñó esta porquería...?"

# game/Story01.rpy:7596

translate spanish final2_137b065c:

    # a "Need a hand?"
    a "¿Necesitas una mano?"

# game/Story01.rpy:7598

translate spanish final2_4dd61ae8:

    # Fl "Honestly? Yes. As long as you don’t slow me down."
    Fl "¿Honestamente? Sí. Mientras no me ralentices."

# game/Story01.rpy:7600

translate spanish final2_c3e68a78:

    # a "Always this charming, or am I just special?"
    a "¿Siempre eres así de encantadora, o soy especial?"

# game/Story01.rpy:7602

translate spanish final2_565b99da:

    # Fl "This is my charming. Got a problem with it?"
    Fl "Este es mi encanto. ¿Tienes algún problema?"

# game/Story01.rpy:7608

translate spanish final2_8a5833bc:

    # a "Not at all. I find it... endearing."
    a "Para nada. Me parece... adorable."

# game/Story01.rpy:7610

translate spanish final2_d77d3973:

    # i "It’s been a long time, hasn’t it?"
    i "Ha pasado mucho tiempo, ¿no?"

# game/Story01.rpy:7612

translate spanish final2_83492fd7:

    # Fl "...So it’s you."
    Fl "...Así que eres tú."

# game/Story01.rpy:7616

translate spanish final2_a231f65d:

    # i "Yeah. It’s me. What’s the issue?"
    i "Sí. Soy yo. ¿Cuál es el problema?"

# game/Story01.rpy:7618

translate spanish final2_34a2443b:

    # Fl "Aside from this junk terminal? Protocol conflict. System keeps throwing a 418."
    Fl "¿Aparte de esta terminal basura? Conflicto de protocolo. El sistema no deja de lanzar un 418."

# game/Story01.rpy:7619

translate spanish final2_bf04ab11:

    # Fl "I’ve cleared cache, rerouted DNS, even bypassed the firewall. Still nothing."
    Fl "Limpié la caché, redirigí el DNS e incluso salté el cortafuegos. Y nada."

# game/Story01.rpy:7622

translate spanish final2_d22ae0b1:

    # Fl "And the worst part? It connects sometimes. Like it’s being sabotaged."
    Fl "¿Y lo peor? A veces conecta. Como si alguien lo estuviera saboteando."

# game/Story01.rpy:7624

translate spanish final2_96ed76fc:

    # i "Or the signal’s unstable."
    i "O la señal es inestable."

# game/Story01.rpy:7625

translate spanish final2_5c80c6a7:

    # i "Let me take a look. I have a few tricks you haven’t ruined yet."
    i "Déjame echar un vistazo. Tengo algunos trucos que no has arruinado todavía."

# game/Story01.rpy:7637

translate spanish final2_6e60a2e8:

    # Mi "This is worse than anything I imagined."
    Mi "Esto es peor de lo que imaginé."

# game/Story01.rpy:7638

translate spanish final2_41acee31:

    # Mi "We're standing... right in the heart of it."
    Mi "Estamos... justo en el corazón de todo."

# game/Story01.rpy:7640

translate spanish final2_8c229f3d:

    # Mi "This is where they're made. These creatures — this is their birthplace."
    Mi "Aquí las fabrican. Estas criaturas... nacen aquí."

# game/Story01.rpy:7643

translate spanish final2_d8c1e1b6:

    # Mi "No wonder we couldn’t trace them. Their origin was never out there. It was always buried right beneath us."
    Mi "Con razón no pudimos rastrearlas. Su origen nunca estuvo ahí fuera. Siempre estuvo enterrado justo bajo nosotros."

# game/Story01.rpy:7647

translate spanish final2_20a51363:

    # mc "Footsteps. Approaching."
    mc "Pasos. Se acercan."

# game/Story01.rpy:7648

translate spanish final2_0e9b7fcc:

    # Mi "I’ll take point."
    Mi "Yo iré al frente."

# game/Story01.rpy:7656

translate spanish final2_1077e677:

    # mc "Stay sharp. Could be anything. Or anyone."
    mc "Manténganse alerta. Podría ser cualquier cosa. O cualquiera."

# game/Story01.rpy:7661

translate spanish final2_6c78ac0b:

    # mc "(Slow… controlled breaths. No sudden moves…)"
    mc "(Respira despacio... controlado. Sin movimientos bruscos...)"

# game/Story01.rpy:7668

translate spanish final2_1431b751:

    # mc "Oh — wait. It’s you. We thought—"
    mc "Oh... espera. Eres tú. Pensamos que..."

# game/Story01.rpy:7678

translate spanish final2_2dbd8587:

    # Mi "No. Not again."
    Mi "No, otra vez no."

# game/Story01.rpy:7681

translate spanish final2_9aecfad7:

    # Mi "I’ve already lost enough to this trick. I’m not falling for it twice."
    Mi "Ya perdí demasiado por culpa de este truco. No volveré a caer."

# game/Story01.rpy:7684

translate spanish final2_88ca1d17:

    # h "Wh—what the hell? That looked like Ostorius! But it wasn’t, was it? What was that?!"
    h "¿Q-qué demonios? ¡Parecía Ostorius! Pero no lo era, ¿verdad? ¿Qué fue eso?"

# game/Story01.rpy:7686

translate spanish final2_2657d095:

    # Mi "A mimic."
    Mi "Un imitador."

# game/Story01.rpy:7687

translate spanish final2_00e0a32c:

    # Mi "It imitates human appearances. A very nasty opponent. There's nothing worse than it."
    Mi "Imita apariencias humanas. Un rival muy desagradable. No hay nada peor."

# game/Story01.rpy:7690

translate spanish final2_e8f49715:

    # mc "So it pulls from memory? Does it need to see the person first? Then… why Ostorius? Out of everyone?"
    mc "¿Entonces saca la forma de tus recuerdos? ¿Primero tiene que haber visto a esa persona? Entonces... ¿por qué Ostorius? ¿Entre todos?"

# game/Story01.rpy:7692

translate spanish final2_73c135fd:

    # Mi "It has a very troubling ability. It picks someone from your memories to whom you are most attached."
    Mi "Tiene una habilidad muy inquietante. Elige de tus recuerdos a la persona a la que estás más unido."

# game/Story01.rpy:7693

translate spanish final2_a50dedd9:

    # Mi "However, it must have seen that person in person before."
    Mi "Pero antes tiene que haberla visto en persona."

# game/Story01.rpy:7695

translate spanish final2_d46e5d38:

    # Mi "I hope to hell the second group is still alive. But right now — we need answers."
    Mi "Espero de verdad que el segundo grupo siga vivo. Pero ahora mismo necesitamos respuestas."

# game/Story01.rpy:7700

translate spanish final2_ab21fd38:

    # mc "This whole place... these things... they weren’t born. They were built. Engineered."
    mc "Todo este lugar... estas cosas... no nacieron. Las fabricaron. Las diseñaron."

# game/Story01.rpy:7701

translate spanish final2_0c39750b:

    # mc "But why? What kind of mind creates something like this?"
    mc "¿Pero por qué? ¿Qué clase de mente crea algo así?"

# game/Story01.rpy:7704

translate spanish final2_28cf7a9d:

    # Mi "That’s what we need to find out."
    Mi "Eso es lo que necesitamos averiguar."

# game/Story01.rpy:7706

translate spanish final2_641384d2:

    # h "But this facility is enormous! Someone would’ve noticed — this couldn’t have stayed hidden!"
    h "¡Pero esta instalación es enorme! Alguien habría notado algo. ¡Esto no pudo permanecer oculto!"

# game/Story01.rpy:7709

translate spanish final2_ac5632c4:

    # Mi "I never knew this place existed. Not a single record, not a whisper."
    Mi "Nunca supe que este lugar existía. Ni un solo registro, ni un rumor."

# game/Story01.rpy:7710

translate spanish final2_c4f2b907:

    # Mi "Flora might know more, but the signal’s dead — jammed beyond reach."
    Mi "Flora quizá sepa más, pero la señal está muerta: bloqueada fuera de nuestro alcance."

# game/Story01.rpy:7717

translate spanish final2_6674de0e:

    # mc "What kind of restrictions are we talking about?"
    mc "¿De qué tipo de restricciones estamos hablando?"

# game/Story01.rpy:7719

translate spanish final2_49eb64cb:

    # mc "No… please don’t mean—"
    mc "No... por favor, no será..."

# game/Story01.rpy:7724

translate spanish final2_0bde224b:

    # mc "Of course. Of course it’s this."
    mc "Por supuesto. Por supuesto que es esto."

# game/Story01.rpy:7734

translate spanish final2_53c06205:

    # h "We need to get out — now! We’re outgunned, outmatched, out of time!"
    h "¡Tenemos que salir ya! ¡Nos superan en armas, en fuerza y en tiempo!"

# game/Story01.rpy:7736

translate spanish final2_fbb96769:

    # mc "The exits are sealed. There’s no way back. Then we fight."
    mc "Las salidas están selladas. No hay vuelta atrás. Entonces luchamos."

# game/Story01.rpy:7737

translate spanish final2_98d9017a:

    # mc "If we’re dying in this pit, we’re taking them with us."
    mc "Si vamos a morir en este pozo, nos los llevaremos con nosotros."

# game/Story01.rpy:7739

translate spanish final2_cfbc118c:

    # mc "(I’m not dying here. Not in this goddamn grave!)"
    mc "(No voy a morir aquí. ¡No en esta maldita tumba!)"

# game/Story01.rpy:7758

translate spanish final2_7f1b6a0a:

    # o "Fall back! We’ve got your flank!"
    o "¡Retrocedan! ¡Les cubrimos el flanco!"

# game/Story01.rpy:7762

translate spanish final2_3567ea4f:

    # mc "Olivia, go! Now! I’ll hold the line!"
    mc "¡Olivia, ve! ¡Ahora! ¡Yo aguanto la línea!"

# game/Story01.rpy:7764

translate spanish final2_f8be1bcf:

    # h "On it!"
    h "¡Voy!"

# game/Story01.rpy:7766

translate spanish final2_add9aae9:

    # mc "Miriel — on three, head for the stairs."
    mc "Miriel, a la de tres, a las escaleras."

# game/Story01.rpy:7768

translate spanish final2_c1f75860:

    # mc "Three!"
    mc "¡Tres!"

# game/Story01.rpy:7772

translate spanish final2_79c2b117:

    # mc "Go! Keep moving! Don’t stop!"
    mc "¡Vamos! ¡No pares!"

# game/Story01.rpy:7781

translate spanish final2_2507e3dc:

    # o "You’re the last one — move it!"
    o "¡Eres el último, muévete!"

# game/Story01.rpy:7784

translate spanish final2_1513939c:

    # o "Don’t play hero! We need you alive!"
    o "¡No juegues a héroe! ¡Te necesitamos vivo!"

# game/Story01.rpy:7790

translate spanish final2_0cdf124e:

    # o "That’s it — everyone out!"
    o "Eso es, ¡todos fuera!"

# game/Story01.rpy:7797

translate spanish final2_ed9d8db6:

    # o "RUN! DON’T LOOK BACK!"
    o "¡CORRAN! ¡NO MIREN ATRÁS!"

# game/Story01.rpy:7803

translate spanish final2_f2ce8c8b:

    # g "(Where the hell are they—)"
    g "(¿Dónde demonios están...?)"

# game/Story01.rpy:7805

translate spanish final2_79127a32:

    # o "Detonate it! NOW!"
    o "¡Detónenlo! ¡AHORA!"

# game/Story01.rpy:7819

translate spanish final2_d12d5a1d:

    # o "You alright?"
    o "¿Estás bien?"

# game/Story01.rpy:7821

translate spanish final2_d7011f70:

    # mc "Breathing. Thanks to you."
    mc "Respirando, gracias a ti."

# game/Story01.rpy:7822

translate spanish final2_829382cd:

    # mc "But how? How did you even find us? We took a completely different route."
    mc "Pero ¿cómo? ¿Cómo nos encontraste? Tomamos una ruta completamente distinta."

# game/Story01.rpy:7824

translate spanish final2_d542108e:

    # o "We were tailing the Inquisitor. Everything was fine — until she changed course."
    o "Íbamos siguiendo a la inquisidora. Todo iba bien... hasta que cambió de rumbo."

# game/Story01.rpy:7825

translate spanish final2_367aa697:

    # o "That’s when we stumbled across this... this place."
    o "Así fue como dimos con este... este lugar."

# game/Story01.rpy:7827

translate spanish final2_c1e9601f:

    # mc "And then?"
    mc "¿Y entonces?"

# game/Story01.rpy:7829

translate spanish final2_a782a445:

    # o "She vanished. No sound. No trace. Just — gone."
    o "Desapareció. Sin ruido. Sin rastro. Simplemente... se fue."

# game/Story01.rpy:7830

translate spanish final2_62af0951:

    # o "We had to figure things out as we went — blind, with no real sense of what we were walking into."
    o "Tuvimos que improvisar sobre la marcha: a ciegas, sin saber realmente en qué nos estábamos metiendo."

# game/Story01.rpy:7832

translate spanish final2_122dc951:

    # mc "So… what is this place?"
    mc "Entonces... ¿qué es este lugar?"

# game/Story01.rpy:7834

translate spanish final2_ab538b39:

    # o "No clue. And that terrifies me more than anything."
    o "Ni idea. Y eso me aterra más que cualquier otra cosa."

# game/Story01.rpy:7836

translate spanish final2_9890ce48:

    # mc "And the jammer? Were you able to destroy it?"
    mc "¿Y el interferidor? ¿Pudieron destruirlo?"

# game/Story01.rpy:7839

translate spanish final2_bac6552f:

    # o "No. We couldn’t even find it."
    o "No. Ni siquiera lo encontramos."

# game/Story01.rpy:7840

translate spanish final2_0bd17023:

    # o "This place... it plays tricks on you. On your head. Everything feels... off."
    o "Este lugar... juega con tu cabeza. Todo se siente... mal."

# game/Story01.rpy:7842

translate spanish final2_75e19450:

    # h "Is it just me, or is this entire place something out of a nightmare?"
    h "¿Soy yo, o este lugar entero parece salido de una pesadilla?"

# game/Story01.rpy:7843

translate spanish final2_d4655148:

    # h "How could something this big stay hidden? It makes no sense."
    h "¿Cómo pudo algo tan grande permanecer oculto? No tiene sentido."

# game/Story01.rpy:7848

translate spanish final2_e2f5bbed:

    # mc "What the hell is that thing…?"
    mc "¿Qué demonios es esa cosa?"

# game/Story01.rpy:7850

translate spanish final2_8ba30327:

    # Fl "Soulless. Mutants driven by hunger and rage. And no one knows where they came from."
    Fl "Desalmados. Mutantes impulsados por el hambre y la rabia. Y nadie sabe de dónde salieron."

# game/Story01.rpy:7853

translate spanish final2_781d0184:

    # mc "When did they start appearing?"
    mc "¿Cuándo empezaron a aparecer?"

# game/Story01.rpy:7855

translate spanish final2_7ac6bf55:

    # h "Don’t start with your conspiracies again…"
    h "No empieces con tus conspiraciones otra vez..."

# game/Story01.rpy:7857

translate spanish final2_4012f46e:

    # mc "Olivia, not now! I’m serious."
    mc "Olivia, ¡ahora no! Hablo en serio."

# game/Story01.rpy:7860

translate spanish final2_b5d814bc:

    # sci "The Inquisition! They’ve found out about our plans!"
    sci "¡La Inquisición! ¡Han descubierto nuestros planes!"

# game/Story01.rpy:7862

translate spanish final2_aba904e7:

    # sci "The Inquisition believes we are behind the appearance of those monsters."
    sci "La Inquisición cree que estamos detrás de la aparición de esos monstruos."

# game/Story01.rpy:7865

translate spanish final2_7aba4958:

    # mc "These creatures — did they appear after Lora’s got here?"
    mc "Estas criaturas... ¿aparecieron después de que Lora llegara aquí?"

# game/Story01.rpy:7869

translate spanish final2_14a2b5f1:

    # R "Vital signs stable. No anomalies. We’re nearly there."
    R "Signos vitales estables. Sin anomalías. Ya casi estamos."

# game/Story01.rpy:7871

translate spanish final2_2afaa6bd:

    # R "Everything is unfolding exactly as predicted."
    R "Todo se desarrolla exactamente como se predijo."

# game/Story01.rpy:7872

translate spanish final2_4d8473b0:

    # R "Honestly, disabling their signal matrix was a stroke of genius. I should thank you."
    R "Sinceramente, desactivar su matriz de señal fue una genialidad. Debería darte las gracias."

# game/Story01.rpy:7875

translate spanish final2_dc0dc242:

    # o "Are you saying… your team caused this?!"
    o "¿Estás diciendo... que tu equipo causó esto?"

# game/Story01.rpy:7877

translate spanish final2_2a4c14e4:

    # o "That’s madness — even for them!"
    o "Eso es una locura, ¡incluso para ellos!"

# game/Story01.rpy:7881

translate spanish final2_5473849e:

    # a "Why? Why betray us? We gave you everything — everything you asked for!"
    a "¿Por qué? ¿Por qué traicionarnos? ¡Te dimos todo, todo lo que pediste!"

# game/Story01.rpy:7883

translate spanish final2_c5004c16:

    # R "Everything? You gave me a corner in the lab and a reminder of what I used to be."
    R "¿Todo? Me dieron un rincón en el laboratorio y un recordatorio de lo que solía ser."

# game/Story01.rpy:7884

translate spanish final2_ef66bbfd:

    # R "While she roams the stars — {b}my{/b} post, {b}my{/b} research — they handed everything to her."
    R "Mientras ella recorre las estrellas, {b}mi{/b} puesto, {b}mi{/b} investigación... se lo entregaron todo a ella."

# game/Story01.rpy:7886

translate spanish final2_1c1d640d:

    # R "You all expected me to just fade into the background. Accept my new role like a good little servant."
    R "Todos esperaban que me desvaneciera en segundo plano. Que aceptara mi nuevo papel como un buen sirviente."

# game/Story01.rpy:7887

translate spanish final2_55cca784:

    # R "But I’m done waiting for scraps. I took the one opportunity left to me."
    R "Pero me cansé de esperar sobras. Tomé la única oportunidad que me quedaba."

# game/Story01.rpy:7888

translate spanish final2_ab280420:

    # R "Call it betrayal if you want. I call it reclamation."
    R "Llámalo traición si quieres. Yo lo llamo recuperar lo mío."

# game/Story01.rpy:7890

translate spanish final2_1148c888:

    # a "You’re insane. The Mistress will hear of this — she’ll end it."
    a "Estás loco. La Señora se enterará de esto. Ella le pondrá fin."

# game/Story01.rpy:7899

translate spanish final2_7e1c58aa:

    # ab "She won’t hear a thing. And even if she does…"
    ab "No oirá nada, y aunque lo haga..."

# game/Story01.rpy:7900

translate spanish final2_911d4356:

    # ab "She’ll die with the rest of them."
    ab "Morirá con el resto de ellos."

# game/Story01.rpy:7903

translate spanish final2_58569527:

    # ab "Send her my regards."
    ab "Envíale mis saludos."

# game/Story01.rpy:7905

translate spanish final2_606e5c32:

    # o "What did you find? What’s written there?!"
    o "¿Qué encontraste? ¿Qué dice ahí?"

# game/Story01.rpy:7906

translate spanish final2_6899359a:

    # Mi "They’re… they’re planning to—"
    Mi "Están... están planeando..."

# game/Story01.rpy:7908

translate spanish final2_d14b0df1:

    # Mi "no… {w=1.2} No {w=0.8} No {w=0.4} NO {w=0.1} NO — IT CAN’T BE!"
    Mi "No... {w=1.2} No {w=0.8} No {w=0.4} NO {w=0.1} NO... ¡NO PUEDE SER!"

# game/Story01.rpy:7909

translate spanish final2_009717ec:

    # o "WHAT?! WHAT ARE THEY PLANNING?!"
    o "¿¡QUÉ!? ¿¡QUÉ ESTÁN PLANEANDO!?"

# game/Story01.rpy:7911

translate spanish final2_ec4183b3:

    # Mi "They’re going to—"
    Mi "Van a..."

# game/Story01.rpy:7913

translate spanish final2_a16c34b5:

    # R "Synchronization complete. Proceed."
    R "Sincronización completa. Procedan."

# game/Story01.rpy:7915

translate spanish final2_81554771:

    # Mi "Sacrifice the entire planet."
    Mi "Sacrificar el planeta entero."

# game/Story01.rpy:7947

translate spanish final2_f71829b0:

    # n "Also if you liked my game, and wanted to support me, than welcome to my patreon or subscribestar. (Feels shy to say that tbh)"
    n "Además, si te gustó mi juego y quieres apoyarme, eres bienvenido en mi Patreon o SubscribeStar. (Me da un poco de vergüenza decirlo, la verdad.)"

translate spanish laborat_b740bb8e:

    # mc "(That voice... feeling that I know him from somewhere... but where?)"
    mc "(Esa voz... sentimiento de que lo conozco desde algún lugar... pero ¿dónde?)"

# game/Story01.rpy:6516

translate spanish gate4_7378154d:

    # o "We’re not just racing time. We’re racing death."
    o "No solo estamos a tiempo de correr. Estamos corriendo la muerte."

# game/Story01.rpy:6519

translate spanish gate4_c067a525:

    # g "Visibility’s zero. We’re flying blind down here. One wrong turn and we vanish."
    g "Visibilidad cero. Estamos volando ciegos aquí abajo. Un giro equivocado y nos desaparecimos."

# game/Story01.rpy:6521

translate spanish gate4_2f83375b:

    # o "Then stay close and don’t fall behind. One step at a time."
    o "Entonces manténte cerca y no te quedes atrás. Un paso a la vez."

# game/Story01.rpy:6523

translate spanish gate4_0a951948:

    # mc "Where do we go from here?"
    mc "¿A dónde vamos desde aquí?"

# game/Story01.rpy:6525

translate spanish gate4_9c3c43bf:

    # o "The nav-device still works locally."
    o "El dispositivo de nav todavía funciona localmente."

# game/Story01.rpy:6527

translate spanish gate4_99bb152f:

    # o "Without that, as already stated, we’re walking corpses."
    o "Sin eso, como ya se ha dicho, estamos caminando cadáveres."

# game/Story01.rpy:6534

translate spanish gate4_cbb8280b:

    # o "Target’s a couple kilometers east."
    o "Target está a un par de kilómetros al este."

# game/Story01.rpy:6537

translate spanish gate4_6925682d:

    # o "Shortest path is through this tunnel."
    o "El camino más corto es a través de este túnel."

# game/Story01.rpy:6540

translate spanish gate4_b8d335f9:

    # g "That one? It's a coffin waiting to collapse. A single shot and we’re rubble."
    g "Este es un ataúd que está a punto de colapsar, un tiro y nos convertiremos en escombros."

# game/Story01.rpy:6541

translate spanish gate4_ea5a3c22:

    # o "Options?"
    o "¿Opciones?"

# game/Story01.rpy:6543

translate spanish gate4_081183f2:

    # g "We take the service route. Slower, but reinforced."
    g "Tomamos la ruta de servicio, más despacio, pero reforzado."

# game/Story01.rpy:6547

translate spanish gate4_475e0d4c:

    # g "Though... there’s something in there. Something we don’t talk about."
    g "Aunque... hay algo ahí dentro. Algo de lo que no hablamos."

# game/Story01.rpy:6548

translate spanish gate4_12250000:

    # o "How bad?"
    o "¿Qué tan malo?"

# game/Story01.rpy:6549

translate spanish gate4_9f9281aa:

    # g "Deadly bad."
    g "Qué pena."

# game/Story01.rpy:6552

translate spanish gate4_cd33cf63:

    # o "Check your ammo. I want numbers."
    o "Mira tu munición, quiero números."

# game/Story01.rpy:6554

translate spanish gate4_330bf7f4:

    # gg "Five shells for the launcher. Seven mags each for rifles."
    gg "Cinco conchas para el lanzador, siete magos cada uno para rifles."

# game/Story01.rpy:6556

translate spanish gate4_81bd3f7a:

    # o "Good. And you?"
    o "Bien. ¿Y tú?"

# game/Story01.rpy:6558

translate spanish gate4_38fb36e6:

    # mc "Locked, loaded, and not in the mood to die."
    mc "Encerrado, cargado, y no en el estado de ánimo de morir."

# game/Story01.rpy:6561

translate spanish gate4_2fded262:

    # h "..."
    h "..."

# game/Story01.rpy:6563

translate spanish gate4_90172481:

    # h "Same. Let’s get this over with."
    h "Lo mismo. Terminemos con esto."

# game/Story01.rpy:6565

translate spanish gate4_93ea3243:

    # o "We take the service tunnel. Brace yourselves."
    o "Tomamos el túnel de servicio."

# game/Story01.rpy:6571

translate spanish gate4_2917e4a1:

    # o "Right turn ahead. No contacts — wait... entrance in sight."
    o "No hay contactos, espera, entrada a la vista."

# game/Story01.rpy:6573

translate spanish gate4_e194124b:

    # o "Clear, for now."
    o "Despejado, por ahora."

# game/Story01.rpy:6576

translate spanish gate4_e132ebc4:

    # Mi "So this is it."
    Mi "Así que esto es todo."

# game/Story01.rpy:6579

translate spanish gate4_1439ecf6:

    # o "Best shot we’ve got. It’s stable. Safer. But what’s inside... that’s another story."
    o "El mejor disparo que tenemos. Es estable. Más seguro. Pero lo que hay dentro... es otra historia."

# game/Story01.rpy:6582

translate spanish gate4_634d4cba:

    # mc "Who’s in there?"
    mc "¿Quién está ahí?"

# game/Story01.rpy:6588

translate spanish gate4_c02654f5:

    # Mi "They didn’t brief you?"
    Mi "¿No te han informado?"

# game/Story01.rpy:6590

translate spanish gate4_365d91cd:

    # mc "Apparently not."
    mc "Aparentemente no."

# game/Story01.rpy:6592

translate spanish gate4_2fc435ad:

    # Mi "I think it’s worth explaining."
    Mi "Creo que vale la pena explicarlo."

# game/Story01.rpy:6594

translate spanish gate4_ba134435:

    # o "Agreed..."
    o "De acuerdo..."

# game/Story01.rpy:6595

translate spanish gate4_3e1d8182:

    # o "Let’s just say we’ve got neighbors — underground neighbors."
    o "Digamos que tenemos vecinos — vecinos subterráneos."

# game/Story01.rpy:6596

translate spanish gate4_4ac8d953:

    # o "They’re not exactly the friendly sort. Aggressive, irritable, and very territorial."
    o "No son exactamente el tipo amistoso. Agresivo, irritable, y muy territorial."

# game/Story01.rpy:6597

translate spanish gate4_2f2d1e99:

    # o "They don’t take kindly to trespassers."
    o "No se llevan amablemente a los transeúntes."

# game/Story01.rpy:6599

translate spanish gate4_4fba006b:

    # gg "Or we stop wasting time and just blow the damn thing open."
    gg "O dejamos de perder el tiempo y volamos la maldita cosa abierta."

# game/Story01.rpy:6600

translate spanish gate4_e150faa4:

    # g "You and your explosives... There. It’s open."
    g "Tú y tus explosivos... ahí."

# game/Story01.rpy:6602

translate spanish gate4_b61b900f:

    # g "Let’s move. Stay close. Eyes forward."
    g "Vamos. Mantente cerca. Ojos hacia adelante."

# game/Story01.rpy:6611

translate spanish gate4_2fbe79db:

    # h "It’s so dark down here… like we’ve stepped into the lungs of the world — damp, suffocating."
    h "Está tan oscuro aquí abajo... como hemos entrado en los pulmones del mundo — húmedo, asfixiante."

# game/Story01.rpy:6612

translate spanish gate4_01bec60a:

    # Mi "You’ll get used to it. Or you won’t."
    Mi "Te acostumbrarás a ello. O no lo harás."

# game/Story01.rpy:6613

translate spanish gate4_d993f687:

    # Mi "Either way, complaining won’t change it."
    Mi "De cualquier manera, quejarse no lo cambiará."

# game/Story01.rpy:6615

translate spanish gate4_6edc0a1a:

    # mc "She’s right. Vision’s shot. Sound’s bouncing like it’s mocking us."
    mc "Tiene razón. El disparo de Visión. El sonido rebota como si nos estuviera burlando."

# game/Story01.rpy:6617

translate spanish gate4_9b5bcd8c:

    # o "Eyes forward. Sound off. Headcount."
    o "Ojos hacia adelante, sonar fuera."

# game/Story01.rpy:6622

translate spanish gate4_ce9bb854:

    # o "No stragglers. We move as one. Stay alert. Crawlers nest in the walls. They don’t like visitors."
    o "No hay rezagados. Nos movemos como uno. Mantenga la alerta. Los agricultores anidan en las paredes. No les gustan los visitantes."

# game/Story01.rpy:6625

translate spanish gate4_7f3cfbd6:

    # h "Crawlers? What is this, a haunted mine? Are they dirt-eating mole-people or actual monsters?"
    h "¿Qué es esto, una mina embrujada? ¿Están comendo gente de lunares o monstruos reales?"

# game/Story01.rpy:6628

translate spanish gate4_05ede682:

    # Mi "Arachnoid-class organisms. Fast. Territorial. And very, very real."
    Mi "Organismos de clase arquinoide."

# game/Story01.rpy:6631

translate spanish gate4_269ba42e:

    # mc "Spiders? That’s what we’re worried about?"
    mc "¿Arañas? ¿Eso es lo que nos preocupa?"

# game/Story01.rpy:6634

translate spanish gate4_61405e35:

    # Mi "The young ones? One to five meters. Adults range from five to ten. The elders… they’ve outgrown fear."
    Mi "Los jóvenes? Uno a cinco metros. Los adultos van de cinco a diez. Los ancianos... han superado el miedo."

# game/Story01.rpy:6637

translate spanish gate4_641908b0:

    # h "The size of a dropship?! Come on. That’s myth-level exaggeration."
    h "¿El tamaño de una gota?! Vamos. Eso es exageración de nivel mito."

# game/Story01.rpy:6639

translate spanish gate4_bb523d22:

    # Mi "You’ll believe it when your lungs stop working and you realize the shadow above you isn’t the ceiling."
    Mi "Lo creerás cuando tus pulmones dejen de funcionar y te das cuenta de que la sombra que hay encima no es el techo."

# game/Story01.rpy:6641

translate spanish gate4_a435bb54:

    # o "Cut the chatter. This place wasn’t always like this. Nine years ago, we tried to reclaim these tunnels."
    o "Cortar el chatter. Este lugar no siempre fue así. Hace nueve años, intentamos recuperar estos túneles."

# game/Story01.rpy:6643

translate spanish gate4_7e1693fe:

    # o "Council said they were ‘just bugs.’ Sent us down with light rifles and empty promises."
    o "El Consejo dijo que eran \"solo errores\". Nos envió con rifles ligeros y promesas vacías."

# game/Story01.rpy:6645

translate spanish gate4_0e9f63c8:

    # o "By the time we realized what we were up against, the tunnels had become a tomb."
    o "Para cuando nos dimos cuenta de lo que estábamos en contra, los túneles se habían convertido en una tumba."

# game/Story01.rpy:6646

translate spanish gate4_2fe4bfcf:

    # o "Since then, they closed access. Stopped funding. Pretended this place didn’t exist."
    o "Desde entonces, cerraron el acceso. Detenido financiamiento. Pretendido este lugar no existía."

# game/Story01.rpy:6648

translate spanish gate4_7f6957cc:

    # Mi "They can’t secure their own city, but they’re experts in genocide."
    Mi "No pueden asegurar su propia ciudad, pero son expertos en genocidio."

# game/Story01.rpy:6650

translate spanish gate4_71c95e9e:

    # o "Enough. This isn’t politics."
    o "Basta. Esto no es política."

# game/Story01.rpy:6653

translate spanish gate4_3adfc068:

    # o "It’s survival."
    o "Es supervivencia."

# game/Story01.rpy:6655

translate spanish gate4_c888b7af:

    # Mi "Is that why there's such a shortage of personnel now?"
    Mi "¿Por eso hay tanta escasez de personal?"

# game/Story01.rpy:6657

translate spanish gate4_cd9e0591:

    # h "Why do our worlds only seem to share similarities in all the worst ways?"
    h "¿Por qué nuestros mundos solo parecen compartir similitudes de todas las formas peores?"

# game/Story01.rpy:6658

translate spanish gate4_2b35b6fe:

    # mc "..."
    mc "..."

# game/Story01.rpy:6661

translate spanish gate4_22900410:

    # mc "...We’re not alone."
    mc "...No estamos solos."

# game/Story01.rpy:6663

translate spanish gate4_4d496a1c:

    # mc "Are those the creatures you were talking about earlier?"
    mc "¿Son esas criaturas de las que hablabas antes?"

# game/Story01.rpy:6665

translate spanish gate4_3002841a:

    # o "What did you—"
    o "¿Qué has...?"

# game/Story01.rpy:6666

translate spanish gate4_56ac1680:

    # mc "Ceiling. Look."
    mc "- ¿Qué?"

# game/Story01.rpy:6670

translate spanish gate4_07abc845:

    # o "..."
    o "..."

# game/Story01.rpy:6671

translate spanish gate4_c66fc920:

    # o "Weapons up. Light sweep — NOW!"
    o "Armas arriba. ¡Luz de barrido — ¡Ahora!"

# game/Story01.rpy:6674

translate spanish gate4_4cf7fbc3:

    # mc "Now I get why you hesitated. This isn’t a detour. It’s a death sentence."
    mc "Ahora entiendo por qué lo dudaste. Esto no es un desvío. Es una sentencia de muerte."

# game/Story01.rpy:6676

translate spanish gate4_c779d27f:

    # o "Keep moving! Push through!"
    o "¡Sigue adelante!"

# game/Story01.rpy:6678

translate spanish gate4_571350fe:

    # h "Behind us!"
    h "¡Detrás de nosotros!"

# game/Story01.rpy:6688

translate spanish gate4_2b6e83ba:

    # mc "I owe you one."
    mc "Te debo una."

# game/Story01.rpy:6690

translate spanish gate4_b4bb544b:

    # h "Just like Drake, huh?"
    h "Como Drake, ¿eh?"

# game/Story01.rpy:6692

translate spanish gate4_f3c9a95c:

    # h "Chaos, smoke, no backup... good times."
    h "Caos, humo, sin respaldo... buenos tiempos."

# game/Story01.rpy:6696

translate spanish gate4_cf1adef2:

    # mc "Yeah."
    mc "Sí."

# game/Story01.rpy:6698

translate spanish gate4_463d68bf:

    # mc "Except back then, the enemy didn’t have eight legs and acid blood."
    mc "Excepto en aquel entonces, el enemigo no tenía ocho piernas y sangre ácida."

# game/Story01.rpy:6703

translate spanish gate4_93fe2246:

    # g "They’re closing in! We’re boxed in!"
    g "¡Se están acercando! ¡Estamos en caja!"

# game/Story01.rpy:6708

translate spanish gate4_b2a6c02a:

    # o "Fear is how they win! You want to live — then FIGHT!"
    o "¡El miedo es cómo ganan! ¡Quieres vivir —¡entonces, Fight!"

# game/Story01.rpy:6711

translate spanish gate4_08f8b549:

    # o "Forward, all of you!"
    o "¡Adelante, todos!"

# game/Story01.rpy:6713

translate spanish gate4_922333ee:

    # o "FORWARD!"
    o "¡ADELANTE!"

# game/Story01.rpy:6715

translate spanish gate4_821e1d74:

    # o "Miriel, status?"
    o "Miriel, ¿estado?"

# game/Story01.rpy:6722

translate spanish gate4_82de296b:

    # Mi "One inhibitor left. Almost there!"
    Mi "Solo queda un inhibidor. ¡Casi!"

# game/Story01.rpy:6725

translate spanish gate4_c0f8140d:

    # H "All phases complete. Reaper mode activated. Happy hunting, Miss Miriel."
    H "Todas las fases completadas. Modo Parca activado. Buena caza, señorita Miriel."

# game/Story01.rpy:6736

translate spanish gate4_e839e47b:

    # H "Task complete. Enemy casualties: 67."
    H "Tarea completada. Bajas enemigas: 67."

# game/Story01.rpy:6741

translate spanish gate4_9381fe3d:

    # H "Warning. Activation code denied. Weapons deactivated."
    H "Advertencia. Código de activación denegado. Armas desactivadas."

# game/Story01.rpy:6742

translate spanish gate4_730e50b1:

    # Mi "Each time... it’s getting worse and worse..."
    Mi "Cada vez... va a peor..."

# game/Story01.rpy:6744

translate spanish gate4_01350e90:

    # mc "What was that? She — how did she—?"
    mc "¿Qué fue eso? Ella... ¿cómo?"

# game/Story01.rpy:6746

translate spanish gate4_d122a019:

    # o "She’s like you. Experiment. Implant. But where yours are built for survival... hers were forged for war."
    o "Es como tú: un experimento. Implantes. Pero mientras los tuyos fueron pensados para sobrevivir... los suyos fueron forjados para la guerra."

# game/Story01.rpy:6748

translate spanish gate4_00ec0db8:

    # o "We didn’t know what you’d become. Just hoped it wouldn’t kill you."
    o "No sabíamos en qué te convertirías. Solo esperábamos que no te matara."

# game/Story01.rpy:6752

translate spanish gate4_850ef128:

    # b "..."
    b "..."

# game/Story01.rpy:6754

translate spanish gate4_9fffb729:

    # h "...That didn’t sound friendly."
    h "...Eso no sonó amistoso."

# game/Story01.rpy:6756

translate spanish gate4_d8f59f77:

    # o "That’s not good. That’s not good at all."
    o "Eso es malo. Muy malo."

# game/Story01.rpy:6760

translate spanish gate4_0d714f3a:

    # o "RUN!"
    o "¡CORRAN!"

# game/Story01.rpy:6762

translate spanish gate4_4ff1cef7:

    # mc "What the hell are we running from?!"
    mc "¿De qué diablos estamos huyendo?"

# game/Story01.rpy:6764

translate spanish gate4_4a21102b:

    # o "Pray you don’t find out. Just MOVE."
    o "Recen por no descubrirlo. Ahora, ¡MUÉVANSE!"

# game/Story01.rpy:6766

translate spanish gate4_2ac9753d:

    # mc "(What kind of mess have we gotten ourselves into...?)"
    mc "(¿En qué clase de desastre nos hemos metido...?)"

# game/Story01.rpy:6774

translate spanish gate4_3ea7a382:

    # mc "(Now I understand why we’re running...)"
    mc "(Ahora entiendo por qué estamos corriendo...)"

# game/Story01.rpy:6776

translate spanish gate4_fe5c0a9a:

    # gg "Get over here quickly! Leave the rest to us."
    gg "¡Vengan aquí, rápido! Déjennos el resto."

# game/Story01.rpy:6785

translate spanish gate4_31bf77cd:

    # gg "TAKE THAT, YOU BASTARD!"
    gg "¡TOMA ESO, BASTARDO!"

# game/Story01.rpy:6788

translate spanish gate4_642c1b79:

    # gg "Keep pushing it back! Let them know what happens when they mess with us!"
    gg "¡Sigan empujándola! ¡Que aprendan qué pasa cuando se meten con nosotros!"

# game/Story01.rpy:6791

translate spanish gate4_e7caee40:

    # o "How are you holding up? Can you keep going?"
    o "¿Cómo estás? ¿Puedes seguir?"

# game/Story01.rpy:6792

translate spanish gate4_98b33b08:

    # Mi "I... I can’t. Muscles won’t respond. Nerve feedback’s spiking. I can’t... move."
    Mi "Yo... no puedo. Los músculos no responden. La retroalimentación nerviosa se dispara. No puedo... moverme."

# game/Story01.rpy:6794

translate spanish gate4_7a05848c:

    # o "We need a sitter. Who’s staying? Decide now."
    o "Necesitamos a alguien con ella. ¿Quién se queda? Decidan ya."

# game/Story01.rpy:6796

translate spanish gate4_1d1f4d1b:

    # mc "I will. I’ve got her."
    mc "Lo haré. La tengo."

# game/Story01.rpy:6797

translate spanish gate4_fc4f065e:

    # o "Good, then we move."
    o "Bien. Entonces avancemos."

# game/Story01.rpy:6799

translate spanish gate4_8fe3a821:

    # g "Second wave’s incoming. Delay another second — we’re corpses."
    g "La segunda oleada se acerca. Otro segundo de retraso y somos cadáveres."

# game/Story01.rpy:6820

translate spanish gate4_890882d9:

    # mc "How are you holding up? You didn’t twist anything while running, did you?"
    mc "¿Cómo estás? No te torciste nada al correr, ¿verdad?"

# game/Story01.rpy:6824

translate spanish gate4_5895c49a:

    # h "I’m fine. And even if I wasn’t, pain’s just... familiar now. Comfortable, in a sick kind of way."
    h "Estoy bien. Y aunque no lo estuviera, el dolor ya es... familiar. Cómodo, de una forma bastante enferma."

# game/Story01.rpy:6827

translate spanish gate4_bc53fe45:

    # h "Funny, isn’t it? Two months ago I was planning a bar expansion. Now I kill things with more eyes than morals."
    h "Hace dos meses planeaba ampliar el bar. Ahora mato cosas con más ojos que moral."

# game/Story01.rpy:6830

translate spanish gate4_b1acbe43:

    # mc "Yeah. Life flipped the board and set it on fire."
    mc "Sí. La vida volcó el tablero y luego le prendió fuego."

# game/Story01.rpy:6831

translate spanish gate4_86589ae8:

    # mc "Earlier — you said something. Was that about training, or... something else?"
    mc "Antes —dijiste algo. ¿Era eso sobre entrenamiento, o... algo más?"

# game/Story01.rpy:6834

translate spanish gate4_e0538218:

    # h "Later. Some ghosts don’t like being dragged into daylight."
    h "Más tarde. A algunos fantasmas no les gusta ser arrastrados a la luz del día."

# game/Story01.rpy:6835

translate spanish gate4_bdc4c063:

    # h "Look who’s back from the void. {w}Our lovely executioner wakes."
    h "Mira quién ha vuelto del vacío. {w}Nuestro encantador verdugo despierta."

# game/Story01.rpy:6836

translate spanish gate4_506b8ea6:

    # h "Sleep well, sweetheart? Remember who you are, or do we need to start with names and body counts?"
    h "¿Te acuerdas de quién eres, o necesitamos empezar con nombres y cuentas de cuerpo?"

# game/Story01.rpy:6838

translate spanish gate4_7fba446f:

    # Mi "...Sleep? I wasn’t asleep."
    Mi "... ¿Dormir? No estaba dormido."

# game/Story01.rpy:6839

translate spanish gate4_f0bacf56:

    # Mi "I remember spiders. Blood. Then nothing. {w}Just... silence like a grave."
    Mi "Recuerdo a las arañas, sangre, y nada. {w}Solo... silencio como una tumba."

# game/Story01.rpy:6841

translate spanish gate4_309026ab:

    # Mi "Also — can someone please stop grabbing my ass? Thanks."
    Mi "También, ¿puede alguien por favor dejar de agarrarme el culo?"

# game/Story01.rpy:6842

translate spanish gate4_5c29fbc8:

    # mc "(I wasn’t touching anything... was I?)"
    mc "(No estaba tocando nada... ¿Yo?)"

# game/Story01.rpy:6845

translate spanish gate4_63d50e09:

    # Mi "Where are we? What happened after the fight?"
    Mi "¿Qué pasó después de la pelea?"

# game/Story01.rpy:6847

translate spanish gate4_518557ef:

    # mc "You tore through them like a storm. Then collapsed. We carried you out. Barely."
    mc "Los destrozaste como una tormenta, y luego te desplomaste, te arrastramos, y te arrastraste, y te lo llevaste."

# game/Story01.rpy:6849

translate spanish gate4_099f0b6a:

    # mc "Now? We’re in some kind of dead zone."
    mc "Estamos en una especie de zona muerta."

# game/Story01.rpy:6850

translate spanish gate4_6b52beb8:

    # mc "Quiet. {w=0.5}Too quiet. The monsters won’t come near it."
    mc "Silencio. {w=0.5}Demasiado tranquilo. Los monstruos no se acercarán."

# game/Story01.rpy:6851

translate spanish gate4_3dcaefa2:

    # mc "Feels like they’re afraid."
    mc "Se siente como si tuvieran miedo."

# game/Story01.rpy:6853

translate spanish gate4_deb8701d:

    # h "They stopped chasing us. Just... turned back. Like something deeper down scared them off."
    h "Dejaron de perseguirnos, pero... retrocedieron, como si algo más profundo los asustara."

# game/Story01.rpy:6855

translate spanish gate4_ec535cc7:

    # h "Either we’re beneath their notice… or something worse is watching."
    h "O estamos bajo su aviso... o algo peor está viendo."

# game/Story01.rpy:6857

translate spanish gate4_da3fdbf1:

    # Mi "..."
    Mi "..."

# game/Story01.rpy:6858

translate spanish gate4_11100fa2:

    # Mi "I hate this. Not knowing. Not understanding."
    Mi "Odio esto, no lo sé, no lo entiendo."

# game/Story01.rpy:6861

translate spanish gate4_2523569c:

    # o "Eyes up. Everyone, gather. We need to talk."
    o "Todos, todos, reúnanse, tenemos que hablar."

# game/Story01.rpy:6863

translate spanish gate4_9a27feff:

    # mc "New problem?"
    mc "¿Nuevo problema?"

# game/Story01.rpy:6865

translate spanish gate4_3917415b:

    # g "Depends how you define 'problem.' Our signal jammer’s gone dark."
    g "Depende de cómo definas \"problema\". Nuestro interferidor se ha evaporado."

# game/Story01.rpy:6868

translate spanish gate4_afcc31db:

    # g "Instruments say it’s... not where it should be."
    g "Los instrumentos dicen que no es... donde debería estar."

# game/Story01.rpy:6870

translate spanish gate4_fedc9680:

    # g "Either it moved... or it was never a device in the first place."
    g "O se movió... o nunca fue un dispositivo en primer lugar."

# game/Story01.rpy:6871

translate spanish gate4_717e5f0c:

    # mc "You mean—?"
    mc "¿Quieres decir...?"

# game/Story01.rpy:6874

translate spanish gate4_f03c1c60:

    # g "I mean it’s organic. Living. And it’s jamming everything around us like a heartbeat. We weren’t trained for this."
    g "Quiero decir que es orgánica. Vivir. Y está atascando todo alrededor de nosotros como un latido del corazón. No fuimos entrenados para esto."

# game/Story01.rpy:6878

translate spanish gate4_0520bc0c:

    # gggg "CONTACT FRONT!"
    gggg "¡Contáctese!"

# game/Story01.rpy:6880

translate spanish gate4_3f5d77e4:

    # gggg "Don’t move! Identify yourself! Division and clearance — NOW!"
    gggg "¡No te muevas! ¡Identifiquete! División y limpieza — ¡AHORA!"

# game/Story01.rpy:6881

translate spanish gate4_bb8e4b4e:

    # a "..."
    a "..."

# game/Story01.rpy:6885

translate spanish gate4_9f873829:

    # o "I’m going to check it out. Stay sharp."
    o "Voy a comprobarlo."

# game/Story01.rpy:6886

translate spanish gate4_92f0b873:

    # gg "I’ve got a bad feeling about this..."
    gg "Tengo una mala sensación sobre esto..."

# game/Story01.rpy:6888

translate spanish gate4_ed371c5c:

    # o "He’s not responding. Weapons tight. If he twitches wrong, drop him."
    o "No responde. Armas apretadas. Si se equivoca, déjalo caer."

# game/Story01.rpy:6891

translate spanish gate4_b51aa932:

    # a "No need."
    a "No es necesario."

# game/Story01.rpy:6893

translate spanish gate4_5a07c3d8:

    # a "He won’t be moving again. Death took him long before you got here."
    a "No volverá a moverse. La muerte le llevó mucho antes de que llegaras."

# game/Story01.rpy:6896

translate spanish gate4_3b702b97:

    # o "And what brings the Inquisition down here?"
    o "¿Y qué trae la Inquisición aquí abajo?"

# game/Story01.rpy:6897

translate spanish gate4_c57132fb:

    # o "You don’t usually get your boots dirty with our kind."
    o "No sueles ensuciar tus botas con nuestro tipo."

# game/Story01.rpy:6899

translate spanish gate4_2642caea:

    # a "Curiosity. {w}And maybe a touch of divine judgment."
    a "Curiosidad. {w}Y tal vez un toque de juicio divino."

# game/Story01.rpy:6900

translate spanish gate4_738a7d96:

    # a "Share too much, I’d have to kill you. But you already knew that."
    a "Compartir demasiado, tendría que matarte. Pero ya lo sabías."

# game/Story01.rpy:6901

translate spanish gate4_6563353c:

    # a "Lower your weapon. Before you embarrass yourself."
    a "Baja tu arma antes de que te avergüences."

# game/Story01.rpy:6904

translate spanish gate4_13c3ed99:

    # a "Good. I knew you weren’t entirely without intelligence — unlike the last team that passed through."
    a "Sabía que no estabas completamente sin inteligencia, a diferencia del último equipo que pasó por aquí."

# game/Story01.rpy:6905

translate spanish gate4_07abc845_1:

    # o "..."
    o "..."

# game/Story01.rpy:6907

translate spanish gate4_31ef06ae:

    # a "Now, what exactly brings you to this wretched place? Care to enlighten me?"
    a "¿Qué te trae exactamente a este lugar miserable?"

# game/Story01.rpy:6909

translate spanish gate4_62fffba1:

    # o "I thought we were here for the same reason?"
    o "¿Pensé que estábamos aquí por la misma razón?"

# game/Story01.rpy:6910

translate spanish gate4_e0916875:

    # o "Or are you here for something else entirely?"
    o "¿O estás aquí por algo más por completo?"

# game/Story01.rpy:6913

translate spanish gate4_aad49879:

    # a "Oh, come now, of course, we share the same goal. How could you even suspect that I wouldn’t be on your side?"
    a "Oh, vamos, por supuesto, compartimos el mismo objetivo. ¿Cómo puedes sospechar que no estaría de tu lado?"

# game/Story01.rpy:6915

translate spanish gate4_d74daaa2:

    # mc "Why are we hiding? Who is that?"
    mc "¿Por qué nos escondemos?"

# game/Story01.rpy:6917

translate spanish gate4_4e692d39:

    # h "That’s an Inquisitor. If they see us — really see us — we’re not walking out of here."
    h "Es un inquisidor. Si nos ve, si de verdad nos ve, no saldremos de aquí."

# game/Story01.rpy:6919

translate spanish gate4_f8a737d2:

    # Mi "(...Nice save, Olivia.)"
    Mi "(...Bien cubierto, Olivia.)"

# game/Story01.rpy:6921

translate spanish gate4_4ab96640:

    # a "Well, well... The Cold Reaper herself. Didn’t expect to cross blades — metaphorical or otherwise."
    a "Vaya, vaya... la Parca Fría en persona. No esperaba cruzar espadas contigo, ni literal ni metafóricamente."

# game/Story01.rpy:6922

translate spanish gate4_6c262472:

    # a "Walk with me, would you? There’s so much I’ve been dying to discuss with you."
    a "Acompáñame, ¿quieres? Me muero por hablar de tantas cosas contigo."

# game/Story01.rpy:6924

translate spanish gate4_6f49dee8:

    # o "She’s not going anywhere with you. Different assignment. You’re not on the guest list."
    o "No va a ninguna parte contigo. Tiene otra misión. Tú no estás en la lista de invitados."

# game/Story01.rpy:6926

translate spanish gate4_d1a706c4:

    # a "Pity."
    a "Qué pena."

# game/Story01.rpy:6927

translate spanish gate4_fc2c4411:

    # a "But tell me — what mission sends your precious Reaper alone into hell’s underbelly?"
    a "Pero dime: ¿qué misión envía a tu preciosa Parca sola al vientre del infierno?"

# game/Story01.rpy:6928

translate spanish gate4_dcb527c6:

    # o "You don’t need to know."
    o "No necesitas saberlo."

# game/Story01.rpy:6931

translate spanish gate4_bb8e4b4e_1:

    # a "..."
    a "..."

# game/Story01.rpy:6932

translate spanish gate4_780b94b4:

    # a "Fascinating..."
    a "Fascinante..."

# game/Story01.rpy:6935

translate spanish gate4_97bef882:

    # o "We’ve changed course. We’re heading deeper."
    o "Hemos cambiado de rumbo. Nos dirigimos más profundo."

# game/Story01.rpy:6937

translate spanish gate4_fdb37e25:

    # o "You should stay behind. She can’t find out about our passengers."
    o "Tú quédate atrás. No puede descubrir a nuestros pasajeros."

# game/Story01.rpy:6938

translate spanish gate4_81c89ada:

    # o "Eyes on them. Do not let them slip."
    o "No les quites los ojos de encima. No dejes que se escapen."

# game/Story01.rpy:6940

translate spanish gate4_3c313796:

    # a "Of course, Commander. Time is ticking. Lead the way."
    a "Por supuesto, comandante. El tiempo corre. Guíe el camino."

# game/Story01.rpy:6949

translate spanish gate4_7fc62b06:

    # h "So? What actually happened back there?"
    h "¿Entonces? ¿Qué pasó ahí atrás?"

# game/Story01.rpy:6952

translate spanish gate4_3358aec5:

    # Mi "Even I don’t have the full picture."
    Mi "Ni siquiera yo tengo el panorama completo."

# game/Story01.rpy:6953

translate spanish gate4_dbdd0bd6:

    # Mi "They went off to disable the jammer. We’re supposed to find shelter. Rest."
    Mi "Fueron a desactivar el interferidor. Nosotros debemos buscar refugio. Descansar."

# game/Story01.rpy:6955

translate spanish gate4_4e0b5bcb:

    # Mi "But something’s off. Ostorius... the way he spoke to her — it wasn’t strategy. It was personal."
    Mi "Pero algo no encaja. Ostorius... la forma en que le habló no era estrategia. Era algo personal."

# game/Story01.rpy:6958

translate spanish gate4_c35ab9d5:

    # mc "Isn’t the Inquisition basically untouchable in your world? Maybe that’s why."
    mc "¿La Inquisición no es básicamente intocable en tu mundo? Quizá sea por eso."

# game/Story01.rpy:6959

translate spanish gate4_8940a5a4:

    # mc "...Though I felt it too. Like pressure behind my ribs. Thought it was just being underground."
    mc "Aunque yo también lo sentí. Como una presión detrás de las costillas. Pensé que era por estar bajo tierra."

# game/Story01.rpy:6962

translate spanish gate4_0d34d17e:

    # h "Yeah, no. That woman... She didn’t move like a soldier."
    h "Sí... no. Esa mujer no se movía como una soldado."

# game/Story01.rpy:6963

translate spanish gate4_0487f28e:

    # h "She glided. Like the air stepped aside for her."
    h "Se deslizaba. Como si el aire se apartara para dejarla pasar."

# game/Story01.rpy:6965

translate spanish gate4_998027fb:

    # h "And now we’re benched? ‘Find a safe place and rest’? Sounds a lot like 'you're in the way.'"
    h "¿Y ahora nos mandan al banquillo? ¿\"Busquen un lugar seguro y descansen\"? Suena mucho a \"estorban\"."

# game/Story01.rpy:6967

translate spanish gate4_3119629c:

    # Mi "It’s not that. You both look like you haven’t slept in days. And Liv’s been pushing herself to the edge."
    Mi "No es eso. Ustedes dos parecen llevar días sin dormir. Y Liv se ha estado empujando hasta el límite."

# game/Story01.rpy:6969

translate spanish gate4_06edc0fe:

    # h "Pushing forward is what I was made for."
    h "Seguir avanzando es para lo que nací."

# game/Story01.rpy:6970

translate spanish gate4_4d7cfb6d:

    # h "Sitting around while others fight? That’s not rest, that’s guilt."
    h "¿Quedarnos sentados mientras otros pelean? Eso no es descanso; es culpa."

# game/Story01.rpy:6972

translate spanish gate4_c482c3e2:

    # Mi "And what about you?"
    Mi "¿Y tú?"

# game/Story01.rpy:6975

translate spanish gate4_282212fb:

    # mc "We need to recover. It's not weakness. It’s strategy."
    mc "Necesitamos recuperarnos. No es debilidad. Es estrategia."

# game/Story01.rpy:6977

translate spanish gate4_e005d60c:

    # Mi "Fair. Rest it is. Let’s find a spot that won’t kill us in our sleep."
    Mi "Justo. Entonces descansamos. Busquemos un lugar que no nos mate mientras dormimos."

# game/Story01.rpy:6979

translate spanish gate4_05906fb8:

    # Mi "Well then, let’s move out."
    Mi "Bien, entonces avancemos."

# game/Story01.rpy:6985

translate spanish gate4_17161744:

    # mc "No. We keep moving. I can’t sit still with that thing still active."
    mc "No. Seguimos moviéndonos. No puedo quedarme quieto con esa cosa todavía activa."

# game/Story01.rpy:6987

translate spanish gate4_af724ec7:

    # Mi "Alright. Just don’t drop dead on me halfway there."
    Mi "De acuerdo. Pero no se te ocurra morirte a mitad del camino."

# game/Story01.rpy:6989

translate spanish gate4_05906fb8_1:

    # Mi "Well then, let’s move out."
    Mi "Bien, entonces avancemos."

# game/Story01.rpy:7003

translate spanish olivia_fr_scene_2e0cde03:

    # Mi "This place... dust, rust, and leftover silence."
    Mi "Este lugar... polvo, óxido y un silencio que se quedó atrás."

# game/Story01.rpy:7004

translate spanish olivia_fr_scene_f2cf929c:

    # Mi "Power grid’s long dead, but the insulation's still good. Might even keep us warm."
    Mi "La red eléctrica murió hace mucho, pero el aislamiento sigue intacto. Quizá hasta nos mantenga calientes."

# game/Story01.rpy:7006

translate spanish olivia_fr_scene_578ba1c8:

    # Mi "It’s not much, but it beats dying in the open. What do you think?"
    Mi "No es gran cosa, pero es mejor que morir a la intemperie. ¿Qué opinan?"

# game/Story01.rpy:7008

translate spanish olivia_fr_scene_968d013c:

    # h "I think you’re dodging the real question."
    h "Creo que estás esquivando la verdadera pregunta."

# game/Story01.rpy:7009

translate spanish olivia_fr_scene_9aa33994:

    # Mi "Hm?"
    Mi "¿Hm?"

# game/Story01.rpy:7010

translate spanish olivia_fr_scene_38f9d358:

    # h "Why the mask?"
    h "¿Por qué la máscara?"

# game/Story01.rpy:7012

translate spanish olivia_fr_scene_da3fdbf1:

    # Mi "..."
    Mi "..."

# game/Story01.rpy:7013

translate spanish olivia_fr_scene_32f43f81:

    # Mi "It covered the scars."
    Mi "Ocultaba las cicatrices."

# game/Story01.rpy:7014

translate spanish olivia_fr_scene_e0190cf5:

    # Mi "After a while... I forgot how not to wear it."
    Mi "Después de un tiempo... olvidé cómo estar sin ella."

# game/Story01.rpy:7015

translate spanish olivia_fr_scene_3e464b12:

    # h "Then take it off. Let the past breathe a little."
    h "Entonces quítatela. Deja que el pasado respire un poco."

# game/Story01.rpy:7016

translate spanish olivia_fr_scene_b4ea19a1:

    # h "I bet even [mc] would rather see the real you."
    h "Apuesto a que hasta [mc] preferiría ver a la verdadera tú."

# game/Story01.rpy:7019

translate spanish olivia_fr_scene_7475c7f3:

    # Mi "...Alright."
    Mi "...De acuerdo."

# game/Story01.rpy:7021

translate spanish olivia_fr_scene_12af69f1:

    # h "...Told you. Gorgeous."
    h "...Te lo dije. Preciosa."

# game/Story01.rpy:7023

translate spanish olivia_fr_scene_da3fdbf1_1:

    # Mi "..."
    Mi "..."

# game/Story01.rpy:7025

translate spanish olivia_fr_scene_fc30204a:

    # Mi "...Thanks."
    Mi "...Gracias."

# game/Story01.rpy:7028

translate spanish olivia_fr_scene_cd81b7fa:

    # h "Whoa. No flinching? No 'I’m not like that' speech? Look at you."
    h "Vaya. ¿Sin estremecerte? ¿Sin discurso de \"yo no soy así\"? Mírate."

# game/Story01.rpy:7030

translate spanish olivia_fr_scene_8be893b9:

    # h "Growing up on me."
    h "Madurando delante de mis ojos."

# game/Story01.rpy:7032

translate spanish olivia_fr_scene_949c951b:

    # Mi "Maybe. {w}Or maybe I’m too tired to argue."
    Mi "Tal vez. {w}O quizás estoy demasiado cansada para discutir."

# game/Story01.rpy:7035

translate spanish olivia_fr_scene_12ce51c0:

    # mc "Sorry to ruin the moment, but... you two need to see this."
    mc "Perdón por arruinar el momento, pero... tienen que ver esto."

# game/Story01.rpy:7037

translate spanish olivia_fr_scene_f8a59fab:

    # h "What now? Another monster?"
    h "¿Otro monstruo?"

# game/Story01.rpy:7040

translate spanish olivia_fr_scene_7398d180:

    # mc "Worse. Maybe."
    mc "Peor. Tal vez."

# game/Story01.rpy:7043

translate spanish olivia_fr_scene_7e9e7e05:

    # h "So?"
    h "¿Y?"

# game/Story01.rpy:7046

translate spanish olivia_fr_scene_da163c01:

    # mc "Back on the Ark — before we launched — remember the research team? Paranormal studies, off-the-books."
    mc "En el Arca, antes del lanzamiento... ¿recuerdas al equipo de investigación? Estudios paranormales, extraoficiales."

# game/Story01.rpy:7048

translate spanish olivia_fr_scene_0b30800c:

    # h "Yeah, I remember them… vaguely."
    h "Sí, los recuerdo... vagamente."

# game/Story01.rpy:7052

translate spanish olivia_fr_scene_99e5953a:

    # mc "This wall. The insignia. Same one."
    mc "Esta pared. La insignia. Es la misma."

# game/Story01.rpy:7053

translate spanish olivia_fr_scene_213fedcb:

    # mc "Their motto, too. ‘A man must believe the incomprehensible can be understood.’"
    mc "Y su lema también: \"Una persona debe creer que lo incomprensible puede llegar a entenderse.\""

# game/Story01.rpy:7056

translate spanish olivia_fr_scene_3bc20e08:

    # mc "Miriel... how did Lora end up here?"
    mc "Miriel... ¿cómo terminó Lora aquí?"

# game/Story01.rpy:7059

translate spanish olivia_fr_scene_9f989ea0:

    # h "Again?"
    h "¿Otra vez?"

# game/Story01.rpy:7060

translate spanish olivia_fr_scene_82e5a980:

    # h "You're reading into it too much. I... I—"
    h "Lees demasiado entre líneas. Yo... yo..."

# game/Story01.rpy:7062

translate spanish olivia_fr_scene_13149de2:

    # mc "OLIVIA!"
    mc "¡OLIVIA!"

# game/Story01.rpy:7065

translate spanish olivia_fr_scene_8e8722f9:

    # mc "LIV? HEY!"
    mc "¿LIV? ¡OYE!"

# game/Story01.rpy:7066

translate spanish olivia_fr_scene_74941eb5:

    # mc "What`s wrong?!"
    mc "¿Qué ocurre?"

# game/Story01.rpy:7068

translate spanish olivia_fr_scene_cb418999:

    # mc "Miriel?!"
    mc "¡Miriel!"

# game/Story01.rpy:7069

translate spanish olivia_fr_scene_a1253b1b:

    # Mi "She pushed past her limits."
    Mi "Pasó de largo sus propios límites."

# game/Story01.rpy:7070

translate spanish olivia_fr_scene_abd86a4a:

    # Mi "Burned herself from the inside out. And never stopped."
    Mi "Se quemó por dentro. Y aun así no se detuvo."

# game/Story01.rpy:7072

translate spanish olivia_fr_scene_838f0d19:

    # mc "It’s not— It doesn’t look like—"
    mc "No es... No parece..."

# game/Story01.rpy:7073

translate spanish olivia_fr_scene_44ef9aec:

    # Mi "Don’t argue. I’ll get the stabilizers."
    Mi "No discutas. Iré por los estabilizadores."

# game/Story01.rpy:7074

translate spanish olivia_fr_scene_3d511f68:

    # Mi "Move her. Now."
    Mi "Muévela. Ahora."

# game/Story01.rpy:7077

translate spanish olivia_fr_scene_738aef13:

    # mc "Okay — yeah. Okay"
    mc "Vale, sí."

# game/Story01.rpy:7078

translate spanish olivia_fr_scene_9fe41c81:

    # mc "Just tell me she’ll be alright."
    mc "Solo dime que estará bien."

# game/Story01.rpy:7081

translate spanish olivia_fr_scene_b12a9849:

    # Mi "She will."
    Mi "Lo hará."

# game/Story01.rpy:7082

translate spanish olivia_fr_scene_13f66bd4:

    # Mi "But next time, someone needs to pull her back before she snaps herself in half."
    Mi "Pero la próxima vez alguien tiene que frenarla antes de que se parta en dos."

# game/Story01.rpy:7085

translate spanish olivia_fr_scene_d547eb2a:

    # Mi "Over here. Lay her down."
    Mi "Aquí. Acuéstala."

# game/Story01.rpy:7088

translate spanish olivia_fr_scene_da3fdbf1_2:

    # Mi "..."
    Mi "..."

# game/Story01.rpy:7091

translate spanish olivia_fr_scene_7596713b:

    # Mi "…Hold her steady."
    Mi "...Sujétala bien."

# game/Story01.rpy:7092

translate spanish olivia_fr_scene_043242a3:

    # Mi "Vitals are crashing— "
    Mi "Los signos vitales se desploman... "

# game/Story01.rpy:7093

translate spanish olivia_fr_scene_32dfb47b:

    # Mi "…Come on, come on…"
    Mi "Vamos, vamos..."

# game/Story01.rpy:7095

translate spanish olivia_fr_scene_9a811e10:

    # Mi "…She’s stable."
    Mi "...Está estable."

# game/Story01.rpy:7099

translate spanish olivia_fr_scene_757bf369:

    # mc "(If I’d lost her too… I don’t—)"
    mc "(Si también la hubiera perdido a ella... yo no...)"

# game/Story01.rpy:7107

translate spanish olivia_fr_scene_da3fdbf1_3:

    # Mi "..."
    Mi "..."

# game/Story01.rpy:7110

translate spanish olivia_fr_scene_a6be913e:

    # mc "So?"
    mc "¿Y?"

# game/Story01.rpy:7112

translate spanish olivia_fr_scene_da76920b:

    # Mi "She needs sleep."
    Mi "Necesita dormir."

# game/Story01.rpy:7113

translate spanish olivia_fr_scene_5c19529b:

    # Mi "Like the rest of us should’ve had hours ago."
    Mi "Como el resto de nosotros debería haber hecho hace horas."

# game/Story01.rpy:7115

translate spanish olivia_fr_scene_bd87542c:

    # mc "That’s it?"
    mc "¿Eso es todo?"

# game/Story01.rpy:7117

translate spanish olivia_fr_scene_422656f8:

    # Mi "I hope so."
    Mi "Eso espero."

# game/Story01.rpy:7118

translate spanish olivia_fr_scene_dc044862:

    # Mi "But hope’s not really my field."
    Mi "Pero la esperanza no es precisamente mi especialidad."

# game/Story01.rpy:7120

translate spanish olivia_fr_scene_850ef128:

    # b "..."
    b "..."

# game/Story01.rpy:7122

translate spanish olivia_fr_scene_2170b42f:

    # mc "Miriel?"
    mc "¿Miriel?"

# game/Story01.rpy:7124

translate spanish olivia_fr_scene_da3fdbf1_4:

    # Mi "..."
    Mi "..."

# game/Story01.rpy:7126

translate spanish olivia_fr_scene_b73768a9:

    # Mi "You don’t have to say it."
    Mi "No tienes que decirlo."

# game/Story01.rpy:7128

translate spanish olivia_fr_scene_ae070c4d:

    # mc "I wasn’t going to thank you."
    mc "No iba a agradecerte."

# game/Story01.rpy:7130

translate spanish olivia_fr_scene_77feb436:

    # Mi "Good."
    Mi "Bien."

# game/Story01.rpy:7132

translate spanish olivia_fr_scene_e3c9e435:

    # mc "I was going to ask why."
    mc "Iba a preguntar por qué."

# game/Story01.rpy:7133

translate spanish olivia_fr_scene_9544d998:

    # mc "Why do you care about us so much?"
    mc "¿Por qué te preocupas tanto por nosotros?"

# game/Story01.rpy:7135

translate spanish olivia_fr_scene_da2c0965:

    # Mi "Don’t do this."
    Mi "No hagas esto."

# game/Story01.rpy:7137

translate spanish olivia_fr_scene_a1de67ad:

    # mc "You didn’t have to. Like last time."
    mc "No tenías que hacerlo. Como la última vez."

# game/Story01.rpy:7139

translate spanish olivia_fr_scene_2ea261af:

    # Mi "I..."
    Mi "Yo..."

# game/Story01.rpy:7141

translate spanish olivia_fr_scene_c66e3692:

    # mc "And this is the cold reaper?"
    mc "¿Y esta es la Parca Fría?"

# game/Story01.rpy:7142

translate spanish olivia_fr_scene_0fa42410:

    # mc "Funny, don't you think?"
    mc "Es gracioso, ¿no crees?"

# game/Story01.rpy:7144

translate spanish olivia_fr_scene_bf4f7c5f:

    # Mi "Don’t make me into something I’m not."
    Mi "No me conviertas en algo que no soy."

# game/Story01.rpy:7145

translate spanish olivia_fr_scene_b9fc9e51:

    # Mi "I didn’t do this to be noble. I just… didn’t want more blood on my hands. Not hers."
    Mi "No lo hice por nobleza. Solo... no quería más sangre en mis manos. No la de ella."

# game/Story01.rpy:7147

translate spanish olivia_fr_scene_0cd1477e:

    # mc "Still."
    mc "Aún así."

# game/Story01.rpy:7148

translate spanish olivia_fr_scene_f0edc8ea:

    # mc "You stayed. You fought. That means something."
    mc "Te quedaste. Peleaste. Eso significa algo."

# game/Story01.rpy:7150

translate spanish olivia_fr_scene_42f1be33:

    # Mi "To you, maybe."
    Mi "A ti, tal vez."

# game/Story01.rpy:7151

translate spanish olivia_fr_scene_19541a8e:

    # Mi "To me, it’s just one less nightmare."
    Mi "Para mí, es solo una pesadilla menos."

# game/Story01.rpy:7153

translate spanish olivia_fr_scene_da3fdbf1_5:

    # Mi "..."
    Mi "..."

# game/Story01.rpy:7155

translate spanish olivia_fr_scene_bed062ed:

    # mc "You changed something."
    mc "Cambiaste algo."

# game/Story01.rpy:7156

translate spanish olivia_fr_scene_1d84882f:

    # mc "For her. For me."
    mc "Para ella, para mí."

# game/Story01.rpy:7158

translate spanish olivia_fr_scene_d149f440:

    # Mi "Don’t."
    Mi "No."

# game/Story01.rpy:7160

translate spanish olivia_fr_scene_8663293f:

    # mc "I mean it."
    mc "Lo digo en serio."

# game/Story01.rpy:7162

translate spanish olivia_fr_scene_da3fdbf1_6:

    # Mi "..."
    Mi "..."

# game/Story01.rpy:7164

translate spanish olivia_fr_scene_004273b3:

    # Mi "And I mean— "
    Mi "Y yo digo... "

# game/Story01.rpy:7166

translate spanish olivia_fr_scene_7c7e5ef9:

    # Mi "You don’t owe me anything. Don’t carry that weight for me."
    Mi "No me debes nada. No cargues ese peso por mí."

# game/Story01.rpy:7168

translate spanish olivia_fr_scene_22b5537d:

    # mc "Maybe I already am."
    mc "Tal vez ya lo estoy."

# game/Story01.rpy:7170

translate spanish olivia_fr_scene_da3fdbf1_7:

    # Mi "..."
    Mi "..."

# game/Story01.rpy:7172

translate spanish olivia_fr_scene_7bf88ef0:

    # Mi "You and Olivia..."
    Mi "Tú y Olivia..."

# game/Story01.rpy:7174

translate spanish olivia_fr_scene_da3fdbf1_8:

    # Mi "..."
    Mi "..."

# game/Story01.rpy:7176

translate spanish olivia_fr_scene_0d604f01:

    # Mi "I always wondered. How’d it start?"
    Mi "Siempre me lo pregunté. ¿Cómo empezó?"

# game/Story01.rpy:7178

translate spanish olivia_fr_scene_edfaeaf4:

    # mc "Like most stories worth telling."
    mc "Como la mayoría de las historias que valen la pena contarse."

# game/Story01.rpy:7179

translate spanish olivia_fr_scene_5df5466a:

    # mc "With something broken."
    mc "Con algo roto."

# game/Story01.rpy:7187

translate spanish olivia_fr_scene_1a52897e:

    # mc "(We started with almost nothing. A small kitchen, some borrowed furniture, and dreams we didn’t dare speak aloud.)"
    mc "(Empezamos con casi nada. Una pequeña cocina, algunos muebles prestados y sueños que no nos atrevíamos a decir en voz alta.)"

# game/Story01.rpy:7189

translate spanish olivia_fr_scene_e71f2e97:

    # mc "(At the time, my dear Lora and I worked alone. And despite not having any special advantages, our customer base grew rapidly.)"
    mc "(En ese momento, mi querida Lora y yo trabajamos solos. Y a pesar de no tener ninguna ventaja especial, nuestra base de clientes creció rápidamente.)"

# game/Story01.rpy:7190

translate spanish olivia_fr_scene_52a12243:

    # mc "(This, of course, meant we had to start looking for new staff.)"
    mc "(Esto, por supuesto, significaba que teníamos que empezar a buscar nuevo personal.)"

# game/Story01.rpy:7192

translate spanish olivia_fr_scene_7af8570d:

    # L "So this is the one you told me about?"
    L "¿Así que esta es la chica de la que me hablaste?"

# game/Story01.rpy:7193

translate spanish olivia_fr_scene_c3a5476a:

    # L "Where on earth did you find this lovely gem? She looks amazing."
    L "¿Dónde demonios encontraste esta pequeña joya? Se ve maravillosa."

# game/Story01.rpy:7195

translate spanish olivia_fr_scene_65f14302:

    # mc "Right? I thought the same thing at the time."
    mc "Pensé lo mismo en ese momento."

# game/Story01.rpy:7196

translate spanish olivia_fr_scene_a9faf3d9:

    # mc "I decided it was worth taking a chance."
    mc "Decidí que valía la pena arriesgarme."

# game/Story01.rpy:7198

translate spanish olivia_fr_scene_6af6e555:

    # mc "I went all-in, and only time would tell if it was a wise decision."
    mc "Aposté todo, y solo el tiempo diría si fue una decisión sabia."

# game/Story01.rpy:7199

translate spanish olivia_fr_scene_d704cd04:

    # mc "But at that moment, I simply couldn't bring myself to turn her away when she was so desperately asking for help."
    mc "Pero en ese momento, no pude rechazarla cuando estaba tan desesperada por pedir ayuda."

# game/Story01.rpy:7201

translate spanish olivia_fr_scene_edba461f:

    # mc "(Although we could afford a more qualified employee, I just couldn't refuse someone who genuinely needed a chance.)"
    mc "(Aunque podíamos permitirnos contratar a alguien más cualificado, no pude negarme a alguien que de verdad necesitaba una oportunidad.)"

# game/Story01.rpy:7203

translate spanish olivia_fr_scene_f064b59f:

    # L "Hmm. I’ve always believed talent can be taught, but fire — that’s either born or forged."
    L "Hmm. Siempre he creído que el talento puede enseñarse, pero el fuego... eso se trae de nacimiento o se forja."

# game/Story01.rpy:7204

translate spanish olivia_fr_scene_21f72498:

    # L "Sweetheart, give us a smile."
    L "Cariño, dame una sonrisa."

# game/Story01.rpy:7206

translate spanish olivia_fr_scene_79649a15:

    # h "Like this?"
    h "¿Así?"

# game/Story01.rpy:7207

translate spanish olivia_fr_scene_850ef128_1:

    # b "..."
    b "..."

# game/Story01.rpy:7208

translate spanish olivia_fr_scene_710be211:

    # L "Close. We'll work on that."
    L "Casi. Trabajaremos en eso."

# game/Story01.rpy:7210

translate spanish olivia_fr_scene_fc0bc68c:

    # mc "She’s got heart. Just... maybe not the right outfit. Doesn’t quite match the soul."
    mc "Tiene corazón. Solo... quizá no el atuendo adecuado. No termina de hacerle justicia."

# game/Story01.rpy:7212

translate spanish olivia_fr_scene_850ef128_2:

    # b "..."
    b "..."

# game/Story01.rpy:7213

translate spanish olivia_fr_scene_be627234:

    # h "Is something wrong?"
    h "¿Pasa algo?"

# game/Story01.rpy:7215

translate spanish olivia_fr_scene_c9f8316a:

    # mc "No, not wrong. Just... unfinished. Like a canvas with the first strokes of something beautiful."
    mc "No, no está mal, solo... inacabado, como un lienzo con los primeros golpes de algo hermoso."

# game/Story01.rpy:7217

translate spanish olivia_fr_scene_a8290a1c:

    # L "Wait here."
    L "Espera aquí."

# game/Story01.rpy:7220

translate spanish olivia_fr_scene_f96da06e:

    # L "I’ve got just the thing."
    L "Tengo la cosa."

# game/Story01.rpy:7222

translate spanish olivia_fr_scene_2b35b6fe:

    # mc "..."
    mc "..."

# game/Story01.rpy:7223

translate spanish olivia_fr_scene_2b577ec5:

    # mc "Don't worry so much; try to relax a bit more. You're too tense, okay?"
    mc "No te preocupes tanto, trata de relajarte."

# game/Story01.rpy:7225

translate spanish olivia_fr_scene_0d8e332e:

    # mc "If there's anything here you don't like, let us know. We don't bite, and we truly value our employees' opinions."
    mc "Si no te gusta algo aquí, háganos saber que no mordemos y realmente apreciamos las opiniones de nuestro personal."

# game/Story01.rpy:7227

translate spanish olivia_fr_scene_4fa97a48:

    # h "Thank you. I’ll do my best. This is my only chance."
    h "Gracias. Haré lo mejor que pueda. Esta es mi única oportunidad."

# game/Story01.rpy:7229

translate spanish olivia_fr_scene_084b577d:

    # mc "(Yeah, back then I never could've imagined that this shy girl would go on to change not just her life, but ours as well — forever.)"
    mc "(Sí, nunca imaginé que esta chica tímida cambiaría no solo su vida, sino la nuestra... para siempre.)"

# game/Story01.rpy:7233

translate spanish olivia_fr_scene_fe225ead:

    # L "Now, take a look. What do you think?"
    L "Ahora, echa un vistazo. ¿Qué piensas?"

# game/Story01.rpy:7235

translate spanish olivia_fr_scene_e77a24f9:

    # L "This little accessory is quite versatile, so I think it will be much more useful for you during your work here."
    L "Este pequeño accesorio es bastante versátil, así que creo que será mucho más útil para usted durante su trabajo aquí."

# game/Story01.rpy:7237

translate spanish olivia_fr_scene_10326f1a:

    # mc "Now she looks stunning, simply amazing!"
    mc "¡Ahora se ve impresionante, simplemente increíble!"

# game/Story01.rpy:7239

translate spanish olivia_fr_scene_ea5e21a7:

    # L "Alright, sweetheart, we're curious to know your opinion. What do you think about this?"
    L "Vale, cariño, nos interesa tu opinión."

# game/Story01.rpy:7241

translate spanish olivia_fr_scene_4d19a7b0:

    # h "I... I look like I belong."
    h "Me parece que pertenezco."

# game/Story01.rpy:7243

translate spanish olivia_fr_scene_1ec0aff2:

    # h "THANK YOU, thank you so much for this opportunity!"
    h "Gracias, muchas gracias por esta oportunidad."

# game/Story01.rpy:7244

translate spanish olivia_fr_scene_f8f57f63:

    # h "I'll do everything I can to not let you down."
    h "Haré todo lo que esté en mi poder para no defraudarte."

# game/Story01.rpy:7245

translate spanish olivia_fr_scene_d1fe3ef5:

    # mc "(She was indeed very diligent and dedicated, but...)"
    mc "(Ella era muy diligente y dedicada, pero...)"

# game/Story01.rpy:7253

translate spanish olivia_fr_scene_9f55d655:

    # h "OH COME ON! Not again..."
    h "¡Oh, vamos!"

# game/Story01.rpy:7254

translate spanish olivia_fr_scene_ef4a92ff:

    # mc "(He was clumsy. Always dropping something.)"
    mc "Siempre cayendo algo."

# game/Story01.rpy:7257

translate spanish olivia_fr_scene_c1ebf163:

    # mc "(But despite that, we never scolded her. We were understanding.)"
    mc "(Pero a pesar de eso, nunca la regañamos."

# game/Story01.rpy:7258

translate spanish olivia_fr_scene_5405a515:

    # mc "(Perhaps anyone else in our place would've let her go, but we didn't.)"
    mc "(Quizá alguien más la hubiera despedido, pero no lo hicimos.)"

# game/Story01.rpy:7261

translate spanish olivia_fr_scene_29323a0f:

    # mc "(We supported her efforts because we too had been in her shoes once upon a time.)"
    mc "(Nosotros apoyamos sus esfuerzos porque también habíamos estado en sus zapatos una vez por vez.)"

# game/Story01.rpy:7267

translate spanish olivia_fr_scene_6bbbd731:

    # mc "I think it's precisely because we didn't push her away."
    mc "Creo que es porque no la alejamos..."

# game/Story01.rpy:7268

translate spanish olivia_fr_scene_60334832:

    # mc "But instead reached out to her that she became so attached to us."
    mc "Pero en cambio se le ocurrió que se apegó tanto a nosotros."

# game/Story01.rpy:7270

translate spanish olivia_fr_scene_9516ba4b:

    # mc "Though, a lot of credit goes to Olivia herself."
    mc "Aunque, mucho crédito le va a Olivia."

# game/Story01.rpy:7271

translate spanish olivia_fr_scene_fd15de0b:

    # mc "In her place, many would've given up, but she... she kept going, determined."
    mc "En su lugar, muchos se habrían rendido, pero ella... ella siguió, determinó."

# game/Story01.rpy:7273

translate spanish olivia_fr_scene_f9431ba9:

    # Mi "That’s quite a story... "
    Mi "Es una historia... "

# game/Story01.rpy:7275

translate spanish olivia_fr_scene_a2e5c373:

    # Mi "Makes me wonder how different things might’ve been if someone had given me that chance."
    Mi "Me hace preguntarme qué cosas diferentes podrían haber sido si alguien me hubiera dado esa oportunidad."

# game/Story01.rpy:7277

translate spanish olivia_fr_scene_721d4483:

    # mc "What do you mean by that?"
    mc "¿Qué quieres decir con eso?"

# game/Story01.rpy:7279

translate spanish olivia_fr_scene_3ce7dc45:

    # Mi "Oh, it's nothing."
    Mi "Nada."

# game/Story01.rpy:7282

translate spanish olivia_fr_scene_23ddbb95:

    # mc "You never told us your story."
    mc "Nunca nos contaste tu historia."

# game/Story01.rpy:7284

translate spanish olivia_fr_scene_dc50852c:

    # mc "Only if you want to. I'm not forcing you."
    mc "Solo si quieres, no te estoy forzando."

# game/Story01.rpy:7287

translate spanish olivia_fr_scene_06dbc95d:

    # Mi "Maybe one day. For now... I’ll check the perimeter."
    Mi "Quizás un día. Por ahora... revisaré el perímetro."

# game/Story01.rpy:7296

translate spanish olivia_fr_scene_ce336786:

    # mc "(It’s been too long. She should’ve returned by now.)"
    mc "(Ha pasado mucho tiempo. Ella debería haber regresado ahora.)"

# game/Story01.rpy:7298

translate spanish olivia_fr_scene_b4b6cd27:

    # mc "(A part of me wants to run after her...)"
    mc "(Una parte de mí quiere correr tras ella...)"

# game/Story01.rpy:7299

translate spanish olivia_fr_scene_2edc71f0:

    # mc "(But then there’s Olivia. Alone. Still unconscious.)"
    mc "(Pero entonces está Olivia. Solo. Todavía inconsciente.)"

# game/Story01.rpy:7300

translate spanish olivia_fr_scene_86bb08c2:

    # mc "(Damn it. What if something’s already gone wrong?)"
    mc "(Damn it. ¿Qué pasa si algo ya ha ido mal?)"

# game/Story01.rpy:7303

translate spanish olivia_fr_scene_6cb1ee23:

    # h "Mmm..."
    h "Mmm..."

# game/Story01.rpy:7305

translate spanish olivia_fr_scene_0fc0ef36:

    # h "Mmm... No, not yet... please..."
    h "No, aún no... por favor..."

# game/Story01.rpy:7307

translate spanish olivia_fr_scene_c7b05e62:

    # h "...Not here... not in front of them..."
    h "...no aquí... no delante de ellos..."

# game/Story01.rpy:7309

translate spanish olivia_fr_scene_83794487:

    # mc "(Dreaming. And by the sound of it, not a pleasant one.)"
    mc "Y por el sonido de ella, no agradable."

# game/Story01.rpy:7310

translate spanish olivia_fr_scene_a1fa8265:

    # mc "(I should wake her before her mind drags her any deeper.)"
    mc "(Debo despertarla antes de que su mente la arrastre más profundamente.)"

# game/Story01.rpy:7313

translate spanish olivia_fr_scene_78ac430b:

    # mc "Olivia... hey. Wake up. Are you alright?"
    mc "Olivia... despierta. ¿Estás bien?"

# game/Story01.rpy:7315

translate spanish olivia_fr_scene_7cfaea80:

    # h "No... just a few more minutes..."
    h "No... solo unos minutos más..."

# game/Story01.rpy:7317

translate spanish olivia_fr_scene_2fded262:

    # h "..."
    h "..."

# game/Story01.rpy:7319

translate spanish olivia_fr_scene_f150b30a:

    # h "...Why did you pull me from something so perfect?"
    h "¿Por qué me sacaste de algo tan perfecto?"

# game/Story01.rpy:7322

translate spanish olivia_fr_scene_e00f7cd6:

    # h "..What... what happened? Why are we on the ground? Where’s Mirielle?"
    h "...¿Qué... qué pasó? ¿Por qué estamos en el suelo? ¿Dónde está Miriel?"

# game/Story01.rpy:7324

translate spanish olivia_fr_scene_04f89d76:

    # mc "You fainted during our walk. Miriel said it was from exhaustion — your body just gave out."
    mc "Te desmayaste mientras caminábamos. Miriel dijo que fue agotamiento: tu cuerpo simplemente cedió."

# game/Story01.rpy:7326

translate spanish olivia_fr_scene_2fded262_1:

    # h "..."
    h "..."

# game/Story01.rpy:7328

translate spanish olivia_fr_scene_e4c229a9:

    # mc "How are you feeling now? Can you sit up? Do you need anything?"
    mc "¿Cómo te sientes ahora? ¿Puedes sentarte? ¿Necesitas algo?"

# game/Story01.rpy:7330

translate spanish olivia_fr_scene_c7190dfa:

    # h "I’m sorry... I didn’t mean to worry you. I feel better now. Truly."
    h "Lo siento... no quería preocuparte. Ya me siento mejor. De verdad."

# game/Story01.rpy:7332

translate spanish olivia_fr_scene_bfc9c268:

    # h "But... where’s Miriel?"
    h "Pero... ¿dónde está Miriel?"

# game/Story01.rpy:7334

translate spanish olivia_fr_scene_c7e2fb6f:

    # mc "She went to scout ahead. Said she wouldn’t be long."
    mc "Fue a explorar más adelante. Dijo que no tardaría."

# game/Story01.rpy:7337

translate spanish olivia_fr_scene_c7c48f6b:

    # mc "So it’s just the two of us now."
    mc "Así que ahora somos solo los dos."

# game/Story01.rpy:7339

translate spanish olivia_fr_scene_2fded262_2:

    # h "..."
    h "..."

# game/Story01.rpy:7341

translate spanish olivia_fr_scene_4480293b:

    # mc "You’re quiet. Something’s bothering you?"
    mc "Estás callada. ¿Te pasa algo?"

# game/Story01.rpy:7344

translate spanish olivia_fr_scene_0ef37aa5:

    # h "I don’t know. I feel..."
    h "No lo sé. Me siento..."

# game/Story01.rpy:7347

translate spanish olivia_fr_scene_774cd7e2:

    # h "...strange. Like my skin doesn’t fit anymore."
    h "...rara. Como si mi piel ya no me quedara bien."

# game/Story01.rpy:7350

translate spanish olivia_fr_scene_2b35b6fe_1:

    # mc "..."
    mc "..."

# game/Story01.rpy:7352

translate spanish olivia_fr_scene_06192c8f:

    # mc "Strange how?"
    mc "¿Raro cómo?"

# game/Story01.rpy:7354

translate spanish olivia_fr_scene_623501a2:

    # h "Like... an itch deep beneath the surface."
    h "Como... una picazón muy adentro, bajo la piel."

# game/Story01.rpy:7356

translate spanish olivia_fr_scene_7e50d2f8:

    # h "And you... maybe you could help me with that."
    h "Y tú... tal vez podrías ayudarme con eso."

# game/Story01.rpy:7361

translate spanish olivia_fr_scene_331fa9e6:

    # mc "You make it very hard to say no when you look at me like that."
    mc "Haces muy difícil decir que no cuando me miras así."

# game/Story01.rpy:7363

translate spanish olivia_fr_scene_2b3baf04:

    # h "I was hoping you'd say that."
    h "Esperaba que dijeras eso."

# game/Story01.rpy:7366

translate spanish olivia_fr_scene_e7040c52:

    # h "Let’s see if the stories were true. Lora had such colorful things to say about your... nightly visits."
    h "Veamos si las historias eran ciertas. Lora tenía comentarios muy pintorescos sobre tus... visitas nocturnas."

# game/Story01.rpy:7369

translate spanish olivia_fr_scene_2fded262_3:

    # h "..."
    h "..."

# game/Story01.rpy:7371

translate spanish olivia_fr_scene_2ed83991:

    # mc "Something wrong?"
    mc "¿Pasa algo?"

# game/Story01.rpy:7373

translate spanish olivia_fr_scene_78fc7bb8:

    # h "I forgot just how... much there is of you."
    h "Olvidé cuánto había de ti."

# game/Story01.rpy:7374

translate spanish olivia_fr_scene_bed29567:

    # h "Was it always like this? It feels... even bigger now. Like my hand barely covers it."
    h "¿Siempre fue así? Se siente... incluso más grande ahora. Como si mi mano apenas lo cubriera."

# game/Story01.rpy:7377

translate spanish olivia_fr_scene_24c40be6:

    # h "How did I ever take this inside me...?"
    h "¿Cómo pude meterme esto dentro...?"

# game/Story01.rpy:7379

translate spanish olivia_fr_scene_041c6316:

    # mc "You're exaggerating."
    mc "Estás exagerando."

# game/Story01.rpy:7382

translate spanish olivia_fr_scene_e6840c74:

    # mc "Besides... she seemed to enjoy it, so there’s nothing to complain about."
    mc "Además... parecía disfrutarlo, así que no hay nada de qué quejarse."

# game/Story01.rpy:7384

translate spanish olivia_fr_scene_09069090:

    # h "Am I? Doesn’t mean I didn’t enjoy it."
    h "¿Ah, sí? Eso no significa que no lo disfrutara."

# game/Story01.rpy:7385

translate spanish olivia_fr_scene_1748a05c:

    # h "Now shut up and help me scratch this itch."
    h "Ahora cállate y ayúdame con esta picazón."

# game/Story01.rpy:7397

translate spanish olivia_fr_scene_12a1a1d5:

