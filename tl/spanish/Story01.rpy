    mc "¿Y la gente cree eso?"

# game/Story01.rpy:4791

translate spanish street3_0be9e034:

    # Fl "Maybe."
    Fl "Tal vez."

# game/Story01.rpy:4792

translate spanish street3_cdd85515:

    # Fl "Out here, belief isn’t optional."
    Fl "Aquí, creer no es opcional."

# game/Story01.rpy:4793

translate spanish street3_defec1c0:

    # Fl "It’s survival."
    Fl "Es supervivencia."

# game/Story01.rpy:4794

translate spanish street3_818918fe:

    # Fl "And the ones who know how to use that…"
    Fl "Y los que saben cómo usar eso..."

# game/Story01.rpy:4795

translate spanish street3_27e36e27:

    # Fl "they live in places like this."
    Fl "viven en lugares como este."

# game/Story01.rpy:4797

translate spanish street3_3a42cce4:

