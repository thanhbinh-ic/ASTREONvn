translate spanish eye_6e507e18:

    # Fl "You really should pick up a more rewarding hobby."
    Fl "Deberías buscar un pasatiempo más gratificante."

# game/Story01.rpy:2230

translate spanish eye_64b1a79b:

    # o "Heh. More like self-defense."
    o "Je. Más bien defensa propia."

# game/Story01.rpy:2231

translate spanish eye_a2d1cdd7:

    # o "...Anyway. I’ve got patients. You’ve got choices."
    o "...En fin. Yo tengo pacientes. Tú tienes decisiones."

# game/Story01.rpy:2234

translate spanish eye_3a593bbd:

    # o "Don’t just stand there. Go. You might actually make a difference."
    o "No te quedes ahí plantada. Ve. Quizá de verdad puedas hacer algo."

