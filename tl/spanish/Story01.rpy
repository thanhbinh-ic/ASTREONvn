translate spanish laborat_d69c5995_1:

    # o "You okay?"
    o "¿Estás bien?"

# game/Story01.rpy:799

translate spanish laborat_77c13f7f:

    # mc "I... need some time to process all this information."
    mc "Necesito tiempo para procesar toda esta información."

# game/Story01.rpy:801

translate spanish laborat_b03bd4ee:

    # R "In that case, we'll leave it here. I hope we’ve covered everything you needed to know."
    R "En ese caso, lo dejaremos aquí. Espero haber cubierto todo lo que necesitaba saber."

# game/Story01.rpy:806

translate spanish laborat_eb6df64f_1:

    # mc "How can I meet my son? What happened to him?"
    mc "¿Cómo puedo ver a mi hijo? ¿Qué le pasó?"

# game/Story01.rpy:807

translate spanish laborat_dffc2201_1:

    # R "First of all, let me assure you that your son is fine."
    R "Primero, permítame asegurarle que su hijo está bien."

# game/Story01.rpy:809

translate spanish laborat_77b19c30_1:

    # R "But, as things stand right now, you can’t meet him."
    R "Pero, tal como están las cosas ahora mismo, no puede verlo."

# game/Story01.rpy:811

translate spanish laborat_81d9d7fd_1:

    # mc "And why the hell not? I’m perfectly capable of meeting Norman."
    mc "¿Y por qué demonios no? Estoy perfectamente en condiciones de ver a Norman."

# game/Story01.rpy:813

translate spanish laborat_a6320436_1:

    # o "Dr. Lee forgot to mention that you have a scheduled meeting with a very important individual right now. Unfortunately, we don’t have the authority to change that."
    o "El Dr. Li olvidó mencionar que ahora tiene una reunión programada con una persona muy importante. Por desgracia, no tenemos autoridad para cambiar eso."

# game/Story01.rpy:814

translate spanish laborat_555f9bdc_1:

    # o "(whispering) What are you doing? You know about his son. Why are you keeping it from him?"
    o "(susurrando) ¿Qué haces? Sabes lo de su hijo. ¿Por qué se lo ocultas?"

# game/Story01.rpy:816

translate spanish laborat_b53a1376_1:

    # R "(whispering) Go ahead and tell him yourself, then. Let’s see how he reacts."
    R "(susurrando) Entonces adelante, díselo tú. Veamos cómo reacciona."

# game/Story01.rpy:818

translate spanish laborat_005ef0c4_1:

    # mc "(What are they whispering about?)"
    mc "(¿Sobre qué están susurrando?)"

# game/Story01.rpy:819

translate spanish laborat_9bda4351_1:

    # o "(whispering) I hope you know what you’re doing."
    o "(susurrando) Espero que sepas lo que haces."

# game/Story01.rpy:821

translate spanish laborat_2ed83991_1:

    # mc "Something wrong?"
    mc "¿Pasa algo?"

# game/Story01.rpy:823

translate spanish laborat_0149a6eb_1:

    # o "No, no, everything’s fine. Nothing to worry about."
    o "No, no, todo está bien. Nada de qué preocuparse."

# game/Story01.rpy:825

translate spanish laborat_a6889037_1:

    # R "And with that, we're done. I hope we've answered most of your questions."
    R "Y con eso hemos terminado. Espero haber respondido a la mayoría de sus preguntas."

# game/Story01.rpy:830

translate spanish laborat_ba0ab142:

    # R "How are you feeling? No pain? No strange symptoms?"
    R "¿Cómo se siente? ¿Dolor? ¿Síntomas extraños?"

# game/Story01.rpy:832

translate spanish laborat_33025447:

    # mc "Other than the shock and surprise, I’m perfectly fine."
    mc "Más allá del impacto y la sorpresa, estoy perfectamente bien."

# game/Story01.rpy:834

translate spanish laborat_0d1907ff:

    # R "Glad to hear it."
    R "Me alegra oírlo."

# game/Story01.rpy:835

translate spanish laborat_116c9b3c:

    # R "Getting to the main point, the reason you're here is because..."
    R "Yendo al punto principal, la razón por la que está aquí es..."

# game/Story01.rpy:841

translate spanish laborat_9e7df9cb:

    # sci "Sir, the Ark of Light has made their move."
    sci "Señor, el Arca de la Luz ha hecho su movimiento."

# game/Story01.rpy:842

translate spanish laborat_708ed406:

    # sci "They’ve rebelled in full force."
    sci "Se han rebelado con toda su fuerza."

# game/Story01.rpy:844

translate spanish laborat_364c74b7:

    # mc "(Ark of Light?)"
    mc "(¿Arca de la Luz?)"

# game/Story01.rpy:846

translate spanish laborat_c0a35acc:

    # mc "Who are we talking about?"
    mc "¿De quién estamos hablando?"

# game/Story01.rpy:848

translate spanish laborat_9831d3d7:

    # o "A group of fanatics opposing any modification of the human body, blocking technological progress for everyone else."
    o "Un grupo de fanáticos oponen cualquier modificación del cuerpo humano, bloqueando el progreso tecnológico para todos los demás."

# game/Story01.rpy:852

translate spanish laborat_24ff5669:

    # R "But they’ve rebelled before. So, how is this case any different?"
    R "Pero se han rebelado antes. Entonces, ¿cómo es este caso diferente?"

# game/Story01.rpy:853

translate spanish laborat_6654c6d6:

    # sci "The scale, sir, and their threats. It seems they’re far more determined this time."
    sci "La escala, señor, y sus amenazas. Parece que están mucho más decididas esta vez."

# game/Story01.rpy:855

translate spanish laborat_0245869b:

    # o "What triggered their dissatisfaction?"
    o "¿Qué provocó su insatisfacción?"

# game/Story01.rpy:857

translate spanish laborat_33feaab0:

    # sci "Someone leaked our latest research."
    sci "Alguien filtró nuestra última investigación."

# game/Story01.rpy:859

translate spanish laborat_73faf2c5:

    # o "What research are we talking about?"
    o "¿De qué investigación estamos hablando?"

# game/Story01.rpy:861

translate spanish laborat_dd6c90f5:

    # sci "We’ve identified the cause of the monster outbreaks outside the city..."
    sci "Hemos identificado la causa de los brotes de monstruo fuera de la ciudad..."

# game/Story01.rpy:862

translate spanish laborat_2812ff90:

    # R "Who is overseeing this matter? I need the names of those in charge."
    R "¿Quién está supervisando este asunto? Necesito los nombres de los encargados."

# game/Story01.rpy:866

translate spanish laborat_2ac4c279:

    # sci "Here, sir. Take a look."
    sci "Mire, señor."

# game/Story01.rpy:880

translate spanish laborat_c823bbe8:

    # mc "(First, there was the ship, then those cultists who call themselves Ark of Light, and now monsters too? You’ve got to be kidding me — what kind of place is this?)"
    mc "(Primero la nave, luego esos fanáticos que se hacen llamar el Arca de la Luz, ¿y ahora también monstruos? Tiene que ser una broma. ¿Qué clase de lugar es este?)"

# game/Story01.rpy:892

translate spanish laborat_038905b7:

    # mc "(Or was it just my imagination again? Could it be... side effects?)"
    mc "(¿O fue otra vez mi imaginación? ¿Podrían ser... efectos secundarios?)"

# game/Story01.rpy:930

translate spanish laborat_64118ef9:

    # mc "I’m sorry, but for some reason unknown to me, I can’t do it. It feels like... something inside me is holding me back."
    mc "Lo siento, pero no sé por qué, no puedo hacerlo. Es como si... algo dentro de mí me frenara."

# game/Story01.rpy:932

translate spanish laborat_517aee89:

    # o "It could be related..."
    o "Podría estar relacionado..."

# game/Story01.rpy:933

translate spanish laborat_093ec633:

    # o "In that case, we’ll end this conversation for now. I need to discuss this with Dr. Lee."
    o "En ese caso, terminaremos esta conversación por ahora. Necesito hablarlo con el Dr. Li."

# game/Story01.rpy:1030

translate spanish part2_94e56f0d:

    # Mi "My ears. Do they bother you? Seeing them — does it stir something in you? Anger? Hatred? Or maybe pity?"
    Mi "Mis orejas. ¿Le molestan? Verlas... ¿despierta algo en usted? ¿Ira? ¿Odio? ¿Tal vez lástima?"

# game/Story01.rpy:1034

translate spanish part2_e24f3248:

    # mc "And even if I did hate you, what would that accomplish? Especially when your people saved me and my family’s lives."
    mc "Y aunque la odiara, ¿qué conseguiría con eso? Sobre todo después de que su gente nos salvara la vida a mí y a mi familia."

# game/Story01.rpy:1035

translate spanish part2_b9a87fee:

    # mc "I owe you a debt for that — one I can’t easily repay, no matter how hard I try."
    mc "Le debo una deuda por eso, una que no podré pagar fácilmente por mucho que lo intente."

# game/Story01.rpy:1037

translate spanish part2_c35afa3e:

    # mc "From what I’ve heard, you’ve been keeping an eye on us for quite some time now."
    mc "Por lo que he oído, llevan bastante tiempo vigilándonos."

# game/Story01.rpy:1038

translate spanish part2_6b73a76f:

    # mc "After all that assistance, should I just turn my back on the help you’ve given us, just because of your ears?"
    mc "Después de toda esa ayuda, ¿debería darle la espalda a lo que han hecho por nosotros solo por sus orejas?"

# game/Story01.rpy:1039

translate spanish part2_bc90e9db:

    # mc "That’d be utterly absurd."
    mc "Sería absurdo."

# game/Story01.rpy:1041

translate spanish part2_869bcd91:

    # Mi "It’s not just ears."
    Mi "No son solo orejas."

# game/Story01.rpy:1042

translate spanish part2_218d4276:

    # Mi "These are a mark, a symbol. Proof that lines were crossed, mistakes made, and debts paid — paid in blood."
    Mi "Son una marca, un símbolo. La prueba de que se cruzaron líneas, se cometieron errores y se pagaron deudas, pagadas con sangre."

# game/Story01.rpy:1043

translate spanish part2_5c74fb21:

    # Mi "We’ve become outcasts, exiles, hated across the stars."
    Mi "Nos convertimos en marginados, exiliados, odiados a través de las estrellas."

# game/Story01.rpy:1158

translate spanish part2_b5e74a52:

    # Fl "His head goes pop — like a glassfruit under a gravity hammer. Messy, but memorable. Bet it’ll make for a fun story at dinner parties."
    Fl "La cabeza le hace pop, como una fruta de cristal bajo un martillo gravitatorio. Sucio, pero memorable. Seguro que da para una anécdota divertidísima en cenas."

# game/Story01.rpy:1200

translate spanish part2_d5007e35:

    # Fl "Staring at a girl’s chest isn’t exactly star-tier intellect, understand? Keep your eyes and your brain in the right place next time."
    Fl "Mirarle el pecho a una chica no es exactamente intelecto de primera categoría, ¿entendido? La próxima vez, mantén los ojos y el cerebro donde corresponde."

# game/Story01.rpy:1223

translate spanish part2_74a9abc3:

    # h "Alright, I believe you. If you say so, then so be it."
    h "Está bien, te creo. Si tú lo dices, así será."

# game/Story01.rpy:1225

translate spanish part2_0f82ca3c:

    # mc "Right... Anyway, how are you holding up?"
    mc "Bien... En fin, ¿cómo lo llevas?"

# game/Story01.rpy:1227

translate spanish part2_bf7d4a45:

    # h "More or less. Over the past two months, while you were unconscious, I had to learn and adapt to so much..."
    h "Más o menos. Durante estos dos meses, mientras estabas inconsciente, tuve que aprender y adaptarme a tantas cosas..."

# game/Story01.rpy:1229

translate spanish part2_babc5ae8:

    # mc "Wait a minute. I was unconscious for two whole months? You’ve got to be kidding me..."
    mc "Espera un momento. ¿Estuve inconsciente dos meses enteros? Tienes que estar bromeando..."

# game/Story01.rpy:1233

translate spanish part2_54a8f94a:

    # h "For some reason, I feel like hitting you right now..."
    h "Por alguna razón, ahora mismo me dan ganas de golpearte..."

# game/Story01.rpy:1235

translate spanish part2_2fded262_3:

    # h "..."
    h "..."

# game/Story01.rpy:1237

translate spanish part2_7355c323:

    # h "Yes, you were out for two months."
    h "Sí, estuviste fuera dos meses."

# game/Story01.rpy:1238

translate spanish part2_74be0be5:

    # h "And they were the hardest months of my life. Thoughts and nightmares about your death haunted me endlessly."
    h "Y fueron los meses más duros de mi vida. No dejaban de perseguirme pensamientos y pesadillas sobre tu muerte."

# game/Story01.rpy:1239

translate spanish part2_ad2cac8a:

    # h "To make it worse, the doctors’ predictions didn’t inspire confidence. When I saw you in that state, I... "
    h "Para empeorarlo, los pronósticos de los médicos no inspiraban ninguna confianza. Cuando te vi en ese estado, yo... "

# game/Story01.rpy:1247

translate spanish part2_2fded262_4:

    # h "..."
    h "..."

# game/Story01.rpy:1249

translate spanish part2_6fe2c18f:

    # h "I felt like I was all alone here, in an unfamiliar place, without family or anyone close to me."
    h "Sentí que estaba sola aquí, en un lugar desconocido, sin familia ni nadie cercano."

# game/Story01.rpy:1250

translate spanish part2_8eaa8bab:

    # h "A void started growing inside me... But coming to see you every day, watching your condition improve little by little, gave me hope."
    h "Un vacío empezó a crecer dentro de mí... pero venir a verte cada día, ver cómo tu estado mejoraba poco a poco, me dio esperanza."

# game/Story01.rpy:1252

translate spanish part2_6a04dd7e:

    # mc "Thank you for that. If it hadn’t been for your presence, I’m not sure I’d have made it through that state."
    mc "Gracias por eso. Si no hubiera sido por ti, no estoy seguro de haber salido de ese estado."

# game/Story01.rpy:1254

translate spanish part2_2fded262_5:

    # h "..."
    h "..."

# game/Story01.rpy:1257

translate spanish part2_34cec937:

    # mc "Is something wrong?"
    mc "¿Pasa algo?"

# game/Story01.rpy:1261

translate spanish part2_ab2e4598:

    # h "You’ve changed... Your eyes, they..."
    h "Has cambiado... tus ojos..."

# game/Story01.rpy:1265

translate spanish part2_fec8e16a:

    # h "(whispering) No, Olivia, now isn’t the time..."
    h "(susurrando) No, Olivia, ahora no es el momento..."

# game/Story01.rpy:1267

translate spanish part2_fb368e45:

    # h "Alright, let’s go. There’s so much I need to tell you."
    h "Está bien, vamos. Tengo muchísimo que contarte."

# game/Story01.rpy:1269

translate spanish part2_6bbcedd1:

    # h "While you were unconscious, I immersed myself in learning everything I could."
    h "Mientras estabas inconsciente, me dediqué a aprender todo lo que pude."

# game/Story01.rpy:1270

translate spanish part2_3a7d1996:

    # h "And I think it’s time you learned a little about this world."
    h "Y creo que ya va siendo hora de que aprendas un poco sobre este mundo."

# game/Story01.rpy:1293

translate spanish firstanswer_276e72d8:

    # mc "So, where are we? What is this place? Are we on another planet? What are we even doing here?"
    mc "Entonces, ¿dónde estamos? ¿Qué es este lugar? ¿Estamos en otro planeta? ¿Qué estamos haciendo aquí?"

# game/Story01.rpy:1295

translate spanish firstanswer_c9f6f5a6:

    # mc "I’ve been given the gist of it, but I’d like to know more about where exactly we are. What is this place? Are we really on another planet? And how does..."
    mc "Me dieron la idea general, pero quisiera saber con más precisión dónde estamos. ¿Qué es este lugar? ¿De verdad estamos en otro planeta? Y cómo..."

# game/Story01.rpy:1297

translate spanish firstanswer_5da006ba:

    # h "Hold on. I understand your desire to know everything at once, but this isn’t the time. Let’s take it step by step — where are we?"
    h "Espera. Entiendo que quieras saberlo todo de golpe, pero este no es el momento. Vamos paso a paso: ¿dónde estamos?"

# game/Story01.rpy:1298

translate spanish firstanswer_e5d08311:

    # h "We’re currently in the territory of the Arks Confederation, a democratic union of several systems."
    h "Ahora mismo estamos en territorio de la Confederación Arks, una unión democrática de varios sistemas."

# game/Story01.rpy:1299

translate spanish firstanswer_4017b54f:

    # h "What is this place? This is the Citadel, where most of the council’s high-ranking members convene."
    h "¿Qué es este lugar? Es la Ciudadela, donde se reúne la mayoría de los miembros de alto rango del consejo."

# game/Story01.rpy:1301

translate spanish firstanswer_95dffca6:

    # mc "Council members? You mean politicians?"
    mc "¿Miembros del consejo? ¿Te refieres a políticos?"

# game/Story01.rpy:1303

translate spanish firstanswer_1dfd0ab9:

    # h "Not exactly. The difference lies in scale. Politicians represent the interests of their planet or system."
    h "No exactamente. La diferencia está en la escala. Los políticos representan los intereses de su planeta o sistema."

# game/Story01.rpy:1304

translate spanish firstanswer_cab43aa2:

    # h "The council, on the other hand, determines the policies and actions for an entire race or even the entire Confederation."
    h "El consejo, en cambio, define las políticas y acciones de toda una raza o incluso de toda la Confederación."

# game/Story01.rpy:1305

translate spanish firstanswer_b3900d56:

    # h "Politicians can come from any race, but council members... that’s a different story."
    h "Los políticos pueden venir de cualquier raza, pero los miembros del consejo... eso ya es otra historia."

# game/Story01.rpy:1307

translate spanish firstanswer_1a7295c8:

    # mc "You said it’s a democratic union... But why don’t they allow members of other races on the council?"
    mc "Dijiste que era una unión democrática... pero ¿por qué no permiten a los miembros de otras razas en el consejo?"

# game/Story01.rpy:1309

translate spanish firstanswer_57c94f97:

    # h "Would you want someone fundamentally different from you — someone who doesn’t even breathe the same air — deciding your fate and worldview?"
    h "¿Querrías que alguien fundamentalmente distinto de ti, alguien que ni siquiera respira el mismo aire, decidiera tu destino y tu forma de ver el mundo?"

# game/Story01.rpy:1311

translate spanish firstanswer_7b503e7f:

    # mc "That’s... a fair point"
    mc "Es... un buen punto."

# game/Story01.rpy:1313

translate spanish firstanswer_b44eb90c:

    # h "Exactly."
    h "Exactamente."

# game/Story01.rpy:1314

translate spanish firstanswer_57df9fc9:

    # h "As for your other question — yes, we’re on another planet. But honestly, even I haven’t fully grasped the scope of it yet."
    h "En cuanto a tu otra pregunta: sí, estamos en otro planeta. Pero, sinceramente, ni siquiera yo termino de asimilar la escala de todo esto."

# game/Story01.rpy:1324

translate spanish firstanswer_a3d04b4b:

    # mc "I have another question about the races... Over this time, I’ve met at least an elf and some beast-men. But that can’t be all, right?"
    mc "Tengo otra pregunta sobre las razas... En este tiempo he conocido al menos a un elfo y a algunos hombres bestia. Pero no puede ser solo eso, ¿verdad?"

# game/Story01.rpy:1326

translate spanish firstanswer_df5ca1c4:

    # h "From what I’ve learned, there are 13 main races in this world. But aside from the main ones, there are also subraces."
    h "Por lo que he aprendido, en este mundo hay 13 razas principales. Pero además de las principales, también existen subrazas."

# game/Story01.rpy:1328

translate spanish firstanswer_2027184c:

    # mc "Subraces?"
    mc "¿Subrazas?"

# game/Story01.rpy:1330

translate spanish firstanswer_d049ff26:

    # h "Hybrids. When individuals from different races decide to... well, have a child together, a subrace is born—something new and unique."
    h "Híbridos. Cuando individuos de razas distintas deciden... bueno, tener un hijo juntos, nace una subraza: algo nuevo y único."

# game/Story01.rpy:1331

translate spanish firstanswer_177ccc4b:

    # h "That’s the theory, at least. In practice, these beings are often ostracized, shunned, and even ridiculed."
    h "Esa es la teoría, al menos. En la práctica, a estos seres suelen marginarlos, rechazarlos e incluso ridiculizarlos."

# game/Story01.rpy:1340

translate spanish firstanswer_2af44c4d:

    # mc "What about governance? How is everything structured here?"
    mc "¿Y el gobierno? ¿Cómo está estructurado todo aquí?"

# game/Story01.rpy:1342

translate spanish firstanswer_01a8e662:

    # h "It depends on the system. The Arks Confederation, for instance, is officially a democratic structure."
    h "Depende del sistema. La Confederación Arks, por ejemplo, es oficialmente una estructura democrática."

# game/Story01.rpy:1343

translate spanish firstanswer_531a8811:

    # h "But in reality, it’s a mix of aristocracy and technocracy. Power belongs to those who can prove their worth."
    h "Pero en realidad es una mezcla de aristocracia y tecnocracia. El poder pertenece a quienes pueden demostrar su valor."

# game/Story01.rpy:1345

translate spanish firstanswer_5632b8f9:

    # mc "Aristocracy and technocracy? What does that even mean?"
    mc "¿Aristocracia y tecnocracia? ¿Qué significa eso?"

# game/Story01.rpy:1347

translate spanish firstanswer_e9809626:

    # h "Aristocracy is when power belongs to those who were born into a privileged family or inherited their status."
    h "La aristocracia es cuando el poder pertenece a quienes nacieron en una familia privilegiada o heredaron su estatus."

# game/Story01.rpy:1349

translate spanish firstanswer_e03785f1:

    # mc "So, the rich and influential rule?"
    mc "Entonces gobiernan los ricos y los influyentes."

# game/Story01.rpy:1351

translate spanish firstanswer_aa4ceb80:

    # h "Exactly. Technocracy, on the other hand, is the rule of specialists — those who possess knowledge, advanced technology, or the ability to solve complex problems."
    h "Exacto. La tecnocracia, por otro lado, es el gobierno de los especialistas: quienes poseen conocimientos, tecnología avanzada o la capacidad de resolver problemas complejos."

# game/Story01.rpy:1353

translate spanish firstanswer_5149e99b:

    # mc "So it's either wealth or brains?"
    mc "Entonces es riqueza o cerebro."

# game/Story01.rpy:1355

translate spanish firstanswer_34bd04bc:

    # h "Ideally, both."
    h "Lo ideal, ambas cosas."

# game/Story01.rpy:1357

translate spanish firstanswer_47cb6e36:

    # mc "And what about the other factions? How do they govern?"
    mc "¿Y las otras facciones? ¿Cómo gobiernan?"

# game/Story01.rpy:1359

translate spanish firstanswer_6f63a7ed:

    # h "It's more complicated with them. For example, the Astral Dominion is entirely authoritarian — it's ruled by a single Grand Magister."
    h "Con ellas es más complicado. Por ejemplo, el Dominio Astral es completamente autoritario: lo gobierna un único Gran Magíster."

# game/Story01.rpy:1360

translate spanish firstanswer_6781de38:

    # h "The Omnion Syndicate doesn't really have a formal government. Everything there revolves around money and the power of individual families."
    h "El Omnion Syndicate no tiene un gobierno formal. Allí todo gira en torno al dinero y al poder de familias individuales."

# game/Story01.rpy:1362

translate spanish firstanswer_4909dd84:

    # mc "What about the Ark of Light?"
    mc "¿Qué hay del Arca de la Luz?"

# game/Story01.rpy:1364

translate spanish firstanswer_dbf65386:

    # h "A dictatorship—but they call it 'purity.' They see themselves as instruments of the ancients' will."
    h "Una dictadura, aunque ellos la llaman \"pureza\". Se ven a sí mismos como instrumentos de la voluntad de los antiguos."

# game/Story01.rpy:1365

translate spanish firstanswer_0b6307de:

    # h "For them, ruling isn't governance; it's fulfilling a divine purpose."
    h "Para ellos, gobernar no es administrar poder; es cumplir un propósito divino."

# game/Story01.rpy:1367

translate spanish firstanswer_8c2a5012:

    # mc "Something tells me there's not a lot of personal freedom in that system."
    mc "Algo me dice que en ese sistema no hay mucha libertad personal."

# game/Story01.rpy:1369

translate spanish firstanswer_77f01917:

