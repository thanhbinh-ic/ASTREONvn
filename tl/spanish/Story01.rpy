translate spanish eye_efad8190:

    # Fl "(whispers) Stay safe, Father."
    Fl "(en voz baja) Cuídate, padre."

# game/Story01.rpy:2240

translate spanish eye_bc0c86cb:

    # Fl "Well, look who clawed his way back from the abyss."
