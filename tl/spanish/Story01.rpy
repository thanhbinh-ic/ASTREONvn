    # Fl "…You’re weird."
    Fl "...Eres raro."

# game/Story01.rpy:4770

translate spanish street3_d77790fd:

    # Fl "Most people thought it was a myth."
    Fl "La mayoría de la gente pensaba que era un mito."

# game/Story01.rpy:4771

translate spanish street3_5b2c50e6:

    # Fl "Others would tear each other apart to be in your place."
    Fl "Otros se despedazarían entre sí por estar en tu lugar."

# game/Story01.rpy:4774

translate spanish street3_c7c201f1:

    # mc "I never asked for any of this."
    mc "Nunca pedí nada de esto."

# game/Story01.rpy:4776

translate spanish street3_aef83bf0:

    # Fl "Yeah."
    Fl "Sí."

# game/Story01.rpy:4776

translate spanish street3_e0216b8c:

    # Fl "I’m a little jealous."
    Fl "Estoy un poco celosa."

# game/Story01.rpy:4779

translate spanish street3_25a9332c:

    # mc "Tell me, this Ark of yours… what is it?"
    mc "Dime, esta Arca tuya... ¿qué es?"

# game/Story01.rpy:4782

translate spanish street3_f2baf678:

    # Fl "No idea."
    Fl "Ni idea."

# game/Story01.rpy:4783

translate spanish street3_10c43df8:

    # Fl "Just rumors stacked on rumors."
    Fl "Solo rumores sobre rumores."

# game/Story01.rpy:4784

translate spanish street3_096a8c2d:

    # mc "The most popular one?"
    mc "¿El más popular?"

# game/Story01.rpy:4785

translate spanish street3_7348a48c:

    # Fl "The popular one?"
    Fl "¿El más popular?"

# game/Story01.rpy:4786

translate spanish street3_6ab25b9b:

    # Fl "Something about eternal life."
    Fl "Algo sobre la vida eterna."

# game/Story01.rpy:4787

translate spanish street3_bac17592:

