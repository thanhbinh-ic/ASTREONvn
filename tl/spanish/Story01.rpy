translate spanish path_first_left_next_5_305e3fd8_1:

    # Fl "With the right gear — which you don’t have. Not yet."
    Fl "Con el equipo adecuado —que no tienes. Aún no."

# game/Story01.rpy:5476

translate spanish path_first_left_next_5_04595e4e_1:

    # mc "Fantastic. Encouraging as always."
    mc "Fantástico, estimulándose como siempre."

# game/Story01.rpy:5491

translate spanish path_first_left_next_8_7b9a952c:

    # Fl "Dead end. No use pressing forward."
    Fl "No hay necesidad de avanzar."

# game/Story01.rpy:5492

translate spanish path_first_left_next_8_586073af:

    # mc "Still worth a look. Might be a hidden route."
    mc "Podría ser una ruta oculta."

# game/Story01.rpy:5519

translate spanish path_second_up_2_28590057:

    # Fl "Detectors are on the fritz. Could be empty. Or we’re walking into an ambush."
    Fl "Los detectores están en el fritz. Podría estar vacío. O estamos caminando en una emboscada."

# game/Story01.rpy:5520

translate spanish path_second_up_2_afe4e65e:

    # mc "Got it. Staying sharp."
    mc "Lo tengo, quédate afilado."

# game/Story01.rpy:5522

translate spanish path_second_up_2_9e2f08d5:

    # mc "Looks like a patrol ship crashed here. Must’ve been shot down."
    mc "Parece que un barco de patrulla se estrelló aquí."

# game/Story01.rpy:5523

translate spanish path_second_up_2_1e2de1a6:

    # Fl "No sign of the crew. Maybe they bailed. Maybe they didn’t."
    Fl "No hay señales de la tripulación. Tal vez se fueron. Tal vez no lo hicieron."

# game/Story01.rpy:5524

translate spanish path_second_up_2_90e71768:

    # mc "Better than burning alive inside."
    mc "Mejor que quemar vivo dentro."

# game/Story01.rpy:5526

translate spanish path_second_up_2_f0c681d6:

    # mc "No way around. Damn."
    mc "No hay manera de rodear."

# game/Story01.rpy:5528

translate spanish path_second_up_2_62e14c58:

    # Fl "Not quite a dead end. There’s a metro access point around the corner. Should link back to the main path."
    Fl "No es un callejón sin salida. Hay un punto de acceso al metro alrededor de la esquina. Debe conectarse de nuevo a la ruta principal."

# game/Story01.rpy:5529

translate spanish path_second_up_2_ca5269b7:

    # mc "Checking it now."
    mc "Compruébalo ahora."

# game/Story01.rpy:5551

translate spanish path_second_up_3_2_4ba7b4c8:

    # mc "Big door. Feels like it’s laughing at me."
    mc "Gran puerta. Se siente como si se estuviera riendo de mí."

# game/Story01.rpy:5553

translate spanish path_second_up_3_2_effc8290:

    # Fl "Still — that’s a lead. Beats guessing."
    Fl "Aún así, eso es una pista."

# game/Story01.rpy:5555

translate spanish path_second_up_3_2_c242822a:

    # Fl "Though… there’s something on my sensors. Faint, but ugly. Maybe it’s a good thing that door’s sealed."
    Fl "Aunque... hay algo en mis sensores. Faint, pero feo. Tal vez es algo bueno que la puerta está sellada."

# game/Story01.rpy:5557

translate spanish path_second_up_3_2_0b457588:

    # mc "Copy. Heading back to the main route."
    mc "Regreso a la ruta principal."

# game/Story01.rpy:5567

translate spanish path_second_up_3_3_552a0328:

    # mc "So who are we fighting?"
    mc "¿Entonces quién estamos luchando?"

# game/Story01.rpy:5568

translate spanish path_second_up_3_3_8ba30327:

    # Fl "Soulless. Mutants driven by hunger and rage. And no one knows where they came from."
    Fl "Desalmados. Mutantes impulsados por el hambre y la rabia. Y nadie sabe de dónde salieron."

# game/Story01.rpy:5570

translate spanish path_second_up_3_3_fd61eb4b:

    # Fl "Nasty bastards. You kill one, and two more show up."
    Fl "Malditos, matas a uno y dos más apareces."

# game/Story01.rpy:5571

translate spanish path_second_up_3_3_d7aecfb8:

    # mc "You’re joking?"
    mc "¿Estás bromeando?"

# game/Story01.rpy:5572

translate spanish path_second_up_3_3_196fa6b4:

    # Fl "Not literally. They reproduce insanely fast — like a virus."
    Fl "No literalmente. Se reproducen locamente rápido, como un virus."

# game/Story01.rpy:5573

translate spanish path_second_up_3_3_6cbf9e60:

    # Fl "Let’s discuss it later. Eyes up."
    Fl "Vamos a discutirlo más tarde."

# game/Story01.rpy:5574

translate spanish path_second_up_3_3_9912a7f4:

    # Fl "Movement ahead — tight formation."
    Fl "Movimiento por delante: formación estrecha."

# game/Story01.rpy:5575

translate spanish path_second_up_3_3_10c60323:

    # Fl "Could be people. Could be worse."
    Fl "Podría ser gente, podría ser peor."

# game/Story01.rpy:5578

translate spanish path_second_up_3_3_ba4b3ff6:

    # mc "Copy."
    mc "Copiado."

# game/Story01.rpy:5579

translate spanish path_second_up_3_3_91201c54:

    # Fl "And do me a favor — no lone hero moves this time."
    Fl "Y hazme un favor, ningún héroe solitario se mueve esta vez."

# game/Story01.rpy:5582

translate spanish path_second_up_3_3_fc5769fc:

    # mc "I’d promise… but we both know how I treat bad ideas."
    mc "Prometo... pero ambos sabemos cómo trato malas ideas."

# game/Story01.rpy:5587

translate spanish path_second_up_3_3_2954cd25:

    # g "Cover me! Go, go, go!"
    g "¡Cúbreme!"

# game/Story01.rpy:5593

translate spanish path_second_up_3_3_2c935a3c:

    # gg "How many rounds left?!"
    gg "¿Cuántas rondas quedan?"

# game/Story01.rpy:5598

translate spanish path_second_up_3_3_ad755091:

    # g "Two mags! After that, it’s fists and prayers!"
    g "¡Dos mags! Después de eso, son puños y oraciones!"

# game/Story01.rpy:5601

translate spanish path_second_up_3_3_369b52e1:

    # gg "Seriously?! They’re swarming like it’s feeding time!"
    gg "¡En serio! ¡Están enjambre como si fuera tiempo de alimentación!"

# game/Story01.rpy:5604

translate spanish path_second_up_3_3_42595d7d:

    # g "Shit — reloading!"
    g "¡Mierda, recargando!"

# game/Story01.rpy:5606

translate spanish path_second_up_3_3_aa137322:

    # gg "I’ve got you! Make it fast — I’m down to fumes myself!"
    gg "¡Te tengo! ¡Hazlo rápido — ¡Estoy para mermelada!"

# game/Story01.rpy:5610

translate spanish path_second_up_3_3_a588a83c:

    # g "—WHAT THE HELL?!"
    g "- ¿Qué tal el teléfono?"

# game/Story01.rpy:5611

translate spanish path_second_up_3_3_0b55a3ad:

    # gg "What?!"
    gg "¿Qué?"

# game/Story01.rpy:5612

translate spanish path_second_up_3_3_3c354daf:

    # g "I’m out. Nothing left."
    g "Estoy fuera."

# game/Story01.rpy:5614

translate spanish path_second_up_3_3_b3a04da4:

    # gg "You’re joking?!"
    gg "¿Estás bromeando?!"

# game/Story01.rpy:5615

translate spanish path_second_up_3_3_47bf7195:

    # gg "Back pocket, top right! Spare mag! Drop it, and I’ll drop you!"
    gg "¡En el bolsillo trasero, arriba derecho! ¡Polsa! ¡Tírala, y te dejaré caer!"

# game/Story01.rpy:5642

translate spanish path_second_up_3_3_c780288a:

    # mc "You two still breathing, or am I talking to corpses?"
    mc "¿Todavía respiran, o estoy hablando con los cadáveres?"

# game/Story01.rpy:5643

translate spanish path_second_up_3_3_5c86dcb3:

    # gg "No, sir. We’re alive. Barely. Rest of the squad… gone. The Faceless tore through them."
    gg "No, señor, estamos vivos, Apenas, el resto del equipo... se fue, el sin rostro los atravesó."

# game/Story01.rpy:5660

translate spanish path_second_up_3_3_11fd2df5:

    # mc "This... was the cause of it all?"
    mc "¿Esto... fue la causa de todo?"

# game/Story01.rpy:5661

translate spanish path_second_up_3_3_1fad5786:

    # mc "All that blood. All that ruin. For this?"
    mc "Toda esa sangre, toda esa ruina. ¿Por esto?"

# game/Story01.rpy:5664

translate spanish path_second_up_3_3_040c6996:

    # Fl "Feeling brave now? What’s next — barehanded wrestling?"
    Fl "¿Te sientes valiente ahora? ¿Qué sigue: lucha desleal?"

# game/Story01.rpy:5665

translate spanish path_second_up_3_3_330b1f9f:

    # Fl "Maybe if you’d finished the job last time, we wouldn’t be swimming in entrails."
    Fl "Tal vez si hubieras terminado el trabajo la última vez, no estaríamos nadando en las entrañas."

# game/Story01.rpy:5667

translate spanish path_second_up_3_3_29735dc3:

    # mc "Victory doesn’t pick the strongest. Just the one who slips last."
    mc "La victoria no es el más fuerte. Solo el que se desliza por última vez."

# game/Story01.rpy:5668

translate spanish path_second_up_3_3_90c30278:

    # mc "But hey — if you plan to keep reminding me, I can start tuning you out right now."
    mc "Pero oye, si planeas seguir recordándome, puedo empezar a afinarte ahora mismo."

# game/Story01.rpy:5670

translate spanish path_second_up_3_3_6e2a444b:

    # g "We would've been dead without you. Thank you."
    g "Estaríamos muertos sin ti."

# game/Story01.rpy:5672

translate spanish path_second_up_3_3_50682a52:

    # gg "We didn’t even know you were with us..."
    gg "Ni siquiera sabíamos que estabas con nosotros..."

# game/Story01.rpy:5679

translate spanish path_second_up_3_3_b3ca731a:

    # gg "Sir... you’re Inquisition, right?"
    gg "Señor... usted es Inquisición, ¿verdad?"

# game/Story01.rpy:5686

translate spanish path_second_up_3_3_df5e171f:

    # Fl "Nice outfit, Inquisition boy. That whole “I’ve already judged you guilty” look? Nailed it."
    Fl "Bonito traje, chico de la Inquisición. ¿Ese conjunto “ya te he juzgado culpable”? Nailed it."

# game/Story01.rpy:5687

translate spanish path_second_up_3_3_8f6caef6:

    # mc "(whispering) Oh this? Hand-me-downs. From your dad, actually."
    mc "De tu padre, en realidad."

# game/Story01.rpy:5688

translate spanish path_second_up_3_3_e18a81dc:

    # Fl "Let me guess. His last guest liked the martyr look. Or maybe, like you, he collects trouble."
    Fl "A su último invitado le gustó la mirada martirista o tal vez, como tú, él recoge problemas."

# game/Story01.rpy:5692

translate spanish path_second_up_3_3_023f9de8:

    # Fl "Ah, the strong silent type. Keep brooding like that and maybe they’ll put you on some propaganda poster. 'Hope wears a scowl.'"
    Fl "Ese tipo silencioso fuerte, sigue mirando tan reflexivamente, y tal vez te pongas en un cartel de propaganda, \"La esperanza está frunciendo\"."

# game/Story01.rpy:5695

translate spanish path_second_up_3_3_a5be7f33:

    # mc "We intercepted a transmission. Strike team’s nearby. You know anything?"
    mc "Interceptamos una transmisión. El equipo de ataque está cerca. ¿Sabes algo?"

# game/Story01.rpy:5696

translate spanish path_second_up_3_3_64e21da6:

    # g "That’s our unit. Or what’s left of it."
    g "Esa es nuestra unidad. O lo que queda de ella."

# game/Story01.rpy:5698

translate spanish path_second_up_3_3_868a4e29:

    # gg "We were sent to reinforce another squad."
    gg "Nos enviaron para reforzar a otro equipo."

# game/Story01.rpy:5699

translate spanish path_second_up_3_3_70224c76:

    # gg "Showed up late. Paid in blood for it."
    gg "Pagó sangre por ella."

# game/Story01.rpy:5701

translate spanish path_second_up_3_3_b98c3d21:

    # mc "Tragic. But expected."
    mc "Trágico, pero esperado."

# game/Story01.rpy:5706

translate spanish path_second_up_3_3_4db819f8:

    # mc "If we stay here, we’re just more names on a wall."
    mc "Si nos quedamos aquí, solo somos más nombres en una pared."

# game/Story01.rpy:5718

translate spanish path_second_up_3_3_2ffac996:

    # gg "Upstairs — command center’s still standing."
    gg "Arriba — el centro de mando todavía está de pie."

# game/Story01.rpy:5719

translate spanish path_second_up_3_3_0404f5b1:

    # gg "Thanks sir. We owe you. May Aldarion watch over you."
    gg "Gracias, señor, le debemos, que Aldarion le cuide."

# game/Story01.rpy:5721

translate spanish path_second_up_3_3_c26a6fef:

    # mc "Yeah thanks."
    mc "Sí, gracias."

# game/Story01.rpy:5727

translate spanish path_second_up_3_3_b5880d3a:

    # ggg "Sir? What brings you—"
    ggg "Señor, ¿qué le trae...?"

# game/Story01.rpy:5730

translate spanish path_second_up_3_3_3162300c:

    # mc "My feet brought me here. Heard this place had people I was supposed to meet."
    mc "Me trajeron los pies aquí, escuché que este lugar tenía gente que debía conocer."

# game/Story01.rpy:5731

translate spanish path_second_up_3_3_82d54876:

    # mc "Thought I’d say hello."
    mc "Pensé que diría hola."

# game/Story01.rpy:5739

translate spanish path_second_up_3_3_62aa6322:

    # Fl "Wow. “My feet brought me.” You auditioning for prophet or just winging it?"
    Fl "Wow. Mis pies me trajeron. ¿Estás audindo para profeta o simplemente alabarlo?"

# game/Story01.rpy:5741

translate spanish path_second_up_3_3_185232f6:

    # mc "Worked, didn’t it?"
    mc "¿Funcionó, no?"

# game/Story01.rpy:5743

translate spanish path_second_up_3_3_995c4713:

    # Fl "Sadly, yes. I’ve heard dumber."
    Fl "Tristemente, sí. He oído más tonto."

# game/Story01.rpy:5748

translate spanish path_second_up_3_3_ea97710f:

    # mc "My mission is clear. Identify and extinguish threats to the will of Aldarion."
    mc "Mi misión es clara. Identificar y extinguir las amenazas a la voluntad de Aldarion."

# game/Story01.rpy:5749

translate spanish path_second_up_3_3_04b080fd:

    # mc "Stand in my way, and you’ll share their fate."
    mc "Párate en mi camino, y compartirás su destino."

# game/Story01.rpy:5750

translate spanish path_second_up_3_3_365e9f79:

    # ggg "N-No, sir! I-I just needed to know—!"
    ggg "¡No, señor! ¡Solo necesitaba saberlo!"

# game/Story01.rpy:5751

translate spanish path_second_up_3_3_58f1113b:

    # mc "You don’t need to know. Just stay out of my path and pray I don’t find what I’m looking for."
    mc "No necesitas saber. Solo mantente fuera de mi camino y reza No encuentro lo que estoy buscando."

# game/Story01.rpy:5752

translate spanish path_second_up_3_3_b032272b:

    # ggg "Y-Yes, sir! Right away!"
    ggg "¡Sí, señor!"

# game/Story01.rpy:5759

translate spanish path_second_up_3_3_8cf6632e:

    # Fl "You really went full Inquisition there. I almost bought it."
    Fl "Realmente fuiste a la Inquisición llena, casi lo compré."

# game/Story01.rpy:5761

translate spanish path_second_up_3_3_7c1fafce:

    # mc "If they think I’m one of them, might as well make it useful."
    mc "Si creen que soy uno de ellos, también podría hacerlo útil."

# game/Story01.rpy:5763

translate spanish path_second_up_3_3_5a6b5cf9:

    # Fl "Surprisingly practical. I’m impressed — and mildly alarmed."
    Fl "Sorprendentemente práctico. Estoy impresionado y ligeramente alarmado."

# game/Story01.rpy:5766

translate spanish path_second_up_3_3_202f6967:

    # mc "Someone needed help. I showed up. That’s all."
    mc "Alguien necesitaba ayuda. Yo aparecí. Eso es todo."

# game/Story01.rpy:5767

translate spanish path_second_up_3_3_771ea750:

    # ggg "Understood. Please — proceed."
    ggg "Entendido. Por favor, proceda."

# game/Story01.rpy:5774

translate spanish path_second_up_3_3_ba065c51:

    # Fl "Wow. You're just dripping with charm today."
    Fl "Vaya, hoy estás exudiendo mucho encanto."

# game/Story01.rpy:5776

translate spanish path_second_up_3_3_40b3d866:

    # mc "I’m not here to entertain."
    mc "No estoy aquí para entretener."

# game/Story01.rpy:5778

translate spanish path_second_up_3_3_bfb25243:

    # Fl "Shame. You’d make a hell of a tragic lead."
    Fl "Vergüenza. Serías una gran ventaja."

# game/Story01.rpy:5783

translate spanish path_second_up_3_3_6c149f47:

    # mc "This is the command post? Looks like a homeless shelter."
    mc "¿Este es el puesto de mando?"

# game/Story01.rpy:5786

translate spanish path_second_up_3_3_54920aee:

    # Fl "Please. What did you expect from the slums? Of course everything looks like crap."
    Fl "Por favor, ¿qué esperabas de los barrios marginales?"

# game/Story01.rpy:5788

translate spanish path_second_up_3_3_134b03cc:

    # mc "Not exactly a glorious fate, huh."
    mc "No es exactamente un destino glorioso, ¿eh?"

# game/Story01.rpy:5791

translate spanish path_second_up_3_3_4fcede52:

    # Fl "Oh no… I just found out who’s in charge of this operation."
    Fl "Oh no... acabo de descubrir quién está a cargo de esta operación."

# game/Story01.rpy:5792

translate spanish path_second_up_3_3_3cc57e2c:

    # Fl "Disgusting man."
    Fl "Hombre repugnante."

# game/Story01.rpy:5795

translate spanish path_second_up_3_3_3b6f4b85:

    # mc "You’ve worked with him?"
    mc "¿Has trabajado con él?"

# game/Story01.rpy:5797

translate spanish path_second_up_3_3_b1507bf2:

    # Fl "Once. Back when I thought the system meant something."
    Fl "Una vez, cuando pensé que el sistema significaba algo."

# game/Story01.rpy:5800

translate spanish path_second_up_3_3_2b35b6fe_4:

    # mc "..."
    mc "..."

# game/Story01.rpy:5803

translate spanish path_second_up_3_3_1fbed1af:

    # mc "Let me guess. Age mellowed him?"
    mc "Déjame adivinar. ¿La edad lo santificó?"

# game/Story01.rpy:5806

translate spanish path_second_up_3_3_2fa4cd1c:

    # Fl "Mellow like acid. Still burns. Just slower."
    Fl "Mellow como ácido, todavía quema, más despacio."

# game/Story01.rpy:5809

translate spanish path_second_up_3_3_e8207156:

    # mc "Can’t be that bad."
    mc "No puede ser tan malo."

# game/Story01.rpy:5810

translate spanish path_second_up_3_3_83af87e1:

    # Fl "You’ll see."
    Fl "Ya lo verás."

# game/Story01.rpy:5812

translate spanish path_second_up_3_3_dbd8016d:

    # g "No. Titans won’t break that line."
    g "No. Titanes no romperá esa línea."

# game/Story01.rpy:5814

translate spanish path_second_up_3_3_01c938c4:

    # gg "What if we flank? Cut their link. Starve 'em."
    gg "¿Y si los golpeamos de los flancos?"

# game/Story01.rpy:5816

translate spanish path_second_up_3_3_7cc6e8dc:

    # ex "Fools."
    ex "Tontos."

# game/Story01.rpy:5817

translate spanish path_second_up_3_3_2729b76c:

    # ex "Tactics? Diagrams?"
    ex "¿Tactics?"

# game/Story01.rpy:5818

translate spanish path_second_up_3_3_380e0d46:

    # ex "You don’t bend chaos. You invite it."
    ex "No doblas el caos. Lo invitas."

# game/Story01.rpy:5820

translate spanish path_second_up_3_3_048b671a:

    # ex "Victory isn’t earned by cleverness."
    ex "La victoria no se gana por la astucia."

# game/Story01.rpy:5821

translate spanish path_second_up_3_3_fb18a4db:

    # ex "It belongs to those who make their enemies crawl… toward a salvation that doesn’t exist."
    ex "Pertenece a aquellos que hacen que sus enemigos se arrastran hacia una salvación que no existe."

# game/Story01.rpy:5822

translate spanish path_second_up_3_3_3ad49ae2:

    # ex "Now—"
    ex "Ahora..."

# game/Story01.rpy:5824

translate spanish path_second_up_3_3_91a3a0f5:

    # ex "Who let Inquisition drift into my war room? You lost, mongrel? Or just arrogant?"
    ex "¿Quién dejó que la Inquisición se desplome en mi sala de guerra?"

# game/Story01.rpy:5828

translate spanish path_second_up_3_3_4efbe10f:

    # mc "Hallowed sanctum’? That what we’re calling this dump?"
    mc "¿Que lo que estamos llamando a este basurero?"

# game/Story01.rpy:5829

translate spanish path_second_up_3_3_5e46bd17:

    # mc "Could’ve sworn I walked into a storage closet with delusions of grandeur."
    mc "Pudo haber jurado que caminé en un armario de almacenamiento con delirios de grandeza."

# game/Story01.rpy:5830

translate spanish path_second_up_3_3_8ac96614:

    # mc "Next time I’ll bring incense and a mop.."
    mc "La próxima vez traeré incienso y una cucharada.."

# game/Story01.rpy:5831

translate spanish path_second_up_3_3_2aebb5cc:

    # ex "You insolent—"
    ex "Insolente..."

# game/Story01.rpy:5832

translate spanish path_second_up_3_3_609ead63:

    # Fl "Yep. Same bastard. No filter, no shame."
    Fl "Sí, el mismo bastardo, sin filtro, sin vergüenza."

# game/Story01.rpy:5834

translate spanish path_second_up_3_3_99ad6dbf:

    # mc "You think I came here to kneel?"
    mc "¿Crees que vine aquí para arrodillarme?"

# game/Story01.rpy:5835

translate spanish path_second_up_3_3_d4b3f276:

    # mc "We don’t kneel. Not to titles. Not to smoke and mirrors."
    mc "No nos arrodillamos. No a títulos. No a humo y espejos."

# game/Story01.rpy:5836

translate spanish path_second_up_3_3_b2635013:

    # mc "You want reverence? Try a cathedral. This is a warzone."
    mc "Prueba una catedral, es una zona de guerra."

# game/Story01.rpy:5837

translate spanish path_second_up_3_3_2bf83020:

    # mc "We walk through fire. While you hide behind sandbags."
    mc "Caminamos a través del fuego mientras te escondes detrás de las bolsas de arena."

# game/Story01.rpy:5840

translate spanish path_second_up_3_3_6139db60:

    # ex "…You’ve got teeth."
    ex "...Tienes dientes."

# game/Story01.rpy:5841

translate spanish path_second_up_3_3_3f006fe0:

    # ex "Been a while since someone bit back."
    ex "Hace tiempo que alguien se mordió."

# game/Story01.rpy:5845

translate spanish path_second_up_3_3_a5efb248:

    # ex "Finally, someone from High Command who doesn’t squeal when barked at."
    ex "Finalmente, alguien del Alto Mando que no se arruine cuando se desnuda."

# game/Story01.rpy:5846

translate spanish path_second_up_3_3_8bfc55e9:

    # ex "Still beneath me — but better than the usual fodder."
    ex "Aún debajo de mí, pero mejor que la escalera habitual."

# game/Story01.rpy:5853

translate spanish path_second_up_3_3_d7ebf384:

    # mc "Mongrel? Cute."
    mc "Mongrel, lindo."

# game/Story01.rpy:5854

translate spanish path_second_up_3_3_880af53d:

    # mc "Do I look like I fetch sticks and piss on command?"
    mc "¿Parezco que traigo palos y meo en el mando?"

# game/Story01.rpy:5856

translate spanish path_second_up_3_3_dd2314e9:

    # mc "If anything, you’re the trained dog here — only your leash is made of pride and bad decisions."
    mc "Si algo, eres el perro entrenado aquí, solo tu correa está hecha de orgullo y malas decisiones."

# game/Story01.rpy:5859

translate spanish path_second_up_3_3_12ec4f58:

    # ex "Three out of ten. Try again when you're not whining."
    ex "Inténtalo de nuevo cuando dejas de lloriquear."

# game/Story01.rpy:5864

translate spanish path_second_up_3_3_ed2ea3ff:

    # ex "Thoughts?"
    ex "¿Pensamientos?"

# game/Story01.rpy:5866

translate spanish path_second_up_3_3_dd43262f:

    # gg "He listens. That’s already rare."
    gg "Él escucha. Eso ya es raro."

# game/Story01.rpy:5868

translate spanish path_second_up_3_3_cabd6458:

    # g "He’s sharp. And fast. I’m in."
    g "Está afilado y rápido. Estoy dentro."

# game/Story01.rpy:5870

translate spanish path_second_up_3_3_bac0e626:

    # gggg "Wait — isn’t he the one with ties to the Crusaders’ Commander?"
    gggg "Espera — ¿no es él el que tiene vínculos con el Comandante de los Cruzados?"

# game/Story01.rpy:5872

translate spanish path_second_up_3_3_55b93c5a:

    # gg "Didn’t he gut those thugs who tried to drag that elf girl away?"
    gg "¿No destripó a esos matones que intentaron arrastrar a esa chica elfo?"

# game/Story01.rpy:5873

translate spanish path_second_up_3_3_058d1b54:

    # Fl "Hero of the slums, huh? City’s buzzing with your bedtime stories."
    Fl "Hero de los barrios marginales, ¿eh? City está zumbido con tus historias de dormir."

# game/Story01.rpy:5876

translate spanish path_second_up_3_3_759cbe29:

    # ex "Well, well. A local celebrity. That explains the ego."
    ex "Una celebridad local, eso explica el ego."

# game/Story01.rpy:5879

translate spanish path_second_up_3_3_b0f25014:

    # ex "Good. You’ll need that fire."
    ex "Bien. Necesitarás ese fuego."

# game/Story01.rpy:5881

translate spanish path_second_up_3_3_345be893:

    # mc "Save the praise. What’s the target?"
    mc "Guarda el elogio. ¿Cuál es el objetivo?"

# game/Story01.rpy:5883

translate spanish path_second_up_3_3_e1f68197:

    # ex "Few clicks east. Power station. Soulless hit it hard — severed us from the grid."
    ex "A unos pocos clics al este. La central eléctrica. Los Desalmados la atacaron con fuerza y nos desconectaron de la red."

# game/Story01.rpy:5886

translate spanish path_second_up_3_3_79c71c89:

    # ex "Topside’s a deathtrap. Locked down, swarming."
    ex "Topside es una trampa mortal. Encerrado, enjaulado."

# game/Story01.rpy:5888

translate spanish path_second_up_3_3_9822fb38:

    # mc "Underground?"
    mc "¿Bascado?"

# game/Story01.rpy:5890

translate spanish path_second_up_3_3_78c6b89b:

    # ex "Tunnels would take weeks. We’re out of time."
    ex "Los túneles tardarían semanas. Nos quedamos sin tiempo."

# game/Story01.rpy:5892

translate spanish path_second_up_3_3_79e1ed5b:

    # mc "No metro lines? Sewer access?"
    mc "¿No hay líneas de metro?"

# game/Story01.rpy:5894

translate spanish path_second_up_3_3_3fbd5d73:

    # gggg "Hold on — what if we don’t dig?"
    gggg "Espera, ¿y si no excavamos?"

# game/Story01.rpy:5895

translate spanish path_second_up_3_3_0ee6a342:

    # gggg "We blow through. Weakest point in the foundation — already marked it."
    gggg "Lo volamos. Punto más débil en la fundación — ya lo marcamos."

# game/Story01.rpy:5897

translate spanish path_second_up_3_3_0799d450:

    # g "Short on charges."
    g "Corto por cargos."

# game/Story01.rpy:5899

translate spanish path_second_up_3_3_9460aeb3:

    # gg "But not dry. Just need something nasty."
    gg "Pero no seca, solo necesito algo desagradable."

# game/Story01.rpy:5901

translate spanish path_second_up_3_3_96eedcd3:

    # mc "Gas."
    mc "Gas."

# game/Story01.rpy:5903

translate spanish path_second_up_3_3_4ffe1d86:

    # mc "Vent it right — propane, methane — and the fire’ll carve a tunnel."
    mc "Ventá bien — propano, metano— y el fuego va a tallar un túnel."

# game/Story01.rpy:5905

translate spanish path_second_up_3_3_d58e82d8:

    # mc "One misstep, though, and we’re soup on the ceiling."
    mc "Un mal paso, sin embargo, y estamos sopa en el techo."

# game/Story01.rpy:5907

translate spanish path_second_up_3_3_a5b159df:

    # ex "The support columns might hold. If we map it clean."
    ex "Las columnas de soporte pueden contener. Si lo mapeamos limpio."

# game/Story01.rpy:5908

translate spanish path_second_up_3_3_cce743d3:

    # g "We’ll scavenge the gas."
    g "Vamos a escavenear el gas."

# game/Story01.rpy:5909

translate spanish path_second_up_3_3_1042a1aa:

    # gg "Charges are prepped. Wall’s ready."
    gg "Las cargas están preparadas. Wall está listo."

# game/Story01.rpy:5911

translate spanish path_second_up_3_3_563f3d8e:

    # ex "Then light the match."
    ex "Entonces enciende el partido."

# game/Story01.rpy:5921

translate spanish path_second_up_3_3_37d9f8f3:

    # R "whispering How did it come to this... From a respected scientist to a glorified errand boy."
    R "susurrando ¿Cómo llegó a esto... de un respetado científico a un respetado chico errante."

# game/Story01.rpy:5924

translate spanish path_second_up_3_3_baa4c3cb:

    # R "whispering Stuck here while she roams the galaxy studying the gates?"
    R "¿Susurrando a Stuck mientras vaga la galaxia estudiando las puertas?"

# game/Story01.rpy:5925

translate spanish path_second_up_3_3_b7e973bd:

    # R "(How dare they put her in my place!)"
    R "(¡Cómo se atreven a ponerla en mi lugar!)"

# game/Story01.rpy:5928

translate spanish path_second_up_3_3_e4b1ca48:

    # R "If only she just… disappeared…"
    R "Si ella solo... desapareció..."

# game/Story01.rpy:5931

translate spanish path_second_up_3_3_a812b5fd:

    # R "What the—"
    R "¿Qué...?"

# game/Story01.rpy:5933

translate spanish path_second_up_3_3_8d42ab27:

    # aa "They saw what they weren’t supposed to."
    aa "Ellos vieron lo que se suponía que no debían."

# game/Story01.rpy:5935

translate spanish path_second_up_3_3_249aad57:

    # aa "But don’t worry. That won’t happen to you."
    aa "Pero no te preocupes. Eso no te pasará."

# game/Story01.rpy:5937

translate spanish path_second_up_3_3_3cf53dad:

    # R "What do you want?"
    R "¿Qué quieres?"

# game/Story01.rpy:5939

translate spanish path_second_up_3_3_b332a4e9:

    # aa "We’re aware of your research, Doctor."
    aa "Estamos conscientes de su investigación, Doctor."

# game/Story01.rpy:5940

translate spanish path_second_up_3_3_915187cd:

    # aa "And we’d be very interested in… a collaboration."
    aa "Y estaríamos muy interesados en... una colaboración."

# game/Story01.rpy:5942

translate spanish path_second_up_3_3_6104e5dd:

    # R "Do I have a choice?"
    R "¿Tengo elección?"

# game/Story01.rpy:5944

translate spanish path_second_up_3_3_24b98af0:

    # aa "Of course. You can refuse. But then you’ll share their fate."
    aa "Por supuesto. Puedes rechazarlo, pero entonces compartirás su destino."

# game/Story01.rpy:5947

translate spanish path_second_up_3_3_1c8acf17:

    # am "..."
    am "..."

# game/Story01.rpy:5950

translate spanish path_second_up_3_3_294cc87c:

    # am "Yin, head to the lab. I have a bad feeling about this."
    am "Yin, ve al laboratorio, tengo un mal presentimiento."

# game/Story01.rpy:5953

translate spanish path_second_up_3_3_35a7c413:

    # yin "Yes, ma’am."
    yin "Sí, señora."

# game/Story01.rpy:5956

translate spanish path_second_up_3_3_1c8acf17_1:

    # am "..."
    am "..."

# game/Story01.rpy:5959

translate spanish path_second_up_3_3_3fb09463:

    # am "Now."
    am "Ahora."

# game/Story01.rpy:5961

translate spanish path_second_up_3_3_18d01e80:

    # yin "But ma’—"
    yin "Pero ma'--"

# game/Story01.rpy:5962

translate spanish path_second_up_3_3_1c8acf17_2:

    # am "..."
    am "..."

# game/Story01.rpy:5963

translate spanish path_second_up_3_3_8d681454:

    # yin "Understood."
    yin "Entendido."

# game/Story01.rpy:5966

translate spanish path_second_up_3_3_922a7267:

    # aa "Not planning to run, Lady Astoria?"
    aa "¿No planeas correr, Lady Astoria?"

# game/Story01.rpy:5968

translate spanish path_second_up_3_3_3c8bf924:

    # am "What are you doing here? We have a peace treaty."
    am "Tenemos un tratado de paz."

# game/Story01.rpy:5970

translate spanish path_second_up_3_3_5f819314:

    # aa "Times change, my lady. The old generation gives way to the new."
    aa "Los tiempos cambian, mi señora, la vieja generación da paso a lo nuevo."

# game/Story01.rpy:5971

translate spanish path_second_up_3_3_c8e9913f:

    # am "Gorem won’t like what you’re doing."
    am "A Gorem no le gusta lo que estás haciendo."

# game/Story01.rpy:5973

translate spanish path_second_up_3_3_4d59f827:

    # aaa "Father is dead. He was a foolish and naive ruler."
    aaa "Padre está muerto, era un gobernante tonto e ingenuo."

# game/Story01.rpy:5975

translate spanish path_second_up_3_3_23107602:

    # am "Selvaria, we both know that’s not true. He was a wise man."
    am "Selvaria, ambos sabemos que eso no es verdad. Él era un hombre sabio."

# game/Story01.rpy:5976

translate spanish path_second_up_3_3_b7bb24f2:

    # am "Then why?"
    am "¿Entonces por qué?"

# game/Story01.rpy:5978

translate spanish path_second_up_3_3_3630e706:

    # sel "How much longer were we supposed to endure humiliation from other races? Centuries?"
    sel "¿Cuánto tiempo más se suponía que íbamos a soportar la humillación de otras razas?"

# game/Story01.rpy:5980

translate spanish path_second_up_3_3_3cb0eb89:

    # am "And your solution is… to declare war on us?"
    am "¿Y tu solución es declararnos la guerra?"

# game/Story01.rpy:5981

translate spanish path_second_up_3_3_3d2efd4c:

    # am "What’s stopping me from killing both of you right now for your betrayal?"
    am "¿Qué me impide matar a ambos ahora mismo por su traición?"

# game/Story01.rpy:5984

translate spanish path_second_up_3_3_19d94f74:

    # y "They... They’ve taken our planet hostage."
    y "Ellos... han tomado a nuestro planeta como rehenes."

# game/Story01.rpy:5985

translate spanish path_second_up_3_3_1c8acf17_3:

    # am "..."
    am "..."

# game/Story01.rpy:5987

translate spanish path_second_up_3_3_b8d34665:

    # sel "Don’t do anything stupid, Astoria. Unless you want to say goodbye to your life."
    sel "No hagas nada estúpido, Astoria. A menos que quieras despedirte de tu vida."

# game/Story01.rpy:5989

translate spanish path_second_up_3_3_1c8acf17_4:

    # am "..."
    am "..."

# game/Story01.rpy:5990

translate spanish path_second_up_3_3_aeadf272:

    # am "(Did you notify the Inquisition?)"
    am "(¿Lo notificó a la Inquisición?)"

# game/Story01.rpy:5991

translate spanish path_second_up_3_3_5dcd2c7f:

    # y "(Yes, my lady. They’re on their way.)"
    y "(Sí, mi señora. Están en camino.)"

# game/Story01.rpy:6006

translate spanish gate2_44726e11:

    # mc "This ad’s a masterpiece. Another miracle cure. Lose your dignity, your credits, and probably your genitals."
    mc "Este anuncio es una obra maestra. Otra cura milagrosa: pierdes tu dignidad, tus créditos y probablemente tus genitales."

# game/Story01.rpy:6008

translate spanish gate2_136a2dcb:

    # mc "‘Penis Enhancer 9000.’ Choose the best from our premium selection.’"
    mc "'Potenciador de Pene 9000'. Elige lo mejor de nuestra selección premium."

# game/Story01.rpy:6009

translate spanish gate2_03d9c563:

    # mc "...and people fall for this?"
    mc "...¿y la gente cae en esto?"

# game/Story01.rpy:6012

translate spanish gate2_4509fbdf:

    # Fl "That’s the one endorsed by Mr. Stallion, right? The guy who turned his junk into a meme and a marketing brand."
    Fl "Ese es el que promociona el Sr. Stallion, ¿verdad? El tipo que convirtió sus partes en un meme y una marca comercial."

# game/Story01.rpy:6013

translate spanish gate2_3ba3517a:

    # Fl "Made the evening news. Twice."
    Fl "Salió en las noticias nocturnas. Dos veces."

# game/Story01.rpy:6015

translate spanish gate2_5c93f98e:

    # mc "I see. Modern heroism — one cybernetic phallus at a time."
    mc "Ya veo. Heroísmo moderno: un falo cibernético a la vez."

# game/Story01.rpy:6017

translate spanish gate2_044a01f7:

    # mc "Fine print: ‘We are not liable for injury, dysfunction, or sudden detachment.’"
    mc "Letra pequeña: 'No nos hacemos responsables de lesiones, disfunción o desprendimiento repentino'."

# game/Story01.rpy:6018

translate spanish gate2_282bee87:

    # mc "...Sudden detachment?"
    mc "...¿Desprendimiento repentino?"

# game/Story01.rpy:6020

translate spanish gate2_ab3a3be3:

    # Fl "Drama queen. That’s nothing. I’ve seen ads that made my neural implants glitch out from secondhand embarrassment."
    Fl "Reina del drama. Eso no es nada. He visto anuncios que hicieron fallar mis implantes neuronales de pura vergüenza ajena."

# game/Story01.rpy:6022

translate spanish gate2_8ad9fbe0:

    # mc "Okay, stop. Just — stop. I regret asking. Let’s get back to why we’re even here."
    mc "Vale, basta. Simplemente... basta. Me arrepiento de haber preguntado. Volvamos a la razón por la que estamos aquí."

# game/Story01.rpy:6024

translate spanish gate2_c1910294:

    # mc "You’ve read the brief, right?"
    mc "Leíste el informe, ¿verdad?"

# game/Story01.rpy:6026

translate spanish gate2_bc2ec8ad:

    # mc "I need confirmation. And I want a full map of the approach zone. Plus any available schematics of the railway line."
    mc "Necesito confirmación. Y quiero un mapa completo de la zona de aproximación, además de cualquier esquema disponible de la línea ferroviaria."

# game/Story01.rpy:6027

translate spanish gate2_13fc43c3:

    # mc "Also — team info. I want to know who’s covering my back."
    mc "También: información del equipo. Quiero saber quién me cubre la espalda."

# game/Story01.rpy:6029

translate spanish gate2_6a757568:

    # Fl "Sure, boss. Maybe I’ll throw in the exact jammer coordinates too, if you ask nicely."
    Fl "Claro, jefe. Quizá también te pase las coordenadas exactas del interferidor si lo pides con educación."

# game/Story01.rpy:6030

translate spanish gate2_e4b1138e:

    # Fl "Hell, why not a list of tombs in a five-click radius? Want gift wrap with that?"
    Fl "Ya puestos, ¿por qué no una lista de tumbas en un radio de cinco clics? ¿Lo quieres envuelto para regalo?"

# game/Story01.rpy:6032

translate spanish gate2_15bede7c:

    # mc "Flora — I’m serious. I need your head in the game. If we screw this up, no one gets a second chance."
    mc "Flora, hablo en serio. Necesito que estés concentrada. Si la cagamos, nadie tendrá una segunda oportunidad."

# game/Story01.rpy:6036

translate spanish gate2_510f69a1:

    # mc "Why are you suddenly quiet? You find something?"
    mc "¿Por qué te quedaste callada de repente? ¿Encontraste algo?"

# game/Story01.rpy:6042

translate spanish gate2_6bb9c57e:

    # mc "You’re kidding."
    mc "Estás bromeando."

# game/Story01.rpy:6046

translate spanish gate2_a4d19930:

    # mc "Don’t tell me some deranged alley-cat mistook it for a chew toy and jumped on—"
    mc "No me digas que algún gato callejero desquiciado lo confundió con un juguete para morder y saltó sobre..."

# game/Story01.rpy:6049

translate spanish gate2_7ea99757:

    # Fl "Oh, please. Don’t pretend you’re above this. You’d jump the first elf with a pulse."
    Fl "Ay, por favor. No finjas que estás por encima de esto. Te lanzarías sobre el primer elfo con pulso."

# game/Story01.rpy:6051

translate spanish gate2_8ba2fc09:

    # Fl "Or maybe you’d rather trade places with the toy. Hm? Not judging. Just... noting."
    Fl "O quizá preferirías cambiar de lugar con el juguete. ¿Hm? No juzgo. Solo... tomo nota."

# game/Story01.rpy:6054

translate spanish gate2_09c7a57e:

    # Fl "Okay, okay. No need to get defensive."
    Fl "Vale, vale. No hace falta ponerse a la defensiva."

# game/Story01.rpy:6056

translate spanish gate2_e49c9f42:

    # Fl "Though I’ve been wondering... You barely look at women. Always bring up your wife. Makes me think..."
    Fl "Aunque me he estado preguntando... apenas miras a las mujeres. Siempre sacas a relucir a tu esposa. Eso me hace pensar..."

# game/Story01.rpy:6057

translate spanish gate2_833ed2ae:

    # Fl "...are you hiding something, or are you just {b}very{/b} devoted? Either way — it’s kind of terrifying."
    Fl "...¿estás ocultando algo, o es que eres {b}muy{/b} devoto? Sea como sea, da un poco de miedo."

# game/Story01.rpy:6060

translate spanish gate2_00b1205e:

    # Fl "Anyway. Focus, soldier. I see you dressed up for the apocalypse."
    Fl "En fin. Concéntrate, soldado. Veo que te vestiste para el apocalipsis."

# game/Story01.rpy:6061

translate spanish gate2_e780dd29:

    # Fl "Not bad, actually. Makes you look like someone who wins."
    Fl "No está mal, de hecho. Te hace parecer alguien que gana."

# game/Story01.rpy:6069

translate spanish gate2_ddf78bf5:

    # mc "May the glory of Aldarion be with you."
    mc "Que la gloria de Aldarion esté contigo."

# game/Story01.rpy:6072

translate spanish gate2_0dfdcd09:

    # mc "You too."
    mc "Tú también."

# game/Story01.rpy:6077

translate spanish gate2_300c4cdb:

    # mc "All right, Flora? I need to know—what's the time difference?"
    mc "Bien, Flora. Necesito saber algo: ¿cuál es la diferencia temporal?"

# game/Story01.rpy:6080

translate spanish gate2_d0a56c78:

    # Fl "Are you talking about that conversation with Ember? I ran a little analysis—"
    Fl "¿Hablas de esa conversación con Ember? Hice un pequeño análisis..."

# game/Story01.rpy:6081

translate spanish gate2_709558a1:

    # Fl "—but I doubt you’ll like the results."
    Fl "...pero dudo que te gusten los resultados."

# game/Story01.rpy:6085

translate spanish gate2_3274ebce:

    # mc "If I’ve been here for two months, how much time passed on Earth?"
    mc "Si he estado aquí durante dos meses, ¿cuánto tiempo pasó en la Tierra?"

# game/Story01.rpy:6087

translate spanish gate2_73569b96:

    # Fl "By my calculations, the ratio is three to one. If it’s been two months here it’s been twenty days there."
    Fl "Según mis cálculos, la proporción es de tres a uno. Si aquí pasaron dos meses, allí pasaron veinte días."

# game/Story01.rpy:6089

translate spanish gate2_206623f8:

    # mc "So… three times the speed."
    mc "Así que... tres veces la velocidad."

# game/Story01.rpy:6091

translate spanish gate2_9fa92e86:

    # Fl "Roughly, yeah."
    Fl "Aproximadamente, sí."

# game/Story01.rpy:6094

translate spanish gate2_035e5a58:

    # mc "Then... if two years pass back home, it’s six here?"
    mc "Entonces... si en casa pasan dos años, ¿aquí serían seis?"

# game/Story01.rpy:6096

translate spanish gate2_86025c9f:

    # Fl "In theory. In practice—I can’t say for sure."
    Fl "En teoría. En la práctica, no puedo asegurarlo."

# game/Story01.rpy:6098

translate spanish gate2_2a332eca:

    # mc "If Lora disappeared three years ago... and ended up {b}here{/b}... she’s been living nine?"
    mc "Si Lora desapareció hace tres años... y acabó {b}aquí{/b}... ¿ha vivido nueve?"

# game/Story01.rpy:6103

translate spanish gate2_0803c116:

    # Fl "But that’s a rabbit hole for later. Right now — your team’s prepped."
    Fl "Pero ese pozo lo dejamos para después. Ahora mismo, tu equipo está listo."

# game/Story01.rpy:6107

translate spanish gate2_ba155333:

    # g "Our best shot is Zone 7, northeast gate. It's half-forgotten, barely used. We’ll move quietly."
    g "Nuestra mejor opción es la Zona 7, puerta noreste. Está medio olvidada, casi nadie la usa. Nos moveremos en silencio."

# game/Story01.rpy:6110

translate spanish gate2_4542ad7a:

    # gg "But don’t relax. They may be dumb, but they swarm. If we’re spotted, it’s a bloodbath."
    gg "Pero no se relajen. Puede que sean estúpidos, pero atacan en enjambre. Si nos detectan, será un baño de sangre."

# game/Story01.rpy:6112

translate spanish gate2_9ed5c0a4:

    # g "You ready to move?"
    g "¿Listo para movernos?"

# game/Story01.rpy:6114

translate spanish gate2_0817892e:

    # mc "Always."
    mc "Siempre."

# game/Story01.rpy:6116

translate spanish gate2_3ba19b1c:

    # g "Good. Coordinates are on their way. We’ll link up with the other squad en route."
    g "Bien. Las coordenadas van en camino. Nos reuniremos con el otro escuadrón durante la ruta."

# game/Story01.rpy:6120

translate spanish gate2_f90539be:

    # g "Small group. But the rookies? Solid instincts. One of them survived a singularity breach without backup."
    g "Un grupo pequeño. Pero los novatos tienen instinto. Uno de ellos sobrevivió a una brecha de singularidad sin apoyo."

# game/Story01.rpy:6122

translate spanish gate2_c62d2b9e:

    # mc "And if something happens to you — or me?"
    mc "¿Y si algo te sucede a ti o a mí?"

# game/Story01.rpy:6124

translate spanish gate2_f45c2afe:

    # g "What our motto?"
    g "¿Cuál es nuestro lema?"

# game/Story01.rpy:6126

translate spanish gate2_9ab979ad:

    # ggg "We’re the dead, marching ahead of death. Either we fall — or the world behind us does."
    ggg "Somos los muertos que marchan por delante de la muerte. O caemos nosotros, o cae el mundo a nuestras espaldas."

# game/Story01.rpy:6128

translate spanish gate2_faf324e3:

    # g "No backups. No reruns. No one’s coming to save us."
    g "Sin apoyo. Sin repetir la jugada. Nadie vendrá a salvarnos."

# game/Story01.rpy:6129

translate spanish gate2_12126250:

    # g "Only you… and your abilities."
    g "Solo tú... y tus habilidades."

# game/Story01.rpy:6131

translate spanish gate2_aa78317e:

    # g "Now — move out."
    g "Ahora: en marcha."

# game/Story01.rpy:6141

translate spanish gate3_c3fbabf7:

    # mc "Made it to the location. No resistance... which is starting to feel like a warning in itself. Everything’s too quiet."
    mc "Lo hizo a la ubicación. No hay resistencia... que está empezando a sentir como una advertencia en sí mismo. Todo es demasiado tranquilo."

# game/Story01.rpy:6145

translate spanish gate3_60e3d21c:

    # Fl "Should we worry? Maybe. But that's not today's task, is it?"
    Fl "Quizás, pero no es el reto hoy, ¿verdad?"

# game/Story01.rpy:6146

translate spanish gate3_cfb64f4a:

    # Fl "Eyes forward. Do you see the gates?"
    Fl "Ojos hacia adelante. ¿Ves las puertas?"

# game/Story01.rpy:6148

translate spanish gate3_59ea26be:

    # mc "If you mean that cathedral-sized door looming like it guards something ancient and hungry — then yeah, I see it. Loud and clear."
    mc "Si quieres decir que la puerta de tamaño catedral se atormenta como si protegiera algo antiguo y hambriento, entonces sí, lo veo. En voz alta y clara."

# game/Story01.rpy:6152

translate spanish gate3_8ceb7186:

    # Fl "Excellent. If you do wake a monster, give me a heads-up. I’ll make popcorn."
    Fl "Excelente. Si despiertas a un monstruo, dame una cabeza arriba. Voy a hacer palomitas."

# game/Story01.rpy:6153

translate spanish gate3_75926e56:

    # Fl "Could be the best fight I never got to attend."
    Fl "Podría ser la mejor pelea que nunca tuve que asistir."

# game/Story01.rpy:6156

translate spanish gate3_c654643c:

    # mc "Popcorn? Didn’t know you were into bloodsport. Thought you were more the... candlelit-books-and-tea type."
    mc "¿Popcorn? No sabía que estabas en el puerto de sangre. Pensé que eras más el tipo... de los libros y tés de vela."

# game/Story01.rpy:6160

translate spanish gate3_b177a198:

    # Fl "Wow, what sharp perception. I’d almost be flattered — if it were accurate."
    Fl "Vaya, qué percepción aguda. Casi me sentiría halagada — si fuera exacta."

# game/Story01.rpy:6161

translate spanish gate3_5ec709cf:

    # Fl "I like stories, not slaughter. But stories about slaughter? Those are fascinating. The why, not the how."
    Fl "Me gustan las historias, no la matanza, pero las historias sobre la masacre son fascinantes, por qué no el cómo."

# game/Story01.rpy:6165

translate spanish gate3_38f9bbd3:

    # Fl "You’d be amazed at how much knowledge, how many stories, inspirations, emotions, and experiences I’ve gathered from them."
    Fl "Te sorprendería cuánto conocimiento, cuántas historias, inspiraciones, emociones y experiencias he recogido de ellas."

# game/Story01.rpy:6166

translate spanish gate3_0dbcdd11:

    # mc "Not helping your case, bookworm."
    mc "No ayudas a tu caso, bóker de libros."

# game/Story01.rpy:6167

translate spanish gate3_8322725b:

    # Fl "Says the guy who monologues like he's narrating a noir film."
    Fl "Dice el tipo que está haciendo el monólogo, como la voz en una película de noir."

# game/Story01.rpy:6171

translate spanish gate3_a0241f40:

    # mc "Fair."
    mc "Bien."

# game/Story01.rpy:6172

translate spanish gate3_44dca978:

    # mc "Anyway... see anything? Because it's just me out here. No movement, no sound. Too calm."
    mc "En fin... ¿ves algo? Porque aquí afuera solo estoy yo. Sin movimiento, sin ruido. Demasiado tranquilo."

# game/Story01.rpy:6175

translate spanish gate3_2495dfcf:

    # Fl "First: screw you."
    Fl "Primero: jódete."

# game/Story01.rpy:6176

translate spanish gate3_e41918b7:

    # Fl "Second: no."
    Fl "Segundo: no."

# game/Story01.rpy:6177

translate spanish gate3_a5e29d8e:

    # Fl "No signs of life. Apart from you — lucky me."
    Fl "Sin señales de vida. Aparte de ti, para mi desgracia."

# game/Story01.rpy:6178

translate spanish gate3_badf4cfe:

    # Fl "But maybe this lull’s an opportunity. Let's kill the silence. Swap some history."
    Fl "Pero tal vez este timbre es una oportunidad, vamos a romper el silencio, vamos a compartir una historia."

# game/Story01.rpy:6182

translate spanish gate3_e0679129:

    # Fl "Riddle me this: how the hell did someone like Lora end up married to someone like you?"
    Fl "¿Cómo diablos alguien como Lora terminó casado con alguien como tú?"

# game/Story01.rpy:6186

translate spanish gate3_6428c277:

    # Fl "You do realize we're talking about the same guy who jumped into bed with the first stranger who smiled at him, right?"
    Fl "¿Te das cuenta de que estamos hablando del mismo tipo que saltó a la cama con el primer extraño que le sonrió?"

# game/Story01.rpy:6189

translate spanish gate3_83a6219a:

    # mc "Really? You’re not gonna let that go?"
    mc "¿En serio? ¿No vas a dejar que se vaya?"

# game/Story01.rpy:6190

translate spanish gate3_49fa93cc:

    # mc "I lost control. It happens."
    mc "Perdí el control, pasa."

# game/Story01.rpy:6192

translate spanish gate3_6cf80485:

    # mc "Anyway. Truth is... we met under weird circumstances."
    mc "De todas formas, la verdad es que nos conocimos bajo circunstancias extrañas."

# game/Story01.rpy:6195

translate spanish gate3_0302236f:

    # mc "Like me?"
    mc "¿Como yo?"

# game/Story01.rpy:6196

translate spanish gate3_f2f946ad:

    # mc "Well... Truth is... {w}we met under weird circumstances."
    mc "Bueno... la verdad es... {w}Nos conocimos bajo circunstancias extrañas."

# game/Story01.rpy:6197

translate spanish gate3_63a31854:

    # mc "One night, a girl walks into my restaurant. Bunny costume. Swears no one can see her but me."
    mc "Una noche, una chica entra en mi restaurante, con un disfraz de conejo, y no le ves a nadie más que a mí."

# game/Story01.rpy:6199

translate spanish gate3_83a26653:

    # mc "I laugh it off — until I realize no one does see her. Not until I say her name aloud."
    mc "Me río de ella hasta que me doy cuenta de que nadie la ve, no hasta que yo diga su nombre en voz alta."

# game/Story01.rpy:6200

translate spanish gate3_12cb65a7:

    # mc "Wild story, right?"
    mc "Una historia salvaje, ¿verdad?"

# game/Story01.rpy:6205

translate spanish gate3_46ec3d57:

    # mc "Too wild. None of that happened. We met at university. Went on a date. That’s it."
    mc "Demasiado salvaje. Nada de eso sucedió. Nos conocimos en la universidad. Fuimos a una cita. Eso es todo."

# game/Story01.rpy:6207

translate spanish gate3_41da62cb:

    # Fl "..."
    Fl "..."

# game/Story01.rpy:6209

translate spanish gate3_b7a9d15f:

    # Fl "...You insufferable bastard."
    Fl "...insufrible bastardo."

# game/Story01.rpy:6210

translate spanish gate3_215c61e0:

    # Fl "I almost bought it. Almost."
    Fl "Casi lo compré."

# game/Story01.rpy:6215

translate spanish gate3_97c64574:

    # Fl "You’ve officially exhausted my trust — and my respect. But I still have a duty to warn you."
    Fl "Usted ha agotado oficialmente mi confianza y mi respeto. Pero aún tengo el deber de advertirle."

# game/Story01.rpy:6216

translate spanish gate3_f101a7aa:

    # Fl "Movement. West. Can’t tell how many."
    Fl "Movimiento. Oeste. No se puede decir cuántos."

# game/Story01.rpy:6220

translate spanish gate3_1f00bf5e:

    # Fl "Stay sharp. "
    Fl "Mantente firme. "

# game/Story01.rpy:6225

translate spanish gate3_3669ed3b:

    # mc "Understood. "
    mc "Entendido. "

# game/Story01.rpy:6227

translate spanish gate3_2fded262:

    # h "..."
    h "..."

# game/Story01.rpy:6231

translate spanish gate3_1279cf5e:

    # mc "Olivia...?!"
    mc "¡Olivia!"

# game/Story01.rpy:6234

translate spanish gate3_c1ffdfd9:

    # mc "What the hell are you doing here? I thought Miriel had you training back at HQ."
    mc "Pensé que Miriel te había entrenado en el cuartel general."

# game/Story01.rpy:6236

translate spanish gate3_c643fe56:

    # h "She did. Then I heard some stubborn old fool ran straight into the storm."
    h "Entonces escuché que un viejo tonto obstinado corrió directo a la tormenta."

# game/Story01.rpy:6238

translate spanish gate3_77bcf4e6:

    # h "And I knew who it had to be."
    h "Y yo sabía quién tenía que ser."

# game/Story01.rpy:6239

translate spanish gate3_7da7f9ce:

    # h "You really thought I’d just sit back while you charge into whatever fresh hell this place has to offer?"
    h "¿Realmente pensaste que me sentaría mientras cobrabas por el infierno que este lugar tiene que ofrecer?"

# game/Story01.rpy:6241

translate spanish gate3_4d7af369:

    # h "Please. I made you a promise. I meant it."
    h "Por favor, te hice una promesa, lo dije en serio."

# game/Story01.rpy:6245

translate spanish gate3_1c2b81ed:

    # mc "But why? Why are you here, Olivia? You were supposed to stay safe."
    mc "¿Por qué estás aquí, Olivia?"

# game/Story01.rpy:6247

translate spanish gate3_cc9d94d9:

    # h "Safe?"
    h "¿A salvo?"

# game/Story01.rpy:6248

translate spanish gate3_79ec0bd6:

    # h "Why do you care now? Or do you even care?"
    h "¿Por qué te importa ahora o te importa?"

# game/Story01.rpy:6252

translate spanish gate3_2b35b6fe:

    # mc "..."
    mc "..."

# game/Story01.rpy:6254

translate spanish gate3_f1ce453c:

    # h "...Didn’t think so."
    h "...no lo creía."

# game/Story01.rpy:6255

translate spanish gate3_2b2332a0:

    # h "It hurts, you know. Thinking I mattered more to you than this silence says I do."
    h "Me duele, sabes, pensar que te importaba más que este silencio dice que sí."

# game/Story01.rpy:6259

translate spanish gate3_fc652ee6:

    # mc "No? Was I supposed to? I don’t recall doing anything wrong."
    mc "¿Se supone que debo hacerlo? No recuerdo haber hecho nada malo."

# game/Story01.rpy:6260

translate spanish gate3_2fded262_1:

    # h "..."
    h "..."

# game/Story01.rpy:6262

translate spanish gate3_b9df7ac2:

    # mc "Why should I apologize for something I don’t understand?"
    mc "¿Por qué debería disculparme por algo que no entiendo?"

# game/Story01.rpy:6264

translate spanish gate3_2190c780:

    # h "...Wow."
    h "...Wow."

# game/Story01.rpy:6265

translate spanish gate3_c46a1774:

    # h "(softly) I used to believe you were better than this."
    h "Solía creer que eras mejor que esto."

# game/Story01.rpy:6266

translate spanish gate3_572e7507:

    # h "Guess I was wrong."
    h "Supongo que me equivoqué."

# game/Story01.rpy:6271

translate spanish gate3_6967aa87:

    # mc "I’m sorry. I didn’t mean to shut you out. I thought it was the right call... keeping you away. Keeping you safe."
    mc "Lo siento. No quise callarte. Pensé que era la decisión correcta... manteniéndote alejado."

# game/Story01.rpy:6272

translate spanish gate3_2fded262_2:

    # h "..."
    h "..."

# game/Story01.rpy:6274

translate spanish gate3_06a3eddd:

    # h "...Safe? Or convenient?"
    h "¿Safe?"

# game/Story01.rpy:6276

translate spanish gate3_8713c882:

    # h "Maybe you’re lying to ease your guilt. Maybe not. But I’ll take the lie."
    h "Tal vez estás mintiendo para aliviar tu culpa. Tal vez no. Pero yo tomaré la mentira."

# game/Story01.rpy:6277

translate spanish gate3_9ef58de8:

    # h "At least it sounds like you still care."
    h "Al menos parece que todavía te importa."

# game/Story01.rpy:6281

translate spanish gate3_ac6c0439:

    # mc "How’d you even find me? Comms were cut."
    mc "¿Cómo me encontraste? Los bailes fueron cortados."

# game/Story01.rpy:6283

translate spanish gate3_9c3271b0:

    # h "Oh, that? You can thank the infuriating feline who planted a tracker on your ass."
    h "Puedes agradecer al felino que te ha plantado un rastreador en el culo."

# game/Story01.rpy:6284

translate spanish gate3_250339f3:

    # h "Without it, we’d still be blind."
    h "Sin ella, todavía estaríamos ciegos."

# game/Story01.rpy:6286

translate spanish gate3_2cacce10:

    # h "And speaking of which — where is she?"
    h "Y hablando de eso — ¿dónde está?"

# game/Story01.rpy:6287

translate spanish gate3_8603b863:

    # h "Don’t tell me she ran the second things got messy."
    h "No me digas que ella corrió las segundas cosas se puso desordenada."

# game/Story01.rpy:6290

translate spanish gate3_1ada0a67:

    # Fl "TELL THAT SELF-RIGHTEOUS GREMLIN I CAN HEAR HER, and she better WATCH HER DAMN MOUTH — without me, she’d be curled up crying in a bunker somewhere!"
    Fl "Dile que la glorieta de la luz que puedo oírla, y mejor ella le vigila el sur de la mañana, sin mí, ella estaría encorvada llorando en un búnker en algún lugar!"

# game/Story01.rpy:6292

translate spanish gate3_c3ea6a0d:

    # mc "(How exactly am I supposed to repeat that without getting myself killed?)"
    mc "(¿Cómo se supone que debo repetir eso sin que me maten?)"

# game/Story01.rpy:6294

translate spanish gate3_bff28cee:

    # h "...Something wrong? You went quiet."
    h "- ¿Algo va mal?"

# game/Story01.rpy:6296

translate spanish gate3_6ef21454:

    # mc "Flora’s here. She's... the voice in my ear. And she heard everything."
    mc "Flora está aquí, es una voz en mi oído y lo oyó todo."

# game/Story01.rpy:6299

translate spanish gate3_cf250af0:

    # Fl "And I demand an apology."
    Fl "Y exijo una disculpa."

# game/Story01.rpy:6302

translate spanish gate3_bda2ad6c:

    # h "Aww, poor thing. Want a medal? Or a standing ovation for doing your job?"
    h "Pobrecita. ¿Quieres una medalla o una ovación por hacer tu trabajo?"

# game/Story01.rpy:6305

translate spanish gate3_92c4f3cf:

    # Fl "WHAT DID SHE JUST— I SWEAR TO EVERY STAR—"
    Fl "¿Qué hizo ella justo-- Averiguaba a cada estrella--"

# game/Story01.rpy:6307

translate spanish gate3_6a3f3bef:

    # H "Connection temporarily lost. "
    H "Conexion temporalmente perdida. "

# game/Story01.rpy:6309

translate spanish gate3_5402e203:

    # h "She still yelling?"
    h "¿Sigue gritando?"

# game/Story01.rpy:6311

translate spanish gate3_d259b4fa:

    # mc "Furious. Might be breathing fire soon."
    mc "- Puede que pronto esté respirando fuego."

# game/Story01.rpy:6313

translate spanish gate3_2b35b6fe_1:

    # mc "..."
    mc "..."

# game/Story01.rpy:6316

translate spanish gate3_b102af48:

    # h "Anyway... what’ve you and Baldie been doing out here?"
    h "De todos modos... ¿qué han estado haciendo tú y Baldie aquí?"

# game/Story01.rpy:6317

translate spanish gate3_cb6fd069:

    # h "Tell me you found something useful."
    h "Dime que encontraste algo útil."

# game/Story01.rpy:6319

translate spanish gate3_74d570bb:

    # mc "We did. And it’s... worse than we thought."
    mc "Lo hicimos, y es... peor de lo que pensamos."

# game/Story01.rpy:6320

translate spanish gate3_529de837:

    # mc "We’re stranded in the far edge of the universe."
    mc "Estamos varados en el borde lejano del universo."

# game/Story01.rpy:6321

translate spanish gate3_1a8c3be2:

    # mc "There’s an artifact here that can shape worlds. And Lora’s tied to it somehow."
    mc "Hay un artefacto aquí que puede formar mundos. Y Lora está ligada a él de alguna manera."

# game/Story01.rpy:6325

translate spanish gate3_fa06c702:

    # mc "(And what about Shiya? Did she survive? Is Norman really gone? What happens to Alex, to Mina... if we never return?)"
    mc "¿Y qué hay de Shiya? ¿Sobrevivió? ¿No está Norman realmente fuera? ¿Qué le pasa a Alex, a Mina... si nunca volvemos?"

# game/Story01.rpy:6326

translate spanish gate3_746fccd2:

    # mc "(Did Lora find the answers we needed... or make things worse?)"
    mc "(¿Encontró Lora las respuestas que necesitábamos... o empeoró las cosas?)"

# game/Story01.rpy:6329

translate spanish gate3_41ea9f44:

    # mc "(If Norman’s dead... why did I dream about him? And if he’s alive, how the hell did he escape?)"
    mc "(Si Norman está muerto... ¿por qué soñé con él? Y si está vivo, ¿cómo diablos escapó?)"

# game/Story01.rpy:6330

translate spanish gate3_801d6bc8:

    # mc "(What about Shiya, the General? What if we’re the last ones left?)"
    mc "¿Y si somos los últimos?"

# game/Story01.rpy:6331

translate spanish gate3_746fccd2_1:

    # mc "(Did Lora find the answers we needed... or make things worse?)"
    mc "(¿Encontró Lora las respuestas que necesitábamos... o empeoró las cosas?)"

# game/Story01.rpy:6334

translate spanish gate3_2b35b6fe_2:

    # mc "..."
    mc "..."

# game/Story01.rpy:6336

translate spanish gate3_cc404906:

    # mc "(...Enough. Thinking won’t solve this. Not now.)"
    mc "(...Basta. Pensar no resolverá esto. No ahora.)"

# game/Story01.rpy:6342

translate spanish gate3_c3a54420:

    # h "Whatever's racing through your mind — don’t let it drown you."
    h "Lo que pase por tu cabeza, no dejes que te arruine."

# game/Story01.rpy:6343

translate spanish gate3_8401a332:

    # h "You don’t get to give up. Not now. Not after everything."
    h "No puedes renunciar. No ahora. No después de todo."

# game/Story01.rpy:6344

translate spanish gate3_459dc959:

    # h "Let their sacrifices mean something."
    h "Que sus sacrificios signifiquen algo."

# game/Story01.rpy:6347

translate spanish gate3_9c566a05:

    # o "I’ve already been briefed. No reinforcements. Eastern front’s devouring everything — even Astoria."
    o "Ya me han informado. No hay refuerzos. El frente oriental lo devora todo — incluso Astoria."

# game/Story01.rpy:6350

translate spanish gate3_aa918844:

    # o "So this is it. Just us. And too many lives hanging in the balance to afford failure."
    o "Así que esto es todo: solo nosotros, y demasiadas vidas en juego como para permitirnos fallar."

# game/Story01.rpy:6352

translate spanish gate3_b373b762:

    # Mi "Technically, the 7th Squadron’s en route... but let’s not hold our breath."
    Mi "Técnicamente, el 7.º Escuadrón está en camino... pero no contemos con ello."

# game/Story01.rpy:6355

translate spanish gate3_a6360540:

    # Mi "What I do know for certain is who won’t be showing up."
    Mi "Lo que sí sé con certeza es quién no aparecerá."

# game/Story01.rpy:6356

translate spanish gate3_53d6ed7c:

    # Mi "Liv. What part of 'stay together' slipped past you?"
    Mi "Liv, ¿qué parte de \"mantenernos juntos\" se te escapó?"

# game/Story01.rpy:6357

translate spanish gate3_83112952:

    # Mi "That signal could’ve killed us."
    Mi "Esa señal podría habernos matado."

# game/Story01.rpy:6359

translate spanish gate3_c2441bb2:

    # h "Oh come on. I was a scout, remember? If it had been hostile, I’d be the one warning you, not the other way around."
    h "Oh, vamos. Yo era explorador, ¿recuerdas? Si hubiera sido hostil, te habría avisado yo, no al revés."

# game/Story01.rpy:6361

translate spanish gate3_21edb6c2:

    # h "And besides, you’re hardly one to talk — ‘Cold Reaper’? Really? Doesn’t exactly scream ‘follow protocol.’"
    h "Y además, tú no eres quién para hablar. ¿\"Parca Fría\"? ¿En serio? Ese apodo no grita precisamente \"sigo el protocolo\"."

# game/Story01.rpy:6363

translate spanish gate3_519deeab:

    # mc "Wait. ‘Cold Reaper’? I tho you are joking."
    mc "Espera. ¿\"Parca Fría\"? Creí que bromeabas."

# game/Story01.rpy:6364

translate spanish gate3_30552d64:

    # mc "You meet a nickname like that and expect..."
    mc "Conoces un apodo como ese y esperas..."

# game/Story01.rpy:6365

translate spanish gate3_55f83fe8:

    # mc "A seven-foot war machine, not an elf who looks like she brews herbal tea and rescues kittens."
    mc "Una máquina de guerra de siete pies, no un elfo que parece que elabora té de hierbas y salva gatitos."

# game/Story01.rpy:6367

translate spanish gate3_6df0bd6a:

    # h "Exactly! I thought the same — gentle voice, soft smile, heart of gold..."
    h "¡Exactamente! Pensé lo mismo: voz suave, sonrisa suave, corazón de oro..."

# game/Story01.rpy:6369

translate spanish gate3_87396fc6:

    # h "Then she took out an entire platoon. Alone. In under a minute."
    h "Luego sacó un pelotón entero, solo en un minuto."

# game/Story01.rpy:6370

translate spanish gate3_df293d47:

    # h "They called her a living weapon. And honestly? They weren’t wrong."
    h "La llamaban arma viva. ¿Y honestamente? No estaban equivocados."

# game/Story01.rpy:6372

translate spanish gate3_fc3df40d:

    # h "But to me, she’s still Miriel. The one who never gets my jokes but at least pretends to try."
    h "Pero para mí, ella todavía es Miriel. El que nunca consigue mis chistes pero al menos finge intentarlo."

# game/Story01.rpy:6374

translate spanish gate3_c4b0258c:

    # Mi "I didn’t ask for this."
    Mi "No pedí esto."

# game/Story01.rpy:6375

translate spanish gate3_fe5f85e2:

    # Mi "They didn’t ask either. Just... cut me open. Wired me up. Told me to kill."
    Mi "No me preguntaron. Solo... me abrieron. Me cablearon. Me ordenaron matar."

# game/Story01.rpy:6377

translate spanish gate3_6597387f:

    # Mi "I don’t sleep. I don’t dream. I only remember the silence... after."
    Mi "No duermo. No sueño. Solo recuerdo el silencio... después."

# game/Story01.rpy:6380

translate spanish gate3_da3fdbf1:

    # Mi "..."
    Mi "..."

# game/Story01.rpy:6382

translate spanish gate3_a1ecb362:

    # Mi "And what exactly do you think you’re doing?"
    Mi "¿Y qué crees que estás haciendo exactamente?"

# game/Story01.rpy:6384

translate spanish gate3_5066394d:

    # h "Oh, I noticed a little... tension in the atmosphere. Thought I’d investigate."
    h "Oh, noté un poco de... tensión en el ambiente. Pensé que debía investigar."

# game/Story01.rpy:6386

translate spanish gate3_8222e031:

    # h "Turns out the Cold Reaper blushes."
    h "Resulta que la Parca Fría se sonroja."

# game/Story01.rpy:6389

translate spanish gate3_9cb06d26:

    # Mi "Touch me again, and I swear I’ll redecorate this cave with your intestines."
    Mi "Vuelve a tocarme y juro que redecoraré esta cueva con tus intestinos."

# game/Story01.rpy:6390

translate spanish gate3_2fded262_3:

    # h "..."
    h "..."

# game/Story01.rpy:6392

translate spanish gate3_da3fdbf1_1:

    # Mi "..."
    Mi "..."

# game/Story01.rpy:6395

translate spanish gate3_1d721ea6:

    # h "Love you too!"
    h "¡Yo también te quiero!"

# game/Story01.rpy:6396

translate spanish gate3_15865abc:

    # Mi "Come back here, you little—!"
    Mi "¡Vuelve aquí, pedazo de...!"

# game/Story01.rpy:6399

translate spanish gate3_741bd8d0:

    # o "Don’t wander too far, you two..."
    o "No se alejen demasiado, ustedes dos..."

# game/Story01.rpy:6401

translate spanish gate3_f00b6afa:

    # o "You might think this sounds silly — or even hypocritical — but I’m glad you’re here."
    o "Puede que esto suene tonto, incluso hipócrita, pero me alegra que estén aquí."

# game/Story01.rpy:6403

translate spanish gate3_bc9374d3:

    # o "In such a short time, you’ve already accomplished more than most... including me."
    o "En tan poco tiempo, ya han logrado más que la mayoría... incluso yo."

# game/Story01.rpy:6405

translate spanish gate3_b2b9e19d:

    # mc "What do you mean?"
    mc "¿Qué quieres decir?"

# game/Story01.rpy:6407

translate spanish gate3_bc942277:

    # o "All my life, I never saw Miriel even smirk — so imagine my face when she made a joke."
    o "Toda mi vida, nunca vi a Miriel incluso esmirr — así que imagina mi cara cuando hizo una broma."

# game/Story01.rpy:6409

translate spanish gate3_1aa9bf6a:

    # o "Flora, too. I thought she’d never leave that bunker. And here she is. Out in the open."
    o "Flora, también. Pensé que nunca dejaría ese búnker. Y aquí está."

# game/Story01.rpy:6411

translate spanish gate3_c75f57ec:

    # o "You changed something. That’s more than most ever manage."
    o "Cambiaste algo. Eso es más que nunca manejado."

# game/Story01.rpy:6415

translate spanish gate3_31f0a449:

    # Fl "—[mc], DO YOU HEAR ME? Interference’s spiked — like they’ve locked onto our signal. Be careful! I think there’s a—"
    Fl "—[mc], ¿Me oyes? La interferencia está esparcida, como si hubieran bloqueado nuestra señal. ¡Ten cuidado! Creo que hay un..."

# game/Story01.rpy:6417

translate spanish gate3_103797d5:

    # mc "Flora? {w}FLORA?!"
    mc "¿Flora? {w}¡Flairea!"

# game/Story01.rpy:6421

translate spanish gate3_2b35b6fe_3:

    # mc "..."
    mc "..."

# game/Story01.rpy:6423

translate spanish gate3_d3b933ed:

    # o "Something wrong? "
    o "¿Pasa algo? "

# game/Story01.rpy:6425

translate spanish gate3_915a1b5a:

    # mc "Nothing. Just a hunch. Not worth wasting time on."
    mc "Nada, solo una corazonada, no vale la pena perder tiempo."

# game/Story01.rpy:6427

translate spanish gate3_65f4108e:

    # mc "(No. Not yet. I need to be sure.)"
    mc "(No. Aún no. Necesito estar seguro.)"

# game/Story01.rpy:6430

translate spanish gate3_aab804c1:

    # g "Sir. We’ve got a problem."
    g "Señor, tenemos un problema."

# game/Story01.rpy:6431

translate spanish gate3_6a67c302:

    # o "What happened?"
    o "¿Qué pasó?"

# game/Story01.rpy:6433

translate spanish gate3_caf3e0c4:

    # g "This."
    g "Esto."

# game/Story01.rpy:6435

translate spanish gate3_2405d7de:

    # o "Why haven’t we opened it yet?"
    o "¿Por qué no lo hemos abierto todavía?"

# game/Story01.rpy:6437

translate spanish gate3_64ac458c:

    # g "We... can’t. There’s a security system here I’ve never seen before."
    g "No podemos. Hay un sistema de seguridad aquí que nunca he visto antes."

# game/Story01.rpy:6438

translate spanish gate3_33784b63:

    # g "Even Astoria hasn’t received tech this advanced."
    g "Incluso Astoria no ha recibido tecnología tan avanzada."

# game/Story01.rpy:6440

translate spanish gate3_a0343caf:

    # gg "We’ve got explosives. Let’s just turn the whole damn gate into dust."
    gg "Tenemos explosivos. Vamos a convertir toda la maldita puerta en polvo."

# game/Story01.rpy:6442

translate spanish gate3_12f496bb:

    # g "Blow it open? Waste every round we’ve got on a door? Brilliant."
    g "¿Desperdiciar cada ronda que tenemos en una puerta? Brillante."

# game/Story01.rpy:6443

translate spanish gate3_8b20003a:

    # g "And what do we fight with after — sharp looks and angry words?"
    g "¿Y con qué luchamos después, con miradas agudas y palabras enojadas?"

# game/Story01.rpy:6445

translate spanish gate3_02a83b11:

    # g "That thing’s made of quantum titanium. It could shrug off a tank."
    g "Esa cosa está hecha de titanio cuántico. Podría arrancar un tanque."

# game/Story01.rpy:6447

translate spanish gate3_00e68635:

    # mc "Then we don’t go through it. We go under."
    mc "Entonces no lo pasamos."

# game/Story01.rpy:6448

translate spanish gate3_80fef107:

    # mc "Metro tunnels. There are access routes beneath this district."
    mc "Hay rutas de acceso por debajo de este distrito."

# game/Story01.rpy:6450

translate spanish gate3_10fdf7b0:

    # o "We considered that. Problem is — the maps are a mess, and even if we had one, we’d still face..."
    o "Consideramos eso. El problema es que los mapas son un desastre, e incluso si lo tuvieramos, todavía nos enfrentamos a..."

# game/Story01.rpy:6451

translate spanish gate3_81d9fcb3:

    # o "...the locals."
    o "... los locales."

# game/Story01.rpy:6454

translate spanish gate3_2b35b6fe_4:

    # mc "..."
    mc "..."

# game/Story01.rpy:6455

translate spanish gate3_d4cc040f:

    # mc "(What the...)"
    mc "(¿Qué...?)"

# game/Story01.rpy:6457

translate spanish gate3_89a9693a:

    # mc "(OLIVIA!) "
    mc "(OLIVIA!) "

# game/Story01.rpy:6458

translate spanish gate3_44265eb6:

    # o "Where do you think you’re going?!"
    o "¿A dónde crees que vas?!"

# game/Story01.rpy:6460

translate spanish gate3_c8ce8134:

    # o "No more waiting. We figure it out as we go."
    o "No más espera, lo averiguaremos mientras vamos."

# game/Story01.rpy:6462

translate spanish gate3_a7fa140e:

    # mc "(Please be safe.)"
    mc "(Por favor, asegúrese.)"

# game/Story01.rpy:6467

translate spanish gate3_18109266:

    # h "Whatever that was... it shook the whole district. The sky lit up like a dying star."
    h "Lo que sea que fue... estremeció a todo el distrito, el cielo se encendió como una estrella moribunda."

# game/Story01.rpy:6469

translate spanish gate3_f1a2ec5f:

    # h "Honestly? Looked worse than my drunk dad’s face... not that I ever saw him."
    h "¿Honestamente? Se veía peor que la cara de mi padre borracho... no que lo haya visto nunca."

# game/Story01.rpy:6473

translate spanish gate3_ecd2bea1:

    # mc "You’re alive."
    mc "Estás vivo."

# game/Story01.rpy:6477

translate spanish gate3_9a62466c:

    # h "What? I’m fine. Nothing happened. You’re blowing this out of proportion."
    h "¿Qué? Estoy bien. No pasó nada. Estás soplando esto fuera de proporción."

# game/Story01.rpy:6479

translate spanish gate3_d097e9f7:

    # mc "I’ve already lost too much. If anything happens to you… I won’t survive it."
    mc "Ya he perdido demasiado. Si algo te sucede... no sobreviviré."

# game/Story01.rpy:6483

translate spanish gate3_a6e98175:

    # h "Or what? You gonna chain me to your side now?"
    h "¿Me vas a encadenar a tu lado ahora?"

# game/Story01.rpy:6485

translate spanish gate3_648b5fae:

    # mc "Olivia, I’m serious. You can be reckless with your own life, fine — but not with ours. Not with mine."
    mc "Olivia, lo digo en serio. Puedes ser imprudente con tu propia vida, bien, pero no con la nuestra. No con la mía."

# game/Story01.rpy:6488

translate spanish gate3_37105feb:

    # h "Alright, alright. No more disappearing. I just—"
    h "No más desapareciendo."

# game/Story01.rpy:6490

translate spanish gate3_ceb2719d:

    # h "just..."
    h "Solo..."

# game/Story01.rpy:6492

translate spanish gate3_2fded262_4:

    # h "..."
    h "..."

# game/Story01.rpy:6494

translate spanish gate3_77b250a9:

    # h "I saw Miriel, and... she looked hollow. Like she’d already lost."
    h "Vi a Miriel, y... parecía hueca, como si ya hubiera perdido."

# game/Story01.rpy:6496

translate spanish gate3_5e3b3176:

    # h "I thought if I could get her to laugh, even for a second—"
    h "Pensé que si podía hacer que se reira, incluso por un segundo..."

# game/Story01.rpy:6497

translate spanish gate3_7b30c812:

    # h "But I messed it up. {w}And now everyone’s looking at me like I’m the damn problem."
    h "Pero lo he estropeado. {w}Y ahora todos me están mirando como si fuera el maldito problema."

# game/Story01.rpy:6499

translate spanish gate3_2b35b6fe_5:

    # mc "..."
    mc "..."

# game/Story01.rpy:6502

translate spanish gate3_e888ba1a:

    # Mi "Glad to know my safety was just an afterthought."
    Mi "Me alegra saber que mi seguridad era solo un idea secundaria."

# game/Story01.rpy:6503

translate spanish gate3_2b35b6fe_6:

    # mc "..."
    mc "..."

# game/Story01.rpy:6505

translate spanish gate3_28264810:

    # mc "...Fine. How are you?"
    mc "Bien. ¿Cómo estás?"

# game/Story01.rpy:6507

translate spanish gate3_3b016760:

    # Mi "Oh, you care now? Cute. But don’t strain yourself pretending."
    Mi "¿Te importa ahora? Lindo. Pero no te esforces fingiendo."

# game/Story01.rpy:6510

translate spanish gate3_2b35b6fe_7:

    # mc "..."
    mc "..."

# game/Story01.rpy:6511

translate spanish gate3_a3172528:

    # mc "We need to move. This is getting worse by the second."
    mc "Tenemos que movernos, esto se está poniendo peor para el segundo."

# game/Story01.rpy:6513

translate spanish gate3_58c5700d:

    # o "Tunnel access secured. Everyone, with me. Stay sharp."
    o "Todos, conmigo, manténganse afilados."

# game/Story01.rpy:6522

translate spanish gate3_7378154d:

    # o "We’re not just racing time. We’re racing death."
    o "No solo estamos a tiempo de correr. Estamos corriendo la muerte."

# game/Story01.rpy:6525

translate spanish gate3_c067a525:

    # g "Visibility’s zero. We’re flying blind down here. One wrong turn and we vanish."
    g "Visibilidad cero. Estamos volando ciegos aquí abajo. Un giro equivocado y nos desaparecimos."

# game/Story01.rpy:6527

translate spanish gate3_2f83375b:

    # o "Then stay close and don’t fall behind. One step at a time."
    o "Entonces manténte cerca y no te quedes atrás. Un paso a la vez."

# game/Story01.rpy:6529

translate spanish gate3_0a951948:

    # mc "Where do we go from here?"
    mc "¿A dónde vamos desde aquí?"

# game/Story01.rpy:6531

translate spanish gate3_9c3c43bf:

    # o "The nav-device still works locally."
    o "El dispositivo de nav todavía funciona localmente."

# game/Story01.rpy:6533

translate spanish gate3_99bb152f:

    # o "Without that, as already stated, we’re walking corpses."
    o "Sin eso, como ya se ha dicho, estamos caminando cadáveres."

# game/Story01.rpy:6540

translate spanish gate3_cbb8280b:

    # o "Target’s a couple kilometers east."
    o "Target está a un par de kilómetros al este."

# game/Story01.rpy:6543

translate spanish gate3_6925682d:

    # o "Shortest path is through this tunnel."
    o "El camino más corto es a través de este túnel."

# game/Story01.rpy:6546

translate spanish gate3_b8d335f9:

    # g "That one? It's a coffin waiting to collapse. A single shot and we’re rubble."
    g "Este es un ataúd que está a punto de colapsar, un tiro y nos convertiremos en escombros."

# game/Story01.rpy:6547

translate spanish gate3_ea5a3c22:

    # o "Options?"
    o "¿Opciones?"

# game/Story01.rpy:6549

translate spanish gate3_081183f2:

    # g "We take the service route. Slower, but reinforced."
    g "Tomamos la ruta de servicio, más despacio, pero reforzado."

# game/Story01.rpy:6553

translate spanish gate3_475e0d4c:

    # g "Though... there’s something in there. Something we don’t talk about."
    g "Aunque... hay algo ahí dentro. Algo de lo que no hablamos."

# game/Story01.rpy:6554

translate spanish gate3_12250000:

    # o "How bad?"
    o "¿Qué tan malo?"

# game/Story01.rpy:6555

translate spanish gate3_9f9281aa:

    # g "Deadly bad."
    g "Qué pena."

# game/Story01.rpy:6558

translate spanish gate3_cd33cf63:

    # o "Check your ammo. I want numbers."
    o "Mira tu munición, quiero números."

# game/Story01.rpy:6560

translate spanish gate3_330bf7f4:

    # gg "Five shells for the launcher. Seven mags each for rifles."
    gg "Cinco conchas para el lanzador, siete magos cada uno para rifles."

# game/Story01.rpy:6562

translate spanish gate3_81bd3f7a:

    # o "Good. And you?"
    o "Bien. ¿Y tú?"

# game/Story01.rpy:6564

translate spanish gate3_38fb36e6:

    # mc "Locked, loaded, and not in the mood to die."
    mc "Encerrado, cargado, y no en el estado de ánimo de morir."

# game/Story01.rpy:6567

translate spanish gate3_2fded262_5:

    # h "..."
    h "..."

# game/Story01.rpy:6569

translate spanish gate3_90172481:

    # h "Same. Let’s get this over with."
    h "Lo mismo. Terminemos con esto."

# game/Story01.rpy:6571

translate spanish gate3_93ea3243:

    # o "We take the service tunnel. Brace yourselves."
    o "Tomamos el túnel de servicio."

# game/Story01.rpy:6577

translate spanish gate3_2917e4a1:

    # o "Right turn ahead. No contacts — wait... entrance in sight."
    o "No hay contactos, espera, entrada a la vista."

# game/Story01.rpy:6579

translate spanish gate3_e194124b:

    # o "Clear, for now."
    o "Despejado, por ahora."

# game/Story01.rpy:6582

translate spanish gate3_e132ebc4:

    # Mi "So this is it."
    Mi "Así que esto es todo."

# game/Story01.rpy:6585

translate spanish gate3_1439ecf6:

    # o "Best shot we’ve got. It’s stable. Safer. But what’s inside... that’s another story."
    o "El mejor disparo que tenemos. Es estable. Más seguro. Pero lo que hay dentro... es otra historia."

# game/Story01.rpy:6588

translate spanish gate3_634d4cba:

    # mc "Who’s in there?"
    mc "¿Quién está ahí?"

# game/Story01.rpy:6594

translate spanish gate3_c02654f5:

    # Mi "They didn’t brief you?"
    Mi "¿No te han informado?"

# game/Story01.rpy:6596

translate spanish gate3_365d91cd:

    # mc "Apparently not."
    mc "Aparentemente no."

# game/Story01.rpy:6598

translate spanish gate3_2fc435ad:

    # Mi "I think it’s worth explaining."
    Mi "Creo que vale la pena explicarlo."

# game/Story01.rpy:6600

translate spanish gate3_ba134435:

    # o "Agreed..."
    o "De acuerdo..."

# game/Story01.rpy:6601

translate spanish gate3_3e1d8182:

    # o "Let’s just say we’ve got neighbors — underground neighbors."
    o "Digamos que tenemos vecinos — vecinos subterráneos."

# game/Story01.rpy:6602

translate spanish gate3_4ac8d953:

    # o "They’re not exactly the friendly sort. Aggressive, irritable, and very territorial."
    o "No son exactamente el tipo amistoso. Agresivo, irritable, y muy territorial."

# game/Story01.rpy:6603

translate spanish gate3_2f2d1e99:

    # o "They don’t take kindly to trespassers."
    o "No se llevan amablemente a los transeúntes."

# game/Story01.rpy:6605

translate spanish gate3_4fba006b:

    # gg "Or we stop wasting time and just blow the damn thing open."
    gg "O dejamos de perder el tiempo y volamos la maldita cosa abierta."

# game/Story01.rpy:6606

translate spanish gate3_e150faa4:

    # g "You and your explosives... There. It’s open."
    g "Tú y tus explosivos... ahí."

# game/Story01.rpy:6608

translate spanish gate3_b61b900f:

    # g "Let’s move. Stay close. Eyes forward."
    g "Vamos. Mantente cerca. Ojos hacia adelante."

# game/Story01.rpy:6617

translate spanish gate3_2fbe79db:

    # h "It’s so dark down here… like we’ve stepped into the lungs of the world — damp, suffocating."
    h "Está tan oscuro aquí abajo... como hemos entrado en los pulmones del mundo — húmedo, asfixiante."

# game/Story01.rpy:6618

translate spanish gate3_01bec60a:

    # Mi "You’ll get used to it. Or you won’t."
    Mi "Te acostumbrarás a ello. O no lo harás."

# game/Story01.rpy:6619

translate spanish gate3_d993f687:

    # Mi "Either way, complaining won’t change it."
    Mi "De cualquier manera, quejarse no lo cambiará."

# game/Story01.rpy:6621

translate spanish gate3_6edc0a1a:

    # mc "She’s right. Vision’s shot. Sound’s bouncing like it’s mocking us."
    mc "Tiene razón. El disparo de Visión. El sonido rebota como si nos estuviera burlando."

# game/Story01.rpy:6623

translate spanish gate3_9b5bcd8c:

    # o "Eyes forward. Sound off. Headcount."
    o "Ojos hacia adelante, sonar fuera."

# game/Story01.rpy:6628

translate spanish gate3_ce9bb854:

    # o "No stragglers. We move as one. Stay alert. Crawlers nest in the walls. They don’t like visitors."
    o "No hay rezagados. Nos movemos como uno. Mantenga la alerta. Los agricultores anidan en las paredes. No les gustan los visitantes."

# game/Story01.rpy:6631

translate spanish gate3_7f3cfbd6:

    # h "Crawlers? What is this, a haunted mine? Are they dirt-eating mole-people or actual monsters?"
    h "¿Qué es esto, una mina embrujada? ¿Están comendo gente de lunares o monstruos reales?"

# game/Story01.rpy:6634

translate spanish gate3_05ede682:

    # Mi "Arachnoid-class organisms. Fast. Territorial. And very, very real."
    Mi "Organismos de clase arquinoide."

# game/Story01.rpy:6637

translate spanish gate3_269ba42e:

    # mc "Spiders? That’s what we’re worried about?"
    mc "¿Arañas? ¿Eso es lo que nos preocupa?"

# game/Story01.rpy:6640

translate spanish gate3_61405e35:

    # Mi "The young ones? One to five meters. Adults range from five to ten. The elders… they’ve outgrown fear."
    Mi "Los jóvenes? Uno a cinco metros. Los adultos van de cinco a diez. Los ancianos... han superado el miedo."

# game/Story01.rpy:6643

translate spanish gate3_641908b0:

    # h "The size of a dropship?! Come on. That’s myth-level exaggeration."
    h "¿El tamaño de una gota?! Vamos. Eso es exageración de nivel mito."

# game/Story01.rpy:6645

translate spanish gate3_bb523d22:

    # Mi "You’ll believe it when your lungs stop working and you realize the shadow above you isn’t the ceiling."
    Mi "Lo creerás cuando tus pulmones dejen de funcionar y te das cuenta de que la sombra que hay encima no es el techo."

# game/Story01.rpy:6647

translate spanish gate3_a435bb54:

    # o "Cut the chatter. This place wasn’t always like this. Nine years ago, we tried to reclaim these tunnels."
    o "Cortar el chatter. Este lugar no siempre fue así. Hace nueve años, intentamos recuperar estos túneles."

# game/Story01.rpy:6649

translate spanish gate3_7e1693fe:

    # o "Council said they were ‘just bugs.’ Sent us down with light rifles and empty promises."
    o "El Consejo dijo que eran \"solo errores\". Nos envió con rifles ligeros y promesas vacías."

# game/Story01.rpy:6651

translate spanish gate3_0e9f63c8:

    # o "By the time we realized what we were up against, the tunnels had become a tomb."
    o "Para cuando nos dimos cuenta de lo que estábamos en contra, los túneles se habían convertido en una tumba."

# game/Story01.rpy:6652

translate spanish gate3_2fe4bfcf:

    # o "Since then, they closed access. Stopped funding. Pretended this place didn’t exist."
    o "Desde entonces, cerraron el acceso. Detenido financiamiento. Pretendido este lugar no existía."

# game/Story01.rpy:6654

translate spanish gate3_7f6957cc:

    # Mi "They can’t secure their own city, but they’re experts in genocide."
    Mi "No pueden asegurar su propia ciudad, pero son expertos en genocidio."

# game/Story01.rpy:6656

translate spanish gate3_71c95e9e:

    # o "Enough. This isn’t politics."
    o "Basta. Esto no es política."

# game/Story01.rpy:6659

translate spanish gate3_3adfc068:

    # o "It’s survival."
    o "Es supervivencia."

# game/Story01.rpy:6661

translate spanish gate3_c888b7af:

    # Mi "Is that why there's such a shortage of personnel now?"
    Mi "¿Por eso hay tanta escasez de personal?"

# game/Story01.rpy:6663

translate spanish gate3_cd9e0591:

    # h "Why do our worlds only seem to share similarities in all the worst ways?"
    h "¿Por qué nuestros mundos solo parecen compartir similitudes de todas las formas peores?"

# game/Story01.rpy:6664

translate spanish gate3_2b35b6fe_8:

    # mc "..."
    mc "..."

# game/Story01.rpy:6667

translate spanish gate3_22900410:

    # mc "...We’re not alone."
    mc "...No estamos solos."

# game/Story01.rpy:6669

translate spanish gate3_4d496a1c:

    # mc "Are those the creatures you were talking about earlier?"
    mc "¿Son esas criaturas de las que hablabas antes?"

# game/Story01.rpy:6671

translate spanish gate3_3002841a:

    # o "What did you—"
    o "¿Qué has...?"

# game/Story01.rpy:6672

translate spanish gate3_56ac1680:

    # mc "Ceiling. Look."
    mc "- ¿Qué?"

# game/Story01.rpy:6676

translate spanish gate3_07abc845:

    # o "..."
    o "..."

# game/Story01.rpy:6677

translate spanish gate3_c66fc920:

    # o "Weapons up. Light sweep — NOW!"
    o "Armas arriba. ¡Luz de barrido — ¡Ahora!"

# game/Story01.rpy:6680

translate spanish gate3_4cf7fbc3:

    # mc "Now I get why you hesitated. This isn’t a detour. It’s a death sentence."
    mc "Ahora entiendo por qué lo dudaste. Esto no es un desvío. Es una sentencia de muerte."

# game/Story01.rpy:6682

translate spanish gate3_c779d27f:

    # o "Keep moving! Push through!"
    o "¡Sigue adelante!"

# game/Story01.rpy:6684

translate spanish gate3_571350fe:

    # h "Behind us!"
    h "¡Detrás de nosotros!"

# game/Story01.rpy:6694

translate spanish gate3_2b6e83ba:

    # mc "I owe you one."
    mc "Te debo una."

# game/Story01.rpy:6696

translate spanish gate3_b4bb544b:

    # h "Just like Drake, huh?"
    h "Como Drake, ¿eh?"

# game/Story01.rpy:6698

translate spanish gate3_f3c9a95c:

    # h "Chaos, smoke, no backup... good times."
    h "Caos, humo, sin respaldo... buenos tiempos."

# game/Story01.rpy:6702

translate spanish gate3_cf1adef2:

    # mc "Yeah."
    mc "Sí."

# game/Story01.rpy:6704

translate spanish gate3_463d68bf:

    # mc "Except back then, the enemy didn’t have eight legs and acid blood."
    mc "Excepto en aquel entonces, el enemigo no tenía ocho piernas y sangre ácida."

# game/Story01.rpy:6709

translate spanish gate3_93fe2246:

    # g "They’re closing in! We’re boxed in!"
    g "¡Se están acercando! ¡Estamos en caja!"

# game/Story01.rpy:6714

translate spanish gate3_b2a6c02a:

    # o "Fear is how they win! You want to live — then FIGHT!"
    o "¡El miedo es cómo ganan! ¡Quieres vivir —¡entonces, Fight!"

# game/Story01.rpy:6717

translate spanish gate3_08f8b549:

    # o "Forward, all of you!"
    o "¡Adelante, todos!"

# game/Story01.rpy:6719

translate spanish gate3_922333ee:

    # o "FORWARD!"
    o "¡ADELANTE!"

# game/Story01.rpy:6721

translate spanish gate3_821e1d74:

    # o "Miriel, status?"
    o "Miriel, ¿estado?"

# game/Story01.rpy:6728

translate spanish gate3_82de296b:

    # Mi "One inhibitor left. Almost there!"
    Mi "Solo queda un inhibidor. ¡Casi!"

# game/Story01.rpy:6731

translate spanish gate3_c0f8140d:

    # H "All phases complete. Reaper mode activated. Happy hunting, Miss Miriel."
    H "Todas las fases completadas. Modo Parca activado. Buena caza, señorita Miriel."

# game/Story01.rpy:6742

translate spanish gate3_e839e47b:

    # H "Task complete. Enemy casualties: 67."
    H "Tarea completada. Bajas enemigas: 67."

# game/Story01.rpy:6747

translate spanish gate3_9381fe3d:

    # H "Warning. Activation code denied. Weapons deactivated."
    H "Advertencia. Código de activación denegado. Armas desactivadas."

# game/Story01.rpy:6748

translate spanish gate3_730e50b1:

    # Mi "Each time... it’s getting worse and worse..."
    Mi "Cada vez... va a peor..."

# game/Story01.rpy:6750

translate spanish gate3_01350e90:

    # mc "What was that? She — how did she—?"
    mc "¿Qué fue eso? Ella... ¿cómo?"

# game/Story01.rpy:6752

translate spanish gate3_d122a019:

    # o "She’s like you. Experiment. Implant. But where yours are built for survival... hers were forged for war."
    o "Es como tú: un experimento. Implantes. Pero mientras los tuyos fueron pensados para sobrevivir... los suyos fueron forjados para la guerra."

# game/Story01.rpy:6754

translate spanish gate3_00ec0db8:

    # o "We didn’t know what you’d become. Just hoped it wouldn’t kill you."
    o "No sabíamos en qué te convertirías. Solo esperábamos que no te matara."

# game/Story01.rpy:6758

translate spanish gate3_850ef128:

    # b "..."
    b "..."

# game/Story01.rpy:6760

translate spanish gate3_9fffb729:

    # h "...That didn’t sound friendly."
    h "...Eso no sonó amistoso."

# game/Story01.rpy:6762

translate spanish gate3_d8f59f77:

    # o "That’s not good. That’s not good at all."
    o "Eso es malo. Muy malo."

# game/Story01.rpy:6766

translate spanish gate3_0d714f3a:

    # o "RUN!"
    o "¡CORRAN!"

# game/Story01.rpy:6768

translate spanish gate3_4ff1cef7:

    # mc "What the hell are we running from?!"
    mc "¿De qué diablos estamos huyendo?"

# game/Story01.rpy:6770

translate spanish gate3_4a21102b:

    # o "Pray you don’t find out. Just MOVE."
    o "Recen por no descubrirlo. Ahora, ¡MUÉVANSE!"

# game/Story01.rpy:6772

translate spanish gate3_2ac9753d:

    # mc "(What kind of mess have we gotten ourselves into...?)"
    mc "(¿En qué clase de desastre nos hemos metido...?)"

# game/Story01.rpy:6780

translate spanish gate3_3ea7a382:

    # mc "(Now I understand why we’re running...)"
    mc "(Ahora entiendo por qué estamos corriendo...)"

# game/Story01.rpy:6782

translate spanish gate3_fe5c0a9a:

    # gg "Get over here quickly! Leave the rest to us."
    gg "¡Vengan aquí, rápido! Déjennos el resto."

# game/Story01.rpy:6791

translate spanish gate3_31bf77cd:

    # gg "TAKE THAT, YOU BASTARD!"
    gg "¡TOMA ESO, BASTARDO!"

# game/Story01.rpy:6794

translate spanish gate3_642c1b79:

    # gg "Keep pushing it back! Let them know what happens when they mess with us!"
    gg "¡Sigan empujándola! ¡Que aprendan qué pasa cuando se meten con nosotros!"

# game/Story01.rpy:6797

translate spanish gate3_e7caee40:

    # o "How are you holding up? Can you keep going?"
    o "¿Cómo estás? ¿Puedes seguir?"

# game/Story01.rpy:6798

translate spanish gate3_98b33b08:

    # Mi "I... I can’t. Muscles won’t respond. Nerve feedback’s spiking. I can’t... move."
    Mi "Yo... no puedo. Los músculos no responden. La retroalimentación nerviosa se dispara. No puedo... moverme."

# game/Story01.rpy:6800

translate spanish gate3_7a05848c:

    # o "We need a sitter. Who’s staying? Decide now."
    o "Necesitamos a alguien con ella. ¿Quién se queda? Decidan ya."

# game/Story01.rpy:6802

translate spanish gate3_1d1f4d1b:

    # mc "I will. I’ve got her."
    mc "Lo haré. La tengo."

# game/Story01.rpy:6803

translate spanish gate3_fc4f065e:

    # o "Good, then we move."
    o "Bien. Entonces avancemos."

# game/Story01.rpy:6805

translate spanish gate3_8fe3a821:

    # g "Second wave’s incoming. Delay another second — we’re corpses."
    g "La segunda oleada se acerca. Otro segundo de retraso y somos cadáveres."

# game/Story01.rpy:6826

translate spanish gate3_890882d9:

    # mc "How are you holding up? You didn’t twist anything while running, did you?"
    mc "¿Cómo estás? No te torciste nada al correr, ¿verdad?"

# game/Story01.rpy:6830

translate spanish gate3_5895c49a:

    # h "I’m fine. And even if I wasn’t, pain’s just... familiar now. Comfortable, in a sick kind of way."
    h "Estoy bien. Y aunque no lo estuviera, el dolor ya es... familiar. Cómodo, de una forma bastante enferma."

# game/Story01.rpy:6833

translate spanish gate3_bc53fe45:

    # h "Funny, isn’t it? Two months ago I was planning a bar expansion. Now I kill things with more eyes than morals."
    h "Hace dos meses planeaba ampliar el bar. Ahora mato cosas con más ojos que moral."

# game/Story01.rpy:6836

translate spanish gate3_b1acbe43:

    # mc "Yeah. Life flipped the board and set it on fire."
    mc "Sí. La vida volcó el tablero y luego le prendió fuego."

# game/Story01.rpy:6837

translate spanish gate3_86589ae8:

    # mc "Earlier — you said something. Was that about training, or... something else?"
    mc "Antes —dijiste algo. ¿Era eso sobre entrenamiento, o... algo más?"

# game/Story01.rpy:6840

translate spanish gate3_e0538218:

    # h "Later. Some ghosts don’t like being dragged into daylight."
    h "Más tarde. A algunos fantasmas no les gusta ser arrastrados a la luz del día."

# game/Story01.rpy:6841

translate spanish gate3_bdc4c063:

    # h "Look who’s back from the void. {w}Our lovely executioner wakes."
    h "Mira quién ha vuelto del vacío. {w}Nuestro encantador verdugo despierta."

# game/Story01.rpy:6842

translate spanish gate3_506b8ea6:

    # h "Sleep well, sweetheart? Remember who you are, or do we need to start with names and body counts?"
    h "¿Te acuerdas de quién eres, o necesitamos empezar con nombres y cuentas de cuerpo?"

# game/Story01.rpy:6844

translate spanish gate3_7fba446f:

    # Mi "...Sleep? I wasn’t asleep."
    Mi "... ¿Dormir? No estaba dormido."

# game/Story01.rpy:6845

translate spanish gate3_f0bacf56:

    # Mi "I remember spiders. Blood. Then nothing. {w}Just... silence like a grave."
    Mi "Recuerdo a las arañas, sangre, y nada. {w}Solo... silencio como una tumba."

# game/Story01.rpy:6847

translate spanish gate3_309026ab:

    # Mi "Also — can someone please stop grabbing my ass? Thanks."
    Mi "También, ¿puede alguien por favor dejar de agarrarme el culo?"

# game/Story01.rpy:6848

translate spanish gate3_5c29fbc8:

    # mc "(I wasn’t touching anything... was I?)"
    mc "(No estaba tocando nada... ¿Yo?)"

# game/Story01.rpy:6851

translate spanish gate3_63d50e09:

    # Mi "Where are we? What happened after the fight?"
    Mi "¿Qué pasó después de la pelea?"

# game/Story01.rpy:6853

translate spanish gate3_518557ef:

    # mc "You tore through them like a storm. Then collapsed. We carried you out. Barely."
    mc "Los destrozaste como una tormenta, y luego te desplomaste, te arrastramos, y te arrastraste, y te lo llevaste."

# game/Story01.rpy:6855

translate spanish gate3_099f0b6a:

    # mc "Now? We’re in some kind of dead zone."
    mc "Estamos en una especie de zona muerta."

# game/Story01.rpy:6856

translate spanish gate3_6b52beb8:

    # mc "Quiet. {w=0.5}Too quiet. The monsters won’t come near it."
    mc "Silencio. {w=0.5}Demasiado tranquilo. Los monstruos no se acercarán."

# game/Story01.rpy:6857

translate spanish gate3_3dcaefa2:

    # mc "Feels like they’re afraid."
    mc "Se siente como si tuvieran miedo."

# game/Story01.rpy:6859

translate spanish gate3_deb8701d:

    # h "They stopped chasing us. Just... turned back. Like something deeper down scared them off."
    h "Dejaron de perseguirnos, pero... retrocedieron, como si algo más profundo los asustara."

# game/Story01.rpy:6861

translate spanish gate3_ec535cc7:

    # h "Either we’re beneath their notice… or something worse is watching."
    h "O estamos bajo su aviso... o algo peor está viendo."

# game/Story01.rpy:6863

translate spanish gate3_da3fdbf1_2:

    # Mi "..."
    Mi "..."

# game/Story01.rpy:6864

translate spanish gate3_11100fa2:

    # Mi "I hate this. Not knowing. Not understanding."
    Mi "Odio esto, no lo sé, no lo entiendo."

# game/Story01.rpy:6867

translate spanish gate3_2523569c:

    # o "Eyes up. Everyone, gather. We need to talk."
    o "Todos, todos, reúnanse, tenemos que hablar."

# game/Story01.rpy:6869

translate spanish gate3_9a27feff:

    # mc "New problem?"
    mc "¿Nuevo problema?"

# game/Story01.rpy:6871

translate spanish gate3_3917415b:

    # g "Depends how you define 'problem.' Our signal jammer’s gone dark."
    g "Depende de cómo definas \"problema\". Nuestro interferidor se ha evaporado."

# game/Story01.rpy:6874

translate spanish gate3_afcc31db:

    # g "Instruments say it’s... not where it should be."
    g "Los instrumentos dicen que no es... donde debería estar."

# game/Story01.rpy:6876

translate spanish gate3_fedc9680:

    # g "Either it moved... or it was never a device in the first place."
    g "O se movió... o nunca fue un dispositivo en primer lugar."

# game/Story01.rpy:6877

translate spanish gate3_717e5f0c:

    # mc "You mean—?"
    mc "¿Quieres decir...?"

# game/Story01.rpy:6880

translate spanish gate3_f03c1c60:

    # g "I mean it’s organic. Living. And it’s jamming everything around us like a heartbeat. We weren’t trained for this."
    g "Quiero decir que es orgánica. Vivir. Y está atascando todo alrededor de nosotros como un latido del corazón. No fuimos entrenados para esto."

# game/Story01.rpy:6884

translate spanish gate3_0520bc0c:

    # gggg "CONTACT FRONT!"
    gggg "¡Contáctese!"

# game/Story01.rpy:6886

translate spanish gate3_3f5d77e4:

    # gggg "Don’t move! Identify yourself! Division and clearance — NOW!"
    gggg "¡No te muevas! ¡Identifiquete! División y limpieza — ¡AHORA!"

# game/Story01.rpy:6887

translate spanish gate3_bb8e4b4e:

    # a "..."
    a "..."

# game/Story01.rpy:6891

translate spanish gate3_9f873829:

    # o "I’m going to check it out. Stay sharp."
    o "Voy a comprobarlo."

# game/Story01.rpy:6892

translate spanish gate3_92f0b873:

    # gg "I’ve got a bad feeling about this..."
    gg "Tengo una mala sensación sobre esto..."

# game/Story01.rpy:6894

translate spanish gate3_ed371c5c:

    # o "He’s not responding. Weapons tight. If he twitches wrong, drop him."
    o "No responde. Armas apretadas. Si se equivoca, déjalo caer."

# game/Story01.rpy:6897

translate spanish gate3_b51aa932:

    # a "No need."
    a "No es necesario."

# game/Story01.rpy:6899

translate spanish gate3_5a07c3d8:

    # a "He won’t be moving again. Death took him long before you got here."
    a "No volverá a moverse. La muerte le llevó mucho antes de que llegaras."

# game/Story01.rpy:6902

translate spanish gate3_3b702b97:

    # o "And what brings the Inquisition down here?"
    o "¿Y qué trae la Inquisición aquí abajo?"

# game/Story01.rpy:6903

translate spanish gate3_c57132fb:

    # o "You don’t usually get your boots dirty with our kind."
    o "No sueles ensuciar tus botas con nuestro tipo."

# game/Story01.rpy:6905

translate spanish gate3_2642caea:

    # a "Curiosity. {w}And maybe a touch of divine judgment."
    a "Curiosidad. {w}Y tal vez un toque de juicio divino."

# game/Story01.rpy:6906

translate spanish gate3_738a7d96:

    # a "Share too much, I’d have to kill you. But you already knew that."
    a "Compartir demasiado, tendría que matarte. Pero ya lo sabías."

# game/Story01.rpy:6907

translate spanish gate3_6563353c:

    # a "Lower your weapon. Before you embarrass yourself."
    a "Baja tu arma antes de que te avergüences."

# game/Story01.rpy:6910

translate spanish gate3_13c3ed99:

    # a "Good. I knew you weren’t entirely without intelligence — unlike the last team that passed through."
    a "Sabía que no estabas completamente sin inteligencia, a diferencia del último equipo que pasó por aquí."

# game/Story01.rpy:6911

translate spanish gate3_07abc845_1:

    # o "..."
    o "..."

# game/Story01.rpy:6913

translate spanish gate3_31ef06ae:

    # a "Now, what exactly brings you to this wretched place? Care to enlighten me?"
    a "¿Qué te trae exactamente a este lugar miserable?"

# game/Story01.rpy:6915

translate spanish gate3_62fffba1:

    # o "I thought we were here for the same reason?"
    o "¿Pensé que estábamos aquí por la misma razón?"

# game/Story01.rpy:6916

translate spanish gate3_e0916875:

    # o "Or are you here for something else entirely?"
    o "¿O estás aquí por algo más por completo?"

# game/Story01.rpy:6919

translate spanish gate3_aad49879:

    # a "Oh, come now, of course, we share the same goal. How could you even suspect that I wouldn’t be on your side?"
    a "Oh, vamos, por supuesto, compartimos el mismo objetivo. ¿Cómo puedes sospechar que no estaría de tu lado?"

# game/Story01.rpy:6921

translate spanish gate3_d74daaa2:

    # mc "Why are we hiding? Who is that?"
    mc "¿Por qué nos escondemos?"

# game/Story01.rpy:6923

translate spanish gate3_4e692d39:

    # h "That’s an Inquisitor. If they see us — really see us — we’re not walking out of here."
    h "Es un inquisidor. Si nos ve, si de verdad nos ve, no saldremos de aquí."

# game/Story01.rpy:6925

translate spanish gate3_f8a737d2:

    # Mi "(...Nice save, Olivia.)"
    Mi "(...Bien cubierto, Olivia.)"

# game/Story01.rpy:6927

translate spanish gate3_4ab96640:

    # a "Well, well... The Cold Reaper herself. Didn’t expect to cross blades — metaphorical or otherwise."
    a "Vaya, vaya... la Parca Fría en persona. No esperaba cruzar espadas contigo, ni literal ni metafóricamente."

# game/Story01.rpy:6928

translate spanish gate3_6c262472:

    # a "Walk with me, would you? There’s so much I’ve been dying to discuss with you."
    a "Acompáñame, ¿quieres? Me muero por hablar de tantas cosas contigo."

# game/Story01.rpy:6930

translate spanish gate3_6f49dee8:

    # o "She’s not going anywhere with you. Different assignment. You’re not on the guest list."
    o "No va a ninguna parte contigo. Tiene otra misión. Tú no estás en la lista de invitados."

# game/Story01.rpy:6932

translate spanish gate3_d1a706c4:

    # a "Pity."
    a "Qué pena."

# game/Story01.rpy:6933

translate spanish gate3_fc2c4411:

    # a "But tell me — what mission sends your precious Reaper alone into hell’s underbelly?"
    a "Pero dime: ¿qué misión envía a tu preciosa Parca sola al vientre del infierno?"

# game/Story01.rpy:6934

translate spanish gate3_dcb527c6:

    # o "You don’t need to know."
    o "No necesitas saberlo."

# game/Story01.rpy:6937

translate spanish gate3_bb8e4b4e_1:

    # a "..."
    a "..."

# game/Story01.rpy:6938

translate spanish gate3_780b94b4:

    # a "Fascinating..."
    a "Fascinante..."

# game/Story01.rpy:6941

translate spanish gate3_97bef882:

    # o "We’ve changed course. We’re heading deeper."
    o "Hemos cambiado de rumbo. Nos dirigimos más profundo."

# game/Story01.rpy:6943

translate spanish gate3_fdb37e25:

    # o "You should stay behind. She can’t find out about our passengers."
    o "Tú quédate atrás. No puede descubrir a nuestros pasajeros."

# game/Story01.rpy:6944

translate spanish gate3_81c89ada:

    # o "Eyes on them. Do not let them slip."
    o "No les quites los ojos de encima. No dejes que se escapen."

# game/Story01.rpy:6946

translate spanish gate3_3c313796:

    # a "Of course, Commander. Time is ticking. Lead the way."
    a "Por supuesto, comandante. El tiempo corre. Guíe el camino."

# game/Story01.rpy:6955

translate spanish gate3_7fc62b06:

    # h "So? What actually happened back there?"
    h "¿Entonces? ¿Qué pasó ahí atrás?"

# game/Story01.rpy:6958

translate spanish gate3_3358aec5:

    # Mi "Even I don’t have the full picture."
    Mi "Ni siquiera yo tengo el panorama completo."

# game/Story01.rpy:6959

translate spanish gate3_dbdd0bd6:

    # Mi "They went off to disable the jammer. We’re supposed to find shelter. Rest."
    Mi "Fueron a desactivar el interferidor. Nosotros debemos buscar refugio. Descansar."

# game/Story01.rpy:6961

translate spanish gate3_4e0b5bcb:

    # Mi "But something’s off. Ostorius... the way he spoke to her — it wasn’t strategy. It was personal."
    Mi "Pero algo no encaja. Ostorius... la forma en que le habló no era estrategia. Era algo personal."

# game/Story01.rpy:6964

translate spanish gate3_c35ab9d5:

    # mc "Isn’t the Inquisition basically untouchable in your world? Maybe that’s why."
    mc "¿La Inquisición no es básicamente intocable en tu mundo? Quizá sea por eso."

# game/Story01.rpy:6965

translate spanish gate3_8940a5a4:

    # mc "...Though I felt it too. Like pressure behind my ribs. Thought it was just being underground."
    mc "Aunque yo también lo sentí. Como una presión detrás de las costillas. Pensé que era por estar bajo tierra."

# game/Story01.rpy:6968

translate spanish gate3_0d34d17e:

    # h "Yeah, no. That woman... She didn’t move like a soldier."
    h "Sí... no. Esa mujer no se movía como una soldado."

# game/Story01.rpy:6969

translate spanish gate3_0487f28e:

    # h "She glided. Like the air stepped aside for her."
    h "Se deslizaba. Como si el aire se apartara para dejarla pasar."

# game/Story01.rpy:6971

translate spanish gate3_998027fb:

    # h "And now we’re benched? ‘Find a safe place and rest’? Sounds a lot like 'you're in the way.'"
    h "¿Y ahora nos mandan al banquillo? ¿\"Busquen un lugar seguro y descansen\"? Suena mucho a \"estorban\"."

# game/Story01.rpy:6973

translate spanish gate3_3119629c:

    # Mi "It’s not that. You both look like you haven’t slept in days. And Liv’s been pushing herself to the edge."
    Mi "No es eso. Ustedes dos parecen llevar días sin dormir. Y Liv se ha estado empujando hasta el límite."

# game/Story01.rpy:6975

translate spanish gate3_06edc0fe:

    # h "Pushing forward is what I was made for."
    h "Seguir avanzando es para lo que nací."

# game/Story01.rpy:6976

translate spanish gate3_4d7cfb6d:

    # h "Sitting around while others fight? That’s not rest, that’s guilt."
    h "¿Quedarnos sentados mientras otros pelean? Eso no es descanso; es culpa."

# game/Story01.rpy:6978

translate spanish gate3_c482c3e2:

    # Mi "And what about you?"
    Mi "¿Y tú?"

# game/Story01.rpy:6981

translate spanish gate3_282212fb:

    # mc "We need to recover. It's not weakness. It’s strategy."
    mc "Necesitamos recuperarnos. No es debilidad. Es estrategia."

# game/Story01.rpy:6983

translate spanish gate3_e005d60c:

    # Mi "Fair. Rest it is. Let’s find a spot that won’t kill us in our sleep."
    Mi "Justo. Entonces descansamos. Busquemos un lugar que no nos mate mientras dormimos."

# game/Story01.rpy:6985

translate spanish gate3_05906fb8:

    # Mi "Well then, let’s move out."
    Mi "Bien, entonces avancemos."

# game/Story01.rpy:6995

translate spanish gate3_17161744:

    # mc "No. We keep moving. I can’t sit still with that thing still active."
    mc "No. Seguimos moviéndonos. No puedo quedarme quieto con esa cosa todavía activa."

# game/Story01.rpy:6997

translate spanish gate3_af724ec7:

    # Mi "Alright. Just don’t drop dead on me halfway there."
    Mi "De acuerdo. Pero no se te ocurra morirte a mitad del camino."

# game/Story01.rpy:6999

translate spanish gate3_05906fb8_1:

    # Mi "Well then, let’s move out."
    Mi "Bien, entonces avancemos."

# game/Story01.rpy:7005

translate spanish gate3_2e0cde03:

    # Mi "This place... dust, rust, and leftover silence."
    Mi "Este lugar... polvo, óxido y un silencio que se quedó atrás."

# game/Story01.rpy:7006

translate spanish gate3_f2cf929c:

    # Mi "Power grid’s long dead, but the insulation's still good. Might even keep us warm."
    Mi "La red eléctrica murió hace mucho, pero el aislamiento sigue intacto. Quizá hasta nos mantenga calientes."

# game/Story01.rpy:7008

translate spanish gate3_578ba1c8:

    # Mi "It’s not much, but it beats dying in the open. What do you think?"
    Mi "No es gran cosa, pero es mejor que morir a la intemperie. ¿Qué opinan?"

# game/Story01.rpy:7010

translate spanish gate3_968d013c:

    # h "I think you’re dodging the real question."
    h "Creo que estás esquivando la verdadera pregunta."

# game/Story01.rpy:7011

translate spanish gate3_9aa33994:

    # Mi "Hm?"
    Mi "¿Hm?"

# game/Story01.rpy:7012

translate spanish gate3_38f9d358:

    # h "Why the mask?"
    h "¿Por qué la máscara?"

# game/Story01.rpy:7014

translate spanish gate3_da3fdbf1_3:

    # Mi "..."
    Mi "..."

# game/Story01.rpy:7015

translate spanish gate3_32f43f81:

    # Mi "It covered the scars."
    Mi "Ocultaba las cicatrices."

# game/Story01.rpy:7016

translate spanish gate3_e0190cf5:

    # Mi "After a while... I forgot how not to wear it."
    Mi "Después de un tiempo... olvidé cómo estar sin ella."

# game/Story01.rpy:7017

translate spanish gate3_3e464b12:

    # h "Then take it off. Let the past breathe a little."
    h "Entonces quítatela. Deja que el pasado respire un poco."

# game/Story01.rpy:7018

translate spanish gate3_b4ea19a1:

    # h "I bet even [mc] would rather see the real you."
    h "Apuesto a que hasta [mc] preferiría ver a la verdadera tú."

# game/Story01.rpy:7021

translate spanish gate3_7475c7f3:

    # Mi "...Alright."
    Mi "...De acuerdo."

# game/Story01.rpy:7023

translate spanish gate3_12af69f1:

    # h "...Told you. Gorgeous."
    h "...Te lo dije. Preciosa."

# game/Story01.rpy:7025

translate spanish gate3_da3fdbf1_4:

    # Mi "..."
    Mi "..."

# game/Story01.rpy:7027

translate spanish gate3_fc30204a:

    # Mi "...Thanks."
    Mi "...Gracias."

# game/Story01.rpy:7030

translate spanish gate3_cd81b7fa:

    # h "Whoa. No flinching? No 'I’m not like that' speech? Look at you."
    h "Vaya. ¿Sin estremecerte? ¿Sin discurso de \"yo no soy así\"? Mírate."

# game/Story01.rpy:7032

translate spanish gate3_8be893b9:

    # h "Growing up on me."
    h "Madurando delante de mis ojos."

# game/Story01.rpy:7034

translate spanish gate3_949c951b:

    # Mi "Maybe. {w}Or maybe I’m too tired to argue."
    Mi "Tal vez. {w}O quizás estoy demasiado cansada para discutir."

# game/Story01.rpy:7037

translate spanish gate3_12ce51c0:

    # mc "Sorry to ruin the moment, but... you two need to see this."
    mc "Perdón por arruinar el momento, pero... tienen que ver esto."

# game/Story01.rpy:7039

translate spanish gate3_f8a59fab:

    # h "What now? Another monster?"
    h "¿Otro monstruo?"

# game/Story01.rpy:7042

translate spanish gate3_7398d180:

    # mc "Worse. Maybe."
    mc "Peor. Tal vez."

# game/Story01.rpy:7045

translate spanish gate3_7e9e7e05:

    # h "So?"
    h "¿Y?"

# game/Story01.rpy:7048

translate spanish gate3_da163c01:

    # mc "Back on the Ark — before we launched — remember the research team? Paranormal studies, off-the-books."
    mc "En el Arca, antes del lanzamiento... ¿recuerdas al equipo de investigación? Estudios paranormales, extraoficiales."

# game/Story01.rpy:7050

translate spanish gate3_0b30800c:

    # h "Yeah, I remember them… vaguely."
    h "Sí, los recuerdo... vagamente."

# game/Story01.rpy:7054

translate spanish gate3_99e5953a:

    # mc "This wall. The insignia. Same one."
    mc "Esta pared. La insignia. Es la misma."

# game/Story01.rpy:7055

translate spanish gate3_213fedcb:

    # mc "Their motto, too. ‘A man must believe the incomprehensible can be understood.’"
    mc "Y su lema también: \"Una persona debe creer que lo incomprensible puede llegar a entenderse.\""

# game/Story01.rpy:7058

translate spanish gate3_3bc20e08:

    # mc "Miriel... how did Lora end up here?"
    mc "Miriel... ¿cómo terminó Lora aquí?"

# game/Story01.rpy:7061

translate spanish gate3_9f989ea0:

    # h "Again?"
    h "¿Otra vez?"

# game/Story01.rpy:7062

translate spanish gate3_82e5a980:

    # h "You're reading into it too much. I... I—"
    h "Lees demasiado entre líneas. Yo... yo..."

# game/Story01.rpy:7064

translate spanish gate3_13149de2:

    # mc "OLIVIA!"
    mc "¡OLIVIA!"

# game/Story01.rpy:7067

translate spanish gate3_8e8722f9:

    # mc "LIV? HEY!"
    mc "¿LIV? ¡OYE!"

# game/Story01.rpy:7068

translate spanish gate3_74941eb5:

    # mc "What`s wrong?!"
    mc "¿Qué ocurre?"

# game/Story01.rpy:7070

translate spanish gate3_cb418999:

    # mc "Miriel?!"
    mc "¡Miriel!"

# game/Story01.rpy:7071

translate spanish gate3_a1253b1b:

    # Mi "She pushed past her limits."
    Mi "Pasó de largo sus propios límites."

# game/Story01.rpy:7072

translate spanish gate3_abd86a4a:

    # Mi "Burned herself from the inside out. And never stopped."
    Mi "Se quemó por dentro. Y aun así no se detuvo."

# game/Story01.rpy:7074

translate spanish gate3_838f0d19:

    # mc "It’s not— It doesn’t look like—"
    mc "No es... No parece..."

# game/Story01.rpy:7075

translate spanish gate3_44ef9aec:

    # Mi "Don’t argue. I’ll get the stabilizers."
    Mi "No discutas. Iré por los estabilizadores."

# game/Story01.rpy:7076

translate spanish gate3_3d511f68:

    # Mi "Move her. Now."
    Mi "Muévela. Ahora."

# game/Story01.rpy:7079

translate spanish gate3_738aef13:

    # mc "Okay — yeah. Okay"
    mc "Vale, sí."

# game/Story01.rpy:7080

translate spanish gate3_9fe41c81:

    # mc "Just tell me she’ll be alright."
    mc "Solo dime que estará bien."

# game/Story01.rpy:7083

translate spanish gate3_b12a9849:

    # Mi "She will."
    Mi "Lo hará."

# game/Story01.rpy:7084

translate spanish gate3_13f66bd4:

    # Mi "But next time, someone needs to pull her back before she snaps herself in half."
    Mi "Pero la próxima vez alguien tiene que frenarla antes de que se parta en dos."

# game/Story01.rpy:7087

translate spanish gate3_d547eb2a:

    # Mi "Over here. Lay her down."
    Mi "Aquí. Acuéstala."

# game/Story01.rpy:7090

translate spanish gate3_da3fdbf1_5:

    # Mi "..."
    Mi "..."

# game/Story01.rpy:7093

translate spanish gate3_7596713b:

    # Mi "…Hold her steady."
    Mi "...Sujétala bien."

# game/Story01.rpy:7094

translate spanish gate3_043242a3:

    # Mi "Vitals are crashing— "
    Mi "Los signos vitales se desploman... "

# game/Story01.rpy:7095

translate spanish gate3_32dfb47b:

    # Mi "…Come on, come on…"
    Mi "Vamos, vamos..."

# game/Story01.rpy:7097

translate spanish gate3_9a811e10:

    # Mi "…She’s stable."
    Mi "...Está estable."

# game/Story01.rpy:7101

translate spanish gate3_757bf369:

    # mc "(If I’d lost her too… I don’t—)"
    mc "(Si también la hubiera perdido a ella... yo no...)"

# game/Story01.rpy:7109

translate spanish gate3_da3fdbf1_6:

    # Mi "..."
    Mi "..."

# game/Story01.rpy:7112

translate spanish gate3_a6be913e:

    # mc "So?"
    mc "¿Y?"

# game/Story01.rpy:7114

translate spanish gate3_da76920b:

    # Mi "She needs sleep."
    Mi "Necesita dormir."

# game/Story01.rpy:7115

translate spanish gate3_5c19529b:

    # Mi "Like the rest of us should’ve had hours ago."
    Mi "Como el resto de nosotros debería haber hecho hace horas."

# game/Story01.rpy:7117

translate spanish gate3_bd87542c:

    # mc "That’s it?"
    mc "¿Eso es todo?"

# game/Story01.rpy:7119

translate spanish gate3_422656f8:

    # Mi "I hope so."
    Mi "Eso espero."

# game/Story01.rpy:7120

translate spanish gate3_dc044862:

    # Mi "But hope’s not really my field."
    Mi "Pero la esperanza no es precisamente mi especialidad."

# game/Story01.rpy:7122

translate spanish gate3_850ef128_1:

    # b "..."
    b "..."

# game/Story01.rpy:7124

translate spanish gate3_2170b42f:

    # mc "Miriel?"
    mc "¿Miriel?"

# game/Story01.rpy:7126

translate spanish gate3_da3fdbf1_7:

    # Mi "..."
    Mi "..."

# game/Story01.rpy:7128

translate spanish gate3_b73768a9:

    # Mi "You don’t have to say it."
    Mi "No tienes que decirlo."

# game/Story01.rpy:7130

translate spanish gate3_ae070c4d:

    # mc "I wasn’t going to thank you."
    mc "No iba a agradecerte."

# game/Story01.rpy:7132

translate spanish gate3_77feb436:

    # Mi "Good."
    Mi "Bien."

# game/Story01.rpy:7134

translate spanish gate3_e3c9e435:

    # mc "I was going to ask why."
    mc "Iba a preguntar por qué."

# game/Story01.rpy:7135

translate spanish gate3_9544d998:

    # mc "Why do you care about us so much?"
    mc "¿Por qué te preocupas tanto por nosotros?"

# game/Story01.rpy:7137

translate spanish gate3_da2c0965:

    # Mi "Don’t do this."
    Mi "No hagas esto."

# game/Story01.rpy:7139

translate spanish gate3_a1de67ad:

    # mc "You didn’t have to. Like last time."
    mc "No tenías que hacerlo. Como la última vez."

# game/Story01.rpy:7141

translate spanish gate3_2ea261af:

    # Mi "I..."
    Mi "Yo..."

# game/Story01.rpy:7143

translate spanish gate3_c66e3692:

    # mc "And this is the cold reaper?"
    mc "¿Y esta es la Parca Fría?"

# game/Story01.rpy:7144

translate spanish gate3_0fa42410:

    # mc "Funny, don't you think?"
    mc "Es gracioso, ¿no crees?"

# game/Story01.rpy:7146

translate spanish gate3_bf4f7c5f:

    # Mi "Don’t make me into something I’m not."
    Mi "No me conviertas en algo que no soy."

# game/Story01.rpy:7147

translate spanish gate3_b9fc9e51:

    # Mi "I didn’t do this to be noble. I just… didn’t want more blood on my hands. Not hers."
    Mi "No lo hice por nobleza. Solo... no quería más sangre en mis manos. No la de ella."

# game/Story01.rpy:7149

translate spanish gate3_0cd1477e:

    # mc "Still."
    mc "Aún así."

# game/Story01.rpy:7150

translate spanish gate3_f0edc8ea:

    # mc "You stayed. You fought. That means something."
    mc "Te quedaste. Peleaste. Eso significa algo."

# game/Story01.rpy:7152

translate spanish gate3_42f1be33:

    # Mi "To you, maybe."
    Mi "A ti, tal vez."

# game/Story01.rpy:7153

translate spanish gate3_19541a8e:

    # Mi "To me, it’s just one less nightmare."
    Mi "Para mí, es solo una pesadilla menos."

# game/Story01.rpy:7155

translate spanish gate3_da3fdbf1_8:

    # Mi "..."
    Mi "..."

# game/Story01.rpy:7157

translate spanish gate3_bed062ed:

    # mc "You changed something."
    mc "Cambiaste algo."

# game/Story01.rpy:7158

translate spanish gate3_1d84882f:

    # mc "For her. For me."
    mc "Para ella, para mí."

# game/Story01.rpy:7160

translate spanish gate3_d149f440:

    # Mi "Don’t."
    Mi "No."

# game/Story01.rpy:7162

translate spanish gate3_8663293f:

    # mc "I mean it."
    mc "Lo digo en serio."

# game/Story01.rpy:7164

translate spanish gate3_da3fdbf1_9:

    # Mi "..."
    Mi "..."

# game/Story01.rpy:7166

translate spanish gate3_004273b3:

    # Mi "And I mean— "
    Mi "Y yo digo... "

# game/Story01.rpy:7168

translate spanish gate3_7c7e5ef9:

    # Mi "You don’t owe me anything. Don’t carry that weight for me."
    Mi "No me debes nada. No cargues ese peso por mí."

# game/Story01.rpy:7170

translate spanish gate3_22b5537d:

    # mc "Maybe I already am."
    mc "Tal vez ya lo estoy."

# game/Story01.rpy:7172

translate spanish gate3_da3fdbf1_10:

    # Mi "..."
    Mi "..."

# game/Story01.rpy:7174

translate spanish gate3_7bf88ef0:

    # Mi "You and Olivia..."
    Mi "Tú y Olivia..."

# game/Story01.rpy:7176

translate spanish gate3_da3fdbf1_11:

    # Mi "..."
    Mi "..."

# game/Story01.rpy:7178

translate spanish gate3_0d604f01:

    # Mi "I always wondered. How’d it start?"
    Mi "Siempre me lo pregunté. ¿Cómo empezó?"

