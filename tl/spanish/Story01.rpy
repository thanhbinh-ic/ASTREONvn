    Fl "Normalmente, al instante."

# game/Story01.rpy:4742

translate spanish street3_bf8a48da:

    # Fl "Rule one."
    Fl "Regla uno."

# game/Story01.rpy:4752

translate spanish street3_84b33d76:

    # Fl "Stay sharp."
    Fl "Mantente alerta."

# game/Story01.rpy:4753

translate spanish street3_4bfea2ea:

    # Fl "People who drift off don’t last long here."
    Fl "La gente que se distrae no dura mucho aquí."

# game/Story01.rpy:4756

translate spanish street3_6fb1465c:

    # mc "Noted."
    mc "Anotado."

# game/Story01.rpy:4757

translate spanish street3_49dc5dfd:

    # mc "But why are we here?"
    mc "¿Pero por qué estamos aquí?"

# game/Story01.rpy:4760

translate spanish street3_d59b8377:

