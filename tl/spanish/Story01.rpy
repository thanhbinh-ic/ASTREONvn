translate spanish street3_83af87e1:

    # Fl "You’ll see."
    Fl "Ya lo verás."

# game/Story01.rpy:4805

translate spanish street3_db714bd7:

    # Fl "Try to keep up."
    Fl "Intenta seguirme el ritmo."

# game/Story01.rpy:4809

translate spanish street3_f251e946:

