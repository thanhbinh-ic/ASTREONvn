    # mc "Olivia, not now! I’m serious. Just answer me."
    mc "Olivia, ¡ahora no! Hablo en serio. Solo respóndeme."

# game/Story01.rpy:7827

translate spanish final2_00fc96e4:

    # mc "These creatures... they started showing up after Lora and her group arrived here, didn’t they?"
    mc "Estas criaturas... comenzaron a aparecer después de que Lora y su grupo llegaran aquí, ¿no?"

# game/Story01.rpy:7890

