# game/Story01.rpy:2245

translate spanish eye_2045143e:

    # Fl "You get patched up. Cute."
    Fl "Terminas remendado. Qué tierno."

# game/Story01.rpy:2246

translate spanish eye_9dce6941:

    # Fl "I’d call that luck, if I believed in it."
    Fl "Lo llamaría suerte, si creyera en esas cosas."

# game/Story01.rpy:2248

translate spanish eye_ab5f3722:

    # mc "Or maybe I’m just more useful than they’re willing to admit."
    mc "O quizá soy más útil de lo que están dispuestos a admitir."

# game/Story01.rpy:2250

translate spanish eye_f16278dd:

    # Fl "Or maybe you're just not worth the bullet."
    Fl "O quizá simplemente no vales la bala."

# game/Story01.rpy:2251

translate spanish eye_d90d4380:

    # Fl "Jury’s still hung on that one."
    Fl "El jurado sigue deliberando."

# game/Story01.rpy:2253

translate spanish eye_0c5aa423:

    # h "Still doesn’t make sense. Why hurt someone you actually {b}need{/b}?"
    h "Sigue sin tener sentido. ¿Por qué herir a alguien a quien realmente {b}necesitas{/b}?"

# game/Story01.rpy:2255

translate spanish eye_14b480ac:

    # Mi "Because here, reputation keeps you alive. You mouth off, you pay for it—outsider or not."
    Mi "Porque aquí la reputación te mantiene con vida. Si hablas de más, lo pagas, seas forastero o no."

# game/Story01.rpy:2257

translate spanish eye_fb90345d:

    # Fl "Actions carry weight. Yours? Let’s just say the universe isn’t tipping in your favor."
    Fl "Las acciones tienen peso. ¿Las tuyas? Digamos que el universo no se inclina a tu favor."

# game/Story01.rpy:2259

translate spanish eye_de416208:

    # mc "Come on, it wasn’t that bad—"
    mc "Vamos, no fue para tanto—"

# game/Story01.rpy:2261

translate spanish eye_61b5c330:

    # Mi "If it wasn’t, we wouldn’t be having this conversation."
    Mi "Si no lo fuera, no estaríamos teniendo esta conversación."

# game/Story01.rpy:2263

translate spanish eye_4d96374b:

    # mc "So what now? No one’s said why I’m even here."
    mc "¿Y ahora qué? Nadie ha dicho por qué estoy aquí."

# game/Story01.rpy:2265

translate spanish eye_b93d56c8:

    # Mi "Flora will fill you in. I’m heading back to Olivia."
    Mi "Flora te pondrá al día. Yo vuelvo con Olivia."

# game/Story01.rpy:2267

translate spanish eye_c770837c:

    # h "What? Again? Why am I always left behind?!"
    h "¿Qué? ¿Otra vez? ¿Por qué siempre me dejan atrás?"

# game/Story01.rpy:2269

translate spanish eye_3f8f0d7c:

    # Mi "Because you’re not ready. We’ve talked about this."
    Mi "Porque no estás lista. Ya hablamos de esto."

# game/Story01.rpy:2271

translate spanish eye_f28dfb11:

    # Mi "Or would you rather end up like last time — cornered and helpless?"
    Mi "¿O prefieres acabar como la última vez: acorralada e indefensa?"

# game/Story01.rpy:2275

translate spanish eye_1e1c82bf:

    # h "...I get it. I do. It’s just — too much, all at once. I’m trying, I really am."
    h "...Lo entiendo. De verdad. Es solo que... es demasiado, todo a la vez. Lo intento, de verdad."

# game/Story01.rpy:2277

translate spanish eye_d8fa6225:

    # Fl "Don’t take it personally. I’ll keep him alive. Not out of kindness — I just hate wasting potential."
    Fl "No te lo tomes como algo personal. Lo mantendré con vida. No por bondad: simplemente odio desperdiciar potencial."

# game/Story01.rpy:2279

translate spanish eye_edbaa5a0:

    # mc "I’ll be fine. Promise."
    mc "Estaré bien. Lo prometo."

# game/Story01.rpy:2281

translate spanish eye_45169d3a:

    # h "You said that before. Right before everything went to hell. You never learn."
    h "Eso dijiste antes. Justo antes de que todo se fuera al infierno. Nunca aprendes."

# game/Story01.rpy:2285

translate spanish eye_0c64d3fb:

    # h "Whatever. Go. Do your big hero thing. I’ll be here... waiting."
    h "Como quieras. Ve. Haz tu gran acto de héroe. Yo estaré aquí... esperando."

# game/Story01.rpy:2287

translate spanish eye_5cc9e6dc:

    # h "Hey Miriel — why do cows wear bells?"
    h "Oye, Miriel... ¿por qué las vacas llevan campanas?"

# game/Story01.rpy:2288

translate spanish eye_0065cdc1:

    # Mi "...Why?"
    Mi "¿Por qué?"

# game/Story01.rpy:2289

translate spanish eye_1c2a3947:

    # h "Because their horns don’t work. Get it? {b}Horns?{/b}"
    h "Porque sus cuernos no suenan. ¿Lo pillas? {b}¿Cuernos?{/b}"

# game/Story01.rpy:2292

translate spanish eye_6ab56585:

    # Fl "She means well. Her heart’s loud. Too loud. Gets her into trouble."
    Fl "Tiene buenas intenciones. Su corazón grita. Demasiado. Eso la mete en problemas."

# game/Story01.rpy:2293

translate spanish eye_fc79a29b:

    # Fl "Not her fault. But not exactly helpful either."
    Fl "No es culpa suya. Pero tampoco ayuda demasiado."

# game/Story01.rpy:2294

translate spanish eye_e8919edc:

    # Fl "Let’s keep moving before her heart gets us all killed."
    Fl "Sigamos antes de que su corazón nos mate a todos."

# game/Story01.rpy:2304

translate spanish norman_fc4c5e62:

    # mc "(So… it wasn’t a dream. This silence... it’s real.)"
    mc "(Así que... no fue un sueño. Este silencio... es real.)"

# game/Story01.rpy:2306

translate spanish norman_a5c5c4d8:

    # mc "(You’re gone, Norman. Just like that.)"
    mc "(Te has ido, Norman. Así.)"

# game/Story01.rpy:2313

translate spanish norman_7a49050d:

    # mc "(All this time, I kept reaching backward — chasing shadows instead of holding onto what was right in front of me.)"
    mc "(Todo este tiempo seguí mirando atrás, persiguiendo sombras en lugar de aferrarme a lo que tenía justo delante.)"

# game/Story01.rpy:2315

translate spanish norman_f2435fde:

    # mc "(Now you’re part of that shadow too…)"
    mc "(Ahora también eres parte de esa sombra...)"

# game/Story01.rpy:2317

translate spanish norman_c39fd126:

    # mc "(Funny, isn’t it? How loss teaches value faster than time ever could.)"
    mc "(Qué ironía, ¿no? La pérdida enseña el valor de las cosas más rápido de lo que jamás podría hacerlo el tiempo.)"

# game/Story01.rpy:2318

translate spanish norman_74289af5:

    # mc "(I was too blind to see the gift I had until it slipped through my fingers.)"
    mc "(Fui demasiado ciego para ver lo que tenía hasta que se me escurrió entre los dedos.)"

# game/Story01.rpy:2320

translate spanish norman_7bad90f2:

    # mc "I’m sorry, Norman. I failed you... as a father, as a man."
    mc "Lo siento, Norman. Te fallé... como padre, como hombre."

# game/Story01.rpy:2322

translate spanish norman_eedbd841:

    # mc "(I hope wherever you are, it’s far from this place. Far from regret. And if there's peace to be found beyond this life... may it find you first.)"
    mc "(Espero que estés donde estés, sea lejos de este lugar. Lejos del arrepentimiento. Y si existe paz más allá de esta vida... ojalá te encuentre primero.)"

# game/Story01.rpy:2323

translate spanish norman_bdd3e568:

    # mc "(As for me... I’ve made my choice.)"
    mc "(En cuanto a mí... he tomado mi decisión.)"

# game/Story01.rpy:2325

translate spanish norman_27416777:

    # mc "Get it together, [mc]. This isn't over — not yet."
    mc "Contrólate, [mc]. Esto no ha terminado. Todavía no."

# game/Story01.rpy:2327

translate spanish norman_a6ea1520:

    # mc "(Whatever it takes... whoever stands in my way — I'll see this through. For you, Norman. I swear it.)"
    mc "(Cueste lo que cueste... se interponga quien se interponga, llegaré hasta el final. Por ti, Norman. Lo juro.)"

# game/Story01.rpy:2338

translate spanish taxi_3cc873d3:

    # Fl "(Where is she? If we're late, Ember won't be happy.)"
    Fl "(¿Dónde está? Si llegamos tarde, Ember no estará contenta.)"

# game/Story01.rpy:2340

translate spanish taxi_3d85478c:

    # h "Are you kidding? He’s going alone? He just came to his senses!"
    h "¿Estás bromeando? ¿Va a ir solo? ¡Acaba de recuperar el sentido!"

# game/Story01.rpy:2341

translate spanish taxi_790aacf7:

    # Mi "We’ve already been through this."
    Mi "Ya hemos pasado por esto."

# game/Story01.rpy:2343

translate spanish taxi_eee9abb9:

    # h "Fine, then who are you sending him with, if not me? Alone?"
    h "Bien, entonces, ¿con quién lo mandas, si no es conmigo? ¿Solo?"

# game/Story01.rpy:2344

translate spanish taxi_55932dea:

    # Mi "We’ve got someone for that."
    Mi "Tenemos a alguien para eso."

# game/Story01.rpy:2346

translate spanish taxi_00a7ea8a:

    # mc "Don’t worry, I’m not a kid. I’ll manage somehow."
    mc "No te preocupes, no soy un niño. Yo me las arreglaré de alguna manera."

# game/Story01.rpy:2347

translate spanish taxi_2d031942:

    # h "You have no idea what you’re getting into... Alright."
    h "No tienes idea de en qué te estás metiendo... Está bien."

# game/Story01.rpy:2350

translate spanish taxi_deb733c7:

    # h "Anyway. Did you get what you needed?"
    h "De todos modos. ¿Conseguiste lo que necesitabas?"

# game/Story01.rpy:2354

translate spanish taxi_fa38795e:

    # mc "More or less. She didn’t mince words. Sharp - edged, but efficient."
    mc "Más o menos. No se anduvo con rodeos. Cortante, pero eficiente."

# game/Story01.rpy:2357

translate spanish taxi_d5a291a1:

    # h "Straight shooters are rare. Let’s not waste the opportunity."
    h "La gente directa escasea. No desperdiciemos la oportunidad."

# game/Story01.rpy:2362

translate spanish taxi_ec25f7d6:

    # mc "She was… difficult. Couldn’t quite tell if she was testing me or just didn’t care."
    mc "Fue... difícil. No sabía si me estaba poniendo a prueba o si simplemente no le importaba."

# game/Story01.rpy:2365

translate spanish taxi_e4536fe2:

    # h "You two looked cozy. I thought you were swapping life stories out there."
    h "Se veían muy cómodos ustedes dos. Pensé que estaban intercambiando historias de vida ahí dentro."

# game/Story01.rpy:2368

translate spanish taxi_3b6357cd:

    # mc "It wasn’t like that."
    mc "No era así."

# game/Story01.rpy:2371

translate spanish taxi_c8b7f316:

    # h "Sure. Keep telling yourself that."
    h "Claro, sigue diciéndote eso."

# game/Story01.rpy:2375

translate spanish taxi_f29b7645:

    # mc "What’s next? I was told you’d brief us on the mission."
    mc "¿Qué sigue? Me dijeron que nos pondrías al tanto de la misión."

# game/Story01.rpy:2378

translate spanish taxi_623c7501:

    # Mi "Right. Before that, meet Flora. Engineer."
    Mi "Cierto. Antes de eso, esta es Flora. Ingeniera."

# game/Story01.rpy:2381

translate spanish taxi_2d5d4c48:

    # Mi "Brilliant, if a little—"
    Mi "Brillante, aunque un poco—"

# game/Story01.rpy:2383

translate spanish taxi_2bec6303:

    # h "—Intolerable?"
    h "- ¿Intolerable?"

# game/Story01.rpy:2387

translate spanish taxi_b0f528b6:

    # Mi "I was going to say ‘prickly.’ But yes. Teamwork isn’t exactly her strong suit."
    Mi "Iba a decir 'espinosa'. Pero sí. El trabajo en equipo no es precisamente su fuerte."

# game/Story01.rpy:2389

translate spanish taxi_710aa79c:

    # h "Strong suit? She just declared war on common decency."
    h "¿Su fuerte? Acaba de declararle la guerra a la decencia común."

# game/Story01.rpy:2390

translate spanish taxi_b72c8661:

    # h "Please, don’t tell me she’s the one you picked as his handler."
    h "Por favor, no me digas que la eligieron como su enlace."

# game/Story01.rpy:2394

translate spanish taxi_6f008721:

    # Mi "Despite... {b}that{/b}, she’s good. Too good to sideline."
    Mi "A pesar de... {b}eso{/b}, es buena. Demasiado buena para dejarla al margen."

# game/Story01.rpy:2396

translate spanish taxi_00d6b0c7:

    # h "Talent doesn’t excuse everything. Especially not on day one."
    h "El talento no lo excusa todo. Y menos el primer día."

# game/Story01.rpy:2398

translate spanish taxi_b46c2f76:

    # mc "She didn’t cross any lines. Actually helped — adjusted my implants."
    mc "No cruzó ninguna línea. De hecho, ayudó: ajustó mis implantes."

# game/Story01.rpy:2402

translate spanish taxi_8707cf4c:

    # mc "Look — last thing we need is a civil war. You don’t have to like her. Just… don’t light the match."
    mc "Mira, lo último que necesitamos es una guerra civil. No tiene que caerte bien. Solo... no enciendas la mecha."

# game/Story01.rpy:2404

translate spanish taxi_0d5484bf:

    # Mi "If she stepped out of line, I’ll deal with it. But for now, try to stay on the same page."
    Mi "Si se pasó de la raya, yo me encargaré. Pero por ahora, intenten mantenerse del mismo lado."

# game/Story01.rpy:2406

translate spanish taxi_3fb94351:

    # h "Fine. I’ll play nice. But don’t expect me to fake smiles."
    h "Bien. Me portaré bien. Pero no esperes que finja sonrisas."

# game/Story01.rpy:2408

translate spanish taxi_6fea16ea:

    # Fl "Well, look who found her manners. Thought feral kids were extinct — guess we missed one."
    Fl "Vaya, mira quién encontró sus modales. Creí que los niños salvajes estaban extintos, pero parece que se nos escapó una."

# game/Story01.rpy:2411

translate spanish taxi_69a8feda:

    # h "Wolves have more class than you."
    h "Los lobos tienen más clase que tú."

# game/Story01.rpy:2413

translate spanish taxi_5500e654:

    # Fl "More bite, huh?"
    Fl "Más mordedura, ¿eh?"

# game/Story01.rpy:2414

translate spanish taxi_c8c833ac:

    # Fl "Brave talk for someone still learning which end of the blade cuts."
    Fl "Palabras valientes para alguien que aún está aprendiendo qué lado de la hoja corta."

# game/Story01.rpy:2416

translate spanish taxi_bc19f712:

    # mc "(This is spiraling. Fast.)"
    mc "(Esto se está saliendo de control. Rápido.)"

# game/Story01.rpy:2419

translate spanish taxi_d191875c:

    # mc "Enough. This ends here. We’re on the same side — aren’t we?"
    mc "Basta. Esto termina aquí. Estamos del mismo lado, ¿no?"

# game/Story01.rpy:2421

translate spanish taxi_a5c1e2be:

    # h "I’m not scared of her, if that’s what you’re implying."
    h "No tengo miedo de ella, si eso es lo que estás insinuando."

# game/Story01.rpy:2423

translate spanish taxi_461cb14e:

    # h "To me, she’s just a spoiled brat looking for attention."
    h "Para mí, es solo una mocosa malcriada buscando atención."

# game/Story01.rpy:2424

translate spanish taxi_7271b221:

    # h "If that’s what she wants, she’s barking up the wrong tree."
    h "Si eso es lo que quiere, se metió con la persona equivocada."

# game/Story01.rpy:2428

translate spanish taxi_ed5b9eac:

    # Fl "Spoiled brat, am I? Funny."
    Fl "¿Mocosa consentida? Qué gracioso."

# game/Story01.rpy:2429

translate spanish taxi_587255e2:

    # Fl "Coming from someone who probably cried the first time gravity hit."
    Fl "Viniendo de alguien que seguro lloró la primera vez que la gravedad la tocó."

# game/Story01.rpy:2430

translate spanish taxi_0fa4cc6f:

    # Fl "Say it again. To my face this time. I dare you."
    Fl "Dilo otra vez. A la cara esta vez. Te reto."

# game/Story01.rpy:2434

translate spanish taxi_40062ff1:

    # h "Oh, did that hit a little too close to home?"
    h "¿Te tocó una fibra?"

# game/Story01.rpy:2435

translate spanish taxi_b560e11d:

    # h "Poor baby. Go cry to mommy — maybe she’ll give you the validation you’re so desperate for."
    h "Pobrecita. Ve a llorarle a mamá; quizá ella te dé la validación que tanto necesitas."

# game/Story01.rpy:2437

translate spanish taxi_ac17c7dc:

    # h "Relax. I’ll be as gentle as I can with her."
    h "Relájate. Seré tan amable como pueda con ella."

# game/Story01.rpy:2438

translate spanish taxi_9c502187:

    # h "She helped you, and I respect that."
    h "Te ayudó, y eso lo respeto."

# game/Story01.rpy:2439

translate spanish taxi_00ab7d7f:

    # h "But I’m not letting her walk all over us."
    h "Pero no voy a dejar que nos pisotee."

# game/Story01.rpy:2445

translate spanish taxi_9851254a:

    # h "Can I ask you something?"
    h "¿Puedo preguntarte algo?"

# game/Story01.rpy:2447

translate spanish taxi_1e8638ee:

    # Fl "Try me."
    Fl "Inténtalo."

# game/Story01.rpy:2449

translate spanish taxi_f0b4e7e6:

    # h "You worked your way into the plan. Not with skill. With your damn mouth."
    h "Te colaste en el plan. No por habilidad. Por tu maldita boca."

# game/Story01.rpy:2453

translate spanish taxi_009adb85:

    # Fl "Say that again."
    Fl "Repite eso."

# game/Story01.rpy:2461

translate spanish taxi_63ac7fb7:

    # mc "Let’s not escalate this. We don’t want to harm each other physically, right?"
    mc "No hagamos que esto vaya a más. No queremos acabar haciéndonos daño de verdad, ¿cierto?"

# game/Story01.rpy:2462

translate spanish taxi_fb2a40c2:

    # h "She’s the one pushing buttons."
    h "Ella es la que está provocando."

# game/Story01.rpy:2464

translate spanish taxi_672b360d:

    # Mi "*whispers* You’re being a little too much."
    Mi "*en voz baja* Te estás pasando un poco."

# game/Story01.rpy:2467

translate spanish taxi_53270883:

    # mc "You threw the first punch. You think she’ll just take that lying down?"
    mc "Tú diste el primer golpe. ¿Crees que ella se va a quedar de brazos cruzados?"

# game/Story01.rpy:2468

translate spanish taxi_225c6b06:

    # h "...Fine. I got carried away."
    h "...Bien. Me dejé llevar."

# game/Story01.rpy:2469

translate spanish taxi_bcd136d4:

    # Mi "Let’s not waste more time. I’ll handle Olivia’s briefing. You’re with Flora."
    Mi "No perdamos más tiempo. Yo me encargaré de poner al día a Olivia. Tú vas con Flora."

# game/Story01.rpy:2474

translate spanish taxi_92cc7779:

    # Mi "Liv, let’s get you cleaned up. You look like someone spat you out of a ventilation shaft."
    Mi "Liv, vamos a limpiarte. Pareces recién escupida por un conducto de ventilación."

# game/Story01.rpy:2477

translate spanish taxi_436a8e27:

    # h "Sending him off with that fox..."
    h "Mandarlo con esa zorra..."

# game/Story01.rpy:2478

translate spanish taxi_1241fa96:

    # h "Yeah, that’s... {w}fine. I’ll deal with it."
    h "Sí, eso está... {w}bien. Lo manejaré."

# game/Story01.rpy:2481

translate spanish taxi_00b89295:

    # h "(muttering) And what’s wrong with my outfit… I thought it was edgy."
    h "(murmurando) ¿Y qué tiene de malo mi atuendo...? Yo creía que tenía estilo."

# game/Story01.rpy:2483

translate spanish taxi_3a509a97:

    # Mi "No stunts. Not today."
    Mi "Nada de numeritos. Hoy no."

# game/Story01.rpy:2484

translate spanish taxi_43751c71:

    # Mi "[mc] — no heroics. Keep your head down."
    Mi "[mc], nada de heroicidades. Mantén la cabeza baja."

# game/Story01.rpy:2486

translate spanish taxi_0871a390:

    # Fl "Relax, he’ll breathe. {w}Probably."
    Fl "Relájate, seguirá respirando. {w}Probablemente."

# game/Story01.rpy:2487

translate spanish taxi_96b51103:

    # Fl "I'll keep an eye on him."
    Fl "Le echaré un ojo."

# game/Story01.rpy:2489

translate spanish taxi_ca95305c:

    # Mi "That’s what worries me."
    Mi "Eso es lo que me preocupa."

# game/Story01.rpy:2491

translate spanish taxi_b11ab808:

    # Fl "You actually made a valid point."
    Fl "De hecho, dijiste algo válido."

# game/Story01.rpy:2493

translate spanish taxi_053edf5d:

    # mc "Mind if I ask something?"
    mc "¿Te importa si pregunto algo?"

# game/Story01.rpy:2495

translate spanish taxi_e607938f:

    # Fl "Go ahead. You’ve earned a question."
    Fl "Adelante. Te has ganado una pregunta."

# game/Story01.rpy:2497

translate spanish taxi_65df9ffe:

    # mc "Why do you push Olivia like that? Is it personal?"
    mc "¿Por qué presionas así a Olivia? ¿Es algo personal?"

# game/Story01.rpy:2499

translate spanish taxi_cb8dcd91:

    # Fl "The place we’re going — outsiders aren’t welcome. And that’s exactly what she is."
    Fl "El lugar al que vamos no recibe bien a los forasteros. Y eso es exactamente lo que ella es."

# game/Story01.rpy:2501

translate spanish taxi_a2fc62ea:

    # mc "So this was all planned?"
    mc "¿Entonces todo esto estaba planeado?"

# game/Story01.rpy:2503

translate spanish taxi_86c46a4d:

    # Fl "Maybe, maybe not. Who knows."
    Fl "Tal vez, tal vez no."

# game/Story01.rpy:2504

translate spanish taxi_8d1e10a9:

    # Fl "For now? I’ve got real problems to solve."
    Fl "Por ahora? Tengo problemas reales para resolver."

# game/Story01.rpy:2521

translate spanish flashback_c3bfa118:

    # Mi "Found something interesting? Or is there a reason you’ve been staring at that thing for the last five minutes?"
    Mi "¿Encontraste algo interesante? ¿O hay una razón por la que has estado mirando esa cosa durante los últimos cinco minutos?"

# game/Story01.rpy:2524

translate spanish flashback_8ac493dd:

    # h "This? Just... a fragment. Just memories from another life."
    h "Esto es solo un fragmento, solo recuerdos de otra vida."

# game/Story01.rpy:2525

translate spanish flashback_41c82c13:

    # h "It’s all that’s left from that time. But memories aren’t why you pulled me aside, are they?"
    h "Es todo lo que queda de ese tiempo. Pero los recuerdos no son por qué me hiciste a un lado, ¿verdad?"

# game/Story01.rpy:2528

translate spanish flashback_24750d49:

    # h "And to be honest, I’m glad you did."
    h "Y para ser honesto, me alegro de que lo hicieras."

# game/Story01.rpy:2529

translate spanish flashback_2a0c258f:

    # h "I’ve been waiting for a chance to finally get some answers out of you."
    h "He estado esperando una oportunidad para finalmente conseguir algunas respuestas de usted."

# game/Story01.rpy:2531

translate spanish flashback_2c7265d1:

    # Mi "I want to talk. About a few things. Especially about [mc]."
    if mc == "Kael" or persistent.mc_name == "Kael":
        Mi "Quiero hablar de algunas cosas, especialmente de Kael."
    else:
        Mi "Quiero hablar de algunas cosas, especialmente [mc!t]."

# game/Story01.rpy:2532

translate spanish flashback_3f90380a:

    # Mi "We’ve been dancing around it long enough."
    Mi "Hemos estado bailando alrededor de él bastante tiempo."

# game/Story01.rpy:2535

translate spanish flashback_db9bf1e2:

    # h "Oh? And why now?"
    h "¿Y por qué ahora?"

# game/Story01.rpy:2536

translate spanish flashback_0855aac8:

    # h "What’s changed?"
    h "¿Qué ha cambiado?"

# game/Story01.rpy:2537

translate spanish flashback_dcccdf6d:

    # h "Last I checked, you were tight-lipped as a grave."
    h "Lo último que comprobé, eras una tumba."

# game/Story01.rpy:2539

translate spanish flashback_7e87920b:

    # Mi "This time’s different. I swear it. On my honor."
    Mi "Esta vez es diferente. Lo juro. En mi honor."

# game/Story01.rpy:2542

translate spanish flashback_30f77406:

    # h "Honor? That’s a quaint little word."
    h "¿Señoría? Esa es una pequeña palabra pintoresca."

# game/Story01.rpy:2543

translate spanish flashback_f4e2714d:

    # h "Means nothing to me. Not anymore."
    h "No significa nada para mí, ya no."

# game/Story01.rpy:2544

translate spanish flashback_a892e1bb:

    # h "So if you want something from me... you’d better make it worth my time."
    h "Así que si quieres algo de mí... será mejor que valga la pena mi tiempo."

# game/Story01.rpy:2546

translate spanish flashback_ed29d2f3:

    # Mi "Then ask. I’ll answer what I can."
    Mi "Entonces pregunta. Responderé lo que pueda."

# game/Story01.rpy:2548

translate spanish flashback_387a80b3:

    # h "Alright then. Let’s start with the obvious."
    h "Muy bien entonces. Empecemos con lo obvio."

# game/Story01.rpy:2549

translate spanish flashback_a0f946df:

    # h "How the hell did we end up here?"
    h "¿Cómo diablos terminamos aquí?"

# game/Story01.rpy:2553

translate spanish flashback_7cc91ada:

    # h "I combed through every scrap of data I could find — not a single mention of Earth."
    h "Me peiné a través de cada chat de datos que pude encontrar, no una sola mención de la Tierra."

# game/Story01.rpy:2554

translate spanish flashback_8ada1f7a:

    # h "Are we in another universe? Did we cross some dimensional line no one knew existed?"
    h "¿Estamos en otro universo? ¿Cruzamos alguna línea dimensional que nadie sabía que existía?"

# game/Story01.rpy:2556

translate spanish flashback_182aa183:

    # Mi "No. Same universe. Just... the far edge of it. The Astoria system."
    Mi "No, el mismo universo, el borde de la misma, el sistema Astoria."

# game/Story01.rpy:2557

translate spanish flashback_1abf64a2:

    # Mi "When the self-destruct activated, there wasn’t time for precision."
    Mi "Cuando la autodestrucción se activa, no había tiempo para la precisión."

# game/Story01.rpy:2558

translate spanish flashback_268ade09:

    # Mi "We jumped through the first wormhole that opened."
    Mi "Saltamos por el primer agujero de gusano que se abrió."

# game/Story01.rpy:2563

translate spanish flashback_7e405d8f:

    # h "A wormhole? That’s your explanation?"
    h "¿Un agujero de gusano? ¿Es tu explicación?"

# game/Story01.rpy:2564

translate spanish flashback_1df3035f:

    # h "Like some cheap pulp sci-fi crap?"
    h "¿Como una mierda de ciencia ficción barata?"

# game/Story01.rpy:2569

translate spanish flashback_bd77f27a:

    # h "Sorry, sorry..."
    h "Lo siento, lo siento..."

# game/Story01.rpy:2571

translate spanish flashback_075a0126:

    # h "You expect me to swallow that?"
    h "¿Esperas que me lo trague?"

# game/Story01.rpy:2575

translate spanish flashback_35aaa393:

    # Mi "I know how it sounds. But it’s the truth."
    Mi "Sé cómo suena, pero es la verdad."

# game/Story01.rpy:2581

translate spanish flashback_eaad59f1:

    # h "...If that’s true, then why doesn’t Earth show up in any star map?"
    h "...Si eso es cierto, entonces ¿por qué no aparece la Tierra en ningún mapa de estrellas?"

# game/Story01.rpy:2585

translate spanish flashback_b5679d03:

    # Mi "Because the galaxy is divided. {w}Known and hidden sectors."
    Mi "Porque la galaxia está dividida. {w}Sectores conocidos y ocultos."

# game/Story01.rpy:2586

translate spanish flashback_7459238a:

    # Mi "Earth’s buried in the latter."
    Mi "La Tierra está enterrada en este último."

# game/Story01.rpy:2588

translate spanish flashback_86b9d094:

    # h "This have anything to do with the blood of the ancients?"
    h "¿Esto tiene algo que ver con la sangre de los antiguos?"

# game/Story01.rpy:2590

translate spanish flashback_38ad0345:

    # Mi "It might."
    Mi "Podría."

# game/Story01.rpy:2592

translate spanish flashback_4923e73e:

    # h "Fine. Then answer this — if we got here... is there a way back?"
    h "Bien. Entonces responda esto, si llegamos aquí... ¿hay una manera de volver?"

# game/Story01.rpy:2594

translate spanish flashback_5fcfeafe:

    # h "You’ve crossed that line before. You’ve seen both sides."
    h "Has cruzado esa línea antes. Has visto ambos lados."

# game/Story01.rpy:2596

translate spanish flashback_12da8d50:

    # Mi "It’s not that simple."
    Mi "No es tan simple."

# game/Story01.rpy:2597

translate spanish flashback_eae55326:

    # Mi "But right now... I need to know something else."
    Mi "Pero ahora mismo... necesito saber otra cosa."

# game/Story01.rpy:2599

translate spanish flashback_27c40d0d:

    # Mi "Why [mc]? Why are you so loyal to him?"
    Mi "¿Por qué? [mc]¿Por qué eres tan leal a él?"

# game/Story01.rpy:2601

translate spanish flashback_bf83bd82:

    # h "...That’s what you want to know?"
    h "...¿Eso es lo que quieres saber?"

# game/Story01.rpy:2602

translate spanish flashback_0c3e77ab:

    # h "You pull me aside, throw wormholes and lost Earth at me, and now you want a damn heart-to-heart?"
    h "Me haces a un lado, me arrojas agujeros de gusano y me perdiste la Tierra, ¿y ahora quieres un corazón a corazón?"

# game/Story01.rpy:2604

translate spanish flashback_fd93855e:

    # Mi "Look... I saw how you stood in front of him. Back there. Without hesitation."
    Mi "Mira, vi cómo te paraste frente a él, allá atrás, sin dudarlo."

# game/Story01.rpy:2605

translate spanish flashback_12d849f6:

    # Mi "Like someone who’s done it before."
    Mi "Como alguien que lo ha hecho antes."

# game/Story01.rpy:2606

translate spanish flashback_f88f7d59:

    # Mi "Not for a commander. Not even for a friend."
    Mi "Ni siquiera para un comandante."

# game/Story01.rpy:2607

translate spanish flashback_c8b05ef4:

    # Mi "You looked like someone protecting family."
    Mi "Parecías alguien protegiendo a los suyos."

# game/Story01.rpy:2611

translate spanish flashback_cb15718f:

    # Mi "So tell me — what made you that way?"
    Mi "Entonces dime: ¿qué te hizo así?"

# game/Story01.rpy:2617

translate spanish flashback_1c119a26:

    # h "It’s not a simple story. It started long before we ever met."
    h "No es una historia sencilla. Empezó mucho antes de que nos conociéramos."

# game/Story01.rpy:2621

translate spanish flashback_bee1f955:

    # h "We were poor. {w}The kind of poor that eats at your bones."
    h "Éramos pobres. {w}De esa pobreza que se te mete en los huesos."

# game/Story01.rpy:2622

translate spanish flashback_7256dfdd:

    # h "I don’t remember my father — and I thank the stars for that."
    h "No recuerdo a mi padre, y doy gracias por eso."

# game/Story01.rpy:2624

translate spanish flashback_0221d9fc:

    # h "He was a bastard. The only decent thing he ever did was pay off our debts before vanishing."
    h "Era un bastardo. Lo único decente que hizo fue pagar nuestras deudas antes de desaparecer."

# game/Story01.rpy:2626

translate spanish flashback_3a590478:

    # h "Mom did the rest. Took any job that paid. {w=0.3}Cleaning. {w=0.3}Lifting. {w=0.3}Bleeding fingers and aching joints."
    h "Mamá hizo el resto. Aceptó cualquier trabajo que pagara. {w=0.3}Limpiar. {w=0.3}Cargar peso. {w=0.3}Dedos sangrando y articulaciones destrozadas."

# game/Story01.rpy:2627

translate spanish flashback_aaa1703b:

    # h "But she smiled through it. Said we had to keep living, keep laughing. Even when the world kicked us in the teeth."
    h "Pero aun así sonreía. Decía que teníamos que seguir viviendo, seguir riéndonos. Incluso cuando el mundo nos pateaba los dientes."

# game/Story01.rpy:2631

translate spanish flashback_9670ddf9:

    # h "School was hell. {w=0.3}Bullies. {w=0.3}Looks. {w=0.3}Whispers."
    h "La escuela era un infierno. {w=0.3}Abusones. {w=0.3}Miradas. {w=0.3}Susurros."

# game/Story01.rpy:2633

translate spanish flashback_2dba9a1d:

    # h "Transferred more times than I can count."
    h "Me cambié de escuela más veces de las que puedo contar."

# game/Story01.rpy:2635

translate spanish flashback_8f5b7cc6:

    # h "But the truth is, I didn’t just transfer — I got expelled."
    h "Pero la verdad es que no solo me cambiaron de escuela: me expulsaron."

# game/Story01.rpy:2639

translate spanish flashback_996ae6ce:

    # h "Who's the ugly little freak now, huh?! Come on, say something!"
    h "¿Quién es ahora el monstruito feo, eh? ¡Vamos, di algo!"

# game/Story01.rpy:2644

translate spanish flashback_acd0c2e2:

    # Mi "That explains... {w=0.7}a lot."
    Mi "Eso explica... {w=0.7}muchas cosas."

# game/Story01.rpy:2646

translate spanish flashback_6691ef66:

    # h "That rage? It wasn’t for me. It was for her."
    h "¿Esa rabia? No era por mí. Era por ella."

# game/Story01.rpy:2647

translate spanish flashback_05833941:

    # h "My sister. {w=0.6}No one touches her. {w=0.7}Ever."
    h "Mi hermana. {w=0.6}Nadie la toca. {w=0.7}Nunca."

# game/Story01.rpy:2652

translate spanish flashback_1e06cad9:

    # C "You’re late."
    C "Llegas tarde."

# game/Story01.rpy:2653

translate spanish flashback_13aa05a3:

    # C "Did something happen?"
    C "¿Pasó algo?"

# game/Story01.rpy:2655

translate spanish flashback_95f34983:

    # h "Oh, nothing serious. Just had to take care of a little business with some old acquaintances."
    h "No es nada serio. Solo tuve que arreglar un asuntito con unos viejos conocidos."

# game/Story01.rpy:2656

translate spanish flashback_7d98d6a1:

    # h "But don’t worry — it’s all sorted out now."
    h "Pero no te preocupes: ya está todo arreglado."

# game/Story01.rpy:2658

translate spanish flashback_0d87725f:

    # C "Well, if you say so, then alright."
    C "Bueno, si tú lo dices... está bien."

# game/Story01.rpy:2659

translate spanish flashback_529c7dbe:

    # C "I hope nothing bad happened to those acquaintances of yours."
    C "Espero que no les haya pasado nada malo a esos conocidos tuyos."

# game/Story01.rpy:2661

translate spanish flashback_83bf6841:

    # C "Because if they, I don’t know, suddenly ended up in a hospital..."
    C "Porque si, no sé, de pronto acabaron en el hospital..."

# game/Story01.rpy:2662

translate spanish flashback_4883fb60:

    # C "And then decided to press charges... what are we supposed to do then?"
    C "Y luego deciden presentar cargos... ¿qué se supone que vamos a hacer?"

# game/Story01.rpy:2664

translate spanish flashback_9bd7d988:

    # h "Oh, what’s this? Are those notes of concern I hear in your voice?"
    h "Vaya, ¿qué es esto? ¿Oigo preocupación en tu voz?"

# game/Story01.rpy:2665

translate spanish flashback_1857bbe2:

    # h "My little sister’s growing soft on me. How adorable."
    h "Mi hermanita se me está ablandando. Qué adorable."

# game/Story01.rpy:2667

translate spanish flashback_c5984938:

    # h "(She always felt older than me. Smarter. Sharper. She saw through things I never could.)"
    h "(Siempre parecía mayor que yo. Más lista. Más lúcida. Veía cosas que yo no podía ver.)"

# game/Story01.rpy:2669

translate spanish flashback_47a11129:

    # h "I’m lucky, you know."
    h "Tengo suerte, ¿sabes?"

# game/Story01.rpy:2673

translate spanish flashback_a569790e:

    # h "I’d be dead, or worse."
    h "Estaría muerta, o algo peor."

# game/Story01.rpy:2680

translate spanish flashback_b0246807:

    # C "That smell — your sleeves! Blood again?!"
    C "¡Ese olor... tus mangas! ¡Otra vez sangre?!"

# game/Story01.rpy:2682

translate spanish flashback_33c36345:

    # C "You got into a fight again, didn’t you? How many times do we have to go through this?!"
    C "Te metiste en otra pelea, ¿verdad? ¡¿Cuántas veces tenemos que pasar por esto?!"

# game/Story01.rpy:2683

translate spanish flashback_096fd088:

    # C "Sit down. Don’t argue. I’ll get the med kit."
    C "Siéntate. No discutas. Voy por el botiquín."

# game/Story01.rpy:2684

translate spanish flashback_69bac397:

    # C "The last thing we need is for an infection to set in."
    C "Lo último que necesitamos es que se infecte."

# game/Story01.rpy:2686

translate spanish flashback_6789f0f3:

    # Mi "She really cares for you."
    Mi "De verdad se preocupa por ti."

# game/Story01.rpy:2688

translate spanish flashback_27bde915:

    # h "She’s all I had. Still is."
    h "Era todo lo que tenía. Todavía lo es."

# game/Story01.rpy:2690

translate spanish flashback_a120d698:

    # C "So? What was it this time?"
    C "Entonces, ¿qué fue esta vez?"

# game/Story01.rpy:2691

translate spanish flashback_7be962c2:

    # C "Was there really no way to resolve things peacefully?"
    C "¿De verdad no había forma de resolverlo en paz?"

# game/Story01.rpy:2692

translate spanish flashback_ba1de1b0:

    # C "Did you {b}really{/b} have to resort to fists again?"
    C "¿De {b}verdad{/b} tenías que volver a usar los puños?"

# game/Story01.rpy:2698

translate spanish flashback_9661f2d4:

    # h "(I had a plan. A stupid, desperate plan.)"
    h "(Tenía un plan, un plan estúpido y desesperado.)"

# game/Story01.rpy:2699

translate spanish flashback_c81f5ba0:

    # h "(I wanted to drop out. {w=0.7}Find a job. {w=0.7}Help Mom.)"
    h "(Quería dejar la escuela. {w=0.7}Buscar trabajo. {w=0.7}Ayudar a mamá.)"

# game/Story01.rpy:2700

translate spanish flashback_01a20cdf:

    # h "(Pay for college. Give Anya the future I never had.)"
    h "(Pagar la universidad. Darle a Anya el futuro que yo nunca tuve.)"

# game/Story01.rpy:2702

translate spanish flashback_71d281f2:

    # h "Anya..."
    h "Anya..."

# game/Story01.rpy:2704

translate spanish flashback_6fdd4899:

    # C "What now?"
    C "¿Y ahora qué se te ocurrió?"

# game/Story01.rpy:2713

translate spanish flashback_83bbe951:

    # C "And no. You don’t have to do that."
    C "Y no. No tienes que hacer eso."

# game/Story01.rpy:2714

translate spanish flashback_f4cede2a:

    # C "Don’t worry about me - I’ll figure it out."
    C "No te preocupes por mí: ya encontraré la manera."

# game/Story01.rpy:2718

translate spanish flashback_dbc38cbd:

    # h "She never sugarcoated anything. {w}Brutal honesty, no matter how harsh it sounded."
    h "Nunca endulzaba nada. {w}Honestidad brutal, por duro que sonara."

# game/Story01.rpy:2719

translate spanish flashback_983fa9e2:

    # h "Not much has changed about her in that regard, even now."
    h "En eso no ha cambiado demasiado, ni siquiera ahora."

# game/Story01.rpy:2721

translate spanish flashback_183adc69:

    # h "As for how I met [mc]... I was desperately looking for a job."
    h "En cuanto a cómo conocí a [mc]... en ese momento buscaba trabajo desesperadamente."

# game/Story01.rpy:2722

translate spanish flashback_7990a09b:

    # h "I went to every place that would even consider hiring me..."
    h "Fui a todos los lugares donde siquiera pudieran considerar contratarme..."

# game/Story01.rpy:2724

translate spanish flashback_e5c97658:

    # h "But it was pointless. Everywhere I went, they asked for that stupid piece of paper — a high school diploma."
    h "Pero era inútil. En todas partes me pedían ese estúpido papel: un diploma de secundaria."

# game/Story01.rpy:2725

translate spanish flashback_852eeeae:

    # h "Can you believe it? Even just to work in a basic restaurant..."
    h "¿Puedes creerlo? Incluso para trabajar en un restaurante cualquiera..."

# game/Story01.rpy:2729

translate spanish flashback_f06c5204:

    # h "Then, one rainy night... I met him."
    h "Entonces, una noche de lluvia... lo conocí."

# game/Story01.rpy:2733

translate spanish flashback_1f4cd599:

    # h "You know what [mc] told me that night?"
    h "¿Sabes qué me dijo [mc] esa noche?"

# game/Story01.rpy:2735

translate spanish flashback_4db62cdd:

    # h "He said, ‘Sometimes, spilling your guts to a stranger is the healthiest thing you can do.’"
    h "Dijo: 'A veces, contarle tus miserias a un extraño es lo más sano que puedes hacer.'"

# game/Story01.rpy:2737

translate spanish flashback_d2974aa3:

    # h "(I remember thinking to myself back then—what a weirdo.)"
    h "(Recuerdo que en ese momento pensé: vaya tipo raro.)"

# game/Story01.rpy:2739

translate spanish flashback_d6aa4506:

    # h "You're kind of strange, you know."
    h "Sabes, eres bastante raro."

# game/Story01.rpy:2740

translate spanish flashback_08cd3d8c:

    # h "(And he just replied...)"
    h "(Y él simplemente respondió...)"

# game/Story01.rpy:2742

translate spanish flashback_1ac25744:

    # mc "My wife is a crazy scientist, and I’m just a regular bar owner."
    mc "Mi esposa es una científica loca, y yo solo soy un dueño de bar común y corriente."

# game/Story01.rpy:2743

translate spanish flashback_fc167046:

    # mc "One who can’t even find an employee — funny, right?"
    mc "Uno que ni siquiera encuentra a quién contratar. Gracioso, ¿no?"

# game/Story01.rpy:2744

translate spanish flashback_573217c6:

    # mc "Does that make me strange? Absolutely. Do I care? Not in the slightest."
    mc "¿Eso me hace raro? Sin duda. ¿Me importa? Ni lo más mínimo."

# game/Story01.rpy:2746

translate spanish flashback_2fded262_6:

    # h "..."
    h "..."

# game/Story01.rpy:2747

translate spanish flashback_c1f515ad:

    # h "You’re looking for... {w}an employee?"
    h "Estás buscando... {w}¿un empleado?"

# game/Story01.rpy:2749

translate spanish flashback_8e666101:

    # mc "Yeah, been a couple of weeks now, and I still can’t find anyone."
    mc "Sí. Llevo un par de semanas y todavía no encuentro a nadie."

# game/Story01.rpy:2751

translate spanish flashback_d77ca3b2:

    # h "I just couldn’t hold back my laughter from the absurdity of it all."
    h "No pude contener la risa ante lo absurdo de todo."

# game/Story01.rpy:2752

translate spanish flashback_b4b1adf3:

    # h "And if this wasn’t fate, then what is?"
    h "Y si eso no era el destino, entonces ¿qué era?"

# game/Story01.rpy:2754

translate spanish flashback_2fded262_7:

    # h "..."
    h "..."

# game/Story01.rpy:2756

translate spanish flashback_df6a34a9:

    # h "...He gave me a place. A job. Food that wasn’t stolen or expired. And silence."
    h "...Me dio un lugar. Un trabajo. Comida que no estaba robada ni vencida. Y silencio."

# game/Story01.rpy:2757

translate spanish flashback_f333d2a7:

    # h "Not questions. Not judgment. Just... space."
    h "Nada de preguntas. Nada de juicios. Solo... espacio."

# game/Story01.rpy:2759

translate spanish flashback_2fded262_8:

    # h "..."
    h "..."

# game/Story01.rpy:2761

translate spanish flashback_864d5765:

    # h "And sometimes, space is all it takes to grow something back."
    h "Y a veces, el espacio basta para que algo pueda volver a crecer."

# game/Story01.rpy:2773

translate spanish street3_b707cd07:

    # Fl "Oh please. It’s just a basic taxi."
    Fl "Ay, por favor. Es solo un taxi básico."

# game/Story01.rpy:2775

translate spanish street3_d3ee03d9:

    # Fl "If this rattles you, how do you plan on handling something that actually matters?"
    Fl "Si esto te deja así, ¿cómo piensas manejar algo que de verdad importe?"

# game/Story01.rpy:2777

translate spanish street3_3d47b3db:

    # mc "Taxi? That wasn’t a taxi."
    mc "¿Taxi? Eso no era un taxi."

# game/Story01.rpy:2778

translate spanish street3_6e5e6303:

    # mc "That was a missile with a steering wheel."
    mc "Era un misil con volante."

# game/Story01.rpy:2781

translate spanish street3_7582a3cd:

    # Fl "Oh, stop being dramatic. It wasn’t that bad."
    Fl "Ay, deja el drama. No fue para tanto."

# game/Story01.rpy:2782

translate spanish street3_d51a3019:

    # Fl "Well, maybe for you, but I’m fine."
    Fl "Bueno, tal vez para ti, pero estoy bien."

# game/Story01.rpy:2784

translate spanish street3_11aea1b3:

    # mc "Right. Just casually mentioning that we almost crashed into a couple of buildings..."
    mc "Claro. Solo menciono casualmente que casi nos estrellamos contra un par de edificios..."

# game/Story01.rpy:2785

translate spanish street3_917b3685:

    # mc "Totally normal."
    mc "Totalmente normal."

# game/Story01.rpy:2790

translate spanish street3_fb8b7687:

    # Fl "Still shaking, or did your stomach crawl back to its designated quadrant?"
    Fl "¿Sigues temblando, o tu estómago ya volvió a su cuadrante designado?"

# game/Story01.rpy:2793

translate spanish street3_4936241a:

    # mc "Mostly stable... though there’s a little left..."
    mc "Casi estable... aunque todavía queda un poco..."

# game/Story01.rpy:2797

translate spanish street3_381a9fc5:

    # mc "BLEEUUUGH."
    mc "BLEEUUUGH."

# game/Story01.rpy:2799

translate spanish street3_b65836de:

    # Fl "Adorable. Nothing like shared trauma to bond people together, huh?"
    Fl "Adorable. Nada como un trauma compartido para unir a la gente, ¿eh?"

# game/Story01.rpy:2800

translate spanish street3_09e20f9b:

    # Fl "Take your time. This alley isn’t going anywhere."
    Fl "Tómate tu tiempo. Este callejón no va a ninguna parte."

# game/Story01.rpy:2801

translate spanish street3_3ab7d2af:

    # Fl "It just smells like death’s armpit and melted copper. Honestly, you’re thriving."
    Fl "Huele al sobaco de la muerte y a cobre fundido. Sinceramente, estás prosperando."

# game/Story01.rpy:2804

translate spanish street3_9ed383b1:

    # mc "Alright, alright. I’m coming."
    mc "Bien, bien. Ya voy."

# game/Story01.rpy:2811

translate spanish street3_f9e1c7fe:

    # Fl "Better?"
    Fl "¿Mejor?"

# game/Story01.rpy:2814

translate spanish street3_55affcc0:

    # Fl "Or have you developed a sudden fondness for dumpsters and the perfume of industrial decay?"
    Fl "¿O desarrollaste un cariño repentino por los contenedores y el perfume de la decadencia industrial?"

# game/Story01.rpy:2816

translate spanish street3_78005ff1:

    # mc "Ha-ha. {w}Mocking the wounded. Very noble of you."
    mc "Ja-ha. {w}- ¿Qué?"

# game/Story01.rpy:2817

translate spanish street3_3fa03a17:

    # mc "But seriously, what the hell is that?"
    mc "Pero en serio, ¿qué demonios es eso?"

# game/Story01.rpy:2819

translate spanish street3_a89d3017:

    # ss "Scanning..."
    ss "Escaneando..."

# game/Story01.rpy:2821

translate spanish street3_13743ff6:

    # Fl "That? That’s our ever-watchful sky warden. City’s answer to trust issues — with lasers."
    Fl "¿Eso? Es nuestro guardián celeste siempre vigilante. La respuesta de la ciudad a los problemas de confianza: con láseres."

# game/Story01.rpy:2822

translate spanish street3_9fa5bccb:

    # Fl "Fully autonomous, super-efficient."
    Fl "Totalmente autónomo, supereficiente."

# game/Story01.rpy:2823

translate spanish street3_5d0b2f9a:

    # Fl "Of course, like anything else, it’s not perfect, but let’s save that fun conversation for later."
    Fl "Claro, como todo lo demás, no es perfecto, pero guardemos esa conversación tan divertida para más tarde."

# game/Story01.rpy:2827

translate spanish street3_f751bac4:

    # Fl "It scans everything — documents, DNA, probably your browser history."
    Fl "Escanea todo: documentos, ADN, probablemente tu historial de navegación."

# game/Story01.rpy:2828

translate spanish street3_f6ebef01:

    # Fl "Knows who broke your heart in third grade and what you had for breakfast."
    Fl "Sabe quién te rompió el corazón en tercer grado y qué desayunaste."

# game/Story01.rpy:2830

translate spanish street3_b852b15d:

    # Fl "And if something doesn’t match up?"
    Fl "¿Y si algo no coincide?"

# game/Story01.rpy:2831

translate spanish street3_d033ba29:

    # Fl "Well, it’ll summon a squad to politely ask you some friendly questions."
    Fl "Bueno, llamará a un escuadrón para hacerte unas preguntas muy amables."

# game/Story01.rpy:2832

translate spanish street3_f1877cb6:

    # Fl "And if it really doesn’t like you..."
    Fl "Y si realmente no le gustas..."

# game/Story01.rpy:2834

translate spanish street3_0f48a466:

    # Fl "Just — {b}zap{/b}. You’re a smear where your shadow used to be."
    Fl "Simplemente... {b}zap{/b}. Te conviertes en una mancha donde antes estaba tu sombra."

# game/Story01.rpy:2835

translate spanish street3_39186686:

    # Fl "But hey, if you play nice, it usually doesn’t shoot."
    Fl "Pero si te portas bien, normalmente no dispara."

# game/Story01.rpy:2837

translate spanish street3_a896751b:

    # Fl "Just smile, nod, and keep your limbs in neutral territory."
    Fl "Sonríe, asiente y mantén tus extremidades en territorio neutral."

# game/Story01.rpy:2838

translate spanish street3_ab68ef1e:

    # Fl "Pretend you’re harmless."
    Fl "Finge que eres inofensivo."

# game/Story01.rpy:2840

translate spanish street3_7e4f4a6b:

    # Fl "Unless it glitches. Which, fun fact — happens more than anyone wants to admit."
    Fl "A menos que tenga un fallo. Dato curioso: pasa más de lo que nadie quiere admitir."

# game/Story01.rpy:2841

translate spanish street3_55ed70ce:

    # Fl "So if your eyeballs start burning, run. Don’t ask. Just run."
    Fl "Así que si los ojos empiezan a arderte, corre. No preguntes. Solo corre."

# game/Story01.rpy:2843

translate spanish street3_1feea213:

    # mc "Wait — that thing just scanned me. All my info? How’s that even possible?"
    mc "Espera... esa cosa acaba de escanearme. ¿Toda mi información? ¿Cómo es posible?"

# game/Story01.rpy:2845

translate spanish street3_533940ab:

    # Fl "Doesn’t store. It cross-checks. The Registry already has your life boxed, labeled, catalogued."
    Fl "No almacena nada. Cruza datos. El Registro ya tiene tu vida en una caja, etiquetada y catalogada."

# game/Story01.rpy:2846

translate spanish street3_547f1d79:

    # Fl "Think nosy librarian. With a gun. And a superiority complex."
    Fl "Piensa en una bibliotecaria entrometida. Con un arma. Y complejo de superioridad."

# game/Story01.rpy:2860

translate spanish street3_59537ecb:

    # Fl "Rule one: keep your head clear. Daydreamers die fast."
    Fl "Regla uno: mantén la cabeza despejada. Los que sueñan despiertos mueren rápido."

# game/Story01.rpy:2863

translate spanish street3_babacdcf:

    # mc "I just can’t stop thinking — how did that thing scan me and pull up everything? Feels impossible."
    mc "No puedo dejar de pensar... ¿cómo me escaneó esa cosa y sacó todo eso? Parece imposible."

# game/Story01.rpy:2866

translate spanish street3_3e562638:

    # Fl "It didn’t. Just cross-checked you with the registry."
    Fl "No lo hizo. Solo te contrastó con el registro."

# game/Story01.rpy:2867

translate spanish street3_d05471ac:

    # Fl "And the registry? Let’s just say your brain was an open book. We took a peek."
    Fl "¿Y el registro? Digamos que tu cerebro era un libro abierto."

# game/Story01.rpy:2870

translate spanish street3_c33ac12c:

    # Fl "Legal? Not even close."
    Fl "¿Legal? Ni de lejos."

# game/Story01.rpy:2871

translate spanish street3_4e9d6479:

    # Fl "But that’s the job, and let’s face it — morals don’t pay the bills."
    Fl "Pero ese es el trabajo, y seamos sinceros: la moral no paga las cuentas."

# game/Story01.rpy:2872

translate spanish street3_b85fe5b7:

    # Fl "Especially when the pay’s really good."
    Fl "Sobre todo cuando pagan tan bien."

# game/Story01.rpy:2875

translate spanish street3_bd2ad773:

    # Fl "Out here, survival beats dignity. Always. A starving kid’ll gut you for half a ration — no one blinks."
    Fl "Aquí, la supervivencia pesa más que la dignidad. Siempre. Un niño hambriento te destriparía por media ración y nadie pestañearía."

# game/Story01.rpy:2878

translate spanish street3_6e5b8b7b:

    # mc "And no one does anything?"
    mc "¿Y nadie hace nada?"

# game/Story01.rpy:2881

translate spanish street3_a67744c6:

    # Fl "Sure they tried. The whole “let’s fix the world” speech."
    Fl "Claro que lo intentaron. Todo el discursito de \"arreglemos el mundo\"."

# game/Story01.rpy:2882

translate spanish street3_8eb5b185:

    # Fl "Thought passion could rewrite the rules."
    Fl "Creían que la pasión podía reescribir las reglas."

# game/Story01.rpy:2885

translate spanish street3_fd62f7b2:

    # Fl "I watched them scream while the crowd cheered and kids sold snacks. It was... efficient."
    Fl "Los vi gritar mientras la multitud aplaudía y los niños vendían bocadillos. Fue... eficiente."

# game/Story01.rpy:2887

translate spanish street3_f850002b:

    # Fl "They had a spark. But when it came time to ignite? They blinked."
    Fl "Tenían una chispa. Pero cuando llegó la hora de prender la mecha, dudaron."

# game/Story01.rpy:2888

translate spanish street3_8d57ae31:

    # Fl "Now they’re just part of the pavement. History’s ashtray."
    Fl "Ahora son solo parte del pavimento. El cenicero de la historia."

# game/Story01.rpy:2891

translate spanish street3_49043882:

    # mc "Bit excessive, don’t you think?"
    mc "Un poco excesivo, ¿no crees?"

# game/Story01.rpy:2900

translate spanish street3_cc4f8db2:

    # Fl "And here we are. First stop on our charming little tour."
    Fl "Y aquí estamos, primera parada en nuestro pequeño tour encantador."

# game/Story01.rpy:2906

translate spanish street3_05852bfb:

    # mc "Wait... isn’t this just a strip cl—"
    mc "Espera... ¿no es solo un club de strip...?"

# game/Story01.rpy:2915

translate spanish street3_d66621af:

    # Fl "You? You stay. Don’t touch anything, don’t talk to anyone, and for the love of entropy — don’t try to be clever."
    Fl "¿Tú? Tú te quedas. No toques nada, no hables con nadie y, por amor a la entropía, no intentes hacerte el listo."

# game/Story01.rpy:2916

translate spanish street3_dcef6a82:

    # Fl "Stand still, look mysterious. Maybe they’ll mistake you for security."
    Fl "Quédate quieto, pon cara de misterio. Quizá te confundan con seguridad."

# game/Story01.rpy:2917

translate spanish street3_67cb25ac:

    # Fl "I’ll be back before your brain has time to short-circuit."
    Fl "Volveré antes de que tu cerebro tenga tiempo para hacer cortocircuito."

# game/Story01.rpy:2919

translate spanish street3_3e55eb26:

    # Fl "I won’t be long. And hey — don’t miss me too much while I’m gone."
    Fl "No tardaré mucho. Y oye, no me extrañes demasiado mientras no estoy."

# game/Story01.rpy:2921

translate spanish street3_67304c67:

    # mc "Stand around and do nothing. Sounds like a dream job."
    mc "Quedarme de pie sin hacer nada. Suena a trabajo de ensueño."

# game/Story01.rpy:2933

translate spanish street3_2b35b6fe_3:

    # mc "..."
    mc "..."

# game/Story01.rpy:2939

translate spanish street3_41d422bb:

    # mc "(Won’t be long), she said..."
    mc "(No tardará mucho), dijo..."

# game/Story01.rpy:2941

translate spanish street3_0bd8b6c7:

    # mc "How long am I supposed to wait here, exactly?"
