translate spanish path_second_up_2_0219a67d:

    # Fl "The detectors here are glitching out. Can’t tell if anyone’s around or not. Could be empty — or not."
    Fl "Los detectores aquí están desconcertándose. No se puede decir si alguien está cerca o no. Podría estar vacío —o no."

# game/Story01.rpy:4620

translate spanish path_second_up_2_59a0f1da:

    # Fl "Either way, stay frosty. You’re in the kind of place where anything can happen."
    Fl "De cualquier manera, quédate congelada. Estás en el tipo de lugar donde puede pasar cualquier cosa."

# game/Story01.rpy:4621

translate spanish path_second_up_2_83d7e526:

    # mc "Understood. I’ll stay on high alert."
    mc "Entendido. Me quedaré en alerta alta."

# game/Story01.rpy:4623

translate spanish path_second_up_2_a81b91fa:

    # mc "So, this is the cause of the blockade. But how did it end up here?"
    mc "Así que esta es la causa del bloqueo, pero ¿cómo terminó aquí?"

# game/Story01.rpy:4624

translate spanish path_second_up_2_ba6eeb17:

    # Fl "Judging by the debris, I’d say this patrol ship was shot down. No sign of the pilots, though. Hopefully, they ejected in time. Slim chance, but hey, miracles happen."
    Fl "A juzgar por los escombros, diría que esta nave patrulla fue derribado. Sin embargo, no hay señales de los pilotos. Con suerte, ellos expulsaron a tiempo. Escasa oportunidad, pero oye, los milagros suceden."

# game/Story01.rpy:4625

translate spanish path_second_up_2_97aa136f:

    # mc "A grim fate... but certainly better than being trapped inside."
    mc "Un destino asqueroso... pero ciertamente mejor que estar atrapado dentro."

# game/Story01.rpy:4627

translate spanish path_second_up_2_7ed49160:

    # mc "It doesn’t seem like there’s any way around here… Unfortunate."
    mc "No parece que haya alguna manera por aquí... infortunada."

# game/Story01.rpy:4629

translate spanish path_second_up_2_92bf8f4a:

    # Fl "Not a total dead end. There’s a metro entrance around the corner on your right. You can use it to reach the objective."
    Fl "No es un callejón sin salida. Hay una entrada de metro alrededor de la esquina a la derecha. Puedes usarlo para alcanzar el objetivo."

# game/Story01.rpy:4630

