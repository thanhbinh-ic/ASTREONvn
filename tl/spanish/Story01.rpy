translate spanish dodgebut2_8a340642:

    # mc "What does that mean?"
    mc "¿Qué significa eso?"

# game/Story01.rpy:2055

translate spanish dodgebut2_292a57b5:

    # am "You want answers? Offer something in return."
    am "Ofrézcale algo a cambio."

# game/Story01.rpy:2057

translate spanish dodgebut2_521c1bbd:

    # mc "What could I possibly offer you?"
    mc "¿Qué podría ofrecerte?"

# game/Story01.rpy:2059

translate spanish dodgebut2_0ac408db:

    # am "The matter that truly concerns us. The artifact — the one you interacted with."
    am "El asunto que realmente nos concierne. El artefacto — con el que interactuaste."

# game/Story01.rpy:2060

translate spanish dodgebut2_17a2ce0e:

    # am "Its name is the Web of Realities."
    am "Su nombre es la Web de Realidades."

# game/Story01.rpy:2062

translate spanish dodgebut2_284dc756:

    # mc "The Web of Realities? That sounds like—"
    mc "¿La Web de las Realidades?"

# game/Story01.rpy:2064

translate spanish dodgebut2_68817b9e:

    # am "—fiction? So did fire to the caveman."
    am "- ¿Ficción? También le disparó al cavernícola."

# game/Story01.rpy:2066

translate spanish dodgebut2_bff8bd4a:

    # am "Your task is to find a fragment."
    am "Su tarea es encontrar un fragmento."

# game/Story01.rpy:2068

translate spanish dodgebut2_eb1e3b1a:

    # mc "...What about Norman? Please... don’t dance around this one."
    mc "...¿Qué hay de Norman? Por favor... no baile alrededor de este."

# game/Story01.rpy:2072

translate spanish dodgebut2_5daab785:

    # am "Give me a fragment — and you’ll get your answers."
    am "Dame un fragmento y obtendrás tus respuestas."

# game/Story01.rpy:2074

translate spanish dodgebut2_2b35b6fe:

    # mc "..."
    mc "..."

# game/Story01.rpy:2092

translate spanish eye_62694309:

    # o "Didn’t think I’d see you back so soon. Life’s got a twisted sense of timing, doesn’t it?"
    o "No pensé que volvería a verte tan pronto. La vida tiene un sentido del momento bastante retorcido, ¿no?"

# game/Story01.rpy:2094

translate spanish eye_361f438a:

    # o "I patched up your eye — mostly. Still missing a few key pieces, but it’ll hold when it counts."
    o "Te remendé el ojo... en su mayor parte. Aún faltan algunas piezas clave, pero aguantará cuando haga falta."

# game/Story01.rpy:2095

translate spanish eye_16cf8478:

    # o "It might glitch now and then. Consider it a reminder — you’re not invincible."
    o "Puede fallar de vez en cuando. Tómalo como un recordatorio: no eres invencible."

# game/Story01.rpy:2096

translate spanish eye_08ea7135:

    # o "How’re you holding up? Don’t lie. I’ll know."
    o "¿Cómo lo llevas? No mientas. Me daré cuenta."

# game/Story01.rpy:2101

translate spanish eye_e82448cc:

    # mc "Yeah... Thanks, Doc."
    mc "Sí, gracias, Doc."

# game/Story01.rpy:2103

translate spanish eye_f94cbb92:

    # o "Don’t thank me yet. We’ll see how long it lasts."
    o "No me agradezcas todavía. Veremos cuánto dura."

# game/Story01.rpy:2109

translate spanish eye_857e7e4d:

    # o "You always were a terrible liar."
    o "Siempre fuiste un mentiroso terrible."

# game/Story01.rpy:2113

translate spanish eye_789eebe7:

    # Mi "Excuse me, sir. May I come in?"
    Mi "Disculpe, señor. ¿Puedo pasar?"

# game/Story01.rpy:2115

translate spanish eye_7af81103:

    # o "Go ahead. He’s awake — more or less intact."
    o "Adelante. Está despierto, más o menos intacto."

# game/Story01.rpy:2117

translate spanish eye_3ed85779:

    # Mi "Thank you. I was worried."
    Mi "Gracias. Estaba preocupada."

# game/Story01.rpy:2119

translate spanish eye_5cb5d2b4:

    # Mi "How are you feeling? Any better?"
    Mi "¿Cómo te sientes? ¿Algo mejor?"

# game/Story01.rpy:2121

translate spanish eye_6eca2f45:

    # mc "Better, yeah. Eye still feels like someone jammed a screwdriver in it, but... I’ll manage."
    mc "Mejor, sí. El ojo todavía se siente como si alguien me hubiera clavado un destornillador, pero... me las arreglaré."

# game/Story01.rpy:2123

translate spanish eye_682050f0:

    # mc "Where’s Olivia? She wasn’t with you."
    mc "¿Dónde está Olivia? No estaba contigo."

# game/Story01.rpy:2127

translate spanish eye_d49b216c:

    # mc "Something happen?"
    mc "¿Pasa algo?"

# game/Story01.rpy:2129

translate spanish eye_208ede5c:

    # h "You reckless bastard! One day — just one! That’s all I asked!"
    h "¡Maldito imprudente! Un día, ¡solo uno! ¡Eso era todo lo que te pedía!"

# game/Story01.rpy:2133

translate spanish eye_776c5b1c:

    # h "I told you not to do anything stupid, and what do you do? Exactly that!"
    h "Te dije que no hicieras ninguna estupidez, ¿y qué haces? Exactamente eso."

# game/Story01.rpy:2139

translate spanish eye_ea1b1e49:

    # mc "I know. I screwed up. Again."
    mc "Lo sé. La cagué. Otra vez."

# game/Story01.rpy:2141

translate spanish eye_96f74f03:

    # mc "Trouble and I — we’ve got history. Doesn’t mean I like it. Doesn’t mean I can stop."
    mc "Los problemas y yo tenemos historia. No significa que me guste. Tampoco significa que pueda parar."

# game/Story01.rpy:2144

translate spanish eye_d300aa55:

    # o "Alright, enough. I’ve got rounds to do. Miriel, he’s yours now. Try not to let him break anything else."
    o "Está bien, suficiente. Tengo rondas que hacer. Miriel, ahora es todo tuyo. Intenta que no rompa nada más."

# game/Story01.rpy:2146

translate spanish eye_a6633a95:

    # Mi "Understood. Thank you, sir."
    Mi "Entendido. Gracias, señor."

# game/Story01.rpy:2156

translate spanish eye_0ff491e3:

    # o "Well, that’s my cue. Try not to kill each other."
    o "Bueno, esa es mi señal. Intenten no matarse."

# game/Story01.rpy:2158

translate spanish eye_a6633a95_1:

    # Mi "Understood. Thank you, sir."
    Mi "Entendido. Gracias, señor."

# game/Story01.rpy:2164

translate spanish eye_c8b16eb4:

    # mc "Why do you even care? It’s my life. My choices. Not yours to control."
    mc "¿Y a ti por qué te importa? Es mi vida. Mis decisiones. No son tuyas para controlarlas."

# game/Story01.rpy:2166

translate spanish eye_4588b171:

    # h "I was trying to help! But you just keep pushing everyone away—"
    h "¡Solo intentaba ayudar! Pero tú sigues apartando a todo el mundo—"

# game/Story01.rpy:2168

translate spanish eye_f0be8ee7:

    # o "Kid’s been at your bedside every hour, asking if you’d make it."
    o "La chica ha estado junto a tu cama a cada rato, preguntando si saldrías de esta."

# game/Story01.rpy:2169

translate spanish eye_e98733e8:

    # o "Say what you want — but don’t pretend she doesn’t care."
    o "Di lo que quieras, pero no finjas que no le importas."

# game/Story01.rpy:2170

translate spanish eye_707ff5ff:

    # o "Don’t screw this up worse than you already have."
    o "No lo estropees más de lo que ya lo hiciste."

# game/Story01.rpy:2172

translate spanish eye_28f1e31a:

    # Fl "Another hallway heartbreak? Let me guess — your doing again?"
    Fl "¿Otro corazón roto en el pasillo? Déjame adivinar: ¿obra tuya otra vez?"

# game/Story01.rpy:2174

translate spanish eye_56fc32b6:

    # mc "Did what I had to. Should’ve cut it off before it got this far. She deserves better."
    mc "Hice lo que tenía que hacer. Debí cortarlo antes de que llegara tan lejos. Ella merece algo mejor."

# game/Story01.rpy:2176

translate spanish eye_404811df:

    # Fl "Maybe she is better than you. Doesn't mean you're her goddamn curator."
    Fl "Quizá sí sea mejor que tú. Eso no significa que seas su maldito curador."

# game/Story01.rpy:2177

translate spanish eye_61bdb4a2:

    # Fl "Bold, yeah. Cold? Fridge-level."
    Fl "Valiente, sí. ¿Frío? Nivel congelador."

# game/Story01.rpy:2179

translate spanish eye_7bf6e154:

    # Mi "I’ll talk to her when I can."
    Mi "Hablaré con ella cuando pueda."

# game/Story01.rpy:2181

translate spanish eye_b0ac2a3f:

    # Mi "Right now, she needs space. Let her breathe."
    Mi "Ahora mismo necesita espacio. Déjala respirar."

# game/Story01.rpy:2183

translate spanish eye_2c31a2b6:

    # Fl "Drama’s cute, but we’ve got bigger ghosts to chase."
    Fl "El drama es adorable, pero tenemos fantasmas más grandes que perseguir."

# game/Story01.rpy:2187

translate spanish eye_506533d5:

    # Mi "Flora will catch you up. I’ll check on Olivia."
    Mi "Flora te pondrá al día. Yo iré a ver a Olivia."

# game/Story01.rpy:2191

translate spanish eye_180af67f:

    # mc "Miriel—"
    mc "Miriel..."

# game/Story01.rpy:2195

translate spanish eye_c0bbcc68:

    # mc "Take care of her."
    mc "Cuida de ella."

# game/Story01.rpy:2198

translate spanish eye_a13b5436:

    # Mi "You’d better make this worth it."
    Mi "Será mejor que valga la pena."

# game/Story01.rpy:2200

translate spanish eye_f2fd04bf:

    # Fl "She leads with her heart. That’s brave. And dangerous."
    Fl "Ella se deja guiar por el corazón. Es valiente. Y peligroso."

# game/Story01.rpy:2201

translate spanish eye_a605cbad:

    # Fl "Now come on. We've wasted enough daylight."
    Fl "Ya hemos perdido demasiado tiempo."

